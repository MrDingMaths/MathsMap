      {
        "id": "p78-q31-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the perimeter if $x=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\text{ cm}$; $P=4x+16$.",
          "worked": "The inward edges have lengths $(x-2)\\text{ cm}$ and $(x+5)\\text{ cm}$.\n$$\\begin{align*}P&=x+3+(x-2)+(x+5)+2+(x+8)\\\\P&=4x+16\\\\P&=4(5)+16\\\\P&=36\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p78-q31-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area if $x=7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45\\text{ cm}^2$; $A=3x+2(x+5)$.",
          "worked": "Split the shape into a left rectangle of dimensions $3\\text{ cm}$ by $x\\text{ cm}$ and a lower-right rectangle of dimensions $(x+5)\\text{ cm}$ by $2\\text{ cm}$.\n$$\\begin{align*}A&=3x+2(x+5)\\\\A&=3(7)+2(7+5)\\\\A&=45\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p78-q31-c",
        "type": "part",
        "label": "c",
        "prompt": "The perimeter is $46\\text{ cm}$. Find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7.5$ (left edge $7.5\\text{ cm}$); $4x+16=46$.",
          "worked": "$$\\begin{align*}4x+16&=46\\\\4x&=30\\\\x&=7.5\\end{align*}$$\nThe left edge is $7.5\\text{ cm}$.\nCheck: $4(7.5)+16=46$, and $7.5>2$, so both inward edges have positive lengths.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p78-q31-d",
        "type": "part",
        "label": "d",
        "prompt": "The area of the shape is $65\\text{ cm}^2$. Find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=11$ (left edge $11\\text{ cm}$); $3x+2(x+5)=65$.",
          "worked": "$$\\begin{align*}3x+2(x+5)&=65\\\\5x+10&=65\\\\5x&=55\\\\x&=11\\end{align*}$$\nThe left edge is $11\\text{ cm}$.\nCheck: $3(11)+2(11+5)=65$, and $11>2$, so both inward edges have positive lengths.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
