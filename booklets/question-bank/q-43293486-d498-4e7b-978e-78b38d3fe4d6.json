  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve each quadratic equation by completing the square.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-2x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $3$",
          "worked": "$$\\begin{align*}x^2-2x+1&=3+1\\\\(x-1)^2&=4\\\\x-1&=\\pm2\\\\x&=-1\\text{ or }3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-6x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $6$",
          "worked": "$$\\begin{align*}x^2-6x+9&=9\\\\(x-3)^2&=9\\\\x-3&=\\pm3\\\\x&=0\\text{ or }6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p20-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$a^2+6a+8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-4$ or $-2$",
          "worked": "$$\\begin{align*}a^2+6a&=-8\\\\a^2+6a+9&=1\\\\(a+3)^2&=1\\\\a+3&=\\pm1\\\\a&=-4\\text{ or }-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p20-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2+\\sqrt3$ or $-2-\\sqrt3$",
          "worked": "$$\\begin{align*}x^2+4x&=-1\\\\x^2+4x+4&=3\\\\(x+2)^2&=3\\\\x+2&=\\pm\\sqrt3\\\\x&=-2\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p20-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-10x+20=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5+\\sqrt5$ or $5-\\sqrt5$",
          "worked": "$$\\begin{align*}x^2-10x&=-20\\\\x^2-10x+25&=5\\\\(x-5)^2&=5\\\\x-5&=\\pm\\sqrt5\\\\x&=5\\pm\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p20-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$y^2+3y=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-5$ or $2$",
          "worked": "$$\\begin{align*}y^2+3y+\\frac94&=10+\\frac94\\\\\\left(y+\\frac32\\right)^2&=\\frac{49}{4}\\\\y+\\frac32&=\\pm\\frac72\\\\y&=-5\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p20-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$b^2-5b-14=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-2$ or $7$",
          "worked": "$$\\begin{align*}b^2-5b&=14\\\\b^2-5b+\\frac{25}{4}&=\\frac{81}{4}\\\\\\left(b-\\frac52\\right)^2&=\\frac{81}{4}\\\\b-\\frac52&=\\pm\\frac92\\\\b&=-2\\text{ or }7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p20-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$y^2-y+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution.",
          "worked": "$$\\begin{align*}y^2-y&=-2\\\\y^2-y+\\frac14&=-\\frac74\\\\\\left(y-\\frac12\\right)^2&=-\\frac74\\end{align*}$$\nA real square cannot be negative, so there is no real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p20-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$a^2+7a+7=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{-7+\\sqrt{21}}2$ or $\\frac{-7-\\sqrt{21}}2$",
          "worked": "$$\\begin{align*}a^2+7a&=-7\\\\a^2+7a+\\frac{49}{4}&=\\frac{21}{4}\\\\\\left(a+\\frac72\\right)^2&=\\frac{21}{4}\\\\a+\\frac72&=\\pm\\frac{\\sqrt{21}}2\\\\a&=\\frac{-7\\pm\\sqrt{21}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
