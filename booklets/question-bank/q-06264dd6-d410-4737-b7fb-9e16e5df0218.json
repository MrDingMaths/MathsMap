  "content": {
    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve the following for $\\theta\\in[0^\\circ,360^\\circ]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin^2\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=90^\\circ,270^\\circ$.",
          "worked": "$$\\begin{align*}\\sin\\theta&=\\pm1\\\\\\theta&=90^\\circ,270^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p19-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos^2\\theta=\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ,150^\\circ,210^\\circ,330^\\circ$.",
          "worked": "$$\\cos\\theta=\\pm\\frac{\\sqrt3}{2}$$\nThe related acute angle is $30^\\circ$. Including both signs gives a solution in each quadrant:\n$$\\theta=30^\\circ,150^\\circ,210^\\circ,330^\\circ.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p19-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan^2\\theta=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,120^\\circ,240^\\circ,300^\\circ$.",
          "worked": "$$\\tan\\theta=\\pm\\sqrt3$$\nThe related acute angle is $60^\\circ$. Including both signs gives a solution in each quadrant:\n$$\\theta=60^\\circ,120^\\circ,240^\\circ,300^\\circ.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\cos^2\\theta-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^\\circ,135^\\circ,225^\\circ,315^\\circ$.",
          "worked": "$$\\begin{align*}2\\cos^2\\theta&=1\\\\\\cos^2\\theta&=\\frac12\\\\\\cos\\theta&=\\pm\\frac1{\\sqrt2}\\end{align*}$$\nThe related acute angle is $45^\\circ$. Including both signs gives\n$$\\theta=45^\\circ,135^\\circ,225^\\circ,315^\\circ.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$3\\tan^2\\theta-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ,150^\\circ,210^\\circ,330^\\circ$.",
          "worked": "$$\\begin{align*}3\\tan^2\\theta&=1\\\\\\tan^2\\theta&=\\frac13\\\\\\tan\\theta&=\\pm\\frac1{\\sqrt3}\\end{align*}$$\nThe related acute angle is $30^\\circ$. Including both signs gives\n$$\\theta=30^\\circ,150^\\circ,210^\\circ,330^\\circ.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
