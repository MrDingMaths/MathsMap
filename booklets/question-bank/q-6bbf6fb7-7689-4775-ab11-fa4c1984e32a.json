  "content": {
    "id": "p15-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "When it was built, the Great Pyramid of Cheops in Egypt had a height of $145.75\\text{ m}$ and its base was a square of side length $229\\text{ m}$. Find its volume in cubic metres, correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\,547\\,758.6\\text{ m}^3$",
      "worked": "$$\\begin{align*}A&=229\\times229=52\\,441\\text{ m}^2\\\\V&=\\frac13\\times\\text{base area}\\times\\text{height}\\\\V&=\\frac13\\times52\\,441\\times145.75\\text{ m}^3\\\\V&\\approx2\\,547\\,758.6\\text{ m}^3\\quad\\text{(1 decimal place)}\\end{align*}$$",
      "solutionDiagrams": []
