  "content": {
    "id": "p25-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Alice and Ben take turns tossing a coin. Alice tosses first. The first player to toss a head wins. Find the probability that Alice wins.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
