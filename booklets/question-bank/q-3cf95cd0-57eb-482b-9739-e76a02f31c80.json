  },
  "content": {
    "id": "p58-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Finish factorising the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+3)(x^2-16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+4)(x-4)$",
          "worked": "$$\\begin{align*}(x+3)(x^2-16)&=(x+3)(x^2-4^2)\\\\&=(x+3)(x+4)(x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+3)(x^2+10x+16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+2)(x+8)$",
          "worked": "$2\\times8=16$ and $2+8=10$.\n$$\\begin{align*}(x+3)(x^2+10x+16)&=(x+3)(x+2)(x+8)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+3)(x^2+8x+16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+4)^2$",
          "worked": "$2\\times x\\times4=8x$.\n$$\\begin{align*}(x+3)(x^2+8x+16)&=(x+3)(x+4)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x+3)(4x^2+8x+16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x+3)(x^2+2x+4)$",
          "worked": "$$\\begin{align*}(x+3)(4x^2+8x+16)&=4(x+3)(x^2+2x+4)\\end{align*}$$\nNo integer factor pair of $4$ has sum $2$, so the quadratic does not factorise further over the integers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+3)(4x^2+8x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x+3)(x+1)^2$",
          "worked": "$$\\begin{align*}(x+3)(4x^2+8x+4)&=4(x+3)(x^2+2x+1)\\\\&=4(x+3)(x+1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x+3)(4x^2-8x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x+3)(x-1)^2$",
          "worked": "$$\\begin{align*}(x+3)(4x^2-8x+4)&=4(x+3)(x^2-2x+1)\\\\&=4(x+3)(x-1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$5(x+3)(4x^2+8x-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(x+3)(2x-1)(2x+5)$",
          "worked": "$P=4(-5)=-20$, $S=8$; the factor pair is $10,-2$.\n$$\\begin{align*}4x^2+8x-5&=4x^2+10x-2x-5\\\\&=2x(2x+5)-(2x+5)\\\\&=(2x-1)(2x+5)\\\\5(x+3)(4x^2+8x-5)&=5(x+3)(2x-1)(2x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p58-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$5(x+3)(4x^2+8x-12)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20(x+3)^2(x-1)$",
          "worked": "$3\\times(-1)=-3$ and $3+(-1)=2$.\n$$\\begin{align*}5(x+3)(4x^2+8x-12)&=20(x+3)(x^2+2x-3)\\\\&=20(x+3)(x+3)(x-1)\\\\&=20(x+3)^2(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p58-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$5(x+3)(4x^2+8x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20x(x+3)(x+2)$",
          "worked": "$$\\begin{align*}5(x+3)(4x^2+8x)&=5(x+3)\\cdot4x(x+2)\\\\&=20x(x+3)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
