  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A class contains twenty-four students, and there are three times as many girls as there are boys. How many girls and boys are in the class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "18 girls and 6 boys.",
      "worked": "Let $g$ be the number of girls and $b$ the number of boys.\n$$\\begin{align*}g+b&=24\\\\g&=3b\\\\3b+b&=24\\\\4b&=24\\\\b&=6\\\\g&=3(6)\\\\g&=18\\end{align*}$$\nThere are 18 girls and 6 boys.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
