  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Simplify each expression.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$12y^3 + 2x^2 - 5y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7y^3 + 2x^2$",
          "worked": "$$\\begin{align*}12y^3 + 2x^2 - 5y^3 &= (12-5)y^3 + 2x^2 \\\\ &= 7y^3 + 2x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$5x^2 - 9x^2 + 4x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4x^2 + 4x^3$",
          "worked": "$$\\begin{align*}5x^2 - 9x^2 + 4x^3 &= (5-9)x^2 + 4x^3 \\\\ &= -4x^2 + 4x^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$8x^3 + 2x^2 - 7x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x^3 + 2x^2 - 7x$",
          "worked": "The powers of $x$ are different, so there are no like terms. The expression is already simplified: $8x^3 + 2x^2 - 7x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^3 + 6x^2 - 2x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x^3 + 6x^2$",
          "worked": "$$\\begin{align*}x^3 + 6x^2 - 2x^3 &= (1-2)x^3 + 6x^2 \\\\ &= -x^3 + 6x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$4m^3 + 12m^2 - 11m^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4m^3 + m^2$",
          "worked": "$$\\begin{align*}4m^3 + 12m^2 - 11m^2 &= 4m^3 + (12-11)m^2 \\\\ &= 4m^3 + m^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$21h^3 + 21h^2 - h^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20h^3 + 21h^2$",
          "worked": "$$\\begin{align*}21h^3 + 21h^2 - h^3 &= (21-1)h^3 + 21h^2 \\\\ &= 20h^3 + 21h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
