                  "type": "math",
                  "latex": "\\dfrac{(-2)^{10}}{(-2)^{\\boxed{\\rule{0pt}{5mm}\\hspace{5mm}}}}=(-2)^5",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Let the missing index be $n$. The common base is $-2$. Subtract the denominator's index from the numerator's index.\n$$\\begin{align*}10-n&=5\\\\n&=10-5\\\\&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
