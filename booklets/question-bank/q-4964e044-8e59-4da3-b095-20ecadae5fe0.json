              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\dfrac{7^{\\boxed{\\rule{0pt}{5mm}\\hspace{5mm}}}}{7^5}=7^4",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "Let the missing index be $n$. Subtract the denominator's index from the numerator's index.\n$$\\begin{align*}n-5&=4\\\\n&=4+5\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p59-q5-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p59-q5-e-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\dfrac{3^5}{3^{\\boxed{\\rule{0pt}{5mm}\\hspace{5mm}}}}=3^3",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "Let the missing index be $n$. Subtract the denominator's index from the numerator's index.\n$$\\begin{align*}5-n&=3\\\\n&=5-3\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p59-q5-f",
        "type": "part",
        "label": "f",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p59-q5-f-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
