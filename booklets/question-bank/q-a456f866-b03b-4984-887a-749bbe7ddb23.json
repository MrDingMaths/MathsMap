  "content": {
    "id": "p52-q3-root",
    "type": "question",
    "label": "",
    "prompt": "Given $\\overrightarrow{OA}=\\begin{pmatrix}-3\\\\4\\end{pmatrix}$ and $\\overrightarrow{OB}=\\begin{pmatrix}2\\\\1\\end{pmatrix}$, find the resultant vector for:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{OA}+\\overrightarrow{OB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}-1\\\\5\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{OA}+\\overrightarrow{OB}&=\\begin{pmatrix}-3\\\\4\\end{pmatrix}+\\begin{pmatrix}2\\\\1\\end{pmatrix}\\\\&=\\begin{pmatrix}-3+2\\\\4+1\\end{pmatrix}\\\\&=\\begin{pmatrix}-1\\\\5\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p52-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{OB}-\\overrightarrow{OA}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}5\\\\-3\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{OB}-\\overrightarrow{OA}&=\\begin{pmatrix}2\\\\1\\end{pmatrix}-\\begin{pmatrix}-3\\\\4\\end{pmatrix}\\\\&=\\begin{pmatrix}2-(-3)\\\\1-4\\end{pmatrix}\\\\&=\\begin{pmatrix}5\\\\-3\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p52-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{OA}-\\overrightarrow{OB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}-5\\\\3\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{OA}-\\overrightarrow{OB}&=\\begin{pmatrix}-3\\\\4\\end{pmatrix}-\\begin{pmatrix}2\\\\1\\end{pmatrix}\\\\&=\\begin{pmatrix}-3-2\\\\4-1\\end{pmatrix}\\\\&=\\begin{pmatrix}-5\\\\3\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
