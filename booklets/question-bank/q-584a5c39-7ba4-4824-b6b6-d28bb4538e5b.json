  "content": {
    "id": "p34-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A parabola has $x$-intercepts of $-2$ and $-4$ and a $y$-intercept of $-8$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-x^2-6x-8$",
      "worked": "The $x$-intercepts give the factors $(x+2)$ and $(x+4)$.\n$$\\begin{align*}y&=a(x+2)(x+4)\\\\-8&=a(0+2)(0+4)\\\\-8&=8a\\\\a&=-1\\\\y&=-(x+2)(x+4)\\\\y&=-x^2-6x-8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
