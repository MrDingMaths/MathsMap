  "content": {
    "id": "p25-q12-root",
    "type": "question",
    "label": "",
    "prompt": "Solve for $x$ or $n$, as appropriate.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^x\\times9^x=27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$\\begin{align*}3^x\\times3^{2x}&=3^3\\\\3^{3x}&=3^3\\\\3x&=3\\\\x&=1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^{3x}\\times25^{-2x+1}=125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$\\begin{align*}5^{3x}\\times5^{-4x+2}&=5^3\\\\5^{-x+2}&=5^3\\\\-x+2&=3\\\\-x&=1\\\\x&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p25-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{-3x}\\times4^{2x-2}=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$",
          "worked": "$\\begin{align*}2^{-3x}\\times2^{4x-4}&=2^4\\\\2^{x-4}&=2^4\\\\x-4&=4\\\\x&=8\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$16^{-x}=\\frac{1}{32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5}{4}$",
          "worked": "$\\begin{align*}2^{-4x}&=2^{-5}\\\\-4x&=-5\\\\x&=\\frac{5}{4}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$8^x=4^{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$\\begin{align*}2^{3x}&=2^{2x+2}\\\\3x&=2x+2\\\\x&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p25-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$16^{2-x}=\\frac{1}{8^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$",
          "worked": "$\\begin{align*}2^{8-4x}&=2^{-3x}\\\\8-4x&=-3x\\\\x&=8\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p25-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3^{n-2}}{9^{1-n}}=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$",
          "worked": "$\\begin{align*}\\frac{3^{n-2}}{3^{2-2n}}&=3^2\\\\3^{3n-4}&=3^2\\\\3n-4&=2\\\\3n&=6\\\\n&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p25-q12-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{5^{3n-3}}{25^{n-3}}=125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=0$",
          "worked": "$\\begin{align*}\\frac{5^{3n-3}}{5^{2n-6}}&=5^3\\\\5^{n+3}&=5^3\\\\n+3&=3\\\\n&=0\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p25-q12-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{36^{3+2n}}{6^n}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-2$",
          "worked": "$\\begin{align*}\\frac{6^{6+4n}}{6^n}&=6^0\\\\6^{6+3n}&=6^0\\\\6+3n&=0\\\\3n&=-6\\\\n&=-2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
