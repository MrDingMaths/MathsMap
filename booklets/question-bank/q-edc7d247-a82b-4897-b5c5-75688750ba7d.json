  "content": {
    "id": "p56-q4",
    "type": "question",
    "label": "4",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q4-initial",
        "type": "group",
        "label": null,
        "prompt": "Solve $6(x-9)=24$ by:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p56-q4-a",
            "type": "part",
            "label": "a",
            "prompt": "Expanding first.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=13$",
              "worked": "$$\\begin{align*}6x-54&=24\\\\6x&=78\\\\x&=13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p56-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "Dividing both sides by 6 first.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=13$",
              "worked": "$$\\begin{align*}x-9&=4\\\\x&=13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p56-q5",
        "type": "group",
        "label": null,
        "prompt": "Solve $6(x-9)=22$ by:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p56-q5-a",
            "type": "part",
            "label": "c",
            "prompt": "Expanding first.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\dfrac{38}{3}$",
              "worked": "$$\\begin{align*}6x-54&=22\\\\6x&=76\\\\x&=\\frac{76}{6}\\\\x&=\\frac{38}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p56-q5-b",
            "type": "part",
            "label": "d",
            "prompt": "Dividing both sides by 6 first.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\dfrac{38}{3}$",
              "worked": "$$\\begin{align*}x-9&=\\frac{22}{6}\\\\x&=\\frac{22}{6}+9\\\\x&=\\frac{11}{3}+\\frac{27}{3}\\\\x&=\\frac{38}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p56-q6",
        "type": "part",
        "label": "e",
        "prompt": "By considering parts a–d, explain how to determine whether to expand first or divide first when solving equations with brackets.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Dividing first is often simpler when it gives a whole number; otherwise, expanding first can avoid early fractions. Both methods are valid.",
          "worked": "For $6(x-9)=24$, dividing by 6 first gives $x-9=4$, so the working uses whole numbers. For $6(x-9)=22$, dividing first gives $x-9=\\frac{11}{3}$, whereas expanding first keeps whole numbers until the final division. Choose the method that makes the arithmetic easier; both give the same solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
