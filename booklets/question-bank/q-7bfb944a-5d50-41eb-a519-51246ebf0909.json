        "id": "p34-challenge-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "If $2^y=x$, what is $15\\times2^{y+3}$, in terms of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120x$",
          "worked": "$$\\begin{align*}15\\times2^{y+3}&=15\\times2^y\\times2^3\\\\15\\times2^{y+3}&=15\\times x\\times8\\\\15\\times2^{y+3}&=120x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p34-challenge-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "If $3^x=2$, find $3^{7x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$128$",
          "worked": "$$\\begin{align*}3^{7x}&=(3^x)^7\\\\3^{7x}&=2^7\\\\3^{7x}&=128\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p34-challenge-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "If $4^y=x$, what is $4^{y-2}$, in terms of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{16}$",
          "worked": "$$\\begin{align*}4^{y-2}&=\\frac{4^y}{4^2}\\\\4^{y-2}&=\\frac{x}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
