          "inlines": [
            {
              "type": "text",
              "text": "40% of workers for a large construction company prefer to have an early lunch,",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "25% of workers prefer to work through lunch and leave earlier.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "All other workers prefer a late lunch.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If 70 workers prefer a late lunch, how many workers are employed by the company?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "200 workers",
      "worked": "The workers who prefer a late lunch represent $100\\%-40\\%-25\\%=35\\%$ of the workforce.\n$$\\begin{align*}35\\%&=70\\text{ workers}\\\\1\\%&=70\\div35=2\\text{ workers}\\\\100\\%&=2\\times100=200\\text{ workers}\\end{align*}$$\nThe company employs 200 workers.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
