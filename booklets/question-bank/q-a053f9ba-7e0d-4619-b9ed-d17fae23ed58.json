      {
        "id": "p18-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that the greatest common divisor of two consecutive integers is $1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{GCD}(n,n+1)=1$.\n\nAny common divisor divides their difference, $1$.",
          "worked": "Let $n\\in\\mathbb Z$ and let $d$ be a positive common divisor of $n$ and $n+1$. Then $d$ divides their difference:\n$$\\begin{align*}(n+1)-n&=1.\\end{align*}$$\nThe only positive divisor of $1$ is $1$, so\n$$\\operatorname{GCD}(n,n+1)=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that the greatest common divisor of two consecutive odd integers is $1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{GCD}(2n+1,2n+3)=1$.\n\nAny common divisor divides $2$; both integers are odd, so their only positive common divisor is $1$.",
          "worked": "Let $n\\in\\mathbb Z$. Two consecutive odd integers are $2n+1$ and $2n+3$. Any positive common divisor $d$ divides their difference:\n$$\\begin{align*}(2n+3)-(2n+1)&=2.\\end{align*}$$\nThus $d$ is $1$ or $2$. Since $2n+1$ is odd, $2$ cannot divide it. Therefore $d=1$, and\n$$\\operatorname{GCD}(2n+1,2n+3)=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
