  "content": {
    "id": "p55-q10-root",
    "type": "question",
    "label": "3",
    "prompt": "Explain why it can be preferable to sketch trigonometric graphs using radians instead of degrees along the $x$-axis.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Radians make it convenient to use equal numerical scales on the two axes when combining trigonometric graphs with other functions. Equal axis scales must still be chosen; with these scales, $y=x$ has a $45^\\circ$ inclination.",
      "worked": "A sine cycle spans $2\\pi\\approx6.28$ in radians, compared with $360$ in degrees, while its values remain between $-1$ and $1$. Radian measure therefore makes equal numerical scales on the axes convenient when plotting sine with functions such as $y=x$. With equal axis scales, $y=x$ has a $45^\\circ$ inclination. Radians do not automatically impose equal axis scales.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
