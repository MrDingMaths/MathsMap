  "content": {
    "id": "p50-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "During a sale in a bookstore all travel guides are reduced from \\$30 by 20%.\nWhat percentage increase is required to take the price back to \\$30?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$ increase.",
          "worked": "Let $d$ be the multiplier needed to return to \\$30.\n$$\\begin{align*}30\\times0.8\\times d&=30\\\\24d&=30\\\\d&=1.25\\\\\\text{Percentage increase}&=(1.25-1)\\times100\\%\\\\&=25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p50-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The cost of an item is reduced by 50%.\nWhat percentage increase is required to return to its original price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\%$ increase.",
          "worked": "The reduction gives multiplier $0.5$. Let $d$ be the multiplier needed to restore the original price.\n$$\\begin{align*}0.5d&=1\\\\d&=2\\\\\\text{Percentage increase}&=(2-1)\\times100\\%\\\\&=100\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p50-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The cost of an item is increased by 75%.\nWhat percentage decrease is required to return to its original price?\nRound to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$42.86\\%$ decrease.",
          "worked": "The increase gives multiplier $1.75$. Let $d$ be the multiplier needed to restore the original price.\n$$\\begin{align*}1.75d&=1\\\\d&=\\frac{1}{1.75}\\\\&=\\frac47\\\\\\text{Percentage decrease}&=\\left(1-\\frac47\\right)\\times100\\%\\\\&=\\frac{300}{7}\\%\\\\&\\approx42.86\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p50-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "The cost of an item is changed by $a\\%$. What multiplier returns the changed cost to the original cost? Give a rule for an increase and a rule for a decrease.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "After an increase: multiply by $\\dfrac{100}{100+a}$. After a decrease: multiply by $\\dfrac{100}{100-a}$.",
          "worked": "Let $d$ be the multiplier needed to restore the original cost.\nFor an increase of $a\\%$:\n$$\\begin{align*}\\left(1+\\frac{a}{100}\\right)d&=1\\\\d&=\\frac{1}{1+a/100}\\\\&=\\frac{100}{100+a}\\end{align*}$$\nFor a decrease of $a\\%$:\n$$\\begin{align*}\\left(1-\\frac{a}{100}\\right)d&=1\\\\d&=\\frac{1}{1-a/100}\\\\&=\\frac{100}{100-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
