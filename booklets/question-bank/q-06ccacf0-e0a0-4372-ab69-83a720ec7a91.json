  "content": {
    "id": "p11-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A bag contains three times as many yellow marbles as blue marbles, and no other colours.\n\nIf a marble is chosen at random, find the probability that it is yellow.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{4}$",
      "worked": "Let the number of blue marbles be $x$. Then there are $3x$ yellow marbles and $4x$ marbles altogether.\n\n$$\\begin{align*}P(\\text{yellow})&=\\frac{3x}{4x}\\\\&=\\frac{3}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
