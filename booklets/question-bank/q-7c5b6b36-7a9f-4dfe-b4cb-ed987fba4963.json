        "id": "p48-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x(x^2+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x^2+1)^4(11x^2+1)$",
          "worked": "$$\\begin{align*}u&=x, & u'&=1\\\\v&=(x^2+1)^5, & v'&=10x(x^2+1)^4\\end{align*}$$\n$$\\begin{align*}y'&=u'v+uv'\\\\y'&=(x^2+1)^5+x\\bigl[10x(x^2+1)^4\\bigr]\\\\y'&=(x^2+1)^4\\bigl[(x^2+1)+10x^2\\bigr]\\\\y'&=(x^2+1)^4(11x^2+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p48-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2\\pi x^3(1-x^2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2\\pi x^2(1-x^2)^3(3-11x^2)$",
          "worked": "$$\\begin{align*}u&=2\\pi x^3, & u'&=6\\pi x^2\\\\v&=(1-x^2)^4, & v'&=-8x(1-x^2)^3\\end{align*}$$\n$$\\begin{align*}y'&=u'v+uv'\\\\y'&=6\\pi x^2(1-x^2)^4\\\\&\\quad+2\\pi x^3\\bigl[-8x(1-x^2)^3\\bigr]\\\\y'&=2\\pi x^2(1-x^2)^3\\\\&\\quad\\times\\bigl[3(1-x^2)-8x^2\\bigr]\\\\y'&=2\\pi x^2(1-x^2)^3(3-11x^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      },
      {
        "id": "p48-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-2x(x^2+x+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-2(x^2+x+1)^2(7x^2+4x+1)$",
          "worked": "$$\\begin{align*}u&=-2x, & u'&=-2\\\\v&=(x^2+x+1)^3\\\\v'&=3(x^2+x+1)^2(2x+1)\\end{align*}$$\n$$\\begin{align*}y'&=u'v+uv'\\\\y'&=-2(x^2+x+1)^3\\\\&\\quad-6x(x^2+x+1)^2(2x+1)\\\\y'&=-2(x^2+x+1)^2\\\\&\\quad\\times\\bigl[x^2+x+1+3x(2x+1)\\bigr]\\\\y'&=-2(x^2+x+1)^2(7x^2+4x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
