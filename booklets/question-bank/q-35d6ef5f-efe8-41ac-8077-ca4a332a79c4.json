  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "By expressing $15^\\circ$ as $(45^\\circ-30^\\circ)$, show:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin15^\\circ=\\dfrac{\\sqrt3-1}{2\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3-1}{2\\sqrt2}$",
          "worked": "$$\\begin{aligned}\\sin15^\\circ&=\\sin(45^\\circ-30^\\circ)\\\\&=\\sin45^\\circ\\cos30^\\circ-\\cos45^\\circ\\sin30^\\circ\\\\&=\\frac1{\\sqrt2}\\left(\\frac{\\sqrt3}2\\right)-\\frac1{\\sqrt2}\\left(\\frac12\\right)\\\\&=\\frac{\\sqrt3}{2\\sqrt2}-\\frac1{2\\sqrt2}\\\\&=\\frac{\\sqrt3-1}{2\\sqrt2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos15^\\circ=\\dfrac{\\sqrt3+1}{2\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3+1}{2\\sqrt2}$",
          "worked": "$$\\begin{aligned}\\cos15^\\circ&=\\cos(45^\\circ-30^\\circ)\\\\&=\\cos45^\\circ\\cos30^\\circ+\\sin45^\\circ\\sin30^\\circ\\\\&=\\frac1{\\sqrt2}\\left(\\frac{\\sqrt3}2\\right)+\\frac1{\\sqrt2}\\left(\\frac12\\right)\\\\&=\\frac{\\sqrt3}{2\\sqrt2}+\\frac1{2\\sqrt2}\\\\&=\\frac{\\sqrt3+1}{2\\sqrt2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan15^\\circ=2-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\sqrt3$",
          "worked": "$$\\begin{aligned}\\tan15^\\circ&=\\frac{\\sin15^\\circ}{\\cos15^\\circ}\\\\&=\\frac{\\dfrac{\\sqrt3-1}{2\\sqrt2}}{\\dfrac{\\sqrt3+1}{2\\sqrt2}}\\\\&=\\frac{\\sqrt3-1}{\\sqrt3+1}\\\\&=\\frac{(\\sqrt3-1)^2}{(\\sqrt3+1)(\\sqrt3-1)}\\\\&=\\frac{3-2\\sqrt3+1}{3-1}\\\\&=\\frac{4-2\\sqrt3}{2}\\\\&=2-\\sqrt3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
    ]
  },
