  "content": {
    "id": "p8-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Four couples enter a theatre and sit in a single row. Find the number of possible ways to seat the eight people if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8!=40\\,320$",
          "worked": "Arrange the eight distinct people in a row.\n$$\\begin{align*}N&=8!\\\\N&=40\\,320\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "all the couples sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^4\\times4!=384$",
          "worked": "Treat each couple as one block. Arrange the four blocks in $4!$ ways. Each couple has two internal orders, independently.\n$$\\begin{align*}N&=2^4\\times4!\\\\N&=384\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
