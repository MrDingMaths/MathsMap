        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$48k^2\\ \\text{cm}^2$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p20-q12-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let the width be ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "w",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " cm, so the length is ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "3w",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " cm.",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{align*}2(w+3w)&=32k\\\\2w+6w&=32k\\\\8w&=32k\\\\w&=4k\\\\\\text{Area}&=3(4k)(4k)\\\\\\text{Area}&=48k^2\\ \\text{cm}^2\\end{align*}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
