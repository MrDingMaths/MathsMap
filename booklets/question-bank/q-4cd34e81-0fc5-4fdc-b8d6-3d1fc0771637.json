          {
            "id": "p20-q12-a-shape",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User-requested feedback diagram; p20-q12-a-shape\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,line width=0.8pt,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont,inner sep=1pt}]\n\\draw (0,0) rectangle (18,18);\n\\node[anchor=south] at (9,20) {$P=12d\\,\\mathrm{cm}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 34,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "description": "Square with perimeter 12d cm.",
              "mathematics": "Square with perimeter 12d cm.",
              "answerVisibility": "Only stated givens and unknown dimensions; no derived answer."
