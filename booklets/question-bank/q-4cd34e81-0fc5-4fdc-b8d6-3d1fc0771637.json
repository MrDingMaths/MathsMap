        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$9d^2\\ \\text{cm}^2$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p20-q12-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\text{Side}&=\\frac{12d}{4}\\\\\\text{Side}&=3d\\ \\text{cm}\\\\\\text{Area}&=(3d)^2\\\\\\text{Area}&=9d^2\\ \\text{cm}^2\\end{align*}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
