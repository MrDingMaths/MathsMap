    "children": [
      {
        "id": "p26-packaging-context",
        "type": "group",
        "label": "",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p26-packaging-introduction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "In a factory, balls are packed in canisters, which are then wrapped in bundles of six with shrink-wrap film. To make the bundle as secure as possible, the ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "total volume",
                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": " of the pack, including any air space, needs to be as small as possible. If the volume was not as small as possible, the shrink-wrap film could be pulled tighter, thus decreasing the volume and making the package more secure.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p26-packaging-purpose",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "In this project, you will investigate how cylindrical canisters can be packed so as to minimise the volume of the pack.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p26-packaging-givens",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "You will need the following information. The canisters are cylindrical, with a base radius of 2.5 cm and a height of 20 cm.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p26-packaging-restriction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The final package can be no longer than 20 cm – that is, the cans cannot be stacked end-to-end like this.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p26-packaging-cylinder",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 26 Packaging cylinder\"}\n\\begin{tikzpicture}[x=8mm,y=8mm,line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,4) ellipse (1 and 0.25);\\draw (-1,4)--(-1,0);\\draw (1,4)--(1,0);\\draw (-1,0) arc (180:360:1 and 0.25);\n\\node[right] at (1.15,2){20 cm};\\draw[<->,line width=0.4pt] (0,-0.65)--node[below]{2.5 cm}(1,-0.65);\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 42,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
