            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 26 prohibited end-to-end canisters\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,0) ellipse (0.18 and 0.6);\\draw (0,0.6)--(4.8,0.6);\\draw (0,-0.6)--(4.8,-0.6);\\draw (2.4,0.6) arc (90:-90:0.18 and 0.6);\\draw (4.8,0.6) arc (90:-90:0.18 and 0.6);\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 65,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 26,
              "sourceRegion": "Packaging prohibited arrangement",
              "description": "Two horizontal canisters placed end-to-end, associated with the visible prohibition.",
              "mathematics": "End-to-end stacking exceeds the permitted package length.",
              "answerVisibility": "Permanent supplied example of a prohibited arrangement."
