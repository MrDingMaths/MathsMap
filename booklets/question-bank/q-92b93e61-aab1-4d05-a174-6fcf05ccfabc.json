  "content": {
    "id": "v2-frequency-practice-slot-13-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Mia rolls a fair die 20 times and gets 14 even numbers. Jin rolls the same die 500 times and gets 255 even numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-frequency-practice-slot-13-upper-slot-13-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the relative frequency of an even number for each person, as a decimal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Mia: $0.7$; Jin: $0.51$",
          "worked": "$$\\begin{align*}rf_{\\text{Mia}}&=\\frac{14}{20}\\\\rf_{\\text{Mia}}&=0.7\\\\rf_{\\text{Jin}}&=\\frac{255}{500}\\\\rf_{\\text{Jin}}&=0.51\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-frequency-practice-slot-13-upper-slot-13-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Whose relative frequency is closer to the theoretical probability of an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jin's",
          "worked": "$$\\begin{align*}P(\\text{even})&=\\frac36\\\\P(\\text{even})&=0.5\\end{align*}$$Mia's differs from $0.5$ by $0.2$ and Jin's differs by $0.01$. Jin's relative frequency is closer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-frequency-practice-slot-13-upper-slot-13-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why this is likely.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jin rolled the die many more times, so random variation has less effect on his relative frequency.",
          "worked": "Jin had 500 trials and Mia had 20. With more trials, random variation has less effect, so the relative frequency is usually closer to the theoretical probability.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
