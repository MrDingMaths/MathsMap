  "content": {
    "id": "p11-p4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the domain of the following functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-p4-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{x+1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne-1$.",
          "worked": "The original denominator must be nonzero:\n$$\\begin{align*}x+1&\\ne0\\\\x&\\ne-1.\\end{align*}$$\nThe domain is $\\mathbb{R}\\setminus\\{-1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-p4-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{x+1}{x^2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne-1,\\ 1$.",
          "worked": "The original denominator must be nonzero:\n$$\\begin{align*}x^2-1&\\ne0\\\\(x-1)(x+1)&\\ne0\\\\x&\\ne-1,\\ 1.\\end{align*}$$\nBoth exclusions remain even if a common factor is cancelled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-p4-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{x-2}{x^2-5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne2,\\ 3$.",
          "worked": "The original denominator must be nonzero:\n$$\\begin{align*}x^2-5x+6&\\ne0\\\\(x-2)(x-3)&\\ne0\\\\x&\\ne2,\\ 3.\\end{align*}$$\nCancelling $x-2$ does not restore the excluded input $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-p4-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x^2}{\\sqrt{x^2+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R}$.",
          "worked": "For every real $x$,\n$$\\begin{align*}x^2+1&\\ge1\\\\\\sqrt{x^2+1}&\\ge1.\\end{align*}$$\nThe square root is defined and the denominator is positive. Hence the domain is $\\mathbb{R}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
