  "content": {
    "id": "p92-q10-group",
    "type": "question",
    "label": "10",
    "prompt": "Find the Cartesian equation of the following, stating any restrictions where necessary.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p92-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2t^2+3,\\;5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5$, $x\\ge3$.",
          "worked": "$$\\begin{align*}x&=2t^2+3\\\\x&\\ge3\\\\y&=5\\end{align*}$$\nEvery $x\\ge3$ is obtained for a real value of $t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p92-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1-2\\sqrt{t},\\;1+\\sqrt{t})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{3-x}{2}$, $x\\le1$.",
          "worked": "$$\\begin{align*}\\sqrt{t}&=\\frac{1-x}{2}\\\\y&=1+\\frac{1-x}{2}\\\\y&=\\frac{3-x}{2}\\end{align*}$$\nSince $\\sqrt{t}\\ge0$, the restriction is $x\\le1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p92-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-2,\\;1-2^t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$, $y<1$.",
          "worked": "The $x$-coordinate is always $-2$. For real $t$, $2^t>0$, so $y=1-2^t<1$. Conversely, every $y<1$ is obtained because $2^t$ takes every positive value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p92-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3-t^2,\\;2+t^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5-x$, $x\\le3$.",
          "worked": "$$\\begin{align*}t^2&=3-x\\\\y&=2+(3-x)\\\\y&=5-x\\end{align*}$$\nSince $t^2\\ge0$, the restriction is $x\\le3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p92-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2\\sin t-1,\\;\\cos^2t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-\\dfrac{(x+1)^2}{4}$, $-3\\le x\\le1$.",
          "worked": "$$\\begin{align*}\\sin t&=\\frac{x+1}{2}\\\\y&=1-\\sin^2t\\\\y&=1-\\frac{(x+1)^2}{4}\\end{align*}$$\nSince $-1\\le\\sin t\\le1$, the restriction is $-3\\le x\\le1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p92-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(1+2^t,\\;4^t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-1)^2$, $x>1$.",
          "worked": "$$\\begin{align*}2^t&=x-1\\\\y&=(2^t)^2\\\\y&=(x-1)^2\\end{align*}$$\nSince $2^t>0$, the restriction is $x>1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
