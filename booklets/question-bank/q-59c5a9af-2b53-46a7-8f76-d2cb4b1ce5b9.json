  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Consider points $A(-1,-2)$ and $B(4,6)$. Find the point $N$ that divides the line segment $AB$ in the ratio $2:3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$N\\left(1,\\frac65\\right)$.",
      "worked": "$N$ is $\\frac25$ of the way from $A$ to $B$.\n$$\\begin{align*}x_N&=-1+\\frac25(4-(-1))\\\\x_N&=1\\\\y_N&=-2+\\frac25(6-(-2))\\\\y_N&=\\frac65.\\end{align*}$$\nTherefore, $N\\left(1,\\frac65\\right)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
