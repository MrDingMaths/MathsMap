  "content": {
    "id": "p60-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Find the exact gradient of the tangent to the curve $y=x\\sqrt{2x+5}$ at $x=1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{8\\sqrt7}{7}$",
      "worked": "Using the product rule:\n$$\\begin{align*}\\frac{dy}{dx}&=\\sqrt{2x+5}+x\\left(\\frac12(2x+5)^{-1/2}\\times2\\right)\\\\&=\\sqrt{2x+5}+\\frac{x}{\\sqrt{2x+5}}.\\end{align*}$$\nAt $x=1$:\n$$\\begin{align*}m&=\\sqrt7+\\frac1{\\sqrt7}\\\\&=\\frac8{\\sqrt7}\\\\&=\\frac{8\\sqrt7}{7}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
