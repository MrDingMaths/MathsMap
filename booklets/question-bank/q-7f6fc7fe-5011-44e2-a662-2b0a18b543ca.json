  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Parallel lines have the same gradient. Decide whether each pair of lines will be parallel.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = 4x + 5$ and $y = 3x + 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not parallel.",
          "worked": "The gradients are $4$ and $3$. They are unequal, so the lines are not parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = 7 - x$ and $y = -x + 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "Both gradients are $-1$, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = \\dfrac{2}{3}x - 9$ and $y = 4 + \\dfrac{2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "Both gradients are $\\dfrac{2}{3}$, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = 18x - 11$ and $y = 11 - 18x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not parallel.",
          "worked": "The gradients are $18$ and $-18$. They are unequal, so the lines are not parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$y = 4(3x + 1)$ and $y = 3x - 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not parallel.",
          "worked": "$$\\begin{align*}y &= 4(3x + 1)\\\\y &= 12x + 4\\end{align*}$$\nThe gradients are $12$ and $3$. They are unequal, so the lines are not parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$y = 2x + 7$ and $y = 2(x - 9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$$\\begin{align*}y &= 2(x - 9)\\\\y &= 2x - 18\\end{align*}$$\nBoth gradients are $2$, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
