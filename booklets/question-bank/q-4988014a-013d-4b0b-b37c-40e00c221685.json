        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{\\ell^2m^3}$",
          "worked": "$$\\begin{align*}2\\ell^2m^{-1}\\times5\\ell^{-4}m^{-2}&=10\\ell^{2-4}m^{-1-2}\\\\2\\ell^2m^{-1}\\times5\\ell^{-4}m^{-2}&=10\\ell^{-2}m^{-3}\\\\2\\ell^2m^{-1}\\times5\\ell^{-4}m^{-2}&=\\frac{10}{\\ell^2m^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{56t^{-4}}{8t^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{t^6}$",
          "worked": "$$\\begin{align*}\\frac{56t^{-4}}{8t^2}&=7t^{-4-2}\\\\\\frac{56t^{-4}}{8t^2}&=7t^{-6}\\\\\\frac{56t^{-4}}{8t^2}&=\\frac{7}{t^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{25\\ell^{-2}}{15\\ell^{-6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\ell^4}{3}$",
          "worked": "$$\\begin{align*}\\frac{25\\ell^{-2}}{15\\ell^{-6}}&=\\frac53\\ell^{-2-(-6)}\\\\\\frac{25\\ell^{-2}}{15\\ell^{-6}}&=\\frac{5\\ell^4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{28x^6y^2}{21x^{10}y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4y}{3x^4}$",
          "worked": "$$\\begin{align*}\\frac{28x^6y^2}{21x^{10}y}&=\\frac43x^{6-10}y^{2-1}\\\\\\frac{28x^6y^2}{21x^{10}y}&=\\frac43x^{-4}y\\\\\\frac{28x^6y^2}{21x^{10}y}&=\\frac{4y}{3x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{16u^{-2}v}{12u^{-6}v^{-7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4u^4v^8}{3}$",
          "worked": "$$\\begin{align*}\\frac{16u^{-2}v}{12u^{-6}v^{-7}}&=\\frac43u^{-2-(-6)}v^{1-(-7)}\\\\\\frac{16u^{-2}v}{12u^{-6}v^{-7}}&=\\frac{4u^4v^8}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q8-i",
        "type": "part",
        "label": "i",
        "prompt": "$(2mn^{-1})^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n^2}{4m^2}$",
          "worked": "$$\\begin{align*}(2mn^{-1})^{-2}&=2^{-2}m^{-2}n^2\\\\(2mn^{-1})^{-2}&=\\frac14\\times\\frac1{m^2}\\times n^2\\\\(2mn^{-1})^{-2}&=\\frac{n^2}{4m^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q8-j",
        "type": "part",
        "label": "j",
        "prompt": "$(3m^{-1}n^2)^{-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{m^4}{81n^8}$",
          "worked": "$$\\begin{align*}(3m^{-1}n^2)^{-4}&=3^{-4}m^4n^{-8}\\\\(3m^{-1}n^2)^{-4}&=\\frac1{81}\\times m^4\\times\\frac1{n^8}\\\\(3m^{-1}n^2)^{-4}&=\\frac{m^4}{81n^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q8-k",
        "type": "part",
        "label": "k",
        "prompt": "$(2a^{-4}b^{-1})^{-3}\\times3a^6b^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3a^{18}b}{8}$",
          "worked": "$$\\begin{align*}(2a^{-4}b^{-1})^{-3}\\times3a^6b^{-2}&=2^{-3}a^{12}b^3\\times3a^6b^{-2}\\\\(2a^{-4}b^{-1})^{-3}\\times3a^6b^{-2}&=\\frac38a^{12+6}b^{3-2}\\\\(2a^{-4}b^{-1})^{-3}\\times3a^6b^{-2}&=\\frac{3a^{18}b}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q8-l",
        "type": "part",
        "label": "l",
        "prompt": "$(a^{-1}b^2)^{-4}\\times(a^2b^{-3})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^{10}}{b^{17}}$",
          "worked": "$$\\begin{align*}(a^{-1}b^2)^{-4}\\times(a^2b^{-3})^3&=a^4b^{-8}\\times a^6b^{-9}\\\\(a^{-1}b^2)^{-4}\\times(a^2b^{-3})^3&=a^{10}b^{-17}\\\\(a^{-1}b^2)^{-4}\\times(a^2b^{-3})^3&=\\frac{a^{10}}{b^{17}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q8-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{(3a^{-2}b^{-1})^{-3}}{a^2b^{-4}}\\times\\dfrac{a^{-3}b^4}{12a^6b^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^{13}}{324a^5}$\n\nRaise each factor to its power, then combine indices when multiplying and dividing.",
          "worked": "$$\\begin{align*}\\frac{(3a^{-2}b^{-1})^{-3}}{a^2b^{-4}}\\times\\frac{a^{-3}b^4}{12a^6b^{-2}}&=\\frac{a^6b^3}{27a^2b^{-4}}\\times\\frac{a^{-3}b^4}{12a^6b^{-2}}\\\\\\frac{(3a^{-2}b^{-1})^{-3}}{a^2b^{-4}}\\times\\frac{a^{-3}b^4}{12a^6b^{-2}}&=\\frac{a^4b^7}{27}\\times\\frac{a^{-9}b^6}{12}\\\\\\frac{(3a^{-2}b^{-1})^{-3}}{a^2b^{-4}}\\times\\frac{a^{-3}b^4}{12a^6b^{-2}}&=\\frac{a^{-5}b^{13}}{324}\\\\\\frac{(3a^{-2}b^{-1})^{-3}}{a^2b^{-4}}\\times\\frac{a^{-3}b^4}{12a^6b^{-2}}&=\\frac{b^{13}}{324a^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q8-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{(a^{-1}b^4)^{-3}}{(a^2b^{-1})^4}\\times\\dfrac{a^{-2}b}{(ab^{-1})^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{a^{10}b^4}$\n\nMultiply the indices inside each power before applying the quotient and product laws.",
          "worked": "$$\\begin{align*}\\frac{(a^{-1}b^4)^{-3}}{(a^2b^{-1})^4}\\times\\frac{a^{-2}b}{(ab^{-1})^3}&=\\frac{a^3b^{-12}}{a^8b^{-4}}\\times\\frac{a^{-2}b}{a^3b^{-3}}\\\\\\frac{(a^{-1}b^4)^{-3}}{(a^2b^{-1})^4}\\times\\frac{a^{-2}b}{(ab^{-1})^3}&=a^{-5}b^{-8}\\times a^{-5}b^4\\\\\\frac{(a^{-1}b^4)^{-3}}{(a^2b^{-1})^4}\\times\\frac{a^{-2}b}{(ab^{-1})^3}&=a^{-10}b^{-4}\\\\\\frac{(a^{-1}b^4)^{-3}}{(a^2b^{-1})^4}\\times\\frac{a^{-2}b}{(ab^{-1})^3}&=\\frac1{a^{10}b^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q8-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{(a^2)^4}{b^4}\\div\\dfrac{ab^{-2}}{(b^{-1})^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^7}{b^5}$",
          "worked": "$$\\begin{align*}\\frac{(a^2)^4}{b^4}\\div\\frac{ab^{-2}}{(b^{-1})^3}&=\\frac{a^8}{b^4}\\div ab\\\\\\frac{(a^2)^4}{b^4}\\div\\frac{ab^{-2}}{(b^{-1})^3}&=\\frac{a^8}{b^4}\\times\\frac1{ab}\\\\\\frac{(a^2)^4}{b^4}\\div\\frac{ab^{-2}}{(b^{-1})^3}&=\\frac{a^7}{b^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-q8-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\dfrac{ab^{-1}}{4a^2}\\div\\dfrac{(2a^{-3}b)^{-2}}{12a^{-1}b^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{12b^4}{a^8}$\n\nSimplify both fractions, then multiply by the reciprocal of the second.",
          "worked": "$$\\begin{align*}\\frac{ab^{-1}}{4a^2}\\div\\frac{(2a^{-3}b)^{-2}}{12a^{-1}b^3}&=\\frac1{4ab}\\div\\frac{a^6b^{-2}}{48a^{-1}b^3}\\\\\\frac{ab^{-1}}{4a^2}\\div\\frac{(2a^{-3}b)^{-2}}{12a^{-1}b^3}&=\\frac1{4ab}\\div\\frac{a^7}{48b^5}\\\\\\frac{ab^{-1}}{4a^2}\\div\\frac{(2a^{-3}b)^{-2}}{12a^{-1}b^3}&=\\frac1{4ab}\\times\\frac{48b^5}{a^7}\\\\\\frac{ab^{-1}}{4a^2}\\div\\frac{(2a^{-3}b)^{-2}}{12a^{-1}b^3}&=\\frac{12b^4}{a^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q8-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\dfrac{(4xy)^0}{(4xy)^{-1}}\\times\\dfrac{3x^2y^{-6}}{(x^{-2}y^3)^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{12y^7}{x^5}$\n\nUse the zero-index law first, then simplify the powers and quotients.",
          "worked": "$$\\begin{align*}\\frac{(4xy)^0}{(4xy)^{-1}}\\times\\frac{3x^2y^{-6}}{(x^{-2}y^3)^{-4}}&=4xy\\times\\frac{3x^2y^{-6}}{x^8y^{-12}}\\\\\\frac{(4xy)^0}{(4xy)^{-1}}\\times\\frac{3x^2y^{-6}}{(x^{-2}y^3)^{-4}}&=4xy\\times3x^{-6}y^6\\\\\\frac{(4xy)^0}{(4xy)^{-1}}\\times\\frac{3x^2y^{-6}}{(x^{-2}y^3)^{-4}}&=12x^{-5}y^7\\\\\\frac{(4xy)^0}{(4xy)^{-1}}\\times\\frac{3x^2y^{-6}}{(x^{-2}y^3)^{-4}}&=\\frac{12y^7}{x^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p15-q8-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\dfrac{2m^{-3}n^{-2}}{(2mn^4)^{-2}}\\times\\dfrac{3m^{-3}}{(mn^2)^0}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{24n^6}{m^4}$\n\nRaise every factor, including the coefficient, to the power and use $(mn^2)^0=1$.",
          "worked": "$$\\begin{align*}\\frac{2m^{-3}n^{-2}}{(2mn^4)^{-2}}\\times\\frac{3m^{-3}}{(mn^2)^0}&=\\frac{2m^{-3}n^{-2}}{\\frac14m^{-2}n^{-8}}\\times3m^{-3}\\\\\\frac{2m^{-3}n^{-2}}{(2mn^4)^{-2}}\\times\\frac{3m^{-3}}{(mn^2)^0}&=8m^{-1}n^6\\times3m^{-3}\\\\\\frac{2m^{-3}n^{-2}}{(2mn^4)^{-2}}\\times\\frac{3m^{-3}}{(mn^2)^0}&=24m^{-4}n^6\\\\\\frac{2m^{-3}n^{-2}}{(2mn^4)^{-2}}\\times\\frac{3m^{-3}}{(mn^2)^0}&=\\frac{24n^6}{m^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
