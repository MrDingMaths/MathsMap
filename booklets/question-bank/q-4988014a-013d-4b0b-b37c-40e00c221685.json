      {
        "id": "p15-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{-4}y^{-2}\\times x^2y^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x^2y^8}$",
          "worked": "$$\\begin{align*}x^{-4}y^{-2}\\times x^2y^{-6}&=x^{-4+2}y^{-2-6}\\\\x^{-4}y^{-2}\\times x^2y^{-6}&=x^{-2}y^{-8}\\\\x^{-4}y^{-2}\\times x^2y^{-6}&=\\frac{1}{x^2y^8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$p^{-5}q^{-3}\\times pq^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{p^4q^5}$",
          "worked": "$$\\begin{align*}p^{-5}q^{-3}\\times pq^{-2}&=p^{-5+1}q^{-3-2}\\\\p^{-5}q^{-3}\\times pq^{-2}&=p^{-4}q^{-5}\\\\p^{-5}q^{-3}\\times pq^{-2}&=\\frac{1}{p^4q^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$4n^{-2}b\\times 3a^4b^{-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{12a^4}{n^2b^5}$",
          "worked": "$$\\begin{align*}4n^{-2}b\\times3a^4b^{-6}&=12a^4n^{-2}b^{1-6}\\\\4n^{-2}b\\times3a^4b^{-6}&=12a^4n^{-2}b^{-5}\\\\4n^{-2}b\\times3a^4b^{-6}&=\\frac{12a^4}{n^2b^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\ell^2m^{-1}\\times5\\ell^{-4}m^{-2}$",
