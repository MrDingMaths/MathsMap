    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\tan 2\\theta$ in terms of $\\tan\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan 2\\theta=\\dfrac{2\\tan\\theta}{1-\\tan^2\\theta}$",
          "worked": "$$\\tan 2\\theta=\\frac{2\\tan\\theta}{1-\\tan^2\\theta}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the two right-angled triangles to write two equations with $h$ and $\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta=\\dfrac{h}{30},\\quad\\tan 2\\theta=\\dfrac{h}{10}$",
          "worked": "$AC=20+10=30\\text{ m}$.\nIn $\\triangle ACW$, $\\tan\\theta=\\dfrac{h}{30}$.\nIn $\\triangle BCW$, $\\tan 2\\theta=\\dfrac{h}{10}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Use parts **a** and **b** to show $\\dfrac1{10}=\\dfrac{60}{900-h^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{10}=\\dfrac{\\frac{1}{15}}{1-\\frac{h^2}{900}}=\\dfrac{60}{900-h^2}$",
          "worked": "$$\\begin{aligned}\\tan 2\\theta&=\\frac{2\\tan\\theta}{1-\\tan^2\\theta}\\\\\\frac{h}{10}&=\\frac{\\frac{2h}{30}}{1-\\left(\\frac{h}{30}\\right)^2}.\\end{aligned}$$\nSince $h>0$, divide by $h$:\n$$\\begin{aligned}\\frac1{10}&=\\frac{\\frac1{15}}{1-\\frac{h^2}{900}}\\\\\\frac1{10}&=\\frac{\\frac1{15}}{\\frac{900-h^2}{900}}\\\\\\frac1{10}&=\\frac1{15}\\times\\frac{900}{900-h^2}\\\\\\frac1{10}&=\\frac{60}{900-h^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $h=10\\sqrt3$ metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=10\\sqrt3\\text{ m}$",
          "worked": "$$\\begin{aligned}900-h^2&=600\\\\h^2&=300\\\\h&=\\sqrt{300}\\\\h&=10\\sqrt3\\text{ m}.\\end{aligned}$$\nTake the positive root because $h$ is a length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
