        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 14 p14-q7-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (30,0);\n\\coordinate (C) at (45,0);\n\\coordinate (W) at (45,-34);\n\\draw[black,line width=0.8pt] (A)--(C)--(W)--cycle (B)--(W);\n\\draw[black,line width=0.4pt] ($(C)!3mm!(A)$)--($(C)!3mm!(A)+(C)!3mm!(W)-(C)$)--($(C)!3mm!(W)$);\n\\path (A)--(B) node[midway,above=3mm] {$20\\,\\mathrm{m}$};\n\\path (B)--(C) node[midway,above=3mm] {$10\\,\\mathrm{m}$};\n\\path (C)--(W) node[midway,right=2mm] {$h$};\n\\node[above left=1mm] at (A) {$A$};\n\\node[below left=1mm] at (B) {$B$};\n\\node[above right=1mm] at (C) {$C$};\n\\node[below=1mm] at (W) {$W$};\n\\pic[draw=black,line width=0.4pt,angle radius=9mm,angle eccentricity=1.35,\"$\\theta$\"] {angle=W--A--C};\n\\pic[draw=black,line width=0.4pt,angle radius=7mm,angle eccentricity=1.55,\"$2\\theta$\"] {angle=W--B--C};\n\\end{tikzpicture}",
