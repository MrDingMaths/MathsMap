  "content": {
    "id": "p14-q7",
    "type": "question",
    "label": "7",
    "prompt": "Find the missing number to make these equations true.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p14-q7-a-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "4(k+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$3$",
                  "width": 9
                },
                {
                  "type": "math",
                  "latex": ")+3(k-5)=7k-3",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "Let the missing number be $t$.\n$$\\begin{align*}4(k+t)+3(k-5)&=7k+4t-15\\\\4t-15&=-3\\\\4t&=12\\\\t&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p14-q7-b-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "3(2-r)+",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$-2$",
                  "width": 11
                },
                {
                  "type": "math",
                  "latex": "(6-2r)=r-6",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "Let the missing number be $t$.\n$$\\begin{align*}3(2-r)+t(6-2r)&=6+6t+(-3-2t)r\\\\6+6t&=-6\\\\6t&=-12\\\\t&=-2\\end{align*}$$\nThe coefficient of $r$ is $-3-2(-2)=1$, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p14-q7-c-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "2(d-5)-",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$5$",
                  "width": 9
                },
                {
                  "type": "math",
                  "latex": "(1-d)=7d-15",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Let the missing number be $t$.\n$$\\begin{align*}2(d-5)-t(1-d)&=(2+t)d-10-t\\\\2+t&=7\\\\t&=5\\end{align*}$$\nThe constant term is $-10-5=-15$, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
