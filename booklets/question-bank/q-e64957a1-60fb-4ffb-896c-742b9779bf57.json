  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "By grouping in pairs, factorise:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-y^2+x-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y+1)$",
          "worked": "$$\\begin{align*}x^2-y^2+x-y&=(x-y)(x+y)+(x-y)\\\\x^2-y^2+x-y&=(x-y)(x+y+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-y^2+x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y)(x-y+1)$",
          "worked": "$$\\begin{align*}x^2-y^2+x+y&=(x+y)(x-y)+(x+y)\\\\x^2-y^2+x+y&=(x+y)(x-y+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
