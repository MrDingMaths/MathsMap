          {
            "id": "p38-q4-a-figure",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"segmentFill\",\"hex\":\"D4E8FF\",\"reason\":\"identifies the segment whose area is requested\"}],\"reference\":\"source page 38 question 4a\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.8cm,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{segmentFill}{HTML}{D4E8FF}\n\\coordinate (O) at (0,0);\\coordinate (R) at (4,0);\\coordinate (T) at (60:4);\n\\fill[segmentFill] (R) arc[start angle=0,end angle=60,radius=4] -- cycle;\n\\draw[black] (O)--(R) arc[start angle=0,end angle=60,radius=4]--(O);\n\\draw[black] (T)--(R);\n\\path (O)--(R) node[midway,below] {$4$};\n\\node at (30:0.9) {$\\frac{\\pi}{3}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 41,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 38,
              "sourceRegion": "Question 4(a), upper-left figure",
              "description": "Sector with centre at lower left, horizontal lower radius, upper radius at 60 degrees, chord and shaded minor segment.",
              "mathematics": "Radius 4; central angle pi/3. The shaded region is sector minus triangle.",
              "answerVisibility": "Only supplied radius and angle are visible."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8\\pi}{3}-4\\sqrt{3}$",
          "worked": "Segment area = sector area − triangle area.\n$$\\begin{align*}A&=\\frac12r^2\\theta-\\frac12r^2\\sin\\theta\\\\A&=\\frac12(4)^2\\left(\\frac{\\pi}{3}\\right)-\\frac12(4)^2\\sin\\left(\\frac{\\pi}{3}\\right)\\\\A&=\\frac{8\\pi}{3}-8\\left(\\frac{\\sqrt3}{2}\\right)\\\\A&=\\frac{8\\pi}{3}-4\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35,
        "responseSpace": "scaffold"
      },
