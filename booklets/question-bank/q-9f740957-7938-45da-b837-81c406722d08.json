    "prompt": "List all the prime numbers between 100 and 160.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$101, 103, 107, 109, 113, 127, 131, 137, 139, 149, 151, 157$",
      "worked": "A prime number has exactly two factors: 1 and itself. Exclude even numbers and multiples of 3, 5, 7 and 11. Any composite number below 160 has a prime factor among these, since $13^2=169>160$.\n\nThe remaining numbers are $101, 103, 107, 109, 113, 127, 131, 137, 139, 149, 151, 157$.",
