      "evidence": ".booklet-work/reasoning-ratings/calls/percentage-increase-decrease-change-v1/976ed73a0daa5fc95988e4b1c7b228ed53a8cbf7ffc8f0b8de90c2b50f7cef2e-1792560975486/last-message.txt"
