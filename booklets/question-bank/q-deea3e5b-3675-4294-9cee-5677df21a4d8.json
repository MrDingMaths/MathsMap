  "content": {
    "id": "p39-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Calculate the new price if:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$80$ is discounted by $50\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$40$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1-0.50\\\\\\text{Multiplier} &= 0.50\\\\\\text{New price} &= 0.50\\times\\$80\\\\\\text{New price} &= \\$40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$30$ is marked up by $20\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$36$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1+0.20\\\\\\text{Multiplier} &= 1.20\\\\\\text{New price} &= 1.20\\times\\$30\\\\\\text{New price} &= \\$36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$45$ is reduced by $10\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$40.50$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1-0.10\\\\\\text{Multiplier} &= 0.90\\\\\\text{New price} &= 0.90\\times\\$45\\\\\\text{New price} &= \\$40.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\$50$ is $65\\%$ off",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$17.50$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1-0.65\\\\\\text{Multiplier} &= 0.35\\\\\\text{New price} &= 0.35\\times\\$50\\\\\\text{New price} &= \\$17.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\$75$ has a surcharge of $20\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$90$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1+0.20\\\\\\text{Multiplier} &= 1.20\\\\\\text{New price} &= 1.20\\times\\$75\\\\\\text{New price} &= \\$90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\$85$ appreciates by $120\\%$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$187$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1+1.20\\\\\\text{Multiplier} &= 2.20\\\\\\text{New price} &= 2.20\\times\\$85\\\\\\text{New price} &= \\$187\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\$450$ Blu-ray player reduced by $12\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$396$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1-0.12\\\\\\text{Multiplier} &= 0.88\\\\\\text{New price} &= 0.88\\times\\$450\\\\\\text{New price} &= \\$396\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\$12\\,990$ second-hand car depreciates by $15\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$11\\,041.50$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1-0.15\\\\\\text{Multiplier} &= 0.85\\\\\\text{New price} &= 0.85\\times\\$12\\,990\\\\\\text{New price} &= \\$11\\,041.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q13-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\$1\\,725\\,000$ home with an additional $3\\%$ fee",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1\\,776\\,750$",
          "worked": "$$\\begin{align*}\\text{Multiplier} &= 1+0.03\\\\\\text{Multiplier} &= 1.03\\\\\\text{New price} &= 1.03\\times\\$1\\,725\\,000\\\\\\text{New price} &= \\$1\\,776\\,750\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
