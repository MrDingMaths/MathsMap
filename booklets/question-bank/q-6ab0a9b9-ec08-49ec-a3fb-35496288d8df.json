  "content": {
    "id": "p14-ep-12-root",
    "type": "question",
    "label": "12",
    "prompt": "Let $f(x)=x^2+4x+5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-ep-12-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down $f(x+h)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2xh+h^2+4x+4h+5$",
          "worked": "$$\\begin{align*}f(x+h)&=(x+h)^2+4(x+h)+5\\\\&=x^2+2xh+h^2+4x+4h+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-ep-12-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $\\dfrac{f(x+h)-f(x)}{h}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+h+4$",
          "worked": "$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{x^2+2xh+h^2+4x+4h+5-(x^2+4x+5)}{h}\\\\&=\\frac{2xh+h^2+4h}{h}\\\\&=2x+h+4\\quad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-ep-12-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x+4$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\&=\\lim_{h\\to0}(2x+h+4)\\\\&=2x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
