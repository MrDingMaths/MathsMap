    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sin(180^\\circ+\\beta)}{\\cos(360^\\circ-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\tan\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\sin(180^\\circ+\\beta)}{\\cos(360^\\circ-\\beta)}&=\\frac{-\\sin\\beta}{\\cos\\beta}\\\\\\frac{\\sin(180^\\circ+\\beta)}{\\cos(360^\\circ-\\beta)}&=-\\tan\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\cos(180^\\circ-\\beta)}{\\sin(90^\\circ-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{\\cos(180^\\circ-\\beta)}{\\sin(90^\\circ-\\beta)}&=\\frac{-\\cos\\beta}{\\cos\\beta}\\\\\\frac{\\cos(180^\\circ-\\beta)}{\\sin(90^\\circ-\\beta)}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin B\\cos(90^\\circ-B)+\\cos B\\sin(90^\\circ-B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Use $\\cos(90^\\circ-B)=\\sin B$ and $\\sin(90^\\circ-B)=\\cos B$. The expression becomes $\\sin^2B+\\cos^2B=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(180^\\circ+\\beta)\\cos(90^\\circ-\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sin^2\\beta$",
          "worked": "$$\\begin{align*}\\sin(180^\\circ+\\beta)\\cos(90^\\circ-\\beta)&=(-\\sin\\beta)\\sin\\beta\\\\\\sin(180^\\circ+\\beta)\\cos(90^\\circ-\\beta)&=-\\sin^2\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\tan(180^\\circ+\\beta)}{\\sec(180^\\circ-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sin\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\tan(180^\\circ+\\beta)}{\\sec(180^\\circ-\\beta)}&=\\frac{\\tan\\beta}{-\\sec\\beta}\\\\\\frac{\\tan(180^\\circ+\\beta)}{\\sec(180^\\circ-\\beta)}&=-\\frac{\\sin\\beta}{\\cos\\beta}\\cos\\beta\\\\\\frac{\\tan(180^\\circ+\\beta)}{\\sec(180^\\circ-\\beta)}&=-\\sin\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p15-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\cos(360^\\circ+\\beta)}{\\tan(90^\\circ-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\cos(360^\\circ+\\beta)}{\\tan(90^\\circ-\\beta)}&=\\frac{\\cos\\beta}{\\cot\\beta}\\\\\\frac{\\cos(360^\\circ+\\beta)}{\\tan(90^\\circ-\\beta)}&=\\cos\\beta\\frac{\\sin\\beta}{\\cos\\beta}\\\\\\frac{\\cos(360^\\circ+\\beta)}{\\tan(90^\\circ-\\beta)}&=\\sin\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
