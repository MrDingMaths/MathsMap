  "content": {
    "id": "p17-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Suppose that $a$, $b$ and $c$ are positive. By locating the axial intercepts, sketch the graphs of the lines given by the equations below:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$ax+by=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A descending line through $(\\frac ca,0)$ and $(0,\\frac cb)$.",
          "worked": "For the $x$-intercept, set $y=0$:\n$$\\begin{align*}ax+b(0)&=c\\\\ax&=c\\\\x&=\\frac ca.\\end{align*}$$\nFor the $y$-intercept, set $x=0$:\n$$\\begin{align*}a(0)+by&=c\\\\by&=c\\\\y&=\\frac cb.\\end{align*}$$\nBoth intercepts are positive. Draw the straight line through them.",
          "solutionDiagrams": [
            {
              "id": "p17-q12-a-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 17; teacher page 69; p17-q12-a\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-1.6,-1.35) rectangle (2.2,1.75);\n\\draw[<->,line width=0.5pt] (-1.45,0)--(1.85,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-1.2)--(0,1.5) node[above] {$y$};\n\\draw[line width=0.8pt,domain=-1.2:1.8] plot (\\x,{0.8-0.6666667*\\x});\n\\node[left,fill=white,inner sep=1pt] at (0,0.8) {$(0,\\frac cb)$};\n\\node[above left,fill=white,inner sep=1pt] at (1.2,0) {$(\\frac ca,0)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 65,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 17,
                "sourceRegion": "13F question 12(a); teacher PDF page 69",
                "description": "Schematic symbolic-intercept graph with arrowed axes, no ticks or grid, and a descending line.",
                "mathematics": "Positive intercepts c/a and c/b; normalized schematic coordinates do not assign numerical values to a, b or c.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 126
      },
      {
        "id": "p17-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$-ax+by=-c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An ascending line through $(\\frac ca,0)$ and $(0,-\\frac cb)$.",
          "worked": "For the $x$-intercept, set $y=0$:\n$$\\begin{align*}-ax+b(0)&=-c\\\\-ax&=-c\\\\x&=\\frac ca.\\end{align*}$$\nFor the $y$-intercept, set $x=0$:\n$$\\begin{align*}-a(0)+by&=-c\\\\by&=-c\\\\y&=-\\frac cb.\\end{align*}$$\nThe $x$-intercept is positive and the $y$-intercept is negative. Draw the straight line through them.",
