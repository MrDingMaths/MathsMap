  "content": {
    "id": "p29-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Solve these equations for $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{mx+n}{a}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ab-n}{m}$",
          "worked": "$$\\begin{align*}mx+n&=ab\\\\mx&=ab-n\\\\x&=\\frac{ab-n}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p29-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$m(x-n)=p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{p+mn}{m}$",
          "worked": "$$\\begin{align*}mx-mn&=p\\\\mx&=p+mn\\\\x&=\\frac{p+mn}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p29-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$a(bx-c)=d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ac+d}{ab}$",
          "worked": "$$\\begin{align*}abx-ac&=d\\\\abx&=ac+d\\\\x&=\\frac{ac+d}{ab}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p29-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$mx-n=px+q$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{n+q}{m-p}$\n\nCollect the $x$ terms and factorise.",
          "worked": "$$\\begin{align*}mx-px-n&=q\\\\mx-px&=n+q\\\\x(m-p)&=n+q\\\\x&=\\frac{n+q}{m-p}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p29-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x}{a}+\\dfrac{b}{c}=d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{acd-ab}{c}$",
          "worked": "Multiply both sides by $ac$.\n$$\\begin{align*}cx+ab&=acd\\\\cx&=acd-ab\\\\x&=\\frac{acd-ab}{c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p29-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{m(x+n)}{a}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{ab-mn}{m}$",
          "worked": "$$\\begin{align*}m(x+n)&=ab\\\\mx+mn&=ab\\\\mx&=ab-mn\\\\x&=\\frac{ab-mn}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
