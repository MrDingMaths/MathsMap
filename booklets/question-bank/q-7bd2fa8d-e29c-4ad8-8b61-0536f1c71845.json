    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q66",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan x\\cot x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan x\\cot x&=\\frac{\\sin x}{\\cos x}\\cdot\\frac{\\cos x}{\\sin x}\\\\\\tan x\\cot x&=1\\end{align*}$$\n\nValid where the original expression is defined: $\\sin x\\ne0$ and $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q67",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin x\\operatorname{cosec}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin x\\operatorname{cosec}x&=\\sin x\\cdot\\frac{1}{\\sin x}\\\\\\sin x\\operatorname{cosec}x&=1\\end{align*}$$\n\nValid for $\\sin x\\ne0$, the domain of the original expression.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q68",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos x\\sec x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos x\\sec x&=\\cos x\\cdot\\frac{1}{\\cos x}\\\\\\cos x\\sec x&=1\\end{align*}$$\n\nValid for $\\cos x\\ne0$, the domain of the original expression.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q69",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot x\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x$",
          "worked": "$$\\begin{align*}\\cot x\\sin x&=\\frac{\\cos x}{\\sin x}\\cdot\\sin x\\\\\\cot x\\sin x&=\\cos x\\end{align*}$$\n\nValid for $\\sin x\\ne0$, the domain of the original expression.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
