    "answer": {
      "short": "$\\frac{4^\\circ\\mathrm{C}}{\\mathrm{hour}}$",
      "worked": "$$\\begin{align*}\\text{Temperature increase} &= (32-20)^\\circ\\mathrm{C}=12^\\circ\\mathrm{C}\\\\\\text{Time} &= (12-9)\\text{ hours}=3\\text{ hours}\\\\\\text{Average increase} &= \\frac{12^\\circ\\mathrm{C}}{3\\text{ hours}}=4^\\circ\\mathrm{C}/\\mathrm{hour}\\end{align*}$$",
      "solutionDiagrams": []
