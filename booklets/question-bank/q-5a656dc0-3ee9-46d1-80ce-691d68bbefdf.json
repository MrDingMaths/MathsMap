      {
        "id": "p23-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write each of $[1;2,2]$ and $[1;2,2,2]$ as a nested fraction. Calculate their values, correct to three decimal places where necessary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[1;2,2]=1+\\dfrac{1}{2+\\frac12}=1.4$.\n\n$[1;2,2,2]=1+\\dfrac{1}{2+\\dfrac{1}{2+\\frac12}}\\approx1.417$.",
          "worked": "Evaluate each fraction from the innermost denominator outwards.\n\n$$\\begin{align*}[1;2,2]&=1+\\dfrac{1}{2+\\frac12}\\\\{[}1;2,2]&=1+\\frac25\\\\{[}1;2,2]&=\\frac75\\\\{[}1;2,2]&=1.4\\end{align*}$$\n\n$$\\begin{align*}[1;2,2,2]&=1+\\dfrac{1}{2+\\dfrac{1}{2+\\frac12}}\\\\&=1+\\dfrac{1}{2+\\frac25}\\\\&=1+\\frac5{12}\\\\&=\\frac{17}{12}\\\\&\\approx1.417\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
