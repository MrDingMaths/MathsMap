    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$14\\times5+21\\times4\\pmod{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}14\\times5+21\\times4&\\equiv2\\times2+0\\times1\\pmod{3}\\\\14\\times5+21\\times4&\\equiv4\\pmod{3}\\\\14\\times5+21\\times4&\\equiv1\\pmod{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$15\\times4+25\\times23\\pmod{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}15\\times4+25\\times23&\\equiv3\\times4+1\\times5\\pmod{6}\\\\15\\times4+25\\times23&\\equiv0+5\\pmod{6}\\\\15\\times4+25\\times23&\\equiv5\\pmod{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$10^5+2^5\\pmod{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}10^5+2^5&\\equiv10^4\\times10+2^4\\times2\\pmod{11}\\\\10^5+2^5&\\equiv1\\times10+5\\times2\\pmod{11}\\\\10^5+2^5&\\equiv10+10\\pmod{11}\\\\10^5+2^5&\\equiv9\\pmod{11}\\end{align*}$$\n\nHere $10^2\\equiv1\\pmod{11}$, so $10^4\\equiv1\\pmod{11}$; also $2^4=16\\equiv5\\pmod{11}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$3+3^2+3^3+3^4\\pmod{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$3^2=9\\equiv4\\pmod{5}$, $3^3\\equiv4\\times3\\equiv2\\pmod{5}$ and $3^4\\equiv2\\times3\\equiv1\\pmod{5}$.\n\n$$\\begin{align*}3+3^2+3^3+3^4&\\equiv3+4+2+1\\pmod{5}\\\\3+3^2+3^3+3^4&\\equiv10\\pmod{5}\\\\3+3^2+3^3+3^4&\\equiv0\\pmod{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
