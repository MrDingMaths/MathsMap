  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A circle has an area of $314\\text{ cm}^2$. Using $\\pi\\approx3.14$, find the approximate value of the radius of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\text{ cm}$",
      "worked": "$$\\begin{align*}A&=\\pi r^2\\\\r^2&=\\frac{A}{\\pi}\\\\r^2&\\approx\\frac{314}{3.14}\\\\r^2&\\approx100\\\\r&\\approx\\sqrt{100}\\\\r&\\approx10\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
