  "content": {
    "id": "p15-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Differentiate each function then determine whether the curve is increasing, decreasing, or stationary at $x=0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x-1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=3(x-1)^2$; $y'(0)=3>0$, so the curve is increasing at $x=0$.",
          "worked": "$$\\begin{align*}y'&=3(x-1)^2\\times1\\\\y'(0)&=3(0-1)^2\\\\y'(0)&=3(-1)^2\\\\y'(0)&=3>0\\end{align*}$$\nThe curve is increasing at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(2x-1)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=8(2x-1)^3$; $y'(0)=-8<0$, so the curve is decreasing at $x=0$.",
          "worked": "$$\\begin{align*}y'&=4(2x-1)^3\\times2\\\\y'&=8(2x-1)^3\\\\y'(0)&=8(2(0)-1)^3\\\\y'(0)&=8(-1)^3\\\\y'(0)&=-8<0\\end{align*}$$\nThe curve is decreasing at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x^2+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4x(x^2+3)$; $y'(0)=0$, so the curve is stationary at $x=0$.",
          "worked": "$$\\begin{align*}y'&=2(x^2+3)\\times2x\\\\y'&=4x(x^2+3)\\\\y'(0)&=4(0)(0^2+3)\\\\y'(0)&=0\\end{align*}$$\nThe curve is stationary at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
