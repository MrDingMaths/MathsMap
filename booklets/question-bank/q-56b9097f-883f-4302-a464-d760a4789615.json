  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find $\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}$ given:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}3\\\\1\\end{pmatrix},\\ \\underset{\\sim}{b}=\\begin{pmatrix}2\\\\4\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=3(2)+1(4)\\\\&=10\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}-8\\\\-5\\end{pmatrix},\\ \\underset{\\sim}{b}=\\begin{pmatrix}6\\\\-14\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=(-8)(6)+(-5)(-14)\\\\&=22\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}6u\\\\-2v\\end{pmatrix},\\ \\underset{\\sim}{b}=\\begin{pmatrix}3v\\\\9u\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=(6u)(3v)+(-2v)(9u)\\\\&=18uv-18uv\\\\&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
