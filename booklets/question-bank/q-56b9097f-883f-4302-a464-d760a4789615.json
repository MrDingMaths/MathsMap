      {
        "id": "p4-q1d",
        "type": "part",
        "label": "d",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}x-1\\\\x-2\\end{pmatrix},\\ \\underset{\\sim}{b}=\\begin{pmatrix}x-1\\\\x+2\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-2x-3$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=(x-1)^2+(x-2)(x+2)\\\\&=x^2-2x+1+x^2-4\\\\&=2x^2-2x-3\\end{aligned}$$",
