  "content": {
    "id": "p44-q20-node",
    "type": "question",
    "label": "20",
    "prompt": "Find the two integers that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q20-a-node",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p44-q20-node-bank-6c9b81da-d3f3-4169-b7c9-1f67f82ebe55",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Have a product of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "-30",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and a sum of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "-1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Hint: List the positive factor pairs of 30. As the product is negative, one factor must be negative.",
                  "marks": []
                },
                {
                  "type": "break"
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6,\\ 5$",
          "worked": "The product is negative, so the signs differ. The factors $6$ and $5$ differ by $1$; the larger magnitude must be negative.\n$$\\begin{align*}(-6)\\times5&=-30\\\\-6+5&=-1\\end{align*}$$\nThe integers are $-6$ and $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q20-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Have a product of $20$ and a sum of $-12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10,\\ -2$",
          "worked": "The product is positive and the sum is negative, so both integers are negative. The factors $10$ and $2$ have sum $12$.\n$$\\begin{align*}(-10)\\times(-2)&=20\\\\-10+(-2)&=-12\\end{align*}$$\nThe integers are $-10$ and $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q20-c-node",
        "type": "part",
        "label": "c",
        "prompt": "Have a product of $18$ and a sum of $-11$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2,\\ -9$",
          "worked": "The product is positive and the sum is negative, so both integers are negative. The factors $2$ and $9$ have sum $11$.\n$$\\begin{align*}(-2)\\times(-9)&=18\\\\-2+(-9)&=-11\\end{align*}$$\nThe integers are $-2$ and $-9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q20-d-node",
        "type": "part",
        "label": "d",
        "prompt": "Have a product of $-84$ and a sum of $-5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7,\\ -12$",
          "worked": "The product is negative, so the signs differ. The factors $12$ and $7$ differ by $5$; the larger magnitude must be negative.\n$$\\begin{align*}7\\times(-12)&=-84\\\\7+(-12)&=-5\\end{align*}$$\nThe integers are $7$ and $-12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q20-e-node",
        "type": "part",
        "label": "e",
        "prompt": "Have a product of $-44$ and a sum of $7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4,\\ 11$",
          "worked": "The product is negative, so the signs differ. The factors $11$ and $4$ differ by $7$; the larger magnitude must be positive.\n$$\\begin{align*}(-4)\\times11&=-44\\\\-4+11&=7\\end{align*}$$\nThe integers are $-4$ and $11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
