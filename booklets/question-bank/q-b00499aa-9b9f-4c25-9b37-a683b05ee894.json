    "children": [
      {
        "id": "p62-q5",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(\\alpha+\\beta)\\cos(\\alpha+\\gamma)-\\cos(\\alpha+\\beta)\\sin(\\alpha+\\gamma)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(\\beta-\\gamma)$",
          "worked": "Use $\\sin U\\cos V-\\cos U\\sin V=\\sin(U-V)$.\n$$\\begin{align*}\\sin(\\alpha+\\beta)\\cos(\\alpha+\\gamma)-\\cos(\\alpha+\\beta)\\sin(\\alpha+\\gamma)&=\\sin\\big((\\alpha+\\beta)-(\\alpha+\\gamma)\\big)\\\\\\sin(\\alpha+\\beta)\\cos(\\alpha+\\gamma)-\\cos(\\alpha+\\beta)\\sin(\\alpha+\\gamma)&=\\sin(\\beta-\\gamma).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p62-q6",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(\\alpha+\\beta)\\cos(\\alpha-\\beta)-\\sin(\\alpha+\\beta)\\sin(\\alpha-\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos(2\\alpha)$",
          "worked": "Use $\\cos U\\cos V-\\sin U\\sin V=\\cos(U+V)$.\n$$\\begin{align*}\\cos(\\alpha+\\beta)\\cos(\\alpha-\\beta)-\\sin(\\alpha+\\beta)\\sin(\\alpha-\\beta)&=\\cos\\big((\\alpha+\\beta)+(\\alpha-\\beta)\\big)\\\\\\cos(\\alpha+\\beta)\\cos(\\alpha-\\beta)-\\sin(\\alpha+\\beta)\\sin(\\alpha-\\beta)&=\\cos(2\\alpha).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p62-q7",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\tan(\\alpha+\\beta)+\\tan(\\alpha-\\beta)}{1-\\tan(\\alpha+\\beta)\\tan(\\alpha-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan(2\\alpha)$",
          "worked": "Use $\\dfrac{\\tan U+\\tan V}{1-\\tan U\\tan V}=\\tan(U+V)$.\n$$\\begin{align*}\\frac{\\tan(\\alpha+\\beta)+\\tan(\\alpha-\\beta)}{1-\\tan(\\alpha+\\beta)\\tan(\\alpha-\\beta)}&=\\tan\\big((\\alpha+\\beta)+(\\alpha-\\beta)\\big)\\\\\\frac{\\tan(\\alpha+\\beta)+\\tan(\\alpha-\\beta)}{1-\\tan(\\alpha+\\beta)\\tan(\\alpha-\\beta)}&=\\tan(2\\alpha).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
