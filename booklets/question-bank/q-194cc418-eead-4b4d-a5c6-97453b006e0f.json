          "inlines": [
            {
              "type": "text",
              "text": "Differentiate the following.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q53-62-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3x^5+2x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=15x^4+2$",
          "worked": "$$\\begin{align*}y'&=3(5x^4)+2\\\\y'&=15x^4+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q53-62-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{4}{x^2}-\\dfrac{3}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-8x^{-3}+\\dfrac32x^{-2}$",
          "worked": "$$\\begin{align*}y&=4x^{-2}-\\frac32x^{-1}\\\\y'&=4(-2)x^{-3}-\\frac32(-1)x^{-2}\\\\y'&=-8x^{-3}+\\frac32x^{-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{3x^2-x^3}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x-x^2$",
          "worked": "$$\\begin{align*}y&=x^2-\\frac13x^3\\\\y'&=2x-\\frac13(3x^2)\\\\y'&=2x-x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x}{5}+\\dfrac5x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac15-5x^{-2}$",
          "worked": "$$\\begin{align*}y&=\\frac15x+5x^{-1}\\\\y'&=\\frac15+5(-1)x^{-2}\\\\y'&=\\frac15-5x^{-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{2x^2}{3}+\\dfrac{3}{2x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac43x-3x^{-3}$",
          "worked": "$$\\begin{align*}y&=\\frac23x^2+\\frac32x^{-2}\\\\y'&=\\frac23(2x)+\\frac32(-2)x^{-3}\\\\y'&=\\frac43x-3x^{-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=4x^2+\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=8x+\\dfrac12x^{-1/2}$",
          "worked": "$$\\begin{align*}y&=4x^2+x^{1/2}\\\\y'&=4(2x)+\\frac12x^{-1/2}\\\\y'&=8x+\\frac12x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\sqrt[3]{x}-4\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac13x^{-2/3}-2x^{-1/2}$",
          "worked": "$$\\begin{align*}y&=x^{1/3}-4x^{1/2}\\\\y'&=\\frac13x^{-2/3}-4\\left(\\frac12x^{-1/2}\\right)\\\\y'&=\\frac13x^{-2/3}-2x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{\\pi x^2+8x+\\sqrt2}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\pi x+4$",
          "worked": "$$\\begin{align*}y&=\\frac\\pi2x^2+4x+\\frac{\\sqrt2}{2}\\\\y'&=\\frac\\pi2(2x)+4+0\\\\y'&=\\pi x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\dfrac{3x^2+\\sqrt{x}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x+\\dfrac1{12}x^{-1/2}$",
          "worked": "$$\\begin{align*}y&=\\frac12x^2+\\frac16x^{1/2}\\\\y'&=\\frac12(2x)+\\frac16\\left(\\frac12x^{-1/2}\\right)\\\\y'&=x+\\frac1{12}x^{-1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q53-62-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=\\dfrac{4x^2}{3}-\\dfrac{3}{4x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac83x+\\dfrac32x^{-3}$",
          "worked": "$$\\begin{align*}y&=\\frac43x^2-\\frac34x^{-2}\\\\y'&=\\frac43(2x)-\\frac34(-2)x^{-3}\\\\y'&=\\frac83x+\\frac32x^{-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
