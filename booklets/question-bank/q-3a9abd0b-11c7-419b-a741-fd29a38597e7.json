  "content": {
    "id": "p12-q6",
    "type": "question",
    "label": "6",
    "prompt": "The curve $y=x^3-3x+2$ has 2 stationary points.\nFind their coordinates and determine their type.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(1,0)$ is a local minimum; $(-1,4)$ is a local maximum.",
