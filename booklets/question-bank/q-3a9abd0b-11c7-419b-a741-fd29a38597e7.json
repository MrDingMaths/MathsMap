            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{dy}{dx}&=3x^2-3\\\\&=3(x^2-1)\\\\&=3(x-1)(x+1)\\end{aligned}",
                "display": true
              }
            ]
          },
