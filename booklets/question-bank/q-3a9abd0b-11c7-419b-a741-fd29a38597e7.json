              },
              {
                "type": "math",
                "latex": "y=1^3-3(1)+2=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "When ",
                "marks": []
              },
              {
                "type": "math",
