            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "At stationary points, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{dy}{dx}=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}3(x-1)(x+1)&=0\\\\x&=1\\text{ or }x=-1\\end{aligned}",
                "display": true
