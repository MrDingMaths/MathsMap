  "content": {
    "id": "p9-q10-response",
    "type": "question",
    "label": "10",
    "prompt": "A postage stamp has an area of $5\\text{ cm}^2$. How many postage stamps will cover an area of $1\\text{ m}^2$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2000$ stamps.",
      "worked": "$$\\begin{align*}1\\text{ m}^2 &= 1\\times100^2\\text{ cm}^2\\\\1\\text{ m}^2 &= 10\\,000\\text{ cm}^2\\\\\\text{Number of stamps} &= 10\\,000\\div5\\\\\\text{Number of stamps} &= 2000\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
