        "children": [],
        "answer": {
          "short": "$2\\le a\\le10$.",
          "worked": "$$\\begin{aligned}\\frac a2-3&\\le2\\\\\\frac a2&\\le5\\\\a&\\le10\\end{aligned}$$\nAnd\n$$\\begin{aligned}-\\left(\\frac a2-3\\right)&\\le2\\\\-\\frac a2&\\le-1\\\\a&\\ge2\\end{aligned}$$\nTherefore $2\\le a\\le10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$14>|8-2x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3<x<11$.",
          "worked": "$$\\begin{aligned}8-2x&<14\\\\-2x&<6\\\\x&>-3\\end{aligned}$$\nAnd\n$$\\begin{aligned}-(8-2x)&<14\\\\-8+2x&<14\\\\2x&<22\\\\x&<11\\end{aligned}$$\nTherefore $-3<x<11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$11\\le|6-5n|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n\\le-1$ or $n\\ge\\frac{17}{5}$.",
          "worked": "$$\\begin{aligned}6-5n&\\ge11\\\\-5n&\\ge5\\\\n&\\le-1\\end{aligned}$$\nOr\n$$\\begin{aligned}-(6-5n)&\\ge11\\\\-6+5n&\\ge11\\\\5n&\\ge17\\\\n&\\ge\\frac{17}{5}\\end{aligned}$$\nTherefore $n\\le-1$ or $n\\ge\\frac{17}{5}$.",
          "solutionDiagrams": []
        },
