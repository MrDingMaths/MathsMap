    "id": "p16-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "If $w:x=2:3$ and $x:y=3:4$ and $y:z=4:5$, then find the ratio $w:z$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$w:z=2:5$.",
      "worked": "$$\\begin{align*}\\frac{w}{z}&=\\frac{w}{x}\\times\\frac{x}{y}\\times\\frac{y}{z}\\\\\\frac{w}{z}&=\\frac{2}{3}\\times\\frac{3}{4}\\times\\frac{4}{5}\\\\\\frac{w}{z}&=\\frac{2}{5}\\end{align*}$$\nTherefore, $w:z=2:5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
