  "content": {
    "id": "p25-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "On average, Melburnians ate 18.34 kg of cheese each in 2001. If the population of Melbourne in 2001 was 3.5 million, what was the total amount of cheese eaten in Melbourne in that year?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$64\\,190\\,000\\text{ kg}$",
      "worked": "$3.5\\text{ million}=3\\,500\\,000$ people.\n\n$$\\begin{align*}18.34\\times3\\,500\\,000&=18.34\\times35\\times100\\,000\\\\18.34\\times3\\,500\\,000&=641.9\\times100\\,000\\\\18.34\\times3\\,500\\,000&=64\\,190\\,000\\end{align*}$$\n\nThe total amount of cheese eaten was $64\\,190\\,000\\text{ kg}$.",
      "solutionDiagrams": []
    },
