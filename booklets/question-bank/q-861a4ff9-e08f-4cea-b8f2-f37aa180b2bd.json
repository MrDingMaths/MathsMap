        "type": "part",
        "label": "a",
        "prompt": "Show that when $x$ is replaced with $-x$ the equation becomes $y=-\\dfrac{2}{x+2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{2}{x+2}$.",
          "worked": "Replacing $x$ with $-x$ gives\n$$\\begin{align*}y&=\\frac{2}{-x-2}\\\\y&=\\frac{2}{-(x+2)}\\\\y&=-\\frac{2}{x+2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
