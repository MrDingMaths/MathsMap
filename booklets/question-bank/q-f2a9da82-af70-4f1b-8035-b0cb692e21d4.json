  "content": {
    "id": "p11-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "If $A = \\{1, 4, 7, 8\\}$ and $B = \\{1, 2, 4, 5, 7\\}$, state whether the following statements are true or false.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$A = B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $8$ is in $A$ but not in $B$, so the sets do not have the same elements.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$|A| = 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $A$ contains four elements: $1$, $4$, $7$ and $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$|B| = 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $B$ contains five elements, so $|B| = 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "$A \\subset B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False; $8$ is in $A$ but not in $B$.",
          "worked": "False. Every element of $A$ would need to be in $B$, but $8 \\in A$ and $8 \\notin B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-e",
        "type": "part",
        "label": "e",
        "prompt": "$A \\cup B = \\{1, 2, 4, 5, 7, 8\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Listing every element in either set once gives $A \\cup B = \\{1, 2, 4, 5, 7, 8\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q17-f",
        "type": "part",
        "label": "f",
        "prompt": "$A \\cap B = \\{1, 4, 7\\}$",
