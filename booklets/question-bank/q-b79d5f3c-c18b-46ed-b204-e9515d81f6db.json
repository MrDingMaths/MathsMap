  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "",
    "prompt": "Find the gradient of the tangent to each curve at the point indicated:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2\\tan^{-1}x$, at $x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\frac{dy}{dx}=\\frac{2}{1+x^2}$$\nAt $x=0$:\n$$m=\\frac{2}{1+0^2}=2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt{3}\\sin^{-1}x$, at $x=\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\frac{dy}{dx}=\\frac{\\sqrt{3}}{\\sqrt{1-x^2}}$$\nAt $x=\\frac{1}{2}$:\n$$\\begin{aligned}m&=\\frac{\\sqrt{3}}{\\sqrt{1-(1/2)^2}}\\\\&=\\frac{\\sqrt{3}}{\\sqrt{3/4}}=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\tan^{-1}(2x)$, at $x=-\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\frac{dy}{dx}=\\frac{2}{1+4x^2}$$\nAt $x=-\\frac{1}{2}$:\n$$m=\\frac{2}{1+4(-1/2)^2}=1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\cos^{-1}\\left(\\frac{x}{2}\\right)$, at $x=\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-\\frac{1/2}{\\sqrt{1-x^2/4}}\\\\&=-\\frac{1}{\\sqrt{4-x^2}}\\end{aligned}$$\nAt $x=\\sqrt{3}$:\n$$m=-\\frac{1}{\\sqrt{4-(\\sqrt{3})^2}}=-1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
