  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the equation of the line through each pair of points $A$ and $B$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(5,3)$ and $B(2,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{4x}{3}-\\frac{11}{3}$",
          "worked": "$$\\begin{align*}m&=\\frac{-1-3}{2-5}\\\\m&=\\frac43\\end{align*}$$\n$$\\begin{align*}y-3&=\\frac43(x-5)\\\\y-3&=\\frac43x-\\frac{20}{3}\\\\y&=\\frac43x-\\frac{11}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(4,1)$ and $B(6,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x-11$",
          "worked": "$$\\begin{align*}m&=\\frac{7-1}{6-4}\\\\m&=3\\end{align*}$$\n$$\\begin{align*}y-1&=3(x-4)\\\\y-1&=3x-12\\\\y&=3x-11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(1,2)$ and $B(2,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x$",
          "worked": "$$\\begin{align*}m&=\\frac{4-2}{2-1}\\\\m&=2\\end{align*}$$\n$$\\begin{align*}y-2&=2(x-1)\\\\y-2&=2x-2\\\\y&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p24-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(-1,6)$ and $B(2,-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3x+3$",
          "worked": "$$\\begin{align*}m&=\\frac{-3-6}{2-(-1)}\\\\m&=-3\\end{align*}$$\n$$\\begin{align*}y-6&=-3(x-(-1))\\\\y-6&=-3x-3\\\\y&=-3x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p24-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(-2,4)$ and $B(1,-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{10x}{3}-\\frac83$",
          "worked": "$$\\begin{align*}m&=\\frac{-6-4}{1-(-2)}\\\\m&=-\\frac{10}{3}\\end{align*}$$\n$$\\begin{align*}y-4&=-\\frac{10}{3}(x-(-2))\\\\y-4&=-\\frac{10}{3}x-\\frac{20}{3}\\\\y&=-\\frac{10}{3}x-\\frac83\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$A(-1,-2)$ and $B(3,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac32x-\\frac12$",
          "worked": "$$\\begin{align*}m&=\\frac{4-(-2)}{3-(-1)}\\\\m&=\\frac32\\end{align*}$$\n$$\\begin{align*}y-(-2)&=\\frac32(x-(-1))\\\\y+2&=\\frac32x+\\frac32\\\\y&=\\frac32x-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
