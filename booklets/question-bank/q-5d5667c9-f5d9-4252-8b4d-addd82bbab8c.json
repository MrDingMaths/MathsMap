  "content": {
    "id": "p58-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "According to Fick's law, diffusion across a cell membrane satisfies:\n$$\\frac{dC}{dt}=k(S-C),$$\nfor some constant $k$, where $C(t)$ is the concentration in the cell and $S$ is the concentration in the surrounding medium.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of this DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=S+Ae^{-kt}$, where $A$ is an arbitrary constant.",
          "worked": "$$\\begin{align*}\\frac{dC}{S-C}&=k\\,dt\\\\-\\ln|S-C|&=kt+C_1\\\\S-C&=Be^{-kt}\\\\C&=S-Be^{-kt}\\\\C&=S+Ae^{-kt},\\end{align*}$$\nwhere $A=-B$ is an arbitrary constant. The equilibrium solution $C=S$ is included when $A=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p58-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose $C(0)=C_0$, where $C_0<S$. Solve the IVP.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=S+(C_0-S)e^{-kt}$.",
          "worked": "$$\\begin{align*}C_0&=S+Ae^0\\\\C_0&=S+A\\\\A&=C_0-S\\\\C&=S+(C_0-S)e^{-kt}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
