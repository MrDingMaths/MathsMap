    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the Euclidean algorithm to find a multiplicative inverse of $9$ modulo $19$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17$",
          "worked": "The Euclidean algorithm gives\n$$\\begin{align*}19&=2\\times9+1,\\\\1&=19-2\\times9.\\end{align*}$$\nHence $-2\\times9\\equiv1\\pmod{19}$. Since $-2\\equiv17\\pmod{19}$, a multiplicative inverse is $17$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve $9x+11\\equiv13\\pmod{19}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\equiv15\\pmod{19}$",
          "worked": "Using the inverse $17$ from part (a),\n$$\\begin{align*}9x+11&\\equiv13\\pmod{19},\\\\9x&\\equiv2\\pmod{19},\\\\17\\cdot9x&\\equiv17\\cdot2\\pmod{19},\\\\x&\\equiv34\\pmod{19},\\\\x&\\equiv15\\pmod{19}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
