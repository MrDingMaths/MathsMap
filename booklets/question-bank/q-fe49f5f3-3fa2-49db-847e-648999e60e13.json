        "prompt": "$\\tan x\\cot x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan x\\cot x&=\\tan x\\times\\frac{1}{\\tan x}\\\\\\tan x\\cot x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin x\\operatorname{cosec}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin x\\operatorname{cosec}x&=\\sin x\\times\\frac{1}{\\sin x}\\\\\\sin x\\operatorname{cosec}x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos x\\sec x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos x\\sec x&=\\cos x\\times\\frac{1}{\\cos x}\\\\\\cos x\\sec x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cot x\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x$",
          "worked": "$$\\begin{align*}\\cot x\\sin x&=\\frac{\\cos x}{\\sin x}\\sin x\\\\\\cot x\\sin x&=\\cos x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
