        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 24, p24-q5-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,draw=black,text=black,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,inner sep=1pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (-1.5,-1.5);\n\\coordinate (B) at (1.5,-1.5);\n\\coordinate (C) at (1.5,1.5);\n\\coordinate (D) at (-1.5,1.5);\n\\draw (0,0) circle ({1.5*sqrt(2)});\n\\draw (A)--(B)--(C)--(D)--cycle;\n\\draw (A)--node[midway,above left=2mm] {$d$}(C);\n\\path (A)--node[midway,left=7mm] {$14$}(D);\n\\path (A)--node[midway,below=7mm] {$14$}(B);\n\\end{tikzpicture}",
