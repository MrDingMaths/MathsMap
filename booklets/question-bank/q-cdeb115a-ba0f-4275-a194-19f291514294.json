        "answer": {
          "short": "$\\frac{3}{199}$",
          "worked": "There are $200$ students in total and $25$ do only Music. The students are selected without replacement.\n$$\\begin{align*}N&=50+45+25+15+20+35+10=200\\\\P(\\text{both only Music})&=\\frac{25}{200}\\times\\frac{24}{199}\\\\P(\\text{both only Music})&=\\frac{3}{199}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
