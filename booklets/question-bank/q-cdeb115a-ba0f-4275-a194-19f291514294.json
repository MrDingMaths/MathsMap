              "inlines": [
                {
                  "type": "text",
                  "text": "do not do History.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{893}{3980}$",
          "worked": "Students outside History are in Geography only, Music only, or Geography and Music only. Select two without replacement.\n$$\\begin{align*}N&=50+45+25+15+20+35+10=200\\\\n(\\text{not History})&=50+25+20=95\\\\P(\\text{both not History})&=\\frac{95}{200}\\times\\frac{94}{199}\\\\P(\\text{both not History})&=\\frac{893}{3980}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
