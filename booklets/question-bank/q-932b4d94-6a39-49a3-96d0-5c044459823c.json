  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find $\\dfrac{dy}{dx}$ using the product rule.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=x\\cos x+\\sin x$",
          "worked": "Let $u=x$, $u'=1$; $v=\\sin x$, $v'=\\cos x$.\n$$\\begin{aligned}\\frac{dy}{dx}&=u'v+uv'\\\\&=\\sin x+x\\cos x\\\\&=x\\cos x+\\sin x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2x\\tan 2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2(\\tan 2x+2x\\sec^2 2x)$",
          "worked": "Let $u=2x$, $u'=2$; $v=\\tan 2x$, $v'=2\\sec^2 2x$.\n$$\\begin{aligned}\\frac{dy}{dx}&=u'v+uv'\\\\&=2\\tan 2x+(2x)(2\\sec^2 2x)\\\\&=2(\\tan 2x+2x\\sec^2 2x)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2\\cos 2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2x(\\cos 2x-x\\sin 2x)$",
          "worked": "Let $u=x^2$, $u'=2x$; $v=\\cos 2x$, $v'=-2\\sin 2x$.\n$$\\begin{aligned}\\frac{dy}{dx}&=u'v+uv'\\\\&=2x\\cos 2x+x^2(-2\\sin 2x)\\\\&=2x(\\cos 2x-x\\sin 2x)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p8-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^3\\sin 3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=3x^2(\\sin 3x+x\\cos 3x)$",
          "worked": "Let $u=x^3$, $u'=3x^2$; $v=\\sin 3x$, $v'=3\\cos 3x$.\n$$\\begin{aligned}\\frac{dy}{dx}&=u'v+uv'\\\\&=3x^2\\sin 3x+x^3(3\\cos 3x)\\\\&=3x^2(\\sin 3x+x\\cos 3x)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
