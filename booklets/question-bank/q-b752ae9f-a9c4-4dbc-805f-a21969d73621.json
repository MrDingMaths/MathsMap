  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=3^x+2$ is translated 3 units downwards. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3^x-1$",
          "worked": "Subtract 3 from the original ordinate.\n$$\\begin{align*}y&=3^x+2-3\\\\y&=3^x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q5b",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=-3^x+1$ is translated 2 units to the right. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3^{x-2}+1$",
          "worked": "Replace $x$ by $x-2$ for a translation 2 units to the right.\n$$y=-3^{x-2}+1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p22-q5c",
        "type": "part",
        "label": "c",
        "prompt": "The graph of $y=2^x-3$ is reflected in the $y$-axis. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2^{-x}-3$",
          "worked": "Replace $x$ by $-x$ for reflection in the $y$-axis.\n$$y=2^{-x}-3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p22-q5d",
        "type": "part",
        "label": "d",
        "prompt": "The graph of $y=-4^x+5$ is reflected in the $x$-axis. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4^x-5$",
          "worked": "Negate the original ordinate for reflection in the $x$-axis.\n$$\\begin{align*}y&=-(-4^x+5)\\\\y&=4^x-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q5e",
        "type": "part",
        "label": "e",
        "prompt": "The graph of $y=2^x+3$ is rotated about the origin by $180^\\circ$. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2^{-x}-3$\n\nReplace $x$ by $-x$ and negate the ordinate.",
          "worked": "A rotation through $180^\\circ$ maps $(x,y)$ to $(-x,-y)$, equivalent to reflection in both axes.\n$$\\begin{align*}y&=-(2^{-x}+3)\\\\y&=-2^{-x}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
