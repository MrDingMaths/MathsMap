        "children": [],
        "answer": {
          "short": "$\\dfrac{dx}{dt}=15t^4-4t^3+2$",
          "worked": "$$\\begin{align*}\\frac{dx}{dt}&=3(5)t^4-4t^3+2\\\\&=15t^4-4t^3+2\\end{align*}$$",
