    "id": "p17-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A line has equation $y=-4x+c$. The point $(6,10)$ is on the line. Find the value of $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=34$.",
      "worked": "Substitute $x=6$ and $y=10$.\n$$\\begin{align*}10&=-4(6)+c\\\\10&=-24+c\\\\c&=34\\end{align*}$$",
      "solutionDiagrams": []
    },
