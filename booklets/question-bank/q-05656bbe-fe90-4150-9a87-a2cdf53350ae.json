  "content": {
    "id": "p30-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find $A$ (exactly) and $\\alpha$ (correct to the nearest minute), if $A>0$ and $0^\\circ\\leq\\alpha<360^\\circ$, and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$A\\cos\\alpha=5$ and $A\\sin\\alpha=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\sqrt{41},\\quad\\alpha\\approx321^\\circ20'$",
          "worked": "$$\\begin{aligned}A^2&=5^2+(-4)^2=41\\\\A&=\\sqrt{41}\\\\\\tan\\alpha&=-\\frac45\\end{aligned}$$\nSince $\\sin\\alpha<0$ and $\\cos\\alpha>0$, $\\alpha$ is in quadrant IV.\n$$\\begin{aligned}\\alpha&=360^\\circ-\\tan^{-1}\\left(\\frac45\\right)\\\\&\\approx321^\\circ20'\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$A\\sin\\alpha=-11$ and $A\\cos\\alpha=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=5\\sqrt5,\\quad\\alpha\\approx259^\\circ42'$",
          "worked": "$$\\begin{aligned}A^2&=(-2)^2+(-11)^2=125\\\\A&=5\\sqrt5\\\\\\tan\\alpha&=\\frac{-11}{-2}=\\frac{11}{2}\\end{aligned}$$\nSince $\\sin\\alpha<0$ and $\\cos\\alpha<0$, $\\alpha$ is in quadrant III.\n$$\\begin{aligned}\\alpha&=180^\\circ+\\tan^{-1}\\left(\\frac{11}{2}\\right)\\\\&\\approx259^\\circ42'\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
