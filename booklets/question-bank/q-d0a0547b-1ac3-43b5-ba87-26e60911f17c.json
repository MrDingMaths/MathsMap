      {
        "id": "p27-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $x\\tan^{-1}x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^{-1}x+\\dfrac{x}{1+x^2}$",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\left(x\\tan^{-1}x\\right)&=1\\cdot\\tan^{-1}x+x\\cdot\\frac{1}{1+x^2}\\\\&=\\tan^{-1}x+\\frac{x}{1+x^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p27-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int_0^1\\tan^{-1}x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac\\pi4-\\dfrac12\\ln2$",
          "worked": "Since\n$$\\int\\left(\\tan^{-1}x+\\frac{x}{1+x^2}\\right)\\,dx=x\\tan^{-1}x+C,$$\n$$\\begin{aligned}\\int\\tan^{-1}x\\,dx&=x\\tan^{-1}x-\\int\\frac{x}{1+x^2}\\,dx\\\\&=x\\tan^{-1}x-\\frac12\\ln(1+x^2)+C.\\end{aligned}$$\nTherefore\n$$\\begin{aligned}\\int_0^1\\tan^{-1}x\\,dx&=\\left[x\\tan^{-1}x-\\frac12\\ln(1+x^2)\\right]_0^1\\\\&=\\left(1\\cdot\\frac\\pi4-\\frac12\\ln2\\right)-0\\\\&=\\frac\\pi4-\\frac12\\ln2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      }
    ]
  },
