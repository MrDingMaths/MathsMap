  "content": {
    "id": "p11-q9",
    "type": "question",
    "label": null,
    "prompt": "The polynomial $P(x)=px^4+qx^3-2x^2+4x+6$ has a double root at $x=-1$. Find the values of $p$ and $q$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=q=8$",
      "worked": "A double root at $x=-1$ gives $P(-1)=0$ and $P'(-1)=0$.\n$$\\begin{align*}P(-1)&=p-q-2-4+6=0\\\\p-q&=0\\\\P'(x)&=4px^3+3qx^2-4x+4\\\\P'(-1)&=-4p+3q+8=0\\end{align*}$$\nUsing $q=p$:\n$$\\begin{align*}-4p+3p+8&=0\\\\p&=8\\\\q&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
