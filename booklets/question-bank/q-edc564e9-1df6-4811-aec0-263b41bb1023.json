  "content": {
    "id": "p31-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Factorise",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{2}-y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y)(x-y)$",
          "worked": "The squared terms are $x^{2}$ and $y^{2}$.\n$$x^{2}-y^{2}=(x+y)(x-y)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x^{2}-y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+y)(2x-y)$",
          "worked": "$$\\begin{align*}4x^{2}-y^{2}&=(2x)^{2}-y^{2}\\\\4x^{2}-y^{2}&=(2x+y)(2x-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^{2}-4y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2y)(x-2y)$",
          "worked": "$$\\begin{align*}x^{2}-4y^{2}&=x^{2}-(2y)^{2}\\\\x^{2}-4y^{2}&=(x+2y)(x-2y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^{2}-9y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+3y)(2x-3y)$",
          "worked": "$$\\begin{align*}4x^{2}-9y^{2}&=(2x)^{2}-(3y)^{2}\\\\4x^{2}-9y^{2}&=(2x+3y)(2x-3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$25x^{2}-16y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x+4y)(5x-4y)$",
          "worked": "$$\\begin{align*}25x^{2}-16y^{2}&=(5x)^{2}-(4y)^{2}\\\\25x^{2}-16y^{2}&=(5x+4y)(5x-4y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
