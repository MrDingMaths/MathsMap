      "short": "$0.5$",
      "worked": "$$\\begin{align*}P(\\text{blue})&=1-\\bigl(P(\\text{red})+P(\\text{green})\\bigr)\\\\P(\\text{blue})&=1-(0.2+0.3)\\\\P(\\text{blue})&=1-0.5\\\\P(\\text{blue})&=0.5\\end{align*}$$",
