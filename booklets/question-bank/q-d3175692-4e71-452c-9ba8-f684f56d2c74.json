  "content": {
    "id": "p7-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "There are 60 cars in a station car park. Of the cars, 22 are Australian-made, 28 are Japanese-made and the rest are European. What is the probability that the first car to leave is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Japanese?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{15}$",
          "worked": "$$\\begin{align*}P(\\text{Japanese})&=\\frac{28}{60}\\\\P(\\text{Japanese})&=\\frac{7}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "not Australian?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{30}$",
          "worked": "$$\\begin{align*}P(\\text{not Australian})&=1-P(\\text{Australian})\\\\P(\\text{not Australian})&=1-\\frac{22}{60}\\\\P(\\text{not Australian})&=\\frac{19}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q26-c",
        "type": "part",
        "label": "c",
        "prompt": "European?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "There are $60-22-28=10$ European cars.\n\n$$\\begin{align*}P(\\text{European})&=\\frac{10}{60}\\\\P(\\text{European})&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q26-d",
        "type": "part",
        "label": "d",
        "prompt": "American?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "There are no American cars, so this event is impossible.\n\n$P(\\text{American})=\\frac{0}{60}=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
