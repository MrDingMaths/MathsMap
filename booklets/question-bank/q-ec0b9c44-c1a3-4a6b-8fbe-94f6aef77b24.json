  "content": {
    "id": "p7-q25-root",
    "type": "question",
    "label": "25",
    "prompt": "A bag contains a set of snooker balls (15 red balls and one each of white, yellow, green, brown, blue, pink and black). What is the probability that one ball selected at random is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15}{22}$",
          "worked": "There are $15+7=22$ balls, of which 15 are red.\n\n$$P(\\text{red})=\\frac{15}{22}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "not red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{22}$",
          "worked": "Seven of the 22 balls are not red.\n\n$$P(\\text{not red})=\\frac{7}{22}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{22}$",
          "worked": "One of the 22 balls is black.\n\n$$P(\\text{black})=\\frac{1}{22}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q25-d",
        "type": "part",
        "label": "d",
        "prompt": "neither red nor white?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{11}$",
          "worked": "The favourable balls are yellow, green, brown, blue, pink and black: 6 balls.\n\n$$\\begin{align*}P(\\text{neither red nor white})&=\\frac{6}{22}\\\\P(\\text{neither red nor white})&=\\frac{3}{11}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
