  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A triangle has sides whose lengths are $\\sqrt{2}$, $\\sqrt{7}$ and 3. Determine if this triangle has a right angle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes, since $(\\sqrt{2})^2+(\\sqrt{7})^2=3^2$.",
      "worked": "$$\\begin{align*}(\\sqrt{2})^2+(\\sqrt{7})^2&=2+7\\\\(\\sqrt{2})^2+(\\sqrt{7})^2&=9\\\\3^2&=9\\end{align*}$$\nSince the sum of the squares of the shorter sides equals the square of the longest side, the triangle has a right angle.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
