  "content": {
    "id": "p72-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The velocity of an object is given by $v=t(t^2-3)^4\\text{ m s}^{-1}$.\nIf the displacement is $0$ after $2\\text{ s}$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p72-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "the equation for the displacement",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(t)=\\dfrac{(t^2-3)^5-1}{10}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p72-q7-a-completion-worked-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}x(t)&=\\int t(t^2-3)^4\\,dt\\\\&=\\frac12\\int 2t(t^2-3)^4\\,dt\\\\&=\\frac{(t^2-3)^5}{10}+C\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p72-q7-a-completion-worked-1",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x(2)=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ":",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p72-q7-a-completion-worked-2",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}0&=\\frac{1^5}{10}+C\\\\C&=-\\frac1{10}\\\\x(t)&=\\frac1{10}\\big[(t^2-3)^5-1\\big]\\text{ m}.\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p72-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "the displacement after $3\\text{ s}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$777.5\\text{ m}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p72-q7-b-completion-worked-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}x(3)&=\\frac1{10}\\big[(3^2-3)^5-1\\big]\\\\&=\\frac1{10}\\big[6^5-1\\big]\\\\&=777.5\\text{ m}.\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
