  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "[Solving equations using the distance definition]\n\nUse the techniques from Question 7 to solve the following equations.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x|=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm6$.",
          "worked": "The distance from 0 is 6.\n\n$x=0\\pm6=\\pm6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p3-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$|-x|=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm3$.",
          "worked": "$|-x|=|x|$, so $|x|=3$.\n\nThe distance from 0 is 3, giving $x=\\pm3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$|2x|=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2$.",
          "worked": "$\\begin{aligned}|2x|&=4\\\\|x|&=2\\end{aligned}$\n\nThe distance from 0 is 2, giving $x=\\pm2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$|x+4|=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=-6$.",
          "worked": "The distance from $-4$ is 2.\n\n$\\begin{aligned}x&=-4\\pm2\\\\x&=-2\\text{ or }-6\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p3-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$|x-5|=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=12$ or $x=-2$.",
          "worked": "The distance from 5 is 7.\n\n$\\begin{aligned}x&=5\\pm7\\\\x&=12\\text{ or }-2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p3-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$|2x+1|=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=-2$.",
          "worked": "$\\begin{aligned}|2x+1|&=3\\\\\\left|x+\\frac12\\right|&=\\frac32\\end{aligned}$\n\nThe distance from $-\\frac12$ is $\\frac32$.\n\n$\\begin{aligned}x&=-\\frac12\\pm\\frac32\\\\x&=1\\text{ or }-2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$|3-2x|=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=-1$.",
          "worked": "$\\begin{aligned}|3-2x|&=5\\\\|2x-3|&=5\\\\\\left|x-\\frac32\\right|&=\\frac52\\end{aligned}$\n\nThe distance from $\\frac32$ is $\\frac52$.\n\n$\\begin{aligned}x&=\\frac32\\pm\\frac52\\\\x&=4\\text{ or }-1\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p3-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$|3x+5|=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7$ or $x=\\frac{11}{3}$.",
          "worked": "$\\begin{aligned}|3x+5|&=16\\\\\\left|x+\\frac53\\right|&=\\frac{16}3\\end{aligned}$\n\nThe distance from $-\\frac53$ is $\\frac{16}3$.\n\n$\\begin{aligned}x&=-\\frac53\\pm\\frac{16}3\\\\x&=\\frac{11}3\\text{ or }-7\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
