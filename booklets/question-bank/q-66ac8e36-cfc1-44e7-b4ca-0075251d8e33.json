    "type": "question",
    "label": "7",
    "prompt": "If 1 litre is equivalent to 1 cubic decimetre ($1\\text{ dm}^3$), what is 890 mL in cubic decimetres?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.89\\text{ dm}^3$",
      "worked": "Since $1000\\text{ mL}=1\\text{ L}$ and $1\\text{ L}=1\\text{ dm}^3$,\n$$\\begin{align*}890\\text{ mL}&=\\frac{890}{1000}\\text{ L}\\\\890\\text{ mL}&=0.89\\text{ L}\\\\890\\text{ mL}&=0.89\\text{ dm}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
