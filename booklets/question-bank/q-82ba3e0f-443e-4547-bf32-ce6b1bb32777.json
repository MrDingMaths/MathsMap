        "answer": {
          "short": "$80$",
          "worked": "$6+3.5=9.5$ and $15.5+3.5=19$. Add both rectangle perimeters and subtract the shared edge twice, since it is internal.\n$$\\begin{align*}P&=2(9.5+10)+2(19+5)-2(3.5)\\\\&=39+48-7\\\\&=80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
