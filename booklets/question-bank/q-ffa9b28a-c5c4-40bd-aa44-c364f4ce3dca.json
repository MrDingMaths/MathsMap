    "children": [
      {
        "id": "p49-q31-36-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+3x-10$ at $x=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-3x-19$. Normal: $y=\\frac{x}{3}-9$.",
          "worked": "$$\\begin{aligned}y\\big|_{x=-3}&=(-3)^2+3(-3)-10=-10\\\\y'&=2x+3\\\\y'\\big|_{x=-3}&=-3\\\\y+10&=-3(x+3)\\\\y&=-3x-19\\\\y+10&=\\frac13(x+3)\\\\y&=\\frac{x}{3}-9\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p49-q31-36-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(2x-1)^2$ at $x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=4x-3$. Normal: $y=-\\frac{x}{4}+\\frac54$.",
          "worked": "$$\\begin{aligned}y\\big|_{x=1}&=(2(1)-1)^2=1\\\\y'&=4(2x-1)\\\\y'\\big|_{x=1}&=4\\\\y-1&=4(x-1)\\\\y&=4x-3\\\\y-1&=-\\frac14(x-1)\\\\y&=-\\frac{x}{4}+\\frac54\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p49-q31-36-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{1}{2x+1}$ at $x=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-2x-3$. Normal: $y=\\frac{x}{2}-\\frac12$.",
          "worked": "$$\\begin{aligned}y\\big|_{x=-1}&=\\frac{1}{2(-1)+1}=-1\\\\y'&=-2(2x+1)^{-2}\\\\y'\\big|_{x=-1}&=-2\\\\y+1&=-2(x+1)\\\\y&=-2x-3\\\\y+1&=\\frac12(x+1)\\\\y&=\\frac{x}{2}-\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p49-q31-36-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(x+1)(2x+1)$ at $x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=7x-1$. Normal: $y=-\\frac{x}{7}+\\frac{43}{7}$.",
          "worked": "$$\\begin{aligned}y\\big|_{x=1}&=(1+1)(2(1)+1)=6\\\\y&=2x^2+3x+1\\\\y'&=4x+3\\\\y'\\big|_{x=1}&=7\\\\y-6&=7(x-1)\\\\y&=7x-1\\\\y-6&=-\\frac17(x-1)\\\\y&=-\\frac{x}{7}+\\frac{43}{7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p49-q31-36-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sqrt{25-x^2}$ at $x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-\\frac34x+\\frac{25}{4}$. Normal: $y=\\frac43x$.",
          "worked": "$$\\begin{aligned}y\\big|_{x=3}&=\\sqrt{25-3^2}=4\\\\y'&=-\\frac{x}{\\sqrt{25-x^2}}\\\\y'\\big|_{x=3}&=-\\frac34\\\\y-4&=-\\frac34(x-3)\\\\y&=-\\frac34x+\\frac{25}{4}\\\\y-4&=\\frac43(x-3)\\\\y&=\\frac43x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p49-q31-36-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{x+1}{x-2}$ at $x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-3x+13$. Normal: $y=\\frac{x}{3}+3$.",
          "worked": "$$\\begin{aligned}y\\big|_{x=3}&=\\frac{3+1}{3-2}=4\\\\y'&=\\frac{(x-2)-(x+1)}{(x-2)^2}\\\\y'&=-\\frac{3}{(x-2)^2}\\\\y'\\big|_{x=3}&=-3\\\\y-4&=-3(x-3)\\\\y&=-3x+13\\\\y-4&=\\frac13(x-3)\\\\y&=\\frac{x}{3}+3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      }
    ]
