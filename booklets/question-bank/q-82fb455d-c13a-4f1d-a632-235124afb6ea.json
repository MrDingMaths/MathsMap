  "content": {
    "id": "p37-q2-content",
    "type": "question",
    "label": "2",
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$5p^2 - 2p \\times 3p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-p^2$",
          "worked": "$$\\begin{align*}5p^2 - 2p \\times 3p &= 5p^2 - 6p^2\\\\&= -p^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4r^2 + 15r^3 \\div (5r)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7r^2$",
          "worked": "$$\\begin{align*}4r^2 + 15r^3 \\div (5r) &= 4r^2 + 3r^2\\\\&= 7r^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$4b + 3 \\times (2b^3 \\div b^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10b$",
          "worked": "$$\\begin{align*}4b + 3 \\times (2b^3 \\div b^2) &= 4b + 3 \\times 2b\\\\&= 4b + 6b\\\\&= 10b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x + \\frac{x^2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x$",
          "worked": "$$\\begin{align*}2x + \\frac{x^2}{x} &= 2x + x\\\\&= 3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{12x^2y}{3x} - 3xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy$",
          "worked": "$$\\begin{align*}\\frac{12x^2y}{3x} - 3xy &= 4xy - 3xy\\\\&= xy\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{16x^2y^2}{8xy} - xy + y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy + y$",
          "worked": "$$\\begin{align*}\\frac{16x^2y^2}{8xy} - xy + y &= 2xy - xy + y\\\\&= xy + y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
