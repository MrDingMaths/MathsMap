  "content": {
    "id": "p9-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find $f'(x)$, given that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$$f(x)=\\frac{1}{1+\\sin x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\dfrac{\\cos x}{(1+\\sin x)^2}$",
          "worked": "Let $u=1$, $u'=0$, $v=1+\\sin x$ and $v'=\\cos x$.\n$$\\begin{align*}f'(x)&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{0(1+\\sin x)-\\cos x}{(1+\\sin x)^2}\\\\&=-\\frac{\\cos x}{(1+\\sin x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$$f(x)=\\frac{\\sin x}{1+\\cos x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=\\dfrac{1}{1+\\cos x}$",
          "worked": "Let $u=\\sin x$, $u'=\\cos x$, $v=1+\\cos x$ and $v'=-\\sin x$.\n$$\\begin{align*}f'(x)&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{\\cos x(1+\\cos x)+\\sin^2x}{(1+\\cos x)^2}\\\\&=\\frac{\\cos x+1}{(1+\\cos x)^2}\\\\&=\\frac{1}{1+\\cos x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p9-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$$f(x)=\\frac{1-\\sin x}{\\cos x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\dfrac{1}{1+\\sin x}$",
          "worked": "Let $u=1-\\sin x$, $u'=-\\cos x$, $v=\\cos x$ and $v'=-\\sin x$.\n$$\\begin{align*}f'(x)&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{-\\cos^2x+(1-\\sin x)\\sin x}{\\cos^2x}\\\\&=\\frac{\\sin x-1}{\\cos^2x}\\\\&=-\\frac{1-\\sin x}{(1-\\sin x)(1+\\sin x)}\\\\&=-\\frac{1}{1+\\sin x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p9-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$$f(x)=\\frac{\\cos x}{\\cos x+\\sin x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\dfrac{1}{(\\cos x+\\sin x)^2}$",
          "worked": "Let $u=\\cos x$, $u'=-\\sin x$, $v=\\cos x+\\sin x$ and $v'=\\cos x-\\sin x$.\n$$\\begin{align*}f'(x)&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{-\\sin x(\\cos x+\\sin x)}{(\\cos x+\\sin x)^2}-\\frac{\\cos x(\\cos x-\\sin x)}{(\\cos x+\\sin x)^2}\\\\&=\\frac{-\\sin^2x-\\cos^2x}{(\\cos x+\\sin x)^2}\\\\&=-\\frac{1}{(\\cos x+\\sin x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
