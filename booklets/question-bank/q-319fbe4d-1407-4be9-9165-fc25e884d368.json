  "content": {
    "id": "p29-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A survey showed that about 70% of people eat Crunchy Muesli for breakfast. If another survey is carried out with 20 people, find the probability that the following numbers of people eat Crunchy Muesli. Give each answer as a percentage, correct to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "12 people eat Crunchy Muesli",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.4\\%$",
          "worked": "Let $X$ be the number who eat Crunchy Muesli, so $X\\sim\\operatorname{Bin}(20,0.7)$.\n$$\\begin{aligned}P(X=12)&=\\binom{20}{12}(0.7)^{12}(0.3)^8\\\\P(X=12)&\\approx11.4\\%.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "13 people eat Crunchy Muesli",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16.4\\%$",
          "worked": "$X\\sim\\operatorname{Bin}(20,0.7)$.\n$$\\begin{aligned}P(X=13)&=\\binom{20}{13}(0.7)^{13}(0.3)^7\\\\P(X=13)&\\approx16.4\\%.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "9 people eat Crunchy Muesli",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.2\\%$",
          "worked": "$X\\sim\\operatorname{Bin}(20,0.7)$.\n$$\\begin{aligned}P(X=9)&=\\binom{20}{9}(0.7)^9(0.3)^{11}\\\\P(X=9)&\\approx1.2\\%.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
