  "content": {
    "id": "p12-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A right-angled triangle has an angle $\\theta$ and perimeter $P$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a formula for the length of its hypotenuse in terms of $\\theta$ and $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\frac{P}{1+\\sin\\theta+\\cos\\theta}$",
          "worked": "Let $L$ be the hypotenuse. The other sides have lengths $L\\cos\\theta$ and $L\\sin\\theta$.\n$$\\begin{align*}P&=L+L\\cos\\theta+L\\sin\\theta\\\\P&=L(1+\\sin\\theta+\\cos\\theta)\\\\L&=\\frac{P}{1+\\sin\\theta+\\cos\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find a formula for the area of the triangle in terms of $\\theta$ and $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p12-q12-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\displaystyle A=\\frac{P^2\\sin\\theta\\cos\\theta}{2(1+\\sin\\theta+\\cos\\theta)^2}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p12-q12-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use half the product of the perpendicular sides and substitute the hypotenuse from part (a).",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Using the hypotenuse $L$ from part (a),\n$$\\begin{align*}A&=\\frac12(L\\cos\\theta)(L\\sin\\theta)\\\\A&=\\frac12L^2\\sin\\theta\\cos\\theta\\\\A&=\\frac12\\left(\\frac{P}{1+\\sin\\theta+\\cos\\theta}\\right)^2\\sin\\theta\\cos\\theta\\\\A&=\\frac{P^2\\sin\\theta\\cos\\theta}{2(1+\\sin\\theta+\\cos\\theta)^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
