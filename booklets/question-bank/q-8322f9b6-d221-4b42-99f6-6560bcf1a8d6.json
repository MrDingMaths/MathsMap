  "content": {
    "id": "p9-f3-root",
    "type": "question",
    "label": "3",
    "prompt": "Expand the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-f3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt{x}+\\sqrt{y})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2\\sqrt{xy}+y$",
          "worked": "$$\\begin{align*}(\\sqrt{x}+\\sqrt{y})^2&=(\\sqrt{x})^2+2\\sqrt{x}\\sqrt{y}+(\\sqrt{y})^2\\\\(\\sqrt{x}+\\sqrt{y})^2&=x+2\\sqrt{xy}+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-f3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-y$",
          "worked": "$$\\begin{align*}(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})&=(\\sqrt{x})^2-(\\sqrt{y})^2\\\\(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})&=x-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-f3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2+\\frac1x$",
          "worked": "$$\\begin{align*}\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)^2&=(\\sqrt{x})^2+2\\sqrt{x}\\cdot\\frac{1}{\\sqrt{x}}+\\left(\\frac{1}{\\sqrt{x}}\\right)^2\\\\\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)^2&=x+2+\\frac1x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-f3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-\\frac1x$",
          "worked": "$$\\begin{align*}\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)&=(\\sqrt{x})^2-\\left(\\frac{1}{\\sqrt{x}}\\right)^2\\\\\\left(\\sqrt{x}-\\frac{1}{\\sqrt{x}}\\right)\\left(\\sqrt{x}+\\frac{1}{\\sqrt{x}}\\right)&=x-\\frac1x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
