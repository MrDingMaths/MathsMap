            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " be the number of years, with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " a nonnegative integer.",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{align*}1000(1.05)^n &> 2500\\\\(1.05)^n &> 2.5\\\\n &> \\log_{1.05}(2.5)\\end{align*}",
                "display": true
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "The base ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "1.05>1",
                "display": false
              },
              {
                "type": "text",
                "text": ", so the inequality direction is unchanged. Since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "18<\\log_{1.05}(2.5)<19",
                "display": false
              },
              {
                "type": "text",
                "text": ", the balance first exceeds $2500 after 19 whole years.",
