  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A sector with radius $5$ cm has area $10\\pi\\text{ cm}^2$. Find the arc length of the sector.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\pi\\text{ cm}$",
      "worked": "$$\\begin{align*}A&=\\frac{1}{2}r^2\\theta\\\\10\\pi&=\\frac{1}{2}\\times5^2\\times\\theta\\\\\\theta&=\\frac{4\\pi}{5}\\text{ rad}\\\\l&=r\\theta\\\\l&=5\\times\\frac{4\\pi}{5}\\\\l&=4\\pi\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
