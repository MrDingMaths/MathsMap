  "content": {
    "id": "p6-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "$A=\\{1,3,5\\},\\quad B=\\{p,q,r\\}$.\n\nFor each set of ordered pairs, state whether it is a relation from $A$ to $B$. If not, identify the first invalid ordered pair.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\{(1,p),(3,q),(5,r)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes. Every first coordinate belongs to $A$ and every second coordinate belongs to $B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\{(1,p),(3,q)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes. Both ordered pairs have their first coordinate in $A$ and second coordinate in $B$. A relation need not use every element of either set.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\{(1,p),(1,q),(5,r)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes. Every pair belongs to $A\\times B$. A relation may associate the same input with more than one output.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\{(1,p),(3,q),(4,r)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $(4,r)$.",
          "worked": "No. The first invalid pair is $(4,r)$ because $4\\notin A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\{(1,p),(3,s),(5,r)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $(3,s)$.",
          "worked": "No. The first invalid pair is $(3,s)$ because $s\\notin B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\{(1,p),(q,3),(5,r)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; $(q,3)$.",
          "worked": "No. The first invalid pair is $(q,3)$: $q\\notin A$ and $3\\notin B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\{(5,p)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes, because $5\\in A$ and $p\\in B$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
