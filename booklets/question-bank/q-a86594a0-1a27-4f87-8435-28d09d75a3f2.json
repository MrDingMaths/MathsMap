  },
  "content": {
    "id": "p33-q6",
    "type": "question",
    "label": "6",
    "prompt": "Shirley earns \\$765 per week. How much does she earn in:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "5 weeks",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3825",
          "worked": "$$\\begin{align*}\\text{Pay for 5 weeks} &= \\text{Pay per week}\\times\\text{Number of weeks}\\\\\\text{Pay for 5 weeks} &= \\$765\\times5\\\\\\text{Pay for 5 weeks} &= \\$3825\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p33-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "1 year",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$39 780",
          "worked": "$$\\begin{align*}\\text{Annual pay} &= \\text{Pay per week}\\times52\\\\\\text{Annual pay} &= \\$765\\times52\\\\\\text{Annual pay} &= \\$39\\,780\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p33-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "1 month",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3315",
          "worked": "$$\\begin{align*}\\text{Annual pay} &= \\$765\\times52\\\\\\text{Annual pay} &= \\$39\\,780\\\\\\text{Monthly pay} &= \\frac{\\text{Annual pay}}{12}\\\\\\text{Monthly pay} &= \\frac{\\$39\\,780}{12}\\\\\\text{Monthly pay} &= \\$3315\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q6-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p33-q6-d-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "For part ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "c",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": ", a student multiplied weekly pay by 4. Explain why this is incorrect.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Four weeks is not a month.",
          "worked": "There are 52 weeks and 12 months in a year, so a month averages $\\frac{52}{12}$ weeks. Multiplying weekly pay by 4 gives pay for four weeks, rather than monthly pay.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
