  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A circle has radius $6$ cm. If the angle subtended at the centre is $120^\\circ$, find in exact form the",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "length of the arc.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\pi\\text{ cm}$",
          "worked": "$$\\begin{align*}\\theta&=120\\times\\frac{\\pi}{180}=\\frac{2\\pi}{3}\\text{ rad}\\\\l&=r\\theta\\\\l&=6\\times\\frac{2\\pi}{3}\\\\l&=4\\pi\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "area of the sector.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}\\theta&=120\\times\\frac{\\pi}{180}=\\frac{2\\pi}{3}\\text{ rad}\\\\A&=\\frac{1}{2}r^2\\theta\\\\A&=\\frac{1}{2}\\times6^2\\times\\frac{2\\pi}{3}\\\\A&=12\\pi\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
