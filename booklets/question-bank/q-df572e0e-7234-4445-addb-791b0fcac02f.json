  "content": {
    "id": "routine-arithmetic-r9-linked-conditions-1-root",
    "type": "question",
    "label": null,
    "prompt": "The 2nd term of an arithmetic sequence is 9 and the 6th term is 25. Find the sum of the first 10 terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$230$",
      "worked": "$$\\begin{align*}a_2&=a+d=9\\qquad(1)\\\\a_6&=a+5d=25\\qquad(2)\\end{align*}$$\n\n$(2)-(1)$:\n\n$$\\begin{align*}4d&=16\\\\d&=4\\end{align*}$$\n\nSubstitute $d=4$ into (1):\n\n$$\\begin{align*}a+4&=9\\\\a&=5\\end{align*}$$\n\n$$\\begin{align*}S_{10}&=\\frac{10}{2}\\bigl(2(5)+(10-1)(4)\\bigr)\\\\&=230\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
