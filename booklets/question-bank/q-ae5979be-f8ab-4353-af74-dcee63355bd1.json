  "content": {
    "id": "p28-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The number of bacteria, $N$, in a certain culture is halving every hour, so $N=A\\times\\left(\\frac12\\right)^t$, where $t$ is the time in hours after 2 p.m. on a particular day. Assume that there are initially 1000 bacteria.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "State the value of $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=1000$.",
          "worked": "At $t=0$, $N=A\\times\\left(\\frac12\\right)^0=A$. The initial number is 1000, so $A=1000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p28-q7-b",
        "type": "group",
        "label": "b",
        "prompt": "Estimate the number of bacteria in the culture, to the nearest whole bacterium, when:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q7-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$t=2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "250 bacteria.",
              "worked": "$$\\begin{align*}N&=1000\\times\\left(\\frac12\\right)^2\\\\N&=1000\\times\\frac14\\\\N&=250\\end{align*}$$\nThere are 250 bacteria.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p28-q7-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$t=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "125 bacteria.",
              "worked": "$$\\begin{align*}N&=1000\\times\\left(\\frac12\\right)^3\\\\N&=1000\\times\\frac18\\\\N&=125\\end{align*}$$\nThere are 125 bacteria.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p28-q7-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$t=5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Approximately 31 bacteria.",
              "worked": "$$\\begin{align*}N&=1000\\times\\left(\\frac12\\right)^5\\\\N&=1000\\times\\frac1{32}\\\\N&=31.25\\\\N&\\approx31\\end{align*}$$\nThere are approximately 31 bacteria, to the nearest whole bacterium.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      }
    ]
  },
