    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q16-a-node",
        "type": "group",
        "label": "a",
        "prompt": "Find the income tax payable on:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q16-a-i-node",
            "type": "part",
            "label": "i",
            "prompt": "$\\$8000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$0$",
              "worked": "The income is below the tax-free threshold of $\\$12\\,000$, so no income tax is payable.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p13-q16-a-ii-node",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$14\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$300$",
              "worked": "The first $\\$12\\,000$ is tax-free.\n$$\\begin{align*}\\text{Tax}&=(14\\,000-12\\,000)\\times0.15\\\\\\text{Tax}&=\\$300\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p13-q16-a-iii-node",
            "type": "part",
            "label": "iii",
            "prompt": "$\\$36\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$4200$",
              "worked": "The first $\\$12\\,000$ is tax-free.\n$$\\begin{align*}\\text{Tax on next }\\$18\\,000&=18\\,000\\times0.15\\\\\\text{Tax on next }\\$18\\,000&=\\$2700\\\\\\text{Tax on remaining }\\$6000&=6000\\times0.25\\\\\\text{Tax on remaining }\\$6000&=\\$1500\\\\\\text{Total tax}&=2700+1500\\\\\\text{Total tax}&=\\$4200\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 35
          },
          {
            "id": "p13-q16-a-iv-node",
            "type": "part",
            "label": "iv",
            "prompt": "$\\$200\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$57\\,700$",
              "worked": "The first $\\$12\\,000$ is tax-free.\n$$\\begin{align*}\\text{Tax on next }\\$18\\,000&=18\\,000\\times0.15\\\\\\text{Tax on next }\\$18\\,000&=\\$2700\\\\\\text{Tax on next }\\$45\\,000&=45\\,000\\times0.25\\\\\\text{Tax on next }\\$45\\,000&=\\$11\\,250\\\\\\text{Tax on remaining }\\$125\\,000&=125\\,000\\times0.35\\\\\\text{Tax on remaining }\\$125\\,000&=\\$43\\,750\\\\\\text{Total tax}&=2700+11\\,250+43\\,750\\\\\\text{Total tax}&=\\$57\\,700\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p13-q16-b-node",
        "type": "part",
        "label": "b",
        "prompt": "What percentage, to 2 decimal places, of each person’s income was paid in income tax in parts i–iv of part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "i $0.00\\%$; ii $2.14\\%$; iii $11.67\\%$; iv $28.85\\%$.",
          "worked": "For each person, divide the tax by the income and multiply by $100\\%$.\n$$\\begin{align*}\\text{i: percentage}&=\\frac{0}{8000}\\times100\\%=0.00\\%\\\\\\text{ii: percentage}&=\\frac{300}{14\\,000}\\times100\\%\\approx2.14\\%\\\\\\text{iii: percentage}&=\\frac{4200}{36\\,000}\\times100\\%\\approx11.67\\%\\\\\\text{iv: percentage}&=\\frac{57\\,700}{200\\,000}\\times100\\%=28.85\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q16-c-node",
        "type": "group",
        "label": "c",
        "prompt": "Find the income if the income tax on it was:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q16-c-i-node",
            "type": "part",
            "label": "i",
            "prompt": "$\\$1260$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$20\\,400$",
              "worked": "Tax up to $\\$30\\,000$ is $18\\,000\\times0.15=\\$2700$, so this income is in the 15% bracket.\n$$\\begin{align*}\\text{Income above }\\$12\\,000&=1260\\div0.15\\\\\\text{Income above }\\$12\\,000&=\\$8400\\\\\\text{Income}&=12\\,000+8400\\\\\\text{Income}&=\\$20\\,400\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p13-q16-c-ii-node",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$3420$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$32\\,880$",
              "worked": "Tax on the first $\\$30\\,000$ is $\\$2700$; tax on the first $\\$75\\,000$ is $\\$13\\,950$. This income is in the 25% bracket.\n$$\\begin{align*}\\text{Tax above }\\$30\\,000&=3420-2700\\\\\\text{Tax above }\\$30\\,000&=\\$720\\\\\\text{Income above }\\$30\\,000&=720\\div0.25\\\\\\text{Income above }\\$30\\,000&=\\$2880\\\\\\text{Income}&=30\\,000+2880\\\\\\text{Income}&=\\$32\\,880\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          },
          {
            "id": "p13-q16-c-iii-node",
            "type": "part",
            "label": "iii",
            "prompt": "$\\$13\\,950$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$75\\,000$",
              "worked": "$$\\begin{align*}\\text{Tax through }\\$30\\,000&=18\\,000\\times0.15\\\\\\text{Tax through }\\$30\\,000&=\\$2700\\\\\\text{Tax through }\\$75\\,000&=2700+45\\,000\\times0.25\\\\\\text{Tax through }\\$75\\,000&=\\$13\\,950\\end{align*}$$\nTherefore the income is $\\$75\\,000$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p13-q16-c-iv-node",
            "type": "part",
            "label": "iv",
            "prompt": "$\\$14\\,650$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$77\\,000$",
              "worked": "Tax on the first $\\$75\\,000$ is $2700+11\\,250=\\$13\\,950$. The remaining tax is charged at 35%.\n$$\\begin{align*}\\text{Tax above }\\$75\\,000&=14\\,650-13\\,950\\\\\\text{Tax above }\\$75\\,000&=\\$700\\\\\\text{Income above }\\$75\\,000&=700\\div0.35\\\\\\text{Income above }\\$75\\,000&=\\$2000\\\\\\text{Income}&=75\\,000+2000\\\\\\text{Income}&=\\$77\\,000\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          }
        ]
      }
    ]
