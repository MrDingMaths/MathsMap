  "content": {
    "id": "v2-47966955a96ba42-p4-j8-034812-root",
    "type": "question",
    "label": null,
    "prompt": "If $y=\\ln\\left(\\dfrac{e^{2x}}{1+e^x}\\right)$:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-47966955a96ba42-p4-j8-034812-j8-a",
        "type": "part",
        "label": "a",
        "prompt": "show that $y=2x-\\ln(1+e^x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-\\ln(1+e^x)$",
          "worked": "$$\\begin{align*}y&=\\ln(e^{2x})-\\ln(1+e^x)\\\\&=2x-\\ln(1+e^x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-47966955a96ba42-p4-j8-034812-j8-b",
        "type": "part",
        "label": "b",
        "prompt": "hence show that $\\dfrac{dy}{dx}=\\dfrac{2+e^x}{1+e^x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{2+e^x}{1+e^x}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2-\\frac{e^x}{1+e^x}\\\\&=\\frac{2(1+e^x)-e^x}{1+e^x}\\\\&=\\frac{2+e^x}{1+e^x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
