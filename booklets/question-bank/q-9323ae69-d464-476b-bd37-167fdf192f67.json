  "content": {
    "id": "p23-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "For each function $f(x)$, find the inverse function $g(x)$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^3-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=\\sqrt[3]{x+2}$",
          "worked": "Interchange $x$ and $y$, then make $y$ the subject.\n\n$$\\begin{aligned}x&=y^3-2\\\\y^3&=x+2\\\\y&=\\sqrt[3]{x+2}\\\\g(x)&=\\sqrt[3]{x+2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2-x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=\\sqrt[3]{2-x}$",
          "worked": "Interchange $x$ and $y$, then make $y$ the subject.\n\n$$\\begin{aligned}x&=2-y^3\\\\y^3&=2-x\\\\y&=\\sqrt[3]{2-x}\\\\g(x)&=\\sqrt[3]{2-x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=32x^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=\\sqrt[5]{\\dfrac{x}{32}}$",
          "worked": "Interchange $x$ and $y$, then make $y$ the subject.\n\n$$\\begin{aligned}x&=32y^5\\\\y^5&=\\frac{x}{32}\\\\y&=\\sqrt[5]{\\frac{x}{32}}\\\\g(x)&=\\sqrt[5]{\\frac{x}{32}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
