  "content": {
    "id": "v2-cee63-p57-practice-slot-12-root",
    "type": "question",
    "label": null,
    "prompt": "Jo buys 25 notebooks for \\$48.75. She sells each notebook for \\$2.40.\nWork out Jo's percentage profit. Give your answer to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$23.08\\%$ profit",
      "worked": "$$\\begin{align*}\\text{Selling price}&=25\\times\\$2.40\\\\\\text{Selling price}&=\\$60.00\\\\\\text{Profit}&=\\$60.00-\\$48.75\\\\\\text{Profit}&=\\$11.25\\\\\\text{Percentage profit}&=\\frac{11.25}{48.75}\\times100\\%\\\\\\text{Percentage profit}&\\approx23.08\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
