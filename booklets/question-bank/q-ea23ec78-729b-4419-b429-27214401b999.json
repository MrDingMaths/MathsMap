              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "For example, the only possible rational roots of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "5x^3-6x^2+x+2",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " are ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\pm\\frac25,\\ \\pm\\frac15,\\ \\pm2,\\ \\pm1",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            },
            {
              "id": "p51-q51-c-task",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hence, prove ",
                  "marks": []
