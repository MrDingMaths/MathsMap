  "content": {
    "id": "p49-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "In a raffle in which there are 200 tickets, the first prize is drawn and then the second prize is drawn without replacing the winning ticket. If you buy 15 tickets, find the probability that you win:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "both prizes,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{3980}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q18-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{both prizes})&=\\frac{15}{200}\\times\\frac{14}{199}\\\\P(\\text{both prizes})&=\\frac{210}{39800}\\\\P(\\text{both prizes})&=\\frac{21}{3980}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p49-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one prize.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{144}{995}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q18-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{at least one prize})&=1-P(\\text{no prizes})\\\\P(\\text{at least one prize})&=1-\\frac{185}{200}\\times\\frac{184}{199}\\\\P(\\text{at least one prize})&=1-\\frac{34040}{39800}\\\\P(\\text{at least one prize})&=\\frac{144}{995}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
