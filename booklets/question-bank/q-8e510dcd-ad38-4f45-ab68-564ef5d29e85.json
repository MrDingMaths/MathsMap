  "content": {
    "id": "p23-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In a theme park, the cost of an adult ticket is 1.5 times that of a child ticket. If a family of 2 adults and 3 children paid $\\$48$, how much does an adult ticket cost?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$12$",
      "worked": "Let $x$ be the cost of a child ticket in dollars. An adult ticket costs $1.5x$ dollars.\n\n$$\\begin{align*}2(1.5x)+3x&=48\\\\3x+3x&=48\\\\6x&=48\\\\x&=8\\end{align*}$$\n\nAn adult ticket costs $1.5\\times8=12$ dollars, so the answer is $\\$12$.\n\nCheck: $2\\times12+3\\times8=48$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
