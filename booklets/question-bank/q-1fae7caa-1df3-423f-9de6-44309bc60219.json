    "type": "question",
    "label": null,
    "prompt": "Each exterior angle of a regular polygon is $15^{\\circ}$. Find the number of sides of the polygon.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "24 sides",
      "worked": "$$\\begin{align*}15^{\\circ}&=\\frac{360^{\\circ}}{n}\\\\n&=\\frac{360^{\\circ}}{15^{\\circ}}\\\\n&=24\\end{align*}$$\n\nThe polygon has 24 sides.",
