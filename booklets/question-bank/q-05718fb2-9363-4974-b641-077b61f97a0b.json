  "content": {
    "id": "v2-954e5-p15-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Solve $4x^3-3x^2-36x+27=0$ if the sum of 2 of its roots is 0.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\dfrac34,\\ \\pm3$.",
      "worked": "Let the roots be $\\alpha,-\\alpha,\\beta$.\n\nSum of roots:\n$$\\begin{align*}\\alpha-\\alpha+\\beta&=\\frac34\\\\\\beta&=\\frac34\\end{align*}$$\nProduct of roots:\n$$\\begin{align*}-\\alpha^2\\beta&=-\\frac{27}{4}\\\\-\\alpha^2\\left(\\frac34\\right)&=-\\frac{27}{4}\\\\\\alpha^2&=9\\\\\\alpha&=\\pm3\\end{align*}$$\nHence $x=\\frac34,\\pm3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
