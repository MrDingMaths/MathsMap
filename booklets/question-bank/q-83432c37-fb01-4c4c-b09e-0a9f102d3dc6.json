        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 students",
          "worked": "$$\\begin{aligned}\\text{Both}&=80-15-35-21\\\\\\text{Both}&=9\\end{aligned}$$",
          "solutionDiagrams": [
            {
              "id": "p42-q3-completed-diagram",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 42 p42-q3 completed diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line width=0.8pt,text=black,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,0) rectangle (70,47);\n\\draw (24,26) circle (18);\n\\draw (46,26) circle (18);\n\\node at (20,32) {Italian};\n\\node at (51,32) {French};\n\\node at (20,20) {15};\n\\node at (35,25) {9};\n\\node at (51,20) {35};\n\\node[anchor=west] at (1,4) {Neither $=21$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 70,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 42,
                "sourceRegion": "Question 3, left-hand Venn diagram",
                "description": "Completed Venn diagram with 9 in the intersection and all supplied labels and counts retained.",
                "mathematics": "15+9+35+21=80.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p42-q3-a",
        "type": "part",
        "label": "b",
        "prompt": "Speaks neither French nor Italian.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{80}$",
          "worked": "$$P(\\text{neither})=\\frac{21}{80}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q3-b",
        "type": "part",
        "label": "c",
        "prompt": "Speaks Italian or French, but not both.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "$$\\begin{aligned}P(\\text{Italian or French, but not both})&=\\frac{15+35}{80}\\\\&=\\frac{50}{80}\\\\&=\\frac{5}{8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q3-c",
        "type": "part",
        "label": "d",
        "prompt": "Speaks Italian and French.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{80}$",
          "worked": "$$P(\\text{Italian and French})=\\frac{9}{80}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q3-d",
        "type": "part",
        "label": "e",
        "prompt": "Speaks Italian or French.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{59}{80}$",
          "worked": "$$\\begin{aligned}P(\\text{Italian or French})&=\\frac{15+9+35}{80}\\\\&=\\frac{59}{80}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
