  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "By factorising the left-hand side, show that the quadratic inequality $x^2+4x+4\\le0$ has exactly one solution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-2$ only, since $(x+2)^2\\le0$ requires $(x+2)^2=0$.",
      "worked": "$$\\begin{align*}x^2+4x+4&\\le0\\\\(x+2)^2&\\le0.\\end{align*}$$\nA real square is non-negative, so $(x+2)^2=0$.\n$$\\begin{align*}x+2&=0\\\\x&=-2.\\end{align*}$$\nTherefore, there is exactly one solution: $x=-2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
