    "type": "question",
    "label": "3",
    "prompt": "Find the volume and surface area of a sphere of radius $3\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$V=36\\pi\\text{ cm}^3$, $A=36\\pi\\text{ cm}^2$.",
      "worked": "$$\\begin{align*}V&=\\frac{4}{3}\\pi r^3\\\\V&=\\frac{4}{3}\\pi(3)^3\\\\V&=36\\pi\\text{ cm}^3\\end{align*}$$\n$$\\begin{align*}A&=4\\pi r^2\\\\A&=4\\pi(3)^2\\\\A&=36\\pi\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
