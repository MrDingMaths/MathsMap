          "inlines": [
            {
              "type": "math",
              "latex": "\\alpha=\\cos\\left(\\frac{2\\pi}9\\right),\\quad\\beta=\\cos\\left(\\frac{4\\pi}9\\right),\\quad\\gamma=\\cos\\left(\\frac{8\\pi}9\\right)",
              "display": false
            }
          ]
        },
        {
          "id": "p56-q9-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
