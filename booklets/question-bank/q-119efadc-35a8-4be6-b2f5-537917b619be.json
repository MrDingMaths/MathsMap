              "type": "text",
              "text": "Umar and Aiden are both keen runners.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Umar takes 5 minutes to jog around a running track and Aiden takes 4 minutes.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "They start at the finish line at the same time and run until they next both cross the finish line at the same time.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q27-a",
        "type": "part",
        "label": "a",
        "prompt": "How long do they run for?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 minutes",
          "worked": "Multiples of 5: $5,10,15,20,\\ldots$\n\nMultiples of 4: $4,8,12,16,20,\\ldots$\n\nThe LCM is $20$, so they run for 20 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q27-b",
        "type": "part",
        "label": "b",
        "prompt": "How many laps did Aiden run?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 laps",
          "worked": "$$\\begin{align*}\\text{Aiden's laps}&=20\\div4\\\\&=5\\end{align*}$$\n\nAiden ran 5 laps.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q27-c",
        "type": "part",
        "label": "c",
        "prompt": "How many laps did Umar run?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 laps",
          "worked": "$$\\begin{align*}\\text{Umar's laps}&=20\\div5\\\\&=4\\end{align*}$$\n\nUmar ran 4 laps.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
