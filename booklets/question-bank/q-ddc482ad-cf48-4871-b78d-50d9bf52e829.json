      {
        "id": "p8-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $k\\times k!=(k+1)!-k!$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(k+1)!-k!=((k+1)-1)k!=k\\times k!$.",
          "worked": "$$\\begin{align*}\\mathrm{RHS}&=(k+1)!-k!\\\\&=(k+1)k!-k!\\\\&=k!\\big((k+1)-1\\big)\\\\&=k\\times k!\\\\&=\\mathrm{LHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence by considering each individual term as a difference of two terms, sum the series\n$$1\\times1!+2\\times2!+3\\times3!+\\cdots+n\\times n!.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+1)!-1$",
          "worked": "$$\\begin{align*}1\\times1!&=2!-1!\\\\2\\times2!&=3!-2!\\\\3\\times3!&=4!-3!\\\\&\\ \\vdots\\\\n\\times n!&=(n+1)!-n!\\end{align*}$$\nThus\n$$\\begin{align*}S&=(2!-1!)+(3!-2!)+(4!-3!)+\\cdots+((n+1)!-n!)\\\\&=(n+1)!-1!\\\\&=(n+1)!-1.\\end{align*}$$\nThe intermediate factorial terms cancel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
