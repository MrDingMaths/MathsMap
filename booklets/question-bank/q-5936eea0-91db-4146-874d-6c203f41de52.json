  "content": {
    "id": "p51-q18-response",
    "type": "question",
    "label": "3",
    "prompt": "Is it possible for $A\\cap B$ to be equal to $A\\cup B$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes. They are equal when $A=B$.",
      "worked": "Yes. When $A=B$, both the intersection and union equal $A$. Conversely, if the intersection equals the union, no element can belong to only one set, so $A=B$.",
      "solutionDiagrams": []
