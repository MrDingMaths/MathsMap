    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-ex23b-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "{large whole numbers}",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not well-defined.",
          "worked": "“Large” has no agreed numerical boundary, so membership is ambiguous. The collection is not well-defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-ex23b-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "{adults in Australia who like music}",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Well-defined; finite.",
          "worked": "Taking “like music” as each adult’s stated preference, membership can be determined. There are only finitely many adults in Australia, so the set is finite.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-ex23b-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "{fractions between 1 and 2}",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Well-defined; infinite.",
          "worked": "Membership is determined by being a fraction greater than 1 and less than 2. Between any two such fractions there is another fraction, so the set is infinite.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-ex23b-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "{working mobile phones in Australia}",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Well-defined; finite.",
          "worked": "A phone can be checked to determine whether it works and is in Australia. There are only finitely many such phones, so the set is finite.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-ex23b-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "{points on a particular line}",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Well-defined; infinite.",
          "worked": "Whether a point lies on the particular line is unambiguous. Between any two points on the line there is another point, so the set is infinite.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-ex23b-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "{past and present Australian senators}",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Well-defined; finite.",
          "worked": "Records identify who has served as an Australian senator. Only finitely many people have served up to the present, so the set is finite.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p5-ex23b-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "{whole numbers between 1 million and 1 trillion}",
        "layout": "list",
        "columns": null,
