  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "In a school, $\\frac{2}{5}$ of the students are girls. There are 600 boys.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How many girls are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "400 girls",
          "worked": "The fraction of students who are boys is $1-\\frac{2}{5}=\\frac{3}{5}$. Thus three fifths represents 600 boys.\n$$\\begin{align*}\\text{Students in one fifth}&=600\\div3\\\\\\text{Students in one fifth}&=200\\\\\\text{Number of girls}&=2\\times200\\\\\\text{Number of girls}&=400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "How many students are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1000 students",
          "worked": "One fifth represents $600\\div3=200$ students.\n$$\\begin{align*}\\text{Total number of students}&=5\\times200\\\\\\text{Total number of students}&=1000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
