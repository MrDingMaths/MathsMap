  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A fair six-sided die is rolled twice. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "a three is obtained for both rolls",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "The rolls are independent.\n$$\\begin{align*}\\Pr(\\text{three on both rolls})&=\\frac{1}{6}\\times\\frac{1}{6}\\\\\\Pr(\\text{three on both rolls})&=\\frac{1}{36}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "an even number is obtained for both rolls",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "The even outcomes are $2,4,6$, so the probability of an even number on each roll is $\\frac{3}{6}$. The rolls are independent.\n$$\\begin{align*}\\Pr(\\text{even on both rolls})&=\\frac{3}{6}\\times\\frac{3}{6}\\\\\\Pr(\\text{even on both rolls})&=\\frac{1}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "a six is obtained for neither roll.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{36}$",
          "worked": "The probability of not rolling a six is $1-\\frac{1}{6}=\\frac{5}{6}$. The rolls are independent.\n$$\\begin{align*}\\Pr(\\text{six on neither roll})&=\\frac{5}{6}\\times\\frac{5}{6}\\\\\\Pr(\\text{six on neither roll})&=\\frac{25}{36}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
