    "id": "p2-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A music store is offering a $45\\%$ discount during a sale.\n\nCalculate the original marked price of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "a DVD that has a sale price of $\\$13.20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$24$",
          "worked": "The sale price is $100\\%-45\\%=55\\%$ of the original marked price.\n\n$$\\begin{align*}\\text{Original marked price}&=\\frac{\\$13.20}{0.55}\\\\\\text{Original marked price}&=\\$24\\end{align*}$$",
          "solutionDiagrams": []
        },
