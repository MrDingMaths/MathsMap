        "answer": {
          "short": "$\\frac{4pq}{3}$",
          "worked": "$$\\begin{align*}\\frac{48p^2q}{36p}&=\\frac{12p\\times4pq}{12p\\times3}\\\\\\frac{48p^2q}{36p}&=\\frac{4pq}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
