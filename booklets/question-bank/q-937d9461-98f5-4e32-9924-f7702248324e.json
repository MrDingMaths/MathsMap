  "content": {
    "id": "v2-cff70-p23-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the tangent to each curve when $x=0$. Answer in general form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-cff70-p23-practice-slot-8-slot-8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2e^x-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-y+2=0$",
          "worked": "At $x=0$:\n$$\\begin{align*}y&=2e^0-0\\\\y&=2\\end{align*}$$\n$$\\begin{align*}\\frac{dy}{dx}&=2e^x-1\\end{align*}$$\nAt $(0,2)$:\n$$\\begin{align*}m&=2e^0-1\\\\m&=1\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-2&=1(x-0)\\\\y&=x+2\\\\x-y+2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-cff70-p23-practice-slot-8-slot-8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=3^x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ln 3-y+3=0$",
          "worked": "At $x=0$:\n$$\\begin{align*}y&=3^0+2\\\\y&=3\\end{align*}$$\n$$\\begin{align*}\\frac{dy}{dx}&=3^x\\ln 3\\end{align*}$$\nAt $(0,3)$:\n$$\\begin{align*}m&=3^0\\ln 3\\\\m&=\\ln 3\\end{align*}$$\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-3&=\\ln 3(x-0)\\\\y&=x\\ln 3+3\\\\x\\ln 3-y+3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
