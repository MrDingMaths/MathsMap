  "content": {
    "id": "p49-q2",
    "type": "question",
    "label": "2",
    "prompt": "Without division, find the remainder when $P(x)=x^4-x^3+3x^2$ is divided by:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}P(1)&=1^4-1^3+3(1)^2\\\\P(1)&=3\\end{align*}$$\nThe remainder is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$$\\begin{align*}P(2)&=2^4-2^3+3(2)^2\\\\P(2)&=20\\end{align*}$$\nThe remainder is $20$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "$$\\begin{align*}P(-2)&=(-2)^4-(-2)^3+3(-2)^2\\\\P(-2)&=36\\end{align*}$$\nThe remainder is $36$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
