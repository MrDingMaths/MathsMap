  "content": {
    "id": "v2-9e3d4-p35-practice-j14-104354-root",
    "type": "question",
    "label": null,
    "prompt": "Solve these equations simultaneously.\n$$\\begin{aligned}5x+2y&=19\\quad(1)\\\\3x-y&=7\\quad(2)\\end{aligned}$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-9e3d4-p35-practice-j14-104354-j14-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Eliminate $x$ first.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=2$",
          "worked": "$$\\begin{align*}\\color{#ef6068}{\\times3\\to}\\ 15x+6y&=57\\quad(3)\\\\\\color{#ef6068}{\\times5\\to}\\ 15x-5y&=35\\quad(4)\\\\(3)-(4):\\ 11y&=22\\\\y&=2\\end{align*}$$\nSub $y=2$ into $(1)$:\n$$\\begin{align*}5x+4&=19\\\\5x&=15\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-9e3d4-p35-practice-j14-104354-j14-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Eliminate $y$ first.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=2$",
          "worked": "$$\\begin{align*}\\color{#ef6068}{\\times2\\to}\\ 6x-2y&=14\\quad(3)\\\\5x+2y&=19\\quad(1)\\\\(1)+(3):\\ 11x&=33\\\\x&=3\\end{align*}$$\nSub $x=3$ into $(2)$:\n$$\\begin{align*}9-y&=7\\\\y&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-9e3d4-p35-practice-j14-104354-j14-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve these equations simultaneously by eliminating the variable that needs the smaller multipliers.\n$$\\begin{aligned}4x-3y&=17\\quad(1)\\\\5x+6y&=31\\quad(2)\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5,\\ y=1$",
          "worked": "Eliminating $y$ needs multipliers $2$ and $1$; eliminating $x$ needs $5$ and $4$. Eliminate $y$:\n$$\\begin{align*}\\color{#ef6068}{\\times2\\to}\\ 8x-6y&=34\\quad(3)\\\\5x+6y&=31\\quad(2)\\\\(3)+(2):\\ 13x&=65\\\\x&=5\\end{align*}$$\nSub $x=5$ into $(1)$:\n$$\\begin{align*}20-3y&=17\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $x=3,\\ y=2$ b) $x=3,\\ y=2$ c) $x=5,\\ y=1$",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
