      {
        "id": "p16-q8-rate",
        "type": "part",
        "label": "a",
        "prompt": "Write an algebraic expression for the fraction of a bucket of blueberries that could be picked in one hour if A and B worked together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a+b}{ab}$",
          "worked": "In one hour, A picks $\\frac{1}{a}$ of a bucket and B picks $\\frac{1}{b}$ of a bucket.\n\n$\\begin{aligned}\\text{Combined fraction}&=\\frac{1}{a}+\\frac{1}{b}\\\\&=\\frac{b}{ab}+\\frac{a}{ab}\\\\&=\\frac{a+b}{ab}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q8-reciprocal",
        "type": "part",
        "label": "b",
        "prompt": "What does the reciprocal of this fraction represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The time, in hours, for A and B working together to pick one bucket of blueberries.",
          "worked": "$\\frac{a+b}{ab}$ represents blueberry buckets per hour.\n\nIts reciprocal, $\\frac{ab}{a+b}$, represents hours per bucket of blueberries: the time for A and B working together to pick one bucket.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
