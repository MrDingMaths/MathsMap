  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Write the limits of accuracy for each of these numbers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$p = 60$ to the nearest 10",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$55 \\le p < 65$",
          "worked": "Precision: $10$. Absolute error: $\\tfrac12\\times10=5$.\n$$\\begin{align*}\\text{Upper bound}&=60+5=65\\\\\\text{Lower bound}&=60-5=55\\end{align*}$$\nHence $55\\le p<65$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$q = 24.7$ to 1 decimal place",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24.65 \\le q < 24.75$",
          "worked": "Precision: $0.1$. Absolute error: $\\tfrac12\\times0.1=0.05$.\n$$\\begin{align*}\\text{Upper bound}&=24.7+0.05=24.75\\\\\\text{Lower bound}&=24.7-0.05=24.65\\end{align*}$$\nHence $24.65\\le q<24.75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$x = 85$, to the nearest integer",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84.5 \\le x < 85.5$",
          "worked": "Precision: $1$. Absolute error: $\\tfrac12\\times1=0.5$.\n$$\\begin{align*}\\text{Upper bound}&=85+0.5=85.5\\\\\\text{Lower bound}&=85-0.5=84.5\\end{align*}$$\nHence $84.5\\le x<85.5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$x = 85.0$, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84.95 \\le x < 85.05$",
          "worked": "Precision: $0.1$. Absolute error: $\\tfrac12\\times0.1=0.05$.\n$$\\begin{align*}\\text{Upper bound}&=85.0+0.05=85.05\\\\\\text{Lower bound}&=85.0-0.05=84.95\\end{align*}$$\nHence $84.95\\le x<85.05$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
