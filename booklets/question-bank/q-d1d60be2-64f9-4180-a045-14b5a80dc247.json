  "content": {
    "id": "p24-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Four couples, Bob and Mary, Alex and Nora, Chen and Priya, Liam and Sofia, go to a restaurant for dinner. If they sit at a circular table, find the number of seating arrangements if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Bob and Mary are to sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times6!=1440$",
          "worked": "Treat Bob and Mary as one block. The seven entities have $6!$ circular arrangements, and Bob and Mary have two internal orders.\n\n$$N=2\\times6!=1440.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "each couple is to sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3!\\times2^4=96$",
          "worked": "Treat each couple as one block. The four blocks have $3!$ circular arrangements. Each of the four couples has two internal orders.\n\n$$N=3!\\times2^4=96.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "the men and women must alternate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3!\\times4!=144$",
          "worked": "Arrange the four men in a circle in $3!$ ways. Arrange the four women in the four gaps between them in $4!$ ways.\n\n$$N=3!\\times4!=144.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "Nora must sit immediately between Bob and Priya.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q16-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "2\\times5!=240",
                    "display": false
                  }
                ]
              },
              {
                "id": "p24-q16-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use a three-person block with Nora in the middle.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Bob and Priya must be Nora's two immediate neighbours. The block has two orders: Bob–Nora–Priya or Priya–Nora–Bob. The block and the other five people form six entities.\n\n$$N=2\\times5!=240.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "Bob, Alex and Chen are to sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3!\\times5!=720$",
          "worked": "Treat Bob, Alex and Chen as one block. The block and the other five people have $5!$ circular arrangements. The three people within the block have $3!$ orders.\n\n$$N=3!\\times5!=720.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "Alex will not sit next to Mary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q16-f-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "6!\\times5=3600",
                    "display": false
                  }
                ]
              },
              {
                "id": "p24-q16-f-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Seat everyone except Alex first; five gaps are away from Mary.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Arrange the seven people other than Alex in a circle in $6!$ ways. Of their seven gaps, two are next to Mary, leaving five permitted gaps for Alex.\n\n$$N=6!\\times5=3600.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "Chen and Priya are to sit together and Alex and Nora are not to sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q16-g-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "4!\\times2!\\times5\\times4=960",
                    "display": false
                  }
                ]
              },
              {
                "id": "p24-q16-g-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Keep Chen and Priya as a block; place Alex and Nora in distinct gaps.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Treat Chen and Priya as one block. Arrange this block with Bob, Mary, Liam and Sofia in a circle in $4!$ ways. Chen and Priya have $2!$ internal orders.\n\nThere are five gaps between these entities. Place Alex in one gap and Nora in a different gap, giving $5\\times4$ choices. This keeps Chen and Priya together and separates Alex and Nora.\n\n$$N=4!\\times2!\\times5\\times4=960.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
