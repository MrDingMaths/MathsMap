        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"seriesBlue\",\"hex\":\"268CFF\",\"reason\":\"supplied distance-time series\"},{\"name\":\"gridGrey\",\"hex\":\"CCCCCC\",\"reason\":\"neutral coordinate grid\"}],\"reference\":\"source page 9, p9-q5-graph\"}\n\\begin{tikzpicture}[x=1cm,y=0.1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{seriesBlue}{HTML}{268CFF}\n\\definecolor{gridGrey}{HTML}{CCCCCC}\n\\draw[draw=gridGrey,line width=0.25pt,xstep=1,ystep=10] (0,0) grid (4,40);\n\\draw[black,->,line width=0.5pt] (0,0)--(4.35,0);\n\\draw[black,->,line width=0.5pt] (0,0)--(0,43);\n\\foreach \\x in {1,2,3,4}{\\draw[black,line width=0.4pt] (\\x,-0.8)--(\\x,0.8);\\node[below,font=\\fontsize{8.5}{10}\\selectfont] at (\\x,-1.1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {10,20,30,40}{\\draw[black,line width=0.4pt] (-0.08,\\y)--(0.08,\\y);\\node[left,font=\\fontsize{8.5}{10}\\selectfont] at (-0.12,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\y$\\special{dvisvgm:raw </g>}};}\n\\draw[seriesBlue,line width=0.8pt,->] plot[domain=0:4.25,samples=2] (\\x,{10*\\x});\n\\node[font=\\fontsize{10}{12}\\selectfont,anchor=north] at (2,-6) {Time (hours)};\n\\node[font=\\fontsize{10}{12}\\selectfont,rotate=90] at (-0.95,20) {Distance (km)};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 9,
          "sourceRegion": "Question 5, upper-left graph",
          "description": "Distance–time graph with a grey grid, black arrowed axes and a blue straight line through the origin and (4,40), continuing slightly beyond (4,40) with an arrow. Horizontal ticks are 1, 2, 3, 4; vertical ticks are 10, 20, 30, 40. No origin label.",
          "mathematics": "d = 10t; grid step 1 hour horizontally and 10 kilometres vertically.",
