    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{aligned}\\text{Gradient} &= \\frac{\\text{rise}}{\\text{run}}\\\\&=\\frac{40}{4}\\\\&=10\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What rate does the gradient represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Speed in km/h.",
          "worked": "The gradient represents the bike's speed: $10\\text{ km/h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an equation relating distance $d$ and time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=10t$",
          "worked": "The graph passes through the origin, so $d=kt$. With $k=10$, $$d=10t.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-q5-d",
        "type": "group",
        "label": "d",
        "prompt": "Use the equation to find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q5-d-i",
            "type": "part",
            "label": "i",
            "prompt": "The distance travelled in 3.5 hours",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$35\\text{ km}$",
              "worked": "$$\\begin{aligned}d&=10(3.5)\\\\d&=35\\text{ km}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p9-q5-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "time required to travel 55 km.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5.5$ hours, or $5$ hours $30$ minutes.",
              "worked": "$$\\begin{aligned}55&=10t\\\\t&=\\frac{55}{10}\\\\t&=5.5\\text{ hours}\\end{aligned}$$This is $5$ hours $30$ minutes.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
