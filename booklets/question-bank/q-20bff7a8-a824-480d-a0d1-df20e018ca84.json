    "children": [
      {
        "id": "p38-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "In 2000 there were 1750 children aged 0–18 years.\nHow many children were aged 12–18 years in 2000?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "875 children",
          "worked": "The median age in 2000 is $12$ years, so the upper half represents children aged 12–18 years.\n$$50\\%\\times1750=875$$\nThere were $875$ children.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "The number of children aged 12–18 years is the same in both 2000 and 2010.\nHow many children aged 0–18 years are there in 2010?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3500 children",
          "worked": "In 2010, $12$ years is the upper quartile, so ages 12–18 represent $25\\%$ of the children. This is $875$ children.\n$$\\begin{aligned}\\text{Total}&=875\\div0.25\\\\&=3500\\end{aligned}$$\nThere were $3500$ children aged 0–18 years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p38-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Identify TWO changes in the distribution of ages between 2000 and 2010.\nIn your answer, refer to measures of location or spread or the shape of the distributions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The median decreased from 12 to 6 years. The distribution changed from negatively skewed in 2000 to positively skewed in 2010.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p38-q12-c-worked-first",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "There is a greater proportion of younger children in 2010 than in 2000. Specifically, the median age decreased from 12 years in 2000 to 6 years in 2010.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p38-q12-c-worked-second-text",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "In 2000, the distribution is negatively skewed, with a longer left whisker. In 2010, it is positively skewed, with a longer right whisker.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p38-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "What would be ONE possible implication for government planning, because of this change in the distribution of ages?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Plan more primary schools or early childhood daycare centres to accommodate the increased number of young children.",
          "worked": "The number and proportion of young children, such as those aged 0–6 years, are larger in 2010. The government may therefore need to plan and build more primary schools or early childhood daycare centres to accommodate them.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
