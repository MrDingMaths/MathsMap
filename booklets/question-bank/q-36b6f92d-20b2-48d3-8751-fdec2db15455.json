  "content": {
    "id": "v2-7db36c-p9-practice-slot-2-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify these algebraic fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7db36c-p9-practice-slot-2-upper-slot-2-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{m+4}{5m}+\\dfrac{3}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5m+8}{10m}$",
          "worked": "$$\\begin{align*}\\frac{m+4}{5m}+\\frac{3}{10}&=\\frac{2(m+4)}{10m}+\\frac{3m}{10m}\\\\&=\\frac{2(m+4)+3m}{10m}\\\\&=\\frac{2m+8+3m}{10m}\\\\&=\\frac{5m+8}{10m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7db36c-p9-practice-slot-2-upper-slot-2-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2n-1}{6n}-\\dfrac{n+3}{4n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n-11}{12n}$",
          "worked": "$$\\begin{align*}\\frac{2n-1}{6n}-\\frac{n+3}{4n}&=\\frac{2(2n-1)}{12n}-\\frac{3(n+3)}{12n}\\\\&=\\frac{2(2n-1)-3(n+3)}{12n}\\\\&=\\frac{4n-2-3n-9}{12n}\\\\&=\\frac{n-11}{12n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7db36c-p9-practice-slot-2-upper-slot-2-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3k+2}{4k}+\\dfrac{k-5}{k^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3k^2+6k-20}{4k^2}$",
          "worked": "$$\\begin{align*}\\frac{3k+2}{4k}+\\frac{k-5}{k^2}&=\\frac{k(3k+2)}{4k^2}+\\frac{4(k-5)}{4k^2}\\\\&=\\frac{k(3k+2)+4(k-5)}{4k^2}\\\\&=\\frac{3k^2+2k+4k-20}{4k^2}\\\\&=\\frac{3k^2+6k-20}{4k^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-7db36c-p9-practice-slot-2-upper-slot-2-upper-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2p+3}{3p^2}-\\dfrac{p-1}{2p}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-3p^2+7p+6}{6p^2}$",
          "worked": "$$\\begin{align*}\\frac{2p+3}{3p^2}-\\frac{p-1}{2p}&=\\frac{2(2p+3)}{6p^2}-\\frac{3p(p-1)}{6p^2}\\\\&=\\frac{2(2p+3)-3p(p-1)}{6p^2}\\\\&=\\frac{4p+6-3p^2+3p}{6p^2}\\\\&=\\frac{-3p^2+7p+6}{6p^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
