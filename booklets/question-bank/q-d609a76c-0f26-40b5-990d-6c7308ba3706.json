  "content": {
    "id": "p61-q19-root",
    "type": "question",
    "label": null,
    "prompt": "In each case identify how the graph of the second equation can be obtained from the graph of the first by a suitable dilation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-2x$ and $y=\\frac14x^2-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal dilation by factor 2.",
          "worked": "Let $f(x)=x^2-2x$.\n$$\\begin{align*}f\\left(\\frac{x}{2}\\right)&=\\left(\\frac{x}{2}\\right)^2-2\\left(\\frac{x}{2}\\right)\\\\f\\left(\\frac{x}{2}\\right)&=\\frac14x^2-x.\\end{align*}$$\nReplacing $x$ by $\\frac{x}{2}$ gives a horizontal dilation by factor 2.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p61-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{1}{x-4}$ and $y=\\frac{1}{2x-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Vertical dilation by factor $\\frac12$.",
          "worked": "Let $f(x)=\\frac1{x-4}$.\n$$\\begin{align*}\\frac1{2x-8}&=\\frac1{2(x-4)}\\\\\\frac1{2x-8}&=\\frac12f(x).\\end{align*}$$\nEvery $y$-coordinate is multiplied by $\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
