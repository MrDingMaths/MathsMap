  "content": {
    "id": "p97-q7-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the answer to each calculation. Follow the order of operations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p97-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{11}{12}-\\left(\\frac{1}{12}+\\frac{7}{12}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{11}{12}-\\left(\\frac{1}{12}+\\frac{7}{12}\\right)&=\\frac{11}{12}-\\frac{8}{12}\\\\&=\\frac{3}{12}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p97-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{2}\\times\\frac{1}{2}+\\frac{3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{1}{2}\\times\\frac{1}{2}+\\frac{3}{4}&=\\frac{1}{4}+\\frac{3}{4}\\\\&=\\frac{4}{4}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p97-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{2}\\times\\left(\\frac{1}{2}+\\frac{3}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "$$\\begin{align*}\\frac{1}{2}\\times\\left(\\frac{1}{2}+\\frac{3}{4}\\right)&=\\frac{1}{2}\\times\\left(\\frac{2}{4}+\\frac{3}{4}\\right)\\\\&=\\frac{1}{2}\\times\\frac{5}{4}\\\\&=\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p97-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\frac{2}{5}\\div\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}1-\\frac{2}{5}\\div\\frac{1}{2}&=1-\\frac{2}{5}\\times\\frac{2}{1}\\\\&=1-\\frac{4}{5}\\\\&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p97-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(1-\\frac{2}{5}\\right)\\div\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{5}$",
          "worked": "$$\\begin{align*}\\left(1-\\frac{2}{5}\\right)\\div\\frac{1}{2}&=\\frac{3}{5}\\div\\frac{1}{2}\\\\&=\\frac{3}{5}\\times\\frac{2}{1}\\\\&=\\frac{6}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p97-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$5-\\frac{4}{9}\\times\\frac{1}{4}+\\frac{1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{229}{45}$",
          "worked": "$$\\begin{align*}5-\\frac{4}{9}\\times\\frac{1}{4}+\\frac{1}{5}&=5-\\frac{1}{9}+\\frac{1}{5}\\\\&=\\frac{225}{45}-\\frac{5}{45}+\\frac{9}{45}\\\\&=\\frac{229}{45}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p97-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$5-\\frac{4}{9}\\times\\left(\\frac{1}{4}+\\frac{1}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{24}{5}$",
          "worked": "$$\\begin{align*}5-\\frac{4}{9}\\times\\left(\\frac{1}{4}+\\frac{1}{5}\\right)&=5-\\frac{4}{9}\\times\\left(\\frac{5}{20}+\\frac{4}{20}\\right)\\\\&=5-\\frac{4}{9}\\times\\frac{9}{20}\\\\&=5-\\frac{1}{5}\\\\&=\\frac{24}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p97-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(5-\\frac{4}{9}\\right)\\times\\left(\\frac{1}{4}+\\frac{1}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{41}{20}$",
          "worked": "$$\\begin{align*}\\left(5-\\frac{4}{9}\\right)\\times\\left(\\frac{1}{4}+\\frac{1}{5}\\right)&=\\left(\\frac{45}{9}-\\frac{4}{9}\\right)\\times\\left(\\frac{5}{20}+\\frac{4}{20}\\right)\\\\&=\\frac{41}{9}\\times\\frac{9}{20}\\\\&=\\frac{41}{1}\\times\\frac{1}{20}\\\\&=\\frac{41}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p97-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$1\\frac{7}{8}\\times2+\\frac{1}{4}\\div2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{31}{8}$",
          "worked": "$$\\begin{align*}1\\frac{7}{8}\\times2+\\frac{1}{4}\\div2&=\\frac{15}{8}\\times2+\\frac{1}{4}\\times\\frac{1}{2}\\\\&=\\frac{30}{8}+\\frac{1}{8}\\\\&=\\frac{31}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p97-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$1\\frac{7}{8}\\times\\left(2+\\frac{1}{4}\\right)\\div2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{135}{64}$",
          "worked": "$$\\begin{align*}1\\frac{7}{8}\\times\\left(2+\\frac{1}{4}\\right)\\div2&=\\frac{15}{8}\\times\\frac{9}{4}\\div2\\\\&=\\frac{135}{32}\\div2\\\\&=\\frac{135}{32}\\times\\frac{1}{2}\\\\&=\\frac{135}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
