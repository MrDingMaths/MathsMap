  "content": {
    "id": "p11-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A newspaper agent employs a team of $y$ newspaper delivery boys and girls. The whole team has to distribute $6x$ daily papers to the local residential area every morning.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "How many papers, on average, does each person have to distribute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x}{y}$ papers",
          "worked": "Divide the total number of papers by the number of people.\n$$\\text{Average papers per person}=\\frac{6x}{y}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the average number of papers each person distributes each morning if $x=100$ and $y=12$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 papers",
          "worked": "$$\\begin{align*}\\frac{6x}{y}&=\\frac{6\\times100}{12}\\\\\\frac{6x}{y}&=\\frac{600}{12}\\\\\\frac{6x}{y}&=50.\\end{align*}$$\nEach person distributes an average of 50 papers each morning.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
