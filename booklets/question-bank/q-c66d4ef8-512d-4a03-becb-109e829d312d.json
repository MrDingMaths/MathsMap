  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "How many strings of length 4 can be formed using letters from the set $\\{a,b,c,d\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$256$",
          "worked": "Each of the four positions has four choices; repetition is allowed.\n$$\\begin{align*}N&=4^4\\\\N&=256\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q7b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "The numbers of choices decrease as letters are used.\n$$\\begin{align*}N&=4\\times3\\times2\\times1\\\\N&=4!\\\\N&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
