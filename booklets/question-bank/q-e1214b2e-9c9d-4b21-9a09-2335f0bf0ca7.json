    "type": "question",
    "label": null,
    "prompt": "Café A sold 240 coffees and 25% of them were takeaway. Café B sold 180 coffees and 40% of them were takeaway. How many more takeaway coffees did Café B sell than Café A?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12 coffees",
      "worked": "$$\\begin{align*}25\\%\\text{ of }240&=240\\div4=60\\\\10\\%\\text{ of }180&=180\\div10=18\\\\40\\%\\text{ of }180&=4\\times18=72\\\\\\text{Difference}&=72-60=12\\end{align*}$$\nCafé B sold 12 more takeaway coffees.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
