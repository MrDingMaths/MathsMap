  "content": {
    "id": "p11-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Simplify the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$15l+2-3l+7c-12c+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8+12l-5c$",
          "worked": "$$\\begin{align*}15l+2-3l+7c-12c+6&=15l-3l+7c-12c+2+6\\\\&=(15-3)l+(7-12)c+(2+6)\\\\&=8+12l-5c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$7e+e^{2}+3-e^{2}-5e+6+6a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2e+9+6a$",
          "worked": "$$\\begin{align*}7e+e^{2}+3-e^{2}-5e+6+6a&=(7e-5e)+(e^{2}-e^{2})+(3+6)+6a\\\\&=2e+0+9+6a\\\\&=2e+9+6a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$ac+2pa-6a+7-5ap+9ac+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10ac-3ap+19-6a$",
          "worked": "Since $pa=ap$, $2pa$ and $-5ap$ are like terms.\n\n$$\\begin{align*}ac+2pa-6a+7-5ap+9ac+12&=ac+9ac+2ap-5ap+7+12-6a\\\\&=(1+9)ac+(2-5)ap+(7+12)-6a\\\\&=10ac-3ap+19-6a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
