  "content": {
    "id": "p14-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "At a certain school, the mark out of 100 for the Term 1 exam and twice the mark out of 100 for the Term 3 exam are added together. The students must obtain at least 150 marks to achieve a satisfactory grade. A student obtains $x$ marks in the Term 1 exam.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an appropriate inequality to show the mark, $y$, that the student must obtain in the Term 3 exam in order to pass.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge\\dfrac{150-x}{2}$",
          "worked": "The weighted total must be at least 150.\n$$\\begin{align*}x+2y&\\ge150\\\\2y&\\ge150-x\\\\y&\\ge\\frac{150-x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q11-b",
        "type": "group",
        "label": "b",
        "prompt": "Solve this inequality for:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
