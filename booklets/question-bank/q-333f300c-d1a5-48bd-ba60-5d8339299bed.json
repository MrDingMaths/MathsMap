  "content": {
    "id": "p10-q48-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^3-12x^2+47x-60$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q48-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation after translating left by 4 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^3-x$.",
          "worked": "Replace $x$ by $x+4$.\n$$\\begin{align*}y&=(x+4)^3-12(x+4)^2+47(x+4)-60\\\\y&=x^3+12x^2+48x+64-12x^2-96x-192+47x+188-60\\\\y&=x^3-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q48-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, factorise $x^3-12x^2+47x-60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q48-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(x-3)(x-4)(x-5)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p10-q48-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factor the translated cubic, then replace ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " by ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x-4",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " to undo the translation.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "From part (a),\n$$\\begin{align*}f(x+4)&=x^3-x\\\\f(x+4)&=x(x-1)(x+1).\\end{align*}$$\nReplace $x$ by $x-4$ to recover the original polynomial.\n$$\\begin{align*}f(x)&=(x-4)\\bigl((x-4)-1\\bigr)\\bigl((x-4)+1\\bigr)\\\\f(x)&=(x-3)(x-4)(x-5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
