        "answer": {
          "short": "Parallel.",
          "worked": "$$\\binom{-3}{2}=-\\frac13\\binom{9}{-6}$$\nThe vectors are scalar multiples, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p25-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$3\\underset{\\sim}{a}+5\\underset{\\sim}{b}$ and $6\\underset{\\sim}{a}+10\\underset{\\sim}{b}$",
