  "content": {
    "id": "p25-q1",
    "type": "question",
    "label": "1",
    "prompt": "Determine which of the following pairs of vectors are parallel.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\binom{2}{3}$ and $\\binom{6}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$$\\binom{6}{9}=3\\binom{2}{3}$$\nThe vectors are scalar multiples, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p25-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\binom{5}{2}$ and $\\binom{10}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not parallel.",
          "worked": "$$\\frac{10}{5}=2,\\qquad \\frac{5}{2}\\ne2$$\nThere is no common scalar multiple, so the vectors are not parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p25-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\binom{-4}{6}$ and $\\binom{2}{-3}$",
