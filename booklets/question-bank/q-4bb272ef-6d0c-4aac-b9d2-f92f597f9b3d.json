        "answer": {
          "short": "Parallel.",
          "worked": "$$\\binom{2}{-3}=-\\frac12\\binom{-4}{6}$$\nThe vectors are scalar multiples, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p25-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\binom{7}{-3}$ and $\\binom{-14}{6}$",
