        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$$\\binom{-14}{6}=-2\\binom{7}{-3}$$\nThe vectors are scalar multiples, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p25-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\binom{9}{-6}$ and $\\binom{-3}{2}$",
