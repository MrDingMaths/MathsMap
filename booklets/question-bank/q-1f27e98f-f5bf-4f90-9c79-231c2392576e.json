              "inlines": [
                {
                  "type": "math",
                  "latex": "\\log_a(m)+\\log_a(n)=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\log_a(mn)$",
                  "width": 20,
                  "joinPrevious": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a(mn)$",
          "worked": "Let $u=\\log_a m$ and $v=\\log_a n$. Then $mn=a^u a^v=a^{u+v}$, so $\\log_a(mn)=u+v=\\log_a m+\\log_a n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-f1-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p5-f1-b-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\log_a(m)-\\log_a(n)=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$\\log_a\\left(\\frac{m}{n}\\right)$",
                  "width": 22,
                  "joinPrevious": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a\\left(\\frac{m}{n}\\right)$",
          "worked": "Let $u=\\log_a m$ and $v=\\log_a n$. Then $\\frac{m}{n}=\\frac{a^u}{a^v}=a^{u-v}$, so $\\log_a\\left(\\frac{m}{n}\\right)=u-v=\\log_a m-\\log_a n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-f1-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p5-f1-c-equation",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\log_a(m^n)=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$n\\log_a m$",
                  "width": 15,
                  "joinPrevious": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n\\log_a m$",
          "worked": "Let $u=\\log_a m$. Then $m^n=(a^u)^n=a^{nu}$, so $\\log_a(m^n)=nu=n\\log_a m$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-f1-d",
        "type": "part",
        "label": "d",
        "prompt": {
