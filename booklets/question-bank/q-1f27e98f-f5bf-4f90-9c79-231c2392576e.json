              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\log_a(x)=\\dfrac{\\log_b(\\hspace{9mm})}{\\rule{0pt}{5mm}\\hspace{22mm}}",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Numerator argument $x$. Denominator $\\log_b a$.",
          "worked": "Let $y=\\log_a x$. Then $x=a^y$ and $\\log_b x=\\log_b(a^y)=y\\log_b a$.\n\n$$\\log_a x=\\frac{\\log_b x}{\\log_b a}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
