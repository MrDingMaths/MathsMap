  "content": {
    "id": "p45-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The line $y=mx+c$ is a tangent to the curve $y=x^3-x+4$ at the point $(1,4)$. Find the values of $m$ and $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=2$, $c=2$.",
      "worked": "$$\\begin{align*}y'&=3x^2-1\\\\m&=3(1)^2-1\\\\m&=2\\end{align*}$$\n\nSubstitute $(1,4)$ into $y=2x+c$.\n\n$$\\begin{align*}4&=2(1)+c\\\\c&=2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
