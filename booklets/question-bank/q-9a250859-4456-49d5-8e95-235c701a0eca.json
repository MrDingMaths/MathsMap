        "answer": {
          "short": "$11\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage loss}&=\\frac{572\\,000}{5\\,200\\,000}\\times100\\%\\\\\\text{Percentage loss}&=11\\%\\end{align*}$$",
