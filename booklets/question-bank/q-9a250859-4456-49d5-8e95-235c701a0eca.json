      {
        "id": "p25-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the loss?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$572\\,000$",
          "worked": "$$\\begin{align*}\\text{Loss}&=\\$5\\,200\\,000-\\$4\\,628\\,000\\\\\\text{Loss}&=\\$572\\,000\\end{align*}$$",
