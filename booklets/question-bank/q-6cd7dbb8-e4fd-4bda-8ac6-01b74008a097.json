    "label": "51",
    "prompt": "Factorise the following.\n\n$(x-3)-x(3-x)$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-3)(1+x)$\n\nUse $3-x=-(x-3)$, then take out $x-3$.",
      "worked": "$$\\begin{align*}(x-3)-x(3-x)&=(x-3)+x(x-3)\\\\(x-3)-x(3-x)&=(x-3)(1+x)\\end{align*}$$",
      "solutionDiagrams": []
    },
