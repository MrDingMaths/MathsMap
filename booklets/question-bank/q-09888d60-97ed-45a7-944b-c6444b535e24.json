    "answer": {
      "short": "Triangle: $20$ square units; rectangle: $40$ square units. Use $4(x+4)=2\\times\\frac{5(x+2)}{2}$, giving $x=6$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p94-q18-answer-triangle-formula",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Triangle area ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "=\\frac12(x+2)(5)=\\frac{5x+10}{2}",
                "display": false
              }
            ]
          },
          {
            "id": "p94-q18-answer-rectangle-formula",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Rectangle area ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "=4(x+4)=4x+16",
                "display": false
              }
            ]
          },
          {
            "id": "p94-q18-answer-relationship",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Rectangle area = 2 × triangle area:",
                "marks": []
              }
            ]
          },
          {
            "id": "p94-q18-answer-equation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}4x+16&=2\\times\\frac{5x+10}{2}\\\\4x+16&=5x+10\\\\16&=x+10\\\\6&=x\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p94-q18-answer-triangle-area",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Triangle area ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "=\\frac12(6+2)(5)=20",
                "display": false
              },
              {
                "type": "text",
                "text": " square units.",
                "marks": []
              }
            ]
          },
          {
            "id": "p94-q18-answer-rectangle-area",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Rectangle area ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "=4(6+4)=40",
                "display": false
              },
              {
                "type": "text",
                "text": " square units.",
                "marks": []
              }
            ]
          },
          {
            "id": "p94-q18-answer-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Check: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "40=2\\times20",
                "display": false
              },
              {
                "type": "text",
                "text": ", as required.",
                "marks": []
              }
            ]
          }
        ]
      },
