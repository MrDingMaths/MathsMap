  "content": {
    "id": "v2-69002-p11-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether each function is odd.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-69002-p11-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\sin^{-1}x+\\cos^{-1}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not odd: $f(x)=\\frac{\\pi}{2}$, so $f(-x)\\ne-f(x)$.",
          "worked": "$$\\begin{align*}f(x)&=\\sin^{-1}x+\\cos^{-1}x\\\\&=\\frac{\\pi}{2}\\\\f(-x)&=\\frac{\\pi}{2}\\\\-f(x)&=-\\frac{\\pi}{2}\\end{align*}$$\nSince $f(-x)\\ne-f(x)$, $f$ is not odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-69002-p11-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(x)=\\cos^{-1}x-\\frac{\\pi}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Odd: $g(-x)=-g(x)$.",
          "worked": "$$\\begin{align*}g(-x)&=\\cos^{-1}(-x)-\\frac{\\pi}{2}\\\\&=\\pi-\\cos^{-1}x-\\frac{\\pi}{2}\\\\&=\\frac{\\pi}{2}-\\cos^{-1}x\\\\&=-\\left(\\cos^{-1}x-\\frac{\\pi}{2}\\right)\\\\&=-g(x)\\end{align*}$$\nHence $g$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
