  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate each expression for $x=-5$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-21$",
          "worked": "$\\begin{aligned}5x+4&=5(-5)+4\\\\5x+4&=-25+4\\\\5x+4&=-21\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$-5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29$",
          "worked": "$\\begin{aligned}-5x+4&=-5(-5)+4\\\\-5x+4&=25+4\\\\-5x+4&=29\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$5(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$\\begin{aligned}5(x+4)&=5(-5+4)\\\\5(x+4)&=5(-1)\\\\5(x+4)&=-5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$-5(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$\\begin{aligned}-5(x+4)&=-5(-5+4)\\\\-5(x+4)&=-5(-1)\\\\-5(x+4)&=5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$-5x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-125$",
          "worked": "$\\begin{aligned}-5x^2&=-5(-5)^2\\\\-5x^2&=-5(25)\\\\-5x^2&=-125\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-5x)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$625$",
          "worked": "$\\begin{aligned}(-5x)^2&=(-5(-5))^2\\\\(-5x)^2&=25^2\\\\(-5x)^2&=625\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
