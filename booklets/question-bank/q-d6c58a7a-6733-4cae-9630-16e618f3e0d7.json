  "content": {
    "id": "p85-review-two-q06-node",
    "type": "question",
    "label": "25",
    "prompt": "Show that the graph of $y=\\dfrac{x-2}{\\sqrt{2x-1}}$ has no stationary points.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p85-q25-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "y'=\\dfrac{x+1}{(2x-1)^{3/2}}",
                "display": false
              },
              {
                "type": "text",
                "text": "; no stationary points.",
                "marks": []
              }
            ]
          },
          {
            "id": "p85-q25-short-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "On the domain ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x>\\tfrac12",
                "display": false
              },
              {
                "type": "text",
                "text": ", the derivative is positive, so it never equals zero.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p85-q25-worked-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y'&=\\frac{d}{dx}\\left[(x-2)(2x-1)^{-1/2}\\right]\\\\y'&=(2x-1)^{-1/2}-(x-2)(2x-1)^{-3/2}\\\\y'&=\\frac{x+1}{(2x-1)^{3/2}}.\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p85-q25-worked-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The domain is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x>\\tfrac12",
                "display": false
              },
              {
                "type": "text",
                "text": ". Both ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x+1",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(2x-1)^{3/2}",
                "display": false
              },
              {
                "type": "text",
                "text": " are positive there, so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y'",
                "display": false
              },
              {
                "type": "text",
                "text": " cannot be zero. Hence the graph has no stationary points.",
                "marks": []
              }
            ]
          }
        ]
      },
