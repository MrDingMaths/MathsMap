        "answer": {
          "short": "$m_{\\mathrm{perp}}=-\\frac{1}{3}$",
          "worked": "$\\begin{aligned}m&=3\\\\m_{\\mathrm{perp}}&=-\\frac{1}{3}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p51-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-2x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$\\begin{aligned}m&=-2\\\\m_{\\mathrm{perp}}&=-\\frac{1}{-2}\\\\m_{\\mathrm{perp}}&=\\frac{1}{2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p51-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{7}{8}x-\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{8}{7}$",
          "worked": "$\\begin{aligned}m&=\\frac{7}{8}\\\\m_{\\mathrm{perp}}&=-\\frac{1}{\\frac{7}{8}}\\\\m_{\\mathrm{perp}}&=-\\frac{8}{7}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p51-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{-4x}{9}-\\frac{4}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{4}$",
          "worked": "$\\begin{aligned}m&=-\\frac{4}{9}\\\\m_{\\mathrm{perp}}&=-\\frac{1}{-\\frac{4}{9}}\\\\m_{\\mathrm{perp}}&=\\frac{9}{4}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
