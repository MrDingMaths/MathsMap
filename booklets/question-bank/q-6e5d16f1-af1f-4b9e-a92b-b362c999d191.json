      {
        "id": "p5-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+3)(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+5x+6$",
          "worked": "$$\\begin{align*}(x+3)(x+2)&=x^2+3x+2x+6\\\\(x+3)(x+2)&=x^2+5x+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
