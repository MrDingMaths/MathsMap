  "content": {
    "id": "p15-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Five positive whole numbers have a mean of 4, a median of 5 and a mode of 6. Find all five numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
