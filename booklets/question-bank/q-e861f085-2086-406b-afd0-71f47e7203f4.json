      {
        "id": "p30-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x-3}{3}\\leq\\frac{3+x}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq-15$",
          "worked": "Multiply both sides by 6.\n\n$$\\begin{align*}2(x-3)&\\leq3(3+x)\\\\2x-6&\\leq9+3x\\\\-x&\\leq15\\\\x&\\geq-15\\end{align*}$$\n\nReverse the inequality when dividing by $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p30-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2x+3}{2}-\\frac{x-4}{3}>2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-\\frac{5}{4}$",
          "worked": "Multiply both sides by 6.\n\n$$\\begin{align*}3(2x+3)-2(x-4)&>12\\\\6x+9-2x+8&>12\\\\4x+17&>12\\\\4x&>-5\\\\x&>-\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{4-x}{2}+\\frac{3-x}{4}<1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac{7}{3}$",
          "worked": "Multiply both sides by 4.\n\n$$\\begin{align*}2(4-x)+(3-x)&<4\\\\8-2x+3-x&<4\\\\11-3x&<4\\\\-3x&<-7\\\\x&>\\frac73\\end{align*}$$\n\nReverse the inequality when dividing by $-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{3-2x}{2}\\geq\\frac{7-10x}{5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq-\\frac{1}{10}$",
          "worked": "Multiply both sides by 10.\n\n$$\\begin{align*}5(3-2x)&\\geq2(7-10x)\\\\15-10x&\\geq14-20x\\\\10x&\\geq-1\\\\x&\\geq-\\frac1{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p30-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{5-2x}{3}-\\frac{5+2x}{4}\\geq-1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq\\frac{17}{14}$",
          "worked": "Multiply both sides by 12.\n\n$$\\begin{align*}4(5-2x)-3(5+2x)&\\geq-12\\\\20-8x-15-6x&\\geq-12\\\\5-14x&\\geq-12\\\\-14x&\\geq-17\\\\x&\\leq\\frac{17}{14}\\end{align*}$$\n\nReverse the inequality when dividing by $-14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{2x-1}{7}\\geq\\frac{2x+3}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq-\\frac{25}{6}$",
          "worked": "Multiply both sides by 28.\n\n$$\\begin{align*}4(2x-1)&\\geq7(2x+3)\\\\8x-4&\\geq14x+21\\\\-6x&\\geq25\\\\x&\\leq-\\frac{25}{6}\\end{align*}$$\n\nReverse the inequality when dividing by $-6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p30-q18-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{6x+1}{3}>\\frac{3x-1}{2}+3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac{13}{3}$",
          "worked": "Multiply both sides by 6.\n\n$$\\begin{align*}2(6x+1)&>3(3x-1)+18\\\\12x+2&>9x+15\\\\3x&>13\\\\x&>\\frac{13}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p30-q18-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{6-3x}{2}\\geq\\frac{3x-6}{5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq2$",
          "worked": "Multiply both sides by 10.\n\n$$\\begin{align*}5(6-3x)&\\geq2(3x-6)\\\\30-15x&\\geq6x-12\\\\-21x&\\geq-42\\\\x&\\leq2\\end{align*}$$\n\nReverse the inequality when dividing by $-21$.",
