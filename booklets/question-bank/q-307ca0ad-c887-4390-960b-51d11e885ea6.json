      {
        "id": "p16-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}x&=1+2\\tan\\theta\\\\y&=3\\sec\\theta-4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(y+4)^2-9(x-1)^2=36$",
          "worked": "$$\\begin{aligned}\\tan\\theta&=\\frac{x-1}{2}\\\\\\sec\\theta&=\\frac{y+4}{3}\\end{aligned}$$\nUsing $\\sec^2\\theta-\\tan^2\\theta=1$:\n$$\\begin{aligned}\\left(\\frac{y+4}{3}\\right)^2-\\left(\\frac{x-1}{2}\\right)^2&=1\\\\\\frac{(y+4)^2}{9}-\\frac{(x-1)^2}{4}&=1\\\\4(y+4)^2-9(x-1)^2&=36\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}x&=\\cos\\theta+\\sin\\theta\\\\y&=\\cos\\theta-\\sin\\theta\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=2$",
          "worked": "$$\\begin{aligned}x+y&=2\\cos\\theta\\\\\\cos\\theta&=\\frac{x+y}{2}\\\\x-y&=2\\sin\\theta\\\\\\sin\\theta&=\\frac{x-y}{2}\\end{aligned}$$\nUsing $\\cos^2\\theta+\\sin^2\\theta=1$:\n$$\\begin{aligned}\\left(\\frac{x+y}{2}\\right)^2+\\left(\\frac{x-y}{2}\\right)^2&=1\\\\(x+y)^2+(x-y)^2&=4\\\\2x^2+2y^2&=4\\\\x^2+y^2&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
    ]
  },
