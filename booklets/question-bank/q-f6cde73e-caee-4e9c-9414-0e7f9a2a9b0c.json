  "content": {
    "id": "p53-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider the graph of $y=x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the equation of the graph when it is translated right by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-1)^2$",
          "worked": "Replace $x$ by $x-1$.\n$$y=(x-1)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p53-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the new equation if the graph is then dilated horizontally by a factor of $\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(2x-1)^2$",
          "worked": "A horizontal dilation by factor $\\frac12$ replaces $x$ by $2x$ in the equation from part a.\n$$y=(2x-1)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p53-q5-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q5-c-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Complete the following set of steps that were followed in the previous parts.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p53-q5-c-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "x^2\\ \\underset{\\text{Translate}}{\\longrightarrow}\\ (x-",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$1$",
                  "width": 9
                },
                {
                  "type": "math",
                  "latex": ")^2\\ \\underset{\\text{Dilate}}{\\longrightarrow}\\ (",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$2x$",
                  "width": 11
                },
                {
                  "type": "math",
                  "latex": "-1)^2",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)^2$, $(2x-1)^2$",
          "worked": "Translate: replace $x$ by $x-1$. Then dilate: replace $x$ by $2x$ in the translated expression.\n$$x^2\\ \\underset{\\text{Translate}}{\\longrightarrow}\\ (x-1)^2\\ \\underset{\\text{Dilate}}{\\longrightarrow}\\ (2x-1)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p53-q5-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q5-d-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Complete the following set of steps if we instead first dilate and then translate.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p53-q5-d-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "x^2\\ \\underset{\\text{Dilate}}{\\longrightarrow}\\ (",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$2x$",
                  "width": 11
                },
                {
                  "type": "math",
                  "latex": ")^2\\ \\underset{\\text{Translate}}{\\longrightarrow}\\ (",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$2x-2$",
                  "width": 17
                },
                {
                  "type": "math",
                  "latex": ")^2",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x)^2$, $(2x-2)^2$",
          "worked": "Dilate: replace $x$ by $2x$. Then translate: replace $x$ by $x-1$ in the dilated expression.\n$$\\begin{align*}y&=(2x)^2\\\\y&=[2(x-1)]^2\\\\y&=(2x-2)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p53-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "From the above, did the order matter or did you end up with the same curve doing it either way?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The order matters.",
          "worked": "The order matters: translating then dilating gives $y=(2x-1)^2$, whereas dilating then translating gives $y=(2x-2)^2$. Their vertices are $(\\frac12,0)$ and $(1,0)$ respectively, so they are different curves.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
