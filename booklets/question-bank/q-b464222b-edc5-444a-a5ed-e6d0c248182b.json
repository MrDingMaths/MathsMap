    "type": "question",
    "label": "17",
    "prompt": "Calculate the total saving on each bulk purchase compared with buying the same number of items separately.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "3 cans of beetroot for $\\$2.85$ or 98 cents each",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 cents",
          "worked": "Cost of buying the cans separately:\n$$0.98\\times3=2.94$$\nTotal saving on the three cans:\n$$2.94-2.85=0.09$$\nThe saving is 9 cents.",
