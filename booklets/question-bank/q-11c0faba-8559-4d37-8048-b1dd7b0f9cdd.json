      {
        "id": "p5-q1a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $a\\propto b$, and that $b=3$ when $a=1$, find the formula for $a$ in terms of $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{b}{3}$",
          "worked": "Since $a\\propto b$, write $a=kb$.\n$$\\begin{align*}1&=3k\\\\k&=\\frac13\\\\a&=\\frac{b}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q1b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $m\\propto n$, and that $m=15$ when $n=3$, find the formula for $m$ in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=5n$",
          "worked": "Since $m\\propto n$, write $m=kn$.\n$$\\begin{align*}15&=3k\\\\k&=5\\\\m&=5n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
