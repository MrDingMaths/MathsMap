        "prompt": "Find the perimeter of each triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Left: $30\\text{ cm}$. Right: $7.5\\text{ cm}$.",
          "worked": "$$\\begin{aligned}P_{\\text{left}}&=5+12+13\\\\P_{\\text{left}}&=30\\text{ cm}\\\\P_{\\text{right}}&=1.25+3+3.25\\\\P_{\\text{right}}&=7.5\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Is the ratio of the perimeters the same as the ratio of the sides? Why is this so?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. Each side is scaled by the same factor, so their sum is scaled by that factor too.",
          "worked": "Yes. The left-to-right perimeter ratio is $30:7.5=4:1$, matching the corresponding side ratio $13:3.25=4:1$. Every side is multiplied by $0.25$, so the sum of the side lengths is also multiplied by $0.25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
