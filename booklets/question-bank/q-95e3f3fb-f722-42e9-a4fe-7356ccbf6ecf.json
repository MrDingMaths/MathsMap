  "content": {
    "id": "p8-formulas-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the value of the subject of each of the following formulas when the pronumerals have the values indicated.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-formulas-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$V=\\ell bh$, when $\\ell=20$, $b=4.6$ and $h=2.8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=257.6$",
          "worked": "$$\\begin{align*}V&=\\ell bh\\\\V&=20\\times4.6\\times2.8\\\\V&=257.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-formulas-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$s=ut+\\frac{1}{2}at^2$, when $u=4.6$, $a=9.8$ and $t=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=96.8$",
          "worked": "$$\\begin{align*}s&=ut+\\frac{1}{2}at^2\\\\s&=4.6\\times4+\\frac{1}{2}\\times9.8\\times4^2\\\\s&=18.4+78.4\\\\s&=96.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-formulas-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$E=\\frac{p^2}{2m}$, when $p=14.6$ and $m=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$E=13.3225$",
          "worked": "$$\\begin{align*}E&=\\frac{p^2}{2m}\\\\E&=\\frac{14.6^2}{2\\times8}\\\\E&=\\frac{213.16}{16}\\\\E&=13.3225\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-formulas-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=P\\left(1+\\frac{r}{100}\\right)^n$, when $P=1000$, $r=8$ and $n=4$. Give your answer correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\approx1360.5$",
          "worked": "$$\\begin{align*}A&=P\\left(1+\\frac{r}{100}\\right)^n\\\\A&=1000\\left(1+\\frac{8}{100}\\right)^4\\\\A&=1000(1.08)^4\\\\A&=1360.48896\\\\A&\\approx1360.5\\end{align*}$$\nCorrect to 1 decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
