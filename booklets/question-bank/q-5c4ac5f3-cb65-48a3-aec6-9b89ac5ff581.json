    "questionDiagrams": [],
    "children": [
      {
        "id": "p67-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$|A|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$333$",
          "worked": "The multiples of $3$ in $A$ are $3,6,\\ldots,999$.\n$$\\begin{align*}|A|&=\\frac{999}{3}\\\\|A|&=333\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$|B|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$99$",
          "worked": "The multiples of $5$ in $B$ are $5,10,\\ldots,495$.\n$$\\begin{align*}|B|&=\\frac{495}{5}\\\\|B|&=99\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$|A\\cap B|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33$",
          "worked": "Common elements are multiples of $15$ satisfying both bounds. Thus $A\\cap B=\\{15,30,\\ldots,495\\}$.\n$$\\begin{align*}|A\\cap B|&=\\frac{495}{15}\\\\|A\\cap B|&=33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p67-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$|A\\cup B|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$399$",
          "worked": "Use inclusion–exclusion so that common elements are counted once.\n$$\\begin{align*}|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B|&=333+99-33\\\\|A\\cup B|&=399\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
