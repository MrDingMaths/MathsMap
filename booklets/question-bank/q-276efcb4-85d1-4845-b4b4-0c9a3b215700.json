        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x+1}{2x}+\\frac{3}{4x}=\\dfrac{\\rule{0pt}{5mm}\\hspace{18mm}}{4x}+\\dfrac{3}{4x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x+5}{4x}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{2x}+\\frac{3}{4x}&=\\frac{2(x+1)}{4x}+\\frac{3}{4x}\\\\&=\\frac{2x+2+3}{4x}\\\\&=\\frac{2x+5}{4x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-7db36c-p9-practice-j5-213444-j5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2x+1}{3x}+\\frac{x-5}{6x}=\\dfrac{\\rule{0pt}{5mm}\\hspace{18mm}}{6x}+\\dfrac{x-5}{6x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x-3}{6x}$",
          "worked": "$$\\begin{align*}\\frac{2x+1}{3x}+\\frac{x-5}{6x}&=\\frac{2(2x+1)}{6x}+\\frac{x-5}{6x}\\\\&=\\frac{4x+2+x-5}{6x}\\\\&=\\frac{5x-3}{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
