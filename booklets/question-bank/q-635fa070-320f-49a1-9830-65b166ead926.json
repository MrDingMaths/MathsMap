  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Harry is going to roll a six-sided die three times. What is the probability that only the final roll will be a six?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{25}{216}$",
      "worked": "The rolls are independent. The first two rolls must each be a number other than six.\n\n$$\\begin{align*}\\Pr(\\text{only the final roll is six})&=\\frac{5}{6}\\times\\frac{5}{6}\\times\\frac{1}{6}\\\\\\Pr(\\text{only the final roll is six})&=\\frac{25}{216}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
