  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A particle is moving with displacement $x = 2t^2 - 8t + 3$, where $x$ is in metres and $t$ is in seconds.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find its initial velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}(0) = -8\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\dot{x}(t) &= 4t-8\\\\\\dot{x}(0) &= 4(0)-8\\\\&= -8\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that its acceleration is constant and find its value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Constant acceleration of $4\\text{ m/s}^2$.",
          "worked": "$$\\begin{align*}\\dot{x}(t) &= 4t-8\\\\\\ddot{x}(t) &= 4\\text{ m/s}^2\\end{align*}$$\nThe acceleration is constant because it does not depend on $t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p19-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find its displacement at 5 s.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13\\text{ m}$",
          "worked": "$$\\begin{align*}x(5) &= 2(5)^2-8(5)+3\\\\&= 13\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Find when the particle's velocity is zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t = 2\\text{ s}$",
          "worked": "$$\\begin{align*}\\dot{x}(t) &= 4t-8\\\\4t-8 &= 0\\\\4t &= 8\\\\t &= 2\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "What will the particle's displacement be at that time?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\text{ m}$",
          "worked": "$$\\begin{align*}x(2) &= 2(2)^2-8(2)+3\\\\&= -5\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
