  "content": {
    "id": "p15-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A PDF is given by $f(x)=\\dfrac{2x^5}{87381}$ over the interval $1\\le x\\le b$. Find the value of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=8$.",
      "worked": "$$\\begin{align*}\\int_1^b\\frac{2x^5}{87381}\\,dx&=1\\\\\\frac{2}{87381}\\left[\\frac{x^6}{6}\\right]_1^b&=1\\\\\\frac{b^6-1}{262143}&=1\\\\b^6&=262144\\\\b^6&=8^6\\\\b&=8\\end{align*}$$\nSince the domain requires $b>1$, take the positive root.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
