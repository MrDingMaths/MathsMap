  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "For the graph of $f(x)=x(x-4)$,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph, showing intercepts and vertex.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Intercepts: $(0,0)$ and $(4,0)$. Vertex: $(2,-4)$. Opens upwards.",
          "worked": "$$\\begin{align*}x(x-4)&=0\\\\x&=0\\text{ or }4\\\\x_{\\mathrm{vertex}}&=\\frac{0+4}{2}=2\\\\f(2)&=2(2-4)=-4\\end{align*}$$\nThe intercepts are $(0,0)$ and $(4,0)$, including the $y$-intercept $(0,0)$. The vertex is $(2,-4)$ and the parabola opens upwards.",
          "solutionDiagrams": [
            {
              "id": "p19-q3-a-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 19 p19-q3-a-graph\"}\n\\begin{tikzpicture}[x=0.48cm,y=0.24cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,black,line width=0.5pt] (-4,0)--(8,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-8)--(0,8) node[above] {$y$};\n\\draw[<->,black,line width=0.8pt,domain=-1.4:5.4,samples=100] plot (\\x,{\\x*(\\x-4)});\n\\node[below right] at (4,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$4$\\special{dvisvgm:raw </g>}};\n\\node[below] at (2,-4) {$(2,-4)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 55,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 19,
                "sourceRegion": "Question 3a supplied answer graph",
                "description": "Equation-driven upward parabola with double-ended axes, arrowed curve ends, labelled nonzero intercept and vertex; no tick scale.",
                "mathematics": "y=x(x-4); intercepts (0,0),(4,0); vertex (2,-4).",
                "answerVisibility": "answer-only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p19-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the equation of the graph after:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Reflection across the $x$-axis",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-x(x-4)$",
              "worked": "Replace $y$ by $-y$.\n$$\\begin{align*}-y&=x(x-4)\\\\y&=-x(x-4)\\end{align*}$$\nThus $-f(x)=-x(x-4)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p19-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Reflection across the $y$-axis",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=x(x+4)$",
              "worked": "Replace $x$ by $-x$.\n$$\\begin{align*}f(-x)&=(-x)(-x-4)\\\\f(-x)&=x(x+4)\\\\y&=x(x+4)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p19-q3-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Reflection across both axes",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-x(x+4)$",
              "worked": "Replace $x$ by $-x$ and $y$ by $-y$.\n$$\\begin{align*}-y&=(-x)(-x-4)\\\\-y&=x(x+4)\\\\y&=-x(x+4)\\end{align*}$$\nThus $-f(-x)=-x(x+4)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
