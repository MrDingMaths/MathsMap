  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Rearrange the formula $K = \\frac{1}{2}mv^2$ to make:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$m$ the subject",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m = \\frac{2K}{v^2}$",
          "worked": "$$\\begin{align*}2K &= mv^2\\\\\\frac{2K}{v^2} &= m\\\\m &= \\frac{2K}{v^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$v$ the subject",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v = \\pm\\sqrt{\\frac{2K}{m}}$",
          "worked": "$$\\begin{align*}2K &= mv^2\\\\\\frac{2K}{m} &= v^2\\\\\\pm\\sqrt{\\frac{2K}{m}} &= v\\\\v &= \\pm\\sqrt{\\frac{2K}{m}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
