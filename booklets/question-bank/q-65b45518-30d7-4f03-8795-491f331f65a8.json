  "content": {
    "id": "v2-p10-practice-slot-5-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A bag contains red, blue and white marbles. The probability of picking red is $\\frac13$ and the probability of picking blue is $\\frac14$.\n\nState whether each bag could be the one described.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p10-practice-slot-5-upper-slot-5-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "4 red, 3 blue and 5 white marbles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes",
          "worked": "$$\\begin{align*}\\text{Total}&=4+3+5=12\\\\P(\\text{red})&=\\frac{4}{12}=\\frac13\\\\P(\\text{blue})&=\\frac{3}{12}=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-p10-practice-slot-5-upper-slot-5-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "6 red, 5 blue and 7 white marbles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No",
          "worked": "$$\\begin{align*}\\text{Total}&=6+5+7=18\\\\P(\\text{red})&=\\frac{6}{18}=\\frac13\\\\P(\\text{blue})&=\\frac{5}{18}\\end{align*}$$\nThe probability of blue is not $\\frac14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-p10-practice-slot-5-upper-slot-5-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "8 red, 6 blue and 10 white marbles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes",
          "worked": "$$\\begin{align*}\\text{Total}&=8+6+10=24\\\\P(\\text{red})&=\\frac{8}{24}=\\frac13\\\\P(\\text{blue})&=\\frac{6}{24}=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-p10-practice-slot-5-upper-slot-5-upper-q-d",
        "type": "part",
        "label": "d",
        "prompt": "9 red, 6 blue and 9 white marbles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No",
          "worked": "$$\\begin{align*}\\text{Total}&=9+6+9=24\\\\P(\\text{red})&=\\frac{9}{24}=\\frac38\\end{align*}$$\nThe probability of red is not $\\frac13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
