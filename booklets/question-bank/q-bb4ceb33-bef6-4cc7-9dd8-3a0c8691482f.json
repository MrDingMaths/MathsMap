  "content": {
    "id": "p42-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the discriminant to show that the line $y = 2x + 1$ does not intersect the parabola $y = x^{2} + 3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta = -4 < 0$, so there are no points of intersection.",
          "worked": "$$\\begin{align*}2x + 1 &= x^{2} + 3\\\\x^{2} - 2x + 2 &= 0\\end{align*}$$\n$$\\begin{align*}\\Delta &= (-2)^{2} - 4(1)(2)\\\\\\Delta &= -4\\end{align*}$$\nSince $\\Delta < 0$, there are no real solutions, so the line does not intersect the parabola.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p42-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine for which values of $k$ the line $y = 2x + k$ intersects the parabola $y = x^{2} + 3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k \\geq 2$.",
          "worked": "$$\\begin{align*}2x + k &= x^{2} + 3\\\\x^{2} - 2x + 3 - k &= 0\\end{align*}$$\n$$\\begin{align*}\\Delta &= (-2)^{2} - 4(1)(3 - k)\\\\\\Delta &= 4 - 12 + 4k\\\\\\Delta &= 4k - 8\\end{align*}$$\nFor at least one point of intersection, $\\Delta \\geq 0$.\n$$\\begin{align*}4k - 8 &\\geq 0\\\\k &\\geq 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
