  "content": {
    "id": "p9-q6",
    "type": "question",
    "label": "6",
    "prompt": "There are 6 boxes of Smarties and 42 loose Smarties that are not in boxes. Each box contains $x$ Smarties.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the total smarties.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x + 42$",
          "worked": "The six boxes contain $6x$ Smarties. Including the loose Smarties, the total is $6x+42$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p9-q6-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Factorise the expression in part ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "a",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(x + 7)$",
          "worked": "The HCF of $6x$ and $42$ is $6$. Dividing each term by $6$ gives $x$ and $7$.\n$$\\begin{align*}6x+42 &= 6(x+7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "If the smarties are to be shared amongst 6 people, write an expression for the number of Smarties each person receives.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x + 7$ Smarties per person.",
          "worked": "$$\\begin{align*}\\frac{6x+42}{6} &= \\frac{6(x+7)}{6}\\\\\\frac{6x+42}{6} &= x+7\\end{align*}$$\nEach person receives $x+7$ Smarties.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "If the smarties are to be shared amongst 3 people, write an expression for the number of Smarties each person receives.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x + 14$ Smarties per person.",
          "worked": "$$\\begin{align*}\\frac{6x+42}{3} &= \\frac{6(x+7)}{3}\\\\\\frac{6x+42}{3} &= 2(x+7)\\\\\\frac{6x+42}{3} &= 2x+14\\end{align*}$$\nEach person receives $2x+14$ Smarties.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
