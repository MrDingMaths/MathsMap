  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose that $y$ is inversely proportional to $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p22-q5-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Write down a general formula that shows the relationship between ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "x",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "y",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ". ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$y=\\frac{k}{x}$",
                  "width": 17
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{k}{x}$, where $k$ is constant.",
          "worked": "Inverse proportionality means that $xy=k$, where $k$ is constant. Thus $y=\\frac{k}{x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that when $x=3$, $y=2$. Find the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=6$",
          "worked": "$$\\begin{align*}k&=xy\\\\k&=3\\times2\\\\k&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p22-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the value of $y$ when $x=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1$",
          "worked": "$$\\begin{align*}y&=\\frac6x\\\\y&=\\frac66\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
