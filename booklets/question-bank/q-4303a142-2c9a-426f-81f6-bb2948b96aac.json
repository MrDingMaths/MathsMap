  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Use Pythagoras’ theorem to find the hypotenuse of the right-angled triangle in which the lengths of the other two sides are:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{2}$ and $\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "Let $h$ be the hypotenuse. By Pythagoras’ theorem,\n$$\\begin{align*}h^2&=(\\sqrt{2})^2+(\\sqrt{7})^2\\\\h^2&=2+7=9\\\\h&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{5}$ and $2\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Let $h$ be the hypotenuse. By Pythagoras’ theorem,\n$$\\begin{align*}h^2&=(\\sqrt{5})^2+(2\\sqrt{5})^2\\\\h^2&=5+20=25\\\\h&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{7}+1$ and $\\sqrt{7}-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Let $h$ be the hypotenuse. By Pythagoras’ theorem,\n$$\\begin{align*}h^2&=(\\sqrt{7}+1)^2+(\\sqrt{7}-1)^2\\\\h^2&=7+2\\sqrt{7}+1+7-2\\sqrt{7}+1\\\\h^2&=16\\\\h&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\sqrt{3}-\\sqrt{6}$ and $2\\sqrt{3}+\\sqrt{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "Let $h$ be the hypotenuse. By Pythagoras’ theorem,\n$$\\begin{align*}h^2&=(2\\sqrt{3}-\\sqrt{6})^2+(2\\sqrt{3}+\\sqrt{6})^2\\\\h^2&=12-4\\sqrt{18}+6+12+4\\sqrt{18}+6\\\\h^2&=36\\\\h&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
