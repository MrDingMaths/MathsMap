  "content": {
    "id": "p29-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Nina is training hard to become a better swimmer. She spends 17 hours per week doing freestyle, 9 hours per week doing backstroke, and 4 hours per week in the gym. What fraction of her training time is spent out of the pool?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{15}$",
      "worked": "The gym accounts for the training time out of the pool.\n\n$$\\begin{align*}\\text{Total training time}&=17+9+4\\\\\\text{Total training time}&=30\\text{ hours}\\\\\\text{Fraction out of the pool}&=\\frac{4}{30}\\\\\\text{Fraction out of the pool}&=\\frac{2}{15}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
