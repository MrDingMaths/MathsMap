            "label": "a",
            "prompt": "Simplifying each surd then multiplying",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6\\sqrt{6}$",
              "worked": "$$\\begin{align*}\\sqrt{8}\\times\\sqrt{27}&=2\\sqrt{2}\\times3\\sqrt{3}\\\\&=6\\sqrt{6}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p32-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "Multiplying the surds then simplifying.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6\\sqrt{6}$",
              "worked": "$$\\begin{align*}\\sqrt{8}\\times\\sqrt{27}&=\\sqrt{216}\\\\&=\\sqrt{36}\\sqrt{6}\\\\&=6\\sqrt{6}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      },
