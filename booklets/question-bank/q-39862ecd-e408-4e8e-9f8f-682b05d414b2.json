        "code": "% mathsmap-solid {\"version\":1,\"kind\":\"polyhedron\",\"model\":{\"version\":1,\"kind\":\"polyhedron\",\"vertices\":{\"A0\":[0,0,0],\"B0\":[0,0,2],\"A1\":[2,0,0],\"B1\":[2,0,2],\"A2\":[2,2,0],\"B2\":[2,2,2],\"A3\":[0,2,0],\"B3\":[0,2,2]},\"view\":{\"right\":[1,0,0.45],\"up\":[0,1,0.35],\"toward\":[0.3909350184867625,0.30406056993414854,-0.8687444855261388]},\"faces\":[[\"A0\",\"A1\",\"A2\",\"A3\"],[\"B3\",\"B2\",\"B1\",\"B0\"],[\"A0\",\"A1\",\"B1\",\"B0\"],[\"A1\",\"A2\",\"B2\",\"B1\"],[\"A2\",\"A3\",\"B3\",\"B2\"],[\"A3\",\"A0\",\"B0\",\"B3\"]]}}\n\\begin{tikzpicture}[line width=0.8pt,every node/.style={font=\\large},scale=1]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A0) at (0,0);\n\\coordinate (B0) at (0.9,0.7);\n\\coordinate (A1) at (2,0);\n\\coordinate (B1) at (2.9,0.7);\n\\coordinate (A2) at (2,2);\n\\coordinate (B2) at (2.9,2.7);\n\\coordinate (A3) at (0,2);\n\\coordinate (B3) at (0.9,2.7);\n\\draw (A0)--(A1);\n\\draw (A1)--(A2);\n\\draw (A2)--(A3);\n\\draw (A3)--(A0);\n\\draw (B3)--(B2);\n\\draw (B2)--(B1);\n\\draw[dashed] (B1)--(B0);\n\\draw[dashed] (B0)--(B3);\n\\draw (A1)--(B1);\n\\draw[dashed] (B0)--(A0);\n\\draw (A2)--(B2);\n\\draw (A3)--(B3);\n\\path (A0)--(A1) node[pos=0.5,below,fill=white,inner sep=1pt] {$6\\text{ cm}$};\n\\end{tikzpicture}",
