    "children": [
      {
        "id": "p12-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the volume of the cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$216\\text{ cm}^3$",
          "worked": "$$\\begin{align*}V&=6^3\\\\V&=216\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "Each side of the cube is increased by $10\\%$. Find the new volume of the cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$287.496\\text{ cm}^3$",
          "worked": "$$\\begin{align*}\\text{New side length}&=6\\times1.1\\\\\\text{New side length}&=6.6\\text{ cm}\\\\\\text{New volume}&=6.6^3\\\\\\text{New volume}&=287.496\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "Work out the percentage increase in the volume of the cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33.1\\%$ increase",
          "worked": "Each of the three dimensions has multiplier $1.1$.\n\n$$\\begin{align*}\\text{Volume multiplier}&=1.1\\times1.1\\times1.1\\\\\\text{Volume multiplier}&=1.331\\\\\\text{Percentage increase}&=(1.331-1)\\times100\\%\\\\\\text{Percentage increase}&=33.1\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q24-d",
        "type": "part",
        "label": "d",
        "prompt": "Would your answer to part c change if the original side lengths were different?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. Each side still has multiplier $1.1$, so the volume multiplier is always $1.1^3=1.331$. The volume therefore increases by $33.1\\%$, whatever the original side length.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
