    "type": "question",
    "label": null,
    "prompt": "Find the equation of a line with a gradient of $2$ and an $x$-intercept of $-3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=2x+6$",
      "worked": "The $x$-intercept gives the point $(-3,0)$.\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-0&=2(x+3)\\\\y&=2x+6\\end{align*}$$",
      "solutionDiagrams": []
    },
