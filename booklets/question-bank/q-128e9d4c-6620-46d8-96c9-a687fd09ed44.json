  "content": {
    "id": "p4-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find $f(2)$, $f(0)$ and $f(-2)$ for each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2)=5$, $f(0)=-1$, $f(-2)=-7$.",
          "worked": "$$\\begin{align*}f(2)&=3(2)-1\\\\f(2)&=5\\\\f(0)&=3(0)-1\\\\f(0)&=-1\\\\f(-2)&=3(-2)-1\\\\f(-2)&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=4-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2)=0$, $f(0)=4$, $f(-2)=0$.",
          "worked": "$$\\begin{align*}f(2)&=4-2^2\\\\f(2)&=0\\\\f(0)&=4-0^2\\\\f(0)&=4\\\\f(-2)&=4-(-2)^2\\\\f(-2)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^3+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2)=16$, $f(0)=8$, $f(-2)=0$.",
          "worked": "$$\\begin{align*}f(2)&=2^3+8\\\\f(2)&=16\\\\f(0)&=0^3+8\\\\f(0)&=8\\\\f(-2)&=(-2)^3+8\\\\f(-2)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p4-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=2^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2)=4$, $f(0)=1$, $f(-2)=\\frac14$.",
          "worked": "$$\\begin{align*}f(2)&=2^2\\\\f(2)&=4\\\\f(0)&=2^0\\\\f(0)&=1\\\\f(-2)&=2^{-2}\\\\f(-2)&=\\frac{1}{2^2}\\\\f(-2)&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
