  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Expand each of the following by inserting extra brackets where necessary:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(a+3)^2-(a+2)(a-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7a+15$",
          "worked": "$$\\begin{align*}(a+3)^2-(a+2)(a-3)&=(a^2+6a+9)-(a^2-3a+2a-6)\\\\(a+3)^2-(a+2)(a-3)&=a^2+6a+9-a^2+a+6\\\\(a+3)^2-(a+2)(a-3)&=7a+15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(m-3)(m-4)-(m+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11-9m$",
          "worked": "$$\\begin{align*}(m-3)(m-4)-(m+1)^2&=(m^2-4m-3m+12)-(m^2+2m+1)\\\\(m-3)(m-4)-(m+1)^2&=m^2-7m+12-m^2-2m-1\\\\(m-3)(m-4)-(m+1)^2&=11-9m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2y-x)^2-(2x-y)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y^2-3x^2$",
          "worked": "$$\\begin{align*}(2y-x)^2-(2x-y)^2&=(4y^2-4xy+x^2)-(4x^2-4xy+y^2)\\\\(2y-x)^2-(2x-y)^2&=4y^2-4xy+x^2-4x^2+4xy-y^2\\\\(2y-x)^2-(2x-y)^2&=3y^2-3x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
