  "content": {
    "id": "p5-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In each case explain why the function value cannot be found.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$F(0)$, where $F(x)=\\sqrt{x-4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The square root of a negative number is undefined over the real numbers.",
          "worked": "$$\\begin{align*}F(0)&=\\sqrt{0-4}\\\\F(0)&=\\sqrt{-4}\\end{align*}$$\nThere is no real square root of $-4$, so $F(0)$ is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$H(3)$, where $H(x)=\\sqrt{1-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The square root of a negative number is undefined over the real numbers.",
          "worked": "$$\\begin{align*}H(3)&=\\sqrt{1-3^2}\\\\H(3)&=\\sqrt{-8}\\end{align*}$$\nThere is no real square root of $-8$, so $H(3)$ is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(-2)$, where $g(x)=\\dfrac{1}{2+x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Division by zero is undefined.",
          "worked": "$$\\begin{align*}g(-2)&=\\frac{1}{2+(-2)}\\\\g(-2)&=\\frac{1}{0}\\end{align*}$$\nDivision by zero is undefined, so $g(-2)$ cannot be found.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p5-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(0)$, where $f(x)=\\dfrac{1}{x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Division by zero is undefined.",
          "worked": "$$f(0)=\\frac{1}{0}$$\nDivision by zero is undefined, so $f(0)$ cannot be found.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
