  "content": {
    "id": "p72-q2-node",
    "type": "question",
    "label": "2",
    "prompt": "How many degrees does the hour hand of a clock turn in:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p72-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "12 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360^\\circ$",
          "worked": "The hour hand completes one full turn in 12 hours, so it turns $360^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p72-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "24 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720^\\circ$",
          "worked": "The hour hand completes two full turns in 24 hours.\n$$\\begin{align*}\\text{Rotation}&=\\frac{24}{12}\\times360^\\circ\\\\\\text{Rotation}&=720^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p72-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "6 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180^\\circ$",
          "worked": "$$\\begin{align*}\\text{Rotation}&=\\frac{6}{12}\\times360^\\circ\\\\\\text{Rotation}&=180^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p72-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "1 hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^\\circ$",
          "worked": "$$\\begin{align*}\\text{Rotation}&=360^\\circ\\div12\\\\\\text{Rotation}&=30^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p72-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "30 minutes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15^\\circ$",
          "worked": "The hour hand turns $30^\\circ$ in 60 minutes.\n$$\\begin{align*}\\text{Rotation}&=\\frac{30}{60}\\times30^\\circ\\\\\\text{Rotation}&=15^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p72-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "1 minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5^\\circ$",
          "worked": "The hour hand turns $30^\\circ$ in 60 minutes.\n$$\\begin{align*}\\text{Rotation}&=30^\\circ\\div60\\\\\\text{Rotation}&=0.5^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
