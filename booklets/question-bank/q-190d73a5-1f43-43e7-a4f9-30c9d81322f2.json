  "content": {
    "id": "p6-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Find $F(t)-2$ and $F(t-2)$ for each function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$F(x)=5x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(t)-2=5t$, $F(t-2)=5t-8$.",
          "worked": "$$\\begin{align*}F(t)-2&=5t+2-2\\\\F(t)-2&=5t\\\\F(t-2)&=5(t-2)+2\\\\F(t-2)&=5t-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p6-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$F(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(t)-2=\\sqrt{t}-2$, $F(t-2)=\\sqrt{t-2}$.",
          "worked": "$$\\begin{align*}F(t)-2&=\\sqrt{t}-2\\\\F(t-2)&=\\sqrt{t-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$F(x)=x^2+2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(t)-2=t^2+2t-2$, $F(t-2)=t^2-2t$.",
          "worked": "$$\\begin{align*}F(t)-2&=t^2+2t-2\\\\F(t-2)&=(t-2)^2+2(t-2)\\\\F(t-2)&=t^2-4t+4+2t-4\\\\F(t-2)&=t^2-2t\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$F(x)=2-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(t)-2=-t^2$, $F(t-2)=-t^2+4t-2$.",
          "worked": "$$\\begin{align*}F(t)-2&=2-t^2-2\\\\F(t)-2&=-t^2\\\\F(t-2)&=2-(t-2)^2\\\\F(t-2)&=2-(t^2-4t+4)\\\\F(t-2)&=-t^2+4t-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
