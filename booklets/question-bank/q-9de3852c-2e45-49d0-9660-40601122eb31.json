  "content": {
    "id": "v2-204eb-p25-practice-slot-12-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Complete the square to show that $x^2-6x+13=0$ has no real solution.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^2-6x+13=(x-3)^2+4\\ge4$, so it is never $0$.",
      "worked": "$$\\begin{align*}x^2-6x+13&=x^2-6x+(-3)^2-(-3)^2+13\\\\&=(x-3)^2+4\\end{align*}$$\nSince $(x-3)^2\\ge0$, we have $(x-3)^2+4\\ge4>0$. So $x^2-6x+13$ is never $0$ and the equation has no real solution.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
