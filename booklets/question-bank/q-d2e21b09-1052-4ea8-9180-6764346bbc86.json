    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+4=\\frac{12}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6$ or $x=2$.",
          "worked": "For $x\\ne0$, multiply both sides by $x$.\n$$\\begin{align*}x(x+4)&=12\\\\x^2+4x-12&=0\\\\(x+6)(x-2)&=0\\\\x+6&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-6\\quad\\text{or}\\quad x=2\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-3=\\frac{10}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=5$.",
          "worked": "For $x\\ne0$, multiply both sides by $x$.\n$$\\begin{align*}x(x-3)&=10\\\\x^2-3x-10&=0\\\\(x+2)(x-5)&=0\\\\x+2&=0\\quad\\text{or}\\quad x-5=0\\\\x&=-2\\quad\\text{or}\\quad x=5\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p11-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x-\\frac{35}{x}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$ or $x=7$.",
          "worked": "For $x\\ne0$, multiply both sides by $x$.\n$$\\begin{align*}x^2-35&=2x\\\\x^2-2x-35&=0\\\\(x+5)(x-7)&=0\\\\x+5&=0\\quad\\text{or}\\quad x-7=0\\\\x&=-5\\quad\\text{or}\\quad x=7\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p11-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=\\frac{18}{x}-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-9$ or $x=2$.",
          "worked": "For $x\\ne0$, multiply both sides by $x$.\n$$\\begin{align*}x^2&=18-7x\\\\x^2+7x-18&=0\\\\(x+9)(x-2)&=0\\\\x+9&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-9\\quad\\text{or}\\quad x=2\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p11-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+2)(x+4)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=-5$.",
          "worked": "$$\\begin{align*}x^2+6x+8&=3\\\\x^2+6x+5&=0\\\\(x+1)(x+5)&=0\\\\x+1&=0\\quad\\text{or}\\quad x+5=0\\\\x&=-1\\quad\\text{or}\\quad x=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p11-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x-2)(x+5)=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6$ or $x=3$.",
          "worked": "$$\\begin{align*}x^2+3x-10&=8\\\\x^2+3x-18&=0\\\\(x+6)(x-3)&=0\\\\x+6&=0\\quad\\text{or}\\quad x-3=0\\\\x&=-6\\quad\\text{or}\\quad x=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p11-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$(2x+1)(x+5)=18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{13}{2}$ or $x=1$.",
          "worked": "$$\\begin{align*}2x^2+11x+5&=18\\\\2x^2+11x-13&=0\\\\2x^2+13x-2x-13&=0\\\\x(2x+13)-(2x+13)&=0\\\\(2x+13)(x-1)&=0\\\\2x+13&=0\\quad\\text{or}\\quad x-1=0\\\\x&=-\\frac{13}{2}\\quad\\text{or}\\quad x=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p11-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$(2x-3)(x+2)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{5}{2}$ or $x=2$.",
          "worked": "$$\\begin{align*}2x^2+x-6&=4\\\\2x^2+x-10&=0\\\\2x^2+5x-4x-10&=0\\\\x(2x+5)-2(2x+5)&=0\\\\(2x+5)(x-2)&=0\\\\2x+5&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-\\frac{5}{2}\\quad\\text{or}\\quad x=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p11-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$x=\\frac{5}{x}-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$ or $x=1$.",
          "worked": "For $x\\ne0$, multiply both sides by $x$.\n$$\\begin{align*}x^2&=5-4x\\\\x^2+4x-5&=0\\\\(x+5)(x-1)&=0\\\\x+5&=0\\quad\\text{or}\\quad x-1=0\\\\x&=-5\\quad\\text{or}\\quad x=1\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p11-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$x=\\frac{2}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $x=2$.",
          "worked": "For $x\\ne1$, multiply both sides by $x-1$.\n$$\\begin{align*}x(x-1)&=2\\\\x^2-x-2&=0\\\\(x+1)(x-2)&=0\\\\x+1&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-1\\quad\\text{or}\\quad x=2\\end{align*}$$\nBoth values satisfy the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
