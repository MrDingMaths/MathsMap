  "content": {
    "id": "v2-a6564-p25-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find the missing values by equating coefficients.\n$$(x-2k)(x+3k)+2x=x^2+dx-54$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=3,\\ d=5$ or $k=-3,\\ d=-1$.",
      "worked": "$$\\begin{aligned}x^2+kx-6k^2+2x&=x^2+dx-54\\\\x^2+(k+2)x-6k^2&=x^2+dx-54\\end{aligned}$$\nEquating coefficients of $x$ and constant terms:\n$$\\begin{aligned}k+2&=d,&-6k^2&=-54\\\\&&k^2&=9\\\\&&k&=\\pm3\\end{aligned}$$\nIf $k=3$:\n$$\\begin{aligned}d&=3+2\\\\&=5\\end{aligned}$$\nIf $k=-3$:\n$$\\begin{aligned}d&=-3+2\\\\&=-1\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
