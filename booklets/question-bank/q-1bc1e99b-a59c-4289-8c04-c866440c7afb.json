    "id": "v2-0b24d3-p3-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "A water tank is $\\frac{1}{3}$ full. After rain, a further $\\frac{2}{9}$ of the tank's capacity is added. Write the fraction of the tank that is now full as a recurring decimal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.\\dot{5}$",
      "worked": "$$\\begin{align*}\\frac{1}{3}+\\frac{2}{9}&=\\frac{3}{9}+\\frac{2}{9}\\\\&=\\frac{5}{9}\\\\&=0.555555\\ldots\\\\&=0.\\dot{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
