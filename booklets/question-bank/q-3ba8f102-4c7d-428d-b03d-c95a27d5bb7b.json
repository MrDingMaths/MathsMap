  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "How many ways can two cards be dealt from a standard deck of 52 cards? (Assume the order in which they are dealt is irrelevant.)",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "1326",
      "worked": "Order is irrelevant, so choose 2 cards from 52.\n$$\\begin{align*}\\binom{52}{2}&=\\frac{52!}{2!50!}\\\\\\binom{52}{2}&=\\frac{52\\times51}{2}\\\\\\binom{52}{2}&=1326.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
