    "children": [
      {
        "id": "p13-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $A=x\\sqrt{3600-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\frac{dA}{dx}=\\frac{3600-2x^2}{\\sqrt{3600-x^2}}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q8-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}A&=x(3600-x^2)^{1/2}\\\\\\frac{dA}{dx}&=(3600-x^2)^{1/2}+x\\left(\\frac12\\right)(3600-x^2)^{-1/2}(-2x)\\\\\\frac{dA}{dx}&=\\frac{3600-x^2-x^2}{\\sqrt{3600-x^2}}\\\\\\frac{dA}{dx}&=\\frac{3600-2x^2}{\\sqrt{3600-x^2}}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p13-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find any stationary points on $A=x\\sqrt{3600-x^2}$ (to 1 decimal place) and determine their nature.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(42.4,1800.0)$ is a local maximum; $(-42.4,-1800.0)$ is a local minimum.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q8-b-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}3600-2x^2&=0\\\\x^2&=1800\\\\x&=\\pm30\\sqrt2\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
