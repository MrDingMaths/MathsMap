  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $f(x)=\\sqrt{x}$ for $x\\ge0$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$f(4)=\\sqrt4=2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$f(9)=\\sqrt9=3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$ given $f(x)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=16$",
          "worked": "$$\\begin{align*}\\sqrt{x}&=4\\\\x&=4^2\\\\x&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x$ given $f(x)=9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=81$",
          "worked": "$$\\begin{align*}\\sqrt{x}&=9\\\\x&=9^2\\\\x&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
