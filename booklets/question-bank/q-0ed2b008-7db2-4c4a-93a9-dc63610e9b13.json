        "label": "a",
        "prompt": "$A$ and $B$ are mutually exclusive.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9$",
          "worked": "Since $A$ and $B$ are mutually exclusive, $P(A\\cap B)=0$.\n\n$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=0.3+0.6-0\\\\P(A\\cup B)&=0.9\\end{align*}$$",
          "solutionDiagrams": []
        },
