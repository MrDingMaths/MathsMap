                    "latex": "P(A\\cap B)=P(A)P(B)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then apply the addition rule.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $A$ and $B$ are independent,\n\n$$\\begin{align*}P(A\\cap B)&=P(A)P(B)\\\\P(A\\cap B)&=0.3\\times0.6\\\\P(A\\cap B)&=0.18\\end{align*}$$\n\n$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=0.3+0.6-0.18\\\\P(A\\cup B)&=0.72\\end{align*}$$",
