    "children": [
      {
        "id": "v2-515e2-p33-practice-slot-14-lower-slot-14-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P(A\\mid B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "$$\\begin{align*}P(B)&=0.15+0.25=0.4\\\\P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\&=\\frac{0.15}{0.4}\\\\&=\\frac38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-515e2-p33-practice-slot-14-lower-slot-14-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(A'\\mid B')$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}P(B')&=0.30+0.30=0.6\\\\P(A'\\mid B')&=\\frac{P(A'\\cap B')}{P(B')}\\\\&=\\frac{0.30}{0.6}\\\\&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
