  "content": {
    "id": "v2-515e2-p33-practice-slot-14-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The Venn diagram shows the probabilities of events $A$ and $B$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "v2-515e2-p33-practice-slot-14-lower-slot-14-lower-diagram",
        "role": "question",
        "format": "tikz",
        "code": "\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (0,0) rectangle (5.2,3.4);\n\\draw[black] (1.9,1.7) circle (1.2);\n\\draw[black] (3.3,1.7) circle (1.2);\n\\node at (1.3,2.5) {$A$};\n\\node at (3.9,2.5) {$B$};\n\\node at (1.4,1.7) {$0.30$};\n\\node at (2.6,1.7) {$0.15$};\n\\node at (3.8,1.7) {$0.25$};\n\\node at (4.7,0.4) {$0.30$};\n\\end{tikzpicture}",
