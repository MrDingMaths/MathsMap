  "content": {
    "id": "p4-q3",
    "type": "question",
    "label": "3",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p4-q3-introduction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A bag contains a red jellybean and a blue jellybean.",
              "marks": []
            }
          ]
        },
        {
          "id": "p4-q3-scenario-1",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Scenario 1: A jellybean is drawn randomly, the colour recorded, and then returned to the bag. Afterwards, a second jellybean is drawn.",
              "marks": []
            }
          ]
        },
        {
          "id": "p4-q3-scenario-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Scenario 2: A jellybean is drawn randomly, the colour recorded, and it is then eaten. Afterwards, a second jellybean is drawn.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Out of the two scenarios, which one represents a series of independent events, and which one represents a series of dependent events?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Scenario 1 is independent; Scenario 2 is dependent.",
          "worked": "Scenario 1 is independent because replacing the first jellybean leaves the bag unchanged. Scenario 2 is dependent because eating the first jellybean changes what remains in the bag.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "In scenario 1, explain why the probability that the second jellybean is red is $\\frac{1}{2}$, regardless of the colour of the first jellybean.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Replacement leaves one red and one blue jellybean, so the draws are independent and $P(\\text{second red})=\\frac{1}{2}$.",
          "worked": "The first jellybean is returned, so the bag again contains one red and one blue jellybean. Therefore $P(\\text{second red})=\\frac{1}{2}$ regardless of the first colour; the draws are independent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "In scenario 2, explain why the conditional probability of the second jellybean being red, given the colour of the first jellybean, is not $\\frac{1}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If the first is red, the probability is $0$; if the first is blue, the probability is $1$.",
          "worked": "If the first jellybean is red, only the blue jellybean remains, so $P(\\text{second red}\\mid\\text{first red})=0$. If the first jellybean is blue, only the red jellybean remains, so $P(\\text{second red}\\mid\\text{first blue})=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
