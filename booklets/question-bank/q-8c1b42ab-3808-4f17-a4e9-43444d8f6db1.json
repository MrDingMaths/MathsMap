        "children": [
          {
            "id": "p43-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "Explain how we can see that this model represents exponential decay.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The graph decreases and the base $0.95$ is between $0$ and $1$.",
              "worked": "The graph decreases as $t$ increases. Since $0<0.95<1$, the mass is multiplied by a factor less than $1$ each year, so the model represents exponential decay.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p43-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "What was the initial mass of radioactive material?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$800\\text{ g}$",
              "worked": "At $t=0$,\n$$\\begin{align*}m&=800(0.95)^0\\\\m&=800\\text{ g}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p43-q3-c",
            "type": "part",
            "label": "c",
            "prompt": "Use the graph to estimate the mass of radioactive substance after 22.5 years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\approx250\\text{ g}$",
              "worked": "Read vertically from $t=22.5$ to the curve, then horizontally to the mass axis. The mass is approximately $250\\text{ g}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p43-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Estimate the time taken for the mass of radioactive substance to reach 600 g.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx6$ years",
          "worked": "Read horizontally from $m=600$ to the curve, then vertically to the time axis. The time is approximately $6$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p43-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "What is the percentage rate of decay each year?\nExplain how you can work this out from looking at the equation $m = 800(0.95)^t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\%$ per year; $0.95=1-0.05$.",
          "worked": "$0.95=1-0.05$, so $95\\%$ of the mass remains each year. The mass therefore decreases by $5\\%$ each year.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
