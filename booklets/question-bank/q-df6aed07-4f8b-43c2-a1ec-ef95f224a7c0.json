  "content": {
    "id": "p39-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A shop made a profit of 6.2% on total costs last year. If the actual profit was $\\$156000$, what were the total costs and what were the total sales? Give monetary answers to the nearest dollar.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Total costs: $\\$2516129$; total sales: $\\$2672129$.",
      "worked": "$$\\begin{align*}\\text{Profit}&=\\text{costs}\\times0.062\\\\\\text{Costs}&=156000\\div0.062\\\\\\text{Costs}&=\\frac{78000000}{31}\\\\\\text{Costs}&\\approx\\$2516129\\\\\\text{Total sales}&=\\frac{78000000}{31}+156000\\\\\\text{Total sales}&\\approx\\$2672129\\end{align*}$$\nBoth monetary answers are rounded to the nearest dollar.",
      "solutionDiagrams": []
    },
