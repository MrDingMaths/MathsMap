          "worked": "$$\\begin{aligned}\\frac{x^2-5x}{x}&=\\frac{x(x-5)}{x}\\\\&=x-5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3x^2+6x}{3x}$",
