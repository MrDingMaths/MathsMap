          "worked": "$$\\begin{aligned}\\frac{3x^2+6x}{3x}&=\\frac{3x(x+2)}{3x}\\\\&=x+2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q8-d",
        "type": "part",
        "label": "d",
