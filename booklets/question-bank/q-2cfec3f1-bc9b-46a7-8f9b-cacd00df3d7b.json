        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{aligned}\\frac{x^2+3x}{x}&=\\frac{x(x+3)}{x}\\\\&=x+3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
