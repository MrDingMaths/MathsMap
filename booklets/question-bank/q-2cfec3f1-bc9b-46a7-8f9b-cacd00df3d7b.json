          "worked": "$$\\begin{aligned}\\frac{4x^2+8x}{2x}&=\\frac{4x(x+2)}{2x}\\\\&=2(x+2)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
