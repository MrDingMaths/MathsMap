  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Solve the following for $\\theta\\in[0,2\\pi]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\theta=-\\frac{\\sqrt3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{4\\pi}{3},\\frac{5\\pi}{3}$.",
          "worked": "The reference angle is $\\frac{\\pi}{3}$. Sine is negative in quadrants III and IV.\n$$\\begin{align*}\\theta&=\\pi+\\frac{\\pi}{3},\\ 2\\pi-\\frac{\\pi}{3}\\\\\\theta&=\\frac{4\\pi}{3},\\ \\frac{5\\pi}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta=-\\frac{1}{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{5\\pi}{6},\\frac{11\\pi}{6}$.",
          "worked": "The reference angle is $\\frac{\\pi}{6}$. Tangent is negative in quadrants II and IV.\n$$\\begin{align*}\\theta&=\\pi-\\frac{\\pi}{6},\\ 2\\pi-\\frac{\\pi}{6}\\\\\\theta&=\\frac{5\\pi}{6},\\ \\frac{11\\pi}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan^2\\theta=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{3},\\frac{2\\pi}{3},\\frac{4\\pi}{3},\\frac{5\\pi}{3}$.",
          "worked": "$$\\begin{align*}\\tan\\theta&=\\pm\\sqrt3\\\\\\theta&=\\frac{\\pi}{3},\\ \\frac{2\\pi}{3},\\ \\frac{4\\pi}{3},\\ \\frac{5\\pi}{3}\\end{align*}$$\nThe reference angle is $\\frac{\\pi}{3}$; both signs include all four quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$4\\sin^2\\theta=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\frac{\\pi}{3},\\frac{2\\pi}{3},\\frac{4\\pi}{3},\\frac{5\\pi}{3}$.",
          "worked": "$$\\begin{align*}\\sin^2\\theta&=\\frac{3}{4}\\\\\\sin\\theta&=\\pm\\frac{\\sqrt3}{2}\\\\\\theta&=\\frac{\\pi}{3},\\ \\frac{2\\pi}{3},\\ \\frac{4\\pi}{3},\\ \\frac{5\\pi}{3}\\end{align*}$$\nThe reference angle is $\\frac{\\pi}{3}$; both signs include all four quadrants.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
