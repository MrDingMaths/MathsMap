  "content": {
    "id": "p18-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A square has area $(x^2-12x+36)$ cm². Write an expression for its side length.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$|x-6|\\text{ cm}$",
      "worked": "The side length is the nonnegative square root of the area.\n$$\\begin{align*}s&=\\sqrt{x^2-12x+36}\\\\s&=\\sqrt{(x-6)^2}\\\\s&=|x-6|\\text{ cm}\\end{align*}$$\nFor $x>6$, this is $(x-6)\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
