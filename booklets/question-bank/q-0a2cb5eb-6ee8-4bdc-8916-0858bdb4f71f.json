  "content": {
    "id": "p23-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "John walked to school at an average speed of $3$ km/h and jogged back along the same route at $5$ km/h. If his total travelling time was $1$ hour, what is the distance to school?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{15}{8}$ km",
      "worked": "Let $d$ km be the distance to school. The outward and return times are $\\frac{d}{3}$ h and $\\frac{d}{5}$ h.\n$$\\begin{align*}\\frac{d}{3}+\\frac{d}{5}&=1\\\\5d+3d&=15\\\\8d&=15\\\\d&=\\frac{15}{8}\\end{align*}$$\nThe distance to school is $\\frac{15}{8}$ km.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
