  "content": {
    "id": "p14-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate each expression for $x=-\\frac{1}{3}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\frac{2}{3}$",
          "worked": "$$\\begin{align*}5x&=5\\times\\left(-\\frac{1}{3}\\right)\\\\5x&=-\\frac{5}{3}\\\\5x&=-1\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$1-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{3}$",
          "worked": "$$\\begin{align*}1-x&=1-\\left(-\\frac{1}{3}\\right)\\\\1-x&=1+\\frac{1}{3}\\\\1-x&=\\frac{4}{3}\\\\1-x&=1\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}x^2&=\\left(-\\frac{1}{3}\\right)^2\\\\x^2&=\\left(-\\frac{1}{3}\\right)\\times\\left(-\\frac{1}{3}\\right)\\\\x^2&=\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$-7x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{3}$",
          "worked": "$$\\begin{align*}-7x-1&=-7\\times\\left(-\\frac{1}{3}\\right)-1\\\\-7x-1&=\\frac{7}{3}-1\\\\-7x-1&=\\frac{4}{3}\\\\-7x-1&=1\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
