  "content": {
    "id": "p58-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Gari buys a ticket to a concert for $\\$90$. She sells it to her friend for $\\$72$. Calculate the percentage loss she made.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$ loss",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=\\$72-\\$90\\\\\\text{Profit/Loss}&=-\\$18\\\\\\text{Percentage profit/loss}&=\\frac{-18}{90}\\times100\\%\\\\\\text{Percentage profit/loss}&=-20\\%\\end{align*}$$\nThe negative result means a $20\\%$ loss.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p58-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Mr Ding buys trading cards for $\\$120$. 10 years later he sells them for $\\$500$. Calculate the percentage profit made.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$316.\\dot{6}\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=\\$500-\\$120\\\\\\text{Profit/Loss}&=\\$380\\\\\\text{Percentage profit/loss}&=\\frac{380}{120}\\times100\\%\\\\\\text{Percentage profit/loss}&=316.\\dot{6}\\%\\end{align*}$$\nThe positive result means a $316.\\dot{6}\\%$ profit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p58-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Ava buys scarves for $\\$15$ and sells them for $\\$21$. What is her percentage profit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\%$ profit",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=\\$21-\\$15\\\\\\text{Profit/Loss}&=\\$6\\\\\\text{Percentage profit/loss}&=\\frac{6}{15}\\times100\\%\\\\\\text{Percentage profit/loss}&=40\\%\\end{align*}$$\nThe positive result means a $40\\%$ profit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p58-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Beth buys a car for $\\$8000$. Two years later, she sells it for $\\$5500$. Work out her percentage loss.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31.25\\%$ loss",
          "worked": "$$\\begin{align*}\\text{Profit/Loss}&=\\$5500-\\$8000\\\\\\text{Profit/Loss}&=-\\$2500\\\\\\text{Percentage profit/loss}&=\\frac{-2500}{8000}\\times100\\%\\\\\\text{Percentage profit/loss}&=-31.25\\%\\end{align*}$$\nThe negative result means a $31.25\\%$ loss.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
