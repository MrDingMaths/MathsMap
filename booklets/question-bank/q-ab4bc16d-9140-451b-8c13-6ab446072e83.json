  "content": {
    "id": "p23-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Joe works for a men’s hairdresser and is paid \\$15 for each haircut.\nIf he averages 26 haircuts per day for 6 days, how much does he earn?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$2340",
      "worked": "$$\\begin{align*}\\text{Number of haircuts} &= 26\\times6\\\\\\text{Number of haircuts} &= 156\\\\\\text{Pay} &= \\$15\\times156\\\\\\text{Pay} &= \\$2340\\end{align*}$$",
      "solutionDiagrams": []
    },
