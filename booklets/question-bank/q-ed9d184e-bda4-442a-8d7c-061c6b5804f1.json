  "content": {
    "id": "p28-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given $P(x)=2x+5$, $Q(x)=x^2-x-2$ and $R(x)=x^3-9x$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q5-abc",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q5-a",
            "type": "part",
            "label": "a",
            "prompt": "Zeroes of $P(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\frac52$",
              "worked": "$\\begin{align*}2x+5&=0\\\\2x&=-5\\\\x&=-\\frac52\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p28-q5-b",
            "type": "part",
            "label": "b",
            "prompt": "Zeroes of $Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-1,\\ 2$",
              "worked": "$\\begin{align*}x^2-x-2&=0\\\\(x+1)(x-2)&=0\\\\x&=-1\\text{ or }2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p28-q5-c",
            "type": "part",
            "label": "c",
            "prompt": "Zeroes of $R(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0,\\ 3,\\ -3$",
              "worked": "$\\begin{align*}x^3-9x&=0\\\\x(x^2-9)&=0\\\\x(x-3)(x+3)&=0\\\\x&=0,\\ 3\\text{ or }-3\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      },
      {
        "id": "p28-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence identify the zeroes of $P(x)Q(x)R(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac52,\\ -1,\\ 2,\\ 0,\\ 3,\\ -3$",
          "worked": "The product is zero when any factor is zero. Its zeroes are $-\\frac52,\\ -1,\\ 2,\\ 0,\\ 3,\\ -3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p28-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "Hence sketch $P(x)Q(x)R(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p28-q5-e-grid",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"page 28 question 5e blank coordinate grid\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.25pt,step=0.5] (-4,-3) grid (4,3);\n\\draw[black,line width=0.5pt,<->] (-4.2,0)--(4.2,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,<->] (0,-3.2)--(0,3.2) node[above] {$y$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 90,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 28,
              "sourceRegion": "Question 5e response area",
              "description": "An editable blank Cartesian grid provides drawing space; no solution curve or zeroes are supplied.",
              "mathematics": "Grid step is 0.5 coordinate units on both axes. Numerical scales are left for the student to choose.",
              "answerVisibility": "Question edition: blank axes and grid only."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "Crosses the $x$-axis at $-3,-\\frac52,-1,0,2,3$; both ends rise.",
          "worked": "$\\begin{align*}P(x)Q(x)R(x)&=(2x+5)(x+1)(x-2)x(x-3)(x+3)\\end{align*}$\nThe leading term is $2x^6$, so $y\\to\\infty$ as $x\\to\\pm\\infty$. Each zero has multiplicity 1, so the curve crosses the axis at every zero. The $y$-intercept is $(0,0)$.",
          "solutionDiagrams": [
            {
              "id": "p28-q5-e-answer-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"solution polynomial curve distinguished from axes\"}],\"reference\":\"page 28 question 5e solution graph\"}\n\\begin{tikzpicture}[x=1.2cm,y=0.7cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\draw[black,line width=0.5pt,<->] (-3.7,0)--(3.7,0) node[right] {$x$};\n\\draw[black,line width=0.5pt,<->] (0,-5.1)--(0,6) node[above] {$y$};\n\\draw[curveBlue,line width=0.8pt,<->] plot[domain=-3.3:3.15,samples=601] (\\x,{(2*\\x+5)*(\\x*\\x-\\x-2)*(\\x*\\x*\\x-9*\\x)/30});\n\\foreach \\v in {-3,-2.5,-1,2,3}{\\draw[black,line width=0.4pt] (\\v,-0.08)--(\\v,0.08);}\n\\node[below left] at (-3,-0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\node[below] at (-2.5,-0.65) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-\\frac52$\\special{dvisvgm:raw </g>}};\n\\node[above] at (-1,0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[above] at (2,0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[below right] at (3,-0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
