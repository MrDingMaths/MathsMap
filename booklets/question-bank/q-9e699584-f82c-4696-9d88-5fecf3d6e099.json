        "prompt": "$\\dfrac{7.2\\times10^{6}}{0.85\\times10^{-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.47\\times10^{9}$",
          "worked": "$$\\begin{align*}\\frac{7.2\\times10^{6}}{0.85\\times10^{-3}}&=\\frac{7.2}{0.85}\\times10^{6-(-3)}\\\\&=8.470588\\ldots\\times10^{9}\\\\&\\approx8.47\\times10^{9}\\quad(3\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
