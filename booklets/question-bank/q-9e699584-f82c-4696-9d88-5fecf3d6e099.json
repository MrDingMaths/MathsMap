        "answer": {
          "short": "$2.13\\times10^{-2}$",
          "worked": "$$\\begin{align*}(3.8\\times10^{4})\\times(5.6\\times10^{-7})&=21.28\\times10^{4-7}\\\\&=21.28\\times10^{-3}\\\\&=2.128\\times10^{-2}\\\\&\\approx2.13\\times10^{-2}\\quad(3\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
