    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "are female",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{32}{55}$",
          "worked": "There are $20+22+4+30+28+6=110$ people.\n$$\\begin{align*}\\Pr(\\text{female})&=\\frac{30+28+6}{110}\\\\\\Pr(\\text{female})&=\\frac{64}{110}\\\\\\Pr(\\text{female})&=\\frac{32}{55}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "are female and vote Labor",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{11}$",
          "worked": "$$\\begin{align*}\\Pr(\\text{female}\\cap\\text{Labor})&=\\frac{30}{110}\\\\\\Pr(\\text{female}\\cap\\text{Labor})&=\\frac{3}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "do not vote Labor",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{11}$",
          "worked": "$$\\begin{align*}\\Pr(\\text{not Labor})&=\\frac{22+4+28+6}{110}\\\\\\Pr(\\text{not Labor})&=\\frac{60}{110}\\\\\\Pr(\\text{not Labor})&=\\frac{6}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "are female or vote Labor",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{42}{55}$",
          "worked": "The $30$ females voting Labor are counted in both groups.\n$$\\begin{align*}\\Pr(\\text{female}\\cup\\text{Labor})&=\\frac{64+50-30}{110}\\\\\\Pr(\\text{female}\\cup\\text{Labor})&=\\frac{84}{110}\\\\\\Pr(\\text{female}\\cup\\text{Labor})&=\\frac{42}{55}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "vote Independent, given that they are female",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{32}$",
          "worked": "Restrict the sample space to the $64$ females; $6$ vote Independent.\n$$\\begin{align*}\\Pr(\\text{Independent}\\mid\\text{female})&=\\frac{6}{64}\\\\\\Pr(\\text{Independent}\\mid\\text{female})&=\\frac{3}{32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "are female, given that they vote Independent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "Restrict the sample space to the $4+6=10$ Independent voters; $6$ are female.\n$$\\begin{align*}\\Pr(\\text{female}\\mid\\text{Independent})&=\\frac{6}{10}\\\\\\Pr(\\text{female}\\mid\\text{Independent})&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
