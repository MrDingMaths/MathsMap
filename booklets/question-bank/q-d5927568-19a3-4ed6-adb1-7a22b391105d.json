  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the first four terms of the geometric sequence with first term $\\sqrt{2}$ and common ratio $\\sqrt{2}$. Then, find a formula for the $n$th term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "First four terms: $\\sqrt{2},\\ 2,\\ 2\\sqrt{2},\\ 4$. General term: $a_n=(\\sqrt{2})^n$.",
      "worked": "Multiply each term by $\\sqrt{2}$:\n$$\\begin{align*}a_1&=\\sqrt{2}\\\\a_2&=\\sqrt{2}\\times\\sqrt{2}=2\\\\a_3&=2\\times\\sqrt{2}=2\\sqrt{2}\\\\a_4&=2\\sqrt{2}\\times\\sqrt{2}=4.\\end{align*}$$\nUsing $a_n=ar^{n-1}$,\n$$\\begin{align*}a_n&=\\sqrt{2}(\\sqrt{2})^{n-1}\\\\a_n&=(\\sqrt{2})^n.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
