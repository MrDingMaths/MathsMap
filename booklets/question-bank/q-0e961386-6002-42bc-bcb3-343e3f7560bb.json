  "content": {
    "id": "p3-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Suppose $a,b,\\alpha,\\beta\\in\\mathbb R$. Prove that there exist values of $c,\\phi\\in\\mathbb R$ such that the following identity holds for all values of $\\theta\\in\\mathbb R$: $$a\\sin(\\theta+\\alpha)+b\\cos(\\theta+\\beta)=c\\sin(\\theta+\\phi).$$",
    "layout": "list",
