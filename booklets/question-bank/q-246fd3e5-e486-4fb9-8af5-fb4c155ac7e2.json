  "content": {
    "id": "p51-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find how many arrangements of $n$ people around a circle are possible if $n\\ge4$ and:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n-1)!$",
          "worked": "Fix one person and arrange the remaining $n-1$ people: $(n-1)!$ ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p51-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "two particular people must sit together,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(n-2)!$",
          "worked": "Treat the pair as one unit, giving $n-1$ units. There are $2!$ internal orders for the pair.\n$$\\begin{aligned}N&=(n-2)!\\times2!\\\\&=2(n-2)!\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p51-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "two particular people sit apart,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n-2)!(n-3)$",
          "worked": "Subtract arrangements with the pair together from all arrangements.\n$$\\begin{aligned}N&=(n-1)!-2(n-2)!\\\\&=(n-2)!\\bigl((n-1)-2\\bigr)\\\\&=(n-2)!(n-3)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p51-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "three particular people sit together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(n-3)!$",
          "worked": "Treat the three people as one unit, giving $n-2$ units. There are $3!$ internal orders for the group.\n$$\\begin{aligned}N&=(n-3)!\\times3!\\\\&=6(n-3)!\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
