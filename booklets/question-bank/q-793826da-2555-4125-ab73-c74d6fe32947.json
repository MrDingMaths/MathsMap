  "content": {
    "id": "p11-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Consider a right-angled triangle with sides $a$, $b$ and $c$. Draw an altitude from the right-angle to the hypotenuse, and let its length be $h$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
