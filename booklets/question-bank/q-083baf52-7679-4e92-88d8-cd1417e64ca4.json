  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $y=e^x\\sin x$, find $y'$ and $y''$, and show that $y''-2y'+2y=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y'=e^x(\\sin x+\\cos x)$, $y''=2e^x\\cos x$; hence $y''-2y'+2y=0$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p9-q3-worked-derivatives",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}y'&=e^x\\sin x+e^x\\cos x\\\\&=e^x(\\sin x+\\cos x)\\\\y''&=e^x(\\sin x+\\cos x)+e^x(\\cos x-\\sin x)\\\\&=e^x(2\\cos x)\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p9-q3-worked-verification",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 4,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}y''-2y'+2y&=2e^x\\cos x-2e^x(\\sin x+\\cos x)+2e^x\\sin x\\\\&=2e^x\\cos x-2e^x\\sin x-2e^x\\cos x+2e^x\\sin x\\\\&=0\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
