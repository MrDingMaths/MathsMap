  "content": {
    "id": "p8-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x-1}$",
          "worked": "$$\\begin{aligned}\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}&=\\frac{1}{(x-1)^2}\\times(x^2-1)\\\\\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}&=\\frac{(x-1)(x+1)}{(x-1)^2}\\\\\\frac{1}{(x-1)^2}\\div\\frac{1}{x^2-1}&=\\frac{x+1}{x-1}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x-4}{x^2+2x+1}\\times\\frac{x+1}{x^2-16}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{(x+1)(x+4)}$",
          "worked": "$$\\begin{aligned}\\frac{x-4}{x^2+2x+1}\\times\\frac{x+1}{x^2-16}&=\\frac{(x-4)(x+1)}{(x+1)^2(x-4)(x+4)}\\\\\\frac{x-4}{x^2+2x+1}\\times\\frac{x+1}{x^2-16}&=\\frac{1}{(x+1)(x+4)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{m-2}{4m}\\times\\frac{m}{m-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14$",
          "worked": "$$\\begin{aligned}\\frac{m-2}{4m}\\times\\frac{m}{m-2}&=\\frac{m(m-2)}{4m(m-2)}\\\\\\frac{m-2}{4m}\\times\\frac{m}{m-2}&=\\frac14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{p+1}{8(p-1)}\\times\\frac{4(p-1)}{(p+1)(p+2)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2(p+2)}$",
          "worked": "$$\\begin{aligned}\\frac{p+1}{8(p-1)}\\times\\frac{4(p-1)}{(p+1)(p+2)}&=\\frac{4(p+1)(p-1)}{8(p-1)(p+1)(p+2)}\\\\\\frac{p+1}{8(p-1)}\\times\\frac{4(p-1)}{(p+1)(p+2)}&=\\frac{1}{2(p+2)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac4a\\div\\frac2{a^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a$",
          "worked": "$$\\begin{aligned}\\frac4a\\div\\frac2{a^2}&=\\frac4a\\times\\frac{a^2}{2}\\\\\\frac4a\\div\\frac2{a^2}&=2a\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{5a-7}{2a+4}\\times\\frac{12}{10a-14}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac3{a+2}$",
          "worked": "$$\\begin{aligned}\\frac{5a-7}{2a+4}\\times\\frac{12}{10a-14}&=\\frac{12(5a-7)}{2(a+2)\\cdot2(5a-7)}\\\\\\frac{5a-7}{2a+4}\\times\\frac{12}{10a-14}&=\\frac3{a+2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{2x^2+3x-2}{(2x-1)^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{2x-1}$",
          "worked": "$2\\times(-2)=-4$; the numbers $4$ and $-1$ have product $-4$ and sum $3$.\n\n$$\\begin{aligned}\\frac{2x^2+3x-2}{(2x-1)^2}&=\\frac{2x^2+4x-x-2}{(2x-1)^2}\\\\\\frac{2x^2+3x-2}{(2x-1)^2}&=\\frac{2x(x+2)-(x+2)}{(2x-1)^2}\\\\\\frac{2x^2+3x-2}{(2x-1)^2}&=\\frac{(2x-1)(x+2)}{(2x-1)^2}\\\\\\frac{2x^2+3x-2}{(2x-1)^2}&=\\frac{x+2}{2x-1}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p8-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{(x+3)(x-2)}{x+6}\\div\\frac{x+3}{x+6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2$",
          "worked": "$$\\begin{aligned}\\frac{(x+3)(x-2)}{x+6}\\div\\frac{x+3}{x+6}&=\\frac{(x+3)(x-2)}{x+6}\\times\\frac{x+6}{x+3}\\\\\\frac{(x+3)(x-2)}{x+6}\\div\\frac{x+3}{x+6}&=x-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{x^2+3x-4}{2x-4}\\times\\frac{6x-12}{x-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x+4)$",
          "worked": "$$\\begin{aligned}\\frac{x^2+3x-4}{2x-4}\\times\\frac{6x-12}{x-1}&=\\frac{(x+4)(x-1)}{2(x-2)}\\times\\frac{6(x-2)}{x-1}\\\\\\frac{x^2+3x-4}{2x-4}\\times\\frac{6x-12}{x-1}&=3(x+4)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q9-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac{2x^2-6x}{x^2-1}\\div\\frac{x^2-x-6}{x^2-x-2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x(x-2)}{(x-1)(x+2)}$\n\nFactorise, multiply by the reciprocal, then cancel common factors.",
          "worked": "$$\\begin{aligned}\\frac{2x^2-6x}{x^2-1}\\div\\frac{x^2-x-6}{x^2-x-2}&=\\frac{2x(x-3)}{(x-1)(x+1)}\\div\\frac{(x-3)(x+2)}{(x-2)(x+1)}\\\\\\frac{2x^2-6x}{x^2-1}\\div\\frac{x^2-x-6}{x^2-x-2}&=\\frac{2x(x-3)}{(x-1)(x+1)}\\times\\frac{(x-2)(x+1)}{(x-3)(x+2)}\\\\\\frac{2x^2-6x}{x^2-1}\\div\\frac{x^2-x-6}{x^2-x-2}&=\\frac{2x(x-2)}{(x-1)(x+2)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
