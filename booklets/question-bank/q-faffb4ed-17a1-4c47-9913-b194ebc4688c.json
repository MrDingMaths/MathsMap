        "id": "v2-9cfdc-p26-practice-slot-2-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the exact value of $\\displaystyle\\int_1^3(2x-1)^2\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{62}{3}$",
          "worked": "$$\\begin{align*}\\int_1^3(2x-1)^2\\,dx&=\\int_1^3(4x^2-4x+1)\\,dx\\\\&=\\left[\\frac{4x^3}{3}-2x^2+x\\right]_1^3\\\\&=(36-18+3)-\\left(\\frac43-2+1\\right)\\\\&=21-\\frac13\\\\&=\\frac{62}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-9cfdc-p26-practice-slot-2-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the exact value of $\\displaystyle\\int_{-1}^{2}(x^2-1)(x+2)\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac94$",
          "worked": "$$\\begin{align*}\\int_{-1}^{2}(x^2-1)(x+2)\\,dx&=\\int_{-1}^{2}(x^3+2x^2-x-2)\\,dx\\\\&=\\left[\\frac{x^4}{4}+\\frac{2x^3}{3}-\\frac{x^2}{2}-2x\\right]_{-1}^{2}\\\\&=\\left(4+\\frac{16}{3}-2-4\\right)-\\left(\\frac14-\\frac23-\\frac12+2\\right)\\\\&=\\frac{10}{3}-\\frac{13}{12}\\\\&=\\frac94\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
