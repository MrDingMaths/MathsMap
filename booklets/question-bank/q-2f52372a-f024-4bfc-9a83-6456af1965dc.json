  "content": {
    "id": "p40-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A $2.3\\text{ m}$ length of timber is cut into $5$ equal pieces. How long is each piece, in centimetres?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$46\\text{ cm}$",
      "worked": "$$\\begin{align*}\\text{Length of each piece}&=2.3\\div5\\text{ m}\\\\\\text{Length of each piece}&=0.46\\text{ m}\\\\\\text{Length of each piece}&=0.46\\times100\\text{ cm}\\\\\\text{Length of each piece}&=46\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
