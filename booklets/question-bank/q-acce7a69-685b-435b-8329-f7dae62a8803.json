  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The amount of paint $P$, in litres, used to paint a building is directly proportional to the area $A$, in square metres. A certain building requires 48 L to cover an area of $576\\text{ m}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the constant of variation and write the equation relating $P$ and $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{1}{12},\\quad P=\\dfrac{1}{12}A$.",
          "worked": "$$\\begin{align*}P&=kA\\\\48&=k\\times576\\\\k&=\\frac{48}{576}=\\frac{1}{12}\\\\P&=\\frac{1}{12}A\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "A larger building has an area of $668\\text{ m}^2$ to be painted.\nHow many litres of paint will this require? Round to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "55.67 litres.",
          "worked": "$$\\begin{align*}P&=\\frac{1}{12}\\times668\\\\P&=\\frac{167}{3}\\\\P&\\approx55.67\\end{align*}$$\nThe building requires 55.67 litres of paint, to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
