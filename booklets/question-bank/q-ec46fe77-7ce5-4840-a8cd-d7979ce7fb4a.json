              "type": "text",
              "text": "The daily maximum temperature was recorded in two different cities for a week. The results are shown below.",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q2-city-a",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "City A: 28, 31, 34, 32, 31, 29, 28",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q2-city-b",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "City B: 26, 32, 36, 38, 37, 29, 25",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q2-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Which city had the greater mean daily maximum temperature? Give both means correct to two decimal places.",
              "marks": []
            }
          ]
        }
      ]
