    "type": "question",
    "label": "20",
    "prompt": "A Milo tin has a diameter of $10\\text{ cm}$. How far will it move if it is rolled through six revolutions?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60\\pi\\text{ cm}$",
      "worked": "One revolution moves the tin through one circumference.\n\n$$\\begin{align*}C&=\\pi d\\\\C&=10\\pi\\text{ cm}\\\\\\text{Distance}&=6\\times10\\pi\\\\\\text{Distance}&=60\\pi\\text{ cm}\\end{align*}$$",
