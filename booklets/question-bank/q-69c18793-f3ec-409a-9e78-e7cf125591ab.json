  "content": {
    "id": "p14-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "One candle is 20 cm long and takes 4 hours to burn completely. A second candle is 30 cm long and takes 2 hours to burn completely. If both candles are lit at the same time, then find the time taken for the candles to have the same height.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "1 hour.",
      "worked": "The burn rates are $20\\div4=5$ cm/hour and $30\\div2=15$ cm/hour. After $t$ hours, the heights are $20-5t$ cm and $30-15t$ cm.\n\n$$\\begin{align*}20-5t&=30-15t\\\\20+10t&=30\\\\10t&=10\\\\t&=1\\end{align*}$$\n\nThe candles have the same height after 1 hour.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
