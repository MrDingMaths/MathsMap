  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the requested dimensions. Give exact answers and approximations correct to 2 decimal places where needed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the base of a prism whose volume is 240 cm³, given that its height is 8 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\text{ cm}^2$",
          "worked": "$$\\begin{aligned}240&=8A\\\\A&=240/8=30\\text{ cm}^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the height of a rectangular prism if its square base has sides of length 8.5 cm and its volume is 255 cm³.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{60}{17}\\text{ cm}\\approx3.53\\text{ cm}$",
          "worked": "$$\\begin{aligned}255&=(8.5)^2h\\\\h&=\\frac{255}{72.25}=\\frac{60}{17}\\text{ cm}\\\\h&\\approx3.53\\text{ cm}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the length of the side of a cube whose volume is 15.625 m³.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.5\\text{ m}$",
          "worked": "$$\\begin{aligned}s^3&=15.625\\\\s&=\\sqrt[3]{15.625}=2.5\\text{ m}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the dimensions of a square-based prism if its height is twice the side length of the square and the volume is 1228.25 mm³.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.5\\text{ mm}\\times8.5\\text{ mm}\\times17\\text{ mm}$",
          "worked": "Let the square side be $s$ mm; then its height is $2s$ mm.\n$$\\begin{aligned}1228.25&=s^2(2s)=2s^3\\\\s^3&=614.125\\\\s&=8.5\\text{ mm}\\\\h&=2(8.5)=17\\text{ mm}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
