  "content": {
    "id": "p25-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The cost of 10 cans of drink is $\\$x$. Write an expression for:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "The cost of one can of drink",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{10}$ dollars",
          "worked": "Divide the total cost by 10: one can costs $\\frac{x}{10}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p25-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "The cost of $n$ cans",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{nx}{10}$ dollars",
          "worked": "One can costs $\\frac{x}{10}$ dollars. For $n$ cans, the cost is $n\\times\\frac{x}{10}=\\frac{nx}{10}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
