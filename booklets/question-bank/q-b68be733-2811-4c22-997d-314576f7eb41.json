  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Given $\\cos\\theta=\\frac12$, find the value of $\\sin\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sin\\theta=\\pm\\frac{\\sqrt3}{2}$.",
      "worked": "$$\\begin{align*}\\sin^2\\theta&=1-\\cos^2\\theta\\\\\\sin^2\\theta&=1-\\left(\\frac12\\right)^2\\\\\\sin^2\\theta&=\\frac34\\\\\\sin\\theta&=\\pm\\frac{\\sqrt3}{2}\\end{align*}$$\nBoth signs are possible because no quadrant is specified.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
