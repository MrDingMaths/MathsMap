  "content": {
    "id": "p7-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Identify the leading term of these polynomials.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q11-row1",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-a",
            "type": "part",
            "label": "a",
            "prompt": "$P(x)=\\dfrac{4-2x^2}{4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\dfrac12x^2$",
              "worked": "The highest-power term in the numerator is $-2x^2$.\n$$\\begin{align*}\\text{Leading term}&=\\frac{-2x^2}{4}\\\\&=-\\frac12x^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p7-q11-b",
            "type": "part",
            "label": "b",
            "prompt": "$P(x)=\\dfrac{x^3+7x^2+x-3}{-7}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\dfrac{x^3}{7}$",
              "worked": "The highest-power term in the numerator is $x^3$.\n$$\\begin{align*}\\text{Leading term}&=\\frac{x^3}{-7}\\\\&=-\\frac{x^3}{7}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p7-q11-row2",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-unlabelled-1",
            "type": "part",
            "label": "c",
            "prompt": "$P(x)=\\dfrac{x^3+4x^2}{-8}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\dfrac{x^3}{8}$",
              "worked": "The highest-power term in the numerator is $x^3$.\n$$\\begin{align*}\\text{Leading term}&=\\frac{x^3}{-8}\\\\&=-\\frac{x^3}{8}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p7-q11-c",
            "type": "part",
            "label": "d",
            "prompt": "$P(x)=(x+2)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^2$",
              "worked": "$$\\begin{align*}\\text{Leading term}&=x\\times x\\\\&=x^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p7-q11-row3",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-d",
            "type": "part",
            "label": "e",
            "prompt": "$P(x)=-(x+2)(x+3)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-x^3$",
              "worked": "$$\\begin{align*}\\text{Leading term}&=-x\\times x^2\\\\&=-x^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p7-q11-unlabelled-2",
            "type": "part",
            "label": "f",
            "prompt": "$P(x)=2x(x+5)^2(7-x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2x^4$",
              "worked": "$$\\begin{align*}\\text{Leading term}&=2x\\times x^2\\times(-x)\\\\&=-2x^4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p7-q11-row4",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-e",
            "type": "part",
            "label": "g",
            "prompt": "$P(x)=(x^2-3x)(1-x^3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-x^5$",
              "worked": "$$\\begin{align*}\\text{Leading term}&=x^2\\times(-x^3)\\\\&=-x^5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p7-q11-f",
            "type": "part",
            "label": "h",
            "prompt": "$P(x)=(2x^3-3)^3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8x^9$",
              "worked": "$$\\begin{align*}\\text{Leading term}&=(2x^3)^3\\\\&=8x^9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      }
    ]
  },
