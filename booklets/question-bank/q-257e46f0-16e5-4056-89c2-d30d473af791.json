    "type": "question",
    "label": "2",
    "prompt": "Use the substitution method to solve the following pairs of simultaneous equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-ch14-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=3x-5\\\\x+y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=1$",
          "worked": "Substitute $y=3x-5$ into $x+y=3$.\n$$\\begin{align*}x+(3x-5)&=3\\\\4x-5&=3\\\\4x&=8\\\\x&=2\\\\y&=3(2)-5\\\\y&=1\\end{align*}$$\nCheck: $1=3(2)-5$ and $2+1=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p6-ch14-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}x-2y&=7\\\\x&=3y+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=19,\\ y=6$",
          "worked": "Substitute $x=3y+1$ into $x-2y=7$.\n$$\\begin{align*}(3y+1)-2y&=7\\\\y+1&=7\\\\y&=6\\\\x&=3(6)+1\\\\x&=19\\end{align*}$$\nCheck: $19-2(6)=7$ and $19=3(6)+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p6-ch14-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=3-5x\\\\y&=4x-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{2}{3},\\ y=-\\dfrac{1}{3}$",
          "worked": "Substitute $y=3-5x$ into $y=4x-3$.\n$$\\begin{align*}3-5x&=4x-3\\\\6&=9x\\\\x&=\\frac{2}{3}\\\\y&=4\\left(\\frac{2}{3}\\right)-3\\\\y&=\\frac{8}{3}-\\frac{9}{3}\\\\y&=-\\frac{1}{3}\\end{align*}$$\nCheck both original equations:\n$$\\begin{align*}3-5\\left(\\frac{2}{3}\\right)&=-\\frac{1}{3}\\\\4\\left(\\frac{2}{3}\\right)-3&=-\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
