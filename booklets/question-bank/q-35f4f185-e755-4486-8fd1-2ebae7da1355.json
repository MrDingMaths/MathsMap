    "type": "question",
    "label": "5",
    "prompt": "A pair of shoes marked at $\\$220$ is sold for $\\$176$. What percentage discount has been allowed?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20\\%$",
      "worked": "$$\\begin{align*}\\text{Discount}&=\\$220-\\$176\\\\\\text{Discount}&=\\$44\\\\\\text{Percentage discount}&=\\frac{44}{220}\\times100\\%\\\\\\text{Percentage discount}&=20\\%\\end{align*}$$",
