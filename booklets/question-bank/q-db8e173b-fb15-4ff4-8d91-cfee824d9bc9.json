            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 13 p13-q9-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (2.5,0);\n\\coordinate (C) at (0,2.5);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(A)!0.11!(B)$)--($(A)!0.11!(B)+(A)!0.11!(C)-(A)$)--($(A)!0.11!(C)$);\n\\draw[black,line width=0.4pt] ($(A)!0.48!(B)+(0,-0.09)$)--($(A)!0.48!(B)+(0,0.09)$);\n\\draw[black,line width=0.4pt] ($(A)!0.52!(B)+(0,-0.09)$)--($(A)!0.52!(B)+(0,0.09)$);\n\\draw[black,line width=0.4pt] ($(A)!0.48!(C)+(-0.09,0)$)--($(A)!0.48!(C)+(0.09,0)$);\n\\draw[black,line width=0.4pt] ($(A)!0.52!(C)+(-0.09,0)$)--($(A)!0.52!(C)+(0.09,0)$);\n\\pic[draw=black,line width=0.4pt,angle radius=6mm,angle eccentricity=1.4,\"$45^{\\circ}$\"] {angle=C--B--A};\n\\node[below left] at (A) {$A$};\n\\node[below right] at (B) {$B$};\n\\node[above] at (C) {$C$};\n\\path (A)--(C) node[midway,left=3mm] {$1$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 42,
            "alt": "Mathematical diagram",
            "overlayOf": null,
