        "diagramPlacement": "beside-prompt",
        "answer": {
          "short": "$\\sqrt{2}$",
          "worked": "The matching marks give $AB=AC=1$. By Pythagoras’ theorem,\n$$\\begin{align*}BC^2&=AB^2+AC^2\\\\BC^2&=1^2+1^2\\\\BC^2&=2\\\\BC&=\\sqrt{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q9-b",
        "type": "group",
        "label": "b",
        "prompt": "use your result from part **a** to write down the exact values of:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q9-b-a",
            "type": "part",
            "label": "i",
            "prompt": "$\\sin 45^{\\circ}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{\\sqrt{2}}$",
              "worked": "$$\\begin{align*}\\sin 45^{\\circ}&=\\frac{AC}{BC}\\\\\\sin 45^{\\circ}&=\\frac{1}{\\sqrt{2}}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p13-q9-b-b",
            "type": "part",
            "label": "ii",
            "prompt": "$\\cos 45^{\\circ}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{\\sqrt{2}}$",
              "worked": "$$\\begin{align*}\\cos 45^{\\circ}&=\\frac{AB}{BC}\\\\\\cos 45^{\\circ}&=\\frac{1}{\\sqrt{2}}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p13-q9-b-c",
            "type": "part",
            "label": "iii",
            "prompt": "$\\tan 45^{\\circ}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}\\tan 45^{\\circ}&=\\frac{AC}{AB}\\\\\\tan 45^{\\circ}&=\\frac{1}{1}\\\\\\tan 45^{\\circ}&=1.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          }
        ]
      }
    ]
