    "children": [
      {
        "id": "p15-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why there are two pairs of matching sides of equal length for the two triangles $\\triangle ABD$ and $\\triangle CBD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=BC$ (given); $BD$ is a common side.",
          "worked": "$AB=BC$ (given by the matching side marks).\n\n$BD=BD$ (common side).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Give the reason (SSS, SAS, AAS or RHS) why there are two congruent triangles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "SAS.",
          "worked": "$AB=BC$, $BD$ is common and $\\angle ABD=\\angle CBD$ (marked). The equal angles are included between the equal sides, so the triangles are congruent by SAS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Write a congruence statement.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\triangle ABD\\equiv\\triangle CBD$ (SAS).",
          "worked": "$\\triangle ABD\\equiv\\triangle CBD$ (SAS), with corresponding vertices $A\\leftrightarrow C$, $B\\leftrightarrow B$ and $D\\leftrightarrow D$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p15-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why $AC$ is perpendicular $(90^\\circ)$ to $DB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ADB=\\angle CDB$ (corresponding angles in congruent triangles). They sum to $180^\\circ$, so each is $90^\\circ$. Hence $AC\\perp DB$.",
          "worked": "$\\angle ADB=\\angle CDB$ (corresponding angles in congruent triangles).\n\n$\\angle ADB+\\angle CDB=180^\\circ$ (angles on the straight line $AC$).\n\nThe two angles are equal and sum to $180^\\circ$, so each is $90^\\circ$.\n\nTherefore $AC\\perp DB$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
