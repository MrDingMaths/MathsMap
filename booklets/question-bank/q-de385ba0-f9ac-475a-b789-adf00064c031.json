  "content": {
    "id": "p31-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Let $P(x)=x^3+2x-1$. Find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}P(1)&=1^3+2(1)-1\\\\P(1)&=1+2-1\\\\P(1)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
