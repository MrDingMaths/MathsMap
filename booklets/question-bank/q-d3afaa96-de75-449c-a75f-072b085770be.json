  "content": {
    "id": "p61-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The lifespan of a brand of light bulb is normally distributed with mean 1200 hours and standard deviation 80 hours. A bulb lasts longer than 95% of bulbs of this brand. Find its lifespan to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1331.6$ hours",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p61-q4-worked-probability",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "We want a z-score with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "P(Z\\le z)=0.95",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p61-q4-worked-inverse",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using inverse normal on a calculator, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "z=1.6448536\\ldots",
                "display": false
              },
              {
                "type": "text",
                "text": ". Keep full calculator precision.",
                "marks": []
              }
            ]
          },
          {
            "id": "p61-q4-worked-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}x&=\\mu+z\\sigma\\\\x&=1200+(1.6448536\\ldots)(80)\\\\x&=1331.58829\\ldots\\\\x&\\approx1331.6\\text{ hours}\\quad\\text{(1 d.p.)}\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
