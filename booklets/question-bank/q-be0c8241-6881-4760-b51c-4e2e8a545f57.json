    "type": "question",
    "label": null,
    "prompt": "The value $V$ dollars of a machine, $t$ years after it was purchased, is given by $V=Ae^{-0.08t}$.\n\nFind $A$ if the machine was purchased for $\\$36\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A=36\\,000$ dollars.",
      "worked": "At $t=0$, $V=36000$:\n$$\\begin{align*}36000&=Ae^{0}\\\\A&=36000\\end{align*}$$",
      "solutionDiagrams": []
    },
