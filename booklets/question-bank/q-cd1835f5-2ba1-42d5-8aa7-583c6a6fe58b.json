  "content": {
    "id": "p15-q12",
    "type": "question",
    "label": "12",
    "prompt": "There are 100 rabbits on Mt Burrow at the start of the year 2000. The rule for the number of rabbits $N$ after $t$ years (from the start of the year 2000) is $N = 100 \\times 2^t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q12-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the number of rabbits at:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q12-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$t = 2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "400 rabbits",
              "worked": "$$\\begin{align*}N &= 100 \\times 2^2\\\\&=100 \\times 4\\\\&=400\\end{align*}$$\nThere are 400 rabbits.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p15-q12-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$t = 6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "6400 rabbits",
              "worked": "$$\\begin{align*}N &= 100 \\times 2^6\\\\&=100 \\times 64\\\\&=6400\\end{align*}$$\nThere are 6400 rabbits.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p15-q12-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "The beginning of 2007",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "12 800 rabbits",
              "worked": "$$\\begin{align*}t &= 2007-2000\\\\&=7\\\\N &=100 \\times 2^7\\\\&=100 \\times 128\\\\&=12\\,800\\end{align*}$$\nThere are 12 800 rabbits.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p15-q12-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "The beginning of 2010",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "102 400 rabbits",
              "worked": "$$\\begin{align*}t &=2010-2000\\\\&=10\\\\N &=100 \\times 2^{10}\\\\&=100 \\times 1024\\\\&=102\\,400\\end{align*}$$\nThere are 102 400 rabbits.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      },
      {
        "id": "p15-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "How many years will it take for the population to first rise to more than 500 000?\nGive a whole number of years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "13 years",
          "worked": "Check consecutive whole numbers of years:\n$$\\begin{align*}N(12)&=100 \\times 2^{12}\\\\&=100 \\times 4096\\\\&=409\\,600\\\\N(13)&=100 \\times 2^{13}\\\\&=100 \\times 8192\\\\&=819\\,200\\end{align*}$$\nThe population doubles each year. It is below 500 000 after 12 years and above 500 000 after 13 years, so the first whole number of years is 13.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
