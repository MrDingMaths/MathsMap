            "prompt": "$|6x-7|>5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x<\\frac13$ or $x>2$.",
              "worked": "$$\\begin{aligned}6x-7&>5\\\\6x&>12\\\\x&>2\\end{aligned}$$\nOr\n$$\\begin{aligned}-(6x-7)&>5\\\\-6x+7&>5\\\\-6x&>-2\\\\x&<\\frac13\\end{aligned}$$\nTherefore $x<\\frac13$ or $x>2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p17-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "$|7-6x|>5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x<\\frac13$ or $x>2$.",
              "worked": "$$\\begin{aligned}7-6x&>5\\\\-6x&>-2\\\\x&<\\frac13\\end{aligned}$$\nOr\n$$\\begin{aligned}-(7-6x)&>5\\\\-7+6x&>5\\\\6x&>12\\\\x&>2\\end{aligned}$$\nTherefore $x<\\frac13$ or $x>2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      },
      {
        "id": "p17-q3-explain",
        "type": "part",
        "label": "c",
        "prompt": "Explain why the answers are the same.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|6x-7|=|7-6x|$, since the expressions inside the absolute value signs are opposites.",
          "worked": "$7-6x=-(6x-7)$ and a number and its opposite have the same absolute value. Thus $|7-6x|=|6x-7|$, so the inequalities have the same solutions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
