  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "By substituting appropriate values of $k$, find the first term $a$ and last term $\\ell$ of each sum. Then evaluate the sum using $S_n=\\dfrac{n}{2}(a+\\ell)$. (Note that all four series are APs.)",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\sum_{k=1}^{200}(600-2k)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=598$, $\\ell=200$; sum $=79800$.",
          "worked": "$$\\begin{align*}a&=600-2(1)=598\\\\\\ell&=600-2(200)=200\\\\n&=200\\\\S_{200}&=\\frac{200}{2}(598+200)\\\\S_{200}&=79800\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\sum_{k=1}^{61}(93-3k)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=90$, $\\ell=-90$; sum $=0$.",
          "worked": "$$\\begin{align*}a&=93-3(1)=90\\\\\\ell&=93-3(61)=-90\\\\n&=61\\\\S_{61}&=\\frac{61}{2}(90-90)\\\\S_{61}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p22-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\sum_{k=1}^{40}(3k-50)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-47$, $\\ell=70$; sum $=460$.",
          "worked": "$$\\begin{align*}a&=3(1)-50=-47\\\\\\ell&=3(40)-50=70\\\\n&=40\\\\S_{40}&=\\frac{40}{2}(-47+70)\\\\S_{40}&=460\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p22-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\sum_{k=10}^{30}(5k+3)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=53$, $\\ell=153$; sum $=2163$.",
          "worked": "$$\\begin{align*}a&=5(10)+3=53\\\\\\ell&=5(30)+3=153\\\\n&=30-10+1=21\\\\S_{21}&=\\frac{21}{2}(53+153)\\\\S_{21}&=2163\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
