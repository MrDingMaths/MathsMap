  "content": {
    "id": "p97-q19-response",
    "type": "question",
    "label": null,
    "prompt": "The variable $A$ varies inversely with the square root of $d$. If $A = 12$ when $d = 4$, find $A$ when $d = 16$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$A = 6$",
      "worked": "Since $A$ varies inversely with $\\sqrt{d}$,\n$$\\begin{align*}A &= \\frac{k}{\\sqrt{d}}\\\\12 &= \\frac{k}{\\sqrt{4}}\\\\k &= 24\\end{align*}$$\nWhen $d = 16$,\n$$\\begin{align*}A &= \\frac{24}{\\sqrt{16}}\\\\A &= 6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
