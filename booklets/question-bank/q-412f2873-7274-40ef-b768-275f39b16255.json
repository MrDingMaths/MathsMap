  "content": {
    "id": "p54-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the equation of the final curve in the form $y=f(ax+b)$ if $y=f(x)$ is",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "translated right by 2 units, then dilated horizontally by a factor of $\\frac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=f(3x-2)$",
          "worked": "Translate right by 2: replace $x$ by $x-2$.\n$$\\begin{align*}y&=f(x-2)\\end{align*}$$\nDilate horizontally by factor $\\frac{1}{3}$: replace $x$ by $3x$ in the translated rule.\n$$\\begin{align*}y&=f(3x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "translated left by 3 units, then dilated horizontally by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=f\\left(\\frac{x}{2}+3\\right)$",
          "worked": "Translate left by 3: replace $x$ by $x+3$.\n$$\\begin{align*}y&=f(x+3)\\end{align*}$$\nDilate horizontally by factor 2: replace $x$ by $\\frac{x}{2}$ in the translated rule.\n$$\\begin{align*}y&=f\\left(\\frac{x}{2}+3\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
