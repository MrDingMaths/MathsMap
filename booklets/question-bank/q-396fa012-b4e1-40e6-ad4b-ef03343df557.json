          {
            "id": "p6-q12-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=\\frac{n}{m^2}",
                "display": false
              },
              {
                "type": "text",
                "text": " and verify that ",
