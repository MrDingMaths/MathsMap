    "children": [
      {
        "id": "routine-bivar-r248-calculator-analysis-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the regression line predicting value $V$ from age $A$. Give the coefficients to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V = 33.18 - 1.99A$.",
          "worked": "Enter ages as $x$ and values as $y$ in the calculator's two-variable statistics mode. Select linear regression $y=a+bx$.\n$$\\begin{align*}a&=33.183673\\ldots\\\\b&=-1.989795\\ldots\\\\V&\\approx33.18-1.99A\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "routine-bivar-r248-calculator-analysis-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Using the rounded equation from part a, predict the value of a car that is 15 years old. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated value of $3.3$ thousand dollars.",
          "worked": "$$\\begin{align*}V&=33.18-1.99(15)\\\\V&=3.33\\\\V&\\approx3.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "routine-bivar-r248-calculator-analysis-2-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the rounded equation from part a, predict the age of a car that has a value of 17 thousand dollars. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated age of $8.1$ years.",
          "worked": "$$\\begin{align*}17&=33.18-1.99A\\\\1.99A&=16.18\\\\A&=\\frac{16.18}{1.99}\\\\A&\\approx8.1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "routine-bivar-r248-calculator-analysis-2-d",
        "type": "part",
        "label": "d",
        "prompt": "Is part b or c an example of extrapolation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Part b: an age of $15$ years is outside the observed range $1$–$12$.",
          "worked": "Part b uses an age of $15$ years, above the observed range $1$–$12$, so it is extrapolation. Part c uses a value of $17$ thousand dollars, within the observed range $9$–$31$, so it is interpolation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
