                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720=45w$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "3493ddaa-9e21-4645-b056-dcadd6466e5a-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
