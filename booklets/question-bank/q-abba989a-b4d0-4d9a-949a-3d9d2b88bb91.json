  "content": {
    "id": "p12-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A rectangle has length $l$ and width $w$. The formula for the area is $A=lw$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the formula to find $A$ when $l=40$ and $w=17$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=680$",
          "worked": "$$\\begin{align*}A&=lw\\\\A&=40\\times17\\\\A&=680\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q11-b",
        "type": "part",
        "label": "b",
