                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}A&=lw\\\\720&=45w\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve your equation to find the width of this rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=16\\text{ cm}$",
          "worked": "$$\\begin{align*}720&=45w\\\\w&=\\frac{720}{45}\\\\w&=16\\end{align*}$$\nThe width is $16\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
