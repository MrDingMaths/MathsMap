    "answer": {
      "short": "$-2\\sqrt{2}$",
      "worked": "$$\\begin{align*}\\sqrt{18}-\\sqrt{162}+\\sqrt{32}&=\\sqrt{9\\times2}-\\sqrt{81\\times2}+\\sqrt{16\\times2}\\\\\\sqrt{18}-\\sqrt{162}+\\sqrt{32}&=3\\sqrt{2}-9\\sqrt{2}+4\\sqrt{2}\\\\\\sqrt{18}-\\sqrt{162}+\\sqrt{32}&=-2\\sqrt{2}\\end{align*}$$",
