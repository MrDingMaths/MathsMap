              "type": "text",
              "text": "The cost of 50 litres of petrol is $94.68. Express this cost in c/L to 2 d.p.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$189.36\\,\\mathrm{c/L}$",
      "worked": "$$\\begin{align*}\\text{Cost per litre}&=\\frac{\\$94.68}{50\\,\\mathrm{L}}\\\\\\text{Cost per litre}&=\\frac{(94.68\\times100)\\,\\mathrm{c}}{50\\,\\mathrm{L}}\\\\\\text{Cost per litre}&=189.36\\,\\mathrm{c/L}\\end{align*}$$",
      "solutionDiagrams": []
    },
