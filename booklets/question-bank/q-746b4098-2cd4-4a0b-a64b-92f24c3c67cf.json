    "answer": {
      "short": "$1.02\\%$",
      "worked": "$\\begin{aligned}\\text{Precision} &= 1\\text{ cm}\\\\\\text{Absolute error} &= \\tfrac12\\times1 = 0.5\\text{ cm}\\\\\\text{Percentage error} &= \\frac{0.5}{49}\\times100\\%\\\\&\\approx 1.02\\%\\quad\\text{(2 d.p.)}\\end{aligned}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
