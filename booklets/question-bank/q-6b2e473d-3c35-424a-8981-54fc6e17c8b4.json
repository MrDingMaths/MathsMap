  "content": {
    "id": "p25-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Two regular dice are rolled. The resulting numbers are multiplied together. Find the probability that the product is a multiple of 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{5}{12}$",
      "worked": "There are $6\\times6=36$ equally likely ordered outcomes. For first-die results $1,2,3,4,5,6$, respectively, the favourable second-die results are $\\{6\\}$, $\\{3,6\\}$, $\\{2,4,6\\}$, $\\{3,6\\}$, $\\{6\\}$ and $\\{1,2,3,4,5,6\\}$.\n\n$$\\begin{align*}N(\\text{favourable})&=1+2+3+2+1+6\\\\N(\\text{favourable})&=15\\\\\\Pr(\\text{product is a multiple of }6)&=\\frac{15}{36}\\\\\\Pr(\\text{product is a multiple of }6)&=\\frac{5}{12}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
