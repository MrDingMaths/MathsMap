  "content": {
    "id": "p131-task25-28-content",
    "type": "question",
    "label": null,
    "prompt": "Show that the following functions are even.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p131-task25-28-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^4+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=(-x)^4+2=x^4+2=f(x)$. Hence even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^4+2\\\\f(-x)&=x^4+2\\\\f(-x)&=f(x).\\end{align*}$$\n\nThus $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p131-task25-28-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2-\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{align*}f(-x)&=(-x)^2-\\frac{1}{(-x)^2}\\\\f(-x)&=x^2-\\frac{1}{x^2}=f(x).\\end{align*}$$\n\nHence even, with $x\\ne0$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2-\\frac{1}{(-x)^2}\\\\f(-x)&=x^2-\\frac{1}{x^2}\\\\f(-x)&=f(x).\\end{align*}$$\n\nThus $f$ is even on its domain, $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p131-task25-28-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3^x+3^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=3^{-x}+3^x=f(x)$. Hence even.",
          "worked": "$$\\begin{align*}f(-x)&=3^{-x}+3^{-(-x)}\\\\f(-x)&=3^{-x}+3^x\\\\f(-x)&=f(x).\\end{align*}$$\n\nThus $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p131-task25-28-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=|x|+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=|-x|+1=|x|+1=f(x)$. Hence even.",
          "worked": "$$\\begin{align*}f(-x)&=|-x|+1\\\\f(-x)&=|x|+1\\\\f(-x)&=f(x).\\end{align*}$$\n\nThus $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
