  "content": {
    "id": "p11-q16",
    "type": "question",
    "label": "16",
    "prompt": "An owl is 7 metres above ground level, in a tree. The owl sees a mouse on the ground at an angle of depression of $32^{\\circ}$.\n\nHow far must the owl fly in a straight line to catch the mouse, assuming the mouse does not move? Answer to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$13.2\\text{ m}$",
      "worked": "Let $x$ metres be the straight-line flight distance. The angle of elevation from the mouse to the owl is $32^{\\circ}$ because the horizontal lines are parallel.\n\n$$\\begin{align*}\\sin 32^{\\circ} &= \\frac{7}{x}\\\\x &= \\frac{7}{\\sin 32^{\\circ}}\\\\x &\\approx 13.2\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
