        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{8}$",
          "worked": "Let $E$ be the event that the sum is even and $U$ the event that at least one die shows $1$. An even sum requires two odd faces or two even faces, giving $2\\times2+2\\times2=8$ equally likely ordered outcomes. The favourable outcomes are $(1,1),(1,3),(3,1)$.\n$$\\begin{align*}P(U\\mid E)&=\\frac{|U\\cap E|}{|E|}\\\\P(U\\mid E)&=\\frac{3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
