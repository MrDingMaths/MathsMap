    "type": "question",
    "label": null,
    "prompt": "Find the value of $s$ such that the vectors $3\\begin{pmatrix}s\\\\1\\end{pmatrix}+\\begin{pmatrix}2\\\\2\\end{pmatrix}$ and $\\begin{pmatrix}5\\\\-8\\end{pmatrix}$ are perpendicular.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$s=2$",
      "worked": "$$3\\begin{pmatrix}s\\\\1\\end{pmatrix}+\\begin{pmatrix}2\\\\2\\end{pmatrix}=\\begin{pmatrix}3s+2\\\\5\\end{pmatrix}$$\nPerpendicular vectors have component products that add to zero.\n$$\\begin{aligned}5(3s+2)+(5)(-8)&=0\\\\15s+10-40&=0\\\\15s-30&=0\\\\15s&=30\\\\s&=2\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
