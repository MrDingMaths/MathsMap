  "content": {
    "id": "p50-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Show that $x^{2}+2mx+(m^{2}+4)=0$ never has any real solutions for any real $m$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\Delta=-16<0$ for every real $m$, so there are no real solutions.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p50-q14-worked-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\Delta&=(2m)^2-4(1)(m^2+4)\\\\&=4m^2-4m^2-16\\\\&=-16\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p50-q14-worked-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since the discriminant is always negative, this equation never has any real solutions.",
                "marks": [],
