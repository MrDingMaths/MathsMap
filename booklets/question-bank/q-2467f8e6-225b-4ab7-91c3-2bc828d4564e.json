  "content": {
    "id": "p37-q7",
    "type": "question",
    "label": "7",
    "prompt": "The letters of the word PROBABILITY are written on separate cards and one is selected randomly. Calculate:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(\\text{Selecting P})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{11}$",
          "worked": "PROBABILITY has 11 letters, including one P.\n$$P(\\text{selecting P})=\\frac{1}{11}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p37-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(\\text{Not selecting P})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{11}$",
          "worked": "$$\\begin{align*}P(\\text{not selecting P})&=1-\\frac{1}{11}\\\\P(\\text{not selecting P})&=\\frac{10}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p37-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(\\text{Selecting I})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{11}$",
          "worked": "Two of the 11 letters are I.\n$$P(\\text{selecting I})=\\frac{2}{11}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p37-q7-d",
