          "short": "$\\frac{9}{11}$",
          "worked": "$$\\begin{align*}P(\\text{not selecting I})&=1-\\frac{2}{11}\\\\P(\\text{not selecting I})&=\\frac{9}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
