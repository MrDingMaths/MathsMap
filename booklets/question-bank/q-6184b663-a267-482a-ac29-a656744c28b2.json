              "type": "text",
              "text": "Two milk bottles are partially filled. Both milk bottles can hold 0.9 litres.",
              "marks": []
            }
          ]
        },
        {
          "id": "p24-q13-fractions",
          "type": "paragraph",
          "fontSize": null,
