  "content": {
    "id": "v2-221dc-p46-practice-slot-6-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The graphs of $y=kx^{2}$ and $y=\\frac{6}{x}$ intersect at the point where $x=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-221dc-p46-practice-slot-6-upper-slot-6-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac34$",
          "worked": "When $x=2$:\n$$\\begin{align*}y&=\\frac{6}{2}\\\\y&=3\\end{align*}$$\nSubstitute $(2,3)$ into $y=kx^{2}$:\n$$\\begin{align*}3&=k(2)^{2}\\\\4k&=3\\\\k&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-221dc-p46-practice-slot-6-upper-slot-6-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that this is the only point of intersection of the two graphs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{3}=8$ has only the real solution $x=2$, so $(2,3)$ is the only intersection.",
          "worked": "$$\\begin{align*}\\frac34x^{2}&=\\frac{6}{x}\\\\3x^{3}&=24\\\\x^{3}&=8\\\\x&=2\\end{align*}$$\nThere is only one real solution, so $(2,3)$ is the only point of intersection.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
