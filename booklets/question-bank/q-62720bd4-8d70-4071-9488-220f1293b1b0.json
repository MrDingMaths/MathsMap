  "content": {
    "id": "p28-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Emmanuel has borrowed $\\$300\\,000$ for seven years at $9\\%$ p.a. interest, compounded annually, in order to start his carpentry business. He intends to pay the whole amount back, plus interest, at the end of the seven years. Give monetary answers to the nearest cent where necessary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the amount owing after one year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$327\\,000$",
          "worked": "$$\\begin{align*}A_1&=P(1+R)^1\\\\A_1&=300\\,000(1.09)\\\\A_1&=\\$327\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the amount owing after seven years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$548\\,411.74$",
          "worked": "$$\\begin{align*}A_7&=P(1+R)^7\\\\A_7&=300\\,000(1.09)^7\\\\A_7&\\approx\\$548\\,411.74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the percentage increase in the debt over the seven-year period, correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$82.80\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\bigl((1.09)^7-1\\bigr)\\times100\\%\\\\\\text{Percentage increase}&\\approx82.80\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p28-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the total interest charged over the seven years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$248\\,411.74$",
          "worked": "$$\\begin{align*}I&=A_7-P\\\\I&=300\\,000(1.09)^7-300\\,000\\\\I&\\approx\\$248\\,411.74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the simple interest on the principal of $\\$300\\,000$ over the seven-year period at the same annual interest rate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$189\\,000$",
          "worked": "$$\\begin{align*}I&=PRT\\\\I&=300\\,000\\times0.09\\times7\\\\I&=\\$189\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
