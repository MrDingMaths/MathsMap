  "content": {
    "id": "p23-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Rewrite these relations in index form (that is, without using logarithms).",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a(x+y)=\\log_a x+\\log_a y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y=xy$",
          "worked": "Using the product law,\n$$\\begin{align*}\\log_a(x+y)&=\\log_a(xy)\\\\x+y&=xy\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p23-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}x=3+\\log_{10}y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1000y$",
          "worked": "$$\\begin{align*}\\log_{10}x&=\\log_{10}1000+\\log_{10}y\\\\\\log_{10}x&=\\log_{10}(1000y)\\\\x&=1000y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_3 x=4\\log_3 y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=y^4$",
          "worked": "Using the power law,\n$$\\begin{align*}\\log_3 x&=\\log_3(y^4)\\\\x&=y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p23-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\log_2 x+3\\log_2 y-4\\log_2 z=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2y^3=z^4$",
          "worked": "$$\\begin{align*}2\\log_2 x+3\\log_2 y&=4\\log_2 z\\\\\\log_2(x^2y^3)&=\\log_2(z^4)\\\\x^2y^3&=z^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "$x\\log_a2=\\log_a y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^x=y$",
          "worked": "Using the power law,\n$$\\begin{align*}\\log_a(2^x)&=\\log_a y\\\\2^x&=y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p23-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a x-\\log_a y=n\\log_a z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=yz^n$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac{x}{y}\\right)&=\\log_a(z^n)\\\\\\frac{x}{y}&=z^n\\\\x&=yz^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p23-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac12\\log_2 x=\\frac13\\log_2 y-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64x^3=y^2$",
          "worked": "Multiply both sides by $6$ and use $6=\\log_2 64$.\n$$\\begin{align*}3\\log_2 x&=2\\log_2 y-6\\\\\\log_2(x^3)+\\log_2 64&=\\log_2(y^2)\\\\\\log_2(64x^3)&=\\log_2(y^2)\\\\64x^3&=y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p23-q16-h",
        "type": "part",
        "label": "h",
        "prompt": "$2\\log_3(2x+1)=3\\log_3(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)^2=(2x-1)^3$",
          "worked": "Using the power law,\n$$\\begin{align*}\\log_3\\bigl((2x+1)^2\\bigr)&=\\log_3\\bigl((2x-1)^3\\bigr)\\\\(2x+1)^2&=(2x-1)^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
