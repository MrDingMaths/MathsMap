      {
        "id": "p18-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sin 3x=3\\sin x-4\\sin^3x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin 3x=3\\sin x-4\\sin^3x$.",
          "worked": "$$\\begin{aligned}\\sin 3x&=\\sin(2x+x)\\\\&=\\sin 2x\\cos x+\\cos 2x\\sin x\\\\&=2\\sin x\\cos^2x+(1-2\\sin^2x)\\sin x\\\\&=2\\sin x(1-\\sin^2x)+\\sin x-2\\sin^3x\\\\&=2\\sin x-2\\sin^3x+\\sin x-2\\sin^3x\\\\&=3\\sin x-4\\sin^3x.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p18-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence solve the equation $\\sin 3x+\\sin 2x=\\sin x$, for $0\\le x\\le2\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\dfrac{\\pi}{3},\\pi,\\dfrac{5\\pi}{3},2\\pi$.",
          "worked": "$$\\begin{aligned}3\\sin x-4\\sin^3x+2\\sin x\\cos x&=\\sin x\\\\\\sin x(3-4\\sin^2x+2\\cos x-1)&=0\\\\\\sin x(2+2\\cos x-4\\sin^2x)&=0\\\\\\sin x\\bigl(2+2\\cos x-4(1-\\cos^2x)\\bigr)&=0\\\\\\sin x(4\\cos^2x+2\\cos x-2)&=0\\\\\\sin x(2\\cos^2x+\\cos x-1)&=0\\\\\\sin x(2\\cos x-1)(\\cos x+1)&=0.\\end{aligned}$$\nThus $\\sin x=0$, $\\cos x=\\dfrac12$ or $\\cos x=-1$.\n$$x=0,\\frac{\\pi}{3},\\pi,\\frac{5\\pi}{3},2\\pi.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
