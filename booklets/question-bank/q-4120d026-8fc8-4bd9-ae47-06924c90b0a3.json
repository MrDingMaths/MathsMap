                "id": "p25-q10-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}M&=\\frac{k}{T}\\\\12&=\\frac{k}{15}\\\\k&=180\\\\M&=\\frac{180}{T}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
