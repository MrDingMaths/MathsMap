  "content": {
    "id": "p25-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A student believes that the time it takes for an ice cube to melt ($M$ minutes) varies inversely with the room temperature $T\\,^{\\circ}\\mathrm{C}$. The student observes that at a room temperature of $15\\,^{\\circ}\\mathrm{C}$ it takes 12 minutes for an ice cube to melt.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation relating $M$ and $T$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=\\dfrac{180}{T}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
