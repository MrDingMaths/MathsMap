  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write each function using a negative power of $x$.\nThen find the primitive function, writing it as a fraction without a negative index.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-2}$; primitive: $-\\dfrac{1}{x}+C$.",
          "worked": "$$\\begin{align*}\\frac{1}{x^2}&=x^{-2}\\\\f(x)&=\\frac{x^{-1}}{-1}+C\\\\f(x)&=-\\frac{1}{x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-3}$; primitive: $-\\dfrac{1}{2x^2}+C$.",
          "worked": "$$\\begin{align*}\\frac{1}{x^3}&=x^{-3}\\\\f(x)&=\\frac{x^{-2}}{-2}+C\\\\f(x)&=-\\frac{1}{2x^2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\dfrac{3}{x^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3x^{-4}$; primitive: $\\dfrac{1}{x^3}+C$.",
          "worked": "$$\\begin{align*}-\\frac{3}{x^4}&=-3x^{-4}\\\\f(x)&=-3\\frac{x^{-3}}{-3}+C\\\\f(x)&=\\frac{1}{x^3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{x^2}-\\dfrac{1}{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-2}-x^{-3}$; primitive: $-\\dfrac{1}{x}+\\dfrac{1}{2x^2}+C$.",
          "worked": "$$\\begin{align*}\\frac{1}{x^2}-\\frac{1}{x^3}&=x^{-2}-x^{-3}\\\\f(x)&=\\frac{x^{-1}}{-1}-\\frac{x^{-2}}{-2}+C\\\\f(x)&=-\\frac{1}{x}+\\frac{1}{2x^2}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
