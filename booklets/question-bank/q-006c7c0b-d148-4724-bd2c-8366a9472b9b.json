    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne0$.",
          "worked": "Division by zero is undefined, so the denominator must satisfy $x\\ne0$. The natural domain is all real numbers except $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R},\\ x\\ne3$.",
          "worked": "Division by zero is undefined.\n$$\\begin{align*}x-3&\\ne0\\\\x&\\ne3\\end{align*}$$\nThe natural domain is all real numbers except $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{1}{2+x}$",
