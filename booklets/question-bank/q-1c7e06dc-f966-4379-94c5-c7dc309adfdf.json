            {
              "type": "math",
              "latex": "\\frac{3}{4},\\; -\\frac{1}{2},\\; -\\frac{5}{3},\\; -\\frac{3}{4},\\; -1\\frac{1}{2},\\; \\frac{1}{16},\\; -\\frac{1}{5},\\; 3\\frac{1}{10}",
