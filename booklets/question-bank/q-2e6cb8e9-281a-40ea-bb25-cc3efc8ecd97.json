      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\cos\\alpha=\\dfrac45$, find $\\cos2\\alpha$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac7{25}$",
          "worked": "$$\\begin{aligned}\\cos2\\alpha&=2\\cos^2\\alpha-1\\\\&=2\\left(\\frac45\\right)^2-1\\\\&=\\frac7{25}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\sin x=\\dfrac23$, find $\\cos2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac19$",
          "worked": "$$\\begin{aligned}\\cos2x&=1-2\\sin^2x\\\\&=1-2\\left(\\frac23\\right)^2\\\\&=\\frac19.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\sin\\theta=\\dfrac5{13}$ and $\\theta$ is acute, find $\\sin2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{120}{169}$",
          "worked": "Since $\\theta$ is acute, $\\cos\\theta>0$.\n$$\\begin{aligned}\\cos\\theta&=\\sqrt{1-\\left(\\frac5{13}\\right)^2}\\\\&=\\frac{12}{13}.\\end{aligned}$$\n$$\\begin{aligned}\\sin2\\theta&=2\\sin\\theta\\cos\\theta\\\\&=2\\left(\\frac5{13}\\right)\\left(\\frac{12}{13}\\right)\\\\&=\\frac{120}{169}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "If $\\tan A=\\dfrac12$, find $\\tan2A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac43$",
          "worked": "$$\\begin{aligned}\\tan2A&=2\\tan A/(1-\\tan^2 A)\\\\&=\\frac{2\\left(\\frac12\\right)}{1-\\left(\\frac12\\right)^2}\\\\&=\\frac43.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
