  "content": {
    "id": "p8-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "$ABCD$ is a rhombus with $\\angle ABD=30^\\circ$. Find the exact length of each diagonal if the side lengths are $10\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AC=10\\text{ cm}$ and $BD=10\\sqrt3\\text{ cm}$.",
      "worked": "Let the diagonals intersect at $O$. The diagonals of a rhombus bisect each other at right angles, so triangle $ABO$ is right-angled at $O$ and $\\angle ABO=30^\\circ$.\n$$\\begin{align*}AO&=10\\sin30^\\circ\\\\AO&=10\\times\\frac12\\\\AO&=5\\text{ cm}\\\\BO&=10\\cos30^\\circ\\\\BO&=10\\times\\frac{\\sqrt3}{2}\\\\BO&=5\\sqrt3\\text{ cm}\\\\AC&=2AO=10\\text{ cm}\\\\BD&=2BO=10\\sqrt3\\text{ cm}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
  },
