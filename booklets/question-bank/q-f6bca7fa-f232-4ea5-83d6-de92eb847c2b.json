              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Complete the following set of steps if we instead first translate and then reflect.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p15-q16d-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "e^x\\;\\xrightarrow[\\text{translate}]{}\\;e^x+1\\;\\xrightarrow[\\text{reflect}]{}\\;",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$-(e^x+1)$",
                  "width": 24
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^x\\xrightarrow[\\text{translate}]{}e^x+1\\xrightarrow[\\text{reflect}]{}-(e^x+1)$",
          "worked": "Add $1$ to the output, then negate the whole output.\n\n$$e^x\\xrightarrow[\\text{translate}]{}e^x+1\\xrightarrow[\\text{reflect}]{}-(e^x+1)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p15-q16e",
        "type": "part",
        "label": "e",
        "prompt": "From the above, did the order matter or did you end up with the same curve doing it either way?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The order mattered.",
          "worked": "Reflecting first gives $y=-e^x+1$. Translating first gives $y=-e^x-1$. The two curves are $2$ units apart vertically.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
