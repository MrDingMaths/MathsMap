  "content": {
    "id": "p15-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Consider the graph of $y=e^x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q16a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the equation of the graph when it is reflected across the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-e^x$",
          "worked": "Reflection across the $x$-axis negates each $y$-value, giving $y=-e^x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q16b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the equation of the new graph if the graph is then translated up by $1$ unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-e^x$",
          "worked": "Add $1$ to the reflected output.\n\n$$\\begin{align*}y&=-e^x+1\\\\y&=1-e^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q16c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p15-q16c-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Complete the following set of steps that were followed in the previous parts.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p15-q16c-scaffold",
              "type": "paragraph",
              "fontSize": null,
