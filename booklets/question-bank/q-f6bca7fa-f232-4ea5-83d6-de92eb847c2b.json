              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "e^x\\;\\xrightarrow[\\text{reflect}]{}\\;-e^x\\;\\xrightarrow[\\text{translate}]{}\\;",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$-e^x+1$",
                  "width": 24
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^x\\xrightarrow[\\text{reflect}]{}-e^x\\xrightarrow[\\text{translate}]{}-e^x+1$",
          "worked": "Reflect the output, then add $1$.\n\n$$e^x\\xrightarrow[\\text{reflect}]{}-e^x\\xrightarrow[\\text{translate}]{}-e^x+1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p15-q16d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
