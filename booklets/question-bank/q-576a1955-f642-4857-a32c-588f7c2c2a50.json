      {
        "id": "p30-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the line with gradient $-6$ that passes through the point $(1,5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x+y=11$",
          "worked": "$$\\begin{align*}y-5&=-6(x-1)\\\\y-5&=-6x+6\\\\y&=-6x+11\\\\6x+y&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p30-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the line that is perpendicular to the line with equation $3x+2y=8$, and that passes through the point $(-1,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-3y+14=0$\n\nThe given line has gradient $-\\frac32$, so the required perpendicular gradient is $\\frac23$.",
          "worked": "$$\\begin{align*}2y&=-3x+8\\\\y&=-\\frac32x+4\\end{align*}$$\nThe perpendicular gradient is $\\frac23$, since $-\\frac32\\times\\frac23=-1$.\n$$\\begin{align*}y-4&=\\frac23(x+1)\\\\3y-12&=2(x+1)\\\\3y-12&=2x+2\\\\3y&=2x+14\\\\2x-3y+14&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
