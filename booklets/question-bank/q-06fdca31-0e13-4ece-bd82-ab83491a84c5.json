    "difficultyReason": "Convert an annual salary to monthly and weekly pay using the supplied formula."
  },
  "content": {
    "id": "p32-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Jenny works as a pastry chef. Her salary is \\$51 064 per annum.\nExpress this salary as an amount (round to the nearest cent where necessary):",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q4-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p32-q4-a-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Per month",
                  "marks": []
                }
              ]
            },
            {
              "id": "p32-q4-a-scaffold",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\text{Pay per period}=\\frac{\\text{Total pay}}{\\text{Number of periods}}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$4255.33 per month.",
          "worked": "$$\\begin{align*}\\text{Monthly pay}&=\\frac{\\text{Total pay}}{\\text{Number of periods}}\\\\\\text{Monthly pay}&=\\frac{\\$51\\,064}{12}\\\\\\text{Monthly pay}&\\approx\\$4255.33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Per week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$982 per week.",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\frac{\\text{Total pay}}{\\text{Number of periods}}\\\\\\text{Weekly pay}&=\\frac{\\$51\\,064}{52}\\\\\\text{Weekly pay}&=\\$982\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
