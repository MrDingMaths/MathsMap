  "content": {
    "id": "p2-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The sum of $\\$5600$ is borrowed for 4 years and $\\$1948.80$ is paid in interest. Calculate the (per annum) rate of simple interest charged.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8.7\\%$ p.a.",
      "worked": "Using $I=Prn$, with $r$ expressed as a decimal:\n$$\\begin{align*}1948.80&=5600\\times r\\times4\\\\r&=\\frac{1948.80}{5600\\times4}\\\\r&=0.087\\end{align*}$$\nThe rate of simple interest is $8.7\\%$ p.a.",
      "solutionDiagrams": []
    },
