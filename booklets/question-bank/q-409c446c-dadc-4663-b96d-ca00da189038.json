      {
        "id": "p47-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $\\log(\\log x)$ using the chain rule.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x\\log x}$",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\bigl(\\log(\\log x)\\bigr)&=\\frac{1}{\\log x}\\cdot\\frac{1}{x}\\\\&=\\frac{1}{x\\log x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p47-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the general solution of $(x\\log x)y'=y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=C\\log x$",
          "worked": "$$\\begin{aligned}\\frac{y'}{y}&=\\frac{1}{x\\log x}\\\\\\int\\frac{1}{y}\\,dy&=\\int\\frac{1}{x\\log x}\\,dx\\\\\\log|y|&=\\log|\\log x|+K\\\\y&=C\\log x\\end{aligned}$$\nThe constant solution $y=0$ is included by taking $C=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
