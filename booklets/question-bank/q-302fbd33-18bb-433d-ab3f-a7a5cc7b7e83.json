  "content": {
    "id": "p8-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Determine the upper and lower limits of these measurements.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "A section of road to be repaired is measured as $870\\text{ m}$ in length, to the nearest $10\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Lower: $865\\text{ m}$; upper: $875\\text{ m}$.",
          "worked": "$$\\begin{align*}\\text{Precision}&=10\\text{ m}\\\\\\text{Absolute error}&=\\tfrac12\\times10=5\\text{ m}\\\\\\text{Upper limit}&=870+5=875\\text{ m}\\\\\\text{Lower limit}&=870-5=865\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "A horse is measured to weigh $485\\text{ kg}$, to the nearest $5\\text{ kg}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Lower: $482.5\\text{ kg}$; upper: $487.5\\text{ kg}$.",
          "worked": "$$\\begin{align*}\\text{Precision}&=5\\text{ kg}\\\\\\text{Absolute error}&=\\tfrac12\\times5=2.5\\text{ kg}\\\\\\text{Upper limit}&=485+2.5=487.5\\text{ kg}\\\\\\text{Lower limit}&=485-2.5=482.5\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "A solution is measured to have $4.72\\text{ g}$ of copper sulphate, to the nearest $0.01\\text{ g}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Lower: $4.715\\text{ g}$; upper: $4.725\\text{ g}$.",
          "worked": "$$\\begin{align*}\\text{Precision}&=0.01\\text{ g}\\\\\\text{Absolute error}&=\\tfrac12\\times0.01=0.005\\text{ g}\\\\\\text{Upper limit}&=4.72+0.005=4.725\\text{ g}\\\\\\text{Lower limit}&=4.72-0.005=4.715\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "A chocolate bar is measured as $91.0\\text{ g}$, to the nearest $0.5\\text{ g}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Lower: $90.75\\text{ g}$; upper: $91.25\\text{ g}$.",
          "worked": "$$\\begin{align*}\\text{Precision}&=0.5\\text{ g}\\\\\\text{Absolute error}&=\\tfrac12\\times0.5=0.25\\text{ g}\\\\\\text{Upper limit}&=91.0+0.25=91.25\\text{ g}\\\\\\text{Lower limit}&=91.0-0.25=90.75\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
