  "content": {
    "id": "v2-429c3-p20-practice-j5-034345-root",
    "type": "question",
    "label": null,
    "prompt": "The harmonic mean $h$ of two numbers $x$ and $y$ is given by\n\n$$\\frac{2}{h}=\\frac{1}{x}+\\frac{1}{y}$$",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-429c3-p20-practice-j5-034345-j5-new-a",
        "type": "part",
        "label": "a",
        "prompt": "Make $x$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{hy}{2y-h}$",
          "worked": "$$\\begin{align*}\\frac{2}{h}-\\frac{1}{y}&=\\frac{1}{x}\\\\\\frac{2y-h}{hy}&=\\frac{1}{x}\\\\\\frac{hy}{2y-h}&=x\\\\x&=\\frac{hy}{2y-h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-429c3-p20-practice-j5-034345-j5-new-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "v2-429c3-p20-practice-j5-034345-j5-new-b-d1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Substitute your answer to part ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "a",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " into ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "2x-h",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " to show that ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "2x-h=\\frac{h^2}{2y-h}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-h=\\frac{h^2}{2y-h}$",
          "worked": "$$\\begin{align*}2x-h&=\\frac{2hy}{2y-h}-h\\\\2x-h&=\\frac{2hy-h(2y-h)}{2y-h}\\\\2x-h&=\\frac{2hy-2hy+h^2}{2y-h}\\\\2x-h&=\\frac{h^2}{2y-h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-429c3-p20-practice-j5-034345-j5-new-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence show that $(2x-h)(2y-h)=h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-h)(2y-h)=h^2$",
          "worked": "$$\\begin{align*}(2x-h)(2y-h)&=\\frac{h^2}{2y-h}\\times(2y-h)\\\\(2x-h)(2y-h)&=h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
