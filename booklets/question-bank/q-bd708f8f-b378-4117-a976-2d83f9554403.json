        "type": "part",
        "label": "a",
        "prompt": "Show by substitution that the function $y=3e^{2x}$ satisfies the equation $\\dfrac{dy}{dx}=2y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=6e^{2x}=2(3e^{2x})=2y$.",
          "worked": "$$\\begin{aligned}y&=3e^{2x}\\\\\\frac{dy}{dx}&=6e^{2x}\\\\\\frac{dy}{dx}&=2(3e^{2x})\\\\\\frac{dy}{dx}&=2y\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Show by substitution that the function $y=5e^{-4x}$ satisfies the equation $\\dfrac{dy}{dx}=-4y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-20e^{-4x}=-4(5e^{-4x})=-4y$.",
          "worked": "$$\\begin{aligned}y&=5e^{-4x}\\\\\\frac{dy}{dx}&=-20e^{-4x}\\\\\\frac{dy}{dx}&=-4(5e^{-4x})\\\\\\frac{dy}{dx}&=-4y\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
