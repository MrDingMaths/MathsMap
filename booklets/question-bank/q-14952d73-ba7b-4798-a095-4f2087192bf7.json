  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given $v^2=u^2+2ax$ and $v>0$, find the value of $v$ (correct to 1 decimal place) when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$u=0$, $a=5$ and $x=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=10.0$",
          "worked": "$$\\begin{align*}v^2&=0^2+2\\times5\\times10\\\\v^2&=100\\\\v&=\\sqrt{100}\\\\v&=10.0\\end{align*}$$\nTake the positive square root because $v>0$. The answer is correct to 1 decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$u=2$, $a=9.8$ and $x=22$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v\\approx20.9$",
          "worked": "$$\\begin{align*}v^2&=2^2+2\\times9.8\\times22\\\\v^2&=435.2\\\\v&=\\sqrt{435.2}\\\\v&\\approx20.9\\end{align*}$$\nTake the positive square root because $v>0$. Round to 1 decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
