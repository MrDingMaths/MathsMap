  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Write each absolute value expression as a piecewise-defined function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x+5|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |x+5|=\\begin{cases}x+5,&x\\ge -5,\\\\-x-5,&x<-5.\\end{cases}$",
          "worked": "$$\\begin{aligned}|x+5|&=\\begin{cases}x+5,&x+5\\ge0,\\\\-(x+5),&x+5<0\\end{cases}\\\\&=\\begin{cases}x+5,&x\\ge-5,\\\\-x-5,&x<-5.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$|b-3|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |b-3|=\\begin{cases}b-3,&b\\ge3,\\\\-b+3,&b<3.\\end{cases}$",
          "worked": "$$\\begin{aligned}|b-3|&=\\begin{cases}b-3,&b-3\\ge0,\\\\-(b-3),&b-3<0\\end{cases}\\\\&=\\begin{cases}b-3,&b\\ge3,\\\\-b+3,&b<3.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$|2y-6|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |2y-6|=\\begin{cases}2y-6,&y\\ge3,\\\\-2y+6,&y<3.\\end{cases}$",
          "worked": "$$\\begin{aligned}|2y-6|&=\\begin{cases}2y-6,&2y-6\\ge0,\\\\-(2y-6),&2y-6<0\\end{cases}\\\\&=\\begin{cases}2y-6,&y\\ge3,\\\\-2y+6,&y<3.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$|3x+9|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |3x+9|=\\begin{cases}3x+9,&x\\ge-3,\\\\-3x-9,&x<-3.\\end{cases}$",
          "worked": "$$\\begin{aligned}|3x+9|&=\\begin{cases}3x+9,&3x+9\\ge0,\\\\-(3x+9),&3x+9<0\\end{cases}\\\\&=\\begin{cases}3x+9,&x\\ge-3,\\\\-3x-9,&x<-3.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$|4-x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |4-x|=\\begin{cases}4-x,&x\\le4,\\\\x-4,&x>4.\\end{cases}$",
          "worked": "$$\\begin{aligned}|4-x|&=\\begin{cases}4-x,&4-x\\ge0,\\\\-(4-x),&4-x<0\\end{cases}\\\\&=\\begin{cases}4-x,&x\\le4,\\\\x-4,&x>4.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$|2k+1|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |2k+1|=\\begin{cases}2k+1,&k\\ge-\\frac12,\\\\-2k-1,&k<-\\frac12.\\end{cases}$",
          "worked": "$$\\begin{aligned}|2k+1|&=\\begin{cases}2k+1,&2k+1\\ge0,\\\\-(2k+1),&2k+1<0\\end{cases}\\\\&=\\begin{cases}2k+1,&k\\ge-\\frac12,\\\\-2k-1,&k<-\\frac12.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$|5x-2|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |5x-2|=\\begin{cases}5x-2,&x\\ge\\frac25,\\\\-5x+2,&x<\\frac25.\\end{cases}$",
          "worked": "$$\\begin{aligned}|5x-2|&=\\begin{cases}5x-2,&5x-2\\ge0,\\\\-(5x-2),&5x-2<0\\end{cases}\\\\&=\\begin{cases}5x-2,&x\\ge\\frac25,\\\\-5x+2,&x<\\frac25.\\end{cases}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$|ax+b|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle |ax+b|=\\begin{cases}ax+b,&ax+b\\ge0,\\\\-ax-b,&ax+b<0.\\end{cases}$",
          "worked": "$$\\begin{aligned}|ax+b|&=\\begin{cases}ax+b,&ax+b\\ge0,\\\\-(ax+b),&ax+b<0\\end{cases}\\\\&=\\begin{cases}ax+b,&ax+b\\ge0,\\\\-ax-b,&ax+b<0.\\end{cases}\\end{aligned}$$\nThe conditions remain in terms of $ax+b$ because the sign of $a$ is not specified.",
