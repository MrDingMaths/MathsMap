    "id": "v2-c92fc-p53-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Without division, determine whether $(x+3)$ is a factor of $F(x)=x^3+2x^2-5x-6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes.",
      "worked": "$$\\begin{aligned}F(-3)&=(-3)^3+2(-3)^2-5(-3)-6\\\\&=0\\end{aligned}$$\nTherefore $x+3$ is a factor.",
