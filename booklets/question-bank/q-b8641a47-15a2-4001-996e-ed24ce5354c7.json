                "inlines": [
                  {
                    "type": "text",
                    "text": "The derivative changes from positive to negative at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r=\\frac{10}{3\\pi}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The volume increases before this radius and decreases afterwards throughout the physical domain, so the maximum occurs at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "r=\\frac{10}{3\\pi}\\text{ m}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Negative radii in the sign table describe the polynomial outside the physical domain.",
