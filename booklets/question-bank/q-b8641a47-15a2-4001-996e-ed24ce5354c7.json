  "content": {
    "id": "p26-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The sum of the height $h$ of a cylinder and the circumference of its base is 10 metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $h=10-2\\pi r$, where $r$ is the radius of the cylinder.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=10-2\\pi r$.",
          "worked": "$$\\begin{aligned}h+2\\pi r&=10\\\\h&=10-2\\pi r\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the volume of the cylinder is $V=\\pi r^2(10-2\\pi r)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=\\pi r^2(10-2\\pi r)$.",
          "worked": "$$\\begin{aligned}V&=\\pi r^2h\\\\V&=\\pi r^2(10-2\\pi r)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\dfrac{dV}{dr}$ and hence find the value of $r$ at which the volume is a maximum.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dV}{dr}=20\\pi r-6\\pi^2r^2$; the maximum occurs at $r=\\dfrac{10}{3\\pi}$ m.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p26-q9-derivative",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}V&=10\\pi r^2-2\\pi^2r^3\\\\\\frac{dV}{dr}&=20\\pi r-6\\pi^2r^2\\\\\\frac{dV}{dr}&=r(20\\pi-6\\pi^2r)\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p26-q9-roots",
                "type": "paragraph",
