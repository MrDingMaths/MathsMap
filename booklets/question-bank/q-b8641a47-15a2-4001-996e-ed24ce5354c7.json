      {
        "id": "p26-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find the maximum possible volume of the cylinder.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1000}{27\\pi}\\text{ m}^3$.",
          "worked": "$$\\begin{aligned}V_{\\max}&=\\pi\\left(\\frac{10}{3\\pi}\\right)^2\\left(10-2\\pi\\left(\\frac{10}{3\\pi}\\right)\\right)\\\\V_{\\max}&=\\frac{100}{9\\pi}\\times\\frac{10}{3}\\\\V_{\\max}&=\\frac{1000}{27\\pi}\\text{ m}^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
