  "content": {
    "id": "p37-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A fair die is rolled three times. Find the probability of getting exactly:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "no sixes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{125}{216}$",
          "worked": "Let $X$ be the number of sixes in three independent rolls, with $p=\\frac16$.\n$$\\begin{align*}P(X=0)&=\\binom30\\left(\\frac16\\right)^0\\left(\\frac56\\right)^3\\\\P(X=0)&=\\frac{125}{216}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "one six",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{72}$",
          "worked": "Let $X$ be the number of sixes in three independent rolls, with $p=\\frac16$.\n$$\\begin{align*}P(X=1)&=\\binom31\\left(\\frac16\\right)\\left(\\frac56\\right)^2\\\\P(X=1)&=\\frac{25}{72}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "two sixes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{72}$",
          "worked": "Let $X$ be the number of sixes in three independent rolls, with $p=\\frac16$.\n$$\\begin{align*}P(X=2)&=\\binom32\\left(\\frac16\\right)^2\\left(\\frac56\\right)\\\\P(X=2)&=\\frac{5}{72}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "three sixes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{216}$",
          "worked": "Let $X$ be the number of sixes in three independent rolls, with $p=\\frac16$.\n$$\\begin{align*}P(X=3)&=\\binom33\\left(\\frac16\\right)^3\\left(\\frac56\\right)^0\\\\P(X=3)&=\\frac{1}{216}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
