            {
              "type": "text",
              "text": "Gabby is an Australian resident who earned a yearly salary of $204 560. She claimed tax deductions of $10 534 and paid a total of $72 156 PAYG tax.",
              "marks": []
            }
          ]
        },
        {
          "id": "bank-original-p70-q11-root-1",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Calculate her tax liability or refund, if she has to pay the Medicare levy.",
              "marks": []
            }
          ]
        },
        {
          "id": "bank-original-p70-q11-root-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Use the supplied 2022–23 resident tax table and a 2% Medicare levy. Round taxable income down to whole dollars and each completed income-tax and Medicare levy amount to cents before calculating total tax.",
              "marks": []
            }
          ]
        }
