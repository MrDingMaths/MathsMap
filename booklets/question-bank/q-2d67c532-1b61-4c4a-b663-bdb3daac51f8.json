    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Refund of \\$10 296.78.",
      "worked": "$$\\begin{align*}\n\\text{Taxable income} &= 204\\,560-10\\,534=\\$194\\,026\\\\\n\\text{Excess} &= 194\\,026-180\\,000=\\$14\\,026\\\\\n\\text{Income tax} &= 51\\,667+0.45\\times14\\,026\\\\\n\\text{Income tax} &= \\$57\\,978.70\\\\\n\\text{Medicare levy} &= 0.02\\times194\\,026=\\$3\\,880.52\\\\\n\\text{Total tax payable} &= 57\\,978.70+3\\,880.52=\\$61\\,859.22\\\\\n\\text{Refund} &= 72\\,156-61\\,859.22=\\$10\\,296.78\n\\end{align*}$$\nHer PAYG payments exceed her total tax payable, so she receives a refund.",
      "solutionDiagrams": []
    },
