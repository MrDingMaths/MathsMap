  "content": {
    "id": "p34-question-22-27-root",
    "type": "question",
    "label": null,
    "prompt": "Solve the following for $0^\\circ\\leq\\theta\\leq360^\\circ$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-question-22-27-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=90^\\circ$",
          "worked": "On the unit circle, $\\sin\\theta$ is the $y$-coordinate. The only point with $y=1$ is the top of the circle.\n\n$$\\begin{align*}\\theta&=90^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-question-22-27-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0^\\circ,\\ 360^\\circ$",
          "worked": "On the unit circle, $\\cos\\theta$ is the $x$-coordinate. The rightmost point has $x=1$ at the start and end of one full turn. Both endpoints are included.\n\n$$\\begin{align*}\\theta&=0^\\circ,\\ 360^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p34-question-22-27-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^\\circ,\\ 225^\\circ$",
          "worked": "The related angle is $45^\\circ$. Tangent is positive in quadrants I and III.\n\n$$\\begin{align*}\\theta&=45^\\circ,\\ 180^\\circ+45^\\circ\\\\\\theta&=45^\\circ,\\ 225^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-question-22-27-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\theta=\\dfrac{\\sqrt{3}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^\\circ,\\ 120^\\circ$",
          "worked": "The related angle is $60^\\circ$. Sine is positive in quadrants I and II.\n\n$$\\begin{align*}\\theta&=60^\\circ,\\ 180^\\circ-60^\\circ\\\\\\theta&=60^\\circ,\\ 120^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-question-22-27-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos\\theta=-\\dfrac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^\\circ,\\ 240^\\circ$",
          "worked": "The related angle is $60^\\circ$. Cosine is negative in quadrants II and III.\n\n$$\\begin{align*}\\theta&=180^\\circ-60^\\circ,\\ 180^\\circ+60^\\circ\\\\\\theta&=120^\\circ,\\ 240^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p34-question-22-27-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan\\theta=-\\dfrac{1}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=150^\\circ,\\ 330^\\circ$",
          "worked": "The related angle is $30^\\circ$. Tangent is negative in quadrants II and IV.\n\n$$\\begin{align*}\\theta&=180^\\circ-30^\\circ,\\ 360^\\circ-30^\\circ\\\\\\theta&=150^\\circ,\\ 330^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
