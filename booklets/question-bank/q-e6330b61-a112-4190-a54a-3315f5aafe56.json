    "children": [
      {
        "id": "v2-91d8b-p33-practice-slot-11-slot-11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y'=xe^{x^2}$, $y(0)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac12e^{x^2}+\\dfrac32$.",
          "worked": "$$\\begin{aligned}y&=\\int xe^{x^2}\\,dx\\end{aligned}$$\nLet $u=x^2$, so $x\\,dx=\\dfrac{du}{2}$.\n$$\\begin{aligned}y&=\\frac12\\int e^u\\,du\\\\y&=\\frac12e^{x^2}+C\\\\2&=\\frac12e^0+C\\\\C&=\\frac32\\\\y&=\\frac12e^{x^2}+\\frac32\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-91d8b-p33-practice-slot-11-slot-11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y'=\\dfrac{(x+2)^2}{x}$, $y(1)=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac12x^2+4x+4\\ln|x|-\\dfrac32$.",
          "worked": "$$\\begin{aligned}y'&=\\frac{x^2+4x+4}{x}\\\\&=x+4+\\frac4x\\\\y&=\\int\\left(x+4+\\frac4x\\right)dx\\\\y&=\\frac12x^2+4x+4\\ln|x|+C\\\\3&=\\frac12+4+0+C\\\\C&=-\\frac32\\\\y&=\\frac12x^2+4x+4\\ln|x|-\\frac32\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
