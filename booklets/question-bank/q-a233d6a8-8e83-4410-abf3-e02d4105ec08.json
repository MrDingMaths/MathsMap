  "content": {
    "id": "p16-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "$f(x)=\\dfrac{x}{x+1}$, find $f(f(x))$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{x}{2x+1}$, where $x\\ne-1,-\\dfrac12$.",
      "worked": "$$\\begin{aligned}f(f(x))&=\\frac{\\frac{x}{x+1}}{\\frac{x}{x+1}+1}\\\\f(f(x))&=\\frac{\\frac{x}{x+1}}{\\frac{2x+1}{x+1}}\\\\f(f(x))&=\\frac{x}{x+1}\\times\\frac{x+1}{2x+1}\\\\f(f(x))&=\\frac{x}{2x+1}\\end{aligned}$$\nThe inner function requires $x\\ne-1$, and its output cannot equal $-1$, so $x\\ne-\\dfrac12$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
