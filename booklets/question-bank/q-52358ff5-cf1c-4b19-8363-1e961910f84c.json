        "label": "a",
        "prompt": "Divide $\\$45$ in the ratio $4:5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$20$ and $\\$25$.",
          "worked": "There are $4+5=9$ parts in total.\n$$\\begin{align*}\\text{One part}&=\\$45\\div9=\\$5\\\\\\text{First share}&=4\\times\\$5=\\$20\\\\\\text{Second share}&=5\\times\\$5=\\$25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q6b",
        "type": "part",
        "label": "b",
        "prompt": "Divide $720\\text{ kg}$ in the ratio $5:3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$450\\text{ kg}$ and $270\\text{ kg}$.",
          "worked": "There are $5+3=8$ parts in total.\n$$\\begin{align*}\\text{One part}&=720\\div8=90\\text{ kg}\\\\\\text{First share}&=5\\times90=450\\text{ kg}\\\\\\text{Second share}&=3\\times90=270\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
