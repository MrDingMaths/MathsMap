  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A parabola has $x$-intercepts of $\\frac12$ and $2$ and passes through the point $(1,-3)$. Find its equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=6x^2-15x+6$",
      "worked": "Using the roots and the point $(1,-3)$:\n$$\\begin{align*}y&=a\\left(x-\\frac12\\right)(x-2)\\\\-3&=a\\left(1-\\frac12\\right)(1-2)\\\\-3&=-\\frac a2\\\\a&=6\\\\y&=6\\left(x-\\frac12\\right)(x-2)\\\\y&=6x^2-15x+6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
