  "content": {
    "id": "p32-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x}{2x+y}\\times\\dfrac{2xy+x^2}{6x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2y+x}{3(2x+y)}$",
          "worked": "$$\\begin{align*}\\frac{2x}{2x+y}\\times\\frac{2xy+x^2}{6x^2}&=\\frac{2x}{2x+y}\\times\\frac{x(2y+x)}{6x^2}\\\\\\frac{2x}{2x+y}\\times\\frac{2xy+x^2}{6x^2}&=\\frac{2y+x}{3(2x+y)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a^2-5a+6}{a}\\times\\dfrac{a+2}{a^2-2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(a-3)(a+2)}{a^2}$",
          "worked": "$$\\begin{align*}\\frac{a^2-5a+6}{a}\\times\\frac{a+2}{a^2-2a}&=\\frac{(a-2)(a-3)}{a}\\times\\frac{a+2}{a(a-2)}\\\\\\frac{a^2-5a+6}{a}\\times\\frac{a+2}{a^2-2a}&=\\frac{(a-3)(a+2)}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-3x}{2x^2+7x+3}\\times\\dfrac{2x^2-3x-2}{x^2-5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{x+3}$\n\nFactorise completely and cancel common factors.",
          "worked": "$$\\begin{align*}\\frac{x^2-3x}{2x^2+7x+3}\\times\\frac{2x^2-3x-2}{x^2-5x+6}&=\\frac{x(x-3)}{(2x+1)(x+3)}\\times\\frac{(2x+1)(x-2)}{(x-2)(x-3)}\\\\\\frac{x^2-3x}{2x^2+7x+3}\\times\\frac{2x^2-3x-2}{x^2-5x+6}&=\\frac{x}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2-4x+4}{6x-2}\\times\\dfrac{9x^2-6x+1}{3x^2-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(x-2)(3x-1)}{6(x+2)}$\n\nFactorise completely and cancel common factors.",
          "worked": "$$\\begin{align*}\\frac{x^2-4x+4}{6x-2}\\times\\frac{9x^2-6x+1}{3x^2-12}&=\\frac{(x-2)^2}{2(3x-1)}\\times\\frac{(3x-1)^2}{3(x-2)(x+2)}\\\\\\frac{x^2-4x+4}{6x-2}\\times\\frac{9x^2-6x+1}{3x^2-12}&=\\frac{(x-2)(3x-1)}{6(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p32-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{a^2-1}{a}\\times\\dfrac{a^2}{a^2+2a+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a(a-1)}{a+1}$",
          "worked": "$$\\begin{align*}\\frac{a^2-1}{a}\\times\\frac{a^2}{a^2+2a+1}&=\\frac{(a-1)(a+1)}{a}\\times\\frac{a^2}{(a+1)^2}\\\\\\frac{a^2-1}{a}\\times\\frac{a^2}{a^2+2a+1}&=\\frac{a(a-1)}{a+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{4x-12}{3x}\\times\\dfrac{9x^2}{6x-18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}\\frac{4x-12}{3x}\\times\\frac{9x^2}{6x-18}&=\\frac{4(x-3)}{3x}\\times\\frac{9x^2}{6(x-3)}\\\\\\frac{4x-12}{3x}\\times\\frac{9x^2}{6x-18}&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p32-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x^2-x}{3x-3}\\div\\dfrac{3x}{3x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-2}{9}$",
          "worked": "$$\\begin{align*}\\frac{x^2-x}{3x-3}\\div\\frac{3x}{3x-2}&=\\frac{x^2-x}{3x-3}\\times\\frac{3x-2}{3x}\\\\\\frac{x^2-x}{3x-3}\\div\\frac{3x}{3x-2}&=\\frac{x(x-1)}{3(x-1)}\\times\\frac{3x-2}{3x}\\\\\\frac{x^2-x}{3x-3}\\div\\frac{3x}{3x-2}&=\\frac{3x-2}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p32-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{4x-12}{3x}\\div\\dfrac{6x-18}{9x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}\\frac{4x-12}{3x}\\div\\frac{6x-18}{9x^2}&=\\frac{4x-12}{3x}\\times\\frac{9x^2}{6x-18}\\\\\\frac{4x-12}{3x}\\div\\frac{6x-18}{9x^2}&=\\frac{4(x-3)}{3x}\\times\\frac{9x^2}{6(x-3)}\\\\\\frac{4x-12}{3x}\\div\\frac{6x-18}{9x^2}&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p32-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{2x}{3x-3}\\div\\dfrac{4y}{x^2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{6y}$",
          "worked": "$$\\begin{align*}\\frac{2x}{3x-3}\\div\\frac{4y}{x^2-x}&=\\frac{2x}{3x-3}\\times\\frac{x^2-x}{4y}\\\\\\frac{2x}{3x-3}\\div\\frac{4y}{x^2-x}&=\\frac{2x}{3(x-1)}\\times\\frac{x(x-1)}{4y}\\\\\\frac{2x}{3x-3}\\div\\frac{4y}{x^2-x}&=\\frac{x^2}{6y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p32-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{x^2-2xy+y^2}{x^2-y^2}\\div\\dfrac{x^2+xy}{x^2+2xy+y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-y}{x}$\n\nMultiply by the reciprocal, factorise and cancel common factors.",
          "worked": "$$\\begin{align*}\\frac{x^2-2xy+y^2}{x^2-y^2}\\div\\frac{x^2+xy}{x^2+2xy+y^2}&=\\frac{x^2-2xy+y^2}{x^2-y^2}\\times\\frac{x^2+2xy+y^2}{x^2+xy}\\\\\\frac{x^2-2xy+y^2}{x^2-y^2}\\div\\frac{x^2+xy}{x^2+2xy+y^2}&=\\frac{(x-y)^2}{(x-y)(x+y)}\\times\\frac{(x+y)^2}{x(x+y)}\\\\\\frac{x^2-2xy+y^2}{x^2-y^2}\\div\\frac{x^2+xy}{x^2+2xy+y^2}&=\\frac{x-y}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
