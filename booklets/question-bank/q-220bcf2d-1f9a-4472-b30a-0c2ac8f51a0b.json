    "type": "question",
    "label": null,
    "prompt": "Determine whether you can use the index law of multiplication to simplify these expressions.\nIf so, write the simplified form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a98c5-p49-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$7^{3}\\times7^{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $7^{9}$.",
          "worked": "Yes: the factors have the same base.\n$$\\begin{align*}7^{3}\\times7^{6}&=7^{3+6}\\\\&=7^{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
