  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Sketch $y=(x-2)^2-1$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q3-graph",
        "answer": {
          "short": "Concave up.",
          "worked": "$a=1>0$, so the parabola is concave up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q3-graph",
        "answer": {
          "short": "$(0,3)$.",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=(0-2)^2-1\\\\y&=3\\end{align*}$$\nThe $y$-intercept is $(0,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q3-graph",
        "answer": {
          "short": "$(1,0)$ and $(3,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x-2)^2-1\\\\1&=(x-2)^2\\\\\\pm1&=x-2\\\\2\\pm1&=x\\end{align*}$$\nThe $x$-intercepts are $(1,0)$ and $(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p24-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q3-graph",
        "answer": {
          "short": "$(2,-1)$.",
          "worked": "In $y=a(x-h)^2+k$, the vertex is $(h,k)$. Here $h=2$ and $k=-1$, so the vertex is $(2,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ],
    "sharedSolutionDiagrams": [
      {
        "id": "p24-q3-graph",
