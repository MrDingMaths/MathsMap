  "content": {
    "id": "p18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Triangle $ABC$ has vertices $A(2,1)$, $B(10,4)$ and $C(5,13)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\cos\\angle ABC=\\dfrac{13}{\\sqrt{7738}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\angle ABC=\\dfrac{13}{\\sqrt{7738}}$.",
          "worked": "$$\\begin{aligned}\\overrightarrow{BA}&=(2-10,1-4)=(-8,-3)\\\\\\overrightarrow{BC}&=(5-10,13-4)=(-5,9)\\\\\\overrightarrow{BA}\\cdot\\overrightarrow{BC}&=40-27=13\\\\|\\overrightarrow{BA}|&=\\sqrt{64+9}=\\sqrt{73}\\\\|\\overrightarrow{BC}|&=\\sqrt{25+81}=\\sqrt{106}\\\\\\cos\\angle ABC&=\\frac{13}{\\sqrt{73}\\sqrt{106}}\\\\\\cos\\angle ABC&=\\frac{13}{\\sqrt{7738}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p18-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the exact value of $\\sin\\angle ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{87}{\\sqrt{7738}}$.",
          "worked": "Using $\\sin^2x+\\cos^2x=1$,\n\n$$\\begin{aligned}\\sin^2\\angle ABC&=1-\\frac{169}{7738}\\\\\\sin^2\\angle ABC&=\\frac{7569}{7738}\\\\\\sin\\angle ABC&=\\frac{87}{\\sqrt{7738}}\\end{aligned}$$\n\nThe positive root is taken because $\\angle ABC$ is an interior angle of a triangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the area of triangle $ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$43.5$ square units.",
          "worked": "$$\\begin{aligned}\\text{Area}&=\\frac12|\\overrightarrow{BA}|\\,|\\overrightarrow{BC}|\\sin\\angle ABC\\\\\\text{Area}&=\\frac12\\times\\sqrt{73}\\times\\sqrt{106}\\times\\frac{87}{\\sqrt{7738}}\\\\\\text{Area}&=\\frac12\\times87\\\\\\text{Area}&=43.5\\text{ square units}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
