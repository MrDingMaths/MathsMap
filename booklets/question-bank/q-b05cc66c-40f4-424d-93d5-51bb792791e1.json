  "content": {
    "id": "p40-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Show that the average of $\\frac{1}{n}$ and $\\frac{1}{n+1}$ can be written as $\\frac{2n+1}{2n(n+1)}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\displaystyle\\frac{\\frac{1}{n}+\\frac{1}{n+1}}{2}=\\frac{2n+1}{2n(n+1)}$",
      "worked": "$$\\begin{align*}\\frac{\\frac{1}{n}+\\frac{1}{n+1}}{2}&=\\frac{\\frac{n+1+n}{n(n+1)}}{2}\\\\\\frac{\\frac{1}{n}+\\frac{1}{n+1}}{2}&=\\frac{2n+1}{n(n+1)}\\times\\frac{1}{2}\\\\\\frac{\\frac{1}{n}+\\frac{1}{n+1}}{2}&=\\frac{2n+1}{2n(n+1)}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
