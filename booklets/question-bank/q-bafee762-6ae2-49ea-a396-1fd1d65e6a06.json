          "inlines": [
            {
              "type": "text",
              "text": "Determine whether you can use the index law of division to simplify these expressions.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If so, write the simplified form.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$9^{5}\\div9^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $9^{2}$.",
          "worked": "Yes; the bases are the same.\n$$\\begin{align*}9^{5}\\div9^{3}&=9^{5-3}\\\\&=9^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$9^{4}\\div4^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No; the bases are different, so the index law of division does not apply.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p58-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$6^{4}\\div6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $6^{3}$.",
          "worked": "Yes; $6=6^{1}$.\n$$\\begin{align*}6^{4}\\div6&=6^{4}\\div6^{1}\\\\&=6^{4-1}\\\\&=6^{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$10^{3}\\div10^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $10^{4}$.",
          "worked": "Yes; the bases are the same.\n$$\\begin{align*}10^{3}\\div10^{-1}&=10^{3-(-1)}\\\\&=10^{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$8^{2}\\div8^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $1$.",
          "worked": "Yes; the bases are the same.\n$$\\begin{align*}8^{2}\\div8^{2}&=8^{2-2}\\\\&=8^{0}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$5^{4}-5^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No; this expression uses subtraction, so the index law of division does not apply.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p58-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$6^{-3}\\div6^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $6^{-5}$.",
          "worked": "Yes; the bases are the same.\n$$\\begin{align*}6^{-3}\\div6^{2}&=6^{-3-2}\\\\&=6^{-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$4^{1.5}\\div4^{0.5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, $4$.",
          "worked": "Yes; the bases are the same.\n$$\\begin{align*}4^{1.5}\\div4^{0.5}&=4^{1.5-0.5}\\\\&=4^{1}\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
