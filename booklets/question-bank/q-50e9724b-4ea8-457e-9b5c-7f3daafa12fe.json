    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "A bicycle was $\\$180$ and inflated by $15\\%$. What is the new price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$207$",
          "worked": "$$\\begin{align*}\\text{New price} &= 115\\%\\times\\$180\\\\\\text{New price} &= 1.15\\times\\$180\\\\\\text{New price} &= \\$207\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "A restaurant offers $25\\%$ off a $\\$32$ meal. Find the discount amount.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$8$",
          "worked": "$$\\begin{align*}\\text{Discount} &= 25\\%\\times\\$32\\\\\\text{Discount} &= 0.25\\times\\$32\\\\\\text{Discount} &= \\$8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "A laptop has been marked up by $18\\%$. Find the mark-up amount if the original price was $\\$450$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$81$",
          "worked": "$$\\begin{align*}\\text{Mark-up} &= 18\\%\\times\\$450\\\\\\text{Mark-up} &= 0.18\\times\\$450\\\\\\text{Mark-up} &= \\$81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "A store offers $40\\%$ off a $\\$95$ pair of shoes. What is the sale price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$57$",
          "worked": "$$\\begin{align*}\\text{Sale price} &= 60\\%\\times\\$95\\\\\\text{Sale price} &= 0.60\\times\\$95\\\\\\text{Sale price} &= \\$57\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-e",
        "type": "part",
        "label": "e",
        "prompt": "A $\\$120$ tablet has been marked up by $22\\%$. Find the marked-up price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$146.40$",
          "worked": "$$\\begin{align*}\\text{Marked-up price} &= 122\\%\\times\\$120\\\\\\text{Marked-up price} &= 1.22\\times\\$120\\\\\\text{Marked-up price} &= \\$146.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-f",
        "type": "part",
        "label": "f",
        "prompt": "A bookshop offers $35\\%$ off a $\\$24$ novel. How much discount would you get?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$8.40$",
          "worked": "$$\\begin{align*}\\text{Discount} &= 35\\%\\times\\$24\\\\\\text{Discount} &= 0.35\\times\\$24\\\\\\text{Discount} &= \\$8.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-g",
        "type": "part",
        "label": "g",
        "prompt": "A phone was $\\$650$ and inflated by $8\\%$. How much did the price increase?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$52$",
          "worked": "$$\\begin{align*}\\text{Price increase} &= 8\\%\\times\\$650\\\\\\text{Price increase} &= 0.08\\times\\$650\\\\\\text{Price increase} &= \\$52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q17-h",
        "type": "part",
        "label": "h",
        "prompt": "A gym offers $20\\%$ off a $\\$180$ membership. Find the discounted price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$144$",
          "worked": "$$\\begin{align*}\\text{Discounted price} &= 80\\%\\times\\$180\\\\\\text{Discounted price} &= 0.80\\times\\$180\\\\\\text{Discounted price} &= \\$144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
