    "children": [
      {
        "id": "p13-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Let $a,b,c\\ne1$ be positive real numbers. Prove that $(\\log_a b)(\\log_b c)(\\log_c a)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\log_a b)(\\log_b c)(\\log_c a)=1$.\n\nChange all three logarithms to the same base and cancel.",
          "worked": "Using the change-of-base formula with a common base,\n$$\\begin{align*}\n(\\log_a b)(\\log_b c)(\\log_c a)&=\\frac{\\log b}{\\log a}\\cdot\\frac{\\log c}{\\log b}\\cdot\\frac{\\log a}{\\log c}\\\\\n(\\log_a b)(\\log_b c)(\\log_c a)&=1.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Produce a similar result that holds for any four positive real numbers other than $1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For positive $a,b,c,d\\ne1$,\n$$(\\log_a b)(\\log_b c)(\\log_c d)(\\log_d a)=1.$$\n\nChange all four logarithms to the same base and cancel.",
          "worked": "For positive $a,b,c,d\\ne1$, change to a common base:\n$$\\begin{align*}\n(\\log_a b)(\\log_b c)(\\log_c d)(\\log_d a)&=\\frac{\\log b}{\\log a}\\cdot\\frac{\\log c}{\\log b}\\cdot\\frac{\\log d}{\\log c}\\cdot\\frac{\\log a}{\\log d}\\\\\n(\\log_a b)(\\log_b c)(\\log_c d)(\\log_d a)&=1.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
