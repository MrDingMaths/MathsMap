  "content": {
    "id": "p22-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the value of $x$ on $y=x^2-2x+3$ where the tangent is",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "inclined at $45^\\circ$ from the positive $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x-2\\\\m&=\\tan 45^\\circ\\\\m&=1\\\\2x-2&=1\\\\x&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p22-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "inclined at $135^\\circ$ from the positive $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x-2\\\\m&=\\tan 135^\\circ\\\\m&=-1\\\\2x-2&=-1\\\\x&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p22-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "parallel to $y=-2x-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "Parallel lines have the same gradient, so the tangent has gradient $-2$.\n\n$$\\begin{align*}\\frac{dy}{dx}&=2x-2\\\\2x-2&=-2\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "perpendicular to $x+4y-1=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}x+4y-1&=0\\\\4y&=1-x\\\\y&=-\\frac14 x+\\frac14\\end{align*}$$\n\nThe perpendicular gradient is $4$, the negative reciprocal of $-\\frac14$.\n\n$$\\begin{align*}\\frac{dy}{dx}&=2x-2\\\\2x-2&=4\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
