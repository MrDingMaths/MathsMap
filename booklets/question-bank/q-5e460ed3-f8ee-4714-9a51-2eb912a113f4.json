  "content": {
    "id": "p15-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A student expanded brackets and obtained the following answers. In each part, identify and correct the student’s incorrect answer and write the correct expansion.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$4(a+6)=4a+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The 6 was not multiplied by 4. $4(a+6)=4a+24$.",
          "worked": "The multiplier 4 must multiply both terms, so $4\\times6=24$.\n$$\\begin{align*}4(a+6)&=4a+4\\times6\\\\4(a+6)&=4a+24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$5(a+1)=5a+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Multiply 5 by 1 instead of adding them. $5(a+1)=5a+5$.",
          "worked": "The constant term is $5\\times1=5$, not $5+1=6$.\n$$\\begin{align*}5(a+1)&=5a+5\\times1\\\\5(a+1)&=5a+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$-3(p-5)=-3p-15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\times(-5)=15$, not $-15$. $-3(p-5)=-3p+15$.",
          "worked": "The product of two negative numbers is positive.\n$$\\begin{align*}-3(p-5)&=-3p+(-3)\\times(-5)\\\\-3(p-5)&=-3p+15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$a(a+b)=2a+ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a\\times a=a^2$, not $2a$. $a(a+b)=a^2+ab$.",
          "worked": "Multiplying $a$ by itself gives $a^2$.\n$$\\begin{align*}a(a+b)&=a\\times a+a\\times b\\\\a(a+b)&=a^2+ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$2m(3m+5)=6m+10m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2m\\times3m=6m^2$, not $6m$. $2m(3m+5)=6m^2+10m$.",
          "worked": "The first product contains $m\\times m=m^2$.\n$$\\begin{align*}2m(3m+5)&=2m\\times3m+2m\\times5\\\\2m(3m+5)&=6m^2+10m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$4a(3a+5)=7a^2+20a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a\\times3a=12a^2$, not $7a^2$. $4a(3a+5)=12a^2+20a$.",
          "worked": "Multiply the coefficients: $4\\times3=12$.\n$$\\begin{align*}4a(3a+5)&=4a\\times3a+4a\\times5\\\\4a(3a+5)&=12a^2+20a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$3a(4a-7)=12a^2-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The $-7$ was not multiplied by $3a$. $3a(4a-7)=12a^2-21a$.",
          "worked": "The multiplier $3a$ must multiply both terms.\n$$\\begin{align*}3a(4a-7)&=3a\\times4a-3a\\times7\\\\3a(4a-7)&=12a^2-21a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$-6(x-5)=6x+30$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6\\times x=-6x$, not $6x$. $-6(x-5)=-6x+30$.",
          "worked": "The coefficient of $x$ remains negative.\n$$\\begin{align*}-6(x-5)&=-6x+(-6)\\times(-5)\\\\-6(x-5)&=-6x+30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$3x(2x-7y)=6x^2-21y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x\\times(-7y)=-21xy$, not $-21y$. $3x(2x-7y)=6x^2-21xy$.",
          "worked": "Both products must contain the outside factor $x$.\n$$\\begin{align*}3x(2x-7y)&=3x\\times2x-3x\\times7y\\\\3x(2x-7y)&=6x^2-21xy\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
