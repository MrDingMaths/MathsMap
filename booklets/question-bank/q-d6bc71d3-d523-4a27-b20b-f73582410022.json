  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Give a proof of each of the following statements:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "If $n$ is an even integer, then $n^2$ is even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Write $n=2k$, where $k\\in\\mathbb Z$. Then $n^2=2(2k^2)$ is even.",
          "worked": "Let $n=2k$, where $k\\in\\mathbb Z$.\n$$\\begin{align*}n^2&=(2k)^2\\\\n^2&=4k^2\\\\n^2&=2(2k^2).\\end{align*}$$\nSince $2k^2$ is an integer, $n^2$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "If $m$ and $n$ are both odd integers, then $m+n$ is even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Write $m=2a+1$ and $n=2b+1$. Then $m+n=2(a+b+1)$ is even.",
          "worked": "Let $m=2a+1$ and $n=2b+1$, where $a,b\\in\\mathbb Z$.\n$$\\begin{align*}m+n&=(2a+1)+(2b+1)\\\\m+n&=2a+2b+2\\\\m+n&=2(a+b+1).\\end{align*}$$\nSince $a+b+1$ is an integer, $m+n$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "If $m$ is an odd integer, then $m^3$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $m=2a+1$, $m^3=2(4a^3+6a^2+3a)+1$, which is odd.",
          "worked": "Let $m=2a+1$, where $a\\in\\mathbb Z$.\n$$\\begin{align*}m^3&=(2a+1)^3\\\\m^3&=8a^3+12a^2+6a+1\\\\m^3&=2(4a^3+6a^2+3a)+1.\\end{align*}$$\nSince $4a^3+6a^2+3a$ is an integer, $m^3$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "If $m$ is an even integer, then $m^2-4m+3$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $m=2a$, $m^2-4m+3=2(2a^2-4a+1)+1$, which is odd.",
          "worked": "Let $m=2a$, where $a\\in\\mathbb Z$.\n$$\\begin{align*}m^2-4m+3&=(2a)^2-4(2a)+3\\\\m^2-4m+3&=4a^2-8a+3\\\\m^2-4m+3&=2(2a^2-4a+1)+1.\\end{align*}$$\nSince $2a^2-4a+1$ is an integer, $m^2-4m+3$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "If $m$ is an odd integer, then $m^2+5m+3$ is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $m=2a+1$, $m^2+5m+3=2(2a^2+7a+4)+1$, which is odd.",
          "worked": "Let $m=2a+1$, where $a\\in\\mathbb Z$.\n$$\\begin{align*}m^2+5m+3&=(2a+1)^2+5(2a+1)+3\\\\m^2+5m+3&=4a^2+4a+1+10a+5+3\\\\m^2+5m+3&=4a^2+14a+9\\\\m^2+5m+3&=2(2a^2+7a+4)+1.\\end{align*}$$\nSince $2a^2+7a+4$ is an integer, $m^2+5m+3$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
