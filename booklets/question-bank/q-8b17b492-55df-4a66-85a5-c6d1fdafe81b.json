  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "In all of the following, $E$ stands for the universal set.\n\nWrite down the complement of each set $S$ in the given universal set $E$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$S=\\{\\text{women}\\}$, where $E=\\{\\text{adults}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^c=\\{\\text{men}\\}$",
          "worked": "The complement contains the adults who are not in $S$. Thus $S^c=\\{\\text{men}\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$S=\\{\\text{boys}\\}$, where $E=\\{\\text{children}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^c=\\{\\text{girls}\\}$",
          "worked": "The complement contains the children who are not in $S$. Thus $S^c=\\{\\text{girls}\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$S=\\{\\text{Australians living within 10 km of the coast}\\}$, where $E=\\{\\text{Australians}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^c=\\{\\text{Australians living more than 10 km from the coast}\\}$",
          "worked": "The complement contains Australians who are not within 10 km of the coast. Thus $S^c=\\{\\text{Australians living more than 10 km from the coast}\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$S=\\{\\text{weekdays}\\}$, where $E=\\{\\text{days}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^c=\\{\\text{Saturday},\\text{Sunday}\\}$",
          "worked": "The days that are not weekdays are Saturday and Sunday. Hence $S^c=\\{\\text{Saturday},\\text{Sunday}\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p16-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$S=\\{\\text{whole numbers less than 100}\\}$, where $E=\\{\\text{whole numbers}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^c=\\{100,101,102,\\ldots\\}$",
          "worked": "The whole numbers that are not less than 100 are those greater than or equal to 100. Hence $S^c=\\{100,101,102,\\ldots\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$S=\\{\\text{prime numbers}\\}$, where $E=\\{\\text{whole numbers}\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^c=\\{\\text{whole numbers that are not prime}\\}$: 0, 1 and all composite numbers.",
          "worked": "The complement contains every whole number that is not prime. Both 0 and 1 are neither prime nor composite; every other non-prime whole number is composite. Thus $S^c$ consists of 0, 1 and all composite numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
