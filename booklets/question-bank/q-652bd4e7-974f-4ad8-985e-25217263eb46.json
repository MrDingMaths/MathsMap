        "prompt": "$6-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac{3}{4}$",
          "worked": "$$\\begin{align*}6-x&=6-\\left(-\\frac{3}{4}\\right)\\\\6-x&=6+\\frac{3}{4}\\\\6-x&=6\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$6+x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\frac{1}{4}$",
          "worked": "$$\\begin{align*}6+x&=6+\\left(-\\frac{3}{4}\\right)\\\\6+x&=6-\\frac{3}{4}\\\\6+x&=5\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{27}{64}$",
          "worked": "$$\\begin{align*}x^3&=\\left(-\\frac{3}{4}\\right)^3\\\\x^3&=-\\frac{3^3}{4^3}\\\\x^3&=-\\frac{27}{64}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^5$",
