        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{243}{1024}$",
          "worked": "$$\\begin{align*}x^5&=\\left(-\\frac{3}{4}\\right)^5\\\\x^5&=-\\frac{3^5}{4^5}\\\\x^5&=-\\frac{243}{1024}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-e",
        "type": "part",
