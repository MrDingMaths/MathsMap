  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "8, 9, 10 and 11 are four consecutive whole numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "What is the product of the outer pair $(8\\times11)$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$88$",
              "worked": "$$8\\times11=88$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p30-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What is the product of the inner pair $(9\\times10)$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$90$",
              "worked": "$$9\\times10=90$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the difference between the answers to parts i and ii.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "Product of inner pair minus product of outer pair:\n$$90-88=2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "If the smallest of the four consecutive whole numbers is denoted by $n$, express each of the other numbers in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n+1,\\ n+2,\\ n+3$",
          "worked": "Consecutive whole numbers increase by 1, so the other three numbers are $n+1$, $n+2$ and $n+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p30-q4-d",
        "type": "group",
        "label": "d",
        "prompt": "Express the following in terms of $n$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q4-d-i",
            "type": "part",
            "label": "i",
            "prompt": "the product of the outer pair",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$n^2+3n$",
              "worked": "$$\\begin{align*}n(n+3)&=n\\times n+n\\times3\\\\n(n+3)&=n^2+3n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p30-q4-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the product of the inner pair",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$n^2+3n+2$",
              "worked": "$$\\begin{align*}(n+1)(n+2)&=n(n+2)+1(n+2)\\\\(n+1)(n+2)&=n^2+2n+n+2\\\\(n+1)(n+2)&=n^2+3n+2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p30-q4-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the difference between the answers to part ii and part i.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$\n\nExpand both products and subtract; the terms containing $n$ cancel.",
              "worked": "$$\\begin{align*}(n+1)(n+2)-n(n+3)&=(n^2+3n+2)-(n^2+3n)\\\\(n+1)(n+2)-n(n+3)&=n^2+3n+2-n^2-3n\\\\(n+1)(n+2)-n(n+3)&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      }
    ]
  },
