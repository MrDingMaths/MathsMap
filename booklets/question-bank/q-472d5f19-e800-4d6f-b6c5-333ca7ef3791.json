  "content": {
    "id": "p25-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "$f(x)=\\dfrac{2}{x-9}$ and $g(x)=x^2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{x^2-9}$",
          "worked": "$$\\begin{align*}f(g(x))&=f(x^2)\\\\f(g(x))&=\\frac{2}{x^2-9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{(x-9)^2}$",
          "worked": "$$\\begin{align*}g(f(x))&=g\\left(\\frac{2}{x-9}\\right)\\\\g(f(x))&=\\left(\\frac{2}{x-9}\\right)^2\\\\g(f(x))&=\\frac{4}{(x-9)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p25-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Compare the domain of $f(g(x))$ and $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))$ has domain $x\\in\\mathbb R$, $x\\ne\\pm3$, while $g(f(x))$ has domain $x\\in\\mathbb R$, $x\\ne9$.",
          "worked": "For $f(g(x))$, the denominator must be nonzero:\n$$\\begin{align*}x^2-9&\\ne0\\\\x^2&\\ne9\\\\x&\\ne\\pm3\\end{align*}$$\nFor $g(f(x))$, the inner function $f(x)$ requires $x-9\\ne0$, so $x\\ne9$. Squaring introduces no further restriction.\nThus the domains are $\\mathbb R\\setminus\\{-3,3\\}$ and $\\mathbb R\\setminus\\{9\\}$ respectively.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
