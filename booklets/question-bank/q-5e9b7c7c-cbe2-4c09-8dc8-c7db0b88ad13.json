      {
        "id": "p3-ex10a-q1a",
        "type": "part",
        "label": "a",
        "prompt": "If 3 kg of potatoes cost $\\$3.60$, find the cost of 4 kg.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$4.80$",
          "worked": "$$\\begin{align*}\\text{Cost of 1 kg}&=\\$3.60\\div3=\\$1.20\\\\\\text{Cost of 4 kg}&=\\$1.20\\times4=\\$4.80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-ex10a-q1b",
        "type": "part",
        "label": "b",
        "prompt": "If 5 pens cost $\\$15$, find the cost of 6 pens.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$18$",
          "worked": "$$\\begin{align*}\\text{Cost of 1 pen}&=\\$15\\div5=\\$3\\\\\\text{Cost of 6 pens}&=\\$3\\times6=\\$18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-ex10a-q1c",
        "type": "part",
        "label": "c",
        "prompt": "If 8 tennis balls cost $\\$15$, find the cost of 20 tennis balls.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$37.50$",
          "worked": "$$\\begin{align*}\\text{Cost of 4 tennis balls}&=\\$15\\div2=\\$7.50\\\\\\text{Cost of 20 tennis balls}&=\\$7.50\\times5=\\$37.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-ex10a-q1d",
        "type": "part",
        "label": "d",
        "prompt": "If 9 billiard balls weigh 1440 g, how much do 6 billiard balls weigh?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$960\\text{ g}$",
          "worked": "$$\\begin{align*}\\text{Mass of 3 billiard balls}&=1440\\div3=480\\text{ g}\\\\\\text{Mass of 6 billiard balls}&=480\\times2=960\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-ex10a-q1e",
        "type": "part",
        "label": "e",
        "prompt": "If the length of a row of 12 seats is 480 cm, how long will a row of 21 seats be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$840\\text{ cm}$",
          "worked": "$$\\begin{align*}\\text{Length of a row of 3 seats}&=480\\div4=120\\text{ cm}\\\\\\text{Length of a row of 21 seats}&=120\\times7=840\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-ex10a-q1f",
        "type": "part",
        "label": "f",
        "prompt": "The donuts of a certain donut manufacturer contain 25 g of fat ‘per standard serve’. If one standard serve is 2 donuts, how much fat, in grams, is consumed by a person who eats 5 donuts?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$62.5\\text{ g}$",
          "worked": "$$\\begin{align*}\\text{Fat in 1 donut}&=25\\div2=12.5\\text{ g}\\\\\\text{Fat in 5 donuts}&=12.5\\times5=62.5\\text{ g}\\end{align*}$$",
