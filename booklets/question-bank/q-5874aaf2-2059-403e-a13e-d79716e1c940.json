    "children": [
      {
        "id": "p41-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "How much grass is needed to raise 15 sheep?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1000\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\text{Grass required}&=200\\times\\frac{15}{3}\\\\\\text{Grass required}&=1000\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p41-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "How many healthy sheep can $2.5$ hectares of land support?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "375 sheep",
          "worked": "$$\\begin{align*}\\text{Available area}&=2.5\\times10\\,000\\\\\\text{Available area}&=25\\,000\\text{ m}^2\\\\\\text{Number of sheep}&=\\frac{25\\,000}{200}\\times3\\\\\\text{Number of sheep}&=375\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
