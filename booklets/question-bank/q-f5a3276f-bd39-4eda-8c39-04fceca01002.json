    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "of length 5 from $(0,0)$ to the point $(3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "A path of length 5 must contain exactly 3 right steps and 2 up steps. These are arrangements of repeated directions.\n\n$$\\begin{align*}N&=\\frac{5!}{3!2!}\\\\N&=10.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "of length $m+n$ from $(0,0)$ to the point $(m,n)$, where $m$ and $n$ are natural numbers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(m+n)!}{m!n!}$",
          "worked": "The shortest path contains exactly $m$ right steps and $n$ up steps. Arranging these repeated directions gives\n\n$$N=\\frac{(m+n)!}{m!n!}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
