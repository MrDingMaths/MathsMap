    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 x<3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0<x<8$.",
          "worked": "The domain is $x>0$. Since the base $2>1$, the inequality direction is unchanged.\n$$\\begin{align*}x&<2^3\\\\x&<8\\end{align*}$$\nCombining with the domain gives $0<x<8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 x\\geq3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq8$.",
          "worked": "The domain is $x>0$. Since the base $2>1$, the inequality direction is unchanged.\n$$\\begin{align*}x&\\geq2^3\\\\x&\\geq8\\end{align*}$$\nThese values satisfy the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{10}x>3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>1000$.",
          "worked": "The domain is $x>0$. Since the base $10>1$, the inequality direction is unchanged.\n$$\\begin{align*}x&>10^3\\\\x&>1000\\end{align*}$$\nThese values satisfy the domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_6 x<1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0<x<6$.",
          "worked": "The domain is $x>0$. Since the base $6>1$, the inequality direction is unchanged.\n$$\\begin{align*}x&<6^1\\\\x&<6\\end{align*}$$\nCombining with the domain gives $0<x<6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
