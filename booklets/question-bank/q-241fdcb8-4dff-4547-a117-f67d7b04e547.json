  "content": {
    "id": "p21-question-30-33-root",
    "type": "question",
    "label": null,
    "prompt": "Express the following in the form $\\log_b(a)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-question-30-33-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$4\\log_3(2)-\\log_3(4)+\\log_3(16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3(64)$",
          "worked": "$$\\begin{align*}4\\log_3(2)-\\log_3(4)+\\log_3(16)&=\\log_3(16)-\\log_3(4)+\\log_3(16)\\\\4\\log_3(2)-\\log_3(4)+\\log_3(16)&=\\log_3\\left(\\frac{16\\times16}{4}\\right)\\\\4\\log_3(2)-\\log_3(4)+\\log_3(16)&=\\log_3(64)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-30-33-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac12\\log_2(x)-\\log_2(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2\\left(\\frac{\\sqrt{x}}{3}\\right)$",
          "worked": "For $x>0$,\n$$\\begin{align*}\\frac12\\log_2(x)-\\log_2(3)&=\\log_2(\\sqrt{x})-\\log_2(3)\\\\\\frac12\\log_2(x)-\\log_2(3)&=\\log_2\\left(\\frac{\\sqrt{x}}{3}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-question-30-33-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$1+\\log_{10}(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}(50)$",
          "worked": "$$\\begin{align*}1+\\log_{10}(5)&=\\log_{10}(10)+\\log_{10}(5)\\\\1+\\log_{10}(5)&=\\log_{10}(50)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-question-30-33-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}(800)-2\\log_{10}(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}(200)$",
          "worked": "$$\\begin{align*}\\log_{10}(800)-2\\log_{10}(2)&=\\log_{10}\\left(\\frac{800}{2^2}\\right)\\\\\\log_{10}(800)-2\\log_{10}(2)&=\\log_{10}(200)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
