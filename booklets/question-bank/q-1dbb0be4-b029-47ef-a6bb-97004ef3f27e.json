  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A sector has angle $\\theta$ degrees, perimeter $P$ and radius $r$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9a",
        "type": "part",
        "label": "a",
        "prompt": "Find a formula for $P$ in terms of $\\theta$ and $r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=2r+\\dfrac{\\theta\\pi r}{180}$.",
          "worked": "The perimeter consists of two radii and the circular arc.\n$$\\begin{align*}P&=2r+\\frac{\\theta}{360}\\times2\\pi r\\\\P&=2r+\\frac{\\theta\\pi r}{180}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q9b",
        "type": "part",
        "label": "b",
        "prompt": "Find a formula for $r$ in terms of $\\theta$ and $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\dfrac{180P}{360+\\theta\\pi}$.",
          "worked": "$$\\begin{align*}P&=2r+\\frac{\\theta\\pi r}{180}\\\\180P&=360r+\\theta\\pi r\\\\180P&=r(360+\\theta\\pi)\\\\r&=\\frac{180P}{360+\\theta\\pi}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p7-q9c",
        "type": "part",
        "label": "c",
        "prompt": "Find a formula for $\\theta$ in terms of $r$ and $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=\\dfrac{180(P-2r)}{\\pi r}$.",
          "worked": "$$\\begin{align*}P&=2r+\\frac{\\theta\\pi r}{180}\\\\P-2r&=\\frac{\\theta\\pi r}{180}\\\\180(P-2r)&=\\theta\\pi r\\\\\\theta&=\\frac{180(P-2r)}{\\pi r}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
