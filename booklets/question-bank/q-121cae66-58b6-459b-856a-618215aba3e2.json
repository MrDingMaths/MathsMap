  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The length of the Murray River is 2575 km. The length of the Hawkesbury River is 80 000 m. What is the difference in their lengths? Answer in metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\,495\\,000\\text{ m}$",
      "worked": "$$\\begin{align*}2575\\text{ km}&=2575\\times1000\\text{ m}\\\\&=2\\,575\\,000\\text{ m}\\\\\\text{Difference}&=2\\,575\\,000-80\\,000\\\\&=2\\,495\\,000\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
  },
