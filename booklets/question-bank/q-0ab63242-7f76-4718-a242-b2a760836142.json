  "content": {
    "id": "p9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the polynomial $P(x)=x^3-4x^2-3x+18$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $P(3)$ and $P'(3)$ are both zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(3)=0$ and $P'(3)=0$.",
          "worked": "$$\\begin{aligned}P(3)&=27-36-9+18\\\\&=0\\\\P'(x)&=3x^2-8x-3\\\\P'(3)&=27-24-3\\\\&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "What can be deduced from the results in part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$ is a zero of multiplicity at least $2$, so $(x-3)^2$ is a factor of $P(x)$.",
          "worked": "Since $P(3)=P'(3)=0$, $3$ is a zero of multiplicity at least $2$. Hence $(x-3)^2$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence use the sum of zeroes to find all the zeroes of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$ (double) and $-2$ (simple).",
          "worked": "Let the zeroes, counted with multiplicity, be $3,3,\\alpha$.\n$$\\begin{aligned}3+3+\\alpha&=-\\frac{-4}{1}\\\\6+\\alpha&=4\\\\\\alpha&=-2\\end{aligned}$$\nThe zeroes are $3$ (double) and $-2$ (simple).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence factor $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x-3)^2(x+2)$.",
          "worked": "The zeroes are $3,3,-2$ and the leading coefficient is $1$, so\n$$P(x)=(x-3)^2(x+2).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
