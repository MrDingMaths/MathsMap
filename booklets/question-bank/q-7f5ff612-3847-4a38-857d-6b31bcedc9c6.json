        "id": "p42-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the ratio of female to male in the workforce?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4:3$",
          "worked": "$$\\begin{align*}\\text{Female parts} &=7-3\\\\&=4\\\\\\text{Female}:\\text{male} &=4:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p42-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "160 females work for the company. How many people work for the company altogether?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "280 people",
          "worked": "$$\\begin{align*}4\\text{ parts} &=160\\text{ people}\\\\1\\text{ part} &=160\\div4=40\\text{ people}\\\\7\\text{ parts} &=40\\times7=280\\text{ people}\\end{align*}$$\nThere are 280 people altogether.",
