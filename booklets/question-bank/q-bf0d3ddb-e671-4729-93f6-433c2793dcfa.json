  "content": {
    "id": "p53-q8",
    "type": "question",
    "label": "8",
    "prompt": "Find the percentage change when:\nGive non-exact percentages to two decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$60 is decreased by \\$15.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Final amount}&=60-15=45\\\\\\text{Change}&=45-60=-15\\\\\\text{Percentage change}&=\\frac{-15}{60}\\times100\\%=-25\\%\\end{align*}$$\nThe amount decreased by $25\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p53-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$60 is decreased to \\$15.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Change}&=15-60=-45\\\\\\text{Percentage change}&=\\frac{-45}{60}\\times100\\%=-75\\%\\end{align*}$$\nThe amount decreased by $75\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p53-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "\\$25 is increased to \\$37.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Change}&=37-25=12\\\\\\text{Percentage change}&=\\frac{12}{25}\\times100\\%=48\\%\\end{align*}$$\nThe amount increased by $48\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p53-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "\\$25 is increased by \\$37.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$148\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Final amount}&=25+37=62\\\\\\text{Change}&=62-25=37\\\\\\text{Percentage change}&=\\frac{37}{25}\\times100\\%=148\\%\\end{align*}$$\nThe amount increased by $148\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p53-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "\\$55 is decreased to \\$18.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$67.27\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Change}&=18-55=-37\\\\\\text{Percentage change}&=\\frac{-37}{55}\\times100\\%\\\\\\text{Percentage change}&\\approx-67.27\\%\\end{align*}$$\nThe amount decreased by $67.27\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p53-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "\\$37 is increased to \\$58.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56.76\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Change}&=58-37=21\\\\\\text{Percentage change}&=\\frac{21}{37}\\times100\\%\\\\\\text{Percentage change}&\\approx56.76\\%\\end{align*}$$\nThe amount increased by $56.76\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
