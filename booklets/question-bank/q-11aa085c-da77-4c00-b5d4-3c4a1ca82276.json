        "answer": {
          "short": "$2\\,500\\,000\\ \\mathrm{cm}^3$",
          "worked": "$$\\begin{align*}2.5\\ \\mathrm{m}^3 &= (2.5\\times100^3)\\ \\mathrm{cm}^3\\\\&=2\\,500\\,000\\ \\mathrm{cm}^3\\end{align*}$$",
