  "content": {
    "id": "p17-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "If $\\Pr(A)=0.4$, $\\Pr(B)=0.2$ and $\\Pr(A\\mid B)=0.3$, find $\\Pr(B\\mid A)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.15$",
      "worked": "By Bayes’ rule,\n$$\\begin{align*}\\Pr(B\\mid A)&=\\frac{\\Pr(B)\\Pr(A\\mid B)}{\\Pr(A)}\\\\\\Pr(B\\mid A)&=\\frac{0.2\\times0.3}{0.4}\\\\\\Pr(B\\mid A)&=0.15.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
