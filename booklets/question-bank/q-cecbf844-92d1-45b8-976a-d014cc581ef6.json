  "content": {
    "id": "p32-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "A sheep station has 1872 merino sheep. This is $36\\%$ of all the sheep on the station. How many sheep are there on the station?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "5200 sheep.",
      "worked": "$$\\begin{align*}\\text{Sheep in }36\\%&=1872\\\\\\text{Sheep in }1\\%&=1872\\div36=52\\\\\\text{Sheep in }100\\%&=52\\times100=5200\\end{align*}$$\n\nThere are 5200 sheep on the station.",
