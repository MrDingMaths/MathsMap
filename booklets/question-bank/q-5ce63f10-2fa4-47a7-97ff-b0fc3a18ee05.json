  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write each expression in terms of $\\log_a 2$",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a 8&=\\log_a(2^3)\\\\&=3\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a 16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a 16&=\\log_a(2^4)\\\\&=4\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a 64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a 64&=\\log_a(2^6)\\\\&=6\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\left(\\frac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac{1}{2}\\right)&=\\log_a(2^{-1})\\\\&=-\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a\\left(\\frac{1}{8}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac{1}{8}\\right)&=\\log_a(2^{-3})\\\\&=-3\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a\\left(\\frac{1}{32}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac{1}{32}\\right)&=\\log_a(2^{-5})\\\\&=-5\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_a\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt{2}&=\\log_a\\left(2^{\\frac{1}{2}}\\right)\\\\&=\\frac{1}{2}\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\left(\\frac{1}{\\sqrt{2}}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2}\\log_a 2$",
          "worked": "$$\\begin{align*}\\log_a\\left(\\frac{1}{\\sqrt{2}}\\right)&=\\log_a\\left(2^{-\\frac{1}{2}}\\right)\\\\&=-\\frac{1}{2}\\log_a 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
