  "content": {
    "id": "p8-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Ali is $\\frac{4}{26}$ of his way through a journey. What fraction of the journey does he have left?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{11}{13}$",
      "worked": "$\\begin{align*}\\text{Fraction left}&=1-\\frac{4}{26}\\\\\\text{Fraction left}&=\\frac{26}{26}-\\frac{4}{26}\\\\\\text{Fraction left}&=\\frac{22}{26}\\\\\\text{Fraction left}&=\\frac{11}{13}\\end{align*}$",
      "solutionDiagrams": []
    },
