  "content": {
    "id": "p44-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If $y$ is a positive real number and $\\left(y+\\frac{1}{y}\\right)^2=5$, find the value of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y+\\dfrac{1}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}$",
          "worked": "Since $y>0$, $y+\\frac{1}{y}>0$. Therefore\n$$y+\\frac{1}{y}=\\sqrt{5}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p44-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y^2+\\dfrac{1}{y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\left(y+\\frac{1}{y}\\right)^2&=y^2+2+\\frac{1}{y^2}\\\\y^2+\\frac{1}{y^2}&=5-2\\\\y^2+\\frac{1}{y^2}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
