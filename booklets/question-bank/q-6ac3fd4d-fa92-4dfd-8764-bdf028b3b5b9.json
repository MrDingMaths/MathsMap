  "content": {
    "id": "p8-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Expand the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(x+3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+12x+18$",
          "worked": "For the square, $a=x$, $b=3$.\n$$\\begin{align*}2(x+3)^2&=2[x^2+2(x)(3)+3^2]\\\\&=2(x^2+6x+9)\\\\&=2x^2+12x+18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$4(m+5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4m^2+40m+100$",
          "worked": "For the square, $a=m$, $b=5$.\n$$\\begin{align*}4(m+5)^2&=4[m^2+2(m)(5)+5^2]\\\\&=4(m^2+10m+25)\\\\&=4m^2+40m+100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$2(a-7)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^2-28a+98$",
          "worked": "The two terms inside the square are $a$ and $-7$.\n$$\\begin{align*}2(a-7)^2&=2[a^2+2(a)(-7)+(-7)^2]\\\\&=2(a^2-14a+49)\\\\&=2a^2-28a+98\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$-3(y+5)(y+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3y^2-30y-75$",
          "worked": "For the square, $a=y$, $b=5$.\n$$\\begin{align*}-3(y+5)(y+5)&=-3(y+5)^2\\\\&=-3[y^2+2(y)(5)+5^2]\\\\&=-3(y^2+10y+25)\\\\&=-3y^2-30y-75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p8-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$3(2b-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12b^2-12b+3$",
          "worked": "The two terms inside the square are $2b$ and $-1$.\n$$\\begin{align*}3(2b-1)^2&=3[(2b)^2+2(2b)(-1)+(-1)^2]\\\\&=3(4b^2-4b+1)\\\\&=12b^2-12b+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p8-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$-3(2y-6)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12y^2+72y-108$",
          "worked": "For the square, $a=2y$, $b=-6$.\n$$\\begin{align*}-3(2y-6)^2&=-3[(2y)^2+2(2y)(-6)+(-6)^2]\\\\&=-3(4y^2-24y+36)\\\\&=-12y^2+72y-108\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
