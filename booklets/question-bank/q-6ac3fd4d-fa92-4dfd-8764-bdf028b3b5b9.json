    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-36m^2+48m-16$",
      "worked": "For the square, $a=3m$, $b=-2$.\n$$\\begin{align*}-4(3m-2)^2&=-4[(3m)^2+2(3m)(-2)+(-2)^2]\\\\&=-4(9m^2-12m+4)\\\\&=-36m^2+48m-16\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
