              "type": "text",
              "text": "A retailer buys tennis rackets at $84 each and squash rackets at $54 each.",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q19-prompt-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
