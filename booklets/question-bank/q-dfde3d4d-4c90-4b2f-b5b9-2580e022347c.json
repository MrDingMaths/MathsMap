      {
        "id": "p36-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain how each graph is obtained by shifting $y=|x|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The first is $y=|x|$ shifted right $1$ unit; the second is $y=|x|$ shifted down $1$ unit.",
          "worked": "Replacing $x$ by $x-1$ shifts $y=|x|$ right $1$ unit, giving $y=|x-1|$.\n\nSubtracting $1$ from the output shifts $y=|x|$ down $1$ unit, giving $y=|x|-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p36-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Write down the domain and range of each function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=|x-1|$: domain $\\mathbb R$, range $y\\geq0$.\n\n$y=|x|-1$: domain $\\mathbb R$, range $y\\geq-1$.",
          "worked": "Both functions are defined for every real $x$.\n\nFor $y=|x-1|$, the minimum is $0$, attained at $x=1$, so the range is $[0,\\infty)$.\n\nFor $y=|x|-1$, the minimum is $-1$, attained at $x=0$, so the range is $[-1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
