        "answer": {
          "short": "For $|x-1|$: $3,2,1,0,1,2$.\n\nFor $|x|-1$: $1,0,-1,0,1,2$.",
          "worked": "For $x=-2,-1,0,1,2,3$, respectively:\n\n$\\begin{aligned}|x-1|&:|-3|,|-2|,|-1|,|0|,|1|,|2|\\\\&:3,2,1,0,1,2.\\end{aligned}$\n\n$\\begin{aligned}|x|-1&:2-1,1-1,0-1,1-1,2-1,3-1\\\\&:1,0,-1,0,1,2.\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
