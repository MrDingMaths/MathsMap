  "content": {
    "id": "p16-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A spinner with three numbers, 1, 2 and 3, is spun twice.\nEach number is equally likely to be spun on a single spin.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "List the set of possible outcomes, using a tree diagram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{11,12,13,21,22,23,31,32,33\\}$",
          "worked": "Each first-spin result branches to 1, 2 and 3 on the second spin. The complete paths give $\\{11,12,13,21,22,23,31,32,33\\}$.",
