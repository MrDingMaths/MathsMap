    "type": "question",
    "label": "8",
    "prompt": "The distance between interconnecting lines on a silicon chip for a computer is approximately $0.000\\,000\\,04\\text{ m}$. Express this in scientific notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\times10^{-8}\\text{ m}$",
      "worked": "$$\\begin{align*}0.000\\,000\\,04\\text{ m}&=4\\div100\\,000\\,000\\text{ m}\\\\0.000\\,000\\,04\\text{ m}&=4\\times\\frac{1}{100\\,000\\,000}\\text{ m}\\\\0.000\\,000\\,04\\text{ m}&=4\\times10^{-8}\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
