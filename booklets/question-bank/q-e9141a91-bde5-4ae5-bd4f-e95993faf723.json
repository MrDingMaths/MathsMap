      {
        "id": "p62-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=x\\log_e x-x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\log_e x$",
          "worked": "$$\\begin{align*}y&=x\\log_e x-x\\\\y'&=\\log_e x+x\\left(\\frac1x\\right)-1\\\\y'&=\\log_e x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p62-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $\\displaystyle\\int\\log_e x\\,dx$ and $\\displaystyle\\int_{\\sqrt e}^{e}\\log_e x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\int\\log_e x\\,dx=x\\log_e x-x+C$; $\\displaystyle\\int_{\\sqrt e}^{e}\\log_e x\\,dx=\\frac{\\sqrt e}{2}$.",
          "worked": "Using part a,\n$$\\int\\log_e x\\,dx=x\\log_e x-x+C.$$\n$$\\begin{align*}\\int_{\\sqrt e}^{e}\\log_e x\\,dx&=\\left[x\\log_e x-x\\right]_{\\sqrt e}^{e}\\\\&=(e-e)-\\left(\\sqrt e\\times\\frac12-\\sqrt e\\right)\\\\&=0-\\left(-\\frac{\\sqrt e}{2}\\right)\\\\&=\\frac{\\sqrt e}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
