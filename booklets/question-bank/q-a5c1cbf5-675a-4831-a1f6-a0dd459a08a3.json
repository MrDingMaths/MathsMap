  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{20+a}{a}=-3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-5$",
          "worked": "For $a\\ne0$,\n$$\\begin{align*}20+a&=-3a\\\\20&=-4a\\\\a&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{9-2t}{t}=13$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac35$",
          "worked": "For $t\\ne0$,\n$$\\begin{align*}9-2t&=13t\\\\9&=15t\\\\t&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{3}{x-1}=-1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$",
          "worked": "For $x\\ne1$,\n$$\\begin{align*}3&=-(x-1)\\\\3&=-x+1\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{3x}{2x-1}=-1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac15$",
          "worked": "For $x\\ne\\frac12$,\n$$\\begin{align*}3x&=-(2x-1)\\\\3x&=-2x+1\\\\5x&=1\\\\x&=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$$5=\\frac{x+1}{x+2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac94$",
          "worked": "For $x\\ne-2$,\n$$\\begin{align*}5(x+2)&=x+1\\\\5x+10&=x+1\\\\4x&=-9\\\\x&=-\\frac94\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{2x+3}{1-x}=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac16$",
          "worked": "For $x\\ne1$,\n$$\\begin{align*}2x+3&=4(1-x)\\\\2x+3&=4-4x\\\\6x&=1\\\\x&=\\frac16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{2x}{3}+\\frac{x-1}{4}=2x-1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac9{13}$",
          "worked": "$$\\begin{align*}\\frac{8x+3(x-1)}{12}&=2x-1\\\\8x+3(x-1)&=12(2x-1)\\\\11x-3&=24x-12\\\\9&=13x\\\\x&=\\frac9{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p18-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac3{x^2}-\\frac2x=\\frac5x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac37$",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}\\frac{3-2x}{x^2}&=\\frac{5x}{x^2}\\\\3-2x&=5x\\\\3&=7x\\\\x&=\\frac37\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p18-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{1-3x}{x^2}+\\frac2{3x}=\\frac4x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac3{19}$",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}\\frac{3(1-3x)+2x}{3x^2}&=\\frac{12x}{3x^2}\\\\3(1-3x)+2x&=12x\\\\3-7x&=12x\\\\3&=19x\\\\x&=\\frac3{19}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p18-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac{4x+1}{3}-\\frac{x-3}{6}=\\frac{x+5}{6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$$\\begin{align*}\\frac{2(4x+1)-(x-3)}6&=\\frac{x+5}6\\\\2(4x+1)-(x-3)&=x+5\\\\7x+5&=x+5\\\\6x&=0\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p18-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\frac1{x+2}-\\frac2{x-3}=\\frac5{(x+2)(x-3)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-12$",
          "worked": "For $x\\ne-2,3$,\n$$\\begin{align*}\\frac{(x-3)-2(x+2)}{(x+2)(x-3)}&=\\frac5{(x+2)(x-3)}\\\\(x-3)-2(x+2)&=5\\\\-x-7&=5\\\\-x&=12\\\\x&=-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p18-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\frac2{x+4}-\\frac1{x-1}=\\frac3{(x+4)(x-1)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=9$",
          "worked": "For $x\\ne-4,1$,\n$$\\begin{align*}\\frac{2(x-1)-(x+4)}{(x+4)(x-1)}&=\\frac3{(x+4)(x-1)}\\\\2(x-1)-(x+4)&=3\\\\x-6&=3\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
