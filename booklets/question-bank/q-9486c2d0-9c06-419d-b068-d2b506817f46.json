    "children": [
      {
        "id": "p33-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x+3}-\\dfrac{2(2-x)}{3-x}-\\dfrac{x-15}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2(x+4)}{x+3}$",
          "worked": "Use $3-x=-(x-3)$ and $2-x=-(x-2)$.\n\n$$\\begin{align*}\\frac{1}{x+3}-\\frac{2(2-x)}{3-x}-\\frac{x-15}{x^2-9}&=\\frac{(x-3)-2(x-2)(x+3)-(x-15)}{(x-3)(x+3)}\\\\\\frac{1}{x+3}-\\frac{2(2-x)}{3-x}-\\frac{x-15}{x^2-9}&=\\frac{-2x^2-2x+24}{(x-3)(x+3)}\\\\\\frac{1}{x+3}-\\frac{2(2-x)}{3-x}-\\frac{x-15}{x^2-9}&=\\frac{-2(x+4)(x-3)}{(x-3)(x+3)}\\\\\\frac{1}{x+3}-\\frac{2(2-x)}{3-x}-\\frac{x-15}{x^2-9}&=-\\frac{2(x+4)}{x+3}\\end{align*}$$\n\nValid for $x\\ne-3,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p33-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{x+7}+\\dfrac{3}{7-x}-\\dfrac{2(7+2x)}{x^2-49}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x+49}{49-x^2}$",
          "worked": "Use $7-x=-(x-7)$.\n\n$$\\begin{align*}\\frac{2}{x+7}+\\frac{3}{7-x}-\\frac{2(7+2x)}{x^2-49}&=\\frac{2(x-7)-3(x+7)-2(7+2x)}{(x-7)(x+7)}\\\\\\frac{2}{x+7}+\\frac{3}{7-x}-\\frac{2(7+2x)}{x^2-49}&=\\frac{-5x-49}{x^2-49}\\\\\\frac{2}{x+7}+\\frac{3}{7-x}-\\frac{2(7+2x)}{x^2-49}&=\\frac{5x+49}{49-x^2}\\end{align*}$$\n\nValid for $x\\ne-7,7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p33-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{6}{a^2-1}-\\dfrac{3}{a+1}+\\dfrac{3}{a-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{12}{a^2-1}$",
          "worked": "$$\\begin{align*}\\frac{6}{a^2-1}-\\frac{3}{a+1}+\\frac{3}{a-1}&=\\frac{6-3(a-1)+3(a+1)}{(a-1)(a+1)}\\\\\\frac{6}{a^2-1}-\\frac{3}{a+1}+\\frac{3}{a-1}&=\\frac{6-3a+3+3a+3}{(a-1)(a+1)}\\\\\\frac{6}{a^2-1}-\\frac{3}{a+1}+\\frac{3}{a-1}&=\\frac{12}{a^2-1}\\end{align*}$$\n\nValid for $a\\ne-1,1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p33-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a-x}{x}+\\dfrac{a+x}{a}-\\dfrac{a^2-x^2}{2ax}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^2+3x^2}{2ax}$",
          "worked": "$$\\begin{align*}\\frac{a-x}{x}+\\frac{a+x}{a}-\\frac{a^2-x^2}{2ax}&=\\frac{2a(a-x)+2x(a+x)-(a^2-x^2)}{2ax}\\\\\\frac{a-x}{x}+\\frac{a+x}{a}-\\frac{a^2-x^2}{2ax}&=\\frac{2a^2-2ax+2ax+2x^2-a^2+x^2}{2ax}\\\\\\frac{a-x}{x}+\\frac{a+x}{a}-\\frac{a^2-x^2}{2ax}&=\\frac{a^2+3x^2}{2ax}\\end{align*}$$\n\nValid for $a\\ne0$ and $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p33-q4e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{x^2-9x+20}+\\dfrac{1}{x^2-11x+30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{(x-4)(x-6)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2-9x+20}+\\frac{1}{x^2-11x+30}&=\\frac{1}{(x-4)(x-5)}+\\frac{1}{(x-5)(x-6)}\\\\\\frac{1}{x^2-9x+20}+\\frac{1}{x^2-11x+30}&=\\frac{(x-6)+(x-4)}{(x-4)(x-5)(x-6)}\\\\\\frac{1}{x^2-9x+20}+\\frac{1}{x^2-11x+30}&=\\frac{2(x-5)}{(x-4)(x-5)(x-6)}\\\\\\frac{1}{x^2-9x+20}+\\frac{1}{x^2-11x+30}&=\\frac{2}{(x-4)(x-6)}\\end{align*}$$\n\nValid for $x\\ne4,5,6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p33-q4f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{2x^2-x-1}-\\dfrac{3}{6x^2-x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{(2x+1)(x-1)(3x-2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{2x^2-x-1}-\\frac{3}{6x^2-x-2}&=\\frac{1}{(2x+1)(x-1)}-\\frac{3}{(2x+1)(3x-2)}\\\\\\frac{1}{2x^2-x-1}-\\frac{3}{6x^2-x-2}&=\\frac{(3x-2)-3(x-1)}{(2x+1)(x-1)(3x-2)}\\\\\\frac{1}{2x^2-x-1}-\\frac{3}{6x^2-x-2}&=\\frac{3x-2-3x+3}{(2x+1)(x-1)(3x-2)}\\\\\\frac{1}{2x^2-x-1}-\\frac{3}{6x^2-x-2}&=\\frac{1}{(2x+1)(x-1)(3x-2)}\\end{align*}$$\n\nValid for $x\\ne-\\frac12,1,\\frac23$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p33-q4g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{4}{4-7a-2a^2}-\\dfrac{4}{3-a-10a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{4(4a-1)}{(5a+3)(2a-1)(a+4)}$",
          "worked": "$$\\begin{align*}\\frac{4}{4-7a-2a^2}-\\frac{4}{3-a-10a^2}&=-\\frac{4}{(2a-1)(a+4)}+\\frac{4}{(5a+3)(2a-1)}\\\\\\frac{4}{4-7a-2a^2}-\\frac{4}{3-a-10a^2}&=\\frac{-4(5a+3)+4(a+4)}{(5a+3)(2a-1)(a+4)}\\\\\\frac{4}{4-7a-2a^2}-\\frac{4}{3-a-10a^2}&=\\frac{-16a+4}{(5a+3)(2a-1)(a+4)}\\\\\\frac{4}{4-7a-2a^2}-\\frac{4}{3-a-10a^2}&=-\\frac{4(4a-1)}{(5a+3)(2a-1)(a+4)}\\end{align*}$$\n\nValid for $a\\ne-\\frac35,\\frac12,-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p33-q4h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{5}{a^2-9}+\\dfrac{6}{a-3}+\\dfrac{7}{a+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13a+2}{a^2-9}$",
          "worked": "$$\\begin{align*}\\frac{5}{a^2-9}+\\frac{6}{a-3}+\\frac{7}{a+3}&=\\frac{5+6(a+3)+7(a-3)}{(a-3)(a+3)}\\\\\\frac{5}{a^2-9}+\\frac{6}{a-3}+\\frac{7}{a+3}&=\\frac{5+6a+18+7a-21}{(a-3)(a+3)}\\\\\\frac{5}{a^2-9}+\\frac{6}{a-3}+\\frac{7}{a+3}&=\\frac{13a+2}{a^2-9}\\end{align*}$$\n\nValid for $a\\ne-3,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
