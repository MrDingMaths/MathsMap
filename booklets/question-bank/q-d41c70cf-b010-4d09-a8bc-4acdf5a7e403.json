  "content": {
    "id": "p16-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find $f(g(x))$ and $g(f(x))$ for each of these function pairs.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q11-a",
        "type": "group",
        "label": "a",
        "prompt": "$f(x)=x-2$, $g(x)=2x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q11-a-fg",
            "type": "part",
            "label": "i",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x+3$",
              "worked": "$$\\begin{aligned}f(g(x))&=f(2x+5)\\\\f(g(x))&=(2x+5)-2\\\\f(g(x))&=2x+3\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p16-q11-a-gf",
            "type": "part",
            "label": "ii",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x+1$",
              "worked": "$$\\begin{aligned}g(f(x))&=g(x-2)\\\\g(f(x))&=2(x-2)+5\\\\g(f(x))&=2x-4+5\\\\g(f(x))&=2x+1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p16-q11-b",
        "type": "group",
        "label": "b",
        "prompt": "$f(x)=2x$, $g(x)=3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q11-b-fg",
            "type": "part",
            "label": "i",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6x$",
              "worked": "$$\\begin{aligned}f(g(x))&=f(3x)\\\\f(g(x))&=2(3x)\\\\f(g(x))&=6x\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p16-q11-b-gf",
            "type": "part",
            "label": "ii",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6x$",
              "worked": "$$\\begin{aligned}g(f(x))&=g(2x)\\\\g(f(x))&=3(2x)\\\\g(f(x))&=6x\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p16-q11-c",
        "type": "group",
        "label": "c",
        "prompt": "$f(x)=x^2$, $g(x)=x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q11-c-fg",
            "type": "part",
            "label": "i",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^6$",
              "worked": "$$\\begin{aligned}f(g(x))&=f(x^3)\\\\f(g(x))&=(x^3)^2\\\\f(g(x))&=x^6\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p16-q11-c-gf",
            "type": "part",
            "label": "ii",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^6$",
              "worked": "$$\\begin{aligned}g(f(x))&=g(x^2)\\\\g(f(x))&=(x^2)^3\\\\g(f(x))&=x^6\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      },
      {
        "id": "p16-q11-d",
        "type": "group",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{1}{x}$, $g(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q11-d-fg",
            "type": "part",
            "label": "i",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{\\sqrt{x}}$, $x>0$",
              "worked": "$$\\begin{aligned}f(g(x))&=f(\\sqrt{x})\\\\f(g(x))&=\\frac{1}{\\sqrt{x}}\\end{aligned}$$\nThe square root must be defined and the denominator nonzero, so $x>0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p16-q11-d-gf",
            "type": "part",
            "label": "ii",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{\\sqrt{x}}$, $x>0$",
              "worked": "$$\\begin{aligned}g(f(x))&=g\\left(\\frac{1}{x}\\right)\\\\g(f(x))&=\\sqrt{\\frac{1}{x}}\\\\g(f(x))&=\\frac{1}{\\sqrt{x}}\\end{aligned}$$\nHere $x\\ne0$ and $\\frac{1}{x}\\ge0$, so $x>0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      }
    ]
  },
