  "content": {
    "id": "v2-1e331-p64-practice-slot-12-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Find values of $p$ for which the parabola $y=x^{2}+px+16$ is always above the $x$-axis.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-8<p<8$",
      "worked": "The parabola opens upwards, so it is always above the $x$-axis when it has no $x$-intercepts, $\\Delta<0$.\n$$\\begin{align*}\\Delta&=p^{2}-4(1)(16)\\\\&=p^{2}-64\\\\p^{2}-64&<0\\\\(p-8)(p+8)&<0\\end{align*}$$\nThe parabola $y=p^{2}-64$ opens upwards with intercepts $-8$ and $8$. It is below the axis between these intercepts.\n$$-8<p<8$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
