        "label": "a",
        "prompt": "$\\dfrac{x^2+5x+6}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{align*}\\frac{x^2+5x+6}{x+2}&=\\frac{(x+2)(x+3)}{x+2}\\\\&=x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
