  "content": {
    "id": "p20-q8-content",
    "type": "question",
    "label": "8",
    "prompt": "Calculate the present value, to the nearest dollar, for a future value of $\\$1580$, interest rate at 4.8% p.a. compounded monthly for 4 years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$1304$",
      "worked": "$r=\\frac{0.048}{12}=0.004$, $n=4\\times12=48$.\n\n$$\\begin{align*}FV&=PV(1+r)^n\\\\1580&=PV(1+0.004)^{48}\\\\PV&=\\frac{1580}{(1.004)^{48}}\\\\PV&\\approx\\$1304\\quad\\text{(nearest dollar)}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
