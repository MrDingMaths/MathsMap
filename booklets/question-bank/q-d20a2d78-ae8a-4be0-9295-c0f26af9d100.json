  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Joe widens a $1.2\\text{ m}$ doorway by $50\\text{ mm}$. What is the new width of the doorway, in centimetres?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$125\\text{ cm}$",
      "worked": "$$\\begin{align*}\n\\text{Original width} &= 1.2\\times100\\text{ cm} \\\\\n\\text{Original width} &= 120\\text{ cm} \\\\\n\\text{Increase} &= 50\\div10\\text{ cm} \\\\\n\\text{Increase} &= 5\\text{ cm} \\\\\n\\text{New width} &= (120+5)\\text{ cm} \\\\\n\\text{New width} &= 125\\text{ cm}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
