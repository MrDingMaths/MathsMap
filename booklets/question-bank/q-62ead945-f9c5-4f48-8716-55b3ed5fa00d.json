  "content": {
    "id": "p33-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A function has equation $y=\\dfrac{x^3}{3}-3x^2+11x-9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the function has no stationary points.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=x^2-6x+11$. Its discriminant is $-8<0$, so $y'=0$ has no real solutions and there are no stationary points.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q14-a-derivative",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y'=x^2-6x+11",
                    "display": false
                  }
                ]
              },
              {
                "id": "p33-q14-a-condition",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For stationary points: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y'=0",
                    "display": false
                  }
                ]
              },
              {
                "id": "p33-q14-a-equation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x^2-6x+11=0",
                    "display": false
                  }
                ]
              },
              {
                "id": "p33-q14-a-discriminant",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Discriminant: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\Delta=(-6)^2-4(1)(11)=-8<0",
                    "display": false
                  }
                ]
              },
              {
                "id": "p33-q14-a-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "No real solutions, so no stationary points.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
