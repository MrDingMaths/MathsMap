                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "From part a, the upward-opening parabola ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y'=x^2-6x+11",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " has no zeros, so ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y'>0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " for all real ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p33-q14-c-increasing",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Therefore, the graph is strictly increasing.",
                    "marks": []
                  }
                ]
              },
              {
