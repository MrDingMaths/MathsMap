    "label": "6",
    "prompt": "$n$ tonnes of coal are stored in a shed. An extra 1000 tonnes are then added.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many tonnes of coal are there in the shed now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+1000)$ tonnes",
          "worked": "The shed now contains $(n+1000)$ tonnes of coal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "It is decided to ship the coal in 10 equal loads. How many tonnes of coal are there in each load?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{n+1000}{10}$ tonnes",
          "worked": "$$\\begin{align*}\\text{Coal per load}&=(n+1000)\\div 10\\\\\\text{Coal per load}&=\\frac{n+1000}{10}\\text{ tonnes}.\\end{align*}$$",
