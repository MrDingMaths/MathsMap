  "content": {
    "id": "p28-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the limiting sums if they exist, rationalising denominators where necessary.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$1+(1.01)+(1.01)^2+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No limiting sum.",
          "worked": "$r=1.01>1$, so $|r|>1$ and there is no limiting sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p28-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$1+(1.01)^{-1}+(1.01)^{-2}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=101$",
          "worked": "$a=1$ and $r=(1.01)^{-1}=\\frac{100}{101}$. Since $|r|<1$,\n$$\\begin{aligned}S_\\infty&=\\frac{a}{1-r}\\\\&=\\frac{1}{1-\\frac{100}{101}}\\\\&=101.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p28-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$16\\sqrt5+4\\sqrt5+\\sqrt5+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\frac{64\\sqrt5}{3}$",
          "worked": "$a=16\\sqrt5$ and $r=\\frac14$. Since $|r|<1$,\n$$\\begin{aligned}S_\\infty&=\\frac{a}{1-r}\\\\&=\\frac{16\\sqrt5}{1-\\frac14}\\\\&=\\frac{64\\sqrt5}{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p28-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$7+\\sqrt7+1+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\frac{7(7+\\sqrt7)}{6}$",
          "worked": "$a=7$ and $r=\\frac{\\sqrt7}{7}$. Since $|r|<1$,\n$$\\begin{aligned}S_\\infty&=\\frac{7}{1-\\frac{\\sqrt7}{7}}\\\\&=\\frac{49}{7-\\sqrt7}\\\\&=\\frac{49(7+\\sqrt7)}{49-7}\\\\&=\\frac{7(7+\\sqrt7)}{6}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p28-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$4-2\\sqrt2+2-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=4(2-\\sqrt2)$",
          "worked": "$a=4$ and $r=-\\frac{\\sqrt2}{2}$. Since $|r|<1$,\n$$\\begin{aligned}S_\\infty&=\\frac{4}{1+\\frac{\\sqrt2}{2}}\\\\&=\\frac{8}{2+\\sqrt2}\\\\&=\\frac{8(2-\\sqrt2)}{4-2}\\\\&=4(2-\\sqrt2).\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p28-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$5-2\\sqrt5+4-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=5(5-2\\sqrt5)$",
          "worked": "$a=5$ and $r=-\\frac{2\\sqrt5}{5}$. Since $|r|<1$,\n$$\\begin{aligned}S_\\infty&=\\frac{5}{1+\\frac{2\\sqrt5}{5}}\\\\&=\\frac{25}{5+2\\sqrt5}\\\\&=\\frac{25(5-2\\sqrt5)}{25-20}\\\\&=5(5-2\\sqrt5).\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p28-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$9+3\\sqrt{10}+10+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No limiting sum.",
          "worked": "$$r=\\frac{3\\sqrt{10}}9=\\frac{\\sqrt{10}}3>1.$$\nSince $|r|>1$, there is no limiting sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$1+(1-\\sqrt3)+(1-\\sqrt3)^2+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_\\infty=\\frac{\\sqrt3}{3}$",
          "worked": "$a=1$ and $r=1-\\sqrt3$. Since $-1<1-\\sqrt3<0$, $|r|<1$.\n$$\\begin{aligned}S_\\infty&=\\frac{1}{1-(1-\\sqrt3)}\\\\&=\\frac{1}{\\sqrt3}\\\\&=\\frac{\\sqrt3}{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
