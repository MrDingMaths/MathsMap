    "type": "question",
    "label": null,
    "prompt": "Simplify, by factoring out $-1$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-da515b-p6-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{6-x}{x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{6-x}{x-6}&=\\frac{-(x-6)}{x-6}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-da515b-p6-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3x-2}{2-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{3x-2}{2-3x}&=\\frac{3x-2}{-(3x-2)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-da515b-p6-practice-slot-5-slot-5-q-c",
