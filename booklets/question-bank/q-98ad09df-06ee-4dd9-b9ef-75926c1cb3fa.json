  "content": {
    "id": "p12-problem2-root",
    "type": "question",
    "label": "2",
    "prompt": "A naval ship $P$ is equipped with a scanner that is able to detect objects inside the circle $x^2+y^2-80x-40y-500=0$, where the radius is measured in kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-problem2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the location of the ship $P$ and the radius of the scanner.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(40,20)$; scanner radius $50\\text{ km}$.",
          "worked": "$\\begin{align*}x^2-80x+y^2-40y&=500\\\\(x-40)^2+(y-20)^2&=500+1600+400\\\\(x-40)^2+(y-20)^2&=2500.\\end{align*}$\nThe centre is $P(40,20)$ and the radius is $\\sqrt{2500}=50\\text{ km}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-problem2-b",
        "type": "group",
        "label": "b",
        "prompt": "Another ship $Q$ is located at $(60,-20)$ and it can detect objects in a region within a radius of 40 kilometres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-problem2-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Will ship $P$ be able to detect ship $Q$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes. $PQ=20\\sqrt5\\text{ km}<50\\text{ km}$.",
              "worked": "$\\begin{align*}PQ&=\\sqrt{(60-40)^2+(-20-20)^2}\\\\PQ&=\\sqrt{400+1600}\\\\PQ&=20\\sqrt5\\text{ km}.\\end{align*}$\nSince $PQ^2=2000<2500=50^2$, ship $Q$ is within $P$'s scanning radius. Yes, $P$ can detect $Q$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p12-problem2-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Will ship $Q$ be able to detect ship $P$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No. $PQ=20\\sqrt5\\text{ km}>40\\text{ km}$.",
              "worked": "The ships are $20\\sqrt5\\text{ km}$ apart. Since $PQ^2=2000>1600=40^2$, ship $P$ is outside $Q$'s scanning radius. No, $Q$ cannot detect $P$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          }
        ]
      }
    ]
  },
