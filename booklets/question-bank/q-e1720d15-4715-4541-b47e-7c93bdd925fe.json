    "children": [
      {
        "id": "p14-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{1-\\cos 2x}{1+\\cos 2x}=\\tan^2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1-\\cos 2x}{1+\\cos 2x}=\\dfrac{2\\sin^2x}{2\\cos^2x}=\\tan^2x$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\frac{1-\\cos 2x}{1+\\cos 2x}\\\\&=\\frac{1-(1-2\\sin^2x)}{1+(2\\cos^2x-1)}\\\\&=\\frac{2\\sin^2x}{2\\cos^2x}\\\\&=\\frac{\\sin^2x}{\\cos^2x}\\\\&=\\tan^2x\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the exact value of $\\tan\\dfrac{\\pi}{8}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2-1$",
          "worked": "Let $x=\\dfrac{\\pi}{8}$.\n$$\\begin{aligned}\\tan^2\\frac{\\pi}{8}&=\\frac{1-\\cos\\frac{\\pi}{4}}{1+\\cos\\frac{\\pi}{4}}\\\\&=\\frac{1-\\frac1{\\sqrt2}}{1+\\frac1{\\sqrt2}}\\\\&=\\frac{\\sqrt2-1}{\\sqrt2+1}\\\\&=\\frac{(\\sqrt2-1)^2}{(\\sqrt2+1)(\\sqrt2-1)}\\\\&=(\\sqrt2-1)^2.\\end{aligned}$$\nSince $\\dfrac{\\pi}{8}$ is in the first quadrant, $\\tan\\dfrac{\\pi}{8}>0$. Therefore $\\tan\\dfrac{\\pi}{8}=\\sqrt2-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
