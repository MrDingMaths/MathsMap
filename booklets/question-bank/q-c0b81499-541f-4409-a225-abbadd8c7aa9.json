    "type": "question",
    "label": "12",
    "prompt": "Simplify $\\displaystyle\\frac{\\sqrt3+\\sqrt2}{\\sqrt2+\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{\\sqrt2+\\sqrt2-\\sqrt3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac25$\n\nCombine like surds in the denominators, then use the difference of squares.",
      "worked": "$$\\begin{align*}\\frac{\\sqrt3+\\sqrt2}{\\sqrt2+\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{\\sqrt2+\\sqrt2-\\sqrt3}&=\\frac{\\sqrt3+\\sqrt2}{2\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{2\\sqrt2-\\sqrt3}\\\\\\frac{\\sqrt3+\\sqrt2}{\\sqrt2+\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{\\sqrt2+\\sqrt2-\\sqrt3}&=\\frac{(\\sqrt3+\\sqrt2)(2\\sqrt2-\\sqrt3)-(\\sqrt3-\\sqrt2)(2\\sqrt2+\\sqrt3)}{(2\\sqrt2)^2-(\\sqrt3)^2}\\\\\\frac{\\sqrt3+\\sqrt2}{\\sqrt2+\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{\\sqrt2+\\sqrt2-\\sqrt3}&=\\frac{(2\\sqrt6-3+4-\\sqrt6)-(2\\sqrt6+3-4-\\sqrt6)}{8-3}\\\\\\frac{\\sqrt3+\\sqrt2}{\\sqrt2+\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{\\sqrt2+\\sqrt2-\\sqrt3}&=\\frac{(\\sqrt6+1)-(\\sqrt6-1)}5\\\\\\frac{\\sqrt3+\\sqrt2}{\\sqrt2+\\sqrt2+\\sqrt3}-\\frac{\\sqrt3-\\sqrt2}{\\sqrt2+\\sqrt2-\\sqrt3}&=\\frac25\\end{align*}$$",
      "solutionDiagrams": []
    },
