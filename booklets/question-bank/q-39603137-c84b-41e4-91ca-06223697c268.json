  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A door frame has height 1.8 m and width 1 m. Will a square piece of board 2.1 m wide fit through the opening?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No. The doorway diagonal is about $2.06\\text{ m}$, less than $2.1\\text{ m}$.",
      "worked": "Let $d$ metres be the diagonal of the doorway.\n$$\\begin{align*}d^2&=1.8^2+1^2\\\\d^2&=4.24\\\\d&=\\sqrt{4.24}\\text{ m}\\\\d&\\approx2.06\\text{ m}\\end{align*}$$\nSince $\\sqrt{4.24}<2.1$, the board will not fit through the opening.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
