  "content": {
    "id": "p52-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the equation of each transformed function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^3$ is translated 3 units down and 4 units to the left",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+4)^3-3$",
          "worked": "Replace $y$ by $y+3$ and $x$ by $x+4$.\n$$\\begin{align*}y+3&=(x+4)^3\\\\y&=(x+4)^3-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p52-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=|x|$ is translated 9 units up and 1 unit to the right",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=|x-1|+9$",
          "worked": "Replace $y$ by $y-9$ and $x$ by $x-1$.\n$$\\begin{align*}y-9&=|x-1|\\\\y&=|x-1|+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p52-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x$ is dilated vertically with a factor of 3 and translated down 6 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x-6$",
          "worked": "Replace $y$ by $\\frac{y}{3}$, then replace $y$ by $y+6$.\n$$\\begin{align*}\\frac{y}{3}&=x\\\\\\frac{y+6}{3}&=x\\\\y&=3x-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p52-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=10^x$ is reflected in the x-axis and translated up 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-10^x+2$",
          "worked": "Replace $y$ by $-y$, then replace $y$ by $y-2$.\n$$\\begin{align*}-y&=10^x\\\\-(y-2)&=10^x\\\\y&=-10^x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p52-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^3$ is horizontally dilated by a factor of $\\frac{1}{2}$ and translated down 5 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(2x)^3-5$",
          "worked": "Replace $x$ by $2x$ and $y$ by $y+5$.\n$$\\begin{align*}y+5&=(2x)^3\\\\y&=(2x)^3-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p52-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{1}{x}$ is vertically dilated by a factor of 2 and horizontally dilated by a factor of 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{2}{\\frac{x}{3}}=\\frac{6}{x}$",
          "worked": "Replace $y$ by $\\frac{y}{2}$ and $x$ by $\\frac{x}{3}$.\n$$\\begin{align*}\\frac{y}{2}&=\\frac{1}{\\frac{x}{3}}\\\\y&=\\frac{2}{\\frac{x}{3}}\\\\y&=\\frac{6}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p52-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\sqrt{x}$ is reflected in the y-axis, vertically dilated by a factor of 3 and horizontally dilated by a factor of $\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3\\sqrt{-2x}$",
          "worked": "Replace $x$ by $-x$, then $y$ by $\\frac{y}{3}$, then $x$ by $2x$.\n$$\\begin{align*}y&=\\sqrt{-x}\\\\\\frac{y}{3}&=\\sqrt{-x}\\\\\\frac{y}{3}&=\\sqrt{-2x}\\\\y&=3\\sqrt{-2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p52-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\ln x$ is horizontally dilated by a factor of 3 and translated upwards by 2 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left(\\frac{x}{3}\\right)+2$",
          "worked": "Replace $x$ by $\\frac{x}{3}$ and $y$ by $y-2$.\n$$\\begin{align*}y-2&=\\ln\\left(\\frac{x}{3}\\right)\\\\y&=\\ln\\left(\\frac{x}{3}\\right)+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p52-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\log_2 x$ is horizontally dilated by a factor of $\\frac{1}{4}$ and vertically dilated by a factor of 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3\\log_2(4x)$",
          "worked": "Replace $x$ by $4x$ and $y$ by $\\frac{y}{3}$.\n$$\\begin{align*}\\frac{y}{3}&=\\log_2(4x)\\\\y&=3\\log_2(4x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p52-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=x^2$ is horizontally dilated by a factor of 2 and translated down 3 units",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\left(\\frac{x}{2}\\right)^2-3$",
          "worked": "Replace $x$ by $\\frac{x}{2}$ and $y$ by $y+3$.\n$$\\begin{align*}y+3&=\\left(\\frac{x}{2}\\right)^2\\\\y&=\\left(\\frac{x}{2}\\right)^2-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
