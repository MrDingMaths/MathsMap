    "label": "9",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{(x+1)^2}+\\dfrac{1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{(x+1)^2}$",
          "worked": "$$\\begin{aligned}\\frac{1}{(x+1)^2}+\\frac{1}{x+1}&=\\frac{1}{(x+1)^2}+\\frac{x+1}{(x+1)^2}\\\\&=\\frac{x+2}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p34-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{(x+1)^2}-\\dfrac{1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1-x}{(x+1)^2}$",
          "worked": "$$\\begin{aligned}\\frac{2}{(x+1)^2}-\\frac{1}{x+1}&=\\frac{2}{(x+1)^2}-\\frac{x+1}{(x+1)^2}\\\\&=\\frac{2-(x+1)}{(x+1)^2}\\\\&=\\frac{1-x}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3}{(x-2)^2}+\\dfrac{2}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x-1}{(x-2)^2}$",
          "worked": "$$\\begin{aligned}\\frac{3}{(x-2)^2}+\\frac{2}{x-2}&=\\frac{3}{(x-2)^2}+\\frac{2(x-2)}{(x-2)^2}\\\\&=\\frac{3+2x-4}{(x-2)^2}\\\\&=\\frac{2x-1}{(x-2)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x}{(x+3)^2}-\\dfrac{1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{(x+3)^2}$",
          "worked": "$$\\begin{aligned}\\frac{x}{(x+3)^2}-\\frac{1}{x+3}&=\\frac{x}{(x+3)^2}-\\frac{x+3}{(x+3)^2}\\\\&=\\frac{x-(x+3)}{(x+3)^2}\\\\&=-\\frac{3}{(x+3)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
