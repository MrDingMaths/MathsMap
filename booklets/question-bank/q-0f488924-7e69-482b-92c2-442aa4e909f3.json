  },
  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Suppose that $\\log_a b=x$ and $\\log_a c=y$. Express each of the following in terms of $x$ and $y$:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a bc$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y$",
          "worked": "$$\\begin{align*}\\log_a bc&=\\log_a b+\\log_a c\\\\\\log_a bc&=x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac{b}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-y$",
          "worked": "$$\\begin{align*}\\log_a\\frac{b}{c}&=\\log_a b-\\log_a c\\\\\\log_a\\frac{b}{c}&=x-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}\\log_a b^2&=2\\log_a b\\\\\\log_a b^2&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a c^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y$",
          "worked": "$$\\begin{align*}\\log_a c^3&=3\\log_a c\\\\\\log_a c^3&=3y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a b^3c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+2y$",
          "worked": "$$\\begin{align*}\\log_a b^3c^2&=\\log_a b^3+\\log_a c^2\\\\\\log_a b^3c^2&=3\\log_a b+2\\log_a c\\\\\\log_a b^3c^2&=3x+2y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a abc$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+x+y$",
          "worked": "$$\\begin{align*}\\log_a abc&=\\log_a a+\\log_a b+\\log_a c\\\\\\log_a abc&=1+x+y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_a\\frac{a^2b^3}{c^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+3x-4y$",
          "worked": "$$\\begin{align*}\\log_a\\frac{a^2b^3}{c^4}&=\\log_a a^2+\\log_a b^3-\\log_a c^4\\\\\\log_a\\frac{a^2b^3}{c^4}&=2\\log_a a+3\\log_a b-4\\log_a c\\\\\\log_a\\frac{a^2b^3}{c^4}&=2+3x-4y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p8-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\sqrt{ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+1}{2}$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt{ab}&=\\frac12\\log_a ab\\\\\\log_a\\sqrt{ab}&=\\frac12(\\log_a a+\\log_a b)\\\\\\log_a\\sqrt{ab}&=\\frac{1+x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
