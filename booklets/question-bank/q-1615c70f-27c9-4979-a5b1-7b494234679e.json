  "content": {
    "id": "p7-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "There are 200 packets hidden in a lucky dip. Five packets contain $\\$1$ and the rest contain 5 cents. What is the probability that you will not draw out a packet containing $\\$1$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{39}{40}$",
      "worked": "Let $A$ be the event that the packet contains $\\$1$.\n$$P(A)=\\frac{5}{200}=\\frac{1}{40}.$$\nThe event that the packet does not contain $\\$1$ is $A^c$.\n$$\\begin{align*}P(A^c)&=1-P(A)\\\\P(A^c)&=1-\\frac{1}{40}\\\\P(A^c)&=\\frac{39}{40}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
