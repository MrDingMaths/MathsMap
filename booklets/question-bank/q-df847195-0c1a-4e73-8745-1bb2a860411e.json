  "content": {
    "id": "p57-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Simplify the following. $\\dfrac{x^2-9}{x^2-6x+9}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{x+3}{x-3}$, $x\\ne3$.",
      "worked": "The original denominator requires $x\\ne3$.\n$$\\begin{align*}\\frac{x^2-9}{x^2-6x+9}&=\\frac{(x-3)(x+3)}{(x-3)^2}\\\\\\frac{x^2-9}{x^2-6x+9}&=\\frac{x+3}{x-3}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
