          "role": "solution",
          "format": "tikz",
          "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"page 23 question 5\"}\n\\begin{tikzpicture}[x=1.1cm,y=0.24cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[line width=0.5pt,->] (-0.2,0)--(6.6,0);\n\\draw[line width=0.5pt,->] (0,0)--(0,23);\n\\foreach \\v in {0,5,10,15,20}{\\draw[line width=0.4pt](-0.08,\\v)--(0,\\v) node[left]{\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\v\\special{dvisvgm:raw </g>}};}\n\\foreach \\x/\\d in {0/Mon,1/Tues,2/Wed,3/Thur,4/Fri,5/Sat,6/Sun}{\\draw[line width=0.4pt](\\x,0)--(\\x,-0.4) node[rotate=45,anchor=north east,font=\\fontsize{8.5}{10}\\selectfont]{\\d};}\n\\draw[line width=0.8pt] (0,18)--(1,14)--(2,17)--(3,20)--(4,12)--(5,13)--(6,15);\n\\foreach \\x/\\y in {0/18,1/14,2/17,3/20,4/12,5/13,6/15}{\\fill(\\x,\\y) circle[radius=1.5pt];}\n\\node[above] at (3,23){Maximum daily temperature};\n\\node[below] at (3,-8){Day};\n\\node[rotate=90] at (-2.2,11){Temperature ($^\\circ$C)};\n\\end{tikzpicture}",
