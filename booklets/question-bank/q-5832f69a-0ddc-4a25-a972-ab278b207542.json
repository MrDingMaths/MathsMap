  "content": {
    "id": "p3-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The outside of an $n\\times n\\times n$ cube is painted red. The cube is then chopped into $n^3$ unit cubes. The unit cubes are placed in a sack, and one is randomly pulled out and tossed across a table. Find the probability that the uppermost face is painted red.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p3-q8-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\frac{1}{n}",
                "display": false
              }
            ]
          },
          {
            "id": "p3-q8-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Count painted faces among all equally likely unit-cube faces.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Each of the $n^3$ unit cubes has six faces, giving $6n^3$ equally likely faces. The six original faces each contain $n^2$ painted unit faces, giving $6n^2$ painted faces.\n\n$$\\begin{align*}\\Pr(\\text{uppermost face is red})&=\\frac{6n^2}{6n^3}\\\\\\Pr(\\text{uppermost face is red})&=\\frac{1}{n}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
