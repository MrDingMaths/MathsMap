  "content": {
    "id": "p10-ch7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A tank contains $n$ litres of water. 70 litres of water are added to the tank.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-ch7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How many litres of water are there now in the tank?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+70)\\text{ L}$",
          "worked": "The original $n$ litres plus 70 litres gives $(n+70)\\text{ L}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-ch7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "The water is divided into 150 containers. How much water is there in each container?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{n+70}{150}\\text{ L}$",
          "worked": "Divide the total volume equally among the 150 containers:\n\n$$\\text{Volume per container}=\\frac{n+70}{150}\\text{ L}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
