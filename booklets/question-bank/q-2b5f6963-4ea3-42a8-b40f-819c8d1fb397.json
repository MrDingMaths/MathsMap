    "children": [
      {
        "id": "p7-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $$\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2\\theta$",
          "worked": "$$\\begin{align*}\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}&=\\frac{2\\sin^2\\theta}{2\\cos^2\\theta}\\\\\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}&=\\frac{\\sin^2\\theta}{\\cos^2\\theta}\\\\\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}&=\\tan^2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find an expression for $\\tan\\frac{\\pi}{8}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2-1$",
          "worked": "Using part (a),\n$$\\begin{align*}\\tan^2\\frac{\\pi}{8}&=\\frac{1-\\cos\\frac{\\pi}{4}}{1+\\cos\\frac{\\pi}{4}}\\\\\\tan^2\\frac{\\pi}{8}&=\\frac{\\sqrt2-1}{\\sqrt2+1}\\\\\\tan^2\\frac{\\pi}{8}&=(\\sqrt2-1)^2.\\end{align*}$$\nSince $\\frac{\\pi}{8}$ is in Quadrant I, $\\tan\\frac{\\pi}{8}>0$.\n$$\\tan\\frac{\\pi}{8}=\\sqrt2-1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
