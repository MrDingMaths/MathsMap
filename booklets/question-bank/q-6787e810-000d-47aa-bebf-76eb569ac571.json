    "id": "v2-8d9c0-p24-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Use $f(x)=2e^{3x}-5$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8d9c0-p24-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(0)$ and $f(1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(0)=-3$; $f(1)=2e^3-5$.",
          "worked": "$$\\begin{align*}f(0)&=2e^{3(0)}-5\\\\&=2-5\\\\&=-3\\end{align*}$$\n$$\\begin{align*}f(1)&=2e^{3(1)}-5\\\\&=2e^3-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-8d9c0-p24-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $f(-1)$ and $f(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-1)=2e^{-3}-5$; $f(2)=2e^6-5$.",
          "worked": "$$\\begin{align*}f(-1)&=2e^{3(-1)}-5\\\\&=2e^{-3}-5\\end{align*}$$\n$$\\begin{align*}f(2)&=2e^{3(2)}-5\\\\&=2e^6-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
