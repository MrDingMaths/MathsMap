    "children": [
      {
        "id": "p14-q11-evaluate",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $\\dfrac{\\sin 20^{\\circ}}{\\cos 20^{\\circ}}$ to 2 decimal places. How does this compare to $\\tan 20^{\\circ}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx0.36$; the unrounded quotient equals $\\tan 20^{\\circ}$.",
          "worked": "$$\\begin{align*}\\frac{\\sin 20^{\\circ}}{\\cos 20^{\\circ}}&=0.363970\\ldots\\\\\\frac{\\sin 20^{\\circ}}{\\cos 20^{\\circ}}&\\approx0.36\\end{align*}$$\n$\\tan 20^{\\circ}=0.363970\\ldots$, so the two values are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q11-symbolic",
        "type": "group",
        "label": "",
        "prompt": "For this triangle with side lengths $a$, $b$ and $c$, find an expression for:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [
          {
            "id": "p14-q11-symbolic-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 14 p14-q11-symbolic-diagram\"}\n\\begin{tikzpicture}[line join=round,line cap=round,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (0,0);\n\\coordinate (R) at (3,0);\n\\coordinate (T) at (3,2.8);\n\\draw[black,line width=0.8pt] (L)--(R)--(T)--cycle;\n\\draw[black,line width=0.4pt] ($(R)!0.12!(L)$)--($(R)!0.12!(L)+(R)!0.128571!(T)-(R)$)--($(R)!0.128571!(T)$);\n\\node[below] at ($(L)!0.5!(R)$) {$a$};\n\\node[right] at ($(R)!0.5!(T)$) {$b$};\n\\node[above left] at ($(L)!0.5!(T)$) {$c$};\n\\pic[draw=black,line width=0.4pt,angle radius=6mm] {angle=R--L--T};\n\\node at ($(L)+(21.5:0.85)$) {$\\theta$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 38,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 14,
              "sourceRegion": "Lower-right triangle beside question 11 symbolic responses",
              "description": "Unshaded right triangle with horizontal base a, vertical right side b, rising hypotenuse c, theta at the lower-left vertex and a right-angle marker at the lower-right vertex. Drawing coordinates express topology only; no numerical dimensions are supplied.",
              "mathematics": "Relative to theta, opposite = b, adjacent = a and hypotenuse = c. The acute angle sector runs counterclockwise from the base towards the hypotenuse.",
              "answerVisibility": "All side labels and angle marks are permanent student-visible givens."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [
          {
            "id": "p14-q11-symbolic-a",
            "type": "part",
            "label": "b",
            "prompt": "$\\sin\\theta$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{b}{c}$",
              "worked": "$$\\begin{align*}\\sin\\theta&=\\frac{\\text{opposite}}{\\text{hypotenuse}}\\\\\\sin\\theta&=\\frac{b}{c}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p14-q11-symbolic-b",
            "type": "part",
            "label": "c",
            "prompt": "$\\cos\\theta$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{a}{c}$",
              "worked": "$$\\begin{align*}\\cos\\theta&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos\\theta&=\\frac{a}{c}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p14-q11-symbolic-c",
            "type": "part",
            "label": "d",
            "prompt": "$\\tan\\theta$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{b}{a}$",
              "worked": "$$\\begin{align*}\\tan\\theta&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan\\theta&=\\frac{b}{a}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p14-q11-symbolic-d",
            "type": "part",
            "label": "e",
            "prompt": "$\\dfrac{\\sin\\theta}{\\cos\\theta}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{b}{a}$",
              "worked": "$$\\begin{align*}\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{\\left(\\frac{b}{c}\\right)}{\\left(\\frac{a}{c}\\right)}\\\\\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{b}{c}\\div\\frac{a}{c}\\\\\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{b}{c}\\times\\frac{c}{a}\\\\\\frac{\\sin\\theta}{\\cos\\theta}&=\\frac{b}{a}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          }
        ],
        "diagramPlacement": "right-of-prompt"
      }
    ]
  },
