  "content": {
    "id": "v2-x-topic-4-practice-slot-5-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Ravi is simplifying $0^{8}$. He says the answer is 1 because any base to the power of 0 is 1.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-x-topic-4-practice-slot-5-upper-slot-5-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why he is incorrect and state the correct answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The power is 8, not 0. The base is 0, so multiplying 0 by itself gives 0.\n\n$0^{8}=0$",
          "worked": "The index law of zero applies when the power is 0. Here the base is 0 and the power is 8, so $0^{8}$ is eight zeros multiplied together, which is 0.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-x-topic-4-practice-slot-5-upper-slot-5-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $0^{6}+6^{0}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1",
          "worked": "$$\\begin{align*}0^{6}+6^{0}&=0+1 \\\\ &=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-x-topic-4-practice-slot-5-upper-slot-5-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Simplify $\\left( 0^{3}+5 \\right)^{0}-0^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1",
          "worked": "$$\\begin{align*}\\left( 0^{3}+5 \\right)^{0}-0^{3}&=(0+5)^{0}-0 \\\\ &=5^{0}-0 \\\\ &=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
