  "content": {
    "id": "p33-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A line passes through the point $(4,12)$ and has gradient $2$. Find where the line crosses the $x$- and $y$-axes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x$-axis: $(-2,0)$; $y$-axis: $(0,4)$.",
      "worked": "At the $x$-axis, let the crossing be $(a,0)$. Using the gradient,\n$$\\begin{align*}\\frac{12-0}{4-a}&=2\\\\12&=2(4-a)\\\\12&=8-2a\\\\a&=-2\\end{align*}$$\nAt the $y$-axis, let the crossing be $(0,b)$.\n$$\\begin{align*}\\frac{12-b}{4-0}&=2\\\\12-b&=8\\\\b&=4\\end{align*}$$\nThe line crosses the $x$-axis at $(-2,0)$ and the $y$-axis at $(0,4)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
