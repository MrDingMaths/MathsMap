  "content": {
    "id": "p20-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The weight of a bundle of A4 paper ($W$ kg) varies directly with the number of sheets ($N$) of A4 paper that the bundle contains.\n\nThis relationship is modelled by the formula $W = kN$, where $k$ is a constant.\n\nThe weight of a bundle containing 500 sheets of A4 paper is 2.5 kilograms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q7-show",
        "type": "part",
        "label": "a",
        "prompt": "Show that $k$ is 0.005.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 0.005$ kg per sheet.",
          "worked": "$$\\begin{align*}W &= kN\\\\2.5 &= k\\times500\\\\k &= \\frac{2.5}{500}\\\\k &= 0.005\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q7-calculate",
        "type": "part",
        "label": "b",
        "prompt": "A bundle of A4 paper has a weight of 1.2 kilograms.\n\nCalculate the number of sheets of A4 paper in the bundle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "240 sheets",
          "worked": "$$\\begin{align*}W &= 0.005N\\\\1.2 &= 0.005N\\\\N &= \\frac{1.2}{0.005}\\\\N &= 240\\end{align*}$$\nThe bundle contains 240 sheets.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
