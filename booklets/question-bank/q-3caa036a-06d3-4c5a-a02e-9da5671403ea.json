  "content": {
    "id": "p78-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p78-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the prime factorisation of 270.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$270 = 2 \\times 3^3 \\times 5$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p78-q23-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}270 &= 27\\times10\\\\270 &= 3\\times3\\times3\\times2\\times5\\\\270 &= 2\\times3^3\\times5\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p78-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the least positive integer $n$ for which $270n$ is a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n = 30$. Multiply by $2\\times3\\times5$ to make every prime exponent even.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p78-q23-b-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "A perfect square has even prime exponents. The least multiplier supplies one extra factor of each of 2, 3 and 5.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p78-q23-b-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}n &= 2\\times3\\times5\\\\n &= 30\\\\270\\times30 &= 2^2\\times3^4\\times5^2\\\\270\\times30 &= 90^2\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p78-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the least positive integer $n$ for which $\\dfrac{270}{n}$ is a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n = 30$. Divide out $2\\times3\\times5$, leaving $3^2$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p78-q23-c-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide out one factor of each prime with an odd exponent. This is the least divisor leaving all prime exponents even.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p78-q23-c-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}n &= 2\\times3\\times5\\\\n &= 30\\\\\\tfrac{270}{30} &= 3^2\\\\\\tfrac{270}{30} &= 9\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p78-q23-c-check",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Hence the quotient is a perfect square.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
