  "content": {
    "id": "p16-q1",
    "type": "question",
    "label": "1",
    "prompt": "$y = kx$ and $y = 24$ when $x = 8$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "The value of $k$ and write the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 3$, $y = 3x$",
          "worked": "$$\\begin{align*}y &= kx\\\\24 &= k(8)\\\\k &= \\frac{24}{8}\\\\k &= 3\\end{align*}$$\nThe equation is $y = 3x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$ when $x = 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 12$",
          "worked": "Using $y = 3x$ from part a:\n$$\\begin{align*}y &= 3(4)\\\\y &= 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$ when $y = 15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 5$",
          "worked": "Using $y = 3x$ from part a:\n$$\\begin{align*}15 &= 3x\\\\x &= \\frac{15}{3}\\\\x &= 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
