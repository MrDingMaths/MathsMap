        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2a^2}{3b}\\times\\dfrac{9b}{4a}\\div\\dfrac{3}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2$",
          "worked": "$$\\begin{align*}\\frac{2a^2}{3b}\\times\\frac{9b}{4a}\\div\\frac{3}{2a}&=\\frac{2a^2}{3b}\\times\\frac{9b}{4a}\\times\\frac{2a}{3}\\\\&=\\frac{36a^3b}{36ab}\\\\&=a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-34e2a-p18-practice-j15-213223-j15-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5x^3}{2y}\\div\\dfrac{10x}{y^2}\\times\\dfrac{6}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3y}{2}$",
          "worked": "$$\\begin{align*}\\frac{5x^3}{2y}\\div\\frac{10x}{y^2}\\times\\frac{6}{x^2}&=\\frac{5x^3}{2y}\\times\\frac{y^2}{10x}\\times\\frac{6}{x^2}\\\\&=\\frac{30x^3y^2}{20x^3y}\\\\&=\\frac{30y}{20}\\\\&=\\frac{3y}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-34e2a-p18-practice-j15-213223-j15-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3m^2}{8n}\\times\\dfrac{4n^3}{9m}\\div\\dfrac{m^2}{6n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n^3}{m}$",
          "worked": "$$\\begin{align*}\\frac{3m^2}{8n}\\times\\frac{4n^3}{9m}\\div\\frac{m^2}{6n}&=\\frac{3m^2}{8n}\\times\\frac{4n^3}{9m}\\times\\frac{6n}{m^2}\\\\&=\\frac{72m^2n^4}{72m^3n}\\\\&=\\frac{n^3}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
