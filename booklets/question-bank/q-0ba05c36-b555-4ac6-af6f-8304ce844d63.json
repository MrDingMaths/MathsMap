  "content": {
    "id": "p22-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Shares in Value Radios have been falling by 18% per year for the last five years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the present worth of a parcel of shares with an original worth five years ago of the following amounts. Give your answers correct to the nearest cent.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\$1000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$370.74$",
              "worked": "Each year, $100\\%-18\\%=82\\%$ of the previous value remains.\n\n$$\\begin{align*}\\text{Present worth}&=1000\\times(0.82)^5\\\\\\text{Present worth}&=370.7398432\\\\\\text{Present worth}&\\approx\\$370.74\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$24\\,000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$8897.76$",
              "worked": "The annual multiplier is $1-0.18=0.82$.\n\n$$\\begin{align*}\\text{Present worth}&=24\\,000\\times(0.82)^5\\\\\\text{Present worth}&=8897.7562368\\\\\\text{Present worth}&\\approx\\$8897.76\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q8-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\$11\\,328\\,512$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$4\\,199\\,930.76$",
              "worked": "The annual multiplier is $1-0.18=0.82$.\n\n$$\\begin{align*}\\text{Present worth}&=11\\,328\\,512\\times(0.82)^5\\\\\\text{Present worth}&=4\\,199\\,930.7625693184\\\\\\text{Present worth}&\\approx\\$4\\,199\\,930.76\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p22-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "By what percentage has the value fallen over the five-year period? Give your answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$62.9\\%$",
          "worked": "$$\\begin{align*}\\text{Remaining proportion}&=(0.82)^5\\\\\\text{Remaining proportion}&=0.3707398432\\\\\\text{Percentage decrease}&=(1-0.3707398432)\\times100\\%\\\\\\text{Percentage decrease}&=62.92601568\\%\\\\\\text{Percentage decrease}&\\approx62.9\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
