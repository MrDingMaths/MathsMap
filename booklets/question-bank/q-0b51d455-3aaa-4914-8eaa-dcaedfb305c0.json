  "content": {
    "id": "p20-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Consider $\\triangle ABC$. Suppose $D$ is on $BC$ such that $AD$ bisects $\\angle A$. Given $BD=2$, $CD=5$ and $AB+AC=8$, find $AB$ and $AC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AB=\\dfrac{16}{7}$, $AC=\\dfrac{40}{7}$.",
      "worked": "By the Angle Bisector Theorem,\n$$\\frac{AB}{AC}=\\frac{BD}{CD}=\\frac25.$$\nLet $AB=2k$ and $AC=5k$.\n$$\\begin{align*}2k+5k&=8,\\\\k&=\\frac87,\\\\AB&=2\\times\\frac87=\\frac{16}{7},\\\\AC&=5\\times\\frac87=\\frac{40}{7}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
