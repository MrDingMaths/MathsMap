        "answer": {
          "short": "$38$",
          "worked": "$$\\begin{align*}(2x)^2+2&=(2\\times3)^2+2\\\\(2x)^2+2&=6^2+2\\\\(2x)^2+2&=36+2\\\\(2x)^2+2&=38\\end{align*}$$",
          "solutionDiagrams": []
