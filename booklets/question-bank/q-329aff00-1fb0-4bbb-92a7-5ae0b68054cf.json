  "content": {
    "id": "p33-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A swimming pool is in the shape of a rectangular prism. The pool is 12 metres long, 4 metres wide and 1.5 metres deep. The pool is to be lined with tiles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q20-a",
        "type": "group",
        "label": "a",
        "prompt": "How many tiles are needed to line the pool if each tile is:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q20-a-i",
            "type": "part",
            "label": "i",
            "prompt": "100 mm ×100 mm?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "9600 tiles.",
              "worked": "Floor and four walls have total area $12(4)+2(12)(1.5)+2(4)(1.5)=96\\text{ m}^2$. Each tile has area $0.1\\times0.1=0.01\\text{ m}^2$, so the required number is $\\frac{96}{0.01}=9600$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p33-q20-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "200 mm ×200 mm?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "2400 tiles.",
              "worked": "Floor and four walls have total area $12(4)+2(12)(1.5)+2(4)(1.5)=96\\text{ m}^2$. Each tile has area $0.2\\times0.2=0.04\\text{ m}^2$, so the required number is $\\frac{96}{0.04}=2400$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p33-q20-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "200 mm ×100 mm?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "4800 tiles.",
              "worked": "Floor and four walls have total area $12(4)+2(12)(1.5)+2(4)(1.5)=96\\text{ m}^2$. Each tile has area $0.2\\times0.1=0.02\\text{ m}^2$, so the required number is $\\frac{96}{0.02}=4800$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      },
      {
        "id": "p33-q20-b",
        "type": "group",
        "label": "b",
        "prompt": "A path 1 metre wide is to be put around the pool. How many pavers are needed to make the path if each of the pavers is of size:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p33-q20-b-i",
            "type": "part",
            "label": "iv",
            "prompt": "1 m ×1 m?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "36 pavers.",
              "worked": "The outer dimensions are 14 m by 6 m, so the path area is $14(6)-12(4)=36\\text{ m}^2$. Each paver has area $1\\text{ m}^2$ and the required number is $\\frac{36}{1}=36$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p33-q20-b-ii",
            "type": "part",
            "label": "v",
            "prompt": "500 mm ×500 mm?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "144 pavers.",
              "worked": "The outer dimensions are 14 m by 6 m, so the path area is $14(6)-12(4)=36\\text{ m}^2$. Each paver has area $0.5^2=0.25\\text{ m}^2$ and the required number is $\\frac{36}{0.25}=144$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p33-q20-b-iii",
            "type": "part",
            "label": "vi",
            "prompt": "250 mm ×250 mm?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "576 pavers.",
              "worked": "The outer dimensions are 14 m by 6 m, so the path area is $14(6)-12(4)=36\\text{ m}^2$. Each paver has area $0.25^2=0.0625\\text{ m}^2$ and the required number is $\\frac{36}{0.0625}=576$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      },
      {
        "id": "p33-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "When the pool is completed, it is filled at 400 litres/hour. How long will it take to fill the pool to 10 cm below the top?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "168 hours.",
          "worked": "Water depth $=1.5-0.1=1.4$ m. Volume $=12(4)(1.4)=67.2\\text{ m}^3=67\\,200\\text{ L}$. Time $=67\\,\\frac{200}{400}=168$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
