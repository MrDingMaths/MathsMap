  "content": {
    "id": "p17-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A particle is projected from the origin. Its initial velocity vector is $8\\mathbf{i}+6\\mathbf{j}$ m/s. Take $g=10\\text{ m/s}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Express its velocity at time $t$ in the form $\\mathbf{v}=\\dot{x}\\mathbf{i}+\\dot{y}\\mathbf{j}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbf{v}(t)=8\\mathbf{i}+(6-10t)\\mathbf{j}$ m/s.",
          "worked": "$$\\begin{aligned}\\ddot{x}&=0,&\\ddot{y}&=-10\\\\\\dot{x}&=8,&\\dot{y}&=6-10t\\end{aligned}$$\nThus $\\mathbf{v}(t)=8\\mathbf{i}+(6-10t)\\mathbf{j}$ m/s.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Express its displacement at time $t$ in the form $\\mathbf{r}=x\\mathbf{i}+y\\mathbf{j}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbf{r}(t)=8t\\mathbf{i}+(6t-5t^2)\\mathbf{j}$ m.",
          "worked": "Integrating the velocity components gives\n$$\\begin{aligned}x&=8t+C_1\\\\y&=6t-5t^2+C_2.\\end{aligned}$$\nSince the particle starts at the origin, $C_1=C_2=0$. Hence $\\mathbf{r}(t)=8t\\mathbf{i}+(6t-5t^2)\\mathbf{j}$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p17-q3-c",
        "type": "group",
        "label": "c",
        "prompt": "Find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q3-c-i",
            "type": "part",
            "label": "i",
            "prompt": "the initial speed,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10\\text{ m/s}$.",
              "worked": "$$\\begin{aligned}|\\mathbf{v}(0)|&=\\sqrt{8^2+6^2}\\\\&=\\sqrt{64+36}\\\\&=10\\text{ m/s}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p17-q3-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the position vector after 2 seconds,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16\\mathbf{i}-8\\mathbf{j}$ m.",
              "worked": "$$\\begin{aligned}\\mathbf{r}(2)&=8(2)\\mathbf{i}+\\bigl(6(2)-5(2)^2\\bigr)\\mathbf{j}\\\\&=16\\mathbf{i}+(12-20)\\mathbf{j}\\\\&=16\\mathbf{i}-8\\mathbf{j}\\text{ m}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p17-q3-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the position vector when it reaches its greatest height.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4.8\\mathbf{i}+1.8\\mathbf{j}$ m.",
              "worked": "At greatest height, $\\dot{y}=0$.\n$$\\begin{aligned}0&=6-10t\\\\t&=0.6\\text{ s}\\\\\\mathbf{r}(0.6)&=8(0.6)\\mathbf{i}+\\bigl(6(0.6)-5(0.6)^2\\bigr)\\mathbf{j}\\\\&=4.8\\mathbf{i}+(3.6-1.8)\\mathbf{j}\\\\&=4.8\\mathbf{i}+1.8\\mathbf{j}\\text{ m}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      }
    ]
  },
