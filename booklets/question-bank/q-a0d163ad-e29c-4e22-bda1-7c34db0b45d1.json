  "content": {
    "id": "p30-q15-23-root",
    "type": "question",
    "label": null,
    "prompt": "Prove the following identities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q15",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos^2\\theta=\\frac{1+\\cos2\\theta}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^2\\theta=\\frac{1+\\cos2\\theta}{2}$.\n\nRearrange $\\cos2\\theta=2\\cos^2\\theta-1$.",
          "worked": "$$\\begin{align*}\\cos2\\theta&=2\\cos^2\\theta-1\\\\1+\\cos2\\theta&=2\\cos^2\\theta\\\\\\cos^2\\theta&=\\frac{1+\\cos2\\theta}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q16",
        "type": "part",
        "label": "b",
        "prompt": "$(\\cos\\theta-\\sin\\theta)^2=1-\\sin2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\cos\\theta-\\sin\\theta)^2=1-\\sin2\\theta$.\n\nExpand the square and use the Pythagorean and sine double-angle identities.",
          "worked": "$$\\begin{align*}(\\cos\\theta-\\sin\\theta)^2&=\\cos^2\\theta-2\\sin\\theta\\cos\\theta+\\sin^2\\theta\\\\(\\cos\\theta-\\sin\\theta)^2&=1-2\\sin\\theta\\cos\\theta\\\\(\\cos\\theta-\\sin\\theta)^2&=1-\\sin2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q17",
        "type": "part",
        "label": "c",
        "prompt": "$\\cot\\theta-\\tan\\theta=2\\cot2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta-\\tan\\theta=2\\cot2\\theta$.\n\nWrite in sine and cosine, combine fractions, then use both double-angle identities.",
          "worked": "$$\\begin{align*}\\cot\\theta-\\tan\\theta&=\\frac{\\cos\\theta}{\\sin\\theta}-\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\cot\\theta-\\tan\\theta&=\\frac{\\cos^2\\theta-\\sin^2\\theta}{\\sin\\theta\\cos\\theta}\\\\\\cot\\theta-\\tan\\theta&=\\frac{2\\cos2\\theta}{\\sin2\\theta}\\\\\\cot\\theta-\\tan\\theta&=2\\cot2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p30-q18",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan\\theta+\\cot\\theta=2\\operatorname{cosec}2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta+\\cot\\theta=2\\operatorname{cosec}2\\theta$.\n\nCombine the sine/cosine fractions and use $\\sin2\\theta=2\\sin\\theta\\cos\\theta$.",
          "worked": "$$\\begin{align*}\\tan\\theta+\\cot\\theta&=\\frac{\\sin\\theta}{\\cos\\theta}+\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\tan\\theta+\\cot\\theta&=\\frac{\\sin^2\\theta+\\cos^2\\theta}{\\sin\\theta\\cos\\theta}\\\\\\tan\\theta+\\cot\\theta&=\\frac{1}{\\sin\\theta\\cos\\theta}\\\\\\tan\\theta+\\cot\\theta&=\\frac{2}{\\sin2\\theta}\\\\\\tan\\theta+\\cot\\theta&=2\\operatorname{cosec}2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q19",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1+\\sin2\\theta+\\cos2\\theta}{1+\\sin2\\theta-\\cos2\\theta}=\\cot\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1+\\sin2\\theta+\\cos2\\theta}{1+\\sin2\\theta-\\cos2\\theta}=\\cot\\theta$.\n\nUse different cosine expansions in the numerator and denominator, then factorise and cancel.",
          "worked": "$$\\begin{align*}\\frac{1+\\sin2\\theta+\\cos2\\theta}{1+\\sin2\\theta-\\cos2\\theta}&=\\frac{1+2\\sin\\theta\\cos\\theta+(2\\cos^2\\theta-1)}{1+2\\sin\\theta\\cos\\theta-(1-2\\sin^2\\theta)}\\\\\\frac{1+\\sin2\\theta+\\cos2\\theta}{1+\\sin2\\theta-\\cos2\\theta}&=\\frac{2\\cos\\theta(\\sin\\theta+\\cos\\theta)}{2\\sin\\theta(\\sin\\theta+\\cos\\theta)}\\\\\\frac{1+\\sin2\\theta+\\cos2\\theta}{1+\\sin2\\theta-\\cos2\\theta}&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\frac{1+\\sin2\\theta+\\cos2\\theta}{1+\\sin2\\theta-\\cos2\\theta}&=\\cot\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q20",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\sin\\theta+\\sin2\\theta}{1+\\cos2\\theta+\\cos\\theta}=\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sin\\theta+\\sin2\\theta}{1+\\cos2\\theta+\\cos\\theta}=\\tan\\theta$.\n\nExpand the double angles, factorise and cancel the common factor.",
          "worked": "$$\\begin{align*}\\frac{\\sin\\theta+\\sin2\\theta}{1+\\cos2\\theta+\\cos\\theta}&=\\frac{\\sin\\theta+2\\sin\\theta\\cos\\theta}{1+(2\\cos^2\\theta-1)+\\cos\\theta}\\\\\\frac{\\sin\\theta+\\sin2\\theta}{1+\\cos2\\theta+\\cos\\theta}&=\\frac{\\sin\\theta(1+2\\cos\\theta)}{\\cos\\theta(1+2\\cos\\theta)}\\\\\\frac{\\sin\\theta+\\sin2\\theta}{1+\\cos2\\theta+\\cos\\theta}&=\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\frac{\\sin\\theta+\\sin2\\theta}{1+\\cos2\\theta+\\cos\\theta}&=\\tan\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q21",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1-\\cos\\theta}{\\sin\\theta}=\\tan\\frac{\\theta}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1-\\cos\\theta}{\\sin\\theta}=\\tan\\frac{\\theta}{2}$.\n\nApply the double-angle formulas with angle $\\frac{\\theta}{2}$ and cancel.",
          "worked": "$$\\begin{align*}\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{1-(1-2\\sin^2\\frac{\\theta}{2})}{2\\sin\\frac{\\theta}{2}\\cos\\frac{\\theta}{2}}\\\\\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\frac{2\\sin^2\\frac{\\theta}{2}}{2\\sin\\frac{\\theta}{2}\\cos\\frac{\\theta}{2}}\\\\\\frac{1-\\cos\\theta}{\\sin\\theta}&=\\tan\\frac{\\theta}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p30-q22",
        "type": "part",
        "label": "h",
        "prompt": "$\\tan2\\theta\\cot\\theta-1=\\sec2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan2\\theta\\cot\\theta-1=\\sec2\\theta$.\n\nWrite tangent and cotangent in sine/cosine form and simplify to $\\frac{1}{\\cos2\\theta}$.",
          "worked": "$$\\begin{align*}\\tan2\\theta\\cot\\theta-1&=\\frac{2\\sin\\theta\\cos\\theta}{\\cos^2\\theta-\\sin^2\\theta}\\frac{\\cos\\theta}{\\sin\\theta}-1\\\\\\tan2\\theta\\cot\\theta-1&=\\frac{2\\cos^2\\theta-(\\cos^2\\theta-\\sin^2\\theta)}{\\cos^2\\theta-\\sin^2\\theta}\\\\\\tan2\\theta\\cot\\theta-1&=\\frac{\\cos^2\\theta+\\sin^2\\theta}{\\cos^2\\theta-\\sin^2\\theta}\\\\\\tan2\\theta\\cot\\theta-1&=\\frac{1}{\\cos2\\theta}\\\\\\tan2\\theta\\cot\\theta-1&=\\sec2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p30-q23",
        "type": "part",
        "label": "i",
        "prompt": "$\\cot\\theta-\\cot2\\theta=\\operatorname{cosec}2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta-\\cot2\\theta=\\operatorname{cosec}2\\theta$.\n\nUse the reciprocal tangent double-angle formula, combine fractions and convert to sine and cosine.",
          "worked": "$$\\begin{align*}\\cot\\theta-\\cot2\\theta&=\\frac{1}{\\tan\\theta}-\\frac{1-\\tan^2\\theta}{2\\tan\\theta}\\\\\\cot\\theta-\\cot2\\theta&=\\frac{1+\\tan^2\\theta}{2\\tan\\theta}\\\\\\cot\\theta-\\cot2\\theta&=\\frac{\\cos^2\\theta+\\sin^2\\theta}{2\\sin\\theta\\cos\\theta}\\\\\\cot\\theta-\\cot2\\theta&=\\frac{1}{2\\sin\\theta\\cos\\theta}\\\\\\cot\\theta-\\cot2\\theta&=\\frac{1}{\\sin2\\theta}\\\\\\cot\\theta-\\cot2\\theta&=\\operatorname{cosec}2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
