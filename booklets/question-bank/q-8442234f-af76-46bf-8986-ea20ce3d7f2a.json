        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cocoa: $7\\text{ g}$; sugar: $14.5\\text{ g}$; hazelnut paste: $0.3\\text{ g}$; milk powder: $8.2\\text{ g}$. Divide each original mass by $4$.",
          "worked": "$$\\begin{align*}\\text{Number of 30 g bars}&=120\\div30\\\\\\text{Number of 30 g bars}&=4\\\\\\text{Cocoa per bar}&=28\\div4=7\\text{ g}\\\\\\text{Sugar per bar}&=58\\div4=14.5\\text{ g}\\\\\\text{Hazelnut paste per bar}&=1.2\\div4=0.3\\text{ g}\\\\\\text{Milk powder per bar}&=32.8\\div4=8.2\\text{ g}\\end{align*}$$",
