        "type": "part",
        "label": "a",
        "prompt": "How many millimetres in a metre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1000\\text{ mm}$",
          "worked": "$$1\\text{ m}=1000\\text{ mm}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How many millimetres in a kilometre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,000\\,000\\text{ mm}$",
          "worked": "$$\\begin{align*}1\\text{ km}&=1000\\text{ m}\\\\1\\text{ km}&=(1000\\times1000)\\text{ mm}\\\\1\\text{ km}&=1\\,000\\,000\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Convert $36.4\\text{ km}$ to millimetres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\,400\\,000\\text{ mm}$",
          "worked": "$$\\begin{align*}36.4\\text{ km}&=(36.4\\times1\\,000\\,000)\\text{ mm}\\\\36.4\\text{ km}&=36\\,400\\,000\\text{ mm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Convert $276\\text{ mm}$ to kilometres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.000276\\text{ km}$",
          "worked": "$$\\begin{align*}276\\text{ mm}&=(276\\div1\\,000\\,000)\\text{ km}\\\\276\\text{ mm}&=0.000276\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "How many square millimetres in a square kilometre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,000\\,000\\,000\\,000\\text{ mm}^2$\n\nSquare the length conversion factor.",
          "worked": "A square kilometre is a square with sides of $1\\text{ km}=1\\,000\\,000\\text{ mm}$.\n\n$$\\begin{align*}1\\text{ km}^2&=(1\\,000\\,000\\times1\\,000\\,000)\\text{ mm}^2\\\\1\\text{ km}^2&=1\\,000\\,000\\,000\\,000\\text{ mm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "Convert $13.06$ square kilometres to square millimetres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13\\,060\\,000\\,000\\,000\\text{ mm}^2$\n\nMultiply by the squared length conversion factor, $1\\,000\\,000\\,000\\,000$.",
          "worked": "$1\\text{ km}^2=1\\,000\\,000\\,000\\,000\\text{ mm}^2$.\n\n$$\\begin{align*}13.06\\text{ km}^2&=(13.06\\times1\\,000\\,000\\,000\\,000)\\text{ mm}^2\\\\13.06\\text{ km}^2&=13\\,060\\,000\\,000\\,000\\text{ mm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p16-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "Convert $4567.8$ square millimetres to square kilometres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.0000000045678\\text{ km}^2$\n\nDivide by the squared length conversion factor, $1\\,000\\,000\\,000\\,000$.",
