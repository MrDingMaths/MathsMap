        "type": "part",
        "label": "a",
        "prompt": "What is the area inside a semicircle if the radius of the semicircle is $35\\text{ cm}$? Give your answer in terms of $\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$612\\frac12\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac12\\pi r^2\\\\A&=\\frac12\\pi\\times35^2\\\\A&=\\frac{1225\\pi}{2}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
