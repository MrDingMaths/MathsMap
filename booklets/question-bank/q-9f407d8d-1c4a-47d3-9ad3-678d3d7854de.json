    "label": "4",
    "prompt": "Is $270$ a term of the sequence $3,11,19,\\ldots$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No; the required term position is not an integer.",
      "worked": "$a=3$, $d=8$.\n$$a_n=a+(n-1)d$$\nLet $a_n=270$.\n$$\\begin{align*}270&=3+(n-1)8\\\\267&=8(n-1)\\\\n-1&=33.375\\\\n&=34.375\\end{align*}$$\nSince $n$ is not an integer, $270$ is not a term.",
      "solutionDiagrams": []
    },
