        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{5}}{10}$",
          "worked": "$$\\begin{align*}\\frac{1}{2\\sqrt{5}}&=\\frac{1}{2\\sqrt{5}}\\times\\frac{\\sqrt{5}}{\\sqrt{5}}\\\\\\frac{1}{2\\sqrt{5}}&=\\frac{\\sqrt{5}}{2\\times5}\\\\\\frac{1}{2\\sqrt{5}}&=\\frac{\\sqrt{5}}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{3\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
