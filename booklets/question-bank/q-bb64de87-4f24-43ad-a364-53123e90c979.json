  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Given the formula $t=a+(n-1)d$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Rearrange the formula to make $a$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=t-(n-1)d$",
          "worked": "$$\\begin{align*}t&=a+(n-1)d\\\\t-(n-1)d&=a\\\\a&=t-(n-1)d\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the value of $a$ when:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$t=11$, $n=4$ and $d=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=2$",
              "worked": "$$\\begin{align*}a&=11-(4-1)\\times3\\\\a&=11-9\\\\a&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p12-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$t=8$, $n=5$ and $d=-3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=20$",
              "worked": "$$\\begin{align*}a&=8-(5-1)\\times(-3)\\\\a&=8-(-12)\\\\a&=20\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Rearrange the formula to make $d$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=\\dfrac{t-a}{n-1}$",
          "worked": "$$\\begin{align*}t&=a+(n-1)d\\\\t-a&=(n-1)d\\\\d&=\\frac{t-a}{n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p12-q4-d",
        "type": "group",
        "label": "d",
        "prompt": "Find the value of $d$ when:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q4-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$t=48$, $a=3$ and $n=16$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$d=3$",
              "worked": "$$\\begin{align*}d&=\\frac{48-3}{16-1}\\\\d&=\\frac{45}{15}\\\\d&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p12-q4-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$t=120$, $a=-30$ and $n=101$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$d=1.5$",
              "worked": "$$\\begin{align*}d&=\\frac{120-(-30)}{101-1}\\\\d&=\\frac{150}{100}\\\\d&=1.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          }
        ]
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Rearrange the formula to make $n$ the subject and find the value of $n$ when $t=150$, $a=5$ and $d=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{t-a}{d}+1$; $n=30$.",
          "worked": "$$\\begin{align*}t&=a+(n-1)d\\\\t-a&=(n-1)d\\\\\\frac{t-a}{d}&=n-1\\\\n&=\\frac{t-a}{d}+1\\end{align*}$$\nWhen $t=150$, $a=5$ and $d=5$:\n$$\\begin{align*}n&=\\frac{150-5}{5}+1\\\\n&=29+1\\\\n&=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      }
    ]
