  "content": {
    "id": "p19-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "One number is twice another number. The sum of their reciprocals is $\\frac{3}{10}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation describing the situation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2x}+\\frac{1}{x}=\\frac{3}{10}$, where the numbers are $x$ and $2x$.",
          "worked": "Let the smaller number be $x$, so the other number is $2x$.\n$$\\frac{1}{2x}+\\frac{1}{x}=\\frac{3}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation to find the two numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The two numbers are $5$ and $10$.",
          "worked": "$$\\begin{align*}\\frac{1}{2x}+\\frac{2}{2x}&=\\frac{3}{10}\\\\\\frac{3}{2x}&=\\frac{3}{10}\\\\3&=\\frac{3x}{5}\\\\15&=3x\\\\x&=5\\end{align*}$$\nThe two numbers are $5$ and $10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
