  "content": {
    "id": "p51-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A scaled length of 5.5 cm is equal to 44 km in real life.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How many kilometres does a scaled length of 3 cm equal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24\\text{ km}$",
          "worked": "$$\\begin{aligned}\\text{Actual distance for }1\\text{ cm}&=44\\div5.5=8\\text{ km}\\\\\\text{Actual distance for }3\\text{ cm}&=3\\times8=24\\text{ km}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p51-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "How many kilometres does a scaled length of 20 cm equal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$160\\text{ km}$",
          "worked": "$$\\begin{aligned}\\text{Actual distance for }1\\text{ cm}&=44\\div5.5=8\\text{ km}\\\\\\text{Actual distance for }20\\text{ cm}&=20\\times8=160\\text{ km}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p51-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "How many centimetres does an actual distance of 100 km equal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.5\\text{ cm}$",
          "worked": "$$\\begin{aligned}\\text{Actual distance for }1\\text{ cm}&=44\\div5.5=8\\text{ km}\\\\\\text{Scaled length for }100\\text{ km}&=100\\div8=12.5\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
