                  {
                    "type": "math",
                    "latex": "\\begin{align*}3+\\frac52\\ln 1+C&=0\\\\C&=-3\\\\f(x)&=3x+\\frac52\\ln|2x-1|-3\\\\f(2)&=6+\\frac52\\ln 3-3\\\\f(2)&=3+\\frac52\\ln 3\\end{align*}",
