    "children": [
      {
        "id": "p44-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6,0)$",
          "worked": "$$\\begin{align*}6x^2-x^3&=0\\\\x^2(6-x)&=0\\\\x&=0\\text{ or }6\\end{align*}$$\nThe curve touches the axis at the origin and crosses it at $A$, so $A=(6,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p44-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,32)$",
          "worked": "$$\\begin{align*}y'&=12x-3x^2\\\\3x(4-x)&=0\\\\x&=0\\text{ or }4\\\\y(4)&=6(4)^2-(4)^3\\\\y(4)&=32\\end{align*}$$\nThe maximum shown is at $x=4$, so $B=(4,32)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
