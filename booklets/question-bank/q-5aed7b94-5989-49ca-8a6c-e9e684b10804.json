    "type": "question",
    "label": "2",
    "prompt": "The diagram to the right shows a sketch of $y=6x^2-x^3$. The curve cuts the $x$-axis at $A$, has a maximum turning point at $B$ and a point of inflection at $C$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p44-q2-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 44 question 2\"}\n\\begin{tikzpicture}[x=0.65cm,y=0.065cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[->,line width=0.5pt] (-2.5,0)--(8,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,-16)--(0,49) node[right] {$y$};\n\\draw[<->,line width=0.8pt,samples=140,domain=-2.3:6.55] plot (\\x,{6*\\x*\\x-\\x*\\x*\\x});\n\\fill (6,0) circle[radius=1.5pt] node[above right] {$A$};\n\\fill (4,32) circle[radius=1.5pt] node[above] {$B$};\n\\fill (2,16) circle[radius=1.5pt] node[above left] {$C$};\n\\node[anchor=west] at (2.5,44) {$y=6x^2-x^3$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
