  "content": {
    "id": "p18-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "For the formula $I=\\frac{180n-360}{n}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "find $I$ when $n=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=120$",
          "worked": "$$\\begin{align*}I&=\\frac{180\\times6-360}{6}\\\\I&=\\frac{720}{6}\\\\I&=120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "make $n$ the subject of the formula and find $n$ when $I=108$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{360}{180-I}$; when $I=108$, $n=5$.",
          "worked": "$$\\begin{align*}In&=180n-360\\\\180n-In&=360\\\\n(180-I)&=360\\\\n&=\\frac{360}{180-I}\\end{align*}$$When $I=108$,$$\\begin{align*}n&=\\frac{360}{180-108}\\\\n&=\\frac{360}{72}\\\\n&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      }
    ]
  },
