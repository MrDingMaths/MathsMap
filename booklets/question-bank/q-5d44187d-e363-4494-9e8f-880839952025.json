  "content": {
    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If $x=\\dfrac{\\sqrt{5}+1}{2}$, show that $1+\\dfrac{1}{x}=x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1+\\dfrac{1}{x}=\\dfrac{\\sqrt{5}+1}{2}=x$.\n\nRationalise the reciprocal using the conjugate $\\sqrt{5}-1$.",
      "worked": "$$\\begin{align*}1+\\frac{1}{x}&=1+\\frac{2}{\\sqrt{5}+1}\\\\1+\\frac{1}{x}&=1+\\frac{2}{\\sqrt{5}+1}\\times\\frac{\\sqrt{5}-1}{\\sqrt{5}-1}\\\\1+\\frac{1}{x}&=1+\\frac{2(\\sqrt{5}-1)}{5-1}\\\\1+\\frac{1}{x}&=1+\\frac{\\sqrt{5}-1}{2}\\\\1+\\frac{1}{x}&=\\frac{\\sqrt{5}+1}{2}\\\\1+\\frac{1}{x}&=x\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 54
  },
