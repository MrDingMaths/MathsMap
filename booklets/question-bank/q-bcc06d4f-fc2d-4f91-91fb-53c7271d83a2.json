        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"regionBlue\",\"hex\":\"D4E8FF\",\"reason\":\"The two regions whose total area is requested.\"}],\"reference\":\"source page 41 p41-q18-diagram\"}\n\\begin{tikzpicture}[x=0.65cm,y=0.16cm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{regionBlue}{HTML}{D4E8FF}\n\\path[fill=regionBlue] (-3,0)--plot[domain=-3:0,samples=60] (\\x,{exp(\\x)-exp(-\\x)})--cycle;\n\\path[fill=regionBlue] (0,0)--plot[domain=0:3,samples=60] (\\x,{exp(\\x)-exp(-\\x)})--(3,0)--cycle;\n\\draw[line width=0.4pt] (-3,0)--(-3,{exp(-3)-exp(3)});\n\\draw[line width=0.4pt] (3,0)--(3,{exp(3)-exp(-3)});\n\\draw[->,line width=0.5pt] (-6,0)--(6.3,0) node[below left] {$x$};\n\\draw[->,line width=0.5pt] (0,-22)--(0,24) node[left] {$y$};\n\\draw[<->,line width=0.8pt] plot[domain=-3.12:3.12,samples=100] (\\x,{exp(\\x)-exp(-\\x)});\n\\node[above] at (-3,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\node[below] at (3,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
        "src": null,
