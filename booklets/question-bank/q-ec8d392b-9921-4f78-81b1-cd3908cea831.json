  "content": {
    "id": "p52-g88-91",
    "type": "question",
    "label": null,
    "prompt": "Use the discriminant to determine the number of distinct zeroes of the following quadratic functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-g88-91-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=5x^2+4x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real zeroes ($\\Delta=-4<0$).",
          "worked": "$$\\begin{align*}\\Delta &= 4^2-4(5)(1)\\\\\\Delta &= -4<0\\end{align*}$$\nThere are no real zeroes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-g88-91-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2-8x+16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One distinct real zero ($\\Delta=0$).",
          "worked": "$$\\begin{align*}\\Delta &= (-8)^2-4(1)(16)\\\\\\Delta &= 0\\end{align*}$$\nThere is one distinct real zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-g88-91-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=5x^2+9x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two distinct real zeroes ($\\Delta=41>0$).",
          "worked": "$$\\begin{align*}\\Delta &= 9^2-4(5)(2)\\\\\\Delta &= 41>0\\end{align*}$$\nThere are two distinct real zeroes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-g88-91-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=9x^2+6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One distinct real zero ($\\Delta=0$).",
          "worked": "$$\\begin{align*}\\Delta &= 6^2-4(9)(1)\\\\\\Delta &= 0\\end{align*}$$\nThere is one distinct real zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
