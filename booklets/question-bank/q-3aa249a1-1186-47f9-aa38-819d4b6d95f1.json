  "content": {
    "id": "p31-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Identify the LCM",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)$ and $(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+2)$",
          "worked": "The factors are distinct, so use each once.\n$$\\operatorname{LCM}=(x+1)(x+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+1)$ and $(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+3)$",
          "worked": "The factors are distinct, so use each once.\n$$\\operatorname{LCM}=(x+1)(x+3)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$2(x+1)$ and $(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+1)(x+2)$",
          "worked": "Use coefficient $2$ and each distinct algebraic factor once.\n$$\\operatorname{LCM}=2(x+1)(x+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$3(x+1)$ and $2(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(x+1)(x+2)$",
          "worked": "The LCM of $3$ and $2$ is $6$. Use each distinct algebraic factor once.\n$$\\operatorname{LCM}=6(x+1)(x+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+1)^2$ and $(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2(x+2)$",
          "worked": "Use the highest power of each factor: $(x+1)^2$ and $(x+2)$.\n$$\\operatorname{LCM}=(x+1)^2(x+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x+1)^2$ and $(x+1)(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2(x+2)$",
          "worked": "Use the highest power of each factor: $(x+1)^2$ and $(x+2)$.\n$$\\operatorname{LCM}=(x+1)^2(x+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(x+2)(x-3)$ and $(x-3)(x+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-3)(x+5)$",
          "worked": "The common factor $(x-3)$ is needed once. Include both remaining factors.\n$$\\operatorname{LCM}=(x+2)(x-3)(x+5)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$(x+2)(x-3)$ and $(x-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-3)^2$",
          "worked": "Use the highest power of each factor: $(x+2)$ and $(x-3)^2$.\n$$\\operatorname{LCM}=(x+2)(x-3)^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$(x-3)(x+1)$ and $(x-3)(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+1)(x+4)$",
          "worked": "The common factor $(x-3)$ is needed once. Include both remaining factors.\n$$\\operatorname{LCM}=(x-3)(x+1)(x+4)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p31-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$2(x+1)(x-4)$ and $3(x-4)(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(x+1)(x-4)(x+2)$",
          "worked": "The LCM of $2$ and $3$ is $6$. Use the common factor $(x-4)$ once and include both remaining factors.\n$$\\operatorname{LCM}=6(x+1)(x-4)(x+2)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p31-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^2-4$ and $x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-2)$",
          "worked": "$$\\begin{align*}x^2-4&=(x+2)(x-2)\\\\\\operatorname{LCM}&=(x+2)(x-2)\\end{align*}$$\nThe factor $(x+2)$ is already included.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$x^2-4$ and $x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-2)$",
          "worked": "$$\\begin{align*}x^2-4&=(x+2)(x-2)\\\\\\operatorname{LCM}&=(x+2)(x-2)\\end{align*}$$\nThe factor $(x-2)$ is already included.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p31-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$x^2-4$ and $x^2+4x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2(x-2)$",
          "worked": "$$\\begin{align*}x^2-4&=(x+2)(x-2)\\\\x^2+4x+4&=(x+2)^2\\\\\\operatorname{LCM}&=(x+2)^2(x-2)\\end{align*}$$\nUse the highest power of each factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$x^2+5x+6$ and $x^2+4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+2)(x+3)$",
          "worked": "$$\\begin{align*}x^2+5x+6&=(x+2)(x+3)\\\\x^2+4x+3&=(x+1)(x+3)\\\\\\operatorname{LCM}&=(x+1)(x+2)(x+3)\\end{align*}$$\nUse each distinct factor once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q1-o",
        "type": "part",
        "label": "o",
        "prompt": "$x^2-9$ and $x^2-x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x-3)(x+2)$",
          "worked": "$$\\begin{align*}x^2-9&=(x+3)(x-3)\\\\x^2-x-6&=(x-3)(x+2)\\\\\\operatorname{LCM}&=(x+3)(x-3)(x+2)\\end{align*}$$\nUse each distinct factor once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q1-p",
        "type": "part",
        "label": "p",
        "prompt": "$x^2-1$ and $x^2+2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2(x-1)$",
          "worked": "$$\\begin{align*}x^2-1&=(x+1)(x-1)\\\\x^2+2x+1&=(x+1)^2\\\\\\operatorname{LCM}&=(x+1)^2(x-1)\\end{align*}$$\nUse the highest power of each factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q1-q",
        "type": "part",
        "label": "q",
        "prompt": "$x^2+7x+12$ and $x^2+6x+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x+3)(x+4)$",
          "worked": "$$\\begin{align*}x^2+7x+12&=(x+3)(x+4)\\\\x^2+6x+8&=(x+2)(x+4)\\\\\\operatorname{LCM}&=(x+2)(x+3)(x+4)\\end{align*}$$\nUse each distinct factor once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q1-r",
        "type": "part",
        "label": "r",
        "prompt": "$x^2-4x+4$ and $x^2-5x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2(x-3)$",
          "worked": "$$\\begin{align*}x^2-4x+4&=(x-2)^2\\\\x^2-5x+6&=(x-2)(x-3)\\\\\\operatorname{LCM}&=(x-2)^2(x-3)\\end{align*}$$\nUse the highest power of each factor.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
