        "id": "v2-a57f0-p58-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\left(e^{x}+2e^{-x}\\right)^2dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12e^{2x}+4x-2e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int\\left(e^{x}+2e^{-x}\\right)^2dx&=\\int\\left(e^{2x}+4+4e^{-2x}\\right)dx\\\\&=\\frac12e^{2x}+4x-2e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-a57f0-p58-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^e\\frac{(x^2-3)^2}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{e^4}{4}-3e^2+\\dfrac{47}{4}$",
          "worked": "$$\\begin{align*}\\int_1^e\\frac{(x^2-3)^2}{x}\\,dx&=\\int_1^e\\frac{x^4-6x^2+9}{x}\\,dx\\\\&=\\int_1^e\\left(x^3-6x+\\frac9x\\right)dx\\\\&=\\left[\\frac{x^4}{4}-3x^2+9\\ln|x|\\right]_1^e\\\\&=\\left(\\frac{e^4}{4}-3e^2+9\\right)-\\left(\\frac14-3\\right)\\\\&=\\frac{e^4}{4}-3e^2+\\frac{47}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
