  "content": {
    "id": "p19-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "If $\\log_{10}x=0.6$ and $\\log_{10}y=0.2$, evaluate $\\log_{10}\\left(\\frac{x^2}{\\sqrt{y}}\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.1$",
      "worked": "$$\\begin{align*}\\log_{10}\\left(\\frac{x^2}{\\sqrt{y}}\\right)&=\\log_{10}(x^2)-\\log_{10}(y^{1/2})\\\\\\log_{10}\\left(\\frac{x^2}{\\sqrt{y}}\\right)&=2\\log_{10}x-\\frac12\\log_{10}y\\\\\\log_{10}\\left(\\frac{x^2}{\\sqrt{y}}\\right)&=2(0.6)-\\frac12(0.2)\\\\\\log_{10}\\left(\\frac{x^2}{\\sqrt{y}}\\right)&=1.1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
