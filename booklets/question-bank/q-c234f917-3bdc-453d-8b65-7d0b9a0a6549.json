  "content": {
    "id": "v2-3b9cc-p44-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "$ABCD$ is a parallelogram with $\\overrightarrow{AB}=\\underset{\\sim}{a}$ and $\\overrightarrow{BC}=\\underset{\\sim}{b}$. The diagonals meet at $M$.\n\nFind in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [
      {
        "id": "v2-3b9cc-p44-practice-slot-1-slot-1-q-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"slot-1 question diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\\coordinate (B) at (3.2,0);\\coordinate (C) at (4.4,2);\\coordinate (D) at (1.2,2);\\coordinate (M) at (2.2,1);\n\\draw (A)--(B)--(C)--(D)--cycle;\n\\draw[dashed,line width=0.5pt] (A)--(C) (B)--(D);\n\\draw[->] (A)--($(A)!0.55!(B)$);\\draw[->] (B)--($(B)!0.55!(C)$);\n\\fill (M) circle (1.4pt);\n\\node[below left] at (A) {$A$};\\node[below right] at (B) {$B$};\\node[above right] at (C) {$C$};\\node[above left] at (D) {$D$};\n\\node[below right,xshift=1mm] at (M) {$M$};\n\\path (A)--(B) node[midway,below] {$\\underset{\\sim}{a}$};\\path (B)--(C) node[midway,right] {$\\underset{\\sim}{b}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false
      }
    ],
    "children": [
      {
        "id": "v2-3b9cc-p44-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{BD}+\\overrightarrow{CB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\underset{\\sim}{a}$",
          "worked": "$$\\begin{align*}\\overrightarrow{BD}&=\\overrightarrow{BA}+\\overrightarrow{AD}\\\\&=-\\underset{\\sim}{a}+\\underset{\\sim}{b}\\\\\\overrightarrow{CB}&=-\\underset{\\sim}{b}\\\\\\overrightarrow{BD}+\\overrightarrow{CB}&=-\\underset{\\sim}{a}+\\underset{\\sim}{b}-\\underset{\\sim}{b}\\\\&=-\\underset{\\sim}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-3b9cc-p44-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{AC}-\\overrightarrow{DB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\underset{\\sim}{b}$",
          "worked": "$$\\begin{align*}\\overrightarrow{AC}&=\\overrightarrow{AB}+\\overrightarrow{BC}\\\\&=\\underset{\\sim}{a}+\\underset{\\sim}{b}\\\\\\overrightarrow{DB}&=\\overrightarrow{DA}+\\overrightarrow{AB}\\\\&=-\\underset{\\sim}{b}+\\underset{\\sim}{a}\\\\\\overrightarrow{AC}-\\overrightarrow{DB}&=(\\underset{\\sim}{a}+\\underset{\\sim}{b})-(\\underset{\\sim}{a}-\\underset{\\sim}{b})\\\\&=2\\underset{\\sim}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-3b9cc-p44-practice-slot-1-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{MA}+\\overrightarrow{MB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\underset{\\sim}{b}$",
          "worked": "$$\\begin{align*}\\overrightarrow{MA}&=-\\tfrac12\\overrightarrow{AC}\\\\&=-\\tfrac12(\\underset{\\sim}{a}+\\underset{\\sim}{b})\\\\\\overrightarrow{MB}&=\\overrightarrow{MA}+\\overrightarrow{AB}\\\\&=-\\tfrac12(\\underset{\\sim}{a}+\\underset{\\sim}{b})+\\underset{\\sim}{a}\\\\&=\\tfrac12(\\underset{\\sim}{a}-\\underset{\\sim}{b})\\\\\\overrightarrow{MA}+\\overrightarrow{MB}&=-\\tfrac12\\underset{\\sim}{a}-\\tfrac12\\underset{\\sim}{b}+\\tfrac12\\underset{\\sim}{a}-\\tfrac12\\underset{\\sim}{b}\\\\&=-\\underset{\\sim}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
