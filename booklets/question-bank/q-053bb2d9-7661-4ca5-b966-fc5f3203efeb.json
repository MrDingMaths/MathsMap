  "content": {
    "id": "v2-c0a3d-p30-practice-j11-021008-root",
    "type": "question",
    "label": null,
    "prompt": "The difference of two squares can also be used on numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-c0a3d-p30-practice-j11-021008-j11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $51^2-49^2$ by factorising.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$200$",
          "worked": "$$\\begin{align*}51^2-49^2&=(51+49)(51-49)\\\\&=100\\times2\\\\&=200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-c0a3d-p30-practice-j11-021008-j11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $75^2-25^2$ without a calculator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5000$",
          "worked": "$$\\begin{align*}75^2-25^2&=(75+25)(75-25)\\\\&=100\\times50\\\\&=5000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-c0a3d-p30-practice-j11-021008-j11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the difference of two squares to write $2^8-1$ as a product of three whole numbers, each greater than 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times5\\times17$",
          "worked": "$$\\begin{align*}2^8-1&=(2^4)^2-1^2\\\\&=(2^4+1)(2^4-1)\\\\&=17\\left((2^2)^2-1^2\\right)\\\\&=17(2^2+1)(2^2-1)\\\\&=17\\times5\\times3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
