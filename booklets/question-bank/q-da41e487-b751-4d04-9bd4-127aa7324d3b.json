  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A piece of string is $x$ metres in length. It is divided into 5 equal parts.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each part, in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{5}\\text{ m}$",
          "worked": "Divide the total length by the number of equal parts.\n$$\\begin{align*}\\text{Length of each part}&=x\\div5\\\\\\text{Length of each part}&=\\frac{x}{5}\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q7-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the length of each part for:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q7-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x=20$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4\\text{ m}$",
              "worked": "$$\\begin{align*}\\frac{x}{5}&=\\frac{20}{5}\\\\\\frac{x}{5}&=4\\end{align*}$$\nEach part is $4\\text{ m}$ long.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p7-q7-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x=42$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8\\frac{2}{5}\\text{ m}$",
              "worked": "$$\\begin{align*}\\frac{x}{5}&=\\frac{42}{5}\\\\\\frac{x}{5}&=\\frac{40}{5}+\\frac{2}{5}\\\\\\frac{x}{5}&=8\\frac{2}{5}\\end{align*}$$\nEach part is $8\\frac{2}{5}\\text{ m}$ long.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p7-q7-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x=96$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$19\\frac{1}{5}\\text{ m}$",
              "worked": "$$\\begin{align*}\\frac{x}{5}&=\\frac{96}{5}\\\\\\frac{x}{5}&=\\frac{95}{5}+\\frac{1}{5}\\\\\\frac{x}{5}&=19\\frac{1}{5}\\end{align*}$$\nEach part is $19\\frac{1}{5}\\text{ m}$ long.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
