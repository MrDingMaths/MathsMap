    "children": [
      {
        "id": "p54-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why a pictogram would not be suitable for this data",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A pictogram is possible with a suitable key, but these counts would need many symbols or awkward partial symbols. A column graph is more practical.",
          "worked": "With one symbol per car, the large frequencies would take a long time to draw and count. A larger key reduces the number of symbols, but exact counts such as $43$, $71$ and $101$ may require awkward partial symbols. A column graph makes accurate comparison more practical.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p54-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Why would a pie chart be difficult to draw for this data?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The small sectors and non-whole-degree angles would be difficult to draw accurately by hand.",
          "worked": "Each frequency must be represented by a sector angle. Some categories, especially other, produce small sectors, and the angles are not whole numbers of degrees. These are difficult to draw accurately by hand.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
