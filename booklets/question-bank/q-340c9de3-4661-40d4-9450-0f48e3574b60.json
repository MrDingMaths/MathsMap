    "type": "question",
    "label": "13",
    "prompt": "If $y = 0.5x^2$, calculate the value of $y$ in scientific notation when $x = 9.8 \\times 10^{-3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.802 \\times 10^{-5}$",
      "worked": "$$\\begin{align*}y &= 0.5(9.8 \\times 10^{-3})^2\\\\y &= 0.5 \\times 96.04 \\times 10^{-6}\\\\y &= 4.802 \\times 10^{-5}\\end{align*}$$",
      "solutionDiagrams": []
    },
