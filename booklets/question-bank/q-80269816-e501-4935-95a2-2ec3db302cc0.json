  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Prove that two chords of a circle are equal in length if and only if the central angles they define are equal in measure.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AB=CD$ if and only if $\\angle AOB=\\angle COD$.\n\nUse SSS for equal chords and SAS for equal central angles.",
      "worked": "Let $AB$ and $CD$ be chords of a circle with centre $O$. All four radii are equal: $OA=OB=OC=OD$.\n\nIf $AB=CD$, then $\\triangle OAB\\equiv\\triangle OCD$ by SSS. Corresponding angles give $\\angle AOB=\\angle COD$.\n\nConversely, if $\\angle AOB=\\angle COD$, then $\\triangle OAB\\equiv\\triangle OCD$ by SAS. Corresponding sides give $AB=CD$.\n\nThus the statement holds in both directions.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
