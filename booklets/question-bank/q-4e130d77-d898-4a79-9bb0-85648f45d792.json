  "content": {
    "id": "p2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the general term for the sequence of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "positive odd integers",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=2n-1$",
          "worked": "The terms are $1,3,5,\\ldots$, starting with $n=1$.\n$$\\begin{align*}a_n&=1+2(n-1)\\\\a_n&=2n-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p2-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "positive even integers",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=2n$",
          "worked": "The terms are $2\\times1,2\\times2,2\\times3,\\ldots$.\n$$a_n=2n.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "perfect squares",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=n^2$",
          "worked": "The terms are $1^2,2^2,3^2,\\ldots$.\n$$a_n=n^2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "positive multiples of 10.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=10n$",
          "worked": "The terms are $10\\times1,10\\times2,10\\times3,\\ldots$.\n$$a_n=10n.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
