  "content": {
    "id": "p66-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p66-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(2n + 1)^2 = 8k + 1$ for some integer $k$ that depends on $n$. Hence explain why the square of any odd integer always leaves remainder 1 when divided by 8.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{n(n+1)}{2}$ is an integer because one of $n$ and $n+1$ is even. Thus $(2n+1)^2=8k+1$, so every odd square leaves remainder 1 when divided by 8.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p66-q14-a-answer-expansion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(2n+1)^2&=4n^2+4n+1\\\\(2n+1)^2&=4n(n+1)+1\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p66-q14-a-answer-parity",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "One of ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "n",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "n+1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is even because they are consecutive integers. Hence ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "n(n+1)=2k",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " for some integer ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "k",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p66-q14-a-answer-substitution",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(2n+1)^2&=4(2k)+1\\\\(2n+1)^2&=8k+1\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p66-q14-a-answer-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Every odd integer has the form ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2n+1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", so its square leaves remainder 1 when divided by 8.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p66-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Verify for $7^2$ and $11^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^2=8\\times6+1$ and $11^2=8\\times15+1$; both leave remainder 1.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p66-q14-b-answer-seven",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "7^2=49=48+1=8\\times6+1",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p66-q14-b-answer-eleven",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "11^2=121=120+1=8\\times15+1",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
