        "prompt": "List every arrangement of 3 successes and 1 failure in 4 trials.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{SSSF}$\n\n$\\mathrm{SSFS}$\n\n$\\mathrm{SFSS}$\n\n$\\mathrm{FSSS}$",
          "worked": "Place the single failure in each of the four positions:\n\n$$\\begin{aligned}&\\mathrm{SSSF}\\\\&\\mathrm{SSFS}\\\\&\\mathrm{SFSS}\\\\&\\mathrm{FSSS}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "How many are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "There are $4$ arrangements, one for each possible position of the failure.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
