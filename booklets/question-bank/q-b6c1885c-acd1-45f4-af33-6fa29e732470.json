  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify the following. You will need to rewrite the fractions with a common denominator.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{x}+\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8+x^2}{4x}$",
          "worked": "$$\\begin{align*}\\frac{2}{x}+\\frac{x}{4}&=\\frac{8}{4x}+\\frac{x^2}{4x}\\\\&=\\frac{8+x^2}{4x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{-5}{x}+\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-10+x^2}{2x}$",
          "worked": "$$\\begin{align*}\\frac{-5}{x}+\\frac{x}{2}&=\\frac{-10}{2x}+\\frac{x^2}{2x}\\\\&=\\frac{-10+x^2}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{-2}{x}-\\frac{4x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-6-4x^2}{3x}$",
          "worked": "$$\\begin{align*}\\frac{-2}{x}-\\frac{4x}{3}&=\\frac{-6}{3x}-\\frac{4x^2}{3x}\\\\&=\\frac{-6-4x^2}{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{2x}-\\frac{5x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6-5x^2}{4x}$",
          "worked": "$$\\begin{align*}\\frac{3}{2x}-\\frac{5x}{4}&=\\frac{6}{4x}-\\frac{5x^2}{4x}\\\\&=\\frac{6-5x^2}{4x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3x}{4}-\\frac{5}{6x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x^2-10}{12x}$",
          "worked": "$$\\begin{align*}\\frac{3x}{4}-\\frac{5}{6x}&=\\frac{9x^2}{12x}-\\frac{10}{12x}\\\\&=\\frac{9x^2-10}{12x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{3x}-\\frac{x}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3-x^2}{9x}$",
          "worked": "$$\\begin{align*}\\frac{1}{3x}-\\frac{x}{9}&=\\frac{3}{9x}-\\frac{x^2}{9x}\\\\&=\\frac{3-x^2}{9x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$-\\frac{2}{5x}+\\frac{3x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-4+15x^2}{10x}$",
          "worked": "$$\\begin{align*}-\\frac{2}{5x}+\\frac{3x}{2}&=\\frac{-4}{10x}+\\frac{15x^2}{10x}\\\\&=\\frac{-4+15x^2}{10x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{-5}{4x}-\\frac{3x}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-25-6x^2}{20x}$",
          "worked": "$$\\begin{align*}\\frac{-5}{4x}-\\frac{3x}{10}&=\\frac{-25}{20x}-\\frac{6x^2}{20x}\\\\&=\\frac{-25-6x^2}{20x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$-\\frac{6x}{4}-\\frac{5}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{-9x^2-10}{6x}$",
          "worked": "$$\\begin{align*}-\\frac{6x}{4}-\\frac{5}{3x}&=\\frac{-18x^2}{12x}-\\frac{20}{12x}\\\\&=\\frac{-18x^2-20}{12x}\\\\&=\\frac{-9x^2-10}{6x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
