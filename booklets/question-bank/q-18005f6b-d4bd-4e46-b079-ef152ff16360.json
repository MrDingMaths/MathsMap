  "content": {
    "id": "p30-q24-root",
    "type": "question",
    "label": null,
    "prompt": "Given $\\cos\\theta=\\frac25$, find the value of $\\cos^2\\frac{\\theta}{2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac7{10}$",
      "worked": "$$\\begin{align*}\\cos\\theta&=2\\cos^2\\frac{\\theta}{2}-1\\\\\\cos^2\\frac{\\theta}{2}&=\\frac{1+\\cos\\theta}{2}\\\\\\cos^2\\frac{\\theta}{2}&=\\frac{1+\\frac25}{2}\\\\\\cos^2\\frac{\\theta}{2}&=\\frac7{10}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
