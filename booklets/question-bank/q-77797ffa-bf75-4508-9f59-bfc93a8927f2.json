          "inlines": [
            {
              "type": "text",
              "text": "Buttons can be pressed in sequence to achieve different copy sizes. For example, to achieve a copy of size ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "72\\%",
              "display": false
            },
            {
              "type": "text",
              "text": " one can press button B followed by button C since ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "90\\%\\text{ of }80\\%=72\\%",
              "display": false
            },
            {
              "type": "text",
              "text": ". Buttons can be pressed more than once. For example, pressing button B twice would yield a copy of size ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "80\\%\\text{ of }80\\%=64\\%",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
