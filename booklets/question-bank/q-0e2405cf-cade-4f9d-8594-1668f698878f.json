  "content": {
    "id": "p20-q27-root",
    "type": "question",
    "label": "27",
    "prompt": "Two linear functions are defined as $f(x)=2x+k$ and $g(x)=3x-4$, where $k$ is a real constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q27-a",
        "type": "part",
        "label": "a",
        "prompt": "Find simplified algebraic expressions for $f(g(x))$ and $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=6x-8+k$; $g(f(x))=6x+3k-4$.",
          "worked": "$$\\begin{aligned}f(g(x))&=2(3x-4)+k\\\\f(g(x))&=6x-8+k\\end{aligned}$$\n$$\\begin{aligned}g(f(x))&=3(2x+k)-4\\\\g(f(x))&=6x+3k-4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p20-q27-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the unique value of $k$ for which $f(g(x))=g(f(x))$ for all values of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-2$.",
          "worked": "For $f(g(x))=g(f(x))$ to hold identically for all $x$:\n$$\\begin{aligned}6x-8+k&=6x+3k-4\\\\-8+k&=3k-4\\\\-4&=2k\\\\k&=-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
