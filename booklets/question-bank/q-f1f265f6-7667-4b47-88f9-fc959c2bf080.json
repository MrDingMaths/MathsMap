      {
        "id": "p52-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Label the line segments as:\nA: Before petrol station\nB: After petrol station but before worksite\nC: Return from worksite",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A: 6–7 a.m.; B: 7:15–8:30 a.m.; C: 9:15–11 a.m.",
          "worked": "Label the first rising segment A, the second rising segment B and the descending return segment C. The horizontal segments represent stops.",
          "solutionDiagrams": [
            {
              "id": "p52-q5-a-labelled-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 52 p52-q5-a-labelled-graph\"}\n\\begin{tikzpicture}[x=0.6cm,y=0.12cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\foreach \\x in {0,1,...,11}{\\draw[line width=0.25pt,color=black!20] (\\x,0)--(\\x,55);}\n\\foreach \\y in {0,5,...,55}{\\draw[line width=0.25pt,color=black!20] (0,\\y)--(11,\\y);}\n\\draw[->,black,line width=0.5pt] (0,0)--(11,0);\n\\draw[->,black,line width=0.5pt] (0,0)--(0,55);\n\\foreach \\x/\\t in {0/6,2/7,4/8,6/9,8/10,10/11}{\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-1);\\node[below,align=center] at (\\x,-1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\t\\\\a.m.\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {0,10,20,30,40,50}{\\draw[black,line width=0.4pt] (0,\\y)--(-0.15,\\y);\\node[left] at (-0.15,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\y\\special{dvisvgm:raw </g>}};}\n\\node[rotate=90] at (-1.55,27.5) {\\textit{Distance from home (km)}};\n\\node[below] at (5.5,-16) {\\textit{Time}};\n\\draw[black,line width=0.8pt] (0,0)--node[midway,left=2mm]{A}(2,25)--(2.5,25)--node[midway,left=2mm]{B}(5,45)--(6.5,45)--node[midway,right=2mm]{C}(10,0);\n\\end{tikzpicture}",
