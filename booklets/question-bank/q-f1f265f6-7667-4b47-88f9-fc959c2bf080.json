      {
        "id": "p52-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the car’s speed during stage A?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ km/h}$",
          "worked": "The car travels 25 km from 6 a.m. to 7 a.m.\n$$\\begin{align*}\\text{Time taken}&=1\\text{ h}\\\\\\text{Speed}&=\\frac{25\\text{ km}}{1\\text{ h}}\\\\\\text{Speed}&=25\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p52-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "What was the car’s speed during stage B?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\text{ km/h}$",
          "worked": "Stage B runs from 7:15 a.m. to 8:30 a.m.\n$$\\begin{align*}\\text{Time taken}&=1\\text{ h }15\\text{ min}=1.25\\text{ h}\\\\\\text{Distance travelled}&=(45-25)\\text{ km}=20\\text{ km}\\\\\\text{Speed}&=\\frac{20\\text{ km}}{1.25\\text{ h}}\\\\\\text{Speed}&=16\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "What was the car’s speed during stage C? Round to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25.71\\text{ km/h}$",
          "worked": "The return journey runs from 9:15 a.m. to 11 a.m. Speed uses the distance travelled, so it is positive.\n$$\\begin{align*}\\text{Time taken}&=1\\text{ h }45\\text{ min}=1.75\\text{ h}\\\\\\text{Speed}&=\\frac{45\\text{ km}}{1.75\\text{ h}}\\\\\\text{Speed}&=\\frac{180}{7}\\text{ km/h}\\\\\\text{Speed}&\\approx25.71\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "What distance did the car travel in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90\\text{ km}$",
          "worked": "The car travels 45 km to the worksite and 45 km home.\n$$\\text{Total distance}=45+45=90\\text{ km}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p52-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "What was the car’s average speed for the whole journey, not including the stops?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90\\div4=22.5\\text{ km/h}$",
          "worked": "The whole journey lasts 5 h. The petrol-station stop lasts 15 min and the worksite stop lasts 45 min.\n$$\\begin{align*}\\text{Total stopped time}&=15+45=60\\text{ min}=1\\text{ h}\\\\\\text{Driving time}&=5-1=4\\text{ h}\\\\\\text{Average speed}&=\\frac{90\\text{ km}}{4\\text{ h}}\\\\\\text{Average speed}&=22.5\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
