  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the points $A(1,3)$ and $B(9,9)$. If the line segment $AB$ is the diameter of a circle, then:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of the centre of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,6)$",
          "worked": "The centre is the midpoint of the diameter.\n$$\\begin{align*}C&=\\left(\\frac{1+9}{2},\\frac{3+9}{2}\\right)\\\\C&=(5,6).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the radius of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}r&=CA\\\\r&=\\sqrt{(5-1)^2+(6-3)^2}\\\\r&=\\sqrt{25}\\\\r&=5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine if the point $(10,5)$ lies on the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; its squared distance from the centre is $26$, whereas $r^2=25$.",
          "worked": "Let $P=(10,5)$.\n$$\\begin{align*}CP^2&=(10-5)^2+(5-6)^2\\\\CP^2&=26.\\end{align*}$$\nSince $CP^2\\ne r^2=25$, the point does not lie on the circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
