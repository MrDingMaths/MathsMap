  "content": {
    "id": "p15-q3-response",
    "type": "question",
    "label": "3",
    "prompt": "There are 64 blue and red marbles in a box. The ratio of red marbles to blue marbles is $3:5$. How many blue marbles are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "40 blue marbles.",
      "worked": "$$\\begin{align*}\\text{Total number of parts}&=3+5=8\\\\\\text{Marbles in one part}&=64\\div8=8\\\\\\text{Number of blue marbles}&=5\\times8=40\\end{align*}$$\nThere are 40 blue marbles.",
      "solutionDiagrams": []
    },
