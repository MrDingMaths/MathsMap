  "content": {
    "id": "v2-7-practice-section-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "The area, in m², of an algal bloom on a dam is given by $A=3t^2-5t+20$, where $t$ is time in days. Find the rate of increase in the area after 4 days.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$19\\text{ m}^2/\\text{day}$",
      "worked": "$$\\begin{align*}\\frac{dA}{dt}&=6t-5\\\\\\left.\\frac{dA}{dt}\\right|_{t=4}&=6(4)-5\\\\&=19\\text{ m}^2/\\text{day}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
