            {
              "type": "text",
              "text": "Bob flips a coin and rolls a six-sided die. Find the probability that Bob has heads and an odd number.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "The coin flip and die roll are independent.\n$$\\begin{align*}P(\\text{heads and odd})&=\\frac{1}{2}\\times\\frac{3}{6}\\\\P(\\text{heads and odd})&=\\frac{1}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
