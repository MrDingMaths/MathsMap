    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A number, $x$, is multiplied by 7 and divided by 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{2}$",
          "worked": "Multiplying $x$ by 7 gives $7x$. Dividing this by 2 gives $\\frac{7x}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A number, $x$, is multiplied by 11 and divided by 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11x}{3}$",
          "worked": "Multiplying $x$ by 11 gives $11x$. Dividing this by 3 gives $\\frac{11x}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{5}$ of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{5}$",
          "worked": "$$\\frac{1}{5}\\times x=\\frac{x}{5}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "A number, $y$, is multiplied by $\\frac{3}{4}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3y}{4}$",
          "worked": "$$y\\times\\frac{3}{4}=\\frac{3y}{4}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "A number, $y$, is divided by 7, 11 is added to the result, and the result of this is multiplied by 13.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13\\left(\\frac{y}{7}+11\\right)$",
          "worked": "Dividing $y$ by 7 gives $\\frac{y}{7}$.\n\nAdding 11 gives $\\frac{y}{7}+11$.\n\nMultiplying the whole result by 13 gives $13\\left(\\frac{y}{7}+11\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
