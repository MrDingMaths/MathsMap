  "content": {
    "id": "p54-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q2-explanation",
        "type": "part",
        "label": "a",
        "prompt": "Why is $\\dfrac{2}{4+\\sqrt{3}}$ the same value as $\\dfrac{2}{4+\\sqrt{3}}\\times\\dfrac{4-\\sqrt{3}}{4-\\sqrt{3}}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The conjugate fraction equals $1$, so multiplying by it leaves the value unchanged.",
          "worked": "Since $4-\\sqrt{3}\\ne0$, $\\dfrac{4-\\sqrt{3}}{4-\\sqrt{3}}=1$. Multiplying the numerator and denominator by this same nonzero expression gives an equivalent fraction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p54-q2-rationalise",
        "type": "group",
        "label": "",
        "prompt": "Rationalise these denominators.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q2-a",
            "type": "part",
            "label": "b",
            "prompt": "$\\dfrac{2}{4+\\sqrt{3}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{8-2\\sqrt{3}}{13}$",
              "worked": "$$\\begin{align*}\\frac{2}{4+\\sqrt{3}}&=\\frac{2}{4+\\sqrt{3}}\\times\\frac{4-\\sqrt{3}}{4-\\sqrt{3}}\\\\&=\\frac{8-2\\sqrt{3}}{16-3}\\\\&=\\frac{8-2\\sqrt{3}}{13}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          },
          {
            "id": "p54-q2-b",
            "type": "part",
            "label": "c",
            "prompt": "$\\dfrac{1}{5-\\sqrt{7}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{5+\\sqrt{7}}{18}$",
              "worked": "$$\\begin{align*}\\frac{1}{5-\\sqrt{7}}&=\\frac{1}{5-\\sqrt{7}}\\times\\frac{5+\\sqrt{7}}{5+\\sqrt{7}}\\\\&=\\frac{5+\\sqrt{7}}{25-7}\\\\&=\\frac{5+\\sqrt{7}}{18}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          },
          {
            "id": "p54-q2-c",
            "type": "part",
            "label": "d",
            "prompt": "$\\dfrac{\\sqrt{5}}{8-\\sqrt{5}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{8\\sqrt{5}+5}{59}$",
              "worked": "$$\\begin{align*}\\frac{\\sqrt{5}}{8-\\sqrt{5}}&=\\frac{\\sqrt{5}}{8-\\sqrt{5}}\\times\\frac{8+\\sqrt{5}}{8+\\sqrt{5}}\\\\&=\\frac{8\\sqrt{5}+5}{64-5}\\\\&=\\frac{8\\sqrt{5}+5}{59}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p54-q2-d",
            "type": "part",
            "label": "e",
            "prompt": "$\\dfrac{5}{\\sqrt{6}-1}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{6}+1$",
              "worked": "$$\\begin{align*}\\frac{5}{\\sqrt{6}-1}&=\\frac{5}{\\sqrt{6}-1}\\times\\frac{\\sqrt{6}+1}{\\sqrt{6}+1}\\\\&=\\frac{5\\sqrt{6}+5}{6-1}\\\\&=\\sqrt{6}+1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          },
          {
            "id": "p54-q2-e",
            "type": "part",
            "label": "f",
            "prompt": "$\\dfrac{6}{\\sqrt{2}+\\sqrt{11}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{2\\sqrt{11}-2\\sqrt{2}}{3}$",
              "worked": "$$\\begin{align*}\\frac{6}{\\sqrt{2}+\\sqrt{11}}&=\\frac{6}{\\sqrt{2}+\\sqrt{11}}\\times\\frac{\\sqrt{2}-\\sqrt{11}}{\\sqrt{2}-\\sqrt{11}}\\\\&=\\frac{6\\sqrt{2}-6\\sqrt{11}}{2-11}\\\\&=\\frac{6\\sqrt{11}-6\\sqrt{2}}{9}\\\\&=\\frac{2\\sqrt{11}-2\\sqrt{2}}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 53
          },
          {
            "id": "p54-q2-f",
            "type": "part",
            "label": "g",
            "prompt": "$\\dfrac{2+\\sqrt{3}}{2-\\sqrt{3}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7+4\\sqrt{3}$",
              "worked": "$$\\begin{align*}\\frac{2+\\sqrt{3}}{2-\\sqrt{3}}&=\\frac{2+\\sqrt{3}}{2-\\sqrt{3}}\\times\\frac{2+\\sqrt{3}}{2+\\sqrt{3}}\\\\&=\\frac{(2+\\sqrt{3})^2}{4-3}\\\\&=4+4\\sqrt{3}+3\\\\&=7+4\\sqrt{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 49
          }
        ]
      }
    ]
  },
