    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the derivative of $f(x)=x^3-6x^2+9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=3x^2-12x$",
          "worked": "$$\\begin{align*}f'(x)&=3x^2-12x+0\\\\f'(x)&=3x^2-12x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p15-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence determine whether the curve is increasing, decreasing, or stationary at:",
        "layout": "grid",
        "columns": 5,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q2-b-x0",
            "type": "part",
            "label": "i",
            "prompt": "$x=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(0)=0$; stationary.",
              "worked": "$$\\begin{align*}f'(0)&=3(0)^2-12(0)\\\\f'(0)&=0\\end{align*}$$\nThe curve is stationary at $x=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q2-b-x1",
            "type": "part",
            "label": "ii",
            "prompt": "$x=1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(1)=-9$; decreasing.",
              "worked": "$$\\begin{align*}f'(1)&=3(1)^2-12(1)\\\\f'(1)&=-9<0\\end{align*}$$\nThe curve is decreasing at $x=1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q2-b-x2",
            "type": "part",
            "label": "iii",
            "prompt": "$x=2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(2)=-12$; decreasing.",
              "worked": "$$\\begin{align*}f'(2)&=3(2)^2-12(2)\\\\f'(2)&=-12<0\\end{align*}$$\nThe curve is decreasing at $x=2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q2-b-x3",
            "type": "part",
            "label": "iv",
            "prompt": "$x=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(3)=-9$; decreasing.",
              "worked": "$$\\begin{align*}f'(3)&=3(3)^2-12(3)\\\\f'(3)&=-9<0\\end{align*}$$\nThe curve is decreasing at $x=3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q2-b-xminus1",
            "type": "part",
            "label": "v",
            "prompt": "$x=-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(-1)=15$; increasing.",
              "worked": "$$\\begin{align*}f'(-1)&=3(-1)^2-12(-1)\\\\f'(-1)&=3+12\\\\f'(-1)&=15>0\\end{align*}$$\nThe curve is increasing at $x=-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      }
