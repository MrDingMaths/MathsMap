  "content": {
    "id": "p36-q11",
    "type": "question",
    "label": "11",
    "prompt": "For three months, Cameron has been wearing an exercise tracking wristband that records the distance he walks and the number of calories he burns. The graph shows his weekly totals. The regression line equation for this data is $y=14301+115.02x$.",
