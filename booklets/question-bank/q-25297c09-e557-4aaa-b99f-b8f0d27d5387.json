    "children": [
      {
        "id": "p36-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Using the equation for the regression line, determine the number of calories burned if a person walked 50 km in a week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Estimated $20\\,052$ calories.",
          "worked": "$$\\begin{aligned}y&=14301+115.02(50)\\\\y&=14301+5751\\\\y&=20052\\end{aligned}$$\nThe estimated number of calories burned is $20\\,052$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Is this interpolation or extrapolation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Interpolation.",
          "worked": "Interpolation, because $50$ km lies within the observed distance range.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p36-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Due to an injury, in one week Cameron only walked 10 km and he forgot to wear his tracker. Determine the number of calories this distance would burn.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Estimated $15\\,451.2$ calories.",
          "worked": "$$\\begin{aligned}y&=14301+115.02(10)\\\\y&=14301+1150.2\\\\y&=15451.2\\end{aligned}$$\nThe estimated number of calories burned is $15\\,451.2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p36-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Is this interpolation or extrapolation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Extrapolation.",
          "worked": "Extrapolation, because $10$ km is below the observed distance range. This prediction is less reliable because it extends the model beyond the recorded data.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p36-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "Pearson’s correlation coefficient for this data is $0.9678$.\n\nWhat does this mean for the direction and strength of the correlation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Strong positive correlation.",
          "worked": "Since $r=0.9678$ is positive and close to $1$, there is a strong positive correlation. Greater weekly distances walked tend to be associated with more calories burned.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ],
