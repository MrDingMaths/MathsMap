        "prompt": "$\\sqrt{45}+2\\sqrt{5}-\\sqrt{80}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\sqrt{45}+2\\sqrt{5}-\\sqrt{80}&=3\\sqrt{5}+2\\sqrt{5}-4\\sqrt{5}\\\\\\sqrt{45}+2\\sqrt{5}-\\sqrt{80}&=(3+2-4)\\sqrt{5}\\\\\\sqrt{45}+2\\sqrt{5}-\\sqrt{80}&=\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{28}+2\\sqrt{63}-5\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{7}$",
          "worked": "$$\\begin{align*}\\sqrt{28}+2\\sqrt{63}-5\\sqrt{7}&=2\\sqrt{7}+6\\sqrt{7}-5\\sqrt{7}\\\\\\sqrt{28}+2\\sqrt{63}-5\\sqrt{7}&=(2+6-5)\\sqrt{7}\\\\\\sqrt{28}+2\\sqrt{63}-5\\sqrt{7}&=3\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p39-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{44}+\\sqrt{275}-4\\sqrt{11}$",
