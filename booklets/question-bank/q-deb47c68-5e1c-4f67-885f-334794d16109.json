  "content": {
    "id": "p17-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If $t=\\sqrt{\\frac{M}{M-m}}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "express the formula with $m$ as the subject",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{M(t^2-1)}{t^2}$",
          "worked": "$$\\begin{align*}t^2&=\\frac{M}{M-m}\\\\t^2(M-m)&=M\\\\t^2M-t^2m&=M\\\\t^2M-M&=t^2m\\\\m&=\\frac{M(t^2-1)}{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p17-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "express the formula with $M$ as the subject",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=\\frac{t^2m}{t^2-1}$\n\nCollect the terms containing $M$ and factorise.",
          "worked": "$$\\begin{align*}t^2&=\\frac{M}{M-m}\\\\t^2(M-m)&=M\\\\t^2M-t^2m&=M\\\\t^2M-M&=t^2m\\\\M(t^2-1)&=t^2m\\\\M&=\\frac{t^2m}{t^2-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p17-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "find the value of $M$ if $m=3$ and $t=\\sqrt{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=6$",
          "worked": "$$\\begin{align*}M&=\\frac{t^2m}{t^2-1}\\\\M&=\\frac{(\\sqrt{2})^2\\times3}{(\\sqrt{2})^2-1}\\\\M&=\\frac{2\\times3}{2-1}\\\\M&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
