        "answer": {
          "short": "$2\\frac{3}{5}$",
          "worked": "$$\\begin{align*}\\frac{m+n}{5}&=\\frac{6+7}{5}\\\\\\frac{m+n}{5}&=\\frac{13}{5}\\\\\\frac{m+n}{5}&=2\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{m}{3}+\\frac{n}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{m}{3}+\\frac{n}{2}&=\\frac{6}{3}+\\frac{7}{2}\\\\\\frac{m}{3}+\\frac{n}{2}&=2+3\\frac{1}{2}\\\\\\frac{m}{3}+\\frac{n}{2}&=5\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-d",
        "type": "part",
