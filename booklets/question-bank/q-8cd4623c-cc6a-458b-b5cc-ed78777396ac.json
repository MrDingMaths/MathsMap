  "content": {
    "id": "v2-84f2e-p13-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=x^2-1$ and $g(x)=x+3$. Find expressions for $f(g(x))$ and $g(f(x))$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(g(x))=x^2+6x+8$; $g(f(x))=x^2+2$.",
      "worked": "$$\\begin{align*}f(g(x))&=f(x+3)\\\\&=(x+3)^2-1\\\\&=x^2+6x+8\\end{align*}$$\n$$\\begin{align*}g(f(x))&=g(x^2-1)\\\\&=(x^2-1)+3\\\\&=x^2+2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
