  "content": {
    "id": "p68-q60-root",
    "type": "question",
    "label": null,
    "prompt": "Find a possible parametrisation for $y=4-2x$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q60-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\ne2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=t+2$, $y=-2t$, where $t\\in\\mathbb{R}\\setminus\\{0\\}$.",
          "worked": "Choose $x=t+2$, with $t\\ne0$, so that precisely $x=2$ is excluded.\n$$\\begin{align*}y&=4-2(t+2)\\\\y&=-2t\\end{align*}$$Thus $x=t+2$, $y=-2t$, for $t\\in\\mathbb{R}\\setminus\\{0\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p68-q60-b",
        "type": "part",
        "label": "b",
        "prompt": "$x>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5^t$, $y=4-2\\cdot5^t$, where $t\\in\\mathbb{R}$.",
          "worked": "Choose $x=5^t$, which ranges over all positive real numbers for $t\\in\\mathbb{R}$. Substitution gives $y=4-2\\cdot5^t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p68-q60-c",
        "type": "part",
        "label": "c",
        "prompt": "$x\\ge0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=t^2$, $y=4-2t^2$, where $t\\in\\mathbb{R}$.",
          "worked": "Choose $x=t^2$, which ranges over all nonnegative real numbers for $t\\in\\mathbb{R}$. Substitution gives $y=4-2t^2$; $t=0$ includes the boundary point $(0,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p68-q60-d",
        "type": "part",
        "label": "d",
        "prompt": "$x<1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1-e^t$, $y=2+2e^t$, where $t\\in\\mathbb{R}$.",
          "worked": "Choose $x=1-e^t$, which ranges over all real numbers less than $1$.\n$$\\begin{align*}y&=4-2(1-e^t)\\\\y&=2+2e^t\\end{align*}$$Take $t\\in\\mathbb{R}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
