        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 11 p11-q10-diagram\"}\n\\begin{tikzpicture}[x=0.6cm,y=0.6cm,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.25pt,step=1] (0,0) grid (10,6);\n\\draw[black,line width=0.8pt] (1,1)--(3,1)--(2,5)--cycle;\n\\draw[black,line width=0.8pt] (5,1)--(9,1)--(7,5)--cycle;\n\\node at (2,2.5) {$X$};\n\\node at (7,2.5) {$Y$};\n\\end{tikzpicture}",
