    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-5855d-p41-practice-slot-13-slot-13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the regression line predicting the number of drinks sold $N$ from maximum temperature $T$. Give the coefficients to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$N=13.32+2.06T$.",
          "worked": "Enter temperatures as $x$ and drinks sold as $y$ in the calculator's two-variable statistics mode. Select linear regression $y=a+bx$.\n$$\\begin{align*}a&=13.324627\\ldots\\\\b&=2.055970\\ldots\\\\N&\\approx13.32+2.06T\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-5855d-p41-practice-slot-13-slot-13-b",
        "type": "part",
        "label": "b",
        "prompt": "Subtract 10 from every number of drinks sold in the table. Calculate the new regression equation, giving its coefficients to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$N=3.32+2.06T$.",
          "worked": "Subtracting $10$ from every response decreases the intercept by $10$ and leaves the gradient unchanged. The calculator gives $a=3.324627\\ldots$, $b=2.055970\\ldots$, so $N\\approx3.32+2.06T$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-5855d-p41-practice-slot-13-slot-13-c",
        "type": "part",
        "label": "c",
        "prompt": "Using your rounded equation from part b, predict the new number of drinks sold on a day with a maximum temperature of 24°C. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$52.8$.",
          "worked": "$$\\begin{align*}N&=3.32+2.06(24)\\\\N&=52.76\\\\N&\\approx52.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-5855d-p41-practice-slot-13-slot-13-d",
        "type": "part",
        "label": "d",
        "prompt": "Compare the gradient and intercept of your equations in parts a and b.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.06$ is unchanged; the intercept decreases by $10$, from $13.32$ to $3.32$.",
          "worked": "Subtracting $10$ from each number of drinks shifts every point down by the same amount. The gradient stays $2.06$ and the intercept falls by $10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
