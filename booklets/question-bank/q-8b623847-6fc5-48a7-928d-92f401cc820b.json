  "content": {
    "id": "p64-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Factorise.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p64-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-3)^2-(x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8(x-1)$",
          "worked": "$$\\begin{align*}(x-3)^2-(x+1)^2&=[(x-3)-(x+1)][(x-3)+(x+1)]\\\\&=(-4)(2x-2)\\\\&=-8(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p64-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$16(x+1)^2-9(x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(7x-2)(x+10)$",
          "worked": "$$\\begin{align*}16(x+1)^2-9(x-2)^2&=[4(x+1)]^2-[3(x-2)]^2\\\\&=[4(x+1)-3(x-2)]\\times[4(x+1)+3(x-2)]\\\\&=(x+10)(7x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p64-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-y^2+x-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y+1)$",
          "worked": "$$\\begin{align*}x^2-y^2+x-y&=(x-y)(x+y)+(x-y)\\\\&=(x-y)(x+y+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p64-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-4y^2+6x+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3+2y)(x+3-2y)$",
          "worked": "$$\\begin{align*}x^2-4y^2+6x+9&=x^2+6x+9-4y^2\\\\&=(x+3)^2-(2y)^2\\\\&=(x+3+2y)(x+3-2y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p64-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$6x^2+7x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-1)(2x+3)$",
          "worked": "Product: $6(-3)=-18$. Sum: $7$. Factor pair: $9,-2$.\n$$\\begin{align*}6x^2+7x-3&=6x^2+9x-2x-3\\\\&=3x(2x+3)-(2x+3)\\\\&=(3x-1)(2x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p64-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$12x^2-x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-3)(3x+2)$",
          "worked": "Product: $12(-6)=-72$. Sum: $-1$. Factor pair: $8,-9$.\n$$\\begin{align*}12x^2-x-6&=12x^2+8x-9x-6\\\\&=4x(3x+2)-3(3x+2)\\\\&=(4x-3)(3x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
