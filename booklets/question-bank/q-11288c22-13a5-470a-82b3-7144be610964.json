  "content": {
    "id": "p19-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If Amy has an average score of 67 after four tests, and after doing a fifth test her average increases to 72, what score did she get on the fifth test?\n\nIntroduce a pronumeral, write an equation and solve it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "92",
      "worked": "The total score for the first four tests is $4\\times67=268$.\n\nLet $x$ be Amy's fifth test score.\n\n$$\\begin{align*}\\frac{268+x}{5}&=72\\\\268+x&=360\\\\x&=92\\end{align*}$$\n\nAmy scored 92 on the fifth test.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
