  "content": {
    "id": "p32-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Simplify each expression, if possible.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x^2-4xy^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Already simplified.",
          "worked": "The terms $5x^2$ and $-4xy^2$ have different variable powers, so they are not like terms. The expression is already simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p32-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$3a^2b+4ba^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7a^2b$",
          "worked": "$$\\begin{align*}3a^2b+4ba^2&=(3+4)a^2b\\\\&=7a^2b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p32-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$8m^2n-6nm^2+m^2n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3m^2n$",
          "worked": "$$\\begin{align*}8m^2n-6nm^2+m^2n&=(8-6+1)m^2n\\\\&=3m^2n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p32-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$7p^2q^2-2p^2q^2-4p^2q^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^2q^2$",
          "worked": "$$\\begin{align*}7p^2q^2-2p^2q^2-4p^2q^2&=(7-2-4)p^2q^2\\\\&=p^2q^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p32-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$2x^2y-4xy^2+5yx^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x^2y-4xy^2$",
          "worked": "$$\\begin{align*}2x^2y-4xy^2+5yx^2&=(2+5)x^2y-4xy^2\\\\&=7x^2y-4xy^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$10rs^2+3rs^2-6r^2s$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13rs^2-6r^2s$",
          "worked": "$$\\begin{align*}10rs^2+3rs^2-6r^2s&=(10+3)rs^2-6r^2s\\\\&=13rs^2-6r^2s\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2-7x-3x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2x^2-7x$",
          "worked": "$$\\begin{align*}x^2-7x-3x^2&=(1-3)x^2-7x\\\\&=-2x^2-7x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p32-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$a^2b-4ab^2+3a^2b+b^2a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2b-3ab^2$",
          "worked": "$$\\begin{align*}a^2b-4ab^2+3a^2b+b^2a&=a^2b+3a^2b-4ab^2+ab^2\\\\&=(1+3)a^2b+(-4+1)ab^2\\\\&=4a^2b-3ab^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q8-i",
        "type": "part",
        "label": "i",
        "prompt": "$10pq^2-2qp-3p^2q-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Already simplified.",
          "worked": "The variable parts are $pq^2$, $pq$ and $p^2q$, and $-6$ is a constant. There are no like terms to combine, so the expression is already simplified.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
