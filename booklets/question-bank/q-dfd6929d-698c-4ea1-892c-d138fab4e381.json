    "type": "question",
    "label": "16",
    "prompt": "Find the values of $p$ and $q$ such that $\\dfrac{\\sqrt{5}}{\\sqrt{5}-2}=p+q\\sqrt{5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=5$, $q=2$.",
      "worked": "$$\\begin{align*}\n\\frac{\\sqrt{5}}{\\sqrt{5}-2}&=\\frac{\\sqrt{5}}{\\sqrt{5}-2}\\times\\frac{\\sqrt{5}+2}{\\sqrt{5}+2}\\\\\n\\frac{\\sqrt{5}}{\\sqrt{5}-2}&=\\frac{5+2\\sqrt{5}}{5-4}\\\\\n\\frac{\\sqrt{5}}{\\sqrt{5}-2}&=5+2\\sqrt{5}.\n\\end{align*}$$\nComparing coefficients gives $p=5$ and $q=2$.",
      "solutionDiagrams": []
    },
