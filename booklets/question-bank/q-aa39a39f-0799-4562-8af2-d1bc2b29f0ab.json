    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "Graph the function $y=x(x+2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p29-q7-a-original",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "sharedSolutionDiagramId": "p29-q7-a-solution-graph",
            "answer": {
              "short": "$y=x(x+2)$ has vertex $(-1,-1)$ and $x$-intercepts $-2$ and $0$.",
              "worked": "$$\\begin{align*}y&=x(x+2)\\\\y&=(x+1)^2-1\\end{align*}$$\nPlot the vertex and intercepts and draw an upward-opening parabola.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 56,
            "responseSpace": "scaffold"
          },
          {
            "id": "p29-q7-a-i",
            "type": "part",
            "label": "i",
            "prompt": "The graph in part a is stretched horizontally by a factor of 2. Write down the equation of this new function and graph it on the same number plane.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "sharedSolutionDiagramId": "p29-q7-a-solution-graph",
            "answer": {
              "short": "$y=\\frac14x(x+4)$.",
              "worked": "$$\\begin{align*}y&=\\frac{x}{2}\\left(\\frac{x}{2}+2\\right)\\\\y&=\\frac14x(x+4)\\end{align*}$$\nDouble the original abscissas. The vertex becomes $(-2,-1)$ and the $x$-intercepts become $-4$ and $0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p29-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This graph is then stretched vertically by a factor of 3. Write down the equation of this new function and graph it on the same number plane.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "sharedSolutionDiagramId": "p29-q7-a-solution-graph",
            "answer": {
              "short": "$y=\\frac34x(x+4)$.",
              "worked": "$$\\begin{align*}y&=3\\left[\\frac14x(x+4)\\right]\\\\y&=\\frac34x(x+4)\\end{align*}$$\nTriple the ordinates of the graph in part i. The vertex becomes $(-2,-3)$ and the $x$-intercepts remain $-4$ and $0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          }
        ],
        "sharedSolutionDiagrams": [
          {
            "id": "p29-q7-a-solution-graph",
            "role": "solution",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"page 29 question 7a; answer page 39\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.7cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[->,line width=0.5pt] (-5.8,0)--(1.8,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,-3.7)--(0,4.2) node[above] {$y$};\n\\draw[<->,line width=0.8pt,domain=-3.2:1.2,samples=100] plot (\\x,{(\\x)*((\\x)+2)});\n\\draw[<->,line width=0.8pt,domain=-5.6:1.6,samples=100] plot (\\x,{(\\x)*((\\x)+4)/4});\n\\draw[<->,dashed,line width=0.8pt,domain=-5:1,samples=100] plot (\\x,{3*(\\x)*((\\x)+4)/4});\n\\node[anchor=south west] at (-3.9,0.2) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-4$\\special{dvisvgm:raw </g>}};\n\\node[anchor=north east] at (-2.05,-0.15) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-2$\\special{dvisvgm:raw </g>}};\n\\node[anchor=south west] at (-0.95,0.2) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\draw[line width=0.4pt] (0,-1)--(0.1,-1) (0,-3)--(0.1,-3);\n\\node[anchor=west] at (0.15,-1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[anchor=west] at (0.15,-3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
