  "content": {
    "id": "v2-540759-p8-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the common difference of the AP $2x+1,\\ 5x-2,\\ 8x-5,\\ldots$ Then find $x$ if $a_{8}=72$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$d=3x-3$, $x=4$.",
      "worked": "$$\\begin{align*}d&=(5x-2)-(2x+1)\\\\d&=3x-3\\end{align*}$$\n$$\\begin{align*}a_{8}&=72\\\\a+(8-1)d&=72\\\\(2x+1)+7(3x-3)&=72\\\\2x+1+21x-21&=72\\\\23x-20&=72\\\\23x&=92\\\\x&=4\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
