  "content": {
    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt[10]{16})^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(\\sqrt[10]{16})^5&=(16^{1/10})^5\\\\(\\sqrt[10]{16})^5&=16^{1/2}\\\\(\\sqrt[10]{16})^5&=\\sqrt{16}\\\\(\\sqrt[10]{16})^5&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt[3]{9})^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}(\\sqrt[3]{9})^6&=(9^{1/3})^6\\\\(\\sqrt[3]{9})^6&=9^2\\\\(\\sqrt[3]{9})^6&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt[12]{16})^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(\\sqrt[12]{16})^6&=(16^{1/12})^6\\\\(\\sqrt[12]{16})^6&=16^{1/2}\\\\(\\sqrt[12]{16})^6&=\\sqrt{16}\\\\(\\sqrt[12]{16})^6&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sqrt[3]{8})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(\\sqrt[3]{8})^2&=(8^{1/3})^2\\\\(\\sqrt[3]{8})^2&=8^{2/3}\\\\(\\sqrt[3]{8})^2&=2^2\\\\(\\sqrt[3]{8})^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt[9]{27})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}(\\sqrt[9]{27})^3&=(27^{1/9})^3\\\\(\\sqrt[9]{27})^3&=27^{1/3}\\\\(\\sqrt[9]{27})^3&=\\sqrt[3]{27}\\\\(\\sqrt[9]{27})^3&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt[12]{16})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}(\\sqrt[12]{16})^3&=(16^{1/12})^3\\\\(\\sqrt[12]{16})^3&=16^{1/4}\\\\(\\sqrt[12]{16})^3&=\\sqrt[4]{16}\\\\(\\sqrt[12]{16})^3&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$(\\sqrt[15]{1000})^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}(\\sqrt[15]{1000})^5&=(1000^{1/15})^5\\\\(\\sqrt[15]{1000})^5&=1000^{1/3}\\\\(\\sqrt[15]{1000})^5&=\\sqrt[3]{1000}\\\\(\\sqrt[15]{1000})^5&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$(\\sqrt[12]{64})^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(\\sqrt[12]{64})^4&=(64^{1/12})^4\\\\(\\sqrt[12]{64})^4&=64^{1/3}\\\\(\\sqrt[12]{64})^4&=\\sqrt[3]{64}\\\\(\\sqrt[12]{64})^4&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
