    "children": [
      {
        "id": "p44-q29-g",
        "type": "part",
        "label": "a",
        "prompt": "$P(A)\\times P(B)=P(A\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=22$",
          "worked": "$$\\begin{align*}\nP(A)\\times P(B)&=P(A\\cap B)\\\\\n\\frac{12}{14+x}\\times\\frac{3}{14+x}&=\\frac{1}{14+x}\\\\\n36&=14+x\\\\\nx&=22\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p44-q29-h",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\mid B)=P(A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=22$",
          "worked": "$$\\begin{align*}\nP(A\\mid B)&=P(A)\\\\\n\\frac{1}{3}&=\\frac{12}{14+x}\\\\\n14+x&=36\\\\\nx&=22\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
