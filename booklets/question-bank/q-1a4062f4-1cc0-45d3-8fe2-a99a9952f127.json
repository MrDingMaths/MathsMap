  "content": {
    "id": "p4-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{4x^2+6xy}{8x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x+3y}{4x}$",
          "worked": "$$\\begin{align*}\\frac{4x^2+6xy}{8x^2}&=\\frac{2x(2x+3y)}{2x\\cdot4x}\\\\&=\\frac{2x+3y}{4x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\dfrac{1}{x}-\\dfrac{1}{y}\\right)\\div(x-y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{xy}$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{x}-\\frac{1}{y}\\right)\\div(x-y)&=\\frac{y-x}{xy}\\times\\frac{1}{x-y}\\\\&=\\frac{-(x-y)}{xy(x-y)}\\\\&=-\\frac{1}{xy}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\dfrac{1}{x}+\\dfrac{1}{y}\\right)\\left(\\dfrac{1}{x}-\\dfrac{1}{y}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y^2-x^2}{y^2x^2}$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{x}+\\frac{1}{y}\\right)\\left(\\frac{1}{x}-\\frac{1}{y}\\right)&=\\frac{1}{x^2}-\\frac{1}{y^2}\\\\&=\\frac{y^2-x^2}{y^2x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
