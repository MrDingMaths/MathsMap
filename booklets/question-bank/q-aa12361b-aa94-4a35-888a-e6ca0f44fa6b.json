        "id": "v2-078cb-p18-practice-slot-6-slot-6-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that all three socks are white?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{44}$",
          "worked": "$$\\begin{aligned}P(WWW)&=\\frac{7}{12}\\times\\frac{6}{11}\\times\\frac{5}{10}\\\\P(WWW)&=\\frac{210}{1320}\\\\P(WWW)&=\\frac{7}{44}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-078cb-p18-practice-slot-6-slot-6-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that all three socks are the same colour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{44}$",
          "worked": "The socks are all white or all black. These outcomes are mutually exclusive.\n\n$$\\begin{aligned}P(BBB)&=\\frac{5}{12}\\times\\frac{4}{11}\\times\\frac{3}{10}\\\\P(BBB)&=\\frac{60}{1320}\\\\P(BBB)&=\\frac{1}{22}\\\\P(\\text{same colour})&=\\frac{7}{44}+\\frac{1}{22}\\\\P(\\text{same colour})&=\\frac{9}{44}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
