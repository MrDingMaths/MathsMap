  "content": {
    "id": "p29-q4",
    "type": "question",
    "label": "4",
    "prompt": "A circle with centre $B(4,5)$ passes through the origin. What is its equation?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-4)^2+(y-5)^2=41$",
      "worked": "Using Pythagoras from the centre to the origin,\n$$\\begin{align*}r^2&=(4-0)^2+(5-0)^2\\\\&=41.\\end{align*}$$\nHence the equation is\n$$(x-4)^2+(y-5)^2=41.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
