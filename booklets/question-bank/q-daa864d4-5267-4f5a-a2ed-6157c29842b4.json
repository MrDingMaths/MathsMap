  "content": {
    "id": "p33-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "An urn contains 8 red marbles, 7 white marbles and 5 black marbles. One marble is drawn at random from the urn. What is the probability that it is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "red or black?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{20}$",
          "worked": "There are $8+7+5=20$ marbles. Red and black are mutually exclusive.\n\n$$P(\\text{red or black})=\\frac{8+5}{20}=\\frac{13}{20}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "not white?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{20}$",
          "worked": "$$\\begin{align*}P(\\text{not white})&=1-P(\\text{white})\\\\P(\\text{not white})&=1-\\frac{7}{20}\\\\P(\\text{not white})&=\\frac{13}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "neither black nor white?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "A marble that is neither black nor white is red.\n\n$$P(\\text{neither black nor white})=\\frac{8}{20}=\\frac{2}{5}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
