    "type": "question",
    "label": "11",
    "prompt": "A cylindrical wire in an electrical circuit has radius $3.41\\times10^{-4}$ m and length $8.02\\times10^{-2}$ m. Calculate its volume in $\\text{m}^3$, correct to three significant figures, giving the answer in scientific notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2.93\\times10^{-8}\\text{ m}^3$",
      "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\V&=\\pi(3.41\\times10^{-4})^2(8.02\\times10^{-2})\\\\V&=\\pi\\times3.41^2\\times8.02\\times10^{-10}\\\\V&\\approx2.93\\times10^{-8}\\text{ m}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
