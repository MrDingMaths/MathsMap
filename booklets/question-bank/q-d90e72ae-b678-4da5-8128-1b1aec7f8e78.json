    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "If Samira can paint 7 rooms in 3 hours, then how many rooms can she paint in 4 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\frac{1}{3}$ rooms",
          "worked": "Assuming a constant painting rate:\n$$\\begin{align*}\\text{Rooms painted in 1 hour}&=\\frac{7}{3}\\\\\\text{Rooms painted in 4 hours}&=\\frac{7}{3}\\times4\\\\\\text{Rooms painted in 4 hours}&=9\\frac{1}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If Akira can paint 8 rooms in 5 hours, then how many hours will it take her to paint 3 rooms?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{7}{8}$ hours",
          "worked": "Assuming a constant painting rate:\n$$\\begin{align*}\\text{Time for 1 room}&=\\frac{5}{8}\\text{ hours}\\\\\\text{Time for 3 rooms}&=\\frac{5}{8}\\times3\\text{ hours}\\\\\\text{Time for 3 rooms}&=1\\frac{7}{8}\\text{ hours}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "If Rita can paint 3 rooms in 2 hours, then how many hours will it take her to paint 5 rooms?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{1}{3}$ hours",
          "worked": "Assuming a constant painting rate:\n$$\\begin{align*}\\text{Time for 1 room}&=\\frac{2}{3}\\text{ hours}\\\\\\text{Time for 5 rooms}&=\\frac{2}{3}\\times5\\text{ hours}\\\\\\text{Time for 5 rooms}&=3\\frac{1}{3}\\text{ hours}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "If Hannah can paint 5 rooms in 3 hours, then how many rooms will she paint in 7 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11\\frac{2}{3}$ rooms",
          "worked": "Assuming a constant painting rate:\n$$\\begin{align*}\\text{Rooms painted in 1 hour}&=\\frac{5}{3}\\\\\\text{Rooms painted in 7 hours}&=\\frac{5}{3}\\times7\\\\\\text{Rooms painted in 7 hours}&=11\\frac{2}{3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
