  "content": {
    "id": "v2-d9222-p10-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the centre of the circle with diameter:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d9222-p10-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$EF$, where $E=(-4,3)$ and $F=(6,9)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,6)$",
          "worked": "The centre is the midpoint of the diameter.\n$$\\begin{aligned}\n\\text{Centre}&=\\left(\\frac{-4+6}{2},\\frac{3+9}{2}\\right)\\\\\n&=(1,6).\n\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-d9222-p10-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$GH$, where $G=(5,-6)$ and $H=(-2,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac32,-\\frac52\\right)$",
          "worked": "The centre is the midpoint of the diameter.\n$$\\begin{aligned}\n\\text{Centre}&=\\left(\\frac{5+(-2)}{2},\\frac{-6+1}{2}\\right)\\\\\n&=\\left(\\frac32,-\\frac52\\right).\n\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
