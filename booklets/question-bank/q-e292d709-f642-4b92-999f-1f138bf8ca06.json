        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x(3x-2)$",
          "worked": "The HCF is $4x$.\n$$\\begin{aligned}12x^2-8x&=4x\\left(\\frac{12x^2}{4x}-\\frac{8x}{4x}\\right)\\\\12x^2-8x&=4x(3x-2)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
