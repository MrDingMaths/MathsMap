  "content": {
    "id": "p61-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "Find exact values of $x$ for which the gradient of the tangent to the curve $y=2x(x+3)^2$ is $14$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\dfrac{-6\\pm\\sqrt{30}}{3}$.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2(x+3)^2+4x(x+3)\\\\\\frac{dy}{dx}&=2(x+3)(3x+3)\\\\\\frac{dy}{dx}&=6(x+3)(x+1).\\end{align*}$$\nSet the derivative equal to the given gradient:\n$$\\begin{align*}6(x+3)(x+1)&=14\\\\3x^2+12x+9&=7\\\\3x^2+12x+2&=0\\\\x&=\\frac{-12\\pm\\sqrt{12^2-4(3)(2)}}{2(3)}\\\\x&=\\frac{-12\\pm\\sqrt{120}}{6}\\\\x&=\\frac{-6\\pm\\sqrt{30}}{3}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 53
  },
