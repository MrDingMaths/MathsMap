          "worked": "$$\\begin{align*}\\text{Total}&=18+21+12+7+3\\\\\\text{Total}&=61\\\\\\text{Percentage}&=\\frac{18+21}{61}\\times100\\%\\\\\\text{Percentage}&\\approx64\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
