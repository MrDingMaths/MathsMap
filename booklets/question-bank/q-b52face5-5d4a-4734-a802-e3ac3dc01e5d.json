  "content": {
    "id": "p29-river-rate-bridge-root",
    "type": "question",
    "label": "25",
    "prompt": "A swimmer travels at 5 km/h in still water. A river flows at 1 km/h. The swimmer travels 6 km downstream, then returns 6 km upstream. Add the current downstream and subtract it upstream. The distances are equal, but the travel times differ.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-river-rate-bridge-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the downstream and upstream speeds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ km/h}$ downstream; $4\\text{ km/h}$ upstream.",
          "worked": "Downstream: $5+1=6\\text{ km/h}$. Upstream: $5-1=4\\text{ km/h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-river-rate-bridge-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the time for each 6 km leg.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\text{ h}$ downstream; $1.5\\text{ h}$ upstream.",
          "worked": "$$\\begin{align*}\\text{Downstream time}&=\\frac{6}{6}=1\\text{ h}\\\\\\text{Upstream time}&=\\frac{6}{4}=1.5\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p29-river-rate-bridge-c",
        "type": "part",
        "label": "c",
        "prompt": "Add the two travel times to find the total time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.5\\text{ h}$",
          "worked": "$$1+1.5=2.5\\text{ h}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
