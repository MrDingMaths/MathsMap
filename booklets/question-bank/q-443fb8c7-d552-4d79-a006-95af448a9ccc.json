  "content": {
    "id": "p97-q23-root",
    "type": "question",
    "label": null,
    "prompt": "The force $F$ between two magnets varies directly with the product of their strengths $S_1$ and $S_2$ and inversely with the square of the distance $r$ between them. Suppose $F = 24$ when $S_1 = 2$, $S_2 = 3$, and $r = 2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p97-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 16$",
          "worked": "The direct factors $S_1S_2$ form the numerator, and the inverse-square factor $r^2$ forms the denominator.\n\n$$\\begin{align*}F &= \\frac{kS_1S_2}{r^2} \\\\ 24 &= \\frac{k(2)(3)}{2^2} \\\\ k &= \\frac{24\\times 2^2}{2\\times 3} \\\\ k &= 16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p97-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $F$ when $S_1 = 3$, $S_2 = 4$, and $r = 4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F = 12$",
          "worked": "Using $k = 16$,\n\n$$\\begin{align*}F &= \\frac{16\\times 3\\times 4}{4^2} \\\\ F &= 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
