        "id": "p19-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$3+\\log_2 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 40$",
          "worked": "$$\\begin{align*}3+\\log_2 5&=\\log_2 8+\\log_2 5\\\\3+\\log_2 5&=\\log_2(8\\times5)\\\\3+\\log_2 5&=\\log_2 40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$5-\\log_2 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2\\left(\\frac{32}{5}\\right)$",
          "worked": "$$\\begin{align*}5-\\log_2 5&=\\log_2 32-\\log_2 5\\\\5-\\log_2 5&=\\log_2\\left(\\frac{32}{5}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
