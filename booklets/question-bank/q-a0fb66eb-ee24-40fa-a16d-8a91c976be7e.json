  "content": {
    "id": "p12-q18-root",
    "type": "question",
    "label": null,
    "prompt": "Find the coefficient of $x^{10}$ in the expansion of $$(2+x^2)^8.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$448$",
      "worked": "$$\\begin{align*}T_k&=\\binom{8}{k}2^{8-k}(x^2)^k\\\\T_k&=\\binom{8}{k}2^{8-k}x^{2k}\\\\2k&=10\\\\k&=5\\end{align*}$$\nThe coefficient of $x^{10}$ is\n$$\\begin{align*}\\binom{8}{5}2^3&=56\\times8\\\\\\binom{8}{5}2^3&=448.\\end{align*}$$",
      "solutionDiagrams": []
    },
