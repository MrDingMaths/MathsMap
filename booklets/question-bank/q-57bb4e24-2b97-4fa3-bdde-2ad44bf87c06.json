  "content": {
    "id": "p17-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Let $k$ be any real number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the discriminant of $x^2+kx+k^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3k^2$",
          "worked": "$$\\begin{align*}\\Delta&=k^2-4(1)(k^2)\\\\\\Delta&=-3k^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p17-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "State the value of $k$ for which $x^2+kx+k^2=0$ will have one real root.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=0$",
          "worked": "There is one distinct real root when $\\Delta=0$. The equation $-3k^2=0$ gives $k=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p17-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "For values of $k$ other than this value, how many real roots does this quadratic have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real roots.",
          "worked": "For $k\\ne 0$, $k^2>0$, so $\\Delta=-3k^2<0$ and the quadratic has no real roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
