    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Draw a right-angled triangle with angle $\\theta$ for which $\\tan\\theta=\\frac34$. Find $\\sin\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sin\\theta=\\frac35$",
      "worked": "Choose opposite side $3$ and adjacent side $4$.\n$$\\begin{align*}h^2&=3^2+4^2\\\\h^2&=25\\\\h&=5\\\\\\sin\\theta&=\\frac35\\end{align*}$$",
