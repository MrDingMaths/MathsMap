  "content": {
    "id": "p12-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Let $P$ be the point where $x=4$ on the curve $y=\\sqrt{x}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the tangent at $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "Write $y=x^{\\frac12}$ and apply the power rule.\n\n$$\\begin{align*}y'&=\\frac12 x^{-\\frac12}\\\\y'&=\\frac{1}{2\\sqrt{x}}\\\\\\left.y'\\right|_{x=4}&=\\frac{1}{2\\sqrt4}\\\\\\left.y'\\right|_{x=4}&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coordinates of $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,2)$",
          "worked": "At $x=4$, $y=\\sqrt4=2$, so $P=(4,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the equation of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac14x+1$",
          "worked": "Use gradient $\\frac14$ and the point $(4,2)$.\n\n$$\\begin{align*}y-2&=\\frac14(x-4)\\\\y-2&=\\frac14x-1\\\\y&=\\frac14x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q8-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p12-q8-d-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "State the gradient of the normal. ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$-4$",
                  "width": 11
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "The normal gradient is the negative reciprocal of $\\frac14$, so it is $-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p12-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "Hence, find the equation of the normal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+18$",
          "worked": "Use gradient $-4$ and the point $(4,2)$.\n\n$$\\begin{align*}y-2&=-4(x-4)\\\\y-2&=-4x+16\\\\y&=-4x+18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
