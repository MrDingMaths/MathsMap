  "content": {
    "id": "p7-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Given that $\\cos\\theta=\\frac{3}{5}$ where $0\\le\\theta\\le\\frac{\\pi}{2}$, find $\\tan 2\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac{24}{7}$",
      "worked": "Since $\\theta$ is in Quadrant I, $\\sin\\theta>0$.\n$$\\begin{align*}\\sin\\theta&=\\sqrt{1-\\left(\\frac35\\right)^2}\\\\\\sin\\theta&=\\frac45\\\\\\tan\\theta&=\\frac{4/5}{3/5}\\\\\\tan\\theta&=\\frac43\\\\\\tan 2\\theta&=\\frac{2\\tan\\theta}{1-\\tan^2\\theta}\\\\\\tan 2\\theta&=\\frac{2(4/3)}{1-(4/3)^2}\\\\\\tan 2\\theta&=\\frac{8/3}{-7/9}\\\\\\tan 2\\theta&=-\\frac{24}{7}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
