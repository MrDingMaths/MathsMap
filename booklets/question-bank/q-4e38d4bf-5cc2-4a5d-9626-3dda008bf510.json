        "type": "part",
        "label": "a",
        "prompt": "Show that 12 is the smallest abundant number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$ is the smallest abundant number.\n\nThe proper-divisor sums for $1$ to $11$ do not exceed the corresponding numbers; for $12$, the sum is $16>12$.",
