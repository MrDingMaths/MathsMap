              {
                "id": "p17-q7-a-worked-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For each number below 12, the sum does not exceed the number itself. Since ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "16>12",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", 12 is the smallest abundant number.",
