    "label": "4",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "The first term of an infinite geometric series is 2 and the common ratio is $\\frac13$. Find the sum.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac{2}{1-\\frac13}\\\\S&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The first term of an infinite geometric series is 3 and the sum is 4. Find the common ratio.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\frac14$",
          "worked": "$$\\begin{align*}4&=\\frac{3}{1-r}\\\\4(1-r)&=3\\\\1-r&=\\frac34\\\\r&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The common ratio of an infinite geometric series is $\\frac34$ and the sum is 6. Find the first term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac32$",
          "worked": "$$\\begin{align*}6&=\\frac{a}{1-\\frac34}\\\\a&=6\\left(1-\\frac34\\right)\\\\a&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
