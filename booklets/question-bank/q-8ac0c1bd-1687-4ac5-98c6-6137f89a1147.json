    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}+\\dfrac{x^5}{5}+C$",
          "worked": "$$\\begin{align*}f(x)&=\\frac{x^{2+1}}{2+1}+\\frac{x^{4+1}}{4+1}+C\\\\f(x)&=\\frac{x^3}{3}+\\frac{x^5}{5}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x^3-5x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-x^5+C$",
          "worked": "$$\\begin{align*}f(x)&=\\frac{4x^4}{4}-\\frac{5x^5}{5}+C\\\\f(x)&=x^4-x^5+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2+5x^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x^3}{3}+\\dfrac{5x^8}{8}+C$",
          "worked": "$$\\begin{align*}f(x)&=2\\left(\\frac{x^3}{3}\\right)+5\\left(\\frac{x^8}{8}\\right)+C\\\\f(x)&=\\frac{2x^3}{3}+\\frac{5x^8}{8}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}-\\dfrac{x^2}{2}+x+C$",
          "worked": "$$\\begin{align*}f(x)&=\\frac{x^{2+1}}{2+1}-\\frac{x^{1+1}}{1+1}+x+C\\\\f(x)&=\\frac{x^3}{3}-\\frac{x^2}{2}+x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$3-4x+16x^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-2x^2+2x^8+C$",
          "worked": "$$\\begin{align*}f(x)&=3x-\\frac{4x^2}{2}+\\frac{16x^8}{8}+C\\\\f(x)&=3x-2x^2+2x^8+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x^2-4x^3-5x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-x^4-x^5+C$",
          "worked": "$$\\begin{align*}f(x)&=\\frac{3x^3}{3}-\\frac{4x^4}{4}-\\frac{5x^5}{5}+C\\\\f(x)&=x^3-x^4-x^5+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
