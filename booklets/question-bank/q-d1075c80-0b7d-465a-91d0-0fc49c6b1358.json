  "content": {
    "id": "p5-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The area of a rectangle is $x\\text{ cm}^2$. The length of the rectangle is $4\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression in terms of $x$ for the width of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{4}\\text{ cm}$",
          "worked": "$$\\begin{align*}x&=4w\\\\w&=\\frac{x}{4}\\end{align*}$$\nThe width is $\\dfrac{x}{4}\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Write a formula for the perimeter $P\\text{ cm}$ of the rectangle in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=\\dfrac{x}{2}+8$",
          "worked": "$$\\begin{align*}P&=2(\\ell+w)\\\\P&=2\\left(4+\\frac{x}{4}\\right)\\\\P&=8+\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p5-q9-c",
        "type": "group",
        "label": "c",
        "prompt": "Find $P$ if:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p5-q9-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$x=10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$13\\text{ cm}$",
              "worked": "$$\\begin{align*}P&=\\frac{x}{2}+8\\\\P&=\\frac{10}{2}+8\\\\P&=13\\end{align*}$$\nThe perimeter is $13\\text{ cm}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p5-q9-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x=24$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$20\\text{ cm}$",
              "worked": "$$\\begin{align*}P&=\\frac{x}{2}+8\\\\P&=\\frac{24}{2}+8\\\\P&=20\\end{align*}$$\nThe perimeter is $20\\text{ cm}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      },
      {
        "id": "p5-q9-d",
        "type": "group",
