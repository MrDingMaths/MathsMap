  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify each of the following, expressing your answer using positive indices:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$6\\sqrt{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6^{3/2}$",
          "worked": "$$\\begin{align*}6\\sqrt{6}&=6^1\\times6^{1/2}\\\\6\\sqrt{6}&=6^{1+1/2}\\\\6\\sqrt{6}&=6^{3/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$3\\sqrt[3]{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{4/3}$",
          "worked": "$$\\begin{align*}3\\sqrt[3]{3}&=3^1\\times3^{1/3}\\\\3\\sqrt[3]{3}&=3^{1+1/3}\\\\3\\sqrt[3]{3}&=3^{4/3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{5}\\sqrt[3]{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{5/6}$",
          "worked": "$$\\begin{align*}\\sqrt{5}\\sqrt[3]{5}&=5^{1/2}\\times5^{1/3}\\\\\\sqrt{5}\\sqrt[3]{5}&=5^{1/2+1/3}\\\\\\sqrt{5}\\sqrt[3]{5}&=5^{5/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{7}\\sqrt[4]{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{7/12}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{7}\\sqrt[4]{7}&=7^{1/3}\\times7^{1/4}\\\\\\sqrt[3]{7}\\sqrt[4]{7}&=7^{1/3+1/4}\\\\\\sqrt[3]{7}\\sqrt[4]{7}&=7^{7/12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$5^2\\times\\sqrt[3]{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{7/3}$",
          "worked": "$$\\begin{align*}5^2\\times\\sqrt[3]{5}&=5^2\\times5^{1/3}\\\\5^2\\times\\sqrt[3]{5}&=5^{2+1/3}\\\\5^2\\times\\sqrt[3]{5}&=5^{7/3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$3^4\\times\\sqrt[4]{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{17/4}$",
          "worked": "$$\\begin{align*}3^4\\times\\sqrt[4]{3}&=3^4\\times3^{1/4}\\\\3^4\\times\\sqrt[4]{3}&=3^{4+1/4}\\\\3^4\\times\\sqrt[4]{3}&=3^{17/4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$(\\sqrt[3]{2})^2\\times\\sqrt[3]{2^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(\\sqrt[3]{2})^2\\times\\sqrt[3]{2^4}&=2^{2/3}\\times2^{4/3}\\\\(\\sqrt[3]{2})^2\\times\\sqrt[3]{2^4}&=2^{2/3+4/3}\\\\(\\sqrt[3]{2})^2\\times\\sqrt[3]{2^4}&=2^2\\\\(\\sqrt[3]{2})^2\\times\\sqrt[3]{2^4}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$(\\sqrt[3]{7})^4\\times\\sqrt[4]{7^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{25/12}$",
          "worked": "$$\\begin{align*}(\\sqrt[3]{7})^4\\times\\sqrt[4]{7^3}&=7^{4/3}\\times7^{3/4}\\\\(\\sqrt[3]{7})^4\\times\\sqrt[4]{7^3}&=7^{4/3+3/4}\\\\(\\sqrt[3]{7})^4\\times\\sqrt[4]{7^3}&=7^{25/12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt[2]{d}\\sqrt[3]{d}\\sqrt[4]{d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d^{13/12}$",
          "worked": "$$\\begin{align*}\\sqrt[2]{d}\\sqrt[3]{d}\\sqrt[4]{d}&=d^{1/2}d^{1/3}d^{1/4}\\\\\\sqrt[2]{d}\\sqrt[3]{d}\\sqrt[4]{d}&=d^{1/2+1/3+1/4}\\\\\\sqrt[2]{d}\\sqrt[3]{d}\\sqrt[4]{d}&=d^{13/12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\sqrt[3]{c^4}\\sqrt[4]{c^5}\\sqrt[5]{c^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c^{227/60}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{c^4}\\sqrt[4]{c^5}\\sqrt[5]{c^6}&=c^{4/3}c^{5/4}c^{6/5}\\\\\\sqrt[3]{c^4}\\sqrt[4]{c^5}\\sqrt[5]{c^6}&=c^{4/3+5/4+6/5}\\\\\\sqrt[3]{c^4}\\sqrt[4]{c^5}\\sqrt[5]{c^6}&=c^{(80+75+72)/60}\\\\\\sqrt[3]{c^4}\\sqrt[4]{c^5}\\sqrt[5]{c^6}&=c^{227/60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{\\sqrt[3]{x}}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{x^{1/6}}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt[3]{x}}{\\sqrt{x}}&=\\frac{x^{1/3}}{x^{1/2}}\\\\\\frac{\\sqrt[3]{x}}{\\sqrt{x}}&=x^{1/3-1/2}\\\\\\frac{\\sqrt[3]{x}}{\\sqrt{x}}&=x^{-1/6}\\\\\\frac{\\sqrt[3]{x}}{\\sqrt{x}}&=\\frac{1}{x^{1/6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{a\\sqrt[4]{a}}{\\sqrt[3]{a}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{11/12}$",
          "worked": "$$\\begin{align*}\\frac{a\\sqrt[4]{a}}{\\sqrt[3]{a}}&=\\frac{a^1a^{1/4}}{a^{1/3}}\\\\\\frac{a\\sqrt[4]{a}}{\\sqrt[3]{a}}&=a^{1+1/4-1/3}\\\\\\frac{a\\sqrt[4]{a}}{\\sqrt[3]{a}}&=a^{11/12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
