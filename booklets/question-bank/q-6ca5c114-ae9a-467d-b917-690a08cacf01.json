    "children": [
      {
        "id": "p43-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the discriminant of $x^2-(p+1)x+p-1=0$ is $\\Delta=(p-1)^2+4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=p^2-2p+5=(p-1)^2+4$.",
          "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=[-(p+1)]^2-4(1)(p-1)\\\\\\Delta&=p^2+2p+1-4p+4\\\\\\Delta&=p^2-2p+5\\\\\\Delta&=(p-1)^2+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p43-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence explain why the parabola will always have two $x$-intercepts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=(p-1)^2+4>0$ for every real $p$, so there are two distinct $x$-intercepts.",
          "worked": "Since $(p-1)^2\\geq0$, $\\Delta=(p-1)^2+4\\geq4>0$. A positive discriminant gives two distinct real solutions, so the parabola always has two $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
