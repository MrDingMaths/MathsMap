        "prompt": "$\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{x^3}}{3}+C$",
          "worked": "$\\sqrt{x}=x^{1/2}$\n\n$\\begin{aligned}F(x)&=\\frac{x^{3/2}}{\\frac{3}{2}}+C\\\\F(x)&=\\frac{2\\sqrt{x^3}}{3}+C\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{2x^2}+C$",
          "worked": "$\\begin{aligned}F(x)&=\\frac{x^{-2}}{-2}+C\\\\F(x)&=-\\frac{1}{2x^2}+C\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{x^8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{7x^7}+C$",
          "worked": "$\\dfrac{1}{x^8}=x^{-8}$\n\n$\\begin{aligned}F(x)&=\\frac{x^{-7}}{-7}+C\\\\F(x)&=-\\frac{1}{7x^7}+C\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p7-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\sqrt{x}}+\\dfrac{2}{\\sqrt[3]{x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{x}+6\\sqrt[3]{x}+C$",
          "worked": "$\\dfrac{1}{\\sqrt{x}}+\\dfrac{2}{\\sqrt[3]{x^2}}=x^{-1/2}+2x^{-2/3}$\n\n$\\begin{aligned}F(x)&=\\frac{x^{1/2}}{\\frac{1}{2}}+\\frac{2x^{1/3}}{\\frac{1}{3}}+C\\\\F(x)&=2\\sqrt{x}+6\\sqrt[3]{x}+C\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
