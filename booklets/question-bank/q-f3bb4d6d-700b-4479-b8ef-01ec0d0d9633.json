  "content": {
    "id": "p13-p3",
    "type": "question",
    "label": "3",
    "prompt": "Solve $\\log_8(x)+\\log_4(x)=5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=64$",
      "worked": "The logarithms require $x>0$. Since $8=2^3$ and $4=2^2$, change both logarithms to base $2$.\n\n$$\\begin{align*}\\frac{\\log_2 x}{3}+\\frac{\\log_2 x}{2}&=5\\\\\\frac56\\log_2 x&=5\\\\\\log_2 x&=6\\\\x&=2^6\\\\x&=64\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
  },
