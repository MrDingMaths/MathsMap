  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The kinetic energy $E$ joules of a moving object is given by $E=\\frac{1}{2}mv^2$, where $m$ kg is the mass of the object and $v$ m/s is its speed.\n\nRearrange the formula to make $m$ the subject and use this to find the mass of the object when its energy and speed are, respectively:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "400 joules, 10 m/s",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{2E}{v^2}$; $8\\text{ kg}$.",
          "worked": "$$\\begin{align*}E&=\\frac{1}{2}mv^2\\\\2E&=mv^2\\\\m&=\\frac{2E}{v^2}\\\\m&=\\frac{2\\times400}{10^2}\\\\m&=\\frac{800}{100}\\\\m&=8\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p13-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "28 joules, 4 m/s",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{2E}{v^2}$; $3.5\\text{ kg}$.",
          "worked": "$$\\begin{align*}E&=\\frac{1}{2}mv^2\\\\2E&=mv^2\\\\m&=\\frac{2E}{v^2}\\\\m&=\\frac{2\\times28}{4^2}\\\\m&=\\frac{56}{16}\\\\m&=3.5\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p13-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "57.6 joules, 2.4 m/s",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{2E}{v^2}$; $20\\text{ kg}$.",
          "worked": "$$\\begin{align*}E&=\\frac{1}{2}mv^2\\\\2E&=mv^2\\\\m&=\\frac{2E}{v^2}\\\\m&=\\frac{2\\times57.6}{2.4^2}\\\\m&=\\frac{115.2}{5.76}\\\\m&=20\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
