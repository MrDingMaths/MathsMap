  "content": {
    "id": "p35-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Let $\\theta$ be such that $\\sec\\theta-\\tan\\theta=2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sec\\theta+\\tan\\theta=\\dfrac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q16-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\sec\\theta+\\tan\\theta=\\dfrac12",
                    "display": false
                  }
                ]
              },
              {
                "id": "p35-q16-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Factorise ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\sec^2\\theta-\\tan^2\\theta=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and substitute the given difference.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\sec^2\\theta-\\tan^2\\theta&=1\\\\(\\sec\\theta-\\tan\\theta)(\\sec\\theta+\\tan\\theta)&=1\\\\2(\\sec\\theta+\\tan\\theta)&=1\\\\\\sec\\theta+\\tan\\theta&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p35-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the exact value of $\\sec\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac54$",
          "worked": "Add the given relationship and the result from part (a).\n\n$$\\begin{align*}2\\sec\\theta&=2+\\frac12\\\\2\\sec\\theta&=\\frac52\\\\\\sec\\theta&=\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p35-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, or otherwise, find the exact value of $\\sin\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q16-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "-\\dfrac35",
                    "display": false
                  }
                ]
              },
              {
                "id": "p35-q16-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Find ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\tan\\theta=\\sec\\theta-2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\sin\\theta=\\dfrac{\\tan\\theta}{\\sec\\theta}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\tan\\theta&=\\sec\\theta-2\\\\\\tan\\theta&=\\frac54-2\\\\\\tan\\theta&=-\\frac34\\end{align*}$$\n\nSince $\\tan\\theta=\\dfrac{\\sin\\theta}{\\cos\\theta}$ and $\\sec\\theta=\\dfrac1{\\cos\\theta}$,\n\n$$\\begin{align*}\\sin\\theta&=\\frac{\\tan\\theta}{\\sec\\theta}\\\\\\sin\\theta&=\\frac{-3/4}{5/4}\\\\\\sin\\theta&=-\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
