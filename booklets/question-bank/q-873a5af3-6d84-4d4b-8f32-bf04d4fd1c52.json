  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Evaluate these expressions for $x=8$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{5x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\frac{5x}{4}&=\\frac{5\\times8}{4}\\\\\\frac{5x}{4}&=\\frac{40}{4}\\\\\\frac{5x}{4}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac{2}{5}$",
          "worked": "$$\\begin{align*}\\frac{4x}{5}&=\\frac{4\\times8}{5}\\\\\\frac{4x}{5}&=\\frac{32}{5}\\\\\\frac{4x}{5}&=6\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3(x+5)}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{9}{10}$",
          "worked": "$$\\begin{align*}\\frac{3(x+5)}{10}&=\\frac{3(8+5)}{10}\\\\\\frac{3(x+5)}{10}&=\\frac{39}{10}\\\\\\frac{3(x+5)}{10}&=3\\frac{9}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2x}{5}+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\frac{2x}{5}+12&=\\frac{2\\times8}{5}+12\\\\\\frac{2x}{5}+12&=3\\frac{1}{5}+12\\\\\\frac{2x}{5}+12&=15\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$6\\left(\\frac{x-2}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\frac{1}{5}$",
          "worked": "$$\\begin{align*}6\\left(\\frac{x-2}{5}\\right)&=6\\left(\\frac{8-2}{5}\\right)\\\\6\\left(\\frac{x-2}{5}\\right)&=6\\times\\frac{6}{5}\\\\6\\left(\\frac{x-2}{5}\\right)&=\\frac{36}{5}\\\\6\\left(\\frac{x-2}{5}\\right)&=7\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$25-\\frac{5x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}25-\\frac{5x}{2}&=25-\\frac{5\\times8}{2}\\\\25-\\frac{5x}{2}&=25-20\\\\25-\\frac{5x}{2}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{5x-8}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac{2}{5}$",
          "worked": "$$\\begin{align*}\\frac{5x-8}{5}&=\\frac{5\\times8-8}{5}\\\\\\frac{5x-8}{5}&=\\frac{32}{5}\\\\\\frac{5x-8}{5}&=6\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{3x-4}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{3x-4}{3}&=\\frac{3\\times8-4}{3}\\\\\\frac{3x-4}{3}&=\\frac{20}{3}\\\\\\frac{3x-4}{3}&=6\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
