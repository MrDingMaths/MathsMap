  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Rewrite each expression as a single power of $x$ using fractional indices.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac{5}{2}}$",
          "worked": "$$\\begin{align*}x^2\\sqrt{x}&=x^2x^{\\frac12}\\\\x^2\\sqrt{x}&=x^{2+\\frac12}\\\\x^2\\sqrt{x}&=x^{\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sqrt{x}}{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-\\frac{5}{2}}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{x}}{x^3}&=\\frac{x^{\\frac12}}{x^3}\\\\\\frac{\\sqrt{x}}{x^3}&=x^{\\frac12-3}\\\\\\frac{\\sqrt{x}}{x^3}&=x^{-\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3\\sqrt[3]{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac{11}{3}}$",
          "worked": "$$\\begin{align*}x^3\\sqrt[3]{x^2}&=x^3x^{\\frac23}\\\\x^3\\sqrt[3]{x^2}&=x^{3+\\frac23}\\\\x^3\\sqrt[3]{x^2}&=x^{\\frac{11}{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{\\sqrt[3]{x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac13}$",
          "worked": "$$\\begin{align*}\\frac{x}{\\sqrt[3]{x^2}}&=\\frac{x^1}{x^{\\frac23}}\\\\\\frac{x}{\\sqrt[3]{x^2}}&=x^{1-\\frac23}\\\\\\frac{x}{\\sqrt[3]{x^2}}&=x^{\\frac13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
