    "id": "v2-04320-p16-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "A regular pentagon has been enlarged by scale factor 3. The image has a perimeter of 45 cm.\nWhat is the length of each side of the original pentagon?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\text{ cm}$",
      "worked": "A regular pentagon has five equal sides.\n$$\\begin{align*}\\text{Image side length}&=45\\div5\\\\&=9\\text{ cm}\\\\\\text{Original side length}&=9\\div3\\\\&=3\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
