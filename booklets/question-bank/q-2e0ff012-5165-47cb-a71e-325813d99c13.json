    "type": "question",
    "label": "4",
    "prompt": "A bottle is 13% full and currently holds 143 mL. What is the capacity of the bottle?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1100\\text{ mL}$",
      "worked": "$$\\begin{align*}13\\%&=143\\text{ mL}\\\\1\\%&=\\frac{143}{13}\\text{ mL}=11\\text{ mL}\\\\100\\%&=11\\times100\\text{ mL}=1100\\text{ mL}\\end{align*}$$\nThe capacity of the bottle is $1100\\text{ mL}$.",
      "solutionDiagrams": []
    },
