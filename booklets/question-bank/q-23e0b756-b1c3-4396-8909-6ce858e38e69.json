  "content": {
    "id": "p29-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A book shop has a 50% sale on all stock, and has a container of books with the sale price reduced by a further factor of 16%.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the total discount on each book in the container?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "58%",
          "worked": "$$\\begin{align*}\\text{Final price}&=\\text{original price}\\times0.50\\times0.84\\\\\\text{Final price}&=\\text{original price}\\times0.42\\\\\\text{Total discount}&=100\\%-42\\%\\\\\\text{Total discount}&=58\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If a book in the container is now selling for $\\$10.50$, what was its original price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$25$",
          "worked": "$$\\begin{align*}\\text{Original price}&=\\text{final price}\\div(0.50\\times0.84)\\\\\\text{Original price}&=10.50\\div0.42\\\\\\text{Original price}&=\\$25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
