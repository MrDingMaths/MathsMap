      {
        "id": "v2-07451-p39-practice-slot-2-slot-2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=e^{2x+y}$, with $y(0)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln\\left(\\dfrac{2}{3-e^{2x}}\\right)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=e^{2x}e^{y}\\\\e^{-y}\\,dy&=e^{2x}\\,dx\\\\-e^{-y}&=\\frac{e^{2x}}{2}+C\\end{align*}$$\nUsing $y(0)=0$:\n$$\\begin{align*}-1&=\\frac12+C\\\\C&=-\\frac32\\\\e^{-y}&=\\frac{3-e^{2x}}{2}\\\\y&=\\ln\\left(\\frac{2}{3-e^{2x}}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-07451-p39-practice-slot-2-slot-2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{dy}{dx}=e^{3x-2y}$, with $y(0)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac12\\ln\\left(\\dfrac{2e^{3x}+1}{3}\\right)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=e^{3x}e^{-2y}\\\\e^{2y}\\,dy&=e^{3x}\\,dx\\\\\\frac{e^{2y}}{2}&=\\frac{e^{3x}}{3}+C\\end{align*}$$\nUsing $y(0)=0$:\n$$\\begin{align*}\\frac12&=\\frac13+C\\\\C&=\\frac16\\\\e^{2y}&=\\frac{2e^{3x}+1}{3}\\\\y&=\\frac12\\ln\\left(\\frac{2e^{3x}+1}{3}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
