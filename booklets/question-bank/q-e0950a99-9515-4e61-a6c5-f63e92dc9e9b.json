  "content": {
    "id": "v2-onential-modelling-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Algae covers 5 m$^2$ of a farm dam and doubles its area every 3 days. Find when the algae will cover 2000 m$^2$, to 1 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "25.9 days",
      "worked": "$$\\begin{align*}t=0:\\ A&=5\\times2^0\\\\t=3:\\ A&=5\\times2^1\\\\t=6:\\ A&=5\\times2^2\\end{align*}$$\nThere are $\\frac{t}{3}$ doubling periods in $t$ days, so $A=5\\times2^{\\frac{t}{3}}$.\n$$\\begin{align*}2000&=5\\times2^{\\frac{t}{3}}\\\\400&=2^{\\frac{t}{3}}\\\\\\frac{t}{3}&=\\log_2 400\\\\t&=3\\log_2 400\\\\t&\\approx25.9\\text{ days}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
