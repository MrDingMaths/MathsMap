  "content": {
    "id": "p21-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Given that $\\frac{p}{9}=39$, write down the value of these expressions.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{p}{9}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$$\\begin{align*}\\frac{p}{9}+1&=39+1\\\\&=40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p21-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$351$",
          "worked": "$$\\begin{align*}\\frac{p}{9}&=39\\\\p&=39\\times9\\\\p&=351\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$127-\\frac{p}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$88$",
          "worked": "$$\\begin{align*}127-\\frac{p}{9}&=127-39\\\\&=88\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p21-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$3p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1053$",
          "worked": "$$\\begin{align*}p&=39\\times9\\\\p&=351\\\\3p&=3\\times351\\\\&=1053\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
