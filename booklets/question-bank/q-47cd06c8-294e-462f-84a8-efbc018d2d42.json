    "id": "v2-piecework-practice-slot-17-root",
    "type": "question",
    "label": null,
    "prompt": "Sunita sews cushion covers. She is paid \\$2.40 for each of the first 40 covers and \\$2.90 per cover thereafter. How much does she earn on a day in which she sews 55 covers?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$139.50; $40\\times\\$2.40+15\\times\\$2.90$.",
      "worked": "$$\\begin{align*}\\text{Remaining covers} &= 55-40\\\\\\text{Remaining covers} &= 15\\\\\\text{Pay} &= 40\\times\\$2.40+15\\times\\$2.90\\\\\\text{Pay} &= \\$96.00+\\$43.50\\\\\\text{Pay} &= \\$139.50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
