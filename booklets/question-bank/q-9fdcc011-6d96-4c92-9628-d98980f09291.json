    "children": [
      {
        "id": "p18-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the side length of the courtyard.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14\\text{ m}$",
          "worked": "$$\\begin{align*}l&=\\sqrt{196}\\\\l&=14\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p18-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the perimeter.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56\\text{ m}$",
          "worked": "$$\\begin{align*}P&=4\\times14\\\\P&=56\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p18-q11-c",
