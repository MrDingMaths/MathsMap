    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Without using a calculator, show that $\\sqrt{7}<3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Since $7<3^2$, $\\sqrt{7}<3$.",
          "worked": "Since $7<9=3^2$ and both roots are positive,\n$$\\begin{align*}\\sqrt{7}&<\\sqrt{9}\\\\\\sqrt{7}&<3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Without using a calculator, show that $\\sqrt{7}+\\sqrt[3]{7}+\\sqrt[4]{7}<7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{7}<3$, $\\sqrt[3]{7}<2$ and $\\sqrt[4]{7}<2$, so their sum is less than $3+2+2=7$.",
          "worked": "From part a, $\\sqrt{7}<3$. Since $7<8=2^3$, $\\sqrt[3]{7}<2$. Since $7<16=2^4$, $\\sqrt[4]{7}<2$.\n\nAdding these strict bounds gives\n$$\\begin{align*}\\sqrt{7}+\\sqrt[3]{7}+\\sqrt[4]{7}&<3+2+2\\\\\\sqrt{7}+\\sqrt[3]{7}+\\sqrt[4]{7}&<7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
