    "id": "routine-geometric-r4-first-term-1-root",
    "type": "question",
    "label": null,
    "prompt": "The ratio of a GP is $r=4$ and the sum to three terms is 126. Find the first term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=6$.",
      "worked": "$r=4$, $S_3=126$.\n\n$$\\begin{aligned}S_3&=\\frac{a(r^3-1)}{r-1}\\\\126&=\\frac{a(4^3-1)}{4-1}\\\\126&=\\frac{63a}{3}\\\\126&=21a\\\\a&=6\\end{aligned}$$",
      "solutionDiagrams": []
    },
