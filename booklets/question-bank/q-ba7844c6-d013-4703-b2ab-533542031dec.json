    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt7$",
      "worked": "$$\\begin{align*}\\frac7{\\sqrt7}&=\\frac7{\\sqrt7}\\times\\frac{\\sqrt7}{\\sqrt7}\\\\\\frac7{\\sqrt7}&=\\frac{7\\sqrt7}{7}\\\\\\frac7{\\sqrt7}&=\\sqrt7.\\end{align*}$$",
      "solutionDiagrams": []
    },
