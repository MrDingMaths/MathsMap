  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Expand and simplify each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)(x+2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5+9x^4+32x^3+56x^2+48x+16$",
          "worked": "$$\\begin{align*}(x+2)^4&=x^4+8x^3+24x^2+32x+16\\\\(x+1)(x+2)^4&=x(x^4+8x^3+24x^2+32x+16)+(x^4+8x^3+24x^2+32x+16)\\\\(x+1)(x+2)^4&=x^5+9x^4+32x^3+56x^2+48x+16.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)(x+1)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5+3x^4+2x^3-2x^2-3x-1$",
          "worked": "$$\\begin{align*}(x+1)^4&=x^4+4x^3+6x^2+4x+1\\\\(x-1)(x+1)^4&=x(x^4+4x^3+6x^2+4x+1)-(x^4+4x^3+6x^2+4x+1)\\\\(x-1)(x+1)^4&=x^5+3x^4+2x^3-2x^2-3x-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x+3)(x+2)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^6+23x^5+110x^4+280x^3+400x^2+304x+96$\n\nExpand the fifth power, then distribute $2x+3$.",
          "worked": "$$\\begin{align*}(x+2)^5&=x^5+10x^4+40x^3+80x^2+80x+32\\\\(2x+3)(x+2)^5&=2x(x^5+10x^4+40x^3+80x^2+80x+32)+3(x^5+10x^4+40x^3+80x^2+80x+32)\\\\(2x+3)(x+2)^5&=2x^6+23x^5+110x^4+280x^3+400x^2+304x+96.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2x-3)(x-2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^5-19x^4+72x^3-136x^2+128x-48$",
          "worked": "$$\\begin{align*}(x-2)^4&=x^4-8x^3+24x^2-32x+16\\\\(2x-3)(x-2)^4&=2x(x^4-8x^3+24x^2-32x+16)-3(x^4-8x^3+24x^2-32x+16)\\\\(2x-3)(x-2)^4&=2x^5-19x^4+72x^3-136x^2+128x-48.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
