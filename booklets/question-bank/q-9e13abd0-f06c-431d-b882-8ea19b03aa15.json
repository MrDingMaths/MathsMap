  "content": {
    "id": "p9-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A soccer match lasted 94 minutes (including injury time). If Team A was in possession for 65% of the match, for how many minutes and seconds was Team A in possession?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "61 minutes and 6 seconds",
      "worked": "$$\\begin{align*}\\text{Time in possession}&=94\\times0.65\\text{ minutes}\\\\\\text{Time in possession}&=61.1\\text{ minutes}\\end{align*}$$\n\nThe fractional minute is $0.1\\times60=6$ seconds.\n\nTeam A was in possession for 61 minutes and 6 seconds.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
