                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}P(X=0)&=\\frac{52}{100}=\\frac{13}{25}\\\\P(X=1)&=\\frac{19}{100}\\\\P(X=2)&=\\frac{10}{100}=\\frac{1}{10}\\\\P(X=3)&=\\frac{9}{100}\\\\P(X=5)&=\\frac{10}{100}=\\frac{1}{10}.\\end{align*}",
                    "display": true
