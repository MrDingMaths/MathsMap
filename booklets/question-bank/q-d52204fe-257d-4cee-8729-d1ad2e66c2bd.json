  "content": {
    "id": "v2-b4eae-p40-practice-slot-15-082840-root",
    "type": "question",
    "label": null,
    "prompt": "A ball is dropped from a height of $2\\text{ m}$ onto a concrete path.\n\nAfter each bounce it rises to $\\frac45$ of the height it fell from.\n\nFind the total distance through which the ball travels.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$18\\text{ m}$",
      "worked": "The ball first drops $2\\text{ m}$ and rises $\\frac45\\times2=1.6\\text{ m}$. The first downward-and-upward pair totals $3.6\\text{ m}$. Each subsequent pair is $\\frac45$ of the previous pair, so these distances form a GP with $a=3.6$ and $r=\\frac45$.\n\nSince $|r|<1$,\n$$\\begin{align*}S_\\infty&=\\frac{a}{1-r}\\\\&=\\frac{3.6}{1-\\frac45}\\\\&=3.6\\times5\\\\&=18\\text{ m}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
