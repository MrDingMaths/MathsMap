        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{13}$",
          "worked": "There are $7+6=13$ equally likely outcomes, of which 7 are red.\n\n$$P(\\text{red})=\\frac{7}{13}$$",
