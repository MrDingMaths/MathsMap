  "content": {
    "id": "p55-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Rationalise these denominators.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2}{\\sqrt{2}+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6-2\\sqrt{2}}{7}$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt{2}+3}&=\\frac{2}{\\sqrt{2}+3}\\times\\frac{\\sqrt{2}-3}{\\sqrt{2}-3}\\\\&=\\frac{2\\sqrt{2}-6}{2-9}\\\\&=\\frac{6-2\\sqrt{2}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{3+\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6-2\\sqrt{2}}{7}$",
          "worked": "$$\\begin{align*}\\frac{2}{3+\\sqrt{2}}&=\\frac{2}{3+\\sqrt{2}}\\times\\frac{3-\\sqrt{2}}{3-\\sqrt{2}}\\\\&=\\frac{6-2\\sqrt{2}}{9-2}\\\\&=\\frac{6-2\\sqrt{2}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2}{3-\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6+2\\sqrt{2}}{7}$",
          "worked": "$$\\begin{align*}\\frac{2}{3-\\sqrt{2}}&=\\frac{2}{3-\\sqrt{2}}\\times\\frac{3+\\sqrt{2}}{3+\\sqrt{2}}\\\\&=\\frac{6+2\\sqrt{2}}{9-2}\\\\&=\\frac{6+2\\sqrt{2}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{7}{3-\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{7}{3-\\sqrt{2}}&=\\frac{7}{3-\\sqrt{2}}\\times\\frac{3+\\sqrt{2}}{3+\\sqrt{2}}\\\\&=\\frac{7(3+\\sqrt{2})}{9-2}\\\\&=3+\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p55-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{7}{\\sqrt{2}-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt{2}-3$",
          "worked": "$$\\begin{align*}\\frac{7}{\\sqrt{2}-3}&=\\frac{7}{\\sqrt{2}-3}\\times\\frac{\\sqrt{2}+3}{\\sqrt{2}+3}\\\\&=\\frac{7(\\sqrt{2}+3)}{2-9}\\\\&=-\\sqrt{2}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p55-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{7}{\\sqrt{7}-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-7\\sqrt{7}-21}{2}$",
          "worked": "$$\\begin{align*}\\frac{7}{\\sqrt{7}-3}&=\\frac{7}{\\sqrt{7}-3}\\times\\frac{\\sqrt{7}+3}{\\sqrt{7}+3}\\\\&=\\frac{7\\sqrt{7}+21}{7-9}\\\\&=\\frac{-7\\sqrt{7}-21}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\sqrt{7}}{\\sqrt{7}-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-7-3\\sqrt{7}}{2}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{7}}{\\sqrt{7}-3}&=\\frac{\\sqrt{7}}{\\sqrt{7}-3}\\times\\frac{\\sqrt{7}+3}{\\sqrt{7}+3}\\\\&=\\frac{7+3\\sqrt{7}}{7-9}\\\\&=\\frac{-7-3\\sqrt{7}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\sqrt{5}}{\\sqrt{5}-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-5-3\\sqrt{5}}{4}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{5}}{\\sqrt{5}-3}&=\\frac{\\sqrt{5}}{\\sqrt{5}-3}\\times\\frac{\\sqrt{5}+3}{\\sqrt{5}+3}\\\\&=\\frac{5+3\\sqrt{5}}{5-9}\\\\&=\\frac{-5-3\\sqrt{5}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{\\sqrt{5}}{5-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\sqrt{5}+\\sqrt{15}}{22}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{5}}{5-\\sqrt{3}}&=\\frac{\\sqrt{5}}{5-\\sqrt{3}}\\times\\frac{5+\\sqrt{3}}{5+\\sqrt{3}}\\\\&=\\frac{5\\sqrt{5}+\\sqrt{15}}{25-3}\\\\&=\\frac{5\\sqrt{5}+\\sqrt{15}}{22}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p55-q10-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{2\\sqrt{5}}{5-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\sqrt{5}+\\sqrt{15}}{11}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{5}}{5-\\sqrt{3}}&=\\frac{2\\sqrt{5}}{5-\\sqrt{3}}\\times\\frac{5+\\sqrt{3}}{5+\\sqrt{3}}\\\\&=\\frac{10\\sqrt{5}+2\\sqrt{15}}{25-3}\\\\&=\\frac{10\\sqrt{5}+2\\sqrt{15}}{22}\\\\&=\\frac{5\\sqrt{5}+\\sqrt{15}}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p55-q10-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{4\\sqrt{5}}{5-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10\\sqrt{5}+2\\sqrt{15}}{11}$",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{5}}{5-\\sqrt{3}}&=\\frac{4\\sqrt{5}}{5-\\sqrt{3}}\\times\\frac{5+\\sqrt{3}}{5+\\sqrt{3}}\\\\&=\\frac{20\\sqrt{5}+4\\sqrt{15}}{25-3}\\\\&=\\frac{20\\sqrt{5}+4\\sqrt{15}}{22}\\\\&=\\frac{10\\sqrt{5}+2\\sqrt{15}}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p55-q10-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{4\\sqrt{5}}{5-2\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{20\\sqrt{5}+8\\sqrt{15}}{13}$",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{5}}{5-2\\sqrt{3}}&=\\frac{4\\sqrt{5}}{5-2\\sqrt{3}}\\times\\frac{5+2\\sqrt{3}}{5+2\\sqrt{3}}\\\\&=\\frac{20\\sqrt{5}+8\\sqrt{15}}{25-4\\times3}\\\\&=\\frac{20\\sqrt{5}+8\\sqrt{15}}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p55-q10-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{4\\sqrt{5}}{5-3\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10\\sqrt{5}-6\\sqrt{15}$. Use the conjugate $5+3\\sqrt{3}$; the denominator becomes $-2$.",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{5}}{5-3\\sqrt{3}}&=\\frac{4\\sqrt{5}}{5-3\\sqrt{3}}\\times\\frac{5+3\\sqrt{3}}{5+3\\sqrt{3}}\\\\&=\\frac{20\\sqrt{5}+12\\sqrt{15}}{25-9\\times3}\\\\&=-10\\sqrt{5}-6\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p55-q10-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{4\\sqrt{3}}{5-3\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10\\sqrt{3}-18$. Use the conjugate $5+3\\sqrt{3}$; the denominator becomes $-2$.",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{3}}{5-3\\sqrt{3}}&=\\frac{4\\sqrt{3}}{5-3\\sqrt{3}}\\times\\frac{5+3\\sqrt{3}}{5+3\\sqrt{3}}\\\\&=\\frac{20\\sqrt{3}+36}{25-9\\times3}\\\\&=-10\\sqrt{3}-18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p55-q10-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{4\\sqrt{3}-\\sqrt{2}}{5-3\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-20\\sqrt{3}-36+5\\sqrt{2}+3\\sqrt{6}}{2}$. Multiply by the conjugate $5+3\\sqrt{3}$ and expand the numerator.",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{3}-\\sqrt{2}}{5-3\\sqrt{3}}&=\\frac{4\\sqrt{3}-\\sqrt{2}}{5-3\\sqrt{3}}\\times\\frac{5+3\\sqrt{3}}{5+3\\sqrt{3}}\\\\&=\\frac{(4\\sqrt{3}-\\sqrt{2})(5+3\\sqrt{3})}{25-27}\\\\&=\\frac{20\\sqrt{3}+36-5\\sqrt{2}-3\\sqrt{6}}{-2}\\\\&=\\frac{-20\\sqrt{3}-36+5\\sqrt{2}+3\\sqrt{6}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
