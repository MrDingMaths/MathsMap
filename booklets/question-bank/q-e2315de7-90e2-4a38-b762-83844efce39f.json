  "content": {
    "id": "p9-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A line joins the two points $(-1,3)$ and $(4,-2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the gradient of the line, using $(x_1,y_1)=(-1,3)$ and $(x_2,y_2)=(4,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{-2-3}{4-(-1)}\\\\m&=-\\frac55\\\\m&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the gradient of the line, using $(x_1,y_1)=(4,-2)$ and $(x_2,y_2)=(-1,3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$\\begin{align*}m&=\\frac{y_2-y_1}{x_2-x_1}\\\\m&=\\frac{3-(-2)}{-1-4}\\\\m&=\\frac5{-5}\\\\m&=-1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Do you get the same gradient even if you switch $(x_1,y_1)$ and $(x_2,y_2)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes. Both calculations give $m=-1$. Switching the points reverses the signs of both the numerator and denominator, so their quotient is unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
