  "content": {
    "id": "v2-b537c-p32-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "A cake is removed from an oven at $190^\\circ\\mathrm{C}$ and left to cool in a kitchen at $22^\\circ\\mathrm{C}$. Its temperature is modelled by $T=22+Ae^{kt}$, where $t$ is the time in minutes. After 12 minutes the temperature of the cake is $100^\\circ\\mathrm{C}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b537c-p32-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=168$.",
          "worked": "At $t=0$,\n$$\\begin{align*}190&=22+A\\\\A&=168.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b537c-p32-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $k$ in exact form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{1}{12}\\ln\\left(\\dfrac{13}{28}\\right)\\ \\mathrm{min}^{-1}$.",
          "worked": "$$\\begin{align*}100&=22+168e^{12k}\\\\78&=168e^{12k}\\\\e^{12k}&=\\frac{13}{28}\\\\12k&=\\ln\\left(\\frac{13}{28}\\right)\\\\k&=\\frac{1}{12}\\ln\\left(\\frac{13}{28}\\right)\\ \\mathrm{min}^{-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-b537c-p32-practice-slot-10-slot-10-q-c",
        "type": "part",
        "label": "c",
        "prompt": "After how many minutes, to the nearest minute, will the cake reach $40^\\circ\\mathrm{C}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35$ minutes.",
          "worked": "$$\\begin{align*}40&=22+168e^{kt}\\\\18&=168e^{kt}\\\\e^{kt}&=\\frac{3}{28}\\\\kt&=\\ln\\left(\\frac{3}{28}\\right)\\\\t&=\\frac{\\ln(3/28)}{k}\\\\&=\\frac{12\\ln(3/28)}{\\ln(13/28)}\\\\&\\approx34.9\\text{ minutes}\\approx35\\text{ minutes.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
