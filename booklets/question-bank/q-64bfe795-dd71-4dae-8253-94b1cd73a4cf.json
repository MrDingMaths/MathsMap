  "content": {
    "id": "p11-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A piece of string is $x$ m in length. It is divided into 7 equal parts.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each part in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{7}$ m",
          "worked": "Length of each part $=\\frac{x}{7}$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q8-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the length of each part for the following values of $x$.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q8-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x=21$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "3 m",
              "worked": "$$\\begin{align*}\\frac{x}{7}&=\\frac{21}{7}\\\\\\frac{x}{7}&=3\\end{align*}$$\nEach part is 3 m long.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p11-q8-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x=42$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "6 m",
              "worked": "$$\\begin{align*}\\frac{x}{7}&=\\frac{42}{7}\\\\\\frac{x}{7}&=6\\end{align*}$$\nEach part is 6 m long.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p11-q8-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x=100$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
