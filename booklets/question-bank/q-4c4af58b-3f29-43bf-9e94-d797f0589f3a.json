  "content": {
    "id": "p6-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The graph $y=x^2$ undergoes each of the given pairs of transformations. Find the equation of the resulting parabola.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "A reflection in the $x$-axis followed by a translation of 1 unit to the right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-1)^2$",
          "worked": "After reflection in the $x$-axis: $y=-x^2$.\n\nAfter translation 1 unit right: $y=-(x-1)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "A translation of 2 units to the left followed by a reflection in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+2)^2$",
          "worked": "After translation 2 units left: $y=(x+2)^2$.\n\nAfter reflection in the $x$-axis: $y=-(x+2)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "A dilation by a factor of 2 from the $x$-axis followed by a reflection in the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x^2$",
          "worked": "After dilation by a factor of 2 from the $x$-axis: $y=2x^2$.\n\nAfter reflection in the $x$-axis: $y=-2x^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "A dilation by a factor of $\\frac13$ from the $x$-axis followed by a translation by 3 units down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac13x^2-3$",
          "worked": "After dilation by a factor of $\\frac13$ from the $x$-axis: $y=\\frac13x^2$.\n\nAfter translation 3 units down: $y=\\frac13x^2-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "A dilation by a factor of 4 from the $x$-axis, then a translation of 4 units to the left.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4(x+4)^2$",
          "worked": "After dilation by a factor of 4 from the $x$-axis: $y=4x^2$.\n\nAfter translation 4 units left: $y=4(x+4)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
