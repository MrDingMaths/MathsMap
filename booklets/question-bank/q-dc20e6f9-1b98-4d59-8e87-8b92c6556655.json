  "content": {
    "id": "p23-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Jack makes leather belts. The piece rate is \\$1.25 each for the first 50 belts and \\$1.50 thereafter. What is his income for a day in which he produces 68 belts?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$89.50; $50\\times\\$1.25+18\\times\\$1.50$.",
      "worked": "$$\\begin{align*}\\text{Remaining belts} &= 68-50\\\\\\text{Remaining belts} &= 18\\\\\\text{Income} &= 50\\times\\$1.25+18\\times\\$1.50\\\\\\text{Income} &= \\$62.50+\\$27.00\\\\\\text{Income} &= \\$89.50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
