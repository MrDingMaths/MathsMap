        "answer": {
          "short": "$4\\sqrt{2}-2\\sqrt{3}$",
          "worked": "$$\\begin{align*}4\\sqrt{2}-\\sqrt{12}&=4\\sqrt{2}-\\sqrt{4\\times3}\\\\4\\sqrt{2}-\\sqrt{12}&=4\\sqrt{2}-2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt{2}+\\sqrt{8}+\\sqrt{32}$",
