        "answer": {
          "short": "$7\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{2}+\\sqrt{8}+\\sqrt{32}&=\\sqrt{2}+2\\sqrt{2}+4\\sqrt{2}\\\\\\sqrt{2}+\\sqrt{8}+\\sqrt{32}&=7\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$3\\sqrt{75}-2\\sqrt{98}-5\\sqrt{12}+2\\sqrt{50}$",
