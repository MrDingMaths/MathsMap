      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$4\\sqrt{3}-8\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\sqrt{3}$",
          "worked": "$$4\\sqrt{3}-8\\sqrt{3}=-4\\sqrt{3}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$4\\sqrt[3]{2}+3\\sqrt[3]{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\sqrt[3]{2}$",
          "worked": "$$4\\sqrt[3]{2}+3\\sqrt[3]{2}=7\\sqrt[3]{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$3\\sqrt{3}+4\\sqrt{2}-\\sqrt{3}-2\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}+2\\sqrt{3}$",
          "worked": "$$\\begin{align*}3\\sqrt{3}+4\\sqrt{2}-\\sqrt{3}-2\\sqrt{2}&=(3-1)\\sqrt{3}+(4-2)\\sqrt{2}\\\\3\\sqrt{3}+4\\sqrt{2}-\\sqrt{3}-2\\sqrt{2}&=2\\sqrt{2}+2\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\sqrt{7}-4\\sqrt{5}-\\sqrt{5}-2\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\sqrt{5}$",
          "worked": "$$\\begin{align*}2\\sqrt{7}-4\\sqrt{5}-\\sqrt{5}-2\\sqrt{7}&=(2-2)\\sqrt{7}-(4+1)\\sqrt{5}\\\\2\\sqrt{7}-4\\sqrt{5}-\\sqrt{5}-2\\sqrt{7}&=-5\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$3\\sqrt{3}-5\\sqrt{5}-5\\sqrt{3}-6\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sqrt{3}-11\\sqrt{5}$",
          "worked": "$$\\begin{align*}3\\sqrt{3}-5\\sqrt{5}-5\\sqrt{3}-6\\sqrt{5}&=(3-5)\\sqrt{3}-(5+6)\\sqrt{5}\\\\3\\sqrt{3}-5\\sqrt{5}-5\\sqrt{3}-6\\sqrt{5}&=-2\\sqrt{3}-11\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt{2}+\\sqrt{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{2}+\\sqrt{8}&=\\sqrt{2}+2\\sqrt{2}\\\\\\sqrt{2}+\\sqrt{8}&=3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$4\\sqrt{2}-\\sqrt{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
