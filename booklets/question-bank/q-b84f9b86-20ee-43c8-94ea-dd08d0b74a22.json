  "content": {
    "id": "p12-practice-right-root",
    "type": "question",
    "label": "",
    "prompt": "$y=(x-2)(x+6)$.\n\nDetermine the behaviour of the curve at:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-practice-right-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Stationary.",
          "worked": "$$\\begin{align*}y&=x^2+4x-12\\\\\\frac{dy}{dx}&=2x+4\\\\\\left.\\frac{dy}{dx}\\right|_{x=-2}&=2(-2)+4\\\\&=0\\end{align*}$$\nThe curve is stationary at $x=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p12-practice-right-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increasing.",
          "worked": "Using $\\dfrac{dy}{dx}=2x+4$:\n$$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=0}&=2(0)+4\\\\&=4>0\\end{align*}$$\nThe curve is increasing at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p12-practice-right-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increasing.",
          "worked": "Using $\\dfrac{dy}{dx}=2x+4$:\n$$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=2}&=2(2)+4\\\\&=8>0\\end{align*}$$\nThe curve is increasing at $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
