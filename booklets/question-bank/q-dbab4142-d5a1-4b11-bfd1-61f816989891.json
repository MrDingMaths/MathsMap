  "content": {
    "id": "p37-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A line of best fit for a scatter plot, relating the weight of a pumpkin (kg) to the number of seeds it contains, was found to pass through the points $(1,300)$ and $(7,540)$. Assume weight is on the $x$-axis.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the line of best fit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=40w+260$, where $w$ is weight in kilograms and $n$ is the number of seeds.",
          "worked": "Let $w$ be weight in kilograms and $n$ the number of seeds.\n$$\\begin{align*}m&=\\frac{540-300}{7-1}\\\\m&=40\\\\n-300&=40(w-1)\\\\n-300&=40w-40\\\\n&=40w+260\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p37-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Use your equation to estimate the number of seeds a pumpkin contains that weighs $5.2$ kg.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$468$ seeds.",
          "worked": "$$\\begin{align*}n&=40(5.2)+260\\\\n&=468\\end{align*}$$\nThe pumpkin is estimated to contain $468$ seeds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p37-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Use your equation to estimate the weight of a pumpkin containing $600$ seeds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.5$ kg.",
          "worked": "$$\\begin{align*}600&=40w+260\\\\340&=40w\\\\w&=\\frac{340}{40}\\\\w&=8.5\\end{align*}$$\nThe estimated weight is $8.5$ kg.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
