      {
        "id": "p85-review-two-q08-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the initial displacement and initial velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(0)=4\\text{ m}$; $v(0)=-\\dfrac32\\text{ m s}^{-1}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p85-q27-a-work",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}x(0)&=\\frac{6}{0+2}+1=4\\text{ m}\\\\v(t)&=x'(t)=-\\frac{6}{(t+2)^2}\\\\v(0)&=-\\frac{6}{2^2}=-\\frac32\\text{ m s}^{-1}.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p85-review-two-q08-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the velocity when the particle is at $x=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\text{ s}$, so $v=-\\dfrac23\\text{ m s}^{-1}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p85-q27-b-work",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}3&=\\frac{6}{t+2}+1\\\\2&=\\frac{6}{t+2}\\\\t&=1\\text{ s}\\\\v(1)&=-\\frac{6}{(1+2)^2}=-\\frac23\\text{ m s}^{-1}.\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p85-review-two-q08-c",
        "type": "part",
        "label": "c",
        "prompt": "Find when the particle has speed $\\dfrac23\\text{ m s}^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\text{ s}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p85-q27-c-work",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}|v(t)|&=\\frac{6}{(t+2)^2}\\\\\\frac{6}{(t+2)^2}&=\\frac23\\\\(t+2)^2&=9\\\\t&=1\\text{ s}\\quad(t\\geq 0).\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
