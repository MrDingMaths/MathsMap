  "content": {
    "id": "v2-4ab09-p14-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "Dylan is paid \\$23.65 per hour. In one week he works 36 hours at the normal rate, 2.5 hours at time-and-a-half and 4 hours at double time.\nCalculate his total weekly wage. Round to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1129.29",
      "worked": "$$\\begin{align*}\\text{Normal pay}&=23.65\\times36=\\$851.40\\\\\\text{Time-and-a-half pay}&=23.65\\times2.5\\times1.5=\\$88.6875\\\\\\text{Double-time pay}&=23.65\\times4\\times2=\\$189.20\\\\\\text{Total pay}&=851.40+88.6875+189.20\\\\\\text{Total pay}&=\\$1129.2875\\\\\\text{Total pay}&\\approx\\$1129.29\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
