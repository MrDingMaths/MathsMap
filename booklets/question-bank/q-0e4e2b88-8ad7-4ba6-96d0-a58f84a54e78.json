    "type": "question",
    "label": "14",
    "prompt": "One store is selling 4 avocados for $\\$3$. A second store is selling 7 avocados for $\\$5$. Which store is offering the best unit price for avocados?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Store 2.",
      "worked": "Compare the cost of 28 avocados.\n\n$$\\begin{align*}\\text{Store 1 cost} &= 7\\times\\$3\\\\\\text{Store 1 cost} &= \\$21\\\\\\text{Store 2 cost} &= 4\\times\\$5\\\\\\text{Store 2 cost} &= \\$20\\end{align*}$$\n\nStore 2 offers the best unit price because the same number of avocados costs less.",
      "solutionDiagrams": []
    },
