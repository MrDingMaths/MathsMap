  "content": {
    "id": "p7-q4",
    "type": "question",
    "label": "4",
    "prompt": "Solve these quadratic equations. First rearrange to the form $ax^{2}+bx+c=0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^{2}=15-7x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{2}$ or $x=-5$.",
          "worked": "P: $-30$, S: $7$, F: $10,-3$.\n$$\\begin{align*}2x^{2}+7x-15&=0\\\\2x^{2}+10x-3x-15&=0\\\\2x(x+5)-3(x+5)&=0\\\\(2x-3)(x+5)&=0\\\\2x-3&=0\\quad\\text{or}\\quad x+5=0\\\\x&=\\frac{3}{2}\\quad\\text{or}\\quad x=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$4x^{2}=12x-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{2}$.",
          "worked": "P: $36$, S: $-12$, F: $-6,-6$.\n$$\\begin{align*}4x^{2}-12x+9&=0\\\\(2x-3)^{2}&=0\\\\2x-3&=0\\\\x&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=3x^{2}-14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=\\frac{7}{3}$.",
          "worked": "P: $-42$, S: $-1$, F: $-7,6$.\n$$\\begin{align*}3x^{2}-x-14&=0\\\\3x^{2}-7x+6x-14&=0\\\\x(3x-7)+2(3x-7)&=0\\\\(x+2)(3x-7)&=0\\\\x+2&=0\\quad\\text{or}\\quad 3x-7=0\\\\x&=-2\\quad\\text{or}\\quad x=\\frac{7}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p7-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$17x=12-5x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{5}$ or $x=-4$.",
          "worked": "P: $-60$, S: $17$, F: $20,-3$.\n$$\\begin{align*}5x^{2}+17x-12&=0\\\\5x^{2}+20x-3x-12&=0\\\\5x(x+4)-3(x+4)&=0\\\\(5x-3)(x+4)&=0\\\\5x-3&=0\\quad\\text{or}\\quad x+4=0\\\\x&=\\frac{3}{5}\\quad\\text{or}\\quad x=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p7-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$25=-9x^{2}-30x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{5}{3}$.",
          "worked": "P: $225$, S: $30$, F: $15,15$.\n$$\\begin{align*}9x^{2}+30x+25&=0\\\\(3x+5)^{2}&=0\\\\3x+5&=0\\\\x&=-\\frac{5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$17x-6x^{2}=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{3}$ or $x=\\frac{5}{2}$.",
          "worked": "P: $30$, S: $-17$, F: $-15,-2$.\n$$\\begin{align*}6x^{2}-17x+5&=0\\\\6x^{2}-15x-2x+5&=0\\\\3x(2x-5)-(2x-5)&=0\\\\(3x-1)(2x-5)&=0\\\\3x-1&=0\\quad\\text{or}\\quad 2x-5=0\\\\x&=\\frac{1}{3}\\quad\\text{or}\\quad x=\\frac{5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
