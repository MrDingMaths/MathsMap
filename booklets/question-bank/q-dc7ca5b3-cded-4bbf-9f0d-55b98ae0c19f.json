    "label": "4",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $k$ if $(x+2)$ is a factor of $x^3-kx^2-2x-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-2$",
          "worked": "By the factor theorem, the value at $x=-2$ is zero.\n$$\\begin{aligned}(-2)^3-k(-2)^2-2(-2)-4&=0\\\\-8-4k+4-4&=0\\\\-4k&=8\\\\k&=-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p53-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $k$ if $(x-3)$ is a factor of $2x^3+2x^2-kx-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=23$",
          "worked": "By the factor theorem, the value at $x=3$ is zero.\n$$\\begin{aligned}2(3)^3+2(3)^2-3k-3&=0\\\\54+18-3k-3&=0\\\\3k&=69\\\\k&=23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p53-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $m$, if $-2$ is a zero of the function $F(x)=x^3+mx^2-3x+4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac12$",
          "worked": "Since $-2$ is a zero, $F(-2)=0$.\n$$\\begin{aligned}(-2)^3+m(-2)^2-3(-2)+4&=0\\\\-8+4m+6+4&=0\\\\4m&=-2\\\\m&=-\\frac12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p53-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "For what value of $a$ is $3x^4+ax^2-2$ divisible by $x+1$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-1$",
          "worked": "By the factor theorem, the value at $x=-1$ is zero.\n$$\\begin{aligned}3(-1)^4+a(-1)^2-2&=0\\\\3+a-2&=0\\\\a&=-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
