  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The measures of the angles in a triangle are in the ratio $2:3:4$. Find the measure of the largest angle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$80^{\\circ}$",
      "worked": "Let the angles be $2x$, $3x$ and $4x$. By the angle sum of a triangle,\n$$\\begin{align*}2x+3x+4x&=180^{\\circ}\\\\9x&=180^{\\circ}\\\\x&=20^{\\circ}.\\end{align*}$$\nThe largest angle is $4x=4\\times20^{\\circ}=80^{\\circ}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
