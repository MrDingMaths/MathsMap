      {
        "id": "p33-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{m}+\\sqrt{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\sqrt{m}+\\sqrt{n}&=\\sqrt{9}+\\sqrt{16}\\\\&=3+4\\\\&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{m+n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\sqrt{m+n}&=\\sqrt{9+16}\\\\&=\\sqrt{25}\\\\&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$m\\sqrt{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "$$\\begin{align*}m\\sqrt{n}&=9\\sqrt{16}\\\\&=9(4)\\\\&=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$n\\sqrt{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}n\\sqrt{m}&=16\\sqrt{9}\\\\&=16(3)\\\\&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{mn}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}\\sqrt{mn}&=\\sqrt{9(16)}\\\\&=\\sqrt{144}\\\\&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
