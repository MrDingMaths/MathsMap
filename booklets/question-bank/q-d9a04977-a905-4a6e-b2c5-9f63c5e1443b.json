  "content": {
    "id": "p21-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "A regular polygon has exterior angles and interior angles in the ratio $2:7$.\nHow many sides does it have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "9 sides",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q22-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}E:I&=2:7\\\\\\frac{E}{I}&=\\frac{2}{7}\\\\I&=3.5E\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q22-answer-supplementary",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 4,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}E+I&=180^{\\circ}\\\\E+3.5E&=180^{\\circ}\\\\E&=40^{\\circ}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q22-answer-sides",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 4,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "E=\\frac{360^{\\circ}}{n}",
                "display": false
              },
              {
                "type": "math",
                "latex": "n=\\frac{360}{40}=9\\text{ sides}",
                "display": true
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
