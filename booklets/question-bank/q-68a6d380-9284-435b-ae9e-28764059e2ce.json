  "content": {
    "id": "p61-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Factorise.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p61-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{25}-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac15+x\\right)\\left(\\frac15-x\\right)$",
          "worked": "$$\\begin{align*}\\frac{1}{25}-x^2&=\\left(\\frac15\\right)^2-x^2\\\\&=\\left(\\frac15+x\\right)\\left(\\frac15-x\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{64b^2}{25}-\\frac{4y^2}{81}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{8b}{5}+\\frac{2y}{9}\\right)\\left(\\frac{8b}{5}-\\frac{2y}{9}\\right)$",
          "worked": "$$\\begin{align*}\\frac{64b^2}{25}-\\frac{4y^2}{81}&=\\left(\\frac{8b}{5}\\right)^2-\\left(\\frac{2y}{9}\\right)^2\\\\&=\\left(\\frac{8b}{5}+\\frac{2y}{9}\\right)\\left(\\frac{8b}{5}-\\frac{2y}{9}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p61-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$3p^2-\\frac{48}{p^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\left(p+\\frac4p\\right)\\left(p-\\frac4p\\right)$",
          "worked": "$$\\begin{align*}3p^2-\\frac{48}{p^2}&=3\\left(p^2-\\frac{16}{p^2}\\right)\\\\&=3\\left[p^2-\\left(\\frac4p\\right)^2\\right]\\\\&=3\\left(p+\\frac4p\\right)\\left(p-\\frac4p\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p61-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$(m+3)^2-25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+8)(m-2)$",
          "worked": "$$\\begin{align*}(m+3)^2-25&=(m+3+5)(m+3-5)\\\\&=(m+8)(m-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x-y)^2-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x-2y)$",
          "worked": "$$\\begin{align*}(x-y)^2-y^2&=(x-y+y)(x-y-y)\\\\&=x(x-2y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$(p+x)^2-(p-x)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4px$",
          "worked": "$$\\begin{align*}(p+x)^2-(p-x)^2&=[(p+x)+(p-x)]\\times[(p+x)-(p-x)]\\\\&=(2p)(2x)\\\\&=4px\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{4c^2}{9}-\\frac{e^2}{36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{2c}{3}+\\frac e6\\right)\\left(\\frac{2c}{3}-\\frac e6\\right)$",
          "worked": "$$\\begin{align*}\\frac{4c^2}{9}-\\frac{e^2}{36}&=\\left(\\frac{2c}{3}\\right)^2-\\left(\\frac e6\\right)^2\\\\&=\\left(\\frac{2c}{3}+\\frac e6\\right)\\left(\\frac{2c}{3}-\\frac e6\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p61-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$4g^2-(g-2k)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3g-2k)(g+2k)$",
          "worked": "$$\\begin{align*}4g^2-(g-2k)^2&=[2g+(g-2k)]\\times[2g-(g-2k)]\\\\&=(3g-2k)(g+2k)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$5w^5-80w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5w(w-2)(w+2)(w^2+4)$",
          "worked": "$$\\begin{align*}5w^5-80w&=5w(w^4-16)\\\\&=5w(w^2-4)(w^2+4)\\\\&=5w(w-2)(w+2)(w^2+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$a^2(a+2)-4(a+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+2)(a+2)(a-2)$",
          "worked": "$$\\begin{align*}a^2(a+2)-4(a+2)&=(a+2)(a^2-4)\\\\&=(a+2)(a+2)(a-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$6x^2-5x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2)(2x-3)$",
          "worked": "Product: $6\\times(-6)=-36$. Sum: $-5$. Factor pair: $4,-9$.\n$$\\begin{align*}6x^2-5x-6&=6x^2+4x-9x-6\\\\&=2x(3x+2)-3(3x+2)\\\\&=(3x+2)(2x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p61-q7-l",
        "type": "part",
        "label": "l",
        "prompt": "$6x^2-5xy-6y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2y)(2x-3y)$",
          "worked": "Product: $6\\times(-6)=-36$. Sum: $-5$. Factor pair: $4,-9$.\n$$\\begin{align*}6x^2-5xy-6y^2&=6x^2+4xy-9xy-6y^2\\\\&=2x(3x+2y)-3y(3x+2y)\\\\&=(3x+2y)(2x-3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p61-q7-m",
        "type": "part",
        "label": "m",
        "prompt": "$x(y-1)+3(y-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y-1)(x+3)$",
          "worked": "$$\\begin{align*}x(y-1)+3(y-1)&=(y-1)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p61-q7-n",
        "type": "part",
        "label": "n",
        "prompt": "$3x(y-2)+5(2-y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y-2)(3x-5)$",
          "worked": "$$\\begin{align*}3x(y-2)+5(2-y)&=3x(y-2)-5(y-2)\\\\&=(y-2)(3x-5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-o",
        "type": "part",
        "label": "o",
        "prompt": "$(m-n)^2-(m-n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m-n)(m-n-1)$",
          "worked": "$$\\begin{align*}(m-n)^2-(m-n)&=(m-n)[(m-n)-1]\\\\&=(m-n)(m-n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-second-a",
        "type": "part",
        "label": "p",
        "prompt": "$x^3-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x+2)(x-2)$",
          "worked": "$$\\begin{align*}x^3-4x&=x(x^2-4)\\\\&=x(x+2)(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-second-b",
        "type": "part",
        "label": "q",
        "prompt": "$2x^3+x^2-8x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-2)(2x+1)$",
          "worked": "$$\\begin{align*}2x^3+x^2-8x-4&=x^2(2x+1)-4(2x+1)\\\\&=(x^2-4)(2x+1)\\\\&=(x+2)(x-2)(2x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q7-second-c",
        "type": "part",
        "label": "r",
        "prompt": "$x^3-x^2-4x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)(x-2)(x-1)$",
          "worked": "$$\\begin{align*}x^3-x^2-4x+4&=x^2(x-1)-4(x-1)\\\\&=(x^2-4)(x-1)\\\\&=(x+2)(x-2)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q7-second-d",
        "type": "part",
        "label": "s",
        "prompt": "$3x^3+6x^2-3x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x+1)(x-1)(x+2)$",
          "worked": "$$\\begin{align*}3x^3+6x^2-3x-6&=3x^2(x+2)-3(x+2)\\\\&=3(x+2)(x^2-1)\\\\&=3(x+1)(x-1)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p61-q7-second-e",
        "type": "part",
        "label": "t",
        "prompt": "$(x+2)^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5)(x-1)$",
          "worked": "$$\\begin{align*}(x+2)^2-9&=(x+2+3)(x+2-3)\\\\&=(x+5)(x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p61-q7-second-f",
        "type": "part",
        "label": "u",
        "prompt": "$(x-5)^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x-7)$",
          "worked": "$$\\begin{align*}(x-5)^2-4&=(x-5+2)(x-5-2)\\\\&=(x-3)(x-7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
