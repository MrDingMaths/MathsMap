  "content": {
    "id": "v2-8d878845-p73-level-slot-4-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The marks of five students in a quiz out of $20$ were\n\n$12,\\ 15,\\ 9,\\ 14,\\ 15$\n\nA sixth student's mark is added. The mean of the six marks is $14$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8d878845-p73-level-slot-4-upper-slot-4-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the sixth student's mark.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19$",
          "worked": "$$\\begin{align*}\\text{Total of six marks}&=6\\times14\\\\\\text{Total of six marks}&=84\\\\\\text{Total of five marks}&=12+15+9+14+15=65\\\\\\text{Sixth mark}&=84-65\\\\\\text{Sixth mark}&=19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-8d878845-p73-level-slot-4-upper-slot-4-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "v2-8d878845-p73-level-slot-4-upper-slot-4-upper-q-b-d1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "State how the median changes using ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "“increase, decrease, no change”",
                  "marks": [
                    "bold"
                  ]
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Median: increase.",
          "worked": "Before: $9,\\ 12,\\ \\underline{14},\\ 15,\\ 15$, so the median is $14$.\n\nAfter: $9,\\ 12,\\ \\underline{14},\\ \\underline{15},\\ 15,\\ 19$, so the median is $\\frac{14+15}{2}=14.5$.\n\nThe median increases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-8d878845-p73-level-slot-4-upper-slot-4-upper-q-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "v2-8d878845-p73-level-slot-4-upper-slot-4-upper-q-c-d1",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "State how the range changes using ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "“increase, decrease, no change”",
                  "marks": [
                    "bold"
                  ]
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Range: increase.",
          "worked": "$$\\begin{align*}\\text{Range before}&=15-9=6\\\\\\text{Range after}&=19-9=10\\end{align*}$$\n\nThe range increases because the new mark is the new maximum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
