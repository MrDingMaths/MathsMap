  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{6!}{5!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\frac{6!}{5!}&=\\frac{6\\times5!}{5!}\\\\\\frac{6!}{5!}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{8!}{6!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56$",
          "worked": "$$\\begin{align*}\\frac{8!}{6!}&=\\frac{8\\times7\\times6!}{6!}\\\\\\frac{8!}{6!}&=56\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{10!}{7!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720$",
          "worked": "$$\\begin{align*}\\frac{10!}{7!}&=\\frac{10\\times9\\times8\\times7!}{7!}\\\\\\frac{10!}{7!}&=720\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{6!}{3!3!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$$\\begin{align*}\\frac{6!}{3!3!}&=\\frac{6\\times5\\times4\\times3!}{3!\\times6}\\\\\\frac{6!}{3!3!}&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{8!}{3!5!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56$",
          "worked": "$$\\begin{align*}\\frac{8!}{3!5!}&=\\frac{8\\times7\\times6\\times5!}{6\\times5!}\\\\\\frac{8!}{3!5!}&=56\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{11!}{9!2!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$55$",
          "worked": "$$\\begin{align*}\\frac{11!}{9!2!}&=\\frac{11\\times10\\times9!}{9!\\times2}\\\\\\frac{11!}{9!2!}&=55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2g",
        "type": "part",
        "label": "g",
        "prompt": "$7!-(6\\times6!)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720$",
          "worked": "$$\\begin{align*}7!-(6\\times6!)&=(7-6)6!\\\\7!-(6\\times6!)&=6!\\\\7!-(6\\times6!)&=720\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q2h",
        "type": "part",
        "label": "h",
        "prompt": "$(4\\times5!)-(5\\times4!)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$",
          "worked": "$$\\begin{align*}(4\\times5!)-(5\\times4!)&=(4\\times5-5)4!\\\\(4\\times5!)-(5\\times4!)&=15\\times24\\\\(4\\times5!)-(5\\times4!)&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q2i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{9!+8!}{8!+7!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{80}{9}$",
          "worked": "$$\\begin{align*}\\frac{9!+8!}{8!+7!}&=\\frac{(9+1)8!}{(8+1)7!}\\\\\\frac{9!+8!}{8!+7!}&=\\frac{10\\times8\\times7!}{9\\times7!}\\\\\\frac{9!+8!}{8!+7!}&=\\frac{80}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q2j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{8!+7!}{8!-7!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{7}$",
          "worked": "$$\\begin{align*}\\frac{8!+7!}{8!-7!}&=\\frac{(8+1)7!}{(8-1)7!}\\\\\\frac{8!+7!}{8!-7!}&=\\frac{9}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
