  "content": {
    "id": "p23-q51-root",
    "type": "question",
    "label": "51",
    "prompt": "Express $\\cot(\\alpha+\\beta)$ in terms of $\\cot\\alpha$ and $\\cot\\beta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\displaystyle\\cot(\\alpha+\\beta)=\\frac{\\cot\\alpha\\cot\\beta-1}{\\cot\\alpha+\\cot\\beta}$",
      "worked": "$$\\begin{align*}\\cot(\\alpha+\\beta)&=\\frac{1}{\\tan(\\alpha+\\beta)}\\\\\\cot(\\alpha+\\beta)&=\\frac{1-\\tan\\alpha\\tan\\beta}{\\tan\\alpha+\\tan\\beta}\\\\\\cot(\\alpha+\\beta)&=\\frac{1-\\frac{1}{\\cot\\alpha\\cot\\beta}}{\\frac{1}{\\cot\\alpha}+\\frac{1}{\\cot\\beta}}\\\\\\cot(\\alpha+\\beta)&=\\frac{\\cot\\alpha\\cot\\beta-1}{\\cot\\alpha+\\cot\\beta}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
