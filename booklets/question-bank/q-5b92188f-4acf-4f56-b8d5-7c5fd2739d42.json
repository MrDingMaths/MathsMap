    "children": [
      {
        "id": "p23-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=\\sin x$ is a PDF in the domain $\\left[0,\\frac{\\pi}{2}\\right]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin x\\ge0$ on $\\left[0,\\frac{\\pi}{2}\\right]$ and $\\displaystyle\\int_0^{\\pi/2}\\sin x\\,dx=1$, so it is a PDF.",
          "worked": "$$\\begin{aligned}\\int_0^{\\pi/2}\\sin x\\,dx&=[-\\cos x]_0^{\\pi/2}\\\\&=-\\cos\\left(\\frac{\\pi}{2}\\right)+\\cos(0)\\\\&=0+1\\\\&=1.\\end{aligned}$$\nAlso, $\\sin x\\ge0$ on $\\left[0,\\frac{\\pi}{2}\\right]$. Therefore, it is a PDF.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p23-q18-b",
        "type": "group",
        "label": "b",
        "prompt": "Find each exact probability:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q18-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P\\left(X\\le\\frac{\\pi}{3}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac12$",
              "worked": "$$\\begin{aligned}P\\left(X\\le\\frac{\\pi}{3}\\right)&=\\int_0^{\\pi/3}\\sin x\\,dx\\\\&=[-\\cos x]_0^{\\pi/3}\\\\&=-\\frac12+1\\\\&=\\frac12.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p23-q18-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P\\left(0<X<\\frac{\\pi}{4}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\sqrt2-1}{\\sqrt2}$",
              "worked": "$$\\begin{aligned}P\\left(0<X<\\frac{\\pi}{4}\\right)&=\\int_0^{\\pi/4}\\sin x\\,dx\\\\&=[-\\cos x]_0^{\\pi/4}\\\\&=1-\\frac1{\\sqrt2}\\\\&=\\frac{\\sqrt2-1}{\\sqrt2}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 35
          },
          {
            "id": "p23-q18-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P\\left(X>\\frac{\\pi}{6}\\right)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\sqrt3}{2}$",
              "worked": "$$\\begin{aligned}P\\left(X>\\frac{\\pi}{6}\\right)&=\\int_{\\pi/6}^{\\pi/2}\\sin x\\,dx\\\\&=[-\\cos x]_{\\pi/6}^{\\pi/2}\\\\&=0+\\frac{\\sqrt3}{2}\\\\&=\\frac{\\sqrt3}{2}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 35
          }
        ]
      }
    ]
  },
