  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Multiply these fractions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x}{2}\\times\\frac{y}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{xy}{6}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}\\times\\frac{y}{3}&=\\frac{x\\times y}{2\\times3}\\\\&=\\frac{xy}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{e}{5}\\times\\frac{k}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{ek}{5y}$",
          "worked": "$$\\begin{align*}\\frac{e}{5}\\times\\frac{k}{y}&=\\frac{e\\times k}{5\\times y}\\\\&=\\frac{ek}{5y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{n}{2}\\times\\frac{n}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{n^2}{6}$",
          "worked": "$$\\begin{align*}\\frac{n}{2}\\times\\frac{n}{3}&=\\frac{n\\times n}{2\\times3}\\\\&=\\frac{n^2}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3p}{5}\\times\\frac{4p}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12p^2}{35}$",
          "worked": "$$\\begin{align*}\\frac{3p}{5}\\times\\frac{4p}{7}&=\\frac{3p\\times4p}{5\\times7}\\\\&=\\frac{12p^2}{35}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{e}{2}\\times\\frac{t}{3}\\times\\frac{5e}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5e^2t}{24}$",
          "worked": "$$\\begin{align*}\\frac{e}{2}\\times\\frac{t}{3}\\times\\frac{5e}{4}&=\\frac{e\\times t\\times5e}{2\\times3\\times4}\\\\&=\\frac{5e^2t}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2}{k}\\times\\frac{m}{3}\\times\\frac{4m}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8m^2}{15k}$",
          "worked": "$$\\begin{align*}\\frac{2}{k}\\times\\frac{m}{3}\\times\\frac{4m}{5}&=\\frac{2\\times m\\times4m}{k\\times3\\times5}\\\\&=\\frac{8m^2}{15k}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
