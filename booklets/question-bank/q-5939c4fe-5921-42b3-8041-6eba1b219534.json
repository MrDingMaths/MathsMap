        "answer": {
          "short": "$120x+79$. Expand from the innermost brackets.",
          "worked": "$$\\begin{align*}&=2(3(4(5x)+4(2)+3)+4)+5\\\\&=2(3(20x+11)+4)+5\\\\&=2(3(20x)+3(11)+4)+5\\\\&=2(60x+37)+5\\\\&=2(60x)+2(37)+5\\\\&=120x+79\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$-2(-3(-4(-5x-2)-3)-4)-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120x+33$. Expand from the innermost brackets, keeping each term's sign.",
          "worked": "$$\\begin{align*}&=-2(-3((-4)(-5x)+(-4)(-2)-3)-4)-5\\\\&=-2(-3(20x+5)-4)-5\\\\&=-2((-3)(20x)+(-3)(5)-4)-5\\\\&=-2(-60x-19)-5\\\\&=(-2)(-60x)+(-2)(-19)-5\\\\&=120x+33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$4(3(2(x+2)+2)+3)+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24x+88$. Expand from the innermost brackets.",
          "worked": "$$\\begin{align*}&=4(3(2(x)+2(2)+2)+3)+4\\\\&=4(3(2x+6)+3)+4\\\\&=4(3(2x)+3(6)+3)+4\\\\&=4(6x+21)+4\\\\&=4(6x)+4(21)+4\\\\&=24x+88\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$-4(-3(-2(x-2)-3)-4)$",
