  "content": {
    "id": "p44-q17-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^2+x-3$ and $g(x)=|x|$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(0))$, $g(f(0))$, $f(g(-2))$ and $g(f(-2))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$, $3$, $3$, $1$, respectively.",
          "worked": "$$\\begin{align*}f(g(0))&=f(0)=0^2+0-3=-3\\\\g(f(0))&=g(-3)=|-3|=3\\\\f(g(-2))&=f(2)=2^2+2-3=3\\\\g(f(-2))&=|(-2)^2+(-2)-3|=|-1|=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p44-q17-b",
        "type": "group",
        "label": "b",
        "prompt": "Write an expression for $f(g(x))$ without any use of absolute value, given that:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p44-q17-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x\\geq0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^2+x-3$.",
              "worked": "For $x\\geq0$, $|x|=x$, so$$\\begin{align*}f(g(x))&=f(x)\\\\f(g(x))&=x^2+x-3.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p44-q17-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x<0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^2-x-3$.",
              "worked": "For $x<0$, $|x|=-x$, so$$\\begin{align*}f(g(x))&=f(-x)\\\\f(g(x))&=(-x)^2-x-3\\\\f(g(x))&=x^2-x-3.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      }
    ]
  },
