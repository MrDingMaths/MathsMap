        "label": "a",
        "prompt": "How many functions are there from $X$ to $Y$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^3=125$.",
          "worked": "Each of the three elements of $X$ has five possible images in $Y$.\n$$\\begin{align*}N&=5\\times5\\times5\\\\N&=125.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "How many of them are one-to-one?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{5}P_3=60$.",
          "worked": "The three images must be distinct, giving five, four and three choices in turn.\n$$\\begin{align*}N&={}^{5}P_3\\\\N&=5\\times4\\times3\\\\N&=60.\\end{align*}$$",
