          "worked": "$\\begin{align*}\\frac{x+10}{6}&=\\frac{20+10}{6}\\\\\\frac{x+10}{6}&=\\frac{30}{6}\\\\\\frac{x+10}{6}&=5\\end{align*}$",
          "solutionDiagrams": []
