  "content": {
    "id": "p34-challenge-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the value of $x$ if $\\frac{4^{1/2}}{\\sqrt[3]{8^2}}=2^x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-1$.",
      "worked": "$$\\begin{align*}\\frac{4^{1/2}}{\\sqrt[3]{8^2}}&=\\frac{(2^2)^{1/2}}{((2^3)^2)^{1/3}}\\\\\\frac{4^{1/2}}{\\sqrt[3]{8^2}}&=\\frac{2}{2^2}\\\\\\frac{4^{1/2}}{\\sqrt[3]{8^2}}&=2^{-1}\\end{align*}$$\nEquating indices gives $x=-1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
