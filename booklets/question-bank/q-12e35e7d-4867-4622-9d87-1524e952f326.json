          "worked": "$$\\begin{align*}(a+5)(a+8)&=a^2+8a+5a+40\\\\(a+5)(a+8)&=a^2+13a+40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
