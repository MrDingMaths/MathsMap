  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The height in centimetres of a sunflower seedling is given by $H=5t^2+2t$, where $t$ is time in weeks. Find the rate at which the seedling is growing after 3 weeks.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$32\\text{ cm/week}$",
      "worked": "$$\\begin{align*}\\frac{dH}{dt}&=10t+2\\\\\\left.\\frac{dH}{dt}\\right|_{t=3}&=10(3)+2\\\\&=32\\text{ cm/week}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
