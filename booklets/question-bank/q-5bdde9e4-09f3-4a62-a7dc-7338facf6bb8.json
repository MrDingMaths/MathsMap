  "content": {
    "id": "p6-p4-root",
    "type": "question",
    "label": null,
    "prompt": "Define the function $f(x)=x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-p4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(1+h)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1+h)^2$",
          "worked": "$$\\begin{align*}f(1+h)&=(1+h)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p6-p4-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p6-p4-b-cue",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hence, find the value of",
                  "marks": []
                }
              ]
            },
            {
              "id": "p6-p4-b-limit",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=\\lim_{h\\to0}\\frac{(1+h)^2-1}{h}\\\\\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=\\lim_{h\\to0}\\frac{2h+h^2}{h}\\\\\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=\\lim_{h\\to0}(2+h)\\\\\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=2+0\\\\\\lim_{h\\to0}\\frac{f(1+h)-f(1)}{h}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
