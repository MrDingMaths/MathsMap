  "content": {
    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A manufacturer of drink cans produces cylindrical cans with a volume of $1000\\text{ cm}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "If the radius of the can is $4\\text{ cm}$, find the height of the can, correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19.9\\text{ cm}$",
          "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\1000&=\\pi\\times4^2\\times h\\\\h&=\\frac{1000}{16\\pi}\\\\h&\\approx19.9\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "If the height of the can is $8\\text{ cm}$, find the radius of the can, correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.31\\text{ cm}$",
          "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\1000&=\\pi\\times r^2\\times8\\\\r^2&=\\frac{125}{\\pi}\\\\r&=\\sqrt{\\frac{125}{\\pi}}\\\\r&\\approx6.31\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
