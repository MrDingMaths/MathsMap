    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^3-4x^2+3x-2$. Find the value(s) of $a$ such that $f(a)=-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=0$, $a=1$ or $a=3$.",
      "worked": "$$\\begin{align*}a^3-4a^2+3a-2&=-2\\\\a^3-4a^2+3a&=0\\\\a(a^2-4a+3)&=0\\\\a(a-1)(a-3)&=0\\\\a&=0,\\ 1\\text{ or }3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
