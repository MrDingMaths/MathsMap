  "content": {
    "id": "v2-835d9511f29-p25-q2-slot-17-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Use the prime factors of the denominator to decide whether each fraction is a terminating or recurring decimal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-835d9511f29-p25-q2-slot-17-lower-slot-17-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{7}{40}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Terminating.",
          "worked": "$$\\begin{align*}40&=2\\times2\\times2\\times5\\\\40&=2^3\\times5\\end{align*}$$\n\nThe only prime factors are $2$ and $5$, so the decimal terminates.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-835d9511f29-p25-q2-slot-17-lower-slot-17-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{5}{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Recurring.",
          "worked": "$$\\begin{align*}18&=2\\times3\\times3\\\\18&=2\\times3^2\\end{align*}$$\n\nThe prime factor $3$ is not $2$ or $5$, so the decimal recurs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-835d9511f29-p25-q2-slot-17-lower-slot-17-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{21}{60}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Terminating.",
          "worked": "$$\\begin{align*}\\frac{21}{60}&=\\frac{7}{20}\\\\20&=2\\times2\\times5\\\\20&=2^2\\times5\\end{align*}$$\n\nThe simplified denominator has only prime factors $2$ and $5$, so the decimal terminates.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
