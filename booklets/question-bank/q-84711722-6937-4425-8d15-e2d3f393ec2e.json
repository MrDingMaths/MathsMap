  "content": {
    "id": "p18-q18-response",
    "type": "question",
    "label": "18",
    "prompt": "40 children take part in a school show. All the children either sing, dance or do both.\n35 children dance. 28 children sing.\nHow many children sing and dance?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "23 children.",
      "worked": "All children sing, dance or do both, so the union contains 40 children. Let $x$ be the number who sing and dance.\nUsing the addition rule:\n$$\\begin{align*}40&=35+28-x\\\\40&=63-x\\\\x&=23\\end{align*}$$\n23 children sing and dance.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
