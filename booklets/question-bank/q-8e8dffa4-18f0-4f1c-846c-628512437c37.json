  "content": {
    "id": "p7-q26-root",
    "type": "question",
    "label": null,
    "prompt": "When the polynomial $P(x)=x^3+ax+b$ is divided by $x(x+1)$, the remainder is $3x+5$. Find $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
