  "content": {
    "id": "p68-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write an equation to represent these statements.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "8 less than $t$ is equal to 14",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t-8=14$",
          "worked": "“8 less than $t$” means $t-8$.\n$$t-8=14$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p68-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Half of $y$ is 13",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y}{2}=13$",
          "worked": "Half of $y$ means $y$ divided by 2.\n$$\\frac{y}{2}=13$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "45 is 3 times $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45=3x$",
          "worked": "Three times $x$ is $3x$.\n$$45=3x$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p68-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "The value of $a$ is 4 times the sum of 8 and 12",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4(8+12)$",
          "worked": "Group the sum $8+12$ before multiplying by 4.\n$$a=4(8+12)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p68-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "A quarter of $z$ is 3 larger than 12",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{z}{4}=12+3$",
          "worked": "A quarter of $z$ is $\\frac{z}{4}$; 3 larger than 12 is $12+3$.\n$$\\frac{z}{4}=12+3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "One-fifth of double of $t$ is 12.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2t}{5}=12$",
          "worked": "Double $t$ to get $2t$, then divide by 5.\n$$\\frac{2t}{5}=12$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q5-g",
        "type": "part",
        "label": "g",
        "prompt": {
          "format": "maths-editor-document-v1",
