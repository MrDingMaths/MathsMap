        },
        "answerSpaceMm": 12
      },
      {
        "id": "p68-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "Amy is $f$ years old. In 10 years’ time her age will be 27.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
