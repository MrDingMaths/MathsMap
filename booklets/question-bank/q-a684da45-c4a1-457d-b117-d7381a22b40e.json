    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\pm12$",
      "worked": "Exactly one real solution requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=k^2-4(9)(4)\\\\0&=k^2-144\\\\k^2&=144\\\\k&=\\pm12\\end{align*}$$",
