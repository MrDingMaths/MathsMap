          "inlines": [
            {
              "type": "text",
              "text": "Boyle’s law states that, for a fixed amount of gas at constant temperature, the pressure ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "P",
              "display": false
            },
            {
              "type": "text",
              "text": " in a container is inversely proportional to the volume ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "V",
              "display": false
            },
            {
              "type": "text",
              "text": " of the container.",
              "marks": []
