      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the volume if the pressure is $3.75\\text{ kg/cm}^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{55}{3}\\text{ cm}^3$.",
          "worked": "Since pressure and volume are inversely proportional, $PV=k$.\n$$\\begin{align*}k&=2.5\\times27.5\\\\k&=\\frac{275}{4}\\\\V&=\\frac{k}{P}\\\\V&=\\frac{275/4}{15/4}\\\\V&=\\frac{55}{3}\\text{ cm}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the pressure if the volume is reduced to $20\\text{ cm}^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{55}{16}\\text{ kg/cm}^2$.",
          "worked": "Using $PV=k$ with $k=\\dfrac{275}{4}$,\n$$\\begin{align*}P&=\\frac{k}{V}\\\\P&=\\frac{275/4}{20}\\\\P&=\\frac{55}{16}\\text{ kg/cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
