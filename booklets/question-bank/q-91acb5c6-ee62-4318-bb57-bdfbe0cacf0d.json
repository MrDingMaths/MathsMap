          ]
        },
        {
          "id": "p8-q5-data",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "At a given time, the volume of the canister is ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "27.5\\text{ cm}^3",
              "display": false
            },
            {
              "type": "text",
              "text": " and the pressure is ",
