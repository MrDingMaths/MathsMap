  "content": {
    "id": "v2-ifficulty-metadata-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "A 90 m roll of fencing wire is cut into two pieces.\nThe longer piece is 6 m more than twice the length of the shorter piece.\nHow long is the longer piece?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "62 m; $x+(2x+6)=90$.",
      "worked": "Let $x$ be the length of the shorter piece in metres. The longer piece is $2x+6$ metres.\n\n$$\\begin{align*}x+(2x+6)&=90\\\\3x+6&=90\\\\3x&=84\\\\x&=28\\end{align*}$$\n\nThe longer piece is $2(28)+6=62$ m.\n\nCheck: $28+62=90$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
