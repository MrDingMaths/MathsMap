  "content": {
    "id": "p41-r",
    "type": "question",
    "label": "r",
    "prompt": "The value of an investor's shares dropped by 18% to $\\$30\\,750$ in a financial crash. What was the value of the shares before the crash?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$37\\,500$",
      "worked": "The final value represents $100\\%-18\\%=82\\%$ of the original.\n$$\\begin{align*}82\\%&=\\$30\\,750\\\\1\\%&=\\frac{\\$30\\,750}{82}\\\\1\\%&=\\$375\\\\100\\%&=\\$375\\times100\\\\100\\%&=\\$37\\,500\\end{align*}$$\nThe shares were worth $\\$37\\,500$ before the crash.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
