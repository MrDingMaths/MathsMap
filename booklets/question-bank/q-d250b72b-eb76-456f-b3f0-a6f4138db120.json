  "content": {
    "id": "p30-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In each case identify how the graph of the second equation can be obtained from the graph of the first by a suitable dilation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-2x$ and $y=3x^2-6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Vertical dilation by factor $3$ from the $x$-axis.",
          "worked": "For $f(x)=x^2-2x$,\n$$\\begin{align*}3f(x)&=3(x^2-2x)\\\\3f(x)&=3x^2-6x.\\end{align*}$$\nMultiply each $y$-coordinate by $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p30-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{1}{x-4}$ and $y=\\frac{1}{2x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal dilation by factor $\\frac12$ from the $y$-axis.",
          "worked": "For $f(x)=\\frac{1}{x-4}$,\n$$f(2x)=\\frac{1}{2x-4}.$$\nReplacing $x$ by $2x$ multiplies every $x$-coordinate by $\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p30-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=3^x$ and $y=3^{\\frac14x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal dilation by factor $4$ from the $y$-axis.",
          "worked": "For $f(x)=3^x$,\n$$f\\left(\\frac{x}{4}\\right)=3^{x/4}.$$\nReplacing $x$ by $\\frac{x}{4}$ multiplies every $x$-coordinate by $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{1}{x+1}$ and $y=\\frac{2}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Vertical dilation by factor $2$ from the $x$-axis.",
          "worked": "For $f(x)=\\frac{1}{x+1}$,\n$$2f(x)=\\frac{2}{x+1}.$$\nMultiply each $y$-coordinate by $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
