        "type": "part",
        "label": "a",
        "prompt": "A circle with centre the origin passes through the point $(-3,5)$. Find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=34$",
          "worked": "$$\\begin{align*}r^2&=(-3)^2+5^2\\\\&=34\\end{align*}$$\nHence the equation is\n$$x^2+y^2=34.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-218388-p5-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The point $(2,k)$ lies on the circle $x^2+y^2=20$. Find the possible values of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4$ or $k=-4$",
          "worked": "$$\\begin{align*}2^2+k^2&=20\\\\k^2&=16\\\\k&=\\pm4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
