  "content": {
    "id": "p33-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Write the equation of the parabola obtained when the graph of $y=3x^2$ is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "translated 3 units to the left and 2 units up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3(x+3)^2+2$",
          "worked": "Translating 3 units left replaces $x$ with $x+3$:\n$$y=3(x+3)^2.$$\nTranslating 2 units up adds 2:\n$$y=3(x+3)^2+2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "translated 3 units to the right and 2 units down",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3(x-3)^2-2$",
          "worked": "Translating 3 units right replaces $x$ with $x-3$:\n$$y=3(x-3)^2.$$\nTranslating 2 units down subtracts 2:\n$$y=3(x-3)^2-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
