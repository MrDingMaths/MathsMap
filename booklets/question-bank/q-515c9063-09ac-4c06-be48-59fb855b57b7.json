    "type": "question",
    "label": "9",
    "prompt": "Due to market demands, the cost of petrol increases by $2\\%$, $5\\%$ and $4\\%$ in three successive months. By what percentage has the cost of petrol increased over the three-month period?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$11.384\\%$ increase.",
      "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.02\\times1.05\\times1.04\\\\\\text{Combined multiplier}&=1.11384\\\\\\text{Percentage increase}&=(1.11384-1)\\times100\\%\\\\\\text{Percentage increase}&=11.384\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
