    "children": [
      {
        "id": "p30-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\int_{-1}^{0}(1-2x)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\int_{-1}^{0}(1-2x)\\,dx&=[x-x^2]_{-1}^{0}\\\\&=(0-0)-(-1-1)\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\int_{-1}^{0}(2x+3)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\int_{-1}^{0}(2x+3)\\,dx&=[x^2+3x]_{-1}^{0}\\\\&=(0+0)-(1-3)\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\int_{-2}^{1}3x^2\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{aligned}\\int_{-2}^{1}3x^2\\,dx&=[x^3]_{-2}^{1}\\\\&=1^3-(-2)^3\\\\&=1-(-8)\\\\&=9\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\int_{-1}^{2}(4x^3+5)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{aligned}\\int_{-1}^{2}(4x^3+5)\\,dx&=[x^4+5x]_{-1}^{2}\\\\&=(2^4+5\\times2)-((-1)^4+5\\times(-1))\\\\&=26-(-4)\\\\&=30\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\int_{-2}^{2}(5x^4+6x^2)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$96$",
          "worked": "$$\\begin{aligned}\\int_{-2}^{2}(5x^4+6x^2)\\,dx&=[x^5+2x^3]_{-2}^{2}\\\\&=(2^5+2\\times2^3)-((-2)^5+2\\times(-2)^3)\\\\&=48-(-48)\\\\&=96\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\int_{-2}^{-1}(4x^3+12x^2-3)\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{aligned}\\int_{-2}^{-1}(4x^3+12x^2-3)\\,dx&=[x^4+4x^3-3x]_{-2}^{-1}\\\\&=\\bigl((-1)^4+4(-1)^3-3(-1)\\bigr)-\\bigl((-2)^4+4(-2)^3-3(-2)\\bigr)\\\\&=(1-4+3)-(16-32+6)\\\\&=0-(-10)\\\\&=10\\end{aligned}$$",
          "solutionDiagrams": []
