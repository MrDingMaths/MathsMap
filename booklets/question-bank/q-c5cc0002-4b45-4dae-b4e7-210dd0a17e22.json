      {
        "id": "p11-q4-explanation",
        "type": "part",
        "label": "a",
        "prompt": "Explain why rounding to 1 significant figure is not always the same as rounding to the nearest $1000$. Give an example.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The first significant digit is not always in the thousands place. For example, $81$ rounds to $80$ to 1 s.f., but to $0$ to the nearest $1000$.",
          "worked": "Rounding to 1 significant figure uses the place value of the first non-zero digit. For $7382$, this is the thousands place; for $81$, it is the tens place.\n$$\\begin{aligned}81&\\approx80\\quad(1\\text{ s.f.})\\\\81&\\approx0\\quad(\\text{nearest }1000)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
