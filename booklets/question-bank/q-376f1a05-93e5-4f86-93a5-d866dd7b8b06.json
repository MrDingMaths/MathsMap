  "content": {
    "id": "index-t10-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3a \\times 3a \\times 3a}{3a + 3a + 3a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^{2}$\n\nExpand the product in the numerator and collect like terms in the denominator before simplifying.",
          "worked": "$$\\begin{align*}\\frac{3a\\times3a\\times3a}{3a+3a+3a}&=\\frac{27a^3}{9a} \\\\ &=3a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3c \\times 4c^{2} \\times 5c^{3}}{3c + 4c^{2} + 5c^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{60c^{5}}{3 + 4c + 5c^{2}}$",
          "worked": "$$\\begin{align*}\\frac{3c\\times4c^2\\times5c^3}{3c+4c^2+5c^3}&=\\frac{60c^6}{c(3+4c+5c^2)} \\\\ &=\\frac{60c^5}{3+4c+5c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{ab^{2} \\times 2b^{2}c^{3} \\times 3c^{3}a^{4}}{a^{3}b^{3} + 2a^{3}b^{3} + 3a^{3}b^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2}bc^{6}$",
          "worked": "$$\\begin{align*}\\frac{ab^2\\times2b^2c^3\\times3c^3a^4}{a^3b^3+2a^3b^3+3a^3b^3}&=\\frac{6a^5b^4c^6}{6a^3b^3} \\\\ &=a^2bc^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q8-root-bank-index-t10-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2a+2a+2a}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$\\frac{2a+2a+2a}{2a}=\\frac{6a}{2a}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "index-t10-q8-root-bank-index-t10-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2a\\times2a+2a}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+1$",
          "worked": "$\\frac{2a\\times2a+2a}{2a}=\\frac{4a^2+2a}{2a}=2a+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "index-t10-q8-root-bank-index-t10-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2a\\times2a\\times2a}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2$",
          "worked": "$\\frac{2a\\times2a\\times2a}{2a}=\\frac{8a^3}{2a}=4a^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
