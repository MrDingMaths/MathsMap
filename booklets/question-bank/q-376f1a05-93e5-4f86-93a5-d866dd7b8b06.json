  "content": {
    "id": "index-t10-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3a \\times 3a \\times 3a}{3a + 3a + 3a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^{2}$",
          "worked": "$$\\begin{align*}\\frac{3a\\times3a\\times3a}{3a+3a+3a}&=\\frac{27a^3}{9a} \\\\ &=3a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3c \\times 4c^{2} \\times 5c^{3}}{3c + 4c^{2} + 5c^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{60c^{5}}{3 + 4c + 5c^{2}}$",
          "worked": "$$\\begin{align*}\\frac{3c\\times4c^2\\times5c^3}{3c+4c^2+5c^3}&=\\frac{60c^6}{c(3+4c+5c^2)} \\\\ &=\\frac{60c^5}{3+4c+5c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{ab^{2} \\times 2b^{2}c^{3} \\times 3c^{3}a^{4}}{a^{3}b^{3} + 2a^{3}b^{3} + 3a^{3}b^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2}bc^{6}$",
          "worked": "$$\\begin{align*}\\frac{ab^2\\times2b^2c^3\\times3c^3a^4}{a^3b^3+2a^3b^3+3a^3b^3}&=\\frac{6a^5b^4c^6}{6a^3b^3} \\\\ &=a^2bc^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
