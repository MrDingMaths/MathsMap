  "content": {
    "id": "p34-p",
    "type": "question",
    "label": "p",
    "prompt": "Prove that\n$$(\\sec\\theta+\\tan\\theta)^2=\\frac{1+\\sin\\theta}{1-\\sin\\theta}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "LHS $=\\dfrac{(1+\\sin\\theta)^2}{(1-\\sin\\theta)(1+\\sin\\theta)}=\\dfrac{1+\\sin\\theta}{1-\\sin\\theta}=$ RHS.",
      "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\left(\\frac{1}{\\cos\\theta}+\\frac{\\sin\\theta}{\\cos\\theta}\\right)^2\\\\&=\\left(\\frac{1+\\sin\\theta}{\\cos\\theta}\\right)^2\\\\&=\\frac{(1+\\sin\\theta)^2}{\\cos^2\\theta}\\\\&=\\frac{(1+\\sin\\theta)^2}{1-\\sin^2\\theta}\\\\&=\\frac{(1+\\sin\\theta)^2}{(1-\\sin\\theta)(1+\\sin\\theta)}\\\\&=\\frac{1+\\sin\\theta}{1-\\sin\\theta}\\\\&=\\mathrm{RHS}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 50
  },
