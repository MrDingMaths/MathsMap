        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{x+3}$",
          "worked": "Let the missing fraction be $F$.\n$$\\begin{align*}F&=2\\times\\frac{5}{x+3}\\\\&=\\frac{10}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
