        "answer": {
          "short": "$\\dfrac{10x}{3}$",
          "worked": "Let the missing fraction be $F$.\n$$\\begin{align*}F&=\\frac{5x}{x-1}\\times\\frac{2x-2}{3}\\\\&=\\frac{5x}{x-1}\\times\\frac{2(x-1)}{3}\\\\&=\\frac{10x}{3}\\end{align*}$$",
          "solutionDiagrams": []
