            "children": [],
            "answer": {
              "short": "$64=8^2$",
              "worked": "$$64=8^2$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p25-q14-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\log_{64}8=\\dfrac12$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8=64^{\\frac12}$",
              "worked": "$$8=64^{\\frac12}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p25-q14-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\log_8\\dfrac1{64}=-2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac1{64}=8^{-2}$",
              "worked": "$$\\frac1{64}=8^{-2}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p25-q14-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\log_{64}\\dfrac18=-\\dfrac12$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac18=64^{-\\frac12}$",
              "worked": "$$\\frac18=64^{-\\frac12}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p25-q14-continuation",
        "type": "group",
        "label": null,
        "prompt": "Hence evaluate the following:",
