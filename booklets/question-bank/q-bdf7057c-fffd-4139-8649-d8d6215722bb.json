        "children": [
          {
            "id": "p25-q14-e",
            "type": "part",
            "label": "e",
            "prompt": "$\\log_2 8$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$$\\begin{align*}x&=\\log_2 8\\\\2^x&=8\\\\x&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p25-q14-f",
            "type": "part",
            "label": "f",
            "prompt": "$\\log_8 2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac13$",
              "worked": "$$\\begin{align*}x&=\\log_8 2\\\\8^x&=2\\\\x&=\\frac13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p25-q14-g",
            "type": "part",
            "label": "g",
            "prompt": "$\\log_2\\dfrac18$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3$",
              "worked": "$$\\begin{align*}x&=\\log_2\\frac18\\\\2^x&=\\frac18\\\\x&=-3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p25-q14-h",
            "type": "part",
            "label": "h",
            "prompt": "$\\log_8\\dfrac12$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\dfrac13$",
              "worked": "$$\\begin{align*}x&=\\log_8\\frac12\\\\8^x&=\\frac12\\\\x&=-\\frac13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      }
