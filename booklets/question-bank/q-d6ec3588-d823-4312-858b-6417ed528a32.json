  "content": {
    "id": "p28-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If $x$ is a solution of $x+\\dfrac{1}{x}=3$, find $x^2+\\dfrac{1}{x^2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7$.\n\nSquare the given sum and subtract its cross term, $2$.",
      "worked": "Since $x\\ne0$, squaring the given equation gives\n$$\\begin{align*}\\left(x+\\frac{1}{x}\\right)^2&=9\\\\x^2+2x\\left(\\frac{1}{x}\\right)+\\frac{1}{x^2}&=9\\\\x^2+2+\\frac{1}{x^2}&=9\\\\x^2+\\frac{1}{x^2}&=7.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
