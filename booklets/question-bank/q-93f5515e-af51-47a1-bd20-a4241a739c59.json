  "content": {
    "id": "p58-q30-root",
    "type": "question",
    "label": "30",
    "prompt": "Sketch $y=x\\sqrt{16-x^2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Closed endpoints $(-4,0)$ and $(4,0)$; passes through $(0,0)$. Minimum $(-2\\sqrt2,-8)$, maximum $(2\\sqrt2,8)$ and point of inflection $(0,0)$. The curve has odd symmetry.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p58-q30-domain",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Domain: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "16-x^2\\ge0,\\quad -4\\le x\\le4",
                "display": false
              },
              {
                "type": "text",
                "text": ". The function is odd, so its graph has rotational symmetry about the origin. There are no asymptotes.",
                "marks": []
              }
            ]
          },
          {
            "id": "p58-q30-intercepts",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x\\sqrt{16-x^2}=0",
                "display": false
              },
              {
                "type": "text",
                "text": " gives intercepts ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(-4,0),\\ (0,0),\\ (4,0)",
                "display": false
              },
              {
                "type": "text",
                "text": ". Both domain endpoints are included.",
                "marks": []
              }
            ]
          },
          {
            "id": "p58-q30-first-derivative",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y'&=\\sqrt{16-x^2}+x\\frac{-2x}{2\\sqrt{16-x^2}}\\\\y'&=\\frac{16-2x^2}{\\sqrt{16-x^2}}\\\\0&=16-2x^2\\\\x^2&=8\\\\x&=\\pm2\\sqrt2\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p58-q30-stationary-values",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y(-2\\sqrt2)&=(-2\\sqrt2)\\sqrt{16-8}=-8\\\\y(2\\sqrt2)&=(2\\sqrt2)\\sqrt{16-8}=8\\end{aligned}",
                "display": true
              }
            ]
          },
