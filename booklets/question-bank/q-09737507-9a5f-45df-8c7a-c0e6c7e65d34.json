  "content": {
    "id": "p12-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Express each of the following with a rational denominator:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{\\sqrt[3]{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2^{2/3}}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt[3]{2}}&=\\frac{1}{2^{1/3}}\\\\\\frac{1}{\\sqrt[3]{2}}&=\\frac{2^{2/3}}{2^{1/3}2^{2/3}}\\\\\\frac{1}{\\sqrt[3]{2}}&=\\frac{2^{2/3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{\\sqrt[3]{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3^{2/3}}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt[3]{3}}&=\\frac{1}{3^{1/3}}\\\\\\frac{1}{\\sqrt[3]{3}}&=\\frac{3^{2/3}}{3^{1/3}3^{2/3}}\\\\\\frac{1}{\\sqrt[3]{3}}&=\\frac{3^{2/3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\sqrt[4]{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2^{3/4}}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt[4]{2}}&=\\frac{1}{2^{1/4}}\\\\\\frac{1}{\\sqrt[4]{2}}&=\\frac{2^{3/4}}{2^{1/4}2^{3/4}}\\\\\\frac{1}{\\sqrt[4]{2}}&=\\frac{2^{3/4}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2}{\\sqrt[4]{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\times3^{3/4}}{3}$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt[4]{3}}&=\\frac{2}{3^{1/4}}\\\\\\frac{2}{\\sqrt[4]{3}}&=\\frac{2\\times3^{3/4}}{3^{1/4}3^{3/4}}\\\\\\frac{2}{\\sqrt[4]{3}}&=\\frac{2\\times3^{3/4}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt[3]{\\dfrac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2^{1/3}3^{2/3}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{\\frac{2}{3}}&=\\frac{2^{1/3}}{3^{1/3}}\\\\\\sqrt[3]{\\frac{2}{3}}&=\\frac{2^{1/3}3^{2/3}}{3^{1/3}3^{2/3}}\\\\\\sqrt[3]{\\frac{2}{3}}&=\\frac{2^{1/3}3^{2/3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt[4]{\\dfrac{4}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2^{1/2}5^{3/4}}{5}$",
          "worked": "$$\\begin{align*}\\sqrt[4]{\\frac{4}{5}}&=\\frac{4^{1/4}}{5^{1/4}}\\\\\\sqrt[4]{\\frac{4}{5}}&=\\frac{2^{1/2}}{5^{1/4}}\\\\\\sqrt[4]{\\frac{4}{5}}&=\\frac{2^{1/2}5^{3/4}}{5^{1/4}5^{3/4}}\\\\\\sqrt[4]{\\frac{4}{5}}&=\\frac{2^{1/2}5^{3/4}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt[3]{\\dfrac{8}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\times5^{2/3}}{5}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{\\frac{8}{5}}&=\\frac{2}{5^{1/3}}\\\\\\sqrt[3]{\\frac{8}{5}}&=\\frac{2\\times5^{2/3}}{5^{1/3}5^{2/3}}\\\\\\sqrt[3]{\\frac{8}{5}}&=\\frac{2\\times5^{2/3}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt[4]{\\dfrac{16}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\times3^{3/4}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt[4]{\\frac{16}{3}}&=\\frac{2}{3^{1/4}}\\\\\\sqrt[4]{\\frac{16}{3}}&=\\frac{2\\times3^{3/4}}{3^{1/4}3^{3/4}}\\\\\\sqrt[4]{\\frac{16}{3}}&=\\frac{2\\times3^{3/4}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
