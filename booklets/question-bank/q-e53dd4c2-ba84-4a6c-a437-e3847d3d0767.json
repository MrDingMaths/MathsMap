  "content": {
    "id": "p36-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "A ferry’s mean travel time is 3.1 hours. About 47.5% of the time the ferry takes between 3.1 and 3.5 hours.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the standard deviation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2$ hours",
          "worked": "By the empirical rule, approximately $95\\%$ lies within two standard deviations of the mean, so $47.5\\%$ lies between $\\mu$ and $\\mu+2\\sigma$.\n$$\\begin{aligned}3.1+2\\sigma&=3.5\\\\2\\sigma&=0.4\\\\\\sigma&=0.2\\text{ hours}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p36-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the travel time that is $3\\sigma$ below the mean.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.5$ hours",
          "worked": "$$\\begin{aligned}\\mu-3\\sigma&=3.1-3(0.2)\\\\&=2.5\\text{ hours}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
  },
