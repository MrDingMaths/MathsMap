      {
        "id": "p118-q46-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $f(x)$ as a piecewise-defined function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$f(x)=\\begin{cases}0&\\text{if }x\\in\\mathbb{Z},\\\\1&\\text{if }x\\notin\\mathbb{Z}.\\end{cases}$$",
          "worked": "At an integer, the ceiling and floor are equal. Between consecutive integers, the ceiling exceeds the floor by $1$. Hence\n$$f(x)=\\begin{cases}0&\\text{if }x\\in\\mathbb{Z},\\\\1&\\text{if }x\\notin\\mathbb{Z}.\\end{cases}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
