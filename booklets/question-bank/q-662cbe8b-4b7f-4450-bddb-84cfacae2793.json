  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "",
    "prompt": "Solve the following equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x-\\dfrac{4}{x}=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2$.",
          "worked": "Since $x\\ne0$, multiply by $x$.\n$$\\begin{align*}x^2-4&=0\\\\x^2&=4\\\\x&=\\pm2\\end{align*}$$\nBoth values are nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{36}{x}-x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm6$.",
          "worked": "Since $x\\ne0$, multiply by $x$.\n$$\\begin{align*}36-x^2&=0\\\\x^2&=36\\\\x&=\\pm6\\end{align*}$$\nBoth values are nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3}{x^2}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm1$.",
          "worked": "Since $x\\ne0$, multiply by $x^2$.\n$$\\begin{align*}3&=3x^2\\\\x^2&=1\\\\x&=\\pm1\\end{align*}$$\nBoth values are nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$5(x^2+1)=3x^2+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm1$.",
          "worked": "$$\\begin{align*}5x^2+5&=3x^2+7\\\\2x^2&=2\\\\x^2&=1\\\\x&=\\pm1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$x(x-3)=2x^2+4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $-7$.",
          "worked": "$$\\begin{align*}x^2-3x&=2x^2+4x\\\\x^2+7x&=0\\\\x(x+7)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $x+7=0$.\nHence $x=0$ or $-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x(5-x)=x(7-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $4$.",
          "worked": "$$\\begin{align*}15x-3x^2&=7x-x^2\\\\2x^2-8x&=0\\\\2x(x-4)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $x-4=0$.\nHence $x=0$ or $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
