            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}z&=\\frac{x-\\mu}{\\sigma}\\\\2.7&=\\frac{39-\\mu}{4.5}\\\\\\mu&=39-12.15\\\\\\mu&=26.85\\end{aligned}",
