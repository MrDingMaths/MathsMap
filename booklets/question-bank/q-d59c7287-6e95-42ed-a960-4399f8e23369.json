    "type": "question",
    "label": "9",
    "prompt": "A normally distributed data set has standard deviation 4.5. A score of 39 has a $z$-score of 2.7.\nFind the mean.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$26.85$",
