  "content": {
    "id": "p53-q1-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $y'=ky$, where $k$ is an unknown constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=Ae^{kx}$.",
          "worked": "$$\\begin{align*}\\frac{dy}{y}&=k\\,dx\\\\\\ln|y|&=kx+C\\\\y&=Ae^{kx}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p53-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate the arbitrary constant given $y(0)=20$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=20$, so $y=20e^{kx}$.",
          "worked": "$$\\begin{align*}20&=Ae^{k(0)}\\\\A&=20\\\\y&=20e^{kx}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p53-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Evaluate $k$ given $y(2)=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-\\ln 2$.",
          "worked": "$$\\begin{align*}5&=20e^{2k}\\\\e^{2k}&=\\frac14\\\\2k&=\\ln\\frac14\\\\k&=-\\ln2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p53-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Simplify the solution and evaluate $y(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=20\\cdot2^{-x}$; $y(3)=2.5$.",
          "worked": "$$\\begin{align*}y&=20e^{-x\\ln2}\\\\y&=20\\cdot2^{-x}\\\\y(3)&=20\\cdot2^{-3}\\\\y(3)&=2.5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
