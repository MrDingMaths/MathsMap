  "content": {
    "id": "p5-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Let $f(x)=2x+3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\{f(x)\\in\\mathbb{R}:1\\le x\\le2\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[5,7]$",
          "worked": "$$\\begin{align*}f(1)&=2(1)+3\\\\f(1)&=5\\\\f(2)&=2(2)+3\\\\f(2)&=7\\end{align*}$$\nSince $f$ is increasing, the outputs fill $[5,7]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\{x\\in\\mathbb{R}:2\\le f(x)\\le4\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left[-\\frac12,\\frac12\\right]$",
          "worked": "$$\\begin{align*}2&\\le2x+3\\le4\\\\-1&\\le2x\\le1\\\\-\\frac12&\\le x\\le\\frac12\\end{align*}$$\nThe required set is $\\left[-\\frac12,\\frac12\\right]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
