  "content": {
    "id": "p3-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Calculate the amount that an investment of $\\$12\\,000$ will be worth if it is invested at 8% p.a. for 6 years compounded as follows. Give your answers to the nearest cent.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "annually",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$19\\,042.49$",
          "worked": "$R=0.08$ per year and $n=6$.\n$$\\begin{align*}A_6&=12\\,000(1+0.08)^6\\\\A_6&=12\\,000(1.08)^6\\\\A_6&\\approx\\$19\\,042.49\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "quarterly (assume 2% per quarter)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$19\\,301.25$",
          "worked": "$R=0.02$ per quarter and $n=6\\times4=24$.\n$$\\begin{align*}A_{24}&=12\\,000(1+0.02)^{24}\\\\A_{24}&=12\\,000(1.02)^{24}\\\\A_{24}&\\approx\\$19\\,301.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "monthly (assume $\\frac{2}{3}\\%$ per month)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$19\\,362.03$",
          "worked": "$R=\\frac{2}{3}\\div100=\\frac{1}{150}$ per month and $n=6\\times12=72$.\n$$\\begin{align*}A_{72}&=12\\,000\\left(1+\\frac{1}{150}\\right)^{72}\\\\A_{72}&=12\\,000\\left(\\frac{151}{150}\\right)^{72}\\\\A_{72}&\\approx\\$19\\,362.03\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
