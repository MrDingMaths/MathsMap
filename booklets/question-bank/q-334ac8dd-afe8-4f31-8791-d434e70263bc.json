  "content": {
    "id": "p15-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "There are two ways to express $720$ as a product of consecutive integers:\n$$1\\times2\\times3\\times4\\times5\\times6=8\\times9\\times10.$$\nFind a second way to express\n$$8\\times9\\times10\\times11\\times12\\times13\\times14$$\nas a product of consecutive integers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$63\\times64\\times65\\times66$.\n\nRegroup the prime factors into four consecutive integers.",
      "worked": "Prime factorisation gives\n$$\\begin{align*}8\\times9\\times10\\times11\\times12\\times13\\times14&=2^7\\times3^3\\times5\\times7\\times11\\times13\\\\8\\times9\\times10\\times11\\times12\\times13\\times14&=(3^2\\times7)\\times2^6\\times(5\\times13)\\times(2\\times3\\times11)\\\\8\\times9\\times10\\times11\\times12\\times13\\times14&=63\\times64\\times65\\times66.\\end{align*}$$\nThese four integers are consecutive.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
