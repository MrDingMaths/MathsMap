    "id": "p22-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "What can be said about the graph of $y=ax^2+bx+c$ if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "$a>0$ and $c<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A concave-up parabola with two distinct roots.",
          "worked": "Since $a>0$, the parabola opens upwards. Since $ac<0$, $\\Delta=b^2-4ac>0$, so it crosses the $x$-axis at two distinct points.",
