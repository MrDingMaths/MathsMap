  "content": {
    "id": "v2-55815-p13-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "The marks in a Biology exam are normally distributed with standard deviation $6.5$. A mark of $49$ has z-score $-1.4$.\nFind the mean.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$58.1$",
      "worked": "$$\\begin{align*}z&=\\frac{x-\\mu}{\\sigma}\\\\-1.4&=\\frac{49-\\mu}{6.5}\\\\-9.1&=49-\\mu\\\\\\mu&=49+9.1\\\\\\mu&=58.1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
