  "content": {
    "id": "p19-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A committee of 4 students is to be chosen from a group of 5 boys and 6 girls. How many ways can this be done?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$330$",
          "worked": "Choose four students from the $5+6=11$ students.\n$$\\binom{11}{4}=330.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "if two boys and two girls are chosen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150$",
          "worked": "Choose two boys from five and two girls from six. Multiply the numbers of selections.\n$$\\binom{5}{2}\\binom{6}{2}=10\\times15=150.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "if at least one boy and one girl are chosen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
