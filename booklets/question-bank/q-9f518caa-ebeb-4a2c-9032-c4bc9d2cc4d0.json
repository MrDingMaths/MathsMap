  "content": {
    "id": "p29-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "The ratio of the radius to height of a cylinder is $2:3$. Find the radius and height of the cylinder given its surface area is $80\\pi\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$r=4\\text{ cm},\\quad h=6\\text{ cm}$",
      "worked": "Let $r=2k$ and $h=3k$, where $k>0$.\n$$\\begin{align*}2\\pi r^2+2\\pi rh&=80\\pi\\\\2\\pi(2k)^2+2\\pi(2k)(3k)&=80\\pi\\\\20\\pi k^2&=80\\pi\\\\k^2&=4\\\\k&=2\\end{align*}$$\nTherefore $r=4\\text{ cm}$ and $h=6\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
