      {
        "id": "p40-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the temperature after 2 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.5^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}T&=96\\times\\left(\\frac12\\right)^{3\\times2}\\\\T&=\\frac{96}{64}\\\\T&=1.5\\end{align*}$$\nThe temperature is $1.5^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p40-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Write the equation with the time $n$ in hours as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac13\\log_{1/2}\\left(\\frac{T}{96}\\right)$",
          "worked": "$$\\begin{align*}\\frac{T}{96}&=\\left(\\frac12\\right)^{3n}\\\\3n&=\\log_{1/2}\\left(\\frac{T}{96}\\right)\\\\n&=\\frac13\\log_{1/2}\\left(\\frac{T}{96}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p40-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "How long does it take, correct to the nearest minute, for the temperature to fall to $1^\\circ\\mathrm{C}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "132 minutes (2 hours 12 minutes).",
          "worked": "$$\\begin{align*}n&=\\frac13\\log_{1/2}\\left(\\frac1{96}\\right)\\\\n&=\\frac{\\log_{10}(1/96)}{3\\log_{10}(1/2)}\\end{align*}$$\nIn minutes, the time is $60\\times\\frac{\\log_{10}(\\frac{1}{96})}{3\\log_{10}(\\frac{1}{2})}\\approx132$ minutes, or 2 hours 12 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
