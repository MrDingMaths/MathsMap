    "type": "question",
    "label": "8",
    "prompt": "Holly gained a standardised score ($z$-score) of $-3$ for a fitness test.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Describe Holly’s results in terms of the mean and standard deviation of the test.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Holly’s result was 3 standard deviations below the mean of the fitness test.",
          "worked": "A $z$-score of $-3$ means Holly’s result was 3 standard deviations below the mean of the fitness test.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The fitness test has a mean of 75 and a standard deviation of 7.\nWhat is the actual mark scored by Holly?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "54 marks",
          "worked": "$$\\begin{aligned}x&=\\mu+z\\sigma\\\\x&=75+(-3)(7)\\\\x&=54\\end{aligned}$$\nHolly scored 54 marks.",
