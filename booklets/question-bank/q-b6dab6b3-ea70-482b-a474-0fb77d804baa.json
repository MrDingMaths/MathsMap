  "content": {
    "id": "p34-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find the equation of the line that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "passes through the point $(2,4)$ and has gradient $1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x+2$",
          "worked": "Using $y-y_1=m(x-x_1)$:\n$$\\begin{align*}y-4&=1(x-2)\\\\y-4&=x-2\\\\y&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "passes through the point $(-2,0)$ and has gradient $4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4x+8$",
          "worked": "Using $y-y_1=m(x-x_1)$:\n$$\\begin{align*}y-0&=4(x-(-2))\\\\y&=4(x+2)\\\\y&=4x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "passes through the point $(3,-1)$ and has gradient $\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{2}x-\\frac{5}{2}$",
          "worked": "Using $y-y_1=m(x-x_1)$:\n$$\\begin{align*}y-(-1)&=\\frac{1}{2}(x-3)\\\\y+1&=\\frac{1}{2}x-\\frac{3}{2}\\\\y&=\\frac{1}{2}x-\\frac{5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p34-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "passes through the point $(-2,-5)$ and has gradient $-\\frac{2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{2}{5}x-\\frac{29}{5}$",
          "worked": "Using $y-y_1=m(x-x_1)$:\n$$\\begin{align*}y-(-5)&=-\\frac{2}{5}(x-(-2))\\\\y+5&=-\\frac{2}{5}x-\\frac{4}{5}\\\\y&=-\\frac{2}{5}x-\\frac{29}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
