    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The lines with equations $y=3x-k$ and $y=mx-2$ intersect at $(2,3)$. Find $m$ and $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=\\frac52,\\ k=3$.",
      "worked": "Substitute $(2,3)$ into both equations:\n$$\\begin{align*}3&=3(2)-k\\\\k&=3\\\\3&=2m-2\\\\2m&=5\\\\m&=\\frac52\\end{align*}$$\nCheck: $3(2)-3=3$ and $\\frac52(2)-2=3$.",
      "solutionDiagrams": []
    },
