        "label": "a",
        "prompt": "All squares are similar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Corresponding angles are all $90^{\\circ}$, and corresponding sides are in the same ratio.",
          "worked": "All corresponding angles are equal at $90^{\\circ}$. Each square has four equal sides, so if one corresponding side is multiplied by a factor $k$, every corresponding side is multiplied by the same factor $k$. Hence corresponding sides are in the same ratio, so the squares are similar.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "All equilateral triangles are similar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Corresponding angles are all $60^{\\circ}$, and corresponding sides are in the same ratio.",
          "worked": "All corresponding angles are equal at $60^{\\circ}$. Each equilateral triangle has three equal sides, so if one corresponding side is multiplied by a factor $k$, every corresponding side is multiplied by the same factor $k$. Hence corresponding sides are in the same ratio, so the triangles are similar.",
          "solutionDiagrams": []
        },
