    "children": [
      {
        "id": "p44-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{22}2+\\log_{22}11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_{22}2+\\log_{22}11&=\\log_{22}(2\\times11)\\\\\\log_{22}2+\\log_{22}11&=\\log_{22}22\\\\\\log_{22}2+\\log_{22}11&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}25+\\log_{10}4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{10}25+\\log_{10}4&=\\log_{10}(25\\times4)\\\\\\log_{10}25+\\log_{10}4&=\\log_{10}10^2\\\\\\log_{10}25+\\log_{10}4&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_7 98-\\log_7 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_7 98-\\log_7 2&=\\log_7\\left(\\frac{98}{2}\\right)\\\\\\log_7 98-\\log_7 2&=\\log_7 7^2\\\\\\log_7 98-\\log_7 2&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_5 6-\\log_5 150$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_5 6-\\log_5 150&=\\log_5\\left(\\frac{6}{150}\\right)\\\\\\log_5 6-\\log_5 150&=\\log_5 5^{-2}\\\\\\log_5 6-\\log_5 150&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_3 54+\\log_3\\frac{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_3 54+\\log_3\\frac{1}{6}&=\\log_3\\left(54\\times\\frac{1}{6}\\right)\\\\\\log_3 54+\\log_3\\frac{1}{6}&=\\log_3 3^2\\\\\\log_3 54+\\log_3\\frac{1}{6}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p44-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{12}\\frac{2}{7}+\\log_{12}\\frac{7}{2}$",
