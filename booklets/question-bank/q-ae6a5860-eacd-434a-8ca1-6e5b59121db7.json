    "id": "v2-3cf9e-p17-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "Find the number of sides in an irregular polygon with one exterior angle of $96^{\\circ}$ and all others $12^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "23 sides.",
      "worked": "Let $n$ be the number of sides. The exterior angles sum to $360^{\\circ}$.\n$$\\begin{align*}96+12(n-1)&=360\\\\12(n-1)&=264\\\\n-1&=22\\\\n&=23\\end{align*}$$\nThe polygon has 23 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
