              {
                "type": "math",
                "latex": "\\frac{315}{176}",
                "display": false
              },
              {
                "type": "text",
                "text": " hours.",
                "marks": []
              }
            ]
          },
          {
            "id": "p19-q14-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
