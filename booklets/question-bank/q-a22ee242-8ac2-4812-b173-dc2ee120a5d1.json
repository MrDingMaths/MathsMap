      {
        "id": "p30-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-x^{-1})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-2+\\dfrac{1}{x^2}$",
          "worked": "$$\\begin{align*}(x-x^{-1})^2&=x^2-2xx^{-1}+x^{-2}\\\\(x-x^{-1})^2&=x^2-2+\\frac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p30-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x^2+x^{\\frac12})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+2x^{\\frac52}+x$",
          "worked": "$$\\begin{align*}(x^2+x^{\\frac12})^2&=x^4+2x^2x^{\\frac12}+x\\\\(x^2+x^{\\frac12})^2&=x^4+2x^{\\frac52}+x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p30-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^n-3x^{-n})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{2n}-6+\\dfrac{9}{x^{2n}}$",
          "worked": "$$\\begin{align*}(x^n-3x^{-n})^2&=x^{2n}-6x^nx^{-n}+9x^{-2n}\\\\(x^n-3x^{-n})^2&=x^{2n}-6+\\frac{9}{x^{2n}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
