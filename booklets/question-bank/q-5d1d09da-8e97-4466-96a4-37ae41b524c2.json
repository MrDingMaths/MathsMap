        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}x&=2y+1\\\\y&=x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=1$.",
          "worked": "$$\\begin{align*}y&=(2y+1)-2\\\\y&=2y-1\\\\y&=1\\\\x&=2(1)+1\\\\x&=3\\end{align*}$$\nCheck: $3=2(1)+1$ and $1=3-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}x&=3y-1\\\\2x+y&=12\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5,\\ y=2$.",
          "worked": "$$\\begin{align*}2(3y-1)+y&=12\\\\6y-2+y&=12\\\\7y-2&=12\\\\7y&=14\\\\y&=2\\\\x&=3(2)-1\\\\x&=5\\end{align*}$$\nCheck: $5=3(2)-1$ and $2(5)+2=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}x&=y-1\\\\x&=3y+7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5,\\ y=-4$.",
          "worked": "$$\\begin{align*}y-1&=3y+7\\\\-2y&=8\\\\y&=-4\\\\x&=-4-1\\\\x&=-5\\end{align*}$$\nCheck: $-5=-4-1$ and $-5=3(-4)+7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=3x-5\\\\x&=2y+6\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac45,\\ y=-\\dfrac{13}{5}$.",
          "worked": "$$\\begin{align*}x&=2(3x-5)+6\\\\x&=6x-10+6\\\\x&=6x-4\\\\5x&=4\\\\x&=\\frac45\\\\y&=3\\left(\\frac45\\right)-5\\\\y&=-\\frac{13}{5}\\end{align*}$$\nCheck: $-\\frac{13}{5}=3(\\frac45)-5$ and $\\frac45=2(-\\frac{13}{5})+6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p7-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}a&=b+3\\\\2a+b&=18\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=7,\\ b=4$.",
          "worked": "$$\\begin{align*}2(b+3)+b&=18\\\\2b+6+b&=18\\\\3b+6&=18\\\\3b&=12\\\\b&=4\\\\a&=4+3\\\\a&=7\\end{align*}$$\nCheck: $7=4+3$ and $2(7)+4=18$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p7-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}a+3b&=6\\\\a&=2b+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3,\\ b=1$.",
          "worked": "$$\\begin{align*}(2b+1)+3b&=6\\\\5b+1&=6\\\\5b&=5\\\\b&=1\\\\a&=2(1)+1\\\\a&=3\\end{align*}$$\nCheck: $3+3(1)=6$ and $3=2(1)+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p7-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}a&=7-2b\\\\a&=b+4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5,\\ b=1$.",
          "worked": "$$\\begin{align*}7-2b&=b+4\\\\3&=3b\\\\b&=1\\\\a&=7-2(1)\\\\a&=5\\end{align*}$$\nCheck: $5=7-2(1)$ and $5=1+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}3a-2b&=2\\\\a&=b-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4,\\ b=5$.",
          "worked": "$$\\begin{align*}3(b-1)-2b&=2\\\\3b-3-2b&=2\\\\b-3&=2\\\\b&=5\\\\a&=5-1\\\\a&=4\\end{align*}$$\nCheck: $3(4)-2(5)=2$ and $4=5-1$.",
