  "content": {
    "id": "v2-86081e-p7-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Sketch $y=2(x+1)(x-3)$:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-86081e-p7-practice-slot-1-lower-s1l-q-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up.",
          "worked": "$a=2>0$, so the parabola is concave up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "v2-86081e-p7-practice-slot-1-lower-s1l-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-6)$.",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=2(0+1)(0-3)\\\\y&=-6\\end{align*}$$\nThe $y$-intercept is $(0,-6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-86081e-p7-practice-slot-1-lower-s1l-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-1,0)$ and $(3,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=2(x+1)(x-3)\\\\x+1&=0\\quad\\text{or}\\quad x-3=0\\\\x&=-1\\quad\\text{or}\\quad x=3\\end{align*}$$\nThe $x$-intercepts are $(-1,0)$ and $(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-86081e-p7-practice-slot-1-lower-s1l-q-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-8)$.",
          "worked": "Use the mean of the $x$-intercepts.\n$$\\begin{align*}x&=\\frac{-1+3}{2}\\\\x&=1\\end{align*}$$\nSubstitute $x=1$.\n$$\\begin{align*}y&=2(1+1)(1-3)\\\\y&=-8\\end{align*}$$\nThe vertex is $(1,-8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ],
