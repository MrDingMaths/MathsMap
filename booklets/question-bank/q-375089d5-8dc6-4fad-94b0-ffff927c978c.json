  "content": {
    "id": "p21-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Olivia and Vihaan initially stand back to back and then walk directly away from one another. Olivia walks at a speed of $3\\text{ m/s}$ and Vihaan walks at a speed of $2\\text{ m/s}$. At the time when they are $100\\text{ m}$ apart, how far has Olivia walked?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q6-short-result",
            "type": "paragraph",
            "fontSize": null,
