    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p72-q1-variation-a",
        "type": "part",
        "label": "a",
        "prompt": "$B=2^1\\times3^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "HCF $18$, LCM $72$.",
          "worked": "$$\\begin{align*}\\text{HCF}&=2^1\\times3^2\\\\&=18\\\\\\text{LCM}&=2^3\\times3^2\\\\&=72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p72-q1-variation-b",
        "type": "part",
        "label": "b",
        "prompt": "$B=2^2\\times3^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "HCF $36$, LCM $72$. The HCF changes; the LCM stays the same.",
          "worked": "$$\\begin{align*}\\text{HCF}&=2^2\\times3^2\\\\&=36\\\\\\text{LCM}&=2^3\\times3^2\\\\&=72\\end{align*}$$\nThe HCF changes (from $18$ to $36$); the LCM stays the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p72-q1-variation-c",
        "type": "part",
        "label": "c",
        "prompt": "$B=2^3\\times3^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "HCF $72$, LCM $72$. The HCF changes; the LCM stays the same.",
          "worked": "$$\\begin{align*}\\text{HCF}&=2^3\\times3^2\\\\&=72\\\\\\text{LCM}&=2^3\\times3^2\\\\&=72\\end{align*}$$\nThe HCF changes (from $36$ to $72$); the LCM stays the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p72-q1-variation-d",
        "type": "part",
        "label": "d",
        "prompt": "$B=2^4\\times3^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "HCF $72$, LCM $144$. The HCF stays the same; the LCM changes.",
          "worked": "$$\\begin{align*}\\text{HCF}&=2^3\\times3^2\\\\&=72\\\\\\text{LCM}&=2^4\\times3^2\\\\&=144\\end{align*}$$\nThe HCF stays the same; the LCM changes (from $72$ to $144$).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p72-q1-variation-e",
        "type": "part",
        "label": "e",
        "prompt": "Let $A=2^2\\times3\\times5$ and $B=2\\times3^2\\times7$. Find the HCF and LCM of $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "HCF $6$, LCM $1260$.",
          "worked": "$$\\begin{align*}\\text{HCF}&=2\\times3\\\\&=6\\\\\\text{LCM}&=2^2\\times3^2\\times5\\times7\\\\&=1260\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
