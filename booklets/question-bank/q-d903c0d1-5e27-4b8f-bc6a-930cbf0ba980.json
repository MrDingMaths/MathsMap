      {
        "id": "p24-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{-1}{\\sqrt{1-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^{-1}x+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{-1}{\\sqrt{1-x^2}}\\,dx&=\\cos^{-1}x+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{4-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^{-1}\\left(\\frac{x}{2}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{\\sqrt{4-x^2}}\\,dx&=\\int\\frac{\\frac12}{\\sqrt{1-(x/2)^2}}\\,dx\\\\&=\\sin^{-1}\\left(\\frac{x}{2}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p24-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{1}{9+x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13\\tan^{-1}\\left(\\frac{x}{3}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{9+x^2}\\,dx&=\\frac13\\int\\frac{\\frac13}{1+(x/3)^2}\\,dx\\\\&=\\frac13\\tan^{-1}\\left(\\frac{x}{3}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p24-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{\\frac49-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin^{-1}\\left(\\frac{3x}{2}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{\\sqrt{\\frac49-x^2}}\\,dx&=\\int\\frac{\\frac32}{\\sqrt{1-(3x/2)^2}}\\,dx\\\\&=\\sin^{-1}\\left(\\frac{3x}{2}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\frac{1}{2+x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{\\sqrt2}\\tan^{-1}\\left(\\frac{x}{\\sqrt2}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{2+x^2}\\,dx&=\\frac1{\\sqrt2}\\int\\frac{\\frac1{\\sqrt2}}{1+(x/\\sqrt2)^2}\\,dx\\\\&=\\frac1{\\sqrt2}\\tan^{-1}\\left(\\frac{x}{\\sqrt2}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p24-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int\\frac{-1}{\\sqrt{5-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^{-1}\\left(\\frac{x}{\\sqrt5}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{-1}{\\sqrt{5-x^2}}\\,dx&=\\int\\frac{-\\frac1{\\sqrt5}}{\\sqrt{1-(x/\\sqrt5)^2}}\\,dx\\\\&=\\cos^{-1}\\left(\\frac{x}{\\sqrt5}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
