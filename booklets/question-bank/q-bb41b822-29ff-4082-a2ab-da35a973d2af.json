  "content": {
    "id": "v2-939c3-p18-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "The mass $m$ grams of a copper wire varies directly with its length $l$ cm. A 35 cm piece of wire has a mass of 24.5 g.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-939c3-p18-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the constant of variation and write an equation connecting $m$ and $l$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=0.7,\\quad m=0.7l$",
          "worked": "$$\\begin{align*}m&=kl\\\\24.5&=k\\times35\\\\k&=\\frac{24.5}{35}=0.7\\\\m&=0.7l\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-939c3-p18-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the length of wire, in metres, that has a mass of 1.4 kg.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 m",
          "worked": "$$\\begin{align*}1.4\\text{ kg}&=1400\\text{ g}\\\\m&=0.7l\\\\1400&=0.7l\\\\l&=\\frac{1400}{0.7}\\\\l&=2000\\text{ cm}\\\\l&=20\\text{ m}\\end{align*}$$\nThe wire is 20 m long.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
