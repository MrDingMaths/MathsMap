  "content": {
    "id": "p24-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If a fair coin is tossed three times, find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "three heads are obtained",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}\\Pr(HHH)&=\\frac12\\times\\frac12\\times\\frac12\\\\\\Pr(HHH)&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "three tails are obtained",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\begin{align*}\\Pr(TTT)&=\\frac12\\times\\frac12\\times\\frac12\\\\\\Pr(TTT)&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "exactly two heads are obtained.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{8}$",
          "worked": "The favourable outcomes are $HHT$, $HTH$ and $THH$. Each has probability $\\frac18$.\n\n$$\\begin{align*}\\Pr(\\text{exactly two heads})&=\\frac18+\\frac18+\\frac18\\\\\\Pr(\\text{exactly two heads})&=\\frac38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
