        "label": "b",
        "prompt": "Write an expression for the perimeter of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4w+20$",
          "worked": "$$\\begin{align*}P&=2(2w+3)+2(7)\\\\P&=4w+6+14\\\\P&=4w+20\\end{align*}$$",
          "solutionDiagrams": []
        },
