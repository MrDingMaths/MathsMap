  "content": {
    "id": "v2-4ef008-p5-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether the two lines intersect at the given value of $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4ef008-p5-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2x+1$ and $y=-x+7$ at $x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. Both give $y=5$, so the lines intersect at $(2,5)$.",
          "worked": "$$\\begin{align*}y&=2(2)+1\\\\&=5\\end{align*}$$\n$$\\begin{align*}y&=-(2)+7\\\\&=5\\end{align*}$$\nBoth equations give $y=5$ at $x=2$, so the lines intersect at $(2,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-4ef008-p5-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=0.5x-3$ and $y=-2x+2$ at $x=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The equations give $y=-4$ and $y=6$.",
          "worked": "$$\\begin{align*}y&=0.5(-2)-3\\\\&=-1-3\\\\&=-4\\end{align*}$$\n$$\\begin{align*}y&=-2(-2)+2\\\\&=4+2\\\\&=6\\end{align*}$$\nThe $y$-values are different at $x=-2$, so the lines do not intersect there.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-4ef008-p5-practice-slot-1-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-3x+1$ and $y=0.5x+8$ at $x=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. Both give $y=7$, so the lines intersect at $(-2,7)$.",
          "worked": "$$\\begin{align*}y&=-3(-2)+1\\\\&=6+1\\\\&=7\\end{align*}$$\n$$\\begin{align*}y&=0.5(-2)+8\\\\&=-1+8\\\\&=7\\end{align*}$$\nBoth equations give $y=7$ at $x=-2$, so the lines intersect at $(-2,7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
