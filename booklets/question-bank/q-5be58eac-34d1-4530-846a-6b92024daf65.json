  "content": {
    "id": "p2-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A department store is offering a $40\\%$ discount on all items in the store. Calculate the discounted price on the following items:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "a jacket with a marked price of $\\$399$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$239.40$",
          "worked": "$$\\begin{align*}\\text{Discount}&=0.40\\times\\$399\\\\\\text{Discount}&=\\$159.60\\\\\\text{Discounted price}&=\\$399-\\$159.60\\\\\\text{Discounted price}&=\\$239.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p2-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "a dress with a marked price of $\\$120$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$72$",
          "worked": "$$\\begin{align*}\\text{Discount}&=0.40\\times\\$120\\\\\\text{Discount}&=\\$48\\\\\\text{Discounted price}&=\\$120-\\$48\\\\\\text{Discounted price}&=\\$72\\end{align*}$$",
