  "content": {
    "id": "p38-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Mr Wong’s 10-year-old used car is worth $\\$4000$, and has been depreciating at 22.5% p.a. Calculate amounts of money in whole dollars. Give the percentage answer to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Use division by 0.775 to find how much it was worth a year ago.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5161$.",
          "worked": "$$\\begin{align*}\\text{Value one year ago}&=4000\\div0.775\\\\\\text{Value one year ago}&\\approx\\$5161\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find how much it was worth two years ago.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6660$.",
          "worked": "$$\\begin{align*}\\text{Value two years ago}&=4000\\div0.775^2\\\\\\text{Value two years ago}&\\approx\\$6660\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Find how much it was worth 10 years ago.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$51\\,173$.",
          "worked": "$$\\begin{align*}\\text{Original value}&=4000\\div0.775^{10}\\\\\\text{Original value}&\\approx\\$51\\,173\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the total percentage depreciation on the car over the 10-year period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$92.18\\%$.",
          "worked": "$$\\begin{align*}\\text{Percentage depreciation}&=(1-0.775^{10})\\times100\\%\\\\\\text{Percentage depreciation}&\\approx92.18\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "What was the average depreciation in dollars per year over the 10-year period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$4717$ per year.",
          "worked": "Use the unrounded original value.\n$$\\begin{align*}\\text{Average annual depreciation}&=\\frac{4000\\div0.775^{10}-4000}{10}\\\\\\text{Average annual depreciation}&\\approx\\$4717\\text{ per year}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
