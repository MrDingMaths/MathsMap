        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_5 75-\\log_5 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_5 75-\\log_5 3&=\\log_5\\left(\\frac{75}{3}\\right)\\\\&=\\log_5 25\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{15}3+\\log_{15}5$",
