        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{12}72+\\log_{12}2&=\\log_{12}(72\\times2)\\\\&=\\log_{12}144\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{10}50+\\log_{10}20$",
