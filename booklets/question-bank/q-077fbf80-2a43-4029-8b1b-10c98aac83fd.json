        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_3 8-\\log_3 6-\\log_3 12&=\\log_3\\left(\\frac{8}{6\\times12}\\right)\\\\&=\\log_3\\left(\\frac{1}{9}\\right)\\\\&=\\log_3(3^{-2})\\\\&=-2\\log_3 3\\\\&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\log_5 12-\\log_5 20-\\log_5 15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_5 12-\\log_5 20-\\log_5 15&=\\log_5\\left(\\frac{12}{20\\times15}\\right)\\\\&=\\log_5\\left(\\frac{1}{25}\\right)\\\\&=\\log_5(5^{-2})\\\\&=-2\\log_5 5\\\\&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\log_6\\left(\\frac{1}{3}\\right)-\\log_6 12$",
