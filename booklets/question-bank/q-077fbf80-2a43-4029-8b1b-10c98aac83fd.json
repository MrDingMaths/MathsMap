        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_{30}2+\\log_{30}3+\\log_{30}5&=\\log_{30}(2\\times3\\times5)\\\\&=\\log_{30}30\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_{12}9+\\log_{12}8+\\log_{12}2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{12}9+\\log_{12}8+\\log_{12}2&=\\log_{12}(9\\times8\\times2)\\\\&=\\log_{12}144\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\log_2 12+\\log_2 6-\\log_2 72$",
        "layout": "list",
        "columns": null,
