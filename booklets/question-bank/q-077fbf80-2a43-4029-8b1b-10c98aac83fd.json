        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\log_2 12+\\log_2 6-\\log_2 72&=\\log_2\\left(\\frac{12\\times6}{72}\\right)\\\\&=\\log_2 1\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-m",
