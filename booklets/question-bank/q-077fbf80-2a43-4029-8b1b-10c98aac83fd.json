        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_6 9+\\log_6 4&=\\log_6(9\\times4)\\\\&=\\log_6 36\\\\&=2\\end{align*}$$",
