        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_{15}3+\\log_{15}5&=\\log_{15}(3\\times5)\\\\&=\\log_{15}15\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{12}72+\\log_{12}2$",
