        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$$\\begin{align*}P(HH) &= \\frac12\\times\\frac12 \\\\ P(HH) &= \\frac14\\end{align*}$$",
