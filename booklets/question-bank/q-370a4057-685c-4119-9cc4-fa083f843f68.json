  "content": {
    "id": "p48-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A tank is initially full with 4000 L of water and water is being used at a rate of 20 L per minute.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write a rule for the volume, $V$ litres, of water after $t$ minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V = 4000 - 20t$",
          "worked": "The initial volume is 4000 L and it decreases by 20 L each minute.\n$$V = 4000 - 20t$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p48-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the volume after 1.5 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2200 L",
          "worked": "$1.5$ hours is $1.5 \\times 60 = 90$ minutes.\n$$\\begin{align*}V &= 4000 - 20(90)\\\\V &= 2200\\end{align*}$$\nThe volume is 2200 L.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "How long will it take for the tank to be emptied?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "200 min",
          "worked": "$$\\begin{align*}0 &= 4000 - 20t\\\\20t &= 4000\\\\t &= 200\\end{align*}$$\nThe tank empties after 200 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "How long will it take for the tank to have only 500 L?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "175 min",
          "worked": "$$\\begin{align*}500 &= 4000 - 20t\\\\20t &= 3500\\\\t &= 175\\end{align*}$$\nThe tank has 500 L after 175 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
