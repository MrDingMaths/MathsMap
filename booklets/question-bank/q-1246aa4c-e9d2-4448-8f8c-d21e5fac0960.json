      {
        "id": "p45-q28-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate the integral $\\displaystyle\\int_0^N e^{-x}\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-e^{-N}$",
          "worked": "$$\\begin{align*}\\int_0^N e^{-x}\\,dx&=[-e^{-x}]_0^N\\\\&=-e^{-N}+e^0\\\\&=1-e^{-N}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p45-q28-b",
        "type": "part",
        "label": "b",
        "prompt": "What is its limit as $N\\to\\infty$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "As $N\\to\\infty$, $e^{-N}\\to0$.\n$$\\lim_{N\\to\\infty}(1-e^{-N})=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
