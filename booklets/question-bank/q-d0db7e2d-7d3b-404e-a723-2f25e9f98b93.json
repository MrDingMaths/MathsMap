        "id": "p10-q8-reflection",
        "type": "part",
        "label": "g",
        "prompt": "What do you notice about your answers? Why does this happen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "When one number is a multiple of the other, the LCM is the larger number.",
          "worked": "Each answer is the larger number. The larger number is a multiple of both numbers, so it is a common multiple. No smaller positive number can be a multiple of the larger number, so it is the LCM.",
