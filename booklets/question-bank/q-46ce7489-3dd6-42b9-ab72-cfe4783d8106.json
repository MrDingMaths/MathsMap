  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A rectangle is 4 m longer than it is wide. Let the width be $w$ metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression in terms of $w$ for the length, $\\ell$, of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=w+4$",
          "worked": "The length is 4 m more than the width, so $\\ell=w+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression in terms of $w$ for the perimeter, $P$, of the rectangle. Find $P$ and $\\ell$ when $w=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=4w+8;\\quad P=28\\text{ m},\\ \\ell=9\\text{ m}$",
          "worked": "$P=2(w+4)+2w=4w+8$. When $w=5$, $P=4(5)+8=28\\text{ m}$ and $\\ell=5+4=9\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an expression for the area, $A$, of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=w(w+4)$",
          "worked": "Multiply length by width: $A=w(w+4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Find $A$ when $w=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21\\text{ m}^2$",
          "worked": "When $w=3$, $A=3(3+4)=3(7)=21\\text{ m}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Find $w$ when $P=32$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\text{ m}$",
          "worked": "$$\\begin{aligned}32&=4w+8\\\\24&=4w\\\\w&=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "Find $w$ when $A=45$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ m}$",
          "worked": "We need $w(w+4)=45$, with positive width. The positive factor pairs of 45 are $(1,45)$, $(3,15)$ and $(5,9)$. Only 5 and 9 differ by 4, so $w=5\\text{ m}$. Check: $5(5+4)=45$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
