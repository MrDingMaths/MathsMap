        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12$ or $x=3$",
          "worked": "$$\\begin{align*}2x^2+x-6x-3&=0\\\\x(2x+1)-3(2x+1)&=0\\\\(2x+1)(x-3)&=0\\\\2x+1&=0\\quad\\text{or}\\quad x-3=0\\\\x&=-\\frac12\\quad\\text{or}\\quad x=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$6x^2+x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$ or $x=-\\frac23$",
          "worked": "$$\\begin{align*}6x^2+4x-3x-2&=0\\\\2x(3x+2)-(3x+2)&=0\\\\(3x+2)(2x-1)&=0\\\\3x+2&=0\\quad\\text{or}\\quad 2x-1=0\\\\x&=-\\frac23\\quad\\text{or}\\quad x=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
