      {
        "id": "v2-149e8-p20-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $(\\sin x+\\cos x)^2$ in terms of $\\sin 2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sin x+\\cos x)^2=1+\\sin 2x$",
          "worked": "$$\\begin{aligned}(\\sin x+\\cos x)^2&=\\sin^2x+2\\sin x\\cos x+\\cos^2x\\\\&=1+\\sin 2x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-149e8-p20-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The region bounded by the curve $y=\\sin x+\\cos x$, the coordinate axes and the vertical line $x=\\frac{\\pi}{2}$ is rotated about the $x$-axis. Find the volume of the solid generated.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pi\\left(\\frac{\\pi}{2}+1\\right)\\text{ units}^3$",
          "worked": "$$\\begin{aligned}V&=\\pi\\int_0^{\\pi/2}(\\sin x+\\cos x)^2\\,dx\\\\V&=\\pi\\int_0^{\\pi/2}(1+\\sin 2x)\\,dx\\\\V&=\\pi\\left[x-\\frac{\\cos 2x}{2}\\right]_0^{\\pi/2}\\\\V&=\\pi\\left[\\left(\\frac{\\pi}{2}+\\frac12\\right)-\\left(-\\frac12\\right)\\right]\\\\V&=\\pi\\left(\\frac{\\pi}{2}+1\\right)\\text{ units}^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
