  "content": {
    "id": "p26-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Suppose $\\triangle ABC$ is a right-angled triangle. Denote the side lengths by $a$, $b$ and $c$ where $c$ is the hypotenuse.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the value of the circumradius, in terms of $a$, $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{c}{2}$.",
          "worked": "Let $M$ be the midpoint of the hypotenuse. Reflect the right-angle vertex in $M$. The resulting quadrilateral is a rectangle: its diagonals bisect each other, and it has a right angle. Its diagonals are equal, so $M$ is equidistant from all three vertices of the original triangle. Hence $M$ is the circumcentre and\n$$R=\\frac{c}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the location of the circumcentre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The midpoint of the hypotenuse.",
          "worked": "As shown in part (a), the midpoint of the hypotenuse is equidistant from the three vertices. Therefore it is the circumcentre.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
