    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8-proof",
        "type": "part",
        "label": "a",
        "prompt": "Show, by expansion, that $(x+a)(x+b)=x^2+(a+b)x+ab$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+a)(x+b)=x^2+(a+b)x+ab$.",
          "worked": "$$\\begin{align*}(x+a)(x+b)&=x^2+bx+ax+ab\\\\&=x^2+(a+b)x+ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q8-values",
        "type": "group",
        "label": "",
        "prompt": "Use this fact to find possible values of $a$ and $b$ for these expansions.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q8-a",
            "type": "part",
            "label": "b",
            "prompt": "$(x+a)(x+b)=x^2+5x+6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=2$, $b=3$ (or vice versa).",
              "worked": "$$\\begin{align*}a+b&=5\\\\ab&=6\\end{align*}$$\nSince $2+3=5$ and $2\\times3=6$, $a=2$ and $b=3$, or vice versa.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p7-q8-b",
            "type": "part",
            "label": "c",
            "prompt": "$(x+a)(x+b)=x^2-5x+6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=-2$, $b=-3$ (or vice versa).",
              "worked": "$$\\begin{align*}a+b&=-5\\\\ab&=6\\end{align*}$$\nSince $-2+(-3)=-5$ and $(-2)(-3)=6$, $a=-2$ and $b=-3$, or vice versa.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p7-q8-c",
            "type": "part",
            "label": "d",
            "prompt": "$(x+a)(x+b)=x^2+x-6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=3$, $b=-2$ (or vice versa).",
              "worked": "$$\\begin{align*}a+b&=1\\\\ab&=-6\\end{align*}$$\nSince $3+(-2)=1$ and $3(-2)=-6$, $a=3$ and $b=-2$, or vice versa.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p7-q8-d",
            "type": "part",
            "label": "e",
            "prompt": "$(x+a)(x+b)=x^2-x-6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=-3$, $b=2$ (or vice versa).",
              "worked": "$$\\begin{align*}a+b&=-1\\\\ab&=-6\\end{align*}$$\nSince $-3+2=-1$ and $(-3)2=-6$, $a=-3$ and $b=2$, or vice versa.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
  },
