      {
        "id": "p35-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$(a+b)^2-c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+b+c)(a+b-c)$",
          "worked": "Use the difference of two squares with squared terms $a+b$ and $c$.\n$$\\begin{align*}(a+b)^2-c^2&=((a+b)+c)((a+b)-c)\\\\(a+b)^2-c^2&=(a+b+c)(a+b-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$(a-b)^2-c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-b+c)(a-b-c)$",
          "worked": "Use the difference of two squares with squared terms $a-b$ and $c$.\n$$\\begin{align*}(a-b)^2-c^2&=((a-b)+c)((a-b)-c)\\\\(a-b)^2-c^2&=(a-b+c)(a-b-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+y)^2-4z^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y+2z)(x+y-2z)$",
          "worked": "Write $4z^2=(2z)^2$, then use the difference of two squares.\n$$\\begin{align*}(x+y)^2-4z^2&=(x+y)^2-(2z)^2\\\\(x+y)^2-4z^2&=((x+y)+2z)((x+y)-2z)\\\\(x+y)^2-4z^2&=(x+y+2z)(x+y-2z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
