  "content": {
    "id": "p18-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "For each of parts c to f in Question 2, reproduced below, solve the given equation for $y$ and hence write the equation of the line using function notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Question 2(c): $x+y-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-x$; $f(x)=1-x$.",
          "worked": "$$\\begin{align*}x+y-1&=0\\\\y&=1-x\\end{align*}$$\nHence $f(x)=1-x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Question 2(d): $x-2y-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac12x-2$; $f(x)=\\frac12x-2$.",
          "worked": "$$\\begin{align*}x-2y-4&=0\\\\2y&=x-4\\\\y&=\\frac12x-2\\end{align*}$$\nHence $f(x)=\\frac12x-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p18-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Question 2(e): $2x-3y-12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac23x-4$; $f(x)=\\frac23x-4$.",
          "worked": "$$\\begin{align*}2x-3y-12&=0\\\\3y&=2x-12\\\\y&=\\frac23x-4\\end{align*}$$\nHence $f(x)=\\frac23x-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p18-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Question 2(f): $x+4y+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac14x-\\frac32$; $f(x)=-\\frac14x-\\frac32$.",
          "worked": "$$\\begin{align*}x+4y+6&=0\\\\4y&=-x-6\\\\y&=-\\frac14x-\\frac32\\end{align*}$$\nHence $f(x)=-\\frac14x-\\frac32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
