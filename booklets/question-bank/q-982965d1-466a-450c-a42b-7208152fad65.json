  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Land rates in Crookwell Shire have risen by $6\\%$ every year for the last seven years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "By what percentage have the land rates risen over the seven-year period? Give your answer correct to one decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50.4\\%$",
          "worked": "Each annual increase has multiplier $1.06$.\n$$\\begin{align*}\\text{Overall percentage increase}&=(1.06^7-1)\\times100\\%\\\\\\text{Overall percentage increase}&=50.363025899\\ldots\\%\\\\\\text{Overall percentage increase}&\\approx50.4\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the rates now payable by a landowner whose rates seven years ago were the following. Give each answer correct to the nearest cent.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\$1000$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1503.63$",
              "worked": "$$\\begin{align*}\\text{Rates now}&=1000\\times1.06^7\\\\\\text{Rates now}&=1503.630258991\\ldots\\\\\\text{Rates now}&\\approx\\$1503.63\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\$17\\,268.24$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$25\\,965.05$",
              "worked": "$$\\begin{align*}\\text{Rates now}&=17\\,268.24\\times1.06^7\\\\\\text{Rates now}&=25\\,965.048183524\\ldots\\\\\\text{Rates now}&\\approx\\$25\\,965.05\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q4-b-iii",
            "type": "part",
            "label": "iii",
