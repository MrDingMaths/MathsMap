  "content": {
    "id": "p16-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Show that $y=\\sqrt{x}$ is increasing for its entire domain.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y'=\\dfrac{1}{2\\sqrt{x}}>0$ for $x>0$. Also, $y(0)=0<\\sqrt{x}$ for every $x>0$, so the function is increasing on $[0,\\infty)$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p16-q11-worked-domain",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The domain is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\geq0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p16-q11-worked-derivative",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y'&=\\frac12x^{-1/2}\\\\&=\\frac{1}{2\\sqrt{x}}>0\\qquad(x>0)\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p16-q11-worked-interior",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Hence the function is increasing for ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x>0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p16-q11-worked-endpoint",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 1,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "At the endpoint, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y(0)=0<\\sqrt{x}",
                "display": false
              },
              {
                "type": "text",
                "text": " for every ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x>0",
                "display": false
              },
              {
                "type": "text",
                "text": ". Therefore the function is increasing on its entire domain ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "[0,\\infty)",
                "display": false
              },
              {
                "type": "text",
                "text": ", although its derivative is undefined at ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
