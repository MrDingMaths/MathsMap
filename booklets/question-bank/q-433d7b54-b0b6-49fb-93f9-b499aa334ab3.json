  "content": {
    "id": "p31-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The half-life of a substance is the time it takes for the substance to reduce to half its original mass. Find the half-life of a radioactive material if its mass reduces by 1% per year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\log_{0.99}(0.5)$ years $\\approx69.0$ years\n\nSet $(0.99)^t=0.5$, then use logarithms to find the half-life.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p31-q9-worked-definition",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "M",
                "display": false
              },
              {
                "type": "text",
                "text": " be the original mass and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "t",
                "display": false
              },
              {
                "type": "text",
                "text": " the time in years.",
                "marks": []
              }
            ]
          },
          {
            "id": "p31-q9-worked-multiplier",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "A 1% annual reduction leaves ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "1-0.01=0.99",
                "display": false
              },
              {
                "type": "text",
                "text": " of the mass each year.",
                "marks": []
              }
            ]
          },
          {
            "id": "p31-q9-worked-equations",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac{M}{2}&=M\\times(0.99)^t\\\\0.5&=(0.99)^t\\\\t&=\\log_{0.99}(0.5)\\\\t&\\approx69.0\\text{ years}\\end{align*}",
                "display": true
              }
            ]
          }
        ]
      },
