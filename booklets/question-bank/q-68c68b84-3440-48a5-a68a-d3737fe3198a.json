        "type": "part",
        "label": "a",
        "prompt": "If $y=3+4x^3-x^4$, show that $y'=4x^2(3-x)$ and $y''=12x(2-x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p47-q10-a-short-formula-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y'=12x^2-4x^3=4x^2(3-x)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p47-q10-a-short-formula-1",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y''=24x-12x^2=12x(2-x)",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y'&=12x^2-4x^3\\\\y'&=4x^2(3-x)\\\\y''&=24x-12x^2\\\\y''&=12x(2-x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
