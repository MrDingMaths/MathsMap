        "type": "group",
        "label": "b",
        "prompt": "If a courier is chosen at random from the 15, find these probabilities:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q22-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(L)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{3}{5}$",
              "worked": "$$\\begin{align*}P(L)&=\\frac{9}{15}\\\\&=\\frac{3}{5}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p18-q22-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(L\\text{ only})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "$$\\begin{align*}P(L\\text{ only})&=\\frac{5}{15}\\\\&=\\frac{1}{3}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p18-q22-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(L\\text{ or }S)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{13}{15}$",
              "worked": "“Or” includes companies offering both services.\n$$\\begin{align*}n(L\\cup S)&=9+7-3\\\\&=13\\\\P(L\\text{ or }S)&=\\frac{13}{15}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p18-q22-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(L\\text{ and }S\\text{ only})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{15}$",
              "worked": "Exclude companies offering all three services.\n$$\\begin{align*}n(L\\cap S\\cap I')&=3-2\\\\&=1\\\\P(L\\text{ and }S\\text{ only})&=\\frac{1}{15}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
