        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int3\\sin(2x)^\\circ\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{270}{\\pi}\\cos(2x)^\\circ+C$",
          "worked": "$$\\begin{aligned}\\int3\\sin(2x)^\\circ\\,dx&=3\\int\\sin\\left(\\frac{\\pi x}{90}\\right)\\,dx\\\\&=-3\\cdot\\frac{90}{\\pi}\\cos\\left(\\frac{\\pi x}{90}\\right)+C\\\\&=-\\frac{270}{\\pi}\\cos(2x)^\\circ+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-p43-mixed-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^{15}\\sec^2(3x)^\\circ\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{60}{\\pi}$",
          "worked": "$$\\begin{aligned}\\int_0^{15}\\sec^2(3x)^\\circ\\,dx&=\\int_0^{15}\\sec^2\\left(\\frac{\\pi x}{60}\\right)\\,dx\\\\&=\\left[\\frac{60}{\\pi}\\tan\\left(\\frac{\\pi x}{60}\\right)\\right]_0^{15}\\\\&=\\frac{60}{\\pi}\\left(\\tan\\frac{\\pi}{4}-\\tan0\\right)\\\\&=\\frac{60}{\\pi}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
