  "content": {
    "id": "p17-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Let $a>0$. Find the area of the region bounded by the graph of $ax+\\frac{y}{a}=1$ and the $x$- and $y$-axes.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac12$ square units.\n\nThe axial intercepts give a base of $\\frac1a$ and a height of $a$.",
      "worked": "For the $x$-intercept, set $y=0$:\n$$\\begin{align*}ax&=1\\\\x&=\\frac1a.\\end{align*}$$\nFor the $y$-intercept, set $x=0$:\n$$\\begin{align*}\\frac{y}{a}&=1\\\\y&=a.\\end{align*}$$\nSince $a>0$, the bounded region is a right-angled triangle with base $\\frac1a$ and height $a$.\n$$\\begin{align*}A&=\\frac12\\times\\frac1a\\times a\\\\A&=\\frac12\\text{ square units}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 90
  },
