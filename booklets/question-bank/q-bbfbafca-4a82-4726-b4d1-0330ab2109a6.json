          "worked": "HCF: $2y$.\n$$\\begin{align*}6y - 10y^{2} &= 2y(3 - 5y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-i",
        "type": "part",
