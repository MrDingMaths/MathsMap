  "content": {
    "id": "p12-q3",
    "type": "question",
    "label": "3",
    "prompt": "Factorise the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{2} + 2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x + 2)$",
          "worked": "HCF: $x$.\n$$\\begin{align*}x^{2} + 2x &= x(x + 2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{2} - 4a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a(a - 4)$",
          "worked": "HCF: $a$.\n$$\\begin{align*}a^{2} - 4a &= a(a - 4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y^{2} - 7y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y(y - 7)$",
          "worked": "HCF: $y$.\n$$\\begin{align*}y^{2} - 7y &= y(y - 7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x - x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(1 - x)$",
          "worked": "HCF: $x$. Dividing $x$ by $x$ gives $1$.\n$$\\begin{align*}x - x^{2} &= x(1 - x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$3p^{2} + 3p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3p(p + 1)$",
          "worked": "HCF: $3p$. Dividing $3p$ by $3p$ gives $1$.\n$$\\begin{align*}3p^{2} + 3p &= 3p(p + 1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$8x - 8x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x(1 - x)$",
          "worked": "HCF: $8x$. Dividing $8x$ by $8x$ gives $1$.\n$$\\begin{align*}8x - 8x^{2} &= 8x(1 - x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$4b^{2} + 12b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b(b + 3)$",
          "worked": "HCF: $4b$.\n$$\\begin{align*}4b^{2} + 12b &= 4b(b + 3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q3-h",
