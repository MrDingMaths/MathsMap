                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}&\\phantom{=}1(3)+2(4)+3(5)+\\cdots+k(k+2)+(k+1)((k+1)+2)\\\\&=\\frac16(k+1)((k+1)+1)(2(k+1)+7)\\\\&=\\frac16(k+1)(k+2)(2k+9).\\end{aligned}",
