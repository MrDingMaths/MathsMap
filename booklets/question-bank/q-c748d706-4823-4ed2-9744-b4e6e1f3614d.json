                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}LHS&=1(3)+2(4)+3(5)+\\cdots+k(k+2)+(k+1)((k+1)+2)\\\\&=\\frac16k(k+1)(2k+7)+(k+1)((k+1)+2)\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
