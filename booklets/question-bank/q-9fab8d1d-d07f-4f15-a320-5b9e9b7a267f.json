  "content": {
    "id": "p19-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The mass of a particular adult is approximately $60$ kg, of which approximately $55\\%$ is water. The mass of one molecule of water is approximately $3\\times10^{-23}$ grams.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How many grams of water are there in this adult?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $33\\,000$ g.",
          "worked": "$$\\begin{align*}m&=0.55\\times60\\times1000\\\\m&=33\\,000\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How many water molecules are there in this adult?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $1.1\\times10^{27}$ molecules.",
          "worked": "$$\\begin{align*}N&=\\frac{3.3\\times10^4}{3\\times10^{-23}}\\\\N&=1.1\\times10^{4-(-23)}\\\\N&=1.1\\times10^{27}\\end{align*}$$\nApproximately $1.1\\times10^{27}$ molecules.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Another adult weighs approximately $80$ kilograms, of which approximately $60\\%$ is water. How many water molecules are there in this adult?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $1.6\\times10^{27}$ molecules.",
          "worked": "$$\\begin{align*}m&=0.60\\times80\\times1000\\\\m&=48\\,000\\text{ g}\\\\N&=\\frac{4.8\\times10^4}{3\\times10^{-23}}\\\\N&=1.6\\times10^{27}\\end{align*}$$\nApproximately $1.6\\times10^{27}$ molecules.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
