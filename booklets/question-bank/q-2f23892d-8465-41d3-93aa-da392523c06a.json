        "label": "a",
        "prompt": "$y=(1-e^x)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-5e^x(1-e^x)^4$",
          "worked": "$$\\begin{aligned}y'&=5(1-e^x)^4(-e^x)\\\\y'&=-5e^x(1-e^x)^4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(e^{4x}-9)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=16e^{4x}(e^{4x}-9)^3$",
          "worked": "$$\\begin{aligned}y'&=4(e^{4x}-9)^3(4e^{4x})\\\\y'&=16e^{4x}(e^{4x}-9)^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{1}{e^x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{e^x}{(e^x-1)^2}$",
          "worked": "$$\\begin{aligned}y&=(e^x-1)^{-1}\\\\y'&=-(e^x-1)^{-2}e^x\\\\y'&=-\\frac{e^x}{(e^x-1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{1}{(e^{3x}+4)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{6e^{3x}}{(e^{3x}+4)^3}$",
          "worked": "$$\\begin{aligned}y&=(e^{3x}+4)^{-2}\\\\y'&=-2(e^{3x}+4)^{-3}(3e^{3x})\\\\y'&=-\\frac{6e^{3x}}{(e^{3x}+4)^3}\\end{aligned}$$",
