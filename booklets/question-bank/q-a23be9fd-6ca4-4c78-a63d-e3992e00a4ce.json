  "content": {
    "id": "v2-a57f0-p58-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "Find $\\dfrac{d}{dx}(\\cos^6x)$, and hence find $\\displaystyle\\int\\sin x\\cos^5x\\,dx$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$$\\dfrac{d}{dx}(\\cos^6x)=-6\\sin x\\cos^5x$$\n\n$$\\displaystyle\\int\\sin x\\cos^5x\\,dx=-\\dfrac16\\cos^6x+C$$",
      "worked": "$$\\begin{align*}\\frac{d}{dx}(\\cos^6x)&=-6\\sin x\\cos^5x\\\\\\sin x\\cos^5x&=-\\frac16\\times(-6\\sin x\\cos^5x)\\\\\\int\\sin x\\cos^5x\\,dx&=-\\frac16\\cos^6x+C\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
