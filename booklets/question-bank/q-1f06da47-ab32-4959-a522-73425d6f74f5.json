  "content": {
    "id": "p30-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "6, 8, 10 and 12 are four consecutive even whole numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q5-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q5-a-i",
            "type": "part",
            "label": "i",
            "prompt": "What is the product of the outer pair $(6\\times12)$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$72$",
              "worked": "$6\\times12=72$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p30-q5-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What is the product of the inner pair $(8\\times10)$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$80$",
              "worked": "$8\\times10=80$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p30-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If the smallest of the four consecutive even numbers is denoted by $n$, express each of the other numbers in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n+2,\\ n+4,\\ n+6$",
          "worked": "Consecutive even numbers differ by 2, so the other numbers are $n+2$, $n+4$ and $n+6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p31-q5-c",
        "type": "group",
        "label": "c",
        "prompt": "Express the following in terms of $n$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p31-q5-c-i",
            "type": "part",
            "label": "i",
            "prompt": "the product of the outer pair",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$n^2+6n$",
              "worked": "$$\\begin{align*}n(n+6)&=n^2+6n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p31-q5-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the product of the inner pair",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$n^2+6n+8$",
              "worked": "$$\\begin{align*}(n+2)(n+4)&=n^2+4n+2n+8\\\\(n+2)(n+4)&=n^2+6n+8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p31-q5-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the difference between the answers to part ii and part i.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8$",
              "worked": "$$\\begin{align*}(n+2)(n+4)-n(n+6)&=(n^2+6n+8)-(n^2+6n)\\\\(n+2)(n+4)-n(n+6)&=8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p31-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "What happens if you take four consecutive odd whole numbers and complete parts a, b and c with these numbers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The inner product is again 8 greater than the outer product.\n\nConsecutive odd numbers also differ by 2, so the same expansion applies.",
          "worked": "For example, use $5,7,9,11$. The outer product is $5\\times11=55$ and the inner product is $7\\times9=63$, giving a difference of $8$.\n\nIf the smallest odd number is $n$, the others are $n+2$, $n+4$ and $n+6$.\n$$\\begin{align*}n(n+6)&=n^2+6n\\\\(n+2)(n+4)&=n^2+6n+8\\\\(n+2)(n+4)-n(n+6)&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
