    "type": "question",
    "label": "3",
    "prompt": "If the bearing of $A$ from $B$ is $\\theta$, then what is the bearing of $B$ from $A$, in terms of $\\theta$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
