            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{cases}\\theta+180^\\circ,&0^\\circ\\leq\\theta<180^\\circ,\\\\\\theta-180^\\circ,&180^\\circ\\leq\\theta<360^\\circ.\\end{cases}",
                "display": true
              }
            ]
          },
          {
            "id": "p5-q7-short-method",
            "type": "paragraph",
            "fontSize": null,
