  "content": {
    "id": "p35-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The line of best fit comparing salary, in thousands, at age 35 $(S)$ and number of years of study $(n)$ is given by $S=3.5n+9.8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q9-a",
        "type": "group",
        "label": "a",
        "prompt": "Predict the salary of someone who has completed:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q9-a-i",
            "type": "part",
            "label": "i",
            "prompt": "10 years of study\n(left school year 10)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$44\\,800$",
              "worked": "$$\\begin{align*}S&=3.5(10)+9.8\\\\S&=44.8\\end{align*}$$\nThe estimated salary is $\\$44\\,800$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p35-q9-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "12 years of study\n(no university)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$51\\,800$",
              "worked": "$$\\begin{align*}S&=3.5(12)+9.8\\\\S&=51.8\\end{align*}$$\nThe estimated salary is $\\$51\\,800$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          },
          {
            "id": "p35-q9-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "17 years of study\n(double degree)",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$69\\,300$",
              "worked": "$$\\begin{align*}S&=3.5(17)+9.8\\\\S&=69.3\\end{align*}$$\nThe estimated salary is $\\$69\\,300$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 15
          }
        ]
      },
      {
        "id": "p35-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "The value of Pearson’s correlation coefficient is $r=0.6$.\nHow accurate do you expect these predictions to be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Moderately accurate.",
          "worked": "The value $r=0.6$ indicates a moderate positive correlation, so the predictions are expected to be moderately accurate.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
