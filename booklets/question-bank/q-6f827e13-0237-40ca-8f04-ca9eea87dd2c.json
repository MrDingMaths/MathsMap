  "content": {
    "id": "p6-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "A barrel of wine is 40% empty. Then 40 litres of wine are removed. The barrel is now 40% full. How many litres does the full barrel contain?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$200$ litres.\n\nThe removed $40$ litres represents $20\\%$ of the barrel's capacity.",
      "worked": "Initially the barrel is $60\\%$ full, so the removed wine represents $60\\%-40\\%=20\\%$ of its capacity.\n\n$$\\begin{align*}20\\%\\text{ of capacity}&=40\\text{ litres}\\\\1\\%\\text{ of capacity}&=2\\text{ litres}\\\\100\\%\\text{ of capacity}&=200\\text{ litres}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
