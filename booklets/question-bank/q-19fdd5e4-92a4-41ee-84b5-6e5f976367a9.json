    "children": [
      {
        "id": "p62-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate her total income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$66 049",
          "worked": "$$\\begin{align*}\\text{Total income} &= 64\\,099 + 1950 \\\\\\text{Total income} &= \\$66\\,049\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p62-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate her taxable income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$64 499",
          "worked": "$$\\begin{align*}\\text{Taxable income} &= 66\\,049 - 1550 \\\\\\text{Taxable income} &= \\$64\\,499\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p62-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate her annual income tax payable. Round your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$11 429.18",
          "worked": "Use the \\$45 001–\\$120 000 bracket in the resident tax rates 2022–23 table.\n\n$$\\begin{align*}\\text{Excess} &= 64\\,499 - 45\\,000 \\\\\\text{Excess} &= 19\\,499 \\\\\\text{Tax payable} &= 5092 + 0.325 \\times 19\\,499 \\\\\\text{Tax payable} &= 11\\,429.175\\end{align*}$$\n\nAnnual income tax payable is \\$11 429.18, rounded to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p62-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Should she receive a tax refund or does she have a tax liability?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tax liability.",
          "worked": "$$\\begin{align*}\\text{Instalments} - \\text{tax payable} &= 3265 - 11\\,429.18 \\\\\\text{Instalments} - \\text{tax payable} &= -\\$8164.18\\end{align*}$$\n\nThe negative result shows that she has paid too little tax, so she has a tax liability.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
