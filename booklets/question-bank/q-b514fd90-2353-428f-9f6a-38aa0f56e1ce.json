  "content": {
    "id": "p55-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "An object is initially stationary and accelerates. The acceleration is constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "It is found that the velocity $v$ m/s varies directly with the time $t$ seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p55-q10-a-i",
            "type": "part",
            "label": "i",
            "prompt": "After 4 seconds the speed is 5 m/s. Find the constant of proportionality.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=\\frac54\\text{ m/s}^2$.",
              "worked": "$v=kt$. Substituting the given values,\n$$\\begin{align*}5&=4k\\\\k&=\\frac54\\text{ m/s}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p55-q10-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What is the speed of the object at $t=12$ s?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$15\\text{ m/s}$.",
              "worked": "$$\\begin{align*}v&=\\frac54\\times12\\\\v&=15\\text{ m/s}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p55-q10-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "When will the object be travelling at 12.5 m/s?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t=10\\text{ s}$.",
              "worked": "$$\\begin{align*}12.5&=\\frac54t\\\\t&=12.5\\times\\frac45\\\\t&=10\\text{ s}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p55-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "The distance $x$ metres that the object travels is proportional to the square of the time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p56-q10-c",
            "type": "group",
            "label": "",
            "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [
              {
                "id": "p56-q10-c-formula",
                "type": "part",
                "label": "",
                "prompt": "",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$x=kt^2$.",
                  "worked": "Since distance is proportional to the square of time, $x=kt^2$.",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 10,
                "responseSpace": "scaffold"
              },
              {
                "id": "p56-q10-c-i",
                "type": "part",
                "label": "i",
                "prompt": "After 4 seconds the distance is $x=10$ m. Show that the constant of proportionality is half that in part a.",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$k=\\frac58$, half the constant $\\frac54$ in part a.",
                  "worked": "$$\\begin{align*}10&=k\\times4^2\\\\k&=\\frac{10}{16}\\\\k&=\\frac58\\text{ m/s}^2.\\end{align*}$$\nThe constant in part a is $\\frac54$, and $\\frac12\\times\\frac54=\\frac58$.",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 38
              },
              {
                "id": "p56-q10-c-ii",
                "type": "part",
                "label": "ii",
                "prompt": "How far has the object travelled at $t=12$ s?",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$90\\text{ m}$.",
                  "worked": "$$\\begin{align*}x&=\\frac58\\times12^2\\\\x&=90\\text{ m}.\\end{align*}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 20
              },
              {
                "id": "p56-q10-c-iii",
                "type": "part",
                "label": "iii",
                "prompt": "How much time has elapsed when $x=160$ m?",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$16\\text{ s}$.",
                  "worked": "$$\\begin{align*}160&=\\frac58t^2\\\\t^2&=160\\times\\frac85\\\\t^2&=256\\\\t&=16\\text{ s}.\\end{align*}$$\nTake the positive square root because $t$ is elapsed time.",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 46
              },
              {
                "id": "p56-q10-c-iv",
                "type": "part",
                "label": "iv",
                "prompt": "What happens to $x$ when the value of $t$ is doubled? Check your answer by comparing $x$ when $t=8$ s with part i.",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$x$ is quadrupled. At $t=8$ s, $x=40$ m, four times the 10 m travelled at $t=4$ s.",
                  "worked": "Replacing $t$ by $2t$ gives $k(2t)^2=4kt^2$, so $x$ is quadrupled.\nAt $t=8$ s,\n$$\\begin{align*}x&=\\frac58\\times8^2\\\\x&=40\\text{ m}.\\end{align*}$$\nIn part i, $x=10$ m at $t=4$ s. Since $40=4\\times10$, doubling the time quadruples the distance.",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 32
              }
            ]
          }
        ]
      }
    ]
  },
