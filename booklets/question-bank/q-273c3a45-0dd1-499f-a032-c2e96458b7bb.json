  "content": {
    "id": "p10-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Show that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\sin30^\\circ\\cos30^\\circ=\\sin60^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\left(\\frac12\\right)\\left(\\frac{\\sqrt3}{2}\\right)=\\frac{\\sqrt3}{2}=\\sin60^\\circ$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=2\\left(\\frac12\\right)\\left(\\frac{\\sqrt3}{2}\\right)\\\\&=\\frac{2\\sqrt3}{4}\\\\&=\\frac{\\sqrt3}{2}=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos^2 60^\\circ-\\cos^2 30^\\circ=-\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12\\right)^2-\\left(\\frac{\\sqrt3}{2}\\right)^2=\\frac14-\\frac34=-\\frac12$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\left(\\frac12\\right)^2-\\left(\\frac{\\sqrt3}{2}\\right)^2\\\\&=\\frac14-\\frac34\\\\&=-\\frac24\\\\&=-\\frac12=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p10-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin60^\\circ\\cos45^\\circ-\\cos60^\\circ\\sin45^\\circ=\\frac{\\sqrt6-\\sqrt2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt3-1}{2\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}=\\frac{\\sqrt6-\\sqrt2}{4}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sqrt3}{2}\\times\\frac1{\\sqrt2}-\\frac12\\times\\frac1{\\sqrt2}\\\\&=\\frac{\\sqrt3-1}{2\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\&=\\frac{\\sqrt3\\sqrt2-\\sqrt2}{2\\sqrt2\\sqrt2}\\\\&=\\frac{\\sqrt6-\\sqrt2}{4}=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\tan45^\\circ}=2-\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt3-1}{1+\\sqrt3}\\times\\frac{1-\\sqrt3}{1-\\sqrt3}=\\frac{-4+2\\sqrt3}{-2}=2-\\sqrt3$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sqrt3-1}{1+\\sqrt3}\\\\&=\\frac{\\sqrt3-1}{1+\\sqrt3}\\times\\frac{1-\\sqrt3}{1-\\sqrt3}\\\\&=\\frac{(\\sqrt3-1)(1-\\sqrt3)}{(1+\\sqrt3)(1-\\sqrt3)}\\\\&=\\frac{\\sqrt3-3-1+\\sqrt3}{1-3}\\\\&=\\frac{-4+2\\sqrt3}{-2}\\\\&=2-\\sqrt3=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p10-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{\\frac1{\\cos30^\\circ}-\\tan30^\\circ}=\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{\\frac2{\\sqrt3}-\\frac1{\\sqrt3}}=\\frac{1}{\\frac1{\\sqrt3}}=\\sqrt3$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1}{\\left(\\frac2{\\sqrt3}-\\frac1{\\sqrt3}\\right)}\\\\&=\\frac{1}{\\left(\\frac1{\\sqrt3}\\right)}\\\\&=\\sqrt3=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1+\\tan30^\\circ}{1-\\tan30^\\circ}=2+\\sqrt3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt3+1}{\\sqrt3-1}\\times\\frac{\\sqrt3+1}{\\sqrt3+1}=\\frac{4+2\\sqrt3}{2}=2+\\sqrt3$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\left(1+\\frac1{\\sqrt3}\\right)}{\\left(1-\\frac1{\\sqrt3}\\right)}\\\\&=\\frac{\\left(\\frac{\\sqrt3+1}{\\sqrt3}\\right)}{\\left(\\frac{\\sqrt3-1}{\\sqrt3}\\right)}\\\\&=\\frac{\\sqrt3+1}{\\sqrt3-1}\\\\&=\\frac{(\\sqrt3+1)(\\sqrt3+1)}{(\\sqrt3-1)(\\sqrt3+1)}\\\\&=\\frac{3+2\\sqrt3+1}{3-1}\\\\&=\\frac{4+2\\sqrt3}{2}\\\\&=2+\\sqrt3=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
  },
