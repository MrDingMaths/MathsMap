  "content": {
    "id": "v2-515e2-p33-practice-slot-16-root",
    "type": "question",
    "label": null,
    "prompt": "A bag contains 4 red and 6 green jellybeans. Mia takes one jellybean at random and eats it, then takes a second jellybean at random. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-515e2-p33-practice-slot-16-slot-16-q-a",
        "type": "part",
        "label": "a",
        "prompt": "the second jellybean is red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "A tree diagram is useful here. Split first into the colour of the first jellybean, then the second.\n$$\\begin{align*}P(RR)&=\\frac{4}{10}\\times\\frac{3}{9}=\\frac{12}{90}\\\\P(GR)&=\\frac{6}{10}\\times\\frac{4}{9}=\\frac{24}{90}\\\\P(\\text{second red})&=\\frac{12}{90}+\\frac{24}{90}\\\\P(\\text{second red})&=\\frac{36}{90}=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-515e2-p33-practice-slot-16-slot-16-q-b",
        "type": "part",
        "label": "b",
        "prompt": "the first jellybean is red, given that the second jellybean is red.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "$$\\begin{align*}P(\\text{first red}\\mid\\text{second red})&=\\frac{P(RR)}{P(\\text{second red})}\\\\P(\\text{first red}\\mid\\text{second red})&=\\frac{12/90}{36/90}\\\\P(\\text{first red}\\mid\\text{second red})&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $\\frac{2}{5}$ b) $\\frac{1}{3}$",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
  },
