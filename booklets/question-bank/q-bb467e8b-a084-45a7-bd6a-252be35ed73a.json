    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "John buys three towels, Mary buys six towels and Naomi buys four towels.\nWrite a fully simplified expression for the total amount spent on towels.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13c$ dollars",
          "worked": "Total cost (dollars):\n$$\\begin{align*}3c+6c+4c&=(3+6+4)c\\\\&=13c\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "On another occasion, Chris buys $n$ towels.\nDavid buys twice as many as Chris and Edward buys three times as many as David.\nWrite a simplified expression for the total amount they spent on towels.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9nc$ dollars",
          "worked": "David buys $2n$ towels. Edward buys $3(2n)=6n$ towels.\n\nTotal cost (dollars):\n$$\\begin{align*}nc+2nc+6nc&=(1+2+6)nc\\\\&=9nc\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
