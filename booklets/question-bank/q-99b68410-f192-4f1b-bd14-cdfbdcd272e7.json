  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "An A4 sheet of paper is 210 mm by 297 mm. An A3 sheet of paper is 297 mm by 420 mm.\nWhat is the scale factor from A4 to A3, correct to two decimal places?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1.41$",
      "worked": "Match the shorter sides of the two sheets.\n$$\\begin{align*}\\text{Scale factor}&=\\frac{\\text{A3 length}}{\\text{A4 length}}\\\\&=\\frac{297}{210}\\\\&\\approx1.41\\end{align*}$$\nThe longer sides also give $\\frac{420}{297}\\approx1.41$ to two decimal places.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
