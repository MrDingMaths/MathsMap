  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify each of the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\binom{n}{0}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "There is one way to choose no objects: select nothing.\n$$\\binom{n}{0}=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom{n}{1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$",
          "worked": "There are $n$ ways to choose one object from $n$ objects.\n$$\\binom{n}{1}=n.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\binom{n}{n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$",
          "worked": "Choosing $n-1$ objects is equivalent to leaving out one object.\n$$\\begin{align*}\\binom{n}{n-1}&=\\binom{n}{1}\\\\\\binom{n}{n-1}&=n.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\binom{n+1}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n+1$",
          "worked": "Choosing $n$ objects from $n+1$ objects is equivalent to leaving out one object.\n$$\\begin{align*}\\binom{n+1}{n}&=\\binom{n+1}{1}\\\\\\binom{n+1}{n}&=n+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\binom{n}{n-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$",
          "worked": "Choosing $n-1$ objects is equivalent to leaving out one object.\n$$\\begin{align*}\\binom{n}{n-1}&=\\binom{n}{1}\\\\\\binom{n}{n-1}&=n.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\binom{n+2}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(n+1)(n+2)}{2}$",
          "worked": "$$\\begin{align*}\\binom{n+2}{n}&=\\frac{(n+2)!}{n!\\,2!}\\\\\\binom{n+2}{n}&=\\frac{(n+2)(n+1)n!}{n!\\,2}\\\\\\binom{n+2}{n}&=\\frac{(n+1)(n+2)}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
