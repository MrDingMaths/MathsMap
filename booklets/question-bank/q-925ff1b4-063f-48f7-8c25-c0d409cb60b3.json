  "content": {
    "id": "p20-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Let $Q(x)=2x^3-x^2-2x+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x=\\frac12$ is a root of $Q(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q\\left(\\frac12\\right)=0$.",
          "worked": "$$\\begin{align*}Q\\left(\\frac12\\right)&=2\\left(\\frac12\\right)^3-\\left(\\frac12\\right)^2-2\\left(\\frac12\\right)+1\\\\Q\\left(\\frac12\\right)&=\\frac14-\\frac14-1+1\\\\Q\\left(\\frac12\\right)&=0\\end{align*}$$\nTherefore, $x=\\frac12$ is a root of $Q(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p20-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $x=1$ is a root of $Q(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(1)=0$.",
          "worked": "$$\\begin{align*}Q(1)&=2(1)^3-(1)^2-2(1)+1\\\\Q(1)&=2-1-2+1\\\\Q(1)&=0\\end{align*}$$\nTherefore, $x=1$ is a root of $Q(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p20-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $x=2$ is not a root of $Q(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q(2)=9\\ne0$.",
          "worked": "$$\\begin{align*}Q(2)&=2(2)^3-(2)^2-2(2)+1\\\\Q(2)&=16-4-4+1\\\\Q(2)&=9\\ne0\\end{align*}$$\nTherefore, $x=2$ is not a root of $Q(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
