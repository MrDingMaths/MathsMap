  "content": {
    "id": "p3-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Given that $f(x)=2x^2-3x$, calculate the average rate of change between $x=1$ and $x=4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7$.",
      "worked": "$$\\begin{align*}f(1)&=2(1)^2-3(1)=-1,\\\\f(4)&=2(4)^2-3(4)=20,\\\\\\text{Average rate}&=\\frac{f(4)-f(1)}{4-1}\\\\\\text{Average rate}&=\\frac{20-(-1)}{3}=7.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
