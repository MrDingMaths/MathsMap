  "content": {
    "id": "p60-q8-root",
    "type": "question",
    "label": null,
    "prompt": "$ABC$ is a triangle. The point $M$ is the midpoint of $BC$. Write the vectors in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p60-q8-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 60 p60-q8-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont},line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0); \\coordinate (B) at (2.3,1.8); \\coordinate (C) at (4.1,0.35); \\coordinate (M) at ($(B)!0.5!(C)$);\n\\draw (A)--(B)--(C)--cycle;\n\\draw[->] ($(B)!0.43!(A)$)--($(B)!0.56!(A)$);\n\\draw[->] ($(A)!0.47!(C)$)--($(A)!0.60!(C)$);\n\\path (B)--(A) node[midway,above left] {$\\underset{\\sim}{a}$};\n\\path (A)--(C) node[midway,below] {$\\underset{\\sim}{b}$};\n\\fill (M) circle (1.5pt);\n\\node[below left] at (A) {$A$}; \\node[above] at (B) {$B$}; \\node[right] at (C) {$C$}; \\node[above right] at (M) {$M$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 62,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 60,
          "sourceRegion": "Question 8 triangle",
          "description": "Unshaded triangle with M marked exactly halfway along BC; no AM segment. Ordinary marks black.",
          "mathematics": "BA=a; AC=b; BM=MC.",
          "answerVisibility": "Givens only."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p60-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{BC}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{a}+\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{BC}&=\\overrightarrow{BA}+\\overrightarrow{AC}\\\\\\overrightarrow{BC}&=\\underset{\\sim}{a}+\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p60-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{BM}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12\\right)\\underset{\\sim}{a}+\\left(\\frac12\\right)\\underset{\\sim}{b}$",
          "worked": "Since $M$ is the midpoint of $BC$,\n$$\\begin{aligned}\\overrightarrow{BM}&=\\frac12\\overrightarrow{BC}\\\\\\overrightarrow{BM}&=\\frac12(\\underset{\\sim}{a}+\\underset{\\sim}{b})\\\\\\overrightarrow{BM}&=\\frac12\\underset{\\sim}{a}+\\frac12\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p60-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{AM}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\left(\\frac12\\right)\\underset{\\sim}{a}+\\left(\\frac12\\right)\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AM}&=\\overrightarrow{AB}+\\overrightarrow{BM}\\\\\\overrightarrow{AM}&=-\\underset{\\sim}{a}+\\frac12(\\underset{\\sim}{a}+\\underset{\\sim}{b})\\\\\\overrightarrow{AM}&=-\\frac12\\underset{\\sim}{a}+\\frac12\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
