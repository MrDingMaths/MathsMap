  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=3x^2-2$. Find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(3t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27t^2-2$",
          "worked": "$$\\begin{align*}f(3t)&=3(3t)^2-2\\\\f(3t)&=3(9t^2)-2\\\\f(3t)&=27t^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p3-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(-2t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12t^2-2$",
          "worked": "$$\\begin{align*}f(-2t)&=3(-2t)^2-2\\\\f(-2t)&=3(4t^2)-2\\\\f(-2t)&=12t^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p3-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(\\sqrt{t})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3t-2$",
          "worked": "$$\\begin{align*}f(\\sqrt{t})&=3(\\sqrt{t})^2-2\\\\f(\\sqrt{t})&=3t-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(t-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3t^2-6t+1$",
          "worked": "$$\\begin{align*}f(t-1)&=3(t-1)^2-2\\\\f(t-1)&=3(t^2-2t+1)-2\\\\f(t-1)&=3t^2-6t+3-2\\\\f(t-1)&=3t^2-6t+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
