  "content": {
    "id": "p22-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the values of $k$ for which the quadratic equation $x^2+6x+k=0$ has:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "real roots,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k\\le 9$",
          "worked": "$$\\begin{align*}\\Delta&=6^2-4(1)k\\\\\\Delta&=36-4k\\end{align*}$$\nReal roots require $\\Delta\\ge0$.\n$$\\begin{align*}36-4k&\\ge0\\\\-4k&\\ge-36\\\\k&\\le9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "equal roots,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=9$",
          "worked": "$$\\begin{align*}\\Delta&=6^2-4(1)k\\\\\\Delta&=36-4k\\end{align*}$$\nEqual roots require $\\Delta=0$.\n$$\\begin{align*}36-4k&=0\\\\k&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "unreal roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k>9$",
          "worked": "$$\\begin{align*}\\Delta&=6^2-4(1)k\\\\\\Delta&=36-4k\\end{align*}$$\nUnreal roots require $\\Delta<0$.\n$$\\begin{align*}36-4k&<0\\\\-4k&<-36\\\\k&>9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
