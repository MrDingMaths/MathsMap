  "content": {
    "id": "p67-g31-38-node",
    "type": "question",
    "label": null,
    "prompt": "Find the Cartesian equation, stating restrictions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p67-q31",
        "type": "part",
        "label": "a",
        "prompt": "$(2t^2,4t^4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2$, where $x\\ge0$.",
          "worked": "$x=2t^2\\ge0$. Then\n$$\\begin{align*}y&=4t^4\\\\y&=(2t^2)^2\\\\y&=x^2.\\end{align*}$$\nThus $y=x^2$, where $x\\ge0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p67-q32",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt{t},t+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2+1$, where $x\\ge0$.",
          "worked": "$x=\\sqrt{t}\\ge0$, so $t=x^2$. Then\n$$\\begin{align*}y&=t+1\\\\y&=x^2+1.\\end{align*}$$\nRetain $x\\ge0$ because the square root is nonnegative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p67-q33",
        "type": "part",
        "label": "c",
        "prompt": "$(2^t,4-2^t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4-x$, where $x>0$.",
          "worked": "$x=2^t>0$. Substitution gives\n$$\\begin{align*}y&=4-2^t\\\\y&=4-x.\\end{align*}$$\nThus $y=4-x$, where $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q34",
        "type": "part",
        "label": "d",
        "prompt": "$(t^2-1,2t^2+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+3$, where $x\\ge-1$.",
          "worked": "$t^2=x+1\\ge0$, so $x\\ge-1$. Then\n$$\\begin{align*}y&=2t^2+1\\\\y&=2(x+1)+1\\\\y&=2x+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q35",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt{t}+1,\\sqrt{t}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-2$, where $x\\ge1$.",
          "worked": "$\\sqrt{t}=x-1\\ge0$, so $x\\ge1$. Then\n$$\\begin{align*}y&=\\sqrt{t}-1\\\\y&=(x-1)-1\\\\y&=x-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q36",
        "type": "part",
        "label": "f",
        "prompt": "$(t^2-1,t^2+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x+2$, where $x\\ge-1$.",
          "worked": "$t^2=x+1\\ge0$, so $x\\ge-1$. Then\n$$\\begin{align*}y&=t^2+1\\\\y&=(x+1)+1\\\\y&=x+2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q37",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\frac{1}{t},\\frac{t-1}{t}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1-x$, where $x\\ne0$.",
          "worked": "The expressions require $t\\ne0$, and $x=\\frac{1}{t}\\ne0$. Then\n$$\\begin{align*}y&=\\frac{t-1}{t}\\\\y&=1-\\frac{1}{t}\\\\y&=1-x.\\end{align*}$$\nRetain $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p67-q38",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\frac{2-3^t}{2},\\frac{1+3^t}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{3-2x}{4}$, where $x<1$.",
          "worked": "$3^t=2-2x>0$, so $x<1$. Then\n$$\\begin{align*}y&=\\frac{1+3^t}{4}\\\\y&=\\frac{1+(2-2x)}{4}\\\\y&=\\frac{3-2x}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
