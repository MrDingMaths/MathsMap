    "children": [
      {
        "id": "p63-q16-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the value of $2-4+6-8+10-12$ by:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p63-q16-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Working from left to right",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-6$",
              "worked": "$$\\begin{align*}2-4+6-8+10-12&=-2+6-8+10-12\\\\&=4-8+10-12\\\\&=-4+10-12\\\\&=6-12\\\\&=-6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p63-q16-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Pairing the numbers: $(2-4)+(6-8)+(10-12)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-6$; three pairs each give $-2$.",
              "worked": "$$\\begin{align*}(2-4)+(6-8)+(10-12)&=-2-2-2\\\\&=-6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      },
      {
        "id": "p63-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $2-4+6-8+10-12+14-16+\\cdots+98-100$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-50$; $25$ pairs each give $-2$.",
          "worked": "Pair consecutive terms: $(2-4),(6-8),\\ldots,(98-100)$. There are $50\\div2=25$ pairs, each equal to $-2$.\n\n$$\\begin{align*}2-4+6-8+10-12+14-16+\\cdots+98-100&=25\\times(-2)\\\\&=-50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
