    "type": "question",
    "label": "3",
    "prompt": "A business spent $\\$560000$ installing alarms at its premises and then depreciated them at $20\\%$ p.a. Find the value after five years, and the percentage depreciation of their value. Give the percentage to $2$ decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$183500.80$; $67.23\\%$ depreciation.",
      "worked": "$$\\begin{align*}V_5&=560000\\times(0.80)^5\\\\V_5&=\\$183500.80\\\\\\text{Percentage remaining}&=(0.80)^5\\times100\\%\\\\\\text{Percentage remaining}&=32.768\\%\\\\\\text{Percentage depreciation}&=100\\%-32.768\\%\\\\\\text{Percentage depreciation}&\\approx67.23\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
