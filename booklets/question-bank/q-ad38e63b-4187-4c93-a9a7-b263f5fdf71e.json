          "worked": "$$\\begin{align*}x-3&>0\\\\x&>3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p41-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\log_2 x-3$",
        "layout": "list",
        "columns": null,
