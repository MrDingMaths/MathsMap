  "content": {
    "id": "p47-ep-14-node",
    "type": "question",
    "label": "6",
    "prompt": "Find the equation of the tangent and normal to $y=x^3-6x^2+12x-4$ when $x=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Tangent: $y=4$. Normal: $x=2$.\nSince $y'(2)=0$, the tangent is horizontal and the normal is vertical.",
      "worked": "$$\\begin{align*}y(2)&=2^3-6(2)^2+12(2)-4\\\\y(2)&=4\\\\y'&=3x^2-12x+12\\\\y'(2)&=0\\end{align*}$$\nThe tangent through $(2,4)$ is $y=4$. The normal is vertical, so its equation is $x=2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
