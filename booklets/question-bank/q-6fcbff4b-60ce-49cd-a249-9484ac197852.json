    "id": "p21-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "According to the Rational Root Theorem, which two integers are always in the list of possible roots of a polynomial with integer coefficients?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-1$ and $1$.",
      "worked": "The integers $1$ and $-1$ are factors of every integer constant term, and $1$ is a factor of every non-zero leading coefficient. Thus the candidate list always includes $\\frac{-1}{1}=-1$ and $\\frac{1}{1}=1$.",
      "solutionDiagrams": []
    },
