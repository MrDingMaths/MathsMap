  "content": {
    "id": "v2-c5fa9-p19-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "Mia scored 71 in a Geography test in which the mean was 62 and SD was 6.\n\nThe History test has a mean of 55 and SD of 8.\n\nWhat mark would she have to score in History for her performance to be equivalent?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "67",
      "worked": "$$\\begin{align*}z_G&=\\frac{x_G-\\mu_G}{\\sigma_G}\\\\z_G&=\\frac{71-62}{6}\\\\z_G&=1.5\\\\x_H&=\\mu_H+z_G\\sigma_H\\\\x_H&=55+1.5(8)\\\\x_H&=67\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
