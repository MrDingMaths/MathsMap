    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1$",
          "worked": "$$\\begin{align*}P(A\\cap B)&=P(A)P(B)\\\\P(A\\cap B)&=0.4\\times0.25\\\\P(A\\cap B)&=0.1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p38-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\cap\\overline{B})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "$A$ and $\\overline{B}$ are independent.\n$$\\begin{align*}P(A\\cap\\overline{B})&=P(A)(1-P(B))\\\\P(A\\cap\\overline{B})&=0.4(1-0.25)\\\\P(A\\cap\\overline{B})&=0.3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p38-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(\\overline{A}\\cap\\overline{B})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.45$",
          "worked": "$\\overline{A}$ and $\\overline{B}$ are independent.\n$$\\begin{align*}P(\\overline{A}\\cap\\overline{B})&=P(\\overline{A})P(\\overline{B})\\\\P(\\overline{A}\\cap\\overline{B})&=(1-0.4)(1-0.25)\\\\P(\\overline{A}\\cap\\overline{B})&=0.6\\times0.75\\\\P(\\overline{A}\\cap\\overline{B})&=0.45.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
