  "content": {
    "id": "v2-03df2-p64-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Each line has the given angle of inclination and passes through the two given points. Find the exact value of $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-03df2-p64-practice-slot-10-slot-10-a",
        "type": "part",
        "label": "a",
        "prompt": "Angle of inclination $45^\\circ$; points $(-1,3)$ and $(x,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6$",
          "worked": "$$\\begin{align*}m&=\\tan45^\\circ=1\\\\\\frac{-2-3}{x-(-1)}&=1\\\\\\frac{-5}{x+1}&=1\\\\x+1&=-5\\\\x&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-03df2-p64-practice-slot-10-slot-10-b",
        "type": "part",
        "label": "b",
        "prompt": "Angle of inclination $150^\\circ$; points $(-2,1)$ and $(x,-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3\\sqrt3-2$",
          "worked": "$$\\begin{align*}m&=\\tan150^\\circ=-\\frac1{\\sqrt3}\\\\\\frac{-2-1}{x-(-2)}&=-\\frac1{\\sqrt3}\\\\\\frac{-3}{x+2}&=-\\frac1{\\sqrt3}\\\\x+2&=3\\sqrt3\\\\x&=3\\sqrt3-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
