  "content": {
    "id": "p22-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If light travels at $3\\times10^5$ km/s and our galaxy is approximately $80\\,000$ light years across, how many kilometres is it across? (A light year is the distance light travels in a year.) Give your answer in scientific notation, rounding its coefficient to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p22-q10-short-result",
            "type": "paragraph",
            "fontSize": null,
