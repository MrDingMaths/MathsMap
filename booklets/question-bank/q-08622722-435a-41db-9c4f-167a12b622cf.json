        "answer": {
          "short": "$n=2$",
          "worked": "$$\\begin{align*}\\left(\\frac1{10}\\right)^n&=\\left(\\frac1{10}\\right)^2\\\\n&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
