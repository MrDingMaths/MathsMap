        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}10^n&=10^3\\\\n&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^n=27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}3^n&=3^3\\\\n&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^{2n}=64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}2^{2n}&=2^6\\\\2n&=6\\\\n&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$5^{n+1}=125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$",
          "worked": "$$\\begin{align*}5^{n+1}&=5^3\\\\n+1&=3\\\\n&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^{n-1}=64$",
