        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4$",
          "worked": "$$\\begin{align*}4^{n-1}&=4^3\\\\n-1&=3\\\\n&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1}{2^n}=\\dfrac14$",
