  "content": {
    "id": "p11-q8",
    "type": "question",
    "label": "8",
    "prompt": "The area of a triangle is given by the formula $A = \\frac{1}{2}bh$. Use the formula to:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "find $A$ when $b = 20$ and $h = 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A = 90$",
          "worked": "$$\\begin{align*} A &= \\frac{1}{2}bh \\\\ A &= \\frac{1}{2}(20)(9) \\\\ A &= 90 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p11-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "find $b$ when $A = 20$ and $h = 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b = 8$",
          "worked": "$$\\begin{align*} A &= \\frac{1}{2}bh \\\\ 20 &= \\frac{1}{2}b(5) \\\\ 40 &= 5b \\\\ b &= 8 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
