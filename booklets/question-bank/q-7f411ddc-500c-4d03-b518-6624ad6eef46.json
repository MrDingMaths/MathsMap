  "content": {
    "id": "p11-q7",
    "type": "question",
    "label": "7",
    "prompt": "The perimeter of a rectangle of length $l$ and width $w$ is given by the formula $P = 2(l + w)$.\nUse the formula to:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "find $P$ when $l = 6$ and $w = 20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P = 52$",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ P &= 2(6+20) \\\\ P &= 52 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "find $l$ when $w = 6$ and $P = 20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l = 4$",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ 20 &= 2(l+6) \\\\ 10 &= l+6 \\\\ l &= 4 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "find $w$ when $P = 10$ and $l = 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w = 3$",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ 10 &= 2(2+w) \\\\ 5 &= 2+w \\\\ w &= 3 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "find area of a rectangle if its perimeter is 20 and width is 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l = 6$, so $A = 24$.",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ 20 &= 2(l+4) \\\\ 10 &= l+4 \\\\ l &= 6 \\end{align*}$$\n$$\\begin{align*} A &= lw \\\\ A &= (6)(4) \\\\ A &= 24 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 51
      }
    ]
  },
