  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "For each problem, write an equation and solve it to find the unknown number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Ten is added to a number, $x$, and the result is multiplied by $\\frac{1}{2}$. The result of this is $-32$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}(x+10)=-32$; $x=-74$.",
          "worked": "$$\\begin{align*}\\frac{1}{2}(x+10)&=-32\\\\x+10&=-64\\\\x&=-64-10\\\\x&=-74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "One-quarter of a number, $x$, and one-fifth of the same number are added. The result is 60.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{4}+\\frac{x}{5}=60$; $x=133\\frac{1}{3}$.",
          "worked": "Multiply both sides by 20.\n\n$$\\begin{align*}\\frac{x}{4}+\\frac{x}{5}&=60\\\\5x+4x&=1200\\\\9x&=1200\\\\x&=\\frac{1200}{9}\\\\x&=133\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p15-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "The result of multiplying a number, $a$, by $-6$ and adding 3 is the same as the result of multiplying $a$ by 10 and subtracting 20.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6a+3=10a-20$; $a=1\\frac{7}{16}$.",
          "worked": "$$\\begin{align*}-6a+3&=10a-20\\\\3&=16a-20\\\\23&=16a\\\\a&=\\frac{23}{16}\\\\a&=1\\frac{7}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p15-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Two-sevenths of a number, $z$, is subtracted from three-fifths of the same number, and the result is 10.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3z}{5}-\\frac{2z}{7}=10$; $z=31\\frac{9}{11}$.",
          "worked": "Multiply both sides by 35.\n\n$$\\begin{align*}\\frac{3z}{5}-\\frac{2z}{7}&=10\\\\21z-10z&=350\\\\11z&=350\\\\z&=\\frac{350}{11}\\\\z&=31\\frac{9}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p15-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "Six is added to seven-tenths of a number, $z$, and the result is the same as subtracting 4 from $z$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7z}{10}+6=z-4$; $z=33\\frac{1}{3}$.",
          "worked": "Multiply both sides by 10.\n\n$$\\begin{align*}\\frac{7z}{10}+6&=z-4\\\\7z+60&=10z-40\\\\60&=3z-40\\\\100&=3z\\\\z&=\\frac{100}{3}\\\\z&=33\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
