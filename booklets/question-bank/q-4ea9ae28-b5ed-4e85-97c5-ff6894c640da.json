  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Use the quotient rule to find the first derivative of each function. Then use the chain rule to find the second derivative.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{1}{(x+1)^2}$; $\\dfrac{d^2y}{dx^2}=-\\dfrac{2}{(x+1)^3}$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{(x+1)(1)-x(1)}{(x+1)^2}\\\\\\frac{dy}{dx}&=\\frac{1}{(x+1)^2}\\\\\\frac{dy}{dx}&=(x+1)^{-2}\\\\\\frac{d^2y}{dx^2}&=-2(x+1)^{-3}(1)\\\\\\frac{d^2y}{dx^2}&=-\\frac{2}{(x+1)^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x-1}{2x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac{7}{(2x+5)^2}$; $\\dfrac{d^2y}{dx^2}=-\\dfrac{28}{(2x+5)^3}$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{(2x+5)(1)-(x-1)(2)}{(2x+5)^2}\\\\\\frac{dy}{dx}&=\\frac{2x+5-2x+2}{(2x+5)^2}\\\\\\frac{dy}{dx}&=\\frac{7}{(2x+5)^2}\\\\\\frac{dy}{dx}&=7(2x+5)^{-2}\\\\\\frac{d^2y}{dx^2}&=7(-2)(2x+5)^{-3}(2)\\\\\\frac{d^2y}{dx^2}&=-\\frac{28}{(2x+5)^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
