  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Evaluate these expressions for $x = 2$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2(x+5)}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{2(x+5)}{7}&=\\frac{2(2+5)}{7}\\\\\\frac{2(x+5)}{7}&=\\frac{2\\times7}{7}\\\\\\frac{2(x+5)}{7}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2x}{10}+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\frac{2}{5}$",
          "worked": "$$\\begin{align*}\\frac{2x}{10}+10&=\\frac{2\\times2}{10}+10\\\\\\frac{2x}{10}+10&=\\frac{4}{10}+10\\\\\\frac{2x}{10}+10&=\\frac{2}{5}+10\\\\\\frac{2x}{10}+10&=10\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$7\\left(\\frac{x-1}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{2}{5}$",
          "worked": "$$\\begin{align*}7\\left(\\frac{x-1}{5}\\right)&=7\\left(\\frac{2-1}{5}\\right)\\\\7\\left(\\frac{x-1}{5}\\right)&=7\\times\\frac{1}{5}\\\\7\\left(\\frac{x-1}{5}\\right)&=\\frac{7}{5}\\\\7\\left(\\frac{x-1}{5}\\right)&=1\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$4-\\frac{3x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}4-\\frac{3x}{2}&=4-\\frac{3\\times2}{2}\\\\4-\\frac{3x}{2}&=4-3\\\\4-\\frac{3x}{2}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
