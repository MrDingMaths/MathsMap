  "content": {
    "id": "p14-23d-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Divide each of the polynomials $P(x)$ by the given polynomial $D(x)$. Express your answer in the form $$\\frac{P(x)}{D(x)}=Q(x)+\\frac{R(x)}{D(x)}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-23d-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=2x+3$, $D(x)=x-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle 2+\\frac{5}{x-1}$",
          "worked": "$$\\begin{align*}2x+3-2(x-1)&=5\\\\2x+3&=2(x-1)+5\\\\\\frac{2x+3}{x-1}&=2+\\frac{5}{x-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-23d-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=3x+4$, $D(x)=4x+3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle \\frac34+\\frac{\\frac74}{4x+3}$",
          "worked": "$$\\begin{align*}3x+4-\\frac34(4x+3)&=\\frac74\\\\3x+4&=\\frac34(4x+3)+\\frac74\\\\\\frac{3x+4}{4x+3}&=\\frac34+\\frac{\\frac74}{4x+3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-23d-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=x^3-2x^2+x+3$, $D(x)=x^2-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle x-2+\\frac{2x+1}{x^2-1}$",
          "worked": "$$\\begin{align*}(x^3-2x^2+x+3)-x(x^2-1)&=-2x^2+2x+3\\\\(-2x^2+2x+3)-(-2)(x^2-1)&=2x+1\\\\x^3-2x^2+x+3&=(x^2-1)(x-2)+(2x+1)\\\\\\frac{x^3-2x^2+x+3}{x^2-1}&=x-2+\\frac{2x+1}{x^2-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-23d-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=x^4+3x^2-x+2$, $D(x)=x^2+3x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle x^2-3x+11-\\frac{31x+9}{x^2+3x+1}$",
          "worked": "Include the missing $0x^3$ term when setting out the division.\n\n$$\\begin{align*}(x^4+0x^3+3x^2-x+2)-x^2(x^2+3x+1)&=-3x^3+2x^2-x+2\\\\(-3x^3+2x^2-x+2)-(-3x)(x^2+3x+1)&=11x^2+2x+2\\\\(11x^2+2x+2)-11(x^2+3x+1)&=-31x-9\\\\x^4+3x^2-x+2&=(x^2+3x+1)(x^2-3x+11)-31x-9\\\\\\frac{x^4+3x^2-x+2}{x^2+3x+1}&=x^2-3x+11-\\frac{31x+9}{x^2+3x+1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
