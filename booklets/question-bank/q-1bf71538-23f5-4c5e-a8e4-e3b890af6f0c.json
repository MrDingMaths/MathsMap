    "type": "question",
    "label": "3",
    "prompt": "A rectangular orchard is 520 m long and 300 m wide. Find the area of the orchard in hectares. (Recall that $1\\text{ hectare}=10\\,000\\text{ m}^2$.)",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "15.6 ha",
      "worked": "$$\\begin{aligned}A&=520\\times300=156\\,000\\text{ m}^2\\\\A&=156\\,000\\div10\\,000=15.6\\text{ ha}.\\end{aligned}$$",
