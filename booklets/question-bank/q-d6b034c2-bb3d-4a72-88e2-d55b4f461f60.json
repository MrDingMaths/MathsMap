  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "When two different lines have the same gradient, there will be no intersection point.\nUse this idea to decide if these pairs of simultaneous equations will have a solution.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=3x-1\\\\y&=3x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "Both gradients are $3$, but the intercepts are $-1$ and $1$. The lines are parallel, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=7x+2\\\\y&=7x+6\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "Both gradients are $7$, but the intercepts are $2$ and $6$. The lines are parallel, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x-6\\\\y&=-2x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Solution possible.",
          "worked": "The gradients are $2$ and $-2$. They are different, so the lines intersect and have a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=-x+7\\\\y&=2x-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Solution possible.",
          "worked": "The gradients are $-1$ and $2$. They are different, so the lines intersect and have a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}2x-y&=4\\\\y&=2x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "$$\\begin{aligned}2x-y&=4\\\\y&=2x-4\\end{aligned}$$\nBoth gradients are $2$, but the intercepts are $-4$ and $1$. The lines are parallel, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}7x-y&=1\\\\y&=-7x+2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Solution possible.",
          "worked": "$$\\begin{aligned}7x-y&=1\\\\y&=7x-1\\end{aligned}$$\nThe gradients are $7$ and $-7$. They are different, so the lines intersect and have a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}2y-3x&=0\\\\y&=-\\frac{3x}{2}-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Solution possible.",
          "worked": "$$\\begin{aligned}2y-3x&=0\\\\2y&=3x\\\\y&=\\frac{3}{2}x\\end{aligned}$$\nThe gradients are $\\frac32$ and $-\\frac32$. They are different, so the lines intersect and have a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}y&=\\frac{x}{2}+3\\\\\\frac{x-2y}{4}&=0\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "$$\\begin{aligned}\\frac{x-2y}{4}&=0\\\\x-2y&=0\\\\2y&=x\\\\y&=\\frac{x}{2}\\end{aligned}$$\nBoth gradients are $\\frac12$, but the intercepts are $3$ and $0$. The lines are parallel, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
