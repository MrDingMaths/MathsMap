  "content": {
    "id": "p30-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "Eggs are sold in cartons of 12. If there are 345 eggs to be packaged, how many full cartons will there be and how many eggs will be left over?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "28 full cartons; 9 eggs left over.",
      "worked": "Using short division, $34\\div12=2$ remainder $10$. Write $2$ in the tens column and carry the remaining $10$ tens to the $5$ ones, giving $105$. Then $105\\div12=8$ remainder $9$.\n\n$345\\div12=28$ remainder $9$.\n\nThere will be 28 full cartons and 9 eggs left over.",
      "solutionDiagrams": []
    },
