  "content": {
    "id": "p37-q6",
    "type": "question",
    "label": "6",
    "prompt": "Identify the natural domain of these functions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{2}{\\sqrt{1-x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<1$",
          "worked": "The radicand must be positive because the square root is in the denominator.\n$$\\begin{aligned}1-x&>0\\\\x&<1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1}{\\sqrt{2x-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\dfrac{3}{2}$",
          "worked": "The radicand must be positive because the square root is in the denominator.\n$$\\begin{aligned}2x-3&>0\\\\2x&>3\\\\x&>\\frac{3}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p37-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{x}{\\sqrt{x+2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-2$",
          "worked": "The radicand must be positive because the square root is in the denominator.\n$$\\begin{aligned}x+2&>0\\\\x&>-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p37-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{1}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\neq2$ and $x\\neq-2$",
          "worked": "The denominator cannot be zero.\n$$\\begin{aligned}x^2-4&\\neq0\\\\(x-2)(x+2)&\\neq0\\end{aligned}$$\nThe domain is all real $x$ except $x=2$ and $x=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\dfrac{1}{x^2+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\neq0$ and $x\\neq-1$",
          "worked": "The denominator cannot be zero.\n$$\\begin{aligned}x^2+x&\\neq0\\\\x(x+1)&\\neq0\\end{aligned}$$\nThe domain is all real $x$ except $x=0$ and $x=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p37-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{1}{x^2-5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\neq2$ and $x\\neq3$",
          "worked": "The denominator cannot be zero.\n$$\\begin{aligned}x^2-5x+6&\\neq0\\\\(x-2)(x-3)&\\neq0\\end{aligned}$$\nThe domain is all real $x$ except $x=2$ and $x=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
