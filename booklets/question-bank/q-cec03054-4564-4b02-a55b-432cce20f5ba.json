            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"seriesBlue\",\"hex\":\"268CFF\",\"reason\":\"exponential population curve and its plotted markers\"},{\"name\":\"gridGrey\",\"hex\":\"CCCCCC\",\"reason\":\"coordinate grid\"}],\"reference\":\"source page 42, p42-q2-graph\"}\n\\begin{tikzpicture}[x=0.24cm,y=0.24cm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{seriesBlue}{HTML}{268CFF}\n\\definecolor{gridGrey}{HTML}{CCCCCC}\n\\path[use as bounding box] (-4,-2) rectangle (29,22);\n\\draw[step=1,gridGrey,line width=0.25pt] (0,0) grid (27,20);\n\\draw[black,line width=0.5pt,->] (0,0)--(27,0);\n\\draw[black,line width=0.5pt] (0,0)--(0,1.1);\n\\draw[black,line width=0.5pt] (0,1.1)--(-0.5,1.4)--(0.5,1.7)--(0,2);\n\\draw[black,line width=0.5pt,->] (0,2)--(0,20.8);\n\\foreach \\x in {5,10,15,20,25}{\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-0.35);\\node[below,font=\\fontsize{8.5}{10}\\selectfont] at (\\x,-0.35) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y/\\lab in {3/20\\,000,8/30\\,000,13/40\\,000,18/50\\,000}{\\draw[black,line width=0.4pt] (0,\\y)--(-0.35,\\y);\\node[left,font=\\fontsize{8.5}{10}\\selectfont] at (-0.35,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\lab$\\special{dvisvgm:raw </g>}};}\n\\node[below left,font=\\fontsize{8.5}{10}\\selectfont] at (-0.35,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\node[above left] at (0,20.8) {$P$};\n\\node[below right] at (27,0) {$t$};\n\\draw[seriesBlue,line width=0.8pt,domain=0:25,samples=101] plot (\\x,{15*pow(1.02,\\x)-7});\n\\foreach \\x in {0,5,10,15,20,25}{\\fill[seriesBlue] (\\x,{15*pow(1.02,\\x)-7}) circle[radius=1.1pt];}\n\\node[black,below] at (16,10.3) {$P=30\\,000(1.02)^t$};\n\\end{tikzpicture}",
