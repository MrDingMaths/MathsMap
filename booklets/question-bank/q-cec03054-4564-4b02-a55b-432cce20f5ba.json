        "children": [
          {
            "id": "p42-q2-a",
            "type": "part",
            "label": "a",
            "prompt": "What does the intercept of the curve with the vertical axis represent?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The initial population: $30\\,000$ people.",
              "worked": "The vertical-axis intercept occurs at $t=0$, so it represents the initial population of $30\\,000$ people.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p42-q2-b",
            "type": "part",
            "label": "b",
            "prompt": "Use the graph to estimate the population after 18 years.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Approximately $43\\,000$ people.",
              "worked": "Read upwards from $t=18$ to the curve, then across to the population axis. The population is approximately $43\\,000$ people.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p42-q2-c",
            "type": "part",
            "label": "c",
            "prompt": "Estimate the time taken for the population to reach $39\\,000$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Approximately 13 years.",
              "worked": "Read across from $P=39\\,000$ to the curve, then down to the time axis. The time is approximately 13 years.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ],
        "diagramPlacement": "beside-prompt"
      },
      {
        "id": "p42-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the percentage increase in population each year?\nExplain how you can work this out from looking at the equation $P = 30\\,000(1.02)^t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\%$ per year, since $1.02=1+0.02$.",
          "worked": "$$\\begin{align*}1.02&=1+0.02\\\\0.02\\times100\\%&=2\\%\\end{align*}$$\nThe factor $1.02$ represents a $2\\%$ increase each year.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
