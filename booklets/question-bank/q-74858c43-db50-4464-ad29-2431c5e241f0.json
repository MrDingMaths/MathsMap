      {
        "id": "p32-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "By what factor does the volume of an $8\\times9\\times10$ cuboid exceed the volume of a $3\\times4\\times5$ cuboid?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}V_{\\text{larger}}&=8\\times9\\times10=720\\\\V_{\\text{smaller}}&=3\\times4\\times5=60\\\\\\text{Factor}&=\\frac{720}{60}=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "By what factor does the volume of a $26\\times27\\times28$ cuboid exceed the volume of a $7\\times8\\times9$ cuboid?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$39$",
          "worked": "$$\\begin{align*}V_{\\text{larger}}&=26\\times27\\times28=19656\\\\V_{\\text{smaller}}&=7\\times8\\times9=504\\\\\\text{Factor}&=\\frac{19656}{504}=39\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
