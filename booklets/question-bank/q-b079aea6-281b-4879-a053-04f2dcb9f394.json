    "type": "question",
    "label": "9",
    "prompt": "A book of 150 pages has a picture on 20 of its pages. If one page is chosen at random, what is the probability that it has a picture on it?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{15}$",
      "worked": "There are 20 favourable pages out of 150 equally likely pages.\n$$\\begin{align*}P(\\text{picture})&=\\frac{20}{150}\\\\P(\\text{picture})&=\\frac{2}{15}\\end{align*}$$",
      "solutionDiagrams": []
