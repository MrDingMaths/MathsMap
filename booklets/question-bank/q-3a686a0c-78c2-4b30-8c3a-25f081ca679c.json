  "content": {
    "id": "p41-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Prove, using exact values, that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin330^\\circ\\cos150^\\circ-\\cos390^\\circ\\sin390^\\circ=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=(-\\tfrac12)(-\\tfrac{\\sqrt3}{2})-(\\tfrac{\\sqrt3}{2})(\\tfrac12)=0=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=-\\sin30^\\circ(-\\cos30^\\circ)-\\cos30^\\circ\\sin30^\\circ\\\\&=\\sin30^\\circ\\cos30^\\circ-\\cos30^\\circ\\sin30^\\circ\\\\&=\\frac12\\cdot\\frac{\\sqrt3}{2}-\\frac{\\sqrt3}{2}\\cdot\\frac12\\\\&=0=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p41-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin420^\\circ\\cos405^\\circ+\\cos420^\\circ\\sin405^\\circ=\\dfrac{\\sqrt3+1}{2\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sqrt3}{2\\sqrt2}+\\dfrac1{2\\sqrt2}=\\dfrac{\\sqrt3+1}{2\\sqrt2}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\sin60^\\circ\\cos45^\\circ+\\cos60^\\circ\\sin45^\\circ\\\\&=\\frac{\\sqrt3}{2}\\left(\\frac1{\\sqrt2}\\right)+\\frac12\\left(\\frac1{\\sqrt2}\\right)\\\\&=\\frac{\\sqrt3}{2\\sqrt2}+\\frac1{2\\sqrt2}\\\\&=\\frac{\\sqrt3+1}{2\\sqrt2}=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p41-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sin135^\\circ-\\cos120^\\circ}{\\sin135^\\circ+\\cos120^\\circ}=3+2\\sqrt2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{2+\\sqrt2}{2-\\sqrt2}=\\dfrac{(2+\\sqrt2)^2}{4-2}=3+2\\sqrt2=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin45^\\circ-(-\\cos60^\\circ)}{\\sin45^\\circ+(-\\cos60^\\circ)}\\\\&=\\frac{\\frac1{\\sqrt2}+\\frac12}{\\frac1{\\sqrt2}-\\frac12}\\\\&=\\frac{\\frac{2+\\sqrt2}{2\\sqrt2}}{\\frac{2-\\sqrt2}{2\\sqrt2}}\\\\&=\\frac{2+\\sqrt2}{2-\\sqrt2}\\times\\frac{2+\\sqrt2}{2+\\sqrt2}\\\\&=\\frac{4+4\\sqrt2+2}{4-2}\\\\&=\\frac{6+4\\sqrt2}{2}\\\\&=3+2\\sqrt2=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 92
      },
      {
        "id": "p42-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sin150^\\circ+\\cos270^\\circ+\\tan315^\\circ)^2=\\sin^2 135^\\circ\\cos^2 225^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=(\\tfrac12-1)^2=\\tfrac14$ and $\\mathrm{RHS}=(\\tfrac1{\\sqrt2})^2(-\\tfrac1{\\sqrt2})^2=\\tfrac14$. Hence $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=(\\sin30^\\circ+0+(-\\tan45^\\circ))^2\\\\&=\\left(\\frac12-1\\right)^2\\\\&=\\frac14.\\end{align*}$$\n$$\\begin{align*}\\mathrm{RHS}&=(\\sin45^\\circ)^2(-\\cos45^\\circ)^2\\\\&=\\left(\\frac1{\\sqrt2}\\right)^2\\left(-\\frac1{\\sqrt2}\\right)^2\\\\&=\\frac14.\\end{align*}$$\nTherefore $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p42-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sin120^\\circ}{\\tan300^\\circ}-\\dfrac{\\cos240^\\circ}{\\left(\\dfrac1{\\tan315^\\circ}\\right)}=\\tan^2 240^\\circ-\\dfrac1{\\sin^2 330^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=-\\tfrac12-\\tfrac12=-1$ and $\\mathrm{RHS}=3-4=-1$. Hence $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin60^\\circ}{-\\tan60^\\circ}-\\frac{-\\cos60^\\circ}{\\left(\\frac1{-\\tan45^\\circ}\\right)}\\\\&=\\frac{\\left(\\frac{\\sqrt3}{2}\\right)}{-\\sqrt3}-\\frac{\\left(-\\frac12\\right)}{-1}\\\\&=-\\frac12-\\frac12\\\\&=-1.\\end{align*}$$\n$$\\begin{align*}\\mathrm{RHS}&=\\tan^2 60^\\circ-\\frac1{\\sin^2 30^\\circ}\\\\&=(\\sqrt3)^2-\\frac1{\\left(\\frac12\\right)^2}\\\\&=3-\\frac1{\\left(\\frac14\\right)}\\\\&=3-4\\\\&=-1.\\end{align*}$$\nTherefore $\\mathrm{LHS}=\\mathrm{RHS}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 108
      }
    ]
  },
