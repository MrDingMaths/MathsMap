  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A student thinks that the common denominator to use when simplifying $\\dfrac{x+1}{2}+\\dfrac{2x-1}{4}$ is 8.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4-methods",
        "type": "group",
        "label": null,
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q4-a",
            "type": "part",
            "label": "a",
            "prompt": "Complete the addition by making both denominators 8.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{8x+2}{8}=\\dfrac{4x+1}{4}$",
              "worked": "$$\\begin{align*}\\frac{x+1}{2}+\\frac{2x-1}{4}&=\\frac{4(x+1)}{8}+\\frac{2(2x-1)}{8}\\\\&=\\frac{4x+4+4x-2}{8}\\\\&=\\frac{8x+2}{8}\\\\&=\\frac{4x+1}{4}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p6-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "Complete the simplification using the actual LCD of 4.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{4x+1}{4}$",
              "worked": "$$\\begin{align*}\\frac{x+1}{2}+\\frac{2x-1}{4}&=\\frac{2(x+1)}{4}+\\frac{2x-1}{4}\\\\&=\\frac{2(x+1)+(2x-1)}{4}\\\\&=\\frac{2x+2+2x-1}{4}\\\\&=\\frac{4x+1}{4}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      },
      {
        "id": "p6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p6-q4-c-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "You should have the same answer for both methods. Which do you prefer and why?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, use 4: smaller numbers and less simplification.",
          "worked": "Both methods give $\\dfrac{4x+1}{4}$. Using the LCD of 4 keeps the numbers smaller and avoids reducing a fraction with denominator 8. Either preference is acceptable with a valid reason.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
