  "content": {
    "id": "p40-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A number is chosen uniformly from the interval $[0,10]$. Find the probability that it is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q1a",
        "type": "part",
        "label": "a",
        "prompt": "less than 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{align*}\\Pr(X<3)&=\\frac{3-0}{10-0}\\\\\\Pr(X<3)&=\\frac{3}{10}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q1b",
        "type": "part",
        "label": "b",
        "prompt": "in the interval $[4,6]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\Pr(4\\le X\\le6)&=\\frac{6-4}{10-0}\\\\\\Pr(4\\le X\\le6)&=\\frac{1}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q1c",
        "type": "part",
        "label": "c",
        "prompt": "greater than 8 or less than 2",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "The two intervals are disjoint, so their lengths add.\n\n$$\\begin{align*}\\Pr(X>8\\text{ or }X<2)&=\\frac{(10-8)+(2-0)}{10-0}\\\\\\Pr(X>8\\text{ or }X<2)&=\\frac{2}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p40-q1d",
        "type": "part",
        "label": "d",
        "prompt": "greater than 2 given that it is less than 8.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}$",
          "worked": "Given $X<8$, the sample interval has length 8. The favourable interval is $(2,8)$.\n\n$$\\begin{align*}\\Pr(X>2\\mid X<8)&=\\frac{8-2}{8-0}\\\\\\Pr(X>2\\mid X<8)&=\\frac{3}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
