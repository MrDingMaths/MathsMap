        "prompt": "$\\displaystyle\\int\\frac{1}{3x-k}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13\\ln|3x-k|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{1}{3x-k}\\,dx&=\\frac13\\ln|3x-k|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
