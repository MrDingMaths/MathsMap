      {
        "id": "p32-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{1}{mx-2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1m\\ln|mx-2|+C$",
          "worked": "For $m\\ne0$,\n$$\\begin{align*}\\int\\frac{1}{mx-2}\\,dx&=\\frac1m\\ln|mx-2|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{p}{px+q}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln|px+q|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{p}{px+q}\\,dx&=p\\left(\\frac1p\\ln|px+q|\\right)+C\\\\&=\\ln|px+q|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{A}{sx-t}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac As\\ln|sx-t|+C$",
          "worked": "For $s\\ne0$,\n$$\\begin{align*}\\int\\frac{A}{sx-t}\\,dx&=A\\left(\\frac1s\\ln|sx-t|\\right)+C\\\\&=\\frac As\\ln|sx-t|+C\\end{align*}$$",
