    "type": "question",
    "label": null,
    "prompt": "Simplify $\\dfrac{\\binom{n-1}{k-1}}{\\binom nk}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{k}{n}$",
      "worked": "$$\\begin{align*}\\frac{\\binom{n-1}{k-1}}{\\binom nk}&=\\frac{(n-1)!}{(k-1)!(n-k)!}\\times\\frac{k!(n-k)!}{n!}\\\\\\frac{\\binom{n-1}{k-1}}{\\binom nk}&=\\frac{(n-1)!\\,k(k-1)!}{(k-1)!\\,n(n-1)!}\\\\\\frac{\\binom{n-1}{k-1}}{\\binom nk}&=\\frac{k}{n}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
