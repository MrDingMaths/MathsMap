  "content": {
    "id": "p10-p2-root",
    "type": "question",
    "label": "2",
    "prompt": "For each of the following, in what direction was $f(x)$ translated to yield $g(x)$, and by how many units?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-p2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sqrt{2x-3}$, $y=\\sqrt{2x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 units to the left.",
          "worked": "$$\\begin{align*} g(x)&=\\sqrt{2x+7}\\\\ g(x)&=\\sqrt{2(x+5)-3}\\\\ g(x)&=f(x+5) \\end{align*}$$\nThe translation is 5 units to the left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-p2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(3x+5)^2$, $y=(3x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units to the right.",
          "worked": "$$\\begin{align*} g(x)&=(3x-1)^2\\\\ g(x)&=(3(x-2)+5)^2\\\\ g(x)&=f(x-2) \\end{align*}$$\nThe translation is 2 units to the right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-p2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=e^{-x}$, $y=e^{-x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 unit to the right.",
          "worked": "$$\\begin{align*} g(x)&=e^{-x+1}\\\\ g(x)&=e^{-(x-1)}\\\\ g(x)&=f(x-1) \\end{align*}$$\nThe translation is 1 unit to the right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p10-p2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=e^{-2x}$, $y=e^{-2x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units to the right.",
          "worked": "$$\\begin{align*} g(x)&=e^{-2x+4}\\\\ g(x)&=e^{-2(x-2)}\\\\ g(x)&=f(x-2) \\end{align*}$$\nThe translation is 2 units to the right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
