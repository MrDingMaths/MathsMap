        "answer": {
          "short": "$2^5\\times3^5$",
          "worked": "The three single factors of 2 contribute $2^3$; the two single factors of 3 contribute $3^2$.\n\n$$\\begin{align*}2\\times2\\times2\\times2^2\\times3\\times3\\times3^3&=2^{3+2}\\times3^{2+3}\\\\2\\times2\\times2\\times2^2\\times3\\times3\\times3^3&=2^5\\times3^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\times3\\times2\\times3\\times2\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3\\times3^3$",
          "worked": "$$\\begin{align*}2\\times3\\times2\\times3\\times2\\times3&=(2\\times2\\times2)\\times(3\\times3\\times3)\\\\2\\times3\\times2\\times3\\times2\\times3&=2^3\\times3^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
