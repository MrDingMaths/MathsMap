        "answer": {
          "short": "$4\\sqrt{6}+10\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\sqrt{600}+\\sqrt{300}-\\sqrt{216}&=\\sqrt{100\\times6}+\\sqrt{100\\times3}-\\sqrt{36\\times6}\\\\\\sqrt{600}+\\sqrt{300}-\\sqrt{216}&=10\\sqrt{6}+10\\sqrt{3}-6\\sqrt{6}\\\\\\sqrt{600}+\\sqrt{300}-\\sqrt{216}&=4\\sqrt{6}+10\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$4\\sqrt{18}+3\\sqrt{12}-2\\sqrt{50}$",
        "layout": "list",
        "columns": null,
