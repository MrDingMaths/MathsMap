  "content": {
    "id": "p41-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Screw lengths are normally distributed with mean 2 cm and standard deviation 0.1 cm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q12-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p41-q12-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What is the probability a screw is undersized",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "(more than 2 standard deviations below the mean)?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $0.025$ ($2.5\\%$).",
          "worked": "By the empirical rule, approximately 95% of lengths lie within two standard deviations of the mean. The remaining 5% is split equally between the tails.\n$$P(Z<-2)\\approx\\frac{1-0.95}{2}=0.025$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p41-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "In a batch of 2400, use z-scores to find how many screws are longer than 2.3 cm. Give your answer to the nearest whole screw.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 4 screws.",
          "worked": "$$\\begin{aligned}z&=\\frac{2.3-2}{0.1}=3\\\\P(Z>3)&\\approx0.0015\\\\\\text{Expected number}&=0.0015\\times2400=3.6\\\\\\text{Expected number}&\\approx4\\text{ screws}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
