    "id": "p31-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "The scale of a map reads $1:350\\,000$. Find the distance apart of two towns that are:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$3\\text{ cm}$ apart on the map",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10.5\\text{ km}$",
          "worked": "On the map, $1\\text{ cm}$ represents $350\\,000\\text{ cm}=3.5\\text{ km}$.\n$$\\begin{align*}\\text{Actual distance}&=3\\times3.5\\text{ km}\\\\\\text{Actual distance}&=10.5\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p31-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$35\\text{ mm}$ apart on the map",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.25\\text{ km}$",
          "worked": "$35\\text{ mm}=3.5\\text{ cm}$. On the map, $1\\text{ cm}$ represents $350\\,000\\text{ cm}=3.5\\text{ km}$.\n$$\\begin{align*}\\text{Actual distance}&=3.5\\times3.5\\text{ km}\\\\\\text{Actual distance}&=12.25\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
