  "content": {
    "id": "v2-97400-p42-practice-slot-2-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Two Year 9 classes have 58 students in total. One class has 4 more students than the other. How many students are in each class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "31 and 27 students.",
      "worked": "Let $x$ be the number of students in the larger class and $y$ the number in the smaller class.\n$$\\begin{align*}x+y&=58 &&(1)\\\\x-y&=4 &&(2)\\end{align*}$$\n$(1)+(2)$:\n$$\\begin{align*}2x&=62\\\\x&=31\\end{align*}$$\nSubstitute $x=31$ into (1):\n$$\\begin{align*}31+y&=58\\\\y&=27\\end{align*}$$\nThe classes have 31 and 27 students.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
