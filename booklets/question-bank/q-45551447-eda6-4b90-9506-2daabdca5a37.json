    "prompt": "Jerry is solving the equation $\\frac{a-3}{4}=6$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p50-q2-attempt",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 50, p50-q2-attempt\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,draw=black,text=black,>=stealth,every node/.style={font=\\fontsize{10}{12}\\selectfont,inner sep=1pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-3.05,-4.45) rectangle (3.05,0.65);\n\\node at (0,0) {$\\dfrac{a-3}{4}=6$};\n\\node at (0,-2) {$\\dfrac{a}{4}=9$};\n\\node at (0,-4) {$a=36$};\n\\draw[->,line width=0.8pt] (-1.45,0.05) .. controls (-2.12,-0.65) and (-2.12,-1.05) .. (-1.45,-1.65);\n\\draw[->,line width=0.8pt] (1.45,0.05) .. controls (2.12,-0.65) and (2.12,-1.05) .. (1.45,-1.65);\n\\node at (-2.55,-0.8) {$+3$};\n\\node at (2.55,-0.8) {$+3$};\n\\draw[->,line width=0.8pt] (-1.45,-2.1) .. controls (-2.12,-2.65) and (-2.12,-3.05) .. (-1.45,-3.7);\n\\draw[->,line width=0.8pt] (1.45,-2.1) .. controls (2.12,-2.65) and (2.12,-3.05) .. (1.45,-3.7);\n\\node at (-2.55,-2.9) {$\\times4$};\n\\node at (2.55,-2.9) {$\\times4$};\n\\end{tikzpicture}",
        "src": null,
