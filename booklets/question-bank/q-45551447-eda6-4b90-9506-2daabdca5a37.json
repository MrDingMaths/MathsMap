    "children": [
      {
        "id": "p50-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show by substitution that Jerry is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{36-3}{4}=\\frac{33}{4}\\ne6$",
          "worked": "$$\\begin{align*}\\frac{36-3}{4}&=\\frac{33}{4}\\\\&\\ne6\\end{align*}$$\nSo $a=36$ does not satisfy the equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p50-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain his mistake",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "He should have multiplied by $4$ first.",
          "worked": "He added $3$ before undoing division by $4$. The whole numerator $a-3$ is divided by $4$, so multiply both sides by $4$ first, then add $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p50-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the correct solution to the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=27$",
          "worked": "$$\\begin{align*}\\frac{4(a-3)}{4}&=4\\times6\\\\a-3&=24\\\\a-3+3&=24+3\\\\a&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
