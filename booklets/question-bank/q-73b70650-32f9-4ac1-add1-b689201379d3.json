      {
        "id": "p10-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "What are the values of $\\cos360^\\circ$, $\\sin360^\\circ$ and $\\tan360^\\circ$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos360^\\circ=1$, $\\sin360^\\circ=0$, $\\tan360^\\circ=0$.",
          "worked": "One full revolution returns $P$ to $(1,0)$.\n\n$$\\begin{align*}\\cos360^\\circ&=1\\\\\\sin360^\\circ&=0\\\\\\tan360^\\circ&=\\frac{0}{1}\\\\\\tan360^\\circ&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "Why are $\\tan90^\\circ$ and $\\tan270^\\circ$ not defined?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both have $\\cos\\theta=0$, so $\\tan\\theta=\\dfrac{\\sin\\theta}{\\cos\\theta}$ would require division by zero.",
          "worked": "$$\\begin{align*}\\tan90^\\circ&=\\frac{\\sin90^\\circ}{\\cos90^\\circ}=\\frac{1}{0}\\\\\\tan270^\\circ&=\\frac{\\sin270^\\circ}{\\cos270^\\circ}=\\frac{-1}{0}\\end{align*}$$\n\nDivision by zero is undefined, so neither tangent value is defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
