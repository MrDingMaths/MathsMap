  "content": {
    "id": "p40-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider the differential equation $\\dfrac{dy}{dx}=2-y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the constant solution?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2$.",
          "worked": "For a constant solution, $\\dfrac{dy}{dx}=0$.\n$$\\begin{align*}2-y&=0\\\\y&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p40-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Use separation of variables or reciprocals to solve the DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln|2-y|=-x+C$ for nonconstant solutions.",
          "worked": "Separate variables for $y\\ne2$:\n$$\\begin{align*}\\frac{1}{2-y}\\,dy&=dx\\\\\\int\\frac{1}{2-y}\\,dy&=\\int1\\,dx\\\\-\\ln|2-y|&=x+C_1\\\\\\ln|2-y|&=-x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p40-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Make $y$ the subject, simplifying the constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2+Ae^{-x}$, where $A\\in\\mathbb R$.",
          "worked": "$$\\begin{align*}|2-y|&=e^{-x+C}\\\\2-y&=Be^{-x}\\\\y&=2-Be^{-x}\\\\y&=2+Ae^{-x}\\end{align*}$$\nHere $B=\\pm e^C$ and $A=-B$. Including $A=0$ restores the constant solution, so the complete family has $A\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Check that the constant solution is included in part c.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=0$ gives $y=2$.",
          "worked": "Taking $A=0$ in $y=2+Ae^{-x}$ gives $y=2$, the constant solution from part a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p40-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the solution for $y(0)=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2+e^{-x}$.",
          "worked": "Substitute $y(0)=3$:\n$$\\begin{align*}3&=2+Ae^0\\\\3&=2+A\\\\A&=1\\\\y&=2+e^{-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
