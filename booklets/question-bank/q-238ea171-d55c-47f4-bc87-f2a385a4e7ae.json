  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x}{5}+\\dfrac{4x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x}{5}$",
          "worked": "$$\\begin{align*}\\frac{2x}{5}+\\frac{4x}{5}&=\\frac{2x+4x}{5}\\\\\\frac{2x}{5}+\\frac{4x}{5}&=\\frac{6x}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3x}{10}+\\dfrac{11x}{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{31x}{30}$",
          "worked": "$$\\begin{align*}\\frac{3x}{10}+\\frac{11x}{15}&=\\frac{9x}{30}+\\frac{22x}{30}\\\\\\frac{3x}{10}+\\frac{11x}{15}&=\\frac{9x+22x}{30}\\\\\\frac{3x}{10}+\\frac{11x}{15}&=\\frac{31x}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3x-1}{3}-\\dfrac{7-2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x-8}{3}$",
          "worked": "$$\\begin{align*}\\frac{3x-1}{3}-\\frac{7-2x}{3}&=\\frac{3x-1-(7-2x)}{3}\\\\\\frac{3x-1}{3}-\\frac{7-2x}{3}&=\\frac{3x-1-7+2x}{3}\\\\\\frac{3x-1}{3}-\\frac{7-2x}{3}&=\\frac{5x-8}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5x+3}{6}-\\dfrac{1-4x}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{32x+9}{24}$",
          "worked": "$$\\begin{align*}\\frac{5x+3}{6}-\\frac{1-4x}{8}&=\\frac{4(5x+3)-3(1-4x)}{24}\\\\\\frac{5x+3}{6}-\\frac{1-4x}{8}&=\\frac{20x+12-3+12x}{24}\\\\\\frac{5x+3}{6}-\\frac{1-4x}{8}&=\\frac{32x+9}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p4-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{5}{4x}+\\dfrac{3}{4x}+\\dfrac{1}{8x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{8x}$",
          "worked": "$$\\begin{align*}\\frac{5}{4x}+\\frac{3}{4x}+\\frac{1}{8x}&=\\frac{10+6+1}{8x}\\\\\\frac{5}{4x}+\\frac{3}{4x}+\\frac{1}{8x}&=\\frac{17}{8x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{5}{4x}-\\dfrac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{4x}$",
          "worked": "$$\\begin{align*}\\frac{5}{4x}-\\frac{2}{x}&=\\frac{5-8}{4x}\\\\\\frac{5}{4x}-\\frac{2}{x}&=-\\frac{3}{4x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p4-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x}{x-1}-\\dfrac{x}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{(x-1)(x+1)}$",
          "worked": "$$\\begin{align*}\\frac{x}{x-1}-\\frac{x}{x+1}&=\\frac{x(x+1)-x(x-1)}{(x-1)(x+1)}\\\\\\frac{x}{x-1}-\\frac{x}{x+1}&=\\frac{x^2+x-x^2+x}{(x-1)(x+1)}\\\\\\frac{x}{x-1}-\\frac{x}{x+1}&=\\frac{2x}{(x-1)(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p4-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{3x+5}{x-2}-\\dfrac{x+7}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(x-1)}{x-2}$",
          "worked": "$$\\begin{align*}\\frac{3x+5}{x-2}-\\frac{x+7}{x-2}&=\\frac{3x+5-(x+7)}{x-2}\\\\\\frac{3x+5}{x-2}-\\frac{x+7}{x-2}&=\\frac{2x-2}{x-2}\\\\\\frac{3x+5}{x-2}-\\frac{x+7}{x-2}&=\\frac{2(x-1)}{x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p4-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{2}{x-2}+\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x-2}{x(x-2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x-2}+\\frac{1}{x}&=\\frac{2x+(x-2)}{x(x-2)}\\\\\\frac{2}{x-2}+\\frac{1}{x}&=\\frac{3x-2}{x(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{3}{4x^2}+\\dfrac{5}{6x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10x+9}{12x^2}$",
          "worked": "$$\\begin{align*}\\frac{3}{4x^2}+\\frac{5}{6x}&=\\frac{9}{12x^2}+\\frac{10x}{12x^2}\\\\\\frac{3}{4x^2}+\\frac{5}{6x}&=\\frac{10x+9}{12x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p4-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{5}{x(x-2)}+\\dfrac{2}{x(x+2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+6}{x(x-2)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{5}{x(x-2)}+\\frac{2}{x(x+2)}&=\\frac{5(x+2)+2(x-2)}{x(x-2)(x+2)}\\\\\\frac{5}{x(x-2)}+\\frac{2}{x(x+2)}&=\\frac{5x+10+2x-4}{x(x-2)(x+2)}\\\\\\frac{5}{x(x-2)}+\\frac{2}{x(x+2)}&=\\frac{7x+6}{x(x-2)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p4-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{3}{x(x-4)}-\\dfrac{2}{x^2-3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2-x+6}{x(x-1)(x-2)(x-4)}$\n\nFactor $x^2-3x+2$ before finding the common denominator.",
          "worked": "$$\\begin{align*}x^2-3x+2&=(x-1)(x-2)\\end{align*}$$\n$$\\begin{align*}\\frac{3}{x(x-4)}-\\frac{2}{x^2-3x+2}&=\\frac{3(x-1)(x-2)-2x(x-4)}{x(x-1)(x-2)(x-4)}\\\\\\frac{3}{x(x-4)}-\\frac{2}{x^2-3x+2}&=\\frac{3x^2-9x+6-2x^2+8x}{x(x-1)(x-2)(x-4)}\\\\\\frac{3}{x(x-4)}-\\frac{2}{x^2-3x+2}&=\\frac{x^2-x+6}{x(x-1)(x-2)(x-4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
