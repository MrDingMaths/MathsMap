    "children": [
      {
        "id": "p5-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify\n$$\\left[\\frac{k(k+1)}2\\right]^2-\\left[\\frac{k(k-1)}2\\right]^2.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k^3$",
          "worked": "$$\\begin{align*}\\left[\\frac{k(k+1)}2\\right]^2-\\left[\\frac{k(k-1)}2\\right]^2&=\\frac{k^2}{4}\\bigl((k+1)^2-(k-1)^2\\bigr)\\\\\\left[\\frac{k(k+1)}2\\right]^2-\\left[\\frac{k(k-1)}2\\right]^2&=\\frac{k^2}{4}(4k)\\\\\\left[\\frac{k(k+1)}2\\right]^2-\\left[\\frac{k(k-1)}2\\right]^2&=k^3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p5-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find a formula for the sum\n$$1^3+2^3+\\cdots+n^3.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\left[\\frac{n(n+1)}2\\right]^2$.\n\nSum part (a); consecutive squared expressions cancel.",
          "worked": "Let $T_k=\\frac{k(k+1)}2$, so $T_0=0$. Part (a) gives $k^3=T_k^2-T_{k-1}^2$.\n$$\\begin{align*}\\sum_{k=1}^n k^3&=\\sum_{k=1}^n(T_k^2-T_{k-1}^2)\\\\\\sum_{k=1}^n k^3&=T_n^2-T_0^2\\\\\\sum_{k=1}^n k^3&=\\left[\\frac{n(n+1)}2\\right]^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
