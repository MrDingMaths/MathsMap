        "id": "p9-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{x}+\\frac{5}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{2x}$",
          "worked": "$$\\begin{align*}\\frac{3}{x}+\\frac{5}{2x}&=\\frac{6}{2x}+\\frac{5}{2x}\\\\&=\\frac{11}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{7}{3x}-\\frac{2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3x}$",
          "worked": "$$\\begin{align*}\\frac{7}{3x}-\\frac{2}{x}&=\\frac{7}{3x}-\\frac{6}{3x}\\\\&=\\frac{1}{3x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{7}{4x}-\\frac{5}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{4x}$",
          "worked": "$$\\begin{align*}\\frac{7}{4x}-\\frac{5}{2x}&=\\frac{7}{4x}-\\frac{10}{4x}\\\\&=-\\frac{3}{4x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{4}{3x}+\\frac{2}{9x}$",
