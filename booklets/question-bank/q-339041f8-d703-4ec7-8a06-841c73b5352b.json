          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{4x}-\\frac{2}{5x}$",
