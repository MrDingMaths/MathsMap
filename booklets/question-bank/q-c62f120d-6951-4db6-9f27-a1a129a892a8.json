  "content": {
    "id": "p53-q66-root",
    "type": "question",
    "label": "21",
    "prompt": "Let $A$ and $B$ be two subsets of a universal set $U$.\n\nShow that the following are equal to the universal set.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q66-a",
        "type": "part",
        "label": "a",
        "prompt": "$(A\\cup B)\\cup(\\overline A\\cap\\overline B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$U$.\n\nBy De Morgan’s law, this is a set united with its complement.",
          "worked": "By De Morgan’s law,\n$$\\begin{align*}(A\\cup B)\\cup(\\overline A\\cap\\overline B)&=(A\\cup B)\\cup\\overline{A\\cup B}\\\\(A\\cup B)\\cup(\\overline A\\cap\\overline B)&=U.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p53-q66-b",
        "type": "part",
        "label": "b",
        "prompt": "$(A\\cup\\varnothing)\\cup(U\\cap\\overline A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$U$.\n\nThe expression simplifies to $A\\cup\\overline A$.",
          "worked": "$A\\cup\\varnothing=A$ and $U\\cap\\overline A=\\overline A$, so\n$$\\begin{align*}(A\\cup\\varnothing)\\cup(U\\cap\\overline A)&=A\\cup\\overline A\\\\(A\\cup\\varnothing)\\cup(U\\cap\\overline A)&=U.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
