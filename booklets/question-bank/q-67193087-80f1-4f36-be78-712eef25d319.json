  "content": {
    "id": "p21-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Let $a=2+\\sqrt{3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the exact value of $a+\\frac{1}{a}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{1}{a}&=\\frac{1}{2+\\sqrt{3}}\\\\\\frac{1}{2+\\sqrt{3}}&=\\frac{2-\\sqrt{3}}{(2+\\sqrt{3})(2-\\sqrt{3})}\\\\\\frac{2-\\sqrt{3}}{(2+\\sqrt{3})(2-\\sqrt{3})}&=\\frac{2-\\sqrt{3}}{4-3}\\\\\\frac{2-\\sqrt{3}}{4-3}&=2-\\sqrt{3}\\\\a+\\frac{1}{a}&=(2+\\sqrt{3})+(2-\\sqrt{3})\\\\(2+\\sqrt{3})+(2-\\sqrt{3})&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p21-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, without calculating $a^2$, find the exact value of $a^2+\\frac{1}{a^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$\n\nSquare the sum from (a) and subtract the cross term $2$.",
          "worked": "$$\\begin{align*}\\left(a+\\frac{1}{a}\\right)^2&=a^2+2a\\cdot\\frac{1}{a}+\\frac{1}{a^2}\\\\a^2+2a\\cdot\\frac{1}{a}+\\frac{1}{a^2}&=a^2+2+\\frac{1}{a^2}\\\\a^2+\\frac{1}{a^2}&=\\left(a+\\frac{1}{a}\\right)^2-2\\\\\\left(a+\\frac{1}{a}\\right)^2-2&=4^2-2\\\\4^2-2&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
