      {
        "id": "p22-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the product rule to show that if $y=x^2(x-4)^2$, then $\\dfrac{dy}{dx}=4x(x-4)(x-2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=4x(x-4)(x-2)$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x(x-4)^2+x^2\\cdot2(x-4)\\\\\\frac{dy}{dx}&=2x(x-4)\\bigl[(x-4)+x\\bigr]\\\\\\frac{dy}{dx}&=2x(x-4)(2x-4)\\\\\\frac{dy}{dx}&=4x(x-4)(x-2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p22-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Find any stationary points and use a table of gradients to classify them.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Local minima at $(0,0)$ and $(4,0)$; local maximum at $(2,16)$.",
