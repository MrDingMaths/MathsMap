  "content": {
    "id": "p13-q10",
    "type": "question",
    "label": "10",
    "prompt": "A plane is flying at a speed of 640 km/h. How far will it travel between 10:30 a.m. and 11:15 a.m. the same day?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$480\\text{ km}$",
      "worked": "The elapsed time from 10:30 a.m. to 11:15 a.m. is 45 minutes.\n\n$$\\begin{align*}\\text{Time}&=\\frac{45}{60}\\text{ h}\\\\\\text{Time}&=\\frac34\\text{ h}\\\\\\text{Distance}&=640\\times\\frac34\\\\\\text{Distance}&=480\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
