      {
        "id": "p39-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\displaystyle\\int\\left(6\\cos 3x-4\\sin\\left(\\frac{x}{2}\\right)\\right)\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sin 3x+8\\cos\\left(\\frac{x}{2}\\right)+C$",
          "worked": "$$\\begin{aligned}\\int\\left(6\\cos 3x-4\\sin\\left(\\frac{x}{2}\\right)\\right)\\,dx&=\\frac{6}{3}\\sin 3x-4\\left(-\\frac{1}{1/2}\\cos\\left(\\frac{x}{2}\\right)\\right)+C\\\\&=2\\sin 3x+8\\cos\\left(\\frac{x}{2}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\displaystyle\\int\\left(8\\sec^2 2x-10\\cos\\left(\\frac{x}{4}\\right)-36\\sin\\left(\\frac{x}{3}\\right)\\right)\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\tan(2x)+108\\cos\\left(\\frac{x}{3}\\right)-40\\sin\\left(\\frac{x}{4}\\right)+C$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\int\\left(8\\sec^2 2x-10\\cos\\left(\\frac{x}{4}\\right)-36\\sin\\left(\\frac{x}{3}\\right)\\right)\\,dx\\\\&=\\frac{8}{2}\\tan 2x-\\frac{10}{1/4}\\sin\\left(\\frac{x}{4}\\right)+\\frac{36}{1/3}\\cos\\left(\\frac{x}{3}\\right)+C\\\\&=4\\tan 2x-40\\sin\\left(\\frac{x}{4}\\right)+108\\cos\\left(\\frac{x}{3}\\right)+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
