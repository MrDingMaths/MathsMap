    "type": "question",
    "label": "15",
    "prompt": "True or False? Let $A$ and $B$ be sets in a universal set $U$.\n\n$A\\cap(A\\cup B)=A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "True.",
      "worked": "True. The union $A\\cup B$ contains every element of $A$. Intersecting it with $A$ therefore leaves exactly $A$.",
