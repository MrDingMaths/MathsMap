  "content": {
    "id": "p19-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Evaluate the following, and write each result using scientific notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$2.3\\times10^4+4.6\\times10^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.9\\times10^4$",
          "worked": "$$\\begin{align*}2.3\\times10^4+4.6\\times10^4&=(2.3+4.6)\\times10^4\\\\2.3\\times10^4+4.6\\times10^4&=6.9\\times10^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$8.4\\times10^3-3.7\\times10^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.7\\times10^3$",
          "worked": "$$\\begin{align*}8.4\\times10^3-3.7\\times10^3&=(8.4-3.7)\\times10^3\\\\8.4\\times10^3-3.7\\times10^3&=4.7\\times10^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$5.6\\times10^6+5\\times10^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.06\\times10^7$",
          "worked": "$$\\begin{align*}5.6\\times10^6+5\\times10^6&=(5.6+5)\\times10^6\\\\5.6\\times10^6+5\\times10^6&=10.6\\times10^6\\\\5.6\\times10^6+5\\times10^6&=1.06\\times10^7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$9\\times10^5+1.1\\times10^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.11\\times10^5$",
          "worked": "$$\\begin{align*}9\\times10^5+1.1\\times10^4&=9\\times10^5+0.11\\times10^5\\\\9\\times10^5+1.1\\times10^4&=(9+0.11)\\times10^5\\\\9\\times10^5+1.1\\times10^4&=9.11\\times10^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$6\\times10^5-9\\times10^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8.4\\times10^6$",
          "worked": "$$\\begin{align*}6\\times10^5-9\\times10^6&=0.6\\times10^6-9\\times10^6\\\\6\\times10^5-9\\times10^6&=(0.6-9)\\times10^6\\\\6\\times10^5-9\\times10^6&=-8.4\\times10^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\times10^{15}-9.1\\times10^{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8.9\\times10^{16}$",
          "worked": "$$\\begin{align*}2\\times10^{15}-9.1\\times10^{16}&=0.2\\times10^{16}-9.1\\times10^{16}\\\\2\\times10^{15}-9.1\\times10^{16}&=(0.2-9.1)\\times10^{16}\\\\2\\times10^{15}-9.1\\times10^{16}&=-8.9\\times10^{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
