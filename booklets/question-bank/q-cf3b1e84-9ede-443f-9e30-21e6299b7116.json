  "content": {
    "id": "p18-practice-q2-root",
    "type": "question",
    "label": "",
    "prompt": "How many terms of the series $4+7+10+\\cdots$ are needed to give a sum of 531?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "18 terms.",
      "worked": "$a=4$, $d=3$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2a+(n-1)d]\\\\531&=\\frac{n}{2}[2(4)+(n-1)3]\\\\1062&=n(3n+5)\\\\3n^2+5n-1062&=0\\\\(n-18)(3n+59)&=0\\\\n&=18\\text{ or }-\\frac{59}{3}\\end{align*}$$\nSince $n$ is a positive integer, 18 terms are needed.",
      "solutionDiagrams": []
    },
