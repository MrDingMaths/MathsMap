  "content": {
    "id": "p33-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Let $f(x)=x+\\frac{1}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f\\left(\\frac{1}{a}\\right)=f(a)$, for $a\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f\\left(\\frac{1}{a}\\right)=\\frac{1}{a}+a=f(a)$, for $a\\ne0$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q12-a-domain",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a\\ne0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ",",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p33-q12-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}f\\left(\\frac{1}{a}\\right)&=\\frac{1}{a}+\\frac{1}{\\left(\\frac{1}{a}\\right)}\\\\f\\left(\\frac{1}{a}\\right)&=\\frac{1}{a}+a\\\\f\\left(\\frac{1}{a}\\right)&=f(a).\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence explain why $f(x)$ does not have an inverse function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(2)=f\\left(\\frac12\\right)=\\frac52$. The distinct inputs $2$ and $\\frac12$ give the same output, so $f$ is not one-to-one and has no inverse function.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q12-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Taking ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a=2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in part a gives ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f(2)=f\\left(\\frac12\\right)=\\frac52",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". These are distinct inputs with the same output. Therefore ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " is not one-to-one, so it does not have an inverse function.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
