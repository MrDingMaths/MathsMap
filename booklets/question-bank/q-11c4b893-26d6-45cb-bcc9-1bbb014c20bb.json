  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A father distributes $\\$100$ to his three children according to the following instructions: The middle child receives $\\$12$ less than the oldest and the youngest receives three times as much as the middle child. How much does the middle child receive?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$17.60$",
      "worked": "Let the middle child receive $x$ dollars. The oldest receives $(x+12)$ dollars and the youngest receives $3x$ dollars.\n$$\\begin{align*}x+(x+12)+3x&=100\\\\5x+12&=100\\\\5x&=88\\\\x&=17.6\\end{align*}$$\nThe middle child receives $\\$17.60$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
