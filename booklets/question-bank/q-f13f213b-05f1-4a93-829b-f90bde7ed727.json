        "answer": {
          "short": "$\\frac{29}{8}$",
          "worked": "$\\begin{aligned}P\\left(\\frac12\\right)&=\\left(\\frac12\\right)^3+2\\left(\\frac12\\right)^2-4\\left(\\frac12\\right)+5\\\\&=\\frac18+\\frac12-2+5\\\\&=\\frac{29}{8}\\end{aligned}$\nThe remainder is $\\frac{29}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p50-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{97}{8}$",
          "worked": "$\\begin{aligned}P\\left(-\\frac32\\right)&=\\left(-\\frac32\\right)^3+2\\left(-\\frac32\\right)^2-4\\left(-\\frac32\\right)+5\\\\&=-\\frac{27}{8}+\\frac92+6+5\\\\&=\\frac{97}{8}\\end{aligned}$\nThe remainder is $\\frac{97}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p50-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{95}{27}$",
          "worked": "$\\begin{aligned}P\\left(\\frac23\\right)&=\\left(\\frac23\\right)^3+2\\left(\\frac23\\right)^2-4\\left(\\frac23\\right)+5\\\\&=\\frac8{27}+\\frac89-\\frac83+5\\\\&=\\frac{95}{27}\\end{aligned}$\nThe remainder is $\\frac{95}{27}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
