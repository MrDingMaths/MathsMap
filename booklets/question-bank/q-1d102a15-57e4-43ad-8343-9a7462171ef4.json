        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5$",
          "worked": "$$\\begin{align*}\\frac{c}{10} &= \\frac{5}{10}\\\\\\frac{c}{10} &= 0.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p30-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{10}{c}$",
