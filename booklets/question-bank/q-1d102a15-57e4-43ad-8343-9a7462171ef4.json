    "label": "4",
    "prompt": "Substitute $c = 5$ to evaluate each expression.",
    "layout": "grid",
    "columns": 5,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$c + 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}c+10 &= (5)+10\\\\c+10 &= 15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$10 + c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}10+c &= 10+(5)\\\\10+c &= 15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$10c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50$",
          "worked": "$$\\begin{align*}10c &= 10(5)\\\\10c &= 50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{c}{10}$",
