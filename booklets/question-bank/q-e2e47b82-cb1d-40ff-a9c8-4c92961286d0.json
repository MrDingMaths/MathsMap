        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{5-5x^2}{(x^2+1)^2}$",
          "worked": "$u=5x$, $u'=5$, $v=x^2+1$, $v'=2x$.\n$$\\begin{align*}y'&=\\frac{u'v-uv'}{v^2}\\\\&=\\frac{5(x^2+1)-(5x)(2x)}{(x^2+1)^2}\\\\&=\\frac{5x^2+5-10x^2}{(x^2+1)^2}\\\\&=\\frac{5-5x^2}{(x^2+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
