        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{10+\\sqrt{50}}{5}&=\\frac{10+5\\sqrt{2}}{5}\\\\&=2+\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-6a4c2-p37-practice-slot-6-slot-6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{20-\\sqrt{80}}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5-\\sqrt{5}}{2}$",
          "worked": "$$\\begin{align*}\\frac{20-\\sqrt{80}}{8}&=\\frac{20-4\\sqrt{5}}{8}\\\\&=\\frac{5-\\sqrt{5}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-6a4c2-p37-practice-slot-6-slot-6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sqrt{12}+\\sqrt{27}}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{12}+\\sqrt{27}}{5}&=\\frac{2\\sqrt{3}+3\\sqrt{3}}{5}\\\\&=\\frac{5\\sqrt{3}}{5}\\\\&=\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-6a4c2-p37-practice-slot-6-slot-6-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt{18}\\times\\sqrt{6}+12}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{18}\\times\\sqrt{6}+12}{6}&=\\frac{\\sqrt{108}+12}{6}\\\\&=\\frac{6\\sqrt{3}+12}{6}\\\\&=\\sqrt{3}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-6a4c2-p37-practice-slot-6-slot-6-q-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{4\\sqrt{3}\\times\\sqrt{6}+6\\sqrt{8}}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{4\\sqrt{3}\\times\\sqrt{6}+6\\sqrt{8}}{8}&=\\frac{4\\sqrt{18}+6\\sqrt{8}}{8}\\\\&=\\frac{12\\sqrt{2}+12\\sqrt{2}}{8}\\\\&=\\frac{24\\sqrt{2}}{8}\\\\&=3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
