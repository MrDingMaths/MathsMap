    "children": [
      {
        "id": "p37-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of the team having a win and a draw, in any order?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.28$",
          "worked": "$$\\begin{align*}P(WD)&=0.7\\times0.2=0.14\\\\P(DW)&=0.2\\times0.7=0.14\\\\P(\\text{a win and a draw})&=P(WD)+P(DW)\\\\&=0.14+0.14\\\\&=0.28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p37-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Paul claims that 1.4 is the probability of the team winning both matches.\nGive one reason why this is NOT correct.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A probability cannot be greater than 1. Alternatively, Paul added instead of multiplying along the branches.",
          "worked": "A probability cannot be greater than 1. Paul added the branch probabilities; winning both matches requires multiplication:\n$$\\begin{align*}P(WW)&=0.7\\times0.7\\\\&=0.49.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
    "diagramPlacement": "beside-prompt"
