  "content": {
    "id": "p15-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "There are $123456$ balls in a (very large) bag. Determine if these balls can be divided in the following ratios:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$1:2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=1+2=3\\\\\\text{Balls per part}&=123456\\div3=41152\\\\\\text{Shares}&=41152\\text{ and }82304\\end{align*}$$\nYes: both shares contain whole numbers of balls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p15-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$1:3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=1+3=4\\\\\\text{Balls per part}&=123456\\div4=30864\\\\\\text{Shares}&=30864\\text{ and }92592\\end{align*}$$\nYes: both shares contain whole numbers of balls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p15-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$2:3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=2+3=5\\\\123456&=5\\times24691+1\\end{align*}$$\nNo: the total is not divisible by $5$, so the shares cannot both contain whole numbers of balls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p15-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$2:7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=2+7=9\\\\123456&=9\\times13717+3\\end{align*}$$\nNo: the total is not divisible by $9$, so the shares cannot both contain whole numbers of balls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p15-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$3:4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=3+4=7\\\\123456&=7\\times17636+4\\end{align*}$$\nNo: the total is not divisible by $7$, so the shares cannot both contain whole numbers of balls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p15-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$3:5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}\\text{Total parts}&=3+5=8\\\\\\text{Balls per part}&=123456\\div8=15432\\\\\\text{Shares}&=46296\\text{ and }77160\\end{align*}$$\nYes: both shares contain whole numbers of balls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
