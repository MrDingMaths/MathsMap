  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Giorgia has 5 red ribbons, 3 blue ribbons and 6 green ribbons in a drawer. Giorgia randomly takes one ribbon out and then a second (no replacement). What is the probability that she obtains:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "2 red ribbons?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{91}$",
          "worked": "There are $14$ ribbons initially and $13$ after the first draw.\n$$\\begin{align*}P(\\text{two red})&=\\frac{5}{14}\\times\\frac{4}{13}\\\\P(\\text{two red})&=\\frac{10}{91}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "a red and a blue ribbon?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15}{91}$",
          "worked": "Include red then blue and blue then red.\n$$\\begin{align*}P(\\text{one red, one blue})&=\\frac{5}{14}\\times\\frac{3}{13}+\\frac{3}{14}\\times\\frac{5}{13}\\\\P(\\text{one red, one blue})&=\\frac{30}{182}\\\\P(\\text{one red, one blue})&=\\frac{15}{91}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "a green and a red ribbon?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{30}{91}$",
          "worked": "Include green then red and red then green.\n$$\\begin{align*}P(\\text{one green, one red})&=\\frac{6}{14}\\times\\frac{5}{13}+\\frac{5}{14}\\times\\frac{6}{13}\\\\P(\\text{one green, one red})&=\\frac{60}{182}\\\\P(\\text{one green, one red})&=\\frac{30}{91}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "2 blue ribbons?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{91}$",
          "worked": "$$\\begin{align*}P(\\text{two blue})&=\\frac{3}{14}\\times\\frac{2}{13}\\\\P(\\text{two blue})&=\\frac{3}{91}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
