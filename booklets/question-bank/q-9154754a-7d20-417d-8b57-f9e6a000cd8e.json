  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Each of 100 guests at a party shakes hands with every other guest. How many handshakes take place?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "4950 handshakes.",
      "worked": "Count each handshake once: successive guests shake hands with $99,98,\\ldots,1$ guests whose handshakes have not yet been counted.\n\n$$\\begin{align*}S_{99}&=\\frac{99}{2}(1+99)\\\\S_{99}&=\\frac{99\\times100}{2}\\\\S_{99}&=4950.\\end{align*}$$\n\nThere are 4950 handshakes.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
