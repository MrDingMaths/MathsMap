  "content": {
    "id": "p16-review-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given that $m\\propto\\sqrt{n}$, what is the effect on:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-review-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$m$ when $n$ is doubled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m$ is multiplied by $\\sqrt{2}$.",
          "worked": "Since $m=k\\sqrt{n}$, doubling $n$ gives\n$$\\begin{align*}m_{\\text{new}}&=k\\sqrt{2n}\\\\m_{\\text{new}}&=\\sqrt{2}\\,k\\sqrt{n}\\\\m_{\\text{new}}&=\\sqrt{2}\\,m.\\end{align*}$$\nThus, $m$ is multiplied by $\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-review-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$m$ when $n$ is divided by $4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m$ is halved.",
          "worked": "Since $m=k\\sqrt{n}$, dividing $n$ by $4$ gives\n$$\\begin{align*}m_{\\text{new}}&=k\\sqrt{\\frac{n}{4}}\\\\m_{\\text{new}}&=\\frac{k\\sqrt{n}}{2}\\\\m_{\\text{new}}&=\\frac{m}{2}.\\end{align*}$$\nThus, $m$ is halved.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
