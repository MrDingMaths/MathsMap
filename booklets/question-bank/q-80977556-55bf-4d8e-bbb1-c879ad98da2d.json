  "content": {
    "id": "p41-q4-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the function $h(x)=3x-5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $h(h(0))$, $h(h(5))$, $h(h(-1))$ and $h(h(-5))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h(h(0))=-20$, $h(h(5))=25$, $h(h(-1))=-29$, $h(h(-5))=-65$.",
          "worked": "$$\\begin{align*}h(h(0))&=h(-5)=3(-5)-5\\\\h(h(0))&=-20\\\\h(h(5))&=h(10)=3(10)-5\\\\h(h(5))&=25\\\\h(h(-1))&=h(-8)=3(-8)-5\\\\h(h(-1))&=-29\\\\h(h(-5))&=h(-20)=3(-20)-5\\\\h(h(-5))&=-65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p41-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find expressions for $h(h(x))$ and for $h(h(h(x)))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h(h(x))=9x-20$, $h(h(h(x)))=27x-65$.",
          "worked": "$$\\begin{align*}h(h(x))&=3(3x-5)-5\\\\h(h(x))&=9x-15-5\\\\h(h(x))&=9x-20\\\\h(h(h(x)))&=3(9x-20)-5\\\\h(h(h(x)))&=27x-60-5\\\\h(h(h(x)))&=27x-65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
