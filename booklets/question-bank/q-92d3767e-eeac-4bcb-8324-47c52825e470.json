  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A monic quadratic function crosses the $x$-axis when $x=2$ and $x=3$. What is the equation of the function?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(x)=x^2-5x+6$.",
      "worked": "The zeros give factors $x-2$ and $x-3$. Since the quadratic is monic, its leading coefficient is $1$.\n$$\\begin{align*}f(x)&=(x-2)(x-3)\\\\f(x)&=x^2-3x-2x+6\\\\f(x)&=x^2-5x+6\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
