  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A rectangular room has a length that is 1 metre less than twice the width. If the perimeter of the room is 22 metres, then find its area.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$28\\text{ m}^2$.",
      "worked": "Let the width be $x$ metres. The length is $2x-1$ metres.\n$$\\begin{align*}2x+2(2x-1)&=22\\\\2x+4x-2&=22\\\\6x-2&=22\\\\6x&=24\\\\x&=4\\end{align*}$$\nThe length is $2(4)-1=7$ metres.\n$$\\begin{align*}A&=lw\\\\A&=7\\times4\\\\A&=28\\text{ m}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 84
  },
