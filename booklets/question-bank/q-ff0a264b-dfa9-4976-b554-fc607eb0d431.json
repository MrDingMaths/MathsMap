  "content": {
    "id": "p41-p-content",
    "type": "question",
    "label": "p",
    "prompt": "Samantha went shopping and bought a new bike for \\$750. How much GST did she pay? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$68.18",
      "worked": "The purchase price includes GST, so \\$750 represents 110% of the pre-GST price.\n$$\\begin{align*}110\\% &= \\$750\\\\10\\% &= \\frac{\\$750}{11}\\\\&\\approx \\$68.18\\end{align*}$$\nShe paid \\$68.18 in GST.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
  },
