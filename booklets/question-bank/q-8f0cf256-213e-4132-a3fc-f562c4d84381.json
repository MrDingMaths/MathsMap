  "content": {
    "id": "p5-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "On a spinning wheel, the numbers go from 0 to 36. Each number is equally likely. The wheel is spun. What is the probability that when it stops the resulting number will be:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{37}$",
          "worked": "There are 37 equally likely outcomes. The even outcomes are $0,2,4,\\ldots,36$, giving 19 favourable outcomes. Zero is even.\n\n$$P(\\text{even number})=\\frac{19}{37}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "an odd number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18}{37}$",
          "worked": "The odd outcomes are $1,3,5,\\ldots,35$, giving 18 favourable outcomes out of 37 equally likely outcomes.\n\n$$P(\\text{odd number})=\\frac{18}{37}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "a number less than 15, excluding 0?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14}{37}$",
          "worked": "The favourable outcomes are $1,2,3,\\ldots,14$, giving 14 favourable outcomes out of 37 equally likely outcomes.\n\n$$P(\\text{number less than 15, excluding 0})=\\frac{14}{37}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
