    "type": "question",
    "label": "14",
    "prompt": "Sometimes customers pay a deposit on an item and then later pay the rest of the full price. Find the full price when a deposit of $\\$570$ is $30\\%$ of the full price.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$1900$",
      "worked": "$$\\begin{align*}\\text{Full price}&=\\text{deposit}\\div30\\%\\\\\\text{Full price}&=570\\div0.30\\\\\\text{Full price}&=\\$1900\\end{align*}$$",
