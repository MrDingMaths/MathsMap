  "content": {
    "id": "p41-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the volume and surface area of a hemisphere of radius $2\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$V=\\dfrac{16\\pi}{3}\\text{ cm}^3$, $A=12\\pi\\text{ cm}^2$.",
      "worked": "$$\\begin{align*}V&=\\frac{1}{2}\\times\\frac{4}{3}\\pi r^3\\\\V&=\\frac{2}{3}\\pi(2)^3\\\\V&=\\frac{16\\pi}{3}\\text{ cm}^3\\end{align*}$$\nInclude the flat circular face as well as the curved surface.\n$$\\begin{align*}A&=2\\pi r^2+\\pi r^2\\\\A&=3\\pi(2)^2\\\\A&=12\\pi\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
