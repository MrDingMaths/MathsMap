  "content": {
    "id": "p33-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the exact values of the $x$-intercepts by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+4x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2-\\sqrt6,\\ -2+\\sqrt6$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}x^2+4x-2&=0\\\\x^2+4x+4&=6\\\\(x+2)^2&=6\\\\x+2&=\\pm\\sqrt6\\\\x&=-2\\pm\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3-2\\sqrt2,\\ 3+2\\sqrt2$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}x^2-6x+1&=0\\\\x^2-6x+9&=8\\\\(x-3)^2&=8\\\\x-3&=\\pm2\\sqrt2\\\\x&=3\\pm2\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2x^2+10x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac52-\\dfrac{\\sqrt{19}}2,\\ -\\dfrac52+\\dfrac{\\sqrt{19}}2$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}2x^2+10x+3&=0\\\\2\\left(x^2+5x+\\frac32\\right)&=0\\\\x^2+5x&=-\\frac32\\\\x^2+5x+\\frac{25}{4}&=\\frac{19}{4}\\\\\\left(x+\\frac52\\right)^2&=\\frac{19}{4}\\\\x+\\frac52&=\\pm\\frac{\\sqrt{19}}2\\\\x&=-\\frac52\\pm\\frac{\\sqrt{19}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p33-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-2x^2-8x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2-\\dfrac{\\sqrt{26}}2,\\ -2+\\dfrac{\\sqrt{26}}2$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}-2x^2-8x+5&=0\\\\-2\\left(x^2+4x-\\frac52\\right)&=0\\\\x^2+4x&=\\frac52\\\\x^2+4x+4&=\\frac{13}{2}\\\\(x+2)^2&=\\frac{13}{2}\\\\x+2&=\\pm\\frac{\\sqrt{26}}2\\\\x&=-2\\pm\\frac{\\sqrt{26}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
