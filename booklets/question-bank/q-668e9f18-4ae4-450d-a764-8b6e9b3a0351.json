    "children": [
      {
        "id": "p22-q52-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{(x+1)^2}{x}=x+2+\\dfrac1x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(x+1)^2}{x}=x+2+\\dfrac1x$ for $x\\ne0$. Expand the numerator, then split it.",
          "worked": "$$\\begin{align*}\\dfrac{(x+1)^2}{x}&=\\dfrac{x^2+2x+1}{x}\\\\\\dfrac{(x+1)^2}{x}&=\\dfrac{x^2}{x}+\\dfrac{2x}{x}+\\dfrac1x\\\\\\dfrac{(x+1)^2}{x}&=x+2+\\dfrac1x\\qquad(x\\ne0).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q52-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, differentiate $\\dfrac{(x+1)^2}{x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\dfrac1{x^2}$ for $x\\ne0$.",
          "worked": "$$\\begin{align*}\\dfrac{d}{dx}\\left(\\dfrac{(x+1)^2}{x}\\right)&=\\dfrac{d}{dx}\\left(x+2+x^{-1}\\right)\\\\\\dfrac{d}{dx}\\left(\\dfrac{(x+1)^2}{x}\\right)&=1-x^{-2}\\\\\\dfrac{d}{dx}\\left(\\dfrac{(x+1)^2}{x}\\right)&=1-\\dfrac1{x^2}\\qquad(x\\ne0).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
