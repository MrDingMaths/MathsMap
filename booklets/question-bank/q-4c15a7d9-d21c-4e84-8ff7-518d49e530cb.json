  "content": {
    "id": "p35-q23-response",
    "type": "question",
    "label": "24",
    "prompt": "Evaluate $\\frac{20}{x}+3y$ when $x=\\frac{1}{5}$, $y=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$106$",
      "worked": "$$\\begin{align*}\\dfrac{20}{x}+3y &= \\dfrac{20}{\\dfrac{1}{5}}+3(2)\\\\\\dfrac{20}{x}+3y &= 100+6\\\\\\dfrac{20}{x}+3y &= 106\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
  },
