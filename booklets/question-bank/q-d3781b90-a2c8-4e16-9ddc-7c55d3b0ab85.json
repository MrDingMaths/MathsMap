    "children": [
      {
        "id": "p18-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1-\\sqrt5}{2}$ or $x=\\frac{-1+\\sqrt5}{2}$.",
          "worked": "$$\\begin{align*}x^2+x+\\frac14-\\frac14-1&=0\\\\x^2+x+\\frac14&=\\frac54\\\\\\left(x+\\frac12\\right)^2&=\\frac54\\\\x+\\frac12&=\\pm\\frac{\\sqrt5}{2}\\\\x&=\\frac{-1\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-3x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3-\\sqrt5}{2}$ or $x=\\frac{3+\\sqrt5}{2}$.",
          "worked": "$$\\begin{align*}x^2-3x+\\frac94-\\frac94+1&=0\\\\x^2-3x+\\frac94&=\\frac54\\\\\\left(x-\\frac32\\right)^2&=\\frac54\\\\x-\\frac32&=\\pm\\frac{\\sqrt5}{2}\\\\x&=\\frac{3\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-5x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5-\\sqrt{29}}{2}$ or $x=\\frac{5+\\sqrt{29}}{2}$.",
          "worked": "$$\\begin{align*}x^2-5x+\\frac{25}{4}-\\frac{25}{4}-1&=0\\\\x^2-5x+\\frac{25}{4}&=\\frac{29}{4}\\\\\\left(x-\\frac52\\right)^2&=\\frac{29}{4}\\\\x-\\frac52&=\\pm\\frac{\\sqrt{29}}2\\\\x&=\\frac{5\\pm\\sqrt{29}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-3-\\sqrt{17}}{2}$ or $x=\\frac{-3+\\sqrt{17}}{2}$.",
          "worked": "$$\\begin{align*}x^2+3x+\\frac94-\\frac94-2&=0\\\\x^2+3x+\\frac94&=\\frac{17}{4}\\\\\\left(x+\\frac32\\right)^2&=\\frac{17}{4}\\\\x+\\frac32&=\\pm\\frac{\\sqrt{17}}2\\\\x&=\\frac{-3\\pm\\sqrt{17}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2+5x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-5-\\sqrt{21}}{2}$ or $x=\\frac{-5+\\sqrt{21}}{2}$.",
          "worked": "$$\\begin{align*}x^2+5x+\\frac{25}{4}-\\frac{25}{4}+1&=0\\\\x^2+5x+\\frac{25}{4}&=\\frac{21}{4}\\\\\\left(x+\\frac52\\right)^2&=\\frac{21}{4}\\\\x+\\frac52&=\\pm\\frac{\\sqrt{21}}2\\\\x&=\\frac{-5\\pm\\sqrt{21}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2-6x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3-\\sqrt7$ or $x=3+\\sqrt7$.",
          "worked": "$$\\begin{align*}x^2-6x+9-9+2&=0\\\\(x-3)^2-7&=0\\\\(x-3)^2&=7\\\\x-3&=\\pm\\sqrt7\\\\x&=3\\pm\\sqrt7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2+10x+23=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5-\\sqrt2$ or $x=-5+\\sqrt2$.",
          "worked": "$$\\begin{align*}x^2+10x+25-25+23&=0\\\\(x+5)^2-2&=0\\\\(x+5)^2&=2\\\\x+5&=\\pm\\sqrt2\\\\x&=-5\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p18-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2+9x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-9-\\sqrt{65}}{2}$ or $x=\\frac{-9+\\sqrt{65}}{2}$.",
          "worked": "$$\\begin{align*}x^2+9x+\\frac{81}{4}-\\frac{81}{4}+4&=0\\\\x^2+9x+\\frac{81}{4}&=\\frac{65}{4}\\\\\\left(x+\\frac92\\right)^2&=\\frac{65}{4}\\\\x+\\frac92&=\\pm\\frac{\\sqrt{65}}2\\\\x&=\\frac{-9\\pm\\sqrt{65}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$x^2+3x-11=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-3-\\sqrt{53}}{2}$ or $x=\\frac{-3+\\sqrt{53}}{2}$.",
          "worked": "$$\\begin{align*}x^2+3x+\\frac94-\\frac94-11&=0\\\\x^2+3x+\\frac94&=\\frac{53}{4}\\\\\\left(x+\\frac32\\right)^2&=\\frac{53}{4}\\\\x+\\frac32&=\\pm\\frac{\\sqrt{53}}2\\\\x&=\\frac{-3\\pm\\sqrt{53}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
