      {
        "id": "p18-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$x^2+11x+10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-10$ or $x=-1$.",
          "worked": "$$\\begin{align*}x^2+11x+\\frac{121}{4}-\\frac{121}{4}+10&=0\\\\x^2+11x+\\frac{121}{4}&=\\frac{81}{4}\\\\\\left(x+\\frac{11}{2}\\right)^2&=\\frac{81}{4}\\\\x+\\frac{11}{2}&=\\pm\\frac92\\\\x&=-\\frac{11}{2}\\pm\\frac92\\\\x&=-10\\text{ or }x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p18-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^2+7x+10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-5$ or $x=-2$.",
          "worked": "$$\\begin{align*}x^2+7x+\\frac{49}{4}-\\frac{49}{4}+10&=0\\\\x^2+7x+\\frac{49}{4}&=\\frac94\\\\\\left(x+\\frac72\\right)^2&=\\frac94\\\\x+\\frac72&=\\pm\\frac32\\\\x&=-\\frac72\\pm\\frac32\\\\x&=-5\\text{ or }x=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
