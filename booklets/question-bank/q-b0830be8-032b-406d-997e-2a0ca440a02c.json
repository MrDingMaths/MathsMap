  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Find the units digit of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$12\\,345+54\\,321$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}12\\,345+54\\,321&\\equiv5+1\\pmod{10}\\\\12\\,345+54\\,321&\\equiv6\\pmod{10}\\end{align*}$$\nThe units digit is $6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$1234\\times5678$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}1234\\times5678&\\equiv4\\times8\\pmod{10}\\\\1234\\times5678&\\equiv32\\pmod{10}\\\\1234\\times5678&\\equiv2\\pmod{10}\\end{align*}$$\nThe units digit is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$12\\times34\\times56\\times78$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}12\\times34\\times56\\times78&\\equiv2\\times4\\times6\\times8\\pmod{10}\\\\12\\times34\\times56\\times78&\\equiv384\\pmod{10}\\\\12\\times34\\times56\\times78&\\equiv4\\pmod{10}\\end{align*}$$\nThe units digit is $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p7-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$9\\times8\\times7\\times6\\times5\\times4\\times3\\times2\\times1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "The product contains the factors $5$ and $2$, whose product is $10$. Hence the whole product is a multiple of $10$, so its units digit is $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
