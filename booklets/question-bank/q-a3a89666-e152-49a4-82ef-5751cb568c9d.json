  "content": {
    "id": "p15-q7",
    "type": "question",
    "label": "7",
    "prompt": "The diagram shows line $k$ and line $l$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p15-q7-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"lineK\",\"hex\":\"EF6068\",\"reason\":\"distinguishes line k from line l\"},{\"name\":\"lineL\",\"hex\":\"268CFF\",\"reason\":\"distinguishes line l from line k\"}],\"reference\":\"source page 15 p15-q7-diagram\"}\n\\begin{tikzpicture}[x=0.48cm,y=0.25cm,>=Stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{lineK}{HTML}{EF6068}\n\\definecolor{lineL}{HTML}{268CFF}\n\\draw[<->,black,line width=0.5pt] (-4,0)--(7.4,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-6.5)--(0,6.7) node[above] {$y$};\n\\draw[<->,lineK,line width=0.8pt] plot[domain=-2.8:6.5,samples=2] (\\x,{(25-5*\\x)/7});\n\\draw[<->,lineL,line width=0.8pt] plot[domain=2.7:5.8,samples=2] (\\x,{(5*\\x-25)/2});\n\\fill[lineK] (-2,5) circle[radius=1.5pt];\n\\node[below left,black] at (-2,5) {$(-2,5)$};\n\\fill[lineL] (3,-5) circle[radius=1.5pt];\n\\node[right,black] at (3,-5) {$(3,-5)$};\n\\node[below,black] at (5,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$5$\\special{dvisvgm:raw </g>}};\n\\node[right,black] at (6.2,-1.15) {$k$};\n\\node[above left,black] at (5.8,2) {$l$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 15,
          "sourceRegion": "Question 7 shared graph",
          "description": "Two arrow-ended lines on ungridded Cartesian axes with arrowheads at both ends. Line k is red and descending; line l is blue and ascending. Both pass through the x-axis at 5. Preserve the marked coordinate points and line identities. The origin label is omitted under the graph convention.",
          "mathematics": "Line k passes through (-2,5) and (5,0), so y=(25-5x)/7. Line l passes through (3,-5) and (5,0), so y=(5x-25)/2. Axes have no regular ticks or grid.",
          "answerVisibility": "Only source givens are visible; equations and missing-coordinate answers are omitted."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "The equation of line $l$ in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x-2y-25=0$",
          "worked": "$\\begin{align*}m_l&=\\frac{0-(-5)}{5-3}\\\\m_l&=\\frac52\\\\y-0&=\\frac52(x-5)\\\\2y&=5x-25\\\\5x-2y-25&=0\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "The equation of line $k$ in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x+7y-25=0$",
          "worked": "$\\begin{align*}m_k&=\\frac{0-5}{5-(-2)}\\\\m_k&=-\\frac57\\\\y-0&=-\\frac57(x-5)\\\\7y&=-5x+25\\\\5x+7y-25&=0\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$w$ if the point $(7,w)$ lies on $l$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=5$",
          "worked": "$\\begin{align*}5(7)-2w-25&=0\\\\2w&=10\\\\w&=5\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$t$ if the point $(t,11)$ lies on $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=-\\frac{52}{5}$",
          "worked": "$\\begin{align*}5t+7(11)-25&=0\\\\5t&=-52\\\\t&=-\\frac{52}{5}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
