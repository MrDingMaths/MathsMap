  "content": {
    "id": "v2-83495-p26-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Kim catches a train and then a bus to school. The train is on time with probability $0.85$ and the bus is on time with probability $0.7$. Assume that the two events are independent. Find the probability that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-83495-p26-practice-slot-7-s7-train-bus-a",
        "type": "part",
        "label": "a",
        "prompt": "both the train and the bus are on time,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.595$",
          "worked": "$$\\begin{align*}P(\\text{both on time})&=0.85\\times0.7\\\\P(\\text{both on time})&=0.595\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-83495-p26-practice-slot-7-s7-train-bus-b",
        "type": "part",
        "label": "b",
        "prompt": "exactly one of them is on time.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.36$",
          "worked": "Exactly one is on time if the train is on time and the bus is late, or the train is late and the bus is on time. These cases are mutually exclusive.\n$$\\begin{align*}P(\\text{exactly one on time})&=0.85\\times0.3+0.15\\times0.7\\\\P(\\text{exactly one on time})&=0.255+0.105\\\\P(\\text{exactly one on time})&=0.36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
