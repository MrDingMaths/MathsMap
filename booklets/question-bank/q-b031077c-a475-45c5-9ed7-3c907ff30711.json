  "content": {
    "id": "v2-92f4f-p12-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "The quadrilateral $ABCD$ has vertices $A(-2,0)$, $B(4,2)$, $C(6,8)$ and $D(0,4)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-92f4f-p12-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the midpoints $P$ of $AB$, $Q$ of $BC$, $R$ of $CD$, and $S$ of $DA$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=(1,1)$, $Q=(5,5)$, $R=(3,6)$, $S=(-1,2)$.",
          "worked": "$$\\begin{align*}P&=\\left(\\frac{-2+4}{2},\\frac{0+2}{2}\\right)=(1,1)\\\\Q&=\\left(\\frac{4+6}{2},\\frac{2+8}{2}\\right)=(5,5)\\\\R&=\\left(\\frac{6+0}{2},\\frac{8+4}{2}\\right)=(3,6)\\\\S&=\\left(\\frac{0+(-2)}{2},\\frac{4+0}{2}\\right)=(-1,2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-92f4f-p12-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that $PQRS$ is a parallelogram by showing that $PQ\\parallel SR$ and $PS\\parallel QR$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{PQ}=m_{SR}=1$ and $m_{PS}=m_{QR}=-\\frac12$. Both pairs of opposite sides are parallel, so $PQRS$ is a parallelogram.",
          "worked": "$$\\begin{align*}m_{PQ}&=\\frac{5-1}{5-1}=1\\\\m_{SR}&=\\frac{6-2}{3-(-1)}=1\\end{align*}$$\n\n$PQ\\parallel SR$ since $m_{PQ}=m_{SR}$.\n\n$$\\begin{align*}m_{PS}&=\\frac{2-1}{-1-1}=-\\frac12\\\\m_{QR}&=\\frac{6-5}{3-5}=-\\frac12\\end{align*}$$\n\n$PS\\parallel QR$ since $m_{PS}=m_{QR}$.\n\n$PQRS$ is a parallelogram since opposite sides are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
