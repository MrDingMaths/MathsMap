    "children": [
      {
        "id": "p8-q27-30-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=4x^3+6x^2-5x+1$, $D(x)=2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(2x+1)\\left(2x^2+2x-\\frac72\\right)+\\frac92$.",
          "worked": "Match leading terms, multiply by the divisor and subtract at each step.\n\n$$\\begin{align*}(4x^3+6x^2-5x+1)-2x^2(2x+1)&=4x^2-5x+1\\\\(4x^2-5x+1)-2x(2x+1)&=-7x+1\\\\(-7x+1)-\\left(-\\frac72\\right)(2x+1)&=\\frac92\\end{align*}$$\n\nThus $Q(x)=2x^2+2x-\\frac72$ and $R(x)=\\frac92$.\n\n$$P(x)=(2x+1)\\left(2x^2+2x-\\frac72\\right)+\\frac92.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p8-q27-30-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=4x^3-2x^2+5x+3$, $D(x)=2x^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(2x^2-1)(2x-1)+7x+2$.",
          "worked": "$$\\begin{align*}(4x^3-2x^2+5x+3)-2x(2x^2-1)&=-2x^2+7x+3\\\\(-2x^2+7x+3)-(-1)(2x^2-1)&=7x+2\\end{align*}$$\n\nThe remainder has degree less than 2, so $Q(x)=2x-1$ and $R(x)=7x+2$.\n\n$$P(x)=(2x^2-1)(2x-1)+7x+2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q27-30-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=x^4+x^2-x+1$, $D(x)=x^2+3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x^2+3x+1)(x^2-3x+9)-25x-8$.",
          "worked": "$$\\begin{align*}(x^4+0x^3+x^2-x+1)-x^2(x^2+3x+1)&=-3x^3-x+1\\\\(-3x^3+0x^2-x+1)-(-3x)(x^2+3x+1)&=9x^2+2x+1\\\\(9x^2+2x+1)-9(x^2+3x+1)&=-25x-8\\end{align*}$$\n\nThus $Q(x)=x^2-3x+9$ and $R(x)=-25x-8$.\n\n$$P(x)=(x^2+3x+1)(x^2-3x+9)-25x-8.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p8-q27-30-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=6x^4-3x^2+2$, $D(x)=3x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(3x^2+1)\\left(2x^2-\\frac53\\right)+\\frac{11}{3}$.",
          "worked": "$$\\begin{align*}(6x^4-3x^2+2)-2x^2(3x^2+1)&=-5x^2+2\\\\(-5x^2+2)-\\left(-\\frac53\\right)(3x^2+1)&=\\frac{11}{3}\\end{align*}$$\n\nThus $Q(x)=2x^2-\\frac53$ and $R(x)=\\frac{11}{3}$.\n\n$$P(x)=(3x^2+1)\\left(2x^2-\\frac53\\right)+\\frac{11}{3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
