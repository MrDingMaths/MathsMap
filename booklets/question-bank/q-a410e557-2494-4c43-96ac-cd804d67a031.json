    "children": [
      {
        "id": "p18-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "The first term of a GP is $\\frac18$ and the fifth term is 162.\n\nFind the first five terms of the GP, then find their sum. There are two possibilities.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $r=6$: $\\frac18,\\frac34,\\frac92,27,162$; sum $\\frac{1555}{8}$.\n\nFor $r=-6$: $\\frac18,-\\frac34,\\frac92,-27,162$; sum $\\frac{1111}{8}$.",
          "worked": "$a=\\frac18$, $a_5=162$.\n\n$$\\begin{aligned}a_5&=ar^4\\\\162&=\\frac18r^4\\\\r^4&=1296\\\\r&=\\pm6\\end{aligned}$$\n\nTaking $r=6$, the first five terms are $\\frac18,\\frac34,\\frac92,27,162$.\n\n$$\\begin{aligned}S_5&=\\frac{\\frac18(6^5-1)}{6-1}\\\\S_5&=\\frac{1555}{8}\\end{aligned}$$\n\nTaking $r=-6$, the first five terms are $\\frac18,-\\frac34,\\frac92,-27,162$.\n\n$$\\begin{aligned}S_5&=\\frac{\\frac18(1-(-6)^5)}{1-(-6)}\\\\S_5&=\\frac{1111}{8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 81
      },
      {
        "id": "p18-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The first term of a GP is $-\\frac34$ and the fourth term is 6. Find the sum of the first six terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_6=\\frac{63}{4}=15.75$.",
          "worked": "$a=-\\frac34$, $a_4=6$.\n\n$$\\begin{aligned}a_4&=ar^3\\\\6&=-\\frac34r^3\\\\r^3&=-8\\\\r&=-2\\\\S_6&=\\frac{a(1-r^6)}{1-r}\\\\S_6&=\\frac{-\\frac34(1-(-2)^6)}{1-(-2)}\\\\S_6&=\\frac{63}{4}\\\\S_6&=15.75\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p19-c",
        "type": "part",
        "label": "c",
        "prompt": "The second term of a GP is 0.08 and the third term is 0.4. Find the sum to eight terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_8=1562.496$.",
          "worked": "$a_2=0.08$, $a_3=0.4$.\n\n$$\\begin{aligned}r&=\\frac{a_3}{a_2}\\\\r&=\\frac{0.4}{0.08}\\\\r&=5\\end{aligned}$$\n\nAlso, $r=\\frac{a_2}{a}$, so\n\n$$\\begin{aligned}a&=\\frac{a_2}{r}\\\\a&=\\frac{0.08}{5}\\\\a&=0.016\\\\S_8&=\\frac{a(r^8-1)}{r-1}\\\\S_8&=\\frac{0.016(5^8-1)}{5-1}\\\\S_8&=1562.496\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p19-d",
        "type": "part",
        "label": "d",
        "prompt": "The ratio of a GP is $r=2$ and the sum to eight terms is 1785. Find the first term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=7$.",
          "worked": "$r=2$, $S_8=1785$.\n\n$$\\begin{aligned}S_8&=\\frac{a(r^8-1)}{r-1}\\\\1785&=\\frac{a(2^8-1)}{2-1}\\\\1785&=255a\\\\a&=7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p19-e",
        "type": "part",
        "label": "e",
        "prompt": "A GP has ratio $r=-\\frac12$ and the sum to eight terms is 425. Find the first term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=640$.",
          "worked": "$r=-\\frac12$, $S_8=425$.\n\n$$\\begin{aligned}S_8&=\\frac{a(1-r^8)}{1-r}\\\\425&=\\frac{a(1-(-\\frac12)^8)}{1-(-\\frac12)}\\\\425&=\\frac{a(1-\\frac1{256})}{\\frac32}\\\\\\frac{1275}{2}&=\\frac{255}{256}a\\\\a&=640\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      }
    ]
