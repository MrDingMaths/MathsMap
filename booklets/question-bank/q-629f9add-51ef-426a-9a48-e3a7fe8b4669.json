            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "WTP: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}4+9+14+\\cdots+(5k-1)+(5(k+1)-1)&=\\frac{(k+1)(5(k+1)+3)}{2}\\\\&=\\frac{(k+1)(5k+8)}{2}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "v2-3c0e1-p16-practice-slot-5-root-worked-d12",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\mathrm{LHS}&=[4+9+14+\\cdots+(5k-1)]+(5k+4)\\\\&=\\frac{k(5k+3)}{2}+5k+4\\quad\\text{using assumption}\\\\&=\\frac{5k^2+3k+2(5k+4)}{2}\\\\&=\\frac{5k^2+13k+8}{2}\\\\&=\\frac{(k+1)(5k+8)}{2}\\\\&=\\mathrm{RHS}\\end{aligned}",
                "display": true
              }
            ]
          },
