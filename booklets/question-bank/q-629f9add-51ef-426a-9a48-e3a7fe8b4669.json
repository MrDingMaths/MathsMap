              {
                "type": "math",
                "latex": "4+9+14+\\cdots+(5k-1)=\\frac{k(5k+3)}{2}",
                "display": true
              }
            ]
          },
          {
            "id": "v2-3c0e1-p16-practice-slot-5-root-worked-d10",
            "type": "paragraph",
