  "content": {
    "id": "p29-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "By taking logarithms base 10 of both sides, solve each index equation correct to four significant figures.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$3^{x-4}=47$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx7.505$",
          "worked": "$$\\begin{align*}\\log_{10}(3^{x-4})&=\\log_{10}47\\\\(x-4)\\log_{10}3&=\\log_{10}47\\\\x\\log_{10}3&=\\log_{10}47+4\\log_{10}3\\\\x&=\\frac{\\log_{10}47+4\\log_{10}3}{\\log_{10}3}\\\\x&\\approx7.505\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p29-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{x-5}=5\\times2^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx-7.322$",
          "worked": "$$\\begin{align*}\\log_{10}(2^{x-5})&=\\log_{10}(5\\times2^{2x})\\\\(x-5)\\log_{10}2&=\\log_{10}5+2x\\log_{10}2\\\\x\\log_{10}2-5\\log_{10}2&=\\log_{10}5+2x\\log_{10}2\\\\-x\\log_{10}2&=\\log_{10}5+5\\log_{10}2\\\\x&=\\frac{-\\log_{10}5-5\\log_{10}2}{\\log_{10}2}\\\\x&\\approx-7.322\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p29-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^{2x}=6^{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx1.256$",
          "worked": "$$\\begin{align*}\\log_{10}(5^{2x})&=\\log_{10}(6^{x+1})\\\\2x\\log_{10}5&=(x+1)\\log_{10}6\\\\2x\\log_{10}5-x\\log_{10}6&=\\log_{10}6\\\\x(2\\log_{10}5-\\log_{10}6)&=\\log_{10}6\\\\x&=\\frac{\\log_{10}6}{2\\log_{10}5-\\log_{10}6}\\\\x&\\approx1.256\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p29-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$7^{1-x}=6\\times5^{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx1.401$",
          "worked": "$$\\begin{align*}\\log_{10}(7^{1-x})&=\\log_{10}(6\\times5^{x-3})\\\\(1-x)\\log_{10}7&=\\log_{10}6+(x-3)\\log_{10}5\\\\\\log_{10}7-x\\log_{10}7&=\\log_{10}6+x\\log_{10}5-3\\log_{10}5\\\\x\\log_{10}7+x\\log_{10}5&=\\log_{10}7-\\log_{10}6+3\\log_{10}5\\\\x(\\log_{10}7+\\log_{10}5)&=\\log_{10}7-\\log_{10}6+3\\log_{10}5\\\\x&=\\frac{\\log_{10}7-\\log_{10}6+3\\log_{10}5}{\\log_{10}7+\\log_{10}5}\\\\x&\\approx1.401\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
