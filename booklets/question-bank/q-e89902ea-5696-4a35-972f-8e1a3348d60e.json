  "content": {
    "id": "p41-q15-18-root",
    "type": "question",
    "label": null,
    "prompt": "Find equations with integer coefficients given the roots:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q15-18-a",
        "type": "part",
        "label": "a",
        "prompt": "$-4,\\ 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-x-20=0$",
          "worked": "The sum and product of the roots are\n$$\\begin{align*}\\alpha+\\beta&=-4+5=1\\\\\\alpha\\beta&=(-4)(5)=-20.\\end{align*}$$\nUse $x^2-(\\alpha+\\beta)x+\\alpha\\beta=0$:\n$$x^2-x-20=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p41-q15-18-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac12,\\ \\dfrac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x^2-10x+3=0$",
          "worked": "The sum and product of the roots are\n$$\\begin{align*}\\alpha+\\beta&=\\frac12+\\frac34=\\frac54\\\\\\alpha\\beta&=\\frac12\\times\\frac34=\\frac38.\\end{align*}$$\nThe monic quadratic is\n$$x^2-\\frac54x+\\frac38=0.$$\nMultiply by $8$ to obtain integer coefficients:\n$$8x^2-10x+3=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p41-q15-18-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\dfrac52,\\ \\dfrac25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10x^2+21x-10=0$",
          "worked": "The sum and product of the roots are\n$$\\begin{align*}\\alpha+\\beta&=-\\frac52+\\frac25=-\\frac{21}{10}\\\\\\alpha\\beta&=-\\frac52\\times\\frac25=-1.\\end{align*}$$\nThe monic quadratic is\n$$x^2+\\frac{21}{10}x-1=0.$$\nMultiply by $10$ to obtain integer coefficients:\n$$10x^2+21x-10=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p41-q15-18-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\sqrt5,\\ 1+\\sqrt5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-2x-4=0$",
          "worked": "The sum and product of the roots are\n$$\\begin{align*}\\alpha+\\beta&=(1-\\sqrt5)+(1+\\sqrt5)=2\\\\\\alpha\\beta&=(1-\\sqrt5)(1+\\sqrt5)\\\\\\alpha\\beta&=1-5=-4.\\end{align*}$$\nUse $x^2-(\\alpha+\\beta)x+\\alpha\\beta=0$:\n$$x^2-2x-4=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
