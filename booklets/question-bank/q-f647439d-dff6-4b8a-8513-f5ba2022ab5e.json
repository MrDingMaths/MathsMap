  "content": {
    "id": "p54-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Prove that $x^n-1$ is always divisible by $(x-1)$ for every positive integer $n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(1)=1^n-1=0$, so $x-1$ is a factor of $x^n-1$.",
      "worked": "Let $P(x)=x^n-1$.\n$$\\begin{align*}P(1)&=1^n-1\\\\P(1)&=1-1\\\\P(1)&=0\\end{align*}$$\nSince $1^n=1$ for every positive integer $n$, the factor theorem shows that $x-1$ divides $x^n-1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 15
  },
