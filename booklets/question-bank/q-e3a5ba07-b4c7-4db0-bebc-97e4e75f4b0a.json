    "type": "question",
    "label": null,
    "prompt": "Walking tracks connect 9 campsites so that there is exactly one route between any two campsites. How many tracks are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "8 tracks.",
      "worked": "A network with exactly one path between any two vertices is a tree. A tree with $n$ vertices has $n-1$ edges.\n$$9-1=8$$\nTherefore, there are 8 tracks.",
