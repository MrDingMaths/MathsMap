  "content": {
    "id": "p7-q5",
    "type": "question",
    "label": "5",
    "prompt": "Find $90\\%$ of $56$ and $9\\%$ of $560$. What do you notice?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Both are $50.4$; they are equal.",
      "worked": "$$\\begin{align*}90\\%\\text{ of }56&=90\\%\\times56\\\\&=0.90\\times56\\\\&=50.4\\\\9\\%\\text{ of }560&=9\\%\\times560\\\\&=0.09\\times560\\\\&=50.4\\end{align*}$$\nThe results are equal.",
      "solutionDiagrams": []
    },
