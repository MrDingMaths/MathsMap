    "type": "question",
    "label": "4",
    "prompt": "A debating team consists of four boys and eight girls. If one of the team is chosen at random to be the leader, what is the probability that the leader is a girl?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{3}$",
      "worked": "There are $4+8=12$ team members, each equally likely to be chosen.\n$$\\begin{aligned}P(\\text{girl})&=\\frac{8}{12}\\\\P(\\text{girl})&=\\frac{2}{3}\\end{aligned}$$",
      "solutionDiagrams": []
    },
