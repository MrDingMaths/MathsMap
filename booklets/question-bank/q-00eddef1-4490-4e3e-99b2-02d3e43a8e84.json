  "content": {
    "id": "p4-stem-62-65-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions, and express your answer as an exact value in simplest form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q62",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\operatorname{cosec}\\frac{3\\pi}{4}}{1-\\cot\\frac{3\\pi}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{\\operatorname{cosec}\\frac{3\\pi}{4}}{1-\\cot\\frac{3\\pi}{4}}&=\\frac{\\frac{1}{\\sin\\frac{3\\pi}{4}}}{1-\\frac{\\cos\\frac{3\\pi}{4}}{\\sin\\frac{3\\pi}{4}}}\\\\\\frac{\\operatorname{cosec}\\frac{3\\pi}{4}}{1-\\cot\\frac{3\\pi}{4}}&=\\frac{\\sqrt{2}}{1-(-1)}\\\\\\frac{\\operatorname{cosec}\\frac{3\\pi}{4}}{1-\\cot\\frac{3\\pi}{4}}&=\\frac{\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p4-q63",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sec\\frac{5\\pi}{6}}{1-\\cot\\frac{5\\pi}{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p4-q63-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{\\sqrt{3}-3}{3}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p4-q63-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute the exact reciprocal ratios, then rationalise the denominator.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "At $\\frac{5\\pi}{6}$, $\\cos\\frac{5\\pi}{6}=-\\frac{\\sqrt{3}}{2}$ and $\\sin\\frac{5\\pi}{6}=\\frac12$.\n\n$$\\begin{align*}\\frac{\\sec\\frac{5\\pi}{6}}{1-\\cot\\frac{5\\pi}{6}}&=\\frac{\\frac{1}{-\\sqrt{3}/2}}{1-\\frac{-\\sqrt{3}/2}{1/2}}\\\\\\frac{\\sec\\frac{5\\pi}{6}}{1-\\cot\\frac{5\\pi}{6}}&=\\frac{-2}{\\sqrt{3}(1+\\sqrt{3})}\\\\\\frac{\\sec\\frac{5\\pi}{6}}{1-\\cot\\frac{5\\pi}{6}}&=\\frac{-2}{3+\\sqrt{3}}\\\\\\frac{\\sec\\frac{5\\pi}{6}}{1-\\cot\\frac{5\\pi}{6}}&=\\frac{-2(3-\\sqrt{3})}{6}\\\\\\frac{\\sec\\frac{5\\pi}{6}}{1-\\cot\\frac{5\\pi}{6}}&=\\frac{\\sqrt{3}-3}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p4-q64",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{\\sec\\frac{2\\pi}{3}+\\tan\\frac{2\\pi}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p4-q64-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\sqrt{3}-2",
                    "display": false
                  }
                ]
              },
              {
                "id": "p4-q64-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the second-quadrant exact values, then rationalise the denominator.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{1}{\\sec\\frac{2\\pi}{3}+\\tan\\frac{2\\pi}{3}}&=\\frac{1}{\\frac{1}{\\cos\\frac{2\\pi}{3}}+\\tan\\frac{2\\pi}{3}}\\\\\\frac{1}{\\sec\\frac{2\\pi}{3}+\\tan\\frac{2\\pi}{3}}&=\\frac{1}{-2-\\sqrt{3}}\\\\\\frac{1}{\\sec\\frac{2\\pi}{3}+\\tan\\frac{2\\pi}{3}}&=\\frac{-2+\\sqrt{3}}{(-2-\\sqrt{3})(-2+\\sqrt{3})}\\\\\\frac{1}{\\sec\\frac{2\\pi}{3}+\\tan\\frac{2\\pi}{3}}&=\\sqrt{3}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q65",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sec^2\\frac{\\pi}{4}-\\tan^2\\frac{\\pi}{4}}{\\operatorname{cosec}\\frac{\\pi}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{\\sec^2\\frac{\\pi}{4}-\\tan^2\\frac{\\pi}{4}}{\\operatorname{cosec}\\frac{\\pi}{4}}&=\\frac{\\left(\\frac{1}{\\cos\\frac{\\pi}{4}}\\right)^2-\\tan^2\\frac{\\pi}{4}}{\\frac{1}{\\sin\\frac{\\pi}{4}}}\\\\\\frac{\\sec^2\\frac{\\pi}{4}-\\tan^2\\frac{\\pi}{4}}{\\operatorname{cosec}\\frac{\\pi}{4}}&=\\frac{(\\sqrt{2})^2-1^2}{\\sqrt{2}}\\\\\\frac{\\sec^2\\frac{\\pi}{4}-\\tan^2\\frac{\\pi}{4}}{\\operatorname{cosec}\\frac{\\pi}{4}}&=\\frac{\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
