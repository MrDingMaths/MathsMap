  "content": {
    "id": "v2-d2748-p15-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Show by substitution that the function $y=Ae^{3-0.2x}$ satisfies the equation $\\dfrac{dy}{dx}=-0.2y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{dy}{dx}=-0.2Ae^{3-0.2x}=-0.2y$.",
      "worked": "$$\\begin{aligned}y&=Ae^{3-0.2x}\\\\\\frac{dy}{dx}&=Ae^{3-0.2x}(-0.2)\\\\\\frac{dy}{dx}&=-0.2(Ae^{3-0.2x})\\\\\\frac{dy}{dx}&=-0.2y\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
