  "content": {
    "id": "p27-q38-content",
    "type": "question",
    "label": "38",
    "prompt": "The graph of $y=\\log_3(x)$ is translated 2 units down. What is the equivalent horizontal dilation to give the same result?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q38-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Horizontal dilation by a factor of 9.",
                "marks": []
              }
            ]
          },
          {
            "id": "p27-q38-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\log_3(x)-2=\\log_3\\left(\\frac{x}{9}\\right)",
                "display": false
              },
              {
                "type": "text",
                "text": ", corresponding to ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\mapsto\\frac{x}{9}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Replace $y\\mapsto y+2$.\n\n$$\\begin{align*}y+2&=\\log_3(x)\\\\y&=\\log_3(x)-\\log_3(9)\\\\y&=\\log_3\\left(\\frac{x}{9}\\right)\\end{align*}$$\n\nThe substitution $x\\mapsto \\frac{x}{9}$ gives a horizontal dilation by a factor of $9$.",
      "solutionDiagrams": []
    },
