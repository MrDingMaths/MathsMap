      {
        "id": "p53-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\sin^3x\\cos x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14\\sin^4x+C$",
          "worked": "Let $u=\\sin x$, so $du=\\cos x\\,dx$.\n$$\\begin{aligned}\\int\\sin^3x\\cos x\\,dx&=\\int u^3\\,du\\\\&=\\frac14u^4+C\\\\&=\\frac14\\sin^4x+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p53-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\sin^6x\\cos x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac17\\sin^7x+C$",
          "worked": "Let $u=\\sin x$, so $du=\\cos x\\,dx$.\n$$\\begin{aligned}\\int\\sin^6x\\cos x\\,dx&=\\int u^6\\,du\\\\&=\\frac17u^7+C\\\\&=\\frac17\\sin^7x+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p53-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\cos^5x\\sin x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac16\\cos^6x+C$",
          "worked": "Let $u=\\cos x$, so $du=-\\sin x\\,dx$.\n$$\\begin{aligned}\\int\\cos^5x\\sin x\\,dx&=-\\int u^5\\,du\\\\&=-\\frac16u^6+C\\\\&=-\\frac16\\cos^6x+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p53-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\cos^8x\\sin x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac19\\cos^9x+C$",
          "worked": "Let $u=\\cos x$, so $du=-\\sin x\\,dx$.\n$$\\begin{aligned}\\int\\cos^8x\\sin x\\,dx&=-\\int u^8\\,du\\\\&=-\\frac19u^9+C\\\\&=-\\frac19\\cos^9x+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p53-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int e^x\\sin(e^x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cos(e^x)+C$",
          "worked": "Let $u=e^x$, so $du=e^x\\,dx$.\n$$\\begin{aligned}\\int e^x\\sin(e^x)\\,dx&=\\int\\sin u\\,du\\\\&=-\\cos u+C\\\\&=-\\cos(e^x)+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p53-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int e^x\\cos(5e^x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac15\\sin(5e^x)+C$",
          "worked": "Let $u=5e^x$, so $du=5e^x\\,dx$.\n$$\\begin{aligned}\\int e^x\\cos(5e^x)\\,dx&=\\frac15\\int\\cos u\\,du\\\\&=\\frac15\\sin u+C\\\\&=\\frac15\\sin(5e^x)+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p53-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\displaystyle\\int\\tan x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\log_e|\\cos x|+C$",
          "worked": "$$\\int\\tan x\\,dx=\\int\\frac{\\sin x}{\\cos x}\\,dx.$$\nLet $u=\\cos x$, so $du=-\\sin x\\,dx$.\n$$\\begin{aligned}\\int\\tan x\\,dx&=-\\int\\frac1u\\,du\\\\&=-\\log_e|u|+C\\\\&=-\\log_e|\\cos x|+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p53-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\displaystyle\\int\\cot 7x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac17\\log_e|\\sin 7x|+C$",
          "worked": "$$\\int\\cot 7x\\,dx=\\int\\frac{\\cos 7x}{\\sin 7x}\\,dx.$$\nLet $u=\\sin 7x$, so $du=7\\cos 7x\\,dx$.\n$$\\begin{aligned}\\int\\cot 7x\\,dx&=\\frac17\\int\\frac1u\\,du\\\\&=\\frac17\\log_e|u|+C\\\\&=\\frac17\\log_e|\\sin 7x|+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
