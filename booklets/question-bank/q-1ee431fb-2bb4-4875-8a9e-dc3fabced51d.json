  "content": {
    "id": "p37-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Each point in the plane is coloured with one of $n$ colours. Must there exist a rectangle whose corners are all the same colour?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
