    "id": "v2-1a591-p11-practice-slot-1-085643-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=px^2-2x$.\n\nFind $p$ if $f(3)=3f(-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=2$.",
      "worked": "$$\\begin{align*}f(3)&=p(3)^2-2(3)\\\\&=9p-6\\\\f(-1)&=p(-1)^2-2(-1)\\\\&=p+2\\\\9p-6&=3(p+2)\\\\9p-6&=3p+6\\\\6p&=12\\\\p&=2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
