    "type": "question",
    "label": "17",
    "prompt": "Louise rides $5\\frac{1}{2}\\text{ km}$ in $\\frac{3}{4}$ of an hour. What is her speed in km/h?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7\\frac{1}{3}\\text{ km/h}$",
      "worked": "$$\\begin{align*}\\text{Speed}&=\\frac{\\text{distance}}{\\text{time}}\\\\\\text{Speed}&=5\\frac{1}{2}\\div\\frac{3}{4}\\\\\\text{Speed}&=\\frac{11}{2}\\times\\frac{4}{3}\\\\\\text{Speed}&=\\frac{22}{3}\\\\\\text{Speed}&=7\\frac{1}{3}\\text{ km/h}\\end{align*}$$",
      "solutionDiagrams": []
    },
