  "content": {
    "id": "p124-practice-05-question",
    "type": "question",
    "label": "5",
    "prompt": "Explain, using the number line interpretation of the absolute value, why $|x-y|=0$ implies that $x=y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x$ and $y$ are zero units apart on the number line, so $x=y$.",
      "worked": "$|x-y|$ is the distance between $x$ and $y$ on the number line. A distance of zero means they occupy the same point, so $x=y$.",
      "solutionDiagrams": []
    },
