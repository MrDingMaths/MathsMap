  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each quotient, expressing each pronumeral in the answer with a positive index.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2y^3}{xy^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{y}$",
          "worked": "$$\\begin{align*}\\frac{x^2y^3}{xy^4}&=x^{2-1}y^{3-4}\\\\\\frac{x^2y^3}{xy^4}&=\\frac{x}{y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{30x^2y^4}{20xy^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3xy^2}{2}$",
          "worked": "$$\\begin{align*}\\frac{30x^2y^4}{20xy^2}&=\\frac32x^{2-1}y^{4-2}\\\\\\frac{30x^2y^4}{20xy^2}&=\\frac{3xy^2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{a^6m^4}{a^2m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^4m^3$",
          "worked": "$$\\begin{align*}\\frac{a^6m^4}{a^2m}&=a^{6-2}m^{4-1}\\\\\\frac{a^6m^4}{a^2m}&=a^4m^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{25x^4y^6}{20x^3y^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5xy}{4}$",
          "worked": "$$\\begin{align*}\\frac{25x^4y^6}{20x^3y^5}&=\\frac54x^{4-3}y^{6-5}\\\\\\frac{25x^4y^6}{20x^3y^5}&=\\frac{5xy}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{8ab^3c^4}{12ab^5c^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2c^2}{3b^2}$",
          "worked": "$$\\begin{align*}\\frac{8ab^3c^4}{12ab^5c^2}&=\\frac23b^{-2}c^2\\\\\\frac{8ab^3c^4}{12ab^5c^2}&=\\frac{2c^2}{3b^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p5-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{16x^3y^6z^8}{4y^7z^8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4x^3}{y}$",
          "worked": "$$\\begin{align*}\\frac{16x^3y^6z^8}{4y^7z^8}&=4x^3y^{6-7}z^{8-8}\\\\\\frac{16x^3y^6z^8}{4y^7z^8}&=\\frac{4x^3}{y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
