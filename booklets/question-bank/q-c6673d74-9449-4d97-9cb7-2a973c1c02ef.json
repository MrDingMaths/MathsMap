  "content": {
    "id": "p14-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "For each equation, in what direction and how many units was $f(x)$ translated to yield $g(x)$?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\sqrt{2x-3},\\quad g(x)=\\sqrt{2x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 units left.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}\\sqrt{2(x-b)-3}&=\\sqrt{2x+7}\\\\2x-2b-3&=2x+7\\\\-2b-3&=7\\\\-2b&=10\\\\b&=-5\\end{aligned}$$\nTherefore, 5 units left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=(3x+5)^2,\\quad g(x)=(3x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units right.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}(3(x-b)+5)^2&=(3x-1)^2\\\\(3x-3b+5)^2&=(3x-1)^2\\\\-3b+5&=-1\\\\b&=2\\end{aligned}$$\nTherefore, 2 units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=5^{-x},\\quad g(x)=5^{-x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 unit right.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}5^{-(x-b)}&=5^{-x+1}\\\\-x+b&=-x+1\\\\b&=1\\end{aligned}$$\nTherefore, 1 unit right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p14-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=3^{-2x},\\quad g(x)=3^{-2x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units right.",
          "worked": "Let $f(x-b)=g(x)$.\n$$\\begin{aligned}3^{-2(x-b)}&=3^{-2x+4}\\\\-2x+2b&=-2x+4\\\\2b&=4\\\\b&=2\\end{aligned}$$\nTherefore, 2 units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
