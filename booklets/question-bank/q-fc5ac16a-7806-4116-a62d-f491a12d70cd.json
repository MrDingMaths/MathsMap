  "content": {
    "id": "p23-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The line $\\ell$ has equation $y=3x+5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the $y$-intercept of $\\ell$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "In $y=mx+c$, the $y$-intercept is $c$. Here $c=5$, so the $y$-intercept is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p23-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the gradient of $\\ell$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "In $y=mx+c$, the gradient is $m$. Here $m=3$, so the gradient is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p23-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the line that has the same $y$-intercept as $\\ell$ but has a gradient of $\\frac{1}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{2}x+5$",
          "worked": "The required line has $m=\\frac{1}{2}$ and $c=5$.\n$$\\begin{align*}y&=mx+c\\\\y&=\\frac{1}{2}x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the line that has the same gradient as $\\ell$ but has a $y$-intercept of $-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x-2$",
          "worked": "The required line has $m=3$ and $c=-2$.\n$$\\begin{align*}y&=mx+c\\\\y&=3x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
