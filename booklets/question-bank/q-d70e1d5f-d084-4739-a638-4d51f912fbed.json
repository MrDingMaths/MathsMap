      {
        "id": "v2-fafc9-p54-practice-slot-9-lower-slot-9-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2}{\\sqrt{7}+\\sqrt{3}}+\\dfrac{2}{\\sqrt{7}-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{7}$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt{7}+\\sqrt{3}}+\\frac{2}{\\sqrt{7}-\\sqrt{3}}&=\\frac{2(\\sqrt{7}-\\sqrt{3})+2(\\sqrt{7}+\\sqrt{3})}{(\\sqrt{7}+\\sqrt{3})(\\sqrt{7}-\\sqrt{3})}\\\\&=\\frac{4\\sqrt{7}}{7-3}\\\\&=\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-fafc9-p54-practice-slot-9-lower-slot-9-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3}{\\sqrt{6}+2}-\\dfrac{3}{\\sqrt{6}-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{6}+2}-\\frac{3}{\\sqrt{6}-2}&=\\frac{3(\\sqrt{6}-2)-3(\\sqrt{6}+2)}{(\\sqrt{6}+2)(\\sqrt{6}-2)}\\\\&=\\frac{-12}{6-4}\\\\&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
