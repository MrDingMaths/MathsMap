  "content": {
    "id": "p12-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "Suppose $a<b$. Find $a$ and $b$ if the graph of $y=(x-a)(x-b)$ has a turning point at $A(3,-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(a,b)=(2,4)$.",
      "worked": "The turning point lies halfway between the intercepts.\n$$\\begin{align*}\\frac{a+b}{2}&=3\\\\a+b&=6\\\\b&=6-a\\end{align*}$$\nSubstitute $A(3,-1)$ into the equation.\n$$\\begin{align*}(3-a)(3-b)&=-1\\\\(3-a)(a-3)&=-1\\\\-(3-a)^2&=-1\\\\(3-a)^2&=1\\\\a&=2\\text{ or }4\\end{align*}$$\nSince $a<b$ and $a+b=6$, $a=2$ and $b=4$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
