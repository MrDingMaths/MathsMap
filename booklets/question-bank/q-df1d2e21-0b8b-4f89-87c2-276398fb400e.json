  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "What is the probability of choosing an integer that is exactly divisible by 5 from the set $\\{5,6,7,8,9,10,11,12\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "The favourable outcomes are 5 and 10. There are 8 equally likely outcomes.\n$$\\begin{align*}P(\\text{divisible by }5)&=\\frac{2}{8}\\\\P(\\text{divisible by }5)&=\\frac{1}{4}\\end{align*}$$",
      "solutionDiagrams": []
    },
