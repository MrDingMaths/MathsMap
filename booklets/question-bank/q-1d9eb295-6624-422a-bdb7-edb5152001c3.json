  "content": {
    "id": "p33-q7-response",
    "type": "question",
    "label": "7",
    "prompt": "Consider a group of six students from which we must select four. How many ways can this be done so that the selection includes the oldest or youngest student?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14$ ways.",
      "worked": "Let $A$ be the selections containing the oldest student and $B$ the selections containing the youngest student. Fixing either student leaves three students to choose from five; fixing both leaves two to choose from four.\n\n$$\\begin{align*}|A|&=\\binom{5}{3}=10\\\\|B|&=\\binom{5}{3}=10\\\\|A\\cap B|&=\\binom{4}{2}=6\\\\|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B|&=10+10-6\\\\|A\\cup B|&=14\\end{align*}$$\n\nThere are $14$ ways.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
