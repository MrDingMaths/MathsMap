    "type": "question",
    "label": "11",
    "prompt": "If $3x^3+ax^2+bx-6$ is exactly divisible by $x+2$ and $x-3$, find the values of $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
