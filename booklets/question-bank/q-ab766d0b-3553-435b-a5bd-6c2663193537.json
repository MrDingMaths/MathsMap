    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=5x-9$. Find $f^{-1}(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f^{-1}(x)=\\dfrac{x+9}{5}$.",
      "worked": "Write $y=5x-9$. Interchange $x$ and $y$ to obtain $x=5y-9$.\n$$\\begin{align*}5y&=x+9\\\\y&=\\frac{x+9}{5}\\\\f^{-1}(x)&=\\frac{x+9}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
