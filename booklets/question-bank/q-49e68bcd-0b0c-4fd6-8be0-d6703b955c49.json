          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "According to latest enrolment figures, half the student population of the university are over the age of 24. The ‘average’ student is 29 years old.",
              "marks": []
            }
          ]
        },
        {
          "id": "p25-q14-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Can you give an example of a set of 4 students with mean age 24 and median age of 29?",
              "marks": []
            }
          ]
        }
      ]
