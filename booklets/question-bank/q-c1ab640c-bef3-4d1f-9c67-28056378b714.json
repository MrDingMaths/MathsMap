    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the parabola $y=(x-1)^2+a$. Find the value of $a$ if the $y$-intercept is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
