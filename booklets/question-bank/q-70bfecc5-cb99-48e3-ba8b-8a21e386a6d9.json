    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(0)$ and show the point on the graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q4-solution-graph",
        "answer": {
          "short": "$f(0)=4$; point $(0,4)$.",
          "worked": "$\\begin{aligned}f(0)&=4-0^2\\\\&=4\\end{aligned}$\nThe point is $(0,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $x$ when $f(x)=0$ and show the points on the graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q4-solution-graph",
        "answer": {
          "short": "$x=-2$ or $2$; points $(-2,0)$ and $(2,0)$.",
          "worked": "The graph meets the $x$-axis at $x=-2$ and $x=2$, where $f(x)=0$.\nThe points are $(-2,0)$ and $(2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $f(4)$ and show the point on the graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q4-solution-graph",
        "answer": {
          "short": "$f(4)=-12$; point $(4,-12)$.",
          "worked": "$\\begin{aligned}f(4)&=4-4^2\\\\&=4-16\\\\&=-12\\end{aligned}$\nThe point is $(4,-12)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ],
