  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the 5 number summary and IQR for each of these sets of data.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$1,\\ 3,\\ 4,\\ 7,\\ 9,\\ 10,\\ 11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Min: $1$, $Q_1:3$, $Q_2:7$, $Q_3:10$, Max: $11$. IQR: $7$.",
          "worked": "Exclude the median when finding the medians of the lower and upper halves.\n\n$$\\begin{align*}Q_2&=7\\\\Q_1&=3\\\\Q_3&=10\\end{align*}$$\n\nMin: $1$, $Q_1:3$, $Q_2:7$, $Q_3:10$, Max: $11$.\n\n$$\\begin{align*}\\text{IQR}&=Q_3-Q_1\\\\\\text{IQR}&=10-3\\\\\\text{IQR}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$14,\\ 14,\\ 15,\\ 16,\\ 16,\\ 18,\\ 19,\\ 19,\\ 20,\\ 20,\\ 21$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Min: $14$, $Q_1:15$, $Q_2:18$, $Q_3:20$, Max: $21$. IQR: $5$.",
          "worked": "Exclude the median when finding the medians of the lower and upper halves.\n\n$$\\begin{align*}Q_2&=18\\\\Q_1&=15\\\\Q_3&=20\\end{align*}$$\n\nMin: $14$, $Q_1:15$, $Q_2:18$, $Q_3:20$, Max: $21$.\n\n$$\\begin{align*}\\text{IQR}&=Q_3-Q_1\\\\\\text{IQR}&=20-15\\\\\\text{IQR}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$0,\\ 1,\\ 2,\\ 3,\\ 5,\\ 5,\\ 6,\\ 7,\\ 7,\\ 8,\\ 9,\\ 9,\\ 11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Min: $0$, $Q_1:2.5$, $Q_2:6$, $Q_3:8.5$, Max: $11$. IQR: $6$.",
          "worked": "Exclude the median when finding the medians of the lower and upper halves.\n\n$$\\begin{align*}Q_2&=6\\\\Q_1&=\\frac{2+3}{2}\\\\Q_1&=2.5\\\\Q_3&=\\frac{8+9}{2}\\\\Q_3&=8.5\\end{align*}$$\n\nMin: $0$, $Q_1:2.5$, $Q_2:6$, $Q_3:8.5$, Max: $11$.\n\n$$\\begin{align*}\\text{IQR}&=Q_3-Q_1\\\\\\text{IQR}&=8.5-2.5\\\\\\text{IQR}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$18,\\ 21,\\ 21,\\ 26,\\ 27,\\ 29,\\ 30,\\ 30,\\ 35,\\ 36,\\ 37,\\ 38,\\ 41$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Min: $18$, $Q_1:23.5$, $Q_2:30$, $Q_3:36.5$, Max: $41$. IQR: $13$.",
          "worked": "Exclude the median when finding the medians of the lower and upper halves.\n\n$$\\begin{align*}Q_2&=30\\\\Q_1&=\\frac{21+26}{2}\\\\Q_1&=23.5\\\\Q_3&=\\frac{36+37}{2}\\\\Q_3&=36.5\\end{align*}$$\n\nMin: $18$, $Q_1:23.5$, $Q_2:30$, $Q_3:36.5$, Max: $41$.\n\n$$\\begin{align*}\\text{IQR}&=Q_3-Q_1\\\\\\text{IQR}&=36.5-23.5\\\\\\text{IQR}&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
