        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the line $BC$ in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+5y-9=0$",
          "worked": "The gradient of $AB$ is $\\frac{5}{3}$, so the perpendicular gradient is $-\\frac{3}{5}$.\nThrough $B(3,0)$:\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-0&=-\\frac{3}{5}(x-3)\\\\5y&=-3x+9\\\\3x+5y-9&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
