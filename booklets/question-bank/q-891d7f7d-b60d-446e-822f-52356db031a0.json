          "inlines": [
            {
              "type": "text",
              "text": "The value of a bank balance increases by 10% per year. The initial amount is $2000.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation in the form $FV=PV(1+r)^n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$FV=2000(1.1)^n$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 2000(1+0.10)^n\\\\FV &= 2000(1.1)^n\\end{align*}$$\nHere $n$ is the number of years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p30-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the time, correct to two decimals, when the balance is double the original amount.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.27$ years",
          "worked": "$$\\begin{align*}FV &= 2000(1.1)^n\\\\4000 &= 2000(1.1)^n\\\\2 &= 1.1^n\\\\n &= \\log_{1.1}2\\\\n &\\approx 7.27\\end{align*}$$\nThe time is $7.27$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
