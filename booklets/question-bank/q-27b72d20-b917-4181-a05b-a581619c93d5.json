            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Area involves two dimensions. A square with side ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "1\\text{ km}",
                "display": false
              },
              {
                "type": "text",
                "text": " has side ",
