                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{align*}\\text{Area of the square}&=1\\,000\\times1\\,000=1\\,000\\,000\\text{ m}^2\\\\1\\text{ km}^2&=1\\,000\\,000\\text{ m}^2\\end{align*}",
                "display": true
              },
              {
                "type": "text",
                "text": "Therefore, to convert from ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\text{m}^2",
                "display": false
              },
              {
                "type": "text",
                "text": " to ",
