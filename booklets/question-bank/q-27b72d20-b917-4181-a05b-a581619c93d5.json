              },
              {
                "type": "math",
                "latex": "\\text{km}^2",
                "display": false
              },
              {
                "type": "text",
                "text": ", divide by ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "1\\,000^2=1\\,000\\,000",
                "display": false
              },
              {
                "type": "text",
