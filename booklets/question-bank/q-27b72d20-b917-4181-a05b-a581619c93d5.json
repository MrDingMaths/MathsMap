    "answer": {
      "short": "Area involves two dimensions, so divide by $1\\,000^2=1\\,000\\,000$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p10-q16-answer",
            "type": "paragraph",
