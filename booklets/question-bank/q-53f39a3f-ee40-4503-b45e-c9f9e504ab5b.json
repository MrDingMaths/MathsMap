  "content": {
    "id": "p21-question-53-58-root",
    "type": "question",
    "label": null,
    "prompt": "Given $\\log_{10}(2)=a$ and $\\log_{10}(3)=b$, express the following in terms of $a$ and/or $b$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-question-53-58-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{10}(60)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b+1$",
          "worked": "$$\\begin{align*}\\log_{10}(60)&=\\log_{10}(2\\times3\\times10)\\\\\\log_{10}(60)&=\\log_{10}(2)+\\log_{10}(3)+\\log_{10}(10)\\\\\\log_{10}(60)&=a+b+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p21-question-53-58-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}(1.5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b-a$",
          "worked": "$$\\begin{align*}\\log_{10}(1.5)&=\\log_{10}(3)-\\log_{10}(2)\\\\\\log_{10}(1.5)&=b-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-question-53-58-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{10}(20)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+a$",
          "worked": "$$\\begin{align*}\\log_{10}(20)&=\\log_{10}(10)+\\log_{10}(2)\\\\\\log_{10}(20)&=1+a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-question-53-58-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}(24)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a+b$",
          "worked": "$$\\begin{align*}\\log_{10}(24)&=\\log_{10}(2^3\\times3)\\\\\\log_{10}(24)&=3\\log_{10}(2)+\\log_{10}(3)\\\\\\log_{10}(24)&=3a+b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-question-53-58-part-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{10}(25)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-2a$",
          "worked": "$$\\begin{align*}\\log_{10}(25)&=\\log_{10}\\left(\\left(\\frac{10}{2}\\right)^2\\right)\\\\\\log_{10}(25)&=2\\bigl(\\log_{10}(10)-\\log_{10}(2)\\bigr)\\\\\\log_{10}(25)&=2-2a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p21-question-53-58-part-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{10}(1.25)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-3a$",
          "worked": "$$\\begin{align*}\\log_{10}(1.25)&=\\log_{10}\\left(\\frac{10}{2^3}\\right)\\\\\\log_{10}(1.25)&=\\log_{10}(10)-3\\log_{10}(2)\\\\\\log_{10}(1.25)&=1-3a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
