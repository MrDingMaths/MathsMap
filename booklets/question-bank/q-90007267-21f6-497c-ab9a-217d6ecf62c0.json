  "content": {
    "id": "p17-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The diagram above is a sketch of $y=\\ln(x)$. For each equation, what other function should be drawn on the same axes so that the $x$-coordinates of any intersections give the solutions?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "p17-q16-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"logBlue\",\"hex\":\"268CFF\",\"reason\":\"matches the supplied logarithmic curve to its equation\"}],\"reference\":\"student PDF p17 p17-q16-graph\"}\n\\begin{tikzpicture}[x=9mm,y=9mm,>=stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{logBlue}{HTML}{268CFF}\n\\draw[black,->,line width=0.5pt] (-1,0)--(6.85,0) node[below] {$x$};\n\\draw[black,->,line width=0.5pt] (0,-2.25)--(0,2.42) node[left] {$y$};\n\\draw[black,line width=0.4pt] (1,-0.09)--(1,0.09);\n\\node[below] at (1,-0.12) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\draw[logBlue,<->,line width=0.8pt] plot[domain=-2.03:1.80,samples=100,variable=\\t] ({exp(\\t)},{\\t});\n\\node[logBlue,below right] at (4.85,1.52) {$y=\\ln(x)$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 74,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 17,
          "sourceRegion": "Graph above Question 16",
          "description": "The supplied blue logarithmic curve has arrows at both ends and a matching equation label. Both axes have positive-direction arrows. The only numbered tick is at x = 1.",
          "mathematics": "y = ln(x) for x > 0, with x-intercept (1,0) and vertical asymptote x = 0.",
          "answerVisibility": "student"
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p17-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\ln(x)=x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x-2$",
          "worked": "The equation already has $\\ln(x)$ alone on the left. Draw $y=x-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p17-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac12\\ln(x)=1-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2-2x$",
          "worked": "Multiply both sides by $2$.\n\n$$\\begin{align*}\\ln(x)&=2(1-x)\\\\\\ln(x)&=2-2x\\end{align*}$$\n\nDraw $y=2-2x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p17-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$x\\ln(x)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x}$",
          "worked": "Since $x>0$, divide both sides by $x$.\n\n$$\\begin{align*}\\ln(x)&=\\dfrac{1}{x}\\end{align*}$$\n\nDraw $y=\\dfrac{1}{x}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\ln(x)}{x}=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2$",
          "worked": "Since $x>0$, multiply both sides by $x$.\n\n$$\\begin{align*}\\ln(x)&=x^2\\end{align*}$$\n\nDraw $y=x^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ],
    "diagramPlacement": "before-prompt"
  },
