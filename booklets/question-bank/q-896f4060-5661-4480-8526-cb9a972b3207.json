      {
        "id": "v2-1b3ff-p61-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Daily water use per household in a suburb is normally distributed with standard deviation 40 L. 5% of households use more than 400 L. Find the mean daily water use.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$334.2\\text{ L}$",
          "worked": "$P(X\\le400)=1-0.05=0.95$.\n\nUsing inverse normal, $z=\\operatorname{invNorm}(0.95)\\approx1.6448536$.\n\n$$\\begin{align*}400&=\\mu+40\\operatorname{invNorm}(0.95)\\\\\\mu&=400-40(1.6448536)\\\\\\mu&\\approx334.2\\text{ L}\\quad\\text{(1 d.p.)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-1b3ff-p61-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Lengths of barramundi at a fish farm are normally distributed with standard deviation 4 cm. 15% of the fish are shorter than 30 cm. Find the mean length.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34.1\\text{ cm}$",
          "worked": "$P(X<30)=0.15$.\n\nUsing inverse normal, $z=\\operatorname{invNorm}(0.15)\\approx-1.0364334$.\n\n$$\\begin{align*}30&=\\mu+4\\operatorname{invNorm}(0.15)\\\\\\mu&=30-4(-1.0364334)\\\\\\mu&\\approx34.1\\text{ cm}\\quad\\text{(1 d.p.)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
