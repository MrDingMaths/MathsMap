  "content": {
    "id": "p27-q9-node",
    "type": "question",
    "label": "9",
    "prompt": "Let $a=\\log_6(3)$ and $b=\\log_6(4)$. Find the following in terms of $a$ and $b$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_6(48)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2b+a$",
          "worked": "$$\\begin{align*}\\log_6(48)&=\\log_6(4^2\\cdot3)\\\\\\log_6(48)&=2\\log_6(4)+\\log_6(3)\\\\\\log_6(48)&=2b+a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_6(8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3b}{2}$",
          "worked": "$$\\begin{align*}\\log_6(8)&=\\log_6(4^{3/2})\\\\\\log_6(8)&=\\frac32\\log_6(4)\\\\\\log_6(8)&=\\frac{3b}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_6(24)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3b}{2}+a$ or $1+b$",
          "worked": "$$\\begin{align*}\\log_6(24)&=\\log_6(8\\cdot3)\\\\\\log_6(24)&=\\log_6(8)+\\log_6(3)\\\\\\log_6(24)&=\\frac{3b}{2}+a\\end{align*}$$\nAlso, $24=6\\cdot4$, so $\\log_6(24)=\\log_6(6)+\\log_6(4)=1+b$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_6\\left(\\dfrac{2}{\\sqrt3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac b2-\\dfrac a2$",
          "worked": "$$\\begin{align*}\\log_6\\left(\\frac{2}{\\sqrt3}\\right)&=\\log_6(2)-\\log_6(\\sqrt3)\\\\\\log_6\\left(\\frac{2}{\\sqrt3}\\right)&=\\frac12\\log_6(4)-\\frac12\\log_6(3)\\\\\\log_6\\left(\\frac{2}{\\sqrt3}\\right)&=\\frac b2-\\frac a2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
