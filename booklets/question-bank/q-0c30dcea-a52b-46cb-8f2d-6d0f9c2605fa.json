  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Without expanding, simplify:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$1+3(x-1)+3(x-1)^2+(x-1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3$",
          "worked": "The coefficients $1,3,3,1$ match row 3 of Pascal's triangle.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}1+3(x-1)+3(x-1)^2+(x-1)^3\\\\&=(1+(x-1))^3\\\\&=x^3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p11-q4-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q4-b-expression",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "1-6(x+1)+15(x+1)^2-20(x+1)^3+15(x+1)^4-6(x+1)^5+(x+1)^6",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^6$",
          "worked": "The coefficients are row 6 of Pascal's triangle, with alternating signs.\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}1-6(x+1)+15(x+1)^2-20(x+1)^3+15(x+1)^4-6(x+1)^5+(x+1)^6\\\\&=(1-(x+1))^6\\\\&=(-x)^6\\\\&=x^6.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
