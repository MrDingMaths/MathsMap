  "content": {
    "id": "p58-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Chloe is running a tuck shop. She buys a pack of 12 chocolate bars for $\\$3.50$. Give percentage answers to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Chloe sells all the chocolate bars for 60c each. Work out her percentage profit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$105.71\\%$ profit. Total sales are $\\$7.20$; profit is $\\$3.70$.",
          "worked": "$$\\begin{align*}\\text{Total selling price}&=12\\times\\$0.60\\\\\\text{Total selling price}&=\\$7.20\\\\\\text{Profit}&=\\$7.20-\\$3.50\\\\\\text{Profit}&=\\$3.70\\\\\\text{Percentage profit}&=\\frac{3.70}{3.50}\\times100\\%\\\\\\text{Percentage profit}&\\approx105.71\\%\\end{align*}$$\nThe percentage profit is $105.71\\%$ to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p58-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Work out Chloe's percentage profit if she sells one third of the chocolate bars for 60c each and the rest for 30c each.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37.14\\%$ profit. Total sales: $4\\times\\$0.60+8\\times\\$0.30=\\$4.80$.",
          "worked": "$$\\begin{align*}\\text{Bars sold for 60c}&=\\frac13\\times12\\\\\\text{Bars sold for 60c}&=4\\\\\\text{Bars sold for 30c}&=12-4\\\\\\text{Bars sold for 30c}&=8\\\\\\text{Total selling price}&=4\\times\\$0.60+8\\times\\$0.30\\\\\\text{Total selling price}&=\\$4.80\\\\\\text{Profit}&=\\$4.80-\\$3.50\\\\\\text{Profit}&=\\$1.30\\\\\\text{Percentage profit}&=\\frac{1.30}{3.50}\\times100\\%\\\\\\text{Percentage profit}&\\approx37.14\\%\\end{align*}$$\nThe percentage profit is $37.14\\%$ to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
