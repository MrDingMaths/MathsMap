      {
        "id": "v2-tions-mixed-review-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=f(x)$ goes through $(5,-1)$ and the inverse function $f^{-1}$ exists. Find the value of $k$ such that $f^{-1}(k+3)=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-4$.",
          "worked": "Since $f(5)=-1$, apply $f$ to both sides.\n$$\\begin{align*}k+3&=f(5)\\\\k+3&=-1\\\\k&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-tions-mixed-review-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $f(x)=2x^3+1$. Solve the equation $f^{-1}(x)=-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-15$.",
          "worked": "$$\\begin{align*}f(f^{-1}(x))&=f(-2)\\\\x&=f(-2)\\\\x&=2(-2)^3+1\\\\x&=-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
