  "content": {
    "id": "p9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A pupil has 3 tickets in the class raffle. If there are 60 tickets in the raffle and one ticket is drawn, find the probability that the pupil:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "wins",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{20}$",
          "worked": "$$\\begin{align*}P(\\text{wins})&=\\frac{3}{60}\\\\P(\\text{wins})&=\\frac{1}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "does not win",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{20}$",
          "worked": "$$\\begin{align*}P(\\text{does not win})&=1-P(\\text{wins})\\\\P(\\text{does not win})&=1-\\frac{1}{20}\\\\P(\\text{does not win})&=\\frac{19}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
