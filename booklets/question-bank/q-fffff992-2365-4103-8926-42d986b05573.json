        "label": "a",
        "prompt": "$P(x)=3x^4-2x^2+x-3,\\quad D(x)=x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q17-short-result",
                "type": "paragraph",
                "fontSize": null,
