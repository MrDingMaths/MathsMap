                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(x)=(x+2)(3x^3-6x^2+10x-19)+35",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q17-short-method",
                "type": "paragraph",
