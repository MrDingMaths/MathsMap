  "content": {
    "id": "p52-q86-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=4x-x^2$. Find an expression for the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q86-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(3a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9a^2+12a$",
          "worked": "$$\\begin{align*}f(3a)&=4(3a)-(3a)^2\\\\f(3a)&=-9a^2+12a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p52-q86-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(1-2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4a^2-4a+3$",
          "worked": "$$\\begin{align*}f(1-2a)&=4(1-2a)-(1-2a)^2\\\\f(1-2a)&=4-8a-(1-4a+4a^2)\\\\f(1-2a)&=-4a^2-4a+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q86-c",
        "type": "part",
        "label": "c",
        "prompt": "$f\\left(\\dfrac{a-1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{a^2}{4}+\\dfrac{5a}{2}-\\dfrac{9}{4}$",
          "worked": "$$\\begin{align*}f\\left(\\dfrac{a-1}{2}\\right)&=4\\left(\\dfrac{a-1}{2}\\right)-\\left(\\dfrac{a-1}{2}\\right)^2\\\\f\\left(\\dfrac{a-1}{2}\\right)&=\\dfrac{8a-8-a^2+2a-1}{4}\\\\f\\left(\\dfrac{a-1}{2}\\right)&=-\\dfrac{a^2}{4}+\\dfrac{5a}{2}-\\dfrac{9}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p52-q86-d",
        "type": "part",
        "label": "d",
        "prompt": "$f\\left(a+\\dfrac{1}{a}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-a^2-\\dfrac{1}{a^2}+4a+\\dfrac{4}{a}-2$, where $a\\ne0$.",
          "worked": "The input requires $a\\ne0$.\n\n$$\\begin{align*}f\\left(a+\\dfrac{1}{a}\\right)&=4\\left(a+\\dfrac{1}{a}\\right)-\\left(a+\\dfrac{1}{a}\\right)^2\\\\f\\left(a+\\dfrac{1}{a}\\right)&=4a+\\dfrac{4}{a}-\\left(a^2+2+\\dfrac{1}{a^2}\\right)\\\\f\\left(a+\\dfrac{1}{a}\\right)&=-a^2-\\dfrac{1}{a^2}+4a+\\dfrac{4}{a}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
