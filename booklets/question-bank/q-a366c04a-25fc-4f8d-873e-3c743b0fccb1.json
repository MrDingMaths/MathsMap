        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Identify why the two triangles are similar",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At least two pairs of equal corresponding angles: the angle at $C$ is common, and corresponding angles are equal because $BD\\parallel AE$.",
          "worked": "$\\angle BCD=\\angle ACE$ (common angle) and $\\angle CBD=\\angle CAE$ (corresponding angles, $BD\\parallel AE$). Therefore $\\triangle CBD\\sim\\triangle CAE$, since at least two pairs of corresponding angles are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "find the value of $x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=12\\text{ cm}$",
          "worked": "$CE$ corresponds to $CD$, and $AE$ corresponds to $BD$.\n$$\\begin{align*}\\frac{x}{8}&=\\frac{7.5}{5}\\\\x&=8\\times\\frac{7.5}{5}\\\\x&=12\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ],
