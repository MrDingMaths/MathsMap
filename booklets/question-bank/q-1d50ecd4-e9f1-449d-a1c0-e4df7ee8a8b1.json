        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2+3x+10}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+4+\\dfrac{14}{x-1}$",
          "worked": "$$\\begin{align*}(x^2+3x+10)-x(x-1)&=4x+10\\\\(4x+10)-4(x-1)&=14\\\\\\frac{x^2+3x+10}{x-1}&=x+4+\\frac{14}{x-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
