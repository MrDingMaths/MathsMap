        "prompt": "$\\dfrac{x+4}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\dfrac{1}{x+3}$",
          "worked": "$$\\begin{align*}(x+4)-(x+3)&=1\\\\\\frac{x+4}{x+3}&=1+\\frac{1}{x+3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
