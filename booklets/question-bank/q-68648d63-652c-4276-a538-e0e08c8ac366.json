    "children": [
      {
        "id": "p19-q68",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{\\dfrac{1-\\sin\\theta}{1+\\sin\\theta}}=|\\sec\\theta-\\tan\\theta|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{\\dfrac{1-\\sin\\theta}{1+\\sin\\theta}}=|\\sec\\theta-\\tan\\theta|$, for $\\cos\\theta\\ne0$.\n\nMultiply inside the root by $\\dfrac{1-\\sin\\theta}{1-\\sin\\theta}$ and use $\\sqrt{u^2}=|u|$.",
          "worked": "For $\\cos\\theta\\ne0$,\n$$\\begin{align*}\n\\sqrt{\\frac{1-\\sin\\theta}{1+\\sin\\theta}}&=\\sqrt{\\frac{(1-\\sin\\theta)^2}{1-\\sin^2\\theta}}\\\\\n\\sqrt{\\frac{1-\\sin\\theta}{1+\\sin\\theta}}&=\\sqrt{\\left(\\frac{1-\\sin\\theta}{\\cos\\theta}\\right)^2}\\\\\n\\sqrt{\\frac{1-\\sin\\theta}{1+\\sin\\theta}}&=\\left|\\frac{1-\\sin\\theta}{\\cos\\theta}\\right|\\\\\n\\sqrt{\\frac{1-\\sin\\theta}{1+\\sin\\theta}}&=|\\sec\\theta-\\tan\\theta|.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p19-q69",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{\\dfrac{1+\\cos\\theta}{1-\\cos\\theta}}=|\\cot\\theta+\\operatorname{cosec}\\theta|$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{\\dfrac{1+\\cos\\theta}{1-\\cos\\theta}}=|\\cot\\theta+\\operatorname{cosec}\\theta|$, for $\\sin\\theta\\ne0$.\n\nMultiply inside the root by $\\dfrac{1+\\cos\\theta}{1+\\cos\\theta}$ and use $\\sqrt{u^2}=|u|$.",
          "worked": "For $\\sin\\theta\\ne0$,\n$$\\begin{align*}\n\\sqrt{\\frac{1+\\cos\\theta}{1-\\cos\\theta}}&=\\sqrt{\\frac{(1+\\cos\\theta)^2}{1-\\cos^2\\theta}}\\\\\n\\sqrt{\\frac{1+\\cos\\theta}{1-\\cos\\theta}}&=\\sqrt{\\left(\\frac{1+\\cos\\theta}{\\sin\\theta}\\right)^2}\\\\\n\\sqrt{\\frac{1+\\cos\\theta}{1-\\cos\\theta}}&=\\left|\\frac{1+\\cos\\theta}{\\sin\\theta}\\right|\\\\\n\\sqrt{\\frac{1+\\cos\\theta}{1-\\cos\\theta}}&=|\\cot\\theta+\\operatorname{cosec}\\theta|.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
