            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 12 p12-q5-a-diagram\"}\n\\begin{tikzpicture}[line width=.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,0) circle (1.5);\n\\draw[dashed,line width=.4pt] (0,0) ellipse (1.5 and .45);\n\\fill (0,0) circle (1.2pt);\n\\draw[dashed,line width=.4pt] (0,0)--(-.45,-.4293);\n\\path (0,0)--(-.45,-.4293) node[midway,right=2pt] {$r\\text{ cm}$};\n\\end{tikzpicture}",
