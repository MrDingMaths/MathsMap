    "type": "question",
    "label": "9",
    "prompt": "Show that $y=x^3$ is increasing for all values of $x$, apart from $x=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y'=3x^2>0$ for $x\\ne0$; at $x=0$, $y'=0$, so the curve is stationary.",
      "worked": "$$y'=3x^2$$\nFor $x\\ne0$, $x^2>0$, so $y'>0$. Hence the curve is increasing for $x<0$ and for $x>0$.\nAt $x=0$, $y'=0$, so the curve is stationary.",
      "solutionDiagrams": []
    },
