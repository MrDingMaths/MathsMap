        "id": "p11-q8",
        "type": "part",
        "label": "a",
        "prompt": "$A\\cup B$ means “at least one of $A$ or $B$ occurs”.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Union includes outcomes in $A$, in $B$, or in both. Therefore it means at least one of $A$ or $B$ occurs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p11-q9",
        "type": "part",
        "label": "b",
        "prompt": "$A\\cap B$ means “$A$ or $B$ occurs”.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. It means both $A$ and $B$ occur.",
          "worked": "Intersection contains outcomes common to both events, so $A\\cap B$ means both $A$ and $B$ occur. The statement uses the meaning of union.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p11-q10",
        "type": "part",
        "label": "c",
        "prompt": "$A\\cap\\overline B$ means “$A$ only”.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$A\\cap\\overline B$ requires $A$ to occur and $B$ not to occur. This is “$A$ only”.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
