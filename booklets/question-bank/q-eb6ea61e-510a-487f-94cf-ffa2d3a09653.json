  "content": {
    "id": "p19-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A rectangle has a length of $6\\text{ cm}$ and a width of $4\\text{ cm}$. A second rectangle has length $9\\text{ cm}$ and width $6\\text{ cm}$. Find the ratio of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "the lengths of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "$$\\begin{align*}\\text{Length ratio}&=6:9\\\\\\text{Length ratio}&=2:3\\end{align*}$$\nDivide both terms by $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "the widths of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "$$\\begin{align*}\\text{Width ratio}&=4:6\\\\\\text{Width ratio}&=2:3\\end{align*}$$\nDivide both terms by $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "the perimeters of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2:3$",
          "worked": "The perimeter of a rectangle is $2(l+w)$.\n\n$$\\begin{align*}P_1&=2(6+4)\\text{ cm}\\\\P_1&=20\\text{ cm}\\\\P_2&=2(9+6)\\text{ cm}\\\\P_2&=30\\text{ cm}\\\\\\text{Perimeter ratio}&=20:30\\\\\\text{Perimeter ratio}&=2:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p19-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "the areas of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4:9$\n\nCalculate each area using length × width, then simplify the ratio.",
          "worked": "The area of a rectangle is $lw$.\n\n$$\\begin{align*}A_1&=6\\times4\\text{ cm}^2\\\\A_1&=24\\text{ cm}^2\\\\A_2&=9\\times6\\text{ cm}^2\\\\A_2&=54\\text{ cm}^2\\\\\\text{Area ratio}&=24:54\\\\\\text{Area ratio}&=4:9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
