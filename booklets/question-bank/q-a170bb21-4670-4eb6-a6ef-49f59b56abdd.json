    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Convert these true bearings to angles of inclination.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$070^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20^{\\circ}$",
          "worked": "The direction is $70^{\\circ}$ clockwise from north, so it is above the positive $x$-axis.\n$$\\begin{align*}\\theta&=90^{\\circ}-70^{\\circ}\\\\\\theta&=20^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$270^{\\circ}$",
          "worked": "A bearing of $180^{\\circ}$ points south. Measure anticlockwise from the positive $x$-axis to south.\n$$\\begin{align*}\\theta&=360^{\\circ}-90^{\\circ}\\\\\\theta&=270^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$315^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135^{\\circ}$",
          "worked": "The direction is northwest, $45^{\\circ}$ anticlockwise from north.\n$$\\begin{align*}\\alpha&=360^{\\circ}-315^{\\circ}\\\\\\alpha&=45^{\\circ}\\\\\\theta&=90^{\\circ}+45^{\\circ}\\\\\\theta&=135^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
