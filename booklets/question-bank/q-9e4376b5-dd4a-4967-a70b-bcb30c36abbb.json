    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How many people participated in the survey?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50 people",
          "worked": "$$\\begin{align*}\\text{Total people}&=20+10+15+5+0\\\\\\text{Total people}&=50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the relative frequency of a participant watching less than 5 hours of television?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "$$\\begin{align*}rf&=\\frac{\\text{Frequency of less than 5 hours}}{\\text{Total people}}\\\\rf&=\\frac{20}{50}\\\\rf&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the relative frequency of a participant watching at least 5 but less than 20 hours of television?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Combine the $5\\le h<10$ and $10\\le h<20$ groups.\n$$\\begin{align*}rf&=\\frac{\\text{Frequency of at least 5 but less than 20 hours}}{\\text{Total people}}\\\\rf&=\\frac{10+15}{50}\\\\rf&=\\frac{25}{50}\\\\rf&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
