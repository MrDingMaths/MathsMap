  "content": {
    "id": "p43-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A motorist travels through eight sets of traffic lights, each of which is red or green. He is forced to stop at three sets of lights.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "In how many ways could this happen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56$",
          "worked": "Arrange 3 red and 5 green lights.\n$$\\frac{8!}{3!\\times5!}=56$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p43-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What other number of red lights would give an identical answer to part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 red lights.",
          "worked": "5 red and 3 green lights give the same count, since interchanging the colour counts leaves $\\frac{8!}{3!\\times5!}$ unchanged.",
          "solutionDiagrams": []
        },
