    "type": "question",
    "label": "8",
    "prompt": "Kathy is a scientist who is working in a remote part of Australia. She earns an annual salary of \\$86 840 plus a weekly allowance of \\$124.80 for working under extreme and isolated conditions. Calculate Kathy’s fortnightly pay.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$3589.60",
      "worked": "$$\\begin{align*}\\text{Fortnightly salary} &= 86\\,840\\div26 = \\$3340\\\\\\text{Fortnightly allowance} &= 124.80\\times2 = \\$249.60\\\\\\text{Fortnightly pay} &= 3340+249.60 = \\$3589.60\\end{align*}$$",
