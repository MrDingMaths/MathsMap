  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write down the domain for each function.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne-2$",
          "worked": "The denominator must not be zero.\n$$\\begin{align*}x+2&\\ne0\\\\x&\\ne-2\\end{align*}$$\nThe domain is all real numbers except $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1}{3x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne2$",
          "worked": "The denominator must not be zero.\n$$\\begin{align*}3x-6&\\ne0\\\\x&\\ne2\\end{align*}$$\nThe domain is all real numbers except $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{5-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le5$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}5-x&\\ge0\\\\x&\\le5\\end{align*}$$\nThe domain is $x\\le5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(x)=\\sqrt{2x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge2$",
          "worked": "The radicand must be non-negative.\n$$\\begin{align*}2x-4&\\ge0\\\\2x&\\ge4\\\\x&\\ge2\\end{align*}$$\nThe domain is $x\\ge2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$g(x)=\\dfrac{1}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne3$ and $x\\ne-3$",
          "worked": "The denominator must not be zero.\n$$\\begin{align*}x^2-9&=(x-3)(x+3)\\end{align*}$$\nIt is zero when $x=3$ or $x=-3$. The domain is all real numbers except $3$ and $-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p14-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\log_2(x+7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-7$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}x+7&>0\\\\x&>-7\\end{align*}$$\nThe domain is $x>-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=2^x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "$2^x$ is defined for every real $x$. Adding $6$ introduces no restriction, so the domain is all real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p14-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$h(x)=\\log_2(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\dfrac12$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}2x-1&>0\\\\2x&>1\\\\x&>\\frac12\\end{align*}$$\nThe domain is $x>\\dfrac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$h(x)=\\log_2(6-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<6$",
          "worked": "The logarithm's argument must be positive.\n$$\\begin{align*}6-x&>0\\\\x&<6\\end{align*}$$\nThe domain is $x<6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
