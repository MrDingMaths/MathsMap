  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "On average, 8% of mail is junk mail. Find the mean and variance of a Bernoulli distribution for receiving junk mail.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Mean $=0.08$; variance $=0.0736$.",
      "worked": "$$\\begin{aligned}p&=0.08\\\\E(X)&=p=0.08\\\\\\operatorname{Var}(X)&=p(1-p)\\\\\\operatorname{Var}(X)&=0.08(0.92)\\\\\\operatorname{Var}(X)&=0.0736\\end{aligned}$$",
      "solutionDiagrams": []
    },
