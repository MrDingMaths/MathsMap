    "children": [
      {
        "id": "p16-q3a",
        "type": "part",
        "label": "a",
        "prompt": "When $P(x)=ax^3+x^2-x+3$ is divided by $x-2$ the remainder is $3$. Find $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\frac14$.",
          "worked": "By the remainder theorem, $P(2)=3$.\n$$\\begin{align*}8a+4-2+3&=3\\\\8a+5&=3\\\\8a&=-2\\\\a&=-\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q3b",
        "type": "part",
        "label": "b",
        "prompt": "When $P(x)=x^3+ax^2-1$ is divided by $x-a$ the remainder is $1$. Find $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$.",
          "worked": "By the remainder theorem, $P(a)=1$.\n$$\\begin{align*}a^3+a(a^2)-1&=1\\\\2a^3-1&=1\\\\2a^3&=2\\\\a^3&=1\\\\a&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p16-q3c",
        "type": "part",
        "label": "c",
        "prompt": "When $P(x)=x^3+ax^2+bx+1$ is divided by $x-2$ the remainder is $2$, and when divided by $x+2$ the remainder is $-2$. Find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\frac14$, $b=-3$.\n\nUse $P(2)=2$ and $P(-2)=-2$ to form simultaneous equations.",
          "worked": "By the remainder theorem, $P(2)=2$ and $P(-2)=-2$.\n$$\\begin{align*}8+4a+2b+1&=2\\\\4a+2b&=-7\\\\-8+4a-2b+1&=-2\\\\4a-2b&=5\\end{align*}$$\nAdding the two simplified equations gives\n$$\\begin{align*}8a&=-2\\\\a&=-\\frac14\\end{align*}$$\nSubstituting into $4a+2b=-7$ gives\n$$\\begin{align*}4\\left(-\\frac14\\right)+2b&=-7\\\\-1+2b&=-7\\\\2b&=-6\\\\b&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
