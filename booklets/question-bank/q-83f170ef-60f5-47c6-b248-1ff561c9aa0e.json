        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{2(x+3)}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x+3}{2x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{2x+6}&=\\frac{x+3}{2(x+3)}\\\\&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{(x+3)(x+4)}{2x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{2}$",
          "worked": "$$\\begin{align*}\\frac{(x+3)(x+4)}{2x+6}&=\\frac{(x+3)(x+4)}{2(x+3)}\\\\&=\\frac{x+4}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{(x+3)(x+4)}{2x+8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{2}$",
          "worked": "$$\\begin{align*}\\frac{(x+3)(x+4)}{2x+8}&=\\frac{(x+3)(x+4)}{2(x+4)}\\\\&=\\frac{x+3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{x^2+7x+12}{2x+8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{2}$",
          "worked": "$$\\begin{align*}\\frac{x^2+7x+12}{2x+8}&=\\frac{(x+3)(x+4)}{2(x+4)}\\\\&=\\frac{x+3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{x^2+7x+12}{(x+4)(x-9)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{x-9}$",
          "worked": "$$\\begin{align*}\\frac{x^2+7x+12}{(x+4)(x-9)}&=\\frac{(x+3)(x+4)}{(x+4)(x-9)}\\\\&=\\frac{x+3}{x-9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{x^2+7x+12}{x^2-5x-36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{x-9}$",
          "worked": "$$\\begin{align*}\\frac{x^2+7x+12}{x^2-5x-36}&=\\frac{(x+3)(x+4)}{(x+4)(x-9)}\\\\&=\\frac{x+3}{x-9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{2x^2+14x+24}{x^2-5x-36}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x+3)}{x-9}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+14x+24}{x^2-5x-36}&=\\frac{2(x^2+7x+12)}{(x+4)(x-9)}\\\\&=\\frac{2(x+3)(x+4)}{(x+4)(x-9)}\\\\&=\\frac{2(x+3)}{x-9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q14-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{2x^2+14x+24}{3x^2-15x-108}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x+3)}{3(x-9)}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+14x+24}{3x^2-15x-108}&=\\frac{2(x^2+7x+12)}{3(x^2-5x-36)}\\\\&=\\frac{2(x+3)(x+4)}{3(x+4)(x-9)}\\\\&=\\frac{2(x+3)}{3(x-9)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q14-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{2x^2+14x+24}{3x^2+4x-15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x+4)}{3x-5}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+14x+24}{3x^2+4x-15}&=\\frac{2(x^2+7x+12)}{(3x-5)(x+3)}\\\\&=\\frac{2(x+3)(x+4)}{(3x-5)(x+3)}\\\\&=\\frac{2(x+4)}{3x-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q14-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\dfrac{14x-24-2x^2}{3x^2+4x-15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2(x-3)(x-4)}{(3x-5)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{14x-24-2x^2}{3x^2+4x-15}&=\\frac{-2(x^2-7x+12)}{(3x-5)(x+3)}\\\\&=-\\frac{2(x-3)(x-4)}{(3x-5)(x+3)}\\end{align*}$$\nThere are no common binomial factors to cancel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q14-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\dfrac{14x-24-2x^2}{3x^2-4x-15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2(x-4)}{3x+5}$",
          "worked": "$$\\begin{align*}\\frac{14x-24-2x^2}{3x^2-4x-15}&=\\frac{-2(x^2-7x+12)}{(3x+5)(x-3)}\\\\&=\\frac{-2(x-3)(x-4)}{(3x+5)(x-3)}\\\\&=-\\frac{2(x-4)}{3x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
