        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{2(x+3)}{x+3}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(x+3)}{2(x+3)}$",
        "layout": "list",
