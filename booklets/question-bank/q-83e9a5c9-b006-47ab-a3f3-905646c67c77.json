  "content": {
    "id": "p34-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "A parabola has equation $y=3(x+h)^2+4$ and $y$-intercept 7. Find the value of $h$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$h=1$ or $h=-1$.",
      "worked": "At the $y$-intercept, $x=0$ and $y=7$.\n$$\\begin{align*}7&=3(0+h)^2+4\\\\3h^2&=7-4\\\\h^2&=1\\\\h&=\\pm1\\end{align*}$$\nBoth values give a $y$-intercept of $3(1)+4=7$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
