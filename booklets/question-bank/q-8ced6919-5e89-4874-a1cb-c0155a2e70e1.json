    "type": "question",
    "label": "1",
    "prompt": "When Evelyn took $\\frac{3}{4}$ of the chocolates, there were four chocolates left in the box. How many chocolates did Evelyn take?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12 chocolates",
      "worked": "The four chocolates left represent $\\frac{1}{4}$ of the box. Evelyn took three such quarters.\n\n$$\\begin{align*}\\text{Fraction left}&=1-\\frac{3}{4}=\\frac{1}{4}\\\\\\text{Chocolates taken}&=3\\times4\\\\\\text{Chocolates taken}&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
