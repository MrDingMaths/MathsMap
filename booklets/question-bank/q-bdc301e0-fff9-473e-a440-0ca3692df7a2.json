  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "For parts (b) to (f) inclusive, express your answers in the form $y=mx+c$.\n\nFind the equation of the straight line with",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "gradient $m$ that passes through $(x_1,y_1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-y_1=m(x-x_1)$",
          "worked": "The change in $y$ equals the gradient multiplied by the change in $x$:\n$$y-y_1=m(x-x_1).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "gradient $2$ that passes through $(1,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+2$",
          "worked": "$$\\begin{align*}y-4&=2(x-1)\\\\y-4&=2x-2\\\\y&=2x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "gradient $-3$ that passes through $(2,-5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3x+1$",
          "worked": "$$\\begin{align*}y+5&=-3(x-2)\\\\y+5&=-3x+6\\\\y&=-3x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "gradient $-\\frac32$ that passes through $(-4,3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac32x-3$",
          "worked": "$$\\begin{align*}y-3&=-\\frac32(x+4)\\\\y-3&=-\\frac32x-6\\\\y&=-\\frac32x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p3-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "gradient $\\frac23$ that has an $x$-intercept of $-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac23x+\\frac43$",
          "worked": "The $x$-intercept gives the point $(-2,0)$.\n$$\\begin{align*}y-0&=\\frac23(x+2)\\\\y&=\\frac23x+\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "gradient $\\frac52$ that has a $y$-intercept of $1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac52x+1$",
          "worked": "Substitute $m=\\frac52$ and $c=1$ into $y=mx+c$:\n$$y=\\frac52x+1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
