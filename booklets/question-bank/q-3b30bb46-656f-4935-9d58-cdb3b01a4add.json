    "children": [
      {
        "id": "p27-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "centre $(-1,5)$, radius $4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2+(y-5)^2=16$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$:\n$$\\begin{align*}(x-(-1))^2+(y-5)^2&=4^2\\\\(x+1)^2+(y-5)^2&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p27-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "centre $(3,-5)$, radius $\\sqrt{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2+(y+5)^2=7$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$:\n$$\\begin{align*}(x-3)^2+(y-(-5))^2&=(\\sqrt{7})^2\\\\(x-3)^2+(y+5)^2&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p27-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(8,11)$, radius $2\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-8)^2+(y-11)^2=20$",
          "worked": "Using $(x-a)^2+(y-b)^2=r^2$:\n$$\\begin{align*}r^2&=(2\\sqrt{5})^2\\\\r^2&=20\\\\(x-8)^2+(y-11)^2&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
