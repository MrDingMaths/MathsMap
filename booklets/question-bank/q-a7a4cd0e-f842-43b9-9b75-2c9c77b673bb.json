    "children": [
      {
        "id": "p32-q2a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a$ and $b$ for which\n$$\\frac{1}{n(n+3)}=\\frac{a}{n}+\\frac{b}{n+3}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac13,\\quad b=-\\frac13$.",
          "worked": "Clearing denominators gives\n$$\\begin{align*}1&=a(n+3)+bn\\\\1&=3a+(a+b)n.\\end{align*}$$\nSetting $n=0$ in this polynomial identity gives $a=\\frac13$. Setting $n=-3$ gives $b=-\\frac13$. Therefore,\n$$\\frac{1}{n(n+3)}=\\frac13\\left(\\frac1n-\\frac1{n+3}\\right).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p32-q2b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, evaluate\n$$\\frac{1}{3\\times6}+\\frac{1}{6\\times9}+\\cdots+\\frac{1}{96\\times99}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{32}{297}$.",
          "worked": "Let $S$ denote the required sum. Using part (a),\n$$\\begin{align*}S&=\\frac13\\left[\\left(\\frac13-\\frac16\\right)+\\left(\\frac16-\\frac19\\right)+\\cdots+\\left(\\frac1{96}-\\frac1{99}\\right)\\right]\\\\S&=\\frac13\\left(\\frac13-\\frac1{99}\\right)\\\\S&=\\frac13\\cdot\\frac{32}{99}\\\\S&=\\frac{32}{297}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
