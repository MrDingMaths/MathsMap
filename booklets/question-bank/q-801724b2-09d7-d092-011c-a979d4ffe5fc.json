      {
        "id": "p26-q19-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{4x+3}{2}-\\frac{x+2}{5}=5.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{13}{6}$",
          "worked": "$$\\begin{align*}\\frac{5(4x+3)-2(x+2)}{10}&=5\\\\20x+15-2x-4&=50\\\\18x+11&=50\\\\18x&=39\\\\x&=\\frac{13}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p26-q20-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac2{x+2}+\\frac3{x-1}=\\frac{10}{(x+2)(x-1)}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac65$",
          "worked": "The original denominators require $x\\ne-2,1$.\n\n$$\\begin{align*}\\frac{2(x-1)+3(x+2)}{(x+2)(x-1)}&=\\frac{10}{(x+2)(x-1)}\\\\2(x-1)+3(x+2)&=10\\\\5x+4&=10\\\\5x&=6\\\\x&=\\frac65\\end{align*}$$\n\nThis value is permitted.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p26-q21-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac5{2x-1}-\\frac2{2x+1}=\\frac{2x}{4x^2-1}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac74$",
          "worked": "The original denominators require $x\\ne-\\frac12,\\frac12$.\n\n$$\\begin{align*}\\frac{5(2x+1)-2(2x-1)}{(2x-1)(2x+1)}&=\\frac{2x}{(2x-1)(2x+1)}\\\\5(2x+1)-2(2x-1)&=2x\\\\6x+7&=2x\\\\4x&=-7\\\\x&=-\\frac74\\end{align*}$$\n\nThis value is permitted.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
