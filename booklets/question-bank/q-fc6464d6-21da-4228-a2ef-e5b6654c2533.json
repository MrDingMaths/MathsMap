  "content": {
    "id": "p21-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "An irregular polygon has two interior angles of $120^{\\circ}$. All of its other interior angles are $165^{\\circ}$.\nFind the number of sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "18 sides",
      "worked": "The exterior angles are $180^{\\circ}-120^{\\circ}=60^{\\circ}$ (twice) and $180^{\\circ}-165^{\\circ}=15^{\\circ}$ for the others.\n$$\\begin{aligned}2(60)+15(n-2)&=360\\\\120+15(n-2)&=360\\\\15(n-2)&=240\\\\n-2&=16\\\\n&=18\\text{ sides}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
