  "content": {
    "id": "p36-q32-root",
    "type": "question",
    "label": "32",
    "prompt": "The limiting sum of a geometric series is $9\\frac{1}{3}$ and the common ratio is $\\frac{2}{5}$.\nFind the first term of the series.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=\\frac{28}{5}$",
      "worked": "$S_\\infty=\\frac{28}{3},\\quad r=\\frac{2}{5}$\n$$\\begin{aligned}S_\\infty&=\\frac{a}{1-r}\\\\\\frac{28}{3}&=\\frac{a}{1-\\frac{2}{5}}\\\\\\frac{28}{3}&=\\frac{a}{\\frac{3}{5}}\\\\\\frac{28}{3}&=\\frac{5a}{3}\\\\\\therefore\\ a&=\\frac{28}{5}\\end{aligned}$$",
      "solutionDiagrams": []
    },
