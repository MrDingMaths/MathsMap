  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the coordinates of the stationary points of each function.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-1)$",
          "worked": "$$y'=2x-2$$\nAt a stationary point, $y'=0$.\n$$\\begin{align*}2x-2&=0\\\\2x&=2\\\\x&=1\\\\y(1)&=1^2-2(1)\\\\y(1)&=-1\\end{align*}$$\nThe stationary point is $(1,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,-1)$",
          "worked": "$$y'=2x-4$$\nAt a stationary point, $y'=0$.\n$$\\begin{align*}2x-4&=0\\\\2x&=4\\\\x&=2\\\\y(2)&=2^2-4(2)+3\\\\y(2)&=-1\\end{align*}$$\nThe stationary point is $(2,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2+6x+9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3,0)$",
          "worked": "$$y'=2x+6$$\nAt a stationary point, $y'=0$.\n$$\\begin{align*}2x+6&=0\\\\2x&=-6\\\\x&=-3\\\\y(-3)&=(-3)^2+6(-3)+9\\\\y(-3)&=0\\end{align*}$$\nThe stationary point is $(-3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=2x^2-16x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4,-32)$",
          "worked": "$$y'=4x-16$$\nAt a stationary point, $y'=0$.\n$$\\begin{align*}4x-16&=0\\\\4x&=16\\\\x&=4\\\\y(4)&=2(4)^2-16(4)\\\\y(4)&=-32\\end{align*}$$\nThe stationary point is $(4,-32)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p16-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^3-3x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,0)$ and $(2,-4)$",
          "worked": "$$y'=3x^2-6x$$\nAt a stationary point, $y'=0$.\n$$\\begin{align*}3x^2-6x&=0\\\\3x(x-2)&=0\\\\x&=0\\text{ or }2\\\\y(0)&=0^3-3(0)^2\\\\y(0)&=0\\\\y(2)&=2^3-3(2)^2\\\\y(2)&=-4\\end{align*}$$\nThe stationary points are $(0,0)$ and $(2,-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p16-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x^3-12x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,16)$ and $(2,-16)$",
          "worked": "$$y'=3x^2-12$$\nAt a stationary point, $y'=0$.\n$$\\begin{align*}3x^2-12&=0\\\\x^2&=4\\\\x&=\\pm2\\\\y(-2)&=(-2)^3-12(-2)\\\\y(-2)&=16\\\\y(2)&=2^3-12(2)\\\\y(2)&=-16\\end{align*}$$\nThe stationary points are $(-2,16)$ and $(2,-16)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
