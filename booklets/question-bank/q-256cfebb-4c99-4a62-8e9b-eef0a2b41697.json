  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify each of the following, expressing your answers using positive indices:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{x^3}\\times\\sqrt[3]{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{13/6}$",
          "worked": "$$\\begin{align*}\\sqrt{x^3}\\times\\sqrt[3]{x^2}&=x^{3/2}\\times x^{2/3}\\\\\\sqrt{x^3}\\times\\sqrt[3]{x^2}&=x^{3/2+2/3}\\\\\\sqrt{x^3}\\times\\sqrt[3]{x^2}&=x^{13/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt[3]{xy}\\times\\sqrt{xy}\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{11/6}y^{5/6}$",
          "worked": "$$\\begin{align*}\\sqrt[3]{xy}\\times\\sqrt{xy}\\times x&=x^{1/3}y^{1/3}x^{1/2}y^{1/2}x\\\\\\sqrt[3]{xy}\\times\\sqrt{xy}\\times x&=x^{1/3+1/2+1}y^{1/3+1/2}\\\\\\sqrt[3]{xy}\\times\\sqrt{xy}\\times x&=x^{11/6}y^{5/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sqrt{x}}{x}\\times\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x^{1/6}}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{x}}{x}\\times\\sqrt[3]{x}&=\\frac{x^{1/2}}{x}\\times x^{1/3}\\\\\\frac{\\sqrt{x}}{x}\\times\\sqrt[3]{x}&=x^{1/2-1+1/3}\\\\\\frac{\\sqrt{x}}{x}\\times\\sqrt[3]{x}&=x^{-1/6}\\\\\\frac{\\sqrt{x}}{x}\\times\\sqrt[3]{x}&=\\frac{1}{x^{1/6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x}{\\sqrt[3]{x}}\\times\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{7/6}$",
          "worked": "$$\\begin{align*}\\frac{x}{\\sqrt[3]{x}}\\times\\sqrt{x}&=\\frac{x}{x^{1/3}}\\times x^{1/2}\\\\\\frac{x}{\\sqrt[3]{x}}\\times\\sqrt{x}&=x^{1-1/3+1/2}\\\\\\frac{x}{\\sqrt[3]{x}}\\times\\sqrt{x}&=x^{7/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\sqrt{xy}}{y}\\times\\sqrt[3]{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^{5/6}}{y^{1/6}}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{xy}}{y}\\times\\sqrt[3]{xy}&=\\frac{x^{1/2}y^{1/2}}{y}\\times x^{1/3}y^{1/3}\\\\\\frac{\\sqrt{xy}}{y}\\times\\sqrt[3]{xy}&=x^{1/2+1/3}y^{1/2-1+1/3}\\\\\\frac{\\sqrt{xy}}{y}\\times\\sqrt[3]{xy}&=x^{5/6}y^{-1/6}\\\\\\frac{\\sqrt{xy}}{y}\\times\\sqrt[3]{xy}&=\\frac{x^{5/6}}{y^{1/6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{\\sqrt{xy}}{x}\\times\\dfrac{y}{\\sqrt[3]{yx}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^{7/6}}{x^{5/6}}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{xy}}{x}\\times\\frac{y}{\\sqrt[3]{yx}}&=\\frac{x^{1/2}y^{1/2}}{x}\\times\\frac{y}{y^{1/3}x^{1/3}}\\\\\\frac{\\sqrt{xy}}{x}\\times\\frac{y}{\\sqrt[3]{yx}}&=x^{1/2-1-1/3}y^{1/2+1-1/3}\\\\\\frac{\\sqrt{xy}}{x}\\times\\frac{y}{\\sqrt[3]{yx}}&=x^{-5/6}y^{7/6}\\\\\\frac{\\sqrt{xy}}{x}\\times\\frac{y}{\\sqrt[3]{yx}}&=\\frac{y^{7/6}}{x^{5/6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{y^2}{\\sqrt{xy^3}}\\times\\dfrac{x}{\\sqrt[3]{x^2y}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^{1/6}}{x^{1/6}}$",
          "worked": "$$\\begin{align*}\\frac{y^2}{\\sqrt{xy^3}}\\times\\frac{x}{\\sqrt[3]{x^2y}}&=\\frac{y^2}{x^{1/2}y^{3/2}}\\times\\frac{x}{x^{2/3}y^{1/3}}\\\\\\frac{y^2}{\\sqrt{xy^3}}\\times\\frac{x}{\\sqrt[3]{x^2y}}&=x^{1-1/2-2/3}y^{2-3/2-1/3}\\\\\\frac{y^2}{\\sqrt{xy^3}}\\times\\frac{x}{\\sqrt[3]{x^2y}}&=x^{-1/6}y^{1/6}\\\\\\frac{y^2}{\\sqrt{xy^3}}\\times\\frac{x}{\\sqrt[3]{x^2y}}&=\\frac{y^{1/6}}{x^{1/6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p12-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x}{x^2\\sqrt{y^3}}\\times\\dfrac{y\\sqrt[3]{x^2}}{\\sqrt[3]{y}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x^{1/3}y^{5/6}}$",
          "worked": "$$\\begin{align*}\\frac{x}{x^2\\sqrt{y^3}}\\times\\frac{y\\sqrt[3]{x^2}}{\\sqrt[3]{y}}&=\\frac{x}{x^2y^{3/2}}\\times\\frac{yx^{2/3}}{y^{1/3}}\\\\\\frac{x}{x^2\\sqrt{y^3}}\\times\\frac{y\\sqrt[3]{x^2}}{\\sqrt[3]{y}}&=x^{1-2+2/3}y^{1-3/2-1/3}\\\\\\frac{x}{x^2\\sqrt{y^3}}\\times\\frac{y\\sqrt[3]{x^2}}{\\sqrt[3]{y}}&=x^{-1/3}y^{-5/6}\\\\\\frac{x}{x^2\\sqrt{y^3}}\\times\\frac{y\\sqrt[3]{x^2}}{\\sqrt[3]{y}}&=\\frac{1}{x^{1/3}y^{5/6}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
