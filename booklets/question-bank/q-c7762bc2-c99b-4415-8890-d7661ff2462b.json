    "id": "p19-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Use first principles differentiation to find the derivative function $f'(x)$ for $x^2+10$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f'(x)=2x$",
      "worked": "$$\\begin{aligned}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\&=\\lim_{h\\to0}\\frac{(x+h)^2+10-(x^2+10)}{h}\\\\&=\\lim_{h\\to0}\\frac{2xh+h^2}{h}\\\\&=\\lim_{h\\to0}(2x+h)\\\\&=2x\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
