  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Using the area model, or otherwise, expand these expressions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-paired-parts",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q10-a",
            "type": "part",
            "label": "a",
            "prompt": "$(x+1)(x^2+x+1)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^3+2x^2+2x+1$",
              "worked": "$$\\begin{align*}(x+1)(x^2+x+1)&=x(x^2+x+1)+(x^2+x+1)\\\\&=x^3+x^2+x+x^2+x+1\\\\&=x^3+2x^2+2x+1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p7-q10-b",
            "type": "part",
            "label": "b",
            "prompt": "$(x-2)(x^2-x+3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^3-3x^2+5x-6$",
              "worked": "$$\\begin{align*}(x-2)(x^2-x+3)&=x(x^2-x+3)-2(x^2-x+3)\\\\&=x^3-x^2+3x-2x^2+2x-6\\\\&=x^3-3x^2+5x-6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p7-q10-c",
            "type": "part",
            "label": "c",
            "prompt": "$(2x+1)(2x^2-x+4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4x^3+7x+4$",
              "worked": "$$\\begin{align*}(2x+1)(2x^2-x+4)&=2x(2x^2-x+4)+(2x^2-x+4)\\\\&=4x^3-2x^2+8x+2x^2-x+4\\\\&=4x^3+7x+4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p7-q10-d",
            "type": "part",
            "label": "d",
            "prompt": "$(x^2-x+1)(x+3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^3+2x^2-2x+3$",
              "worked": "$$\\begin{align*}(x^2-x+1)(x+3)&=x^2(x+3)-x(x+3)+(x+3)\\\\&=x^3+3x^2-x^2-3x+x+3\\\\&=x^3+2x^2-2x+3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p7-q10-e",
            "type": "part",
            "label": "e",
            "prompt": "$(5x^2-x+2)(2x-3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10x^3-17x^2+7x-6$",
              "worked": "$$\\begin{align*}(5x^2-x+2)(2x-3)&=5x^2(2x-3)-x(2x-3)+2(2x-3)\\\\&=10x^3-15x^2-2x^2+3x+4x-6\\\\&=10x^3-17x^2+7x-6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p7-q10-f",
            "type": "part",
            "label": "f",
            "prompt": "$(2x^2-x+7)(4x-7)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8x^3-18x^2+35x-49$",
              "worked": "$$\\begin{align*}(2x^2-x+7)(4x-7)&=2x^2(4x-7)-x(4x-7)+7(4x-7)\\\\&=8x^3-14x^2-4x^2+7x+28x-49\\\\&=8x^3-18x^2+35x-49\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p7-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$(x+1)(x+2)(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+6x^2+11x+6$",
          "worked": "$$\\begin{align*}(x+1)(x+2)(x+3)&=(x^2+3x+2)(x+3)\\\\&=x^2(x+3)+3x(x+3)+2(x+3)\\\\&=x^3+3x^2+3x^2+9x+2x+6\\\\&=x^3+6x^2+11x+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
