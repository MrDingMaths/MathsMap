  "content": {
    "id": "p25-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write in the form $(x+a)^2+c$ by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac32\\right)^2-\\frac54$",
          "worked": "$a=\\frac32$.\n$$\\begin{align*}x^2+3x+1&=x^2+3x+\\left(\\frac32\\right)^2-\\left(\\frac32\\right)^2+1\\\\&=\\left(x+\\frac32\\right)^2-\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x-\\frac32\\right)^2-\\frac54$",
          "worked": "$a=-\\frac32$.\n$$\\begin{align*}x^2-3x+1&=x^2-3x+\\left(-\\frac32\\right)^2-\\left(-\\frac32\\right)^2+1\\\\&=\\left(x-\\frac32\\right)^2-\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+5x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac52\\right)^2-\\frac{21}{4}$",
          "worked": "$a=\\frac52$.\n$$\\begin{align*}x^2+5x+1&=x^2+5x+\\left(\\frac52\\right)^2-\\left(\\frac52\\right)^2+1\\\\&=\\left(x+\\frac52\\right)^2-\\frac{21}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x-\\frac52\\right)^2-\\frac94$",
          "worked": "$a=-\\frac52$.\n$$\\begin{align*}x^2-5x+4&=x^2-5x+\\left(-\\frac52\\right)^2-\\left(-\\frac52\\right)^2+4\\\\&=\\left(x-\\frac52\\right)^2-\\frac94\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+7x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac72\\right)^2-\\frac{45}{4}$",
          "worked": "$a=\\frac72$.\n$$\\begin{align*}x^2+7x+1&=x^2+7x+\\left(\\frac72\\right)^2-\\left(\\frac72\\right)^2+1\\\\&=\\left(x+\\frac72\\right)^2-\\frac{45}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p26-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2+9x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac92\\right)^2-\\frac{89}{4}$",
          "worked": "$a=\\frac92$.\n$$\\begin{align*}x^2+9x-2&=x^2+9x+\\left(\\frac92\\right)^2-\\left(\\frac92\\right)^2-2\\\\&=\\left(x+\\frac92\\right)^2-\\frac{89}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
