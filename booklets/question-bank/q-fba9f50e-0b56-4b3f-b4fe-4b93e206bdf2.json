  "content": {
    "id": "p54-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Ann, Beatrice, and Collie are sharing money in the ratio $2:3:7$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of the money does Beatrice get?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\text{Total parts}&=2+3+7\\\\&=12\\\\\\text{Beatrice's fraction}&=\\frac{3}{12}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p54-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "If the total amount of money shared is $\\$240$, how much does Collie get?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$140$",
          "worked": "There are $2+3+7=12$ parts altogether.\n$$\\begin{align*}12\\text{ parts}&=\\$240\\\\1\\text{ part}&=\\$240\\div12\\\\&=\\$20\\\\7\\text{ parts}&=\\$20\\times7\\\\&=\\$140\\end{align*}$$\nCollie gets $\\$140$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p54-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "If Beatrice gets $\\$90$, how much does Ann get?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$60$",
          "worked": "$$\\begin{align*}3\\text{ parts}&=\\$90\\\\1\\text{ part}&=\\$90\\div3\\\\&=\\$30\\\\2\\text{ parts}&=\\$30\\times2\\\\&=\\$60\\end{align*}$$\nAnn gets $\\$60$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p54-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "If Collie gets $\\$20$ more than Beatrice, how much does Ann get?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10$. The difference is $7-3=4$ parts, so one part is $\\$5$.",
          "worked": "The difference between Collie's and Beatrice's shares is $7-3=4$ parts.\n$$\\begin{align*}4\\text{ parts}&=\\$20\\\\1\\text{ part}&=\\$20\\div4\\\\&=\\$5\\\\2\\text{ parts}&=\\$5\\times2\\\\&=\\$10\\end{align*}$$\nAnn gets $\\$10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
