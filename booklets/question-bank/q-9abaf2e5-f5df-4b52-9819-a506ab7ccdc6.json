  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise each of the following expressions:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)$",
          "worked": "$$\\begin{align*}x^2-9&=x^2-3^2\\\\x^2-9&=(x-3)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)(x+5)$",
          "worked": "$$\\begin{align*}x^2-25&=x^2-5^2\\\\x^2-25&=(x-5)(x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$9m^2-4n^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3m-2n)(3m+2n)$",
          "worked": "$$\\begin{align*}9m^2-4n^2&=(3m)^2-(2n)^2\\\\9m^2-4n^2&=(3m-2n)(3m+2n)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$4a^2-25b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2a-5b)(2a+5b)$",
          "worked": "$$\\begin{align*}4a^2-25b^2&=(2a)^2-(5b)^2\\\\4a^2-25b^2&=(2a-5b)(2a+5b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$36x^2-49y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6x-7y)(6x+7y)$",
          "worked": "$$\\begin{align*}36x^2-49y^2&=(6x)^2-(7y)^2\\\\36x^2-49y^2&=(6x-7y)(6x+7y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$3n^2-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(n-2)(n+2)$",
          "worked": "$$\\begin{align*}3n^2-12&=3(n^2-4)\\\\3n^2-12&=3(n^2-2^2)\\\\3n^2-12&=3(n-2)(n+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$8n^2-50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(2n-5)(2n+5)$",
          "worked": "$$\\begin{align*}8n^2-50&=2(4n^2-25)\\\\8n^2-50&=2\\bigl((2n)^2-5^2\\bigr)\\\\8n^2-50&=2(2n-5)(2n+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$16b^2-\\frac19$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(4b-\\frac13\\right)\\left(4b+\\frac13\\right)$",
          "worked": "$$\\begin{align*}16b^2-\\frac19&=(4b)^2-\\left(\\frac13\\right)^2\\\\16b^2-\\frac19&=\\left(4b-\\frac13\\right)\\left(4b+\\frac13\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$4b^2-\\frac4{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(2b-\\frac25\\right)\\left(2b+\\frac25\\right)$",
          "worked": "$$\\begin{align*}4b^2-\\frac4{25}&=(2b)^2-\\left(\\frac25\\right)^2\\\\4b^2-\\frac4{25}&=\\left(2b-\\frac25\\right)\\left(2b+\\frac25\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{n^2}{4}-\\frac49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac n2-\\frac23\\right)\\left(\\frac n2+\\frac23\\right)$",
          "worked": "$$\\begin{align*}\\frac{n^2}{4}-\\frac49&=\\left(\\frac n2\\right)^2-\\left(\\frac23\\right)^2\\\\\\frac{n^2}{4}-\\frac49&=\\left(\\frac n2-\\frac23\\right)\\left(\\frac n2+\\frac23\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$x^2-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-\\sqrt5)(x+\\sqrt5)$",
          "worked": "$$\\begin{align*}x^2-5&=x^2-(\\sqrt5)^2\\\\x^2-5&=(x-\\sqrt5)(x+\\sqrt5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$a^2-11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-\\sqrt{11})(a+\\sqrt{11})$",
          "worked": "$$\\begin{align*}a^2-11&=a^2-(\\sqrt{11})^2\\\\a^2-11&=(a-\\sqrt{11})(a+\\sqrt{11})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$4x^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-\\sqrt3)(2x+\\sqrt3)$",
          "worked": "$$\\begin{align*}4x^2-3&=(2x)^2-(\\sqrt3)^2\\\\4x^2-3&=(2x-\\sqrt3)(2x+\\sqrt3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$(x-2)^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x-4)$",
          "worked": "$$\\begin{align*}(x-2)^2-4&=(x-2)^2-2^2\\\\(x-2)^2-4&=(x-2-2)(x-2+2)\\\\(x-2)^2-4&=x(x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q1-o",
        "type": "part",
        "label": "o",
        "prompt": "$(a-2)^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
