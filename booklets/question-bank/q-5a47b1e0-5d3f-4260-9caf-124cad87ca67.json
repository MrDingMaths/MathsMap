      {
        "id": "p9-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "List all the elements of set $D$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=\\{1,4,9,16,25,36,49\\}$",
          "worked": "The squares from $1$ to $50$ are $1^2,2^2,3^2,4^2,5^2,6^2,7^2$; $8^2=64$ is outside the universal set.\n\n$D=\\{1,4,9,16,25,36,49\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "List all the elements that are in both set $B$ and set $D$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B\\cap D=\\{4,16,36\\}$",
          "worked": "The even elements of $D$ are $4$, $16$ and $36$.\n\n$B\\cap D=\\{4,16,36\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why there are no elements that are listed in both set $A$ and set $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All multiples of 10 are even, but $A$ contains only odd numbers.",
          "worked": "Every multiple of $10$ is even, whereas every element of $A$ is odd. No number can be both odd and even, so $A\\cap C=\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "List the elements that are in set $C$ or $D$ or both.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C\\cup D=\\{1,4,9,10,16,20,25,30,36,40,49,50\\}$",
          "worked": "$C=\\{10,20,30,40,50\\}$\n\n$D=\\{1,4,9,16,25,36,49\\}$\n\nThe union contains every element in either set, listed once.\n\n$C\\cup D=\\{1,4,9,10,16,20,25,30,36,40,49,50\\}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
