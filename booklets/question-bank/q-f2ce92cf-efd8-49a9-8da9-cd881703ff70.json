  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p8-q5-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "In a small business, the seven employees earn the following wages per week:",
              "marks": []
            }
          ]
        },
        {
          "id": "p8-q5-wages",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "$300, $490, $520, $590, $660, $680, $970",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the population standard deviation for this set of data, rounded to the nearest dollar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$191$",
          "worked": "Enter the seven wages in the calculator's 1-variable statistics mode and select population standard deviation $\\sigma_x$.\n$$\\begin{aligned}\\sigma_x &\\approx \\$191.0443906\\\\&\\approx \\$191\\quad\\text{(nearest dollar)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Each employee receives a $\\$20$ pay increase.\nExplain the effect that this increase will have on the standard deviation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Unchanged; the spread of the wages is unchanged.",
          "worked": "Every wage and the mean increase by $\\$20$, so each wage's distance from the mean stays the same. The standard deviation is unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q5-root-bank-p8-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Instead of the $\\$20$ increase, every employee receives a 10% pay rise. Calculate the new population standard deviation to the nearest dollar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$210$",
          "worked": "Enter the new wages \\$330, \\$539, \\$572, \\$649, \\$726, \\$748 and \\$1067 in the calculator's 1-variable statistics mode and select population standard deviation $\\sigma_x$.\n$$\\sigma_x \\approx \\$210.1488296 \\approx \\$210\\quad\\text{(nearest dollar)}$$\nMultiplying every wage by $1.1$ also multiplies the standard deviation by $1.1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q5-root-bank-p8-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Which pay rise gives the smaller standard deviation: $\\$20$ each or 10% each?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$20$ each.",
          "worked": "The $\\$20$ pay rise leaves the standard deviation at approximately $\\$191$. The 10% pay rise increases it to approximately $\\$210$, so $\\$20$ each gives the smaller standard deviation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
