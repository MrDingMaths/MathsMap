        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q5b",
        "type": "part",
        "label": "b",
        "prompt": "What is the gradient of the straight-line graph of $d$ against $t$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80$",
          "worked": "The gradient is the constant speed, so the gradient is $80$ (80 km per hour).",
