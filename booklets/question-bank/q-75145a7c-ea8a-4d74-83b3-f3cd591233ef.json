      {
        "id": "p5-q5a",
        "type": "part",
        "label": "a",
        "prompt": "What is the formula for the distance $d$ (in kilometres) travelled by the car in $t$ hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=80t$",
          "worked": "In 1 hour, the car travels 80 km. In 2 hours, it travels 160 km. Therefore, in $t$ hours, the distance in kilometres is $$d=80t.$$",
