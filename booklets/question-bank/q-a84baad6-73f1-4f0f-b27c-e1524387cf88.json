  "content": {
    "id": "p21-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify $f(-x)$ for each function, and hence determine whether it is even, odd or neither.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q6-a-node",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^2-9$. Even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2-9\\\\f(-x)&=x^2-9\\\\f(-x)&=f(x)\\end{align*}$$\nTherefore $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p21-q6-b-node",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2-6x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^2+6x+5$. Neither.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2-6(-x)+5\\\\f(-x)&=x^2+6x+5\\\\-f(x)&=-x^2+6x-5\\end{align*}$$\nThus $f(-x)$ equals neither $f(x)$ nor $-f(x)$ identically. The function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q6-c-node",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^3-25x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x^3+25x$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^3-25(-x)\\\\f(-x)&=-x^3+25x\\\\f(-x)&=-(x^3-25x)\\\\f(-x)&=-f(x)\\end{align*}$$\nTherefore $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q6-d-node",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^4-4x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^4-4x^2$. Even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^4-4(-x)^2\\\\f(-x)&=x^4-4x^2\\\\f(-x)&=f(x)\\end{align*}$$\nTherefore $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p21-q6-e-node",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=x^3+5x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x^3+5x^2$. Neither.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^3+5(-x)^2\\\\f(-x)&=-x^3+5x^2\\\\-f(x)&=-x^3-5x^2\\end{align*}$$\nThus $f(-x)$ equals neither $f(x)$ nor $-f(x)$ identically. The function is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q6-f-node",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=x^5-16x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x^5+16x$. Odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^5-16(-x)\\\\f(-x)&=-x^5+16x\\\\f(-x)&=-(x^5-16x)\\\\f(-x)&=-f(x)\\end{align*}$$\nTherefore $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
