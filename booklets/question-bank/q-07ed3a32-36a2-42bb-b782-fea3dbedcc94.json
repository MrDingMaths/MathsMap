  "content": {
    "id": "p72-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "There are 5 numbers: 3, 4, 5, 5 and 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p72-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "How many different arrangements can be made from the numbers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "The two 5s are identical.\n$$\\frac{5!}{2!}=60$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p72-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "How many arrangements form numbers greater than 40 000?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "The first digit must be 4, 5 or 6.\n\nFirst digit 4: $\\dfrac{4!}{2!}=12$.\n\nFirst digit 5: $4!=24$.\n\nFirst digit 6: $\\dfrac{4!}{2!}=12$.\n\nTotal: $12+24+12=48$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p72-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "How many form numbers less than 50 000?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "The first digit must be 3 or 4.\n\nFirst digit 3: $\\dfrac{4!}{2!}=12$.\n\nFirst digit 4: $\\dfrac{4!}{2!}=12$.\n\nTotal: $12+12=24$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p72-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "If an arrangement is made at random, find the probability that it is less than 40 000.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{5}$",
          "worked": "No arrangement equals 40 000, so the number less than 40 000 is the total minus the number greater than 40 000.\n$$60-48=12$$\n$$P(\\text{less than }40\\,000)=\\frac{12}{60}=\\frac15$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
