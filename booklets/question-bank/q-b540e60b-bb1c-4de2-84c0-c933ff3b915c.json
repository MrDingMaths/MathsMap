  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Suppose that the quadratic equation $x^2-kx-4x-35=0$ has the sum of roots being $2$.\nFind the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=-2$",
      "worked": "The equation is $x^2-(k+4)x-35=0$.\n$$\\begin{aligned}\\alpha+\\beta&=-\\frac{-(k+4)}{1}\\\\2&=k+4\\\\k&=-2\\end{aligned}$$",
      "solutionDiagrams": []
    },
