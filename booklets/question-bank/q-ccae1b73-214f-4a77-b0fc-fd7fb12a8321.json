        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{3}(x+3)+\\frac{x}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+12}{6}$",
          "worked": "$$\\begin{align*}\\frac23(x+3)+\\frac{x}{6}&=\\frac{2x}{3}+2+\\frac{x}{6}\\\\\\frac23(x+3)+\\frac{x}{6}&=\\frac{4x+12+x}{6}\\\\\\frac23(x+3)+\\frac{x}{6}&=\\frac{5x+12}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p15-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{4}(x+2)+\\frac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+6}{12}$",
          "worked": "$$\\begin{align*}\\frac14(x+2)+\\frac{x}{3}&=\\frac{x}{4}+\\frac12+\\frac{x}{3}\\\\\\frac14(x+2)+\\frac{x}{3}&=\\frac{3x+6+4x}{12}\\\\\\frac14(x+2)+\\frac{x}{3}&=\\frac{7x+6}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p15-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3}{5}(x-1)+\\frac{2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19x-9}{15}$",
          "worked": "$$\\begin{align*}\\frac35(x-1)+\\frac{2x}{3}&=\\frac{3x}{5}-\\frac35+\\frac{2x}{3}\\\\\\frac35(x-1)+\\frac{2x}{3}&=\\frac{9x-9+10x}{15}\\\\\\frac35(x-1)+\\frac{2x}{3}&=\\frac{19x-9}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p15-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5}{6}(x-4)+\\frac{3x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19x-40}{12}$",
          "worked": "$$\\begin{align*}\\frac56(x-4)+\\frac{3x}{4}&=\\frac{5x}{6}-\\frac{10}{3}+\\frac{3x}{4}\\\\\\frac56(x-4)+\\frac{3x}{4}&=\\frac{10x-40+9x}{12}\\\\\\frac56(x-4)+\\frac{3x}{4}&=\\frac{19x-40}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
