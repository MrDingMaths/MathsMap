    "type": "question",
    "label": "7",
    "prompt": "Which is larger? $\\frac{99}{100}$ or $\\frac{98}{99}$. Give reasons.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{99}{100}$ is larger: its distance from 1 is $\\frac{1}{100}$, which is smaller than $\\frac{1}{99}$.",
      "worked": "$$\\begin{align*}\\frac{99}{100}&=\\frac{9801}{9900}\\\\\\frac{98}{99}&=\\frac{9800}{9900}\\end{align*}$$\nSince $9801>9800$, $\\frac{99}{100}>\\frac{98}{99}$. Equivalently, $\\frac{99}{100}$ is closer to 1 because $\\frac{1}{100}<\\frac{1}{99}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
