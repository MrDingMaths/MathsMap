  "content": {
    "id": "p44-task-10-11-root",
    "type": "question",
    "label": null,
    "prompt": "Let $P(2,6)$ be a point on $y=f(x)$. Find the new coordinates of $P$ on the graph of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q10",
        "type": "part",
        "label": "a",
        "prompt": "$y=3f(x-4)+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(6,20)$",
          "worked": "Translate right 4 units, dilate vertically by factor 3, then translate up 2 units.\n$$\\begin{align*}x_{\\mathrm{new}}&=2+4=6\\\\y_{\\mathrm{new}}&=3\\times6+2=20\\end{align*}$$\nThe new point is $(6,20)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p44-q11",
        "type": "part",
        "label": "b",
        "prompt": "$y=-f(x+2)+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-5)$",
          "worked": "Translate left 2 units, reflect in the $x$-axis, then translate up 1 unit.\n$$\\begin{align*}x_{\\mathrm{new}}&=2-2=0\\\\y_{\\mathrm{new}}&=-6+1=-5\\end{align*}$$\nThe new point is $(0,-5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
