  "content": {
    "id": "p9-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Four dice are rolled and the product of the numbers is recorded. Find the probability that at least one six is rolled.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{671}{1296}$",
      "worked": "Let $A$ be the event that at least one six is rolled. Its complement $A'$ is the event that no sixes are rolled. Each die has probability $\\frac{5}{6}$ of not showing six, and the rolls are independent.\n\n$$\\begin{align*}\\Pr(A')&=\\left(\\frac{5}{6}\\right)^4\\\\\\Pr(A')&=\\frac{625}{1296}\\\\\\Pr(A)&=1-\\frac{625}{1296}\\\\\\Pr(A)&=\\frac{671}{1296}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
