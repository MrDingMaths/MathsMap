  "content": {
    "id": "v2-3cf9e-p17-practice-slot-4-lower-root",
    "type": "question",
    "label": null,
    "prompt": "An irregular polygon has two exterior angles of $90^{\\circ}$.\nIf the other exterior angles are $30^{\\circ}$, find the number of sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "8 sides.",
      "worked": "Let $n$ be the number of sides.\n$$\\begin{align*}2(90)+30(n-2)&=360\\\\180+30(n-2)&=360\\\\30(n-2)&=180\\\\n-2&=6\\\\n&=8\\end{align*}$$\nThe polygon has 8 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
