  "content": {
    "id": "p32-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Show that these functions are odd:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=2x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-2x^3=-f(x)$, so $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=2(-x)^3\\\\f(-x)&=-2x^3\\\\f(-x)&=-f(x).\\end{align*}$$ Hence, $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=4x-3x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-(4x-3x^3)=-f(x)$, so $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=4(-x)-3(-x)^3\\\\f(-x)&=-4x+3x^3\\\\f(-x)&=-(4x-3x^3)\\\\f(-x)&=-f(x).\\end{align*}$$ Hence, $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q2c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x(x-1)(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x(x+1)(x-1)=-f(x)$, so $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)(-x-1)(-x+1)\\\\f(-x)&=(-x)[-(x+1)][-(x-1)]\\\\f(-x)&=-x(x+1)(x-1)\\\\f(-x)&=-f(x).\\end{align*}$$ Hence, $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p33-q2d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-\\sqrt[3]{x}=-f(x)$, so $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=\\sqrt[3]{-x}\\\\f(-x)&=-\\sqrt[3]{x}\\\\f(-x)&=-f(x).\\end{align*}$$ Hence, $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q2e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=x\\cos(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x\\cos x=-f(x)$, so $f$ is odd.",
          "worked": "Since $\\cos(-x)=\\cos x$,\n$$\\begin{align*}f(-x)&=(-x)\\cos(-x)\\\\f(-x)&=-x\\cos x\\\\f(-x)&=-f(x).\\end{align*}$$ Hence, $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p33-q2f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=x|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=-x|x|=-f(x)$, so $f$ is odd.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)|-x|\\\\f(-x)&=-x|x|\\\\f(-x)&=-f(x).\\end{align*}$$ Hence, $f$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
