          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{array}{cccccccc}1&2&3&4&5&6&7&\\cdots\\\\\\downarrow&\\downarrow&\\downarrow&\\downarrow&\\downarrow&\\downarrow&\\downarrow&\\\\0&-1&1&-2&2&-3&3&\\cdots\\end{array}",
              "display": true
            }
          ]
        }
