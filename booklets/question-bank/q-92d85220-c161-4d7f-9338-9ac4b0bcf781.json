              "type": "text",
              "text": "In this section we illustrated an example of a bijection ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f:\\mathbb N\\to\\mathbb Z",
              "display": false
            },
            {
              "type": "text",
              "text": ",",
              "marks": []
            }
          ]
        },
        {
          "id": "p38-q7-mapping",
