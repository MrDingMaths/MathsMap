    "answer": {
      "short": "$4\\sqrt3$",
      "worked": "$$\\begin{align*}\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}&=\\sqrt{25\\times3}-2\\sqrt{4\\times3}+\\sqrt{9\\times3}\\\\\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}&=5\\sqrt3-4\\sqrt3+3\\sqrt3\\\\\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}&=4\\sqrt3.\\end{align*}$$",
      "solutionDiagrams": []
