  "content": {
    "id": "v2-e2837-p32-practice-j3-081428-root",
    "type": "question",
    "label": null,
    "prompt": "A continuous random variable $X$ has PDF\n$$f(x)=\\begin{cases}\\dfrac{x}{8},&0\\le x\\le2,\\\\[4pt]\\dfrac{6-x}{8},&2<x\\le4.\\end{cases}$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-e2837-p32-practice-j3-081428-bridge-piecewise-cdf-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $F(x)$ for $0\\le x\\le2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{x^2}{16}$",
          "worked": "$$\\begin{align*}F(x)&=\\int_0^x\\frac{t}{8}\\,dt\\\\&=\\left[\\frac{t^2}{16}\\right]_0^x\\\\&=\\frac{x^2}{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-e2837-p32-practice-j3-081428-bridge-piecewise-cdf-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $F(2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(2)=\\dfrac14$",
          "worked": "$$\\begin{align*}F(2)&=\\frac{2^2}{16}\\\\&=\\frac14.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-e2837-p32-practice-j3-081428-bridge-piecewise-cdf-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $F(x)$ for $2<x\\le4$ by adding $F(2)$ to $\\displaystyle\\int_2^x f(t)\\,dt$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=-\\dfrac{x^2}{16}+\\dfrac{3x}{4}-1$",
          "worked": "$$\\begin{align*}F(x)&=F(2)+\\int_2^x\\frac{6-t}{8}\\,dt\\\\&=\\frac14+\\frac18\\left[6t-\\frac{t^2}{2}\\right]_2^x\\\\&=\\frac14+\\frac18\\left(6x-\\frac{x^2}{2}-10\\right)\\\\&=-\\frac{x^2}{16}+\\frac{3x}{4}-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-e2837-p32-practice-j3-081428-bridge-piecewise-cdf-d",
        "type": "part",
        "label": "d",
        "prompt": "Use the CDF to find $P(1<X<3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac58$",
          "worked": "$$\\begin{align*}P(1<X<3)&=F(3)-F(1)\\\\&=\\left(-\\frac9{16}+\\frac94-1\\right)-\\frac1{16}\\\\&=\\frac{11}{16}-\\frac1{16}\\\\&=\\frac58.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
