  "content": {
    "id": "p55-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A carpenter programs a wood lathe to carve out a bowl according to the formula $d=\\frac{1}{3}x^2-27$.\n\nAll dimensions are in centimetres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph for $-9\\leq x\\leq9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p55-q3-a-axes",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 55 p55-q3-a-axes\"}\n\\begin{tikzpicture}[x=1mm,y=1mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-30,0)--(30,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-29)--(0,29) node[above] {$d$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 70,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 55,
              "sourceRegion": "Question 3(a), blank coordinate axes",
              "description": "Blank perpendicular double-ended axes without ticks, scale, origin label or curve. Vertical label corrected from y to d to match the model.",
              "mathematics": "Horizontal variable x; vertical variable d. No supplied numerical scale.",
              "answerVisibility": "Blank student sketching scaffold."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "Concave up, with vertex $(0,-27)$ and intercepts $(-9,0)$ and $(9,0)$; retain only $-9\\leq x\\leq9$.",
          "worked": "The coefficient of $x^2$ is positive, so the parabola is concave up. At $x=0$,\n$$\\begin{align*}d&=\\frac13(0)^2-27\\\\d&=-27.\\end{align*}$$\nLet $d=0$.\n$$\\begin{align*}0&=\\frac13x^2-27\\\\x^2&=81\\\\x&=\\pm9.\\end{align*}$$\nPlot $(-9,0)$, $(0,-27)$ and $(9,0)$, then draw the symmetric curve over the stated domain.",
          "solutionDiagrams": [
            {
              "id": "p55-q3-a-solution",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 55 p55-q3-a-solution\"}\n\\begin{tikzpicture}[x=2.5mm,y=1.3mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-11,0)--(11,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-34)--(0,7) node[above] {$d$};\n\\draw[line width=0.8pt,domain=-9:9,samples=81] plot (\\x,{\\x*\\x/3-27});\n\\fill (-9,0) circle (1.3pt) node[above] {$(-9,0)$};\n\\fill (9,0) circle (1.3pt) node[above] {$(9,0)$};\n\\fill (0,-27) circle (1.3pt) node[below right] {$(0,-27)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 65,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 55,
                "sourceRegion": "Question 3(a), authored completed sketch",
                "description": "Complete bounded upward parabola with labelled endpoints and vertex; no continuation arrows on the bounded curve.",
                "mathematics": "d=x^2/3-27 for -9≤x≤9, vertex (0,-27), endpoints (-9,0) and (9,0).",
                "answerVisibility": "Answer editions only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p55-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the breadth of the bowl?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18\\text{ cm}$",
          "worked": "The rim endpoints have $x=-9$ and $x=9$.\n$$\\begin{align*}\\text{Breadth}&=9-(-9)\\\\\\text{Breadth}&=18\\text{ cm}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p55-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the maximum depth of the bowl?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27\\text{ cm}$",
          "worked": "The lowest point is the vertex $(0,-27)$, and the rim is at $d=0$.\n$$\\begin{align*}\\text{Depth}&=0-(-27)\\\\\\text{Depth}&=27\\text{ cm}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
