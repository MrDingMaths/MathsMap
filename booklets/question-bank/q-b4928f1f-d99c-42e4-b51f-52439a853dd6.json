            "inlines": [
              {
                "type": "text",
                "text": "Use ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=\\frac{\\sin^2\\theta}{\\cos\\theta}",
                "display": false
              },
              {
                "type": "text",
                "text": ", ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "b=\\frac{\\cos^2\\theta}{\\sin\\theta}",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\sin^6\\theta+\\cos^6\\theta=1-3\\sin^2\\theta\\cos^2\\theta",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
