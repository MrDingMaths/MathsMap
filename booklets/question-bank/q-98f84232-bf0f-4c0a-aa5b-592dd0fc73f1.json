  "content": {
    "id": "p13-q5",
    "type": "question",
    "label": "5",
    "prompt": "A triangle that has an area of $7\\text{ m}^2$ and height $5\\text{ m}$ more than its base.\nFind the height and base lengths.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Height $7\\text{ m}$; base $2\\text{ m}$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "ff7892f4-deca-4e0f-a87a-b40de5bc2f1f-compact-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": " be the base length in metres. The height is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(x+5)\\text{ m}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "ff7892f4-deca-4e0f-a87a-b40de5bc2f1f-compact-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\frac12x(x+5)&=7\\\\x(x+5)&=14\\\\x^2+5x-14&=0\\\\(x+7)(x-2)&=0\\\\x&=-7\\text{ or }2\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "ff7892f4-deca-4e0f-a87a-b40de5bc2f1f-compact-2",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Reject ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=-7",
                "display": false
              },
              {
                "type": "text",
                "text": " because a length must be positive. The base is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2\\text{ m}",
                "display": false
              },
              {
                "type": "text",
                "text": " and the height is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2+5=7\\text{ m}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "ff7892f4-deca-4e0f-a87a-b40de5bc2f1f-compact-3",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.25,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Check: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac12\\times2\\times7=7\\text{ m}^2",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
