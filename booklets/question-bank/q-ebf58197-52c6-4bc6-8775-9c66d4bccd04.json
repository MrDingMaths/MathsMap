  "content": {
    "id": "p16-review-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $x=\\frac{-b+\\sqrt{b^2-4ac}}{2a}$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-review-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $x$ if $b=4$, $a=1$ and $c=-24$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2+2\\sqrt7$",
          "worked": "$$\\begin{align*}x&=\\frac{-4+\\sqrt{4^2-4\\times1\\times(-24)}}{2\\times1}\\\\x&=\\frac{-4+\\sqrt{112}}{2}\\\\x&=\\frac{-4+4\\sqrt7}{2}\\\\x&=-2+2\\sqrt7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p16-review-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $c$ if $a=1$, $x=6$ and $b=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=-48$.\n\nIsolate the square root, square both sides, then solve for $c$.",
          "worked": "$$\\begin{align*}6&=\\frac{-2+\\sqrt{2^2-4\\times1\\times c}}{2\\times1}\\\\12&=-2+\\sqrt{4-4c}\\\\14&=\\sqrt{4-4c}\\\\196&=4-4c\\\\192&=-4c\\\\c&=-48.\\end{align*}$$\n\nCheck: $\\frac{-2+\\sqrt{4-4(-48)}}{2}=\\frac{-2+14}{2}=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
  },
