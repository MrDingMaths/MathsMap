  "content": {
    "id": "p36-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "A factory assembles calculators. Each calculator requires a chip and a battery.\nIt is known that 1% of chips and 4% of batteries are defective. Assume that chip and battery defects are independent.\nFind the probability that a calculator selected at random will have at least one defective component.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.96\\%$",
      "worked": "Assuming chip and battery defects are independent,\n$$\\begin{align*}P(\\text{both work})&=0.99\\times0.96\\\\P(\\text{both work})&=0.9504\\\\P(\\text{at least one defective})&=1-P(\\text{both work})\\\\P(\\text{at least one defective})&=1-0.9504\\\\P(\\text{at least one defective})&=0.0496=4.96\\%.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
