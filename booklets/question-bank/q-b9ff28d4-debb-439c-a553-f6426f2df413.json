  "content": {
    "id": "p16-q3",
    "type": "question",
    "label": "3",
    "prompt": "$a$ varies directly with $b$ and $a = 84$ when $b = 56$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$b$ when $a = 22$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b = 14\\frac{2}{3}$",
          "worked": "$$\\begin{align*}a &= kb\\\\84 &= k(56)\\\\k &= \\frac{84}{56}\\\\k &= \\frac{3}{2}\\\\a &= \\frac{3}{2}b\\\\22 &= \\frac{3}{2}b\\\\b &= 22\\times\\frac{2}{3}\\\\b &= \\frac{44}{3}\\\\b &= 14\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$a$ when $b = 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = 18$",
          "worked": "Using $a = \\frac{3}{2}b$ from part a:\n$$\\begin{align*}a &= \\frac{3}{2}(12)\\\\a &= 18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
