    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p139-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2$ and $g(x)=\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$g(x)=\\frac{1}{x}$ requires $x\\ne0$. The outer function $f(x)=x^2$ accepts every real input, so there is no further restriction.\n\nThe composite domain is $(-\\infty,0)\\cup(0,\\infty)$. This pair is possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p139-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\frac{1}{x+1}$ and $g(x)=x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$g(x)=x-1$ is defined for every real $x$. The input to $f$ cannot be $-1$, so $x-1\\ne-1$, giving $x\\ne0$.\n\nThe composite domain is $(-\\infty,0)\\cup(0,\\infty)$. This pair is possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p139-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\frac{1}{x^2}$ and $g(x)=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$g(x)=\\sqrt{x}$ requires $x\\ge0$. The input to $f$ must also be nonzero, so $\\sqrt{x}\\ne0$. Together these conditions give $x>0$.\n\nThe composite domain is $(0,\\infty)$, which differs from the stated domain. This pair is not possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p139-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\sqrt{x}$ and $g(x)=\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$g(x)=\\frac{1}{x^2}$ requires $x\\ne0$. For every such input, $g(x)>0$, so its output lies in the domain $[0,\\infty)$ of $f(x)=\\sqrt{x}$.\n\nThe composite domain is $(-\\infty,0)\\cup(0,\\infty)$. This pair is possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p139-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=\\frac{1}{x}$ and $g(x)=\\frac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$g(x)=\\frac{1}{x}$ requires $x\\ne0$. Its output is never zero, so the outer reciprocal is defined for every allowed input.\n\nAlthough $f(g(x))=x$ on this domain, the original restriction $x\\ne0$ remains. The composite domain is $(-\\infty,0)\\cup(0,\\infty)$. This pair is possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
  },
