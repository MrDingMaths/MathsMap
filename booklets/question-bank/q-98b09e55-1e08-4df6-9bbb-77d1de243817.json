  "content": {
    "id": "p26-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "For each value of $x$, find $x^2+3x$ and simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=3a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9a^2+9a$",
          "worked": "$$\\begin{align*}x^2+3x&=(3a)^2+3(3a)\\\\x^2+3x&=9a^2+9a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=-2b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b^2-6b$",
          "worked": "$$\\begin{align*}x^2+3x&=(-2b)^2+3(-2b)\\\\x^2+3x&=4b^2-6b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=a-b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-2ab+b^2+3a-3b$\n\nExpand the square and distribute $3$.",
          "worked": "$$\\begin{align*}x^2+3x&=(a-b)^2+3(a-b)\\\\x^2+3x&=a^2-2ab+b^2+3a-3b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=2m+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4m^2+4mn+n^2+6m+3n$\n\nExpand the square and distribute $3$.",
          "worked": "$$\\begin{align*}x^2+3x&=(2m+n)^2+3(2m+n)\\\\x^2+3x&=(2m)^2+2(2m)n+n^2+6m+3n\\\\x^2+3x&=4m^2+4mn+n^2+6m+3n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
