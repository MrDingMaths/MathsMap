  "content": {
    "id": "p27-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If you toss a coin three times find the probability of getting",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "a tail and two heads.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{8}$",
          "worked": "There are $2^3=8$ equally likely sequences. Three have one tail: $THH$, $HTH$ and $HHT$.\n\n$$P(\\text{one tail})=\\frac{3}{8}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p27-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one tail.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{8}$",
          "worked": "Only $HHH$ has no tails.\n\n$$\\begin{align*}P(\\text{at least one tail})&=1-\\frac{1}{8}\\\\P(\\text{at least one tail})&=\\frac{7}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
