    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Total gross income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$63 850",
          "worked": "$$\\begin{align*}\\text{Gross income} &= 62\\,500 + 500 + 850\\\\\\text{Gross income} &= \\$63\\,850\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p54-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Total allowable tax deductions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2400",
          "worked": "$$\\begin{align*}\\text{Allowable deductions} &= 1800 + 600\\\\\\text{Allowable deductions} &= \\$2400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p54-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Taxable income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$61 450",
          "worked": "$$\\begin{align*}\\text{Taxable income} &= \\text{Gross income} - \\text{Allowable deductions}\\\\\\text{Taxable income} &= 63\\,850 - 2400\\\\\\text{Taxable income} &= \\$61\\,450\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p54-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Income tax payable. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$10 438.25",
          "worked": "Using the resident tax rates for 2022–23, taxable income of \\$61 450 is in the third bracket (\\$45 001–\\$120 000).\n\n$$\\begin{align*}\\text{Excess} &= 61\\,450 - 45\\,000\\\\\\text{Excess} &= \\$16\\,450\\\\\\text{Tax payable} &= \\text{Base tax} + \\text{Tax rate}\\times\\text{Excess}\\\\\\text{Tax payable} &= 5092 + 0.325\\times16\\,450\\\\\\text{Tax payable} &= \\$10\\,438.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
