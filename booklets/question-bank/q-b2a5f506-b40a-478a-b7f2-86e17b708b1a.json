        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The square of $a$ is directly proportional to the square root of $b$.",
          "worked": "Read $a^2$ as “the square of $a$” and $\\sqrt{b}$ as “the square root of $b$”. Therefore, the square of $a$ is directly proportional to the square root of $b$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
