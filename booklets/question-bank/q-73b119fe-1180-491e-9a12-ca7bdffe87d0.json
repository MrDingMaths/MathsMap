  "content": {
    "id": "p94-q83-root",
    "type": "question",
    "label": "83",
    "prompt": "Prove that this is always true: The sum of five consecutive integers is divisible by 15 if and only if the third number is a multiple of 3.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Let the third integer be $n$. The sum is $5n$, which is divisible by 15 if and only if $n$ is a multiple of 3.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p94-q83-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let the third integer be ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": ". The sum is",
                "marks": []
              }
            ]
          },
          {
            "id": "p94-q83-answer-sum",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}S&=(n-2)+(n-1)+n+(n+1)+(n+2)\\\\S&=5n.\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p94-q83-answer-necessary",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "If ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "S=5n",
                "display": false
              },
              {
                "type": "text",
                "text": " is divisible by 15, then ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n=\\frac{S}{5}",
                "display": false
              },
              {
                "type": "text",
                "text": " is a multiple of 3.",
                "marks": []
              }
            ]
          },
          {
            "id": "p94-q83-answer-sufficient",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Conversely, if ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n=3k",
                "display": false
              },
              {
                "type": "text",
                "text": " for an integer ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k",
                "display": false
              },
              {
                "type": "text",
                "text": ", then ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "S=5(3k)=15k",
                "display": false
              },
              {
                "type": "text",
                "text": ", so the sum is divisible by 15.",
                "marks": []
              }
            ]
          },
          {
            "id": "p94-q83-answer-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Hence the sum is divisible by 15 if and only if the third integer is a multiple of 3.",
                "marks": []
              }
            ]
          }
        ]
      },
