            {
              "type": "text",
              "text": "Use the fact that ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "b^{\\log_b x}=x",
              "display": false
            },
            {
              "type": "text",
              "text": " for all ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x>0",
              "display": false
            },
            {
              "type": "text",
              "text": " to prove each of the following identities.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_b(xy)=\\log_b x+\\log_b y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_b(xy)=\\log_b\\left(b^{\\log_b x+\\log_b y}\\right)=\\log_b x+\\log_b y$.",
          "worked": "$$\\begin{align*}\\log_b(xy)&=\\log_b\\left(b^{\\log_b x}\\cdot b^{\\log_b y}\\right)\\\\\\log_b(xy)&=\\log_b\\left(b^{\\log_b x+\\log_b y}\\right)\\\\\\log_b(xy)&=\\log_b x+\\log_b y.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_b\\frac{x}{y}=\\log_b x-\\log_b y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_b\\frac{x}{y}=\\log_b\\left(b^{\\log_b x-\\log_b y}\\right)=\\log_b x-\\log_b y$.",
          "worked": "$$\\begin{align*}\\log_b\\frac{x}{y}&=\\log_b\\left(\\frac{b^{\\log_b x}}{b^{\\log_b y}}\\right)\\\\\\log_b\\frac{x}{y}&=\\log_b\\left(b^{\\log_b x-\\log_b y}\\right)\\\\\\log_b\\frac{x}{y}&=\\log_b x-\\log_b y.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_b x^c=c\\log_b x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_b x^c=\\log_b\\left(b^{c\\log_b x}\\right)=c\\log_b x$.",
          "worked": "$$\\begin{align*}\\log_b x^c&=\\log_b\\left(\\left(b^{\\log_b x}\\right)^c\\right)\\\\\\log_b x^c&=\\log_b\\left(b^{c\\log_b x}\\right)\\\\\\log_b x^c&=c\\log_b x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
