    "type": "question",
    "label": "11",
    "prompt": "Copy the statements below and fill in each square, using either a $+$ sign or a $-$ sign, to make the statements correct.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$1\\frac{1}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{3}{4}=\\frac{3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$+,\\;-$",
          "worked": "$$\\begin{align*}1\\frac{1}{4}+\\frac{1}{4}-\\frac{3}{4}&=\\frac{5}{4}+\\frac{1}{4}-\\frac{3}{4}\\\\1\\frac{1}{4}+\\frac{1}{4}-\\frac{3}{4}&=\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p28-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$1\\frac{7}{8}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{3}{8}=1\\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-,\\;-$",
          "worked": "$$\\begin{align*}1\\frac{7}{8}-\\frac{1}{4}-\\frac{3}{8}&=\\frac{15}{8}-\\frac{2}{8}-\\frac{3}{8}\\\\1\\frac{7}{8}-\\frac{1}{4}-\\frac{3}{8}&=\\frac{10}{8}\\\\1\\frac{7}{8}-\\frac{1}{4}-\\frac{3}{8}&=1\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p28-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{2}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{3}{4}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-,\\;-,\\;+$ or $+,\\;+,\\;-$",
          "worked": "$$\\begin{align*}2-\\frac{1}{2}-\\frac{1}{4}+\\frac{3}{4}&=2-\\frac{2}{4}-\\frac{1}{4}+\\frac{3}{4}\\\\2-\\frac{1}{2}-\\frac{1}{4}+\\frac{3}{4}&=2\\end{align*}$$\nAlternatively:\n$$\\begin{align*}2+\\frac{1}{2}+\\frac{1}{4}-\\frac{3}{4}&=2+\\frac{2}{4}+\\frac{1}{4}-\\frac{3}{4}\\\\2+\\frac{1}{2}+\\frac{1}{4}-\\frac{3}{4}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p28-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$1\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{2}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{1}{4}\\;\\boxed{\\rule{0pt}{4mm}\\hspace{4mm}}\\;\\frac{3}{8}=\\frac{7}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$+,\\;-,\\;-$",
          "worked": "$$\\begin{align*}1+\\frac{1}{2}-\\frac{1}{4}-\\frac{3}{8}&=\\frac{8}{8}+\\frac{4}{8}-\\frac{2}{8}-\\frac{3}{8}\\\\1+\\frac{1}{2}-\\frac{1}{4}-\\frac{3}{8}&=\\frac{7}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
