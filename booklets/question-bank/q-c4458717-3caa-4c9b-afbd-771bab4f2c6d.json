  "content": {
    "id": "p8-p1-root",
    "type": "question",
    "label": "7",
    "prompt": "Solve the following for $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "$16^{-x}=\\frac{1}{32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac54$",
          "worked": "$$\\begin{align*}2^{-4x}&=2^{-5}\\\\-4x&=-5\\\\[0.9mm]x&=\\tfrac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "$8^x=4^{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}2^{3x}&=2^{2(x+1)}\\\\3x&=2x+2\\\\3x-2x&=2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "$16^{2-x}=\\frac{1}{8^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$",
          "worked": "$$\\begin{align*}2^{4(2-x)}&=2^{-3x}\\\\8-4x&=-3x\\\\8&=x\\\\x&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-p1-d",
        "type": "part",
        "label": "d",
        "prompt": "$8^x=2^{x+3}+2^{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}2^{3x}&=2\\times2^{x+3}\\\\2^{3x}&=2^{x+4}\\\\3x&=x+4\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-p1-e",
        "type": "part",
        "label": "e",
        "prompt": "$32^x=2^{x+5}-2^{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}2^{4x+x}&=2^{x+4}(2-1)\\\\2^{5x}&=2^{x+4}\\\\5x&=x+4\\\\4x&=4\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-p1-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^x-2^{x+1}-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$\n\nFactorise the quadratic in $2^x$ and use $2^x>0$.",
          "worked": "Let $u=2^x$, so $u>0$. Since $4^x=(2^x)^2$ and $2^{x+1}=2\\times2^x$,\n\n$$\\begin{align*}u^2-2u-8&=0\\\\(u-4)(u+2)&=0\\end{align*}$$\n\nThe roots are $4$ and $-2$. Since $u>0$, use $u=4$.\n\n$$\\begin{align*}2^x&=4\\\\2^x&=2^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
