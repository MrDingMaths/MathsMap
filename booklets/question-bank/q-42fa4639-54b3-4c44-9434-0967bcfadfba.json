  "content": {
    "id": "p23-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Suppose a wheel with radius $r$ metres rolls without slipping and spins with a constant angular speed $\\omega$ radians per second.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "How many metres does the wheel roll after one second?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r\\omega\\text{ m}$",
          "worked": "In one second, the wheel turns through $\\omega$ radians. With no slipping, the distance rolled equals the corresponding arc length.\n$$\\begin{align*}l&=r\\theta\\\\l&=r\\omega\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p23-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, what is the linear speed $s$ of the wheel?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=r\\omega\\text{ m/s}$",
          "worked": "$$\\begin{align*}s&=\\frac{\\text{distance}}{\\text{time}}\\\\s&=\\frac{r\\omega}{1}\\\\s&=r\\omega\\text{ m/s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
