                  "type": "math",
                  "latex": "\\frac{x+1}{2}-\\frac{x}{3}+\\frac{4x}{5}=-1",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{45}{29}$",
          "worked": "$$\\begin{align*}\\frac{15(x+1)}{30}-\\frac{10x}{30}+\\frac{24x}{30}&=-1\\\\\\frac{15x+15-10x+24x}{30}&=-1\\\\\\frac{29x+15}{30}&=-1\\\\29x+15&=-30\\\\29x&=-45\\\\x&=-\\frac{45}{29}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": {
