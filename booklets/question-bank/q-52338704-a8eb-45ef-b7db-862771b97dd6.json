              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{4-2x}{3}-\\frac{5x}{4}+\\frac{3x+1}{2}=2",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{2}{5}$",
          "worked": "$$\\begin{align*}\\frac{4(4-2x)}{12}-\\frac{15x}{12}+\\frac{6(3x+1)}{12}&=2\\\\\\frac{16-8x-15x+18x+6}{12}&=2\\\\\\frac{22-5x}{12}&=2\\\\22-5x&=24\\\\-5x&=2\\\\x&=-\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
