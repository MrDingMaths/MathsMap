    "children": [
      {
        "id": "p27-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $3^{2x+2}-3^{x+3}-3^x+3=(9\\times3^x-1)(3^x-3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Expanding the right-hand side gives $9\\cdot3^{2x}-27\\cdot3^x-3^x+3$, which is $3^{2x+2}-3^{x+3}-3^x+3$.",
          "worked": "$$\\begin{align*}\\text{RHS}&=(9\\times3^x-1)(3^x-3)\\\\\\text{RHS}&=9\\cdot3^{2x}-27\\cdot3^x-3^x+3\\\\\\text{RHS}&=3^{2x+2}-3^{x+3}-3^x+3\\\\\\text{RHS}&=\\text{LHS}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p27-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, solve the equation $3^{2x+2}-3^{x+3}-3^x+3=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$ or $x=-2$.",
          "worked": "Using (a), $(9\\times3^x-1)(3^x-3)=0$. Either $9\\times3^x-1=0$ or $3^x-3=0$.\n$$\\begin{align*}3^x&=\\frac19\\\\3^x&=3^{-2}\\\\x&=-2\\end{align*}$$\nThe other factor gives\n$$\\begin{align*}3^x&=3\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
