      {
        "id": "p11-ch7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "A parabola has $x$-intercepts $-1$ and $4$, and $y$-intercept $8$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x^2+6x+8$",
          "worked": "The intercepts give factors $x+1$ and $x-4$. Substitute the point $(0,8)$ to find $a$.\n$$\\begin{align*}y&=a(x+1)(x-4)\\\\8&=a(0+1)(0-4)\\\\8&=-4a\\\\a&=-2\\\\y&=-2(x+1)(x-4)\\\\y&=-2x^2+6x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p11-ch7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "A parabola has $x$-intercepts $3$ and $5$, and passes through the point $(1,8)$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2-8x+15$",
          "worked": "The intercepts give factors $x-3$ and $x-5$. Substitute the point $(1,8)$ to find $a$.\n$$\\begin{align*}y&=a(x-3)(x-5)\\\\8&=a(1-3)(1-5)\\\\8&=8a\\\\a&=1\\\\y&=(x-3)(x-5)\\\\y&=x^2-8x+15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
