  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For each of the following, find the final amount and the overall percentage change:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "60 is increased by 50% and then the result is increased by 50%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "135; 125% increase.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=60\\times1.5\\times1.5\\\\\\text{Final amount}&=135\\\\\\text{Percentage increase}&=\\frac{135-60}{60}\\times100\\%\\\\\\text{Percentage increase}&=125\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "30 is increased by 10% and then the result is decreased by 50%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16.5; 45% decrease.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=30\\times1.1\\times0.5\\\\\\text{Final amount}&=16.5\\\\\\text{Percentage decrease}&=\\frac{30-16.5}{30}\\times100\\%\\\\\\text{Percentage decrease}&=45\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "100 is increased by 5% and then the result is decreased by 10%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "94.5; 5.5% decrease.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=100\\times1.05\\times0.9\\\\\\text{Final amount}&=94.5\\\\\\text{Percentage decrease}&=\\frac{100-94.5}{100}\\times100\\%\\\\\\text{Percentage decrease}&=5.5\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "1000 is decreased by 10% and then the result is decreased by 10%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "810; 19% decrease.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=1000\\times0.9\\times0.9\\\\\\text{Final amount}&=810\\\\\\text{Percentage decrease}&=\\frac{1000-810}{1000}\\times100\\%\\\\\\text{Percentage decrease}&=19\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "10 000 is increased by 10% and then the result is increased by 10%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 100; 21% increase.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=10\\,000\\times1.1\\times1.1\\\\\\text{Final amount}&=12\\,100\\\\\\text{Percentage increase}&=\\frac{12\\,100-10\\,000}{10\\,000}\\times100\\%\\\\\\text{Percentage increase}&=21\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "60 is increased by 20% and then the result is increased by 10%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "79.2; 32% increase.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=60\\times1.2\\times1.1\\\\\\text{Final amount}&=79.2\\\\\\text{Percentage increase}&=\\frac{79.2-60}{60}\\times100\\%\\\\\\text{Percentage increase}&=32\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "110 is decreased by 10% and then the result is increased by 20%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "118.8; 8% increase.",
          "worked": "$$\\begin{align*}\\text{Final amount}&=110\\times0.9\\times1.2\\\\\\text{Final amount}&=118.8\\\\\\text{Percentage increase}&=\\frac{118.8-110}{110}\\times100\\%\\\\\\text{Percentage increase}&=8\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
