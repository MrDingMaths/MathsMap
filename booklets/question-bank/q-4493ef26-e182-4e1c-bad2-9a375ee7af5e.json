  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "By completing the square, show that the inequality $x^2+4x+5>0$ is true for all $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x+2)^2+1\\ge1>0$ for all real $x$.",
      "worked": "$$\\begin{align*}x^2+4x+5&=(x^2+4x+4)+1\\\\x^2+4x+5&=(x+2)^2+1\\\\x^2+4x+5&\\ge1\\\\x^2+4x+5&>0.\\end{align*}$$\nSince $(x+2)^2\\ge0$ for every real $x$, the inequality is true for all real $x$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
