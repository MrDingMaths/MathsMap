    "children": [
      {
        "id": "p20-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Using your knowledge of index laws, explain why $(3\\sqrt{5})^2=3^2(\\sqrt{5})^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The power-of-a-product law: $(ab)^n=a^nb^n$.",
          "worked": "The power-of-a-product law, $(ab)^n=a^nb^n$, applies with $a=3$, $b=\\sqrt{5}$ and $n=2$, so $(3\\sqrt{5})^2=3^2(\\sqrt{5})^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, explain why $(3\\sqrt{5})^2=45$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^2(\\sqrt{5})^2=9(5)=45$.",
          "worked": "$$\\begin{align*}(3\\sqrt{5})^2&=3^2(\\sqrt{5})^2\\\\&=9\\times5\\\\&=45\\end{align*}$$\nSince $(\\sqrt{5})^2=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
