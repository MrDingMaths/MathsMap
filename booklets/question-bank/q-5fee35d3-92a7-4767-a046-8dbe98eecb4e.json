  "content": {
    "id": "p27-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The population of rabbits on a farm increases by a factor of 1.2 each month. If the initial population is 100, then what is the approximate (integer) population after one year?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "892 rabbits.",
      "worked": "One year is 12 months. The population after $t$ months is $P(t)=100(1.2)^t$.\n$$\\begin{align*}P(12)&=100(1.2)^{12}\\\\P(12)&=891.6100448256\\\\P(12)&\\approx892.\\end{align*}$$\nThe approximate population is 892 rabbits.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
