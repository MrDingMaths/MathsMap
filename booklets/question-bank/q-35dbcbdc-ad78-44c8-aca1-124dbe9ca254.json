        "id": "p6-ch15-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Express 30 cents as a percentage of $\\$1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$",
          "worked": "$\\$1=100$ cents.\n\n$$\\begin{align*}\\frac{30}{100}\\times100\\%&=30\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-ch15-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Express 1 kg as a percentage of 800 grams.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125\\%$",
          "worked": "$1\\text{ kg}=1000\\text{ g}$.\n\n$$\\begin{align*}\\frac{1000}{800}\\times100\\%&=\\frac54\\times100\\%\\\\\\frac{1000}{800}\\times100\\%&=125\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p6-ch15-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Express 4 months as a percentage of 1 year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33\\frac13\\%$",
          "worked": "$1$ year $=12$ months.\n\n$$\\begin{align*}\\frac4{12}\\times100\\%&=\\frac{100}{3}\\%\\\\\\frac4{12}\\times100\\%&=33\\frac13\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
