      {
        "id": "p16-e15e-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+1)$",
          "worked": "$$\\begin{align*}x^2+4x+3&=(x^2+4x+4)-4+3\\\\x^2+4x+3&=(x+2)^2-1\\\\x^2+4x+3&=(x+2+1)(x+2-1)\\\\x^2+4x+3&=(x+3)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p16-e15e-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(x+1)$",
          "worked": "$$\\begin{align*}x^2+5x+4&=\\left(x^2+5x+\\frac{25}{4}\\right)-\\frac{25}{4}+4\\\\x^2+5x+4&=\\left(x+\\frac52\\right)^2-\\frac94\\\\x^2+5x+4&=\\left(x+\\frac52+\\frac32\\right)\\left(x+\\frac52-\\frac32\\right)\\\\x^2+5x+4&=(x+4)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p16-e15e-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+5x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+2)$",
          "worked": "$$\\begin{align*}x^2+5x+6&=\\left(x^2+5x+\\frac{25}{4}\\right)-\\frac{25}{4}+6\\\\x^2+5x+6&=\\left(x+\\frac52\\right)^2-\\frac14\\\\x^2+5x+6&=\\left(x+\\frac52+\\frac12\\right)\\left(x+\\frac52-\\frac12\\right)\\\\x^2+5x+6&=(x+3)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p16-e15e-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+6x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5)(x+1)$",
          "worked": "$$\\begin{align*}x^2+6x+5&=(x^2+6x+9)-9+5\\\\x^2+6x+5&=(x+3)^2-4\\\\x^2+6x+5&=(x+3+2)(x+3-2)\\\\x^2+6x+5&=(x+5)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
