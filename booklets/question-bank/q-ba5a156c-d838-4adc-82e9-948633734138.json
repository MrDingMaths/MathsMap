        "label": "a",
        "prompt": "$5d^2-10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=\\pm\\sqrt{2}$",
          "worked": "$$\\begin{aligned}5d^2&=10\\\\d^2&=2\\\\d&=\\pm\\sqrt{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-review-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2y^2}{3}-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\pm\\sqrt{\\dfrac{15}{2}}$",
          "worked": "$$\\begin{aligned}\\frac{2y^2}{3}&=5\\\\2y^2&=15\\\\y^2&=\\frac{15}{2}\\\\y&=\\pm\\sqrt{\\frac{15}{2}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p23-review-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3(x-10)^2}{5}-12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10\\pm2\\sqrt{5}$",
          "worked": "$$\\begin{aligned}\\frac{3(x-10)^2}{5}&=12\\\\3(x-10)^2&=60\\\\(x-10)^2&=20\\\\x-10&=\\pm2\\sqrt{5}\\\\x&=10\\pm2\\sqrt{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p23-review-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y^2-8y+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4\\pm\\sqrt{13}$",
          "worked": "$$\\begin{aligned}y^2-8y+16-16+3&=0\\\\(y-4)^2-13&=0\\\\(y-4)^2&=13\\\\y-4&=\\pm\\sqrt{13}\\\\y&=4\\pm\\sqrt{13}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p23-review-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$1=m^2-m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac{1\\pm\\sqrt{5}}{2}$",
          "worked": "$$\\begin{aligned}m^2-m&=1\\\\m^2-m+\\frac14&=\\frac54\\\\\\left(m-\\frac12\\right)^2&=\\frac54\\\\m-\\frac12&=\\pm\\frac{\\sqrt5}{2}\\\\m&=\\frac{1\\pm\\sqrt5}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p23-review-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$3n+3=n^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{3\\pm\\sqrt{21}}{2}$",
          "worked": "$$\\begin{aligned}n^2-3n&=3\\\\n^2-3n+\\frac94&=\\frac{21}{4}\\\\\\left(n-\\frac32\\right)^2&=\\frac{21}{4}\\\\n-\\frac32&=\\pm\\frac{\\sqrt{21}}2\\\\n&=\\frac{3\\pm\\sqrt{21}}2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
