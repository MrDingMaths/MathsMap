  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find a formula relating the given pronumerals for each of these statements.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "The number of square cm $x$ in $y$ square metres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10000y$",
          "worked": "$1\\text{ m}^2=100\\times100=10000\\text{ cm}^2$, so\n$$x=10000y.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "The selling price $\\$S$ of an article with an original price of $\\$m$ when a discount of 20% is given",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S=0.8m$",
          "worked": "$$\\begin{align*}S&=m-0.2m\\\\S&=0.8m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "The length $c$ cm of the hypotenuse and the lengths $a$ cm and $b$ cm of the other two sides in a right-angled triangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c^2=a^2+b^2$",
          "worked": "By Pythagoras’ theorem,\n$$c^2=a^2+b^2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "The area $A$ cm$^2$ of a sector of a circle with a radius of length $r$ cm and angle $\\theta$ at the centre of the circle, measured in degrees",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\dfrac{\\pi r^2\\theta}{360}$",
          "worked": "The sector is $\\dfrac{\\theta}{360}$ of the circle.\n$$\\begin{align*}A&=\\frac{\\theta}{360}\\times\\pi r^2\\\\A&=\\frac{\\pi r^2\\theta}{360}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "The distance $d$ km travelled by a car in $t$ hours at an average speed of 75 km/h",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=75t$",
          "worked": "Distance is speed multiplied by time:\n$$d=75t.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "The number of hectares $h$ in a rectangular paddock of length 400 m and width $w$ m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{w}{25}$",
          "worked": "The paddock has area $400w\\text{ m}^2$. Since $1$ hectare is $10000\\text{ m}^2$,\n$$\\begin{align*}h&=\\frac{400w}{10000}\\\\h&=\\frac{w}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
