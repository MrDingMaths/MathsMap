  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Factorise each of the following expressions:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2x+1)^2-(x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(3x+2)$",
          "worked": "$$\\begin{align*}(2x+1)^2-(x+1)^2&=\\bigl((2x+1)-(x+1)\\bigr)\\bigl((2x+1)+(x+1)\\bigr)\\\\(2x+1)^2-(x+1)^2&=(2x+1-x-1)(2x+1+x+1)\\\\(2x+1)^2-(x+1)^2&=x(3x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3m+2)^2-(2m+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+1)(5m+3)$",
          "worked": "$$\\begin{align*}(3m+2)^2-(2m+1)^2&=\\bigl((3m+2)-(2m+1)\\bigr)\\bigl((3m+2)+(2m+1)\\bigr)\\\\(3m+2)^2-(2m+1)^2&=(3m+2-2m-1)(3m+2+2m+1)\\\\(3m+2)^2-(2m+1)^2&=(m+1)(5m+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x+3)^2-(3x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4-x)(5x+2)$",
          "worked": "$$\\begin{align*}(2x+3)^2-(3x-1)^2&=\\bigl((2x+3)-(3x-1)\\bigr)\\bigl((2x+3)+(3x-1)\\bigr)\\\\(2x+3)^2-(3x-1)^2&=(2x+3-3x+1)(2x+3+3x-1)\\\\(2x+3)^2-(3x-1)^2&=(4-x)(5x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4n-3)^2-(3n+4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n-7)(7n+1)$",
          "worked": "$$\\begin{align*}(4n-3)^2-(3n+4)^2&=\\bigl((4n-3)-(3n+4)\\bigr)\\bigl((4n-3)+(3n+4)\\bigr)\\\\(4n-3)^2-(3n+4)^2&=(4n-3-3n-4)(4n-3+3n+4)\\\\(4n-3)^2-(3n+4)^2&=(n-7)(7n+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
