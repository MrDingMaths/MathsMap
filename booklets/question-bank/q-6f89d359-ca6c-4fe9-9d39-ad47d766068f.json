  "content": {
    "id": "p2-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "In a box of toffees, the ratio of red wrappers to green wrappers is 5 : 6, while the ratio of green wrappers to blue wrappers is 3 : 10. Find the ratio of red wrappers to blue wrappers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:4$",
      "worked": "Make the green components equal:\n$$\\begin{aligned}\\text{red:green}&=5:6\\\\\\text{green:blue}&=3:10=6:20\\\\\\text{red:blue}&=5:20=1:4.\\end{aligned}$$",
