  "content": {
    "id": "p29-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If $y=(2a+3)x+1$ is perpendicular to $y=2x-4$, find the value of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-\\frac{7}{4}$",
      "worked": "The gradients are $2a+3$ and $2$. Perpendicular lines have gradients whose product is $-1$.\n$$\\begin{align*}2(2a+3)&=-1\\\\4a+6&=-1\\\\4a&=-7\\\\a&=-\\frac{7}{4}\\end{align*}$$",
      "solutionDiagrams": []
