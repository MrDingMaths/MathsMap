  "content": {
    "id": "p9-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "How many $n$-digit serial numbers can be formed if no two consecutive digits are the same? An initial zero is allowed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\times9^{n-1}$",
      "worked": "The first digit has 10 choices. Each of the remaining $n-1$ digits has 9 choices because it must differ from the preceding digit.\n\n$$N=10\\times9^{n-1}.$$",
      "solutionDiagrams": []
    },
