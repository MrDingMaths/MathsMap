  "content": {
    "id": "p15-q7-root",
    "type": "question",
    "label": null,
    "prompt": "State the range of the following in the domain $x\\in[-\\pi,\\pi]$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-1,1]$.",
          "worked": "The sine graph attains $-1$ at $x=-\\frac{\\pi}{2}$ and $1$ at $x=\\frac{\\pi}{2}$, and takes every value between them. Hence $y\\in[-1,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-1,1]$.",
          "worked": "The cosine graph attains $-1$ at $x=\\pm\\pi$ and $1$ at $x=0$, and takes every value between them. Hence $y\\in[-1,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in(-\\infty,\\infty)$.",
          "worked": "Between $x=-\\frac{\\pi}{2}$ and $x=\\frac{\\pi}{2}$, the tangent graph takes every real y-value. Hence $y\\in(-\\infty,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\operatorname{cosec}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in(-\\infty,-1]\\cup[1,\\infty)$.",
          "worked": "The nonzero sine values lie in $[-1,0)\\cup(0,1]$. Their reciprocals give every value at most $-1$ or at least $1$. Hence $y\\in(-\\infty,-1]\\cup[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sec x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in(-\\infty,-1]\\cup[1,\\infty)$.",
          "worked": "The nonzero cosine values lie in $[-1,0)\\cup(0,1]$. Their reciprocals give every value at most $-1$ or at least $1$. Hence $y\\in(-\\infty,-1]\\cup[1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\cot x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in(-\\infty,\\infty)$.",
          "worked": "On $0<x<\\pi$, $\\cot x=\\frac{\\cos x}{\\sin x}$ decreases continuously from arbitrarily large positive values to arbitrarily large negative values. Hence $y\\in(-\\infty,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
