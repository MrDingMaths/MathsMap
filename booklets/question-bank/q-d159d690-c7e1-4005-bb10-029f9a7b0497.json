        "label": "a",
        "prompt": "$6^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^5\\times3^5$",
          "worked": "$$\\begin{align*}6^5&=(2\\times3)^5\\\\6^5&=(2\\times3)\\times(2\\times3)\\times(2\\times3)\\times(2\\times3)\\times(2\\times3)\\\\6^5&=2^5\\times3^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$21^{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{100}\\times7^{100}$",
          "worked": "$$\\begin{align*}21^{100}&=(3\\times7)^{100}\\\\21^{100}&=3^{100}\\times7^{100}\\end{align*}$$ There are 100 factors of $3$ and 100 factors of $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p30-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "$15^{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{15}\\times5^{15}$",
          "worked": "$$\\begin{align*}15^{15}&=(3\\times5)^{15}\\\\15^{15}&=3^{15}\\times5^{15}\\end{align*}$$ There are 15 factors of $3$ and 15 factors of $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
