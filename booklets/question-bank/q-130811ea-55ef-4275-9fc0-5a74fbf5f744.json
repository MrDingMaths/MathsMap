  "content": {
    "id": "v2-a2942-p15-practice-slot-4-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Let $y=\\sin^{-1}\\left(\\dfrac{x}{2}\\right)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a2942-p15-practice-slot-4-upper-slot-4-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{d^2y}{dx^2}=\\dfrac{x}{(4-x^2)^{3/2}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d^2y}{dx^2}=\\dfrac{x}{(4-x^2)^{3/2}}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{\\frac12}{\\sqrt{1-\\frac{x^2}{4}}}\\\\&=\\frac{1}{\\sqrt{4-x^2}}\\\\&=(4-x^2)^{-1/2}\\\\\\frac{d^2y}{dx^2}&=-\\frac12(4-x^2)^{-3/2}\\cdot(-2x)\\\\&=\\frac{x}{(4-x^2)^{3/2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-a2942-p15-practice-slot-4-upper-slot-4-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "For what values of $x$ is the graph of $y=\\sin^{-1}\\left(\\dfrac{x}{2}\\right)$ concave down?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2<x<0$",
          "worked": "The graph is concave down where $\\dfrac{d^2y}{dx^2}<0$. The second derivative is defined for $-2<x<2$, where $(4-x^2)^{3/2}>0$. So\n$$\\frac{x}{(4-x^2)^{3/2}}<0\\iff x<0.$$\nHence the graph is concave down for $-2<x<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
