  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the values of the rational numbers $a$, $b$ and $c$ for which",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt[15]{5}\\sqrt[10]{10}\\sqrt[5]{15}=2^a3^b5^c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{1}{10},\\quad b=\\dfrac15,\\quad c=\\dfrac{11}{30}$\n\nRewrite each root using fractional indices and collect powers of each prime.",
          "worked": "$$\\begin{align*}\\sqrt[15]{5}\\sqrt[10]{10}\\sqrt[5]{15}&=5^{1/15}(2\\times5)^{1/10}(3\\times5)^{1/5}\\\\\\sqrt[15]{5}\\sqrt[10]{10}\\sqrt[5]{15}&=2^{1/10}3^{1/5}5^{1/15+1/10+1/5}\\\\\\sqrt[15]{5}\\sqrt[10]{10}\\sqrt[5]{15}&=2^{1/10}3^{1/5}5^{11/30}\\end{align*}$$\nThus $a=\\dfrac{1}{10}$, $b=\\dfrac15$ and $c=\\dfrac{11}{30}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt[2]{2}\\sqrt[3]{3}\\sqrt[4]{4}\\sqrt[5]{5}\\sqrt[6]{6}=2^a3^b5^c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac76,\\quad b=\\dfrac12,\\quad c=\\dfrac15$\n\nRewrite each root using fractional indices and collect powers of each prime.",
          "worked": "$$\\begin{align*}\\sqrt[2]{2}\\sqrt[3]{3}\\sqrt[4]{4}\\sqrt[5]{5}\\sqrt[6]{6}&=2^{1/2}3^{1/3}(2^2)^{1/4}5^{1/5}(2\\times3)^{1/6}\\\\\\sqrt[2]{2}\\sqrt[3]{3}\\sqrt[4]{4}\\sqrt[5]{5}\\sqrt[6]{6}&=2^{1/2+1/2+1/6}3^{1/3+1/6}5^{1/5}\\\\\\sqrt[2]{2}\\sqrt[3]{3}\\sqrt[4]{4}\\sqrt[5]{5}\\sqrt[6]{6}&=2^{7/6}3^{1/2}5^{1/5}\\end{align*}$$\nThus $a=\\dfrac76$, $b=\\dfrac12$ and $c=\\dfrac15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
