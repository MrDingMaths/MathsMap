                    "display": false
                  }
                ]
              },
              {
                "id": "p28-q14a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Count committees of k people with a designated chair: choose the chair first, or choose the committee first.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Count committees of $k$ people chosen from $n$ people, with one committee member designated as chair.\n\nChoosing the chair first gives $n$ choices, then $\\binom{n-1}{k-1}$ choices for the remaining members: $n\\binom{n-1}{k-1}$ possibilities.\n\nChoosing the committee first gives $\\binom{n}{k}$ choices, then $k$ choices for its chair: $k\\binom{n}{k}$ possibilities.\n\nBoth count the same committees with designated chairs, so\n$$n\\binom{n-1}{k-1}=k\\binom{n}{k}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p28-q14b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p28-q14b-formula",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "by using the formula, ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\binom{n}{k}=\\frac{n!}{k!(n-k)!}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p28-q14b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "n\\binom{n-1}{k-1}=\\frac{n!}{(k-1)!(n-k)!}=k\\binom{n}{k}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p28-q14b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the factorial formula, with n(n−1)! = n! and k! = k(k−1)!.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}n\\binom{n-1}{k-1}&=\\frac{n(n-1)!}{(k-1)!(n-1-(k-1))!}\\\\n\\binom{n-1}{k-1}&=\\frac{n!}{(k-1)!(n-k)!}\\\\n\\binom{n-1}{k-1}&=\\frac{kn!}{k!(n-k)!}\\\\n\\binom{n-1}{k-1}&=k\\binom{n}{k}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
