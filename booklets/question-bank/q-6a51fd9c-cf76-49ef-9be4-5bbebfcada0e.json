    "type": "question",
    "label": "14",
    "prompt": "Prove that\n$$n\\binom{n-1}{k-1}=k\\binom{n}{k}$$\nwhere $1\\leq k<n$,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
