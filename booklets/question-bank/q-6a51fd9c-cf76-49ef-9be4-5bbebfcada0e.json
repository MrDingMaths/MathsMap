        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p28-q14a-short-result",
                "type": "paragraph",
                "fontSize": null,
