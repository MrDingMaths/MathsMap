  "content": {
    "id": "p57-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Sven buys a tablet computer for \\$650. How much does he sell the tablet for if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p57-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "he makes a profit of 20%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$780",
          "worked": "$$\\begin{align*}\\text{Profit}&=\\frac{20}{100}\\times650\\\\&=130\\\\\\text{Selling price}&=650+130\\\\&=780\\end{align*}$$\nSelling price: \\$780.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p57-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "he makes a loss of 30%.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$455",
          "worked": "$$\\begin{align*}\\text{Loss}&=\\frac{30}{100}\\times650\\\\&=195\\\\\\text{Selling price}&=650-195\\\\&=455\\end{align*}$$\nSelling price: \\$455.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
