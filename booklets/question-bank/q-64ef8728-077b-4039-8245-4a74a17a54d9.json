    "type": "question",
    "label": "4",
    "prompt": "When will the inverse of a relation be a function?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "When the relation passes the horizontal line test: one-to-one and one-to-many relations have inverses that are functions.",
      "worked": "Each horizontal line must meet the relation at most once. Swapping $x$ and $y$ then gives at most one output for each input, so the inverse passes the vertical line test. This holds for one-to-one and one-to-many relations.",
      "solutionDiagrams": []
    },
