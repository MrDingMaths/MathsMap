  "content": {
    "id": "p27-challenge-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve the equation $x^4-13x^2+36=0$ by treating it as a quadratic in $x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\pm2,\\ \\pm3$",
      "worked": "Let $u=x^2$.\n\n$$\\begin{align*}u^2-13u+36&=0\\\\(u-9)(u-4)&=0\\end{align*}$$\n\nThus $u=9$ or $u=4$. Substituting $u=x^2$:\n\n$$\\begin{align*}x^2&=9\\quad\\text{or}\\quad x^2=4\\\\x&=\\pm3\\quad\\text{or}\\quad x=\\pm2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
