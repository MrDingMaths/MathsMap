              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{\\cot\\theta}{\\operatorname{cosec}\\theta-1}-\\frac{\\cot\\theta}{\\operatorname{cosec}\\theta+1}=0",
                  "display": true
                }
              ]
            },
            {
              "id": "p31-q92-b-domain",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "for ",
                  "marks": []
