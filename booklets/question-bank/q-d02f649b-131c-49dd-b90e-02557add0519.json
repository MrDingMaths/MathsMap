  "content": {
    "id": "p10-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Mike bought 72 stamps. He bought 27 more stamps than Carla. Express the number of stamps Carla bought as a percentage of Mike’s.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$62.5\\%$",
      "worked": "Carla’s stamp count:\n$$\\begin{align*}72-27&=45\\end{align*}$$\nCarla’s count as a percentage of Mike’s:\n$$\\begin{align*}\\frac{45}{72}\\times100\\%&=\\frac{5}{8}\\times100\\%\\\\\\frac{45}{72}\\times100\\%&=62.5\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
