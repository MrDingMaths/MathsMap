  "content": {
    "id": "p41-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A sphere and a cube both have a surface area equal to $1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q15a",
        "type": "part",
        "label": "a",
        "prompt": "Find the volume of the sphere.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6\\sqrt{\\pi}}$.",
          "worked": "$$\\begin{align*}4\\pi r^2&=1\\\\r^2&=\\frac{1}{4\\pi}\\\\r&=\\frac{1}{2\\sqrt{\\pi}}\\\\V_{\\text{sphere}}&=\\frac43\\pi\\left(\\frac{1}{2\\sqrt{\\pi}}\\right)^3\\\\V_{\\text{sphere}}&=\\frac{1}{6\\sqrt{\\pi}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p41-q15b",
        "type": "part",
        "label": "b",
        "prompt": "Find the volume of the cube.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6\\sqrt6}$.",
          "worked": "Let the cube's edge length be $s$.\n$$\\begin{align*}6s^2&=1\\\\s&=\\frac{1}{\\sqrt6}\\\\V_{\\text{cube}}&=\\left(\\frac{1}{\\sqrt6}\\right)^3\\\\V_{\\text{cube}}&=\\frac{1}{6\\sqrt6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p41-q15c",
        "type": "part",
        "label": "c",
        "prompt": "Which has the greater volume, the sphere or the cube? Answer this without using your calculator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The sphere.\n\nSince $\\pi<6$, $\\frac{1}{6\\sqrt\\pi}>\\frac{1}{6\\sqrt6}$.",
          "worked": "Since $\\pi<4<6$, we have $\\sqrt\\pi<\\sqrt6$. Therefore,\n$$\\frac{1}{6\\sqrt\\pi}>\\frac{1}{6\\sqrt6}.$$\nThe sphere has the greater volume.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
