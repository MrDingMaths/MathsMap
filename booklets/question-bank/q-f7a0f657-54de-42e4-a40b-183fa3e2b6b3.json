  "content": {
    "id": "p2-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "You can determine if a number is even or odd by considering the final digit. The final digit of an even number will be 0, 2, 4, 6 or 8. The final digit of an odd number will be 1, 3, 5, 7 or 9. Explain why.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Write the number as $10a+d$, where $d$ is its final digit. Since $10a$ is even, the number has the same parity as $d$.",
      "worked": "Let $d$ be the final digit of the number $n$. Then $n=10a+d$ for some integer $a$. Since $10a=2(5a)$ is even, adding $d$ gives an even number when $d$ is even and an odd number when $d$ is odd.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
