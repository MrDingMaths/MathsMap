                "latex": "\\begin{aligned}850\\text{ mm}&=850\\text{ mm}\\\\80\\text{ cm}&=80\\times10\\text{ mm}=800\\text{ mm}\\\\190\\text{ cm}&=190\\times10\\text{ mm}=1900\\text{ mm}\\\\0.855\\text{ m}&=0.855\\times100\\times10\\text{ mm}=855\\text{ mm}\\\\1.8\\text{ m}&=1.8\\times100\\times10\\text{ mm}=1800\\text{ mm}\\end{aligned}",
