  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The line passing through the points $(-1,6)$ and $(4,b)$ has gradient $-2$. Find the value of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=-4$",
      "worked": "Using $m=\\dfrac{y_2-y_1}{x_2-x_1}$:\n$$\\begin{align*}\\frac{b-6}{4-(-1)}&=-2\\\\\\frac{b-6}{5}&=-2\\\\b-6&=-10\\\\b&=-4\\end{align*}$$",
      "solutionDiagrams": []
    },
