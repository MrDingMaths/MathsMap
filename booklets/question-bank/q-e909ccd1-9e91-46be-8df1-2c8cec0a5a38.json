  "content": {
    "id": "p31-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Some expressions with fractions can be simplified as a difference of two squares.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^{2}-\\dfrac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x-\\frac{1}{2}\\right)\\left(x+\\frac{1}{2}\\right)$",
          "worked": "$$\\begin{align*}x^{2}-\\frac{1}{4}&=x^{2}-\\left(\\frac{1}{2}\\right)^{2}\\\\x^{2}-\\frac{1}{4}&=\\left(x-\\frac{1}{2}\\right)\\left(x+\\frac{1}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{2}-\\dfrac{4}{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x-\\frac{2}{5}\\right)\\left(x+\\frac{2}{5}\\right)$",
          "worked": "$$\\begin{align*}x^{2}-\\frac{4}{25}&=x^{2}-\\left(\\frac{2}{5}\\right)^{2}\\\\x^{2}-\\frac{4}{25}&=\\left(x-\\frac{2}{5}\\right)\\left(x+\\frac{2}{5}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$25x^{2}-\\dfrac{9}{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(5x-\\frac{3}{4}\\right)\\left(5x+\\frac{3}{4}\\right)$",
          "worked": "$$\\begin{align*}25x^{2}-\\frac{9}{16}&=(5x)^{2}-\\left(\\frac{3}{4}\\right)^{2}\\\\25x^{2}-\\frac{9}{16}&=\\left(5x-\\frac{3}{4}\\right)\\left(5x+\\frac{3}{4}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^{2}}{9}-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{x}{3}-1\\right)\\left(\\frac{x}{3}+1\\right)$",
          "worked": "$$\\begin{align*}\\frac{x^{2}}{9}-1&=\\left(\\frac{x}{3}\\right)^{2}-1^{2}\\\\\\frac{x^{2}}{9}-1&=\\left(\\frac{x}{3}-1\\right)\\left(\\frac{x}{3}+1\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{a^{2}}{4}-\\dfrac{b^{2}}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{a}{2}-\\frac{b}{3}\\right)\\left(\\frac{a}{2}+\\frac{b}{3}\\right)$",
          "worked": "$$\\begin{align*}\\frac{a^{2}}{4}-\\frac{b^{2}}{9}&=\\left(\\frac{a}{2}\\right)^{2}-\\left(\\frac{b}{3}\\right)^{2}\\\\\\frac{a^{2}}{4}-\\frac{b^{2}}{9}&=\\left(\\frac{a}{2}-\\frac{b}{3}\\right)\\left(\\frac{a}{2}+\\frac{b}{3}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{5x^{2}}{9}-\\dfrac{5}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\left(\\frac{x}{3}-\\frac{1}{2}\\right)\\left(\\frac{x}{3}+\\frac{1}{2}\\right)$",
          "worked": "$$\\begin{align*}\\frac{5x^{2}}{9}-\\frac{5}{4}&=5\\left(\\frac{x^{2}}{9}-\\frac{1}{4}\\right)\\\\\\frac{5x^{2}}{9}-\\frac{5}{4}&=5\\left[\\left(\\frac{x}{3}\\right)^{2}-\\left(\\frac{1}{2}\\right)^{2}\\right]\\\\\\frac{5x^{2}}{9}-\\frac{5}{4}&=5\\left(\\frac{x}{3}-\\frac{1}{2}\\right)\\left(\\frac{x}{3}+\\frac{1}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
