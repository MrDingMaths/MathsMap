  "content": {
    "id": "p13-q11-root",
    "type": "question",
    "label": "11",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p13-q11-root-bank-e61e71ed-fdb3-4753-bd3a-3ab328ca93d1",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Calculate the amount to which ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "11\\,000",
              "display": false
            },
            {
              "type": "text",
              "text": " dollars will grow in 3 years if it is invested at 8% p.a. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Give monetary answers to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "simple interest",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13\\,640$",
          "worked": "$$\\begin{align*}I &= Prn\\\\I &= 11\\,000\\times0.08\\times3\\\\I &= 2640\\\\A &= P+I\\\\A &= 11\\,000+2640\\\\A &= \\$13\\,640\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "compound interest, compounded annually.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13\\,856.83$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 11\\,000(1+0.08)^3\\\\FV &= 13\\,856.832\\\\FV &\\approx \\$13\\,856.83\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Which method of calculating interest produces the greater amount and by how much?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Compound interest produces $\\$216.83$ more than simple interest.",
          "worked": "$$\\begin{align*}\\text{Difference} &= 13\\,856.832-13\\,640\\\\\\text{Difference} &= 216.832\\\\\\text{Difference} &\\approx \\$216.83\\end{align*}$$\nCompound interest produces the greater amount because interest is also earned on previously accumulated interest.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q11-root-bank-p13-q11-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q11-root-bank-p13-q11-d-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What is the balance after 1 year under each method?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$11\\,880$ under both methods.",
          "worked": "$$\\begin{align*}A_{\\text{simple}}&=11000+11000(0.08)(1)=\\$11\\,880\\\\FV_{\\text{compound}}&=11000(1.08)^1=\\$11\\,880\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q11-root-bank-p13-q11-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q11-root-bank-p13-q11-e-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "How much greater is the compound-interest balance after 2 years?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$70.40$",
          "worked": "$$\\begin{align*}A_{\\text{simple}}&=11000+11000(0.08)(2)=\\$12\\,760\\\\FV_{\\text{compound}}&=11000(1.08)^2=\\$12\\,830.40\\\\\\text{Difference}&=12830.40-12760=\\$70.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q11-root-bank-p13-q11-f",
        "type": "part",
        "label": "f",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p13-q11-root-bank-p13-q11-f-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Explain why the balances agree after 1 year but differ after 2 years.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q11-root-bank-p13-q11-f-short",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both initially earn interest on $11 000. In year 2, compound interest also earns interest on the first year’s $880.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q11-root-bank-p13-q11-f-worked",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 1,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both methods earn $880 on the original $11 000 in year 1. In year 2, compound interest also earns $880 × 0.08 = $70.40 on the first year’s interest.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
