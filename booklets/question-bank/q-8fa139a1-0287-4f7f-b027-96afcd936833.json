    "children": [
      {
        "id": "p27-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $1$ is a zero of the polynomial $P(x)=x^4-2x^3+7x-6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(1)=1-2+7-6=0$, so $1$ is a zero.",
          "worked": "$$\\begin{aligned}P(1)&=1^4-2(1)^3+7(1)-6\\\\&=1-2+7-6\\\\&=0\\end{aligned}$$\nTherefore $1$ is a zero of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p27-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\alpha,\\beta,\\gamma$ are the three other zeroes, find the values of $\\alpha+\\beta+\\gamma$ and $\\alpha\\beta\\gamma$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta+\\gamma=1$, $\\alpha\\beta\\gamma=-6$.",
          "worked": "$$\\begin{aligned}1+\\alpha+\\beta+\\gamma&=-\\frac{-2}{1}=2\\\\\\alpha+\\beta+\\gamma&=1\\end{aligned}$$\n$$\\begin{aligned}1\\cdot\\alpha\\beta\\gamma&=\\frac{-6}{1}\\\\\\alpha\\beta\\gamma&=-6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
