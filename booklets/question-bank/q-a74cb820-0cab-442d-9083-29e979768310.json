            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The domain is all real numbers. There is no symmetry or vertical asymptote. Both intercepts are at ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(0,0)",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
