  "content": {
    "id": "p58-q32-root",
    "type": "question",
    "label": "32",
    "prompt": "Sketch $y=\\dfrac{x}{e^x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Passes through $(0,0)$, with maximum $(1,\\frac{1}{e})$ and inflection point $(2,\\frac{2}{e^2})$. Increasing for $x<1$ and decreasing for $x>1$; concave down for $x<2$ and concave up for $x>2$. As $x\\to-\\infty$, $y\\to-\\infty$; as $x\\to\\infty$, $y\\to0^+$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p58-q32-domain",
