            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y&=xe^{-x}\\\\y'&=e^{-x}-xe^{-x}\\\\y'&=e^{-x}(1-x)\\\\y'&=0\\quad\\text{when }x=1\\\\y(1)&=\\frac1e\\end{aligned}",
                "display": true
              }
