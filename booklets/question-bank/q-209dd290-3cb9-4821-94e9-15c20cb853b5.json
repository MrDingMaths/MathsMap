  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "",
    "prompt": "Solve $2\\tan\\theta=\\sec\\theta$, for $0\\le\\theta\\le360^\\circ$ by:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Applying identities",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ,150^\\circ$.",
          "worked": "The original equation requires $\\cos\\theta\\ne0$.\n$$\\begin{aligned}\\frac{2\\sin\\theta}{\\cos\\theta}&=\\frac1{\\cos\\theta}\\\\2\\sin\\theta&=1\\\\\\sin\\theta&=\\frac12\\\\\\theta&=30^\\circ,150^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Squaring both sides then using identities",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=30^\\circ,150^\\circ$; reject $210^\\circ$ and $330^\\circ$ after substitution.",
          "worked": "$$\\begin{aligned}4\\tan^2\\theta&=\\sec^2\\theta\\\\4\\sec^2\\theta-4&=\\sec^2\\theta\\\\\\sec^2\\theta&=\\frac43\\\\\\cos\\theta&=\\pm\\frac{\\sqrt3}2\\\\\\theta&=30^\\circ,150^\\circ,210^\\circ,330^\\circ\\end{aligned}$$\nCheck in the original equation:\n$$\\begin{aligned}2\\tan30^\\circ&=\\frac2{\\sqrt3}=\\sec30^\\circ\\\\2\\tan150^\\circ&=-\\frac2{\\sqrt3}=\\sec150^\\circ\\\\2\\tan210^\\circ&=\\frac2{\\sqrt3}\\ne-\\frac2{\\sqrt3}=\\sec210^\\circ\\\\2\\tan330^\\circ&=-\\frac2{\\sqrt3}\\ne\\frac2{\\sqrt3}=\\sec330^\\circ\\end{aligned}$$\nTherefore the only solutions are $\\theta=30^\\circ,150^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
