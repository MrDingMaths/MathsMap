  "content": {
    "id": "v2-f9808-p34-practice-j13-214331-root",
    "type": "question",
    "label": null,
    "prompt": "A fisher catches a barramundi on each cast with probability $0.15$, independently.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-f9808-p34-practice-j13-214331-j13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "She makes 4 casts. Find the probability that she catches at least one barramundi, correct to three significant figures.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.478$",
          "worked": "$$\\begin{align*}P(\\text{at least one})&=1-P(\\text{none})\\\\&=1-0.85^4\\\\&\\approx0.478\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-f9808-p34-practice-j13-214331-j13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "She makes $n$ casts. Write an expression for the probability that she catches at least one barramundi.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-0.85^n$",
          "worked": "$$\\begin{align*}P(\\text{at least one})&=1-P(\\text{none})\\\\&=1-0.85^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f9808-p34-practice-j13-214331-j13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the smallest number of casts for which this probability is greater than $0.9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$ casts",
          "worked": "$$\\begin{align*}1-0.85^n&>0.9\\\\0.85^n&<0.1\\end{align*}$$\n$n=14$: $0.85^{14}\\approx0.1028$, not less than $0.1$.\n\n$n=15$: $0.85^{15}\\approx0.0874<0.1$.\n\nThe probability rises as $n$ increases, so the smallest number of casts is $15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
