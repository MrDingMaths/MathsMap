  "content": {
    "id": "p21-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Define the functions $f(x)=x^2-1$, $g(x)=3x-2$ and $h(x)=\\dfrac{1}{x}$. Find the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(-3a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9a-2$",
          "worked": "$$\\begin{align*}g(-3a)&=3(-3a)-2\\\\g(-3a)&=-9a-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(3-a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-6a+8$",
          "worked": "$$\\begin{align*}f(3-a)&=(3-a)^2-1\\\\f(3-a)&=9-6a+a^2-1\\\\f(3-a)&=a^2-6a+8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(g(1))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}g(1)&=3(1)-2\\\\g(1)&=1\\\\f(g(1))&=f(1)\\\\f(g(1))&=1^2-1\\\\f(g(1))&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(f(0))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}f(0)&=0^2-1\\\\f(0)&=-1\\\\g(f(0))&=g(-1)\\\\g(f(0))&=3(-1)-2\\\\g(f(0))&=-5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(h(2))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{4}$",
          "worked": "$$\\begin{align*}h(2)&=\\frac12\\\\f(h(2))&=f\\left(\\frac12\\right)\\\\f(h(2))&=\\left(\\frac12\\right)^2-1\\\\f(h(2))&=\\frac14-1\\\\f(h(2))&=-\\frac34.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-12x+3$",
          "worked": "$$\\begin{align*}f(g(x))&=f(3x-2)\\\\f(g(x))&=(3x-2)^2-1\\\\f(g(x))&=9x^2-12x+4-1\\\\f(g(x))&=9x^2-12x+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q18-g",
        "type": "part",
        "label": "g",
        "prompt": "$g(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x-8$",
          "worked": "$$\\begin{align*}g(g(x))&=g(3x-2)\\\\g(g(x))&=3(3x-2)-2\\\\g(g(x))&=9x-8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p21-q18-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(f(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-2x^2$",
          "worked": "$$\\begin{align*}f(f(x))&=f(x^2-1)\\\\f(f(x))&=(x^2-1)^2-1\\\\f(f(x))&=x^4-2x^2+1-1\\\\f(f(x))&=x^4-2x^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q18-i",
        "type": "part",
        "label": "i",
        "prompt": "$h(f(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x^2-1}$, $x\\ne\\pm1$.",
          "worked": "$$\\begin{align*}h(f(x))&=h(x^2-1)\\\\h(f(x))&=\\frac{1}{x^2-1}.\\end{align*}$$\nThe denominator must be nonzero, so $x\\ne\\pm1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
