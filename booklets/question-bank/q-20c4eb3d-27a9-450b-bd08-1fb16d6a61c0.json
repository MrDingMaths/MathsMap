    "children": [
      {
        "id": "p39-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How much money does she have after 3 weeks?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2100$",
          "worked": "Read the balance at $t=3$ weeks from the graph: $\\$2100$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "When did she have $\\$700$ in her account?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "After 6.5 weeks.",
          "worked": "Read across from $\\$700$ to the model line, then down to the time axis: $6.5$ weeks.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p39-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the $y$-intercept?\nWhat does it represent in this scenario?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$3300$; the initial amount in Nikki’s account.",
          "worked": "At $t=0$, the graph meets the balance axis at $\\$3300$. This is the initial amount in Nikki’s account.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p39-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the gradient?\nWhat does it represent in this scenario?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-400$; her bank balance decreases by $\\$400$ per week.",
          "worked": "Using $(0,3300)$ and $(3,2100)$:\n$$\\begin{aligned}m&=\\frac{\\text{change in balance}}{\\text{change in time}}\\\\m&=\\frac{2100-3300}{3-0}\\\\m&=-400\\end{aligned}$$\nHer bank balance decreases by $\\$400$ per week.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Write an equation relating bank balance $b$ and time in weeks $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-400t+3300$",
          "worked": "The gradient is $-400$ and the initial balance is $3300$.\n$$\\begin{aligned}b&=mt+c\\\\b&=-400t+3300\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ],
