      {
        "id": "p18-q10a",
        "type": "part",
        "label": "a",
        "prompt": "Which of the dealers thinks that red marbles are more valuable?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Dealer 1.",
          "worked": "For one red marble, Dealer 1 offers $\\frac{11}{8}$ green marbles and Dealer 2 offers $\\frac{4}{3}$ green marbles. Since $\\frac{11}{8}=\\frac{33}{24}>\\frac{32}{24}=\\frac{4}{3}$, Dealer 1 values red marbles more highly.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-q10b",
        "type": "part",
        "label": "b",
        "prompt": "If you have 24 red marbles, then how can you get a free green marble?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exchange 24 red for 33 green with Dealer 1. Exchange 32 green for 24 red with Dealer 2, keeping 1 green marble.",
          "worked": "With Dealer 1:\n$$\\begin{align*}\\text{Green marbles received}&=24\\times\\frac{11}{8}\\\\\\text{Green marbles received}&=33.\\end{align*}$$\nKeep 1 green marble and exchange the remaining 32 with Dealer 2:\n$$\\begin{align*}\\text{Red marbles received}&=32\\times\\frac{3}{4}\\\\\\text{Red marbles received}&=24.\\end{align*}$$\nYou now have your original 24 red marbles and 1 extra green marble.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p18-q10c",
        "type": "part",
        "label": "c",
        "prompt": "If you have 44 green marbles, then how can you get a free red marble?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exchange 44 green for 33 red with Dealer 2. Exchange 32 red for 44 green with Dealer 1, keeping 1 red marble.",
          "worked": "With Dealer 2:\n$$\\begin{align*}\\text{Red marbles received}&=44\\times\\frac{3}{4}\\\\\\text{Red marbles received}&=33.\\end{align*}$$\nKeep 1 red marble and exchange the remaining 32 with Dealer 1:\n$$\\begin{align*}\\text{Green marbles received}&=32\\times\\frac{11}{8}\\\\\\text{Green marbles received}&=44.\\end{align*}$$\nYou now have your original 44 green marbles and 1 extra red marble.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
