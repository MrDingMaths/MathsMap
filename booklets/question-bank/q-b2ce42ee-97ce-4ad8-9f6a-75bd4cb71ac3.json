  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "By expanding the left-hand side, prove that\n$$(a-b)(a^2+ab+b^2)=a^3-b^3.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-b)(a^2+ab+b^2)=a^3-b^3$.\n\nExpand and cancel the mixed terms.",
          "worked": "$$\\begin{align*}(a-b)(a^2+ab+b^2)&=a^3+a^2b+ab^2-a^2b-ab^2-b^3\\\\(a-b)(a^2+ab+b^2)&=a^3-b^3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence, rationalise the denominator in the following expressions:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q10-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\displaystyle\\frac{1}{\\sqrt[3]3-\\sqrt[3]2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt[3]9+\\sqrt[3]6+\\sqrt[3]4$",
              "worked": "Use the difference of cubes identity.\n$$\\begin{align*}\\frac{1}{\\sqrt[3]3-\\sqrt[3]2}&=\\frac{(\\sqrt[3]3)^2+\\sqrt[3]3\\sqrt[3]2+(\\sqrt[3]2)^2}{3-2}\\\\\\frac{1}{\\sqrt[3]3-\\sqrt[3]2}&=\\sqrt[3]9+\\sqrt[3]6+\\sqrt[3]4.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 46
          },
          {
            "id": "p14-q10-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\displaystyle\\frac{1}{\\sqrt[3]5-\\sqrt[3]3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\displaystyle\\frac{\\sqrt[3]{25}+\\sqrt[3]{15}+\\sqrt[3]9}{2}$",
              "worked": "$$\\begin{align*}\\frac{1}{\\sqrt[3]5-\\sqrt[3]3}&=\\frac{(\\sqrt[3]5)^2+\\sqrt[3]5\\sqrt[3]3+(\\sqrt[3]3)^2}{5-3}\\\\\\frac{1}{\\sqrt[3]5-\\sqrt[3]3}&=\\frac{\\sqrt[3]{25}+\\sqrt[3]{15}+\\sqrt[3]9}{2}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 46
          },
          {
            "id": "p14-q10-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\displaystyle\\frac{1}{3-\\sqrt[3]2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\displaystyle\\frac{9+3\\sqrt[3]2+\\sqrt[3]4}{25}$",
              "worked": "$$\\begin{align*}\\frac{1}{3-\\sqrt[3]2}&=\\frac{3^2+3\\sqrt[3]2+(\\sqrt[3]2)^2}{27-2}\\\\\\frac{1}{3-\\sqrt[3]2}&=\\frac{9+3\\sqrt[3]2+\\sqrt[3]4}{25}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p14-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "By expanding the left-hand side, prove that\n$$(a+b)(a^2-ab+b^2)=a^3+b^3.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+b)(a^2-ab+b^2)=a^3+b^3$.\n\nExpand and cancel the mixed terms.",
          "worked": "$$\\begin{align*}(a+b)(a^2-ab+b^2)&=a^3-a^2b+ab^2+a^2b-ab^2+b^3\\\\(a+b)(a^2-ab+b^2)&=a^3+b^3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q10-d",
        "type": "group",
        "label": "d",
        "prompt": "Hence, rationalise the denominator in the following expressions:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q10-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\displaystyle\\frac{1}{\\sqrt[3]3+\\sqrt[3]5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\displaystyle\\frac{\\sqrt[3]9-\\sqrt[3]{15}+\\sqrt[3]{25}}{8}$",
              "worked": "Use the sum of cubes identity.\n$$\\begin{align*}\\frac{1}{\\sqrt[3]3+\\sqrt[3]5}&=\\frac{(\\sqrt[3]3)^2-\\sqrt[3]3\\sqrt[3]5+(\\sqrt[3]5)^2}{3+5}\\\\\\frac{1}{\\sqrt[3]3+\\sqrt[3]5}&=\\frac{\\sqrt[3]9-\\sqrt[3]{15}+\\sqrt[3]{25}}{8}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p14-q10-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\displaystyle\\frac{1}{\\sqrt[3]2+\\sqrt[3]3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\displaystyle\\frac{\\sqrt[3]4-\\sqrt[3]6+\\sqrt[3]9}{5}$",
              "worked": "$$\\begin{align*}\\frac{1}{\\sqrt[3]2+\\sqrt[3]3}&=\\frac{(\\sqrt[3]2)^2-\\sqrt[3]2\\sqrt[3]3+(\\sqrt[3]3)^2}{2+3}\\\\\\frac{1}{\\sqrt[3]2+\\sqrt[3]3}&=\\frac{\\sqrt[3]4-\\sqrt[3]6+\\sqrt[3]9}{5}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 46
          },
          {
            "id": "p14-q10-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\displaystyle\\frac{1}{2+\\sqrt[3]3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\displaystyle\\frac{4-2\\sqrt[3]3+\\sqrt[3]9}{11}$",
              "worked": "$$\\begin{align*}\\frac{1}{2+\\sqrt[3]3}&=\\frac{2^2-2\\sqrt[3]3+(\\sqrt[3]3)^2}{8+3}\\\\\\frac{1}{2+\\sqrt[3]3}&=\\frac{4-2\\sqrt[3]3+\\sqrt[3]9}{11}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      }
    ]
  },
