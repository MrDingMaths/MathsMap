  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "By first finding a common denominator, evaluate each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac1{2+\\sqrt3}+\\dfrac1{2-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac1{2+\\sqrt3}+\\frac1{2-\\sqrt3}&=\\frac{(2-\\sqrt3)+(2+\\sqrt3)}{(2+\\sqrt3)(2-\\sqrt3)}\\\\\\frac1{2+\\sqrt3}+\\frac1{2-\\sqrt3}&=\\frac4{4-3}\\\\\\frac1{2+\\sqrt3}+\\frac1{2-\\sqrt3}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac1{\\sqrt2+3}-\\dfrac1{\\sqrt2-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac67$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt2+3}-\\frac1{\\sqrt2-3}&=\\frac{(\\sqrt2-3)-(\\sqrt2+3)}{(\\sqrt2+3)(\\sqrt2-3)}\\\\\\frac1{\\sqrt2+3}-\\frac1{\\sqrt2-3}&=\\frac{-6}{2-9}\\\\\\frac1{\\sqrt2+3}-\\frac1{\\sqrt2-3}&=\\frac67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac1{3+\\sqrt5}+\\dfrac1{3-\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac32$",
          "worked": "$$\\begin{align*}\\frac1{3+\\sqrt5}+\\frac1{3-\\sqrt5}&=\\frac{(3-\\sqrt5)+(3+\\sqrt5)}{(3+\\sqrt5)(3-\\sqrt5)}\\\\\\frac1{3+\\sqrt5}+\\frac1{3-\\sqrt5}&=\\frac6{9-5}\\\\\\frac1{3+\\sqrt5}+\\frac1{3-\\sqrt5}&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac1{\\sqrt2-\\sqrt3}-\\dfrac1{\\sqrt3+\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt2-\\sqrt3}-\\frac1{\\sqrt3+\\sqrt2}&=\\frac{(\\sqrt2+\\sqrt3)-(\\sqrt2-\\sqrt3)}{(\\sqrt2-\\sqrt3)(\\sqrt2+\\sqrt3)}\\\\\\frac1{\\sqrt2-\\sqrt3}-\\frac1{\\sqrt3+\\sqrt2}&=\\frac{2\\sqrt3}{2-3}\\\\\\frac1{\\sqrt2-\\sqrt3}-\\frac1{\\sqrt3+\\sqrt2}&=-2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
