    "questionDiagrams": [],
    "children": [
      {
        "id": "p69-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "The tangent at $T(a,a^2)$ to $y=x^2$, where $a\\ne0$, meets the $x$-axis at $U$ and the $y$-axis at $V$. Let $O$ be the origin.\n\nFind the equation of this tangent and show that $\\triangle OUV$ has area $\\left|\\dfrac{a^3}{4}\\right|$ square units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2ax-a^2$; area $=\\left|\\dfrac{a^3}{4}\\right|$ square units.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x\\\\m_T&=2a\\\\y-a^2&=2a(x-a)\\\\y&=2ax-a^2\\end{align*}$$\nAt the $x$-intercept,\n$$\\begin{align*}0&=2ax-a^2\\\\x&=\\frac a2\\end{align*}$$\nThus $U\\left(\\dfrac a2,0\\right)$ and $V=(0,-a^2)$.\n$$\\begin{align*}A&=\\frac12\\times OU\\times OV\\\\&=\\frac12\\left|\\frac a2\\right|\\left|-a^2\\right|\\\\&=\\left|\\frac{a^3}{4}\\right|\\text{ square units}\\end{align*}$$\nAbsolute values are used because lengths are positive even when coordinates are negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p69-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coordinates of $T$ for which this area is $31.25$ units$^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$T=(5,25)$ or $(-5,25)$.",
          "worked": "$$\\begin{align*}\\left|\\frac{a^3}{4}\\right|&=31.25\\\\|a^3|&=125\\\\a^3&=\\pm125\\\\a&=\\pm5\\end{align*}$$\nSince $T=(a,a^2)$, $T=(5,25)$ or $(-5,25)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
