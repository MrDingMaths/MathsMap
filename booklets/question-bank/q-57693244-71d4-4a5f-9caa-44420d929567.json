          "inlines": [
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\theta",
              "display": false
            },
            {
              "type": "text",
              "text": " be acute. Find the following.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q31",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan\\theta$ given that $\\sin\\theta=\\dfrac{3}{5}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{4}$",
          "worked": "Take the opposite side as $3$ and the hypotenuse as $5$.\n$$\\begin{align*}\\text{Adjacent side}&=\\sqrt{5^2-3^2}\\\\\\text{Adjacent side}&=4\\\\\\tan\\theta&=\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q32",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\theta$ given that $\\tan\\theta=\\dfrac{2}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{\\sqrt{13}}$",
          "worked": "Take the opposite side as $2$ and the adjacent side as $3$.\n$$\\begin{align*}\\text{Hypotenuse}&=\\sqrt{2^2+3^2}\\\\\\text{Hypotenuse}&=\\sqrt{13}\\\\\\sin\\theta&=\\frac{2}{\\sqrt{13}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q33",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos\\theta$ given that $\\sin\\theta=\\dfrac{1}{\\sqrt{3}}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{2}}{\\sqrt{3}}$",
          "worked": "Take the opposite side as $1$ and the hypotenuse as $\\sqrt{3}$.\n$$\\begin{align*}\\text{Adjacent side}&=\\sqrt{(\\sqrt{3})^2-1^2}\\\\\\text{Adjacent side}&=\\sqrt{2}\\\\\\cos\\theta&=\\frac{\\sqrt{2}}{\\sqrt{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
