  "content": {
    "id": "p5-q7-root",
    "type": "question",
    "label": null,
    "prompt": "A road makes an angle of $6^\\circ$ with the horizontal. How much does it rise over a distance of $800\\text{ m}$ along the road? Give your answer to the nearest metre.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$84\\text{ m}$",
      "worked": "Let $h$ metres be the vertical rise. The distance along the road is the hypotenuse.\n$$\\begin{align*}\\sin6^\\circ&=\\frac{h}{800}\\\\h&=800\\sin6^\\circ\\\\h&\\approx84\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
