  "content": {
    "id": "v2-nr-p29-s1-j6-034218-root",
    "type": "question",
    "label": null,
    "prompt": "A triangle has side lengths $6\\text{ cm}$, $8\\text{ cm}$ and $x\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-nr-p29-s1-j6-034218-j6-qa",
        "type": "part",
        "label": "a",
        "prompt": "Find the angle opposite the side of length $x\\text{ cm}$, to 1 d.p., when $x=9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$78.6^\\circ$ ($\\cos\\theta=\\frac{19}{96}$ is positive)",
          "worked": "$$\\begin{align*}\\cos\\theta&=\\frac{6^2+8^2-9^2}{2(6)(8)}\\\\[8pt]&=\\frac{19}{96}\\\\[8pt]\\theta&\\approx78.6^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-nr-p29-s1-j6-034218-j6-qb",
        "type": "part",
        "label": "b",
        "prompt": "Find the angle opposite the side of length $x\\text{ cm}$, to 1 d.p., when $x=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90.0^\\circ$ ($\\cos\\theta=0$)",
          "worked": "$$\\begin{align*}\\cos\\theta&=\\frac{6^2+8^2-10^2}{2(6)(8)}\\\\[8pt]&=0\\\\[8pt]\\theta&=90.0^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-nr-p29-s1-j6-034218-j6-qc",
        "type": "part",
        "label": "c",
        "prompt": "Find the angle opposite the side of length $x\\text{ cm}$, to 1 d.p., when $x=12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$117.3^\\circ$ ($\\cos\\theta=-\\frac{11}{24}$ is negative)",
          "worked": "$$\\begin{align*}\\cos\\theta&=\\frac{6^2+8^2-12^2}{2(6)(8)}\\\\[8pt]&=-\\frac{11}{24}\\\\[8pt]\\theta&\\approx117.3^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-nr-p29-s1-j6-034218-j6-qd",
        "type": "part",
        "label": "d",
        "prompt": "Use your answers to decide, without finding any angle, whether the largest angle of a triangle with side lengths $7\\text{ cm}$, $9\\text{ cm}$ and $12\\text{ cm}$ is acute, right-angled or obtuse.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Obtuse",
          "worked": "The largest angle $\\theta$ is opposite $12\\text{ cm}$.\n$$\\begin{align*}7^2+9^2&=130\\\\12^2&=144\\end{align*}$$\nThe numerator of $\\cos\\theta$ is $130-144=-14$, which is negative, so $\\cos\\theta<0$ and the angle is obtuse.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
