  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write down the equation of the new curve when the following curves have been transformed in the following ways.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=(x-2)^3$, translate left 3 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+1)^3$",
          "worked": "For a translation left by 3, replace $x$ with $x+3$.\n\n$$\\begin{align*}y&=f(x+3)\\\\y&=((x+3)-2)^3\\\\y&=(x+1)^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q4b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=(x-2)^3$, translate right 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-4)^3$",
          "worked": "For a translation right by 2, replace $x$ with $x-2$.\n\n$$\\begin{align*}y&=f(x-2)\\\\y&=((x-2)-2)^3\\\\y&=(x-4)^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q4c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3x+2$, translate left 3 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x+11$",
          "worked": "For a translation left by 3, replace $x$ with $x+3$.\n\n$$\\begin{align*}y&=f(x+3)\\\\y&=3(x+3)+2\\\\y&=3x+11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q4d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=3x+2$, translate right 4 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3x-10$",
          "worked": "For a translation right by 4, replace $x$ with $x-4$.\n\n$$\\begin{align*}y&=f(x-4)\\\\y&=3(x-4)+2\\\\y&=3x-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
