  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Determine if $A$ and $B$ are independent given\n$$\\Pr(A)=0.6,\\quad \\Pr(B)=0.3,\\quad \\Pr(A\\cap B)=0.2.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Not independent.",
      "worked": "$$\\Pr(A)\\Pr(B)=0.6\\times0.3=0.18\\ne0.2=\\Pr(A\\cap B).$$\nTherefore, $A$ and $B$ are not independent.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
