  "content": {
    "id": "p7-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "What is the value of $\\frac{a+b}{ab}$ if $a=-2.1$ and $b=-3.6$, correct to 1 decimal place?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-0.8$",
      "worked": "$$\\begin{align*}\\frac{a+b}{ab}&=\\frac{(-2.1)+(-3.6)}{(-2.1)(-3.6)}\\\\\\frac{a+b}{ab}&=\\frac{-5.7}{7.56}\\\\\\frac{a+b}{ab}&\\approx-0.8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
