    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=\\log_2(ax+b)$ passes through the origin. The equation of its asymptote is $x=2$. Find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\tfrac12$, $b=1$.",
          "worked": "The asymptote occurs where $ax+b=0$.\n$$\\begin{align*}2a+b&=0\\\\b&=-2a\\\\\\log_2 b&=0\\\\b&=1\\\\2a+1&=0\\\\a&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p30-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=\\log_3(ax+b)$ passes through the point $(1,1)$. The equation of its asymptote is $x=-1$. Find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=b=\\tfrac32$.",
          "worked": "The asymptote gives $-a+b=0$, so $b=a$. Substitute $(1,1)$:\n$$\\begin{align*}\\log_3(a+b)&=1\\\\a+b&=3\\\\2a&=3\\\\a&=\\frac32\\\\b&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p30-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The graph of $y=\\log_4(ax+b)$ passes through the points $(1,-1)$ and $(-1,1)$. Find $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\tfrac{15}{8}$, $b=\\tfrac{17}{8}$.",
          "worked": "Substitute the two points:\n$$\\begin{align*}\\log_4(a+b)&=-1\\\\a+b&=\\frac14\\\\\\log_4(-a+b)&=1\\\\-a+b&=4\\\\2b&=\\frac{17}{4}\\\\b&=\\frac{17}{8}\\\\a&=\\frac14-\\frac{17}{8}\\\\a&=-\\frac{15}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
