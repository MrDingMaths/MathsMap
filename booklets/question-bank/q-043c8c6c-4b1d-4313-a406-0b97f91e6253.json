  "content": {
    "id": "p22-q85-root",
    "type": "question",
    "label": "85",
    "prompt": "Simplify\n$$\\ln\\left(1+\\frac1m\\right)+\\ln\\left(1+\\frac1{m+1}\\right)+\\cdots+\\ln\\left(1+\\frac1{2m}\\right),$$\nwhere $m$ is a positive integer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p22-q85-short-result",
            "type": "paragraph",
            "fontSize": null,
