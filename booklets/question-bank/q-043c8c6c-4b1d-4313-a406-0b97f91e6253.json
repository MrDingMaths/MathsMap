          {
            "id": "p22-q85-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Combine the logarithms into a product, retaining the factors from denominator ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "m",
                "display": false
              },
              {
                "type": "text",
                "text": " through denominator ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2m",
                "display": false
              },
              {
                "type": "text",
                "text": ", then cancel.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\ln\\left(1+\\frac1m\\right)+\\ln\\left(1+\\frac1{m+1}\\right)+\\cdots+\\ln\\left(1+\\frac1{2m}\\right)&=\\ln\\left(\\frac{m+1}{m}\\times\\frac{m+2}{m+1}\\times\\cdots\\times\\frac{2m+1}{2m}\\right)\\\\\\ln\\left(1+\\frac1m\\right)+\\ln\\left(1+\\frac1{m+1}\\right)+\\cdots+\\ln\\left(1+\\frac1{2m}\\right)&=\\ln\\left(\\frac{(m+1)(m+2)\\cdots(2m)(2m+1)}{m(m+1)\\cdots(2m-1)(2m)}\\right)\\\\\\ln\\left(1+\\frac1m\\right)+\\ln\\left(1+\\frac1{m+1}\\right)+\\cdots+\\ln\\left(1+\\frac1{2m}\\right)&=\\ln\\left(\\frac{2m+1}{m}\\right).\\end{align*}$$",
      "solutionDiagrams": []
