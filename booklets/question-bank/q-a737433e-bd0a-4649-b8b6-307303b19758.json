  "content": {
    "id": "p25-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "If the 321 700 people living in Darwin produce an average of 1.87 kg of garbage per person per day, how much garbage is produced by Darwin residents in one non-leap year?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$219\\,576\\,335\\text{ kg}$",
      "worked": "A non-leap year has 365 days.\n\n$$\\begin{align*}\\text{Garbage per day}&=321\\,700\\times1.87\\\\\\text{Garbage per day}&=601\\,579\\text{ kg}\\\\\\text{Garbage per year}&=601\\,579\\times365\\\\\\text{Garbage per year}&=219\\,576\\,335\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
    },
