  "content": {
    "id": "v2-p16-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the area bounded by the curve $y=\\sqrt{x+1}$, the $y$-axis and the horizontal lines through the points on the curve where $x=0$ and $x=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{4}{3}\\text{ units}^2$",
      "worked": "Rearrange for $x$ and change the limits.\n$$\\begin{aligned}x&=y^2-1\\\\x=0:&\\quad y=1\\\\x=3:&\\quad y=2\\\\A&=\\int_1^2 (y^2-1)\\,dy\\\\&=\\left[\\frac{y^3}{3}-y\\right]_1^2\\\\&=\\left(\\frac83-2\\right)-\\left(\\frac13-1\\right)\\\\&=\\frac43\\text{ units}^2=1\\frac13\\text{ units}^2\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
