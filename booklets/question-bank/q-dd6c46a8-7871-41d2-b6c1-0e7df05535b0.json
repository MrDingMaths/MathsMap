  "content": {
    "id": "p8-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Global sea levels are rising on average 37 mm per year.\nHow many years would it take for the sea level to rise 2 metres? Give your answer to the nearest whole year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately 54 years.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
