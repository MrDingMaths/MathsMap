  "content": {
    "id": "p30-q7-content",
    "type": "question",
    "label": "7",
    "prompt": "Write an equation to represent the scenario, then solve to find the number.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "A number is tripled to obtain the result 21.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x = 21$, $x = 7$.",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}3x &= 21 \\\\ \\frac{3x}{3} &= \\frac{21}{3} \\\\ x &= 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Six less than a number is 7.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x - 6 = 7$, $x = 13$.",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}x - 6 &= 7 \\\\ x - 6 + 6 &= 7 + 6 \\\\ x &= 13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p30-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "A number is doubled and the result is $-16$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x = -16$, $x = -8$.",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}2x &= -16 \\\\ \\frac{2x}{2} &= \\frac{-16}{2} \\\\ x &= -8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "One-quarter of a number is 30.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{4} = 30$, $x = 120$.",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}\\frac{x}{4} &= 30 \\\\ \\frac{x}{4}\\times 4 &= 30\\times 4 \\\\ x &= 120\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Six more than a number is $-7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x + 6 = -7$, $x = -13$.",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}x + 6 &= -7 \\\\ x + 6 - 6 &= -7 - 6 \\\\ x &= -13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
