  "content": {
    "id": "p40-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Sam’s investment of $\\$50\\,000$ earns her interest at the rate of $6.3\\%$ p.a., compounded annually.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "How much will the investment be worth at the end of six years, correct to the nearest cent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$72\\,138.91$",
          "worked": "Each year the investment is multiplied by $1.063$.\n\n$$\\begin{align*}A&=50\\,000\\times(1.063)^6\\\\A&\\approx\\$72\\,138.91\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the percentage increase of her original investment at the end of six years, correct to the nearest $0.1\\%$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$44.3\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\bigl((1.063)^6-1\\bigr)\\times100\\%\\\\\\text{Percentage increase}&\\approx44.3\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the total interest earned over the six years, correct to the nearest cent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$22\\,138.91$",
          "worked": "$$\\begin{align*}I&=50\\,000\\times(1.063)^6-50\\,000\\\\I&\\approx\\$22\\,138.91\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p40-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "What would the simple interest on the investment have been over six years, assuming the same interest rate of $6.3\\%$ p.a.?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$18\\,900$",
          "worked": "$$\\begin{align*}I&=PRT\\\\I&=50\\,000\\times0.063\\times6\\\\I&=\\$18\\,900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
