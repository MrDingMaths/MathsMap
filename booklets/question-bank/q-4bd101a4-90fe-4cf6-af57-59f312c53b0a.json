        "label": "a",
        "prompt": "Bob sits directly opposite Mary.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8! = 40\\,320$",
          "worked": "Fix Bob's position. Mary has one seat directly opposite him. Arrange the other eight people in the remaining seats.\n$$N = 8! = 40\\,320.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Mary’s seat is two places away from Bob’s (there is one person sitting between them on one of their sides).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times 8! = 80\\,640$",
          "worked": "Fix Bob's position. Mary can sit two places clockwise or two places anticlockwise from Bob, giving two choices. Arrange the other eight people in the remaining seats.\n$$N = 2\\times 8! = 80\\,640.$$",
