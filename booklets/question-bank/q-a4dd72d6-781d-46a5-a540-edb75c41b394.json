  "content": {
    "id": "p17-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve using the quadratic formula:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+2x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt2$",
          "worked": "$a=1$, $b=2$, $c=-1$.\n$$\\begin{align*}x&=\\frac{-2\\pm\\sqrt{2^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{-2\\pm\\sqrt8}{2}\\\\x&=-1\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+4x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2\\pm\\sqrt2$",
          "worked": "$a=1$, $b=4$, $c=2$.\n$$\\begin{align*}x&=\\frac{-4\\pm\\sqrt{4^2-4(1)(2)}}{2(1)}\\\\x&=\\frac{-4\\pm\\sqrt8}{2}\\\\x&=-2\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-2x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1\\pm\\sqrt3$",
          "worked": "$a=1$, $b=-2$, $c=-2$.\n$$\\begin{align*}x&=\\frac{-(-2)\\pm\\sqrt{(-2)^2-4(1)(-2)}}{2(1)}\\\\x&=\\frac{2\\pm\\sqrt{12}}2\\\\x&=1\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2-3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,-\\frac12$",
          "worked": "$a=2$, $b=-3$, $c=-2$.\n$$\\begin{align*}x&=\\frac{-(-3)\\pm\\sqrt{(-3)^2-4(2)(-2)}}{2(2)}\\\\x&=\\frac{3\\pm5}{4}\\\\x&=2\\text{ or }-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x^2-5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\frac23$",
          "worked": "$a=3$, $b=-5$, $c=2$.\n$$\\begin{align*}x&=\\frac{-(-5)\\pm\\sqrt{(-5)^2-4(3)(2)}}{2(3)}\\\\x&=\\frac{5\\pm1}{6}\\\\x&=1\\text{ or }\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x^2-4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2\\pm\\sqrt2}{2}$",
          "worked": "$a=2$, $b=-4$, $c=1$.\n$$\\begin{align*}x&=\\frac{-(-4)\\pm\\sqrt{(-4)^2-4(2)(1)}}{2(2)}\\\\x&=\\frac{4\\pm\\sqrt8}{4}\\\\x&=\\frac{2\\pm\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2+\\sqrt3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-\\sqrt3\\pm\\sqrt{11}}2$",
          "worked": "$a=1$, $b=\\sqrt3$, $c=-2$.\n$$\\begin{align*}x&=\\frac{-\\sqrt3\\pm\\sqrt{(\\sqrt3)^2-4(1)(-2)}}{2(1)}\\\\x&=\\frac{-\\sqrt3\\pm\\sqrt{11}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2+\\sqrt5x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-\\sqrt5\\pm1}2$",
          "worked": "$a=1$, $b=\\sqrt5$, $c=1$.\n$$\\begin{align*}x&=\\frac{-\\sqrt5\\pm\\sqrt{(\\sqrt5)^2-4(1)(1)}}{2(1)}\\\\x&=\\frac{-\\sqrt5\\pm1}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\sqrt2x^2+3x+\\sqrt2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\sqrt2,-\\frac{\\sqrt2}{2}$",
          "worked": "$a=\\sqrt2$, $b=3$, $c=\\sqrt2$.\n$$\\begin{align*}x&=\\frac{-3\\pm\\sqrt{3^2-4(\\sqrt2)(\\sqrt2)}}{2\\sqrt2}\\\\x&=\\frac{-3\\pm1}{2\\sqrt2}\\\\x&=-\\sqrt2\\text{ or }-\\frac{\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
