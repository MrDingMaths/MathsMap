  "content": {
    "id": "p90-q34-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $y=\\dfrac{3x-6}{x+2}$. Find the:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p90-q34-a",
        "type": "part",
        "label": "a",
        "prompt": "$x$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,0)$.",
          "worked": "Set $y=0$.\n\n$$\\begin{align*}3x-6&=0\\\\x&=2\\end{align*}$$\n\nAt $x=2$, the denominator is $4\\ne0$. The $x$-intercept is $(2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p90-q34-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-3)$.",
          "worked": "Set $x=0$.\n\n$$\\begin{align*}y&=\\frac{3(0)-6}{0+2}\\\\y&=-3\\end{align*}$$\n\nThe $y$-intercept is $(0,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p90-q34-c",
        "type": "part",
        "label": "c",
        "prompt": "vertical asymptote.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$.",
          "worked": "Set the denominator equal to zero.\n\n$$\\begin{align*}x+2&=0\\\\x&=-2\\end{align*}$$\n\nThe numerator is $-12\\ne0$ there, so the vertical asymptote is $x=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p90-q34-d",
        "type": "part",
        "label": "d",
        "prompt": "horizontal asymptote.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3$.",
          "worked": "As $x\\to\\pm\\infty$, the ratio of the leading coefficients gives $y\\to\\frac{3}{1}=3$.\n\nThe horizontal asymptote is $y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p90-q34-e",
        "type": "part",
        "label": "e",
        "prompt": "Sketch the graph of $y=\\dfrac{3x-6}{x+2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Asymptotes: $x=-2$ and $y=3$. Intercepts: $(2,0)$ and $(0,-3)$.\n\nThe branches lie upper left and lower right relative to $(-2,3)$.",
          "worked": "Draw the dashed asymptotes $x=-2$ and $y=3$, and mark $(2,0)$ and $(0,-3)$.\n\nFor $x<-2$, draw the branch above $y=3$. For $x>-2$, draw the branch below $y=3$, passing through both intercepts. Both branches approach the asymptotes.",
          "solutionDiagrams": [
            {
              "id": "p90-q34-e-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"graphBlue\",\"hex\":\"268CFF\",\"reason\":\"reciprocal-function curve and intercept markers\"}],\"reference\":\"Teacher PDF 20, printed 598, Exercise 2I Q34(e)\"}\n\\begin{tikzpicture}[x=4.2mm,y=3.5mm,>=stealth,line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{graphBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-8.2,-7.3) rectangle (9,13.4);\n\\draw[black,line width=0.4pt,dashed] (-2,-6.7)--(-2,11.7);\n\\draw[black,line width=0.4pt,dashed] (-7.5,3)--(7.8,3);\n\\draw[black,line width=0.5pt,->] (-7.5,0)--(7.8,0);\n\\draw[black,line width=0.5pt,->] (0,-6.7)--(0,11.7);\n\\draw[graphBlue,line width=0.8pt,<->,domain=-7.5:-3.38,samples=100,smooth] plot (\\x,{3-12/(\\x+2)});\n\\draw[graphBlue,line width=0.8pt,<->,domain=-0.7628:7.8,samples=140,smooth] plot (\\x,{3-12/(\\x+2)});\n\\draw[black,line width=0.4pt] (2,-0.16)--(2,0.16);\n\\draw[black,line width=0.4pt] (-0.13,-3)--(0.13,-3);\n\\fill[graphBlue] (2,0) circle[radius=1.3pt];\n\\fill[graphBlue] (0,-3) circle[radius=1.3pt];\n\\node[black,anchor=north,yshift=-3pt] at (7.8,0) {$x$};\n\\node[black,anchor=south west,xshift=3pt,yshift=2pt] at (0,11.7) {$y$};\n\\node[black,anchor=south,yshift=3pt] at (-2,11.7) {$x=-2$};\n\\node[black,anchor=south east,yshift=3pt] at (7.8,3) {$y=3$};\n\\node[black,anchor=north east,xshift=-2pt,yshift=-3pt] at (-2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-2$\\special{dvisvgm:raw </g>}};\n\\node[black,anchor=south,yshift=2pt] at (2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[black,anchor=south east,xshift=-2pt,yshift=2pt] at (0,3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\node[black,anchor=east,xshift=-2pt] at (0,-3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-3$\\special{dvisvgm:raw </g>}};\n\\node[black,anchor=north west,xshift=3pt,yshift=-4pt] at (2,0) {$(2,0)$};\n\\node[black,anchor=west,xshift=5pt] at (0,-3) {$(0,-3)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 82,
              "alt": "Mathematical diagram",
              "overlayOf": null,
