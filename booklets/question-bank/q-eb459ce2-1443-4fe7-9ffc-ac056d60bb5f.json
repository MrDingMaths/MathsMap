    "label": "",
    "prompt": "In a school of 120 students, 45 study Spanish, 52 study French, and 15 study both languages. How many students study Spanish or French?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "82 students",
      "worked": "Let $S$ be the set of students who study Spanish and $F$ the set who study French.\n$$\\begin{aligned}|S\\cup F|&=|S|+|F|-|S\\cap F|\\\\&=45+52-15\\\\&=82\\end{aligned}$$\n82 students study Spanish or French.",
      "solutionDiagrams": []
