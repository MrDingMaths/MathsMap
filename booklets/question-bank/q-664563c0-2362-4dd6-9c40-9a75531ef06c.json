    "label": "13",
    "prompt": "Find the value of $a$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x-a)^3$ has a tangent with gradient $12$ when $x=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4$ or $a=8$",
          "worked": "$$\\begin{align*}y'&=3(x-a)^2(1)\\\\y'&=3(x-a)^2\\\\3(6-a)^2&=12\\\\(6-a)^2&=4\\\\6-a&=\\pm2\\\\a&=4\\text{ or }8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p43-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(5x+a)^4$ has a tangent with gradient $-160$ when $x=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-17$",
          "worked": "$$\\begin{align*}y'&=4(5x+a)^3(5)\\\\y'&=20(5x+a)^3\\\\20(5(3)+a)^3&=-160\\\\(15+a)^3&=-8\\\\15+a&=-2\\\\a&=-17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
