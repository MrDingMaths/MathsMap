  "content": {
    "id": "p7-q16-root",
    "type": "question",
    "label": null,
    "prompt": "By how much must the numerator of $\\frac{2}{3}$ be increased to give a result of $\\frac{3}{4}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "Let $x$ be the increase in the numerator.\n\n$$\\begin{align*}\\frac{2+x}{3}&=\\frac{3}{4}\\\\2+x&=\\frac{9}{4}\\\\x&=\\frac{9}{4}-2\\\\x&=\\frac{1}{4}\\end{align*}$$\n\nThe numerator must be increased by $\\frac{1}{4}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
