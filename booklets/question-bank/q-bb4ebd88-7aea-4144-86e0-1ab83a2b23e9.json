    "id": "v2-9c586-p22-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "A line has gradient $4$ and passes through the point $(2,5)$. Find its equation $y = mx + c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y = 4x - 3$",
      "worked": "$$\\begin{aligned}y &= 4x + c\\\\5 &= 4(2) + c\\\\c &= -3\\end{aligned}$$\nTherefore $y = 4x - 3$.",
      "solutionDiagrams": []
    },
