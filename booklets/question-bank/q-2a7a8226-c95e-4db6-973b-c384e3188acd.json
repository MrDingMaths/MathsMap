  "content": {
    "id": "p25-stem3-8-content",
    "type": "question",
    "label": "3",
    "prompt": "Do the following require logarithms to solve?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q3",
        "type": "part",
        "label": "a",
        "prompt": "$x^2=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. Take square roots: $x=\\pm\\sqrt{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p25-q4",
        "type": "part",
        "label": "b",
        "prompt": "$3^x=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes. Taking logarithms gives\n$$\\begin{align*}x\\ln(3)&=\\ln(8)\\\\x&=\\frac{\\ln(8)}{\\ln(3)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p25-q5",
        "type": "part",
        "label": "c",
        "prompt": "$x^e=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. The exponent is constant; raise both sides to the power $\\frac{1}{e}$ to obtain $x=9^{1/e}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p25-q6",
        "type": "part",
        "label": "d",
        "prompt": "$e^x=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Yes. Take natural logarithms:\n$$\\begin{align*}\\ln(e^x)&=\\ln(9)\\\\x&=\\ln(9).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p25-q7",
        "type": "part",
        "label": "e",
        "prompt": "$9^x=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. Since $9^0=1$, $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p25-q8",
        "type": "part",
        "label": "f",
        "prompt": "$(-2)^x=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. Since $(-2)^2=4$, the solution $x=2$ can be recognised using familiar powers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
  },
