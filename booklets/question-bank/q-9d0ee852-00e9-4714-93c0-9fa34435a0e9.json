  "content": {
    "id": "p30-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Talula was investigating the relationship between the number of weeks ($n$) people have been on a new diet and their overall weight loss in pounds ($w$).\nShe determines the line of best fit for the relationship as $w = 3.5 + 1.1n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Talula says the gradient is 3.5 and $y$-intercept is 1.1. Explain why she is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The gradient is 1.1 and the $y$-intercept is 3.5.",
          "worked": "In $w = 3.5 + 1.1n$, the coefficient of $n$ is the gradient, 1.1. The constant term is the $y$-intercept, 3.5. Talula has interchanged them.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p30-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Interpret the gradient of the line of best fit in the context of the data.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Predicted weight loss increases by 1.1 pounds per week.",
          "worked": "For each additional week on the diet, the predicted overall weight loss increases by 1.1 pounds.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p30-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Does it make sense to interpret the vertical intercept in the context of the data?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. It predicts a weight loss of 3.5 pounds at 0 weeks.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p30-q5-intercept-note",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The intercept predicts a weight loss of 3.5 pounds at 0 weeks.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p30-q5-c-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "No. At the start of the diet, no time has elapsed for weight loss, so this intercept is not meaningful in the context.",
                    "marks": []
                  }
                ]
              }
            ]
          },
