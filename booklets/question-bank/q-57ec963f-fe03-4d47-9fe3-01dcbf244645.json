  "content": {
    "id": "p7-q12",
    "type": "question",
    "label": "12",
    "prompt": "Consider a regular polygon with a very large number of sides ($n$).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "What shape does this polygon look like?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A circle.",
          "worked": "A circle: its many short sides make the outline look circular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Is there a limit to the size of a polygon angle sum as $n$ increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The angle sum grows without bound.",
          "worked": "$S=180(n-2)$. As $n$ increases, $n-2$ increases without bound, so $S$ also grows without bound.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "What size does each interior angle approach as $n$ increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180^{\\circ}$.",
          "worked": "$$\\begin{align*}I&=\\frac{180(n-2)}{n}\\\\I&=180-\\frac{360}{n}\\end{align*}$$\nAs $n$ increases, $\\dfrac{360}{n}$ approaches $0$, so each interior angle approaches $180^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
