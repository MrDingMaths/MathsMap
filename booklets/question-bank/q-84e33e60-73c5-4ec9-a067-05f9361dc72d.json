  "content": {
    "id": "p9-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "It is found that 3 apricots weigh 300 g. How many kilograms would 20 apricots weigh?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\text{ kg}$",
      "worked": "$$\\begin{align*}\\text{Mass of 1 apricot}&=300\\div3=100\\text{ g}\\\\\\text{Mass of 20 apricots}&=100\\times20=2000\\text{ g}\\\\\\text{Mass of 20 apricots}&=2000\\div1000=2\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
