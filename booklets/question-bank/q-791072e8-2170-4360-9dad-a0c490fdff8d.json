  "content": {
    "id": "p141-q34-root",
    "type": "question",
    "label": "34",
    "prompt": "Let $f(x)=\\dfrac{1}{2-x}$ and $g(x)=\\sqrt{1-x^2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p141-q34-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=\\dfrac{1}{2-\\sqrt{1-x^2}}$.",
          "worked": "$$\\begin{align*}f(g(x))&=f\\left(\\sqrt{1-x^2}\\right)\\\\f(g(x))&=\\frac{1}{2-\\sqrt{1-x^2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p141-q34-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the domain and range of $f(g(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p141-q34-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Domain: ",
                    "marks": []
                  },
                  {
