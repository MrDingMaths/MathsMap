  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In the expansion of $(1+x)^6$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "find the term in $x^2$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15x^2$",
          "worked": "The general term is $T_r=\\binom{6}{r}x^r$. For $x^2$, let $r=2$.\n$$\\begin{aligned}T_2&=\\binom{6}{2}x^2\\\\&=15x^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "find the term in $x^3$,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20x^3$",
          "worked": "For $x^3$, let $r=3$.\n$$\\begin{aligned}T_3&=\\binom{6}{3}x^3\\\\&=20x^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "find the ratio of the term in $x^2$ to the term in $x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{4x}$",
          "worked": "$$\\begin{aligned}\\frac{T_2}{T_3}&=\\frac{15x^2}{20x^3}\\\\&=\\frac{3}{4x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
