  "content": {
    "id": "p20-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Solve the following for $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{x+3}=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}2^{x+3}&=2^4\\\\x+3&=4\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$8^x=\\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{2}{3}$",
          "worked": "$$\\begin{align*}(2^3)^x&=2^{-2}\\\\2^{3x}&=2^{-2}\\\\3x&=-2\\\\x&=-\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p20-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^x=\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{4}$",
          "worked": "$$\\begin{align*}(2^2)^x&=2^{\\frac12}\\\\2^{2x}&=2^{\\frac12}\\\\2x&=\\frac12\\\\x&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$3^{2x-1}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$",
          "worked": "$$\\begin{align*}3^{2x-1}&=3^0\\\\2x-1&=0\\\\2x&=1\\\\x&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^x+3^{x+1}-36=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}3^x+3\\cdot3^x&=36\\\\(1+3)3^x&=36\\\\4\\cdot3^x&=36\\\\3^x&=9\\\\3^x&=3^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^x-5(2^x)+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=2$.\n\nSet $u=2^x$ and factorise the resulting quadratic.",
          "worked": "Since $4^x=(2^x)^2$, let $u=2^x$.\n\n$$\\begin{align*}u^2-5u+4&=0\\\\(u-1)(u-4)&=0\\end{align*}$$\n\nSo $u=1$ or $u=4$.\n\n$$\\begin{align*}2^x&=2^0 & 2^x&=2^2\\\\x&=0 & x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
