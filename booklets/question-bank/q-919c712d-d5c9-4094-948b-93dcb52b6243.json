  "content": {
    "id": "p6-q1-root",
    "type": "question",
    "label": "4",
    "prompt": "Given the curve $y=x^2$, write down the translation required to obtain each of the following graphs.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units up.",
          "worked": "The $+2$ is outside the square, so each output increases by 2. Translate the graph 2 units up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 units down.",
          "worked": "The $-3$ is outside the square, so each output decreases by 3. Translate the graph 3 units down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 unit left.",
          "worked": "Replacing $x$ with $x+1$ moves the vertex from $(0,0)$ to $(-1,0)$ and translates the whole graph 1 unit left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
