        "answer": {
          "short": "$x^2+4x+15=(x+2)^2+11\\geq11$, since $(x+2)^2\\geq0$.",
          "worked": "$$\\begin{align*}x^2+4x+15&=x^2+4x+4-4+15\\\\x^2+4x+15&=(x+2)^2+11.\\end{align*}$$\n\nSince $(x+2)^2\\geq0$, $x^2+4x+15\\geq11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p19-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+2x+15\\geq14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x+15=(x+1)^2+14\\geq14$, since $(x+1)^2\\geq0$.",
          "worked": "$$\\begin{align*}x^2+2x+15&=x^2+2x+1-1+15\\\\x^2+2x+15&=(x+1)^2+14.\\end{align*}$$\n\nSince $(x+1)^2\\geq0$, $x^2+2x+15\\geq14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
