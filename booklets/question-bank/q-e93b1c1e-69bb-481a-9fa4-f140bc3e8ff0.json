  "content": {
    "id": "p2-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The side lengths of a triangle are in the ratio $2:4:5$. Find the triangle’s three side lengths if its perimeter is $33\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6\\text{ cm},\\ 12\\text{ cm},\\ 15\\text{ cm}$",
      "worked": "Let the side lengths be $2x\\text{ cm}$, $4x\\text{ cm}$ and $5x\\text{ cm}$.\n\n$$\\begin{align*}2x+4x+5x&=33\\\\11x&=33\\\\x&=3\\end{align*}$$\n\nThe side lengths are $2\\times3=6\\text{ cm}$, $4\\times3=12\\text{ cm}$ and $5\\times3=15\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
