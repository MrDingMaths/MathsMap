            "children": [],
            "answer": {
              "short": "$6\\times12+\\dfrac{4\\times5}{2}=82\\text{ cm}^2$",
              "worked": "$$\\begin{align*}\n\\text{Triangle base} &= 12-7=5\\text{ cm}\\\\\n\\text{Triangle height} &= 10-6=4\\text{ cm}\\\\\nA_{\\text{rectangle}} &= 6\\times12=72\\text{ cm}^2\\\\\nA_{\\text{triangle}} &= \\frac{4\\times5}{2}=10\\text{ cm}^2\\\\\nA_{\\text{total}} &= 72+10\\\\\nA_{\\text{total}} &= 82\\text{ cm}^2\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
