                "src": null,
                "widthMm": 50,
                "alt": "Mathematical diagram",
                "overlayOf": null,
                "transparent": false,
                "axes": null,
                "spec": {
                  "sourcePage": 20,
                  "sourceRegion": "Question 2a, right diagram",
                  "description": "The same composite outline split vertically into a left trapezium and right rectangle. All four dimension arrows and three right-angle markers are retained.",
                  "mathematics": "The trapezium has parallel vertical sides 10 cm and 6 cm. Their perpendicular separation is derived from 12 cm minus 7 cm.",
                  "answerVisibility": "Only source givens and the supplied partition are visible; derived lengths and areas belong in answers."
                },
                "derived": false,
                "reviewStatus": "needs-review"
              }
            ],
            "children": [],
            "answer": {
              "short": "$7\\times6+\\dfrac{5}{2}(10+6)=82\\text{ cm}^2$",
              "worked": "$$\\begin{align*}\n\\text{Trapezium height} &= 12-7=5\\text{ cm}\\\\\nA_{\\text{rectangle}} &= 7\\times6=42\\text{ cm}^2\\\\\nA_{\\text{trapezium}} &= \\frac{5(10+6)}{2}=40\\text{ cm}^2\\\\\nA_{\\text{total}} &= 42+40\\\\\nA_{\\text{total}} &= 82\\text{ cm}^2\n\\end{align*}$$",
              "solutionDiagrams": []
