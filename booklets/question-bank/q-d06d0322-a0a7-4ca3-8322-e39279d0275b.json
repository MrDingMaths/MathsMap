                "id": "p20-q2-a-diagram-left",
                "role": "question",
                "format": "tikz",
                "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 20, p20-q2-a-diagram-left\"}\n\\begin{tikzpicture}[x=0.38cm,y=0.38cm,draw=black,text=black,>=stealth,every node/.style={font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (12,0);\n\\coordinate (C) at (12,6);\n\\coordinate (D) at (5,6);\n\\coordinate (E) at (0,10);\n\\coordinate (F) at (0,6);\n\\draw[line width=0.8pt] (A)--(B)--(C)--(D)--(E)--cycle;\n\\draw[dashed,line width=0.4pt] (F)--(D);\n\\draw[line width=0.4pt] (0,0.5)--(0.5,0.5)--(0.5,0);\n\\draw[line width=0.4pt] (11.5,0)--(11.5,0.5)--(12,0.5);\n\\draw[line width=0.4pt] (11.5,6)--(11.5,5.5)--(12,5.5);\n\\draw[<->,line width=0.4pt] (-0.6,0)--node[midway,left] {$10\\text{ cm}$} (-0.6,10);\n\\draw[<->,line width=0.4pt] (0,-0.7)--node[midway,below] {$12\\text{ cm}$} (12,-0.7);\n\\draw[<->,line width=0.4pt] (12.6,0)--node[midway,right] {$6\\text{ cm}$} (12.6,6);\n\\draw[<->,line width=0.4pt] (5,6.6)--node[midway,above] {$7\\text{ cm}$} (12,6.6);\n\\end{tikzpicture}",
                "src": null,
                "widthMm": 50,
                "alt": "Mathematical diagram",
                "overlayOf": null,
                "transparent": false,
                "axes": null,
                "spec": {
                  "sourcePage": 20,
                  "sourceRegion": "Question 2a, left diagram",
                  "description": "Composite outline split horizontally into an upper triangle and lower rectangle. All four dimension arrows and three right-angle markers are retained.",
                  "mathematics": "Base 12 cm, left height 10 cm, right height 6 cm and upper horizontal segment 7 cm. The dashed partition joins the left side to the slope-horizontal junction.",
                  "answerVisibility": "Only source givens and the supplied partition are visible; derived lengths and areas belong in answers."
                },
                "derived": false,
                "reviewStatus": "needs-review"
              }
