  "content": {
    "id": "p14-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "For these real functions, explain why the function value cannot be found.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$F(0)$, when $F(x)=\\sqrt{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(0)$ is not real because its radicand is $-4$.",
          "worked": "Substitution gives $\\sqrt{0-4}=\\sqrt{-4}$. A negative number has no real square root, so $F(0)$ is not defined as a real value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(3)$, when $g(x)=\\sqrt{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(3)$ is not real because its radicand is $-8$.",
          "worked": "Substitution gives $\\sqrt{1-3^2}=\\sqrt{-8}$. A negative number has no real square root, so $g(3)$ is not defined as a real value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$h(-2)$, when $h(x)=\\dfrac{1}{2+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h(-2)$ is undefined because its denominator is zero.",
          "worked": "Substitution gives a denominator of $2+(-2)=0$. Division by zero is undefined, so $h(-2)$ cannot be found.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(0)$, when $f(x)=\\dfrac{1}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(0)$ is undefined because its denominator is zero.",
          "worked": "Substitution gives a denominator of $3(0)=0$. Division by zero is undefined, so $f(0)$ cannot be found.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
