        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Areas scale by the square of the linear scale factor.\n\n$$\\begin{align*}\\text{Area scale factor}&=k^2\\\\\\text{Area scale factor}&=2^2\\\\\\text{Area scale factor}&=4\\end{align*}$$",
