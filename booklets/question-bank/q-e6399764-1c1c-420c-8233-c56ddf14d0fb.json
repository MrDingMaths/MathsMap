        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}k&=\\frac{\\text{larger corresponding side}}{\\text{smaller corresponding side}}\\\\k&=\\frac{2}{1}\\\\k&=2\\end{align*}$$",
          "solutionDiagrams": []
