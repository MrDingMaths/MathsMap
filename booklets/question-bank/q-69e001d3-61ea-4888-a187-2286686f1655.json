    "children": [
      {
        "id": "p23-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=c(x-h)^4+k$ has a turning point at $(2,3)$ and passes through the point $(4,5)$. Find $h$, $k$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=2$, $k=3$, $c=\\frac18$.",
          "worked": "The turning point is $(h,k)$, so $h=2$ and $k=3$. Substituting $(4,5)$:\n$$\\begin{align*}5&=c(4-2)^4+3\\\\5&=16c+3\\\\2&=16c\\\\c&=\\frac18.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=c(x-h)^3+k$ has a point of inflection at $(-2,1)$ and passes through the origin. Find $h$, $k$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=-2$, $k=1$, $c=-\\frac18$.",
          "worked": "The point of inflection is $(h,k)$, so $h=-2$ and $k=1$. Substituting $(0,0)$:\n$$\\begin{align*}0&=c(0+2)^3+1\\\\0&=8c+1\\\\-1&=8c\\\\c&=-\\frac18.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
