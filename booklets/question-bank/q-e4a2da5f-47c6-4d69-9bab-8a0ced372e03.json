  "content": {
    "id": "p35-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A container holds 20 cards numbered 1 to 20. Two cards are selected at random without replacement.\nFind the probability that the second card is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "an odd number given that the first card was a 7",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9}{19}$",
          "worked": "After removing 7, there are 19 cards left and 9 are odd.\n$$P(\\text{second card odd}\\mid\\text{first card 7})=\\frac{9}{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "a number less than 5 given that the first card was a 12",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{19}$",
          "worked": "After removing 12, there are 19 cards left. The 4 cards numbered 1, 2, 3 and 4 are less than 5.\n$$P(\\text{second card less than 5}\\mid\\text{first card 12})=\\frac{4}{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "a number divisible by 3 if the first number was 6.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{19}$",
          "worked": "After removing 6, there are 19 cards left. The 5 remaining multiples of 3 are 3, 9, 12, 15 and 18.\n$$P(\\text{second card divisible by 3}\\mid\\text{first card 6})=\\frac{5}{19}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
