        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"pathPurple\",\"hex\":\"8B5CC7\",\"reason\":\"the supplied motion path\"}],\"reference\":\"PDF page 71, p71-q84-diagram\"}\n\\begin{tikzpicture}[x=0.36cm,y=0.36cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{pathPurple}{HTML}{8B5CC7}\n\\draw[black,line width=0.5pt,->] (-8,0)--(4,0) node[below] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-2)--(0,10) node[left] {$y$};\n\\draw[pathPurple,line width=0.8pt] (-4,0)--(0,8);\n\\fill[black] (-4,0) circle[radius=1.3pt];\n\\fill[black] (0,8) circle[radius=1.3pt];\n\\fill[black] (-2,4) circle[radius=1.3pt];\n\\node[black,left] at (-2,4) {$P$};\n\\node[black,below] at (-4,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-4$\\special{dvisvgm:raw </g>}};\n\\node[black,right] at (0,8) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$8$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
