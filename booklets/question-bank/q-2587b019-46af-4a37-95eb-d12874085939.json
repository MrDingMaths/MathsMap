    "type": "question",
    "label": null,
    "prompt": "Find the inverse of $f(x)=4^{x+1}+2^{x+2}+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
