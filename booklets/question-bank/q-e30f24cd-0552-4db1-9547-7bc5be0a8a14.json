        "prompt": "Which is larger, $3^{-3}$ or $2^{-5}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{-3}$",
          "worked": "$$\\begin{align*}3^{-3}&=\\frac{1}{27}\\\\2^{-5}&=\\frac{1}{32}\\end{align*}$$ $\\frac{1}{27}>\\frac{1}{32}$, so $3^{-3}$ is larger.",
          "solutionDiagrams": []
        },
