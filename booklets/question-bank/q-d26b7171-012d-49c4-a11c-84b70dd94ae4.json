  "content": {
    "id": "p17-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Each student in a music class of 28 studies either the piano or the violin or both. It is known that 20 study the piano and 15 study the violin. Find the probability that a student selected at random studies both instruments.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{4}$",
      "worked": "No student studies neither instrument.\n\n$$\\begin{aligned}\\text{Violin only}&=28-20\\\\&=8\\\\\\text{Both}&=15-8\\\\&=7\\\\P(\\text{both})&=\\frac{7}{28}\\\\&=\\frac{1}{4}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
