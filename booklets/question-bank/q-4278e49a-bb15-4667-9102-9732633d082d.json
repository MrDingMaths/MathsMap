  "content": {
    "id": "p14-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A sum of money is to be divided between three people. The first person receives one-fifth of the money, and the second person receives twice as much as the first person. This leaves $\\$30$ for the third person. How much does each person receive?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "First person: $\\$15$; second person: $\\$30$; third person: $\\$30$.",
      "worked": "Let the total be $x$ dollars. The first person receives $\\frac{x}{5}$ dollars and the second receives $\\frac{2x}{5}$ dollars.\n$$\\begin{align*}\\frac{x}{5}+\\frac{2x}{5}+30&=x\\\\3x+150&=5x\\\\150&=2x\\\\x&=75\\end{align*}$$\nThe first person receives $\\$15$, the second receives $\\$30$, and the third receives $\\$30$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
  },
