      {
        "id": "p8-p5-a",
        "type": "part",
        "label": "a",
        "prompt": "$5^{2x}-2^{2y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5^x+2^y)(5^x-2^y)$",
          "worked": "$$\\begin{align*}5^{2x}-2^{2y}&=(5^x)^2-(2^y)^2\\\\5^{2x}-2^{2y}&=(5^x+2^y)(5^x-2^y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p8-p5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{4x}-2^{6x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{4x}(1+2^x)(1-2^x)$",
          "worked": "$$\\begin{align*}2^{4x}-2^{6x}&=2^{4x}(1-2^{2x})\\\\2^{4x}-2^{6x}&=2^{4x}\\bigl(1^2-(2^x)^2\\bigr)\\\\2^{4x}-2^{6x}&=2^{4x}(1+2^x)(1-2^x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
