  "content": {
    "id": "p3-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Show that the stated values are both solutions of the given quadratic equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=2$ and $x=3$; $$x^2-5x+6=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both substitutions give $0$, so both values are solutions.",
          "worked": "For $x=2$:\n$$\\begin{align*}2^2-5(2)+6&=4-10+6\\\\2^2-5(2)+6&=0.\\end{align*}$$\nFor $x=3$:\n$$\\begin{align*}3^2-5(3)+6&=9-15+6\\\\3^2-5(3)+6&=0.\\end{align*}$$\nBoth values satisfy the equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p3-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=4$ and $x=-3$; $$x^2-x-12=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both substitutions give $0$, so both values are solutions.",
          "worked": "For $x=4$:\n$$\\begin{align*}4^2-4-12&=16-4-12\\\\4^2-4-12&=0.\\end{align*}$$\nFor $x=-3$:\n$$\\begin{align*}(-3)^2-(-3)-12&=9+3-12\\\\(-3)^2-(-3)-12&=0.\\end{align*}$$\nBoth values satisfy the equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p3-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\frac12$ and $x=-2$; $$2x^2+3x-2=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both substitutions give $0$, so both values are solutions.",
          "worked": "For $x=\\frac12$:\n$$\\begin{align*}2\\left(\\frac12\\right)^2+3\\left(\\frac12\\right)-2&=\\frac12+\\frac32-2\\\\2\\left(\\frac12\\right)^2+3\\left(\\frac12\\right)-2&=0.\\end{align*}$$\nFor $x=-2$:\n$$\\begin{align*}2(-2)^2+3(-2)-2&=8-6-2\\\\2(-2)^2+3(-2)-2&=0.\\end{align*}$$\nBoth values satisfy the equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
