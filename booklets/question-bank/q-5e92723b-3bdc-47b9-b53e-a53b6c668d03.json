  "content": {
    "id": "p16-review-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The formula for the geometric mean $m$ of two positive numbers $a$ and $b$ is $m=\\sqrt{ab}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-review-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $m$ if $a=16$ and $b=25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=20$",
          "worked": "$$\\begin{align*}m&=\\sqrt{16\\times25}\\\\m&=\\sqrt{400}\\\\m&=20.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-review-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $a$ if $m=7$ and $b=16$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{49}{16}$",
          "worked": "$$\\begin{align*}7&=\\sqrt{16a}\\\\49&=16a\\\\a&=\\frac{49}{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
