  "content": {
    "id": "p15-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A spherical balloon is to be filled with water so that its surface area increases at a constant rate of $1\\text{ cm}^2/\\text{s}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q17-a",
        "type": "group",
        "label": "a",
        "prompt": "Find, when the radius is 3 cm:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q17-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the required rate of increase of the radius,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{24\\pi}\\text{ cm}/\\text{s}$.",
              "worked": "$$\\begin{aligned}A&=4\\pi r^2\\\\\\frac{dA}{dt}&=8\\pi r\\frac{dr}{dt}\\\\1&=8\\pi r\\frac{dr}{dt}\\\\\\frac{dr}{dt}&=\\frac{1}{8\\pi r}\\\\\\frac{dr}{dt}&=\\frac{1}{24\\pi}\\text{ cm}/\\text{s}\\quad(r=3)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p15-q17-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the rate at which the water is flowing in at that time.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{3}{2}\\text{ cm}^3/\\text{s}$.",
              "worked": "$$\\begin{aligned}V&=\\frac{4}{3}\\pi r^3\\\\\\frac{dV}{dt}&=4\\pi r^2\\frac{dr}{dt}\\\\\\frac{dV}{dt}&=4\\pi r^2\\times\\frac{1}{8\\pi r}\\\\\\frac{dV}{dt}&=\\frac{r}{2}\\\\\\frac{dV}{dt}&=\\frac{3}{2}\\text{ cm}^3/\\text{s}\\quad(r=3)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p15-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the volume when the volume is increasing at $10\\text{ cm}^3/\\text{s}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{32000\\pi}{3}\\text{ cm}^3$.",
          "worked": "Since $A=4\\pi r^2$ and $\\frac{dA}{dt}=1$,\n$$\\frac{dr}{dt}=\\frac{1}{8\\pi r}.$$\nWhen $\\frac{dV}{dt}=10$:\n$$\\begin{aligned}4\\pi r^2\\frac{dr}{dt}&=10\\\\4\\pi r^2\\times\\frac{1}{8\\pi r}&=10\\\\\\frac{r}{2}&=10\\\\r&=20\\text{ cm}\\\\V&=\\frac{4}{3}\\pi(20)^3\\\\V&=\\frac{32000\\pi}{3}\\text{ cm}^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
