    "id": "v2-91d8b-p33-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Solve each first-order differential equation ($y\\ne0$).",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-91d8b-p33-practice-slot-10-s10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{dy}{dx}=3y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2=\\dfrac{1}{6(C-x)}$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=\\frac1{3y^3}\\\\x&=\\int\\frac13y^{-3}\\,dy\\\\x&=-\\frac1{6y^2}+C\\\\\\frac1{6y^2}&=C-x\\\\y^2&=\\frac1{6(C-x)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-91d8b-p33-practice-slot-10-s10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{dy}{dx}=\\dfrac{y^2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{3}{C-x}$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=\\frac3{y^2}\\\\x&=\\int3y^{-2}\\,dy\\\\x&=-\\frac3y+C\\\\\\frac3y&=C-x\\\\y&=\\frac3{C-x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
