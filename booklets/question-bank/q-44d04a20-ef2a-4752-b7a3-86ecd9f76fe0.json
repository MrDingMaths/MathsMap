      {
        "id": "p9-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the formula for $\\sin(\\alpha+\\beta)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta$",
          "worked": "$$\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, using the diagram, show that the angles $\\alpha$ and $\\beta$ sum to $45^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(\\alpha+\\beta)=\\dfrac1{\\sqrt2}$ and $0^\\circ<\\alpha+\\beta<90^\\circ$, so $\\alpha+\\beta=45^\\circ$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p9-q14-b-worked-text-0-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "By Pythagoras, ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "PT=\\sqrt5\\text{ cm}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "RT=\\sqrt{10}\\text{ cm}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p9-q14-b-worked-display-1",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\sin(\\alpha+\\beta)&=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\\\&=\\frac1{\\sqrt5}\\left(\\frac3{\\sqrt{10}}\\right)+\\frac2{\\sqrt5}\\left(\\frac1{\\sqrt{10}}\\right)\\\\&=\\frac5{\\sqrt{50}}\\\\&=\\frac1{\\sqrt2}.\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p9-q14-b-worked-text-2-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Each angle is less than ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "45^\\circ",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " because its opposite side is shorter than its adjacent side. Thus ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "0^\\circ<\\alpha+\\beta<90^\\circ",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", so",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p9-q14-b-worked-display-3",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\alpha+\\beta=\\sin^{-1}\\left(\\frac1{\\sqrt2}\\right)=45^\\circ.",
                    "display": true
                  }
                ]
              }
            ]
