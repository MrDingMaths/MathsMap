      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "A line passes through the point $(4,8)$ and has gradient $\\frac12$. Find the $y$-coordinate of the point on the line when $x=8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\frac{y-8}{8-4}&=\\frac12\\\\\\frac{y-8}{4}&=\\frac12\\\\y-8&=2\\\\y&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "A line passes through the point $(-1,6)$ and has gradient $-1$. Find the $y$-coordinate of the point on the line when $x=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{y-6}{4-(-1)}&=-1\\\\\\frac{y-6}{5}&=-1\\\\y-6&=-5\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
