    "children": [
      {
        "id": "index-t7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^3\\times x^6}{x^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{5}$",
          "worked": "$$\\begin{align*}\n\\frac{x^3\\times x^6}{x^4} &= x^{3 + 6 - 4} \\\\\n&= x^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{y^3\\times y^2}{y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{y^3\\times y^2}{y^2} &= y^{3 + 2 - 2} \\\\\n&= y^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{4^5\\times4^3}{4^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4^{6}$",
          "worked": "$$\\begin{align*}\n\\frac{4^5\\times4^3}{4^2} &= 4^{5 + 3 - 2} \\\\\n&= 4^{6}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a^5\\times a^2}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{6}$",
          "worked": "$$\\begin{align*}\n\\frac{a^5\\times a^2}{a} &= a^{5 + 2 - 1} \\\\\n&= a^{6}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{p^2\\times p^3}{p^7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{p^{2}}$",
          "worked": "$$\\begin{align*}\n\\frac{p^2\\times p^3}{p^7} &= \\frac{1}{p^{- 2 - 3 + 7}} \\\\\n&= \\frac{1}{p^{2}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{t^2}{t^4\\times t^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{t^{4}}$",
          "worked": "$$\\begin{align*}\n\\frac{t^2}{t^4\\times t^2} &= \\frac{1}{t^{- 2 + 4 + 2}} \\\\\n&= \\frac{1}{t^{4}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{3^4\\times3^2\\times3^2}{3^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^{4}$",
          "worked": "$$\\begin{align*}\n\\frac{3^4\\times3^2\\times3^2}{3^4} &= 3^{4 + 2 + 2 - 4} \\\\\n&= 3^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{y^4\\times y^3}{y^2\\times y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^{4}$",
          "worked": "$$\\begin{align*}\n\\frac{y^4\\times y^3}{y^2\\times y} &= y^{4 + 3 - 2 - 1} \\\\\n&= y^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q8-i",
