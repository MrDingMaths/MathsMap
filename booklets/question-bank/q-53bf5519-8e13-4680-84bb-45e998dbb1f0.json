      "evidence": ".booklet-work/reasoning-ratings/calls/general-and-point-gradient-form-v1/f2dd41a8f595f304ff8111b696b215c3d737ddb2de91ee1806855aa59442b6de-1792559140788/last-message.txt"
    }
  },
  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Decide if these pairs of lines are parallel, perpendicular, or neither.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=3x-1\\\\y&=3x+7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$$\\begin{aligned}m_1&=3\\\\m_2&=3\\end{aligned}$$\nThe gradients are equal, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=\\frac{1}{2}x-6\\\\y&=\\frac{x}{2}-4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Parallel.",
          "worked": "$$\\begin{aligned}m_1&=\\frac{1}{2}\\\\m_2&=\\frac{1}{2}\\end{aligned}$$\nThe gradients are equal, so the lines are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=-\\frac{2}{3}x+1\\\\y&=\\frac{2}{3}x-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Neither.",
          "worked": "$$\\begin{aligned}m_1&=-\\frac{2}{3}\\\\m_2&=\\frac{2}{3}\\\\m_1m_2&=-\\frac{4}{9}\\end{aligned}$$\nThe gradients are unequal and their product is not $-1$, so the lines are neither parallel nor perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=-8x+4\\\\y&=\\frac{1}{8}x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular.",
          "worked": "$$\\begin{aligned}m_1&=-8\\\\m_2&=\\frac{1}{8}\\\\m_1m_2&=-8\\times\\frac{1}{8}=-1\\end{aligned}$$\nThe gradients are negative reciprocals, so the lines are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p20-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$x-y=4$$\n$$y=-x+\\frac{1}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular.",
          "worked": "$$\\begin{aligned}x-y&=4\\\\-y&=4-x\\\\y&=x-4\\\\m_1&=1\\\\m_2&=-1\\end{aligned}$$\nThe gradients are negative reciprocals, so the lines are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}3x-y&=2\\\\x+3y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Perpendicular.",
          "worked": "$$\\begin{aligned}3x-y&=2\\\\-y&=2-3x\\\\y&=3x-2\\end{aligned}$$\n$$\\begin{aligned}x+3y&=5\\\\3y&=-x+5\\\\y&=-\\frac{1}{3}x+\\frac{5}{3}\\end{aligned}$$\nThe gradients are $3$ and $-\\frac{1}{3}$. They are negative reciprocals, so the lines are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
