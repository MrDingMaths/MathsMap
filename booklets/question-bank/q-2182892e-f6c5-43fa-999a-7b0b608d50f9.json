      {
        "id": "p12-ch18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the formula for the distance $d$ (in kilometres) travelled by the car in $t$ hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=80t$",
          "worked": "Distance equals speed multiplied by time.\n\n$\\begin{align*}d&=80\\times t\\\\d&=80t\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-ch18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the gradient of the straight-line graph of $d$ against $t$?",
        "layout": "list",
