  "content": {
    "id": "p40-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The number of books in a local library varies from year to year. Three years ago, the number fell by 25%, then it rose 41% the following year, and finally rose 8% last year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the percentage increase or decrease over the three years, correct to the nearest 1%?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "14% increase.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.75\\times1.41\\times1.08\\\\\\text{Combined multiplier}&=1.1421\\\\\\text{Percentage increase}&=(1.1421-1)\\times100\\%\\\\\\text{Percentage increase}&=14.21\\%\\\\\\text{Percentage increase}&\\approx14\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p40-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If there were 429000 books in the library three years ago, approximately how many books are in the library now? Give your answer to the nearest whole book.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "489961 books.",
          "worked": "$$\\begin{align*}\\text{Number now}&=429000\\times0.75\\times1.41\\times1.08\\\\\\text{Number now}&=489960.9\\\\\\text{Number now}&\\approx489961\\text{ books}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
