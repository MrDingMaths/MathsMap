  "content": {
    "id": "p55-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A cable is suspended across a farm channel. The height ($h$), in metres, of the cable above the water surface is modelled by the equation $h=3x^2-21x+30$, where $x$ metres is the distance from one side of the channel. The graph of $h$ vs $x$ is shown below.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p55-q12-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"quadratic model curve distinguished from coordinate axes\"}],\"reference\":\"source page 55 p55-q12-graph\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.08cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\draw[black,line width=0.5pt,<->] (0,-22)--(0,52) node[above,font=\\fontsize{10}{12}\\selectfont] {$h$};\n\\draw[black,line width=0.5pt,->] (0,0)--(7.3,0) node[right,font=\\fontsize{10}{12}\\selectfont] {$x$};\n\\draw[curveBlue,line width=0.8pt,->] plot[domain=0:7,samples=100] (\\x,{3*\\x*\\x-21*\\x+30});\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 55,
          "sourceRegion": "Question 12, graph to the left of parts a and b",
          "description": "Unshaded upward-opening parabola with an arrow at its right end, a vertical axis with arrows at both ends and a horizontal axis with a right arrow. Axes are labelled h and x. No ticks, numeric labels, grid or origin label. House styling uses black axes and the standard blue curve.",
          "mathematics": "Plot h=3x^2-21x+30. The roots are x=2 and x=5, and the vertex is (3.5,-6.75); these values determine the curve but are not labelled in the question figure.",
          "answerVisibility": "Only the supplied unlabelled curve and axes are visible; numerical roots, vertex and calculated height remain hidden."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p55-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Factorise the right-hand side of the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x-2)(x-5)$",
          "worked": "The product is $10$ and the sum is $-7$, so use $-2$ and $-5$.\n$$\\begin{align*}3x^2-21x+30&=3(x^2-7x+10)\\\\&=3(x^2-2x-5x+10)\\\\&=3\\bigl[x(x-2)-5(x-2)\\bigr]\\\\&=3(x-2)(x-5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p55-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the height of the cable when $x=3$. Interpret this result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=-6\\text{ m}$; the cable is $6\\text{ m}$ below the water surface.",
          "worked": "$$\\begin{align*}h&=3(3)^2-21(3)+30\\\\&=-6\\text{ m}.\\end{align*}$$\nThe negative height means the cable is $6\\text{ m}$ below the water surface.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p55-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine where the cable is at the level of the water surface.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ m}$ and $5\\text{ m}$ from the side of the channel.",
          "worked": "At the water surface, $h=0$.\n$$\\begin{align*}3(x-2)(x-5)&=0\\\\x-2&=0\\quad\\text{or}\\quad x-5=0\\\\x&=2\\quad\\text{or}\\quad x=5.\\end{align*}$$\nThe cable is at the water surface $2\\text{ m}$ and $5\\text{ m}$ from the side of the channel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
