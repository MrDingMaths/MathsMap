  "content": {
    "id": "p28-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Calculate, give answer in scientific notation and round to four s.f.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$10^{-0.4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.981\\times10^{-1}$",
          "worked": "$$\\begin{align*}10^{-0.4}&=3.981071705\\ldots\\times10^{-1}\\\\10^{-0.4}&\\approx3.981\\times10^{-1}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{240-13\\times17}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.263\\times10^{-2}$",
          "worked": "$$\\begin{align*}\\frac{1}{240-13\\times17}&=\\frac{1}{240-221}\\\\&=\\frac{1}{19}\\\\&=5.263157894\\ldots\\times10^{-2}\\\\&\\approx5.263\\times10^{-2}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p28-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$20000\\times(1.01)^{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.565\\times10^{4}$",
          "worked": "$$\\begin{align*}20000\\times(1.01)^{25}&=2.564863990\\ldots\\times10^{4}\\\\&\\approx2.565\\times10^{4}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p28-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{11.3}{\\sqrt{19.5-14.7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.158\\times10^{0}$",
          "worked": "$$\\begin{align*}\\frac{11.3}{\\sqrt{19.5-14.7}}&=\\frac{11.3}{\\sqrt{4.8}}\\\\&=5.157720749\\ldots\\times10^{0}\\\\&\\approx5.158\\times10^{0}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p28-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3\\frac{2}{3}+5\\frac{1}{4}}{4\\frac{1}{2}+6\\frac{4}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.891\\times10^{-1}$",
          "worked": "$$\\begin{align*}\\frac{3\\frac{2}{3}+5\\frac{1}{4}}{4\\frac{1}{2}+6\\frac{4}{5}}&=\\frac{\\frac{11}{3}+\\frac{21}{4}}{\\frac{9}{2}+\\frac{34}{5}}\\\\&=\\frac{\\frac{107}{12}}{\\frac{113}{10}}\\\\&=\\frac{535}{678}\\\\&=7.890855457\\ldots\\times10^{-1}\\\\&\\approx7.891\\times10^{-1}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p28-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$(87.3\\times10^{4})\\div(0.629\\times10^{-8})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.388\\times10^{14}$",
          "worked": "$$\\begin{align*}\\frac{87.3\\times10^{4}}{0.629\\times10^{-8}}&=\\frac{87300}{629}\\times10^{4-(-8)}\\\\&=\\frac{87300}{629}\\times10^{12}\\\\&=1.387917329\\ldots\\times10^{14}\\\\&\\approx1.388\\times10^{14}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
