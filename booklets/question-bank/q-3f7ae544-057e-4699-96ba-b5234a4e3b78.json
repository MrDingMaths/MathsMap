            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 19, p19-q1-a-diagram\"}\n\\begin{tikzpicture}[line width=0.8pt,draw=black,text=black,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (T) at (0,1.6);\\coordinate (R) at (2.3,0.25);\\coordinate (B) at (0,-1.1);\\coordinate (L) at (-1,0.25);\n\\draw (T)--(R)--(B)--(L)--cycle;\n\\node at ($(T)!0.24!(B)$) {$90^{\\circ}$};\n\\node at ($(R)!0.25!(L)$) {$60^{\\circ}$};\n\\node at ($(B)!0.23!(T)$) {$90^{\\circ}$};\n\\node at ($(L)!0.22!(R)$) {$120^{\\circ}$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 50,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 19,
              "sourceRegion": "Exercise 15D, question 1(a)",
              "description": "Unlabelled diamond-like quadrilateral with four interior-angle givens.",
              "mathematics": "Top and bottom angles are 90 degrees; left is 120 degrees and right is 60 degrees.",
              "answerVisibility": "Only supplied angle values are visible."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Both pairs of opposite angles are supplementary:\n$$\\begin{align*}90^{\\circ}+90^{\\circ}&=180^{\\circ}\\\\120^{\\circ}+60^{\\circ}&=180^{\\circ}.\\end{align*}$$\nTherefore, the quadrilateral can be inscribed in a circle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
