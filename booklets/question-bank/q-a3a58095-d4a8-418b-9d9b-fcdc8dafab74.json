  "content": {
    "id": "p35-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A gym is using a new training program to increase bicep circumference.\nEach fortnight the bicep circumference of each person is measured.\nAt the end of the program, the bicep measurements are compared with time.\nThe correlation coefficient is $0.64$. What does this mean?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "There is a moderate positive relationship between time in the training program and bicep circumference.",
      "worked": "Since $r=0.64$ is positive and lies between $0.50$ and $0.75$ on the supplied scale, the relationship is moderate and positive. Bicep circumference tends to increase as time in the training program increases.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 22
  },
