  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The circulation of a newspaper on 1 January 2009 was $720\\,000$. On 1 January 2010, the circulation was $800\\,000$. Find the percentage increase in circulation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$11\\frac{1}{9}\\%$",
      "worked": "$$\\begin{align*}\\text{Increase in circulation}&=800\\,000-720\\,000\\\\\\text{Increase in circulation}&=80\\,000\\end{align*}$$\n\n$$\\begin{align*}\\text{Percentage increase}&=\\frac{80\\,000}{720\\,000}\\times100\\%\\\\\\text{Percentage increase}&=\\frac{100}{9}\\%\\\\\\text{Percentage increase}&=11\\frac{1}{9}\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
