  "content": {
    "id": "p27-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Evaluate:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^1 e^x(2e^x-1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^2-e$",
          "worked": "$$\\begin{align*}\\int_0^1 e^x(2e^x-1)\\,dx&=\\int_0^1(2e^{2x}-e^x)\\,dx\\\\&=\\left[e^{2x}-e^x\\right]_0^1\\\\&=(e^2-e)-(1-1)\\\\&=e^2-e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p27-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_{-1}^1(e^x+2)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12(e^2-e^{-2})+4(e-e^{-1})+8$",
          "worked": "$$\\begin{align*}\\int_{-1}^1(e^x+2)^2\\,dx&=\\int_{-1}^1(e^{2x}+4e^x+4)\\,dx\\\\&=\\left[\\frac12e^{2x}+4e^x+4x\\right]_{-1}^1\\\\&=\\left(\\frac12e^2+4e+4\\right)-\\left(\\frac12e^{-2}+4e^{-1}-4\\right)\\\\&=\\frac12(e^2-e^{-2})+4(e-e^{-1})+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p27-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_0^1(e^x-1)(e^{-x}+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e+e^{-1}-2$",
          "worked": "$$\\begin{align*}\\int_0^1(e^x-1)(e^{-x}+1)\\,dx&=\\int_0^1(1+e^x-e^{-x}-1)\\,dx\\\\&=\\int_0^1(e^x-e^{-x})\\,dx\\\\&=\\left[e^x+e^{-x}\\right]_0^1\\\\&=(e+e^{-1})-(1+1)\\\\&=e+e^{-1}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p27-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{-1}^1(e^{2x}+e^{-x})(e^{2x}-e^{-x})\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14(e^4-e^{-4})+\\frac12(e^{-2}-e^2)$",
          "worked": "$$\\begin{align*}\\int_{-1}^1(e^{2x}+e^{-x})(e^{2x}-e^{-x})\\,dx&=\\int_{-1}^1(e^{4x}-e^{-2x})\\,dx\\\\&=\\left[\\frac14e^{4x}+\\frac12e^{-2x}\\right]_{-1}^1\\\\&=\\left(\\frac14e^4+\\frac12e^{-2}\\right)-\\left(\\frac14e^{-4}+\\frac12e^2\\right)\\\\&=\\frac14(e^4-e^{-4})+\\frac12(e^{-2}-e^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p27-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_0^1\\frac{e^{3x}+e^x}{e^{2x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e-e^{-1}$",
          "worked": "$$\\begin{align*}\\int_0^1\\frac{e^{3x}+e^x}{e^{2x}}\\,dx&=\\int_0^1(e^x+e^{-x})\\,dx\\\\&=\\left[e^x-e^{-x}\\right]_0^1\\\\&=(e-e^{-1})-(1-1)\\\\&=e-e^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p27-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-1}^1\\frac{e^x-1}{e^{2x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e-e^{-1}+\\frac12(e^{-2}-e^2)$",
          "worked": "$$\\begin{align*}\\int_{-1}^1\\frac{e^x-1}{e^{2x}}\\,dx&=\\int_{-1}^1(e^{-x}-e^{-2x})\\,dx\\\\&=\\left[-e^{-x}+\\frac12e^{-2x}\\right]_{-1}^1\\\\&=\\left(-e^{-1}+\\frac12e^{-2}\\right)-\\left(-e+\\frac12e^2\\right)\\\\&=e-e^{-1}+\\frac12(e^{-2}-e^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
