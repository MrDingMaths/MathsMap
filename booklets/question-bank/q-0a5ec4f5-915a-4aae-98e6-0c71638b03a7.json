  "content": {
    "id": "p16-q103-108-root",
    "type": "question",
    "label": null,
    "prompt": "By using the identity $a^{\\log_a(x)}=x$, simplify the following. For expressions involving $a$, assume $a>0$ and $a\\ne1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q103",
        "type": "part",
        "label": "a",
        "prompt": "$a^{\\log_a(2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$a^{\\log_a(2)}=2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p16-q104",
        "type": "part",
        "label": "b",
        "prompt": "$a^{1+\\log_a(5)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5a$",
          "worked": "$$\\begin{align*}a^{1+\\log_a(5)}&=a\\cdot a^{\\log_a(5)}\\\\a^{1+\\log_a(5)}&=5a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q105",
        "type": "part",
        "label": "c",
        "prompt": "$e^{\\ln(3)+\\ln(4)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{align*}e^{\\ln(3)+\\ln(4)}&=e^{\\ln(3)}\\cdot e^{\\ln(4)}\\\\e^{\\ln(3)+\\ln(4)}&=3\\cdot4\\\\e^{\\ln(3)+\\ln(4)}&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q106",
        "type": "part",
        "label": "d",
        "prompt": "$e^{3\\ln(5)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125$",
          "worked": "$$\\begin{align*}e^{3\\ln(5)}&=\\left(e^{\\ln(5)}\\right)^3\\\\e^{3\\ln(5)}&=5^3\\\\e^{3\\ln(5)}&=125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q107",
        "type": "part",
        "label": "e",
        "prompt": "$e^{\\frac12\\ln(9)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}e^{\\frac12\\ln(9)}&=\\left(e^{\\ln(9)}\\right)^{1/2}\\\\e^{\\frac12\\ln(9)}&=\\sqrt9\\\\e^{\\frac12\\ln(9)}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q108",
        "type": "part",
        "label": "f",
        "prompt": "$a^{2\\log_{a^2}(3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$\n\nRewrite the exponential using base $a^2$.",
          "worked": "$$\\begin{align*}a^{2\\log_{a^2}(3)}&=(a^2)^{\\log_{a^2}(3)}\\\\a^{2\\log_{a^2}(3)}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
