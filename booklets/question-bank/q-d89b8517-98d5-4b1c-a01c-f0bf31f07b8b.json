  "content": {
    "id": "p28-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "Write $\\frac{x+3}{x+5}$ in the form $a+\\frac{b}{x+5}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1-\\frac{2}{x+5}$",
      "worked": "$$\\begin{align*}\\frac{x+3}{x+5}&=a+\\frac{b}{x+5}\\\\x+3&=a(x+5)+b\\\\x+3&=ax+5a+b\\end{align*}$$\nEquate coefficients and constant terms.\n$$\\begin{align*}a&=1\\\\5a+b&=3\\\\5+b&=3\\\\b&=-2\\end{align*}$$\nHence $\\frac{x+3}{x+5}=1-\\frac{2}{x+5}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
