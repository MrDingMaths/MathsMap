        "answer": {
          "short": "$1{,}234{,}512{,}345$",
          "worked": "$$\\begin{align*}100{,}001\\times12{,}345&=(100{,}000+1)\\times12{,}345\\\\100{,}001\\times12{,}345&=100{,}000\\times12{,}345+12{,}345\\\\100{,}001\\times12{,}345&=1{,}234{,}500{,}000+12{,}345\\\\100{,}001\\times12{,}345&=1{,}234{,}512{,}345\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p5-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$999{,}999\\times12{,}345$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12{,}344{,}987{,}655$",
          "worked": "$$\\begin{align*}999{,}999\\times12{,}345&=(1{,}000{,}000-1)\\times12{,}345\\\\999{,}999\\times12{,}345&=1{,}000{,}000\\times12{,}345-12{,}345\\\\999{,}999\\times12{,}345&=12{,}345{,}000{,}000-12{,}345\\\\999{,}999\\times12{,}345&=12{,}344{,}987{,}655\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
