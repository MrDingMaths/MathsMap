  "content": {
    "id": "p7-q4-content",
    "type": "question",
    "label": "4",
    "prompt": "A television costs $\\$500$. Its price is increased by $5\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What is its new price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$525$",
          "worked": "$$\\begin{align*}\\text{New price} &= \\$500\\times1.05\\\\\\text{New price} &= \\$525\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "After a year its price is decreased by $5\\%$. What is its price now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$498.75$",
          "worked": "$$\\begin{align*}\\text{Price now} &= \\$525\\times0.95\\\\\\text{Price now} &= \\$498.75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Does increasing by $5\\%$ then decreasing by $5\\%$ keep the price the same?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "No. The decrease applies to the increased price, so the final price is $\\$498.75$, which is $\\$1.25$ less than the original $\\$500$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
