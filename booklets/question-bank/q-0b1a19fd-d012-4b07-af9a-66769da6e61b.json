  "content": {
    "id": "v2-foundation-section-slot-11-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A fair 8-sided die has each face numbered from 1–8.\nCalculate the expected frequency of each event from the given number of trials.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-foundation-section-slot-11-lower-s11l-a",
        "type": "part",
        "label": "a",
        "prompt": "Rolling a 3 (40 trials).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5",
          "worked": "$$\\begin{align*}P(\\text{Rolling 3})&=\\frac18\\\\f&=np\\\\f&=40\\times\\frac18\\\\f&=5\\end{align*}$$\nExpected frequency: 5 rolls of 3.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-foundation-section-slot-11-lower-s11l-b",
        "type": "part",
        "label": "b",
        "prompt": "Rolling a number less than 3 (200 trials).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "50",
          "worked": "The favourable faces are 1 and 2.\n$$\\begin{align*}P(\\text{less than 3})&=\\frac28\\\\P(\\text{less than 3})&=\\frac14\\\\f&=np\\\\f&=200\\times\\frac14\\\\f&=50\\end{align*}$$\nExpected frequency: 50 rolls less than 3.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a: 5; b: 50",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
  },
