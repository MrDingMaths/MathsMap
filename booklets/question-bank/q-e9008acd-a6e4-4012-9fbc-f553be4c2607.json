  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Over 14 days, it rained on 8 days, snowed on 3 days, and was fine the rest. Write the requested ratios or fraction.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Rainy days to snowy days.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8:3$",
          "worked": "There were 8 rainy days and 3 snowy days.\n\nRainy days : snowy days $=8:3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Snowy days to total days.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:14$",
          "worked": "There were 3 snowy days out of 14 days.\n\nSnowy days : total days $=3:14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Fine days to rainy days.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3:8$",
          "worked": "$$\\begin{align*}\\text{Fine days}&=14-8-3\\\\&=3\\end{align*}$$\n\nFine days : rainy days $=3:8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p6-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Fine days as a fraction of the fortnight.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{14}$",
          "worked": "$$\\begin{align*}\\text{Fine days}&=14-8-3\\\\&=3\\end{align*}$$\n\nA fortnight has 14 days, so the fraction of fine days is $\\frac{3}{14}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
