  "content": {
    "id": "p22-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the values of $m$ for which the quadratic equation $x^2-3mx+9=0$ has:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "real roots,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\le -2$ or $m\\ge 2$.",
          "worked": "Real roots require $\\Delta\\ge0$.\n$$\\begin{align*}\\Delta&=(-3m)^2-4(1)(9)\\\\&=9m^2-36\\\\9m^2-36&\\ge0\\\\m^2&\\ge4\\end{align*}$$\nHence $m\\le-2$ or $m\\ge2$, including equal roots at the endpoints.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "equal roots,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-2$ or $m=2$.",
          "worked": "Equal roots require $\\Delta=0$.\n$$\\begin{align*}\\Delta&=(-3m)^2-4(1)(9)\\\\&=9m^2-36\\\\9m^2-36&=0\\\\m^2&=4\\\\m&=\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "unreal roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2<m<2$.",
          "worked": "Unreal roots require $\\Delta<0$.\n$$\\begin{align*}\\Delta&=(-3m)^2-4(1)(9)\\\\&=9m^2-36\\\\9m^2-36&<0\\\\m^2&<4\\end{align*}$$\nHence $-2<m<2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
