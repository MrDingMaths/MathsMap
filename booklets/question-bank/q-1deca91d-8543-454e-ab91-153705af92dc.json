  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A bag contains three types of balls: red, green and blue. The ratio of red to green balls is $2:3$ and the ratio of green to blue balls is $4:5$. Find the ratio of red to blue balls.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8:15$",
      "worked": "Make the number of green parts equal in both ratios.\n\n$$\\begin{align*}\\text{red}:\\text{green}&=2:3\\\\\\text{red}:\\text{green}&=8:12\\\\\\text{green}:\\text{blue}&=4:5\\\\\\text{green}:\\text{blue}&=12:15\\end{align*}$$\n\nThus red : green : blue is $8:12:15$, so red : blue is $8:15$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
