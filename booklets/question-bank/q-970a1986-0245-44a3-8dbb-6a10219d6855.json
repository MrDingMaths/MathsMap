  "content": {
    "id": "p24-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the sum of the series\n$$1+\\frac12+\\frac13+\\frac14+\\frac16+\\frac18+\\cdots$$\nwhose terms consist of the reciprocals of the positive integers whose only prime divisors are 2 and 3.",
    "layout": "list",
    "columns": null,
