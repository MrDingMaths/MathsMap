  "content": {
    "id": "p11-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "A football oval has area $18\\,000\\text{ m}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Express in ha.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.8\\text{ ha}$",
          "worked": "$$\\begin{align*}18\\,000\\div10\\,000&=1.8\\text{ ha}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "A groundskeeper applies fertiliser at a rate of 1 bag per $500\\text{ m}^2$. How many bags are needed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "36 bags",
          "worked": "$$\\begin{align*}18\\,000\\div500&=36\\text{ bags}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "Each bag costs $\\$12$. Find the total cost.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$432$",
          "worked": "$$\\begin{align*}36\\times\\$12&=\\mathbf{\\$432}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
