  "content": {
    "id": "v2-2e53a-p31-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "A house plan has a scale of $1:2000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-2e53a-p31-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many centimetres in real life does $1\\text{ cm}$ on the plan equal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2000\\text{ cm}$",
          "worked": "The scale is image : original, so $1$ unit on the plan represents $2000$ units in real life.\n$$\\begin{align*}\\text{Original length}&=1\\times2000\\text{ cm}\\\\&=2000\\text{ cm}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-2e53a-p31-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, how many metres does $1\\text{ cm}$ represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ m}$",
          "worked": "$100\\text{ cm}=1\\text{ m}$.\n$$\\begin{align*}\\text{Original length}&=(2000\\div100)\\text{ m}\\\\&=20\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-2e53a-p31-practice-slot-2-slot-2-q-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the scale factor, as a fraction?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2000}$",
          "worked": "Use image length divided by original length, with both lengths in the same units.\n$$\\begin{align*}\\text{Scale factor}&=\\frac{\\text{image length}}{\\text{original length}}\\\\&=\\frac{1}{2000}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
