  "content": {
    "id": "v2-e0e51-p15-practice-slot-5-upper-root",
    "type": "question",
    "label": null,
    "prompt": "At a community centre, 17 people do yoga only, 24 people do pilates, and 6 people do both yoga and pilates.\nHow many people do yoga or pilates?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "41 people.",
      "worked": "Let $Y$ and $P$ be the sets of people who do yoga and pilates. The 17 who do yoga only, together with the 6 who do both, make $|Y|=17+6=23$.\n$$\\begin{align*}|Y\\cup P|&=|Y|+|P|-|Y\\cap P|\\\\|Y\\cup P|&=23+24-6\\\\|Y\\cup P|&=41\\end{align*}$$\n41 people do yoga or pilates.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
