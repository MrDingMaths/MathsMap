      {
        "id": "p19-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(a^{\\frac12}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1a$",
          "worked": "$$\\begin{aligned}\\left(a^{\\frac12}\\right)^{-2}&=a^{\\frac12\\times(-2)}\\\\\\left(a^{\\frac12}\\right)^{-2}&=a^{-1}\\\\\\left(a^{\\frac12}\\right)^{-2}&=\\frac1a\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(b^{-\\frac23}\\right)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{b^4}$",
          "worked": "$$\\begin{aligned}\\left(b^{-\\frac23}\\right)^6&=b^{-\\frac23\\times6}\\\\\\left(b^{-\\frac23}\\right)^6&=b^{-4}\\\\\\left(b^{-\\frac23}\\right)^6&=\\frac1{b^4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q7-c",
