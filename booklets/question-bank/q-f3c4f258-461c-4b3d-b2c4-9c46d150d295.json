        "answer": {
          "short": "$\\frac1{81y^2}$",
          "worked": "$$\\begin{aligned}\\left(3y^{\\frac12}\\right)^{-4}&=3^{-4}y^{\\frac12\\times(-4)}\\\\\\left(3y^{\\frac12}\\right)^{-4}&=\\frac1{81}y^{-2}\\\\\\left(3y^{\\frac12}\\right)^{-4}&=\\frac1{81y^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^{\\frac12}\\times x^{-\\frac32}$",
