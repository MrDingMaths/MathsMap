        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{8x^2}$",
          "worked": "$$\\begin{aligned}\\left(2x^{\\frac23}\\right)^{-3}&=2^{-3}x^{\\frac23\\times(-3)}\\\\\\left(2x^{\\frac23}\\right)^{-3}&=\\frac18x^{-2}\\\\\\left(2x^{\\frac23}\\right)^{-3}&=\\frac1{8x^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(3y^{\\frac12}\\right)^{-4}$",
