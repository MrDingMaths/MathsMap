  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Sketch $y=(x-2)(x-8)$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave up.",
          "worked": "$a=1>0$, so the parabola is concave up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,16)$.",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=(0-2)(0-8)\\\\y&=16\\end{align*}$$\nThe $y$-intercept is $(0,16)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,0)$ and $(8,0)$.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=(x-2)(x-8)\\end{align*}$$\nBy the null factor law, $x-2=0$ or $x-8=0$, so $x=2$ or $x=8$.\nThe $x$-intercepts are $(2,0)$ and $(8,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p8-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,-9)$.",
          "worked": "Average the $x$-intercepts:\n$$\\begin{align*}x&=\\frac{2+8}{2}\\\\x&=5\\end{align*}$$\nSubstitute $x=5$:\n$$\\begin{align*}y&=(5-2)(5-8)\\\\y&=-9\\end{align*}$$\nThe vertex is $(5,-9)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ],
    "sharedSolutionDiagrams": [
