        "type": "part",
        "label": "a",
        "prompt": "the powers of $4$ up to $4^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4^1=4$, $4^2=16$, $4^3=64$, $4^4=256$, $4^5=1024$",
          "worked": "$$\\begin{align*}4^1&=4\\\\4^2&=4\\times4=16\\\\4^3&=4\\times4\\times4=64\\\\4^4&=4\\times4\\times4\\times4=256\\\\4^5&=4\\times4\\times4\\times4\\times4=1024\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p3-ch2-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "the powers of $10$ up to $10^9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^1=10$, $10^2=100$, $10^3=1000$, $10^4=10\\,000$, $10^5=100\\,000$, $10^6=1\\,000\\,000$, $10^7=10\\,000\\,000$, $10^8=100\\,000\\,000$, $10^9=1\\,000\\,000\\,000$",
          "worked": "$$\\begin{align*}10^1&=10\\\\10^2&=10\\times10=100\\\\10^3&=10\\times10\\times10=1000\\\\10^4&=10\\times10\\times10\\times10\\\\10^4&=10\\,000\\\\10^5&=10\\times10\\times10\\times10\\times10\\\\10^5&=100\\,000\\\\10^6&=10\\times10\\times10\\times10\\times10\\times10\\\\10^6&=1\\,000\\,000\\\\10^7&=10\\times10\\times10\\times10\\times10\\times10\\times10\\\\10^7&=10\\,000\\,000\\\\10^8&=10\\times10\\times10\\times10\\times10\\times10\\times10\\times10\\\\10^8&=100\\,000\\,000\\\\10^9&=10\\times10\\times10\\times10\\times10\\times10\\times10\\times10\\times10\\\\10^9&=1\\,000\\,000\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 120
      }
    ]
