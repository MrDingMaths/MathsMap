  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q3-a",
        "type": "group",
        "label": "a",
        "prompt": "The volume of a square pyramid with base length $x$ and height $h$ is $V=\\frac{1}{3}x^2h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q3-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Express $x$ in terms of $V$ and $h$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\sqrt{\\dfrac{3V}{h}}$",
              "worked": "$$\\begin{align*}3V&=x^2h\\\\x^2&=\\frac{3V}{h}\\\\x&=\\sqrt{\\frac{3V}{h}}\\end{align*}$$\n\nTake the positive root because $x$ is a length.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p19-q3-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find $x$ if the volume is $15\\,\\mathrm{cm}^3$ and height is $5\\,\\mathrm{cm}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=3\\,\\mathrm{cm}$",
              "worked": "$$\\begin{align*}x&=\\sqrt{\\frac{3\\times 15}{5}}\\,\\mathrm{cm}\\\\x&=\\sqrt{9}\\,\\mathrm{cm}\\\\x&=3\\,\\mathrm{cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p19-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "The volume of a cylinder is $V=\\pi r^2h$, where $r$ is the radius and $h$ is the height.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Express $r$ in terms of $V$ and $h$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=\\sqrt{\\dfrac{V}{\\pi h}}$",
              "worked": "$$\\begin{align*}r^2&=\\frac{V}{\\pi h}\\\\r&=\\sqrt{\\frac{V}{\\pi h}}\\end{align*}$$\n\nTake the positive root because $r$ is a radius.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p19-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find the radius if the volume is $100\\,\\mathrm{cm}^3$ and height is $4\\pi\\,\\mathrm{cm}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=\\dfrac{5}{\\pi}\\,\\mathrm{cm}$",
              "worked": "$$\\begin{align*}r&=\\sqrt{\\frac{100}{\\pi\\times 4\\pi}}\\,\\mathrm{cm}\\\\r&=\\sqrt{\\frac{25}{\\pi^2}}\\,\\mathrm{cm}\\\\r&=\\frac{5}{\\pi}\\,\\mathrm{cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      },
      {
        "id": "p19-q3-c",
        "type": "group",
        "label": "c",
        "prompt": "The volume of a sphere is $V=\\frac{4}{3}\\pi r^3$, where $r$ is the radius.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q3-c-i",
            "type": "part",
            "label": "i",
            "prompt": "Express $r$ in terms of $V$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=\\sqrt[3]{\\dfrac{3V}{4\\pi}}$",
              "worked": "$$\\begin{align*}3V&=4\\pi r^3\\\\r^3&=\\frac{3V}{4\\pi}\\\\r&=\\sqrt[3]{\\frac{3V}{4\\pi}}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p19-q3-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find $r$ if $V=\\frac{9}{2}\\pi\\,\\mathrm{cm}^3$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$r=\\dfrac{3}{2}\\,\\mathrm{cm}$",
              "worked": "$$\\begin{align*}r&=\\sqrt[3]{\\frac{3\\times(9\\pi/2)}{4\\pi}}\\,\\mathrm{cm}\\\\r&=\\sqrt[3]{\\frac{27}{8}}\\,\\mathrm{cm}\\\\r&=\\frac{3}{2}\\,\\mathrm{cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      }
    ]
  },
