  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the indefinite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int x(x+2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}+x^2+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int x(x+2)\\,dx\\\\&=\\int(x^2+2x)\\,dx\\\\&=\\frac{x^3}{3}+x^2+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int x(4-x^2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-\\dfrac{x^4}{4}+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int x(4-x^2)\\,dx\\\\&=\\int(4x-x^3)\\,dx\\\\&=2x^2-\\frac{x^4}{4}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int x^2(5-3x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x^3}{3}-\\dfrac{3x^4}{4}+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int x^2(5-3x)\\,dx\\\\&=\\int(5x^2-3x^3)\\,dx\\\\&=\\frac{5x^3}{3}-\\frac{3x^4}{4}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int x^3(x-5)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^5}{5}-\\dfrac{5x^4}{4}+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int x^3(x-5)\\,dx\\\\&=\\int(x^4-5x^3)\\,dx\\\\&=\\frac{x^5}{5}-\\frac{5x^4}{4}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int(x-3)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}-3x^2+9x+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int(x-3)^2\\,dx\\\\&=\\int(x^2-6x+9)\\,dx\\\\&=\\frac{x^3}{3}-3x^2+9x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int(2x+1)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4x^3}{3}+2x^2+x+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int(2x+1)^2\\,dx\\\\&=\\int(4x^2+4x+1)\\,dx\\\\&=\\frac{4x^3}{3}+2x^2+x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\displaystyle\\int(1-x^2)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-\\dfrac{2x^3}{3}+\\dfrac{x^5}{5}+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int(1-x^2)^2\\,dx\\\\&=\\int(1-2x^2+x^4)\\,dx\\\\&=x-\\frac{2x^3}{3}+\\frac{x^5}{5}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\displaystyle\\int(2-3x)(2+3x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x-3x^3+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int(2-3x)(2+3x)\\,dx\\\\&=\\int(4-9x^2)\\,dx\\\\&=4x-3x^3+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\displaystyle\\int(x^2-3)(1-2x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{3}-\\dfrac{x^4}{2}-3x+3x^2+C$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\int(x^2-3)(1-2x)\\,dx\\\\&=\\int(x^2-2x^3-3+6x)\\,dx\\\\&=\\frac{x^3}{3}-\\frac{x^4}{2}-3x+3x^2+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
