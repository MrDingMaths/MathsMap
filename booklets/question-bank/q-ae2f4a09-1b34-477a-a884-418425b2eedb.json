  "content": {
    "id": "p26-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Work out:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q16-initial",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p26-q16-initial-a",
            "type": "part",
            "label": "a",
            "prompt": "$30\\%$ of $80$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24$",
              "worked": "$$\\begin{align*}10\\%\\text{ of }80 &= 80\\div10=8\\\\30\\%\\text{ of }80 &= 3\\times8=24\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p26-q16-initial-b",
            "type": "part",
            "label": "b",
            "prompt": "$80\\%$ of $30$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$24$",
              "worked": "$$\\begin{align*}10\\%\\text{ of }30 &= 30\\div10=3\\\\80\\%\\text{ of }30 &= 8\\times3=24\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p26-q16-observation",
        "type": "part",
        "label": "c",
        "prompt": "What do you notice about your answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "They are equal.",
          "worked": "Both answers are $24$. In general, $a\\%$ of $b$ equals $b\\%$ of $a$, since both equal $\\frac{ab}{100}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p26-q16-without-calculator",
        "type": "group",
        "label": "",
        "prompt": "Without using a calculator, find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p26-q16-without-calculator-a",
            "type": "part",
            "label": "d",
            "prompt": "$32\\%$ of $50$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16$",
              "worked": "$$\\begin{align*}32\\%\\text{ of }50 &= 50\\%\\text{ of }32\\\\32\\%\\text{ of }50 &= 32\\div2=16\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p26-q16-without-calculator-b",
            "type": "part",
            "label": "e",
            "prompt": "$16\\%$ of $25$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$$\\begin{align*}16\\%\\text{ of }25 &= 25\\%\\text{ of }16\\\\16\\%\\text{ of }25 &= 16\\div4=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p26-q16-without-calculator-c",
            "type": "part",
            "label": "f",
            "prompt": "$36\\%$ of $25$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9$",
              "worked": "$$\\begin{align*}36\\%\\text{ of }25 &= 25\\%\\text{ of }36\\\\36\\%\\text{ of }25 &= 36\\div4=9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p26-q16-without-calculator-d",
            "type": "part",
            "label": "g",
            "prompt": "$17\\%$ of $50$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8.5$",
              "worked": "$$\\begin{align*}17\\%\\text{ of }50 &= 50\\%\\text{ of }17\\\\17\\%\\text{ of }50 &= 17\\div2=8.5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p26-q16-without-calculator-e",
            "type": "part",
            "label": "h",
            "prompt": "$64\\%$ of $12.5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8$",
              "worked": "$$\\begin{align*}64\\%\\text{ of }12.5 &= 12.5\\%\\text{ of }64\\\\25\\%\\text{ of }64 &= 64\\div4=16\\\\12.5\\%\\text{ of }64 &= 16\\div2=8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p26-q16-without-calculator-f",
            "type": "part",
            "label": "i",
            "prompt": "$90\\%$ of $66\\frac{2}{3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$60$",
              "worked": "$$\\begin{align*}90\\%\\text{ of }66\\tfrac23 &= 66\\tfrac23\\%\\text{ of }90\\\\33\\tfrac13\\%\\text{ of }90 &= 90\\div3=30\\\\66\\tfrac23\\%\\text{ of }90 &= 2\\times30=60\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      }
    ]
  },
