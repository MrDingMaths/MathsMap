  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If the annual increase in the population of a country is $2.5\\%$ and the present number of inhabitants is $2\\,624\\,000$, what will the population be in a year’s time?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\,689\\,600$ inhabitants.",
      "worked": "$$\\begin{align*}\\text{Population increase}&=\\frac{2.5}{100}\\times2\\,624\\,000\\\\\\text{Population increase}&=65\\,600\\\\\\text{Population after one year}&=2\\,624\\,000+65\\,600\\\\\\text{Population after one year}&=2\\,689\\,600\\end{align*}$$\n\nThe population will be $2\\,689\\,600$ inhabitants.",
      "solutionDiagrams": []
    },
