  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Alan, Brendan and Calum each have a number of plastic toys from a fast food store. Brendan has 5 more toys than Alan, and Calum has twice as many toys as Alan.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "If $x$ represents the number of toys Alan has, express each of the following in terms of $x$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the number of toys Brendan has",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x+5$",
              "worked": "Brendan has 5 more toys than Alan, so he has $x+5$ toys.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the number of toys Calum has",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x$",
              "worked": "Calum has twice as many toys as Alan, so he has $2x$ toys.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p16-q8-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the total number of toys the three boys have",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4x+5$",
              "worked": "$$\\begin{align*}\\text{Total number of toys}&=x+(x+5)+2x\\\\\\text{Total number of toys}&=4x+5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "If the boys have 37 toys in total, determine how many toys each boy has.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Alan has 8 toys, Brendan has 13 toys and Calum has 16 toys.",
          "worked": "Let $x$ be the number of toys Alan has.\n$$\\begin{align*}x+(x+5)+2x&=37\\\\4x+5&=37\\\\4x&=32\\\\x&=8\\end{align*}$$\nAlan has 8 toys, Brendan has $8+5=13$ toys and Calum has $2\\times8=16$ toys.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
