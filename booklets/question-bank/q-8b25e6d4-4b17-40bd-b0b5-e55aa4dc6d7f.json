  "content": {
    "id": "p39-q49-root",
    "type": "question",
    "label": "49",
    "prompt": "If the equation $3(\\sin\\theta-\\cos\\theta)+k\\cos\\theta=5$ has no solution, find the range of values of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-1<k<7$.\n\nThe amplitude must be less than $5$.",
      "worked": "The left-hand side is $3\\sin\\theta+(k-3)\\cos\\theta$, with amplitude $R=\\sqrt{9+(k-3)^2}$. It takes every value in $[-R,R]$, so there is no solution precisely when $R<5$.\n$$\\begin{align*}9+(k-3)^2&<25\\\\(k-3)^2&<16\\\\-4&<k-3<4\\\\-1&<k<7.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
