  "content": {
    "id": "p11-ch7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Express each equation in the form $y=a(x-h)^2+k$, and hence state the coordinates of the vertex of each graph.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-ch7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2+6x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+3)^2-6$; vertex $(-3,-6)$.",
          "worked": "$$\\begin{align*}y&=x^2+6x+3\\\\y&=(x^2+6x+3^2)+3-3^2\\\\y&=(x+3)^2-6\\end{align*}$$\nThe vertex is $(-3,-6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-ch7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^2-4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-2)^2-2$; vertex $(2,-2)$.",
          "worked": "$$\\begin{align*}y&=x^2-4x+2\\\\y&=(x^2-4x+2^2)+2-2^2\\\\y&=(x-2)^2-2\\end{align*}$$\nThe vertex is $(2,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-ch7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2x^2+6x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\left(x+\\frac32\\right)^2-\\frac72$; vertex $\\left(-\\frac32,-\\frac72\\right)$.",
          "worked": "$$\\begin{align*}y&=2x^2+6x+1\\\\y&=2\\left[x^2+3x+\\frac12\\right]\\\\y&=2\\left[\\left(x^2+3x+\\frac94\\right)+\\frac12-\\frac94\\right]\\\\y&=2\\left[\\left(x+\\frac32\\right)^2-\\frac74\\right]\\\\y&=2\\left(x+\\frac32\\right)^2-\\frac72\\end{align*}$$\nThe vertex is $\\left(-\\frac32,-\\frac72\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-ch7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=3x^2+8x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3\\left(x+\\frac43\\right)^2-\\frac{10}{3}$; vertex $\\left(-\\frac43,-\\frac{10}{3}\\right)$.",
          "worked": "$$\\begin{align*}y&=3x^2+8x+2\\\\y&=3\\left[x^2+\\frac83x+\\frac23\\right]\\\\y&=3\\left[\\left(x^2+\\frac83x+\\frac{16}{9}\\right)+\\frac23-\\frac{16}{9}\\right]\\\\y&=3\\left[\\left(x+\\frac43\\right)^2-\\frac{10}{9}\\right]\\\\y&=3\\left(x+\\frac43\\right)^2-\\frac{10}{3}\\end{align*}$$\nThe vertex is $\\left(-\\frac43,-\\frac{10}{3}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
