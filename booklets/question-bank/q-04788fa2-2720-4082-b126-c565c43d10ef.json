        "children": [],
        "answer": {
          "short": "Football.",
          "worked": "Football has the tallest bar, with frequency 35.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p40-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of students prefer tennis?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.\\dot{5}\\%$",
          "worked": "The total frequency is $10+35+25+15+5=90$.\n$$\\text{Tennis percentage}=\\frac{5}{90}\\times100\\%=5.\\dot{5}\\%$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the probability that a person chosen at random prefers swimming?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "There are 15 swimming preferences out of 90 responses.\n$$P(\\text{swimming})=\\frac{15}{90}=\\frac16$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "How many degrees in a sector graph would Rugby represent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100^\\circ$",
          "worked": "Rugby has 25 of the 90 responses.\n$$\\text{Sector angle}=\\frac{25}{90}\\times360^\\circ=100^\\circ$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
