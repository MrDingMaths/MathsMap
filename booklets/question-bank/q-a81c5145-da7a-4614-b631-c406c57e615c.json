    "type": "question",
    "label": null,
    "prompt": "Nine different cars park in a row. In how many ways can this be done if the three cars belonging to the Nguyen family must be next to each other?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$30\\,240$",
      "worked": "Treat the three Nguyen cars as one unit, giving 7 units in a row. The three cars have $3!$ internal arrangements.\n$$\\begin{align*}N&=7!\\times3!\\\\&=5040\\times6\\\\&=30\\,240\\end{align*}$$",
      "solutionDiagrams": []
    },
