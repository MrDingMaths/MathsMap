        "children": [],
        "answer": {
          "short": "$0.012\\text{ m}$",
          "worked": "$$\\begin{aligned}1.2\\text{ cm}&=1.2\\div100\\text{ m}\\\\&=0.012\\text{ m}.\\end{aligned}$$",
