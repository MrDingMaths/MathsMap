  "content": {
    "id": "p15-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Study the exercise on compound fractions and then simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1-\\frac12}{1+\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13$",
          "worked": "$$\\begin{align*}\\frac{1-\\frac12}{1+\\frac12}&=\\frac{2-1}{2+1}\\\\\\frac{1-\\frac12}{1+\\frac12}&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2+\\frac13}{5-\\frac23}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac7{13}$",
          "worked": "$$\\begin{align*}\\frac{2+\\frac13}{5-\\frac23}&=\\frac{6+1}{15-2}\\\\\\frac{2+\\frac13}{5-\\frac23}&=\\frac7{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\frac12-\\frac15}{1+\\frac1{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac3{11}$",
          "worked": "$$\\begin{align*}\\frac{\\frac12-\\frac15}{1+\\frac1{10}}&=\\frac{5-2}{10+1}\\\\\\frac{\\frac12-\\frac15}{1+\\frac1{10}}&=\\frac3{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\frac{17}{20}-\\frac34}{\\frac45-\\frac3{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac15$",
          "worked": "$$\\begin{align*}\\frac{\\frac{17}{20}-\\frac34}{\\frac45-\\frac3{10}}&=\\frac{17-15}{16-6}\\\\\\frac{\\frac{17}{20}-\\frac34}{\\frac45-\\frac3{10}}&=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\frac1x}{1+\\frac2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{x+2}$",
          "worked": "$$\\begin{align*}\\frac{\\frac1x}{1+\\frac2x}&=\\frac{x\\left(\\frac1x\\right)}{x\\left(1+\\frac2x\\right)}\\\\\\frac{\\frac1x}{1+\\frac2x}&=\\frac1{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{t-\\frac1t}{t+\\frac1t}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{t^2-1}{t^2+1}$",
          "worked": "$$\\begin{align*}\\frac{t-\\frac1t}{t+\\frac1t}&=\\frac{t\\left(t-\\frac1t\\right)}{t\\left(t+\\frac1t\\right)}\\\\\\frac{t-\\frac1t}{t+\\frac1t}&=\\frac{t^2-1}{t^2+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac1{\\frac1b+\\frac1a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{ab}{a+b}$",
          "worked": "$$\\begin{align*}\\frac1{\\frac1b+\\frac1a}&=\\frac{ab}{ab\\left(\\frac1b+\\frac1a\\right)}\\\\\\frac1{\\frac1b+\\frac1a}&=\\frac{ab}{a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{\\frac{x}{y}+\\frac{y}{x}}{\\frac{x}{y}-\\frac{y}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2+y^2}{x^2-y^2}$",
          "worked": "$$\\begin{align*}\\frac{\\frac{x}{y}+\\frac{y}{x}}{\\frac{x}{y}-\\frac{y}{x}}&=\\frac{xy\\left(\\frac{x}{y}+\\frac{y}{x}\\right)}{xy\\left(\\frac{x}{y}-\\frac{y}{x}\\right)}\\\\\\frac{\\frac{x}{y}+\\frac{y}{x}}{\\frac{x}{y}-\\frac{y}{x}}&=\\frac{x^2+y^2}{x^2-y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{1-\\frac1{x+1}}{\\frac1x+\\frac1{x+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{2x+1}$",
          "worked": "$$\\begin{align*}\\frac{1-\\frac1{x+1}}{\\frac1x+\\frac1{x+1}}&=\\frac{x(x+1)-x}{(x+1)+x}\\\\\\frac{1-\\frac1{x+1}}{\\frac1x+\\frac1{x+1}}&=\\frac{x^2+x-x}{2x+1}\\\\\\frac{1-\\frac1{x+1}}{\\frac1x+\\frac1{x+1}}&=\\frac{x^2}{2x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{\\frac3{x+2}-\\frac2{x+1}}{\\frac5{x+2}-\\frac4{x+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{x-3}$",
          "worked": "$$\\begin{align*}\\frac{\\frac3{x+2}-\\frac2{x+1}}{\\frac5{x+2}-\\frac4{x+1}}&=\\frac{3(x+1)-2(x+2)}{5(x+1)-4(x+2)}\\\\\\frac{\\frac3{x+2}-\\frac2{x+1}}{\\frac5{x+2}-\\frac4{x+1}}&=\\frac{3x+3-2x-4}{5x+5-4x-8}\\\\\\frac{\\frac3{x+2}-\\frac2{x+1}}{\\frac5{x+2}-\\frac4{x+1}}&=\\frac{x-1}{x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
