  "content": {
    "id": "p48-q18-response",
    "type": "question",
    "label": "18",
    "prompt": "Find the value of $k$ such that the curve $y=e^x-kx^2$ is stationary at $x=\\ln 3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\dfrac{3}{2\\ln 3}$.",
      "worked": "$$\\begin{align*}y'&=e^x-2kx.\\end{align*}$$\nAt a stationary point, $y'=0$. Substituting $x=\\ln 3$ gives\n$$\\begin{align*}e^{\\ln 3}-2k\\ln 3&=0\\\\3-2k\\ln 3&=0\\\\2k\\ln 3&=3\\\\k&=\\frac{3}{2\\ln 3}.\\end{align*}$$",
      "solutionDiagrams": []
    },
