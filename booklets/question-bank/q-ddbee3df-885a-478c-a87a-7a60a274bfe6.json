  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "First use the formula $a_n=a+(n-1)d$ to find how many terms there are in each sum.\n\nThen use the formula $S_n=\\frac{n}{2}(a+\\ell)$ to find the sum, where $\\ell$ is the last term $a_n$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$50+51+52+\\cdots+150$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=101$; $S_{101}=10100$.",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\150&=50+(n-1)(1)\\\\100&=n-1\\\\n&=101\\\\S_n&=\\frac{n}{2}(a+\\ell)\\\\S_{101}&=\\frac{101}{2}(50+150)\\\\S_{101}&=10100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$8+15+22+\\cdots+92$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=13$; $S_{13}=650$.",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\92&=8+(n-1)(7)\\\\84&=7n-7\\\\91&=7n\\\\n&=13\\\\S_n&=\\frac{n}{2}(a+\\ell)\\\\S_{13}&=\\frac{13}{2}(8+92)\\\\S_{13}&=650\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p21-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$-10-3+4+\\cdots+60$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=11$; $S_{11}=275$.",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\60&=-10+(n-1)(7)\\\\70&=7n-7\\\\77&=7n\\\\n&=11\\\\S_n&=\\frac{n}{2}(a+\\ell)\\\\S_{11}&=\\frac{11}{2}(-10+60)\\\\S_{11}&=275\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p21-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$4+7+10+\\cdots+301$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=100$; $S_{100}=15250$.",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\301&=4+(n-1)(3)\\\\297&=3n-3\\\\300&=3n\\\\n&=100\\\\S_n&=\\frac{n}{2}(a+\\ell)\\\\S_{100}&=\\frac{100}{2}(4+301)\\\\S_{100}&=15250\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p21-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$6\\frac12+11+15\\frac12+\\cdots+51\\frac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=11$; $S_{11}=319$.",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\51\\frac12&=6\\frac12+(n-1)\\left(4\\frac12\\right)\\\\45&=\\frac92(n-1)\\\\10&=n-1\\\\n&=11\\\\S_n&=\\frac{n}{2}(a+\\ell)\\\\S_{11}&=\\frac{11}{2}\\left(6\\frac12+51\\frac12\\right)\\\\S_{11}&=319\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p21-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$-1\\frac13+\\frac13+2+\\cdots+13\\frac23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=10$; $S_{10}=61\\frac23$.",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\\\frac{41}{3}&=-\\frac43+(n-1)\\left(\\frac53\\right)\\\\\\frac{45}{3}&=\\frac53(n-1)\\\\9&=n-1\\\\n&=10\\\\S_n&=\\frac{n}{2}(a+\\ell)\\\\S_{10}&=\\frac{10}{2}\\left(-\\frac43+\\frac{41}{3}\\right)\\\\S_{10}&=61\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      }
    ]
  },
