  "content": {
    "id": "p14-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find the dimensions of a rectangle whose area is $6\\text{ m}^2$ and whose perimeter is $12\\text{ m}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(3-\\sqrt3)\\text{ m}$ by $(3+\\sqrt3)\\text{ m}$.",
      "worked": "Let the dimensions be $x$ metres and $y$ metres.\n$$\\begin{align*}2(x+y)&=12\\\\x+y&=6\\\\y&=6-x\\\\x(6-x)&=6\\\\x^2-6x&=-6\\\\x^2-6x+9&=-6+9\\\\(x-3)^2&=3\\\\x&=3\\pm\\sqrt3.\\end{align*}$$\nThe dimensions are $(3-\\sqrt3)\\text{ m}$ and $(3+\\sqrt3)\\text{ m}$. Both are positive; their sum is $6\\text{ m}$ and their product is $6\\text{ m}^2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 92
  },
