  "content": {
    "id": "p43-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "In how many ways can the letters of the word SOCKS be arranged in a line:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "The two Ss are identical.\n$$\\frac{5!}{2!}=60$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p43-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "so that the two Ss are together",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "Treat SS as one unit. The four distinct units SS, O, C and K can be arranged in\n$$4!=24$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p43-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "so that the two Ss are separated by at least one other letter",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "Subtract the arrangements with the Ss together from all arrangements.\n$$60-24=36$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p43-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "so that the K is somewhere to the left of the C",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "Swapping K and C pairs each arrangement with K left of C with one having C left of K. Hence half the arrangements qualify.\n$$\\frac{60}{2}=30$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
