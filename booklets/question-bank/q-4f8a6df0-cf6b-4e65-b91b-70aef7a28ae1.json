  "content": {
    "id": "p33-q6",
    "type": "question",
    "label": "6",
    "prompt": "A plumber’s quote for installing a dishwasher is \\$264, including the GST.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the unitary method to calculate the GST payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$24",
          "worked": "$$\\begin{align*}110\\%&=\\$264\\\\10\\%&=\\$264\\div11\\\\&=\\$24\\end{align*}$$\nGST is $10\\%$ of the pre-GST price, so the GST payable is \\$24.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Divide \\$264 by 11; does this give the same answer as part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $264\\div11=\\$24$.",
          "worked": "$$264\\div11=24$$\nYes. This gives \\$24, the same GST payable as in part a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the pre-GST price for installing the dishwasher.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$240",
          "worked": "$$\\begin{align*}110\\%&=\\$264\\\\10\\%&=\\$264\\div11\\\\&=\\$24\\\\100\\%&=\\$24\\times10\\\\&=\\$240\\end{align*}$$\nThe pre-GST price is \\$240.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p33-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Divide \\$264 by 1.1; does this give the same answer as part c?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes; $264\\div1.1=\\$240$.",
          "worked": "$$264\\div1.1=240$$\nYes. This gives \\$240, the same pre-GST price as in part c. Dividing by $1.1$ reverses the $10\\%$ increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
