    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-concept-1-5-a",
        "type": "part",
        "label": "a",
        "prompt": "Row $n$ of Pascal’s Triangle has $n$ terms.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Row $n$ has $n+1$ terms.",
          "worked": "False. Columns in row $n$ run from $0$ to $n$, giving $n+1$ terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p4-concept-1-5-b",
        "type": "part",
        "label": "b",
        "prompt": "Pascal’s Triangle is symmetric.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Each row reads the same from either end.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p4-concept-1-5-c",
        "type": "part",
        "label": "c",
        "prompt": "The sum of all entries in row $n$ equals $2^n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Row $n$ supplies the coefficients of $(a+b)^n$. Setting $a=b=1$ makes every variable factor equal to $1$, so the sum of the coefficients is $(1+1)^n=2^n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p4-concept-1-5-d",
        "type": "part",
        "label": "d",
        "prompt": "For every $n\\geq 1$, row $n$ contains at least one even number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Row $1$ contains only $1,1$.",
          "worked": "False. Row $1$ is $1,1$, so it contains no even number. This counterexample disproves the statement. More generally, rows $n=2^m-1$ have all entries odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p4-concept-1-5-e",
        "type": "part",
        "label": "e",
        "prompt": "The coefficients of the expansion of $(a+b)^n$ come from row $n$ of Pascal’s Triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The coefficients are the entries of row $n$, in order.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
