    "id": "p24-ex15e-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "For each cylinder, find:\ni the exact volume, in terms of $\\pi$\nii an approximate value for the volume, using $\\pi\\approx\\dfrac{22}{7}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-ex15e-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Radius 14 m, height 20 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exact $3920\\pi\\text{ m}^3$; approximate $12\\,320\\text{ m}^3$.",
          "worked": "$V=\\pi r^2h=\\pi(14)^2(20)=3920\\pi\\text{ m}^3$. Using $\\pi\\approx\\frac{22}{7}$, $V\\approx3920(\\frac{22}{7})=12\\,320\\text{ m}^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p24-ex15e-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Diameter 7 cm, height 16 cm",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exact $196\\pi\\text{ cm}^3$; approximate $616\\text{ cm}^3$.",
          "worked": "Radius $r=\\frac{7}{2}=3.5$ cm. Then $V=\\pi(3.5)^2(16)=196\\pi\\text{ cm}^3$. Using $\\pi\\approx\\frac{22}{7}$, $V\\approx196(\\frac{22}{7})=616\\text{ cm}^3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p24-ex15e-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Radius 21 mm, height 12 mm",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Exact $5292\\pi\\text{ mm}^3$; approximate $16\\,632\\text{ mm}^3$.",
