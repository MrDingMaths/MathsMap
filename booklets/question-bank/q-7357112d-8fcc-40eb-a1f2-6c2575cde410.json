  "content": {
    "id": "p16-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider $P(x)=x^3-x^2-x+10$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $-2$ is a zero of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-2)=0$, so $-2$ is a zero.",
          "worked": "$$\\begin{aligned}P(-2)&=(-2)^3-(-2)^2-(-2)+10\\\\&=-8-4+2+10\\\\&=0.\\end{aligned}$$\nTherefore $-2$ is a zero of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p16-q6b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that the zeroes of $P(x)$ are $-2$, $\\alpha$ and $\\beta$. Show that $\\alpha+\\beta=3$ and $\\alpha\\beta=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta=3$ and $\\alpha\\beta=5$.",
          "worked": "Using the sum of zeroes,\n$$\\begin{aligned}\\alpha+\\beta-2&=1\\\\\\alpha+\\beta&=3.\\end{aligned}$$\nUsing the product of zeroes,\n$$\\begin{aligned}-2\\alpha\\beta&=-10\\\\\\alpha\\beta&=5.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q6c",
        "type": "part",
        "label": "c",
        "prompt": "By solving the two equations in part b simultaneously, show that $\\alpha^2-3\\alpha+5=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha(3-\\alpha)=5$, so $\\alpha^2-3\\alpha+5=0$.",
          "worked": "From part b, $\\beta=3-\\alpha$. Substitute into $\\alpha\\beta=5$:\n$$\\begin{aligned}\\alpha(3-\\alpha)&=5\\\\3\\alpha-\\alpha^2&=5\\\\\\alpha^2-3\\alpha+5&=0.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q6d",
        "type": "part",
        "label": "d",
        "prompt": "Hence show there are no such real numbers $\\alpha$ and $\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=9-20=-11<0$, so neither $\\alpha$ nor $\\beta$ is real.",
          "worked": "For $\\alpha^2-3\\alpha+5=0$,\n$$\\begin{aligned}\\Delta&=(-3)^2-4(1)(5)\\\\&=-11<0.\\end{aligned}$$\nThus $\\alpha$ is not real. Since $\\beta=3-\\alpha$, $\\beta$ is not real either.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p16-q6e",
        "type": "part",
        "label": "e",
        "prompt": "Hence state how many times the graph of $P(x)$ crosses the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Once.",
          "worked": "The only real zero is $-2$, and it is a simple zero. Therefore the graph crosses the $x$-axis once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
