    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=5x-2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=5-4x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{5(x+h)-2(x+h)^2-(5x-2x^2)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{5h-4xh-2h^2}{h}\\\\f'(x)&=\\lim_{h\\to0}(5-4x-2h)\\\\f'(x)&=5-4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^2+4x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x+4$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{(x+h)^2+4(x+h)-2-(x^2+4x-2)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2xh+h^2+4h}{h}\\\\f'(x)&=\\lim_{h\\to0}(2x+h+4)\\\\f'(x)&=2x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{x^2+1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=\\dfrac{2x}{5}$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{(x+h)^2+1-(x^2+1)}{5h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2xh+h^2}{5h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2x+h}{5}\\\\f'(x)&=\\frac{2x}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{2x-x^2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=\\dfrac{2-2x}{3}$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2(x+h)-(x+h)^2-(2x-x^2)}{3h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2h-2xh-h^2}{3h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2-2x-h}{3}\\\\f'(x)&=\\frac{2-2x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=2x^2-4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=4x-4$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2(x+h)^2-4(x+h)+3-(2x^2-4x+3)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{4xh+2h^2-4h}{h}\\\\f'(x)&=\\lim_{h\\to0}(4x+2h-4)\\\\f'(x)&=4x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p15-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\dfrac{x^2}{2}-2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=x-2$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{\\frac{(x+h)^2}{2}-2(x+h)+3-(\\frac{x^2}{2}-2x+3)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{xh+\\frac{h^2}{2}-2h}{h}\\\\f'(x)&=\\lim_{h\\to0}\\left(x+\\frac h2-2\\right)\\\\f'(x)&=x-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
