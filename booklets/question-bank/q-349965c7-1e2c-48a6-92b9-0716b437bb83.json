    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x}{4}\\times\\dfrac6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac32$",
          "worked": "$$\\begin{align*}\\frac{x}{4}\\times\\frac6x&=\\frac{6x}{4x}\\\\\\frac{x}{4}\\times\\frac6x&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a}{12}\\div\\dfrac{ab}{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2b}$",
          "worked": "$$\\begin{align*}\\frac{a}{12}\\div\\frac{ab}{18}&=\\frac{a}{12}\\times\\frac{18}{ab}\\\\\\frac{a}{12}\\div\\frac{ab}{18}&=\\frac{18a}{12ab}\\\\\\frac{a}{12}\\div\\frac{ab}{18}&=\\frac{3}{2b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{mn^2}{6}\\times\\dfrac4m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2n^2}{3}$",
          "worked": "$$\\begin{align*}\\frac{mn^2}{6}\\times\\frac4m&=\\frac{4mn^2}{6m}\\\\\\frac{mn^2}{6}\\times\\frac4m&=\\frac{2n^2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{m^2n^2}{4}\\times\\dfrac{mn}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{m^3n^3}{12}$",
          "worked": "$$\\begin{align*}\\frac{m^2n^2}{4}\\times\\frac{mn}{3}&=\\frac{m^{2+1}n^{2+1}}{12}\\\\\\frac{m^2n^2}{4}\\times\\frac{mn}{3}&=\\frac{m^3n^3}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{(3a)^2}{2}\\times\\dfrac{(2a)^3}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12a^5$",
          "worked": "$$\\begin{align*}\\frac{(3a)^2}{2}\\times\\frac{(2a)^3}{3}&=\\frac{9a^2}{2}\\times\\frac{8a^3}{3}\\\\\\frac{(3a)^2}{2}\\times\\frac{(2a)^3}{3}&=\\frac{72a^5}{6}\\\\\\frac{(3a)^2}{2}\\times\\frac{(2a)^3}{3}&=12a^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{y^3}{6x}\\times\\dfrac{2}{x^3y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^2}{3x^4}$",
          "worked": "$$\\begin{align*}\\frac{y^3}{6x}\\times\\frac{2}{x^3y}&=\\frac{2y^3}{6x^4y}\\\\\\frac{y^3}{6x}\\times\\frac{2}{x^3y}&=\\frac{y^2}{3x^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p3-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$ab\\times\\dfrac{a^2}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^3$",
          "worked": "$$\\begin{align*}ab\\times\\frac{a^2}{b}&=\\frac{a^3b}{b}\\\\ab\\times\\frac{a^2}{b}&=a^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\dfrac{x}{2}\\right)^3\\times\\left(\\dfrac4x\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}\\right)^3\\left(\\frac4x\\right)^2&=\\frac{x^3}{8}\\times\\frac{16}{x^2}\\\\\\left(\\frac{x}{2}\\right)^3\\left(\\frac4x\\right)^2&=\\frac{16x^3}{8x^2}\\\\\\left(\\frac{x}{2}\\right)^3\\left(\\frac4x\\right)^2&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(\\dfrac{x}{2}\\right)^3\\div\\left(\\dfrac{x}{4}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}\\right)^3\\div\\left(\\frac{x}{4}\\right)^2&=\\frac{x^3}{8}\\div\\frac{x^2}{16}\\\\\\left(\\frac{x}{2}\\right)^3\\div\\left(\\frac{x}{4}\\right)^2&=\\frac{x^3}{8}\\times\\frac{16}{x^2}\\\\\\left(\\frac{x}{2}\\right)^3\\div\\left(\\frac{x}{4}\\right)^2&=2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\left(\\dfrac{y^3}{6x}\\right)^2\\times\\left(\\dfrac{2}{x^3y}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2y^3}{9x^{11}}$",
          "worked": "$$\\begin{align*}\\left(\\frac{y^3}{6x}\\right)^2\\left(\\frac{2}{x^3y}\\right)^3&=\\frac{y^6}{36x^2}\\times\\frac8{x^9y^3}\\\\\\left(\\frac{y^3}{6x}\\right)^2\\left(\\frac{2}{x^3y}\\right)^3&=\\frac{8y^6}{36x^{11}y^3}\\\\\\left(\\frac{y^3}{6x}\\right)^2\\left(\\frac{2}{x^3y}\\right)^3&=\\frac{2y^3}{9x^{11}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p3-q6-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{-mn}{4}\\times m^2n^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{m^3n^4}{4}$",
          "worked": "$$\\begin{align*}\\frac{-mn}{4}\\times m^2n^3&=-\\frac{m^{1+2}n^{1+3}}4\\\\\\frac{-mn}{4}\\times m^2n^3&=-\\frac{m^3n^4}4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q6-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{m^3n^2}{5}\\div\\dfrac{m^2n}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2mn$",
          "worked": "$$\\begin{align*}\\frac{m^3n^2}{5}\\div\\frac{m^2n}{10}&=\\frac{m^3n^2}{5}\\times\\frac{10}{m^2n}\\\\\\frac{m^3n^2}{5}\\div\\frac{m^2n}{10}&=2m^{3-2}n^{2-1}\\\\\\frac{m^3n^2}{5}\\div\\frac{m^2n}{10}&=2mn\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{y^4}{8x}\\div\\dfrac{y^2}{6x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3xy^2}{4}$",
          "worked": "$$\\begin{align*}\\frac{y^4}{8x}\\div\\frac{y^2}{6x^2}&=\\frac{y^4}{8x}\\times\\frac{6x^2}{y^2}\\\\\\frac{y^4}{8x}\\div\\frac{y^2}{6x^2}&=\\frac{6x^2y^4}{8xy^2}\\\\\\frac{y^4}{8x}\\div\\frac{y^2}{6x^2}&=\\frac{3xy^2}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{mn}{4}\\div\\dfrac{m^2n^3}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2mn^2}$",
          "worked": "$$\\begin{align*}\\frac{mn}{4}\\div\\frac{m^2n^3}{6}&=\\frac{mn}{4}\\times\\frac6{m^2n^3}\\\\\\frac{mn}{4}\\div\\frac{m^2n^3}{6}&=\\frac{6mn}{4m^2n^3}\\\\\\frac{mn}{4}\\div\\frac{m^2n^3}{6}&=\\frac3{2mn^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p3-q6-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{12a^3b^3}{(2ab)^2}\\times\\dfrac{(3a^2)^2b}{4a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27a^4b^2}{4}$",
          "worked": "$$\\begin{align*}\\frac{12a^3b^3}{(2ab)^2}\\frac{(3a^2)^2b}{4a}&=\\frac{12a^3b^3}{4a^2b^2}\\times\\frac{9a^4b}{4a}\\\\\\frac{12a^3b^3}{(2ab)^2}\\frac{(3a^2)^2b}{4a}&=\\frac{108a^7b^4}{16a^3b^2}\\\\\\frac{12a^3b^3}{(2ab)^2}\\frac{(3a^2)^2b}{4a}&=\\frac{27a^4b^2}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p3-q6-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\dfrac{(-2x^2)^3}{xy^2}\\div\\dfrac{2xy^2}{(3x^2y^3)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-36x^8y^2$",
          "worked": "$$\\begin{align*}\\frac{(-2x^2)^3}{xy^2}\\div\\frac{2xy^2}{(3x^2y^3)^2}&=\\frac{-8x^6}{xy^2}\\times\\frac{9x^4y^6}{2xy^2}\\\\\\frac{(-2x^2)^3}{xy^2}\\div\\frac{2xy^2}{(3x^2y^3)^2}&=\\frac{-72x^{10}y^6}{2x^2y^4}\\\\\\frac{(-2x^2)^3}{xy^2}\\div\\frac{2xy^2}{(3x^2y^3)^2}&=-36x^8y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
