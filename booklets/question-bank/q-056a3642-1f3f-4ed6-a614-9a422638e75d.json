    "label": null,
    "prompt": "Make $x$ the subject of $y=2\\log_3 x+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=3^{\\frac{y-1}{2}}$",
      "worked": "$$\\begin{align*}y-1&=2\\log_3 x\\\\\\frac{y-1}{2}&=\\log_3 x\\\\x&=3^{\\frac{y-1}{2}}\\end{align*}$$",
