  "content": {
    "id": "p59-q14-response",
    "type": "question",
    "label": "14",
    "prompt": "If $\\sqrt{x+\\sqrt{x^2-4}}+\\sqrt{x-\\sqrt{x^2-4}}=4$, find the value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=6$. Let the two outer radicals be $a$ and $b$. Then $a+b=4$, $ab=2$ and $2x=a^2+b^2=16-4=12$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p59-q14-worked",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=\\sqrt{x+\\sqrt{x^2-4}},\\qquad b=\\sqrt{x-\\sqrt{x^2-4}}",
                "display": false
              },
              {
                "type": "text",
                "text": ". It is given that ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a+b=4",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p59-q14-worked-product",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}ab&=\\sqrt{\\left(x+\\sqrt{x^2-4}\\right)\\left(x-\\sqrt{x^2-4}\\right)}\\\\ab&=\\sqrt{x^2-(x^2-4)}\\\\ab&=\\sqrt4\\\\ab&=2\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p59-q14-worked-simultaneous-intro",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Solving ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a+b=4",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "ab=2",
                "display": false
              },
              {
                "type": "text",
                "text": ":",
                "marks": []
              }
            ]
          },
          {
            "id": "p59-q14-worked-quadratic",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}a(4-a)&=2\\\\a^2-4a+2&=0\\\\a&=2-\\sqrt2\\quad\\text{or}\\quad2+\\sqrt2\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p59-q14-worked-b-values",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The corresponding values of ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "b=4-a",
                "display": false
              },
              {
                "type": "text",
                "text": " are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2+\\sqrt2",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2-\\sqrt2",
                "display": false
              },
              {
                "type": "text",
                "text": ", respectively.",
                "marks": []
              }
            ]
          },
          {
            "id": "p59-q14-worked-positive-branch-intro",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=2+\\sqrt2",
                "display": false
              },
              {
                "type": "text",
                "text": ":",
                "marks": []
              }
            ]
          },
          {
            "id": "p59-q14-worked-positive-branch",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\sqrt{x+\\sqrt{x^2-4}}&=2+\\sqrt2\\\\x+\\sqrt{x^2-4}&=6+4\\sqrt2\\\\x+\\sqrt{x^2-4}&=6+\\sqrt{32}\\\\\\sqrt{x^2-4}&=6+4\\sqrt2-x\\\\x^2-4&=(6+4\\sqrt2-x)^2\\\\(12+8\\sqrt2)x&=72+48\\sqrt2\\\\x&=6\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p59-q14-worked-negative-branch",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=2-\\sqrt2",
                "display": false
              },
              {
                "type": "text",
                "text": ":",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}\\sqrt{x+\\sqrt{x^2-4}}&=2-\\sqrt2\\\\x+\\sqrt{x^2-4}&=6-4\\sqrt2\\\\x+\\sqrt{x^2-4}&=6-\\sqrt{32}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p59-q14-worked-branch-rejection",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The original radicals require ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\ge2",
                "display": false
              },
              {
                "type": "text",
                "text": ", so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x+\\sqrt{x^2-4}\\ge2",
                "display": false
              },
              {
                "type": "text",
                "text": ". Since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "6-4\\sqrt2<2",
                "display": false
              },
              {
                "type": "text",
                "text": ", this branch has no solution. Using the corresponding values of ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "b",
                "display": false
              },
              {
                "type": "text",
                "text": " gives the same result.",
                "marks": []
              }
            ]
          },
          {
            "id": "p59-q14-worked-check",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Check:",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}\\sqrt{6+\\sqrt{32}}+\\sqrt{6-\\sqrt{32}}&=(2+\\sqrt2)+(2-\\sqrt2)\\\\&=4\\end{aligned}",
                "display": true
              },
              {
                "type": "text",
                "text": "Therefore, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=6",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 150
  },
