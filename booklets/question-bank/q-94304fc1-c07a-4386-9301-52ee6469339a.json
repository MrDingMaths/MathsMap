  "content": {
    "id": "v2-c147d-p51-practice-slot-6-132345-root",
    "type": "question",
    "label": null,
    "prompt": "Find the range of each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-c147d-p51-practice-slot-6-132345-s6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sin^4x+\\cos^4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12\\leq y\\leq1$",
          "worked": "$$\\begin{aligned}y&=(\\sin^2x+\\cos^2x)^2-2\\sin^2x\\cos^2x\\\\&=1-\\frac12(2\\sin x\\cos x)^2\\\\&=1-\\frac12\\sin^22x.\\end{aligned}$$\nSince $0\\leq\\sin^22x\\leq1$,\n$$\\begin{aligned}1-\\frac12\\leq y\\leq1\\end{aligned}$$\nso the range is $\\dfrac12\\leq y\\leq1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "v2-c147d-p51-practice-slot-6-132345-s6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sin^6x+\\cos^6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14\\leq y\\leq1$",
          "worked": "$$\\begin{aligned}y&=(\\sin^2x+\\cos^2x)(\\sin^4x-\\sin^2x\\cos^2x+\\cos^4x)\\\\&=(\\sin^4x+\\cos^4x)-\\sin^2x\\cos^2x\\\\&=1-3\\sin^2x\\cos^2x\\\\&=1-\\frac34(2\\sin x\\cos x)^2\\\\&=1-\\frac34\\sin^22x.\\end{aligned}$$\nSince $0\\leq\\sin^22x\\leq1$,\n$$1-\\frac34\\leq y\\leq1$$\nso the range is $\\dfrac14\\leq y\\leq1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      }
    ]
  },
