    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Use calculus to find the gradient of the tangent to $y=e^x$ at $R\\left(-1,\\frac{1}{e}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{e}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^x\\\\\\left.\\frac{dy}{dx}\\right|_{x=-1}&=e^{-1}=\\frac{1}{e}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the equation of the tangent at $R$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{e}x+\\frac{2}{e}$",
          "worked": "$$\\begin{aligned}y-\\frac{1}{e}&=\\left(\\frac{1}{e}\\right)(x-(-1))\\\\y&=\\left(\\frac{1}{e}\\right)x+\\frac{1}{e}+\\frac{1}{e}\\\\y&=\\left(\\frac{1}{e}\\right)x+\\frac{2}{e}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the $x$-intercept of the tangent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$",
          "worked": "At $y=0$,\n$$\\begin{aligned}\\frac{1}{e}x&=-\\frac{2}{e}\\\\x&=-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
