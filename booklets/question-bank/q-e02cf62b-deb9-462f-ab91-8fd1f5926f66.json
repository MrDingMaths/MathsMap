  "content": {
    "id": "p11-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Factorise the following and simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{7-3x}{3x-7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{7-3x}{3x-7}&=\\frac{-(3x-7)}{3x-7}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{4x-1}{1-4x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{4x-1}{1-4x}&=\\frac{4x-1}{-(4x-1)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{8x+16}{-2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$\\begin{align*}\\frac{8x+16}{-2-x}&=\\frac{8(x+2)}{-(x+2)}\\\\&=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+3}{-9-3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{-9-3x}&=\\frac{x+3}{-3(x+3)}\\\\&=-\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q21-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{5-3x}{18x-30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{6}$",
          "worked": "$$\\begin{align*}\\frac{5-3x}{18x-30}&=\\frac{-(3x-5)}{6(3x-5)}\\\\&=-\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q21-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2-9}{3-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+3)$",
          "worked": "$$\\begin{align*}\\frac{x^2-9}{3-x}&=\\frac{(x-3)(x+3)}{3-x}\\\\&=\\frac{(x-3)(x+3)}{-(x-3)}\\\\&=-(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q21-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{-x^2-4x}{-4x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{4}$",
          "worked": "$$\\begin{align*}\\frac{-x^2-4x}{-4x}&=\\frac{-x(x+4)}{-4x}\\\\&=\\frac{x+4}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q21-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{5x-2x^2}{2x^2-5x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{5x-2x^2}{2x^2-5x}&=\\frac{x(5-2x)}{x(2x-5)}\\\\&=\\frac{-x(2x-5)}{x(2x-5)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q21-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{5y-3xy}{18xy-30y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{6}$",
          "worked": "$$\\begin{align*}\\frac{5y-3xy}{18xy-30y}&=\\frac{y(5-3x)}{6y(3x-5)}\\\\&=\\frac{-y(3x-5)}{6y(3x-5)}\\\\&=-\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p11-q21-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{x^2-100}{10-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(10+x)$",
          "worked": "$$\\begin{align*}\\frac{x^2-100}{10-x}&=\\frac{(x-10)(x+10)}{10-x}\\\\&=\\frac{(x-10)(x+10)}{-(x-10)}\\\\&=-(10+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q21-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{-5a-20}{4+a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}\\frac{-5a-20}{4+a}&=\\frac{-5(a+4)}{a+4}\\\\&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q21-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{x^2-49}{35-5x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{x+7}{5}$",
          "worked": "$$\\begin{align*}\\frac{x^2-49}{35-5x}&=\\frac{(x-7)(x+7)}{5(7-x)}\\\\&=\\frac{(x-7)(x+7)}{-5(x-7)}\\\\&=-\\frac{x+7}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
