    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q70",
        "type": "part",
        "label": "a",
        "prompt": "$\\sec(180^\\circ-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sec x$",
          "worked": "$$\\begin{align*}\\sec(180^\\circ-x)&=\\frac{1}{\\cos(180^\\circ-x)}\\\\\\sec(180^\\circ-x)&=-\\frac{1}{\\cos x}\\\\\\sec(180^\\circ-x)&=-\\sec x\\end{align*}$$\nFor $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q71",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{cosec}(180^\\circ-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\operatorname{cosec}x$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}(180^\\circ-x)&=\\frac{1}{\\sin(180^\\circ-x)}\\\\\\operatorname{cosec}(180^\\circ-x)&=\\frac{1}{\\sin x}\\\\\\operatorname{cosec}(180^\\circ-x)&=\\operatorname{cosec}x\\end{align*}$$\nFor $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q72",
        "type": "part",
        "label": "c",
        "prompt": "$\\cot(180^\\circ-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cot x$",
          "worked": "$$\\begin{align*}\\cot(180^\\circ-x)&=\\frac{\\cos(180^\\circ-x)}{\\sin(180^\\circ-x)}\\\\\\cot(180^\\circ-x)&=-\\frac{\\cos x}{\\sin x}\\\\\\cot(180^\\circ-x)&=-\\cot x\\end{align*}$$\nFor $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q73",
        "type": "part",
        "label": "d",
        "prompt": "$\\sec(180^\\circ+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sec x$",
          "worked": "$$\\begin{align*}\\sec(180^\\circ+x)&=\\frac{1}{\\cos(180^\\circ+x)}\\\\\\sec(180^\\circ+x)&=-\\frac{1}{\\cos x}\\\\\\sec(180^\\circ+x)&=-\\sec x\\end{align*}$$\nFor $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q74",
        "type": "part",
        "label": "e",
        "prompt": "$\\operatorname{cosec}(180^\\circ+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\operatorname{cosec}x$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}(180^\\circ+x)&=\\frac{1}{\\sin(180^\\circ+x)}\\\\\\operatorname{cosec}(180^\\circ+x)&=-\\frac{1}{\\sin x}\\\\\\operatorname{cosec}(180^\\circ+x)&=-\\operatorname{cosec}x\\end{align*}$$\nFor $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q75",
        "type": "part",
        "label": "f",
        "prompt": "$\\cot(180^\\circ+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot x$",
          "worked": "$$\\begin{align*}\\cot(180^\\circ+x)&=\\frac{\\cos(180^\\circ+x)}{\\sin(180^\\circ+x)}\\\\\\cot(180^\\circ+x)&=\\frac{-\\cos x}{-\\sin x}\\\\\\cot(180^\\circ+x)&=\\cot x\\end{align*}$$\nFor $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q76",
        "type": "part",
        "label": "g",
        "prompt": "$\\sec(360^\\circ-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sec x$",
          "worked": "$$\\begin{align*}\\sec(360^\\circ-x)&=\\frac{1}{\\cos(360^\\circ-x)}\\\\\\sec(360^\\circ-x)&=\\frac{1}{\\cos x}\\\\\\sec(360^\\circ-x)&=\\sec x\\end{align*}$$\nFor $\\cos x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q77",
        "type": "part",
        "label": "h",
        "prompt": "$\\operatorname{cosec}(360^\\circ-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\operatorname{cosec}x$",
          "worked": "$$\\begin{align*}\\operatorname{cosec}(360^\\circ-x)&=\\frac{1}{\\sin(360^\\circ-x)}\\\\\\operatorname{cosec}(360^\\circ-x)&=-\\frac{1}{\\sin x}\\\\\\operatorname{cosec}(360^\\circ-x)&=-\\operatorname{cosec}x\\end{align*}$$\nFor $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q78",
        "type": "part",
        "label": "i",
        "prompt": "$\\cot(360^\\circ-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cot x$",
          "worked": "$$\\begin{align*}\\cot(360^\\circ-x)&=\\frac{\\cos(360^\\circ-x)}{\\sin(360^\\circ-x)}\\\\\\cot(360^\\circ-x)&=-\\frac{\\cos x}{\\sin x}\\\\\\cot(360^\\circ-x)&=-\\cot x\\end{align*}$$\nFor $\\sin x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
