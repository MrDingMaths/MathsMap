  "content": {
    "id": "p35-q27-root",
    "type": "question",
    "label": "27",
    "prompt": "From a group of six Year 12 students, five Year 11 students and four Year 10 students, a committee consisting of five students is chosen. Find the probability of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q27-a",
        "type": "part",
        "label": "a",
        "prompt": "all five students are from Year 12.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{1001}$",
          "worked": "There are $\\binom{15}{5}$ equally likely committees. Choose all five members from the six Year 12 students.\n$$\\begin{align*}P(\\text{all Year 12})&=\\frac{\\binom65}{\\binom{15}{5}}\\\\P(\\text{all Year 12})&=\\frac{6}{3003}\\\\P(\\text{all Year 12})&=\\frac{2}{1001}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p35-q27-b",
        "type": "part",
        "label": "b",
        "prompt": "two Year 12 students, two Year 11 students and one Year 10 student are chosen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{200}{1001}$",
          "worked": "Choose two of the six Year 12 students, two of the five Year 11 students and one of the four Year 10 students.\n$$\\begin{align*}P(\\text{required committee})&=\\frac{\\binom62\\binom52\\binom41}{\\binom{15}{5}}\\\\P(\\text{required committee})&=\\frac{15\\times10\\times4}{3003}\\\\P(\\text{required committee})&=\\frac{200}{1001}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
