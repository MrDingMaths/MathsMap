  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Jenny loses $\\frac{1}{3}$ of her money, so that she now has $\\$12$ less than her original amount of money. How much was the original amount?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$36$",
      "worked": "Let $x$ dollars be Jenny’s original amount. The amount lost is $\\$12$.\n$$\\begin{align*}\\frac{x}{3}&=12\\\\x&=3\\times12\\\\x&=36\\end{align*}$$\nJenny originally had $\\$36$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
