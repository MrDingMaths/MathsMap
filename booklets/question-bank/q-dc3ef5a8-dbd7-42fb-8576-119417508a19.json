      {
        "id": "p24-q2a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can four different letters be distributed to four different letterboxes?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$256$",
          "worked": "Each of the four letters has four choices of letterbox.\n$$\\begin{align*}N&=4\\times4\\times4\\times4\\\\N&=4^4=256\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2b",
        "type": "part",
        "label": "b",
        "prompt": "What if each letterbox holds only one letter?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "The successive letters have four, three, two and one available letterboxes.\n$$\\begin{align*}N&=4\\times3\\times2\\times1\\\\N&=4!=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
