  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the area in the second quadrant enclosed between the lines $y=4$ and $y=1-x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{9}{2}\\text{ units}^2$",
      "worked": "The second-quadrant region has right boundary $x=0$ and left boundary $x=1-y$, with $1\\le y\\le4$.\n$$\\begin{align*}A&=\\int_1^4\\bigl(0-(1-y)\\bigr)\\,dy\\\\A&=\\int_1^4(y-1)\\,dy\\\\A&=\\left[\\frac{y^2}{2}-y\\right]_1^4\\\\A&=(8-4)-\\left(\\frac12-1\\right)\\\\A&=\\frac92\\\\A&=4.5\\text{ units}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
