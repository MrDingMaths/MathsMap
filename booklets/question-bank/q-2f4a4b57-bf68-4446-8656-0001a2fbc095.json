  "content": {
    "id": "p21-q4-response",
    "type": "question",
    "label": "4",
    "prompt": "True or False? Let $x,y\\geq0$.\n$$(\\sqrt{x}+\\sqrt{y})^2=x+y$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "False.",
      "worked": "$$\\begin{align*}(\\sqrt{x}+\\sqrt{y})^2&=x+2\\sqrt{xy}+y\\end{align*}$$\nThe cross term $2\\sqrt{xy}$ is generally nonzero, so the statement is false.",
      "solutionDiagrams": []
    },
