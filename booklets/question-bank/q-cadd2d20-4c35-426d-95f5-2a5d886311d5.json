    "id": "v2-ac439-p13-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "A line with gradient $\\frac53$ passes through $(-4,-10)$. Find its $x$-intercept.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=2$",
      "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y+10&=\\frac53(x+4)\\end{aligned}$$\nAt the $x$-intercept $y=0$:\n$$\\begin{aligned}10&=\\frac53(x+4)\\\\6&=x+4\\\\x&=2\\end{aligned}$$",
      "solutionDiagrams": []
    },
