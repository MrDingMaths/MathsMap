  "content": {
    "id": "p27-q41-root",
    "type": "question",
    "label": "41",
    "prompt": "The graph of $y=e^x$ is horizontally dilated by a factor of $h$ to give $y=a^x$, where $a>0$ and $a\\ne1$. Find the value of $h$ in terms of $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q41-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "h=\\frac{1}{\\ln a}",
                "display": false
              }
            ]
          },
          {
            "id": "p27-q41-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Replace ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\mapsto \\frac{x}{h}",
                "display": false
              },
              {
                "type": "text",
                "text": " and match the exponential bases.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Replace $x\\mapsto \\frac{x}{h}$ and match the exponential bases.\n\n$$\\begin{align*}y&=e^{x/h}\\\\e^{1/h}&=a\\\\\\frac{1}{h}&=\\ln a\\\\h&=\\frac{1}{\\ln a}\\end{align*}$$",
      "solutionDiagrams": []
    },
