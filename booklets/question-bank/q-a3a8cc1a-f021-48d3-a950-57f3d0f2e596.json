  "content": {
    "id": "p52-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Consider a regular hexagon with internal angles of $120^{\\circ}$ and side lengths of $10\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p52-q19-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"constructionRed\",\"hex\":\"EF6068\",\"reason\":\"highlighted perpendicular construction and horizontal diameter\"}],\"reference\":\"source page 52 p52-q19-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{constructionRed}{HTML}{EF6068}\n\\coordinate (A) at (-2,0);\n\\coordinate (U) at (-1,{sqrt(3)});\n\\coordinate (V) at (1,{sqrt(3)});\n\\coordinate (R) at (2,0);\n\\coordinate (W) at (1,{-sqrt(3)});\n\\coordinate (C) at (-1,{-sqrt(3)});\n\\coordinate (B) at (-1,0);\n\\draw[black,line width=0.8pt] (A)--(U)--(V)--(R)--(W)--(C)--cycle;\n\\foreach \\p/\\q in {A/U,U/V,V/R,R/W,W/C,C/A}{\\path (\\p)--(\\q) node[midway,sloped] {$|$};}\n\\draw[constructionRed,dashed,line width=0.4pt] (A)--(R);\n\\draw[constructionRed,dashed,line width=0.4pt] (B)--(C);\n\\draw[black,line width=0.4pt] ($(B)!0.23cm!(A)$)--($(B)!0.23cm!(A)+(B)!0.23cm!(C)-(B)$)--($(B)!0.23cm!(C)$);\n\\pic[draw=black,line width=0.4pt,angle radius=0.38cm] {angle=A--U--V};\n\\path (U)--(B) node[pos=0.46,right] {$120^{\\circ}$};\n\\node[left] at (A) {$A$};\n\\node[above] at (B) {$B$};\n\\node[below] at (C) {$C$};\n\\path (R)--(W) node[midway,right=3mm] {$10\\text{ cm}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 60,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 52,
          "sourceRegion": "Question 19 shared hexagon diagram",
          "description": "Regular hexagon with horizontal top and bottom edges, equal-side ticks on all six edges, A at the leftmost vertex, C at the bottom-left vertex and B vertically above C on the horizontal diameter. Dashed red constructions join A to the opposite vertex and B to C. The interior angle at the top-left vertex is 120 degrees, and the lower-right edge is labelled 10 cm. Decorative blue outlines are replaced by ordinary black ink.",
          "mathematics": "Every side is 10 cm. Triangle ABC is right-angled at B; AC is a hexagon side. The horizontal diameter bisects the 120-degree interior angle at A, giving angle BAC = 60 degrees.",
          "answerVisibility": "Only source givens and constructions are visible; no calculated lengths or 60-degree solution annotation."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p52-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of $BC$ to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$BC\\approx8.66\\text{ cm}$",
          "worked": "The horizontal diameter bisects the interior angle at $A$, so $\\angle BAC=60^{\\circ}$.\n$$\\begin{align*}\\sin60^{\\circ}&=\\frac{BC}{10}\\\\BC&=10\\sin60^{\\circ}\\\\BC&\\approx8.66\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the length of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=5\\text{ cm}$",
          "worked": "$$\\begin{align*}\\cos60^{\\circ}&=\\frac{AB}{10}\\\\AB&=10\\cos60^{\\circ}\\\\AB&=5\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p52-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the distance between the parallel sides to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17.3\\text{ cm}$",
          "worked": "By symmetry, the perpendicular distance between the parallel sides is $2BC$.\n$$\\begin{align*}2BC&=20\\sin60^{\\circ}\\\\2BC&\\approx17.3\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p52-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the distance between two opposite vertices.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ cm}$",
          "worked": "The horizontal distance between opposite vertices consists of two lengths equal to $AB$ and one length equal to a side.\n$$5+10+5=20\\text{ cm}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
