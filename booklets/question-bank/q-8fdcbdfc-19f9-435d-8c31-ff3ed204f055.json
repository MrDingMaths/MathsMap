  "content": {
    "id": "v2-b532f-p46-practice-slot-8-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A tank initially contains 600 L of water. A pump adds water at 15 L per minute.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b532f-p46-practice-slot-8-lower-slot-8-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "Write a rule for the volume, $V$ litres, of water after $t$ hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=600+900t$",
          "worked": "The pump adds $15\\times60=900$ L per hour. The initial volume is 600 L.\n$$V=600+900t$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-b532f-p46-practice-slot-8-lower-slot-8-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the volume after 3 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3300 L",
          "worked": "$$\\begin{align*}V&=600+900(3)\\\\V&=3300\\end{align*}$$\nThe volume is 3300 L.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b532f-p46-practice-slot-8-lower-slot-8-lower-c",
        "type": "part",
        "label": "c",
        "prompt": "How long will it take for the tank to hold 2.4 kL?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 hours",
          "worked": "2.4 kL is 2400 L.\n$$\\begin{align*}2400&=600+900t\\\\1800&=900t\\\\t&=2\\end{align*}$$\nIt takes 2 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
