      {
        "id": "p19-q7-a",
        "type": "group",
        "label": "a",
        "prompt": "Each year when the sunflower paddock is weeded, only half the previous weight of weed is dug out. In the first year, 6 tonnes of weed is dug out.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p19-q7-a-i",
            "type": "part",
            "label": "i",
            "prompt": "How much is dug out in the 10th year?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{3}{256}$ tonnes",
              "worked": "$a=6$, $r=\\dfrac12$.\n\n$$\\begin{aligned}a_{10}&=ar^9\\\\a_{10}&=6\\left(\\frac12\\right)^9\\\\a_{10}&=\\frac{3}{256}\\text{ tonnes}\\\\a_{10}&\\approx0.01172\\text{ tonnes}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p19-q7-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "What is the total dug out over 10 years (correct to four significant figures)?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$11.99$ tonnes",
              "worked": "$$\\begin{aligned}S_{10}&=\\frac{a(1-r^{10})}{1-r}\\\\S_{10}&=\\frac{6\\left(1-\\left(\\frac12\\right)^{10}\\right)}{\\frac12}\\\\S_{10}&=\\frac{3069}{256}\\text{ tonnes}\\\\S_{10}&\\approx11.99\\text{ tonnes}\\end{aligned}$$\n\nCorrect to four significant figures.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          }
        ]
      }
    ]
  },
