  "content": {
    "id": "p15-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the standard deviation of a normally distributed data set with mean $89$, if a raw score of $59$ has z-score $-0.6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sigma=50$",
      "worked": "$$\\begin{align*}-0.6&=\\frac{59-89}{\\sigma}\\\\\\sigma&=\\frac{-30}{-0.6}\\\\\\sigma&=50\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
