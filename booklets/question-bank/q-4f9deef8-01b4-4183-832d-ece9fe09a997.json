        "answer": {
          "short": "$\\dfrac{dy}{dx}=-42(7x-5)^{-7}$",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-6(7x-5)^{-7}(7)\\\\\\frac{dy}{dx}&=-42(7x-5)^{-7}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p41-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{1}{3+5x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-5(3+5x)^{-2}$",
          "worked": "$$\\begin{aligned}y&=(3+5x)^{-1}\\\\\\frac{dy}{dx}&=-1(3+5x)^{-2}(5)\\\\\\frac{dy}{dx}&=-5(3+5x)^{-2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p41-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{4}{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-8(2x-1)^{-2}$",
          "worked": "$$\\begin{aligned}y&=4(2x-1)^{-1}\\\\\\frac{dy}{dx}&=4(-1)(2x-1)^{-2}(2)\\\\\\frac{dy}{dx}&=-8(2x-1)^{-2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
