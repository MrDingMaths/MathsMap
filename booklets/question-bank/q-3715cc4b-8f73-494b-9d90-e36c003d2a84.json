        "answer": {
          "short": "$S_1=18$, $S_2=24$, $S_3=26$, $S_4=26\\frac{2}{3}$, $S_5=26\\frac{8}{9}$, $S_6=26\\frac{26}{27}$.",
          "worked": "$$\\begin{align*}S_1&=18\\\\S_2&=18+6=24\\\\S_3&=24+2=26\\\\S_4&=26+\\frac{2}{3}=26\\frac{2}{3}\\\\S_5&=26\\frac{2}{3}+\\frac{2}{9}=26\\frac{8}{9}\\\\S_6&=26\\frac{8}{9}+\\frac{2}{27}=26\\frac{26}{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
