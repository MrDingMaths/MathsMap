  "content": {
    "id": "p22-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The salary structures for companies A and B are given by:\nCompany A: $\\$20$ per hour\nCompany B: $\\$45$ plus $\\$15$ per hour",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q3-a",
        "type": "group",
        "label": "a",
        "prompt": "Find a rule for $\\$E$ earned in $t$ hours for:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q3-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Company A",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$E = 20t$",
              "worked": "Earnings equal the hourly rate multiplied by the hours worked.\n$$\\begin{align*}E &= 20t\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p22-q3-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Company B",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$E = 45 + 15t$",
              "worked": "Earnings equal the fixed payment plus the hourly rate multiplied by the hours worked.\n$$\\begin{align*}E &= 45 + 15t\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          }
        ]
      },
      {
        "id": "p22-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve your two simultaneous equations from part a.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(t,E) = (9,180)$",
          "worked": "Substitute $E = 20t$ into $E = 45 + 15t$.\n$$\\begin{align*}20t &= 45 + 15t\\\\5t &= 45\\\\t &= 9\\end{align*}$$\nSubstitute $t = 9$ into $E = 20t$.\n$$\\begin{align*}E &= 20(9)\\\\E &= 180\\end{align*}$$\nThus $t = 9$ hours and $E = \\$180$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p22-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "State the number of hours worked for which the earnings are the same for the two companies.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 hours",
          "worked": "The solution gives $t = 9$, so the earnings are equal after 9 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p22-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "State the amount earned when the earnings are the same for the two companies.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$180$",
          "worked": "The solution gives $E = 180$, so each company pays $\\$180$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
