  "content": {
    "id": "p25-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A car uses 9 L of petrol to travel 100 km. Answer to 1 d.p.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How much petrol is needed to travel 50 km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.5\\text{ L}$",
          "worked": "$$\\begin{align*}\\frac{9\\text{ L}}{100\\text{ km}}&=\\frac{x\\text{ L}}{50\\text{ km}}\\\\x\\text{ L}&=\\frac{9\\text{ L}}{100\\text{ km}}\\times50\\text{ km}\\\\x&=4.5\\end{align*}$$\nThe petrol needed is $4.5\\text{ L}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "How far can it travel using 50 L?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$555.6\\text{ km}$",
          "worked": "$$\\begin{align*}\\frac{9\\text{ L}}{100\\text{ km}}&=\\frac{50\\text{ L}}{x\\text{ km}}\\end{align*}$$\nTake the reciprocal of both sides.\n$$\\begin{align*}\\frac{100\\text{ km}}{9\\text{ L}}&=\\frac{x\\text{ km}}{50\\text{ L}}\\\\x\\text{ km}&=\\frac{100\\text{ km}}{9\\text{ L}}\\times50\\text{ L}\\\\x&=\\frac{5000}{9}\\\\x&\\approx555.6\\end{align*}$$\nThe distance is approximately $555.6\\text{ km}$ (1 d.p.).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
