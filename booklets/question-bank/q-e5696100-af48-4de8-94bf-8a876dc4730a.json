  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A circle has circumference $66\\text{ cm}$. Using $\\pi \\approx \\frac{22}{7}$, find the approximate value of the diameter of the circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$21\\text{ cm}$",
      "worked": "Divide the circumference by $\\pi$ to find the diameter.\n\n$$\\begin{align*}C&=\\pi d\\\\d&=\\frac{C}{\\pi}\\\\d&\\approx66\\div\\frac{22}{7}\\\\d&\\approx66\\times\\frac{7}{22}\\\\d&\\approx21\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
