  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each of the following by factorising the numerator and denominator and then cancelling:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{a^2-4}{a+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a-2$",
          "worked": "$$\\begin{align*}\\frac{a^2-4}{a+2}&=\\frac{(a-2)(a+2)}{a+2}\\\\\\frac{a^2-4}{a+2}&=a-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x^2+3x+2}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+1$",
          "worked": "$$\\begin{align*}\\frac{x^2+3x+2}{x+2}&=\\frac{(x+1)(x+2)}{x+2}\\\\\\frac{x^2+3x+2}{x+2}&=x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a+2}{a^2-a-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a-3}$",
          "worked": "$$\\begin{align*}\\frac{a+2}{a^2-a-6}&=\\frac{a+2}{(a-3)(a+2)}\\\\\\frac{a+2}{a^2-a-6}&=\\frac{1}{a-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x^2-4x-12}{x-6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$$\\begin{align*}\\frac{x^2-4x-12}{x-6}&=\\frac{(x-6)(x+2)}{x-6}\\\\\\frac{x^2-4x-12}{x-6}&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2b+6}{b^2-3b-18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{b-6}$",
          "worked": "$$\\begin{align*}\\frac{2b+6}{b^2-3b-18}&=\\frac{2(b+3)}{(b-6)(b+3)}\\\\\\frac{2b+6}{b^2-3b-18}&=\\frac{2}{b-6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2x^2+7x+3}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+1$",
          "worked": "$$\\begin{align*}\\frac{2x^2+7x+3}{x+3}&=\\frac{(2x+1)(x+3)}{x+3}\\\\\\frac{2x^2+7x+3}{x+3}&=2x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{6x^2+x-1}{2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-1$",
          "worked": "$$\\begin{align*}\\frac{6x^2+x-1}{2x+1}&=\\frac{(3x-1)(2x+1)}{2x+1}\\\\\\frac{6x^2+x-1}{2x+1}&=3x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{4b-6}{6b^2-19b+15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3b-5}$",
          "worked": "$$\\begin{align*}\\frac{4b-6}{6b^2-19b+15}&=\\frac{2(2b-3)}{(2b-3)(3b-5)}\\\\\\frac{4b-6}{6b^2-19b+15}&=\\frac{2}{3b-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x^2-6x+9}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-3}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x^2-6x+9}{x^2-9}&=\\frac{(x-3)^2}{(x-3)(x+3)}\\\\\\frac{x^2-6x+9}{x^2-9}&=\\frac{x-3}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{d^2-8d+16}{d^2-16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d-4}{d+4}$",
          "worked": "$$\\begin{align*}\\frac{d^2-8d+16}{d^2-16}&=\\frac{(d-4)^2}{(d-4)(d+4)}\\\\\\frac{d^2-8d+16}{d^2-16}&=\\frac{d-4}{d+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{x^2-9x+20}{x^2-x-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-5}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x^2-9x+20}{x^2-x-12}&=\\frac{(x-5)(x-4)}{(x-4)(x+3)}\\\\\\frac{x^2-9x+20}{x^2-x-12}&=\\frac{x-5}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{2a^2-11a+5}{8a^2+2a-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a-5}{4a+3}$\n\nFactorise both quadratics and cancel $2a-1$.",
          "worked": "$$\\begin{align*}\\frac{2a^2-11a+5}{8a^2+2a-3}&=\\frac{(2a-1)(a-5)}{(2a-1)(4a+3)}\\\\\\frac{2a^2-11a+5}{8a^2+2a-3}&=\\frac{a-5}{4a+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
