  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify\n$$\\frac{1}{a^n+1}+\\frac{1}{a^{-n}+1}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$\n\nRewrite $a^{-n}$ as $\\frac{1}{a^n}$ and combine the fractions.",
      "worked": "$$\\begin{align*}\\frac{1}{a^n+1}+\\frac{1}{a^{-n}+1}&=\\frac{1}{a^n+1}+\\frac{1}{\\frac{1}{a^n}+1}\\\\\\frac{1}{a^n+1}+\\frac{1}{a^{-n}+1}&=\\frac{1}{a^n+1}+\\frac{a^n}{1+a^n}\\\\\\frac{1}{a^n+1}+\\frac{1}{a^{-n}+1}&=\\frac{1+a^n}{a^n+1}\\\\\\frac{1}{a^n+1}+\\frac{1}{a^{-n}+1}&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
