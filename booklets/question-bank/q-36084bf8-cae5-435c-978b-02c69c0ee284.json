  "content": {
    "id": "p33-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "The landlord of a large block of home units purchased washing machines for its units six years ago for $\\$600\\,000$, and is assuming a depreciation rate of $30\\%$ p.a.\n\nGive monetary answers to the nearest cent where necessary and the percentage decrease to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the estimated value after one year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$420\\,000$",
          "worked": "The value retained each year is $100\\%-30\\%=70\\%$.\n\n$$\\begin{align*}A_1&=600\\,000(1-0.30)^1\\\\A_1&=600\\,000(0.70)\\\\A_1&=\\$420\\,000.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the estimated value after two years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$294\\,000$",
          "worked": "$$\\begin{align*}A_2&=600\\,000(1-0.30)^2\\\\A_2&=600\\,000(0.70)^2\\\\A_2&=\\$294\\,000.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the estimated value after six years.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$70\\,589.40$",
          "worked": "$$\\begin{align*}A_6&=600\\,000(1-0.30)^6\\\\A_6&=600\\,000(0.70)^6\\\\A_6&=\\$70\\,589.40.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the percentage decrease in value over the six-year period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$88.2\\%$ decrease.",
          "worked": "$$\\begin{align*}\\text{Percentage decrease}&=\\left(1-0.70^6\\right)\\times100\\%\\\\\\text{Percentage decrease}&=88.2351\\%\\\\\\text{Percentage decrease}&\\approx88.2\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "What is the average reduction in value, in dollars p.a., on the washing machines over the six-year period due to depreciation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$88\\,235.10$ p.a.\n\nDivide the total loss in value by six years.",
          "worked": "$$\\begin{align*}\\text{Total reduction}&=600\\,000-70\\,589.40\\\\\\text{Total reduction}&=\\$529\\,410.60.\\end{align*}$$\n\n$$\\begin{align*}\\text{Average reduction per year}&=529\\,410.60\\div6\\\\\\text{Average reduction per year}&=\\$88\\,235.10\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
