  "content": {
    "id": "p35-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider the isosceles triangle $ABC$ with $AB=AC$. Suppose $D$ is on $AB$ and $E$ is on $AC$, so that $AD=DE$. If $\\angle CED=142^\\circ$, calculate $\\angle ABC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p35-q6-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
