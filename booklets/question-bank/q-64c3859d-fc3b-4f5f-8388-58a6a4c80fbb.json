                "latex": "\\angle ABC=71^\\circ",
                "display": false
              }
            ]
          },
          {
            "id": "p35-q6-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Use the straight angle at E, then the equal base angles in triangles ADE and ABC.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\angle AED&=180^\\circ-142^\\circ\\\\\\angle AED&=38^\\circ\\end{align*}$$\nAngles on the straight line $AEC$ add to $180^\\circ$.\n\n$AD=DE$, so the base angles of isosceles triangle $ADE$ are equal:\n$$\\angle DAE=\\angle AED=38^\\circ.$$\nSince $D$ is on $AB$ and $E$ is on $AC$, $\\angle BAC=\\angle DAE=38^\\circ$.\n\n$AB=AC$, so $\\angle ABC=\\angle ACB$. Using the angle sum of triangle $ABC$,\n$$\\begin{align*}2\\angle ABC+38^\\circ&=180^\\circ\\\\2\\angle ABC&=142^\\circ\\\\\\angle ABC&=71^\\circ.\\end{align*}$$",
      "solutionDiagrams": []
    },
