        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}(4-\\sqrt{7})(4+\\sqrt{7})&=4^2-(\\sqrt{7})^2\\\\(4-\\sqrt{7})(4+\\sqrt{7})&=16-7\\\\(4-\\sqrt{7})(4+\\sqrt{7})&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q32-response",
        "type": "part",
        "label": "d",
        "prompt": "$(2+3\\sqrt{2})(\\sqrt{5}-\\sqrt{2})$",
