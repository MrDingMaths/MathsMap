        "children": [],
        "answer": {
          "short": "$-17$",
          "worked": "$$\\begin{align*}(1+3\\sqrt{2})(1-3\\sqrt{2})&=1^2-(3\\sqrt{2})^2\\\\(1+3\\sqrt{2})(1-3\\sqrt{2})&=1-18\\\\(1+3\\sqrt{2})(1-3\\sqrt{2})&=-17\\end{align*}$$",
