  "content": {
    "id": "p23-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If $x=\\sqrt{2}-1$ and $y=\\sqrt{2}+1$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-2\\sqrt{2}$",
          "worked": "$$\\begin{align*}x^2&=(\\sqrt{2}-1)^2\\\\x^2&=2-2\\sqrt{2}+1\\\\x^2&=3-2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+2\\sqrt{2}$",
          "worked": "$$\\begin{align*}y^2&=(\\sqrt{2}+1)^2\\\\y^2&=2+2\\sqrt{2}+1\\\\y^2&=3+2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}x^2+y^2&=(3-2\\sqrt{2})+(3+2\\sqrt{2})\\\\x^2+y^2&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p23-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\sqrt{2}$",
          "worked": "$$\\begin{align*}x^2-y^2&=(3-2\\sqrt{2})-(3+2\\sqrt{2})\\\\x^2-y^2&=3-2\\sqrt{2}-3-2\\sqrt{2}\\\\x^2-y^2&=-4\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}xy&=(\\sqrt{2}-1)(\\sqrt{2}+1)\\\\xy&=(\\sqrt{2})^2-1^2\\\\xy&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}-1$\n\nUse $xy=1$.",
          "worked": "Using part e,\n$$\\begin{align*}x^2y&=x(xy)\\\\x^2y&=(\\sqrt{2}-1)\\times1\\\\x^2y&=\\sqrt{2}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$y^2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}+1$\n\nUse $xy=1$.",
          "worked": "Using part e,\n$$\\begin{align*}y^2x&=y(xy)\\\\y^2x&=(\\sqrt{2}+1)\\times1\\\\y^2x&=\\sqrt{2}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{1}{x}+\\frac{1}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}$\n\nCombine the fractions and use $xy=1$.",
          "worked": "$$\\begin{align*}\\frac{1}{x}+\\frac{1}{y}&=\\frac{x+y}{xy}\\\\\\frac{1}{x}+\\frac{1}{y}&=\\frac{(\\sqrt{2}-1)+(\\sqrt{2}+1)}{1}\\\\\\frac{1}{x}+\\frac{1}{y}&=2\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
