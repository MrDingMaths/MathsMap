  "content": {
    "id": "p3-q3-root",
    "type": "question",
    "label": null,
    "prompt": "For each of the following functions below, find $f(2)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}f(2)&=3(2)+1\\\\f(2)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=1-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}f(2)&=1-2^2\\\\f(2)&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\sqrt{5x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}f(2)&=\\sqrt{5(2)-1}\\\\f(2)&=\\sqrt{9}\\\\f(2)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p3-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{x+1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}f(2)&=\\frac{2+1}{2-1}\\\\f(2)&=\\frac{3}{1}\\\\f(2)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
