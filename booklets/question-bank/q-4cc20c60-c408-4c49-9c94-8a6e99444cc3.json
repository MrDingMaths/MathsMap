    "children": [
      {
        "id": "p53-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $\\angle RPS=\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle QPR=90^\\circ-\\theta$, so $\\angle RPS=\\theta$.",
          "worked": "In right-angled triangle $QPR$, $\\angle QPR=90^\\circ-\\theta$. Since $\\angle QPS=90^\\circ$,\n$$\\begin{align*}\\angle RPS&=90^\\circ-(90^\\circ-\\theta)\\\\&=\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p53-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Find two expressions for $\\tan\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{h}{a}$ and $\\dfrac{b}{h}$.",
          "worked": "Using opposite over adjacent in triangles $QPR$ and $PRS$, respectively:\n$$\\begin{align*}\\tan\\theta&=\\frac{h}{a}\\\\\\tan\\theta&=\\frac{b}{h}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p53-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence show $ab=h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{h}{a}=\\dfrac{b}{h}$, so $ab=h^2$.",
          "worked": "Equate the two expressions for $\\tan\\theta$ and multiply both sides by $ah$:\n$$\\begin{align*}\\frac{h}{a}&=\\frac{b}{h}\\\\h^2&=ab\\\\ab&=h^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
