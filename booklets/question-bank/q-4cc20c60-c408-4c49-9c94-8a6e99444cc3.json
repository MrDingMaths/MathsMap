        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 53 p53-q21-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,text=black,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (Q) at (0,0);\n\\coordinate (R) at (1,0);\n\\coordinate (P) at (1,2);\n\\coordinate (S) at (5,0);\n\\draw (Q)--(P)--(S)--cycle;\n\\draw (P)--(R);\n\\draw[line width=0.4pt] ($(R)!0.24cm!(P)$)--($(R)!0.24cm!(P)+(R)!0.24cm!(S)-(R)$)--($(R)!0.24cm!(S)$);\n\\draw[line width=0.4pt] ($(P)!0.24cm!(Q)$)--($(P)!0.24cm!(Q)+(P)!0.24cm!(S)-(P)$)--($(P)!0.24cm!(S)$);\n\\pic[draw,line width=0.4pt,angle radius=0.48cm] {angle=S--Q--P};\n\\node[above] at (P) {$P$};\n\\node[below left] at (Q) {$Q$};\n\\node[below] at (R) {$R$};\n\\node[right] at (S) {$S$};\n\\path (Q)--(R) node[midway,below=3mm] {$a$};\n\\path (R)--(S) node[midway,below=3mm] {$b$};\n\\path (R)--(P) node[midway,right=1mm] {$h$};\n\\node at ($(Q)+(0.51,0.30)$) {$\\theta$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 58,
        "alt": "Mathematical diagram",
        "overlayOf": null,
