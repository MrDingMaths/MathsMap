    "type": "question",
    "label": "9",
    "prompt": "Given that $P(x)=x^2-2x-4$, find the value of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(1+\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}P(1+\\sqrt{5})&=(1+\\sqrt{5})^2-2(1+\\sqrt{5})-4\\\\P(1+\\sqrt{5})&=1+2\\sqrt{5}+5-2-2\\sqrt{5}-4\\\\P(1+\\sqrt{5})&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(\\sqrt{3}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-4\\sqrt{3}$",
          "worked": "$$\\begin{align*}P(\\sqrt{3}-1)&=(\\sqrt{3}-1)^2-2(\\sqrt{3}-1)-4\\\\P(\\sqrt{3}-1)&=3-2\\sqrt{3}+1-2\\sqrt{3}+2-4\\\\P(\\sqrt{3}-1)&=2-4\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
