  "content": {
    "id": "v2-b36ea-p13-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "A Bernoulli random variable $X$ has $E(X)=0.35$. Find $P(X=0)$ and $\\sigma(X)$, correct to 3 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(X=0)=0.65$, $\\sigma(X)\\approx0.477$",
      "worked": "$$\\begin{aligned}p&=E(X)=0.35\\\\P(X=0)&=1-0.35\\\\&=0.65\\end{aligned}$$\n$$\\begin{aligned}\\operatorname{Var}(X)&=p(1-p)\\\\&=0.35(0.65)\\\\&=0.2275\\end{aligned}$$\n$$\\sigma(X)=\\sqrt{0.2275}\\approx0.477$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
