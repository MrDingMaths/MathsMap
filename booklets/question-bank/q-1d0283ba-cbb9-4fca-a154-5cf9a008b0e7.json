  "content": {
    "id": "p26-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "For each value of $x$, find $x^2$ and simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}x^2&=(\\sqrt{5})^2\\\\x^2&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p26-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=3a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9a^2$",
          "worked": "$$\\begin{align*}x^2&=(3a)^2\\\\x^2&=3^2a^2\\\\x^2&=9a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=-2b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b^2$",
          "worked": "$$\\begin{align*}x^2&=(-2b)^2\\\\x^2&=(-2)^2b^2\\\\x^2&=4b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=a+b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+2ab+b^2$",
          "worked": "$$\\begin{align*}x^2&=(a+b)^2\\\\x^2&=a^2+2ab+b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$x=3m-2n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9m^2-12mn+4n^2$",
          "worked": "$$\\begin{align*}x^2&=(3m-2n)^2\\\\x^2&=(3m)^2-2(3m)(2n)+(2n)^2\\\\x^2&=9m^2-12mn+4n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
