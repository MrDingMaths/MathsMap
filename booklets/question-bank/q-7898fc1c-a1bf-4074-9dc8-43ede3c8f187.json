        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f'(x)$ and $f''(x)$ for $f(x)=(2x-3)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=8(2x-3)^3$, $f''(x)=48(2x-3)^2$.",
          "worked": "$$\\begin{align*}f'(x)&=4(2x-3)^3\\times2\\\\f'(x)&=8(2x-3)^3\\\\f''(x)&=8\\times3(2x-3)^2\\times2\\\\f''(x)&=48(2x-3)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p24-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence evaluate:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$f'(1)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-8$",
              "worked": "$$\\begin{align*}f'(1)&=8(2\\times1-3)^3\\\\f'(1)&=8(-1)^3\\\\f'(1)&=-8\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p24-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$f''(1)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$48$",
              "worked": "$$\\begin{align*}f''(1)&=48(2\\times1-3)^2\\\\f''(1)&=48(-1)^2\\\\f''(1)&=48\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      }
