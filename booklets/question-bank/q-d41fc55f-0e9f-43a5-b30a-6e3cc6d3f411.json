        "answer": {
          "short": "$\\dfrac{1}{2000}$",
          "worked": "$$\\begin{align*}5 \\times 10^{-4} &= \\frac{5}{10^4} \\\\ &= \\frac{5}{10000} \\\\ &= \\frac{1}{2000}\\end{align*}$$",
