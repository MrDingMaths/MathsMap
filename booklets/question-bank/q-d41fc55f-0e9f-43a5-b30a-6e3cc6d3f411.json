        "children": [],
        "answer": {
          "short": "$\\dfrac{171}{50\\,000\\,000}$",
          "worked": "$$\\begin{align*}3.42 \\times 10^{-6} &= \\frac{3.42}{10^6} \\\\ &= \\frac{3.42}{1\\,000\\,000} \\\\ &= \\frac{1.71}{500\\,000} \\\\ &= \\frac{171}{50\\,000\\,000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
