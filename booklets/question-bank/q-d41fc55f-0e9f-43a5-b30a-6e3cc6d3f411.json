        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2000}$",
          "worked": "$$\\begin{align*}1.5 \\times 10^{-3} &= \\frac{1.5}{10^3} \\\\ &= \\frac{1.5}{1000} \\\\ &= \\frac{3}{2000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
