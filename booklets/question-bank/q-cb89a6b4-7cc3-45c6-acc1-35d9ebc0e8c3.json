    "type": "question",
    "label": "13",
    "prompt": "Solve $\\cos 2x+\\cos x=0$ for $0^\\circ\\le x\\le360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=60^\\circ,180^\\circ,300^\\circ$.",
      "worked": "$$\\begin{align*}2\\cos^2x-1+\\cos x&=0\\\\2\\cos^2x+\\cos x-1&=0\\\\(2\\cos x-1)(\\cos x+1)&=0\\end{align*}$$\nHence $\\cos x=\\frac12$ or $\\cos x=-1$.\n$$\\begin{align*}\\cos x&=\\frac12,&x&=60^\\circ,300^\\circ\\\\\\cos x&=-1,&x&=180^\\circ\\end{align*}$$\nTherefore $x=60^\\circ,180^\\circ,300^\\circ$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
