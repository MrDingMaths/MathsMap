    "type": "question",
    "label": null,
    "prompt": "Find the domain of $f(x)=\\dfrac{\\sqrt{5-x}}{x+1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x\\le5,\\ x\\ne-1$",
      "worked": "The radicand must satisfy $5-x\\ge0$, so $x\\le5$. The denominator must satisfy $x+1\\ne0$, so $x\\ne-1$.\n\nThe domain is $x\\le5$, $x\\ne-1$.",
