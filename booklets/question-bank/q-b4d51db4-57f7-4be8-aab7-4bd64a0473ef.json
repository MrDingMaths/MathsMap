  "content": {
    "id": "p33-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Two dice are rolled and the sum of the two numbers is returned. Find the expected value.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7$",
      "worked": "Let $X$ be the sum. The 36 ordered outcomes are equally likely. The sums $2,3,\\ldots,12$ occur with frequencies $1,2,3,4,5,6,5,4,3,2,1$, respectively.\n\n$$\\begin{align*}E(X)&=\\frac{2(1)+3(2)+4(3)+5(4)+6(5)+7(6)+8(5)+9(4)+10(3)+11(2)+12(1)}{36}\\\\E(X)&=\\frac{252}{36}\\\\E(X)&=7.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
