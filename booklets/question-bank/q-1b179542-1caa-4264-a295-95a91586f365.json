    "answer": {
      "short": "$2.6\\text{ cm}$; solve $\\tfrac12x(x+5)=10$ and take the positive root.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p34-q4-response-bank-p34-q4-work-0-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The base is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(x+5)\\text{ cm}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p34-q4-response-bank-p34-q4-work-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac12x(x+5)&=10\\\\x^2+5x-20&=0\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p34-q4-response-bank-p34-q4-work-1-formula",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}x&=\\frac{-5\\pm\\sqrt{5^2-4(1)(-20)}}{2(1)}\\\\x&=\\frac{-5\\pm\\sqrt{105}}{2}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p34-q4-response-bank-p34-q4-work-2-0",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since the height is positive, reject the negative root.",
                "marks": []
              }
            ]
          },
          {
            "id": "p34-q4-response-bank-p34-q4-work-3",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 0,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\nx&=\\frac{-5+\\sqrt{105}}{2}\\\\\nx&\\approx2.6\\text{ cm}\\quad\\text{(1 d.p.)}\n\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
