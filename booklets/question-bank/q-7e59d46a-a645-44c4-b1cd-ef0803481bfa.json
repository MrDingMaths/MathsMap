      {
        "id": "p18-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(4+x)^5$ as far as the term in $x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1024+1280x+640x^2+160x^3+\\cdots$",
          "worked": "$$\\begin{aligned}(4+x)^5&=4^5+\\binom51 4^4x+\\binom52 4^3x^2+\\binom53 4^2x^3+\\cdots\\\\&=1024+1280x+640x^2+160x^3+\\cdots.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coefficient of $x^3$ in the expansion of $(3-x)(4+x)^5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-160$",
          "worked": "$$(3-x)(4+x)^5=(3-x)(1024+1280x+640x^2+160x^3+\\cdots).$$\nCoefficient of $x^3$:\n$$\\begin{aligned}3(160)+(-1)(640)&=480-640\\\\&=-160.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
