  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The volume $V$ litres of fuel in a tanker, $t$ minutes after it has started to empty, is given by $V=200(400-t^2)$. Initially the tanker was full.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the initial volume of fuel in the tanker.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\,000\\text{ L}$",
          "worked": "$$\\begin{align*}V(0)&=200(400-0^2)\\\\V(0)&=80\\,000\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the volume of fuel in the tanker after 15 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35\\,000\\text{ L}$",
          "worked": "$$\\begin{align*}V(15)&=200(400-15^2)\\\\V(15)&=200(175)\\\\V(15)&=35\\,000\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the time taken for the tanker to empty.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ min}$",
          "worked": "The tanker is empty when $V=0$.\n$$\\begin{align*}200(400-t^2)&=0\\\\t^2&=400\\\\t&=\\pm20\\end{align*}$$\nSince $t\\geq0$, the tanker empties after $20$ minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $\\dfrac{dV}{dt}=-400t$, and hence find the rate at which the tanker is emptying after 5 minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dV}{dt}=-400t$; the volume is decreasing by $2000\\text{ L/min}$ after 5 minutes.",
          "worked": "$$\\begin{align*}V&=80\\,000-200t^2\\\\\\frac{dV}{dt}&=-400t\\\\V'(5)&=-400(5)\\\\V'(5)&=-2000\\text{ L/min}\\end{align*}$$\nThe tanker is emptying at $2000\\text{ L/min}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
