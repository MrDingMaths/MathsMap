    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-practice-left-response",
        "type": "part",
        "label": "a",
        "prompt": "Find the angle between the two vectors, to one decimal place.\n\n$\\underset{\\sim}{a}=\\begin{pmatrix}3\\\\1\\end{pmatrix}$ and $\\underset{\\sim}{b}=\\begin{pmatrix}2\\\\5\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49.8^\\circ$",
          "worked": "$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=(3)(2)+(1)(5)\\\\&=11\\end{aligned}$\n\n$|\\underset{\\sim}{a}|=\\sqrt{3^2+1^2}=\\sqrt{10}$\n\n$|\\underset{\\sim}{b}|=\\sqrt{2^2+5^2}=\\sqrt{29}$\n\n$\\begin{aligned}\\cos\\theta&=\\frac{11}{\\sqrt{10}\\sqrt{29}}\\\\\\theta&=\\cos^{-1}\\left(\\frac{11}{\\sqrt{290}}\\right)\\\\&\\approx49.8^\\circ\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p7-practice-right-response",
        "type": "part",
        "label": "b",
        "prompt": "Find the angle between the two vectors, to the nearest degree.\n\n$\\underset{\\sim}{r}=-\\mathbf{i}-3\\mathbf{j}$ and $\\underset{\\sim}{s}=2\\mathbf{i}+5\\mathbf{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$177^\\circ$",
          "worked": "$\\begin{aligned}\\underset{\\sim}{r}\\cdot\\underset{\\sim}{s}&=(-1)(2)+(-3)(5)\\\\&=-17\\end{aligned}$\n\n$|\\underset{\\sim}{r}|=\\sqrt{(-1)^2+(-3)^2}=\\sqrt{10}$\n\n$|\\underset{\\sim}{s}|=\\sqrt{2^2+5^2}=\\sqrt{29}$\n\n$\\begin{aligned}\\cos\\theta&=\\frac{-17}{\\sqrt{10}\\sqrt{29}}\\\\\\theta&=\\cos^{-1}\\left(\\frac{-17}{\\sqrt{290}}\\right)\\\\&\\approx177^\\circ\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
