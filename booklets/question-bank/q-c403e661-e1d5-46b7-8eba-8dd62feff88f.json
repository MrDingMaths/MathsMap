    "prompt": "Complete the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "sum-product-b4-1-root",
        "type": "part",
        "label": "a",
        "prompt": "If $\\alpha,\\beta,\\gamma$ and $\\delta$ are the roots of $x^4+2x^3-5x^2+3x-7=0$, find $\\alpha^2+\\beta^2+\\gamma^2+\\delta^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta+\\gamma+\\delta&=-\\frac{2}{1}=-2\\\\\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta&=\\frac{-5}{1}=-5\\end{aligned}$$\n$$\\begin{aligned}\\alpha^2+\\beta^2+\\gamma^2+\\delta^2&=(\\alpha+\\beta+\\gamma+\\delta)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta)\\\\&=(-2)^2-2(-5)\\\\&=14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "sum-product-b4-2-root",
        "type": "part",
        "label": "b",
        "prompt": "If $\\alpha,\\beta,\\gamma$ and $\\delta$ are the roots of $2x^4-6x^3+5x^2-x+3=0$, find $\\alpha^2+\\beta^2+\\gamma^2+\\delta^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta+\\gamma+\\delta&=-\\frac{-6}{2}=3\\\\\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta&=\\frac{5}{2}\\end{aligned}$$\n$$\\begin{aligned}\\alpha^2+\\beta^2+\\gamma^2+\\delta^2&=(\\alpha+\\beta+\\gamma+\\delta)^2\\\\&\\quad-2(\\alpha\\beta+\\alpha\\gamma+\\alpha\\delta+\\beta\\gamma+\\beta\\delta+\\gamma\\delta)\\\\&=3^2-2\\left(\\frac52\\right)\\\\&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
