  "content": {
    "id": "p27-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the point $P$ on the graph of $y=3x$ that is closest to the point $A(4,2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q2-short-result",
            "type": "paragraph",
