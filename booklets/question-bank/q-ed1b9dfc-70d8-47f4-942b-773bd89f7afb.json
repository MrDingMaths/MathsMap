    "type": "question",
    "label": "4",
    "prompt": "Find the binomial distribution with $50$ trials that has mean $30$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$X\\sim\\operatorname{Bin}\\left(50,\\dfrac35\\right)$",
      "worked": "Using $E(X)=np$ with $n=50$:\n$$\\begin{aligned}50p&=30\\\\p&=\\frac{30}{50}\\\\p&=\\frac35\\end{aligned}$$\nTherefore $X\\sim\\operatorname{Bin}\\left(50,\\dfrac35\\right)$.",
      "solutionDiagrams": []
    },
