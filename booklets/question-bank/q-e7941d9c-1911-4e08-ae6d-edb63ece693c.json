  "content": {
    "id": "p27-q13-node",
    "type": "question",
    "label": "13",
    "prompt": "Solve the equation $(\\ln x)^2-3\\ln(x)-4=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=e^4$ or $x=\\dfrac1e$.\n\nTreat $\\ln(x)$ as the variable in the quadratic, then exponentiate.",
      "worked": "Let $u=\\ln(x)$, with $x>0$.\n$$\\begin{align*}u^2-3u-4&=0\\\\(u-4)(u+1)&=0\\end{align*}$$\nSo $u=4$ or $u=-1$. Hence $\\ln(x)=4$ or $\\ln(x)=-1$, giving $x=e^4$ or $x=e^{-1}=\\frac1e$. Both are positive.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
