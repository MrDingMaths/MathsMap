  "content": {
    "id": "p75-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "On a school trip, there are 5 distinct hotel rooms A, B, C, D, E and 3 students X, Y, Z. Each student is assigned a different room. Find how many ways there are to assign the rooms by:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p75-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Using permutations for ordered selection.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{5}P_{3}=60$",
          "worked": "Select an ordered list of three rooms for X, Y and Z respectively.\n$$\\begin{aligned}{}^{5}P_{3}&=5\\times4\\times3\\\\&=60.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p75-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Using combinations, then arranging.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${}^{5}C_{3}\\times3!=60$",
          "worked": "Choose three of the five rooms, then arrange the three students among those rooms.\n$$\\begin{aligned}{}^{5}C_{3}\\times3!&=10\\times6\\\\&=60.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
