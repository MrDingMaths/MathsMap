    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A triangle has area $3\\text{ cm}^2$ and a height of $4\\text{ cm}$. Find the base length of the triangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{2}\\text{ cm}$.",
      "worked": "$$\\begin{align*}A&=\\frac{bh}{2}\\\\3&=\\frac{4b}{2}\\\\2b&=3\\\\b&=\\frac{3}{2}\\text{ cm}.\\end{align*}$$",
