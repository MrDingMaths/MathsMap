  "content": {
    "id": "p10-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The polynomial $P(x)=8x^4-28x^3+30x^2-13x+2$ has a triple zero.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p10-q7-a-task",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the triple zero.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p10-q7-a-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hint: try fractions.",
                  "marks": []
                }
