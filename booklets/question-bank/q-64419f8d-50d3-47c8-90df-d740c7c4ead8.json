    "label": "9",
    "prompt": "Solve the equation\n\n$$\\cos2x\\cos x-\\sin2x\\sin x=\\frac12$$\n\nfor $0^\\circ\\le x\\le360^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=20^\\circ,\\ 100^\\circ,\\ 140^\\circ,\\ 220^\\circ,\\ 260^\\circ,\\ 340^\\circ$.",
      "worked": "$$\\begin{align*}\\cos(2x+x)&=\\frac12\\\\\\cos3x&=\\frac12\\end{align*}$$\n\nSince $0^\\circ\\le3x\\le1080^\\circ$,\n\n$$\\begin{align*}3x&=60^\\circ,\\ 300^\\circ,\\ 420^\\circ,\\ 660^\\circ,\\ 780^\\circ,\\ 1020^\\circ\\\\x&=20^\\circ,\\ 100^\\circ,\\ 140^\\circ,\\ 220^\\circ,\\ 260^\\circ,\\ 340^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
