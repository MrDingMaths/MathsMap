    "type": "question",
    "label": "2",
    "prompt": "By listing elements, what is $\\binom{4}{3}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\{A,B,C\\}$, $\\{A,B,D\\}$, $\\{A,C,D\\}$, $\\{B,C,D\\}$. Hence $\\binom{4}{3}=4$.",
      "worked": "For four distinct elements $A$, $B$, $C$ and $D$, the three-element selections are\n$$\\{A,B,C\\},\\quad \\{A,B,D\\},\\quad \\{A,C,D\\},\\quad \\{B,C,D\\}.$$\nThere are four selections, so $\\binom{4}{3}=4$.",
      "solutionDiagrams": []
