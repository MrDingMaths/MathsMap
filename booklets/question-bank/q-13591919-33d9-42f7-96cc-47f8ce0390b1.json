        "label": "b",
        "prompt": "$(5+\\sqrt2)(\\sqrt2-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt2-13$",
          "worked": "$$\\begin{align*}(5+\\sqrt2)(\\sqrt2-3)&=5\\sqrt2-15+2-3\\sqrt2\\\\(5+\\sqrt2)(\\sqrt2-3)&=2\\sqrt2-13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-surds-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3\\sqrt2-\\sqrt5)(3\\sqrt2+\\sqrt5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}(3\\sqrt2-\\sqrt5)(3\\sqrt2+\\sqrt5)&=(3\\sqrt2)^2-(\\sqrt5)^2\\\\(3\\sqrt2-\\sqrt5)(3\\sqrt2+\\sqrt5)&=18-5\\\\(3\\sqrt2-\\sqrt5)(3\\sqrt2+\\sqrt5)&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-surds-q4-d",
        "type": "part",
