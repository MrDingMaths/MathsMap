        "prompt": "$\\sqrt8(\\sqrt6-\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt3-4$",
          "worked": "$$\\begin{align*}\\sqrt8(\\sqrt6-\\sqrt2)&=\\sqrt{48}-\\sqrt{16}\\\\\\sqrt8(\\sqrt6-\\sqrt2)&=4\\sqrt3-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
