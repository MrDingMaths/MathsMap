    "type": "question",
    "label": "4",
    "prompt": "Given the continuous probability distribution $f(x)=kx^3$ for $0\\le x\\le5$, $0$ for all other $x$, find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\frac{4}{625}$",
      "worked": "$$\\begin{align*}\\int_0^5 kx^3\\,dx&=1\\\\k\\left[\\frac{x^4}{4}\\right]_0^5&=1\\\\k\\left(\\frac{625}{4}-0\\right)&=1\\\\\\frac{625k}{4}&=1\\\\k&=\\frac{4}{625}\\end{align*}$$",
      "solutionDiagrams": []
    },
