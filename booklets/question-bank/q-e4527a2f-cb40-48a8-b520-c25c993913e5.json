        "answerSpaceMm": 65
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $x$ given $f(x)=\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\frac12$.",
          "worked": "For $-1\\le x<0$:\n$$\\begin{align*}x+1&=\\frac12\\\\x&=-\\frac12.\\end{align*}$$\nFor $0\\le x\\le1$:\n$$\\begin{align*}1-x&=\\frac12\\\\x&=\\frac12.\\end{align*}$$\nBoth values lie in their respective intervals. The rule $f(x)=0$ gives no further solutions. Hence $x=\\pm\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[0,1]$.",
          "worked": "The graph takes every value from $0$ to $1$. Both endpoints are attained: $f(-1)=0$ and $f(0)=1$. Therefore the range is $[0,1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
