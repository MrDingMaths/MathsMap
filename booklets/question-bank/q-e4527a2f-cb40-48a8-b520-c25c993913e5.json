  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the function\n$$f(x)=\\begin{cases}x+1,&-1\\le x<0,\\\\1-x,&0\\le x\\le1,\\\\0,&\\text{otherwise}.\\end{cases}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Line segments join $(-1,0)$, $(0,1)$ and $(1,0)$, with $y=0$ outside $[-1,1]$. All three marked points are included.",
          "worked": "For $-1\\le x<0$, draw $y=x+1$ from $(-1,0)$ towards $(0,1)$. For $0\\le x\\le1$, draw $y=1-x$ from $(0,1)$ to $(1,0)$. Draw $y=0$ for $x<-1$ and $x>1$. The point $(0,1)$ is included by the second rule; both $(-1,0)$ and $(1,0)$ are included.",
          "solutionDiagrams": [
            {
              "id": "p7-q3-a-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 7 question 3; teacher page 31 Section B 3(a)\"}\n\\begin{tikzpicture}[x=1.35cm,y=1.35cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-2.7,-1.5) rectangle (2.8,2.1);\n\\draw[->,line width=0.5pt] (-2.5,0)--(2.5,0) node[right] {$x$};\n\\draw[->,line width=0.5pt] (0,-1.35)--(0,1.85) node[above] {$y$};\n\\draw[<-,line width=0.8pt] (-2.4,0)--(-1,0);\n\\draw[line width=0.8pt] (-1,0)--(0,1)--(1,0);\n\\draw[->,line width=0.8pt] (1,0)--(2.4,0);\n\\fill (-1,0) circle (1.5pt) node[below left] {$(-1,0)$};\n\\fill (0,1) circle (1.5pt) node[above right] {$(0,1)$};\n\\fill (1,0) circle (1.5pt) node[below right] {$(1,0)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 65,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 7,
                "sourceRegion": "Question 3(a); answer graph in teacher PDF page 31, printed page 360, Section B",
                "description": "Two joined linear segments form a triangular peak above horizontal zero-valued tails. Coordinate labels replace ticks; no grid is supplied.",
                "mathematics": "y=x+1 on [-1,0); y=1-x on [0,1]; y=0 otherwise. Included points are (-1,0), (0,1), (1,0).",
                "answerVisibility": "Solution only."
              },
