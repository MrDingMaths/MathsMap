  "content": {
    "id": "p22-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find any points on each curve where the tangent has the given angle of inclination.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2\\sqrt{x},\\quad 30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,2\\sqrt{3})$",
          "worked": "$$\\begin{aligned}m&=\\tan30^\\circ\\\\m&=\\frac{1}{\\sqrt{3}}\\\\y&=2x^{1/2}\\\\\\frac{dy}{dx}&=x^{-1/2}\\\\\\frac{1}{\\sqrt{x}}&=\\frac{1}{\\sqrt{3}}\\\\\\sqrt{x}&=\\sqrt{3}\\\\x&=3\\\\y&=2\\sqrt{3}\\end{aligned}$$\nThe point is $(3,2\\sqrt{3})$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=3\\sqrt[3]{x},\\quad 45^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,3)$ and $(-1,-3)$",
          "worked": "$$\\begin{aligned}m&=\\tan45^\\circ\\\\m&=1\\\\y&=3x^{1/3}\\\\\\frac{dy}{dx}&=x^{-2/3}\\\\\\frac{1}{(\\sqrt[3]{x})^2}&=1\\\\(\\sqrt[3]{x})^2&=1\\\\\\sqrt[3]{x}&=\\pm1\\\\x&=\\pm1\\end{aligned}$$\nFor $x=1$,\n$$\\begin{aligned}y&=3\\sqrt[3]{1}\\\\y&=3\\end{aligned}$$\nFor $x=-1$,\n$$\\begin{aligned}y&=3\\sqrt[3]{-1}\\\\y&=-3\\end{aligned}$$\nThe points are $(1,3)$ and $(-1,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
