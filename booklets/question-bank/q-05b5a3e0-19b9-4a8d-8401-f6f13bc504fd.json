  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A sector has radius $6\\text{ cm}$. If the angle subtended at the centre is $120^{\\circ}$, find in exact form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Arc length",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\pi\\text{ cm}$",
          "worked": "$$\\begin{align*}\\theta &= 120\\times\\frac{\\pi}{180}=\\frac{2\\pi}{3}\\\\l &= r\\theta\\\\l &= 6\\times\\frac{2\\pi}{3}\\\\l &= 4\\pi\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Area of the sector",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\pi\\text{ cm}^{2}$",
          "worked": "$$\\begin{align*}\\theta &= 120\\times\\frac{\\pi}{180}=\\frac{2\\pi}{3}\\\\A &= \\frac{1}{2}r^{2}\\theta\\\\A &= \\frac{1}{2}\\times6^{2}\\times\\frac{2\\pi}{3}\\\\A &= 12\\pi\\text{ cm}^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
