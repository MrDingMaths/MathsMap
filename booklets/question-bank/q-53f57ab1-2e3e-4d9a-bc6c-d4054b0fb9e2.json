        "type": "part",
        "label": "a",
        "prompt": "If 100% of a school’s population is 840, what is 75% of the population?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "630",
          "worked": "25% of the population is $840\\div4=210$.\n\n75% of the population is $3\\times210=630$.",
