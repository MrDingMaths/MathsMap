        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8 more stamps",
          "worked": "A further $25\\%-20\\%=5\\%$ of the total is needed.\n\n5% of the total is $32\\div4=8$ stamps, so 8 more stamps must be bought.",
