    "children": [
      {
        "id": "p25-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "A function $f(x)$ has derivative $f'(x)=e^{2x}$.\n\nFind the equation of $f(x)$, which will involve an arbitrary constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\frac12e^{2x}+C$",
          "worked": "$$\\begin{align*}f(x)&=\\int e^{2x}\\,dx\\\\&=\\frac12e^{2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p25-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "It is also known that $f(0)=-2$.\n\nFind the arbitrary constant and hence write down the equation of $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=-\\frac52$, so $f(x)=\\frac12e^{2x}-\\frac52$.",
          "worked": "$$\\begin{align*}-2&=\\frac12e^{2(0)}+C\\\\-2&=\\frac12+C\\\\C&=-\\frac52\\\\f(x)&=\\frac12e^{2x}-\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
