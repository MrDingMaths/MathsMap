      {
        "id": "p40-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate $P(\\text{not black})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8$",
          "worked": "$$\\begin{align*}P(\\text{not black})&=1-P(\\text{Black})\\\\P(\\text{not black})&=1-0.2\\\\P(\\text{not black})&=0.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate $P(\\text{white})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}P(\\text{white})&=1-\\bigl(P(\\text{Black})+P(\\text{Yellow})\\bigr)\\\\P(\\text{white})&=1-(0.2+0.4)\\\\P(\\text{white})&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why $P(\\text{not black nor yellow})$ is the same as $P(\\text{white})$ with reference to complementary events.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "White is the complement of black or yellow. Since these are the only three colours, neither black nor yellow means white.",
          "worked": "White and black or yellow are complementary events: exactly one must occur. Since these are the only three colours, an outcome that is neither black nor yellow must be white. Hence $P(\\text{not black nor yellow})=P(\\text{white})$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
