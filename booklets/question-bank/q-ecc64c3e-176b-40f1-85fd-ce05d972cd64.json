  "content": {
    "id": "p14-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Find the common difference of each AP. Then find $x$ if $a_{11}=36$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x-9,\\ 5x-5,\\ 5x-1,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=4$, $x=1$.",
          "worked": "$$\\begin{align*}d&=(5x-5)-(5x-9)\\\\d&=4\\end{align*}$$\n$$\\begin{align*}a_{11}&=36\\\\a+(11-1)d&=36\\\\(5x-9)+10(4)&=36\\\\5x-9+40&=36\\\\5x+31&=36\\\\5x&=5\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$16,\\ 16+6x,\\ 16+12x,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=6x$, $x=\\frac13$.",
          "worked": "$$\\begin{align*}d&=(16+6x)-16\\\\d&=6x\\end{align*}$$\n$$\\begin{align*}a_{11}&=36\\\\a+(11-1)d&=36\\\\16+10(6x)&=36\\\\16+60x&=36\\\\60x&=20\\\\x&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
