        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=1$, $B=1$, $C=-1$.",
          "worked": "Expand:\n$$\\begin{align*}(Ax+B)(x+2)+C&=Ax^2+(2A+B)x+2B+C.\\end{align*}$$\nEquate the coefficients of $x^2$, $x$ and the constant term, using each value in turn:\n$$\\begin{align*}A&=1\\\\2(1)+B&=3\\\\B&=1\\\\2(1)+C&=1\\\\C&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p61-q53-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p61-q53-b-instruction",
