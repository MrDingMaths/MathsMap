  "content": {
    "id": "p35-q5",
    "type": "question",
    "label": "5",
    "prompt": "A naval ship is at coordinates $P$ and equipped with a radar scanner that can detect objects inside the circle $x^2+y^2-80x-40y=500$, where radius is measured in kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=(40,20)$.",
          "worked": "$$\\begin{align*}x^2-80x+y^2-40y&=500\\\\(x^2-80x+1600)-1600+(y^2-40y+400)-400&=500\\\\(x-40)^2+(y-20)^2-2000&=500\\\\(x-40)^2+(y-20)^2&=2500\\end{align*}$$\n$P$ is the centre of the circle, so $P=(40,20)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p35-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Another ship is at $Q(60,-20)$ and can detect objects within a radius of 40 km.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Will ship $Q$ be able to detect $P$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "No; $PQ=20\\sqrt5\\text{ km}\\approx44.7\\text{ km}$, greater than 40 km.",
              "worked": "$$\\begin{align*}PQ&=\\sqrt{(60-40)^2+(-20-20)^2}\\\\&=\\sqrt{2000}\\\\&=20\\sqrt5\\text{ km}\\approx44.7\\text{ km}\\end{align*}$$\nNo. The distance is greater than $Q$'s radar range of 40 km.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p35-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Will ship $P$ be able to detect $Q$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes; $PQ<50\\text{ km}$, the range of $P$'s radar.",
              "worked": "From part a, $P$'s radar radius is\n$$\\begin{align*}r&=\\sqrt{2500}\\\\&=50\\text{ km}.\\end{align*}$$\nYes. Since $PQ=20\\sqrt5\\text{ km}\\approx44.7\\text{ km}<50\\text{ km}$, $Q$ is within $P$'s radar range.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      }
    ]
  },
