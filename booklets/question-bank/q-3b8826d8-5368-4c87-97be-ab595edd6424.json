            "label": "a",
            "prompt": "$18:30$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3:5$",
              "worked": "$$\\begin{align*}18:30&=(18\\div6):(30\\div6)\\\\18:30&=3:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p21-q3-col1-e",
            "type": "part",
            "label": "b",
            "prompt": "$30:18$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$5:3$",
              "worked": "$$\\begin{align*}30:18&=(30\\div6):(18\\div6)\\\\30:18&=5:3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p21-q3-col1-f",
            "type": "part",
            "label": "c",
            "prompt": "$18:30:42$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3:5:7$",
              "worked": "Divide every part by the highest common factor, $6$.\n$$18:30:42=3:5:7$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p21-q3-col1-g",
            "type": "part",
            "label": "d",
            "prompt": "$1.8:3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3:5$",
              "worked": "Multiply both parts by $10$, then divide by $6$.\n$$\\begin{align*}1.8:3&=18:30\\\\1.8:3&=3:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      },
      {
        "id": "p21-q3-column-2",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q3-col2-e",
            "type": "part",
            "label": "e",
            "prompt": "$0.18:0.3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3:5$",
              "worked": "Multiply both parts by $100$, then divide by $6$.\n$$\\begin{align*}0.18:0.3&=18:30\\\\0.18:0.3&=3:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p21-q3-col2-f",
            "type": "part",
            "label": "f",
            "prompt": "$18\\text{ cm}:0.3\\text{ m}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3:5$",
              "worked": "$0.3\\text{ m}=30\\text{ cm}$. Divide both quantities by $6\\text{ cm}$.\n$$\\begin{align*}18\\text{ cm}:0.3\\text{ m}&=18:30\\\\18\\text{ cm}:0.3\\text{ m}&=3:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p21-q3-col2-g",
            "type": "part",
            "label": "g",
            "prompt": "$\\$1.80:300\\text{ c}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3:5$",
              "worked": "$\\$1.80=180\\text{ c}$. Divide both quantities by $60\\text{ c}$.\n$$\\begin{align*}\\$1.80:300\\text{ c}&=180:300\\\\\\$1.80:300\\text{ c}&=3:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p21-q3-col2-h",
            "type": "part",
            "label": "h",
            "prompt": "$\\frac{3}{4}:\\frac{5}{8}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6:5$",
              "worked": "Use denominator $8$, then multiply both parts by $8$.\n$$\\begin{align*}\\frac34:\\frac58&=\\frac68:\\frac58\\\\\\frac34:\\frac58&=6:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      },
      {
        "id": "p21-q3-column-3",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q3-col3-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\frac{2}{3}:\\frac{5}{9}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6:5$",
              "worked": "Use denominator $9$, then multiply both parts by $9$.\n$$\\begin{align*}\\frac23:\\frac59&=\\frac69:\\frac59\\\\\\frac23:\\frac59&=6:5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p21-q3-col3-j",
            "type": "part",
            "label": "j",
            "prompt": "$\\frac{1}{2}:0.75$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2:3$",
              "worked": "$0.75=\\frac34$. Use denominator $4$, then multiply both parts by $4$.\n$$\\begin{align*}\\frac12:0.75&=\\frac12:\\frac34\\\\\\frac12:0.75&=\\frac24:\\frac34\\\\\\frac12:0.75&=2:3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p21-q3-col3-k",
            "type": "part",
            "label": "k",
            "prompt": "$1.2\\text{ kg}:450\\text{ g}:0.3\\text{ kg}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8:3:2$",
              "worked": "$1.2\\text{ kg}=1200\\text{ g}$ and $0.3\\text{ kg}=300\\text{ g}$. In grams, the ratio is $1200:450:300$. Divide every part by $150$.\n$$1200:450:300=8:3:2$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p21-q3-col3-l",
            "type": "part",
            "label": "l",
            "prompt": "$1.5\\text{ h}:45\\text{ min}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2:1$",
              "worked": "$1.5\\text{ h}=90\\text{ min}$. Divide both quantities by $45\\text{ min}$.\n$$\\begin{align*}1.5\\text{ h}:45\\text{ min}&=90:45\\\\1.5\\text{ h}:45\\text{ min}&=2:1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      }
