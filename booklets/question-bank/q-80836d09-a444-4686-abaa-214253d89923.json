  "content": {
    "id": "p34-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A deck has 10 blue cards, 10 red cards, 10 green cards, and 10 yellow cards. Eight cards are dealt. Find the probability that",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "all eight cards are red.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\binom{10}{8}}{\\binom{40}{8}}$",
          "worked": "All eight cards must come from the ten red cards. There are $\\binom{40}{8}$ equally likely hands.\n$$P(\\text{all red})=\\frac{\\binom{10}{8}}{\\binom{40}{8}}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p34-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "no red cards are chosen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\binom{30}{8}}{\\binom{40}{8}}$",
          "worked": "Choose all eight cards from the thirty non-red cards.\n$$P(\\text{no red})=\\frac{\\binom{30}{8}}{\\binom{40}{8}}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p34-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "two blue, two red, two green, and two yellow cards are chosen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\binom{10}{2}^{4}}{\\binom{40}{8}}$",
          "worked": "Choose two of the ten cards of each colour and multiply the four counts.\n$$P(\\text{two of each colour})=\\frac{\\binom{10}{2}^{4}}{\\binom{40}{8}}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "one blue, one yellow and six red cards are chosen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\binom{10}{1}^{2}\\binom{10}{6}}{\\binom{40}{8}}$",
          "worked": "Choose one blue card, one yellow card and six red cards, multiplying the counts.\n$$P(\\text{one blue, one yellow, six red})=\\frac{\\binom{10}{1}^{2}\\binom{10}{6}}{\\binom{40}{8}}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "four cards are of one colour, and the other four cards are of another colour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p34-q14-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{\\binom{4}{2}\\binom{10}{4}^{2}}{\\binom{40}{8}}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p34-q14-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Choose two colours, then four cards of each.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Choose an unordered pair of colours in $\\binom{4}{2}$ ways. For each pair, choose four cards of each colour.\n$$P(\\text{four of each of two colours})=\\frac{\\binom{4}{2}\\binom{10}{4}^{2}}{\\binom{40}{8}}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
