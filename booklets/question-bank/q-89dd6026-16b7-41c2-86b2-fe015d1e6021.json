  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider the function $g(x)=x^3-3x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q4-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $g(-x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(-x)=-x^3+3x$.",
          "worked": "$$\\begin{align*}g(-x)&=(-x)^3-3(-x)\\\\g(-x)&=-x^3+3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q4-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that $g(x)$ is an odd function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(-x)=-g(x)$, so $g$ is odd.",
          "worked": "$$\\begin{align*}-g(x)&=-(x^3-3x)\\\\-g(x)&=-x^3+3x\\\\-g(x)&=g(-x)\\end{align*}$$\nTherefore $g$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
