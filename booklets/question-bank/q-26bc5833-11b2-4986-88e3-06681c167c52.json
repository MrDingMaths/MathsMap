  "content": {
    "id": "p47-ep-17-node",
    "type": "question",
    "label": "17",
    "prompt": "Find the coordinates of the point(s) on $y=(x^2-1)^3$ where the tangent(s) are horizontal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p47-ep-17-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
