    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-aec71e22e-practice-j7-121852-j7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(-2.5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.5$",
          "worked": "Since $-2.5<-2$,\n$$\\begin{aligned}f(-2.5)&=2-(-2.5)\\\\&=4.5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
