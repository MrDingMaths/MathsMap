      {
        "id": "p14-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Convert 10 gallons to litres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "45 L",
          "worked": "Reading the graph at 10 gallons gives 45 litres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p14-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Convert 30 litres to gallons.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 6.6 gallons.",
          "worked": "Read across from 30 litres to the line, then down to the gallons axis: approximately 6.6 gallons.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p14-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Why might your answer to part b be inaccurate?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The graph reading is approximate.",
          "worked": "The intersection lies between grid lines, so the number of gallons must be estimated from the graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the value of $k$ by using the point $(10,45)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4.5$",
          "worked": "$$\\begin{align*}k&=\\frac{45}{10}\\\\k&=4.5\\end{align*}$$\nThe conversion factor is 4.5 litres per gallon.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "Hence use your equation to find the exact number of gallons for 30 litres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.\\dot{6}$ gallons.",
          "worked": "$$\\begin{align*}L&=4.5G\\\\30&=4.5G\\\\G&=\\frac{30}{4.5}\\\\G&=\\frac{20}{3}=6.\\dot{6}\\end{align*}$$\nThe exact number is $6.\\dot{6}$ gallons.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ],
