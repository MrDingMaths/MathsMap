  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "How many three-digit numbers can be formed using the digits $\\{1,2,3,4,5\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125$",
          "worked": "Each digit position has five choices; repetition is allowed.\n\n$$\\begin{align*}N&=5^3\\\\N&=125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q6b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "The successive digit positions have five, four and three choices.\n\n$$\\begin{align*}N&=5\\times4\\times3\\\\N&=60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
