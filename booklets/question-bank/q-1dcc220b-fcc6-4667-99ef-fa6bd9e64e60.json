  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If $h=t^3-7t+5$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "the average rate of change of $h$ between $t=3$ and $t=4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{align*}h(3)&=3^3-7(3)+5=11\\\\h(4)&=4^3-7(4)+5=41\\\\\\text{Average rate}&=\\frac{h(4)-h(3)}{4-3}\\\\&=\\frac{41-11}{1}=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "the instantaneous rate of change of $h$ when $t=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$$\\begin{align*}h'(t)&=3t^2-7\\\\h'(3)&=3(3)^2-7\\\\&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
