    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "About $50\\,000$ years.",
      "worked": "$$\\begin{align*}5\\text{ km} &= 5\\times1000\\times100\\text{ cm}\\\\&=500\\,000\\text{ cm}\\\\\\text{Time} &=\\frac{500\\,000\\text{ cm}}{10\\text{ cm/year}}\\\\&=50\\,000\\text{ years}\\end{align*}$$\nIt will take about $50\\,000$ years.",
