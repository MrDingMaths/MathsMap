  "content": {
    "id": "p7-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "$V=\\frac{4}{3}\\pi r^3$ is the volume of a sphere of radius $r$. Express $\\log_2 V$ in terms of $\\log_2 r$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\log_2 V=\\log_2\\left(\\frac{4\\pi}{3}\\right)+3\\log_2 r$",
      "worked": "$$\\begin{align*}\\log_2 V&=\\log_2\\left(\\frac{4\\pi}{3}r^3\\right)\\\\\\log_2 V&=\\log_2\\left(\\frac{4\\pi}{3}\\right)+\\log_2(r^3)\\\\\\log_2 V&=\\log_2\\left(\\frac{4\\pi}{3}\\right)+3\\log_2 r\\end{align*}$$",
      "solutionDiagrams": []
    },
