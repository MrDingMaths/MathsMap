  "content": {
    "id": "p10-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^4\\sqrt{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16}{3}$",
          "worked": "$$\\begin{align*}\\int_0^4\\sqrt{x}\\,dx&=\\int_0^4x^{1/2}\\,dx\\\\&=\\left[\\frac{2}{3}x^{3/2}\\right]_0^4\\\\&=\\frac{2}{3}(8-0)\\\\&=\\frac{16}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_1^9x\\sqrt{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{484}{5}$",
          "worked": "$$\\begin{align*}\\int_1^9x\\sqrt{x}\\,dx&=\\int_1^9x^{3/2}\\,dx\\\\&=\\left[\\frac{2}{5}x^{5/2}\\right]_1^9\\\\&=\\frac{2}{5}(243-1)\\\\&=\\frac{484}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_1^9\\frac{1}{\\sqrt{x}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\int_1^9\\frac{1}{\\sqrt{x}}\\,dx&=\\int_1^9x^{-1/2}\\,dx\\\\&=\\left[2\\sqrt{x}\\right]_1^9\\\\&=2(3-1)\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_2^4(2-\\sqrt{x})(2+\\sqrt{x})\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\int_2^4(2-\\sqrt{x})(2+\\sqrt{x})\\,dx&=\\int_2^4(4-x)\\,dx\\\\&=\\left[4x-\\frac{x^2}{2}\\right]_2^4\\\\&=(16-8)-(8-2)\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p10-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_0^1\\sqrt{x}(\\sqrt{x}-4)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{13}{6}$",
          "worked": "$$\\begin{align*}\\int_0^1\\sqrt{x}(\\sqrt{x}-4)\\,dx&=\\int_0^1(x-4x^{1/2})\\,dx\\\\&=\\left[\\frac{x^2}{2}-\\frac{8}{3}x^{3/2}\\right]_0^1\\\\&=\\frac{1}{2}-\\frac{8}{3}\\\\&=-\\frac{13}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p10-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_4^9(\\sqrt{x}-1)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{73}{6}$",
          "worked": "$$\\begin{align*}\\int_4^9(\\sqrt{x}-1)^2\\,dx&=\\int_4^9(x-2x^{1/2}+1)\\,dx\\\\&=\\left[\\frac{x^2}{2}-\\frac{4}{3}x^{3/2}+x\\right]_4^9\\\\&=\\left(\\frac{81}{2}-36+9\\right)\\\\&\\quad-\\left(8-\\frac{32}{3}+4\\right)\\\\&=\\frac{27}{2}-\\frac{4}{3}\\\\&=\\frac{73}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
