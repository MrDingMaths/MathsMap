  "content": {
    "id": "p54-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find the percentage change, round to 1 d.p.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "35 changed to 60.\nWhat is the percentage change?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$71.4\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Change} &= 60-35\\\\\\text{Change} &= 25\\\\\\%\\text{ change} &= \\frac{25}{35}\\times100\\\\\\%\\text{ change} &\\approx 71.4\\%\\end{align*}$$\nThe positive change represents a $71.4\\%$ increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p54-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "60 changed to 35.\nWhat is the percentage change?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$41.7\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Change} &= 35-60\\\\\\text{Change} &= -25\\\\\\%\\text{ change} &= \\frac{-25}{60}\\times100\\\\\\%\\text{ change} &\\approx -41.7\\%\\end{align*}$$\nThe negative change represents a $41.7\\%$ decrease.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p54-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "60 increased by 35.\nWhat is the percentage change?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$58.3\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Final} &= 60+35\\\\\\text{Final} &= 95\\\\\\text{Change} &= 95-60\\\\\\text{Change} &= 35\\\\\\%\\text{ change} &= \\frac{35}{60}\\times100\\\\\\%\\text{ change} &\\approx 58.3\\%\\end{align*}$$\nThe positive change represents a $58.3\\%$ increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p54-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "35 increased by 60.\nWhat is the percentage change?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$171.4\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Final} &= 35+60\\\\\\text{Final} &= 95\\\\\\text{Change} &= 95-35\\\\\\text{Change} &= 60\\\\\\%\\text{ change} &= \\frac{60}{35}\\times100\\\\\\%\\text{ change} &\\approx 171.4\\%\\end{align*}$$\nThe positive change represents a $171.4\\%$ increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
