  "content": {
    "id": "p2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Show that $\\triangle ABC$ is isosceles, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(1,1)$, $B(3,5)$ and $C(5,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=AC=2\\sqrt5$, so $\\triangle ABC$ is isosceles.",
          "worked": "$$\\begin{align*}AB&=\\sqrt{(3-1)^2+(5-1)^2}\\\\AB&=2\\sqrt5\\\\AC&=\\sqrt{(5-1)^2+(3-1)^2}\\\\AC&=2\\sqrt5\\end{align*}$$\nSince $AB=AC$, $\\triangle ABC$ is isosceles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p2-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(-1,1)$, $B(0,4)$ and $C(3,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=BC=\\sqrt{10}$, so $\\triangle ABC$ is isosceles.",
          "worked": "$$\\begin{align*}AB&=\\sqrt{(0-(-1))^2+(4-1)^2}\\\\AB&=\\sqrt{10}\\\\BC&=\\sqrt{(3-0)^2+(3-4)^2}\\\\BC&=\\sqrt{10}\\end{align*}$$\nSince $AB=BC$, $\\triangle ABC$ is isosceles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p2-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(-2,-3)$, $B(3,5)$ and $C(6,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=AC=\\sqrt{89}$, so $\\triangle ABC$ is isosceles.",
          "worked": "$$\\begin{align*}AB&=\\sqrt{(3-(-2))^2+(5-(-3))^2}\\\\AB&=\\sqrt{89}\\\\AC&=\\sqrt{(6-(-2))^2+(2-(-3))^2}\\\\AC&=\\sqrt{89}\\end{align*}$$\nSince $AB=AC$, $\\triangle ABC$ is isosceles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
