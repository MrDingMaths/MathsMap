  "content": {
    "id": "p43-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Two functions $f$ and $h$ are defined by $f(x)=-x$ and $h(x)=\\frac{1}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $f(h(-\\frac14))$, $h(f(-\\frac14))$, $f(f(-\\frac14))$ and $h(h(-\\frac14))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4,\\ 4,\\ -\\frac14,\\ -\\frac14$, respectively.",
          "worked": "$$\\begin{align*}f(h(-\\tfrac14))&=f(-4)=4\\\\h(f(-\\tfrac14))&=h(\\tfrac14)=4\\\\f(f(-\\tfrac14))&=f(\\tfrac14)=-\\tfrac14\\\\h(h(-\\tfrac14))&=h(-4)=-\\tfrac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p43-q9-b",
        "type": "group",
        "label": "b",
        "prompt": "Show that for all $x\\ne0$:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p43-q9-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(h(x))=h(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Both sides equal $-\\frac1x$ for $x\\ne0$.",
              "worked": "$$\\begin{align*}f(h(x))&=f(\\tfrac1x)=-\\tfrac1x\\\\h(f(x))&=h(-x)=-\\tfrac1x\\end{align*}$$Thus $f(h(x))=h(f(x))$ for $x\\ne0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p43-q9-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$f(f(x))=h(h(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Both sides equal $x$ for $x\\ne0$.",
              "worked": "$$\\begin{align*}f(f(x))&=f(-x)=-(-x)=x\\\\h(h(x))&=h(\\tfrac1x)=\\frac{1}{1/x}=x\\end{align*}$$Thus $f(f(x))=h(h(x))$ for $x\\ne0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      },
      {
        "id": "p43-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Write down the domain and range of $f(h(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $\\mathbb R\\setminus\\{0\\}$. Range: $\\mathbb R\\setminus\\{0\\}$.",
          "worked": "$f(h(x))=-\\frac1x$. The denominator requires $x\\ne0$, and the output is never zero. Every nonzero real output $y$ is obtained when $x=-\\frac1y$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p43-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Describe how the graph of $h(x)$ is transformed to obtain the graph of $h(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Reflect in the $y$-axis (equivalently, in the $x$-axis).",
          "worked": "$h(f(x))=h(-x)$, so reflect the graph of $h$ in the $y$-axis. Since $h(-x)=-h(x)$, reflection in the $x$-axis gives the same graph.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
