  "content": {
    "id": "p20-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A crop of 2181 bananas is packed into a number of cases. There are 27 cases, each holding the same number of bananas. There are also 21 loose bananas. How many bananas are there in each case?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "80 bananas in each case.",
      "worked": "Let $x$ be the number of bananas in each case.\n\n$$\\begin{align*}27x+21&=2181\\\\27x&=2160\\\\x&=80\\end{align*}$$\n\nThere are 80 bananas in each case.\n\nCheck: $27\\times80+21=2160+21=2181$ bananas.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
