  "content": {
    "id": "p17-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "10% of an amount of money is \\$60, how much is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "100% of that amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$600$",
          "worked": "$$\\begin{align*}100\\% &= \\$60\\times10\\\\100\\% &= \\$600\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "150% of that amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$900$",
          "worked": "$$\\begin{align*}150\\% &= \\$60\\times15\\\\150\\% &= \\$900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "15% of that amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$90$",
          "worked": "$$\\begin{align*}5\\% &= \\$60\\div2\\\\5\\% &= \\$30\\\\15\\% &= \\$30\\times3=\\$90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
