  "content": {
    "id": "p17-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use the remainder theorem to find the remainder when each polynomial $P(x)$ is divided by $D(x)=x+1$. Then state whether or not $x+1$ is a factor of $P(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=5x^2-7x-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $0$; $x+1$ is a factor.",
          "worked": "The remainder is $P(-1)$.\n$$\\begin{align*}P(-1)&=5(-1)^2-7(-1)-12\\\\P(-1)&=5+7-12\\\\P(-1)&=0\\end{align*}$$\nSince $P(-1)=0$, $x+1$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=5x^2+7x-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $-14$; $x+1$ is not a factor.",
          "worked": "The remainder is $P(-1)$.\n$$\\begin{align*}P(-1)&=5(-1)^2+7(-1)-12\\\\P(-1)&=5-7-12\\\\P(-1)&=-14\\end{align*}$$\nSince $P(-1)\\ne0$, $x+1$ is not a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=x^6-4x^4+6x^2-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $1$; $x+1$ is not a factor.",
          "worked": "The remainder is $P(-1)$.\n$$\\begin{align*}P(-1)&=(-1)^6-4(-1)^4+6(-1)^2-2\\\\P(-1)&=1-4+6-2\\\\P(-1)&=1\\end{align*}$$\nSince $P(-1)\\ne0$, $x+1$ is not a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=7x^5-3x^3-2x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $-4$; $x+1$ is not a factor.",
          "worked": "The remainder is $P(-1)$.\n$$\\begin{align*}P(-1)&=7(-1)^5-3(-1)^3-2(-1)-2\\\\P(-1)&=-7+3+2-2\\\\P(-1)&=-4\\end{align*}$$\nSince $P(-1)\\ne0$, $x+1$ is not a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(x)=4x^5+5x^4-3x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $6$; $x+1$ is not a factor.",
          "worked": "The remainder is $P(-1)$.\n$$\\begin{align*}P(-1)&=4(-1)^5+5(-1)^4-3(-1)+2\\\\P(-1)&=-4+5+3+2\\\\P(-1)&=6\\end{align*}$$\nSince $P(-1)\\ne0$, $x+1$ is not a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(x)=x^{100}-x^{99}+x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Remainder $0$; $x+1$ is a factor.",
          "worked": "The remainder is $P(-1)$. An even power of $-1$ is $1$, and an odd power is $-1$.\n$$\\begin{align*}P(-1)&=(-1)^{100}-(-1)^{99}+(-1)-1\\\\P(-1)&=1-(-1)-1-1\\\\P(-1)&=0\\end{align*}$$\nSince $P(-1)=0$, $x+1$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
