  "content": {
    "id": "p22-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$BE$ and $CF$ are altitudes of a triangle $ABC$. Prove that $\\dfrac{BE}{CF}=\\dfrac{AB}{AC}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{BE}{CF}=\\dfrac{AB}{AC}$.",
      "worked": "Since BE and CF are altitudes, $\\angle BEA=\\angle CFA=90^\\circ$. The angle at A is common because E lies on AC and F lies on AB, so $\\angle BAE=\\angle CAF$. Hence $\\triangle BEA\\sim\\triangle CFA$ by AAA. Their corresponding hypotenuses are BA and CA, and their corresponding opposite sides are BE and CF; therefore $\\frac{BE}{CF}=\\frac{BA}{CA}=\\frac{AB}{AC}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
