  "content": {
    "id": "p6-p3-root",
    "type": "question",
    "label": null,
    "prompt": "Find $\\displaystyle\\lim_{x\\to2}\\frac{\\frac1x-\\frac12}{x-2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac14$\n\nUse a common denominator in the numerator, then cancel the factor $x-2$.",
      "worked": "$$\\begin{align*}\\lim_{x\\to2}\\frac{\\frac1x-\\frac12}{x-2}&=\\lim_{x\\to2}\\frac{2-x}{2x(x-2)}\\\\\\lim_{x\\to2}\\frac{\\frac1x-\\frac12}{x-2}&=\\lim_{x\\to2}\\frac{-(x-2)}{2x(x-2)}\\\\\\lim_{x\\to2}\\frac{\\frac1x-\\frac12}{x-2}&=\\lim_{x\\to2}\\left(-\\frac{1}{2x}\\right)\\\\\\lim_{x\\to2}\\frac{\\frac1x-\\frac12}{x-2}&=-\\frac{1}{2(2)}\\\\\\lim_{x\\to2}\\frac{\\frac1x-\\frac12}{x-2}&=-\\frac14\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
