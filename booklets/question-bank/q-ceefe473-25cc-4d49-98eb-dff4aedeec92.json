        "type": "part",
        "label": "b",
        "prompt": "a red card?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Hearts and Diamonds give $2\\times13=26$ red cards.\n$$\\begin{align*}P(\\text{red})&=\\frac{26}{52}\\\\P(\\text{red})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p6-q8-c",
