        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{13}$",
          "worked": "There are 4 Aces in 52 cards.\n$$\\begin{align*}P(\\text{Ace})&=\\frac{4}{52}\\\\P(\\text{Ace})&=\\frac{1}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
