    "type": "question",
    "label": "4",
    "prompt": "A cattle station has an area of $260\\text{ km}^2$. What is its area in hectares?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$26000\\text{ ha}$",
      "worked": "One square kilometre is 100 hectares.\n$$\\begin{aligned}260\\text{ km}^2&=260\\times100\\text{ ha}\\\\&=26000\\text{ ha}.\\end{aligned}$$",
