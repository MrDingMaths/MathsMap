    "id": "p25-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Solve each quadratic equation, using any method.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-11x+28=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=7$",
          "worked": "$$\\begin{align*}(x-4)(x-7)&=0\\\\x-4&=0\\quad\\text{or}\\quad x-7=0\\\\x&=4\\quad\\text{or}\\quad x=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-12x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6-2\\sqrt{10}$ or $x=6+2\\sqrt{10}$",
          "worked": "$$\\begin{align*}x^2-12x&=4\\\\x^2-12x+36&=4+36\\\\(x-6)^2&=40\\\\x-6&=\\pm\\sqrt{40}\\\\x&=6\\pm2\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p25-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2+2x-6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-1-\\sqrt{19}}{3}$ or $x=\\dfrac{-1+\\sqrt{19}}{3}$",
          "worked": "Here $a=3$, $b=2$ and $c=-6$.\n$$\\begin{align*}b^2-4ac&=2^2-4(3)(-6)\\\\b^2-4ac&=76\\end{align*}$$\nUsing the quadratic formula,\n$$\\begin{align*}x&=\\frac{-2\\pm\\sqrt{76}}{2(3)}\\\\x&=\\frac{-2\\pm2\\sqrt{19}}{6}\\\\x&=\\frac{-1\\pm\\sqrt{19}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
  },
