      {
        "id": "p19-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "How many times as large would the area of a square be if its side lengths were tripled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 times as large.",
          "worked": "$$\\begin{align*}A_{\\text{new}}&=(3x)^2\\text{ cm}^2\\\\A_{\\text{new}}&=9x^2\\text{ cm}^2.\\end{align*}$$\nThe area is $9$ times the original area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "If you want a square to be 16 times as large, how would you need to change the side lengths?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Make each side 4 times as long.",
          "worked": "Since $4^2=16$, multiply each side length by $4$:\n$$A_{\\text{new}}=(4x)^2=16x^2\\text{ cm}^2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
