        "type": "part",
        "label": "b",
        "prompt": "$y=\\log_{10}(x^2+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real numbers.",
          "worked": "For every real $x$, $x^2\\ge 0$, so $x^2+1\\ge 1$. The logarithm is defined for all real $x$.",
