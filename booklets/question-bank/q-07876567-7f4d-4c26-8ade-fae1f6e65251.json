  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the area enclosed between the curve $y=x^2$, the $y$-axis and the horizontal lines through the points on the curve where $x=1$ and $x=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{52}{3}\\text{ units}^2$",
      "worked": "$$\\begin{aligned}x&=y^{1/2}\\\\y(1)&=1^2=1\\\\y(3)&=3^2=9\\\\A&=\\int_1^9 y^{1/2}\\,dy\\\\A&=\\left[\\frac23y^{3/2}\\right]_1^9\\\\A&=\\frac23(27-1)\\\\A&=\\frac{52}{3}\\text{ units}^2\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
