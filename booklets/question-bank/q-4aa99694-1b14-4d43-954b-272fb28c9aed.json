  "content": {
    "id": "p16-q6",
    "type": "question",
    "label": "6",
    "prompt": "Kim was absent from school on 8 days in Term one. There were 44 school days in term one. Write the following ratios in simplest form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6-ratio-row",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q6-a",
            "type": "part",
            "label": "a",
            "prompt": "days absent to total days",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2:11$",
              "worked": "The HCF of 8 and 44 is 4.\n$$\\begin{aligned}8:44&=(8\\div4):(44\\div4)\\\\8:44&=2:11\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p16-q6-b",
            "type": "part",
            "label": "b",
            "prompt": "days present to total",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9:11$",
              "worked": "$$\\begin{aligned}\\text{Days present}&=44-8\\\\\\text{Days present}&=36\\end{aligned}$$\nThe HCF of 36 and 44 is 4.\n$$\\begin{aligned}36:44&=(36\\div4):(44\\div4)\\\\36:44&=9:11\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p16-q6-c",
            "type": "part",
            "label": "c",
            "prompt": "absent days to present",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2:9$",
              "worked": "$$\\begin{aligned}\\text{Days present}&=44-8\\\\\\text{Days present}&=36\\end{aligned}$$\nThe HCF of 8 and 36 is 4.\n$$\\begin{aligned}8:36&=(8\\div4):(36\\div4)\\\\8:36&=2:9\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p16-q6-d-sentence",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "complete the sentence: for every 9 days she is present, Kim is absent ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "2",
                  "width": 12
                },
                {
                  "type": "text",
                  "text": " days.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 days",
          "worked": "Absent days : present days $=2:9$, so Kim is absent for 2 days for every 9 days she is present.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
