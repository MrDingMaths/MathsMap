  "content": {
    "id": "p7-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "A card is drawn at random from a pack of playing cards. What is the probability that it is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "an Ace?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{13}$",
          "worked": "There are 4 Aces in the 52-card pack.\n$$\\begin{align*}P(\\text{Ace})&=\\frac{4}{52}\\\\P(\\text{Ace})&=\\frac{1}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "a Spade?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are 13 Spades in the 52-card pack.\n$$\\begin{align*}P(\\text{Spade})&=\\frac{13}{52}\\\\P(\\text{Spade})&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "not a Club?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}$",
          "worked": "There are 13 Clubs in the 52-card pack.\n$$\\begin{align*}P(\\text{not a Club})&=1-P(\\text{Club})\\\\P(\\text{not a Club})&=1-\\frac{13}{52}\\\\P(\\text{not a Club})&=\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p7-q24-d",
        "type": "part",
        "label": "d",
        "prompt": "not a 7 or an 8?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{13}$",
          "worked": "There are four 7s and four 8s, so 8 cards are a 7 or an 8.\n$$\\begin{align*}P(\\text{neither 7 nor 8})&=1-\\frac{8}{52}\\\\P(\\text{neither 7 nor 8})&=\\frac{44}{52}\\\\P(\\text{neither 7 nor 8})&=\\frac{11}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
