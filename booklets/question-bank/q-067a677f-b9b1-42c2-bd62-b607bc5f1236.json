  "content": {
    "id": "p27-q3",
    "type": "question",
    "label": "3",
    "prompt": "Calculate the cost price, rounding to the nearest cent where relevant.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the original price of a pack of batteries that is discounted by 30%, if the discounted price is \\$14.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$20",
          "worked": "$$\\begin{align*}70\\%&=\\text{\\$14}\\\\1\\%&=\\text{\\$}\\frac{14}{70}\\\\100\\%&=\\text{\\$}\\frac{14}{70}\\times100=\\text{\\$20}\\end{align*}$$\nThe original price was \\$20.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p27-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the original price of a herbal tea pack after a discount of 20%, if the discounted price is \\$2.40.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3",
          "worked": "$$\\begin{align*}80\\%&=\\text{\\$2.40}\\\\1\\%&=\\text{\\$}\\frac{2.40}{80}\\\\100\\%&=\\text{\\$}\\frac{2.40}{80}\\times100=\\text{\\$3}\\end{align*}$$\nThe original price was \\$3.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p27-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the cost price of a shampoo bottle that is marked up by 40%, if the retail price is \\$5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3.57",
          "worked": "$$\\begin{align*}140\\%&=\\text{\\$5}\\\\1\\%&=\\text{\\$}\\frac{5}{140}\\\\100\\%&=\\text{\\$}\\frac{5}{140}\\times100\\\\100\\%&\\approx\\text{\\$3.57}\\end{align*}$$\nThe cost price was \\$3.57, to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p27-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the cost price of a bag of dog food that is marked up by 30%, if the retail price is \\$19.23.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$14.79",
          "worked": "$$\\begin{align*}130\\%&=\\text{\\$19.23}\\\\1\\%&=\\text{\\$}\\frac{19.23}{130}\\\\100\\%&=\\text{\\$}\\frac{19.23}{130}\\times100\\\\100\\%&\\approx\\text{\\$14.79}\\end{align*}$$\nThe cost price was \\$14.79, to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p27-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the original price of a pair of jeans that is discounted by 20%, if the discounted price is \\$31.96.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$39.95",
          "worked": "$$\\begin{align*}80\\%&=\\text{\\$31.96}\\\\1\\%&=\\text{\\$}\\frac{31.96}{80}\\\\100\\%&=\\text{\\$}\\frac{31.96}{80}\\times100=\\text{\\$39.95}\\end{align*}$$\nThe original price was \\$39.95.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p27-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the cost price of a roll of tape that is marked up by 60%, if the retail price is \\$2.80.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1.75",
          "worked": "$$\\begin{align*}160\\%&=\\text{\\$2.80}\\\\1\\%&=\\text{\\$}\\frac{2.80}{160}\\\\100\\%&=\\text{\\$}\\frac{2.80}{160}\\times100=\\text{\\$1.75}\\end{align*}$$\nThe cost price was \\$1.75.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
