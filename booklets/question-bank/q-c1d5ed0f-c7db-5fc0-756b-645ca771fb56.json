    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q52-root",
        "type": "part",
        "label": "a",
        "prompt": "$$x^2+2xy-15y^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5y)(x-3y)$",
          "worked": "The cross terms are $5xy-3xy=2xy$, and $(5y)(-3y)=-15y^2$.\n$$x^2+2xy-15y^2=(x+5y)(x-3y).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q53-root",
        "type": "part",
        "label": "b",
        "prompt": "$$x^2-5xy-6y^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-6y)(x+y)$",
          "worked": "The cross terms are $-6xy+xy=-5xy$, and $(-6y)y=-6y^2$.\n$$x^2-5xy-6y^2=(x-6y)(x+y).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q54-root",
        "type": "part",
        "label": "c",
        "prompt": "$$x^2-xy-12y^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-4y)(x+3y)$",
          "worked": "The cross terms are $-4xy+3xy=-xy$, and $(-4y)(3y)=-12y^2$.\n$$x^2-xy-12y^2=(x-4y)(x+3y).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q55-root",
        "type": "part",
        "label": "d",
        "prompt": "$$x^2+7xy+10y^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5y)(x+2y)$",
          "worked": "The cross terms are $5xy+2xy=7xy$, and $(5y)(2y)=10y^2$.\n$$x^2+7xy+10y^2=(x+5y)(x+2y).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q56-root",
        "type": "part",
        "label": "e",
        "prompt": "$$3x^2+5xy-2y^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-y)(x+2y)$\n\nMatch the cross terms to $5xy$.",
          "worked": "The cross terms are $6xy-xy=5xy$, and $(-y)(2y)=-2y^2$.\n$$3x^2+5xy-2y^2=(3x-y)(x+2y).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q57-root",
        "type": "part",
        "label": "f",
        "prompt": "$$4x^2-11xy-3y^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x+y)(x-3y)$\n\nMatch the cross terms to $-11xy$.",
          "worked": "The cross terms are $-12xy+xy=-11xy$, and $y(-3y)=-3y^2$.\n$$4x^2-11xy-3y^2=(4x+y)(x-3y).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
