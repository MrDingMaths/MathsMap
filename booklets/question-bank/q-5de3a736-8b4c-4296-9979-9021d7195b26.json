  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$z$ is directly proportional to the square of $x$ and inversely proportional to the square root of $y$. If $z=12$ when $x=2$ and $y=4$, find $z$ when $x=6$ and $y=32$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$z=27\\sqrt{2}$.\n\nUse $z=\\frac{kx^2}{\\sqrt{y}}$ and determine $k$ from the given values.",
      "worked": "$$\\begin{align*}z&=\\frac{kx^2}{\\sqrt{y}}\\\\12&=\\frac{k\\times2^2}{\\sqrt{4}}\\\\12&=2k\\\\k&=6\\end{align*}$$\nThus $z=\\dfrac{6x^2}{\\sqrt{y}}$. When $x=6$ and $y=32$,\n$$\\begin{align*}z&=\\frac{6\\times6^2}{\\sqrt{32}}\\\\z&=\\frac{216}{4\\sqrt{2}}\\\\z&=\\frac{54\\sqrt{2}}{2}\\\\z&=27\\sqrt{2}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 72
  },
