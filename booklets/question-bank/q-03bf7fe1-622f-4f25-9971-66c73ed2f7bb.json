  "content": {
    "id": "p11-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Sally measured the mass of an LCD screen as 2.71 kg.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the limits of accuracy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.705\\text{ kg}$ to $2.715\\text{ kg}$",
          "worked": "$$\\begin{aligned}\\text{Precision} &=0.01\\text{ kg}\\\\\\text{Absolute error} &=\\tfrac12\\times0.01=0.005\\text{ kg}\\\\\\text{Upper bound} &=2.71+0.005=2.715\\text{ kg}\\\\\\text{Lower bound} &=2.71-0.005=2.705\\text{ kg}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the percentage error correct to three decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.185\\%$",
          "worked": "$$\\begin{aligned}\\text{Percentage error} &=\\frac{0.005}{2.71}\\times100\\%\\\\\\text{Percentage error} &\\approx0.185\\%\\quad\\text{(3 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
