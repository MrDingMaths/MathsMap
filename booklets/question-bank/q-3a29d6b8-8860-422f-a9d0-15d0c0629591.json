  "content": {
    "id": "p24-q15-root",
    "type": "question",
    "label": "15",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p24-q15-stem",
          "type": "paragraph",
