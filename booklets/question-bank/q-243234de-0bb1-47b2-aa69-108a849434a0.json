    "children": [
      {
        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the trapezium in terms of $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^2}{2}+ab+\\dfrac{b^2}{2}$",
          "worked": "$$\\begin{align*} A&=\\frac{(a+b)(a+b)}{2}\\\\ A&=\\frac{a^2+2ab+b^2}{2}\\\\ A&=\\frac{a^2}{2}+ab+\\frac{b^2}{2}. \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p17-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Now find the area of the trapezium by finding the sum of the areas of the three triangles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab+\\dfrac{c^2}{2}$",
          "worked": "Each outer triangle has area $\\frac{ab}{2}$. The central triangle has perpendicular sides $c$ and $c$.\n\n$$\\begin{align*} A&=\\frac{ab}{2}+\\frac{c^2}{2}+\\frac{ab}{2}\\\\ A&=ab+\\frac{c^2}{2}. \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, explain why $c^2=a^2+b^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c^2=a^2+b^2$.\n\nEquate the two area expressions, subtract $ab$ and multiply by $2$.",
          "worked": "The two expressions give the area of the same trapezium.\n\n$$\\begin{align*} \\frac{a^2}{2}+ab+\\frac{b^2}{2}&=ab+\\frac{c^2}{2}\\\\ \\frac{a^2}{2}+\\frac{b^2}{2}&=\\frac{c^2}{2}\\\\ a^2+b^2&=c^2. \\end{align*}$$\nSubtracting $ab$ and then multiplying by $2$ gives the required result.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
