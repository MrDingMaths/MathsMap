  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Orange juice is being poured at a constant rate into a glass. After $t$ seconds there are $V$ mL of juice in the glass, where $V=60t$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "How much juice is in the glass after 3 seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180\\text{ mL}$",
          "worked": "$$\\begin{align*}V(3)&=60(3)\\\\V(3)&=180\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p9-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the glass was empty to begin with.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V(0)=60(0)=0\\text{ mL}$, so the glass was initially empty.",
          "worked": "$$\\begin{align*}V(0)&=60(0)\\\\V(0)&=0\\text{ mL}\\end{align*}$$\nThe glass was initially empty because its volume at $t=0$ was zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p9-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "If the glass takes 5 seconds to fill, what is its capacity?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$300\\text{ mL}$",
          "worked": "$$\\begin{align*}V(5)&=60(5)\\\\V(5)&=300\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p9-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Differentiate to find the rate at which the glass is being filled.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dV}{dt}=60\\text{ mL/s}$",
          "worked": "$$\\begin{align*}V&=60t\\\\\\frac{dV}{dt}&=60\\end{align*}$$\nThe glass is being filled at $60\\text{ mL/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p9-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "What sort of function is the derivative in part d?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A constant function.",
          "worked": "The derivative is a constant function because $\\dfrac{dV}{dt}=60$ does not depend on $t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
