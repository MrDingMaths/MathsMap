      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x^2+1)^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)(x+1)(x^2+3)$",
          "worked": "$$\\begin{align*}(x^2+1)^2-4&=(x^2+1-2)(x^2+1+2)\\\\(x^2+1)^2-4&=(x^2-1)(x^2+3)\\\\(x^2+1)^2-4&=(x-1)(x+1)(x^2+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x^2-2)^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2(x-2)(x+2)$",
          "worked": "$$\\begin{align*}(x^2-2)^2-4&=(x^2-2-2)(x^2-2+2)\\\\(x^2-2)^2-4&=x^2(x^2-4)\\\\(x^2-2)^2-4&=x^2(x-2)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+4x+4-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2-y)(x+2+y)$",
          "worked": "$$\\begin{align*}x^2+4x+4-y^2&=(x+2)^2-y^2\\\\x^2+4x+4-y^2&=(x+2-y)(x+2+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+8x+16-a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4-a)(x+4+a)$",
          "worked": "$$\\begin{align*}x^2+8x+16-a^2&=(x+4)^2-a^2\\\\x^2+8x+16-a^2&=(x+4-a)(x+4+a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$m^2-2m+1-n^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m-1-n)(m-1+n)$",
          "worked": "$$\\begin{align*}m^2-2m+1-n^2&=(m-1)^2-n^2\\\\m^2-2m+1-n^2&=(m-1-n)(m-1+n)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$p^2-5p+\\frac{25}{4}-q^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(p-\\frac52-q\\right)\\left(p-\\frac52+q\\right)$",
          "worked": "$$\\begin{align*}p^2-5p+\\frac{25}{4}-q^2&=\\left(p-\\frac52\\right)^2-q^2\\\\p^2-5p+\\frac{25}{4}-q^2&=\\left(p-\\frac52-q\\right)\\left(p-\\frac52+q\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
