              "inlines": [
                {
                  "type": "text",
                  "text": "Find the probability of rolling the number ‘5’ at least once in the first three rolls of the die.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p13-q14-a-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
