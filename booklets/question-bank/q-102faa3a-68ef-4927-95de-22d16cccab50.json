              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hence, find the number of times we must roll the die so that the probability of scoring ‘5’ at least once exceeds 99%.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p13-q14-c-hint",
