  "content": {
    "id": "p13-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A fair die is rolled repeatedly.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q14-a",
        "type": "part",
