  "content": {
    "id": "p36-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A die is rolled twelve times. Find the probability that 5 appears on the uppermost face:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "exactly three times,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\binom{12}{3}\\left(\\frac16\\right)^3\\left(\\frac56\\right)^9$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p36-q9-answer-model",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "X\\sim\\operatorname{Bin}(12,\\tfrac16)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", where X is the number of times 5 appears.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p36-q9-a-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(X=3)=\\binom{12}{3}\\left(\\frac16\\right)^3\\left(\\frac56\\right)^9",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p36-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "exactly eight times,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\binom{12}{8}\\left(\\frac16\\right)^8\\left(\\frac56\\right)^4$",
          "worked": "Let $X$ be the number of times 5 appears. Then $X\\sim\\operatorname{Bin}(12,\\frac16)$.\n$$P(X=8)=\\binom{12}{8}\\left(\\frac16\\right)^8\\left(\\frac56\\right)^4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p36-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "ten or more times, that is, ten, eleven or twelve times.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1711}{6^{12}}$",
          "worked": "Let $X$ be the number of times 5 appears. Then $X\\sim\\operatorname{Bin}(12,\\frac16)$.\n$$\\begin{aligned}P(X\\ge10)&=P(X=10)+P(X=11)+P(X=12)\\\\P(X\\ge10)&=\\binom{12}{10}\\left(\\frac16\\right)^{10}\\left(\\frac56\\right)^2\\\\&\\quad+\\binom{12}{11}\\left(\\frac16\\right)^{11}\\left(\\frac56\\right)+\\left(\\frac16\\right)^{12}\\\\P(X\\ge10)&=\\frac{1650+60+1}{6^{12}}\\\\P(X\\ge10)&=\\frac{1711}{6^{12}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
