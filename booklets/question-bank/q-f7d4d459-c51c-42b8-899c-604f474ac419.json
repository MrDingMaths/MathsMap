  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve each of the following equations by first putting the quadratic equation in standard form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)^2+x^2-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ 0$",
          "worked": "$$\\begin{align*}x^2+2x+1+x^2-1&=0\\\\2x^2+2x&=0\\\\2x(x+1)&=0\\\\x&=-1,\\ 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+2)^2-x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ -1$",
          "worked": "$$\\begin{align*}x^2+4x+4-x-2&=0\\\\x^2+3x+2&=0\\\\(x+2)(x+1)&=0\\\\x&=-2,\\ -1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$-8x+(x+2)^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}-8x+x^2+4x+4&=0\\\\x^2-4x+4&=0\\\\(x-2)^2&=0\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+3-(x+3)^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,\\ -2$",
          "worked": "$$\\begin{align*}x+3-(x^2+6x+9)&=0\\\\-x^2-5x-6&=0\\\\x^2+5x+6&=0\\\\(x+3)(x+2)&=0\\\\x&=-3,\\ -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$x+1+(2x+3)^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ -\\frac54$",
          "worked": "$$\\begin{align*}x+1+4x^2+12x+9&=0\\\\4x^2+13x+10&=0\\\\(4x+5)(x+2)&=0\\\\x&=-2,\\ -\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x-(x-4)^2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ 8$",
          "worked": "$$\\begin{align*}2x-(x^2-8x+16)&=0\\\\-x^2+10x-16&=0\\\\x^2-10x+16&=0\\\\(x-2)(x-8)&=0\\\\x&=2,\\ 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
