  "content": {
    "id": "p22-p3-root",
    "type": "question",
    "label": "3",
    "prompt": "The graphs of $f(x)=x^3-6x^2+11x-4$ and $y=2$ intersect at three points.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-p3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the $x$-coordinates of these intersections satisfy $x^3-6x^2+11x-6=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=2$ gives $x^3-6x^2+11x-6=0$.",
          "worked": "At an intersection, $f(x)=2$.\n$$\\begin{align*}x^3-6x^2+11x-4&=2\\\\x^3-6x^2+11x-6&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p22-p3-b",
        "type": "part",
        "label": "b",
        "prompt": "Using technology, or otherwise, state the solutions of $f(x)=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,2,3$.",
          "worked": "$$\\begin{align*}x^3-6x^2+11x-6&=0\\\\(x-1)(x-2)(x-3)&=0\\end{align*}$$\nHence $x=1,2,3$. These are the three inputs for which $f(x)=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
