  "content": {
    "id": "p27-q40-root",
    "type": "question",
    "label": "40",
    "prompt": "The graph of $y=5^x$ is horizontally dilated by a factor of $h$ to give $y=3^x$. Find the value of $h$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q40-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "h=\\log_3 5=\\frac{\\ln 5}{\\ln 3}",
                "display": false
              }
            ]
          },
          {
            "id": "p27-q40-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Replace ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\mapsto \\frac{x}{h}",
                "display": false
              },
              {
                "type": "text",
                "text": " and match the exponential bases.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Replace $x\\mapsto \\frac{x}{h}$. Matching the exponential bases gives $5^{1/h}=3$.\n\n$$\\begin{align*}y&=5^{x/h}\\\\\\frac{\\ln 5}{h}&=\\ln 3\\\\h&=\\frac{\\ln 5}{\\ln 3}\\\\h&=\\log_3 5\\end{align*}$$",
      "solutionDiagrams": []
    },
