      {
        "id": "p39-q30-33-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\binom{12}{n}=\\binom{12}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4,\\ 8$",
          "worked": "For a fixed upper number, equal binomial coefficients have equal or complementary lower numbers.\n\n$$\\begin{align*}n&=4\\quad\\text{or}\\quad n=12-4\\\\n&=4\\quad\\text{or}\\quad n=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p39-q30-33-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom n8=\\binom n5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=13$",
          "worked": "The lower numbers differ, so they must be complementary.\n\n$$\\begin{align*}8&=n-5\\\\n&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q30-33-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\binom n7+\\binom n6=\\binom{12}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q32-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "n=11",
                    "display": false
                  }
                ]
              },
              {
                "id": "p39-q32-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use Pascal's Identity to combine the left-hand side.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Using Pascal's Identity,\n\n$$\\begin{align*}\\binom n7+\\binom n6&=\\binom{n+1}{7}\\\\\\binom{n+1}{7}&=\\binom{12}{7}\\end{align*}$$\n\nFor a fixed lower number 7, the coefficient increases as the upper number increases.\n\n$$\\begin{align*}n+1&=12\\\\n&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
      },
      {
        "id": "p39-q30-33-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\binom8n+\\binom8{n-1}=\\binom95$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q33-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "n=4,\\ 5",
                    "display": false
                  }
                ]
              },
              {
                "id": "p39-q33-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use Pascal's Identity and complementary selections.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Using Pascal's Identity,\n\n$$\\begin{align*}\\binom8n+\\binom8{n-1}&=\\binom9n\\\\\\binom9n&=\\binom95\\end{align*}$$\n\nThe lower numbers are equal or complementary.\n\n$$\\begin{align*}n&=5\\quad\\text{or}\\quad n=9-5\\\\n&=4\\quad\\text{or}\\quad n=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
