  "content": {
    "id": "p5-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x-1}-\\dfrac{x}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{1}{x-1}-\\frac{x}{x-1}&=\\frac{1-x}{x-1}\\\\&=\\frac{-(x-1)}{x-1}\\\\&=-1\\end{align*}$$\n\nThe original expression is defined for $x\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{t^2-9}{3t-9}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{t+3}{3}$",
          "worked": "$$\\begin{align*}\\frac{t^2-9}{3t-9}&=\\frac{(t-3)(t+3)}{3(t-3)}\\\\&=\\frac{t+3}{3}\\end{align*}$$\n\nThe original expression is defined for $t\\ne3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p5-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{3}{x^2-4}-\\dfrac{2}{x^2-3x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-7}{(x+2)(x-2)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x^2-4}-\\frac{2}{x^2-3x+2}&=\\frac{3}{(x-2)(x+2)}-\\frac{2}{(x-2)(x-1)}\\\\&=\\frac{3(x-1)-2(x+2)}{(x+2)(x-2)(x-1)}\\\\&=\\frac{x-7}{(x+2)(x-2)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2}{x^2-9}-\\dfrac{1}{x-3}-\\dfrac{5}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(7-3x)}{(x+3)(x-3)}$",
          "worked": "The common denominator is $x^2-9=(x+3)(x-3)$.\n\n$$\\begin{align*}\\frac{2}{x^2-9}-\\frac{1}{x-3}-\\frac{5}{x+3}&=\\frac{2-(x+3)-5(x-3)}{(x+3)(x-3)}\\\\&=\\frac{14-6x}{(x+3)(x-3)}\\\\&=\\frac{2(7-3x)}{(x+3)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
