          "inlines": [
            {
              "type": "text",
              "text": "After a 12% pay rise, a worker earns $168 a day. What did the worker earn before the pay rise?",
              "marks": [
                "italic"
              ]
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Work out the worker’s original pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$150 a day",
          "worked": "The new pay represents $100\\%+12\\%=112\\%$ of the original.\n$$\\begin{align*}112\\%&=\\$168\\\\1\\%&=\\frac{\\$168}{112}=\\$1.50\\\\100\\%&=\\$1.50\\times100=\\$150\\end{align*}$$\nThe original pay was \\$150 a day.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Rhys tried to solve the problem by finding 88% of \\$168. Is he correct?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. You cannot reverse a 12% increase by decreasing by 12%.",
          "worked": "No. The 12% pay rise is calculated from the original pay, whereas Rhys’s 12% decrease is calculated from the larger new pay.\n$$\\begin{align*}88\\%\\text{ of }\\$168&=0.88\\times\\$168\\\\&=\\$147.84\\end{align*}$$\nThe original pay is \\$150, found by treating \\$168 as 112% of the original.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
