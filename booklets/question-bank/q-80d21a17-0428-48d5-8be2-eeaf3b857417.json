  "content": {
    "id": "v2-1856e-p52-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Mia earns \\$54 300 per year from her job, \\$240 interest from savings, and \\$360 from share dividends. She has allowable tax deductions of \\$1450 for tools and \\$350 for a uniform. Calculate:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1856e-p52-practice-slot-5-s5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Total gross income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$54 900",
          "worked": "$$\\begin{align*}\\text{Gross income} &= 54\\,300 + 240 + 360\\\\\\text{Gross income} &= \\$54\\,900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-1856e-p52-practice-slot-5-s5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Total allowable tax deductions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1800",
          "worked": "$$\\begin{align*}\\text{Allowable deductions} &= 1450 + 350\\\\\\text{Allowable deductions} &= \\$1800\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-1856e-p52-practice-slot-5-s5-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Taxable income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$53 100",
          "worked": "$$\\begin{align*}\\text{Taxable income} &= \\text{Gross income} - \\text{Allowable deductions}\\\\\\text{Taxable income} &= 54\\,900 - 1800\\\\\\text{Taxable income} &= \\$53\\,100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-1856e-p52-practice-slot-5-s5-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Income tax payable. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$7724.50",
          "worked": "Using the resident tax rates for 2022–23, taxable income of \\$53 100 is in the third bracket (\\$45 001–\\$120 000).\n\n$$\\begin{align*}\\text{Excess} &= 53\\,100 - 45\\,000\\\\\\text{Excess} &= \\$8100\\\\\\text{Tax payable} &= \\text{Base tax} + \\text{Tax rate}\\times\\text{Excess}\\\\\\text{Tax payable} &= 5092 + 0.325\\times8100\\\\\\text{Tax payable} &= \\$7724.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
