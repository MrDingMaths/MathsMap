  "content": {
    "id": "p23-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Sally travelled to work at a speed of $80$ km/h and returned home at a speed of $30$ km/h. She spent a total of $2$ hours travelling. What is her distance to work?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{480}{11}$ km",
      "worked": "Let $d$ km be the distance to work. The outward and return times are $\\frac{d}{80}$ h and $\\frac{d}{30}$ h.\n$$\\begin{align*}\\frac{d}{80}+\\frac{d}{30}&=2\\\\3d+8d&=480\\\\11d&=480\\\\d&=\\frac{480}{11}\\end{align*}$$\nSally's distance to work is $\\frac{480}{11}$ km.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
