      {
        "id": "p32-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of the midpoint $M$ of $BC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M\\left(\\frac{c}{2},\\frac{b}{2}\\right)$",
          "worked": "$$\\begin{align*}x_M&=\\frac{0+c}{2}\\\\x_M&=\\frac{c}{2}\\\\y_M&=\\frac{b+0}{2}\\\\y_M&=\\frac{b}{2}\\end{align*}$$\nHence $M\\left(\\frac{c}{2},\\frac{b}{2}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p32-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the distances:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p32-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$OM$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\sqrt{c^2+b^2}}{2}$",
              "worked": "$$\\begin{align*}OM^2&=\\left(\\frac{c}{2}-0\\right)^2+\\left(\\frac{b}{2}-0\\right)^2\\\\OM^2&=\\frac{c^2+b^2}{4}\\\\OM&=\\frac{\\sqrt{c^2+b^2}}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 49
          },
          {
            "id": "p32-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$MB$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\sqrt{b^2+c^2}}{2}$",
              "worked": "$$\\begin{align*}MB^2&=\\left(0-\\frac{c}{2}\\right)^2+\\left(b-\\frac{b}{2}\\right)^2\\\\MB^2&=\\left(-\\frac{c}{2}\\right)^2+\\left(\\frac{b}{2}\\right)^2\\\\MB^2&=\\frac{c^2+b^2}{4}\\\\MB&=\\frac{\\sqrt{b^2+c^2}}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 55
          },
          {
            "id": "p32-q4-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$MC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{\\sqrt{c^2+b^2}}{2}$",
              "worked": "$$\\begin{align*}MC^2&=\\left(c-\\frac{c}{2}\\right)^2+\\left(0-\\frac{b}{2}\\right)^2\\\\MC^2&=\\left(\\frac{c}{2}\\right)^2+\\left(-\\frac{b}{2}\\right)^2\\\\MC^2&=\\frac{c^2+b^2}{4}\\\\MC&=\\frac{\\sqrt{c^2+b^2}}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 55
          }
        ]
      }
    ],
