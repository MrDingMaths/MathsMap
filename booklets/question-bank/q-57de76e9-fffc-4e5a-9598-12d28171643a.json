        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3e^x$.",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=y\\\\\\frac{dx}{dy}&=\\frac1y\\\\x&=\\int\\frac1y\\,dy\\\\x&=\\ln|y|+C\\\\y&=Ae^x\\\\-3&=Ae^0\\\\A&=-3\\\\y&=-3e^x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y'+2y=0$, $y(0)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=e^{-2x}$.",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=-2y\\\\\\frac{dx}{dy}&=-\\frac1{2y}\\\\x&=\\int-\\frac1{2y}\\,dy\\\\x&=-\\frac12\\ln|y|+C\\\\y&=Ae^{-2x}\\\\1&=Ae^0\\\\A&=1\\\\y&=e^{-2x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p33-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$y'=-3y$, $y(0)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2e^{-3x}$.",
          "worked": "$$\\begin{aligned}\\frac{dx}{dy}&=-\\frac1{3y}\\\\x&=\\int-\\frac1{3y}\\,dy\\\\x&=-\\frac13\\ln|y|+C\\\\y&=Ae^{-3x}\\\\2&=Ae^0\\\\A&=2\\\\y&=2e^{-3x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 41
