  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos140^{\\circ}\\cos50^{\\circ}+\\sin140^{\\circ}\\sin50^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cos140^{\\circ}\\cos50^{\\circ}+\\sin140^{\\circ}\\sin50^{\\circ}&=\\cos(140^{\\circ}-50^{\\circ})\\\\\\cos140^{\\circ}\\cos50^{\\circ}+\\sin140^{\\circ}\\sin50^{\\circ}&=\\cos90^{\\circ}\\\\\\cos140^{\\circ}\\cos50^{\\circ}+\\sin140^{\\circ}\\sin50^{\\circ}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos110^{\\circ}\\cos70^{\\circ}-\\sin110^{\\circ}\\sin70^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\cos110^{\\circ}\\cos70^{\\circ}-\\sin110^{\\circ}\\sin70^{\\circ}&=\\cos(110^{\\circ}+70^{\\circ})\\\\\\cos110^{\\circ}\\cos70^{\\circ}-\\sin110^{\\circ}\\sin70^{\\circ}&=\\cos180^{\\circ}\\\\\\cos110^{\\circ}\\cos70^{\\circ}-\\sin110^{\\circ}\\sin70^{\\circ}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin20^{\\circ}\\cos70^{\\circ}+\\sin70^{\\circ}\\cos20^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin20^{\\circ}\\cos70^{\\circ}+\\sin70^{\\circ}\\cos20^{\\circ}&=\\sin(20^{\\circ}+70^{\\circ})\\\\\\sin20^{\\circ}\\cos70^{\\circ}+\\sin70^{\\circ}\\cos20^{\\circ}&=\\sin90^{\\circ}\\\\\\sin20^{\\circ}\\cos70^{\\circ}+\\sin70^{\\circ}\\cos20^{\\circ}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin100^{\\circ}\\cos80^{\\circ}+\\cos100^{\\circ}\\sin80^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sin100^{\\circ}\\cos80^{\\circ}+\\cos100^{\\circ}\\sin80^{\\circ}&=\\sin(100^{\\circ}+80^{\\circ})\\\\\\sin100^{\\circ}\\cos80^{\\circ}+\\cos100^{\\circ}\\sin80^{\\circ}&=\\sin180^{\\circ}\\\\\\sin100^{\\circ}\\cos80^{\\circ}+\\cos100^{\\circ}\\sin80^{\\circ}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
