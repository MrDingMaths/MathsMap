  "content": {
    "id": "p17-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "If $\\Omega=\\{1,2,3,4,5,6,7\\}$, $A=\\{1,2,3,4,5,6\\}$ and $B=\\{2,3,4,5,6,7\\}$, find $\\Pr(A\\mid B)$ and $\\Pr(B\\mid A)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\Pr(A\\mid B)=\\frac56$, $\\Pr(B\\mid A)=\\frac56$.",
      "worked": "The intersection is $A\\cap B=\\{2,3,4,5,6\\}$. Each conditioning set contains six equally likely outcomes.\n\n$$\\begin{align*}\\Pr(A\\mid B)&=\\frac{|A\\cap B|}{|B|}\\\\\\Pr(A\\mid B)&=\\frac56\\\\\\Pr(B\\mid A)&=\\frac{|A\\cap B|}{|A|}\\\\\\Pr(B\\mid A)&=\\frac56\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
