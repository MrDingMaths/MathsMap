  "content": {
    "id": "p23-review-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The temperature in June at a base in Antarctica varied from a minimum of $-60^{\\circ}\\mathrm{C}$ to a maximum of $-35^{\\circ}\\mathrm{C}$. What was the value of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-review-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "maximum temperature − minimum temperature?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25^{\\circ}\\mathrm{C}$",
          "worked": "$$\\begin{align*}-35-(-60)&=-35+60\\\\-35-(-60)&=25\\end{align*}$$\nThe difference is $25^{\\circ}\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-review-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "minimum temperature − maximum temperature?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-25^{\\circ}\\mathrm{C}$",
          "worked": "$$\\begin{align*}-60-(-35)&=-60+35\\\\-60-(-35)&=-25\\end{align*}$$\nThe difference is $-25^{\\circ}\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
