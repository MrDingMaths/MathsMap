              {
                "id": "p25-task-q1-c",
                "type": "part",
                "label": "c",
                "prompt": "How long is each diagonal segment? Calculate your answer in terms of $d$ and $g$.",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$\\sqrt{d^2+g^2}$",
                  "worked": "Each diagonal is the hypotenuse of a right-angled triangle with perpendicular sides $d$ and $g$. Let its length be $s$.\n$$\\begin{align*}s^2&=d^2+g^2\\\\s&=\\sqrt{d^2+g^2}\\end{align*}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 25
              },
              {
                "id": "p25-task-q1-d",
                "type": "part",
                "label": "d",
                "prompt": "What is the total length of lacing required for the standard lacing pattern? Calculate your answer in terms of $n$, $d$, $\\ell$ and $g$.",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": {
                    "format": "maths-editor-document-v1",
                    "version": 1,
                    "blocks": [
                      {
                        "id": "p25-q1d-short-formula",
                        "type": "paragraph",
