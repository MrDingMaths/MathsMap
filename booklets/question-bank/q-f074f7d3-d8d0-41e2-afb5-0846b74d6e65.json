  "content": {
    "id": "p9-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "By completing the square, find the minimum value of $x^2-2x+5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4$.",
      "worked": "$$\\begin{align*}x^2-2x+5&=(x^2-2x+1)-1+5\\\\x^2-2x+5&=(x-1)^2+4\\end{align*}$$\nSince $(x-1)^2\\geq0$, the minimum value is $4$, attained when $x=1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
