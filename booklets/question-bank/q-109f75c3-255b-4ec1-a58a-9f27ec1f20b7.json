  "content": {
    "id": "p22-q84-root",
    "type": "question",
    "label": "84",
    "prompt": "Simplify\n$$\\ln\\left(\\frac21\\right)+\\ln\\left(\\frac32\\right)+\\cdots+\\ln\\left(1+\\frac1n\\right),$$\nwhere $n$ is a positive integer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
