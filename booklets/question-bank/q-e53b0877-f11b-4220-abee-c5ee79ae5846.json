    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{\\frac12}\\times2^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}2^{\\frac12}\\times2^{\\frac12}&=2^{\\frac12+\\frac12}\\\\2^{\\frac12}\\times2^{\\frac12}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2^{\\frac12}\\times2^{-\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}2^{\\frac12}\\times2^{-\\frac12}&=2^{\\frac12-\\frac12}\\\\2^{\\frac12}\\times2^{-\\frac12}&=2^0\\\\2^{\\frac12}\\times2^{-\\frac12}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{\\frac12}\\times2^{2\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}2^{\\frac12}\\times2^{2\\frac12}&=2^{\\frac12+\\frac52}\\\\2^{\\frac12}\\times2^{2\\frac12}&=2^3\\\\2^{\\frac12}\\times2^{2\\frac12}&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$3^{4\\frac12}\\div3^{5\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "$$\\begin{align*}3^{4\\frac12}\\div3^{5\\frac12}&=3^{\\frac92-\\frac{11}2}\\\\3^{4\\frac12}\\div3^{5\\frac12}&=3^{-1}\\\\3^{4\\frac12}\\div3^{5\\frac12}&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$25\\div25^{\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}25\\div25^{\\frac12}&=25^{1-\\frac12}\\\\25\\div25^{\\frac12}&=25^{\\frac12}\\\\25\\div25^{\\frac12}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$7^{\\frac23}\\div7^{\\frac23}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}7^{\\frac23}\\div7^{\\frac23}&=7^{\\frac23-\\frac23}\\\\7^{\\frac23}\\div7^{\\frac23}&=7^0\\\\7^{\\frac23}\\div7^{\\frac23}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$3^3\\times3^4\\div3^{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{27}$",
          "worked": "$$\\begin{align*}3^3\\times3^4\\div3^{10}&=3^{3+4-10}\\\\3^3\\times3^4\\div3^{10}&=3^{-3}\\\\3^3\\times3^4\\div3^{10}&=\\frac1{27}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(3^{-\\frac13}\\right)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac19$",
          "worked": "$$\\begin{align*}\\left(3^{-\\frac13}\\right)^6&=3^{-\\frac13\\times6}\\\\\\left(3^{-\\frac13}\\right)^6&=3^{-2}\\\\\\left(3^{-\\frac13}\\right)^6&=\\frac19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-i",
