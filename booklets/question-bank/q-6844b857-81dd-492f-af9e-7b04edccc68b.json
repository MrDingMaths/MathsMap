  "content": {
    "id": "p17-q22",
    "type": "question",
    "label": "22",
    "prompt": "By finding expressions for the LHS and RHS, show that these are true for $f(x)=x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q22-grid",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q22-a",
            "type": "part",
            "label": "a",
            "prompt": "$f(4x)=16f(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Both sides equal $16x^2$.",
              "worked": "$$\\begin{aligned}\\text{LHS}&=f(4x)\\\\&=(4x)^2\\\\&=16x^2\\\\\\text{RHS}&=16f(x)\\\\&=16x^2\\end{aligned}$$\nThus LHS = RHS.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p17-q22-b",
            "type": "part",
            "label": "b",
            "prompt": "$f(xy)=f(x)f(y)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Both sides equal $x^2y^2$.",
              "worked": "$$\\begin{aligned}\\text{LHS}&=f(xy)\\\\&=(xy)^2\\\\&=x^2y^2\\\\\\text{RHS}&=f(x)f(y)\\\\&=x^2y^2\\end{aligned}$$\nThus LHS = RHS.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p17-q22-c",
            "type": "part",
            "label": "c",
            "prompt": "$f\\left(\\dfrac{x}{y}\\right)=\\dfrac{f(x)}{f(y)}$, where $y\\ne0$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Both sides equal $\\dfrac{x^2}{y^2}$, for $y\\ne0$.",
              "worked": "$$\\begin{aligned}\\text{LHS}&=f\\left(\\frac{x}{y}\\right)\\\\&=\\left(\\frac{x}{y}\\right)^2\\\\&=\\frac{x^2}{y^2}\\\\\\text{RHS}&=\\frac{f(x)}{f(y)}\\\\&=\\frac{x^2}{y^2}\\end{aligned}$$\nThus LHS = RHS for $y\\ne0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p17-q22-d",
            "type": "part",
            "label": "d",
            "prompt": "$f(x^2)=(f(x))^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Both sides equal $x^4$.",
              "worked": "$$\\begin{aligned}\\text{LHS}&=f(x^2)\\\\&=(x^2)^2\\\\&=x^4\\\\\\text{RHS}&=(f(x))^2\\\\&=(x^2)^2\\\\&=x^4\\end{aligned}$$\nThus LHS = RHS.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      },
      {
        "id": "p17-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x+y)+f(x-y)=2(f(x)+f(y))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides equal $2x^2+2y^2$.",
          "worked": "$$\\begin{aligned}\\text{LHS}&=f(x+y)+f(x-y)\\\\&=(x+y)^2+(x-y)^2\\\\&=x^2+2xy+y^2+x^2-2xy+y^2\\\\&=2x^2+2y^2\\\\\\text{RHS}&=2(f(x)+f(y))\\\\&=2(x^2+y^2)\\\\&=2x^2+2y^2\\end{aligned}$$\nThus LHS = RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
