  "content": {
    "id": "p33-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Four points $A$, $B$, $C$ and $D$ are marked in order on a line such that $AB:AC=3:5$ and $BD:CD=7:2$. If $CD$ is $10\\text{ cm}$ long, find the length of $AB$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p33-q5-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "37.5\\text{ cm}",
                "display": false
              }
            ]
          },
          {
            "id": "p33-q5-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Find BD from its ratio to CD, subtract CD to obtain BC, then use BC as two parts of AB : AC.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Since the points are in order, $BC=BD-CD$.\n$$\\begin{align*}BD&=10\\div2\\times7\\text{ cm}\\\\BD&=35\\text{ cm}\\\\BC&=35-10\\text{ cm}\\\\BC&=25\\text{ cm}\\end{align*}$$\nIn $AB:AC=3:5$, $AB$ is 3 parts and $BC$ is $5-3=2$ parts.\n$$\\begin{align*}\\text{1 part}&=25\\div2\\text{ cm}\\\\\\text{1 part}&=12.5\\text{ cm}\\\\AB&=3\\times12.5\\text{ cm}\\\\AB&=37.5\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
