  "content": {
    "id": "v2-09d4b-p24-practice-slot-17-root",
    "type": "question",
    "label": null,
    "prompt": "A commercial oven was bought for $\\$15\\,000$. It depreciates by 16% of its value each year.\nFind how long it will take for the oven to depreciate to $\\$6000$. Answer to the nearest year.\nHint: set up the compound depreciation equation and use trial and error to estimate n. Refine your trials around the target, then round the estimated time as requested.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "5 years",
      "worked": "$$6000=15\\,000(0.84)^n$$\nUse trial and error:\n$$\\begin{align*}S(5)&=15\\,000(0.84)^5\\approx\\$6273.18\\\\S(5.5)&=15\\,000(0.84)^{5.5}\\approx\\$5749\\end{align*}$$\nThe value reaches $\\$6000$ between 5 and 5.5 years, at about 5.3 years, so the time is 5 years to the nearest year.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
