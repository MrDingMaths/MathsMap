  "content": {
    "id": "p40-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Ashley’s age is $a$.\nBella is 3 years older than Ashley.\nCindy is double the age of Ashley.\nDaisy is 4 years younger than Cindy.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the age of Bella.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+3$ years",
          "worked": "Bella is 3 years older than Ashley, so her age is $a+3$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression for the age of Cindy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a$ years",
          "worked": "Cindy is double Ashley’s age, so her age is $2a$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an expression for the age of Daisy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a-4$ years",
          "worked": "Daisy is 4 years younger than Cindy, whose age is $2a$, so Daisy’s age is $2a-4$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p40-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "Determine their ages if Ashley is 10 years old.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Bella: 13 years; Cindy: 20 years; Daisy: 16 years.",
          "worked": "Substitute $a=10$.\n\nBella:\n$$\\begin{align*}a+3&=10+3\\\\a+3&=13\\end{align*}$$\nCindy:\n$$\\begin{align*}2a&=2\\times10\\\\2a&=20\\end{align*}$$\nDaisy:\n$$\\begin{align*}2a-4&=2\\times10-4\\\\2a-4&=16\\end{align*}$$\nBella is 13 years old, Cindy is 20 years old and Daisy is 16 years old.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
