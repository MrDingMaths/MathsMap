    "children": [
      {
        "id": "p20-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "If the width of $A$ is $x$ m, find, in terms of $x$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q10-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the length of $A$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x+5)$ m",
              "worked": "$\\text{Length of }A=(x+5)$ m.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p20-q10-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the length and width of $B$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Length: $1.2(x+5)$ m; width: $1.5x$ m.",
              "worked": "$$\\begin{align*}\\text{Length of }B&=1.2(x+5)\\text{ m}\\\\\\text{Width of }B&=1.5x\\text{ m}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p20-q10-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the perimeter of $A$, expressed in simplest form",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(4x+10)$ m",
              "worked": "$$\\begin{align*}P_A&=2x+2(x+5)\\\\P_A&=4x+10\\text{ m}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p20-q10-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "the perimeter of $B$, expressed in simplest form",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(5.4x+12)$ m",
              "worked": "$$\\begin{align*}P_B&=2(1.5x)+2\\bigl(1.2(x+5)\\bigr)\\\\P_B&=3x+2.4x+12\\\\P_B&=5.4x+12\\text{ m}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p20-q10-a-v",
            "type": "part",
            "label": "v",
            "prompt": "the difference between the perimeters of $A$ and $B$, expressed in simplest form",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(1.4x+2)$ m",
              "worked": "Rectangle $B$ has the larger perimeter.\n\n$$\\begin{align*}P_B-P_A&=(5.4x+12)-(4x+10)\\\\P_B-P_A&=1.4x+2\\text{ m}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      },
      {
        "id": "p20-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If the difference between the perimeters of $A$ and $B$ is 23 m, what is the value of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=15$",
          "worked": "$$\\begin{align*}1.4x+2&=23\\\\1.4x&=21\\\\x&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
