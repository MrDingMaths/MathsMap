    "children": [
      {
        "id": "v2-2c897-p51-practice-slot-16-slot-16-a",
        "type": "part",
        "label": "a",
        "prompt": "The concentration of a medicine in a patient's bloodstream is $C(t)=15\\left(e^{-0.1t}-e^{-0.4t}\\right)$ mg/L, where $t$ is the time in hours after a dose. Find the value that $C$ approaches as $t\\to\\infty$, and explain why $C$ stays above this value for $t>0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C\\to0$. For $t>0$, $e^{-0.1t}>e^{-0.4t}$, so $C>0$.",
          "worked": "As $t\\to\\infty$, $e^{-0.1t}\\to0$ and $e^{-0.4t}\\to0$, so $C\\to15(0-0)=0$.\n\nFor $t>0$, $-0.1t>-0.4t$, so $e^{-0.1t}>e^{-0.4t}$.\n$$\\begin{align*}C&=15\\left(e^{-0.1t}-e^{-0.4t}\\right)\\\\&>0\\end{align*}$$\nSo $C$ approaches $0$ from above and stays above it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-2c897-p51-practice-slot-16-slot-16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equations of the horizontal asymptotes of $y=\\dfrac{6e^x+1}{2e^x+3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac13$ (as $x\\to-\\infty$) and $y=3$ (as $x\\to\\infty$).",
          "worked": "As $x\\to-\\infty$, $e^x\\to0$:\n$$y\\to\\frac{0+1}{0+3}=\\frac13.$$\nAs $x\\to\\infty$, divide the numerator and denominator by $e^x$:\n$$y=\\frac{6+e^{-x}}{2+3e^{-x}}.$$\nSince $e^{-x}\\to0$:\n$$y\\to\\frac62=3.$$\nThe asymptotes are $y=\\frac13$ and $y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
