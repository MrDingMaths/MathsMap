    "type": "question",
    "label": "7",
    "prompt": "Evaluate the following expression.\n$$\\frac{\\sqrt{49}-1}{\\sqrt[3]{-64}}\\times\\frac{\\sqrt{64}}{\\sqrt{25}}\\div\\frac{(-2)^2}{2^3}\\times\\frac{\\sqrt[3]{125}}{3^2}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-\\frac{8}{3}$",
      "worked": "$$\\begin{align*}\\frac{\\sqrt{49}-1}{\\sqrt[3]{-64}}\\times\\frac{\\sqrt{64}}{\\sqrt{25}}\\div\\frac{(-2)^2}{2^3}\\times\\frac{\\sqrt[3]{125}}{3^2}&=\\frac{7-1}{-4}\\times\\frac{8}{5}\\div\\frac{4}{8}\\times\\frac{5}{9}\\\\&=-\\frac{3}{2}\\times\\frac{8}{5}\\div\\frac{1}{2}\\times\\frac{5}{9}\\\\&=-\\frac{12}{5}\\div\\frac{1}{2}\\times\\frac{5}{9}\\\\&=-\\frac{24}{5}\\times\\frac{5}{9}\\\\&=-\\frac{8}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
