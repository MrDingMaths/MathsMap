    "children": [
      {
        "id": "p16-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\binom{6}{1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\binom{6}{1}&=\\frac{6!}{1!5!}\\\\\\binom{6}{1}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom{7}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\binom{7}{6}&=\\binom{7}{1}\\\\\\binom{7}{6}&=\\frac{7!}{1!6!}\\\\\\binom{7}{6}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\binom{5}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\binom{5}{2}&=\\frac{5!}{2!3!}\\\\\\binom{5}{2}&=\\frac{5\\times4}{2}\\\\\\binom{5}{2}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\binom{15}{14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\binom{15}{14}&=\\binom{15}{1}\\\\\\binom{15}{14}&=\\frac{15!}{1!14!}\\\\\\binom{15}{14}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\binom{25}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$300$",
          "worked": "$$\\begin{align*}\\binom{25}{2}&=\\frac{25!}{2!23!}\\\\\\binom{25}{2}&=\\frac{25\\times24}{2}\\\\\\binom{25}{2}&=300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\binom{100}{98}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4950$",
          "worked": "$$\\begin{align*}\\binom{100}{98}&=\\binom{100}{2}\\\\\\binom{100}{98}&=\\frac{100!}{2!98!}\\\\\\binom{100}{98}&=\\frac{100\\times99}{2}\\\\\\binom{100}{98}&=4950\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
