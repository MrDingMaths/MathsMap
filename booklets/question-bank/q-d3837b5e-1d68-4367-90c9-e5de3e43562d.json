  "content": {
    "id": "p24-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the inverse function of each function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\dfrac{x+4}{3}$.",
          "worked": "Write $y=3x-4$ and interchange $x$ and $y$.\n$$\\begin{align*}x&=3y-4\\\\x+4&=3y\\\\y&=\\frac{x+4}{3}\\end{align*}$$\nHence $f^{-1}(x)=\\dfrac{x+4}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p24-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2-3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\dfrac{2-x}{3}$.",
          "worked": "Write $y=2-3x$ and interchange $x$ and $y$.\n$$\\begin{align*}x&=2-3y\\\\3y&=2-x\\\\y&=\\frac{2-x}{3}\\end{align*}$$\nHence $f^{-1}(x)=\\dfrac{2-x}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p24-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^3+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sqrt[3]{x-2}$.",
          "worked": "Interchange $x$ and $y$.\n$$\\begin{align*}x&=y^3+2\\\\y^3&=x-2\\\\y&=\\sqrt[3]{x-2}\\end{align*}$$\nThe inverse is $y=\\sqrt[3]{x-2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{1}{x}-2$, $x\\ne0$.",
          "worked": "Interchange $x$ and $y$.\n$$\\begin{align*}x&=\\frac{1}{y+2}\\\\x(y+2)&=1\\\\y+2&=\\frac{1}{x}\\\\y&=\\frac{1}{x}-2\\end{align*}$$\nThe inverse is $y=\\dfrac{1}{x}-2$, with $x\\ne0$ because the denominator cannot be zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
