  "content": {
    "id": "p59-q7-response",
    "type": "question",
    "label": "7",
    "prompt": "A patient is to receive 1.5 L of fluid over 6 h through an intravenous drip.\nIf there are 12 drops/mL, how many drops per minute are required to deliver the dose?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "50 drops/min",
      "worked": "The three quantities are drops, volume and time.\n$$\\begin{align*}\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{12\\text{ drops}}{1\\text{ mL}}\\times\\frac{1.5\\text{ L}}{6\\text{ h}}\\\\\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{12\\text{ drops}}{1\\text{ mL}}\\times\\frac{1500\\text{ mL}}{360\\text{ min}}\\\\\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{50\\text{ drops}}{1\\text{ min}}\\end{align*}$$\nThe required drip rate is **50 drops/min**.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
