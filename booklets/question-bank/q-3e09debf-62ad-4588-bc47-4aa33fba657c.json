  "content": {
    "id": "p10-q3",
    "type": "question",
    "label": "3",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the formula for the area of a triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\dfrac{bh}{2}$",
          "worked": "$$A=\\frac{bh}{2}$$\nHere $b$ is the base and $h$ is the perpendicular height.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "The area of a triangle is $8\\text{ cm}^{2}$.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Find the height of the triangle if the base is $10\\text{ cm}$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$h=1.6\\text{ cm}$",
              "worked": "$$\\begin{align*}A&=\\frac{bh}{2}\\\\8&=\\frac{10h}{2}\\\\8&=5h\\\\h&=1.6\\text{ cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p10-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find the height of the triangle if it is equal to the base.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$h=4\\text{ cm}$",
              "worked": "The base equals the height, so $b=h$.\n$$\\begin{align*}A&=\\frac{bh}{2}\\\\8&=\\frac{h^{2}}{2}\\\\h^{2}&=16\\\\h&=4\\text{ cm}\\end{align*}$$\nThe height must be positive.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 43
          }
        ]
      }
    ]
  },
