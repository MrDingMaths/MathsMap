  "content": {
    "id": "v2-4ab09-p14-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Dana is paid \\$31.40 per hour for a 38-hour week. She is paid overtime at double-time for any hours in excess of 38 hours. Calculate her total pay in a week in which she worked 8.5 hours on each of 5 days.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1475.80",
      "worked": "$\\begin{align*}\\text{Total hours}&=8.5\\times5\\\\\\text{Total hours}&=42.5\\\\\\text{Overtime hours}&=42.5-38\\\\\\text{Overtime hours}&=4.5\\\\\\text{Normal pay}&=31.40\\times38\\\\\\text{Normal pay}&=\\$1193.20\\\\\\text{Overtime pay}&=31.40\\times4.5\\times2\\\\\\text{Overtime pay}&=\\$282.60\\\\\\text{Total pay}&=1193.20+282.60\\\\\\text{Total pay}&=\\$1475.80\\end{align*}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
