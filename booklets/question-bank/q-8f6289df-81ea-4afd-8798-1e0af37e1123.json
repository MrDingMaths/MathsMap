  "content": {
    "id": "p16-review-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Given that $y\\propto x^3$, what is the effect on $y$ when $x$ is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-review-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "doubled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is multiplied by $8$.",
          "worked": "Since $y=kx^3$,\n$$\\begin{align*}y_{\\text{new}}&=k(2x)^3\\\\y_{\\text{new}}&=8kx^3\\\\y_{\\text{new}}&=8y.\\end{align*}$$\nThus $y$ is multiplied by $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-review-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "multiplied by $3$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is multiplied by $27$.",
          "worked": "Since $y=kx^3$,\n$$\\begin{align*}y_{\\text{new}}&=k(3x)^3\\\\y_{\\text{new}}&=27kx^3\\\\y_{\\text{new}}&=27y.\\end{align*}$$\nThus $y$ is multiplied by $27$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p16-review-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "divided by $4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is divided by $64$.",
          "worked": "Since $y=kx^3$,\n$$\\begin{align*}y_{\\text{new}}&=k\\left(\\frac{x}{4}\\right)^3\\\\y_{\\text{new}}&=\\frac{kx^3}{64}\\\\y_{\\text{new}}&=\\frac{y}{64}.\\end{align*}$$\nThus $y$ is divided by $64$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
