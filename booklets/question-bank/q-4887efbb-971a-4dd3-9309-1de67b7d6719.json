        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}\\sin(-390^{\\circ})&=\\sin(-390^{\\circ}+720^{\\circ})\\\\\\sin(-390^{\\circ})&=\\sin330^{\\circ}\\\\\\sin(-390^{\\circ})&=-\\sin30^{\\circ}\\\\\\sin(-390^{\\circ})&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
