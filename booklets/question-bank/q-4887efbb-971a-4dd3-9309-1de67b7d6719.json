    "children": [
      {
        "id": "p15-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(-60^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\sin(-60^{\\circ})&=\\sin(-60^{\\circ}+360^{\\circ})\\\\\\sin(-60^{\\circ})&=\\sin300^{\\circ}\\\\\\sin(-60^{\\circ})&=-\\sin60^{\\circ}\\\\\\sin(-60^{\\circ})&=-\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(-135^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\cos(-135^{\\circ})&=\\cos(-135^{\\circ}+360^{\\circ})\\\\\\cos(-135^{\\circ})&=\\cos225^{\\circ}\\\\\\cos(-135^{\\circ})&=-\\cos45^{\\circ}\\\\\\cos(-135^{\\circ})&=-\\frac{1}{\\sqrt2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(-225^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\tan(-225^{\\circ})&=\\tan(-225^{\\circ}+360^{\\circ})\\\\\\tan(-225^{\\circ})&=\\tan135^{\\circ}\\\\\\tan(-225^{\\circ})&=-\\tan45^{\\circ}\\\\\\tan(-225^{\\circ})&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos(-240^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}\\cos(-240^{\\circ})&=\\cos(-240^{\\circ}+360^{\\circ})\\\\\\cos(-240^{\\circ})&=\\cos120^{\\circ}\\\\\\cos(-240^{\\circ})&=-\\cos60^{\\circ}\\\\\\cos(-240^{\\circ})&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin(-330^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\sin(-330^{\\circ})&=\\sin(-330^{\\circ}+360^{\\circ})\\\\\\sin(-330^{\\circ})&=\\sin30^{\\circ}\\\\\\sin(-330^{\\circ})&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p15-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin(-390^{\\circ})$",
        "layout": "list",
        "columns": null,
