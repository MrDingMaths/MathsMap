    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3x^2-3x}{x+1}\\div\\dfrac{1-x}{x^2+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3x^2$",
          "worked": "$$\\begin{align*}\\frac{3x^2-3x}{x+1}\\div\\frac{1-x}{x^2+x}&=\\frac{3x(x-1)}{x+1}\\times\\frac{x(x+1)}{-(x-1)}\\\\\\frac{3x^2-3x}{x+1}\\div\\frac{1-x}{x^2+x}&=-3x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-4}{2x^2-6x}\\div\\dfrac{6-x-x^2}{9-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{2x}$",
          "worked": "$$\\begin{align*}\\frac{x^2-4}{2x^2-6x}\\div\\frac{6-x-x^2}{9-x^2}&=\\frac{(x-2)(x+2)}{2x(x-3)}\\times\\frac{-(x-3)(x+3)}{-(x-2)(x+3)}\\\\\\frac{x^2-4}{2x^2-6x}\\div\\frac{6-x-x^2}{9-x^2}&=\\frac{x+2}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2x^2+5x-3}{x^2-1}\\div\\dfrac{x^2-x-12}{x^2-3x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x-1}{x-1}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+5x-3}{x^2-1}\\div\\frac{x^2-x-12}{x^2-3x-4}&=\\frac{(2x-1)(x+3)}{(x-1)(x+1)}\\times\\frac{(x-4)(x+1)}{(x-4)(x+3)}\\\\\\frac{2x^2+5x-3}{x^2-1}\\div\\frac{x^2-x-12}{x^2-3x-4}&=\\frac{2x-1}{x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{16x^2+8x+1}{8x^2+14x+3}\\div\\dfrac{4x+1}{4x^2+4x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x-1$",
          "worked": "$$\\begin{align*}\\frac{16x^2+8x+1}{8x^2+14x+3}\\div\\frac{4x+1}{4x^2+4x-3}&=\\frac{(4x+1)^2}{(4x+1)(2x+3)}\\times\\frac{(2x+3)(2x-1)}{4x+1}\\\\\\frac{16x^2+8x+1}{8x^2+14x+3}\\div\\frac{4x+1}{4x^2+4x-3}&=2x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{2x^2-3x-2}{x^2+3x}\\div\\dfrac{2x^2+x}{x^2+2x-3}\\div\\dfrac{x^2-3x+2}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$\n\nChange each division to multiplication by the reciprocal, then factorise and cancel common factors.",
          "worked": "$$\\begin{align*}\\frac{2x^2-3x-2}{x^2+3x}\\div\\frac{2x^2+x}{x^2+2x-3}\\div\\frac{x^2-3x+2}{x^2}&=\\frac{2x^2-3x-2}{x^2+3x}\\times\\frac{x^2+2x-3}{2x^2+x}\\times\\frac{x^2}{x^2-3x+2}\\\\\\frac{2x^2-3x-2}{x^2+3x}\\div\\frac{2x^2+x}{x^2+2x-3}\\div\\frac{x^2-3x+2}{x^2}&=\\frac{(2x+1)(x-2)}{x(x+3)}\\times\\frac{(x+3)(x-1)}{x(2x+1)}\\times\\frac{x^2}{(x-1)(x-2)}\\\\\\frac{2x^2-3x-2}{x^2+3x}\\div\\frac{2x^2+x}{x^2+2x-3}\\div\\frac{x^2-3x+2}{x^2}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
