  "content": {
    "id": "p15-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Let $f(x)=\\frac34(x^2-4x+3)$ be defined on $[0,4]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\displaystyle\\int_0^4 f(x)\\,dx=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\int_0^4 f(x)\\,dx=\\frac34\\left(\\frac43\\right)=1$.",
          "worked": "$$\\begin{align*}\\int_0^4 f(x)\\,dx&=\\int_0^4\\frac34(x^2-4x+3)\\,dx\\\\\\int_0^4 f(x)\\,dx&=\\frac34\\left[\\frac{x^3}{3}-2x^2+3x\\right]_0^4\\\\\\int_0^4 f(x)\\,dx&=\\frac34\\left(\\frac{64}{3}-32+12\\right)\\\\\\int_0^4 f(x)\\,dx&=\\frac34\\left(\\frac43\\right)\\\\\\int_0^4 f(x)\\,dx&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $f(x)$ is not a valid PDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)<0$ for $1<x<3$, so $f(x)$ is not a valid PDF.",
          "worked": "$$f(x)=\\frac34(x-1)(x-3).$$\nFor $1<x<3$, $(x-1)>0$ and $(x-3)<0$, so $f(x)<0$.\n\nTherefore, $f(x)$ is not a valid PDF because it is not non-negative throughout its domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
