  "content": {
    "id": "v2-1479f-p27-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of a circle with diameter $PQ$, where $P(-3,-8)$ and $Q(7,4)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-2)^2+(y+2)^2=61$",
      "worked": "The centre is the midpoint of the diameter.\n$$\\begin{align*}\\text{Centre}&=\\left(\\frac{-3+7}{2},\\frac{-8+4}{2}\\right)\\\\&=(2,-2).\\end{align*}$$\nUsing the distance from the centre to $Q$:\n$$\\begin{align*}r^2&=(7-2)^2+(4-(-2))^2\\\\&=25+36\\\\&=61.\\end{align*}$$\nHence the equation is $(x-2)^2+(y+2)^2=61$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
