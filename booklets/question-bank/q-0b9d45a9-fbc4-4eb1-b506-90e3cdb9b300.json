        "id": "p68-q4a",
        "type": "part",
        "label": "a",
        "prompt": "Medicare levy is 2% of the taxable income. How much is Mia’s Medicare levy?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2496",
          "worked": "$$\\begin{align*}\\text{Medicare levy} &= 0.02\\times124\\,800\\\\\\text{Medicare levy} &= \\$2496\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p68-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the total amount of tax due, including the Medicare levy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$33 739, including the Medicare levy.",
          "worked": "Using the 2022–23 tax table, Mia’s taxable income is in the \\$120 001–\\$180 000 bracket.\n\n$$\\begin{align*}\\text{Excess} &= 124\\,800-120\\,000\\\\\\text{Excess} &= 4800\\\\\\text{Income tax} &= 29\\,467+0.37\\times4800\\\\\\text{Income tax} &= \\$31\\,243\\\\\\text{Total tax} &= 31\\,243+2496\\\\\\text{Total tax} &= \\$33\\,739\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
