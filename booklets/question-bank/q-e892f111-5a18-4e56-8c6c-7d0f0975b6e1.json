    "label": "4",
    "prompt": "How many different numbers can be made by arranging the digits in 123123?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$90$",
      "worked": "There are 6 digits, with two each of 1, 2 and 3.\n$$\\begin{align*}N&=\\frac{6!}{2!2!2!}\\\\N&=90\\end{align*}$$",
