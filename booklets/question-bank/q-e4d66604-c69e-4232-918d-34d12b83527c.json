  "content": {
    "id": "p24-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The cost per person ($c$), in dollars, to attend a formal dance varies inversely with the number of people ($n$) attending. When 90 people attend, the cost is $\\$60$ per person.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "If only 80 people attend the formal dance, how much will each person have to pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$67.50$",
          "worked": "$$\\begin{aligned}c&=\\frac{k}{n}\\\\60&=\\frac{k}{90}\\\\k&=5400\\\\c&=\\frac{5400}{n}\\\\c&=\\frac{5400}{80}\\\\c&=67.50\\end{aligned}$$\nEach person pays $\\$67.50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p24-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The organising committee has suggested a cost per ticket of $\\$40$.\nHow many people need to attend the formal dance for the tickets to be $\\$40$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "135 people",
          "worked": "$$\\begin{aligned}c&=\\frac{k}{n}\\\\60&=\\frac{k}{90}\\\\k&=5400\\\\c&=\\frac{5400}{n}\\\\40&=\\frac{5400}{n}\\\\40n&=5400\\\\n&=135\\end{aligned}$$\n135 people need to attend.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
