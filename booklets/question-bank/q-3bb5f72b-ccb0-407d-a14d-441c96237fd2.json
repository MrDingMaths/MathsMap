  "content": {
    "id": "p14-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$(a^3b^2)^3\\times(a^2b^4)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^7b^2$",
          "worked": "$$\\begin{aligned}(a^3b^2)^3\\times(a^2b^4)^{-1}&=a^9b^6\\times\\frac{1}{a^2b^4}\\\\&=a^{9-2}b^{6-4}\\\\&=a^7b^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2a^3b^2}{a^{-3}}\\times\\dfrac{2a^2b^5}{b^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^8b^3$",
          "worked": "$$\\begin{aligned}\\frac{2a^3b^2}{a^{-3}}\\times\\frac{2a^2b^5}{b^4}&=2a^6b^2\\times2a^2b\\\\&=4a^{6+2}b^{2+1}\\\\&=4a^8b^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{(3rs^2)^4}{r^{-3}s^4}\\times\\dfrac{(2r^2s)^2}{s^7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{324r^{11}}{s}$",
          "worked": "$$\\begin{aligned}\\frac{(3rs^2)^4}{r^{-3}s^4}\\times\\frac{(2r^2s)^2}{s^7}&=\\frac{81r^4s^8}{r^{-3}s^4}\\times\\frac{4r^4s^2}{s^7}\\\\&=81r^7s^4\\times4r^4s^{-5}\\\\&=324r^{11}s^{-1}\\\\&=\\frac{324r^{11}}{s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4(x^{-2}y^4)^2}{x^2y^{-3}}\\times\\dfrac{xy^4}{2x^{-2}y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2y^{14}}{x^3}$",
          "worked": "$$\\begin{aligned}\\frac{4(x^{-2}y^4)^2}{x^2y^{-3}}\\times\\frac{xy^4}{2x^{-2}y}&=\\frac{4x^{-4}y^8}{x^2y^{-3}}\\times\\frac{xy^4}{2x^{-2}y}\\\\&=4x^{-6}y^{11}\\times\\frac{x^3y^3}{2}\\\\&=2x^{-3}y^{14}\\\\&=\\frac{2y^{14}}{x^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\dfrac{a^2b^3}{b^{-2}}\\right)^2\\div\\left(\\dfrac{ab^4}{a^2}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2b^{18}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{a^2b^3}{b^{-2}}\\right)^2\\div\\left(\\frac{ab^4}{a^2}\\right)^{-2}&=(a^2b^5)^2\\div\\left(\\frac{a}{b^4}\\right)^2\\\\&=a^4b^{10}\\div\\frac{a^2}{b^8}\\\\&=a^4b^{10}\\times\\frac{b^8}{a^2}\\\\&=a^2b^{18}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\dfrac{m^4n^{-2}}{r^3}\\right)^2\\div\\left(\\dfrac{m^{-3}n^2}{r^3}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{m^{14}}{n^8}$",
          "worked": "$$\\begin{aligned}\\left(\\frac{m^4n^{-2}}{r^3}\\right)^2\\div\\left(\\frac{m^{-3}n^2}{r^3}\\right)^2&=\\frac{m^8n^{-4}}{r^6}\\div\\frac{m^{-6}n^4}{r^6}\\\\&=\\frac{m^8n^{-4}}{r^6}\\times\\frac{r^6}{m^{-6}n^4}\\\\&=m^{14}n^{-8}\\\\&=\\frac{m^{14}}{n^8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
