      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Describe how the graph changes as $b$ increases.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "As $b$ increases, the graph shifts left.",
          "worked": "Increasing $b$ by $h$ shifts every point $h$ units to the left. The shape, amplitude and period stay the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "What happens when $b$ is a multiple of $2\\pi$? Explain why with reference to the unit circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The graph coincides with $y=\\sin x$. Adding a multiple of $2\\pi$ makes whole turns on the unit circle, returning to the same point and hence the same $y$-coordinate.",
          "worked": "If $b=2\\pi n$, where $n$ is an integer, the added angle represents $n$ complete turns on the unit circle. The terminal point, and therefore its $y$-coordinate, is unchanged. Thus $\\sin(x+2\\pi n)=\\sin x$, so the graph returns to its original position.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
