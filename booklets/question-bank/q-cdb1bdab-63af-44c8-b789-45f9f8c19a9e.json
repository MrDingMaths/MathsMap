  "content": {
    "id": "p62-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "Write $3x^2+18x-5$ in the form $\\dfrac{(x-a)^2+c}{b}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{(x+3)^2-\\frac{32}{3}}{\\left(\\frac{1}{3}\\right)}$",
      "worked": "$$\\begin{align*}3x^2+18x-5&=\\frac{x^2-2ax+a^2+c}{b}\\\\3bx^2+18bx-5b&=x^2-2ax+a^2+c\\end{align*}$$\nEquate coefficients and substitute.\n$$\\begin{align*}3b&=1\\\\b&=\\frac13\\\\18\\left(\\frac13\\right)&=-2a\\\\a&=-3\\\\-5\\left(\\frac13\\right)&=(-3)^2+c\\\\c&=-\\frac{32}{3}\\end{align*}$$\nHence $3x^2+18x-5=\\dfrac{(x+3)^2-\\frac{32}{3}}{\\left(\\frac13\\right)}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 65
  },
