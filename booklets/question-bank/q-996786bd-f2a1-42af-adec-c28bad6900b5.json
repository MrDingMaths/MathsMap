    "type": "question",
    "label": "6",
    "prompt": "Solve $\\frac{x}{3}+5=8$ by:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q6-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "3d1e7efb-788f-4c20-93f4-d00c1dac3bac",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Multiplying both sides by 3 first. ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "(Use the distributive law to multiply every term by 3.)",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+15=24$, so $x=9$.",
          "worked": "$$\\begin{align*}3\\left(\\frac{x}{3}+5\\right)&=3\\times8\\\\x+15&=24\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p37-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Subtracting 5 from both sides first.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}=3$, so $x=9$.",
          "worked": "$$\\begin{align*}\\frac{x}{3}+5-5&=8-5\\\\\\frac{x}{3}&=3\\\\x&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
