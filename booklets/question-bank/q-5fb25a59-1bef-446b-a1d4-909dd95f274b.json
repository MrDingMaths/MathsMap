  "content": {
    "id": "p20-q3",
    "type": "question",
    "label": "3",
    "prompt": "For the cubic polynomial $P(x)=x^3-6x^2+11x-6$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $P(1)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(1)=1-6+11-6=0$.",
          "worked": "$$\\begin{align*}P(1)&=1^3-6(1)^2+11(1)-6\\\\P(1)&=1-6+11-6\\\\P(1)&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Divide $P(x)$ by $x-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Quotient $x^2-5x+6$, remainder 0.",
          "worked": "$$\\begin{array}{r|rrrr}&x^2&-5x&+6&\\\\\\hline x-1&x^3&-6x^2&+11x&-6\\\\&\\underline{x^3}&\\underline{-x^2}&&\\\\&&-5x^2&+11x&\\\\&&\\underline{-5x^2}&\\underline{+5x}&\\\\&&&6x&-6\\\\&&&\\underline{6x}&\\underline{-6}\\\\&&&&0\\end{array}$$\n\nThus the quotient is $x^2-5x+6$ and the remainder is 0.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p20-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, factor $P(x)$ into linear factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x-1)(x-2)(x-3)$.",
          "worked": "$$\\begin{align*}P(x)&=(x-1)(x^2-5x+6)\\\\P(x)&=(x-1)(x-2)(x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
