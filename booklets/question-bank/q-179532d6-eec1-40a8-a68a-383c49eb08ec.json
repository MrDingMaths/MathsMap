  "content": {
    "id": "p12-q8",
    "type": "question",
    "label": "8",
    "prompt": "Consider the straight line $x+2y-4=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "The line is translated 2 units left. Find the equation of the new line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-2=0$",
          "worked": "Replace $x$ with $x+2$.\n$$\\begin{align*}(x+2)+2y-4&=0\\\\x+2y-2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The original line is translated 1 unit down. Find the equation of this third line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-2=0$",
          "worked": "Replace $y$ with $y+1$ in the original equation.\n$$\\begin{align*}x+2(y+1)-4&=0\\\\x+2y-2&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Comment on your answers. A sketch could help.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both translations give the same result.",
          "worked": "Both translated lines have equation $x+2y-2=0$, so they coincide. The original line is $y=-\\frac12x+2$; both translations produce $y=-\\frac12x+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
