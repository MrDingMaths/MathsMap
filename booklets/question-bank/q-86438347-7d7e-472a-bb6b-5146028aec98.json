  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A line with gradient $-\\frac{3}{5}$ passes through the midpoint of $(-8,2)$ and $(-2,20)$.\n\nFind the equation of the line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Midpoint: $(-5,11)$; $y=-\\frac{3}{5}x+8$.",
      "worked": "Midpoint: $\\left(\\frac{-8+(-2)}{2},\\frac{2+20}{2}\\right)=(-5,11)$.\n\n$$\\begin{align*}y-y_1&=m(x-x_1)\\\\y-11&=-\\frac{3}{5}(x+5)\\\\y-11&=-\\frac{3}{5}x-3\\\\y&=-\\frac{3}{5}x+8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
