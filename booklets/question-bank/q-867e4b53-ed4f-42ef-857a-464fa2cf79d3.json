  "content": {
    "id": "p40-q9",
    "type": "question",
    "label": "9",
    "prompt": "Evaluate these expressions by substituting $a = -2$, $b = 6$, $c = -3$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2 - b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}a^2-b &= (-2)^2-6\\\\a^2-b &= 4-6\\\\a^2-b &= -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$a - b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-38$",
          "worked": "$$\\begin{align*}a-b^2 &= (-2)-6^2\\\\a-b^2 &= -2-36\\\\a-b^2 &= -38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$2c + a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$\\begin{align*}2c+a &= 2(-3)+(-2)\\\\2c+a &= -6+(-2)\\\\2c+a &= -8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p40-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$b^2 - c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}b^2-c^2 &= 6^2-(-3)^2\\\\b^2-c^2 &= 36-9\\\\b^2-c^2 &= 27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^3 + c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}a^3+c^2 &= (-2)^3+(-3)^2\\\\a^3+c^2 &= -8+9\\\\a^3+c^2 &= 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p40-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$3ab + ac$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-30$",
          "worked": "$$\\begin{align*}3ab+ac &= 3(-2)(6)+(-2)(-3)\\\\3ab+ac &= -36+6\\\\3ab+ac &= -30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p40-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$c - 2ab$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "$$\\begin{align*}c-2ab &= (-3)-2(-2)(6)\\\\c-2ab &= -3-(-24)\\\\c-2ab &= 21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$abc - (ac)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}abc-(ac)^2 &= (-2)(6)(-3)-\\bigl((-2)(-3)\\bigr)^2\\\\abc-(ac)^2 &= 36-6^2\\\\abc-(ac)^2 &= 36-36\\\\abc-(ac)^2 &= 0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p40-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$c(a + b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12$",
          "worked": "$$\\begin{align*}c(a+b) &= (-3)\\bigl((-2)+6\\bigr)\\\\c(a+b) &= (-3)(4)\\\\c(a+b) &= -12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-j",
        "type": "part",
        "label": "j",
        "prompt": "$a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$a^2=(-2)^2=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-k",
        "type": "part",
        "label": "k",
        "prompt": "$a^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$a^3=(-2)^3=-8$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-l",
        "type": "part",
        "label": "l",
        "prompt": "$a^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$a^4=(-2)^4=16$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-m",
        "type": "part",
        "label": "m",
        "prompt": "$a^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-32$",
          "worked": "$$a^5=(-2)^5=-32$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-n",
        "type": "part",
        "label": "n",
        "prompt": "$c^3+b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-21$",
          "worked": "$$\\begin{align*}c^3+b&=(-3)^3+6\\\\&=-27+6\\\\&=-21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
