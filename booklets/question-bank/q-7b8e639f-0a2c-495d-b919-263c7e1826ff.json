  "content": {
    "id": "p12-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the $x$-coordinate of the point(s) on the curve $y=x^3-12x+1$ where",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "the tangent is horizontal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2$",
          "worked": "$y'=3x^2-12$. A horizontal tangent has gradient zero.\n\n$$\\begin{align*}3x^2-12&=0\\\\x^2&=4\\\\x&=\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p12-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "the tangent has angle of inclination $45^\\circ$ from the positive $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt{\\frac{13}{3}}$",
          "worked": "The tangent gradient is $\\tan45^\\circ=1$.\n\n$$\\begin{align*}3x^2-12&=1\\\\3x^2&=13\\\\x^2&=\\frac{13}{3}\\\\x&=\\pm\\sqrt{\\frac{13}{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p12-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "the normal has gradient $\\frac19$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm1$",
          "worked": "The tangent gradient is the negative reciprocal of $\\frac19$, so it is $-9$.\n\n$$\\begin{align*}3x^2-12&=-9\\\\x^2&=1\\\\x&=\\pm1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
