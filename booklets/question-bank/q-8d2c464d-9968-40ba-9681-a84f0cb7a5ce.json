        "answer": {
          "short": "$-\\frac{\\sqrt2}{2}$",
          "worked": "$-405^\\circ+360^\\circ=-45^\\circ$.\n$$\\begin{align*}\\sin(-405^\\circ)&=\\sin(-45^\\circ)\\\\\\sin(-405^\\circ)&=-\\sin45^\\circ\\\\\\sin(-405^\\circ)&=-\\frac{\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
