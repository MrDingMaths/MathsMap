        "prompt": "$\\cos(-60^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\cos(-60^\\circ)&=\\cos60^\\circ\\\\\\cos(-60^\\circ)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin(-225^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt2}{2}$",
          "worked": "$$\\begin{align*}\\sin(-225^\\circ)&=-\\sin225^\\circ\\\\\\sin(-225^\\circ)&=-\\left(-\\sin45^\\circ\\right)\\\\\\sin(-225^\\circ)&=\\frac{\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(-135^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$-135^\\circ+360^\\circ=225^\\circ$.\n$$\\begin{align*}\\tan(-135^\\circ)&=\\tan225^\\circ\\\\\\tan(-135^\\circ)&=\\tan45^\\circ\\\\\\tan(-135^\\circ)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos(-210^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\cos(-210^\\circ)&=\\cos210^\\circ\\\\\\cos(-210^\\circ)&=-\\cos30^\\circ\\\\\\cos(-210^\\circ)&=-\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(-330^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\cos(-330^\\circ)&=\\cos330^\\circ\\\\\\cos(-330^\\circ)&=\\cos30^\\circ\\\\\\cos(-330^\\circ)&=\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin(-405^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
