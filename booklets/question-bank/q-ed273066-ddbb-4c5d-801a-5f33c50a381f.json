  "content": {
    "id": "p26-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the value of $s$ such that the vectors are perpendicular.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\begin{pmatrix}3\\\\s\\end{pmatrix}$ and $\\begin{pmatrix}4\\\\-6\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=2$",
          "worked": "$$2\\begin{pmatrix}3\\\\s\\end{pmatrix}=\\begin{pmatrix}6\\\\2s\\end{pmatrix}$$\nPerpendicular vectors have component products that add to zero.\n$$\\begin{aligned}6(4)+(2s)(-6)&=0\\\\24-12s&=0\\\\12s&=24\\\\s&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p26-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{pmatrix}4\\\\-5\\end{pmatrix}$ and $\\begin{pmatrix}s\\\\3\\end{pmatrix}+\\begin{pmatrix}2\\\\1\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=3$",
          "worked": "$$\\begin{pmatrix}s\\\\3\\end{pmatrix}+\\begin{pmatrix}2\\\\1\\end{pmatrix}=\\begin{pmatrix}s+2\\\\4\\end{pmatrix}$$\nPerpendicular vectors have component products that add to zero.\n$$\\begin{aligned}4(s+2)+(-5)(4)&=0\\\\4s+8-20&=0\\\\4s-12&=0\\\\4s&=12\\\\s&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
