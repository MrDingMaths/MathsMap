  "content": {
    "id": "p48-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A projectile from the origin follows $y=x\\tan\\theta-\\dfrac{5x^2}{V^2}\\sec^2\\theta$. It is launched at $V=20\\text{ m/s}$ and passes through $(20,10)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\tan^2\\theta-4\\tan\\theta+3=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2\\theta-4\\tan\\theta+3=0$.",
          "worked": "$$\\begin{aligned}\\frac{5x^2}{V^2}&=\\frac{5(400)}{400}=5\\\\10&=20\\tan\\theta-5\\sec^2\\theta\\\\10&=20\\tan\\theta-5(1+\\tan^2\\theta)\\\\5\\tan^2\\theta-20\\tan\\theta+15&=0\\\\\\tan^2\\theta-4\\tan\\theta+3&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p48-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the two possible angles, giving non-exact angles to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45^\\circ$ or $71.6^\\circ$.",
          "worked": "$$\\begin{aligned}(\\tan\\theta-1)(\\tan\\theta-3)&=0\\\\\\tan\\theta&=1\\text{ or }3\\\\\\theta&=45^\\circ\\text{ or }\\tan^{-1}(3)\\\\\\theta&=45^\\circ\\text{ or approximately }71.6^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
