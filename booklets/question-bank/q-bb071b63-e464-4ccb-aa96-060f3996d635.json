  "content": {
    "id": "p8-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "In the expansion of $(2x+1)^n$, the coefficient of $x$ is 18. Find $n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=9$.",
      "worked": "The term involving $x$ is $\\binom{n}{1}(2x)1^{n-1}=2nx$, so its coefficient is $2n$.\n\n$$\\begin{align*}2n&=18\\\\n&=9\\end{align*}$$",
      "solutionDiagrams": []
