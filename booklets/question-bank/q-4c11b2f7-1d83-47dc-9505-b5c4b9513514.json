  "content": {
    "id": "p39-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the unit vector $\\underset{\\sim}{\\hat a}$ if:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=3i+4j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{5}(3i+4j)$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{a}|&=\\sqrt{3^2+4^2}\\\\&=5\\\\\\underset{\\sim}{\\hat a}&=\\frac{\\underset{\\sim}{a}}{|\\underset{\\sim}{a}|}\\\\&=\\frac{1}{5}(3i+4j)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p39-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}=5i-12j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{13}(5i-12j)$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{a}|&=\\sqrt{5^2+(-12)^2}\\\\&=13\\\\\\underset{\\sim}{\\hat a}&=\\frac{\\underset{\\sim}{a}}{|\\underset{\\sim}{a}|}\\\\&=\\frac{1}{13}(5i-12j)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p39-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{a}=-6i+8j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{10}(-6i+8j)$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{a}|&=\\sqrt{(-6)^2+8^2}\\\\&=10\\\\\\underset{\\sim}{\\hat a}&=\\frac{\\underset{\\sim}{a}}{|\\underset{\\sim}{a}|}\\\\&=\\frac{1}{10}(-6i+8j)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
