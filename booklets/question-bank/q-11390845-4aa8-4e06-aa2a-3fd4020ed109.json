  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Determine whether the following functions are continuous or discontinuous at the point where the curve changes equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$f(x)=\\begin{cases}2x+1,&x<0\\\\-4x+1,&x\\geq0\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Continuous at $x=0$.",
          "worked": "At $x=0$, the two formulas give\n$$\\begin{align*}2(0)+1&=1\\\\-4(0)+1&=1.\\end{align*}$$\nBoth sides approach $1$, and $f(0)=1$. The function is continuous at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$f(x)=\\begin{cases}\\dfrac{x}{x+4},&x<-1\\\\[6pt]-\\dfrac13,&x\\geq-1\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Continuous at $x=-1$.",
          "worked": "At $x=-1$, the left-hand formula gives\n$$\\begin{align*}\\frac{-1}{-1+4}&=-\\frac13.\\end{align*}$$\nThe right-hand formula and $f(-1)$ also equal $-\\frac13$. The function is continuous at $x=-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$f(x)=\\begin{cases}x^2+1,&x\\leq0\\\\-1,&x>0\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Discontinuous at $x=0$.",
          "worked": "The left-hand formula gives\n$$0^2+1=1.$$\nThe right-hand formula gives $-1$. The one-sided values differ, so the function is discontinuous at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$f(x)=\\begin{cases}13-x,&x<3\\\\10,&x=3\\\\x^2+1,&x>3\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Continuous at $x=3$.",
          "worked": "At $x=3$, the neighbouring formulas give\n$$\\begin{align*}13-3&=10\\\\3^2+1&=10.\\end{align*}$$\nBoth sides approach $10$, and $f(3)=10$. The function is continuous at $x=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
