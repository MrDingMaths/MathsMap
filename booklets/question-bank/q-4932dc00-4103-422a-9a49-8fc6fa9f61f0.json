            "answer": {
              "short": "$0.75\\text{ g}$",
              "worked": "At $n=0$, the graph gives $M=0.75\\text{ g}$. The empty box has mass $0.75\\text{ g}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p40-q5-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "one matchstick",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.5\\text{ g}$",
              "worked": "Using $(0,0.75)$ and $(10,5.75)$ from the graph:\n$$\\begin{align*}m&=\\frac{5.75-0.75}{10-0}\\\\m&=0.5\\end{align*}$$\nEach matchstick adds $0.5\\text{ g}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      },
      {
        "id": "p40-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation relating mass $M$ and number of matchsticks $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M=0.5n+0.75$",
          "worked": "The gradient is $0.5$ g per matchstick and the initial mass is $0.75$ g.\n$$\\begin{align*}M&=mn+c\\\\M&=0.5n+0.75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ],
