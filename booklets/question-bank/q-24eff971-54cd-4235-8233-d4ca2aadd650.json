  "content": {
    "id": "p9-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Consider the polynomial $P(x)=x^4+8x^3+18x^2+16x+5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $P(-1)$, $P'(-1)$ and $P''(-1)$ are all zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(-1)=P'(-1)=P''(-1)=0$.",
          "worked": "$$\\begin{aligned}P(-1)&=1-8+18-16+5\\\\&=0\\\\P'(x)&=4x^3+24x^2+36x+16\\\\P'(-1)&=-4+24-36+16\\\\&=0\\\\P''(x)&=12x^2+48x+36\\\\P''(-1)&=12-48+36\\\\&=0\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What can be deduced from the results in part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$ is a zero of multiplicity at least $3$, so $(x+1)^3$ is a factor of $P(x)$.",
          "worked": "Since $P(-1)=P'(-1)=P''(-1)=0$, $-1$ is a zero of multiplicity at least $3$. Hence $(x+1)^3$ is a factor of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence use the product of zeroes to find all the zeroes of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$ (triple) and $-5$ (simple).",
          "worked": "Let the zeroes, counted with multiplicity, be $-1,-1,-1,\\alpha$.\n$$\\begin{aligned}(-1)(-1)(-1)\\alpha&=\\frac{5}{1}\\\\-\\alpha&=5\\\\\\alpha&=-5\\end{aligned}$$\nThe zeroes are $-1$ (triple) and $-5$ (simple).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence factor $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x+1)^3(x+5)$.",
          "worked": "The zeroes are $-1,-1,-1,-5$ and the leading coefficient is $1$, so\n$$P(x)=(x+1)^3(x+5).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
