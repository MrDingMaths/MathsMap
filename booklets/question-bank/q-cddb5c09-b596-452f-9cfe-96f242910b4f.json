        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$",
          "worked": "$$\\begin{align*}\\sqrt{63}-\\sqrt{28}&=3\\sqrt{7}-2\\sqrt{7}\\\\\\sqrt{63}-\\sqrt{28}&=\\sqrt{7}\\\\\\sqrt{x}&=\\sqrt{7}\\\\x&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{80}-\\sqrt{45}=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}\\sqrt{80}-\\sqrt{45}&=4\\sqrt{5}-3\\sqrt{5}\\\\\\sqrt{80}-\\sqrt{45}&=\\sqrt{5}\\\\\\sqrt{x}&=\\sqrt{5}\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{24}-\\sqrt{54}=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$",
          "worked": "$$\\begin{align*}2\\sqrt{24}-\\sqrt{54}&=2(2\\sqrt{6})-3\\sqrt{6}\\\\2\\sqrt{24}-\\sqrt{54}&=4\\sqrt{6}-3\\sqrt{6}\\\\2\\sqrt{24}-\\sqrt{54}&=\\sqrt{6}\\\\\\sqrt{x}&=\\sqrt{6}\\\\x&=6\\end{align*}$$",
          "solutionDiagrams": []
