    "answer": {
      "short": "\\$490",
      "worked": "$$\\begin{align*}\\text{Weekly earnings} &= \\text{Retainer} + \\text{Percentage}\\times\\text{Sales}\\\\\\text{Weekly earnings} &= 450 + 0.05\\times800\\\\\\text{Weekly earnings} &= \\$490\\end{align*}$$",
      "solutionDiagrams": []
    },
