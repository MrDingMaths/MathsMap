              "text": "Amy works at Best Bookshop. During one week she sells books valued at $800.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If she earns $450 per week plus 5% commission, how much does she earn in this week?",
              "marks": []
            }
          ]
        }
      ]
    },
