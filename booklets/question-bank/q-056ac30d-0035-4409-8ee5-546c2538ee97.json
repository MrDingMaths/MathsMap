        "answer": {
          "short": "$ (x+\\sqrt7)(x-\\sqrt7) $",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q14-bank-e067d2e0-39db-4f88-ab15-49cf41acc58e",
                "type": "paragraph",
