                    "type": "math",
                    "latex": "\\begin{aligned}&{\\color{#24282d}\\mathrel{\\phantom{=}}x^2-7}\\\\&\\color{#268cff}=(x+\\sqrt7)(x-\\sqrt7)\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p33-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-\\sqrt5)(x+\\sqrt5)$",
          "worked": "$$\\begin{align*}x^2-5&=x^2-(\\sqrt5)^2\\\\&=(x-\\sqrt5)(x+\\sqrt5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-19$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-\\sqrt{19})(x+\\sqrt{19})$",
          "worked": "$$\\begin{align*}x^2-19&=x^2-(\\sqrt{19})^2\\\\&=(x-\\sqrt{19})(x+\\sqrt{19}).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$3x^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt3\\,x-2)(\\sqrt3\\,x+2)$",
          "worked": "$$\\begin{align*}3x^2-4&=(\\sqrt3\\,x)^2-2^2\\\\&=(\\sqrt3\\,x-2)(\\sqrt3\\,x+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$5x^2-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt5\\,x-3)(\\sqrt5\\,x+3)$",
          "worked": "$$\\begin{align*}5x^2-9&=(\\sqrt5\\,x)^2-3^2\\\\&=(\\sqrt5\\,x-3)(\\sqrt5\\,x+3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$-9+2x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt2\\,x-3)(\\sqrt2\\,x+3)$",
          "worked": "$$\\begin{align*}-9+2x^2&=2x^2-9\\\\&=(\\sqrt2\\,x)^2-3^2\\\\&=(\\sqrt2\\,x-3)(\\sqrt2\\,x+3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
