        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{2\\times3}+\\frac{1}{3\\times4}+\\frac{1}{4\\times5}+\\frac{1}{5\\times6}&=\\frac{1}{6}+\\frac{1}{12}+\\frac{1}{20}+\\frac{1}{30}\\\\\\frac{1}{2\\times3}+\\frac{1}{3\\times4}+\\frac{1}{4\\times5}+\\frac{1}{5\\times6}&=\\frac{10+5+3+2}{60}\\\\\\frac{1}{2\\times3}+\\frac{1}{3\\times4}+\\frac{1}{4\\times5}+\\frac{1}{5\\times6}&=\\frac{20}{60}=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
