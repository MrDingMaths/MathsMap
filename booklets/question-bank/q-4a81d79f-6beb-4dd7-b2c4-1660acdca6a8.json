  "content": {
    "id": "p18-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "It is known that the ratio of carrots to turnips in a vegetable garden is $3:2$. If there are 138 turnips in the vegetable garden, how many carrots are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "207 carrots.",
      "worked": "The turnips represent 2 parts.\n$$\\begin{align*}\\text{Number in one part}&=138\\div2\\\\\\text{Number in one part}&=69\\\\\\text{Number of carrots}&=3\\times69\\\\\\text{Number of carrots}&=207\\end{align*}$$\nThere are 207 carrots.",
      "solutionDiagrams": []
    },
