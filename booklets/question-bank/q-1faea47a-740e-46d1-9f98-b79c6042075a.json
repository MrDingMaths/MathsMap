  "content": {
    "id": "p19-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "$80\\%$ of a herd of cattle are Herefords, and $15\\%$ of the Herefords are under one year of age. What percentage of the cattle are Herefords under one year of age?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\%$",
      "worked": "The required percentage is $15\\%$ of $80\\%$.\n\n$$\\begin{align*}15\\%\\text{ of }80\\% &= \\frac{15}{100}\\times\\frac{80}{100}\\\\15\\%\\text{ of }80\\% &= \\frac{3}{25}\\\\15\\%\\text{ of }80\\% &= 12\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
