        "id": "p41-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "State the domain.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>4$",
          "worked": "$$\\begin{align*}x-4&>0\\\\x&>4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p41-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "State the equation of the asymptote.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "The curve approaches the vertical line $x=4$ as $x$ approaches $4$ from the right. The asymptote is $x=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p41-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Determine the $x$-intercept by letting $y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4.125,0)$",
          "worked": "$$\\begin{align*}0&=\\log_2(x-4)+3\\\\\\log_2(x-4)&=-3\\\\x-4&=2^{-3}\\\\x-4&=\\frac18\\\\x&=4+\\frac18\\\\x&=4.125\\end{align*}$$The $x$-intercept is $(4.125,0)$, exactly.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p41-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "State the horizontal and vertical translations applied to the graph of $\\log_2 x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Right by 4, up by 3.",
          "worked": "Replacing $x$ with $x-4$ translates $y=\\log_2 x$ right $4$ units. Adding $3$ translates it up $3$ units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ],
    "diagramPlacement": "right-of-prompt"
