      {
        "id": "v2-475f0d-p5-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\cos(A+B)\\cos(A-B)=\\cos^2A-\\sin^2B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\cos^2A-\\sin^2B=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\cos(A+B)\\cos(A-B)\\\\&=(\\cos A\\cos B-\\sin A\\sin B)(\\cos A\\cos B+\\sin A\\sin B)\\\\&=\\cos^2A\\cos^2B-\\sin^2A\\sin^2B\\\\&=\\cos^2A(1-\\sin^2B)-(1-\\cos^2A)\\sin^2B\\\\&=\\cos^2A-\\cos^2A\\sin^2B-\\sin^2B+\\cos^2A\\sin^2B\\\\&=\\cos^2A-\\sin^2B\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "v2-475f0d-p5-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\tan(A+B)\\tan(A-B)=\\dfrac{\\tan^2A-\\tan^2B}{1-\\tan^2A\\tan^2B}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\tan^2A-\\tan^2B}{1-\\tan^2A\\tan^2B}=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\tan(A+B)\\tan(A-B)\\\\&=\\frac{\\tan A+\\tan B}{1-\\tan A\\tan B}\\times\\frac{\\tan A-\\tan B}{1+\\tan A\\tan B}\\\\&=\\frac{\\tan^2A-\\tan^2B}{1-\\tan^2A\\tan^2B}\\\\&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
