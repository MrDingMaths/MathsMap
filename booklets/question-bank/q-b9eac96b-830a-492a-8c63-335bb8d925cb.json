  "content": {
    "id": "p18-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Find the greatest integer that divides 334, 358 and 376 leaving the same remainder in each case.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6$\n\nFind the GCD of the differences between the numbers.",
      "worked": "A divisor leaving the same remainder must divide the differences between the numbers.\n\n$$\\begin{align*}358-334&=24\\\\376-358&=18\\\\24&=2^3\\times3\\\\18&=2\\times3^2\\\\\\operatorname{GCD}(24,18)&=2\\times3\\\\\\operatorname{GCD}(24,18)&=6\\end{align*}$$\n\nChecking the remainders:\n\n$$\\begin{align*}334&=6\\times55+4\\\\358&=6\\times59+4\\\\376&=6\\times62+4\\end{align*}$$\n\nTherefore, the greatest integer is $6$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 108
  },
