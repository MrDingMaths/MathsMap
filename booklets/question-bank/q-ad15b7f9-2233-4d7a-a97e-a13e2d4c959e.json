    "label": "7",
    "prompt": "In a boxplot, is one whisker always longer than the other?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No.",
      "worked": "No. The whiskers show the distances from the minimum to the lower quartile and from the upper quartile to the maximum. These distances can be equal, so the whiskers can have the same length.",
