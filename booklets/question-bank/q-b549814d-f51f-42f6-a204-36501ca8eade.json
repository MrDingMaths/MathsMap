  "content": {
    "id": "p26-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Mikayla is paid $\\$x$ per hour at her job. Write an expression for each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "How much does Mikayla earn if she works 8 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x$ dollars.",
          "worked": "$$\\begin{align*}E&=8\\times x\\\\E&=8x\\text{ dollars}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Mikayla gets a pay rise of $\\$3$ per hour, what is her new hourly wage?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$ dollars per hour.",
          "worked": "New hourly wage: $x+3$ dollars per hour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p26-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "Mikayla works 8 hours at the increased hourly rate, write how much she earns as an expression.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8(x+3)$ dollars.",
          "worked": "The new hourly rate is $x+3$ dollars per hour.\n$$\\begin{align*}E&=8\\times(x+3)\\\\E&=8(x+3)\\text{ dollars}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
