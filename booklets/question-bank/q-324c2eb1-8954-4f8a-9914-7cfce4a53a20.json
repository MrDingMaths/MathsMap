  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "How many strings of length 3 can be formed using letters from the set $\\{a,b,c\\}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "Each of the three positions has three choices; repetition is allowed.\n\n$$\\begin{align*}N&=3^3\\\\N&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q5b",
        "type": "part",
        "label": "b",
        "prompt": "without repetition",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "The successive positions have three, two and one choices.\n\n$$\\begin{align*}N&=3!\\\\N&=3\\times2\\times1\\\\N&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
