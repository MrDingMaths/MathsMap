  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The range of a set of data is 56. The minimum value is 22. The data in order from smallest to largest is $22, 45, 50, 52, 58, x, 67, 71, y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the maximum value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$78$",
          "worked": "$$\\begin{align*}\\text{Maximum value}&=22+56\\\\\\text{Maximum value}&=78\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the median.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$58$",
          "worked": "There are nine values in order, so the median is the fifth value.\n\n$$\\text{Median}=58$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "The mean is 56.5. Find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=65.5$\n\nMultiply the mean by nine to find the total, then subtract the eight known values.",
          "worked": "From part a, $y=78$.\n\n$$\\begin{align*}\\text{Sum of all nine values}&=9\\times56.5\\\\\\text{Sum of all nine values}&=508.5\\\\\\text{Sum of the eight known values}&=22+45+50+52+58+67+71+78\\\\\\text{Sum of the eight known values}&=443\\\\x&=508.5-443\\\\x&=65.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
