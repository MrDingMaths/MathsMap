        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "Using the two-way table,\n$$\\begin{align*}\\Pr(A'\\cap B)&=0.4-0.1\\\\\\Pr(A'\\cap B)&=0.3\\\\\\Pr(A')&=0.3+0.2\\\\\\Pr(A')&=0.5\\\\\\Pr(B\\mid A')&=\\frac{\\Pr(A'\\cap B)}{\\Pr(A')}\\\\\\Pr(B\\mid A')&=\\frac{0.3}{0.5}\\\\\\Pr(B\\mid A')&=0.6\\end{align*}$$",
          "solutionDiagrams": []
        },
