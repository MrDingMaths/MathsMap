                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\Pr(A\\mid B)&=\\frac{\\Pr(A\\cap B)}{\\Pr(B)}\\\\\\Pr(A\\mid B)&=\\frac{0.1}{0.4}\\\\\\Pr(A\\mid B)&=0.25\\end{aligned}",
