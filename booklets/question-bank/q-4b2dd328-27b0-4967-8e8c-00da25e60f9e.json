    "id": "p8-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "$x$ kg of a swimming pool chemical cost $\\$90$. How much, in terms of $x$, did 1 kg cost?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\$90}{x}$",
      "worked": "Divide the total cost by the number of kilograms.\n$$\\begin{align*}\\text{Cost of 1 kg}&=\\$90\\div x\\\\\\text{Cost of 1 kg}&=\\frac{\\$90}{x}.\\end{align*}$$",
      "solutionDiagrams": []
    },
