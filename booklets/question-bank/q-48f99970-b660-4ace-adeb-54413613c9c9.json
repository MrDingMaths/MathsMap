  "content": {
    "id": "p44-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Differentiate the following with respect to $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(3x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(3x-2)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2(3x-2)(3)\\\\\\frac{dy}{dx}&=6(3x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p44-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(3x^2-5)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24x(3x^2-5)^3$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=4(3x^2-5)^3(6x)\\\\\\frac{dy}{dx}&=24x(3x^2-5)^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p44-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\sqrt{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{\\sqrt{x^2+1}}$",
          "worked": "$$\\begin{align*}y&=(x^2+1)^{\\frac12}\\\\\\frac{dy}{dx}&=\\frac12(x^2+1)^{-\\frac12}(2x)\\\\\\frac{dy}{dx}&=\\frac{x}{\\sqrt{x^2+1}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{1}{x^3-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{x(3x-2)}{(x^3-x^2)^2}$",
          "worked": "$$\\begin{align*}y&=(x^3-x^2)^{-1}\\\\\\frac{dy}{dx}&=-(x^3-x^2)^{-2}(3x^2-2x)\\\\\\frac{dy}{dx}&=-\\frac{x(3x-2)}{(x^3-x^2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{1}{\\sqrt{1-x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{\\sqrt{(1-x^2)^3}}$",
          "worked": "$$\\begin{align*}y&=(1-x^2)^{-\\frac12}\\\\\\frac{dy}{dx}&=-\\frac12(1-x^2)^{-\\frac32}(-2x)\\\\\\frac{dy}{dx}&=\\frac{x}{\\sqrt{(1-x^2)^3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p44-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(x+\\frac{1}{x}\\right)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\left(x+\\frac{1}{x}\\right)^3\\left(1-\\frac{1}{x^2}\\right)$",
          "worked": "Let $u=x+\\frac1x$.\n\n$$\\begin{align*}\\frac{du}{dx}&=1-\\frac1{x^2}\\\\\\frac{d}{dx}(u^4)&=4u^3\\frac{du}{dx}\\\\\\frac{d}{dx}\\left(x+\\frac1x\\right)^4&=4\\left(x+\\frac1x\\right)^3\\left(1-\\frac1{x^2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
