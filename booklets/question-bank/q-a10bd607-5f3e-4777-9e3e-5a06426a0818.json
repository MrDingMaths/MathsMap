    "label": "39",
    "prompt": "The fourth, sixth and eighth terms of an AP add to $-6$. Find the sixth term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a_6=-2$",
      "worked": "$$\\begin{align*}a_4+a_6+a_8&=-6\\\\(a+3d)+(a+5d)+(a+7d)&=-6\\\\3a+15d&=-6\\\\a+5d&=-2\\\\\\therefore\\ a_6=a+5d&=-2\\end{align*}$$",
