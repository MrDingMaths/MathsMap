  "content": {
    "id": "p36-q11",
    "type": "question",
    "label": "11",
    "prompt": "Use the formula $P(A\\mid B)=\\dfrac{P(A\\cap B)}{P(B)}$ to answer the following questions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P(A\\mid B)$ if $P(A\\cap B)=0.5$ and $P(B)=0.7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{7}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p36-q11-a-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\P(A\\mid B)&=\\frac{0.5}{0.7}\\\\P(A\\mid B)&=\\frac{5}{7}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
