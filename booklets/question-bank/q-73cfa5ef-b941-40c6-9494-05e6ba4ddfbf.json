            "inlines": [
              {
                "type": "text",
                "text": "Subtract the picture's width from the wall's width, then halve the remaining distance.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}5\\text{ m}&=500\\text{ cm}\\\\\\text{Remaining width}&=500\\text{ cm}-60\\text{ cm}\\\\\\text{Remaining width}&=440\\text{ cm}\\\\\\text{Left-hand distance}&=440\\text{ cm}\\div2\\\\\\text{Left-hand distance}&=220\\text{ cm}\\end{align*}$$\nThe picture is centred, so the remaining width is shared equally between the two sides.",
