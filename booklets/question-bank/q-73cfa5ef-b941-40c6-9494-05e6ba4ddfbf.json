    "type": "question",
    "label": "10",
    "prompt": "A picture, which is 60 cm wide, is to be placed in the centre of a wall. The length of the wall from left to right is 5 m. What is the distance between the left-hand edge of the picture and the left-hand edge of the wall?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
