    "label": "10",
    "prompt": "A discount of $15\\%$ is offered on the price of a book. The discounted price is $\\$136$. What was the original price?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$160$",
      "worked": "The discounted price represents $100\\%-15\\%=85\\%$ of the original price.\n\n$$\\begin{align*}\\text{Value of }1\\%&=\\$136\\div85\\\\\\text{Value of }1\\%&=\\$1.60\\\\\\text{Original price}&=\\$1.60\\times100\\\\\\text{Original price}&=\\$160\\end{align*}$$",
      "solutionDiagrams": []
