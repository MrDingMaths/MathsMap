        "type": "part",
        "label": "b",
        "prompt": "${}^{n}C_7={}^{n}C_3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=10$.",
          "worked": "The lower indices are different, so symmetry gives\n$$\\begin{align*}n-7&=3\\\\n&=10.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p69-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "${}^{n}C_6+{}^{n}C_5={}^{11}C_6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=10$.",
          "worked": "Using Pascal's identity,\n$$\\begin{align*}{}^{n+1}C_6&={}^{11}C_6\\\\n+1&=11\\\\n&=10.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
