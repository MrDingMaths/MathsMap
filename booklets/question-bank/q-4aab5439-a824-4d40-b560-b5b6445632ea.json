  "content": {
    "id": "p20-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "By how much does the circumference of a circle increase if we increase its diameter by $\\pi$ units?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\pi^2$ units",
      "worked": "Let the original diameter be $d$ units. Using $C=\\pi d$:\n\n$$\\begin{align*}\\text{Increase in circumference}&=\\pi(d+\\pi)-\\pi d\\\\\\text{Increase in circumference}&=\\pi d+\\pi^2-\\pi d\\\\\\text{Increase in circumference}&=\\pi^2\\text{ units}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
