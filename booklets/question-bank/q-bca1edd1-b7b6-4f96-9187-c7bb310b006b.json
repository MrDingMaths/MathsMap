  "content": {
    "id": "p4-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Convert each of the following percentages into a fully simplified fraction:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$60\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{align*}60\\%&=\\frac{60}{100}\\\\60\\%&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$75\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac34$",
          "worked": "$$\\begin{align*}75\\%&=\\frac{75}{100}\\\\75\\%&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$15\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{20}$",
          "worked": "$$\\begin{align*}15\\%&=\\frac{15}{100}\\\\15\\%&=\\frac3{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$130\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{10}$",
          "worked": "$$\\begin{align*}130\\%&=\\frac{130}{100}\\\\130\\%&=\\frac{13}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$115\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{23}{20}$",
          "worked": "$$\\begin{align*}115\\%&=\\frac{115}{100}\\\\115\\%&=\\frac{23}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p4-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$1.5\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{200}$",
          "worked": "$$\\begin{align*}1.5\\%&=\\frac{1.5}{100}\\\\1.5\\%&=\\frac{15}{1000}\\\\1.5\\%&=\\frac3{200}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$0.02\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{5000}$",
          "worked": "$$\\begin{align*}0.02\\%&=\\frac{0.02}{100}\\\\0.02\\%&=\\frac2{10000}\\\\0.02\\%&=\\frac1{5000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q3-h",
