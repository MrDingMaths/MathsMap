        "answer": {
          "short": "$\\frac{13}{625}$",
          "worked": "$$\\begin{align*}2.08\\%&=\\frac{2.08}{100}\\\\2.08\\%&=\\frac{208}{10000}\\\\2.08\\%&=\\frac{13}{625}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
