        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{50000}$",
          "worked": "$$\\begin{align*}0.002\\%&=\\frac{0.002}{100}\\\\0.002\\%&=\\frac2{100000}\\\\0.002\\%&=\\frac1{50000}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$2.08\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
