    "type": "question",
    "label": "8",
    "prompt": "A ball’s radius is doubled. How many times as large is the new ball’s volume?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "8 times as large.",
      "worked": "$\\begin{aligned}V_{\\text{original}}&=\\frac43\\pi r^3\\\\V_{\\text{new}}&=\\frac43\\pi(2r)^3\\\\&=8\\left(\\frac43\\pi r^3\\right)\\\\&=8V_{\\text{original}}\\end{aligned}$\nThe new ball’s volume is 8 times as large.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
