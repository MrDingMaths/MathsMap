  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose $a<0$. Solve:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$ax-b<c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\dfrac{c+b}{a}$",
          "worked": "$$\\begin{align*}ax-b&<c\\\\ax&<c+b\\\\\\frac{ax}{a}&>\\frac{c+b}{a}\\\\x&>\\frac{c+b}{a}\\end{align*}$$\nThe inequality reverses when dividing by $a<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$b-ax\\le c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le\\dfrac{b-c}{a}$",
          "worked": "$$\\begin{align*}b-ax&\\le c\\\\ax&\\ge b-c\\\\\\frac{ax}{a}&\\le\\frac{b-c}{a}\\\\x&\\le\\frac{b-c}{a}\\end{align*}$$\nThe inequality reverses when dividing by $a<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$a(x-b)\\ge c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le\\dfrac{c}{a}+b$",
          "worked": "$$\\begin{align*}a(x-b)&\\ge c\\\\x-b&\\le\\frac{c}{a}\\\\x&\\le\\frac{c}{a}+b\\end{align*}$$\nThe inequality reverses when dividing by $a<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$a(b-x)>c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>b-\\dfrac{c}{a}$",
          "worked": "$$\\begin{align*}a(b-x)&>c\\\\b-x&<\\frac{c}{a}\\\\-x&<\\frac{c}{a}-b\\\\x&>b-\\frac{c}{a}\\end{align*}$$\nReverse the inequality when dividing by $a<0$, and again when multiplying by $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
