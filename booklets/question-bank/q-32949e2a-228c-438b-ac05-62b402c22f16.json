    "type": "question",
    "label": "23",
    "prompt": "A rectangle has area $30\\text{ cm}^2$ and length $\\sqrt5\\text{ cm}$. Find its perimeter.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14\\sqrt5\\text{ cm}$",
      "worked": "$$\\begin{align*}w&=\\frac{30}{\\sqrt5}\\\\w&=\\frac{30\\sqrt5}{5}\\\\w&=6\\sqrt5\\text{ cm}\\\\P&=2(\\sqrt5+6\\sqrt5)\\\\P&=14\\sqrt5\\text{ cm}.\\end{align*}$$",
