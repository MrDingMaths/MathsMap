  "content": {
    "id": "p27-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the scale factor of each diagram, map or photograph described below. Give each answer as a ratio of two numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Two towns $3600\\text{ km}$ apart are $12\\text{ cm}$ apart on a map.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:30000000$",
          "worked": "$3600\\text{ km}=360000000\\text{ cm}$.\n$$\\begin{align*}\\text{Scale}&=12:360000000\\\\\\text{Scale}&=1:30000000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "A tree that is $80\\text{ m}$ tall measures $4\\text{ cm}$ on a photograph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:2000$",
          "worked": "$80\\text{ m}=8000\\text{ cm}$.\n$$\\begin{align*}\\text{Scale}&=4:8000\\\\\\text{Scale}&=1:2000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "A flea that is $3\\text{ mm}$ long measures $15\\text{ cm}$ on a microscope photograph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50:1$",
          "worked": "$15\\text{ cm}=150\\text{ mm}$.\n$$\\begin{align*}\\text{Scale}&=150:3\\\\\\text{Scale}&=50:1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p27-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A hair that is $0.03\\text{ mm}$ thick is $2\\text{ cm}$ thick on a microscope photograph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2000:3$",
          "worked": "$2\\text{ cm}=20\\text{ mm}$.\n$$\\begin{align*}\\text{Scale}&=20:0.03\\\\\\text{Scale}&=2000:3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p27-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "A model aeroplane has a wingspan of $3.2\\text{ m}$, and the actual aeroplane has a wingspan of $80\\text{ m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:25$",
          "worked": "$$\\begin{align*}\\text{Scale}&=3.2:80\\\\\\text{Scale}&=1:25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p27-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "A galaxy that is $120$ light years across measures $10\\text{ cm}$ on a telescope photograph. (You may take $1$ light year to be $10^{16}\\text{ m}$.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:(1.2\\times10^{19})$\n\nExpress both lengths in the same unit before simplifying drawing length : actual length.",
          "worked": "$$\\begin{align*}\\text{Actual diameter}&=120\\times10^{16}\\text{ m}\\\\\\text{Actual diameter}&=1.2\\times10^{18}\\text{ m}\\\\\\text{Actual diameter}&=1.2\\times10^{20}\\text{ cm}\\\\\\text{Scale}&=10:(1.2\\times10^{20})\\\\\\text{Scale}&=1:(1.2\\times10^{19})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
