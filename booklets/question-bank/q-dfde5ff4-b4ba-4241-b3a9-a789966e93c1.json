  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the indicated terms of each of the following geometric sequences:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $a_{n+1}=2a_n$ and $a_1=3$, find $a_4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "The common ratio is $r=2$.\n$$\\begin{align*}a_4&=a_1r^3\\\\a_4&=3\\times2^3\\\\a_4&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $a_{n+1}=3a_n$ and $a_1=2$, find $a_5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$162$",
          "worked": "The common ratio is $r=3$.\n$$\\begin{align*}a_5&=a_1r^4\\\\a_5&=2\\times3^4\\\\a_5&=162\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $a_{n+1}=\\frac12a_n$ and $a_1=80$, find $a_4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "The common ratio is $r=\\frac12$.\n$$\\begin{align*}a_4&=a_1r^3\\\\a_4&=80\\left(\\frac12\\right)^3\\\\a_4&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4d",
        "type": "part",
        "label": "d",
        "prompt": "Given that $a_{n+1}=\\sqrt2a_n$ and $a_1=5$, find $a_5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "The common ratio is $r=\\sqrt2$.\n$$\\begin{align*}a_5&=a_1r^4\\\\a_5&=5(\\sqrt2)^4\\\\a_5&=5\\times4\\\\a_5&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4e",
        "type": "part",
        "label": "e",
        "prompt": "Given that $a_{n+1}=5a_n$ and $a_3=2$, find $a_5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50$",
          "worked": "Multiply the third term by the common ratio twice.\n$$\\begin{align*}a_5&=a_3r^2\\\\a_5&=2\\times5^2\\\\a_5&=50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q4f",
        "type": "part",
        "label": "f",
        "prompt": "Given that $a_{n+1}=\\frac13a_n$ and $a_4=1$, find $a_1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "The common ratio is $r=\\frac13$.\n$$\\begin{align*}a_4&=a_1r^3\\\\1&=a_1\\left(\\frac13\\right)^3\\\\1&=\\frac{a_1}{27}\\end{align*}$$\nHence $a_1=27$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
