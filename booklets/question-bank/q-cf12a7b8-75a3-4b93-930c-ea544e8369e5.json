  "content": {
    "id": "p24-q20-answer",
    "type": "question",
    "label": "20",
    "prompt": "Two dice are rolled. What is the probability that only one of the dice shows a six?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{18}$",
      "worked": "Exactly one six occurs as $(6,\\text{not }6)$ or $(\\text{not }6,6)$. These outcomes are mutually exclusive.\n\n$$\\begin{align*}P(\\text{exactly one six}) &= P(6,\\text{not }6)+P(\\text{not }6,6)\\\\&=\\frac{1}{6}\\times\\frac{5}{6}+\\frac{5}{6}\\times\\frac{1}{6}\\\\&=\\frac{5}{18}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
