  "content": {
    "id": "v2-a6eb5da01-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "The concentration of a medicine in a patient's blood in mg/L is given by $C=45e^{-0.18t}$ where $t$ is in hours. Find the concentration after 4 hours and after 12 hours, rounding to 2 d.p. Then state what the concentration becomes as $t\\to\\infty$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "After 4 hours $21.90\\text{ mg/L}$; after 12 hours $5.19\\text{ mg/L}$; the concentration approaches $0\\text{ mg/L}$.",
      "worked": "$$\\begin{align*}C(4)&=45e^{-0.18(4)}\\\\C(4)&=45e^{-0.72}\\\\C(4)&\\approx21.90\\text{ mg/L}\\end{align*}$$\n$$\\begin{align*}C(12)&=45e^{-0.18(12)}\\\\C(12)&=45e^{-2.16}\\\\C(12)&\\approx5.19\\text{ mg/L}\\end{align*}$$\nAs $t\\to\\infty$, $e^{-0.18t}\\to0$, so $C\\to0\\text{ mg/L}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
