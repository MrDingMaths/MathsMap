    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{a^3b^2}{ab}\\times\\frac{a^2b}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^3b^2$",
          "worked": "$\\begin{align*}\\frac{a^3b^2}{ab}\\times\\frac{a^2b}{a}&=\\frac{a^5b^3}{a^2b}\\\\\\frac{a^3b^2}{ab}\\times\\frac{a^2b}{a}&=a^3b^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x^3y}{xy^2}\\times\\frac{x^4y^5}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4y^4$",
          "worked": "$\\begin{align*}\\frac{x^3y}{xy^2}\\times\\frac{x^4y^5}{x^2}&=\\frac{x^7y^6}{x^3y^2}\\\\\\frac{x^3y}{xy^2}\\times\\frac{x^4y^5}{x^2}&=x^4y^4\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2ab^2}{3a^2b^4}\\times\\frac{6a^4b^5}{ab}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2b^2$",
          "worked": "$\\begin{align*}\\frac{2ab^2}{3a^2b^4}\\times\\frac{6a^4b^5}{ab}&=\\frac{12a^5b^7}{3a^3b^5}\\\\\\frac{2ab^2}{3a^2b^4}\\times\\frac{6a^4b^5}{ab}&=4a^2b^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{12x^4y^3}{3x^2y}\\times\\frac{x^2y^4}{x^3y^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4xy$",
          "worked": "$\\begin{align*}\\frac{12x^4y^3}{3x^2y}\\times\\frac{x^2y^4}{x^3y^5}&=\\frac{12x^6y^7}{3x^5y^6}\\\\\\frac{12x^4y^3}{3x^2y}\\times\\frac{x^2y^4}{x^3y^5}&=4xy\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{6ab^2}{5a^3b}\\div\\frac{12ab}{15a^5b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3a^2b}{2}$",
          "worked": "$\\begin{align*}\\frac{6ab^2}{5a^3b}\\div\\frac{12ab}{15a^5b}&=\\frac{6ab^2}{5a^3b}\\times\\frac{15a^5b}{12ab}\\\\\\frac{6ab^2}{5a^3b}\\div\\frac{12ab}{15a^5b}&=\\frac{90a^6b^3}{60a^4b^2}\\\\\\frac{6ab^2}{5a^3b}\\div\\frac{12ab}{15a^5b}&=\\frac{3a^2b}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{7x^3y^4}{2xy^2}\\div\\frac{21x^2y^3}{4x^3y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x^3y}{3}$",
          "worked": "$\\begin{align*}\\frac{7x^3y^4}{2xy^2}\\div\\frac{21x^2y^3}{4x^3y^2}&=\\frac{7x^3y^4}{2xy^2}\\times\\frac{4x^3y^2}{21x^2y^3}\\\\\\frac{7x^3y^4}{2xy^2}\\div\\frac{21x^2y^3}{4x^3y^2}&=\\frac{28x^6y^6}{42x^3y^5}\\\\\\frac{7x^3y^4}{2xy^2}\\div\\frac{21x^2y^3}{4x^3y^2}&=\\frac{2x^3y}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{14a^4b^3}{3ab^2}\\div\\frac{7a^5b^4}{6a^3b^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4ab^2$",
          "worked": "$\\begin{align*}\\frac{14a^4b^3}{3ab^2}\\div\\frac{7a^5b^4}{6a^3b^5}&=\\frac{14a^4b^3}{3ab^2}\\times\\frac{6a^3b^5}{7a^5b^4}\\\\\\frac{14a^4b^3}{3ab^2}\\div\\frac{7a^5b^4}{6a^3b^5}&=\\frac{84a^7b^8}{21a^6b^6}\\\\\\frac{14a^4b^3}{3ab^2}\\div\\frac{7a^5b^4}{6a^3b^5}&=4ab^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{12x^2y}{x^3y^4}\\div\\frac{6xy^2}{x^6y^7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^4y^2$",
          "worked": "$\\begin{align*}\\frac{12x^2y}{x^3y^4}\\div\\frac{6xy^2}{x^6y^7}&=\\frac{12x^2y}{x^3y^4}\\times\\frac{x^6y^7}{6xy^2}\\\\\\frac{12x^2y}{x^3y^4}\\div\\frac{6xy^2}{x^6y^7}&=\\frac{12x^8y^8}{6x^4y^6}\\\\\\frac{12x^2y}{x^3y^4}\\div\\frac{6xy^2}{x^6y^7}&=2x^4y^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
