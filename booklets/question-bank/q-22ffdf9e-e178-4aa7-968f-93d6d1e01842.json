  "content": {
    "id": "p44-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Expand these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3-2\\sqrt{7})(\\sqrt{21}-4\\sqrt{3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11\\sqrt{21}-26\\sqrt{3}$",
          "worked": "$$\\begin{align*}(3-2\\sqrt{7})(\\sqrt{21}-4\\sqrt{3})&=3\\sqrt{21}-12\\sqrt{3}-2\\sqrt{147}+8\\sqrt{21}\\\\&=3\\sqrt{21}-12\\sqrt{3}-14\\sqrt{3}+8\\sqrt{21}\\\\&=11\\sqrt{21}-26\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2\\sqrt{6}+5)(\\sqrt{30}-2\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{5}+\\sqrt{30}$",
          "worked": "$$\\begin{align*}(2\\sqrt{6}+5)(\\sqrt{30}-2\\sqrt{5})&=2\\sqrt{180}-4\\sqrt{30}+5\\sqrt{30}-10\\sqrt{5}\\\\&=12\\sqrt{5}-4\\sqrt{30}+5\\sqrt{30}-10\\sqrt{5}\\\\&=2\\sqrt{5}+\\sqrt{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3\\sqrt{5}+1)(\\sqrt{7}+2\\sqrt{35})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31\\sqrt{7}+5\\sqrt{35}$. Use $\\sqrt{175}=5\\sqrt{7}$.",
          "worked": "$$\\begin{align*}(3\\sqrt{5}+1)(\\sqrt{7}+2\\sqrt{35})&=3\\sqrt{35}+6\\sqrt{175}+\\sqrt{7}+2\\sqrt{35}\\\\&=3\\sqrt{35}+30\\sqrt{7}+\\sqrt{7}+2\\sqrt{35}\\\\&=31\\sqrt{7}+5\\sqrt{35}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4\\sqrt{2}+\\sqrt{7})(3\\sqrt{14}-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19\\sqrt{7}+\\sqrt{2}$",
          "worked": "$$\\begin{align*}(4\\sqrt{2}+\\sqrt{7})(3\\sqrt{14}-5)&=12\\sqrt{28}-20\\sqrt{2}+3\\sqrt{98}-5\\sqrt{7}\\\\&=24\\sqrt{7}-20\\sqrt{2}+21\\sqrt{2}-5\\sqrt{7}\\\\&=19\\sqrt{7}+\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3\\sqrt{3}+4)(\\sqrt{6}-2\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}-2\\sqrt{6}$",
          "worked": "$$\\begin{align*}(3\\sqrt{3}+4)(\\sqrt{6}-2\\sqrt{2})&=3\\sqrt{18}-6\\sqrt{6}+4\\sqrt{6}-8\\sqrt{2}\\\\&=9\\sqrt{2}-6\\sqrt{6}+4\\sqrt{6}-8\\sqrt{2}\\\\&=\\sqrt{2}-2\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(5-3\\sqrt{2})(2\\sqrt{10}+3\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{10}+3\\sqrt{5}$",
          "worked": "$$\\begin{align*}(5-3\\sqrt{2})(2\\sqrt{10}+3\\sqrt{5})&=10\\sqrt{10}+15\\sqrt{5}-6\\sqrt{20}-9\\sqrt{10}\\\\&=10\\sqrt{10}+15\\sqrt{5}-12\\sqrt{5}-9\\sqrt{10}\\\\&=\\sqrt{10}+3\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
