  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve each of the following equations:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+2)^2-(x+1)^2=0.$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac32$",
          "worked": "$$\\begin{align*}[(x+2)-(x+1)][(x+2)+(x+1)]&=0\\\\1(2x+3)&=0\\\\2x&=-3\\\\x&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+3)^2-(x+2)^2=0.$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac52$",
          "worked": "$$\\begin{align*}[(x+3)-(x+2)][(x+3)+(x+2)]&=0\\\\1(2x+5)&=0\\\\2x&=-5\\\\x&=-\\frac52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+1)^2-(x-1)^2=0.$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$$\\begin{align*}[(x+1)-(x-1)][(x+1)+(x-1)]&=0\\\\2(2x)&=0\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x-4)^2-(x-2)^2=0.$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}[(x-4)-(x-2)][(x-4)+(x-2)]&=0\\\\-2(2x-6)&=0\\\\2x&=6\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
