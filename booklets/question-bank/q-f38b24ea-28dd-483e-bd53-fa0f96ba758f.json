  "content": {
    "id": "p48-q20-answer",
    "type": "question",
    "label": "20",
    "prompt": "At present, Emma is 24 years older than her daughter. In 8 years’ time she will be 3 times her daughter’s age. What are Emma and her daughter’s present ages?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Emma is 28 years old and her daughter is 4 years old.",
      "worked": "Let $x$ be Emma’s present age and $y$ be her daughter’s present age, in years.\n$$\\begin{align*}x &= y + 24 \\qquad (1) \\\\ x + 8 &= 3(y + 8) \\qquad (2)\\end{align*}$$\nSubstitute (1) into (2).\n$$\\begin{align*}y + 24 + 8 &= 3(y + 8) \\\\ y + 32 &= 3y + 24 \\\\ 8 &= 2y \\\\ y &= 4\\end{align*}$$\nSubstitute $y = 4$ into (1).\n$$\\begin{align*}x &= 4 + 24 \\\\ x &= 28\\end{align*}$$\nEmma is 28 years old and her daughter is 4 years old.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
