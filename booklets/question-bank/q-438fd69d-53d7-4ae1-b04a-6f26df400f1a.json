    "label": "6",
    "prompt": "Form an equation and solve.\n\nIf the sum of half of $q$ and 6 is equal to the sum of one-third of $q$ and 2, find the value of $q$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$q=-24$",
      "worked": "$$\\begin{align*}\\frac{q}{2}+6&=\\frac{q}{3}+2\\\\3q+36&=2q+12\\\\q+36&=12\\\\q&=-24\\end{align*}$$",
