  "content": {
    "id": "p37-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "There are 30 children in a small village. Each pair of children have a grandfather in common (and each child has two distinct grandfathers). Show that at least 20 children have the same grandfather.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p37-q19-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "At least 20 children share a grandfather.",
                "marks": []
              }
            ]
          },
          {
            "id": "p37-q19-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Either all 30 share one grandfather, or all grandfather pairs use just three grandfathers. In the latter case, the 60 grandfather relationships give at least 20 children for one grandfather by the pigeonhole principle.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p37-q19-worked-case",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "If one grandfather is shared by all 30 children, the result follows. Otherwise, choose a child whose grandfathers are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "A",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "B",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p37-q19-worked-second",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Not every child has both of these grandfathers. Choose a child with a different pair. Since the two children share a grandfather, we may name this pair ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\{A,C\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ", where ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "A,B,C",
                "display": false
              },
              {
                "type": "text",
                "text": " are distinct.",
                "marks": []
              }
            ]
          },
          {
            "id": "p37-q19-worked-third",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "As no grandfather is shared by every child, some child does not have ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "A",
                "display": false
              },
              {
                "type": "text",
                "text": ". To share a grandfather with each of the first two children, this child's pair must be ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\{B,C\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p37-q19-worked-restriction",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Every other child must share a grandfather with each of the pairs ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\{A,B\\},\\ \\{A,C\\},\\ \\{B,C\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ". A pair containing a grandfather outside ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\{A,B,C\\}",
                "display": false
              },
              {
                "type": "text",
                "text": " could meet at most two of these three pairs. Therefore every child's two grandfathers belong to ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\{A,B,C\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p37-q19-worked-count",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "There are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "30\\times2=60",
                "display": false
              },
              {
                "type": "text",
                "text": " child–grandfather relationships distributed among three grandfathers. By the generalised pigeonhole principle, one grandfather has at least ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "60\\div3=20",
                "display": false
              },
              {
                "type": "text",
                "text": " of these relationships. Since each child has two distinct grandfathers, these relationships correspond to at least 20 distinct children.",
                "marks": []
              }
            ]
