        "label": "a",
        "prompt": "$\\sqrt{600}+\\sqrt{300}-\\sqrt{216}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{6}+10\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\sqrt{600}+\\sqrt{300}-\\sqrt{216}&=10\\sqrt{6}+10\\sqrt{3}-6\\sqrt{6}\\\\&=4\\sqrt{6}+10\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$4\\sqrt{18}+3\\sqrt{12}-2\\sqrt{50}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}+6\\sqrt{3}$",
          "worked": "$$\\begin{align*}4\\sqrt{18}+3\\sqrt{12}-2\\sqrt{50}&=4(3\\sqrt{2})+3(2\\sqrt{3})-2(5\\sqrt{2})\\\\&=12\\sqrt{2}+6\\sqrt{3}-10\\sqrt{2}\\\\&=2\\sqrt{2}+6\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p30-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{175}-5\\sqrt{140}-3\\sqrt{28}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{7}-10\\sqrt{35}$",
          "worked": "$$\\begin{align*}2\\sqrt{175}-5\\sqrt{140}-3\\sqrt{28}&=2(5\\sqrt{7})-5(2\\sqrt{35})-3(2\\sqrt{7})\\\\&=10\\sqrt{7}-10\\sqrt{35}-6\\sqrt{7}\\\\&=4\\sqrt{7}-10\\sqrt{35}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
