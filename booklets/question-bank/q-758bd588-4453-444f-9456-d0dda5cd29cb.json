    "prompt": "Prove that\n$$\\frac{\\cos(90^\\circ-\\theta)\\sin(180^\\circ-\\theta)}{\\cos(180^\\circ+\\theta)\\cos(-\\theta)}=-\\tan^2\\theta.$$",
    "layout": "list",
