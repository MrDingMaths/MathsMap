  "content": {
    "id": "p14-q5",
    "type": "question",
    "label": "14",
    "prompt": "$(8,15,n)$ satisfies Pythagoras’ theorem.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find two possible values of $n$. Give any non-whole-number answer correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=17$ or $n=\\sqrt{161}\\approx12.69$.",
          "worked": "If $n$ is the largest number:\n$$\\begin{align*}8^2+15^2&=n^2\\\\n^2&=64+225\\\\n^2&=289\\\\n&=17\\end{align*}$$\nIf $n$ is one of the shorter sides, $15$ is the largest number:\n$$\\begin{align*}8^2+n^2&=15^2\\\\n^2&=15^2-8^2\\\\n^2&=161\\\\n&=\\sqrt{161}\\approx12.69\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $17$ is the only answer if the question asks for a Pythagorean triad.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A Pythagorean triad must contain whole numbers; $\\sqrt{161}$ is not a whole number.",
          "worked": "A Pythagorean triad must contain whole numbers. Since $\\sqrt{161}$ is not a whole number, only $n=17$ gives a Pythagorean triad.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
