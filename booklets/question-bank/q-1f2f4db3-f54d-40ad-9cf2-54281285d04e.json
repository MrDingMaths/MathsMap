  "content": {
    "id": "p18-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Given that $t=2\\pi\\sqrt{\\frac{L}{g}}$, find $L$, given that $t=\\pi$ and $g=9.8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$L=2.45$.",
      "worked": "Divide by $2\\pi$, then square both sides.\n\n$$\\begin{align*}\\frac{t}{2\\pi}&=\\sqrt{\\frac{L}{g}}\\\\\\frac{t^2}{4\\pi^2}&=\\frac{L}{g}\\\\L&=\\frac{gt^2}{4\\pi^2}\\\\L&=\\frac{9.8\\times\\pi^2}{4\\pi^2}\\\\L&=\\frac{9.8}{4}\\\\L&=2.45\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
