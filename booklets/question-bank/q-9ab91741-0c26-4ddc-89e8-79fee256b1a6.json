    "label": null,
    "prompt": "Expand and simplify, then evaluate each expression when $x=-2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4f6de-p10-practice-slot-1-2-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$6-2(x-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16-2x$; $20$",
          "worked": "$$\\begin{align*}6-2(x-5)&=6-2x+10\\\\&=16-2x\\\\\\text{When }x=-2:\\quad 16-2(-2)&=16+4\\\\&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-4f6de-p10-practice-slot-1-2-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x(x-4)+3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-5x$; $18$",
          "worked": "$$\\begin{align*}2x(x-4)+3x&=2x^2-8x+3x\\\\&=2x^2-5x\\\\\\text{When }x=-2:\\quad 2(-2)^2-5(-2)&=8+10\\\\&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
