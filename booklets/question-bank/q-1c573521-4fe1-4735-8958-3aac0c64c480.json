    "type": "question",
    "label": "39",
    "prompt": "Find the value of $n$ if $\\binom{n}{0}+\\binom{n}{1}+\\binom{n}{2}=46$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=9$",
      "worked": "$$\\begin{align*}1+n+\\frac{n(n-1)}{2}&=46\\\\2+2n+n(n-1)&=92\\\\n^2+n-90&=0\\\\(n-9)(n+10)&=0\\\\n&=9\\text{ or }-10.\\end{align*}$$\n\nSince $n\\ge2$, $n=9$.",
      "solutionDiagrams": []
    },
