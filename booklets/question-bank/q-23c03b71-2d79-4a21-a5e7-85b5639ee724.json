  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use the Pythagorean identity to rewrite these expressions in terms of $\\cos^2 x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-\\sin^2 x+\\cos^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cos^2 x$",
          "worked": "$$\\begin{aligned}1-\\sin^2 x+\\cos^2 x&=1-(1-\\cos^2 x)+\\cos^2 x\\\\&=2\\cos^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\cos^2 x-5\\sin^2 x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\cos^2 x$",
          "worked": "$$\\begin{aligned}5\\cos^2 x-5\\sin^2 x+5&=5\\cos^2 x-5(1-\\cos^2 x)+5\\\\&=5\\cos^2 x-5+5\\cos^2 x+5\\\\&=10\\cos^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$1-\\sin^2 x+4\\cos^2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\cos^2 x$",
          "worked": "$$\\begin{aligned}1-\\sin^2 x+4\\cos^2 x&=1-(1-\\cos^2 x)+4\\cos^2 x\\\\&=5\\cos^2 x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
