        "answer": {
          "short": "In table order: $\\frac14,\\ 1,\\ 2\\frac14,\\ 4,\\ 6\\frac14$.",
          "worked": "$$\\begin{align*}s\\bigl(\\tfrac12\\bigr)&=\\left(\\tfrac12\\right)^2=\\tfrac14\\\\s(1)&=1^2=1\\\\s\\bigl(1\\tfrac12\\bigr)&=\\left(\\tfrac32\\right)^2=\\tfrac94=2\\tfrac14\\\\s(2)&=2^2=4\\\\s\\bigl(2\\tfrac12\\bigr)&=\\left(\\tfrac52\\right)^2=\\tfrac{25}4=6\\tfrac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
