  "content": {
    "id": "p6-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify these algebraic fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x}{5}-\\dfrac{3x}{2}-\\dfrac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{43x}{30}$",
          "worked": "$$\\begin{align*}\\frac{2x}{5}-\\frac{3x}{2}-\\frac{x}{3}&=\\frac{12x}{30}-\\frac{45x}{30}-\\frac{10x}{30}\\\\&=\\frac{12x-45x-10x}{30}\\\\&=-\\frac{43x}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x}{4}-\\dfrac{2x}{3}+\\dfrac{5x}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x}{12}$",
          "worked": "$$\\begin{align*}\\frac{x}{4}-\\frac{2x}{3}+\\frac{5x}{6}&=\\frac{3x}{12}-\\frac{8x}{12}+\\frac{10x}{12}\\\\&=\\frac{3x-8x+10x}{12}\\\\&=\\frac{5x}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{5x}{8}-\\dfrac{5x}{6}+\\dfrac{3x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13x}{24}$",
          "worked": "$$\\begin{align*}\\frac{5x}{8}-\\frac{5x}{6}+\\frac{3x}{4}&=\\frac{15x}{24}-\\frac{20x}{24}+\\frac{18x}{24}\\\\&=\\frac{15x-20x+18x}{24}\\\\&=\\frac{13x}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+1}{4}+\\dfrac{2x-1}{3}-\\dfrac{x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{43x-5}{60}$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\frac{x+1}{4}+\\frac{2x-1}{3}-\\frac{x}{5}\\\\&=\\frac{15(x+1)}{60}+\\frac{20(2x-1)}{60}-\\frac{12x}{60}\\\\&=\\frac{15(x+1)+20(2x-1)-12x}{60}\\\\&=\\frac{15x+15+40x-20-12x}{60}\\\\&=\\frac{43x-5}{60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p6-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{2x-1}{3}-\\dfrac{2x}{7}+\\dfrac{x-3}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{23x-35}{42}$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\frac{2x-1}{3}-\\frac{2x}{7}+\\frac{x-3}{6}\\\\&=\\frac{14(2x-1)}{42}-\\frac{12x}{42}+\\frac{7(x-3)}{42}\\\\&=\\frac{14(2x-1)-12x+7(x-3)}{42}\\\\&=\\frac{28x-14-12x+7x-21}{42}\\\\&=\\frac{23x-35}{42}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p6-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1-2x}{5}-\\dfrac{3x}{8}+\\dfrac{3x+1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{28+29x}{40}$",
          "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}\\frac{1-2x}{5}-\\frac{3x}{8}+\\frac{3x+1}{2}\\\\&=\\frac{8(1-2x)}{40}-\\frac{15x}{40}+\\frac{20(3x+1)}{40}\\\\&=\\frac{8(1-2x)-15x+20(3x+1)}{40}\\\\&=\\frac{8-16x-15x+60x+20}{40}\\\\&=\\frac{28+29x}{40}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
