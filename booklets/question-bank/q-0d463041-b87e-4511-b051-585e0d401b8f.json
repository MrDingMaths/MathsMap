  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The total surface area $S\\text{ cm}^2$ of a cylinder is given in terms of its radius $r\\text{ cm}$ and height $h\\text{ cm}$ by the formula $S=2\\pi r(r+h)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Express this formula with $h$ as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{S}{2\\pi r}-r$",
          "worked": "$$\\begin{align*}S&=2\\pi r(r+h)\\\\\\frac{S}{2\\pi r}&=r+h\\\\h&=\\frac{S}{2\\pi r}-r\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the height of such a cylinder if the radius is $7\\text{ cm}$ and the total surface area is $500\\text{ cm}^2$? Calculate your answer in centimetres, correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.37\\text{ cm}$",
          "worked": "$$\\begin{align*}h&=\\frac{500}{2\\pi\\times7}-7\\\\h&=\\frac{250}{7\\pi}-7\\\\h&\\approx4.37\\end{align*}$$\nThe height is $4.37\\text{ cm}$, correct to 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
