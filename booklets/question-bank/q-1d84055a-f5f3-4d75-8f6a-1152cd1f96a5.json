  "content": {
    "id": "p12-q6-content",
    "type": "question",
    "label": "6",
    "prompt": "$\\$8400$ is invested for 3 years at 6% p.a. interest, compounded yearly.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the value of the investment after 3 years. Answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10\\,004.53$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n \\\\ FV &= 8400(1+0.06)^3 \\\\ FV &= 10004.5344 \\\\ FV &\\approx \\$10\\,004.53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the total amount of interest earned? Answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1604.53$",
          "worked": "$$\\begin{align*}I &= FV-PV \\\\ I &= 10004.5344-8400 \\\\ I &\\approx \\$1604.53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
