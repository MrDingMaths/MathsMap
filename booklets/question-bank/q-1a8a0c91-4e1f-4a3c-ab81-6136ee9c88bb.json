        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}x+3y&=4\\\\x+2y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,1)$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}y&=1\\\\x+2(1)&=3\\\\x+2&=3\\\\x&=1\\end{align*}$$\nTherefore, $(x,y)=(1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p22-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}3x+y&=4\\\\x+y&=2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,1)$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}2x&=2\\\\x&=1\\\\1+y&=2\\\\y&=1\\end{align*}$$\nTherefore, $(x,y)=(1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p22-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}3x+2y&=4\\\\x+2y&=10\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-3,\\frac{13}{2}\\right)$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}2x&=-6\\\\x&=-3\\\\-3+2y&=10\\\\2y&=13\\\\y&=\\frac{13}{2}\\end{align*}$$\nTherefore, $(x,y)=\\left(-3,\\frac{13}{2}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p22-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}3x+7y&=3\\\\3x+3y&=1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac16,\\frac12\\right)$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}4y&=2\\\\y&=\\frac12\\\\3x+3\\left(\\frac12\\right)&=1\\\\3x+\\frac32&=1\\\\3x&=-\\frac12\\\\x&=-\\frac16\\end{align*}$$\nTherefore, $(x,y)=\\left(-\\frac16,\\frac12\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 82
      },
      {
        "id": "p22-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}2x+y&=6\\\\2x+4y&=9\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac52,1\\right)$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}3y&=3\\\\y&=1\\\\2x+1&=6\\\\2x&=5\\\\x&=\\frac52\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac52,1\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p22-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}2x+3y&=1\\\\5x+3y&=-5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-2,\\frac53\\right)$",
          "worked": "Subtract the first equation from the second.\n$$\\begin{align*}3x&=-6\\\\x&=-2\\\\2(-2)+3y&=1\\\\-4+3y&=1\\\\3y&=5\\\\y&=\\frac53\\end{align*}$$\nTherefore, $(x,y)=\\left(-2,\\frac53\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p22-q15-g",
