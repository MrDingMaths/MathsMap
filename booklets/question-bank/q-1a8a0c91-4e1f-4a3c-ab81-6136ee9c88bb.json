        "answer": {
          "short": "$(x,y)=(2,-1)$",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}4y&=-4\\\\y&=-1\\\\x-1&=1\\\\x&=2\\end{align*}$$\nTherefore, $(x,y)=(2,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
