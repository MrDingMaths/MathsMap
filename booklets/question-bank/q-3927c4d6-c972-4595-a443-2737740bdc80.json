      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the curve through the origin whose gradient is $\\dfrac{dy}{dx}=3x^4-x^3+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{3x^5}{5}-\\dfrac{x^4}{4}+x$",
          "worked": "$$\\begin{aligned}y&=\\frac{3x^5}{5}-\\frac{x^4}{4}+x+C\\\\0&=\\frac{3(0)^5}{5}-\\frac{(0)^4}{4}+0+C\\\\C&=0\\\\y&=\\frac{3x^5}{5}-\\frac{x^4}{4}+x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the curve passing through $(2,6)$ with gradient function $\\dfrac{dy}{dx}=2+3x^2-x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{x^4}{4}+x^3+2x-2$",
          "worked": "$$\\begin{aligned}y&=2x+x^3-\\frac{x^4}{4}+C\\\\6&=2(2)+(2)^3-\\frac{(2)^4}{4}+C\\\\6&=8+C\\\\C&=-2\\\\y&=-\\frac{x^4}{4}+x^3+2x-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the curve through the point $\\left(\\dfrac{1}{5},1\\right)$ with gradient function $y'=(2-5x)^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\dfrac{(2-5x)^4}{20}+\\dfrac{21}{20}$",
          "worked": "$$\\begin{aligned}y&=\\frac{(2-5x)^4}{-5(4)}+C\\\\y&=-\\frac{(2-5x)^4}{20}+C\\\\1&=-\\frac{\\left(2-5\\left(\\frac15\\right)\\right)^4}{20}+C\\\\1&=-\\frac1{20}+C\\\\C&=\\frac{21}{20}\\\\y&=-\\frac{(2-5x)^4}{20}+\\frac{21}{20}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
