  "content": {
    "id": "p18-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Use the product, quotient and chain rules as appropriate to differentiate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q8-a",
        "type": "part",
        "label": "a",
        "prompt": ": $y=(e^{2x}+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=6e^{2x}(e^{2x}+1)^2$",
          "worked": "$$\\begin{align*}y'&=3(e^{2x}+1)^2\\cdot 2e^{2x}\\\\y'&=6e^{2x}(e^{2x}+1)^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(e^x+e^{-x})^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4(e^x-e^{-x})(e^x+e^{-x})^3$",
          "worked": "$$\\begin{align*}y'&=4(e^x+e^{-x})^3(e^x-e^{-x})\\\\y'&=4(e^x-e^{-x})(e^x+e^{-x})^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(1+x^2)e^{1+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(x+1)^2e^{1+x}$",
          "worked": "$$\\begin{align*}y'&=2xe^{1+x}+(1+x^2)e^{1+x}\\\\y'&=(x^2+2x+1)e^{1+x}\\\\y'&=(x+1)^2e^{1+x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p18-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(x^2-x)e^{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(2x^2-1)e^{2x-1}$",
          "worked": "$$\\begin{align*}y'&=(2x-1)e^{2x-1}+2(x^2-x)e^{2x-1}\\\\y'&=(2x-1+2x^2-2x)e^{2x-1}\\\\y'&=(2x^2-1)e^{2x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p18-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{e^x}{e^x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{e^x}{(e^x+1)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{e^x(e^x+1)-e^x(e^x)}{(e^x+1)^2}\\\\y'&=\\frac{e^{2x}+e^x-e^{2x}}{(e^x+1)^2}\\\\y'&=\\frac{e^x}{(e^x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p18-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{e^x+1}{e^x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{2e^x}{(e^x-1)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{e^x(e^x-1)-e^x(e^x+1)}{(e^x-1)^2}\\\\y'&=\\frac{e^{2x}-e^x-e^{2x}-e^x}{(e^x-1)^2}\\\\y'&=-\\frac{2e^x}{(e^x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
