    "label": "10",
    "prompt": "Find the average of $\\frac12$, $\\frac23$ and $\\frac34$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{23}{36}$",
      "worked": "Add the three numbers and divide by $3$.\n$$\\begin{align*}\\text{Average}&=\\left(\\frac12+\\frac23+\\frac34\\right)\\div3\\\\\\text{Average}&=\\frac{6+8+9}{12}\\div3\\\\\\text{Average}&=\\frac{23}{12}\\times\\frac13\\\\\\text{Average}&=\\frac{23}{36}\\end{align*}$$",
      "solutionDiagrams": []
    },
