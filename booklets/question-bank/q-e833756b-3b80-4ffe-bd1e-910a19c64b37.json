  "content": {
    "id": "p6-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$AB$ is a chord of a circle $ABC$ with centre $O$ and $TC$ is a tangent at $C$. If $\\angle BCT=75^\\circ$, find the size of $\\angle BOC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\angle BOC=150^\\circ$.",
      "worked": "Join $OB$ and $OC$. The radius $OC$ is perpendicular to the tangent $CT$.\n$$\\begin{align*}\\angle BCO&=90^\\circ-75^\\circ\\\\\\angle BCO&=15^\\circ\\end{align*}$$\nSince $OB=OC$ (radii), $\\angle OBC=\\angle BCO=15^\\circ$.\n$$\\begin{align*}\\angle BOC&=180^\\circ-15^\\circ-15^\\circ\\\\\\angle BOC&=150^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
