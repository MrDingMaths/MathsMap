    "children": [
      {
        "id": "p40-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of spinning the letter A or B?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "A and B are mutually exclusive.\n$$\\begin{align*}P(\\text{A or B})&=P(\\text{A})+P(\\text{B})\\\\P(\\text{A or B})&=\\frac15+\\frac1{10}\\\\P(\\text{A or B})&=\\frac2{10}+\\frac1{10}\\\\P(\\text{A or B})&=\\frac3{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability of spinning the letter D?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "$$\\begin{align*}P(\\text{D})&=1-\\bigl(P(\\text{A})+P(\\text{B})+P(\\text{C})\\bigr)\\\\P(\\text{D})&=1-\\left(\\frac15+\\frac1{10}+\\frac25\\right)\\\\P(\\text{D})&=1-\\frac7{10}\\\\P(\\text{D})&=\\frac3{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p40-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "How many sections are labelled C?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8 sections",
          "worked": "The 20 sections are equally likely.\n$$\\begin{align*}\\text{Number labelled C}&=P(\\text{C})\\times20\\\\\\text{Number labelled C}&=\\frac25\\times20\\\\\\text{Number labelled C}&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
