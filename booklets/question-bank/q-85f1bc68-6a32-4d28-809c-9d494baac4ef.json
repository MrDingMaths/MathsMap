        "id": "v2-fafc9-p54-practice-slot-9-upper-slot-9-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sqrt{2}+1}{\\sqrt{2}-1}-\\dfrac{\\sqrt{2}-1}{\\sqrt{2}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{2}+1}{\\sqrt{2}-1}-\\frac{\\sqrt{2}-1}{\\sqrt{2}+1}&=\\frac{(\\sqrt{2}+1)^2-(\\sqrt{2}-1)^2}{(\\sqrt{2}-1)(\\sqrt{2}+1)}\\\\&=\\frac{(3+2\\sqrt{2})-(3-2\\sqrt{2})}{2-1}\\\\&=4\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-fafc9-p54-practice-slot-9-upper-slot-9-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2\\sqrt{3}+1}{2\\sqrt{3}-1}+\\dfrac{2\\sqrt{3}-1}{2\\sqrt{3}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{26}{11}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{3}+1}{2\\sqrt{3}-1}+\\frac{2\\sqrt{3}-1}{2\\sqrt{3}+1}&=\\frac{(2\\sqrt{3}+1)^2+(2\\sqrt{3}-1)^2}{(2\\sqrt{3}-1)(2\\sqrt{3}+1)}\\\\&=\\frac{(13+4\\sqrt{3})+(13-4\\sqrt{3})}{12-1}\\\\&=\\frac{26}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
