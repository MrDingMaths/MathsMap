  "content": {
    "id": "p20-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "In the expansion of $(2x^3+3x^{-2})^{10}$, the general term is $\\binom{10}{k}(2x^3)^{10-k}(3x^{-2})^k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that this general term can be written as $\\binom{10}{k}2^{10-k}3^kx^{30-5k}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{10}{k}2^{10-k}3^kx^{30-5k}$",
          "worked": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\binom{10}{k}(2x^3)^{10-k}(3x^{-2})^k\\\\&=\\binom{10}{k}2^{10-k}x^{3(10-k)}3^kx^{-2k}\\\\&=\\binom{10}{k}2^{10-k}3^kx^{30-3k-2k}\\\\&=\\binom{10}{k}2^{10-k}3^kx^{30-5k}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q17-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence find the coefficients of these terms, giving your answers in combination notation and as prime factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q17-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x^{10}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\binom{10}{4}\\times2^6\\times3^4$",
              "worked": "$$\\begin{aligned}30-5k&=10\\\\k&=4.\\end{aligned}$$\nThe coefficient is $\\binom{10}{4}2^{10-4}3^4=\\binom{10}{4}\\times2^6\\times3^4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p20-q17-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x^{-5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\binom{10}{7}\\times2^3\\times3^7$",
              "worked": "$$\\begin{aligned}30-5k&=-5\\\\k&=7.\\end{aligned}$$\nThe coefficient is $\\binom{10}{7}2^{10-7}3^7=\\binom{10}{7}\\times2^3\\times3^7$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p20-q17-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$x^0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\binom{10}{6}\\times2^4\\times3^6$",
              "worked": "$$\\begin{aligned}30-5k&=0\\\\k&=6.\\end{aligned}$$\nThe coefficient is $\\binom{10}{6}2^{10-6}3^6=\\binom{10}{6}\\times2^4\\times3^6$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
  },
