  "content": {
    "id": "p55-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Factorise:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^{2}+3xy+y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+y)(x+y)$",
          "worked": "Product: $2y^{2}$. Sum: $3y$. Factor pair: $2y,y$.\n\n$$\\begin{align*}2x^{2}+3xy+y^{2}&=2x^{2}+2xy+xy+y^{2}\\\\&=2x(x+y)+y(x+y)\\\\&=(2x+y)(x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p55-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^{2}-xy-y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+y)(x-y)$",
          "worked": "Product: $-2y^{2}$. Sum: $-y$. Factor pair: $-2y,y$.\n\n$$\\begin{align*}2x^{2}-xy-y^{2}&=2x^{2}-2xy+xy-y^{2}\\\\&=2x(x-y)+y(x-y)\\\\&=(2x+y)(x-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p55-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^{2}+5xy+2y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2y)(x+y)$",
          "worked": "Product: $6y^{2}$. Sum: $5y$. Factor pair: $3y,2y$.\n\n$$\\begin{align*}3x^{2}+5xy+2y^{2}&=3x^{2}+3xy+2xy+2y^{2}\\\\&=3x(x+y)+2y(x+y)\\\\&=(3x+2y)(x+y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p55-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$6x^{2}-xy-y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+y)(2x-y)$",
          "worked": "Product: $-6y^{2}$. Sum: $-y$. Factor pair: $-3y,2y$.\n\n$$\\begin{align*}6x^{2}-xy-y^{2}&=6x^{2}-3xy+2xy-y^{2}\\\\&=3x(2x-y)+y(2x-y)\\\\&=(3x+y)(2x-y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p55-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$6x^{2}+5xy-6y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-2y)(2x+3y)$",
          "worked": "Product: $-36y^{2}$. Sum: $5y$. Factor pair: $9y,-4y$.\n\n$$\\begin{align*}6x^{2}+5xy-6y^{2}&=6x^{2}+9xy-4xy-6y^{2}\\\\&=3x(2x+3y)-2y(2x+3y)\\\\&=(3x-2y)(2x+3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
