  "content": {
    "id": "p18-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the requested dimensions. Give exact answers and approximations correct to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A cylinder with base radius 4 cm has a volume of 200 cm³. Find its height.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{25}{2\\pi}\\text{ cm}\\approx3.98\\text{ cm}$",
          "worked": "$$\\begin{aligned}200&=\\pi(4)^2h\\\\h&=\\frac{200}{16\\pi}=\\frac{25}{2\\pi}\\text{ cm}\\\\h&\\approx3.98\\text{ cm}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A cylinder of height 8 cm has a volume of 375 cm³. Find its base radius.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{\\dfrac{375}{8\\pi}}\\text{ cm}\\approx3.86\\text{ cm}$",
          "worked": "$$\\begin{aligned}375&=8\\pi r^2\\\\r^2&=\\frac{375}{8\\pi}\\\\r&=\\sqrt{\\frac{375}{8\\pi}}\\text{ cm}\\approx3.86\\text{ cm}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "A cylinder of volume 1000 cm³ is such that its base radius is equal to its height. Find its height.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{\\dfrac{1000}{\\pi}}\\text{ cm}\\approx6.83\\text{ cm}$",
          "worked": "Since the radius equals the height, let $r=h$.\n$$\\begin{aligned}1000&=\\pi h^3\\\\h&=\\sqrt[3]{\\frac{1000}{\\pi}}\\text{ cm}\\approx6.83\\text{ cm}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "A cylinder of volume 500 cm³ is such that its diameter is equal to its height. Find its height.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{\\dfrac{2000}{\\pi}}\\text{ cm}\\approx8.60\\text{ cm}$",
          "worked": "The radius is half the height: $r=\\frac{h}{2}$.\n$$\\begin{aligned}500&=\\pi(h/2)^2h=\\frac{\\pi h^3}{4}\\\\h^3&=\\frac{2000}{\\pi}\\\\h&=\\sqrt[3]{\\frac{2000}{\\pi}}\\text{ cm}\\approx8.60\\text{ cm}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
