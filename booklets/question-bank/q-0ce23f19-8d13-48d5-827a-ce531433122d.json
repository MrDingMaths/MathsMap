  "content": {
    "id": "routine-arithmetic-r8-parameter-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find the common difference of the AP $4x-7,\\ 4x-1,\\ 4x+5,\\ldots$ Then find $x$ if $a_{9}=69$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$d=6$, $x=7$.",
      "worked": "$$\\begin{align*}d&=(4x-1)-(4x-7)\\\\d&=6\\end{align*}$$\n$$\\begin{align*}a_{9}&=69\\\\a+(9-1)d&=69\\\\(4x-7)+8(6)&=69\\\\4x-7+48&=69\\\\4x+41&=69\\\\4x&=28\\\\x&=7\\end{align*}$$",
      "solutionDiagrams": []
    },
