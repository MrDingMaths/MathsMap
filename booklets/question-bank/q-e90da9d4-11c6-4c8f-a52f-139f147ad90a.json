  "content": {
    "id": "v2-7-practice-section-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the angle $\\theta$ between the vectors $\\underset{\\sim}{u}$ and $\\underset{\\sim}{v}$ (nearest degree if necessary) if $|\\underset{\\sim}{u}|=8$, $|\\underset{\\sim}{v}|=3$ and $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=12\\sqrt3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$30^\\circ$",
      "worked": "$$\\begin{align*}\\cos\\theta&=\\frac{\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}}{|\\underset{\\sim}{u}||\\underset{\\sim}{v}|}\\\\&=\\frac{12\\sqrt3}{8\\times3}=\\frac{\\sqrt3}{2}\\\\\\theta&=30^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
