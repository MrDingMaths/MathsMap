    "type": "question",
    "label": null,
    "prompt": "Find the value(s) of $k$ so that $4x^2-4x+k=0$ has two distinct real roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k<1$.",
      "worked": "$$\\begin{align*}\\Delta&=(-4)^2-4(4)k\\\\\\Delta&=16-16k\\end{align*}$$\nFor two distinct real roots, $\\Delta>0$.\n$$\\begin{align*}16-16k&>0\\\\k&<1\\end{align*}$$",
      "solutionDiagrams": []
    },
