  "content": {
    "id": "p43-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Using the substitution $x=u+1$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{x}{\\sqrt{x-1}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}(x-1)^{3/2}+2\\sqrt{x-1}+C$",
          "worked": "$x=u+1$, $dx=du$ and $u=x-1$.\n$$\\begin{aligned}\\int\\frac{x}{\\sqrt{x-1}}\\,dx&=\\int\\frac{u+1}{\\sqrt u}\\,du\\\\&=\\int\\left(u^{1/2}+u^{-1/2}\\right)\\,du\\\\&=\\frac23u^{3/2}+2u^{1/2}+C\\\\&=\\frac23(x-1)^{3/2}\\\\&\\quad+2\\sqrt{x-1}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p43-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{x}{(x-1)^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ln|x-1|-\\frac{1}{x-1}+C$",
          "worked": "$x=u+1$, $dx=du$ and $u=x-1$.\n$$\\begin{aligned}\\int\\frac{x}{(x-1)^2}\\,dx&=\\int\\frac{u+1}{u^2}\\,du\\\\&=\\int\\left(u^{-1}+u^{-2}\\right)\\,du\\\\&=\\ln|u|-\\frac1u+C\\\\&=\\ln|x-1|-\\frac1{x-1}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
