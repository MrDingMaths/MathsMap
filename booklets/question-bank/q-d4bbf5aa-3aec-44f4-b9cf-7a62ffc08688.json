    "label": "11",
    "prompt": "At Castlefield College, $\\frac{4}{7}$ of the students are boys.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What fraction of students are girls?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{7}$",
          "worked": "$$1-\\frac{4}{7}=\\frac{3}{7}$$\nThe fraction of students who are girls is $\\frac{3}{7}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p14-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "If there are 360 boys, how many girls are there?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "270 girls.\n\nDivide by the boys’ fraction to find the total, then multiply by the girls’ fraction.",
          "worked": "Total number of students:\n$$\\begin{align*}360\\div\\frac{4}{7}&=360\\times\\frac{7}{4}\\\\360\\div\\frac{4}{7}&=630\\end{align*}$$\nNumber of girls:\n$$\\begin{align*}\\frac{3}{7}\\times630&=3\\times90\\\\\\frac{3}{7}\\times630&=270\\end{align*}$$\nThere are 270 girls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
