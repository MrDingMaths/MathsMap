  "content": {
    "id": "p2-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the gradient, $x$-intercept and $y$-intercept of the following lines.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=5x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Gradient $5$; $x$-intercept $\\frac35$; $y$-intercept $-3$.",
          "worked": "From $y=5x-3$, the gradient is $5$.\n\nAt the $x$-intercept, $y=0$:\n$$\\begin{align*}0&=5x-3\\\\5x&=3\\\\x&=\\frac35\\end{align*}$$\nAt the $y$-intercept, $x=0$:\n$$\\begin{align*}y&=5(0)-3\\\\y&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p2-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=4-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Gradient $-1$; $x$-intercept $4$; $y$-intercept $4$.",
          "worked": "$y=4-x=-x+4$, so the gradient is $-1$.\n\nAt the $x$-intercept, $y=0$:\n$$\\begin{align*}0&=4-x\\\\x&=4\\end{align*}$$\nAt the $y$-intercept, $x=0$:\n$$\\begin{align*}y&=4-0\\\\y&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p2-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x-4y=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Gradient $\\frac34$; $x$-intercept $4$; $y$-intercept $-3$.",
          "worked": "$$\\begin{align*}3x-4y&=12\\\\-4y&=12-3x\\\\y&=\\frac34x-3\\end{align*}$$\nThe gradient is $\\frac34$.\n\nAt the $x$-intercept, $y=0$:\n$$\\begin{align*}3x-4(0)&=12\\\\3x&=12\\\\x&=4\\end{align*}$$\nAt the $y$-intercept, $x=0$:\n$$\\begin{align*}3(0)-4y&=12\\\\-4y&=12\\\\y&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p2-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$5x+2y=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Gradient $-\\frac52$; $x$-intercept $\\frac45$; $y$-intercept $2$.",
          "worked": "$$\\begin{align*}5x+2y&=4\\\\2y&=4-5x\\\\y&=-\\frac52x+2\\end{align*}$$\nThe gradient is $-\\frac52$.\n\nAt the $x$-intercept, $y=0$:\n$$\\begin{align*}5x+2(0)&=4\\\\5x&=4\\\\x&=\\frac45\\end{align*}$$\nAt the $y$-intercept, $x=0$:\n$$\\begin{align*}5(0)+2y&=4\\\\2y&=4\\\\y&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
