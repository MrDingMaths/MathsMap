  "content": {
    "id": "p28-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "At the start of the first minute there are 10 grinches. Each minute, their numbers double, and then 2 die. Let $a_n$ be the number of grinches at the start of the $n$th minute.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q4a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a_2$, the number of grinches at the start of the second minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "18 grinches.",
          "worked": "$$\\begin{align*}a_2 &= 2a_1-2\\\\a_2 &= 2\\times10-2\\\\a_2 &= 18.\\end{align*}$$\nThere are 18 grinches at the start of the second minute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Find a recursive equation for $a_{n+1}$ in terms of $a_n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{n+1}=2a_n-2$.",
          "worked": "Double the population first, then subtract the 2 grinches that die:\n$$a_{n+1}=2a_n-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p28-q4c",
        "type": "part",
        "label": "c",
        "prompt": "Find a general formula for $a_n$ in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=8\\times2^{n-1}+2$.\n\nUse $a_n=p2^{n-1}+q$ with the first two terms to find $p=8$ and $q=2$.",
          "worked": "As $r=2$, write $a_n=p2^{n-1}+q$. Using $a_1=10$ and $a_2=18$ gives\n$$\\begin{align*}10 &= p+q\\\\18 &= 2p+q.\\end{align*}$$\nSubtracting the first equation from the second gives $p=8$. Then\n$$\\begin{align*}q &= 10-8\\\\q &= 2.\\end{align*}$$\nHence\n$$a_n=8\\times2^{n-1}+2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
