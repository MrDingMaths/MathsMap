    "children": [
      {
        "id": "p3-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How many digits does $100^{100}$ have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "201 digits.\n\n$100^{100}=10^{200}$, which is 1 followed by 200 zeros.",
          "worked": "$$\\begin{align*}100^{100}&=(10^2)^{100}\\\\100^{100}&=10^{200}\\end{align*}$$\n\nThis is 1 followed by 200 zeros, so it has $200+1=201$ digits.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p3-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How many digits does $(100^{100})^{100}$ have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 001 digits.\n\n$(100^{100})^{100}=10^{20000}$, which is 1 followed by 20 000 zeros.",
          "worked": "$$\\begin{align*}(100^{100})^{100}&=100^{10000}\\\\(100^{100})^{100}&=(10^2)^{10000}\\\\(100^{100})^{100}&=10^{20000}\\end{align*}$$\n\nThis is 1 followed by 20 000 zeros, so it has $20000+1=20001$ digits.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
