    "id": "v2-f1673e-p9-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "The temperature in °C inside a cold room at a Snowy Mountains weather station is given by the expression $t^{2}-17t+42$, where $t$ is hours after midnight.\nFind the times in the day when the temperature is 0°C.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "3 am and 2 pm.",
      "worked": "$$\\begin{align*}t^{2}-17t+42&=0\\\\(t-14)(t-3)&=0\\\\t&=3\\text{ or }14\\end{align*}$$\nThe temperature is 0°C at 3 am and 2 pm.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
