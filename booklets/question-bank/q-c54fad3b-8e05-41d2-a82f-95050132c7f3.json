  "content": {
    "id": "p11-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "For two events $C$ and $D$, $P(C)=0.7$, $P(C\\cap D)=0.3$ and $P(C\\cup D)=0.9$. Find $P(D)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.5$\n\nUse the addition rule and solve for $P(D)$.",
      "worked": "$$\\begin{align*}P(C\\cup D)&=P(C)+P(D)-P(C\\cap D)\\\\0.9&=0.7+P(D)-0.3\\\\P(D)&=0.9-0.7+0.3\\\\P(D)&=0.5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
