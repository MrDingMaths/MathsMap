  "content": {
    "id": "p21-q28-answer",
    "type": "question",
    "label": "28",
    "prompt": "The product of the ages of Cally and Katy is 130 less than the product of their ages in 5 years. If Cally is 3 years older than Katy, what are their current ages?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Katy is 9 years old and Cally is 12 years old.",
      "worked": "Let $K$ and $C$ be Katy’s and Cally’s current ages in years.\n$$\\begin{align*}C &= K+3\\\\CK &= (C+5)(K+5)-130\\\\K(K+3) &= (K+8)(K+5)-130\\\\K^2+3K &= K^2+13K-90\\\\10K &= 90\\\\K &= 9\\\\C &= 9+3=12\\end{align*}$$\nKaty is 9 years old and Cally is 12 years old.\nCheck: $12\\times9=108$ and $17\\times14=238$, so the future product is $238-108=130$ greater.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
