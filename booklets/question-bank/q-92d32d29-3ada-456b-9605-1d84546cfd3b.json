  "content": {
    "id": "p6-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Given $\\frac{1}{f}=\\frac{1}{u}+\\frac{1}{v}$, find the value of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$u$ when $f=2$ and $v=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=4$",
          "worked": "$$\\begin{align*}\\frac{1}{2}&=\\frac{1}{u}+\\frac{1}{4}\\\\\\frac{1}{u}&=\\frac{1}{2}-\\frac{1}{4}\\\\\\frac{1}{u}&=\\frac{1}{4}\\end{align*}$$ Taking reciprocals of both sides gives $u=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p6-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$u$ when $f=3$ and $v=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$u=12$",
          "worked": "$$\\begin{align*}\\frac{1}{3}&=\\frac{1}{u}+\\frac{1}{4}\\\\\\frac{1}{u}&=\\frac{1}{3}-\\frac{1}{4}\\\\\\frac{1}{u}&=\\frac{1}{12}\\end{align*}$$ Taking reciprocals of both sides gives $u=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
