  "content": {
    "id": "p28-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "The volume of water in a reservoir falls from 430 000 litres to 180 000 litres over 5 days.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the rate at which the reservoir is emptying, giving your answer in litres per day.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\,000\\text{ L/day}$",
          "worked": "$$\\begin{align*}\\text{Emptying rate}&=\\frac{430\\,000-180\\,000}{5}\\\\&=50\\,000\\text{ L/day}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Assume that the reservoir continues to empty at the same rate.\nHow many more days will it take for the reservoir to empty completely?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.6$ more days",
          "worked": "Let $x$ be the number of additional days.\n$$\\begin{align*}\\frac{50\\,000}{1}&=\\frac{180\\,000}{x}\\\\\\frac{1}{50\\,000}&=\\frac{x}{180\\,000}\\\\x&=\\frac{180\\,000}{50\\,000}\\\\x&=3.6\\text{ days}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
