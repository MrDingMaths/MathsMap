    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(3x+1)(2x+1)$\n\nIncorrect working: $y'=3\\times2=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Expand first: $y=6x^{2}+5x+1$, so $y'=12x+5$.",
          "worked": "$$\\begin{align*}y&=(3x+1)(2x+1)\\\\y&=6x^{2}+5x+1\\\\y'&=12x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^{2}+4x}{x}$\n\nIncorrect working: $y'=\\dfrac{2x+4}{1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Divide each numerator term by $x$ first: $y=x+4$ for $x\\ne0$, so $y'=1$.",
          "worked": "For $x\\ne0$,\n\n$$\\begin{align*}y&=\\frac{x^{2}+4x}{x}\\\\y&=x+4\\\\y'&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
