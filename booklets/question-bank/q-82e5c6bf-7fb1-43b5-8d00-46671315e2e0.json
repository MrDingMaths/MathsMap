  "content": {
    "id": "p41-25j-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A ball labelled with a three-digit number from 100 to 999 is selected at random. Find the probability all its digits are distinct.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{18}{25}$",
      "worked": "There are 9 choices for the hundreds digit, 9 remaining choices for the tens digit (including zero), and 8 remaining choices for the units digit.\n\n$$\\begin{align*}\nN(\\text{distinct digits})&=9\\times9\\times8\\\\\nN(\\text{distinct digits})&=648\\\\\nN(\\text{all numbers})&=999-100+1\\\\\nN(\\text{all numbers})&=900\\\\\n\\Pr(\\text{distinct digits})&=\\frac{648}{900}\\\\\n\\Pr(\\text{distinct digits})&=\\frac{18}{25}\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
