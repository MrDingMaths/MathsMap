  "content": {
    "id": "p5-q8",
    "type": "question",
    "label": "8",
    "prompt": "Mauna Kea is Hawaii’s tallest volcano and the world’s highest mountain when measured from its base on the sea floor. The height above sea level is 2405 metres. The base of Mauna Kea on the sea floor is 7286 metres below sea level. What is the height of Mauna Kea from sea floor to summit?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9691$ metres",
      "worked": "$$\\begin{align*}\\text{Height}&=2405-(-7286)\\\\\\text{Height}&=2405+7286\\\\\\text{Height}&=9691\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
