  "content": {
    "id": "p33-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "State the transformations that need to be applied to the graph of $y=x^2$ to obtain the graph of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x+2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate 2 units left.",
          "worked": "Replacing $x$ with $x+2$ translates the graph 2 units left. The vertex moves from $(0,0)$ to $(-2,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate 1 unit right.",
          "worked": "Replacing $x$ with $x-1$ translates the graph 1 unit right. The vertex moves from $(0,0)$ to $(1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p33-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-(x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Reflect in the $x$-axis, then translate 1 unit left.",
          "worked": "Reflecting in the $x$-axis gives $y=-x^2$. Translating 1 unit left gives $y=-(x+1)^2$. The vertex is $(-1,0)$ and the arms open downwards.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(x+1)^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate 1 unit left and 3 units down.",
          "worked": "Translating 1 unit left gives $y=(x+1)^2$. Translating 3 units down gives $y=(x+1)^2-3$. The vertex moves to $(-1,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=(x-2)^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Translate 2 units right and 3 units down.",
          "worked": "Translating 2 units right gives $y=(x-2)^2$. Translating 3 units down gives $y=(x-2)^2-3$. The vertex moves to $(2,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=1-(x-3)^2$",
