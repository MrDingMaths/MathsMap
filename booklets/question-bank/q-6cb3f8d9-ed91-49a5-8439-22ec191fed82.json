      {
        "id": "p62-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Prove algebraically that this pattern exists for all decimals ending in .5.\n\n$(x+0.5)^2=$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+0.5)^2=x(x+1)+0.25$.",
          "worked": "Let $x$ be the whole-number part, so the decimal is $x+0.5$.\n$$\\begin{align*}(x+0.5)^2&=x^2+2(x)(0.5)+(0.5)^2\\\\&=x^2+x+0.25\\\\&=x(x+1)+0.25\\end{align*}$$\nThe factors $x$ and $x+1$ are consecutive integers, proving the pattern.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p62-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Prove algebraically that the pattern $25^2=20\\times30+25$, $205^2=200\\times210+25$, … exists for all numbers ending in 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $x$ a multiple of $10$, $(x+5)^2=x(x+10)+25$.",
          "worked": "Let $x$ be a multiple of $10$, so the number ending in $5$ is $x+5$.\n$$\\begin{align*}(x+5)^2&=x^2+2(x)(5)+5^2\\\\&=x^2+10x+25\\\\&=x(x+10)+25\\end{align*}$$\nThus its square is the product of the multiples of $10$ immediately below and above it, plus $25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
