  "content": {
    "id": "v2-ac439-p13-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Find the exact value of each expression. No calculators required.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-ac439-p13-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sin70^{\\circ}}{\\cos20^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin70^{\\circ}&=\\cos(90^{\\circ}-70^{\\circ})\\\\&=\\cos20^{\\circ}\\\\\\frac{\\sin70^{\\circ}}{\\cos20^{\\circ}}&=\\frac{\\cos20^{\\circ}}{\\cos20^{\\circ}}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-ac439-p13-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos40^{\\circ}-\\sin50^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sin50^{\\circ}&=\\cos(90^{\\circ}-50^{\\circ})\\\\&=\\cos40^{\\circ}\\\\\\cos40^{\\circ}-\\sin50^{\\circ}&=\\cos40^{\\circ}-\\cos40^{\\circ}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-ac439-p13-practice-slot-7-slot-7-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan20^{\\circ}\\times\\tan70^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\tan70^{\\circ}&=\\tan(90^{\\circ}-20^{\\circ})\\\\&=\\frac{1}{\\tan20^{\\circ}}\\\\\\tan20^{\\circ}\\times\\tan70^{\\circ}&=\\tan20^{\\circ}\\times\\frac{1}{\\tan20^{\\circ}}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
