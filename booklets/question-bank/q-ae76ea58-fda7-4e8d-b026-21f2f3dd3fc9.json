  "content": {
    "id": "binomial-numerator-r33-compare-2-root",
    "type": "question",
    "label": null,
    "prompt": "A student thinks that the common denominator to use when simplifying $\\dfrac{x+4}{6}+\\dfrac{2x+5}{9}$ is 36.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "binomial-numerator-r33-compare-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Complete the addition by making both denominators 36.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7x+22}{18}$",
          "worked": "$$\\begin{align*}\\frac{x+4}{6}+\\frac{2x+5}{9}&=\\frac{6(x+4)}{36}+\\frac{4(2x+5)}{36}\\\\&=\\frac{6x+24+8x+20}{36}\\\\&=\\frac{14x+44}{36}\\\\&=\\frac{7x+22}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "binomial-numerator-r33-compare-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Complete the simplification using the actual LCD of 18.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7x+22}{18}$",
          "worked": "$$\\begin{align*}\\frac{x+4}{6}+\\frac{2x+5}{9}&=\\frac{3(x+4)}{18}+\\frac{2(2x+5)}{18}\\\\&=\\frac{3x+12+4x+10}{18}\\\\&=\\frac{7x+22}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "binomial-numerator-r33-compare-2-c",
        "type": "part",
        "label": "c",
        "prompt": "You should have the same answer for both methods. Which do you prefer and why?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, use 18: smaller numbers and less simplification.",
          "worked": "Both methods give $\\dfrac{7x+22}{18}$. Using the LCD of 18 keeps the numbers smaller and avoids reducing a fraction with denominator 36. Either preference is acceptable with a valid reason.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
