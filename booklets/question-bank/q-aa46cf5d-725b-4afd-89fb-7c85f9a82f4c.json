  "content": {
    "id": "p27-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Solve simultaneously:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}7^{2x-y}&=49\\\\2^{x+y}&=128\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=4$.",
          "worked": "$$\\begin{align*}7^{2x-y}&=7^2\\\\2x-y&=2\\\\2^{x+y}&=2^7\\\\x+y&=7\\end{align*}$$\nAdding the two linear equations:\n$$\\begin{align*}3x&=9\\\\x&=3\\\\y&=7-3\\\\y&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p27-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}8^x\\div4^y&=4\\\\11^{y-x}&=\\frac{1}{11}\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\ y=-1$.",
          "worked": "$$\\begin{align*}2^{3x}\\div2^{2y}&=2^2\\\\2^{3x-2y}&=2^2\\\\3x-2y&=2\\\\11^{y-x}&=11^{-1}\\\\y-x&=-1\\\\y&=x-1\\end{align*}$$\nSubstituting into the first linear equation:\n$$\\begin{align*}3x-2(x-1)&=2\\\\x+2&=2\\\\x&=0\\\\y&=0-1\\\\y&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p27-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}13^{x+4y}&=1\\\\25^{x+5y}&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ y=\\frac12$.",
          "worked": "$$\\begin{align*}13^{x+4y}&=13^0\\\\x+4y&=0\\\\(5^2)^{x+5y}&=5^1\\\\5^{2x+10y}&=5^1\\\\2x+10y&=1\\end{align*}$$\nSubtracting twice the first linear equation from the second:\n$$\\begin{align*}(2x+10y)-2(x+4y)&=1\\\\2y&=1\\\\y&=\\frac12\\\\x&=-4\\left(\\frac12\\right)\\\\x&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p27-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}2^a+3^b&=17\\\\2^{a+1}-3^{b+1}&=-11\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3,\\ b=2$. Eliminate $2^a$ to obtain $3^b=9$, then $2^a=8$.",
          "worked": "$$\\begin{align*}2\\times2^a-3\\times3^b&=-11\\\\2\\times2^a+2\\times3^b&=34\\end{align*}$$\nSubtracting the first equation above from the second:\n$$\\begin{align*}5\\times3^b&=45\\\\3^b&=9\\\\3^b&=3^2\\\\b&=2\\end{align*}$$\nSubstituting into the original first equation:\n$$\\begin{align*}2^a+9&=17\\\\2^a&=8\\\\2^a&=2^3\\\\a&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      }
    ]
  },
