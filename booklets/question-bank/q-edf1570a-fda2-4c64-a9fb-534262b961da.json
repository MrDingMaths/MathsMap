      {
        "id": "p30-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{1}{\\sqrt{x}(1+x)}\\,dx\\qquad$ using $u=\\sqrt{x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\tan^{-1}\\sqrt{x}+C$",
          "worked": "Let $u=\\sqrt{x}$, so $x=u^2$ and $dx=2u\\,du$.\n$$\\begin{aligned}\\int\\frac{1}{\\sqrt{x}(1+x)}\\,dx&=\\int\\frac{1}{u(1+u^2)}\\cdot2u\\,du\\\\&=\\int\\frac{2}{1+u^2}\\,du\\\\&=2\\tan^{-1}u+C\\\\&=2\\tan^{-1}\\sqrt{x}+C.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p30-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^1\\frac{1}{e^{-x}+e^x}\\,dx\\qquad$ using $u=e^x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^{-1}e-\\dfrac\\pi4$",
          "worked": "$$\\int_0^1\\frac{1}{e^{-x}+e^x}\\,dx=\\int_0^1\\frac{e^x}{1+e^{2x}}\\,dx.$$\nLet $u=e^x$, so $du=e^x\\,dx$. When $x=0$, $u=1$; when $x=1$, $u=e$.\n$$\\begin{aligned}\\int_0^1\\frac{1}{e^{-x}+e^x}\\,dx&=\\int_1^e\\frac{1}{1+u^2}\\,du\\\\&=\\left[\\tan^{-1}u\\right]_1^e\\\\&=\\tan^{-1}e-\\frac\\pi4.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
