          "worked": "$$\\begin{align*}a_1&=0.9\\\\a_2&=0.9+0.73=1.63\\\\a_3&=1.63+0.73=2.36\\\\a_4&=2.36+0.73=3.09\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
