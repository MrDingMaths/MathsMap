  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write out the first four terms of the APs whose first terms and common differences are:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$a=3,\\quad d=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3,\\ 5,\\ 7,\\ 9$",
          "worked": "$$\\begin{align*}a_1&=3\\\\a_2&=3+2=5\\\\a_3&=5+2=7\\\\a_4&=7+2=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$a=7,\\quad d=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7,\\ 3,\\ -1,\\ -5$",
          "worked": "$$\\begin{align*}a_1&=7\\\\a_2&=7-4=3\\\\a_3&=3-4=-1\\\\a_4&=-1-4=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$a=30,\\quad d=-11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30,\\ 19,\\ 8,\\ -3$",
          "worked": "$$\\begin{align*}a_1&=30\\\\a_2&=30-11=19\\\\a_3&=19-11=8\\\\a_4&=8-11=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$a=-9,\\quad d=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9,\\ -5,\\ -1,\\ 3$",
          "worked": "$$\\begin{align*}a_1&=-9\\\\a_2&=-9+4=-5\\\\a_3&=-5+4=-1\\\\a_4&=-1+4=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$a=3\\frac12,\\quad d=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac12,\\ 1\\frac12,\\ -\\frac12,\\ -2\\frac12$",
          "worked": "$$\\begin{align*}a_1&=3\\frac12\\\\a_2&=3\\frac12-2=1\\frac12\\\\a_3&=1\\frac12-2=-\\frac12\\\\a_4&=-\\frac12-2=-2\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$a=0.9,\\quad d=0.73$",
        "layout": "list",
        "columns": null,
