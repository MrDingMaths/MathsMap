  "content": {
    "id": "p25-q12-response",
    "type": "question",
    "label": "12",
    "prompt": "Prove that $\\log_{a^x}(b)=\\dfrac{\\log_a b}{x}$. Assume $a>0$, $a\\ne1$, $b>0$ and $x\\ne0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{\\log_a b}{x}=\\dfrac{\\log_a b}{\\log_a(a^x)}=\\log_{a^x}b$.",
      "worked": "$$\\begin{align*}\\mathrm{RHS}&=\\frac{\\log_a b}{\\log_a(a^x)}\\\\\\mathrm{RHS}&=\\log_{a^x}b\\\\\\mathrm{RHS}&=\\mathrm{LHS}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
