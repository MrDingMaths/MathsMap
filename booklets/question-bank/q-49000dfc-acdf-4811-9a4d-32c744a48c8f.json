    "id": "p20-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the parabola $y=a(x-2)^2-6$. Find the value of $a$ if the $y$-intercept is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
