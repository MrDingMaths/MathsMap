  "content": {
    "id": "p26-q31-root",
    "type": "question",
    "label": "31",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p26-q31-stem",
          "type": "paragraph",
          "fontSize": null,
