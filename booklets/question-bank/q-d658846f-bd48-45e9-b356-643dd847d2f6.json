  "content": {
    "id": "p23-q45-root",
    "type": "question",
    "label": "45",
    "prompt": "Show that $\\dfrac{\\sin\\alpha}{\\cos\\beta\\cos(\\alpha+\\beta)}=\\tan(\\alpha+\\beta)-\\tan\\beta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Identity proved.\n\nExpand the tangent sum on the right, combine fractions and use $1+\\tan^2\\beta=\\sec^2\\beta$.",
      "worked": "$$\\begin{align*}\\tan(\\alpha+\\beta)-\\tan\\beta&=\\frac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}-\\tan\\beta\\\\\\tan(\\alpha+\\beta)-\\tan\\beta&=\\frac{\\tan\\alpha(1+\\tan^2\\beta)}{1-\\tan\\alpha\\tan\\beta}\\\\\\tan(\\alpha+\\beta)-\\tan\\beta&=\\frac{\\tan\\alpha\\sec^2\\beta}{1-\\tan\\alpha\\tan\\beta}\\\\\\tan(\\alpha+\\beta)-\\tan\\beta&=\\frac{\\sin\\alpha}{\\cos\\beta(\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta)}\\\\\\tan(\\alpha+\\beta)-\\tan\\beta&=\\frac{\\sin\\alpha}{\\cos\\beta\\cos(\\alpha+\\beta)}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
