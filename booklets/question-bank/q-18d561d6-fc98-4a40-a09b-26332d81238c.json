  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "It is known that $a(x+2)+b(x-1)=5x+1$ for all values of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Substitute $x=1$ to find $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$",
          "worked": "Substitute $x=1$:\n$$\\begin{align*}a(1+2)+b(1-1)&=5(1)+1\\\\3a&=6\\\\a&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $x=-2$ to find $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=3$",
          "worked": "Substitute $x=-2$:\n$$\\begin{align*}a(-2+2)+b(-2-1)&=5(-2)+1\\\\-3b&=-9\\\\b&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Why were the values $x=1$ and $x=-2$ chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each makes one bracket on the left-hand side zero, leaving only one unknown.",
          "worked": "When $x=1$, $x-1=0$, so the term containing $b$ vanishes. When $x=-2$, $x+2=0$, so the term containing $a$ vanishes. Each substitution leaves an equation in one unknown.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Equate the coefficients of like terms to get a pair of simultaneous equations in $a$ and $b$, then solve them. Do you get the same answer?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b=5$ and $2a-b=1$; hence $a=2$, $b=3$. Yes, these are the same answers.",
          "worked": "Expand and collect like terms:\n$$\\begin{align*}a(x+2)+b(x-1)&=(a+b)x+2a-b\\end{align*}$$\nEquating coefficients of $x$ and the constant terms gives\n$$\\begin{align*}a+b&=5\\qquad\\text{(1)}\\\\2a-b&=1\\qquad\\text{(2)}\\end{align*}$$\nAdd (1) and (2):\n$$\\begin{align*}3a&=6\\\\a&=2\\end{align*}$$\nSubstitute $a=2$ into (1):\n$$\\begin{align*}2+b&=5\\\\b&=3\\end{align*}$$\nYes, these agree with parts a and b.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
