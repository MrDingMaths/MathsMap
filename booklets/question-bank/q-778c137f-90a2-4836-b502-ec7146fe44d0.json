  "content": {
    "id": "p4-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "One card is drawn at random from a pack of playing cards. What is the probability that it is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "a King?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{13}$",
          "worked": "There are 4 Kings among 52 cards.\n$$\\begin{align*}P(\\text{King})&=\\frac{4}{52}\\\\P(\\text{King})&=\\frac{1}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "a red card?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Hearts and Diamonds give $13+13=26$ red cards among 52 cards.\n$$\\begin{align*}P(\\text{red card})&=\\frac{26}{52}\\\\P(\\text{red card})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "a Spade?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are 13 Spades among 52 cards.\n$$\\begin{align*}P(\\text{Spade})&=\\frac{13}{52}\\\\P(\\text{Spade})&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q8-d",
        "type": "part",
        "label": "d",
