  "content": {
    "id": "p31-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the sum $P(x)+Q(x)$, the difference $P(x)-Q(x)$ and the product $P(x)Q(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x+3$, $Q(x)=x^2+2x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=x^2+3x+6$;\n\n$P(x)-Q(x)=-x^2-x$;\n\n$P(x)Q(x)=x^3+5x^2+9x+9$.",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(x+3)+(x^2+2x+3)\\\\P(x)+Q(x)&=x^2+3x+6\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(x+3)-(x^2+2x+3)\\\\P(x)-Q(x)&=x+3-x^2-2x-3\\\\P(x)-Q(x)&=-x^2-x\\end{align*}$$\n$$\\begin{align*}P(x)Q(x)&=(x+3)(x^2+2x+3)\\\\P(x)Q(x)&=x(x^2+2x+3)+3(x^2+2x+3)\\\\P(x)Q(x)&=x^3+2x^2+3x+3x^2+6x+9\\\\P(x)Q(x)&=x^3+5x^2+9x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p31-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=x^2+1$, $Q(x)=x^2+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=2x^2+4$;\n\n$P(x)-Q(x)=-2$;\n\n$P(x)Q(x)=x^4+4x^2+3$.",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(x^2+1)+(x^2+3)\\\\P(x)+Q(x)&=2x^2+4\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(x^2+1)-(x^2+3)\\\\P(x)-Q(x)&=x^2+1-x^2-3\\\\P(x)-Q(x)&=-2\\end{align*}$$\n$$\\begin{align*}P(x)Q(x)&=(x^2+1)(x^2+3)\\\\P(x)Q(x)&=x^2(x^2+3)+(x^2+3)\\\\P(x)Q(x)&=x^4+3x^2+x^2+3\\\\P(x)Q(x)&=x^4+4x^2+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p31-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=2x+1$, $Q(x)=x^2-2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=x^2+2$;\n\n$P(x)-Q(x)=-x^2+4x$;\n\n$P(x)Q(x)=2x^3-3x^2+1$.",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(2x+1)+(x^2-2x+1)\\\\P(x)+Q(x)&=x^2+2\\end{align*}$$\n$$\\begin{align*}P(x)-Q(x)&=(2x+1)-(x^2-2x+1)\\\\P(x)-Q(x)&=2x+1-x^2+2x-1\\\\P(x)-Q(x)&=-x^2+4x\\end{align*}$$\n$$\\begin{align*}P(x)Q(x)&=(2x+1)(x^2-2x+1)\\\\P(x)Q(x)&=2x(x^2-2x+1)+(x^2-2x+1)\\\\P(x)Q(x)&=2x^3-4x^2+2x+x^2-2x+1\\\\P(x)Q(x)&=2x^3-3x^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
  },
