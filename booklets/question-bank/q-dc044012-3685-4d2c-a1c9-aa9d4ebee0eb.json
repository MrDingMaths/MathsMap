        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real zeroes.",
          "worked": "$\\Delta=-3<0$, so there are no real zeroes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p13-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\Delta=4$",
