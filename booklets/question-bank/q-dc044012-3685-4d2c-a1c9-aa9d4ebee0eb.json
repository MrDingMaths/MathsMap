  "content": {
    "id": "p13-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "In each part below, the discriminant of a quadratic function with rational coefficients is given. State whether there are any zeroes. If there are zeroes then state whether they are rational or irrational, and whether they are equal or are distinct.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\Delta=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two irrational, distinct zeroes.",
          "worked": "$\\Delta=2>0$, so there are two distinct zeroes. Since 2 is not a square and the coefficients are rational, both zeroes are irrational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\Delta=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real zeroes.",
          "worked": "$\\Delta=-2<0$, so there are no real zeroes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p13-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\Delta=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Rational, equal zeroes (one double zero).",
          "worked": "$\\Delta=0$, so the zeroes are equal. The double zero is $x=-\\frac{b}{2a}$, which is rational because the coefficients are rational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\Delta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two rational, distinct zeroes.",
          "worked": "$\\Delta=1>0$, so there are two distinct zeroes. Since $1=1^2$ and the coefficients are rational, both zeroes are rational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\Delta=-3$",
