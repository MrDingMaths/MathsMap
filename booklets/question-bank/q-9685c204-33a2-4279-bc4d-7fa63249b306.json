  "content": {
    "id": "p15-q38-root",
    "type": "question",
    "label": null,
    "prompt": "Given $f(x)=x+\\frac{1}{x}$, find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q38-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(3a+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a+2+\\frac{1}{3a+2}$, $a\\ne-\\frac{2}{3}$.",
          "worked": "$$\\begin{align*}f(3a+2)&=(3a+2)+\\frac{1}{3a+2}\\end{align*}$$\n\nThe input must be nonzero: $3a+2\\ne0$, so $a\\ne-\\frac{2}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q38-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a+\\frac{1}{2a}$, $a\\ne0$.",
          "worked": "$$\\begin{align*}f(2a)&=2a+\\frac{1}{2a}\\end{align*}$$\n\nThe input must be nonzero: $2a\\ne0$, so $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q38-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+\\frac{1}{a^2}$, $a\\ne0$.",
          "worked": "$$\\begin{align*}f(a^2)&=a^2+\\frac{1}{a^2}\\end{align*}$$\n\nThe input must be nonzero: $a^2\\ne0$, so $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q38-d",
        "type": "part",
        "label": "d",
        "prompt": "$f\\left(\\frac{1}{a}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p15-q38-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a+\\frac{1}{a},\\quad a\\ne0",
                    "display": false
                  }
                ]
              },
              {
                "id": "p15-q38-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Substitute the reciprocal input and simplify ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{1}{\\frac{1}{a}}=a",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}f\\left(\\frac{1}{a}\\right)&=\\frac{1}{a}+\\frac{1}{\\frac{1}{a}}\\\\f\\left(\\frac{1}{a}\\right)&=\\frac{1}{a}+a\\\\f\\left(\\frac{1}{a}\\right)&=a+\\frac{1}{a},\\quad a\\ne0\\end{align*}$$\n\nThe input $\\frac{1}{a}$ is defined and nonzero when $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
