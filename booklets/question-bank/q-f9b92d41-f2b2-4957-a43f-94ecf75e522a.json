  "content": {
    "id": "p19-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Determine which of the following are Pythagorean triples:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3,4,5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}3^2+4^2&=9+16\\\\3^2+4^2&=25\\\\5^2&=25\\end{align*}$$Since $3^2+4^2=5^2$, this is a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(5,6,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}5^2+6^2&=25+36\\\\5^2+6^2&=61\\\\7^2&=49\\end{align*}$$Since $5^2+6^2\\ne7^2$, this is not a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(6,8,10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}6^2+8^2&=36+64\\\\6^2+8^2&=100\\\\10^2&=100\\end{align*}$$Since $6^2+8^2=10^2$, this is a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(14,22,26)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}14^2+22^2&=196+484\\\\14^2+22^2&=680\\\\26^2&=676\\end{align*}$$Since $14^2+22^2\\ne26^2$, this is not a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(8,15,17)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}8^2+15^2&=64+225\\\\8^2+15^2&=289\\\\17^2&=289\\end{align*}$$Since $8^2+15^2=17^2$, this is a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(5,12,13)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}5^2+12^2&=25+144\\\\5^2+12^2&=169\\\\13^2&=169\\end{align*}$$Since $5^2+12^2=13^2$, this is a Pythagorean triple.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
