          "inlines": [
            {
              "type": "text",
              "text": "Liam earned a wage of $989.60 per week and paid PAYG tax of $229.02 per week. He was able to claim $38.25 per week in allowable tax deductions and $150 per year in donations.",
              "marks": []
            }
          ]
        },
        {
          "id": "p70-q13-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find his tax liability or tax refund, if he needs to pay the Medicare levy.",
              "marks": []
            }
          ]
        },
        {
          "id": "p70-q13-rounding",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Use 52 weeks in a year and the supplied 2022–23 tax table. Round taxable income down to the nearest whole dollar. Round income tax and the Medicare levy to the nearest cent before calculating total tax.",
              "marks": []
            }
          ]
        }
      ]
