  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A cone with diameter 6 cm has a volume of $120\\text{ cm}^3$. Find the height of the cone, correct to the nearest millimetre.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$127\\text{ mm}$",
      "worked": "The radius is $6\\div2=3$ cm.\n$$\\begin{align*}120&=\\frac13\\pi\\times3^2h\\\\120&=3\\pi h\\\\h&=\\frac{40}{\\pi}\\text{ cm}\\\\h&=\\frac{400}{\\pi}\\text{ mm}\\\\h&\\approx127\\text{ mm}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
