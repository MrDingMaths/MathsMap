  "content": {
    "id": "v2-a3909-p37-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Find the stationary point on the curve $y=-x^2+6x-4$ and determine its nature.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(3,5)$, maximum turning point.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=-2x+6\\\\-2x+6&=0\\\\x&=3\\\\y&=-3^2+6(3)-4\\\\y&=5\\\\\\frac{d^2y}{dx^2}&=-2<0\\end{align*}$$\nTherefore, $(3,5)$ is a maximum turning point.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
