  "content": {
    "id": "p22-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Write each of the following recurring decimals as a fraction:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$0.1111\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{9}$",
          "worked": "Let $x=0.1111\\ldots$. Then\n$$\\begin{align*}10x&=1.1111\\ldots\\\\x&=0.1111\\ldots\\\\10x-x&=1\\\\9x&=1\\\\x&=\\frac{1}{9}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.1212\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{33}$",
          "worked": "Let $x=0.1212\\ldots$. Then\n$$\\begin{align*}100x&=12.1212\\ldots\\\\x&=0.1212\\ldots\\\\100x-x&=12\\\\99x&=12\\\\x&=\\frac{12}{99}\\\\x&=\\frac{4}{33}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p22-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$0.123123\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{41}{333}$",
          "worked": "Let $x=0.123123\\ldots$. Then\n$$\\begin{align*}1000x&=123.123123\\ldots\\\\x&=0.123123\\ldots\\\\1000x-x&=123\\\\999x&=123\\\\x&=\\frac{123}{999}\\\\x&=\\frac{41}{333}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p22-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$3.0505\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{302}{99}$",
          "worked": "Let $x=3.0505\\ldots$. Then\n$$\\begin{align*}100x&=305.0505\\ldots\\\\x&=3.0505\\ldots\\\\100x-x&=302\\\\99x&=302\\\\x&=\\frac{302}{99}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
