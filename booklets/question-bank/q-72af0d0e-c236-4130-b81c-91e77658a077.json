  "content": {
    "id": "p27-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "For $\\triangle ABC$ we are given that $a=1$, $\\angle A=30^\\circ$ and $\\angle B=45^\\circ$. Find $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=\\sqrt{2}$",
      "worked": "Using the sine rule,\n$$\\begin{align*}\n\\frac{b}{\\sin45^\\circ}&=\\frac{1}{\\sin30^\\circ}\\\\\nb&=\\frac{\\sin45^\\circ}{\\sin30^\\circ}\\\\\nb&=\\frac{\\sqrt{2}/2}{1/2}\\\\\nb&=\\sqrt{2}.\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
