  "content": {
    "id": "p14-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Express each of the following natural numbers as a product of prime numbers:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times3$",
          "worked": "$$6=2\\times3.$$ Both factors are prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times3$",
          "worked": "$$\\begin{align*}12&=2\\times6\\\\12&=2\\times2\\times3\\\\12&=2^2\\times3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times3^2$",
          "worked": "$$\\begin{align*}36&=4\\times9\\\\36&=(2\\times2)\\times(3\\times3)\\\\36&=2^2\\times3^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$100$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times5^2$",
          "worked": "$$\\begin{align*}100&=10\\times10\\\\100&=(2\\times5)\\times(2\\times5)\\\\100&=2^2\\times5^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$140$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times5\\times7$",
          "worked": "$$\\begin{align*}140&=2\\times70\\\\140&=2\\times2\\times35\\\\140&=2\\times2\\times5\\times7\\\\140&=2^2\\times5\\times7.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$1200$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^4\\times3\\times5^2$",
          "worked": "$$\\begin{align*}1200&=12\\times100\\\\1200&=(2^2\\times3)\\times(2^2\\times5^2)\\\\1200&=2^4\\times3\\times5^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p14-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$3520$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^6\\times5\\times11$",
          "worked": "$$\\begin{align*}3520&=32\\times110\\\\3520&=2^5\\times(2\\times55)\\\\3520&=2^5\\times2\\times5\\times11\\\\3520&=2^6\\times5\\times11.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p14-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$2727$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^3\\times101$",
          "worked": "$$\\begin{align*}2727&=3\\times909\\\\2727&=3\\times3\\times303\\\\2727&=3\\times3\\times3\\times101\\\\2727&=3^3\\times101.\\end{align*}$$ Since $101$ is divisible by none of $2$, $3$, $5$ or $7$, it is prime.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
