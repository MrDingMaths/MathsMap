  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A PDF is given by $f(x)=ae^x$ over a certain domain. Find the exact value of $a$ if the domain is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$[1,7]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{1}{e(e^6-1)}$",
          "worked": "$$\\begin{align*}\\int_1^7 ae^x\\,dx&=1\\\\a[e^x]_1^7&=1\\\\a(e^7-e)&=1\\\\a&=\\frac{1}{e(e^6-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p15-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$[0,4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{1}{e^4-1}$",
          "worked": "$$\\begin{align*}\\int_0^4 ae^x\\,dx&=1\\\\a[e^x]_0^4&=1\\\\a(e^4-1)&=1\\\\a&=\\frac{1}{e^4-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
