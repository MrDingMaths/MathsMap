  "content": {
    "id": "p26-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Evaluate $\\dfrac{2x^2+y}{y^2}$ when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=3$ and $y=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11}{8}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+y}{y^2}&=\\frac{2\\times3^2+4}{4^2}\\\\\\frac{2x^2+y}{y^2}&=\\frac{18+4}{16}\\\\\\frac{2x^2+y}{y^2}&=\\frac{11}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=-\\dfrac{1}{2}$ and $y=\\dfrac{3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{9}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+y}{y^2}&=\\frac{2\\left(-\\frac12\\right)^2+\\frac32}{\\left(\\frac32\\right)^2}\\\\\\frac{2x^2+y}{y^2}&=\\frac{\\frac12+\\frac32}{\\frac94}\\\\\\frac{2x^2+y}{y^2}&=2\\times\\frac49\\\\\\frac{2x^2+y}{y^2}&=\\frac89\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\sqrt{3}$ and $y=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{2x^2+y}{y^2}&=\\frac{2(\\sqrt3)^2+(-2)}{(-2)^2}\\\\\\frac{2x^2+y}{y^2}&=\\frac{6-2}{4}\\\\\\frac{2x^2+y}{y^2}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p26-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=\\sqrt{6}$ and $y=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+y}{y^2}&=\\frac{2(\\sqrt6)^2+(-4)}{(-4)^2}\\\\\\frac{2x^2+y}{y^2}&=\\frac{12-4}{16}\\\\\\frac{2x^2+y}{y^2}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
