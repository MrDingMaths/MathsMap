  "content": {
    "id": "p11-ch7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write the equation of the parabola obtained when the graph of $y=x^2$ is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-ch7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "stretched by a factor of 3 from the $x$-axis and translated 2 units to the right",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3(x-2)^2$",
          "worked": "Stretching by a factor of 3 from the $x$-axis gives $y=3x^2$. Translating 2 units right replaces $x$ with $x-2$, giving $y=3(x-2)^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-ch7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "reflected in the $x$-axis and then translated 1 unit to the left and 3 units up",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x+1)^2+3$",
          "worked": "Reflection in the $x$-axis gives $y=-x^2$. Translating 1 unit left gives $y=-(x+1)^2$. Translating 3 units up gives $y=-(x+1)^2+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-ch7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "translated 5 units to the right and 4 units down",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-5)^2-4$",
          "worked": "Translating 5 units right gives $y=(x-5)^2$. Translating 4 units down gives $y=(x-5)^2-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
