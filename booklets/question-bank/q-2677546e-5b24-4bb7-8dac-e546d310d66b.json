    "children": [
      {
        "id": "p21-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the sum $S_n$ of the first $n$ terms of $7+14+28+\\cdots$ is $S_n=7(2^n-1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=\\dfrac{7(2^n-1)}{2-1}=7(2^n-1)$.",
          "worked": "$a=7$, $r=2$.\n$$\\begin{align*}S_n&=\\frac{a(r^n-1)}{r-1}\\\\S_n&=\\frac{7(2^n-1)}{2-1}\\\\S_n&=7(2^n-1)\\end{align*}$$\nAs required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p21-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "For what value of $n$ is $S_n$ equal to $1785$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=8$.",
          "worked": "$$\\begin{align*}7(2^n-1)&=1785\\\\2^n-1&=255\\\\2^n&=256\\\\2^n&=2^8\\\\n&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $a_n=7\\times2^{n-1}$, and find how many terms are less than $70000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=7\\times2^{n-1}$; $14$ terms are less than $70000$.",
          "worked": "$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=7\\times2^{n-1}\\end{align*}$$\nFor terms less than $70000$:\n$$\\begin{align*}7\\times2^{n-1}&<70000\\\\2^{n-1}&<10000\\\\n-1&<\\log_2 10000\\\\n&<\\log_2 10000+1\\\\n&<14.29\\ldots\\end{align*}$$\nSince $n$ is a positive integer, $n=1,2,\\ldots,14$. Therefore $14$ terms are less than $70000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p21-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Prove that the sum $S_n$ of the first $n$ terms is always $7$ less than the $(n+1)$th term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{n+1}-7=7\\times2^n-7=7(2^n-1)=S_n$.",
          "worked": "We need to show that $a_{n+1}-7=S_n$. From part a, $S_n=7(2^n-1)$.\n$$\\begin{align*}a_{n+1}-7&=(7\\times2^n)-7\\\\a_{n+1}-7&=7(2^n-1)\\\\a_{n+1}-7&=S_n\\end{align*}$$\nTherefore $S_n=a_{n+1}-7$, as required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
