    "type": "question",
    "label": "47",
    "prompt": "Rationalise the denominator of the following. $$\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4+\\sqrt{15}$",
      "worked": "$$\\begin{align*}\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}&=\\frac{(\\sqrt5+\\sqrt3)^2}{(\\sqrt5-\\sqrt3)(\\sqrt5+\\sqrt3)}\\\\\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}&=\\frac{5+2\\sqrt{15}+3}{5-3}\\\\\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}&=4+\\sqrt{15}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
