    "children": [],
    "answer": {
      "short": "$y=3(x+2)^2+1$",
      "worked": "$$\\begin{align*}y&=k(x+2)^2+1\\\\28&=k(-5+2)^2+1\\\\k&=3\\\\\\therefore y&=3(x+2)^2+1\\end{align*}$$",
