          "inlines": [
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f(x)=x^2-4x+3",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-ep-15a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x-4$",
          "worked": "$$\\begin{align*}f'(x)&=\\dfrac{d}{dx}(x^2-4x+3)\\\\f'(x)&=2x-4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p47-ep-15b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $a$ if $f'(a)=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3$",
          "worked": "$$\\begin{align*}f'(a)&=2a-4\\\\2a-4&=2\\\\2a&=6\\\\a&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p47-ep-15c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, write down the coordinates of the point $P$ on the curve where the gradient of the tangent is $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=(3,0)$",
          "worked": "\n\n$$\\begin{align*}f(3)&=3^2-4(3)+3\\\\f(3)&=0.\\end{align*}$$\n\n Hence, $P=(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p47-ep-15d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the tangent at $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-6$",
          "worked": "The tangent has gradient $2$ and passes through $(3,0)$.\n\n$$\\begin{align*}y-0&=2(x-3)\\\\y&=2x-6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p47-ep-15e",
        "type": "part",
        "label": "e",
        "prompt": "Find the equation of the normal at $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-3=0$",
          "worked": "The normal gradient is $-\\frac12$, the negative reciprocal of $2$.\n\n$$\\begin{align*}y-0&=-\\frac12(x-3)\\\\2y&=-x+3\\\\x+2y-3&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
