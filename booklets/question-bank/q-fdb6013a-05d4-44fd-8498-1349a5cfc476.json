  "content": {
    "id": "p19-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Billy worked for 35 hours at the normal hourly rate of pay and for five hours at double time. He earned \\$561.60 in total for this work. What was the normal hourly rate of pay?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$12.48/h",
      "worked": "$$\n\\begin{align*}\\text{Equivalent normal hours} &= 35 + (5 \\times 2) \\\\ &= 45 \\\\ \\text{Normal hourly rate} &= \\frac{561.60}{45} \\\\ &= \\$12.48/\\text{h}\\end{align*}\n$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
