        "label": "a",
        "prompt": "How many ways can you make change for 50 cents using 5, 10 and 20 cent pieces?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
