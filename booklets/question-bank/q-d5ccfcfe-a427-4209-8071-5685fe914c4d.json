  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use the Euclidean algorithm to find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "a multiplicative inverse of $3$ modulo $10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "Tracking the Euclidean subtraction gives\n$$\\begin{align*}10-3\\cdot3&=1.\\end{align*}$$\nHence,\n$$\\begin{align*}(-3)\\cdot3&\\equiv1\\pmod{10},\\\\7\\cdot3&\\equiv1\\pmod{10}.\\end{align*}$$\nA multiplicative inverse is $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "a multiplicative inverse of $4$ modulo $11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "Track the Euclidean subtractions and substitute back:\n$$\\begin{align*}11-2\\cdot4&=3,\\\\4-(11-2\\cdot4)&=1,\\\\3\\cdot4-11&=1.\\end{align*}$$\nThus,\n$$\\begin{align*}3\\cdot4&\\equiv1\\pmod{11}.\\end{align*}$$\nA multiplicative inverse is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "a multiplicative inverse of $5$ modulo $12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Track the Euclidean subtractions and substitute back:\n$$\\begin{align*}12-2\\cdot5&=2,\\\\5-2(12-2\\cdot5)&=1,\\\\5\\cdot5-2\\cdot12&=1.\\end{align*}$$\nThus,\n$$\\begin{align*}5\\cdot5&\\equiv1\\pmod{12}.\\end{align*}$$\nA multiplicative inverse is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "a multiplicative inverse of $6$ modulo $13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "Tracking the Euclidean subtraction gives\n$$\\begin{align*}13-2\\cdot6&=1.\\end{align*}$$\nHence,\n$$\\begin{align*}(-2)\\cdot6&\\equiv1\\pmod{13},\\\\11\\cdot6&\\equiv1\\pmod{13}.\\end{align*}$$\nA multiplicative inverse is $11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
