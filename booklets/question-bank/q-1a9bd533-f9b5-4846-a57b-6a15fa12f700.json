    "type": "question",
    "label": null,
    "prompt": "Mei Ling achieved a score of $35\\%$ in a science test. If the test was out of 40, what was her mark?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "14 marks",
      "worked": "$$\\begin{align*}35\\%&=\\frac{35}{100}\\\\&=\\frac{7}{20}\\\\&=\\frac{14}{40}\\end{align*}$$\n14 marks",
