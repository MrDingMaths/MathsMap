  "content": {
    "id": "p18-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "A square has a perimeter of 20 cm. Find its area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ cm}^2$",
          "worked": "$\\begin{align*}l&=20\\div4\\\\l&=5\\text{ cm}\\\\A&=5^2\\\\A&=25\\text{ cm}^2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "A square has an area of 9 square centimetres. Find its perimeter.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\text{ cm}$",
          "worked": "$\\begin{align*}l&=\\sqrt{9}\\\\l&=3\\text{ cm}\\\\P&=4\\times3\\\\P&=12\\text{ cm}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p18-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "A square’s area and perimeter are the same number. How many units is the side length?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 units; $4^2=4\\times4=16$.",
          "worked": "Area is side length × side length; perimeter is 4 × side length. These have the same numerical value when the side length is 4 units.\n\n$\\begin{align*}A&=4\\times4=16\\text{ square units}\\\\P&=4\\times4=16\\text{ units}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
