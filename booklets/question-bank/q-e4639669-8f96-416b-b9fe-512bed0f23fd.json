  "content": {
    "id": "p51-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the remainder when $P(x)=99x^{99}-1$ is divided by $x^2-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$99x-1$.",
      "worked": "Write $P(x)=(x^2-1)Q(x)+Ax+B$. Substituting the divisor's roots gives\n$$\\begin{align*}P(1)&=A+B=98\\\\P(-1)&=-A+B=-100\\\\2B&=-2\\\\B&=-1\\\\A-1&=98\\\\A&=99.\n\\end{align*}$$\nThe remainder is $99x-1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
