                    "latex": "4!\\times5!\\times6\\times5=86\\,400",
                    "display": false
                  }
                ]
              },
              {
                "id": "p8-q15-f-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Include all internal orders of the four-letter block; place E and F in different gaps.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Treat A, B, C and D as one block, with $4!$ internal orders. Arrange the block and G, H, I, J in $5!$ ways. Place E and F in two different gaps among the six available gaps.\n$$\\begin{align*}N&=4!\\times5!\\times6\\times5\\\\N&=86\\,400\\end{align*}$$",
