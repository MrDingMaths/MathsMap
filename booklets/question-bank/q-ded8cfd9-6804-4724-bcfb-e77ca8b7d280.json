              "type": "text",
              "text": "The first ten letters of the alphabet are to be arranged in a line. Find the number of possible arrangements if",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10!=3\\,628\\,800$",
          "worked": "Arrange the ten distinct letters in a line.\n$$\\begin{align*}N&=10!\\\\N&=3\\,628\\,800\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "the A and B are together.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2!\\times9!=725\\,760$",
          "worked": "Treat A and B as one block. Arrange the nine elements, then arrange A and B within their block.\n$$\\begin{align*}N&=2!\\times9!\\\\N&=725\\,760\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "the A and B are at either ends of the line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2!\\times8!=80\\,640$",
          "worked": "A and B can occupy the two ends in $2!$ orders. Arrange the remaining eight letters between them.\n$$\\begin{align*}N&=2!\\times8!\\\\N&=80\\,640\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "the A and B are together in the middle two spots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2!\\times8!=80\\,640$",
          "worked": "A and B occupy positions 5 and 6 in $2!$ orders. Arrange the remaining eight letters in the other positions.\n$$\\begin{align*}N&=2!\\times8!\\\\N&=80\\,640\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "the A and B are together, but the C and D are not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p8-q15-e-short-result",
                "type": "paragraph",
