  "content": {
    "id": "p41-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Three points are chosen uniformly on the circumference of a circle. Find the probability that the three points can all be located on the same half of the circle. Hint: Fix one of the three points and consider the condition under which the other two points both lie within a semicircle starting from that fixed point.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
