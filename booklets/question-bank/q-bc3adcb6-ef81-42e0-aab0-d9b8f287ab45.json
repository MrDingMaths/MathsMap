  "content": {
    "id": "p48-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A petrol tank holds 66 litres of fuel. If it contains 12 litres of petrol initially and the petrol pump fills it at 3 litres every 10 seconds, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "a linear equation for the amount of fuel ($F$ litres) in the tank after $t$ minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F = 12 + 18t$",
          "worked": "The filling rate is $3 \\times 6 = 18$ litres per minute. The initial amount is 12 litres.\n$$F = 12 + 18t$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p48-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "how long it will take to fill the tank.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 minutes",
          "worked": "$$\\begin{align*}66 &= 12 + 18t\\\\54 &= 18t\\\\t &= 3\\end{align*}$$\nThe tank fills in 3 minutes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p48-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "how long it will take to add 45 litres to the petrol tank.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 min 30 sec",
          "worked": "After adding 45 litres, the tank contains $12 + 45 = 57$ litres.\n$$\\begin{align*}57 &= 12 + 18t\\\\45 &= 18t\\\\t &= 2.5\\end{align*}$$\nIt takes 2 min 30 sec.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
