        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, simplify $\\sqrt{72}$ using as few steps as possible.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sqrt2$",
          "worked": "$$\\begin{align*}\\sqrt{72}&=\\sqrt{36}\\sqrt2\\\\\\sqrt{72}&=6\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
