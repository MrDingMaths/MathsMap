  "content": {
    "id": "p21-q7",
    "type": "question",
    "label": "7",
    "prompt": "For the function $f(x)=-x^3$, explain why the graph of $f(-x)$ and $-f(x)$ will look the same.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(-x)=-(-x)^3=x^3=-f(x)$. This is an odd function.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q7-answer-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}f(-x)&=-(-x)^3\\\\f(-x)&=x^3\\\\f(-x)&=-f(x)\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q7-answer-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "This is an odd function. Since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "f(-x)=-f(x)",
                "display": false
              },
              {
                "type": "text",
                "text": ", the two graphs are identical.",
                "marks": []
              }
            ]
          }
        ]
      },
