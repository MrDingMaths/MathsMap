  "content": {
    "id": "bridge-binomial-parameters-root",
    "type": "question",
    "label": "",
    "prompt": "The first three terms of $(1+ax)^n$ are $1+6x+12x^2+\\cdots$, where $n$ is an integer with $n\\ge2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "bridge-binomial-parameters-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the first three terms of $(1+ax)^n$ in terms of $a$ and $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+nax+\\frac{n(n-1)}2a^2x^2+\\cdots$",
          "worked": "Use $\\binom n0=1$, $\\binom n1=n$ and $\\binom n2=\\frac{n(n-1)}2$:\n$$(1+ax)^n=1+nax+\\frac{n(n-1)}2a^2x^2+\\cdots.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "bridge-binomial-parameters-b",
        "type": "part",
        "label": "b",
        "prompt": "Equate the coefficients of $x$ and $x^2$ to obtain two equations.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$na=6$, $\\frac{n(n-1)}2a^2=12$.",
          "worked": "Equating coefficients gives\n$$\\begin{aligned}na&=6\\\\\\frac{n(n-1)}2a^2&=12.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "bridge-binomial-parameters-c",
        "type": "part",
        "label": "c",
        "prompt": "Divide the second equation by the first to find $a(n-1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a(n-1)=4$.",
          "worked": "Since $na=6\\ne0$, division is valid:\n$$\\begin{aligned}\\frac{a(n-1)}2&=\\frac{12}{6}\\\\a(n-1)&=4.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "bridge-binomial-parameters-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find $a$ and $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$, $n=3$.",
          "worked": "$$\\begin{aligned}na-a&=4\\\\6-a&=4\\\\a&=2\\\\n&=\\frac62\\\\n&=3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
