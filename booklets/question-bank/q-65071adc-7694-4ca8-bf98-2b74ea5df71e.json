    "type": "question",
    "label": "10",
    "prompt": "The distance from the Sun to Earth is approximately $1.5\\times10^{11}$ metres. The speed of light is approximately $3\\times10^8$ metres per second. How many seconds does it take for light to travel from the Sun to the Earth?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $500$ seconds.",
      "worked": "$$\\begin{align*}t&=\\frac{\\text{distance}}{\\text{speed}}\\\\t&=\\frac{1.5\\times10^{11}}{3\\times10^8}\\\\t&=0.5\\times10^3\\\\t&=500\\text{ s}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
