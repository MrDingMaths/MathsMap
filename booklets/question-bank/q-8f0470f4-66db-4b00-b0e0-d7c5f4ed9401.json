    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q78a",
        "type": "part",
        "label": "a",
        "prompt": "Find $f(7)$ and $f(-5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(7)=3$, $f(-5)=3$.",
          "worked": "$$\\begin{align*}f(7)&=\\log_3\\big((7-4)(7+2)\\big)\\\\f(7)&=\\log_3(27)=3\\\\f(-5)&=\\log_3\\big((-5-4)(-5+2)\\big)\\\\f(-5)&=\\log_3(27)=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p22-q78b",
        "type": "part",
        "label": "b",
        "prompt": "Find $g(7)$ and $g(-5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(7)=3$; $g(-5)$ is undefined.",
          "worked": "$$\\begin{align*}g(7)&=\\log_3(3)+\\log_3(9)\\\\g(7)&=1+2\\\\g(7)&=3.\\end{align*}$$\n\nAt $x=-5$, the logarithmic arguments are $-9$ and $-3$. Neither has a real logarithm, so $g(-5)$ is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q78c",
        "type": "part",
        "label": "c",
        "prompt": "State the domain of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D_f=(-\\infty,-2)\\cup(4,\\infty)$.",
          "worked": "The logarithmic argument must be positive:\n\n$$(x-4)(x+2)>0.$$\n\nBoth factors are negative for $x<-2$ and positive for $x>4$. The endpoints give a zero argument and are excluded.\n\n$$D_f=(-\\infty,-2)\\cup(4,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p22-q78d",
        "type": "part",
        "label": "d",
        "prompt": "State the domain of $g$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D_g=(4,\\infty)$.",
          "worked": "Both logarithmic arguments must be positive:\n\n$$x-4>0\\quad\\text{and}\\quad x+2>0.$$\n\nTheir intersection is $x>4$, so\n\n$$D_g=(4,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
