            {
              "type": "math",
              "latex": "\\begin{aligned}f(x)&=\\log_3\\big((x-4)(x+2)\\big)\\\\g(x)&=\\log_3(x-4)+\\log_3(x+2)\\end{aligned}",
              "display": false
            }
