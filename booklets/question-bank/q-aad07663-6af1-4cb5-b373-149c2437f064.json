  "content": {
    "id": "p8-q14-root",
    "type": "question",
    "label": "",
    "prompt": "Tera- (T) is the metric prefix for trillion ($10^{12}=1\\,000\\,000\\,000\\,000$).\nThe distance from Mars to the Sun is $0.228\\ \\mathrm{Tm}$. Convert this distance to kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$228\\,000\\,000\\ \\mathrm{km}$",
      "worked": "Convert terametres to metres by multiplying by $10^{12}$, then divide by $1000$ to convert to kilometres.\n$$\\begin{align*}0.228\\ \\mathrm{Tm}&=(0.228\\times10^{12})\\ \\mathrm{m}\\\\&=(228\\,000\\,000\\,000\\div1000)\\ \\mathrm{km}\\\\&=228\\,000\\,000\\ \\mathrm{km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
