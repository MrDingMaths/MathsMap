  "content": {
    "id": "p52-q3-root",
    "type": "question",
    "label": null,
    "prompt": "Last year, a book club had 60 members. This year, the book club has 96 members.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How many more members does the club have this year than last year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "36 members.",
          "worked": "$$96-60=36$$\nThe club has 36 more members.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p52-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Work out the percentage increase in the number of members.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\%$ increase.",
          "worked": "$$\\begin{align*}\\text{Change}&=96-60\\\\&=36\\\\\\%\\text{ change}&=\\frac{36}{60}\\times100\\\\&=60\\%\\end{align*}$$\nThe membership increased by $60\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
