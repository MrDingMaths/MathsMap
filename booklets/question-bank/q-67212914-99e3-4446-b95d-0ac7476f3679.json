              "text": "A deck consists of the nine distinct letters of ",
              "marks": []
            },
            {
              "type": "text",
              "text": "HYPERBOLA",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": ". How many 5-card hands are there if",
              "marks": []
            }
          ]
        }
      ]
