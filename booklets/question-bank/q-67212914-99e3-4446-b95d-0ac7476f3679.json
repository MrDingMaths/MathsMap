        "label": "a",
        "prompt": "there are no restrictions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{9}{5}=126$",
          "worked": "Choose five of the nine distinct letters; order does not matter.\n\n$$N=\\binom{9}{5}=126.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "no vowels are chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{3}{0}\\binom{6}{5}=6$",
          "worked": "The vowels are A, E and O, leaving six consonants. Choose no vowels and five consonants.\n\n$$N=\\binom{3}{0}\\binom{6}{5}=6.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "exactly one vowel is chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{3}{1}\\binom{6}{4}=45$",
          "worked": "Choose one of the three vowels and four of the six consonants.\n\n$$\\begin{align*}N&=\\binom{3}{1}\\binom{6}{4}\\\\N&=3\\times15\\\\N&=45.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "exactly two vowels are chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{3}{2}\\binom{6}{3}=60$",
          "worked": "Choose two of the three vowels and three of the six consonants.\n\n$$\\begin{align*}N&=\\binom{3}{2}\\binom{6}{3}\\\\N&=3\\times20\\\\N&=60.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "all the vowels are chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{3}{3}\\binom{6}{2}=15$",
          "worked": "All three vowels are included, leaving two places for consonants.\n\n$$N=\\binom{3}{3}\\binom{6}{2}=15.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
