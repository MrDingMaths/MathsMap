    "type": "question",
    "label": "7",
    "prompt": "Convert these units. You may need to convert twice.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$3\\,\\mathrm{m}^2$ to $\\mathrm{mm}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\,000\\,000\\,\\mathrm{mm}^2$",
          "worked": "$$\\begin{align*}3\\,\\mathrm{m}^2 &= (3\\times100^2)\\,\\mathrm{cm}^2\\\\3\\,\\mathrm{m}^2 &= (30\\,000\\times10^2)\\,\\mathrm{mm}^2\\\\3\\,\\mathrm{m}^2 &= 3\\,000\\,000\\,\\mathrm{mm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.5\\,\\mathrm{m}^2$ to $\\mathrm{mm}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$500\\,000\\,\\mathrm{mm}^2$",
          "worked": "$$\\begin{align*}0.5\\,\\mathrm{m}^2 &= (0.5\\times100^2)\\,\\mathrm{cm}^2\\\\0.5\\,\\mathrm{m}^2 &= (5000\\times10^2)\\,\\mathrm{mm}^2\\\\0.5\\,\\mathrm{m}^2 &= 500\\,000\\,\\mathrm{mm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$1\\,000\\,000\\,\\mathrm{mm}^2$ to $\\mathrm{m}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,\\mathrm{m}^2$",
          "worked": "$$\\begin{align*}1\\,000\\,000\\,\\mathrm{mm}^2 &= (1\\,000\\,000\\div10^2)\\,\\mathrm{cm}^2\\\\1\\,000\\,000\\,\\mathrm{mm}^2 &= (10\\,000\\div100^2)\\,\\mathrm{m}^2\\\\1\\,000\\,000\\,\\mathrm{mm}^2 &= 1\\,\\mathrm{m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p8-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$2\\,\\mathrm{km}^2$ to $\\mathrm{m}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\,000\\,000\\,\\mathrm{m}^2$",
          "worked": "$$\\begin{align*}2\\,\\mathrm{km}^2 &= (2\\times1000^2)\\,\\mathrm{m}^2\\\\2\\,\\mathrm{km}^2 &= 2\\,000\\,000\\,\\mathrm{m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\,\\mathrm{km}^2$ to $\\mathrm{ha}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$200\\,\\mathrm{ha}$",
          "worked": "$$\\begin{align*}2\\,\\mathrm{km}^2 &= (2\\times10^2)\\,\\mathrm{ha}\\\\2\\,\\mathrm{km}^2 &= 200\\,\\mathrm{ha}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p8-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\,000\\,000\\,\\mathrm{m}^2$ to $\\mathrm{km}^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\,\\mathrm{km}^2$",
          "worked": "$$\\begin{align*}2\\,000\\,000\\,\\mathrm{m}^2 &= (2\\,000\\,000\\div1000^2)\\,\\mathrm{km}^2\\\\2\\,000\\,000\\,\\mathrm{m}^2 &= 2\\,\\mathrm{km}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
