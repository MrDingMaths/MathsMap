            "inlines": [
              {
                "type": "text",
                "text": "Equal tangent lengths give ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "c=(a-r)+(b-r)",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
