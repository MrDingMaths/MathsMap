  "content": {
    "id": "p26-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Suppose $\\triangle ABC$ is a right-angled triangle. Denote the side lengths by $a$, $b$ and $c$ where $c$ is the hypotenuse. Determine the value of the inradius in terms of $a$, $b$ and $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
