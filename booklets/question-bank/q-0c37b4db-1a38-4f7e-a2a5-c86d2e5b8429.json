    "children": [
      {
        "id": "p31-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$C$ lies halfway between $A$ and $B$. Determine the value of $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{3}{5}$",
          "worked": "The two distances from the midpoint are equal.\n$$\\begin{align*}\nB-A&=4\\frac{7}{10}-2\\frac{1}{2}\\\\\n&=4\\frac{7}{10}-2\\frac{5}{10}\\\\\n&=2\\frac{1}{5}\\\\\n\\frac{B-A}{2}&=\\frac{11}{5}\\div2=\\frac{11}{10}\\\\\nC&=2\\frac{1}{2}+1\\frac{1}{10}\\\\\n&=3\\frac{3}{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p31-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$B$ lies halfway between $A$ and $C$. Determine the value of $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac{9}{10}$",
          "worked": "Since $B$ is the midpoint, $BC=AB$.\n$$\\begin{align*}\nB-A&=4\\frac{7}{10}-2\\frac{1}{2}\\\\\n&=4\\frac{7}{10}-2\\frac{5}{10}\\\\\n&=2\\frac{1}{5}\\\\\nC&=4\\frac{7}{10}+2\\frac{1}{5}\\\\\n&=4\\frac{7}{10}+2\\frac{2}{10}\\\\\n&=6\\frac{9}{10}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
