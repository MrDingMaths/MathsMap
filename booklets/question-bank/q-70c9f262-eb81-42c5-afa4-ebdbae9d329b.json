        "label": "a",
        "prompt": "$\\frac{3x}{7}+\\frac{x}{7}=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{21}{2}$",
          "worked": "$$\\begin{aligned}\\frac{3x}{7}+\\frac{x}{7}&=6\\\\\\frac{4x}{7}&=6\\\\4x&=42\\\\x&=\\frac{21}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4p}{9}+\\frac{2p}{9}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\frac32$",
          "worked": "$$\\begin{aligned}\\frac{4p}{9}+\\frac{2p}{9}&=1\\\\\\frac{6p}{9}&=1\\\\6p&=9\\\\p&=\\frac32\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\frac{x}{5}+\\frac{2x}{5}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{aligned}-\\frac{x}{5}+\\frac{2x}{5}&=1\\\\\\frac{x}{5}&=1\\\\x&=5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2x}{7}+\\frac{x}{5}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{70}{17}$",
          "worked": "$$\\begin{aligned}\\frac{2x}{7}+\\frac{x}{5}&=2\\\\\\frac{10x+7x}{35}&=2\\\\17x&=70\\\\x&=\\frac{70}{17}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{m}{3}+\\frac{2m}{5}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{15}{11}$",
          "worked": "$$\\begin{aligned}\\frac{m}{3}+\\frac{2m}{5}&=1\\\\\\frac{5m+6m}{15}&=1\\\\11m&=15\\\\m&=\\frac{15}{11}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5m}{9}-\\frac{4m}{5}=1$",
