  "content": {
    "id": "p11-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Alexa cuts a yellow ribbon, of length $2\\frac{5}{6}$ metres, into four equal pieces. How long is each piece?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{17}{24}\\text{ m}$",
      "worked": "$$\\begin{align*}2\\frac{5}{6}\\div4&=\\frac{17}{6}\\div4\\\\2\\frac{5}{6}\\div4&=\\frac{17}{6}\\times\\frac{1}{4}\\\\2\\frac{5}{6}\\div4&=\\frac{17}{24}\\end{align*}$$\nEach piece is $\\frac{17}{24}$ metre long.",
      "solutionDiagrams": []
    },
