  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Suppose that A, B and C are the points $(2,5)$, $(5,14)$ and $(-2,13)$ respectively.\n\nIt is known that the angle between the vectors $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is $45^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the vectors $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ in component form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AB}=3\\mathbf{i}+9\\mathbf{j}$, $\\overrightarrow{AC}=-4\\mathbf{i}+8\\mathbf{j}$.",
          "worked": "$$\\begin{aligned}\\overrightarrow{AB}&=(5-2,14-5)=3\\mathbf{i}+9\\mathbf{j}\\\\\\overrightarrow{AC}&=(-2-2,13-5)=-4\\mathbf{i}+8\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\overrightarrow{AB}\\cdot\\overrightarrow{AC}$ using the result $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=x_1x_2+y_1y_2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AB}\\cdot\\overrightarrow{AC}&=3(-4)+9(8)\\\\&=-12+72\\\\&=60\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p13-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Confirm your answer to part b using the result $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{u}||\\underset{\\sim}{v}|\\cos\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\overrightarrow{AB}||\\overrightarrow{AC}|\\cos45^\\circ=60$.",
          "worked": "$$\\begin{aligned}|\\overrightarrow{AB}|&=\\sqrt{9+81}=\\sqrt{90}\\\\|\\overrightarrow{AC}|&=\\sqrt{16+64}=\\sqrt{80}\\end{aligned}$$\n\n$$\\begin{aligned}\\overrightarrow{AB}\\cdot\\overrightarrow{AC}&=|\\overrightarrow{AB}||\\overrightarrow{AC}|\\cos45^\\circ\\\\&=\\sqrt{90}\\times\\sqrt{80}\\times\\frac{1}{\\sqrt2}\\\\&=60\\end{aligned}$$\n\nThis agrees with part b.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
