  "content": {
    "id": "p17-q16-response",
    "type": "question",
    "label": "16",
    "prompt": "Let $A$ and $B$ be events for which $\\Pr(B)=0.7$, $\\Pr(A\\cap B)=0.3$ and $\\Pr(B\\mid A)=0.6$. Find $\\Pr(A\\cup B)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.9$",
      "worked": "$$\\begin{align*}\\Pr(A)&=\\frac{\\Pr(A\\cap B)}{\\Pr(B\\mid A)}\\\\\\Pr(A)&=\\frac{0.3}{0.6}\\\\\\Pr(A)&=0.5\\end{align*}$$\n$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A\\cap B)\\\\\\Pr(A\\cup B)&=0.5+0.7-0.3\\\\\\Pr(A\\cup B)&=0.9\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
