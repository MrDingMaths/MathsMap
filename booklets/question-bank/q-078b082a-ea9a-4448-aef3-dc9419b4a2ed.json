  "content": {
    "id": "p19-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Let $2x^2-5x+3=a(x-2)^2+b(x-2)+c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Equate the coefficients of $x^2$ to find the value of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$",
          "worked": "Equating the coefficients of $x^2$ gives $a=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $x=2$ into the identity to find the value of $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=1$",
          "worked": "Substitute $x=2$:\n$$\\begin{align*}2(2)^2-5(2)+3&=a(2-2)^2+b(2-2)+c\\\\1&=c.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Substitute $x=3$ into the identity to find the value of $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=3$",
          "worked": "Substitute $x=3$, $a=2$ and $c=1$:\n$$\\begin{align*}2(3)^2-5(3)+3&=2(3-2)^2+b(3-2)+1\\\\6&=2+b+1\\\\b&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Why was the value $x=3$ chosen in part c?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It makes each bracket on the right-hand side equal to $1$.",
          "worked": "When $x=3$, $x-2=1$, so $(x-2)^2=1$ as well. The right-hand side becomes $a+b+c$, making $b$ easy to find using the known values of $a$ and $c$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
