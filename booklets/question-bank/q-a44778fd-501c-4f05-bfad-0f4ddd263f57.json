  "content": {
    "id": "p15-q3-6-root",
    "type": "question",
    "label": "3",
    "prompt": "True or False?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q3",
        "type": "part",
        "label": "a",
        "prompt": "For $\\sin\\theta$, as many multiples of $180^\\circ$ may be added to the angle without changing the value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$\\sin(180^\\circ+\\theta)=-\\sin\\theta$. Adding an odd multiple of $180^\\circ$ reverses the sign, so the value is not generally unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p15-q4",
        "type": "part",
        "label": "b",
        "prompt": "For $\\cos\\theta$, as many multiples of $180^\\circ$ may be added to the angle without changing the value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$\\cos(180^\\circ+\\theta)=-\\cos\\theta$. Adding an odd multiple of $180^\\circ$ reverses the sign, so the value is not generally unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p15-q5",
        "type": "part",
        "label": "c",
        "prompt": "For $\\tan\\theta$, as many multiples of $180^\\circ$ may be added to the angle without changing the value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$\\tan(180^\\circ+\\theta)=\\tan\\theta$. Repeating this half-turn preserves the gradient, so adding any integer multiple of $180^\\circ$ preserves tangent wherever it is defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p15-q6",
        "type": "part",
        "label": "d",
        "prompt": "For any trigonometric expression, as many multiples of $360^\\circ$ may be added to the angle without changing the value.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Adding an integer multiple of $360^\\circ$ completes full revolutions and returns to the same terminal ray. Its coordinates and gradient are unchanged, so the trigonometric values are unchanged wherever defined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
