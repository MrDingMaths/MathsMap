  "content": {
    "id": "p18-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A number is equal to one more than its reciprocal. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1+\\sqrt5}{2}$ or $\\frac{1-\\sqrt5}{2}$.",
      "worked": "Let the number be $x\\ne0$.\n$$\\begin{align*}x&=1+\\frac1x\\\\x^2&=x+1\\\\x^2-x-1&=0\\\\x&=\\frac{1\\pm\\sqrt{(-1)^2-4(1)(-1)}}{2(1)}\\\\x&=\\frac{1\\pm\\sqrt5}{2}\\end{align*}$$\nBoth values are nonzero and satisfy the original equation.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
