  "content": {
    "id": "p14-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The number of people who enter Luna Park on a particular Sunday is 3200. Of these, 1250 purchase a ride on the rollercoaster. What percentage of the 3200 people purchase a ride on the rollercoaster?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$39\\frac{1}{16}\\%$",
      "worked": "$$\\begin{align*}\\text{Percentage purchasing a ride}&=\\frac{1250}{3200}\\times100\\%\\\\\\text{Percentage purchasing a ride}&=\\frac{625}{16}\\%\\\\\\text{Percentage purchasing a ride}&=39\\frac{1}{16}\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
