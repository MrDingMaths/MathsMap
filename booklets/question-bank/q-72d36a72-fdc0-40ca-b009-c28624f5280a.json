  "content": {
    "id": "p76-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Six people, of whom Patrick and Jessica are two, arrange themselves in a row. Find the probability that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Patrick and Jessica occupy the end positions,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{15}$",
          "worked": "Patrick and Jessica occupy the ends in $2!$ ways. The other four people can be arranged in $4!$ ways.\n$$P=\\frac{2!\\times4!}{6!}=\\frac{1}{15}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p76-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Patrick and Jessica are not next to each other.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "Treat Patrick and Jessica as one unit when they are together: there are $5!$ arrangements of the units and $2!$ arrangements within their unit.\n$$\\begin{aligned}P(\\text{not together})&=1-P(\\text{together})\\\\&=1-\\frac{5!\\times2!}{6!}\\\\&=\\frac{2}{3}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
