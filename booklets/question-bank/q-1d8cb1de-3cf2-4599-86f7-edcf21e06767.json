  "content": {
    "id": "p2-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Prove each of the following:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "The sum of two even numbers is even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Writing the numbers as $2a$ and $2b$ gives $2a+2b=2(a+b)$, which is even.",
          "worked": "Let $m=2a$ and $n=2b$, where $a$ and $b$ are integers.\n$$\\begin{align*}m+n&=2a+2b\\\\m+n&=2(a+b)\\end{align*}$$\nSince $a+b$ is an integer, $m+n$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The sum of an even and an odd number is odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Writing the numbers as $2a$ and $2b+1$ gives $2a+(2b+1)=2(a+b)+1$, which is odd.",
          "worked": "Let $m=2a$ and $n=2b+1$, where $a$ and $b$ are integers.\n$$\\begin{align*}m+n&=2a+(2b+1)\\\\m+n&=2(a+b)+1\\end{align*}$$\nSince $a+b$ is an integer, $m+n$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The product of two even numbers is even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Writing the numbers as $2a$ and $2b$ gives $(2a)(2b)=2(2ab)$, which is even.",
          "worked": "Let $m=2a$ and $n=2b$, where $a$ and $b$ are integers.\n$$\\begin{align*}mn&=(2a)(2b)\\\\mn&=2(2ab)\\end{align*}$$\nSince $2ab$ is an integer, $mn$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
