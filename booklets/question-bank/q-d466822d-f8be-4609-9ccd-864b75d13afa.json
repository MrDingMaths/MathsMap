      {
        "id": "p5-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Subtract $a(b+c-a)$ from the sum of $b(c+a-b)$ and $c(a+b-c)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-b^2-c^2+2bc$",
          "worked": "$$\\begin{align*}b(c+a-b)+c(a+b-c)-a(b+c-a)&=bc+ab-b^2+ac+bc-c^2-ab-ac+a^2\\\\b(c+a-b)+c(a+b-c)-a(b+c-a)&=a^2-b^2-c^2+2bc\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Subtract the sum of $2x^2-3(x-1)$ and $2x+3(x^2-2)$ from the sum of $5x^2-(x-2)$ and $x^2-2(x+1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-2x+3$",
          "worked": "Let $A$ be the sum being subtracted and $B$ the sum from which it is subtracted.\n\n$$\\begin{align*}A&=2x^2-3(x-1)+2x+3(x^2-2)\\\\A&=2x^2-3x+3+2x+3x^2-6\\\\A&=5x^2-x-3\\\\B&=5x^2-(x-2)+x^2-2(x+1)\\\\B&=5x^2-x+2+x^2-2x-2\\\\B&=6x^2-3x\\\\B-A&=6x^2-3x-(5x^2-x-3)\\\\B-A&=x^2-2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "If $X=x-a$ and $Y=2x+a$, find the product of $Y-X$ and $X+3Y$ in terms of $x$ and $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x^2+16ax+4a^2$",
          "worked": "$$\\begin{align*}Y-X&=(2x+a)-(x-a)\\\\Y-X&=x+2a\\\\X+3Y&=(x-a)+3(2x+a)\\\\X+3Y&=7x+2a\\\\(Y-X)(X+3Y)&=(x+2a)(7x+2a)\\\\(Y-X)(X+3Y)&=7x^2+2ax+14ax+4a^2\\\\(Y-X)(X+3Y)&=7x^2+16ax+4a^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
