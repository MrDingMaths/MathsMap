  "content": {
    "id": "p27-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In a social club, there are two groups. Group $A$ has 4 members, and Group $B$ has 3 members.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can two people be chosen from the 7 members of the social club?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{7}{2}=21$ ways.",
          "worked": "Choose two members without regard to order.\n$$\\binom{7}{2}=\\frac{7\\times6}{2}=21$$\nThere are 21 ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "How many ways can two people be chosen from group $A$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{4}{2}=6$ ways.",
          "worked": "Choose two of the four members of group $A$.\n$$\\binom{4}{2}=\\frac{4\\times3}{2}=6$$\nThere are 6 ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "How many ways can two people be chosen from group $B$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{3}{2}=3$ ways.",
          "worked": "Choose two of the three members of group $B$.\n$$\\binom{3}{2}=\\frac{3\\times2}{2}=3$$\nThere are 3 ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "How many ways can one person be chosen from group $A$, and one person from group $B$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{4}{1}\\binom{3}{1}=12$ ways.",
          "worked": "There are 4 choices from group $A$ and, for each choice, 3 choices from group $B$.\n$$\\binom{4}{1}\\binom{3}{1}=4\\times3=12$$\nThere are 12 ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p27-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "Express your answer to part (a) in terms of the answers found in parts (b) – (d).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p27-q8-e-short-equation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\binom{7}{2}=\\binom{4}{2}+\\binom{3}{2}+\\binom{4}{1}\\binom{3}{1}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p27-q8-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the cases: both from A, both from B, or one from each.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Every pair consists of either two members from group $A$, two from group $B$, or one from each group. These cases are mutually exclusive and include every pair, so their counts add to the count in part (a).\n$$\\begin{align*}\\binom{7}{2}&=\\binom{4}{2}+\\binom{3}{2}+\\binom{4}{1}\\binom{3}{1}\\\\\\binom{7}{2}&=6+3+12\\\\\\binom{7}{2}&=21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
