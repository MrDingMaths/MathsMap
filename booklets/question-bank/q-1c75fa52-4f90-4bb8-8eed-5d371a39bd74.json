              "type": "text",
              "text": "A restaurant has a 1.5% surcharge on all credit card payments.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How much would a $32.50 meal cost if paying by card? Give your answer to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$32.99$",
      "worked": "$$\\begin{aligned}\\text{Multiplier} &= \\frac{100+1.5}{100}=1.015\\\\\\text{Cost} &= \\$32.50\\times1.015\\\\\\text{Cost} &= \\$32.9875\\\\\\text{Cost} &\\approx \\$32.99\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
