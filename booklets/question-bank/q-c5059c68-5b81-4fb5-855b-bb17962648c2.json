  "content": {
    "id": "v2-04320-p16-practice-slot-6-2-root",
    "type": "question",
    "label": null,
    "prompt": "A regular octagon has been enlarged by scale factor 5. The image has a perimeter of 80 cm.\nWhat is the length of each side of the original octagon?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\text{ cm}$",
      "worked": "A regular octagon has eight equal sides.\n$$\\begin{align*}\\text{Image side length}&=80\\div8\\\\&=10\\text{ cm}\\\\\\text{Original side length}&=10\\div5\\\\&=2\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
