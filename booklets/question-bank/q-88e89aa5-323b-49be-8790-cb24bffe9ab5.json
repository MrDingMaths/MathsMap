    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Solve $(-5)^x=25$ for $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$.",
          "worked": "An even integer power gives a positive result. Since $(-5)^2=25$, the solution is $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $(-5)^x=125$ has no solution.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution: magnitude $125=5^3$ requires $x=3$, but $(-5)^3=-125$.",
          "worked": "For a defined real power to have magnitude $125=5^3$, the exponent must be $3$. However, $(-5)^3=-125$, because an odd integer power of a negative number is negative. Hence there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why $(-5)^{\\frac12}$ is undefined.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-5)^{\\frac12}=\\sqrt{-5}$ is undefined over the real numbers.",
          "worked": "The exponent $\\frac12$ represents a square root. No real number has square $-5$, since the square of every real number is nonnegative. Therefore $(-5)^{\\frac12}$ is undefined over the real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p8-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why $a^x$ cannot be defined for all real values of $x$ whenever $a<0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If $a<0$, taking $x=\\frac12$ gives $\\sqrt a$, which has no real value. Thus $a^x$ is not defined for every real $x$.",
          "worked": "Choose the real input $x=\\frac12$. Then $a^x=\\sqrt a$. For $a<0$, this square root has no real value. This one undefined input is enough to show that $a^x$ cannot define a real-valued function for all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
