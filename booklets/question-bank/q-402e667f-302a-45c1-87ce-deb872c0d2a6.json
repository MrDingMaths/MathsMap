  "content": {
    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve the following quadratic equations by first factorising.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2+5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12$ or $x=-2$",
          "worked": "$$\\begin{align*}2x^2+4x+x+2&=0\\\\2x(x+2)+(x+2)&=0\\\\(2x+1)(x+2)&=0\\\\x&=-\\tfrac12,\\quad -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2-5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$ or $x=2$",
          "worked": "$$\\begin{align*}2x^2-4x-x+2&=0\\\\2x(x-2)-(x-2)&=0\\\\(2x-1)(x-2)&=0\\\\x&=\\tfrac12,\\quad 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2+2x-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac43$ or $x=-2$",
          "worked": "$$\\begin{align*}3x^2+6x-4x-8&=0\\\\3x(x+2)-4(x+2)&=0\\\\(3x-4)(x+2)&=0\\\\x&=\\tfrac43,\\quad -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2-4x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac32$ or $x=-\\frac12$",
          "worked": "$$\\begin{align*}4x^2-6x+2x-3&=0\\\\2x(2x-3)+(2x-3)&=0\\\\(2x+1)(2x-3)&=0\\\\x&=\\tfrac32,\\quad -\\tfrac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p13-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$6x^2-x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac13$ or $x=\\frac12$",
          "worked": "$$\\begin{align*}6x^2-3x+2x-1&=0\\\\3x(2x-1)+(2x-1)&=0\\\\(3x+1)(2x-1)&=0\\\\x&=-\\tfrac13,\\quad \\tfrac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p13-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$6x^2+11x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac16$ or $x=-2$",
          "worked": "$$\\begin{align*}6x^2+12x-x-2&=0\\\\6x(x+2)-(x+2)&=0\\\\(6x-1)(x+2)&=0\\\\x&=\\tfrac16,\\quad -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
