  "content": {
    "id": "p7-f2-root",
    "type": "question",
    "label": "2",
    "prompt": "Complete the following.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-f2-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^{-n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a^n}$",
          "worked": "Take the reciprocal of the positive power. For $a\\ne0$, $a^{-n}=\\frac{1}{a^n}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-f2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(ab)^0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "The entire product is the base. For $ab\\ne0$, $(ab)^0=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-f2-c",
        "type": "part",
        "label": "c",
        "prompt": "$ab^0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$",
          "worked": "The zero index applies to $b$. For $b\\ne0$, $$\\begin{align*}ab^0&=a\\times1\\\\ab^0&=a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-f2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{a^{-n}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^n$",
          "worked": "$$\\begin{align*}\\frac{1}{a^{-n}}&=\\frac{1}{1/a^n}\\\\\\frac{1}{a^{-n}}&=a^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-f2-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^{-\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{\\sqrt a}$",
          "worked": "$$\\begin{align*}a^{-\\frac{1}{2}}&=\\frac{1}{a^{\\frac{1}{2}}}\\\\a^{-\\frac{1}{2}}&=\\frac{1}{\\sqrt a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-f2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{a}{b}\\right)^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^n}{b^n}$",
          "worked": "Apply the power to both numerator and denominator. $\\left(\\frac{a}{b}\\right)^n=\\frac{a^n}{b^n}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-f2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\frac{a}{b}\\right)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b}{a}$",
          "worked": "The index $-1$ gives the reciprocal. $\\left(\\frac{a}{b}\\right)^{-1}=\\frac{b}{a}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-f2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\frac{a}{b}\\right)^{-n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b^n}{a^n}$",
          "worked": "$$\\begin{align*}\\left(\\frac{a}{b}\\right)^{-n}&=\\left(\\frac{b}{a}\\right)^n\\\\\\left(\\frac{a}{b}\\right)^{-n}&=\\frac{b^n}{a^n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
