  "content": {
    "id": "p31-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Consider the polynomial $P(x)=x^3+ax^2+b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $P(w)-P(-w)$ in terms of $w$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2w^3$",
          "worked": "$$\\begin{align*}P(w)&=w^3+aw^2+b\\\\P(-w)&=(-w)^3+a(-w)^2+b\\\\P(-w)&=-w^3+aw^2+b\\\\P(w)-P(-w)&=(w^3+aw^2+b)-(-w^3+aw^2+b)\\\\P(w)-P(-w)&=2w^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p31-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the values of $a$ and $b$ if the graph of $y=P(x)$ passes through the point with coordinates $(1,3)$ and $(2,4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p31-q12-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a=-2,\\quad b=4",
                    "display": false
                  }
                ]
              },
              {
                "id": "p31-q12-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P(1)=3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P(2)=4",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then solve simultaneously.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The coordinates give $P(1)=3$ and $P(2)=4$.\n$$\\begin{align*}1^3+a(1)^2+b&=3\\\\a+b&=2\\qquad\\text{(1)}\\\\2^3+a(2)^2+b&=4\\\\4a+b&=-4\\qquad\\text{(2)}\\end{align*}$$\nSubtract (1) from (2).\n$$\\begin{align*}(4a+b)-(a+b)&=-4-2\\\\3a&=-6\\\\a&=-2\\end{align*}$$\nSubstitute into (1).\n$$\\begin{align*}-2+b&=2\\\\b&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      }
    ]
  },
