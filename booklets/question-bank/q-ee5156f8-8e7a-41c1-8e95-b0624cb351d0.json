  "content": {
    "id": "p6-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "State whether these events are impossible, unlikely, even chance, likely, or certain.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Rolling a fair 6-sided die and landing on a 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Unlikely",
          "worked": "Only one of the six equally likely outcomes is a 4, giving less than an even chance.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "The time being 11:00 am one hour after 10:00 am.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Certain",
          "worked": "Certain. One hour after 10:00 am is always 11:00 am.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Getting 13 questions correct on a test containing 10 questions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Impossible",
          "worked": "Impossible. At most 10 questions can be correct on a test containing 10 questions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p6-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Picking a banana at random out of the following fruit bowl.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p6-q1-d-bowl",
            "role": "question",
            "format": "image",
            "code": null,
            "src": "/booklet-assets/projects/probability-v1/fruit-bowl.png",
            "widthMm": 43.32,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "retentionReason": "Exact original fruit-bowl illustration: two grape clusters, red and yellow round fruits and cut avocado, with no banana. Fruit identities define the possible outcomes, so original pictorial evidence is retained.",
            "derived": false
          }
        ],
        "children": [],
        "answer": {
          "short": "Impossible.",
          "worked": "There is no banana in the pictured bowl, so picking a banana is impossible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
