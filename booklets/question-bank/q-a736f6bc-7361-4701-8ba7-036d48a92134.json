  "content": {
    "id": "p46-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "A certain curve has the property that the normal at any point passes through the origin.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the gradient of the line from $(0,0)$ to $(x,y)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y}{x}$.",
          "worked": "$$\\begin{aligned}m&=\\frac{y-0}{x-0}\\\\&=\\frac{y}{x}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p46-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "Now suppose $(x,y)$ is on this curve. Write down a DE for this curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=-\\dfrac{x}{y}$.",
          "worked": "The normal passes through $(0,0)$ and $(x,y)$, so its gradient is $\\frac{y}{x}$. The tangent is perpendicular to the normal, giving\n$$\\frac{dy}{dx}=-\\frac{x}{y}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p46-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence determine the general equation of this curve, which is a relation and not a function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=r^2$, $r>0$: circles centred at the origin.",
          "worked": "$$\\begin{aligned}y\\,dy&=-x\\,dx\\\\\\int y\\,dy&=-\\int x\\,dx\\\\\\frac{y^2}{2}&=-\\frac{x^2}{2}+C\\\\x^2+y^2&=r^2.\\end{aligned}$$\nThis is a family of circles centred at the origin, with radius $r>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
