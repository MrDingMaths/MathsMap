  "content": {
    "id": "v2-21-median-practice-retro-slot-6-222806-root",
    "type": "question",
    "label": null,
    "prompt": "Find the median and range of:\n\n$\\dfrac{3}{8}\\quad 0.4\\quad 35\\%\\quad \\dfrac{1}{2}\\quad 45\\%$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Median: $0.4$; range: $0.15$. Convert to decimals and order.",
      "worked": "Divide the percentages by $100$ and the numerator by the denominator: $\\frac{3}{8}=0.375$, $35\\%=0.35$, $\\frac{1}{2}=0.5$ and $45\\%=0.45$.\nOrdered data: $0.35,\\ 0.375,\\ \\underline{0.4},\\ 0.45,\\ 0.5$.\nThe third value is the middle value.\n$$\\begin{align*}\\mathrm{Median}&=0.4\\\\\\mathrm{Range}&=\\mathrm{Max}-\\mathrm{Min}\\\\\\mathrm{Range}&=0.5-0.35\\\\\\mathrm{Range}&=0.15\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
