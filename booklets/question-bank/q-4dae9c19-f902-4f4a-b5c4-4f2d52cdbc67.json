  "content": {
    "id": "p25-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Factor each expression where possible, then simplify it.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{6a+3b}{10a+5b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{align*}\\frac{6a+3b}{10a+5b}&=\\frac{3(2a+b)}{5(2a+b)}\\\\\\frac{6a+3b}{10a+5b}&=\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2x-2y}{x^2-y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{x+y}$",
          "worked": "$$\\begin{align*}\\frac{2x-2y}{x^2-y^2}&=\\frac{2(x-y)}{(x-y)(x+y)}\\\\\\frac{2x-2y}{x^2-y^2}&=\\frac{2}{x+y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x^2+2x-3}{x^2-5x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+3}{x-4}$",
          "worked": "$$\\begin{align*}\\frac{x^2+2x-3}{x^2-5x+4}&=\\frac{(x+3)(x-1)}{(x-1)(x-4)}\\\\\\frac{x^2+2x-3}{x^2-5x+4}&=\\frac{x+3}{x-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2x^2+3x+1}{2x^3+x^2+2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+1}{x^2+1}$",
          "worked": "$$\\begin{align*}2x^2+3x+1&=2x(x+1)+(x+1)\\\\2x^2+3x+1&=(2x+1)(x+1)\\\\2x^3+x^2+2x+1&=x^2(2x+1)+(2x+1)\\\\2x^3+x^2+2x+1&=(2x+1)(x^2+1)\\end{align*}$$\n$$\\begin{align*}\\frac{2x^2+3x+1}{2x^3+x^2+2x+1}&=\\frac{(2x+1)(x+1)}{(2x+1)(x^2+1)}\\\\\\frac{2x^2+3x+1}{2x^3+x^2+2x+1}&=\\frac{x+1}{x^2+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p25-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{a+b}{a^2+2ab+b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a+b}$",
          "worked": "$$\\begin{align*}\\frac{a+b}{a^2+2ab+b^2}&=\\frac{a+b}{(a+b)^2}\\\\\\frac{a+b}{a^2+2ab+b^2}&=\\frac{1}{a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3x^2-19x-14}{9x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-7}{3x-2}$",
          "worked": "$$\\begin{align*}3x^2-19x-14&=3x^2-21x+2x-14\\\\3x^2-19x-14&=3x(x-7)+2(x-7)\\\\3x^2-19x-14&=(3x+2)(x-7)\\end{align*}$$\n$$\\begin{align*}\\frac{3x^2-19x-14}{9x^2-4}&=\\frac{(3x+2)(x-7)}{(3x+2)(3x-2)}\\\\\\frac{3x^2-19x-14}{9x^2-4}&=\\frac{x-7}{3x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
