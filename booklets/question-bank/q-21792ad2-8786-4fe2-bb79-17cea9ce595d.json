  "content": {
    "id": "v2-2e5df0-p5-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "For the polynomial $P(x)=(2a-1)x^2+(b+3)x+c-2$, find $a$, $b$, $c$ given that:\n\nThe leading coefficient is 5, there is no $x$ term, and the constant term is 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=3,\\ b=-3,\\ c=8$.",
      "worked": "The leading coefficient is the coefficient of $x^2$. There is no $x$ term, so its coefficient is zero. The constant term is 6.\n\n$$\\begin{align*}2a-1&=5\\\\a&=3\\\\b+3&=0\\\\b&=-3\\\\c-2&=6\\\\c&=8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
