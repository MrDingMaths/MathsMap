            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$x=\\sqrt5$.",
          "worked": "Let $h$ be the shared altitude. Both lengths are positive.\n$$\\begin{align*}h^2+5^2&=6^2\\\\h^2&=11\\\\x^2+h^2&=4^2\\\\x^2+11&=16\\\\x^2&=5\\\\x&=\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68,
        "responseSpace": "scaffold"
