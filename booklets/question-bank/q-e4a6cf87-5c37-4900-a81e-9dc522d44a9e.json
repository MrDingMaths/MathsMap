            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 4 p4-q2-a-diagram\"}\n\\begin{tikzpicture}[x=0.5cm,y=0.5cm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\usetikzlibrary{angles}\n\\coordinate (L) at (-5,0);\\coordinate (F) at (0,0);\\coordinate (R) at ({sqrt(5)},0);\\coordinate (T) at (0,{sqrt(11)});\n\\draw[line width=0.8pt] (L)--(T)--(R)--cycle (T)--(F);\n\\pic[draw,line width=0.4pt,angle radius=2mm]{right angle=T--F--R};\n\\path (L)--(T) node[midway,above left] {$6$};\\path (T)--(R) node[midway,above right] {$4$};\\path (L)--(F) node[midway,below] {$5$};\\path (F)--(R) node[midway,below] {$x$};\n\\end{tikzpicture}",
