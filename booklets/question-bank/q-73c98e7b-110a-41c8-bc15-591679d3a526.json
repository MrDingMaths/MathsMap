    "label": "19",
    "prompt": "When a child is born, the probability of a boy is 0.51 and the probability of a girl is 0.49.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q19-tree-response",
