        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "See probability tree. $B$ denotes a boy and $G$ denotes a girl.",
          "worked": "Birth order determines the stages. At each stage, $P(B)=0.51$ and $P(G)=0.49$. The outcomes are $BB$, $BG$, $GB$ and $GG$.",
          "solutionDiagrams": [
            {
              "id": "p36-q19-tree-solution",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 36, p36-q19-tree-solution\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=0.6mm}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\node[align=center] at (14,29) {First\\\\child};\\node[align=center] at (31,29) {Second\\\\child};\\node at (46,29) {Outcome};\n\\draw (0,0)--(14,12) (0,0)--(14,-12);\n\\draw (14,12)--(30,20) (14,12)--(30,4) (14,-12)--(30,-4) (14,-12)--(30,-20);\n\\node[above left,fill=white] at (7,6) {$0.51$};\\node[below left,fill=white] at (7,-6) {$0.49$};\n\\node[above,fill=white] at (23,16) {$0.51$};\\node[below,fill=white] at (23,8) {$0.49$};\\node[above,fill=white] at (23,-8) {$0.51$};\\node[below,fill=white] at (23,-16) {$0.49$};\n\\node[fill=white] at (14,12) {$B$};\\node[fill=white] at (14,-12) {$G$};\n\\foreach \\y/\\a/\\out in {20/B/BB,4/G/BG,-4/B/GB,-20/G/GG}{\\node[anchor=west,fill=white] at (30,\\y) {$\\a$};\\node at (46,\\y) {$\\out$};}\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 120,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 36,
                "sourceRegion": "Question 19 tree-drawing instruction",
                "description": "Authored solution tree with two stages in birth order, four ordered outcomes and all six branch probabilities. No tree is supplied in the student prompt.",
                "mathematics": "Each birth has branches B with probability 0.51 and G with probability 0.49; the second-stage probabilities are unchanged under the source's assumed independence.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p36-q19-a",
        "type": "group",
        "label": "b",
        "prompt": "Calculate the probability, as a decimal:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p36-q19-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Two boys",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.2601$",
              "worked": "$$\\begin{aligned}P(BB)&=0.51\\times0.51\\\\&=0.2601\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p36-q19-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "A boy then a girl, in that order.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.2499$",
              "worked": "$$\\begin{aligned}P(BG)&=0.51\\times0.49\\\\&=0.2499\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p36-q19-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "A girl and a boy, in any order.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.4998$",
              "worked": "$$\\begin{aligned}P(\\text{one girl and one boy})&=P(GB)+P(BG)\\\\&=0.49\\times0.51+0.51\\times0.49\\\\&=0.4998\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p36-q19-a-iv",
            "type": "part",
            "label": "iv",
            "prompt": "At least one girl.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.7399$",
              "worked": "The complement is two boys.\n$$\\begin{aligned}P(\\text{at least one girl})&=1-P(BB)\\\\&=1-0.2601\\\\&=0.7399\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
