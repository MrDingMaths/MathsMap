        "label": "a",
        "prompt": "$$\\int_1^3\\left(x+\\frac{1}{x}\\right)^2\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{40}{3}$",
          "worked": "$$\\begin{align*}\\int_1^3\\left(x+\\frac{1}{x}\\right)^2\\,dx&=\\int_1^3(x^2+2+x^{-2})\\,dx\\\\&=\\left[\\frac{x^3}{3}+2x-\\frac{1}{x}\\right]_1^3\\\\&=\\left(9+6-\\frac13\\right)-\\left(\\frac13+2-1\\right)\\\\&=\\frac{44}{3}-\\frac43\\\\&=\\frac{40}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p33-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\int_1^2\\left(x^2+\\frac{1}{x^2}\\right)^2\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1019}{120}$",
          "worked": "$$\\begin{align*}\\int_1^2\\left(x^2+\\frac{1}{x^2}\\right)^2\\,dx&=\\int_1^2(x^4+2+x^{-4})\\,dx\\\\&=\\left[\\frac{x^5}{5}+2x-\\frac{1}{3x^3}\\right]_1^2\\\\&=\\left(\\frac{32}{5}+4-\\frac1{24}\\right)-\\left(\\frac15+2-\\frac13\\right)\\\\&=\\frac{31}{5}+2+\\frac7{24}\\\\&=\\frac{1019}{120}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
