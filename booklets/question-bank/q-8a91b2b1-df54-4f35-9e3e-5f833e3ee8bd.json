    "answer": {
      "short": "$17\\,671\\text{ cm}^2$",
      "worked": "Tablecloth radius:\n$$\\begin{align*}r&=60+15\\\\r&=75\\text{ cm}\\\\A&=\\pi r^2\\\\A&=\\pi\\times75^2\\\\A&=5625\\pi\\text{ cm}^2\\\\A&\\approx17\\,671\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
