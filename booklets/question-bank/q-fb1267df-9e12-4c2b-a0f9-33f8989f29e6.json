  "content": {
    "id": "p56-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "When a polynomial $P(x)$ is divided by $(x-2)(x+5)$, the remainder is $(x+3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the division identity $P(x)=D(x)Q(x)+R(x)$ from this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x-2)(x+5)Q(x)+(x+3)$.",
          "worked": "$D(x)=(x-2)(x+5)$ and $R(x)=x+3$.\n$$P(x)=(x-2)(x+5)Q(x)+(x+3).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p56-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the remainder when $P(x)$ is divided by $(x+5)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$, since $P(-5)=-5+3=-2$.",
          "worked": "$$\\begin{align*}P(-5)&=(-5-2)(-5+5)Q(-5)+(-5+3)\\\\P(-5)&=-2\\end{align*}$$\nBy the remainder theorem, the remainder is $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
