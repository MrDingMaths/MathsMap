  "content": {
    "id": "p22-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "There are many ways to factorise $\\sqrt{600}$. 1 is given below. Find 2 more different ways.\n\n$\\sqrt{600}=2\\sqrt{150}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q2-other-ways",
        "type": "part",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{24}$ and $10\\sqrt6$",
          "worked": "$$\\begin{align*}\\sqrt{600}&=\\sqrt{25\\times24}\\\\&=5\\sqrt{24}\\end{align*}$$\n$$\\begin{align*}\\sqrt{600}&=\\sqrt{100\\times6}\\\\&=10\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24,
        "responseSpace": "scaffold"
      },
      {
        "id": "p22-q2-simplest",
        "type": "part",
        "label": "b",
        "prompt": "What is the simplest form of $\\sqrt{600}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\sqrt6$",
          "worked": "$$\\begin{align*}\\sqrt{600}&=\\sqrt{100\\times6}\\\\&=10\\sqrt6\\end{align*}$$\n6 has no square factor greater than 1.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
