      "taskHash": "30af014a405e0d1f4f6fc40d3861cdacb7511c7ba1ba6aa0314fd3c8854c6512",
      "evidence": ".booklet-work/reasoning-ratings/calls/logarithms-v1/4c2e5995df7310707f7cf78e360e5e650ce98f11f544c8f1f8c5f7b44f3af96e-1792560614807/last-message.txt"
    }
  },
  "content": {
    "id": "p18-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Simplify:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$5^{-\\log_5 2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}5^{-\\log_5 2}&=5^{\\log_5(2^{-1})}\\\\5^{-\\log_5 2}&=2^{-1}\\\\5^{-\\log_5 2}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$12^{2\\log_{12}7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49$",
          "worked": "$$\\begin{align*}12^{2\\log_{12}7}&=12^{\\log_{12}(7^2)}\\\\12^{2\\log_{12}7}&=7^2\\\\12^{2\\log_{12}7}&=49\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{\\log_2 3+\\log_2 5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}2^{\\log_2 3+\\log_2 5}&=2^{\\log_2(3\\times5)}\\\\2^{\\log_2 3+\\log_2 5}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^{n\\log_a x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^n$",
          "worked": "$$\\begin{align*}a^{n\\log_a x}&=a^{\\log_a(x^n)}\\\\a^{n\\log_a x}&=x^n\\end{align*}$$\nFor $a>0$, $a\\ne1$, $x>0$ and real $n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "$7^{-\\log_7 x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{x}$",
          "worked": "$$\\begin{align*}7^{-\\log_7 x}&=7^{\\log_7(x^{-1})}\\\\7^{-\\log_7 x}&=x^{-1}\\\\7^{-\\log_7 x}&=\\frac{1}{x}\\end{align*}$$\nFor $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "$5^{x+\\log_5 x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\times5^x$",
          "worked": "$$\\begin{align*}5^{x+\\log_5 x}&=5^x\\times5^{\\log_5 x}\\\\5^{x+\\log_5 x}&=5^x\\times x\\\\5^{x+\\log_5 x}&=x\\times5^x\\end{align*}$$\nFor $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "$2^{x\\log_2 x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^x$",
          "worked": "$$\\begin{align*}2^{x\\log_2 x}&=2^{\\log_2(x^x)}\\\\2^{x\\log_2 x}&=x^x\\end{align*}$$\nFor $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q16-h",
        "type": "part",
        "label": "h",
        "prompt": "$3^{\\frac{\\log_3 x}{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac{1}{x}}$",
          "worked": "$$\\begin{align*}3^{\\frac{\\log_3 x}{x}}&=3^{\\frac{1}{x}\\log_3 x}\\\\3^{\\frac{\\log_3 x}{x}}&=3^{\\log_3(x^{1/x})}\\\\3^{\\frac{\\log_3 x}{x}}&=x^{\\frac{1}{x}}\\end{align*}$$\nFor $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
