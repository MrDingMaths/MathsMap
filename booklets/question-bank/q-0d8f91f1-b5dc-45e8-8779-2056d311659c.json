  "content": {
    "id": "p31-q31-32-root",
    "type": "question",
    "label": null,
    "prompt": "Find the $x$-intercept of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q31",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\log_2(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$; the intercept is $(4,0)$.",
          "worked": "At the $x$-intercept, $y=0$.\n\n$$\\begin{align*}\\log_2(x-3)&=0\\\\x-3&=2^0\\\\x-3&=1\\\\x&=4\\end{align*}$$\n\nSince $4>3$, the intercept is $(4,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p31-q32",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\log_5(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$; the intercept is $(1,0)$.",
          "worked": "At the $x$-intercept, $y=0$.\n\n$$\\begin{align*}\\log_5(2x-1)&=0\\\\2x-1&=5^0\\\\2x-1&=1\\\\2x&=2\\\\x&=1\\end{align*}$$\n\nThe argument is $2(1)-1=1>0$, so the intercept is $(1,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
