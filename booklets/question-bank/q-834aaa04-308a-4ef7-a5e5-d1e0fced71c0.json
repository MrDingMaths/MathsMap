  "content": {
    "id": "p25-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Gaye buys three novels and two textbooks at a shop that is advertising 25% discount on all books. The novels are marked at $\\$36$ each and the textbooks are marked at $\\$72$ and $\\$96$. What is the total price after the discount has been given?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$207$",
      "worked": "$$\\begin{align*}\\text{Marked total} &= 3\\times\\$36+\\$72+\\$96\\\\\\text{Marked total} &= \\$276\\\\\\text{Discount} &= \\frac{25}{100}\\times\\$276\\\\\\text{Discount} &= \\$69\\\\\\text{Total after discount} &= \\$276-\\$69\\\\\\text{Total after discount} &= \\$207\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
