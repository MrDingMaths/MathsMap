  "content": {
    "id": "p56-question-5-root",
    "type": "question",
    "label": "5",
    "prompt": "The concentration $C=2000e^{-2t}$ of a chemical is varying with time $t$ in years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-question-5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the concentration when $t=2$. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36.63$",
          "worked": "$$\\begin{align*}C(2)&=2000e^{-2(2)}\\\\C(2)&=2000e^{-4}\\\\C(2)&\\approx36.63\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p56-question-5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find, as a function of $t$, the rate $\\dfrac{dC}{dt}$ at which the concentration is changing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dC}{dt}=-4000e^{-2t}$",
          "worked": "$$\\begin{align*}\\frac{dC}{dt}&=2000(-2)e^{-2t}\\\\\\frac{dC}{dt}&=-4000e^{-2t}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p56-question-5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the rate at which the concentration is changing when $t=2$. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-73.26$ concentration units per year.",
          "worked": "$$\\begin{align*}C'(2)&=-4000e^{-2(2)}\\\\C'(2)&=-4000e^{-4}\\\\C'(2)&\\approx-73.26\\end{align*}$$\nThe concentration is decreasing at $73.26$ concentration units per year.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
