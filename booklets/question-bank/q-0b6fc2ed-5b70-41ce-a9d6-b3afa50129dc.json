  "content": {
    "id": "p10-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Factorise each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y)(x^2+y^2)$",
          "worked": "$$\\begin{align*}x^4-y^4&=(x^2-y^2)(x^2+y^2)\\\\x^4-y^4&=(x-y)(x+y)(x^2+y^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^5-y^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x^4+x^3y+x^2y^2+xy^3+y^4)$",
          "worked": "Use the difference of fifth powers identity.\n$$\\begin{align*}x^5-y^5&=(x-y)(x^4+x^3y+x^2y^2+xy^3+y^4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$a^5+b^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+b)(a^4-a^3b+a^2b^2-ab^3+b^4)$",
          "worked": "Use the sum of fifth powers identity, with alternating signs in the second factor.\n$$\\begin{align*}a^5+b^5&=(a+b)(a^4-a^3b+a^2b^2-ab^3+b^4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^5-32$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x^4+2x^3+4x^2+8x+16)$",
          "worked": "$$\\begin{align*}x^5-32&=x^5-2^5\\\\x^5-32&=(x-2)(x^4+2x^3+4x^2+8x+16)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^7+b^7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p10-q8-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "(a+b)(a^6-a^5b+a^4b^2-a^3b^3+a^2b^4-ab^5+b^6)",
                    "display": true
                  }
                ]
              },
              {
                "id": "p10-q8-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the sum of odd powers identity; the second factor has alternating signs.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Use the sum of seventh powers identity.\n$$\\begin{align*}a^7+b^7&=(a+b)(a^6-a^5b+a^4b^2-a^3b^3+a^2b^4-ab^5+b^6)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^7-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)(x^6+x^5+x^4+x^3+x^2+x+1)$",
          "worked": "$$\\begin{align*}x^7-1&=x^7-1^7\\\\x^7-1&=(x-1)(x^6+x^5+x^4+x^3+x^2+x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p10-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^4-81$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(x+3)(x^2+9)$",
          "worked": "$$\\begin{align*}x^4-81&=x^4-3^4\\\\x^4-81&=(x^2-9)(x^2+9)\\\\x^4-81&=(x-3)(x+3)(x^2+9)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$16x^4-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(2x+1)(4x^2+1)$",
          "worked": "$$\\begin{align*}16x^4-1&=(4x^2)^2-1^2\\\\16x^4-1&=(4x^2-1)(4x^2+1)\\\\16x^4-1&=(2x-1)(2x+1)(4x^2+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q8-i",
        "type": "part",
        "label": "i",
        "prompt": "$32x^5-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(16x^4+8x^3+4x^2+2x+1)$",
          "worked": "$$\\begin{align*}32x^5-1&=(2x)^5-1^5\\\\32x^5-1&=(2x-1)((2x)^4+(2x)^3+(2x)^2+2x+1)\\\\32x^5-1&=(2x-1)(16x^4+8x^3+4x^2+2x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
