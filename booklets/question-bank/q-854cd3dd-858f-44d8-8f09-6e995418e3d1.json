  "content": {
    "id": "p14-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Both the numerator and denominator of $\\frac{2}{3}$ are increased by the same amount. The resulting fraction equals $\\frac{9}{11}$. How much was the increase?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{2}$",
      "worked": "Let the increase be $x$.\n$$\\begin{align*}\\frac{2+x}{3+x}&=\\frac{9}{11}\\\\11(2+x)&=9(3+x)\\\\22+11x&=27+9x\\\\2x&=5\\\\x&=\\frac{5}{2}\\end{align*}$$\nThe increase was $\\frac{5}{2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
