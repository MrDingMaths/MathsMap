  "content": {
    "id": "v2-a6564-p25-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the missing values by equating coefficients.\n$$a(x+2)^2+b(x-1)=3x^2+14x+c$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=3,\\ b=2,\\ c=10$",
      "worked": "$$\\begin{aligned}a(x^2+4x+4)+bx-b&=3x^2+14x+c\\\\ax^2+(4a+b)x+4a-b&=3x^2+14x+c\\end{aligned}$$\nEquating coefficients of $x^2$:\n$$\\begin{aligned}a&=3\\end{aligned}$$\nEquating coefficients of $x$:\n$$\\begin{aligned}4(3)+b&=14\\\\b&=2\\end{aligned}$$\nEquating constant terms:\n$$\\begin{aligned}c&=4(3)-2\\\\&=10\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
