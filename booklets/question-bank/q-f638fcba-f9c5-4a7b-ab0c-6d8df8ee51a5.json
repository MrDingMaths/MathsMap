  "content": {
    "id": "p4-q7-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the straight line that passes through each pair of points below.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,2),\\ (0,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2x+4$",
          "worked": "$$\\begin{align*}m&=\\frac{4-2}{0-1}\\\\m&=-2\\\\y-4&=-2(x-0)\\\\y&=-2x+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p4-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-4,1),\\ (-2,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x+5$",
          "worked": "$$\\begin{align*}m&=\\frac{3-1}{-2-(-4)}\\\\m&=1\\\\y-1&=1(x+4)\\\\y&=x+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p4-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-7,-3),\\ (1,-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac18x-\\frac{31}{8}$",
          "worked": "$$\\begin{align*}m&=\\frac{-4-(-3)}{1-(-7)}\\\\m&=-\\frac18\\\\y+4&=-\\frac18(x-1)\\\\y+4&=-\\frac18x+\\frac18\\\\y&=-\\frac18x-\\frac{31}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p4-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2,-6),\\ (3,-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-10$",
          "worked": "$$\\begin{align*}m&=\\frac{-4-(-6)}{3-2}\\\\m&=2\\\\y+6&=2(x-2)\\\\y&=2x-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p4-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(5,2),\\ (-3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2$",
          "worked": "Both points have $y$-coordinate $2$, so the horizontal line has equation $y=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q7-f",
        "type": "part",
        "label": "f",
