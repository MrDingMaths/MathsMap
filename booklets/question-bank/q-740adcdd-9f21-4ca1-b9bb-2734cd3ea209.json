  "content": {
    "id": "p10-q11-root",
    "type": "question",
    "label": "11",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p10-q11-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
