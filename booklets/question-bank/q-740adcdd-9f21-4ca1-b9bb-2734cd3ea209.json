    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2+b(b+1)a+b^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+b)(a+b^2)$",
          "worked": "$$\\begin{align*}a^2+b(b+1)a+b^3&=a^2+ab+ab^2+b^3\\\\a^2+b(b+1)a+b^3&=a(a+b)+b^2(a+b)\\\\a^2+b(b+1)a+b^3&=(a+b)(a+b^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x^2+xy)^2-(xy+y^2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y)^3$",
          "worked": "$$\\begin{align*}(x^2+xy)^2-(xy+y^2)^2&=x^2(x+y)^2-y^2(x+y)^2\\\\(x^2+xy)^2-(xy+y^2)^2&=(x+y)^2(x^2-y^2)\\\\(x^2+xy)^2-(xy+y^2)^2&=(x-y)(x+y)^3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a^2-b^2)^2-(a-b)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4ab(a-b)^2$",
          "worked": "$$\\begin{align*}(a^2-b^2)^2-(a-b)^4&=(a-b)^2[(a+b)^2-(a-b)^2]\\\\(a^2-b^2)^2-(a-b)^4&=(a-b)^2(2b)(2a)\\\\(a^2-b^2)^2-(a-b)^4&=4ab(a-b)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^4-2x^3y-3xy^3-9y^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x^2+3y^2)(2x-3y)(x+y)$",
          "worked": "$$\\begin{align*}4x^4-2x^3y-3xy^3-9y^4&=2x^2(2x^2-xy-3y^2)+3y^2(2x^2-xy-3y^2)\\\\4x^4-2x^3y-3xy^3-9y^4&=(2x^2+3y^2)(2x^2-xy-3y^2)\\\\4x^4-2x^3y-3xy^3-9y^4&=(2x^2+3y^2)(2x-3y)(x+y).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$(a^2-b^2-c^2)^2-4b^2c^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-b-c)(a+b+c)(a-b+c)(a+b-c)$\n\nApply the difference of squares twice.",
          "worked": "$$\\begin{align*}(a^2-b^2-c^2)^2-4b^2c^2&=(a^2-b^2-c^2-2bc)(a^2-b^2-c^2+2bc)\\\\(a^2-b^2-c^2)^2-4b^2c^2&=[a^2-(b+c)^2][a^2-(b-c)^2]\\\\(a^2-b^2-c^2)^2-4b^2c^2&=(a-b-c)(a+b+c)(a-b+c)(a+b-c).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$(ax+by)^2+(ay-bx)^2+c^2(x^2+y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+y^2)(a^2+b^2+c^2)$",
          "worked": "$$\\begin{align*}(ax+by)^2+(ay-bx)^2+c^2(x^2+y^2)&=a^2x^2+2abxy+b^2y^2+a^2y^2-2abxy+b^2x^2+c^2(x^2+y^2)\\\\(ax+by)^2+(ay-bx)^2+c^2(x^2+y^2)&=a^2(x^2+y^2)+b^2(x^2+y^2)+c^2(x^2+y^2)\\\\(ax+by)^2+(ay-bx)^2+c^2(x^2+y^2)&=(x^2+y^2)(a^2+b^2+c^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$a^4+a^2b^2+b^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a^2-ab+b^2)(a^2+ab+b^2)$\n\nAdd and subtract $a^2b^2$ to form a difference of squares.",
          "worked": "$$\\begin{align*}a^4+a^2b^2+b^4&=a^4+2a^2b^2+b^4-a^2b^2\\\\a^4+a^2b^2+b^4&=(a^2+b^2)^2-(ab)^2\\\\a^4+a^2b^2+b^4&=(a^2-ab+b^2)(a^2+ab+b^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$a^4+4b^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a^2-2ab+2b^2)(a^2+2ab+2b^2)$\n\nAdd and subtract $4a^2b^2$ to form a difference of squares.",
          "worked": "$$\\begin{align*}a^4+4b^4&=a^4+4a^2b^2+4b^4-4a^2b^2\\\\a^4+4b^4&=(a^2+2b^2)^2-(2ab)^2\\\\a^4+4b^4&=(a^2-2ab+2b^2)(a^2+2ab+2b^2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
