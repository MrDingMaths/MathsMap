  "content": {
    "id": "p55-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A population $P$ of insects over time $t$ weeks is given by $P=3e^{1.4t}+12\\,569$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the initial population?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\,572$ insects",
          "worked": "At $t=0$:\n$$\\begin{align*}P(0)&=3e^{1.4(0)}+12\\,569\\\\P(0)&=3+12\\,569\\\\P(0)&=12\\,572\\text{ insects}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p55-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the rate of change, to the nearest whole number, of the number of insects after:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p55-q1-b-i",
            "type": "part",
            "label": "i",
            "prompt": "3 weeks",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$280$ insects/week",
              "worked": "$$\\begin{align*}\\frac{dP}{dt}&=3(1.4)e^{1.4t}\\\\\\frac{dP}{dt}&=4.2e^{1.4t}.\\end{align*}$$\nAt $t=3$:\n$$\\begin{align*}\\left.\\frac{dP}{dt}\\right|_{t=3}&=4.2e^{1.4(3)}\\\\\\left.\\frac{dP}{dt}\\right|_{t=3}&=4.2e^{4.2}\\\\\\left.\\frac{dP}{dt}\\right|_{t=3}&\\approx280\\text{ insects/week}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p55-q1-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "7 weeks",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$75\\,742$ insects/week",
              "worked": "Using $\\dfrac{dP}{dt}=4.2e^{1.4t}$, at $t=7$:\n$$\\begin{align*}\\left.\\frac{dP}{dt}\\right|_{t=7}&=4.2e^{1.4(7)}\\\\\\left.\\frac{dP}{dt}\\right|_{t=7}&=4.2e^{9.8}\\\\\\left.\\frac{dP}{dt}\\right|_{t=7}&\\approx75\\,742\\text{ insects/week}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      }
    ]
