    "type": "question",
    "label": "3",
    "prompt": "Find the equation of the curve, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$y'=(1-x^2)^{-\\frac12}$ and the curve passes through $(0,\\pi)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\sin^{-1}x+\\pi$",
          "worked": "$$\\begin{aligned}y&=\\int(1-x^2)^{-\\frac12}\\,dx\\\\&=\\sin^{-1}x+C\\end{aligned}$$\nSubstitute $(0,\\pi)$:\n$$\\begin{aligned}\\pi&=\\sin^{-1}(0)+C\\\\C&=\\pi\\\\y&=\\sin^{-1}x+\\pi\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$y'=4(16+x^2)^{-1}$ and the curve passes through $(-4,0)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\tan^{-1}\\left(\\frac{x}{4}\\right)+\\frac\\pi4$",
          "worked": "$$\\begin{aligned}y&=\\int\\frac4{16+x^2}\\,dx\\\\&=4\\cdot\\frac14\\tan^{-1}\\left(\\frac{x}{4}\\right)+C\\\\&=\\tan^{-1}\\left(\\frac{x}{4}\\right)+C\\end{aligned}$$\nSubstitute $(-4,0)$:\n$$\\begin{aligned}0&=\\tan^{-1}(-1)+C\\\\&=-\\frac\\pi4+C\\\\C&=\\frac\\pi4\\\\y&=\\tan^{-1}\\left(\\frac{x}{4}\\right)+\\frac\\pi4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
