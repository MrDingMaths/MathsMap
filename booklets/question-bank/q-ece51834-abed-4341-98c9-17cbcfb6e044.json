  "content": {
    "id": "p35-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A person selects a marble from a bag containing 10 red marbles, 4 blue marbles and 1 white marble. The person wins $\\$1$ for the red marble, $\\$5$ for the blue marble and $\\$20$ for the white marble. It costs $\\$4$ to enter the game.\n\nGive monetary approximations to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the expected net return from playing the game and explain why this shows that the game is unfair.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Expected net return $=-\\$\\frac{2}{3}\\approx-\\$0.67$. The game is unfair because the expected net return is not zero.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "2eb52583-f5e5-42c5-b938-9a3e0ce64613",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "X",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " be the net return, in dollars, from one game. The possible net returns are ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "16",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "aa9c4933-ea05-454d-b7fc-3edb8f0f5048",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}E(X)&=(-3)\\left(\\frac{10}{15}\\right)+1\\left(\\frac{4}{15}\\right)+16\\left(\\frac{1}{15}\\right)\\\\&=\\frac{-30+4+16}{15}\\\\&=-\\frac{2}{3}\\approx-0.67.\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "fa1f0706-0c6a-4893-a64a-8ab501428330",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The expected loss is approximately ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\$0.67",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " per game. The game is unfair because the expected net return is not zero.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p35-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose the prizes for drawing the red, blue and white marbles respectively are $k$, $2k$ and $3k$ dollars. What is the value of $k$ such that the entry cost of $\\$4$ is considered fair?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\frac{20}{7}$ dollars, approximately $\\$2.86$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "603cdec5-8283-4824-9026-b6993ff0571b",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For a fair game, the expected prize equals the entry cost:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "2556686e-0c24-4730-a714-c9f67619f22a",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{10}{15}k+\\frac{4}{15}(2k)+\\frac{1}{15}(3k)&=4\\\\\\frac{10k+8k+3k}{15}&=4\\\\\\frac{21k}{15}&=4\\\\k&=\\frac{60}{21}\\\\&=\\frac{20}{7}\\approx2.86.\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "26e123bd-1ebe-49c2-a60f-5944e091ec0f",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Thus ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "k=\\frac{20}{7}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " dollars, approximately ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\$2.86",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
