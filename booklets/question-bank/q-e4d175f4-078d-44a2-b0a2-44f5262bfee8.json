        "id": "p20-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\frac{x+2}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$ or $2$",
          "worked": "$x\\ne0$.\n$$\\begin{align*}x^2&=x+2\\\\x^2-x-2&=0\\\\(x+1)(x-2)&=0\\\\x&=-1\\text{ or }2\\end{align*}$$\nBoth values satisfy the denominator restriction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$a+\\frac{10}{a}=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$ or $5$",
          "worked": "$a\\ne0$.\n$$\\begin{align*}a^2+10&=7a\\\\a^2-7a+10&=0\\\\(a-2)(a-5)&=0\\\\a&=2\\text{ or }5\\end{align*}$$\nBoth values satisfy the denominator restriction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y+\\frac{2}{y}=\\frac{9}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac12$ or $4$",
          "worked": "$y\\ne0$.\n$$\\begin{align*}2y^2+4&=9y\\\\2y^2-9y+4&=0\\\\2y^2-8y-y+4&=0\\\\2y(y-4)-(y-4)&=0\\\\(2y-1)(y-4)&=0\\\\y&=\\frac12\\text{ or }4\\end{align*}$$\nBoth values satisfy the denominator restriction.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p20-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$(5b-3)(3b+1)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=-\\frac25$ or $\\frac23$",
          "worked": "$$\\begin{align*}15b^2-4b-3&=1\\\\15b^2-4b-4&=0\\\\15b^2-10b+6b-4&=0\\\\5b(3b-2)+2(3b-2)&=0\\\\(5b+2)(3b-2)&=0\\\\b&=-\\frac25\\text{ or }\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
