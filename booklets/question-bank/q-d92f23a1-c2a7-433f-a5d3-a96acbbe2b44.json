  "content": {
    "id": "p8-q3",
    "type": "question",
    "label": "3",
    "prompt": "Find the product $P(x)Q(x)$, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x^3$ and $Q(x)=5x^3-2x^2+7x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x^6-2x^5+7x^4$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=x^3(5x^3-2x^2+7x)\\\\P(x)Q(x)&=5x^6-2x^5+7x^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=x^3+1$ and $Q(x)=x^3-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^6-1$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=(x^3+1)(x^3-1)\\\\P(x)Q(x)&=x^6-x^3+x^3-1\\\\P(x)Q(x)&=x^6-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=x^4+x^2+1$ and $Q(x)=x^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^6-1$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=(x^4+x^2+1)(x^2-1)\\\\P(x)Q(x)&=x^6-x^4+x^4-x^2+x^2-1\\\\P(x)Q(x)&=x^6-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(x)=-x^3+x$ and $Q(x)=-x^2-3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5+3x^4-x^3-3x^2$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=(-x^3+x)(-x^2-3x)\\\\P(x)Q(x)&=x^5+3x^4-x^3-3x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(x)=x^2+x+1$ and $Q(x)=x^2-x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+x^2+1$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=(x^2+x+1)(x^2-x+1)\\\\P(x)Q(x)&=x^2(x^2-x+1)+x(x^2-x+1)+(x^2-x+1)\\\\P(x)Q(x)&=x^4-x^3+x^2+x^3-x^2+x+x^2-x+1\\\\P(x)Q(x)&=x^4+x^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
