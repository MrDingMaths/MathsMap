  "content": {
    "id": "p17-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If a stone is dropped off a cliff, the number of metres it has fallen after a certain number of seconds is found by multiplying the square of the number of seconds by 4.9.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the formula for the distance $d$ metres fallen by the stone in $t$ seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=4.9t^2$",
          "worked": "The square of the number of seconds is $t^2$. Multiplying by $4.9$ gives\n$$d=4.9t^2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the distance fallen in 1.5 seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.025\\text{ m}$",
          "worked": "$$\\begin{align*}d&=4.9\\times(1.5)^2\\\\d&=4.9\\times2.25\\\\d&=11.025\\end{align*}$$\nThe distance fallen is $11.025\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
