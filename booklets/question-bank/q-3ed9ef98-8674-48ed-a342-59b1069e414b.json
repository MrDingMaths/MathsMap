  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify these products. Remember to simplify before you multiply.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{6x}{5}\\times\\dfrac{7y}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7xy}{5}$",
          "worked": "$$\\begin{align*}\\frac{6x}{5}\\times\\frac{7y}{6}&=\\frac{x}{5}\\times\\frac{7y}{1}\\\\&=\\frac{7xy}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2b}{5}\\times\\dfrac{7d}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7bd}{15}$",
          "worked": "$$\\begin{align*}\\frac{2b}{5}\\times\\frac{7d}{6}&=\\frac{b}{5}\\times\\frac{7d}{3}\\\\&=\\frac{7bd}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{8a}{5}\\times\\dfrac{3b}{4c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6ab}{5c}$",
          "worked": "$$\\begin{align*}\\frac{8a}{5}\\times\\frac{3b}{4c}&=\\frac{2a}{5}\\times\\frac{3b}{c}\\\\&=\\frac{6ab}{5c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{9d}{2}\\times\\dfrac{4e}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{18de}{7}$",
          "worked": "$$\\begin{align*}\\frac{9d}{2}\\times\\frac{4e}{7}&=\\frac{9d}{1}\\times\\frac{2e}{7}\\\\&=\\frac{18de}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3x}{2}\\times\\dfrac{1}{6x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{3x}{2}\\times\\frac{1}{6x}&=\\frac{1}{2}\\times\\frac{1}{2}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{4}{9k}\\times\\dfrac{3k}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3}$",
          "worked": "$$\\begin{align*}\\frac{4}{9k}\\times\\frac{3k}{2}&=\\frac{2}{3}\\times\\frac{1}{1}\\\\&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
