      {
        "id": "p13-q4-compare",
        "type": "part",
        "label": "c",
        "prompt": "Compare the two diagrams to explain why $\\frac{1}{4}+\\frac{1}{8}$ is not equal to $\\frac{2}{12}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}+\\frac{1}{8}=\\frac{3}{8}$, which is larger than $\\frac{2}{12}$. Denominators name the size of the parts and cannot be added.",
          "worked": "The first model has three eighths shaded; the second has only two twelfths shaded. Since the wholes are the same length, these shaded amounts are different. Rewrite the quarter as two eighths before adding: $\\frac{2}{8}+\\frac{1}{8}=\\frac{3}{8}$. Adding the denominators incorrectly changes the size of the parts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q4-hence",
        "type": "part",
        "label": "d",
        "prompt": "Hence solve $\\frac{6}{12}+\\frac{2}{6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": "$\\begin{align*}\\frac{6}{12}+\\frac{2}{6}&=\\frac{6}{12}+\\frac{4}{12}\\\\&=\\frac{10}{12}\\\\&=\\frac{5}{6}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
