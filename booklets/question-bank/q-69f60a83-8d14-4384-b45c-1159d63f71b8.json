        "answer": {
          "short": "$\\dfrac{7\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\frac{7}{\\sqrt{3}}&=\\frac{7}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{7\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
