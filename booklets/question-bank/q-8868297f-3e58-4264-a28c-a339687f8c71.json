  "content": {
    "id": "v2-c5c49-p14-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Explain why the horizontal line test can be used to decide whether the inverse of a function is a function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Reflecting in $y=x$ turns horizontal lines into vertical lines. If every horizontal line meets the graph at most once, every vertical line meets the inverse at most once, so the inverse is a function.",
      "worked": "The graph of the inverse is the reflection of the original graph in $y=x$, which turns each horizontal line into a vertical line.\n\nIf every horizontal line meets the original graph at most once, every vertical line meets the inverse at most once. The inverse then passes the vertical line test, so it is a function.",
      "solutionDiagrams": []
