  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Admissions to different wards of St Luke’s Hospital mostly rose from 2006 to 2007, but by quite different percentage amounts. Find the percentage increase or decrease in wards where the numbers during 2006 and 2007, respectively, were the following. Round non-exact percentages to 1 decimal place.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$50$ and $68$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Increase}&=68-50=18\\\\\\text{Percentage increase}&=\\frac{18}{50}\\times100\\%\\\\\\text{Percentage increase}&=36\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
