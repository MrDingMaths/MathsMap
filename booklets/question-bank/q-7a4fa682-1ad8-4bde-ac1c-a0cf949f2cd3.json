            },
            {
              "type": "math",
              "latex": "P",
              "display": false
            },
            {
              "type": "text",
              "text": " be the intersection in the first quadrant.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "p50-q59-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"distinguishes the downward parabola\"},{\"name\":\"curveRed\",\"hex\":\"EF6068\",\"reason\":\"distinguishes the upward parabola\"}],\"reference\":\"source page 50, question 59 diagram\"}\n\\begin{tikzpicture}[x=1.35cm,y=1.35cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\definecolor{curveRed}{HTML}{EF6068}\n% The parameter below controls this unscaled schematic; it is not a given value of a.\n\\def\\aplot{0.8}\n\\pgfmathsetmacro{\\px}{1/sqrt(1+\\aplot)}\n\\pgfmathsetmacro{\\py}{1/(1+\\aplot)}\n\\draw[->,black,line width=0.5pt] (-1.55,0)--(1.55,0) node[below] {$x$};\n\\draw[->,black,line width=0.5pt] (0,-0.5)--(0,1.58) node[above] {$y$};\n\\draw[<->,curveBlue,line width=0.8pt] plot[domain=-1.33:1.33,samples=65] (\\x,{1-\\aplot*\\x*\\x});\n\\draw[<->,curveRed,line width=0.8pt] plot[domain=-1.17:1.17,samples=65] (\\x,{\\x*\\x});\n\\fill[black] (-\\px,\\py) circle[radius=1.2pt];\n\\fill[black] (\\px,\\py) circle[radius=1.2pt] node[right] {$P$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 58,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 50,
          "sourceRegion": "right column, question 59",
          "description": "Unscaled Cartesian graph with a blue downward parabola and red upward parabola. Both intersections are marked; the first-quadrant intersection is labelled P.",
          "mathematics": "y=1-ax^2 and y=x^2, with a>0 as depicted by the downward parabola.",
          "answerVisibility": "The source graph gives no numerical coordinates or value of a."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p50-q59a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of $P$, in terms of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P\\left(\\dfrac{1}{\\sqrt{a+1}},\\dfrac{1}{a+1}\\right)$.",
          "worked": "At $P$, the curves have the same coordinates. Since $P$ is in the first quadrant, take the positive square root.\n$$\\begin{align*}1-ax^2&=x^2\\\\1&=(a+1)x^2\\\\x^2&=\\frac{1}{a+1}\\\\x&=\\frac{1}{\\sqrt{a+1}}\\\\y&=x^2=\\frac{1}{a+1}\\end{align*}$$\nThus $P\\left(\\dfrac{1}{\\sqrt{a+1}},\\dfrac{1}{a+1}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p50-q59b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of the tangent to $y=x^2$ at $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{\\sqrt{a+1}}$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x\\\\m_P&=2\\left(\\frac{1}{\\sqrt{a+1}}\\right)\\\\m_P&=\\frac{2}{\\sqrt{a+1}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p50-q59c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, find the value of $a$ if the two curves intersect at right angles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac13$.\n\nThe tangent gradients at $P$ have product $-1$.",
          "worked": "The gradient of $y=1-ax^2$ at $P$ is $-\\frac{2a}{\\sqrt{a+1}}$. At a right-angle intersection, the tangent gradients have product $-1$.\n$$\\begin{align*}\\frac{2}{\\sqrt{a+1}}\\left(-\\frac{2a}{\\sqrt{a+1}}\\right)&=-1\\\\-\\frac{4a}{a+1}&=-1\\\\4a&=a+1\\\\3a&=1\\\\a&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
