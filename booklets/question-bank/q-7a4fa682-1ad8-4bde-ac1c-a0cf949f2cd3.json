          "inlines": [
            {
              "type": "text",
              "text": "The diagram below shows the graphs of ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=1-ax^2",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=x^2",
              "display": false
            },
            {
              "type": "text",
              "text": ". Let ",
