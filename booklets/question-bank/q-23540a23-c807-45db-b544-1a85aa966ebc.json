  "content": {
    "id": "p32-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "In a triangle $ABC$, $\\sin A=\\frac{1}{8}$, $\\sin B=\\frac{3}{4}$ and $a=8$. Find, using the sine rule, the value of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=48$",
      "worked": "By the sine rule:\n$$\\begin{align*}\\frac{b}{\\sin B}&=\\frac{a}{\\sin A}\\\\\\frac{b}{3/4}&=\\frac{8}{1/8}\\\\b&=\\frac{8\\times\\frac{3}{4}}{\\frac{1}{8}}\\\\b&=48\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
