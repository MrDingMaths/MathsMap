    "label": "3",
    "prompt": "Differentiate $y=2^{3x-4}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{dy}{dx}=3(2^{3x-4})\\ln 2$",
      "worked": "Let $u=3x-4$, so $y=2^u$.\n$$\\begin{align*}\\frac{du}{dx}&=3\\\\\\frac{dy}{du}&=(\\ln 2)2^u\\\\\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\\\frac{dy}{dx}&=3(\\ln 2)2^{3x-4}\\end{align*}$$",
      "solutionDiagrams": []
    },
