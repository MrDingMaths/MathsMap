      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\log_2 x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{\\ln x}{\\ln 2}$; $y'=\\dfrac{1}{x\\ln 2}$.",
          "worked": "$$\\begin{align*}y&=\\frac{\\ln x}{\\ln 2}\\\\y'&=\\frac{1}{\\ln 2}\\cdot\\frac{1}{x}\\\\y'&=\\frac{1}{x\\ln 2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
