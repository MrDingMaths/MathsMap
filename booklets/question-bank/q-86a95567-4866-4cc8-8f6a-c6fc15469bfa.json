  "content": {
    "id": "p5-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "State whether or not each expression is a polynomial.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x^2+6x+3$",
