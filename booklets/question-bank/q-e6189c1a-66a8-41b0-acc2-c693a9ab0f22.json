  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Suppose $\\theta$ is an acute angle. Use a similar technique to Question 5 to find",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan\\theta$ given that $\\sin\\theta=\\dfrac35$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac34$",
          "worked": "Choose opposite side $3$ and hypotenuse $5$. Let the adjacent side be $a$.\n$$\\begin{align*}a^2&=5^2-3^2\\\\a&=4\\\\\\tan\\theta&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin\\theta$ given that $\\cot\\theta=\\dfrac23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac3{\\sqrt{13}}$",
          "worked": "$\\cot\\theta=\\dfrac{\\text{adjacent}}{\\text{opposite}}$. Choose adjacent side $2$ and opposite side $3$. Let the hypotenuse be $h$.\n$$\\begin{align*}h^2&=2^2+3^2\\\\h&=\\sqrt{13}\\\\\\sin\\theta&=\\frac3{\\sqrt{13}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos\\theta$ given that $\\sin\\theta=\\dfrac1{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2}{\\sqrt3}$",
          "worked": "Choose opposite side $1$ and hypotenuse $\\sqrt3$. Let the adjacent side be $a$.\n$$\\begin{align*}a^2&=(\\sqrt3)^2-1^2\\\\a&=\\sqrt2\\\\\\cos\\theta&=\\frac{\\sqrt2}{\\sqrt3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p9-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\operatorname{cosec}\\theta$ given that $\\tan\\theta=\\dfrac5{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13}{5}$",
          "worked": "Choose opposite side $5$ and adjacent side $12$. Let the hypotenuse be $h$.\n$$\\begin{align*}h^2&=5^2+12^2\\\\h&=13\\\\\\operatorname{cosec}\\theta&=\\frac{h}{5}\\\\\\operatorname{cosec}\\theta&=\\frac{13}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
