    "id": "p32-challenge-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "In a lottery, only $0.002\\%$ of tickets won prizes. If there were two prizes, how many tickets were sold?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$100\\,000$ tickets.\n\nUse the unitary method to find $1\\%$, then $100\\%$.",
      "worked": "$0.002\\%$ of the tickets corresponds to $2$ winning tickets.\n\n$$\\begin{align*}\\text{Tickets corresponding to }1\\%&=2\\div0.002\\\\\\text{Tickets corresponding to }1\\%&=1000\\\\\\text{Total tickets sold}&=1000\\times100\\\\\\text{Total tickets sold}&=100\\,000.\\end{align*}$$",
      "solutionDiagrams": []
    },
