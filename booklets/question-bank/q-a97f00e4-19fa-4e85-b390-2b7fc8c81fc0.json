              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 12 question 3(a); teacher page 57\"}\n\\begin{tikzpicture}[x=0.28cm,y=0.28cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.5pt,->] (0,0)--(21,0) node[right] {$p$};\n\\draw[black,line width=0.5pt,->] (0,0)--(0,16) node[above] {$q$};\n\\foreach \\x in {5,10,15,20}{\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-0.3) node[below,font=\\fontsize{8.5}{10}\\selectfont] {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};}\n\\foreach \\y in {5,10,15}{\\draw[black,line width=0.4pt] (0,\\y)--(-0.3,\\y) node[left,font=\\fontsize{8.5}{10}\\selectfont] {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\y$\\special{dvisvgm:raw </g>}};}\n\\draw[black,line width=0.8pt,domain=0:4.25,samples=100,variable=\\t] plot ({\\t*\\t},{3*\\t});\n\\foreach \\x/\\y in {0/0,1/3,4/6,9/9,16/12}{\\fill[black] (\\x,\\y) circle (1.5pt);}\n\\end{tikzpicture}",
