  "content": {
    "id": "p29-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A survey of the nightly room rate for Sydney hotels and their proximity to the Sydney Harbour Bridge produced the regression equation $C = -50.471d + 281.92$, where $C$ is the cost of a room per night in dollars and $d$ is the distance to the bridge in kilometres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the cost of a hotel room 2.5 km from the bridge.\n\nGive your answer correct to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$155.74$",
          "worked": "Let $d = 2.5$.\n$$\\begin{align*}C &= -50.471(2.5) + 281.92\\\\C &= 155.7425\\\\C &\\approx \\$155.74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p29-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine the distance of a hotel room from the bridge if the cost of the room was $\\$115$.\n\nGive your answer correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.31\\text{ km}$",
          "worked": "Let $C = 115$.\n$$\\begin{align*}115 &= -50.471d + 281.92\\\\115 - 281.92 &= -50.471d\\\\\\frac{-166.92}{-50.471} &= d\\\\d &\\approx 3.31\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
