  "content": {
    "id": "p16-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find the following limits.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\lim_{x\\to\\infty}(e^x+1)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\infty$",
          "worked": "As $x\\to\\infty$, $e^x\\to\\infty$. Adding 1 leaves the expression increasing without bound, so the limit is $\\infty$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p16-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\lim_{x\\to\\infty}(5-e^x)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\infty$",
          "worked": "As $x\\to\\infty$, $e^x\\to\\infty$. Subtracting it from 5 gives a limit of $-\\infty$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p16-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\lim_{x\\to\\infty}(7-e^{-2x})$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "As $x\\to\\infty$, $-2x\\to-\\infty$, so $e^{-2x}\\to0$. The expression tends to $7-0=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p16-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\lim_{x\\to-\\infty}(5+e^{3x})$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "As $x\\to-\\infty$, $3x\\to-\\infty$, so $e^{3x}\\to0$. The expression tends to $5+0=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p16-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\lim_{x\\to-\\infty}(3+e^{-0.1x})$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\infty$",
          "worked": "As $x\\to-\\infty$, $-0.1x\\to\\infty$, so $e^{-0.1x}\\to\\infty$. Adding 3 leaves the limit equal to $\\infty$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p16-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\lim_{x\\to-\\infty}\\left(\\frac{3}{e^x}\\right)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\infty$",
          "worked": "Write $\\frac{3}{e^x}=3e^{-x}$. As $x\\to-\\infty$, $-x\\to\\infty$, so $3e^{-x}\\to\\infty$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\lim_{x\\to\\infty}\\left(\\frac{1-e^{-x}}{1+e^{-x}}\\right)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "As $x\\to\\infty$, $e^{-x}\\to0$. The numerator and denominator each tend to 1, so the quotient tends to $\\frac{1-0}{1+0}=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
