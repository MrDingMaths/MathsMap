        "label": "a",
        "prompt": "$3x^2+12x+15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x+2)^2+3$",
          "worked": "$$\\begin{align*}3x^2+12x+15&=3(x^2+4x+5)\\\\3x^2+12x+15&=3\\big((x+2)^2-4+5\\big)\\\\3x^2+12x+15&=3(x+2)^2+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q16-root",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+8x+18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2+2$",
          "worked": "$$\\begin{align*}x^2+8x+18&=(x+4)^2-16+18\\\\x^2+8x+18&=(x+4)^2+2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q17-root",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2-4x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x-1)^2+3$",
          "worked": "$$\\begin{align*}2x^2-4x+5&=2\\left(x^2-2x+\\frac52\\right)\\\\2x^2-4x+5&=2\\left((x-1)^2-1+\\frac52\\right)\\\\2x^2-4x+5&=2(x-1)^2+3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p58-q18-root",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2-6x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\left(x-\\dfrac34\\right)^2+\\dfrac34$.\n\nExtract $4$ before completing the square.",
          "worked": "$$\\begin{align*}4x^2-6x+3&=4\\left(x^2-\\frac32x+\\frac34\\right)\\\\4x^2-6x+3&=4\\left(\\left(x-\\frac34\\right)^2-\\frac9{16}+\\frac{12}{16}\\right)\\\\4x^2-6x+3&=4\\left(x-\\frac34\\right)^2+\\frac34.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
