  "content": {
    "id": "p42-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "A loaf of bread costs 89c. The price increases by 22% due to inflation. What is the new price? Answer in dollars, to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1.09$",
          "worked": "$$\\begin{align*}\\text{New price}&=\\$0.89\\times1.22\\\\\\text{New price}&=\\$1.0858\\\\\\text{New price}&\\approx\\$1.09\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p42-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The price of a loaf of bread increases from 89c to \\$1.20. What is the change as a percentage? Round to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34.8\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Increase}&=\\$1.20-\\$0.89\\\\\\text{Increase}&=\\$0.31\\\\\\text{Percentage increase}&=\\frac{0.31}{0.89}\\times100\\%\\\\\\text{Percentage increase}&\\approx34.8\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p42-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "A loaf of bread cost 89c five years ago. This price increases by 6% every year. How much does it cost now, to the nearest cent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1.19$",
          "worked": "Each annual increase has multiplier $1.06$. There are five annual increases.\n\n$$\\begin{align*}\\text{Current price}&=\\$0.89\\times1.06^5\\\\\\text{Current price}&=\\$1.191020764064\\\\\\text{Current price}&\\approx\\$1.19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p42-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "A shop marks down a loaf of bread to 89c in a 30% off sale. What did it cost originally? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1.27$",
          "worked": "After a 30% discount, 89c represents $70\\%$ of the original price.\n\n$$\\begin{align*}70\\%&=\\$0.89\\\\1\\%&=\\$\\frac{0.89}{70}\\\\100\\%&=\\$\\frac{0.89}{70}\\times100\\\\100\\%&=\\$\\frac{89}{70}\\\\100\\%&\\approx\\$1.27\\end{align*}$$\n\nThe original price was $\\$1.27$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
