        "children": [
          {
            "id": "p45-q5-g",
            "type": "part",
            "label": "g",
            "prompt": "$(5\\sqrt{8}-10\\sqrt{2})(5\\sqrt{8}+10\\sqrt{2})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$. The squared terms are both $200$.",
              "worked": "$$\\begin{align*}(5\\sqrt{8}-10\\sqrt{2})(5\\sqrt{8}+10\\sqrt{2})&=(5\\sqrt{8})^2-(10\\sqrt{2})^2\\\\&=200-200\\\\&=0\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-h",
            "type": "part",
            "label": "h",
            "prompt": "$(3\\sqrt{7}-4\\sqrt{6})(3\\sqrt{7}+4\\sqrt{6})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-33$. Subtract the squares: $63-96$.",
              "worked": "$$\\begin{align*}(3\\sqrt{7}-4\\sqrt{6})(3\\sqrt{7}+4\\sqrt{6})&=(3\\sqrt{7})^2-(4\\sqrt{6})^2\\\\&=63-96\\\\&=-33\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-i",
            "type": "part",
            "label": "i",
            "prompt": "$(2\\sqrt{10}+4\\sqrt{5})(2\\sqrt{10}-4\\sqrt{5})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-40$. Subtract the squares: $40-80$.",
              "worked": "$$\\begin{align*}(2\\sqrt{10}+4\\sqrt{5})(2\\sqrt{10}-4\\sqrt{5})&=(2\\sqrt{10})^2-(4\\sqrt{5})^2\\\\&=40-80\\\\&=-40\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-j",
            "type": "part",
            "label": "j",
            "prompt": "$(4\\sqrt{10}-5\\sqrt{6})(4\\sqrt{10}+5\\sqrt{6})$",
            "layout": "list",
            "columns": null,
