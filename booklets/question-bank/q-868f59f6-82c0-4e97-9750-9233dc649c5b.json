          {
            "id": "p45-q5-a",
            "type": "part",
            "label": "a",
            "prompt": "$(3-\\sqrt{2})(3+\\sqrt{2})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}(3-\\sqrt{2})(3+\\sqrt{2})&=3^2-(\\sqrt{2})^2\\\\&=9-2\\\\&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-b",
            "type": "part",
            "label": "b",
            "prompt": "$(5-\\sqrt{6})(5+\\sqrt{6})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$19$",
              "worked": "$$\\begin{align*}(5-\\sqrt{6})(5+\\sqrt{6})&=5^2-(\\sqrt{6})^2\\\\&=25-6\\\\&=19\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-c",
            "type": "part",
            "label": "c",
            "prompt": "$(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})&=(\\sqrt{3})^2-(\\sqrt{2})^2\\\\&=3-2\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-d",
            "type": "part",
            "label": "d",
            "prompt": "$(3\\sqrt{2}-\\sqrt{11})(3\\sqrt{2}+\\sqrt{11})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}(3\\sqrt{2}-\\sqrt{11})(3\\sqrt{2}+\\sqrt{11})&=(3\\sqrt{2})^2-(\\sqrt{11})^2\\\\&=18-11\\\\&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p45-q5-e",
            "type": "part",
            "label": "e",
            "prompt": "$(2\\sqrt{6}+3)(2\\sqrt{6}-3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$15$",
              "worked": "$$\\begin{align*}(2\\sqrt{6}+3)(2\\sqrt{6}-3)&=(2\\sqrt{6})^2-3^2\\\\&=24-9\\\\&=15\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p45-q5-f",
            "type": "part",
            "label": "f",
            "prompt": "$(7-2\\sqrt{5})(7+2\\sqrt{5})$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$29$",
              "worked": "$$\\begin{align*}(7-2\\sqrt{5})(7+2\\sqrt{5})&=7^2-(2\\sqrt{5})^2\\\\&=49-20\\\\&=29\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p45-q5-second-grid",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
