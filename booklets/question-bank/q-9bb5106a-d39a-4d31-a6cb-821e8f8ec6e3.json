    "id": "p13-q1-p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A number is chosen at random from the first 15 positive whole numbers. What is the probability that it is not a prime number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{5}$",
      "worked": "The primes are $2,3,5,7,11,13$: six of the 15 numbers. Note that 1 is not prime.\n$$\\begin{align*}P(\\text{not prime})&=1-\\frac{6}{15}\\\\P(\\text{not prime})&=\\frac{9}{15}\\\\P(\\text{not prime})&=\\frac{3}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
