        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.5$",
          "worked": "$$\\begin{align*}5x+4&=5\\times(-0.1)+4\\\\5x+4&=-0.5+4\\\\5x+4&=3.5\\end{align*}$$",
          "solutionDiagrams": []
