          "worked": "$$\\begin{align*}-5x+4&=-5\\times(-0.1)+4\\\\-5x+4&=0.5+4\\\\-5x+4&=4.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
