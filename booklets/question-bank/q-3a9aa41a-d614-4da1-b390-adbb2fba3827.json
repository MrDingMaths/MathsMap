          "short": "$c=25$",
          "worked": "$$\\begin{align*}c&=\\sqrt{24^{2}+7^{2}}\\\\c&=\\sqrt{576+49}\\\\c&=\\sqrt{625}\\\\c&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
