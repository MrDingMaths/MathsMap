        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=5$",
          "worked": "$$\\begin{align*}c&=\\sqrt{3^{2}+4^{2}}\\\\c&=\\sqrt{9+16}\\\\c&=\\sqrt{25}\\\\c&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
