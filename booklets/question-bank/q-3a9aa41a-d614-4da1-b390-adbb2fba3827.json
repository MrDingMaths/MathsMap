        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=13$",
          "worked": "$$\\begin{align*}c&=\\sqrt{5^{2}+12^{2}}\\\\c&=\\sqrt{25+144}\\\\c&=\\sqrt{169}\\\\c&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
