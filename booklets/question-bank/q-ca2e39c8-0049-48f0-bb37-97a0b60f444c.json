  "content": {
    "id": "p54-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The quantity $y$ varies inversely with the square of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac{k}{x^2}$",
              "worked": "Inverse variation with $x^2$ gives\n$$y=\\frac{k}{x^2}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p54-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "It is found that $y=2$ when $x=3$. Determine the constant $k$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$k=18$",
              "worked": "$$\\begin{align*}2&=\\frac{k}{3^2}\\\\k&=2\\times9\\\\k&=18\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p54-q4-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Evaluate $y$ when $x=6$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac12$",
              "worked": "$$\\begin{align*}y&=\\frac{18}{6^2}\\\\y&=\\frac{18}{36}\\\\y&=\\frac12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p54-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "What happens to the value of $y$ when the value of $x$ is:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "doubled?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ is divided by $4$.",
              "worked": "$$\\frac{k}{(2x)^2}=\\frac14\\frac{k}{x^2}.$$\nThus $y$ is divided by $4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p54-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "halved?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ is quadrupled.",
              "worked": "$$\\frac{k}{(x/2)^2}=4\\frac{k}{x^2}.$$\nThus $y$ is multiplied by $4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          }
        ]
      }
    ]
  },
