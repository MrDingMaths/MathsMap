    "children": [
      {
        "id": "p9-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the side length of the base of the tray.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(20-2x)\\text{ cm}$",
          "worked": "Subtract the two corner widths from the sheet width.\n$$\\begin{align*}s&=20-x-x\\\\s&=20-2x\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression for the area of the base of the tray. Expand your answer.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(20-2x)^2=400-80x+4x^2\\text{ cm}^2$",
          "worked": "For the perfect square, $a=20$ and $b=-2x$.\n$$\\begin{align*}A&=(20-2x)^2\\\\A&=20^2+2(20)(-2x)+(-2x)^2\\\\A&=400-80x+4x^2\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the area of the tray base if $x=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$196\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=400-80(3)+4(3)^2\\\\A&=400-240+36\\\\A&=196\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ],
