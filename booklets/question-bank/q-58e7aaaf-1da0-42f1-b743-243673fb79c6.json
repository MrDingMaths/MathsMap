          },
          "worked": "There are $10$ coins, and $X$ takes the values $5$ and $10$ cents.\n$$\\begin{align*}P(X=5)&=\\frac6{10}=\\frac35\\\\P(X=10)&=\\frac4{10}=\\frac25\\end{align*}$$\nThese probabilities sum to $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the expected value of $X$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$ cents",
          "worked": "$$\\begin{align*}E(X)&=\\frac35\\times5+\\frac25\\times10\\\\E(X)&=3+4\\\\E(X)&=7\\text{ cents}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
