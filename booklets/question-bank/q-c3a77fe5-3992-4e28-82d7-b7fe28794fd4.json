    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Describe the numbers that have exactly three factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Squares of prime numbers: $p^2$, where $p$ is prime.",
          "worked": "If $p$ is prime, the positive factors of $p^2$ are $1$, $p$ and $p^2$.\n\nConversely, a number with exactly three factors must be a square, since its factors pair except for its square root. Its square root must be prime; otherwise a proper factor of the square root would give another factor. Therefore these numbers are precisely the squares of primes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the smallest three-digit number with exactly three factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$121$",
          "worked": "The number must be $p^2$ for a prime $p$. Since $10^2=100$, the smallest possible prime is $11$.\n\n$$11^2=121.$$\n\nIts factors are $1$, $11$ and $121$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the largest three-digit number with exactly three factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$961$",
          "worked": "The number must be $p^2$ for a prime $p$. Since $31^2=961$ and $32^2=1024$, a three-digit square requires $p\\leq31$. The number $31$ is prime.\n\n$$31^2=961.$$\n\nIts factors are $1$, $31$ and $961$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
