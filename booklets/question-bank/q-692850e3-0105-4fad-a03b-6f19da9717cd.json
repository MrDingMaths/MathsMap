  "content": {
    "id": "v2-8731d-p23-practice-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "The number of days $d$ that a bag of dog food lasts varies inversely with the number of dogs $n$ being fed from it. The bag lasts 12 days when $n = 3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-8731d-p23-practice-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation $d = \\frac{k}{n}$ and calculate the constant of variation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 36$, $d = \\frac{36}{n}$.",
          "worked": "$$\\begin{align*}d &= \\frac{k}{n}\\\\12 &= \\frac{k}{3}\\\\36 &= k\\\\d &= \\frac{36}{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-8731d-p23-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How many days will the bag last if $n = 4$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 days",
          "worked": "$$\\begin{align*}d &= \\frac{36}{4}\\\\d &= 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-8731d-p23-practice-slot-11-slot-11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "How many dogs are being fed if the bag lasts 18 days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 dogs",
          "worked": "$$\\begin{align*}18 &= \\frac{36}{n}\\\\18n &= 36\\\\n &= \\frac{36}{18}\\\\n &= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
