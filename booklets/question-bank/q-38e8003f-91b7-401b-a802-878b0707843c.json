  "content": {
    "id": "p6-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "One counter is picked at random from a bag containing 15 red counters, 5 white counters and 5 yellow counters. What is the probability that the counter removed is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "There are $15+5+5=25$ counters.\n\n$$\\begin{align*}P(\\text{red})&=\\frac{15}{25}\\\\P(\\text{red})&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "yellow?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "There are $25$ counters, of which $5$ are yellow.\n\n$$\\begin{align*}P(\\text{yellow})&=\\frac{5}{25}\\\\P(\\text{yellow})&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p6-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "not red?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "Not red is the complement of red.\n\n$$\\begin{align*}P(\\text{not red})&=1-P(\\text{red})\\\\P(\\text{not red})&=1-\\frac{3}{5}\\\\P(\\text{not red})&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
