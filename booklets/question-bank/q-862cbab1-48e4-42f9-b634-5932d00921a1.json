    "children": [],
    "answer": {
      "short": "$1:25\\,000$",
      "worked": "Use the same units for image and original.\n$$\\begin{align*}250\\text{ m}&=25\\,000\\text{ cm}\\\\\\text{Image}:\\text{Original}&=1\\text{ cm}:25\\,000\\text{ cm}\\\\&=1:25\\,000\\end{align*}$$",
