    "type": "question",
    "label": null,
    "prompt": "The number of subscribers to an Australian cooking channel is 2500 and is increasing by 8% each month.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-b02ad-p42-practice-slot-7-lower-slot-7-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation for the number of subscribers, $S$, after $m$ months.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S=2500(1.08)^m$",
          "worked": "$$\\begin{align*}1+0.08&=1.08\\\\S&=2500(1.08)^m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b02ad-p42-practice-slot-7-lower-slot-7-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the number of subscribers after 6 months. Give your answer to the nearest whole number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3967 subscribers",
          "worked": "$$\\begin{align*}S&=2500(1.08)^6\\\\S&\\approx3967\\end{align*}$$",
          "solutionDiagrams": []
        },
