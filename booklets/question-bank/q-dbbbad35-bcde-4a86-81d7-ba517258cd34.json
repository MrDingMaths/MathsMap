  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Solve these questions using the formula $S_n=\\frac{n}{2}(a+\\ell)$ whenever possible, otherwise use the formula $S_n=\\frac{n}{2}(2a+(n-1)d)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the last term if a series with 10 terms and first term $-23$ has sum $-5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=22$",
          "worked": "$$\\begin{align*}S_n&=\\frac{n}{2}(a+\\ell)\\\\-5&=\\frac{10}{2}(-23+\\ell)\\\\-5&=5(-23+\\ell)\\\\-1&=-23+\\ell\\\\\\ell&=22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the first term if a series with 40 terms and last term $8\\frac{1}{2}$ has sum 28.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-7.1$",
          "worked": "$$\\begin{align*}S_n&=\\frac{n}{2}(a+\\ell)\\\\28&=\\frac{40}{2}\\left(a+8\\frac{1}{2}\\right)\\\\28&=20\\left(a+8\\frac{1}{2}\\right)\\\\1.4&=a+8.5\\\\a&=-7.1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the common difference if a series with 8 terms and first term 5 has sum 348.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=11$",
          "worked": "$$\\begin{align*}S_n&=\\frac{n}{2}(2a+(n-1)d)\\\\348&=\\frac{8}{2}(2(5)+7d)\\\\348&=4(10+7d)\\\\87&=10+7d\\\\77&=7d\\\\d&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p24-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the first term if a series with 15 terms and difference $\\frac{2}{7}$ has sum $-15$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-3$",
          "worked": "$$\\begin{align*}S_n&=\\frac{n}{2}(2a+(n-1)d)\\\\-15&=\\frac{15}{2}\\left(2a+14\\left(\\frac{2}{7}\\right)\\right)\\\\-15&=\\frac{15}{2}(2a+4)\\\\-2&=2a+4\\\\-6&=2a\\\\a&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
