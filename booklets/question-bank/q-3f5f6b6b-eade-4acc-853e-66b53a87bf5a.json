    "children": [
      {
        "id": "p36-q7-task",
        "type": "part",
        "label": "",
        "prompt": "Explain why this is incorrect and state the correct volume of Lake Victoria.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A difference of $3$ on the base-10 scale represents a factor of $10^3=1000$, so Lake Victoria has $500\\,000\\,000\\ \\mathrm{ML}$ of water.",
          "worked": "$$\\begin{align*}\\frac{V_{\\mathrm{Victoria}}}{V_{\\mathrm{Anne}}}&=\\frac{10^8}{10^5}\\\\\\frac{V_{\\mathrm{Victoria}}}{V_{\\mathrm{Anne}}}&=10^3=1000\\\\V_{\\mathrm{Victoria}}&=500\\,000\\times1000\\\\V_{\\mathrm{Victoria}}&=500\\,000\\,000\\ \\mathrm{ML}\\end{align*}$$\nA difference of $8-5=3$ on the logarithmic scale represents multiplication by $1000$ in volume. The claim incorrectly treats the logarithmic magnitudes as directly proportional to the volumes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
