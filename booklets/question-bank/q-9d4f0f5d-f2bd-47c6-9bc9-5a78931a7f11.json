  "content": {
    "id": "p16-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the future value for these annuities using the table extract below. Give monetary answers to the nearest cent.\n\nFuture value of an annuity with $1 paid at the end of each period:\n\n| Number of periods | Interest rate per period | Future value of $1 |\n| --- | --- | --- |\n| 10 | 2.5% | 11.2034 |\n| 20 | 2% | 24.2974 |\n| 24 | 1% | 26.9735 |\n| 36 | 0.4% | 38.6381 |\n| 36 | 1% | 43.0769 |\n| 48 | 0.5% | 54.0978 |",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\$300$ invested monthly over 3 years at 4.8% p.a. compounded monthly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$11\\,591.43$",
          "worked": "$$\\begin{align*}n&=3\\times12=36\\\\r&=4.8\\%\\div12=0.4\\%\\\\\\text{Table factor}&=38.6381\\\\FV&=38.6381\\times300\\\\FV&=\\$11\\,591.43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\$100$ invested monthly over 4 years at 6% p.a. compounded monthly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5409.78$",
          "worked": "$$\\begin{align*}n&=4\\times12=48\\\\r&=6\\%\\div12=0.5\\%\\\\\\text{Table factor}&=54.0978\\\\FV&=54.0978\\times100\\\\FV&=\\$5409.78\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\$1000$ invested quarterly over 5 years at 8% p.a. compounded quarterly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$24\\,297.40$",
          "worked": "$$\\begin{align*}n&=5\\times4=20\\\\r&=8\\%\\div4=2\\%\\\\\\text{Table factor}&=24.2974\\\\FV&=24.2974\\times1000\\\\FV&=\\$24\\,297.40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\$3000$ invested every 3 months over 6 years at 4% p.a. compounded every 3 months.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$80\\,920.50$",
          "worked": "$$\\begin{align*}n&=6\\times4=24\\\\r&=4\\%\\div4=1\\%\\\\\\text{Table factor}&=26.9735\\\\FV&=26.9735\\times3000\\\\FV&=\\$80\\,920.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\$15\\,000$ invested biannually over 5 years at 5% p.a. compounded biannually.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$168\\,051.00$",
          "worked": "Biannually means twice a year.\n$$\\begin{align*}n&=5\\times2=10\\\\r&=5\\%\\div2=2.5\\%\\\\\\text{Table factor}&=11.2034\\\\FV&=11.2034\\times15\\,000\\\\FV&=\\$168\\,051.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
