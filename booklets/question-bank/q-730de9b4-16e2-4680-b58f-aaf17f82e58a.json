  "content": {
    "id": "v2-c10bb-p19-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=3-2x$ and $g(x)=\\dfrac{4}{x}$.\n\nFind the inverse of $f(g(x))$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(fg)^{-1}(x)=\\dfrac{8}{3-x}$, $x\\ne3$.",
      "worked": "$$\\begin{align*}f(g(x))&=3-2\\left(\\frac{4}{x}\\right)\\\\f(g(x))&=3-\\frac{8}{x}\\end{align*}$$\n$$\\begin{align*}y&=3-\\frac{8}{x}\\\\x&=3-\\frac{8}{y}\\\\\\frac{8}{y}&=3-x\\\\y&=\\frac{8}{3-x}\\\\(fg)^{-1}(x)&=\\frac{8}{3-x},\\qquad x\\ne3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
  },
