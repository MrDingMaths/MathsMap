        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"intervalBlue\",\"hex\":\"268CFF\",\"reason\":\"distinguishes interval ST from its dashed perpendicular bisector\"}],\"reference\":\"source page 24 p24-q10-diagram\"}\n\\begin{tikzpicture}[x=0.55cm,y=0.55cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{intervalBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-5.5,-4) rectangle (5.7,7.5);\n\\draw[<->,black,line width=0.5pt] (-5.2,0)--(5.2,0) node[below left,text=black] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-3.8)--(0,7) node[right,text=black] {$y$};\n\\coordinate (S) at (-2,-2);\n\\coordinate (T) at (2,6);\n\\coordinate (M) at (0,2);\n\\draw[intervalBlue,line width=0.8pt] (S)--(T);\n\\fill[intervalBlue] (S) circle (1.5pt);\n\\fill[intervalBlue] (T) circle (1.5pt);\n\\node[below left,text=black] at (S) {$S(-2,-2)$};\n\\node[above right,text=black] at (T) {$T(2,6)$};\n\\draw[<->,intervalBlue,dashed,line width=0.8pt] (-4.5,4.25)--(4.5,-0.25);\n\\draw[black,line width=0.4pt] (0.223607,2.447214)--(-0.223607,2.670821)--(-0.447214,2.223607);\n\\end{tikzpicture}",
        "src": null,
