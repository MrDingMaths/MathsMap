    "children": [
      {
        "id": "p24-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of interval $ST$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$",
          "worked": "$$\\begin{align*}m&=\\frac{6-(-2)}{2-(-2)}\\\\&=\\frac{8}{4}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoint of $ST$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M(0,2)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{-2+2}{2},\\frac{-2+6}{2}\\right)\\\\&=(0,2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "The dotted line is perpendicular to $ST$ and passes through its midpoint. What is its gradient?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}m_{\\mathrm{perp}}&=-\\frac{1}{m_{ST}}\\\\&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p24-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the dotted line.\nAnswer in gradient-intercept form $y=mx+c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac12x+2$",
          "worked": "$$\\begin{align*}y-y_1&=m_{\\mathrm{perp}}(x-x_1)\\\\y-2&=-\\frac12(x-0)\\\\y&=-\\frac12x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
