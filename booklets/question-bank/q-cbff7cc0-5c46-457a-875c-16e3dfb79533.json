  "content": {
    "id": "p50-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "In a bag there are four green, three blue and five red discs.\n\nTwo discs are drawn at random, and the first disc is not replaced before the second disc is drawn. Find the probability of drawing:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "two red discs,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{33}$",
          "worked": "$$\\begin{align*}P(\\text{two red})&=\\frac{5}{12}\\times\\frac{4}{11}\\\\P(\\text{two red})&=\\frac{20}{132}=\\frac{5}{33}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p50-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "one red and one blue disc,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{22}$",
          "worked": "$$\\begin{align*}P(\\text{one red, one blue})&=P(RB)+P(BR)\\\\P(\\text{one red, one blue})&=\\frac{5}{12}\\times\\frac{3}{11}+\\frac{3}{12}\\times\\frac{5}{11}\\\\P(\\text{one red, one blue})&=\\frac{30}{132}=\\frac{5}{22}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p50-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one green disc,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{33}$",
          "worked": "$$\\begin{align*}P(\\text{at least one green})&=1-P(\\text{no green})\\\\P(\\text{at least one green})&=1-\\frac{8}{12}\\times\\frac{7}{11}\\\\P(\\text{at least one green})&=1-\\frac{56}{132}\\\\P(\\text{at least one green})&=\\frac{76}{132}=\\frac{19}{33}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p50-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "a blue disc on the first draw,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}P(\\text{blue first})&=\\frac{3}{12}=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p50-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "two discs of the same colour,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{66}$",
          "worked": "$$\\begin{align*}P(\\text{same colour})&=P(GG)+P(BB)+P(RR)\\\\P(\\text{same colour})&=\\frac{4}{12}\\times\\frac{3}{11}+\\frac{3}{12}\\times\\frac{2}{11}+\\frac{5}{12}\\times\\frac{4}{11}\\\\P(\\text{same colour})&=\\frac{12+6+20}{132}\\\\P(\\text{same colour})&=\\frac{38}{132}=\\frac{19}{66}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p50-q22-f",
        "type": "part",
        "label": "f",
        "prompt": "two differently coloured discs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{47}{66}$",
          "worked": "$$\\begin{align*}P(\\text{different colours})&=1-P(\\text{same colour})\\\\P(\\text{different colours})&=1-\\frac{19}{66}=\\frac{47}{66}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
