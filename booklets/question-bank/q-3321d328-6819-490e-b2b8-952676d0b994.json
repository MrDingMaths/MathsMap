  "content": {
    "id": "p61-q4",
    "type": "question",
    "label": "4",
    "prompt": "Find the value of $m$.\n$$(x+3)(m-2)=-\\frac{x}{3}-1$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=\\dfrac{5}{3}$.",
      "worked": "$$\\begin{align*}(m-2)x+3(m-2)&=-\\frac{x}{3}-1\\\\m-2&=-\\frac13\\\\m&=\\frac53\\end{align*}$$\nThe constant terms also agree: $3(m-2)=3(-\\frac13)=-1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
