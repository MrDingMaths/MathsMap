        "id": "v2-cff70-p23-practice-slot-7-slot-7-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=5^{2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2(\\ln 5)5^{2x+1}$",
          "worked": "Let $u=2x+1$, so $y=5^u$.\n$$\\begin{align*}\\frac{du}{dx}&=2\\\\\\frac{dy}{du}&=(\\ln 5)5^u\\\\\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\\\frac{dy}{dx}&=2(\\ln 5)5^{2x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-cff70-p23-practice-slot-7-slot-7-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=10^{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2x(\\ln 10)10^{x^2}$",
          "worked": "Let $u=x^2$, so $y=10^u$.\n$$\\begin{align*}\\frac{du}{dx}&=2x\\\\\\frac{dy}{du}&=(\\ln 10)10^u\\\\\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\\\frac{dy}{dx}&=2x(\\ln 10)10^{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
