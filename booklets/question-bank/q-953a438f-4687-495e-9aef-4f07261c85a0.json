  "content": {
    "id": "p44-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Differentiate the following using first principles.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=4x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=8x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{4(x+h)^2-4x^2}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{8xh+4h^2}{h}\\\\f'(x)&=\\lim_{h\\to0}(8x+4h)\\\\f'(x)&=8x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=1-2x$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{(x+h)-(x+h)^2-(x-x^2)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{h-2xh-h^2}{h}\\\\f'(x)&=\\lim_{h\\to0}(1-2x-h)\\\\f'(x)&=1-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p44-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2x^2+3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=4x+3$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2(x+h)^2+3(x+h)-(2x^2+3x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{4xh+2h^2+3h}{h}\\\\f'(x)&=\\lim_{h\\to0}(4x+2h+3)\\\\f'(x)&=4x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p44-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^2-4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x-4$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{(x+h)^2-4(x+h)+2-(x^2-4x+2)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{2xh+h^2-4h}{h}\\\\f'(x)&=\\lim_{h\\to0}(2x+h-4)\\\\f'(x)&=2x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
