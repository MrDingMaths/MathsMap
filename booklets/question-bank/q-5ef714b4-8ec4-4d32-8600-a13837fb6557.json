  "content": {
    "id": "p31-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The ends of a bar have to be machined down until the bar is $3$ m long. After $5\\%$ of the length had been removed, it was found that $0.5\\%$ of the new length still had to come off. What length was removed at each machining and what was the original length of the bar?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p31-q8-short-results",
