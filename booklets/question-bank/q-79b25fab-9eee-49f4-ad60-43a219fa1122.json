    "type": "question",
    "label": null,
    "prompt": "Show that $$\\frac{\\cos(90^\\circ-\\theta)\\sin(180^\\circ-\\theta)}{\\cos(180^\\circ+\\theta)\\cos(-\\theta)}=-\\tan^2\\theta.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\mathrm{LHS}=-\\dfrac{\\sin^2\\theta}{\\cos^2\\theta}=-\\tan^2\\theta=\\mathrm{RHS}$.",
      "worked": "$$\\begin{align*}\\frac{\\cos(90^\\circ-\\theta)\\sin(180^\\circ-\\theta)}{\\cos(180^\\circ+\\theta)\\cos(-\\theta)}&=\\frac{\\sin\\theta\\sin\\theta}{(-\\cos\\theta)\\cos\\theta}\\\\\\frac{\\cos(90^\\circ-\\theta)\\sin(180^\\circ-\\theta)}{\\cos(180^\\circ+\\theta)\\cos(-\\theta)}&=-\\frac{\\sin^2\\theta}{\\cos^2\\theta}\\\\\\frac{\\cos(90^\\circ-\\theta)\\sin(180^\\circ-\\theta)}{\\cos(180^\\circ+\\theta)\\cos(-\\theta)}&=-\\tan^2\\theta\\end{align*}$$This is the right-hand side.",
      "solutionDiagrams": []
    },
