  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The polynomial $P(x)=x^3-9x^2+27x-25$ can be written in the form $P(x)=(x-h)^3+k$. Find $h$ and $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$h=3$, $k=2$.",
      "worked": "$$\\begin{align*}(x-h)^3+k&=x^3-3hx^2+3h^2x-h^3+k\\end{align*}$$\n\nEquating coefficients:\n\n$$\\begin{align*}-3h&=-9\\\\h&=3\\\\3h^2&=3(3)^2=27\\\\k-h^3&=-25\\\\k-27&=-25\\\\k&=2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
