  "content": {
    "id": "p32-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A cylinder of height $5\\,\\mathrm{cm}$ has a volume of $45\\pi\\,\\mathrm{cm}^3$. Find the radius of this cylinder.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\,\\mathrm{cm}$",
      "worked": "$$\\begin{align*}V&=\\pi r^2h\\\\45\\pi&=\\pi r^2\\times5\\\\r^2&=\\frac{45\\pi}{5\\pi}\\\\r^2&=9\\\\r&=3\\,\\mathrm{cm}\\end{align*}$$\nThe radius is positive.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
