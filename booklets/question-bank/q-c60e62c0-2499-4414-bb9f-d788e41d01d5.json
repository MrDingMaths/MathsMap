    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "A coin is biased so that the probability that it lands on heads is $p$, where $0<p<1$. The coin is thrown six times and the number $X$ of heads is counted. Find the value of $p$ for which\n$$\\Pr(X=2)=16\\times\\Pr(X=4).$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\dfrac15$.",
          "worked": "$$\\begin{align*}\\binom62p^2(1-p)^4&=16\\binom64p^4(1-p)^2\\\\(1-p)^2&=16p^2\\\\1-p&=4p\\\\1&=5p\\\\p&=\\frac15.\\end{align*}$$\nHere $p$ and $1-p$ are positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p38-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "A coin is biased so that the probability that it lands on heads is $p$. The coin is thrown five times and the number $X$ of heads is counted. Find the value of $p$ for which\n$$\\Pr(X=5\\mid X\\geq4)=\\frac13.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\dfrac57$.\n\nRestrict the probability to the outcomes with four or five heads.",
          "worked": "$$\\begin{align*}\\Pr(X=5\\mid X\\geq4)&=\\frac{\\Pr(X=5)}{\\Pr(X=4)+\\Pr(X=5)}\\\\\\Pr(X=5\\mid X\\geq4)&=\\frac{p^5}{5p^4(1-p)+p^5}\\\\\\Pr(X=5\\mid X\\geq4)&=\\frac{p}{5-4p}.\\end{align*}$$\nThus,\n$$\\begin{align*}\\frac{p}{5-4p}&=\\frac13\\\\3p&=5-4p\\\\7p&=5\\\\p&=\\frac57.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
