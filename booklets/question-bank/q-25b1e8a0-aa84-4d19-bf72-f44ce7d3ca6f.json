  },
  "content": {
    "id": "p17-q20",
    "type": "question",
    "label": "20",
    "prompt": "Sienna factorised $\\frac{5x}{3}+\\frac{5y}{6}$ as $\\frac{5}{6}(2x+y)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "By expanding, show that she is correct.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}(2x+y)=\\frac{5x}{3}+\\frac{5y}{6}$, so she is correct.",
          "worked": "$$\\begin{align*}\\frac{5}{6}(2x+y)&=\\frac{10x}{6}+\\frac{5y}{6}\\\\&=\\frac{5x}{3}+\\frac{5y}{6}\\end{align*}$$\nThis is the original expression, so she is correct.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q20-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence factorise these expressions; there should be no fractions inside brackets.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q20-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\frac{x}{2}+\\frac{y}{4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{4}(2x+y)$",
              "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{y}{4}&=\\frac{2x}{4}+\\frac{y}{4}\\\\&=\\frac{1}{4}(2x+y)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p17-q20-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\frac{3a}{4}-\\frac{b}{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{4}(3a-2b)$",
              "worked": "$$\\begin{align*}\\frac{3a}{4}-\\frac{b}{2}&=\\frac{3a}{4}-\\frac{2b}{4}\\\\&=\\frac{1}{4}(3a-2b)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p17-q20-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$\\frac{2p}{3}-\\frac{q}{6}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{6}(4p-q)$",
              "worked": "$$\\begin{align*}\\frac{2p}{3}-\\frac{q}{6}&=\\frac{4p}{6}-\\frac{q}{6}\\\\&=\\frac{1}{6}(4p-q)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p17-q20-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$\\frac{3x}{8}+\\frac{y}{4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{8}(3x+2y)$",
              "worked": "$$\\begin{align*}\\frac{3x}{8}+\\frac{y}{4}&=\\frac{3x}{8}+\\frac{2y}{8}\\\\&=\\frac{1}{8}(3x+2y)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p17-q20-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$\\frac{xy^{2}}{5}+\\frac{xy}{10}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{xy}{10}(2y+1)$",
              "worked": "$$\\begin{align*}\\frac{xy^{2}}{5}+\\frac{xy}{10}&=\\frac{2xy^{2}}{10}+\\frac{xy}{10}\\\\&=\\frac{xy}{10}(2y+1)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p17-q20-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "$\\frac{5c^{3}}{9}-\\frac{cd}{3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{c}{9}(5c^{2}-3d)$",
              "worked": "$$\\begin{align*}\\frac{5c^{3}}{9}-\\frac{cd}{3}&=\\frac{5c^{3}}{9}-\\frac{3cd}{9}\\\\&=\\frac{c}{9}(5c^{2}-3d)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      }
    ]
  },
