        "label": "a",
        "prompt": "$\\sin720^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sin720^{\\circ}&=\\sin(720^{\\circ}-720^{\\circ})\\\\\\sin720^{\\circ}&=\\sin0^{\\circ}\\\\\\sin720^{\\circ}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos720^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\cos720^{\\circ}&=\\cos(720^{\\circ}-720^{\\circ})\\\\\\cos720^{\\circ}&=\\cos0^{\\circ}\\\\\\cos720^{\\circ}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos450^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cos450^{\\circ}&=\\cos(450^{\\circ}-360^{\\circ})\\\\\\cos450^{\\circ}&=\\cos90^{\\circ}\\\\\\cos450^{\\circ}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan(-360^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\tan(-360^{\\circ})&=\\tan0^{\\circ}\\\\\\tan(-360^{\\circ})&=\\frac{\\sin0^{\\circ}}{\\cos0^{\\circ}}\\\\\\tan(-360^{\\circ})&=\\frac01\\\\\\tan(-360^{\\circ})&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p15-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin(-270^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin(-270^{\\circ})&=\\sin(-270^{\\circ}+360^{\\circ})\\\\\\sin(-270^{\\circ})&=\\sin90^{\\circ}\\\\\\sin(-270^{\\circ})&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\cos(-90^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\cos(-90^{\\circ})&=\\cos(-90^{\\circ}+360^{\\circ})\\\\\\cos(-90^{\\circ})&=\\cos270^{\\circ}\\\\\\cos(-90^{\\circ})&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\tan(-180^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\tan(-180^{\\circ})&=\\tan180^{\\circ}\\\\\\tan(-180^{\\circ})&=\\frac{\\sin180^{\\circ}}{\\cos180^{\\circ}}\\\\\\tan(-180^{\\circ})&=\\frac{0}{-1}\\\\\\tan(-180^{\\circ})&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
