  "content": {
    "id": "equations-r6-backfill-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find the missing values by equating coefficients.\n$$(x+3k)(x+k)=x^2+dx+12$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=2,\\ d=8$ or $k=-2,\\ d=-8$.",
      "worked": "$$\\begin{aligned}x^2+4kx+3k^2&=x^2+dx+12\\end{aligned}$$\nEquating coefficients of $x$ and constant terms:\n$$\\begin{aligned}4k&=d,&3k^2&=12\\\\&&k^2&=4\\\\&&k&=\\pm2\\end{aligned}$$\nIf $k=2$:\n$$\\begin{aligned}d&=4(2)\\\\&=8\\end{aligned}$$\nIf $k=-2$:\n$$\\begin{aligned}d&=4(-2)\\\\&=-8\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 37
  },
