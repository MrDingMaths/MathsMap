  "content": {
    "id": "p6-q22-response",
    "type": "question",
    "label": "22",
    "prompt": "Mary walks $85\\text{ m}$ on a bearing of $\\mathrm{N}50^\\circ\\mathrm{W}$. How far north did she walk? Give your answer correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$54.6\\text{ m}$",
      "worked": "The direction is $50^\\circ$ west of north. Let $n$ be the distance north in metres.\n\n$$\\begin{align*}\\cos 50^\\circ &= \\frac{n}{85}\\\\n &= 85\\cos 50^\\circ\\\\n &\\approx 54.6\\end{align*}$$\n\nMary walked $54.6\\text{ m}$ north.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
