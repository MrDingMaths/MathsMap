    "type": "question",
    "label": "11",
    "prompt": "Express $y$ in terms of $x$ when:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{10}y=1+\\log_{10}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=10x$",
          "worked": "$$\\begin{align*}\\log_{10}y&=\\log_{10}10+\\log_{10}x\\\\\\log_{10}y&=\\log_{10}(10x)\\\\y&=10x\\end{align*}$$\nHere $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{10}(y+1)=2+\\log_{10}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=100x-1$",
          "worked": "$$\\begin{align*}\\log_{10}(y+1)&=\\log_{10}100+\\log_{10}x\\\\\\log_{10}(y+1)&=\\log_{10}(100x)\\\\y+1&=100x\\\\y&=100x-1\\end{align*}$$\nHere $x>0$, so $y+1>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
