  "content": {
    "id": "p31-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Work out the value of each of these expressions when $a=5$",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$10a+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$53$",
          "worked": "$$\\begin{align*}10a+3&=10(5)+3\\\\10a+3&=50+3\\\\10a+3&=53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p31-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{10}{a}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\frac{10}{a}+3&=\\frac{10}{5}+3\\\\\\frac{10}{a}+3&=2+3\\\\\\frac{10}{a}+3&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$10a-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$47$",
          "worked": "$$\\begin{align*}10a-3&=10(5)-3\\\\10a-3&=50-3\\\\10a-3&=47\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p31-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a}{10}+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.5$",
          "worked": "$$\\begin{align*}\\frac{a}{10}+3&=\\frac{5}{10}+3\\\\\\frac{a}{10}+3&=0.5+3\\\\\\frac{a}{10}+3&=3.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$10(a+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80$",
          "worked": "$$\\begin{align*}10(a+3)&=10(5+3)\\\\10(a+3)&=10(8)\\\\10(a+3)&=80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{10}{a+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{4}$",
          "worked": "$$\\begin{align*}\\frac{10}{a+3}&=\\frac{10}{5+3}\\\\\\frac{10}{a+3}&=\\frac{10}{8}\\\\\\frac{10}{a+3}&=\\frac{5}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p31-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$10(a-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "$$\\begin{align*}10(a-3)&=10(5-3)\\\\10(a-3)&=10(2)\\\\10(a-3)&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p31-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$3+\\dfrac{a}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.5$",
          "worked": "$$\\begin{align*}3+\\frac{a}{10}&=3+\\frac{5}{10}\\\\3+\\frac{a}{10}&=3+0.5\\\\3+\\frac{a}{10}&=3.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{10-a}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{3}$",
          "worked": "$$\\begin{align*}\\frac{10-a}{3}&=\\frac{10-5}{3}\\\\\\frac{10-a}{3}&=\\frac{5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$10-\\dfrac{3}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{47}{5}$",
          "worked": "$$\\begin{align*}10-\\frac{3}{a}&=10-\\frac{3}{5}\\\\10-\\frac{3}{a}&=\\frac{50}{5}-\\frac{3}{5}\\\\10-\\frac{3}{a}&=\\frac{47}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p31-q7-k",
        "type": "part",
        "label": "k",
        "prompt": "$3+\\dfrac{10}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}3+\\frac{10}{a}&=3+\\frac{10}{5}\\\\3+\\frac{10}{a}&=3+2\\\\3+\\frac{10}{a}&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p31-q7-l",
        "type": "part",
        "label": "l",
        "prompt": "$3-\\dfrac{10}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}3-\\frac{10}{a}&=3-\\frac{10}{5}\\\\3-\\frac{10}{a}&=3-2\\\\3-\\frac{10}{a}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
