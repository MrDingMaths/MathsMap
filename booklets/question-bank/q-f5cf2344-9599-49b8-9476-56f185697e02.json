        "answer": {
          "short": "$h=3\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\sin60^\\circ&=\\frac{h}{6}\\\\h&=6\\times\\frac{\\sqrt3}{2}\\\\h&=3\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-bc79b7-p5-practice-j12-220610-j12-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the exact value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3\\sqrt{6}$",
          "worked": "$$\\begin{align*}\\sin45^\\circ&=\\frac{h}{x}\\\\\\frac{1}{\\sqrt2}&=\\frac{3\\sqrt3}{x}\\\\x&=3\\sqrt3\\times\\sqrt2\\\\x&=3\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
