    "label": "4",
    "prompt": "Find $x$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt7\\,x+3=\\sqrt2\\,x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac{3(\\sqrt7+\\sqrt2)}5$",
          "worked": "$$\\begin{align*}\\sqrt7\\,x-\\sqrt2\\,x&=-3\\\\(\\sqrt7-\\sqrt2)x&=-3\\\\x&=\\frac{-3}{\\sqrt7-\\sqrt2}\\\\x&=\\frac{-3(\\sqrt7+\\sqrt2)}{7-2}\\\\x&=-\\frac{3(\\sqrt7+\\sqrt2)}5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt3\\,x+4=x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{\\sqrt3+1}2$",
          "worked": "$$\\begin{align*}\\sqrt3\\,x-x&=1\\\\(\\sqrt3-1)x&=1\\\\x&=\\frac1{\\sqrt3-1}\\\\x&=\\frac{\\sqrt3+1}{3-1}\\\\x&=\\frac{\\sqrt3+1}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt6\\,x+5=\\sqrt5\\,x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\sqrt6+2\\sqrt5$",
          "worked": "$$\\begin{align*}\\sqrt6\\,x-\\sqrt5\\,x&=2\\\\(\\sqrt6-\\sqrt5)x&=2\\\\x&=\\frac2{\\sqrt6-\\sqrt5}\\\\x&=\\frac{2(\\sqrt6+\\sqrt5)}{6-5}\\\\x&=2\\sqrt6+2\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt6\\,x-6=\\sqrt5\\,x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\sqrt6-\\sqrt5$",
          "worked": "$$\\begin{align*}\\sqrt6\\,x-\\sqrt5\\,x&=-1\\\\(\\sqrt6-\\sqrt5)x&=-1\\\\x&=\\frac{-1}{\\sqrt6-\\sqrt5}\\\\x&=\\frac{-(\\sqrt6+\\sqrt5)}{6-5}\\\\x&=-\\sqrt6-\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
