    "type": "question",
    "label": "11",
    "prompt": "Find the value of $k$ if $k>0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\int_k^3 2\\,dx=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=1$",
          "worked": "$$\\begin{align*}[2x]_k^3&=4\\\\6-2k&=4\\\\2k&=2\\\\k&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\int_k^8 3\\,dx=12$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4$",
          "worked": "$$\\begin{align*}[3x]_k^8&=12\\\\24-3k&=12\\\\3k&=12\\\\k&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\int_2^3(k-3)\\,dx=5$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=8$",
          "worked": "$$\\begin{align*}[(k-3)x]_2^3&=5\\\\3(k-3)-2(k-3)&=5\\\\k-3&=5\\\\k&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\int_3^k(x-3)\\,dx=0$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "$$\\begin{align*}\\left[\\frac{x^2}{2}-3x\\right]_3^k&=0\\\\\\frac{k^2}{2}-3k-\\left(\\frac92-9\\right)&=0\\\\k^2-6k+9&=0\\\\(k-3)^2&=0\\\\k&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p33-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\int_1^k(x+1)\\,dx=6$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "$$\\begin{align*}\\left[\\frac{x^2}{2}+x\\right]_1^k&=6\\\\\\frac{k^2}{2}+k-\\left(\\frac12+1\\right)&=6\\\\k^2+2k-15&=0\\\\(k+5)(k-3)&=0\\\\k&=-5\\text{ or }3\\end{align*}$$\nSince $k>0$, $k=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p33-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\int_1^k(k+3x)\\,dx=\\frac{13}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=2$",
          "worked": "$$\\begin{align*}\\left[kx+\\frac{3x^2}{2}\\right]_1^k&=\\frac{13}{2}\\\\k^2+\\frac{3k^2}{2}-\\left(k+\\frac32\\right)&=\\frac{13}{2}\\\\5k^2-2k-3&=13\\\\5k^2-2k-16&=0\\\\(5k+8)(k-2)&=0\\\\k&=-\\frac85\\text{ or }2\\end{align*}$$\nSince $k>0$, $k=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
