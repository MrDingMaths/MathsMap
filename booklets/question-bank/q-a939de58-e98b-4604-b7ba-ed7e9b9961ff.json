  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The angle of elevation from a point on a horizontal surface to the top of a vertical pole 20 m away is $35^\\circ$. Find the height of the pole, correct to the nearest metre.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14\\text{ m}$.",
      "worked": "Let the height of the pole be $h$ metres. The horizontal distance to its base is 20 m.\n\n$$\\begin{align*}\\tan35^\\circ&=\\frac{h}{20}\\\\h&=20\\tan35^\\circ\\\\h&\\approx14\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
