  "content": {
    "id": "p49-q10",
    "type": "question",
    "label": "10",
    "prompt": "In a science experiment, 40 g of Chemical A is mixed with 85 g of Chemical B.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q10-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "8db4701f-b258-48bc-8ae1-bb76419bc7b7",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Jimmy calculated the percentage of Chemical A in the mixture as 47.06%. ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Explain why he is incorrect.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jimmy used $\\frac{40}{85}$ instead of $\\frac{40}{125}$. The denominator must be the total mass of the mixture, so Chemical A is $32\\%$ of the mixture.",
          "worked": "Jimmy compared Chemical A with Chemical B instead of the whole mixture.\n\n$$\\begin{align*}\\text{Total mass} &= 40+85\\\\&=125\\text{ g}\\\\\\text{Percentage of Chemical A} &= \\frac{40}{125}\\times100\\\\&=32\\%\\end{align*}$$\n\nThe denominator must be $125$, not $85$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p49-q10-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "a384bc3b-0299-4884-8cd8-cc5d50adf09f",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Another 40 g of Chemical A is added to the original mixture. ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "What percentage of the mixture is now Chemical A? Give your answer to 2 decimal places.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48.48\\%$",
          "worked": "$$\\begin{aligned}\\text{Chemical A}&=40+40=80\\text{ g}\\\\\\text{Total mass}&=80+85=165\\text{ g}\\\\\\text{Percentage of A}&=\\frac{80}{165}\\times100\\%\\\\&\\approx48.48\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Then another 85 g of Chemical B is added. What percentage of the mixture is now Chemical A?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32\\%$",
          "worked": "$$\\begin{aligned}\\text{Chemical B}&=85+85=170\\text{ g}\\\\\\text{Total mass}&=80+170=250\\text{ g}\\\\\\text{Percentage of A}&=\\frac{80}{250}\\times100\\%=32\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p49-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why the percentage in part c equals the original percentage.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both chemical amounts have doubled, so Chemical A remains the same fraction of the total.",
          "worked": "Both amounts have doubled: $40:85=80:170$. The total mass also doubles, so $\\frac{40}{125}=\\frac{80}{250}=32\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
