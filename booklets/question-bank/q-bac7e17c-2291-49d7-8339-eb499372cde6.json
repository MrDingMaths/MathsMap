  "content": {
    "id": "p3-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Square the polynomial $P(x)=2x^3+x-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4x^6+4x^4-8x^3+x^2-4x+4$",
      "worked": "$$\\begin{align*}\\bigl[P(x)\\bigr]^2&=(2x^3+x-2)(2x^3+x-2)\\\\\\bigl[P(x)\\bigr]^2&=4x^6+2x^4-4x^3+2x^4+x^2-2x-4x^3-2x+4\\\\\\bigl[P(x)\\bigr]^2&=4x^6+4x^4-8x^3+x^2-4x+4\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
