        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ km/h}$",
          "worked": "$$\\begin{aligned}\\text{Rate of change}&=\\frac{100}{4}\\\\&=25\\text{ km/h}\\end{aligned}$$",
