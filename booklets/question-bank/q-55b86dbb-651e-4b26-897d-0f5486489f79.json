  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Expand and simplify the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{1}{2}(x+4)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{2}+2$",
          "worked": "$$\\begin{align*}\\frac{1}{2}(x+4)&=\\frac{x}{2}+\\frac{4}{2}\\\\&=\\frac{x}{2}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p21-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2}{3}(y-3)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2y}{3}-2$",
          "worked": "$$\\begin{align*}\\frac{2}{3}(y-3)&=\\frac{2y}{3}-\\frac{6}{3}\\\\&=\\frac{2y}{3}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p21-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{3}{4}(2a+4b)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3a}{2}+3b$",
          "worked": "$$\\begin{align*}\\frac{3}{4}(2a+4b)&=\\frac{6a}{4}+\\frac{12b}{4}\\\\&=\\frac{3a}{2}+3b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p21-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{1}{2}(6x+8)+\\frac{1}{3}(12x-3)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x+3$",
          "worked": "$$\\begin{align*}\\frac{1}{2}(6x+8)+\\frac{1}{3}(12x-3)&=3x+4+4x-1\\\\&=7x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{2}{3}(12y-6)+\\frac{1}{4}(2y+3)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17y}{2}-\\frac{13}{4}$",
          "worked": "$$\\begin{align*}\\frac{2}{3}(12y-6)+\\frac{1}{4}(2y+3)&=8y-4+\\frac{y}{2}+\\frac{3}{4}\\\\&=\\frac{16y+y}{2}+\\frac{-16+3}{4}\\\\&=\\frac{17y}{2}-\\frac{13}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p21-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{x}{3}(6+9y)+y(x+4)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+4xy+4y$",
          "worked": "$$\\begin{align*}\\frac{x}{3}(6+9y)+y(x+4)&=2x+3xy+xy+4y\\\\&=2x+4xy+4y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
