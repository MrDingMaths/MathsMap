  "content": {
    "id": "p26-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Identify the first term $a$ and ratio $r$ of each GP and hence find $S_\\infty$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q3a",
        "type": "part",
        "label": "a",
        "prompt": "$8+4+2+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=8,\\ r=\\frac12;\\quad S_\\infty=16$",
          "worked": "$$\\begin{align*}a&=8\\\\r&=\\frac48=\\frac12\\\\S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{8}{1-\\frac12}\\\\S_\\infty&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p26-q3b",
        "type": "part",
        "label": "b",
        "prompt": "$-4-2-1-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-4,\\ r=\\frac12;\\quad S_\\infty=-8$",
          "worked": "$$\\begin{align*}a&=-4\\\\r&=\\frac{-2}{-4}=\\frac12\\\\S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{-4}{1-\\frac12}\\\\S_\\infty&=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p26-q3c",
        "type": "part",
        "label": "c",
        "prompt": "$1-\\frac13+\\frac19-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1,\\ r=-\\frac13;\\quad S_\\infty=\\frac34$",
          "worked": "$$\\begin{align*}a&=1\\\\r&=\\frac{-\\frac13}{1}=-\\frac13\\\\S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{1}{1-(-\\frac13)}\\\\S_\\infty&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q3d",
        "type": "part",
        "label": "d",
        "prompt": "$36-12+4-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=36,\\ r=-\\frac13;\\quad S_\\infty=27$",
          "worked": "$$\\begin{align*}a&=36\\\\r&=\\frac{-12}{36}=-\\frac13\\\\S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{36}{1-(-\\frac13)}\\\\S_\\infty&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q3e",
        "type": "part",
        "label": "e",
        "prompt": "$60-30+15-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=60,\\ r=-\\frac12;\\quad S_\\infty=40$",
          "worked": "$$\\begin{align*}a&=60\\\\r&=\\frac{-30}{60}=-\\frac12\\\\S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{60}{1-(-\\frac12)}\\\\S_\\infty&=40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p26-q3f",
        "type": "part",
        "label": "f",
        "prompt": "$60-12+2\\frac25-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=60,\\ r=-\\frac15;\\quad S_\\infty=50$",
          "worked": "$$\\begin{align*}a&=60\\\\r&=\\frac{-12}{60}=-\\frac15\\\\S_\\infty&=\\frac{a}{1-r}\\\\S_\\infty&=\\frac{60}{1-(-\\frac15)}\\\\S_\\infty&=50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
