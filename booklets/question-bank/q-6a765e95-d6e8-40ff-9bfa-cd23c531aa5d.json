  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The formula for the sum $S$ of the interior angles in a convex $n$-sided polygon is $S=180(n-2)$. Rearrange the formula to make $n$ the subject and use this to find the number of sides in the polygon if the sum of the interior angles is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q6-rearrange",
        "type": "part",
        "label": "a",
        "prompt": "Make $n$ the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{S}{180}+2$",
          "worked": "$$\\begin{align*}S&=180(n-2)\\\\\\frac{S}{180}&=n-2\\\\n&=\\frac{S}{180}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
