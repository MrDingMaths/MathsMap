  "content": {
    "id": "p7-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{10}25+\\log_{10}4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{10}25+\\log_{10}4&=\\log_{10}(25\\times4)\\\\\\log_{10}25+\\log_{10}4&=\\log_{10}100\\\\\\log_{10}25+\\log_{10}4&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 48-\\log_2 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\log_2 48-\\log_2 6&=\\log_2\\frac{48}{6}\\\\\\log_2 48-\\log_2 6&=\\log_2 8\\\\\\log_2 48-\\log_2 6&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 12-\\log_2 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_2 12-\\log_2 3&=\\log_2\\frac{12}{3}\\\\\\log_2 12-\\log_2 3&=\\log_2 4\\\\\\log_2 12-\\log_2 3&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_8 32+\\log_8 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_8 32+\\log_8 2&=\\log_8(32\\times2)\\\\\\log_8 32+\\log_8 2&=\\log_8 64\\\\\\log_8 32+\\log_8 2&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\log_{10}25+2\\log_{10}40$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}2\\log_{10}25+2\\log_{10}40&=2\\log_{10}(25\\times40)\\\\2\\log_{10}25+2\\log_{10}40&=2\\log_{10}1000\\\\2\\log_{10}25+2\\log_{10}40&=2\\times3\\\\2\\log_{10}25+2\\log_{10}40&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\log_3 2+\\log_3 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 16$",
          "worked": "$$\\begin{align*}2\\log_3 2+\\log_3 4&=\\log_3 2^2+\\log_3 4\\\\2\\log_3 2+\\log_3 4&=\\log_3(4\\times4)\\\\2\\log_3 2+\\log_3 4&=\\log_3 16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$3\\log_4 3-\\log_4 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4 3$",
          "worked": "$$\\begin{align*}3\\log_4 3-\\log_4 9&=\\log_4 27-\\log_4 9\\\\3\\log_4 3-\\log_4 9&=\\log_4\\frac{27}{9}\\\\3\\log_4 3-\\log_4 9&=\\log_4 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac13\\log_6 27+\\log_6 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac13\\log_6 27+\\log_6 12&=\\log_6\\sqrt[3]{27}+\\log_6 12\\\\\\frac13\\log_6 27+\\log_6 12&=\\log_6(3\\times12)\\\\\\frac13\\log_6 27+\\log_6 12&=\\log_6 36\\\\\\frac13\\log_6 27+\\log_6 12&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac12\\log_3 4+\\log_3 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 4$",
          "worked": "$$\\begin{align*}\\frac12\\log_3 4+\\log_3 2&=\\log_3\\sqrt4+\\log_3 2\\\\\\frac12\\log_3 4+\\log_3 2&=\\log_3(2\\times2)\\\\\\frac12\\log_3 4+\\log_3 2&=\\log_3 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_2 9+2\\log_2 4-2\\log_2 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\log_2 9+2\\log_2 4-2\\log_2 3&=\\log_2 9+\\log_2 16-\\log_2 9\\\\\\log_2 9+2\\log_2 4-2\\log_2 3&=\\log_2\\frac{9\\times16}{9}\\\\\\log_2 9+2\\log_2 4-2\\log_2 3&=\\log_2 16\\\\\\log_2 9+2\\log_2 4-2\\log_2 3&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{\\log_2 36}{\\log_2 6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{\\log_2 36}{\\log_2 6}&=\\frac{\\log_2 6^2}{\\log_2 6}\\\\\\frac{\\log_2 36}{\\log_2 6}&=\\frac{2\\log_2 6}{\\log_2 6}\\\\\\frac{\\log_2 36}{\\log_2 6}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{\\log_3 16}{\\log_3 2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{\\log_3 16}{\\log_3 2}&=\\frac{\\log_3 2^4}{\\log_3 2}\\\\\\frac{\\log_3 16}{\\log_3 2}&=\\frac{4\\log_3 2}{\\log_3 2}\\\\\\frac{\\log_3 16}{\\log_3 2}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
