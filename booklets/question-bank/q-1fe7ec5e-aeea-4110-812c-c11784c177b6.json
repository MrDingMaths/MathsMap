  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Given that for two events $A$ and $B$, $P(A)=0.2$, $P(B)=0.6$ and $P(A\\cup B)=0.7$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\mid B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$$\\begin{align*}P(A\\cap B)&=P(A)+P(B)-P(A\\cup B)\\\\P(A\\cap B)&=0.2+0.6-0.7\\\\P(A\\cap B)&=0.1\\end{align*}$$\n$$\\begin{align*}P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\P(A\\mid B)&=\\frac{0.1}{0.6}\\\\P(A\\mid B)&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p20-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(B\\mid A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Since $P(B\\cap A)=P(A\\cap B)=0.1$,\n$$\\begin{align*}P(B\\mid A)&=\\frac{P(B\\cap A)}{P(A)}\\\\P(B\\mid A)&=\\frac{0.1}{0.2}\\\\P(B\\mid A)&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
