    "type": "question",
    "label": "",
    "prompt": "If $x=3t^2-t$ and $\\dfrac{dt}{du}=6$, evaluate $\\dfrac{dx}{du}$ when $t=12$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$426$",
      "worked": "Variables: $x,t,u$.\n$$\\begin{aligned}\\frac{dx}{du}&=\\frac{dx}{dt}\\times\\frac{dt}{du}\\\\\\frac{dx}{du}&=(6t-1)\\times6\\end{aligned}$$\nAt $t=12$:\n$$\\begin{aligned}\\frac{dx}{du}&=(6(12)-1)\\times6\\\\\\frac{dx}{du}&=426\\end{aligned}$$",
      "solutionDiagrams": []
    },
