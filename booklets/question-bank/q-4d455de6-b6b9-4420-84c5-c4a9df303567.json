  "content": {
    "id": "p27-q18-23-root",
    "type": "question",
    "label": "",
    "prompt": "Differentiate the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q18-23-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sqrt{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1}{\\sqrt{2x-1}}$",
          "worked": "$y=(2x-1)^{\\frac12}$. \n\n$$\\begin{align*}y'&=\\frac12(2x-1)^{-\\frac12}\\times2\\\\y'&=\\dfrac{1}{\\sqrt{2x-1}}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q18-23-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{x}{\\sqrt{1-x^2}}$",
          "worked": "$y=(1-x^2)^{\\frac12}$. \n\n$$\\begin{align*}y'&=\\frac12(1-x^2)^{-\\frac12}\\times(-2x)\\\\y'&=-\\dfrac{x}{\\sqrt{1-x^2}}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q18-23-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\sqrt{4+x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x}{\\sqrt{4+x^2}}$",
          "worked": "$y=(4+x^2)^{\\frac12}$. \n\n$$\\begin{align*}y'&=\\frac12(4+x^2)^{-\\frac12}\\times2x\\\\y'&=\\dfrac{x}{\\sqrt{4+x^2}}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q18-23-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{1}{\\sqrt{2x+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{1}{\\sqrt{(2x+1)^3}}$",
          "worked": "$y=(2x+1)^{-\\frac12}$. \n\n$$\\begin{align*}y'&=-\\frac12(2x+1)^{-\\frac32}\\times2\\\\y'&=-(2x+1)^{-\\frac32}\\\\y'&=-\\dfrac{1}{\\sqrt{(2x+1)^3}}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p27-q18-23-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{1}{(x+x^2)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{3(1+2x)}{(x+x^2)^4}$",
          "worked": "$y=(x+x^2)^{-3}$. \n\n$$\\begin{align*}y'&=-3(x+x^2)^{-4}\\times(1+2x)\\\\y'&=-\\dfrac{3(1+2x)}{(x+x^2)^4}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p27-q18-23-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{1}{\\sqrt{3x^2-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{3x}{(3x^2-1)^{3/2}}$",
          "worked": "$y=(3x^2-1)^{-\\frac12}$. \n\n$$\\begin{align*}y'&=-\\frac12(3x^2-1)^{-\\frac32}\\times6x\\\\y'&=-3x(3x^2-1)^{-\\frac32}\\\\y'&=-\\dfrac{3x}{(3x^2-1)^{3/2}}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
