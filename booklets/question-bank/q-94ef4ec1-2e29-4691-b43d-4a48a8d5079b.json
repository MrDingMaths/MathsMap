  "content": {
    "id": "p4-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $p(x)=x^2-2x-3$. Determine the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$p(0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}p(0)&=0^2-2\\times0-3\\\\p(0)&=0-0-3\\\\p(0)&=-3\\end{align*}$$",
          "solutionDiagrams": []
