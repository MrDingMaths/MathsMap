        "answer": {
          "short": "$y'=5(x-10)^3(x-2)$",
          "worked": "$$\\begin{align*}u&=x,&u'&=1\\\\v&=(x-10)^4,&v'&=4(x-10)^3\\end{align*}$$\n$$\\begin{align*}y'&=u'v+uv'\\\\y'&=(x-10)^4+4x(x-10)^3\\\\y'&=(x-10)^3[(x-10)+4x]\\\\y'&=5(x-10)^3(x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
