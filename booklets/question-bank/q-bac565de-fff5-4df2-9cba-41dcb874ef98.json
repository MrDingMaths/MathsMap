        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Five-number summary (minutes): $27,30,38,42,48$.",
          "worked": "The minimum is 27 minutes and the maximum is 48 minutes. Use $Q_1=30$, median $38$ and $Q_3=42$ minutes. Draw the box from 30 to 42, mark the median at 38, and extend the whiskers to 27 and 48 on a labelled time scale.",
          "solutionDiagrams": [
            {
              "id": "p11-q4-c-boxplot",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 11 question 4c\"}\n\\begin{tikzpicture}[x=0.36cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[line width=0.5pt,->] (24,0)--(51,0);\n\\foreach \\x in {25,30,35,40,45,50}{\\draw[line width=0.4pt] (\\x,0)--(\\x,-0.1) node[below,font=\\fontsize{8.5}{10}\\selectfont]{\\x};}\n\\node[below,font=\\fontsize{10}{12}\\selectfont] at (37.5,-1.4){Time (minutes)};\n\\draw[line width=0.8pt] (27,0.8)--(30,0.8) (42,0.8)--(48,0.8);\n\\draw[line width=0.8pt] (30,0.5) rectangle (42,1.1);\n\\draw[line width=0.8pt] (38,0.5)--(38,1.1);\n\\end{tikzpicture}",
              "src": null,
