  "content": {
    "id": "p14-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve by completing the square:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+3x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-3\\pm\\sqrt{21}}2$",
          "worked": "$$\\begin{align*}x^2+3x&=3\\\\x^2+3x+\\frac94&=3+\\frac94\\\\\\left(x+\\frac32\\right)^2&=\\frac{21}4\\\\x+\\frac32&=\\pm\\frac{\\sqrt{21}}2\\\\x&=\\frac{-3\\pm\\sqrt{21}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-5x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5\\pm\\sqrt{21}}2$",
          "worked": "$$\\begin{align*}x^2-5x&=-1\\\\x^2-5x+\\frac{25}4&=-1+\\frac{25}4\\\\\\left(x-\\frac52\\right)^2&=\\frac{21}4\\\\x-\\frac52&=\\pm\\frac{\\sqrt{21}}2\\\\x&=\\frac{5\\pm\\sqrt{21}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p14-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1\\pm\\sqrt{13}}2$",
          "worked": "$$\\begin{align*}x^2+x&=3\\\\x^2+x+\\frac14&=3+\\frac14\\\\\\left(x+\\frac12\\right)^2&=\\frac{13}4\\\\x+\\frac12&=\\pm\\frac{\\sqrt{13}}2\\\\x&=\\frac{-1\\pm\\sqrt{13}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p14-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$-x^2-3x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-3\\pm\\sqrt{13}}2$",
          "worked": "$$\\begin{align*}x^2+3x-1&=0\\\\x^2+3x&=1\\\\x^2+3x+\\frac94&=1+\\frac94\\\\\\left(x+\\frac32\\right)^2&=\\frac{13}4\\\\x+\\frac32&=\\pm\\frac{\\sqrt{13}}2\\\\x&=\\frac{-3\\pm\\sqrt{13}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 61
      },
      {
        "id": "p14-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$-x^2-5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-5\\pm\\sqrt{33}}2$",
          "worked": "$$\\begin{align*}x^2+5x-2&=0\\\\x^2+5x&=2\\\\x^2+5x+\\frac{25}4&=2+\\frac{25}4\\\\\\left(x+\\frac52\\right)^2&=\\frac{33}4\\\\x+\\frac52&=\\pm\\frac{\\sqrt{33}}2\\\\x&=\\frac{-5\\pm\\sqrt{33}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 61
      },
      {
        "id": "p14-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$-x^2+3x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3\\pm\\sqrt{17}}2$",
          "worked": "$$\\begin{align*}x^2-3x-2&=0\\\\x^2-3x&=2\\\\x^2-3x+\\frac94&=2+\\frac94\\\\\\left(x-\\frac32\\right)^2&=\\frac{17}4\\\\x-\\frac32&=\\pm\\frac{\\sqrt{17}}2\\\\x&=\\frac{3\\pm\\sqrt{17}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 61
      },
      {
        "id": "p14-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$3x^2+2x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1\\pm\\sqrt{10}}3$",
          "worked": "$$\\begin{align*}x^2+\\frac23x-1&=0\\\\x^2+\\frac23x&=1\\\\x^2+\\frac23x+\\frac19&=1+\\frac19\\\\\\left(x+\\frac13\\right)^2&=\\frac{10}9\\\\x+\\frac13&=\\pm\\frac{\\sqrt{10}}3\\\\x&=\\frac{-1\\pm\\sqrt{10}}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      },
      {
        "id": "p14-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$4x^2+4x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1\\pm\\sqrt2}2$",
          "worked": "$$\\begin{align*}x^2+x-\\frac14&=0\\\\x^2+x&=\\frac14\\\\x^2+x+\\frac14&=\\frac14+\\frac14\\\\\\left(x+\\frac12\\right)^2&=\\frac12\\\\x+\\frac12&=\\pm\\frac{\\sqrt2}2\\\\x&=\\frac{-1\\pm\\sqrt2}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      },
      {
        "id": "p14-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$2x^2-x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac12,\\ 1$",
          "worked": "$$\\begin{align*}x^2-\\frac12x-\\frac12&=0\\\\x^2-\\frac12x&=\\frac12\\\\x^2-\\frac12x+\\frac1{16}&=\\frac12+\\frac1{16}\\\\\\left(x-\\frac14\\right)^2&=\\frac9{16}\\\\x-\\frac14&=\\pm\\frac34\\\\x&=\\frac14\\pm\\frac34\\\\x&=-\\frac12,\\ 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 71
      },
      {
        "id": "p14-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$4x^2+2x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1\\pm\\sqrt5}4$",
          "worked": "$$\\begin{align*}x^2+\\frac12x-\\frac14&=0\\\\x^2+\\frac12x&=\\frac14\\\\x^2+\\frac12x+\\frac1{16}&=\\frac14+\\frac1{16}\\\\\\left(x+\\frac14\\right)^2&=\\frac5{16}\\\\x+\\frac14&=\\pm\\frac{\\sqrt5}4\\\\x&=\\frac{-1\\pm\\sqrt5}4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      },
      {
        "id": "p14-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$3x^2+5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ -\\frac23$",
          "worked": "$$\\begin{align*}x^2+\\frac53x+\\frac23&=0\\\\x^2+\\frac53x&=-\\frac23\\\\x^2+\\frac53x+\\frac{25}{36}&=-\\frac23+\\frac{25}{36}\\\\\\left(x+\\frac56\\right)^2&=\\frac1{36}\\\\x+\\frac56&=\\pm\\frac16\\\\x&=-\\frac56\\pm\\frac16\\\\x&=-1,\\ -\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 71
      },
      {
        "id": "p14-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$2x^2+3x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-3\\pm\\sqrt{41}}4$",
          "worked": "$$\\begin{align*}x^2+\\frac32x-2&=0\\\\x^2+\\frac32x&=2\\\\x^2+\\frac32x+\\frac9{16}&=2+\\frac9{16}\\\\\\left(x+\\frac34\\right)^2&=\\frac{41}{16}\\\\x+\\frac34&=\\pm\\frac{\\sqrt{41}}4\\\\x&=\\frac{-3\\pm\\sqrt{41}}4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 63
      }
    ]
  },
