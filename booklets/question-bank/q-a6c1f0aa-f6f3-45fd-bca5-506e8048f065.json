  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x+2}{2}+\\frac{x+4}{3}=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$$\\begin{align*}\\frac{3(x+2)}{6}+\\frac{2(x+4)}{6}&=4\\\\\\frac{3x+6+2x+8}{6}&=4\\\\\\frac{5x+14}{6}&=4\\\\5x+14&=24\\\\5x&=10\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x+2}{2}+\\frac{x+4}{8}=4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}\\frac{4(x+2)}{8}+\\frac{x+4}{8}&=4\\\\\\frac{4x+8+x+4}{8}&=4\\\\\\frac{5x+12}{8}&=4\\\\5x+12&=32\\\\5x&=20\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x+2}{2}+\\frac{x+4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=12$",
          "worked": "$$\\begin{align*}\\frac{4(x+2)}{8}+\\frac{x+4}{8}&=9\\\\\\frac{4x+8+x+4}{8}&=9\\\\\\frac{5x+12}{8}&=9\\\\5x+12&=72\\\\5x&=60\\\\x&=12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{x+2}{6}+\\frac{x+4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=28$",
          "worked": "$$\\begin{align*}\\frac{4(x+2)}{24}+\\frac{3(x+4)}{24}&=9\\\\\\frac{4x+8+3x+12}{24}&=9\\\\\\frac{7x+20}{24}&=9\\\\7x+20&=216\\\\7x&=196\\\\x&=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{x+2}{6}-\\frac{x+4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=220$",
          "worked": "$$\\begin{align*}\\frac{4(x+2)}{24}-\\frac{3(x+4)}{24}&=9\\\\\\frac{4x+8-3x-12}{24}&=9\\\\\\frac{x-4}{24}&=9\\\\x-4&=216\\\\x&=220\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{x+2}{6}-\\frac{x-4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=196$",
          "worked": "$$\\begin{align*}\\frac{4(x+2)}{24}-\\frac{3(x-4)}{24}&=9\\\\\\frac{4x+8-3x+12}{24}&=9\\\\\\frac{x+20}{24}&=9\\\\x+20&=216\\\\x&=196\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{x-2}{6}-\\frac{x-4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=212$",
          "worked": "$$\\begin{align*}\\frac{4(x-2)}{24}-\\frac{3(x-4)}{24}&=9\\\\\\frac{4x-8-3x+12}{24}&=9\\\\\\frac{x+4}{24}&=9\\\\x+4&=216\\\\x&=212\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{2x-2}{6}-\\frac{2x-4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=106$",
          "worked": "$$\\begin{align*}\\frac{4(2x-2)}{24}-\\frac{3(2x-4)}{24}&=9\\\\\\frac{8x-8-6x+12}{24}&=9\\\\\\frac{2x+4}{24}&=9\\\\2x+4&=216\\\\2x&=212\\\\x&=106\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{4x-2}{6}-\\frac{4x-4}{8}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=53$",
          "worked": "$$\\begin{align*}\\frac{4(4x-2)}{24}-\\frac{3(4x-4)}{24}&=9\\\\\\frac{16x-8-12x+12}{24}&=9\\\\\\frac{4x+4}{24}&=9\\\\4x+4&=216\\\\4x&=212\\\\x&=53\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac{4x-4}{8}-\\frac{4x-2}{6}=9$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-55$",
          "worked": "$$\\begin{align*}\\frac{3(4x-4)}{24}-\\frac{4(4x-2)}{24}&=9\\\\\\frac{12x-12-16x+8}{24}&=9\\\\\\frac{-4x-4}{24}&=9\\\\-4x-4&=216\\\\-4x&=220\\\\x&=-55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\frac{4x-4}{8}-\\frac{4x-2}{6}=1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7$",
          "worked": "$$\\begin{align*}\\frac{3(4x-4)}{24}-\\frac{4(4x-2)}{24}&=1\\\\\\frac{12x-12-16x+8}{24}&=1\\\\\\frac{-4x-4}{24}&=1\\\\-4x-4&=24\\\\-4x&=28\\\\x&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p10-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\frac{4x-4}{8}-\\frac{4x-2}{6}=\\frac{1}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$$\\begin{align*}\\frac{3(4x-4)}{24}-\\frac{4(4x-2)}{24}&=\\frac{1}{2}\\\\\\frac{12x-12-16x+8}{24}&=\\frac{1}{2}\\\\\\frac{-4x-4}{24}&=\\frac{1}{2}\\\\-4x-4&=12\\\\-4x&=16\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
