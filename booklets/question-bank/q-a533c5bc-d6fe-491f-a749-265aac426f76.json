      {
        "id": "p7-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "If $a=5$, find the length of $BC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$B$ and $C$ have the same $y$-coordinate, so\n$$\\begin{align*}BC&=5-2\\\\BC&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q11-b",
        "type": "group",
        "label": "b",
        "prompt": "Find, in terms of $a$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the length $BC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a-2$",
              "worked": "$BC$ is horizontal and $a>2$, so\n$$BC=a-2.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p7-q11-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the coordinates of the point $D$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(a-2,1)$",
              "worked": "Opposite sides of a parallelogram are equal and parallel. From $A$, move $a-2$ units horizontally to reach $D$:\n$$D=(a-2,1).$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p7-q11-c",
        "type": "group",
        "label": "c",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-c-i",
            "type": "part",
            "label": "i",
            "prompt": "Find the gradient of the line $AC$ in terms of $a$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{2}{a}$",
              "worked": "$$\\begin{align*}m_{AC}&=\\frac{3-1}{a-0}\\\\m_{AC}&=\\frac{2}{a}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p7-q11-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find the gradient of the line $BD$ in terms of $a$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{2}{4-a}$ for $a\\ne4$; undefined when $a=4$.",
              "worked": "$$\\begin{align*}m_{BD}&=\\frac{1-3}{(a-2)-2}\\\\m_{BD}&=\\frac{-2}{a-4}\\\\m_{BD}&=\\frac{2}{4-a}.\\end{align*}$$\nWhen $a=4$, $B$ and $D$ both have $x$-coordinate $2$, so $BD$ is vertical and its gradient is undefined.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p7-q11-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Show that when $a=5$, the gradient of the line $BD$ is $-2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m_{BD}=\\dfrac{2}{4-5}=-2$.",
              "worked": "$$\\begin{align*}m_{BD}&=\\frac{2}{4-5}\\\\m_{BD}&=\\frac{2}{-1}\\\\m_{BD}&=-2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p7-q11-d",
        "type": "group",
        "label": "d",
        "prompt": "For $a=5$, find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-d-i",
            "type": "part",
            "label": "i",
            "prompt": "the gradient of the line $AC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac25$",
              "worked": "$$\\begin{align*}m_{AC}&=\\frac{2}{a}\\\\m_{AC}&=\\frac25.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p7-q11-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the equation of the line $AC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac25x+1$",
              "worked": "Using $A=(0,1)$ and $m_{AC}=\\frac25$:\n$$\\begin{align*}y-1&=\\frac25(x-0)\\\\y&=\\frac25x+1.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p7-q11-d-iii",
            "type": "part",
            "label": "iii",
            "prompt": "algebraically, the coordinates of the intersection point of the line $AC$ with the line $BD$, given that the equation of the line $BD$ is $y=-2x+7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\left(\\dfrac52,2\\right)$\n\nEquate the two expressions for $y$ and solve for $x$, then substitute.",
              "worked": "At the intersection, the two expressions for $y$ are equal:\n$$\\begin{align*}\\frac25x+1&=-2x+7\\\\\\frac{12}{5}x&=6\\\\x&=6\\times\\frac5{12}\\\\x&=\\frac52.\\end{align*}$$\nSubstitute into $y=\\frac25x+1$:\n$$\\begin{align*}y&=\\frac25\\times\\frac52+1\\\\y&=2.\\end{align*}$$\nCheck in $BD$: $-2\\times\\frac52+7=2$.\nThe intersection is $\\left(\\frac52,2\\right)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 60
          }
        ]
      },
      {
        "id": "p7-q11-e",
        "type": "group",
        "label": "e",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q11-e-i",
            "type": "part",
            "label": "i",
            "prompt": "Find the length of $AC$ in terms of $a$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{a^2+4}$",
              "worked": "Using the coordinate differences between $A=(0,1)$ and $C=(a,3)$:\n$$\\begin{align*}AC&=\\sqrt{(a-0)^2+(3-1)^2}\\\\AC&=\\sqrt{a^2+4}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p7-q11-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find the exact value of $a$ (as a surd in simplest form) so that $AC=7$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=3\\sqrt5$\n\nSquare the distance equation and use $a>2$ to select the positive value.",
              "worked": "$$\\begin{align*}\\sqrt{a^2+4}&=7\\\\a^2+4&=49\\\\a^2&=45\\\\a&=\\pm\\sqrt{45}\\\\a&=\\pm3\\sqrt5.\\end{align*}$$\nSince $a>2$, $a=3\\sqrt5$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          }
        ]
      }
    ]
