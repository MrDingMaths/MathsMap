  "content": {
    "id": "p2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Factorise each of the following expressions by taking out the greatest common divisor:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)^2+3(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+4)$",
          "worked": "$$\\begin{align*}(x+1)^2+3(x+1)&=(x+1)(x+1+3)\\\\(x+1)^2+3(x+1)&=(x+1)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p2-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-2)+3(x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(3x-5)$",
          "worked": "$$\\begin{align*}(x-2)+3(x-2)^2&=(x-2)\\bigl(1+3(x-2)\\bigr)\\\\(x-2)+3(x-2)^2&=(x-2)(3x-5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p2-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+3)^2-2(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x+1)$",
          "worked": "$$\\begin{align*}(x+3)^2-2(x+3)&=(x+3)(x+3-2)\\\\(x+3)^2-2(x+3)&=(x+3)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p2-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x+4)-2(x+4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+4)(2x+7)$",
          "worked": "$$\\begin{align*}(x+4)-2(x+4)^2&=(x+4)\\bigl(1-2(x+4)\\bigr)\\\\(x+4)-2(x+4)^2&=(x+4)(-2x-7)\\\\(x+4)-2(x+4)^2&=-(x+4)(2x+7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p2-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$3(2x+1)^3+2(2x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)^2(6x+5)$",
          "worked": "$$\\begin{align*}3(2x+1)^3+2(2x+1)^2&=(2x+1)^2\\bigl(3(2x+1)+2\\bigr)\\\\3(2x+1)^3+2(2x+1)^2&=(2x+1)^2(6x+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$2(2x+1)^2-3(2x+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(2x+1)^2(6x+1)$",
          "worked": "$$\\begin{align*}2(2x+1)^2-3(2x+1)^3&=(2x+1)^2\\bigl(2-3(2x+1)\\bigr)\\\\2(2x+1)^2-3(2x+1)^3&=(2x+1)^2(-6x-1)\\\\2(2x+1)^2-3(2x+1)^3&=-(2x+1)^2(6x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
