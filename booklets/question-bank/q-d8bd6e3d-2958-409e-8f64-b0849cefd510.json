  "content": {
    "id": "v2-954e5-p15-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $P(x)=x^3-6x^2+9x-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-954e5-p15-practice-slot-8-slot-8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $2$ is a zero of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(2)=0$, so $2$ is a zero.",
          "worked": "$$\\begin{align*}P(2)&=2^3-6(2)^2+9(2)-2\\\\&=8-24+18-2\\\\&=0\\end{align*}$$\nTherefore $2$ is a zero of $P(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-954e5-p15-practice-slot-8-slot-8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that the zeroes of $P(x)$ are $2$, $\\alpha$ and $\\beta$. Show that $\\alpha+\\beta=4$ and $\\alpha\\beta=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha+\\beta=4$ and $\\alpha\\beta=1$.",
          "worked": "Using the sum of zeroes,\n$$\\begin{align*}2+\\alpha+\\beta&=6\\\\\\alpha+\\beta&=4.\\end{align*}$$\nUsing the product of zeroes,\n$$\\begin{align*}2\\alpha\\beta&=2\\\\\\alpha\\beta&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-954e5-p15-practice-slot-8-slot-8-q-c",
        "type": "part",
        "label": "c",
        "prompt": "By solving the two equations in part b simultaneously, show that $\\alpha^2-4\\alpha+1=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha(4-\\alpha)=1$, so $\\alpha^2-4\\alpha+1=0$.",
          "worked": "From part b, $\\beta=4-\\alpha$. Substitute into $\\alpha\\beta=1$:\n$$\\begin{align*}\\alpha(4-\\alpha)&=1\\\\4\\alpha-\\alpha^2&=1\\\\\\alpha^2-4\\alpha+1&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-954e5-p15-practice-slot-8-slot-8-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find the exact values of $\\alpha$ and $\\beta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha,\\beta=2+\\sqrt3,\\ 2-\\sqrt3$",
          "worked": "$$\\begin{align*}\\alpha&=\\frac{4\\pm\\sqrt{(-4)^2-4(1)(1)}}{2}\\\\&=\\frac{4\\pm\\sqrt{12}}{2}\\\\&=2\\pm\\sqrt3.\\end{align*}$$\nSince $\\beta=4-\\alpha$, if $\\alpha=2+\\sqrt3$ then $\\beta=2-\\sqrt3$, and vice versa. The zeroes of $P(x)$ are $2$, $2+\\sqrt3$ and $2-\\sqrt3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
