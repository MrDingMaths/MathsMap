    "id": "p27-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A rectangular garden plot 8 m by 3 m is surrounded by a concrete path 1.2 m wide and laid to a depth of 8 m.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the path.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32.16\\text{ m}^2$",
          "worked": "$$\\begin{aligned}A&=(8+2(1.2))(3+2(1.2))-8(3)\\\\A&=10.4(5.4)-24\\\\A&=32.16\\text{ m}^2.\\end{aligned}$$",
