      "blocks": [
        {
          "id": "p59-q4-wage",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Tai earns a gross weekly wage of $1024.",
              "marks": []
            }
          ]
        },
        {
          "id": "p59-q4-deductions",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Each week her deductions include tax instalments of $296.40, health fund contribution of $24.50, union fees of $15.80.",
              "marks": []
            }
          ]
        },
        {
          "id": "p59-q4-expenses",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "She also pays $3640 over the year as her share of the household expenses.",
              "marks": []
            }
          ]
        },
        {
          "id": "p59-q4-task",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "What percentage of her net wage does Tai pay for household expenses? Round your answer to 2 decimal places.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10.18\\%$",
      "worked": "$$\\begin{align*}\\text{Weekly net wage}&=1024-296.40-24.50-15.80\\\\&=\\$687.30\\\\\\text{Weekly household expenses}&=3640\\div52\\\\&=\\$70\\\\\\text{Percentage of net wage}&=\\frac{70}{687.30}\\times100\\%\\\\&\\approx10.18\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
