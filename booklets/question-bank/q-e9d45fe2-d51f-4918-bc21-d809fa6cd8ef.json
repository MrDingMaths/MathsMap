  "content": {
    "id": "p8-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Complete the square, expressing each of the following in the form $(x+h)^2+k$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2-2$",
          "worked": "$$\\begin{align*}x^2+4x+2&=x^2+4x+4-4+2\\\\x^2+4x+2&=(x+2)^2-4+2\\\\x^2+4x+2&=(x+2)^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+6x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2-3$",
          "worked": "$$\\begin{align*}x^2+6x+6&=x^2+6x+9-9+6\\\\x^2+6x+6&=(x+3)^2-9+6\\\\x^2+6x+6&=(x+3)^2-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-2x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)^2-7$",
          "worked": "$$\\begin{align*}x^2-2x-6&=x^2-2x+1-1-6\\\\x^2-2x-6&=(x-1)^2-1-6\\\\x^2-2x-6&=(x-1)^2-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+3x-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac32\\right)^2-\\frac{41}{4}$",
          "worked": "$$\\begin{align*}x^2+3x-8&=x^2+3x+\\frac94-\\frac94-8\\\\x^2+3x-8&=\\left(x+\\frac32\\right)^2-\\frac94-\\frac{32}{4}\\\\x^2+3x-8&=\\left(x+\\frac32\\right)^2-\\frac{41}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x-\\frac12\\right)^2-\\frac54$",
          "worked": "$$\\begin{align*}x^2-x-1&=x^2-x+\\frac14-\\frac14-1\\\\x^2-x-1&=\\left(x-\\frac12\\right)^2-\\frac14-\\frac44\\\\x^2-x-1&=\\left(x-\\frac12\\right)^2-\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2-10x+20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)^2-5$",
          "worked": "$$\\begin{align*}x^2-10x+20&=x^2-10x+25-25+20\\\\x^2-10x+20&=(x-5)^2-25+20\\\\x^2-10x+20&=(x-5)^2-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2+3x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac32\\right)^2-\\frac{37}{4}$",
          "worked": "$$\\begin{align*}x^2+3x-7&=x^2+3x+\\frac94-\\frac94-7\\\\x^2+3x-7&=\\left(x+\\frac32\\right)^2-\\frac94-\\frac{28}{4}\\\\x^2+3x-7&=\\left(x+\\frac32\\right)^2-\\frac{37}{4}\\end{align*}$$",
