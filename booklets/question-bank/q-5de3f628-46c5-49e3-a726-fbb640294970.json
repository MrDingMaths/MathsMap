  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The lines $x=-1$, $x=3$ and $y=-2$ form three sides of a rectangle.\nFind the possible equation of the fourth line if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "The area is $12$ square units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1$ or $y=-5$; either is possible.",
          "worked": "$$\\begin{align*}\\text{Width}&=3-(-1)=4\\\\\\text{Height}&=12\\div4=3\\end{align*}$$\nThe fourth side is horizontal and $3$ units above or below $y=-2$.\n$$\\begin{align*}y&=-2+3=1\\\\\\text{or }y&=-2-3=-5\\end{align*}$$\nEither equation is a possible answer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The area is $8$ square units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=0$ or $y=-4$; either is possible.",
          "worked": "$$\\begin{align*}\\text{Width}&=3-(-1)=4\\\\\\text{Height}&=8\\div4=2\\end{align*}$$\nThe fourth side is horizontal and $2$ units above or below $y=-2$.\n$$\\begin{align*}y&=-2+2=0\\\\\\text{or }y&=-2-2=-4\\end{align*}$$\nEither equation is a possible answer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "The perimeter is $14$ units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=1$ or $y=-5$; either is possible.",
          "worked": "$$\\begin{align*}\\text{Width}&=3-(-1)=4\\\\\\text{Width}+\\text{height}&=14\\div2=7\\\\\\text{Height}&=7-4=3\\end{align*}$$\nThe fourth side is horizontal and $3$ units above or below $y=-2$.\n$$\\begin{align*}y&=-2+3=1\\\\\\text{or }y&=-2-3=-5\\end{align*}$$\nEither equation is a possible answer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "The perimeter is $31$ units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{19}{2}$ or $y=-\\frac{27}{2}$; either is possible.",
          "worked": "$$\\begin{align*}\\text{Width}&=3-(-1)=4\\\\\\text{Width}+\\text{height}&=\\frac{31}{2}\\\\\\text{Height}&=\\frac{31}{2}-4=\\frac{23}{2}\\end{align*}$$\nThe fourth side is horizontal and $\\frac{23}{2}$ units above or below $y=-2$.\n$$\\begin{align*}y&=-2+\\frac{23}{2}=\\frac{19}{2}\\\\\\text{or }y&=-2-\\frac{23}{2}=-\\frac{27}{2}\\end{align*}$$\nEither equation is a possible answer.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
