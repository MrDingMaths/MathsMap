  "content": {
    "id": "p21-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Is it possible for the exterior angle of a regular polygon to be $150^{\\circ}$? Why or why not?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No. It would require $2.4$ sides, and a polygon must have a whole number of sides.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q21-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "If each exterior angle is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "150^{\\circ}",
                "display": false
              },
              {
                "type": "text",
                "text": ":",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}150^{\\circ}&=\\frac{360^{\\circ}}{n}\\\\n&=\\frac{360}{150}=2.4\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q21-answer-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since a polygon must have a whole number of sides, an exterior angle of ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "150^{\\circ}",
                "display": false
              },
              {
                "type": "text",
                "text": " is impossible for a regular polygon.",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
