  "content": {
    "id": "sum-product-b2-6-root",
    "type": "question",
    "label": null,
    "prompt": "Find the roots of $x^3+3x^2-13x-15=0$, given that the roots are in arithmetic progression.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-5,\\ -1,\\ 3$.",
      "worked": "Let the roots be $\\alpha-d,\\alpha,\\alpha+d$.\n\nUsing the sum of roots:\n$$\\begin{aligned}3\\alpha&=-3\\\\\\alpha&=-1\\end{aligned}$$\nUsing the product of roots:\n$$\\begin{aligned}(-1-d)(-1)(-1+d)&=15\\\\d^2-1&=15\\\\d^2&=16\\\\d&=\\pm4\\end{aligned}$$\nHence $x=-5,-1,3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
