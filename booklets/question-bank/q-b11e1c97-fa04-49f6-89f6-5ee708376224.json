  "content": {
    "id": "p38-q42-root",
    "type": "question",
    "label": "42",
    "prompt": "The 3rd term of a geometric sequence is $\\dfrac25$ and the 5th term is $\\dfrac85$.\nFind the first term and common ratio.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "First term $\\dfrac1{10}$; common ratio $2$ or $-2$.",
      "worked": "$$\\begin{align*}ar^2&=\\frac25\\qquad(1)\\\\ar^4&=\\frac85\\qquad(2)\\end{align*}$$\n$(2)\\div(1)$:\n$$\\begin{align*}r^2&=4\\\\r&=2\\text{ or }-2\\end{align*}$$\nFor $r=2$:\n$$\\begin{align*}a(4)&=\\frac25\\\\a&=\\frac1{10}\\end{align*}$$\nFor $r=-2$:\n$$\\begin{align*}a(4)&=\\frac25\\\\a&=\\frac1{10}\\end{align*}$$",
      "solutionDiagrams": []
    },
