  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Rationalise the denominator. Assume each expression is defined and any binomial denominator has a nonzero conjugate.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{a\\sqrt b}{c\\sqrt d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a\\sqrt{bd}}{cd}$",
          "worked": "$$\\begin{align*}\\frac{a\\sqrt b}{c\\sqrt d}&=\\frac{a\\sqrt b}{c\\sqrt d}\\cdot\\frac{\\sqrt d}{\\sqrt d}\\\\\\frac{a\\sqrt b}{c\\sqrt d}&=\\frac{a\\sqrt{bd}}{cd}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac1{a+\\sqrt b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-\\sqrt b}{a^2-b}$",
          "worked": "$$\\begin{align*}\\frac1{a+\\sqrt b}&=\\frac1{a+\\sqrt b}\\cdot\\frac{a-\\sqrt b}{a-\\sqrt b}\\\\\\frac1{a+\\sqrt b}&=\\frac{a-\\sqrt b}{a^2-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac1{\\sqrt a}-\\dfrac1{\\sqrt b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt a}{a}-\\dfrac{\\sqrt b}{b}$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt a}-\\frac1{\\sqrt b}&=\\frac1{\\sqrt a}\\cdot\\frac{\\sqrt a}{\\sqrt a}-\\frac1{\\sqrt b}\\cdot\\frac{\\sqrt b}{\\sqrt b}\\\\\\frac1{\\sqrt a}-\\frac1{\\sqrt b}&=\\frac{\\sqrt a}{a}-\\frac{\\sqrt b}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac1{a\\sqrt b-c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a\\sqrt b+c}{a^2b-c^2}$",
          "worked": "$$\\begin{align*}\\frac1{a\\sqrt b-c}&=\\frac1{a\\sqrt b-c}\\cdot\\frac{a\\sqrt b+c}{a\\sqrt b+c}\\\\\\frac1{a\\sqrt b-c}&=\\frac{a\\sqrt b+c}{a^2b-c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac1{a\\sqrt b+c\\sqrt d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a\\sqrt b-c\\sqrt d}{a^2b-c^2d}$",
          "worked": "$$\\begin{align*}\\frac1{a\\sqrt b+c\\sqrt d}&=\\frac1{a\\sqrt b+c\\sqrt d}\\cdot\\frac{a\\sqrt b-c\\sqrt d}{a\\sqrt b-c\\sqrt d}\\\\\\frac1{a\\sqrt b+c\\sqrt d}&=\\frac{a\\sqrt b-c\\sqrt d}{a^2b-c^2d}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
