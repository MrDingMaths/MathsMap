    "children": [
      {
        "id": "p13-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\log_a b+\\log_b a=2$, then prove that $a=b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=b$.\n\nBase swapping gives $(\\log_a b-1)^2=0$, so $\\log_a b=1$.",
          "worked": "Using $\\log_b a=\\dfrac{1}{\\log_a b}$,\n$$\\begin{align*}\n\\log_a b+\\frac{1}{\\log_a b}&=2\\\\\n(\\log_a b)^2+1&=2\\log_a b\\\\\n(\\log_a b)^2-2\\log_a b+1&=0\\\\\n(\\log_a b-1)^2&=0\\\\\n\\log_a b&=1\\\\\nb&=a^1\\\\\nb&=a.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p13-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\log_a b+\\log_b a=-2$, then prove that $ab=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab=1$.\n\nBase swapping gives $(\\log_a b+1)^2=0$, so $b=a^{-1}$.",
          "worked": "Using $\\log_b a=\\dfrac{1}{\\log_a b}$,\n$$\\begin{align*}\n\\log_a b+\\frac{1}{\\log_a b}&=-2\\\\\n(\\log_a b)^2+1&=-2\\log_a b\\\\\n(\\log_a b)^2+2\\log_a b+1&=0\\\\\n(\\log_a b+1)^2&=0\\\\\n\\log_a b&=-1\\\\\nb&=a^{-1}\\\\\nb&=\\frac{1}{a}\\\\\nab&=1.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 76
      }
    ]
  },
