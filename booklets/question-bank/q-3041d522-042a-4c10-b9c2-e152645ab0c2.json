    "label": "6",
    "prompt": "The number $1000$ is a perfect cube. Which perfect cubes lie immediately before and after $1000$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$729$ and $1331$, respectively.",
      "worked": "$$\\begin{align*}10^3&=1000\\\\9^3&=729\\\\11^3&=1331\\end{align*}$$\nThe perfect cubes immediately before and after $1000$ are $729$ and $1331$, respectively.",
