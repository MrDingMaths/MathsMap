    "answer": {
      "short": "$(x-y)^2$. Expand the square and simplify.",
      "worked": "$$\\begin{align*}xy\\left(\\frac{\\sqrt{x}}{\\sqrt{y}}-\\frac{\\sqrt{y}}{\\sqrt{x}}\\right)^2&=xy\\left(\\frac{x}{y}-2\\frac{\\sqrt{x}\\sqrt{y}}{\\sqrt{y}\\sqrt{x}}+\\frac{y}{x}\\right)\\\\&=xy\\left(\\frac{x}{y}-2+\\frac{y}{x}\\right)\\\\&=x^2-2xy+y^2\\\\&=(x-y)^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 45
  },
