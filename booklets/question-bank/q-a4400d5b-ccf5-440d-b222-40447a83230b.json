  "content": {
    "id": "p81-q6-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the inequality $\\dfrac{3}{x-2}>1$. Bob takes the simple approach of ‘moving $x-2$ to the other side’ and solves the inequality from there. Does his solution have anything to do with the correct answer?",
    "layout": "list",
