  "content": {
    "id": "p10-q24-root",
    "type": "question",
    "label": null,
    "prompt": "A bag contains 120 whole numbers from 1 through to 120. If a number is chosen at random from the bag, find the probability that the number is divisible by",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are $120\\div2=60$ multiples of $2$.\n$$\\begin{align*}\\Pr(\\text{divisible by }2)&=\\frac{60}{120}\\\\\\Pr(\\text{divisible by }2)&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "There are $120\\div5=24$ multiples of $5$.\n$$\\begin{align*}\\Pr(\\text{divisible by }5)&=\\frac{24}{120}\\\\\\Pr(\\text{divisible by }5)&=\\frac15.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "$2$ or $5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$\n\nSubtract the multiples of $10$ counted in both events.",
          "worked": "There are $60$ multiples of $2$, $24$ multiples of $5$ and $120\\div10=12$ multiples of both.\n$$\\begin{align*}\\Pr(\\text{divisible by }2\\text{ or }5)&=\\frac{60}{120}+\\frac{24}{120}-\\frac{12}{120}\\\\\\Pr(\\text{divisible by }2\\text{ or }5)&=\\frac{72}{120}\\\\\\Pr(\\text{divisible by }2\\text{ or }5)&=\\frac35.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q24-d",
        "type": "part",
        "label": "d",
        "prompt": "$3$ or $4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$\n\nSubtract the multiples of $12$ counted in both events.",
          "worked": "There are $120\\div3=40$ multiples of $3$, $120\\div4=30$ multiples of $4$ and $120\\div12=10$ multiples of both.\n$$\\begin{align*}\\Pr(\\text{divisible by }3\\text{ or }4)&=\\frac{40}{120}+\\frac{30}{120}-\\frac{10}{120}\\\\\\Pr(\\text{divisible by }3\\text{ or }4)&=\\frac{60}{120}\\\\\\Pr(\\text{divisible by }3\\text{ or }4)&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
