  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A rectangle has a constant area of $36\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "If $x$ is the length of the rectangle, show that the width is $\\dfrac{36}{x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{36}{x}$ cm",
          "worked": "Let $y$ be the width in centimetres, with $x>0$.\n$$\\begin{align*}xy&=36\\\\y&=\\frac{36}{x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the perimeter of the rectangle is given by $P=2x+\\dfrac{72}{x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=2x+\\dfrac{72}{x}$",
          "worked": "$$\\begin{align*}P&=2x+2y\\\\P&=2x+2\\left(\\frac{36}{x}\\right)\\\\P&=2x+\\frac{72}{x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $\\dfrac{dP}{dx}=2-\\dfrac{72}{x^2}$ and hence that the minimum value of $P$ occurs at $x=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dP}{dx}=2-\\dfrac{72}{x^2}$. The derivative changes from negative to positive at $x=6$, so $P$ has its minimum there.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q5-c-calculation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}P&=2x+72x^{-1}\\\\\\frac{dP}{dx}&=2-72x^{-2}\\\\\\frac{dP}{dx}&=2-\\frac{72}{x^2}.\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p24-q5-c-stationary-intro",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
