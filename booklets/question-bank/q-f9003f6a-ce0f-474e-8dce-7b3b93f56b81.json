  "content": {
    "id": "p23-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The radioactivity of any sample of the element iodine-131 decreases by 55% every seven days. Find the percentage reduction in radioactivity over each of the periods given below. (Give percentages correct to one decimal place.)",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "3 weeks",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90.9\\%$",
          "worked": "Each seven-day period leaves $100\\%-55\\%=45\\%$ of the previous radioactivity.\n\n$$\\begin{align*}\\text{Reduction} &= (1-0.45^3)\\times100\\%\\\\\\text{Reduction} &=90.8875\\%\\\\\\text{Reduction} &\\approx90.9\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "10 weeks",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100.0\\%$",
          "worked": "The weekly multiplier is $0.45$.\n\n$$\\begin{align*}\\text{Reduction} &=(1-0.45^{10})\\times100\\%\\\\\\text{Reduction} &\\approx100.0\\%\\end{align*}$$\n\nThis rounds to $100.0\\%$; a small amount of radioactivity remains.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "26 weeks",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
