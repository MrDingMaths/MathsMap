      {
        "id": "v2-41749f-p5-practice-slot-3-upper-s3u-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{27}{64}\\right)^{-\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{3}$",
          "worked": "$$\\begin{align*}\\left(\\frac{27}{64}\\right)^{-\\frac{1}{3}}&=\\left(\\frac{64}{27}\\right)^{\\frac{1}{3}}\\\\&=\\sqrt[3]{\\frac{64}{27}}\\\\&=\\frac{4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-41749f-p5-practice-slot-3-upper-s3u-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{1}{16}\\right)^{-\\frac{1}{4}}+\\left(\\frac{1}{25}\\right)^{-\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{16}\\right)^{-\\frac{1}{4}}+\\left(\\frac{1}{25}\\right)^{-\\frac{1}{2}}&=16^{\\frac{1}{4}}+25^{\\frac{1}{2}}\\\\&=2+5\\\\&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-41749f-p5-practice-slot-3-upper-s3u-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{8^{-\\frac{1}{3}}}{\\left(\\frac{1}{4}\\right)^{-\\frac{1}{2}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{8^{-\\frac{1}{3}}}{\\left(\\frac{1}{4}\\right)^{-\\frac{1}{2}}}&=\\frac{\\frac{1}{8^{\\frac{1}{3}}}}{4^{\\frac{1}{2}}}\\\\&=\\frac{\\frac{1}{2}}{2}\\\\&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "v2-41749f-p5-practice-slot-3-upper-s3u-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{1}{36}\\right)^{-\\frac{1}{2}}\\times27^{-\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\left(\\frac{1}{36}\\right)^{-\\frac{1}{2}}\\times27^{-\\frac{1}{3}}&=36^{\\frac{1}{2}}\\times\\frac{1}{27^{\\frac{1}{3}}}\\\\&=6\\times\\frac{1}{3}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
