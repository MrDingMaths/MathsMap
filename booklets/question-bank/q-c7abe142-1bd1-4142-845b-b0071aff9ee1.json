  "content": {
    "id": "p15-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "The 90A bus and the 95B bus both stop at the bus station at 12:00.\n90A stops there every 20 minutes and 95B stops there every 8 minutes.\nWhen do they both stop there again?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12:40, after 40 minutes.",
      "worked": "Use the LCM because both stopping intervals must divide the elapsed time. The HCF of 20 and 8 is 4.\n$$\\begin{align*}\\operatorname{LCM}(20,8)&=\\frac{20\\times8}{4}\\\\\\operatorname{LCM}(20,8)&=40\\end{align*}$$\nThey next both stop there 40 minutes after 12:00, at 12:40.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
