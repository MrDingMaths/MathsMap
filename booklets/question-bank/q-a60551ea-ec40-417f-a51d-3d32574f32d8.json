      {
        "id": "v2-84f2e-p13-practice-slot-3-s3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=5x-2$ and $f(g(x))=15x+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=3x+2$",
          "worked": "$$\\begin{aligned}f(g(x))&=5(g(x))-2\\\\5(g(x))-2&=15x+8\\\\5(g(x))&=15x+10\\\\g(x)&=3x+2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-84f2e-p13-practice-slot-3-s3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3-2x$ and $f(g(x))=7-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=2x-2$",
          "worked": "$$\\begin{aligned}f(g(x))&=3-2(g(x))\\\\3-2(g(x))&=7-4x\\\\-2(g(x))&=4-4x\\\\g(x)&=2x-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
