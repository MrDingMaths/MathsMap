  "content": {
    "id": "p27-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "For the four points $P(k,1)$, $Q(-2,-3)$, $R(2,3)$ and $S(1,k)$, it is known that $PQ$ is parallel to $RS$. Find the possible values of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=2$ or $k=-1$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q18-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}m_{PQ}&=\\frac{-3-1}{-2-k}=\\frac{-4}{-2-k}=\\frac{4}{2+k}\\\\m_{RS}&=\\frac{k-3}{1-2}=\\frac{k-3}{-1}=3-k\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "For parallel lines, the gradients are equal.",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{4}{2+k}&=3-k\\\\4&=(3-k)(2+k)\\\\4&=6+3k-2k-k^2\\\\k^2-k-2&=0\\\\(k-2)(k+1)&=0\\\\k&=2\\text{ or }k=-1\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 65
  },
