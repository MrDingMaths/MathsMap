  "content": {
    "id": "p41-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Explain why $y=x^2+2$ has no $x$-intercepts.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The discriminant is $-8<0$, so there are no $x$-intercepts.",
      "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=0^2-4(1)(2)\\\\\\Delta&=-8\\end{align*}$$\nSince $\\Delta<0$, there are no real roots, so the parabola has no $x$-intercepts.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
