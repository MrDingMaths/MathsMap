  "content": {
    "id": "p20-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Find the number of sides in an irregular polygon with one exterior angle of $60^{\\circ}$ and all others $10^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "31 sides.",
      "worked": "Let $n$ be the number of sides. The exterior angles sum to $360^{\\circ}$.\n$$\\begin{align*}60+10(n-1)&=360\\\\10(n-1)&=300\\\\n-1&=30\\\\n&=31\\end{align*}$$\nThe polygon has 31 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
