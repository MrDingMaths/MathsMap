  "content": {
    "id": "p4-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the distance between points $A$ and $B$. Give exact answers and, where needed, decimal approximations to 2 decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(1,2),\\ B(0,0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{5}\\approx2.24$",
          "worked": "$$\\begin{align*}AB^2&=(0-1)^2+(0-2)^2\\\\AB^2&=(-1)^2+(-2)^2\\\\AB^2&=5\\\\AB&=\\sqrt{5}\\\\AB&\\approx2.24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(-1,6),\\ B(4,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{29}\\approx5.39$",
          "worked": "$$\\begin{align*}AB^2&=[4-(-1)]^2+(8-6)^2\\\\AB^2&=5^2+2^2\\\\AB^2&=29\\\\AB&=\\sqrt{29}\\\\AB&\\approx5.39\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(-2,8),\\ B(6,4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{5}\\approx8.94$",
          "worked": "$$\\begin{align*}AB^2&=[6-(-2)]^2+(4-8)^2\\\\AB^2&=8^2+(-4)^2\\\\AB^2&=80\\\\AB&=\\sqrt{80}\\\\AB&=4\\sqrt{5}\\\\AB&\\approx8.94\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p4-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(-2,-6),\\ B(3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{89}\\approx9.43$",
          "worked": "$$\\begin{align*}AB^2&=[3-(-2)]^2+[2-(-6)]^2\\\\AB^2&=5^2+8^2\\\\AB^2&=89\\\\AB&=\\sqrt{89}\\\\AB&\\approx9.43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(-3,4),\\ B(4,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{2}\\approx7.07$",
          "worked": "$$\\begin{align*}AB^2&=[4-(-3)]^2+(3-4)^2\\\\AB^2&=7^2+(-1)^2\\\\AB^2&=50\\\\AB&=\\sqrt{50}\\\\AB&=5\\sqrt{2}\\\\AB&\\approx7.07\\end{align*}$$",
