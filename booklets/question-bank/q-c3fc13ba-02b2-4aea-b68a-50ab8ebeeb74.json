  "content": {
    "id": "p32-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "How many ways can you arrange the digits in the number $123456$ so that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "the first digit is even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$",
          "worked": "There are three choices for the first digit: $2$, $4$ or $6$. The remaining five digits can be arranged in $5!$ ways.\n$$\\begin{align*}N&=3\\times5!\\\\N&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p32-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "the last digit is even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$",
          "worked": "There are three choices for the last digit: $2$, $4$ or $6$. The remaining five digits can be arranged in $5!$ ways.\n$$\\begin{align*}N&=3\\times5!\\\\N&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p32-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "the first and last digits are even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$144$",
          "worked": "There are three choices for the first digit and two remaining even digits for the last digit. The other four digits can be arranged in $4!$ ways.\n$$\\begin{align*}N&=3\\times2\\times4!\\\\N&=144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "the first or last digit is even?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p32-q4-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "576",
                    "display": false
                  }
                ]
              },
              {
                "id": "p32-q4-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the counts for each end being even, then subtract the count with both ends even.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Let $A$ be the set of arrangements with an even first digit and $B$ the set with an even last digit. From parts (a)–(c), $|A|=360$, $|B|=360$ and $|A\\cap B|=144$. By inclusion-exclusion,\n$$\\begin{align*}|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B|&=360+360-144\\\\|A\\cup B|&=576\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
