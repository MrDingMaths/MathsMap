        "id": "p15-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "it is a double-flavoured jelly bean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{48}$",
          "worked": "Total jelly beans: $39+54+27+24=144$.\n\nDouble-flavoured jelly beans: $27+24=51$.\n\n$$\\begin{align*}P(\\text{double-flavoured})&=\\frac{51}{144}\\\\P(\\text{double-flavoured})&=\\frac{17}{48}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "it is a green jelly bean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{24}$",
          "worked": "There are $144$ jelly beans in total and $39+27=66$ green jelly beans.\n\n$$\\begin{align*}P(\\text{green})&=\\frac{66}{144}\\\\P(\\text{green})&=\\frac{11}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "it is a green normal jelly bean",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{48}$",
          "worked": "There are $144$ jelly beans in total. The green normal cell contains $39$ jelly beans.\n\n$$\\begin{align*}P(\\text{green and normal})&=\\frac{39}{144}\\\\P(\\text{green and normal})&=\\frac{13}{48}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
