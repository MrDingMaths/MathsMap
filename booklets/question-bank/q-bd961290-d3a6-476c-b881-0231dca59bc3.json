  "content": {
    "id": "p14-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "$\\$100\\,000$ is invested for 10 years at 5.5% compounded annually.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the total percentage increase in the investment to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "70.81%",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 100000(1.055)^{10}\\\\\\text{Percentage increase} &= \\frac{FV-PV}{PV}\\times100\\%\\\\\\text{Percentage increase} &= \\frac{100000(1.055)^{10}-100000}{100000}\\times100\\%\\\\\\text{Percentage increase} &\\approx 70.81\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the simple interest rate that would deliver the same overall interest at the end of the 10 years. Round to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "7.08% p.a.",
          "worked": "$$\\begin{align*}I &= FV-PV\\\\I &= 100000(1.055)^{10}-100000\\\\I &= Prn\\\\100000(1.055)^{10}-100000 &= 100000\\times r\\times10\\\\r &= \\frac{100000(1.055)^{10}-100000}{100000\\times10}\\\\r &\\approx 0.07081444584\\end{align*}$$\nThe simple interest rate is $7.08\\%$ p.a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
