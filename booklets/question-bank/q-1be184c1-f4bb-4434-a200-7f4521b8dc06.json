      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $f(x)=\\sqrt{4-x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=-\\frac{x}{\\sqrt{4-x^2}}$ for $-2<x<2$.",
          "worked": "$$\\begin{align*}f'(x)&=\\frac12(4-x^2)^{-\\frac12}(-2x)\\\\f'(x)&=-\\frac{x}{\\sqrt{4-x^2}}\\end{align*}$$\nThis derivative is defined for $-2<x<2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of the tangent where $x=2$. What do you notice? Explain your observation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The gradient is undefined. The tangent is the vertical line $x=2$.",
          "worked": "At $x=2$ the denominator of $f'(x)$ is zero. The graph is the upper semicircle $x^2+y^2=4$. At $(2,0)$ the radius is horizontal, so the tangent is vertical and its gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
