  "content": {
    "id": "p19-q21-root",
    "type": "question",
    "label": null,
    "prompt": "Jim, a part-time gardener, earned \\$261 in a week. If he worked 12 hours during normal working hours and 4 hours overtime at time-and-a-half, what was his hourly rate of pay?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$14.50/h",
      "worked": "$$\\begin{align*}\\text{Equivalent normal hours} &= 12 + (4 \\times 1.5) = 18\\\\\\text{Hourly rate} &= 261 \\div 18\\\\\\text{Hourly rate} &= \\$14.50/\\text{h}\\end{align*}$$",
      "solutionDiagrams": []
    },
