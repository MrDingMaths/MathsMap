        "answer": {
          "short": "$6-15\\sqrt2$",
          "worked": "$$\\begin{align*}(\\sqrt8+\\sqrt2)(\\sqrt2-5)&=\\sqrt{16}-5\\sqrt8+2-5\\sqrt2\\\\(\\sqrt8+\\sqrt2)(\\sqrt2-5)&=4-10\\sqrt2+2-5\\sqrt2\\\\(\\sqrt8+\\sqrt2)(\\sqrt2-5)&=6-15\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
