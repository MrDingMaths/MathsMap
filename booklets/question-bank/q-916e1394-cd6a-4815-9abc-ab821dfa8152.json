    "children": [
      {
        "id": "p9-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt2+3)(\\sqrt2+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17+8\\sqrt2$",
          "worked": "$$\\begin{align*}(\\sqrt2+3)(\\sqrt2+5)&=2+5\\sqrt2+3\\sqrt2+15\\\\(\\sqrt2+3)(\\sqrt2+5)&=17+8\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt3+2)(\\sqrt3-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5-2\\sqrt3$",
          "worked": "$$\\begin{align*}(\\sqrt3+2)(\\sqrt3-4)&=3-4\\sqrt3+2\\sqrt3-8\\\\(\\sqrt3+2)(\\sqrt3-4)&=-5-2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2\\sqrt5+3)(3\\sqrt5+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36+13\\sqrt5$",
          "worked": "$$\\begin{align*}(2\\sqrt5+3)(3\\sqrt5+2)&=6\\times5+4\\sqrt5+9\\sqrt5+6\\\\(2\\sqrt5+3)(3\\sqrt5+2)&=36+13\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3\\sqrt7-3)(2\\sqrt7+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "$$\\begin{align*}(3\\sqrt7-3)(2\\sqrt7+2)&=6\\times7+6\\sqrt7-6\\sqrt7-6\\\\(3\\sqrt7-3)(2\\sqrt7+2)&=42-6\\\\(3\\sqrt7-3)(2\\sqrt7+2)&=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt5+\\sqrt2)(\\sqrt5+\\sqrt{10})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5+5\\sqrt2+\\sqrt{10}+2\\sqrt5$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt2)(\\sqrt5+\\sqrt{10})&=5+\\sqrt{50}+\\sqrt{10}+\\sqrt{20}\\\\(\\sqrt5+\\sqrt2)(\\sqrt5+\\sqrt{10})&=5+5\\sqrt2+\\sqrt{10}+2\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt3+\\sqrt2)(\\sqrt3+\\sqrt8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+3\\sqrt6$",
          "worked": "$$\\begin{align*}(\\sqrt3+\\sqrt2)(\\sqrt3+\\sqrt8)&=3+\\sqrt{24}+\\sqrt6+\\sqrt{16}\\\\(\\sqrt3+\\sqrt2)(\\sqrt3+\\sqrt8)&=3+2\\sqrt6+\\sqrt6+4\\\\(\\sqrt3+\\sqrt2)(\\sqrt3+\\sqrt8)&=7+3\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p9-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$(\\sqrt5+\\sqrt2)(\\sqrt5+2)$",
