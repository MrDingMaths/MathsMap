        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5+2\\sqrt5+\\sqrt{10}+2\\sqrt2$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt2)(\\sqrt5+2)&=\\sqrt{25}+2\\sqrt5+\\sqrt{10}+2\\sqrt2\\\\(\\sqrt5+\\sqrt2)(\\sqrt5+2)&=5+2\\sqrt5+\\sqrt{10}+2\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p9-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$(\\sqrt8+\\sqrt2)(\\sqrt2-5)$",
