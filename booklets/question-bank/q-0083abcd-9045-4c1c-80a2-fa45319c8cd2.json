  "content": {
    "id": "v2-a9dca-p13-practice-j4-025907-root",
    "type": "question",
    "label": null,
    "prompt": "A bus travels 180 km at a certain speed. If it had travelled 15 km/h faster, the journey would have taken 1 hour less.\nLet $s$ be the bus's original speed in km/h.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a9dca-p13-practice-j4-025907-j4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Use $d=st$ to write an expression for the time taken, in hours, at the original speed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{180}{s}$ hours.",
          "worked": "$$\\begin{align*}180&=st\\\\t&=\\frac{180}{s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-a9dca-p13-practice-j4-025907-j4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression for the time taken, in hours, at the faster speed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{180}{s+15}$ hours.",
          "worked": "The faster speed is $s+15$ km/h, so $t=\\dfrac{180}{s+15}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-a9dca-p13-practice-j4-025907-j4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an equation using the fact that the faster journey takes 1 hour less.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{180}{s}-\\dfrac{180}{s+15}=1$.",
          "worked": "Original time $-$ faster time $=1$:\n$$\\frac{180}{s}-\\frac{180}{s+15}=1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-a9dca-p13-practice-j4-025907-j4-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Write your equation from part c in the form $as^2+bs+c=0$ and solve for $s$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s^2+15s-2700=0$; $s=45$ (reject $s=-60$).",
          "worked": "$$\\begin{align*}180(s+15)-180s&=s(s+15)\\\\2700&=s^2+15s\\\\s^2+15s-2700&=0\\\\(s+60)(s-45)&=0\\\\s&=-60\\text{ or }45\\end{align*}$$\nSince $s>0$, $s=45$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-a9dca-p13-practice-j4-025907-j4-q-e",
        "type": "part",
        "label": "e",
        "prompt": "What was the speed of the bus on each journey?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Original speed $45\\text{ km/h}$; faster speed $60\\text{ km/h}$.",
          "worked": "The original speed is $45\\text{ km/h}$ and the faster speed is $45+15=60\\text{ km/h}$.\nCheck: $180\\div45=4$ h and $180\\div60=3$ h, a decrease of $1$ hour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
