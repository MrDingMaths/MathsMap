  "content": {
    "id": "p14-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "If $x=2\\sqrt{3}$ and $y=-3\\sqrt{6}$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-18\\sqrt{2}$",
          "worked": "$$\\begin{align*}xy&=(2\\sqrt{3})(-3\\sqrt{6})\\\\xy&=-6\\sqrt{18}\\\\xy&=-18\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{y}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3\\sqrt{2}}{2}$",
          "worked": "$$\\begin{align*}\\frac{y}{x}&=\\frac{-3\\sqrt{6}}{2\\sqrt{3}}\\\\\\frac{y}{x}&=-\\frac{3}{2}\\sqrt{\\frac{6}{3}}\\\\\\frac{y}{x}&=-\\frac{3\\sqrt{2}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$66$",
          "worked": "$$\\begin{align*}x^2+y^2&=(2\\sqrt{3})^2+(-3\\sqrt{6})^2\\\\x^2+y^2&=12+54\\\\x^2+y^2&=66\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{x^2}+\\frac{1}{y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{108}$",
          "worked": "$$\\begin{align*}\\frac{1}{x^2}+\\frac{1}{y^2}&=\\frac{1}{(2\\sqrt{3})^2}+\\frac{1}{(-3\\sqrt{6})^2}\\\\\\frac{1}{x^2}+\\frac{1}{y^2}&=\\frac{1}{12}+\\frac{1}{54}\\\\\\frac{1}{x^2}+\\frac{1}{y^2}&=\\frac{9}{108}+\\frac{2}{108}\\\\\\frac{1}{x^2}+\\frac{1}{y^2}&=\\frac{11}{108}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24\\sqrt{3}$",
          "worked": "$$\\begin{align*}x^3&=(2\\sqrt{3})(2\\sqrt{3})(2\\sqrt{3})\\\\x^3&=12\\times2\\sqrt{3}\\\\x^3&=24\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^3y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1296\\sqrt{3}$",
          "worked": "$$\\begin{align*}x^3y^2&=(2\\sqrt{3})^3(-3\\sqrt{6})^2\\\\x^3y^2&=(12\\times2\\sqrt{3})(9\\times6)\\\\x^3y^2&=24\\sqrt{3}\\times54\\\\x^3y^2&=1296\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{y^2}{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{4\\sqrt{3}}$",
          "worked": "$$\\begin{align*}\\frac{y^2}{x^3}&=\\frac{(-3\\sqrt{6})^2}{(2\\sqrt{3})^3}\\\\\\frac{y^2}{x^3}&=\\frac{54}{24\\sqrt{3}}\\\\\\frac{y^2}{x^3}&=\\frac{9}{4\\sqrt{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-42$",
          "worked": "$$\\begin{align*}x^2-y^2&=(2\\sqrt{3})^2-(-3\\sqrt{6})^2\\\\x^2-y^2&=12-54\\\\x^2-y^2&=-42\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
