  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A bowl contains green and blue marbles. There are 24 green marbles and 72 blue marbles. What is the ratio of the number of green marbles to the number of blue marbles?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:3$",
      "worked": "The highest common factor of 24 and 72 is 24.\n\n$$\\begin{align*}\\text{Green marbles}:\\text{blue marbles}&=24:72\\\\\\text{Green marbles}:\\text{blue marbles}&=(24\\div24):(72\\div24)\\\\\\text{Green marbles}:\\text{blue marbles}&=1:3\\end{align*}$$",
      "solutionDiagrams": []
    },
