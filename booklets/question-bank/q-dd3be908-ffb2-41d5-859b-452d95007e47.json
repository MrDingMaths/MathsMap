  "content": {
    "id": "p43-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q14-a",
        "type": "group",
        "label": "a",
        "prompt": "Let $f(x)$ be any function, and let $g(x)=x-a$, where $a$ is a constant. Describe each composite graph as a transformation of the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p43-q14-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Translate vertically by $-a$: down $a$ units if $a>0$, up $|a|$ units if $a<0$.",
              "worked": "$$g(f(x))=f(x)-a.$$Every output changes by $-a$, so the translation vector is $(0,-a)$. There is no change when $a=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p43-q14-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Translate horizontally by $a$: right $a$ units if $a>0$, left $|a|$ units if $a<0$.",
              "worked": "$$f(g(x))=f(x-a).$$The point $(u,f(u))$ moves to $(u+a,f(u))$, so the translation vector is $(a,0)$. There is no change when $a=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p43-q14-b",
        "type": "group",
        "label": "b",
        "prompt": "Let $f(x)$ be any function, and let $g(x)=-x$. Describe each composite graph as a transformation of the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p43-q14-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflect in the $x$-axis.",
              "worked": "$$g(f(x))=-f(x).$$Each point $(x,y)$ becomes $(x,-y)$, giving a reflection in the $x$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p43-q14-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflect in the $y$-axis.",
              "worked": "$$f(g(x))=f(-x).$$Each point $(x,y)$ becomes $(-x,y)$, giving a reflection in the $y$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p43-q14-c",
        "type": "group",
        "label": "c",
        "prompt": "Let $f(x)$ be any function, and let $g(x)=kx$, where $k>0$ is a constant. Describe each composite graph as a transformation of the graph of $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p43-q14-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Vertical stretch with factor $k$.",
              "worked": "$$g(f(x))=kf(x).$$Each point $(x,y)$ becomes $(x,ky)$, giving a vertical stretch with factor $k$ (a compression when $0<k<1$).",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p43-q14-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Horizontal stretch with factor $\\frac1k$.",
              "worked": "$$f(g(x))=f(kx).$$The input $u$ occurs at $x=\\frac{u}{k}$, so each point $(u,f(u))$ becomes $(\\frac{u}{k},f(u))$. This is a horizontal stretch with factor $\\frac1k$ (a compression when $k>1$).",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
  },
