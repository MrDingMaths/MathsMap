  "content": {
    "id": "p18-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Simplify each expression, giving your answers with positive indices.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^{1.6}\\times a^{3.2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{4.8}$",
          "worked": "$$\\begin{aligned}a^{1.6}\\times a^{3.2}&=a^{1.6+3.2}\\\\a^{1.6}\\times a^{3.2}&=a^{4.8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$m^{4.7}\\times m^{1.3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^6$",
          "worked": "$$\\begin{aligned}m^{4.7}\\times m^{1.3}&=m^{4.7+1.3}\\\\m^{4.7}\\times m^{1.3}&=m^6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$p^{8.2}\\div p^{4.6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p^{3.6}$",
          "worked": "$$\\begin{aligned}p^{8.2}\\div p^{4.6}&=p^{8.2-4.6}\\\\p^{8.2}\\div p^{4.6}&=p^{3.6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$b^{4.1}\\div b^{2.85}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^{1.25}$",
          "worked": "$$\\begin{aligned}b^{4.1}\\div b^{2.85}&=b^{4.1-2.85}\\\\b^{4.1}\\div b^{2.85}&=b^{1.25}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2p^{1.3})^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4p^{2.6}$",
          "worked": "$$\\begin{aligned}(2p^{1.3})^2&=2^2p^{1.3\\times2}\\\\(2p^{1.3})^2&=4p^{2.6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$(4p^{2.1})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64p^{6.3}$",
          "worked": "$$\\begin{aligned}(4p^{2.1})^3&=4^3p^{2.1\\times3}\\\\(4p^{2.1})^3&=64p^{6.3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$4a^{1.3}b^{0.6}\\div(8a^2b^{-1})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^{1.6}}{2a^{0.7}}$\n\nSubtract indices when dividing; move the negative power of $a$ to the denominator.",
          "worked": "$$\\begin{aligned}4a^{1.3}b^{0.6}\\div(8a^2b^{-1})&=\\frac12a^{1.3-2}b^{0.6-(-1)}\\\\4a^{1.3}b^{0.6}\\div(8a^2b^{-1})&=\\frac12a^{-0.7}b^{1.6}\\\\4a^{1.3}b^{0.6}\\div(8a^2b^{-1})&=\\frac{b^{1.6}}{2a^{0.7}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p18-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "$12m^{-1.2}n^{3.5}\\div\\bigl(18(mn^{-1.5})^3\\bigr)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2n^8}{3m^{4.2}}$\n\nExpand the cubed product, then subtract indices in the quotient.",
          "worked": "$$\\begin{aligned}12m^{-1.2}n^{3.5}\\div\\bigl(18(mn^{-1.5})^3\\bigr)&=\\frac{12m^{-1.2}n^{3.5}}{18m^3n^{-4.5}}\\\\12m^{-1.2}n^{3.5}\\div\\bigl(18(mn^{-1.5})^3\\bigr)&=\\frac23m^{-1.2-3}n^{3.5-(-4.5)}\\\\12m^{-1.2}n^{3.5}\\div\\bigl(18(mn^{-1.5})^3\\bigr)&=\\frac23m^{-4.2}n^8\\\\12m^{-1.2}n^{3.5}\\div\\bigl(18(mn^{-1.5})^3\\bigr)&=\\frac{2n^8}{3m^{4.2}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p18-q14-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{a^{1.2}b^{4.3}}{(ab^{-1})^{1.2}}\\times\\dfrac{ab^{0.6}}{a^{1.8}b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^{5.1}}{a^{0.8}}$\n\nApply the outer power to both factors, then combine the indices of each base.",
          "worked": "$$\\begin{aligned}\\frac{a^{1.2}b^{4.3}}{(ab^{-1})^{1.2}}\\times\\frac{ab^{0.6}}{a^{1.8}b}&=\\frac{a^{1.2}b^{4.3}}{a^{1.2}b^{-1.2}}\\times\\frac{ab^{0.6}}{a^{1.8}b}\\\\\\frac{a^{1.2}b^{4.3}}{(ab^{-1})^{1.2}}\\times\\frac{ab^{0.6}}{a^{1.8}b}&=a^{1.2-1.2+1-1.8}b^{4.3+1.2+0.6-1}\\\\\\frac{a^{1.2}b^{4.3}}{(ab^{-1})^{1.2}}\\times\\frac{ab^{0.6}}{a^{1.8}b}&=a^{-0.8}b^{5.1}\\\\\\frac{a^{1.2}b^{4.3}}{(ab^{-1})^{1.2}}\\times\\frac{ab^{0.6}}{a^{1.8}b}&=\\frac{b^{5.1}}{a^{0.8}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q14-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{m^{0.9}n}{(mn^{1.5})^2}\\times\\dfrac{1}{mn^{3.8}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{m^{2.1}n^{5.8}}$\n\nSquare each factor in the bracket, combine indices and write negative powers as reciprocals.",
          "worked": "$$\\begin{aligned}\\frac{m^{0.9}n}{(mn^{1.5})^2}\\times\\frac1{mn^{3.8}}&=\\frac{m^{0.9}n}{m^2n^3}\\times\\frac1{mn^{3.8}}\\\\\\frac{m^{0.9}n}{(mn^{1.5})^2}\\times\\frac1{mn^{3.8}}&=m^{0.9-2-1}n^{1-3-3.8}\\\\\\frac{m^{0.9}n}{(mn^{1.5})^2}\\times\\frac1{mn^{3.8}}&=m^{-2.1}n^{-5.8}\\\\\\frac{m^{0.9}n}{(mn^{1.5})^2}\\times\\frac1{mn^{3.8}}&=\\frac1{m^{2.1}n^{5.8}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
