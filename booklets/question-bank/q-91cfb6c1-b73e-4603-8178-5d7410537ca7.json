  "content": {
    "id": "p13-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A line passes through the point $(3,6)$ and has gradient $2$. Find where the line crosses the $x$-axis and the $y$-axis.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Both axes at $(0,0)$.",
      "worked": "At the $x$-axis, let the point be $(a,0)$.\n$$\\begin{align*}\\frac{6-0}{3-a}&=2\\\\6&=2(3-a)\\\\6&=6-2a\\\\a&=0\\end{align*}$$\nAt the $y$-axis, let the point be $(0,b)$.\n$$\\begin{align*}\\frac{6-b}{3-0}&=2\\\\6-b&=6\\\\b&=0\\end{align*}$$\nThe line crosses both axes at $(0,0)$.",
      "solutionDiagrams": []
    },
