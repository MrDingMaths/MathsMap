    "label": "11",
    "prompt": "If you bought 10 raffle tickets and a total of 400 were sold, what would be the probability that you won first prize?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{40}$",
      "worked": "There are 10 favourable tickets out of 400 equally likely tickets.\n\n$$\\begin{aligned}P(\\text{winning first prize})&=\\frac{10}{400}\\\\P(\\text{winning first prize})&=\\frac{1}{40}\\end{aligned}$$",
