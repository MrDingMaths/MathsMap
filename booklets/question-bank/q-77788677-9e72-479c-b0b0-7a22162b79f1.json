  "content": {
    "id": "p10-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "$\\$20\\,000$ is invested at $8\\%$ p.a. simple interest for five years.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "How much interest will be earned each year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1600$ each year.",
          "worked": "$$\\begin{align*}\\text{Annual interest}&=20\\,000\\times8\\%\\\\\\text{Annual interest}&=20\\,000\\times0.08\\\\\\text{Annual interest}&=\\$1600\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the formula $I=PRT$ to find how much interest will be earned over the five-year period.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$8000$.",
          "worked": "$$\\begin{align*}I&=PRT\\\\I&=20\\,000\\times8\\%\\times5\\\\I&=20\\,000\\times0.08\\times5\\\\I&=8000\\end{align*}$$\nThe interest earned over five years is $\\$8000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
