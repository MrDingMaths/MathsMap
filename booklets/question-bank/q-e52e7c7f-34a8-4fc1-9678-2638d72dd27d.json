    "prompt": "Complete these simplifications.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1e44d1-p8-practice-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\mathrel{\\phantom{=}}\\frac{x+2}{3}+\\frac{x+1}{6}$\n\n$=\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}(x+2)}{6}+\\frac{x+1}{6}$\n\n$=\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{12mm}}+x+1}{6}$\n\n$=\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{12mm}}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+5}{6}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{3}+\\frac{x+1}{6}&=\\frac{2(x+2)}{6}+\\frac{x+1}{6}\\\\&=\\frac{2x+4+x+1}{6}\\\\&=\\frac{3x+5}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-1e44d1-p8-practice-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\mathrel{\\phantom{=}}\\frac{4x+5}{6}-\\frac{x+1}{3}$\n\n$=\\frac{4x+5}{6}-\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}(x+1)}{6}$\n\n$=\\frac{4x+5-(\\boxed{\\rule{0pt}{3mm}\\hspace{12mm}})}{6}$\n\n$=\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{12mm}}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x+3}{6}$",
          "worked": "$$\\begin{align*}\\frac{4x+5}{6}-\\frac{x+1}{3}&=\\frac{4x+5}{6}-\\frac{2(x+1)}{6}\\\\&=\\frac{4x+5-(2x+2)}{6}\\\\&=\\frac{2x+3}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-1e44d1-p8-practice-slot-3-slot-3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3m+1}{4}+\\frac{m+2}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7m+4}{8}$",
          "worked": "$$\\begin{align*}\\frac{3m+1}{4}+\\frac{m+2}{8}&=\\frac{2(3m+1)}{8}+\\frac{m+2}{8}\\\\&=\\frac{6m+2+m+2}{8}\\\\&=\\frac{7m+4}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
