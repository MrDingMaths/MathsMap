  "content": {
    "id": "p12-q7-response",
    "type": "question",
    "label": "7",
    "prompt": "The capacity of a bottle is measured as 1.25 litres correct to the nearest 10 millilitres.\n\nWhat is the percentage error for this measurement?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.4\\%$",
      "worked": "Precision: $10\\text{ mL}$.\n\n$$\\begin{aligned}\\text{Absolute error}&=\\tfrac12\\times10\\text{ mL}=5\\text{ mL}\\\\\\text{Measurement}&=1.25\\text{ L}=1250\\text{ mL}\\\\\\text{Percentage error}&=\\frac{5}{1250}\\times100\\%=0.4\\%\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
