  "content": {
    "id": "p56-q12-root",
    "type": "question",
    "label": null,
    "prompt": "The formula for the simple interest $\\$I$ paid when a principal $\\$P$ is invested at interest rate $R$ for $n$ years is $I=nPR$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p56-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose that $R$ and $n$ are fixed. What is the relationship between $I$ and $P$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I$ varies directly with $P$.",
          "worked": "$$I=(nR)P.$$ Since $nR$ is constant, $I$ varies directly with $P$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p56-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that $I$ and $P$ are fixed. What is the relationship between $n$ and $R$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$ varies inversely with $R$.",
          "worked": "$$n=\\frac{I/P}{R}.$$ Since $\\frac{I}{P}$ is constant, $n$ varies inversely with $R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p56-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Suppose that $PR=k$ is constant so that $I=kn$. What are the units of $k$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Dollars per year.",
          "worked": "$$k=\\frac{I}{n}.$$ Interest is measured in dollars and time in years, so $k$ has units of dollars per year.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
