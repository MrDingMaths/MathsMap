        "id": "p2-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "centre $(-1,2)$ and radius $\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)^2+(y-2)^2=3$",
          "worked": "Using $(x-h)^2+(y-k)^2=r^2$:\n$$\\begin{align*}(x-(-1))^2+(y-2)^2&=(\\sqrt{3})^2\\\\(x+1)^2+(y-2)^2&=3\\end{align*}$$",
