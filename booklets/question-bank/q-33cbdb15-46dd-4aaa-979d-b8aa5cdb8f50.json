  "content": {
    "id": "p7-q21-root",
    "type": "question",
    "label": null,
    "prompt": "Let $y\\ne 0$ and suppose that $\\frac{x}{x+y}=\\frac{z}{z+y}$. Prove that $x=z$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=z$.\n\nCross multiply, cancel $xz$, then divide by $y\\ne0$.",
      "worked": "$$\\begin{align*}\nx(z+y)&=z(x+y)\\\\\nxz+xy&=zx+zy\\\\\nxy&=zy\\\\\n\\frac{xy}{y}&=\\frac{zy}{y}\\\\\nx&=z\n\\end{align*}$$\nDivision by $y$ is valid because $y\\ne0$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
