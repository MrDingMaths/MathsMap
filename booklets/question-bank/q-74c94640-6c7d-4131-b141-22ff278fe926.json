    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that a winner gets a prize more than $\\$1000$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{11}$",
          "worked": "The qualifying prizes are $\\$5000$, $\\$10\\,000$, $\\$20\\,000$, $\\$50\\,000$ and $\\$100\\,000$: five of the eleven equally likely segments.\n$$P(\\text{prize}>\\$1000)=\\frac5{11}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "In 110 spins of the Wheel of Fortune, how many winners are expected to receive a prize that is $\\$5000$ or less?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "70 winners",
          "worked": "Seven segments qualify: two $\\$0$, two $\\$100$, $\\$500$, $\\$1000$ and $\\$5000$.\n$$\\begin{align*}P(\\text{prize}\\le\\$5000)&=\\frac7{11}\\\\f&=np\\\\f&=110\\times\\frac7{11}\\\\f&=70\\end{align*}$$Expected frequency: 70 winners.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p22-q7-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p22-q7-c-stem",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Out of the first 110 winners, 104 have received a prize that is ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\$5000",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " or less.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Is there a reason to believe that the wheel may be rigged?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes. The observed 104 is much higher than the expected 70, giving reason to suspect rigging, but not proving it.",
          "worked": "The expected frequency is 70 winners. The observed frequency is 104, which is $104-70=34$ more than expected. This gives reason to suspect that the wheel may be rigged. Actual frequency can differ because of randomness, so this does not prove rigging.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
