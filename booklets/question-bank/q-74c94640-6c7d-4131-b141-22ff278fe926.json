  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Wheel of Fortune is a quiz show where winners get to spin a wheel to determine their prize. The spinner is fair and has an equal chance of landing on each segment.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p22-q7-wheel",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 22 p22-q7-wheel\"}\n\\begin{tikzpicture}[draw=black,text=black,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\foreach \\i in {0,...,10}{\\coordinate (V\\i) at ({90-360*\\i/11}:3.2);}\n\\draw (V0)--(V1)--(V2)--(V3)--(V4)--(V5)--(V6)--(V7)--(V8)--(V9)--(V10)--cycle;\n\\foreach \\i in {0,...,10}{\\draw (0,0)--(V\\i);}\n\\foreach \\i/\\prize in {0/{100\\,000},1/{500},2/{100},3/{5000},4/{0},5/{50\\,000},6/{1000},7/{10\\,000},8/{100},9/{20\\,000},10/{0}}{\n\\pgfmathsetmacro{\\angle}{90-360*(\\i+0.5)/11}\n\\pgfmathsetmacro{\\labelrotation}{\\angle}\n\\ifdim\\labelrotation pt<-90pt\\pgfmathsetmacro{\\labelrotation}{\\labelrotation+180}\\fi\n\\node[rotate=\\labelrotation] at (\\angle:2.36) {$\\$\\prize$};\n}\n\\draw[line width=0.8pt] (0,0)--(0,2.72);\n\\fill[black] (-0.17,2.62)--(0,3.01)--(0.17,2.62)--cycle;\n\\fill[black] (0,0) circle[radius=0.34];\n\\end{tikzpicture}",
