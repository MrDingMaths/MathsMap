      {
        "id": "p3-q4a",
        "type": "part",
        "label": "a",
        "prompt": "If you cut a circle into 3 equal sectors, what is the angle of the sector?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120^\\circ$",
          "worked": "The angles at the centre total $360^\\circ$, so each of the three equal sectors has angle\n$$\\begin{align*}\\text{Sector angle}&=360^\\circ\\div3\\\\\\text{Sector angle}&=120^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4b",
        "type": "part",
        "label": "b",
        "prompt": "Repeat for 5, 8 and 10 equal sectors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 sectors: $72^\\circ$; 8 sectors: $45^\\circ$; 10 sectors: $36^\\circ$.",
          "worked": "Divide the full turn of $360^\\circ$ by the number of equal sectors.\n$$\\begin{align*}\\text{Angle for 5 sectors}&=360^\\circ\\div5=72^\\circ\\\\\\text{Angle for 8 sectors}&=360^\\circ\\div8=45^\\circ\\\\\\text{Angle for 10 sectors}&=360^\\circ\\div10=36^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
