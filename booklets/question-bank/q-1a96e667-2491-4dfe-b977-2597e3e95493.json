    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the derivative of $f(x)=x^2-6x+11$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x-6$",
          "worked": "$$\\begin{align*}f'(x)&=2x-6+0\\\\f'(x)&=2x-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p15-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "Hence determine whether the curve is increasing, decreasing, or stationary at:",
        "layout": "grid",
        "columns": 5,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q1-b-x0",
            "type": "part",
            "label": "i",
            "prompt": "$x=0$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(0)=-6$: decreasing.",
              "worked": "$$\\begin{align*}f'(0)&=2(0)-6\\\\f'(0)&=-6<0\\end{align*}$$\nDecreasing at $x=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p15-q1-b-x1",
            "type": "part",
            "label": "ii",
            "prompt": "$x=1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(1)=-4$: decreasing.",
              "worked": "$$\\begin{align*}f'(1)&=2(1)-6\\\\f'(1)&=-4<0\\end{align*}$$\nDecreasing at $x=1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p15-q1-b-x3",
            "type": "part",
            "label": "iii",
            "prompt": "$x=3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(3)=0$: stationary.",
              "worked": "$$\\begin{align*}f'(3)&=2(3)-6\\\\f'(3)&=0\\end{align*}$$\nStationary at $x=3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p15-q1-b-x4",
            "type": "part",
            "label": "iv",
            "prompt": "$x=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(4)=2$: increasing.",
              "worked": "$$\\begin{align*}f'(4)&=2(4)-6\\\\f'(4)&=2>0\\end{align*}$$\nIncreasing at $x=4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p15-q1-b-xminus1",
            "type": "part",
            "label": "v",
            "prompt": "$x=-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f'(-1)=-8$: decreasing.",
              "worked": "$$\\begin{align*}f'(-1)&=2(-1)-6\\\\f'(-1)&=-8<0\\end{align*}$$\nDecreasing at $x=-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
