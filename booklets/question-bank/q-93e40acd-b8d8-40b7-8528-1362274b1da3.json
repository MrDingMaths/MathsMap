  "content": {
    "id": "p19-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Evaluate the following, and write each result using scientific notation:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{2.5\\times10^7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\times10^3$",
          "worked": "$$\\begin{align*}\\sqrt{2.5\\times10^7}&=\\sqrt{25\\times10^6}\\\\\\sqrt{2.5\\times10^7}&=\\sqrt{25}\\times\\sqrt{10^6}\\\\\\sqrt{2.5\\times10^7}&=5\\times10^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{1.6\\times10^9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\times10^4$",
          "worked": "$$\\begin{align*}\\sqrt{1.6\\times10^9}&=\\sqrt{16\\times10^8}\\\\\\sqrt{1.6\\times10^9}&=\\sqrt{16}\\times\\sqrt{10^8}\\\\\\sqrt{1.6\\times10^9}&=4\\times10^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{8.1\\times10^{11}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\times10^5$",
          "worked": "$$\\begin{align*}\\sqrt{8.1\\times10^{11}}&=\\sqrt{81\\times10^{10}}\\\\\\sqrt{8.1\\times10^{11}}&=\\sqrt{81}\\times\\sqrt{10^{10}}\\\\\\sqrt{8.1\\times10^{11}}&=9\\times10^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{8\\times10^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times10^2$",
          "worked": "$$\\begin{align*}\\sqrt[3]{8\\times10^6}&=\\sqrt[3]{8}\\times\\sqrt[3]{10^6}\\\\\\sqrt[3]{8\\times10^6}&=2\\times10^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p19-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt[3]{2.7\\times10^{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\times10^3$",
          "worked": "$$\\begin{align*}\\sqrt[3]{2.7\\times10^{10}}&=\\sqrt[3]{27\\times10^9}\\\\\\sqrt[3]{2.7\\times10^{10}}&=\\sqrt[3]{27}\\times\\sqrt[3]{10^9}\\\\\\sqrt[3]{2.7\\times10^{10}}&=3\\times10^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt[3]{1.25\\times10^{11}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\times10^3$",
          "worked": "$$\\begin{align*}\\sqrt[3]{1.25\\times10^{11}}&=\\sqrt[3]{125\\times10^9}\\\\\\sqrt[3]{1.25\\times10^{11}}&=\\sqrt[3]{125}\\times\\sqrt[3]{10^9}\\\\\\sqrt[3]{1.25\\times10^{11}}&=5\\times10^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
