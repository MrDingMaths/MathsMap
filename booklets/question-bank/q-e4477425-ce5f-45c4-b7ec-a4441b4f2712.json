  "content": {
    "id": "p30-q11-root",
    "type": "question",
    "label": null,
    "prompt": "Find the coordinates of the points of intersection of the parabola $y=(x-4)^2$ and the line $y=9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(1,9)$ and $(7,9)$.",
      "worked": "At each intersection the two expressions for $y$ are equal.\n$$\\begin{align*}(x-4)^2&=9\\\\x-4&=\\pm3\\\\x&=4\\pm3\\\\x&=1\\text{ or }7.\\end{align*}$$\nBoth points have $y=9$, so the intersection points are $(1,9)$ and $(7,9)$.",
      "solutionDiagrams": []
    },
