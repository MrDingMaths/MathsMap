  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Two positive numbers differ by 3 and the sum of their squares is 117.\nFind the numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6$ and $9$",
      "worked": "Let the smaller number be $x$, so the larger is $x+3$.\n$$\\begin{align*}x^2+(x+3)^2&=117\\\\2x^2+6x+9&=117\\\\x^2+3x-54&=0\\\\(x+9)(x-6)&=0\\\\x&=-9\\text{ or }6.\\end{align*}$$\nSince both numbers are positive, $x=6$. The numbers are $6$ and $9$. Check: $9-6=3$ and $6^2+9^2=117$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
