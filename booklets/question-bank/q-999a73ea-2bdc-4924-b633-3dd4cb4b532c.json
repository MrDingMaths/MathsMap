  "content": {
    "id": "p19-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A rectangle has area $72\\text{ cm}^2$. The lengths of the sides are integers,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the possible lengths of the sides of the rectangle in centimetres,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,72)$, $(2,36)$, $(3,24)$, $(4,18)$, $(6,12)$ and $(8,9)$ cm.",
          "worked": "The side lengths satisfy $lw=72$. The positive factor pairs are $(1,72)$, $(2,36)$, $(3,24)$, $(4,18)$, $(6,12)$ and $(8,9)$, all in centimetres. Reversing a pair gives the same rectangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the connection to the factors of 72?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The possible side lengths are factor pairs of 72.",
          "worked": "Each pair consists of two positive integer factors whose product is $72$, because $A=lw$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
