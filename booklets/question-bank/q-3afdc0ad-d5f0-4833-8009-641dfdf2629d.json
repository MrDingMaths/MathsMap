  "content": {
    "id": "p2-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the first three terms of the sequence whose rule is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$a_n=3n+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5,8,11$",
          "worked": "$$\\begin{align*}a_1&=3(1)+2=5\\\\a_2&=3(2)+2=8\\\\a_3&=3(3)+2=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$a_n=2\\times3^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6,18,54$",
          "worked": "$$\\begin{align*}a_1&=2\\times3^1=6\\\\a_2&=2\\times3^2=18\\\\a_3&=2\\times3^3=54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$a_n=(3\\times2^n)+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10,16,28$",
          "worked": "$$\\begin{align*}a_1&=(3\\times2^1)+4=10\\\\a_2&=(3\\times2^2)+4=16\\\\a_3&=(3\\times2^3)+4=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$a_n=n^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,8,27$",
          "worked": "$$\\begin{align*}a_1&=1^3=1\\\\a_2&=2^3=8\\\\a_3&=3^3=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$a_n=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3,3,3$",
          "worked": "The rule is constant, so $a_1=a_2=a_3=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p2-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$a_n=\\dfrac{1}{n+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13,\\dfrac14,\\dfrac15$",
          "worked": "$$\\begin{align*}a_1&=\\frac{1}{1+2}=\\frac13\\\\a_2&=\\frac{1}{2+2}=\\frac14\\\\a_3&=\\frac{1}{3+2}=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
