    "id": "v2-80820-p11-practice-retro-slot-5-004338-root",
    "type": "question",
    "label": null,
    "prompt": "Find the radius of a sphere with volume $2750\\text{ cm}^3$, correct to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8.69\\text{ cm}$",
      "worked": "$$\\begin{align*}V&=\\frac43\\pi r^3\\\\2750&=\\frac43\\pi r^3\\\\r^3&=\\frac{2750\\times3}{4\\pi}\\\\r&=\\sqrt[3]{\\frac{8250}{4\\pi}}\\\\&\\approx8.69\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
