      {
        "id": "p10-q8-explain",
        "type": "part",
        "label": "a",
        "prompt": "Explain why she has made a mistake.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Dividing by $x$ excludes $x=0$, so she loses a solution.",
          "worked": "Dividing by $x$ assumes $x\\ne0$, because division by zero is undefined. However, $x=0$ satisfies the original equation, so this division loses that solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q8-solve",
        "type": "part",
        "label": "b",
        "prompt": "Hence solve $x^3+3x^2+2x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,-2,-1$.",
          "worked": "$$\\begin{align*}x(x^2+3x+2)&=0\\\\x(x+1)(x+2)&=0\\end{align*}$$\nBy the null factor law, $x=0$, $x+1=0$ or $x+2=0$.\n$$x=0,-1,-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
