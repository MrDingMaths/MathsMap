    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1260$",
      "worked": "There are 9 letters, with multiplicities 2, 3 and 4.\n$$\\begin{align*}N&=\\frac{9!}{2!3!4!}\\\\N&=1260\\end{align*}$$",
