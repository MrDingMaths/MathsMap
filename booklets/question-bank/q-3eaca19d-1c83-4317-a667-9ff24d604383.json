        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=\\sin^{-1}x$ is dilated by a factor of $2$ from the $x$-axis, then translated $3$ units right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2\\sin^{-1}(x-3)$",
          "worked": "$$\\begin{aligned}y&=2\\sin^{-1}x&&\\text{(dilation from the }x\\text{-axis)}\\\\y&=2\\sin^{-1}(x-3)&&\\text{(translation right)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-03008-p17-practice-slot-8-slot-8-b",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=\\cos^{-1}x$ is dilated by a factor of $\\frac12$ from the $y$-axis, then translated $1$ unit up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\cos^{-1}(2x)+1$",
          "worked": "$$\\begin{aligned}y&=\\cos^{-1}(2x)&&\\text{(dilation from the }y\\text{-axis)}\\\\y&=\\cos^{-1}(2x)+1&&\\text{(translation up)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-03008-p17-practice-slot-8-slot-8-c",
        "type": "part",
        "label": "c",
        "prompt": "The graph of $y=\\tan^{-1}x$ is dilated by a factor of $3$ from the $y$-axis, then translated $2$ units right and $\\frac{\\pi}{4}$ units down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\tan^{-1}\\left(\\dfrac{x-2}{3}\\right)-\\dfrac{\\pi}{4}$",
          "worked": "$$\\begin{aligned}y&=\\tan^{-1}\\left(\\frac{x}{3}\\right)&&\\text{(dilation from the }y\\text{-axis)}\\\\y&=\\tan^{-1}\\left(\\frac{x-2}{3}\\right)&&\\text{(translation right)}\\\\y&=\\tan^{-1}\\left(\\frac{x-2}{3}\\right)-\\frac{\\pi}{4}&&\\text{(translation down)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
