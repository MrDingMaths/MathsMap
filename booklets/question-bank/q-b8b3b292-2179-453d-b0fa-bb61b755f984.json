  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Using index laws, calculate the following and express your answer in scientific notation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2 \\times 10^{3}) \\times (3 \\times 10^{6})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6 \\times 10^{9}$",
          "worked": "$$\\begin{align*}(2 \\times 10^{3}) \\times (3 \\times 10^{6}) &= (2 \\times 3) \\times 10^{3+6} \\\\ &= 6 \\times 10^{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$(7 \\times 10^{-5}) \\times (4 \\times 10^{-2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2.8 \\times 10^{-6}$. Add the exponents, then write $28 \\times 10^{-7}$ in standard form.",
          "worked": "$$\\begin{align*}(7 \\times 10^{-5}) \\times (4 \\times 10^{-2}) &= (7 \\times 4) \\times 10^{-5+(-2)} \\\\ &= 28 \\times 10^{-7} \\\\ &= 2.8 \\times 10^{-6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{8 \\times 10^{5}}{2 \\times 10^{-2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4 \\times 10^{7}$",
          "worked": "$$\\begin{align*}\\frac{8 \\times 10^{5}}{2 \\times 10^{-2}} &= \\frac{8}{2} \\times 10^{5-(-2)} \\\\ &= 4 \\times 10^{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{7 \\times 10^{-7}}{7 \\times 10^{-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1 \\times 10^{-4}$",
          "worked": "$$\\begin{align*}\\frac{7 \\times 10^{-7}}{7 \\times 10^{-3}} &= \\frac{7}{7} \\times 10^{-7-(-3)} \\\\ &= 1 \\times 10^{-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
