  "content": {
    "id": "p51-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "The equation $(k^2-1)x^2-2(k^2+1)x+(k^2-1)=0$ can yield distinct, rational solutions that are reciprocals of each other. For what values of $k$ is this true?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k\\in\\mathbb{Q}\\setminus\\{-1,0,1\\}$. The roots are $\\dfrac{k+1}{k-1}$ and $\\dfrac{k-1}{k+1}$; their product is $1$, and they are distinct when $k\\ne0$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p51-q17-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "For a quadratic, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k^2-1\\ne0",
                "display": false
              },
              {
                "type": "text",
                "text": ", so ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k\\ne\\pm1",
                "display": false
              },
              {
                "type": "text",
                "text": ". When ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k=\\pm1",
                "display": false
              },
              {
                "type": "text",
                "text": ", the equation becomes ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "-4x=0",
                "display": false
              },
              {
                "type": "text",
                "text": " and has only the solution ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p51-q17-answer-discriminant",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\Delta&=[-2(k^2+1)]^2-4(k^2-1)(k^2-1)\\\\\\Delta&=16k^2\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p51-q17-answer-formula",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The quadratic formula gives the following unordered pair of roots:",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}x&=\\frac{2(k^2+1)\\pm4k}{2(k^2-1)}\\\\x&=\\frac{k^2\\pm2k+1}{k^2-1}\\end{aligned}",
                "display": true
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}x_1&=\\frac{(k+1)^2}{(k-1)(k+1)}\\\\x_1&=\\frac{k+1}{k-1}\\\\x_2&=\\frac{(k-1)^2}{(k-1)(k+1)}\\\\x_2&=\\frac{k-1}{k+1}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p51-q17-answer-reciprocals",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "x_1x_2=1",
                "display": false
              },
              {
                "type": "text",
                "text": ", so the roots are reciprocals.",
                "marks": []
              }
            ]
          },
          {
            "id": "p51-q17-answer-distinct",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "If the roots are equal:",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{k-1}{k+1}&=\\frac{k+1}{k-1}\\\\(k-1)^2&=(k+1)^2\\\\-2k&=2k\\\\k&=0\\end{aligned}",
                "display": true
              },
              {
                "type": "text",
                "text": "Thus the roots are distinct when ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k\\ne0",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p51-q17-answer-rationality",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Rational ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k\\ne\\pm1",
                "display": false
              },
              {
                "type": "text",
                "text": " gives rational roots. Conversely, if ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "r=\\frac{k+1}{k-1}",
                "display": false
              },
              {
                "type": "text",
                "text": " is rational, then ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "r\\ne1",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k=\\frac{r+1}{r-1}",
                "display": false
              },
              {
                "type": "text",
                "text": " is rational. Therefore ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "k\\in\\mathbb{Q}\\setminus\\{-1,0,1\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
    "answerSpaceMm": 80
  },
