    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x-2$, $g(x)=x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commute: $f(g(x))=g(f(x))=x+3$.",
          "worked": "$$\\begin{align*}f(g(x))&=(x+5)-2\\\\f(g(x))&=x+3\\\\g(f(x))&=(x-2)+5\\\\g(f(x))&=x+3\\end{align*}$$\nThe functions commute under composition.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=ax$, $g(x)=bx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commute: $f(g(x))=g(f(x))=abx$.",
          "worked": "$$\\begin{align*}f(g(x))&=a(bx)\\\\f(g(x))&=abx\\\\g(f(x))&=b(ax)\\\\g(f(x))&=abx\\end{align*}$$\nThe functions commute under composition.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=3x+1$, $g(x)=2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Do not commute: $f(g(x))=6x-2$, whereas $g(f(x))=6x+1$.",
          "worked": "$$\\begin{align*}f(g(x))&=3(2x-1)+1\\\\f(g(x))&=6x-2\\\\g(f(x))&=2(3x+1)-1\\\\g(f(x))&=6x+1\\end{align*}$$\nThe compositions are different, so the functions do not commute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p16-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^m$, $g(x)=x^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Commute: $f(g(x))=g(f(x))=x^{mn}$.",
          "worked": "$$\\begin{align*}f(g(x))&=(x^n)^m\\\\f(g(x))&=x^{nm}\\\\g(f(x))&=(x^m)^n\\\\g(f(x))&=x^{mn}\\end{align*}$$\nSince $nm=mn$, the functions commute under composition.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
