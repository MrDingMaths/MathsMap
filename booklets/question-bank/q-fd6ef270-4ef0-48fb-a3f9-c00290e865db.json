  "content": {
    "id": "p29-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "$x=-2$ is the axis of symmetry of the parabola $y=2x^2-kx+1$. Find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=-8$",
      "worked": "For $y=ax^2+bx+c$, the axis of symmetry is $x=-\\frac{b}{2a}$. Here $a=2$ and $b=-k$:\n$$\\begin{align*}-2&=-\\frac{-k}{2(2)}\\\\-2&=\\frac{k}{4}\\\\k&=-8.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
  },
