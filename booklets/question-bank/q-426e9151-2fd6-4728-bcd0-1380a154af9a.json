  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$f(x)=3x^2+1$. Find the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28$",
          "worked": "$$\\begin{align*}f(-3)&=3(-3)^2+1\\\\&=28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(-a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^2+1$",
          "worked": "$$\\begin{align*}f(-a)&=3(-a)^2+1\\\\&=3a^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^4+1$",
          "worked": "$$\\begin{align*}f(a^2)&=3(a^2)^2+1\\\\&=3a^4+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12a^2+1$",
          "worked": "$$\\begin{align*}f(2a)&=3(2a)^2+1\\\\&=12a^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(\\sqrt a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a+1$",
          "worked": "$$\\begin{align*}f(\\sqrt a)&=3(\\sqrt a)^2+1\\\\&=3a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(ab)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^2b^2+1$",
          "worked": "$$\\begin{align*}f(ab)&=3(ab)^2+1\\\\&=3a^2b^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(2a-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12a^2-60a+76$",
          "worked": "$$\\begin{align*}f(2a-5)&=3(2a-5)^2+1\\\\&=3(4a^2-20a+25)+1\\\\&=12a^2-60a+76\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(1+a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3a^2+6a+4$",
          "worked": "$$\\begin{align*}f(1+a)&=3(1+a)^2+1\\\\&=3(1+2a+a^2)+1\\\\&=3a^2+6a+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p13-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$f\\left(\\dfrac ab\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3a^2}{b^2}+1$",
          "worked": "$$\\begin{align*}f\\left(\\frac ab\\right)&=3\\left(\\frac ab\\right)^2+1\\\\&=\\frac{3a^2}{b^2}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
