        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{x}{3}\\times\\frac{3}{x}&=\\frac{3x}{3x}\\\\\\frac{x}{3}\\times\\frac{3}{x}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{a}{4}\\div\\frac{a}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{a}{4}\\div\\frac{a}{2}&=\\frac{a}{4}\\times\\frac{2}{a}\\\\\\frac{a}{4}\\div\\frac{a}{2}&=\\frac{2a}{4a}\\\\\\frac{a}{4}\\div\\frac{a}{2}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2\\times\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x$",
          "worked": "$$\\begin{align*}x^2\\times\\frac{3}{x}&=\\frac{3x^2}{x}\\\\x^2\\times\\frac{3}{x}&=3x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{2b}\\times b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{2b}\\times b^2&=\\frac{b^2}{2b}\\\\\\frac{1}{2b}\\times b^2&=\\frac{b}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3x}{4}\\times\\frac{2}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2x}$",
          "worked": "$$\\begin{align*}\\frac{3x}{4}\\times\\frac{2}{x^2}&=\\frac{6x}{4x^2}\\\\\\frac{3x}{4}\\times\\frac{2}{x^2}&=\\frac{3}{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
