  "content": {
    "id": "v2-83495-p26-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "A netball player has a probability of $0.7$ of scoring each time she shoots. She takes two shots. Assuming that the two shots are independent, find the probability that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-83495-p26-practice-slot-9-s9-netball-a",
        "type": "part",
        "label": "a",
        "prompt": "she misses both shots,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.09$",
          "worked": "$$\\begin{align*}P(\\text{misses both})&=0.3\\times0.3\\\\P(\\text{misses both})&=0.09\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-83495-p26-practice-slot-9-s9-netball-b",
        "type": "part",
        "label": "b",
        "prompt": "she scores at least once.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.91$",
          "worked": "$$\\begin{align*}P(\\text{scores at least once})&=1-P(\\text{misses both})\\\\P(\\text{scores at least once})&=1-0.09\\\\P(\\text{scores at least once})&=0.91\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
