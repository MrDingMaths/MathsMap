  "content": {
    "id": "p5-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Expand each of the following. Remember to insert brackets where necessary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)(x+2)+(x+3)(x+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+10x+14$",
          "worked": "$$\\begin{align*}(x+1)(x+2)+(x+3)(x+4)&=(x^2+3x+2)+(x^2+7x+12)\\\\(x+1)(x+2)+(x+3)(x+4)&=x^2+3x+2+x^2+7x+12\\\\(x+1)(x+2)+(x+3)(x+4)&=2x^2+10x+14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$(m+n)(m+2n)+(m-2n)(m+n)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2m^2+2mn$",
          "worked": "$$\\begin{align*}(m+n)(m+2n)+(m-2n)(m+n)&=(m^2+3mn+2n^2)+(m^2-mn-2n^2)\\\\(m+n)(m+2n)+(m-2n)(m+n)&=m^2+3mn+2n^2+m^2-mn-2n^2\\\\(m+n)(m+2n)+(m-2n)(m+n)&=2m^2+2mn\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+4)(x+2)-(x+3)(x-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x+23$",
          "worked": "$$\\begin{align*}(x+4)(x+2)-(x+3)(x-5)&=(x^2+6x+8)-(x^2-2x-15)\\\\(x+4)(x+2)-(x+3)(x-5)&=x^2+6x+8-x^2+2x+15\\\\(x+4)(x+2)-(x+3)(x-5)&=8x+23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x-y)(2x+y)-(y-x)(2y-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2xy-3y^2$",
          "worked": "$$\\begin{align*}(x-y)(2x+y)-(y-x)(2y-x)&=(2x^2-xy-y^2)-(2y^2-3xy+x^2)\\\\(x-y)(2x+y)-(y-x)(2y-x)&=2x^2-xy-y^2-2y^2+3xy-x^2\\\\(x-y)(2x+y)-(y-x)(2y-x)&=x^2+2xy-3y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$(m-2)(m+4)-(m-3)(m+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}(m-2)(m+4)-(m-3)(m+5)&=(m^2+2m-8)-(m^2+2m-15)\\\\(m-2)(m+4)-(m-3)(m+5)&=m^2+2m-8-m^2-2m+15\\\\(m-2)(m+4)-(m-3)(m+5)&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(2x-3)(3x+2)-(6x-5)(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-18x+9$",
          "worked": "$$\\begin{align*}(2x-3)(3x+2)-(6x-5)(x+3)&=(6x^2-5x-6)-(6x^2+13x-15)\\\\(2x-3)(3x+2)-(6x-5)(x+3)&=6x^2-5x-6-6x^2-13x+15\\\\(2x-3)(3x+2)-(6x-5)(x+3)&=-18x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$(m-n)^2+(m+n)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2m^2+2n^2$",
          "worked": "$$\\begin{align*}(m-n)^2+(m+n)^2&=(m-n)(m-n)+(m+n)(m+n)\\\\(m-n)^2+(m+n)^2&=(m^2-2mn+n^2)+(m^2+2mn+n^2)\\\\(m-n)^2+(m+n)^2&=2m^2+2n^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p5-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$(m+n)^2-(m-n)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4mn$",
          "worked": "$$\\begin{align*}(m+n)^2-(m-n)^2&=(m+n)(m+n)-(m-n)(m-n)\\\\(m+n)^2-(m-n)^2&=(m^2+2mn+n^2)-(m^2-2mn+n^2)\\\\(m+n)^2-(m-n)^2&=m^2+2mn+n^2-m^2+2mn-n^2\\\\(m+n)^2-(m-n)^2&=4mn\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
