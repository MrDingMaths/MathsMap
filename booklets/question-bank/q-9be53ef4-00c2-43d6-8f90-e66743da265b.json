  "content": {
    "id": "p23-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "It is known that $y$ varies inversely with $x$. If $y = 6$ then $x = 8$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation $y = \\frac{k}{x}$ and calculate the constant of variation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 48$, $y = \\frac{48}{x}$.",
          "worked": "$$\\begin{align*}y &= \\frac{k}{x}\\\\6 &= \\frac{k}{8}\\\\48 &= k\\\\y &= \\frac{48}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $y$ if $x = 24$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 2$",
          "worked": "$$\\begin{align*}y &= \\frac{48}{24}\\\\y &= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $x$ if $y = 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 12$",
          "worked": "$$\\begin{align*}4 &= \\frac{48}{x}\\\\4x &= 48\\\\x &= 12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
