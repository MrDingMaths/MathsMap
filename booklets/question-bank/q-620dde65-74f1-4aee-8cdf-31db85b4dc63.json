  "content": {
    "id": "p41-k",
    "type": "question",
    "label": "k",
    "prompt": "In a sale, the price of a dress is reduced from \\$26 to \\$20.80. Work out the percentage discount.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "20% discount",
      "worked": "$$\\begin{align*}\\text{Discount} &= \\$26-\\$20.80\\\\&=\\$5.20\\\\\\text{Percentage discount} &= \\frac{5.20}{26}\\times100\\%\\\\&=20\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
