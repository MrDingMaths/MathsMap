        "type": "part",
        "label": "a",
        "prompt": "Measure the sizes of angles $\\angle AOB$, $\\angle BOC$ and $\\angle COD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle AOB=27^\\circ$, $\\angle BOC=34^\\circ$, $\\angle COD=44^\\circ$.",
          "worked": "Centre the protractor at $O$ and align its zero with the first arm of each angle. Read the scale through the second arm:\n$$\\begin{align*}\\angle AOB&=27^\\circ\\\\\\angle BOC&=34^\\circ\\\\\\angle COD&=44^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
