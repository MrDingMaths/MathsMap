  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Write each function in parametric form, using the given equation for $x$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a-node",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}3x-4y+24&=0,\\\\x&=4t\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4t,\\quad y=3t+6$",
          "worked": "$$\\begin{aligned}3(4t)-4y+24&=0\\\\12t-4y+24&=0\\\\4y&=12t+24\\\\y&=3t+6\\end{aligned}$$\nThus $x=4t$, $y=3t+6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q7-b-node",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=x^2,\\\\x&=2t-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2t-1,\\quad y=4t^2-4t+1$",
          "worked": "$$\\begin{aligned}y&=(2t-1)^2\\\\y&=4t^2-4t+1\\end{aligned}$$\nThus $x=2t-1$, $y=4t^2-4t+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q7-c-node",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x^2-3x+4,\\\\x&=1-t\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1-t,\\quad y=2t^2-t+3$",
          "worked": "$$\\begin{aligned}y&=2(1-t)^2-3(1-t)+4\\\\y&=2-4t+2t^2-3+3t+4\\\\y&=2t^2-t+3\\end{aligned}$$\nThus $x=1-t$, $y=2t^2-t+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
