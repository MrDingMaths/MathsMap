    "type": "question",
    "label": "3",
    "prompt": "The unit vector in the direction of $\\underset{\\sim}{a}$ is $\\dfrac35i+\\dfrac45j$. Find the vector $\\underset{\\sim}{a}$ if $|\\underset{\\sim}{a}|=10$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\underset{\\sim}{a}=6i+8j$",
      "worked": "$$\\begin{aligned}\\underset{\\sim}{a}&=|\\underset{\\sim}{a}|\\times\\underset{\\sim}{\\hat a}\\\\&=10\\left(\\frac35i+\\frac45j\\right)\\\\&=6i+8j\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
