    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Express the following\n$$\\frac{1}{\\log_3 x}+\\frac{1}{\\log_4 x}+\\frac{1}{\\log_5 x}$$\nin the form $\\log_x k$ for some real number $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_x 60$",
          "worked": "Swap bases, then use the product law.\n$$\\begin{align*}\\frac{1}{\\log_3 x}+\\frac{1}{\\log_4 x}+\\frac{1}{\\log_5 x}&=\\log_x 3+\\log_x 4+\\log_x 5\\\\\\frac{1}{\\log_3 x}+\\frac{1}{\\log_4 x}+\\frac{1}{\\log_5 x}&=\\log_x(3\\times4\\times5)\\\\\\frac{1}{\\log_3 x}+\\frac{1}{\\log_4 x}+\\frac{1}{\\log_5 x}&=\\log_x 60\\end{align*}$$\nThus $k=60$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p13-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify the following expression:\n$$\\frac{1}{\\log_2 n!}+\\frac{1}{\\log_3 n!}+\\frac{1}{\\log_4 n!}+\\cdots+\\frac{1}{\\log_n n!}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$\n\nSwap bases and combine the logarithms; $2\\times3\\times\\cdots\\times n=n!$.",
          "worked": "Swap bases and use $2\\times3\\times\\cdots\\times n=n!$.\n$$\\begin{align*}\\frac{1}{\\log_2 n!}+\\cdots+\\frac{1}{\\log_n n!}&=\\log_{n!}2+\\log_{n!}3+\\cdots+\\log_{n!}n\\\\\\frac{1}{\\log_2 n!}+\\cdots+\\frac{1}{\\log_n n!}&=\\log_{n!}(2\\times3\\times\\cdots\\times n)\\\\\\frac{1}{\\log_2 n!}+\\cdots+\\frac{1}{\\log_n n!}&=\\log_{n!}(n!)\\\\\\frac{1}{\\log_2 n!}+\\cdots+\\frac{1}{\\log_n n!}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
