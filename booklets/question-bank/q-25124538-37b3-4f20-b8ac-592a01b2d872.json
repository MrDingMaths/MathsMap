    "type": "question",
    "label": null,
    "prompt": "Solve the simultaneous equations\n$$\\begin{align*}2(x+1)-3(y-2)&=24\\\\\\frac{x+1}{2}-\\frac{y-1}{3}&=4\\end{align*}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=5$, $y=-2$.",
      "worked": "$$\\begin{align*}2(x+1)-3(y-2)&=24\\\\2x-3y+8&=24\\\\2x-3y&=16 &&(1)\\end{align*}$$\n$$\\begin{align*}3(x+1)-2(y-1)&=24 &&6\\times\\text{second equation}\\\\3x-2y+5&=24\\\\3x-2y&=19 &&(2)\\end{align*}$$\n$$\\begin{align*}6x-9y&=48 &&3\\times(1)\\\\6x-4y&=38 &&2\\times(2)\\end{align*}$$\nSubtract:\n$$\\begin{align*}-5y&=10\\\\y&=-2\\end{align*}$$\nSub $y=-2$ into (1):\n$$\\begin{align*}2x+6&=16\\\\x&=5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
