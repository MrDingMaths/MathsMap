  "content": {
    "id": "p27-q64-root",
    "type": "question",
    "label": "64",
    "prompt": "Assume $a>0$, $b>0$ and $x>0$. Solve $(ax)^{\\ln a}=(bx)^{\\ln b}$ for $x$.",
