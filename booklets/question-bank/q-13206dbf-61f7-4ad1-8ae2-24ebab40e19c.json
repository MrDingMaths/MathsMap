  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=\\dfrac{3^x+3^{-x}}{2}$. Show that $f(2x)=2[f(x)]^2-1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2[f(x)]^2-1=\\dfrac{3^{2x}+3^{-2x}}{2}=f(2x)$.",
      "worked": "$$\\begin{align*}2[f(x)]^2-1&=2\\left(\\frac{3^x+3^{-x}}{2}\\right)^2-1\\\\2[f(x)]^2-1&=\\frac{3^{2x}+2+3^{-2x}}{2}-1\\\\2[f(x)]^2-1&=\\frac{3^{2x}+3^{-2x}}{2}\\\\2[f(x)]^2-1&=f(2x).\\end{align*}$$",
      "solutionDiagrams": []
    },
