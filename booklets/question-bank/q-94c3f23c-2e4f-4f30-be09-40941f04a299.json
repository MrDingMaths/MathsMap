  "content": {
    "id": "p18-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "When a group of 500 people were asked to name their favourite sport $34\\%$ responded ‘only football’ and $26\\%$ responded ‘only cricket’.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many people responded ‘only football’?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "170 people",
          "worked": "$$\\begin{align*}34\\%\\text{ of }500&=\\frac{34}{100}\\times500\\\\34\\%\\text{ of }500&=170\\end{align*}$$\n170 people responded ‘only football’.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many people responded ‘only cricket’?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "130 people",
          "worked": "$$\\begin{align*}26\\%\\text{ of }500&=\\frac{26}{100}\\times500\\\\26\\%\\text{ of }500&=130\\end{align*}$$\n130 people responded ‘only cricket’.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "How many people did not respond ‘only cricket’ or ‘only football’?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "200 people",
          "worked": "The two groups do not overlap and refer to the same 500 people.\n$$\\begin{align*}\\text{Percentage in neither group}&=100\\%-34\\%-26\\%\\\\\\text{Percentage in neither group}&=40\\%\\\\40\\%\\text{ of }500&=\\frac{40}{100}\\times500\\\\40\\%\\text{ of }500&=200\\end{align*}$$\n200 people gave neither response.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
