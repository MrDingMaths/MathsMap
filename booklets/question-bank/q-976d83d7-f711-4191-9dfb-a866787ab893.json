          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}\\operatorname{GCD}(km,kn)&=k\\operatorname{GCD}(m,n)\\\\\\operatorname{LCM}(km,kn)&=k\\operatorname{LCM}(m,n)\\end{aligned}",
              "display": true
            }
          ]
