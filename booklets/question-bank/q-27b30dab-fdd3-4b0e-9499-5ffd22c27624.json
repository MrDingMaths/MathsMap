  "content": {
    "id": "p68-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "If $p^{2}=p+1$, find $p^{3}$ in terms of $p$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2p+1$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p68-q11-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}p^{3}&=p^{2}\\times p\\\\p^{3}&=(p+1)p\\\\p^{3}&=p^{2}+p\\\\p^{3}&=(p+1)+p\\\\p^{3}&=2p+1\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
