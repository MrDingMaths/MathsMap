  "content": {
    "id": "p31-q32-group-root",
    "type": "question",
    "label": "7",
    "prompt": "Rewrite each monic quadratic expression in completed square form, $(x+h)^2+k$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q32-root",
        "type": "part",
        "label": "a",
        "prompt": "$$x^2+6x+4$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)^2-5$",
          "worked": "$$\\begin{align*}x^2+6x+4&=(x+3)^2-9+4\\\\x^2+6x+4&=(x+3)^2-5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p31-q33-root",
        "type": "part",
        "label": "b",
        "prompt": "$$x^2-10x+21$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)^2-4$",
          "worked": "$$\\begin{align*}x^2-10x+21&=(x-5)^2-25+21\\\\x^2-10x+21&=(x-5)^2-4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p31-q34-root",
        "type": "part",
        "label": "c",
        "prompt": "$$x^2+x-1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(x+\\frac12\\right)^2-\\frac54$",
          "worked": "$$\\begin{align*}x^2+x-1&=\\left(x+\\frac12\\right)^2-\\frac14-1\\\\x^2+x-1&=\\left(x+\\frac12\\right)^2-\\frac54.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p31-q35-root",
        "type": "part",
        "label": "d",
        "prompt": "$$x^2+8x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2-16$",
          "worked": "Half of $8$ is $4$; balance the added constant $4^2=16$.\n$$x^2+8x=(x+4)^2-16.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
