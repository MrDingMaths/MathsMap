    "children": [
      {
        "id": "p57-q21-root",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-7x+10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,5$",
          "worked": "$$(x-2)(x-5)=0.$$\nBy the null factor law, $x-2=0$ or $x-5=0$.\n$$x=2\\text{ or }x=5.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p57-q22-root",
        "type": "part",
        "label": "b",
        "prompt": "$4x^2-12x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac12,\\dfrac52$.\n\nFactorise as $(2x-1)(2x-5)=0$ and use the null factor law.",
          "worked": "$$\\begin{align*}4x^2-12x+5&=4x^2-10x-2x+5\\\\4x^2-12x+5&=2x(2x-5)-(2x-5)\\\\4x^2-12x+5&=(2x-1)(2x-5).\\end{align*}$$\nThus $(2x-1)(2x-5)=0$. By the null factor law, $2x-1=0$ or $2x-5=0$.\n$$x=\\frac12\\text{ or }x=\\frac52.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p57-q23-root",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2+2x-8=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\dfrac43$.\n\nFactorise as $(3x-4)(x+2)=0$ and use the null factor law.",
          "worked": "$$\\begin{align*}3x^2+2x-8&=3x^2+6x-4x-8\\\\3x^2+2x-8&=3x(x+2)-4(x+2)\\\\3x^2+2x-8&=(3x-4)(x+2).\\end{align*}$$\nThus $(3x-4)(x+2)=0$. By the null factor law, $3x-4=0$ or $x+2=0$.\n$$x=\\frac43\\text{ or }x=-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p57-q24-root",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2+x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac32,1$.\n\nFactorise as $(2x+3)(x-1)=0$ and use the null factor law.",
          "worked": "$$\\begin{align*}2x^2+x-3&=2x^2-2x+3x-3\\\\2x^2+x-3&=2x(x-1)+3(x-1)\\\\2x^2+x-3&=(2x+3)(x-1).\\end{align*}$$\nThus $(2x+3)(x-1)=0$. By the null factor law, $2x+3=0$ or $x-1=0$.\n$$x=-\\frac32\\text{ or }x=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
