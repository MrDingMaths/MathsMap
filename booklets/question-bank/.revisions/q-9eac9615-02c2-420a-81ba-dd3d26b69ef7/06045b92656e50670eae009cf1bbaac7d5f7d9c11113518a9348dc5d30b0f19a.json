  "content": {
    "id": "p55-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A straight line is parallel to $y=10x+14$ and intersects the y-axis at $(0,-21)$. Write the equation of the line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=10x-21$",
      "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}m_{\\mathrm{orig}}&=10\\\\m_{\\mathrm{par}}&=10\\\\c_{\\mathrm{par}}&=-21\\\\y&=10x-21\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
