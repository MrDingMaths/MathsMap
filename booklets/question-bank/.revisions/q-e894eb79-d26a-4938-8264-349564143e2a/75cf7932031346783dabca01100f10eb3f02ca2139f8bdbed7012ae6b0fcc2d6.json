  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Rearrange these equations to make the variable in the bracket the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$P=2a+b\\qquad(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{P-b}{2}$",
          "worked": "$$\\begin{align*}P-b&=2a\\\\\\frac{P-b}{2}&=a\\\\a&=\\frac{P-b}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$P=2l+2b\\qquad(b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\dfrac{P-2l}{2}$",
          "worked": "$$\\begin{align*}P-2l&=2b\\\\\\frac{P-2l}{2}&=b\\\\b&=\\frac{P-2l}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$M=\\dfrac{a+b}{2}\\qquad(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2M-b$",
          "worked": "$$\\begin{align*}2M&=a+b\\\\2M-b&=a\\\\a&=2M-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$D=b^2-4ac\\qquad(c)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\dfrac{D-b^2}{-4a}$",
          "worked": "$$\\begin{align*}D-b^2&=-4ac\\\\\\frac{D-b^2}{-4a}&=c\\\\c&=\\frac{D-b^2}{-4a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$d=st\\qquad(t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{d}{s}$",
          "worked": "$$\\begin{align*}\\frac{d}{s}&=t\\\\t&=\\frac{d}{s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$A=\\pi r^2\\qquad(r)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\pm\\sqrt{\\dfrac{A}{\\pi}}$",
          "worked": "$$\\begin{align*}\\frac{A}{\\pi}&=r^2\\\\\\pm\\sqrt{\\frac{A}{\\pi}}&=r\\\\r&=\\pm\\sqrt{\\frac{A}{\\pi}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$V=\\pi r^2h\\qquad(h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{V}{\\pi r^2}$",
          "worked": "$$\\begin{align*}\\frac{V}{\\pi r^2}&=h\\\\h&=\\frac{V}{\\pi r^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$c^2=a^2+b^2\\qquad(b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\pm\\sqrt{c^2-a^2}$",
          "worked": "$$\\begin{align*}c^2-a^2&=b^2\\\\\\pm\\sqrt{c^2-a^2}&=b\\\\b&=\\pm\\sqrt{c^2-a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$Q=\\sqrt{2gh}\\qquad(h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\dfrac{Q^2}{2g}$",
          "worked": "$$\\begin{align*}Q^2&=2gh\\\\\\frac{Q^2}{2g}&=h\\\\h&=\\frac{Q^2}{2g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q6-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=\\sqrt{9-x^2}\\qquad(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt{9-y^2}$",
          "worked": "$$\\begin{align*}y^2&=9-x^2\\\\x^2&=9-y^2\\\\x&=\\pm\\sqrt{9-y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q6-k",
        "type": "part",
        "label": "k",
        "prompt": "$A=\\dfrac{h}{2}(a+b)\\qquad(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{2A}{h}-b$",
          "worked": "$$\\begin{align*}2A&=h(a+b)\\\\\\frac{2A}{h}&=a+b\\\\\\frac{2A}{h}-b&=a\\\\a&=\\frac{2A}{h}-b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q6-l",
        "type": "part",
        "label": "l",
        "prompt": "$s=ut+\\dfrac12at^2\\qquad(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{2(s-ut)}{t^2}$",
          "worked": "$$\\begin{align*}s-ut&=\\frac12at^2\\\\2(s-ut)&=at^2\\\\\\frac{2(s-ut)}{t^2}&=a\\\\a&=\\frac{2(s-ut)}{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
