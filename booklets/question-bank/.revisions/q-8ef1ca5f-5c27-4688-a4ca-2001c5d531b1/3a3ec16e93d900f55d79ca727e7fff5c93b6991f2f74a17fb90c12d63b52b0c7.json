    "difficultyReason": "Distinguishes equivalent transformations from transformations that lose sign or domain restrictions."
  },
  "content": {
    "id": "p81-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Which are equivalent to solving $\\dfrac{3}{x-2}>1$?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p81-q8-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$3>x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The original inequality has solution $2<x<5$. This alternative gives $x<5$, which incorrectly includes $x\\leq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$(5-x)(x-2)>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "For $x\\ne2$, multiply by $(x-2)^2>0$:\n$$\\begin{align*}3(x-2)&>(x-2)^2\\\\(5-x)(x-2)&>0.\\end{align*}$$\nBoth inequalities give $2<x<5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x-5}{x-2}<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Subtract 1, then multiply by $-1$ and reverse the inequality:\n$$\\begin{align*}\\frac{3}{x-2}-1&>0\\\\\\frac{5-x}{x-2}&>0\\\\\\frac{x-5}{x-2}&<0.\\end{align*}$$\nThe domain remains $x\\ne2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3}{x-2}-1>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Subtracting 1 from both sides preserves the inequality and its domain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{x-2}>\\dfrac{1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Multiplying both sides by $3>0$ gives the original inequality $\\dfrac{3}{x-2}>1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x-2}{5-x}>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "The original inequality is $\\dfrac{5-x}{x-2}>0$. Its numerator and denominator must have the same sign, so $2<x<5$. The reciprocal has the same sign and the same solution interval; $x=2,5$ are excluded in both solution sets.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x-2}{3}>1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Multiplying by $3>0$ gives $x>5$. The original solution is $2<x<5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p81-q8-part-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x-2}{3}<1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Multiplying by $3>0$ gives $x<5$, which incorrectly includes $x\\leq2$. The original solution is $2<x<5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
