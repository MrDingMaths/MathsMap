              "text": "The perimeter of a sector is 40 cm.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If the radius of the sector is 10 cm, what is the angle at the centre? Answer to 1 d.p.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$114.6^\\circ$",
      "worked": "$$\\begin{align*}P &= l+2r\\\\40 &= \\frac{\\theta}{360}\\times2\\pi(10)+2(10)\\\\40 &= \\frac{\\theta}{360}\\times20\\pi+20\\\\20 &= \\frac{\\theta}{360}\\times20\\pi\\\\7200 &= 20\\pi\\theta\\\\\\theta &= \\frac{7200}{20\\pi}\\\\\\theta &\\approx 114.6^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
