  "content": {
    "id": "p15-q25-group-root",
    "type": "question",
    "label": "6",
    "prompt": "Add or subtract the fractions and simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q25-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac3{(x+2)(x+1)}+\\frac2{x(x+2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+2}{x(x+1)(x+2)}$, $x\\ne0,-1,-2$.\n\nUse the common denominator $x(x+1)(x+2)$.",
          "worked": "$$\\begin{align*}\\frac3{(x+2)(x+1)}+\\frac2{x(x+2)}&=\\frac{3x+2(x+1)}{x(x+1)(x+2)}\\\\\\frac3{(x+2)(x+1)}+\\frac2{x(x+2)}&=\\frac{3x+2x+2}{x(x+1)(x+2)}\\\\\\frac3{(x+2)(x+1)}+\\frac2{x(x+2)}&=\\frac{5x+2}{x(x+1)(x+2)}\\end{align*}$$\nOriginal domain: $x\\ne0,-1,-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p15-q26-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x}{(x+1)(x-5)}+\\frac{2x}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x(2x-9)}{(x+1)(x-5)}$, $x\\ne-1,5$.",
          "worked": "$$\\begin{align*}\\frac{x}{(x+1)(x-5)}+\\frac{2x}{x+1}&=\\frac{x+2x(x-5)}{(x+1)(x-5)}\\\\\\frac{x}{(x+1)(x-5)}+\\frac{2x}{x+1}&=\\frac{2x^2-9x}{(x+1)(x-5)}\\\\\\frac{x}{(x+1)(x-5)}+\\frac{2x}{x+1}&=\\frac{x(2x-9)}{(x+1)(x-5)}\\end{align*}$$\nOriginal domain: $x\\ne-1,5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p15-q27-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac4{x^2-9}-\\frac3{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13-3x}{(x-3)(x+3)}$, $x\\ne-3,3$.",
          "worked": "$$\\begin{align*}\\frac4{x^2-9}-\\frac3{x+3}&=\\frac4{(x-3)(x+3)}-\\frac{3(x-3)}{(x-3)(x+3)}\\\\\\frac4{x^2-9}-\\frac3{x+3}&=\\frac{4-3x+9}{(x-3)(x+3)}\\\\\\frac4{x^2-9}-\\frac3{x+3}&=\\frac{13-3x}{(x-3)(x+3)}\\end{align*}$$\nOriginal domain: $x\\ne-3,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q28-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac2{x+3}+\\frac{4x}{(x+3)(x-3)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6(x-1)}{(x+3)(x-3)}$, $x\\ne-3,3$.",
          "worked": "$$\\begin{align*}\\frac2{x+3}+\\frac{4x}{(x+3)(x-3)}&=\\frac{2(x-3)+4x}{(x+3)(x-3)}\\\\\\frac2{x+3}+\\frac{4x}{(x+3)(x-3)}&=\\frac{6x-6}{(x+3)(x-3)}\\\\\\frac2{x+3}+\\frac{4x}{(x+3)(x-3)}&=\\frac{6(x-1)}{(x+3)(x-3)}\\end{align*}$$\nOriginal domain: $x\\ne-3,3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
