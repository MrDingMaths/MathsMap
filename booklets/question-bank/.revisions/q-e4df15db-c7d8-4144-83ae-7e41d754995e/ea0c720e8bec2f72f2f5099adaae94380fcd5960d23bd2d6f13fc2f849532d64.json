    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$(7-10)^3+21\\div -7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-30$",
          "worked": "$$\\begin{align*}(7-10)^3+21\\div -7&=(-3)^3+21\\div -7\\\\&=-27+21\\div -7\\\\&=-27+(-3)\\\\&=-30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-5)^2\\times6\\div[10\\times5\\div(-10)]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-30$",
          "worked": "$$\\begin{align*}(-5)^2\\times6\\div[10\\times5\\div(-10)]&=(-5)^2\\times6\\div[50\\div(-10)]\\\\&=(-5)^2\\times6\\div(-5)\\\\&=25\\times6\\div(-5)\\\\&=150\\div(-5)\\\\&=-30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
