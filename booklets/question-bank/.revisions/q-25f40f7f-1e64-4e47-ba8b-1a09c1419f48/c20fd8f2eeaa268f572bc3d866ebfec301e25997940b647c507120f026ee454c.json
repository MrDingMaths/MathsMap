  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5a^2}{3}\\times\\dfrac{6}{2a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5a$",
          "worked": "$$\\begin{align*}\\frac{5a^2}{3}\\times\\frac{6}{2a}&=\\frac{30a^2}{6a}\\\\&=\\frac{30a}{6}\\\\&=5a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2x^5}{2z^3}\\times\\dfrac{7z}{6x^9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{6x^4z^2}$",
          "worked": "$$\\begin{align*}\\frac{2x^5}{2z^3}\\times\\frac{7z}{6x^9}&=\\frac{14x^5z}{12x^9z^3}\\\\&=\\frac{14}{12x^4z^2}\\\\&=\\frac{7}{6x^4z^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{a^2b^4}{8}\\times\\dfrac{12}{a^2b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3b^2}{2}$",
          "worked": "$$\\begin{align*}\\frac{a^2b^4}{8}\\times\\frac{12}{a^2b^2}&=\\frac{12a^2b^4}{8a^2b^2}\\\\&=\\frac{12b^2}{8}\\\\&=\\frac{3b^2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4m^3}{3n^7}\\div\\dfrac{5m^8}{6n^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8}{5m^5n^5}$",
          "worked": "$$\\begin{align*}\\frac{4m^3}{3n^7}\\div\\frac{5m^8}{6n^2}&=\\frac{4m^3}{3n^7}\\times\\frac{6n^2}{5m^8}\\\\&=\\frac{24m^3n^2}{15m^8n^7}\\\\&=\\frac{24}{15m^5n^5}\\\\&=\\frac{8}{5m^5n^5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3x^2}{8y^5}\\div\\dfrac{15x^3}{4y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{10xy^4}$",
          "worked": "$$\\begin{align*}\\frac{3x^2}{8y^5}\\div\\frac{15x^3}{4y}&=\\frac{3x^2}{8y^5}\\times\\frac{4y}{15x^3}\\\\&=\\frac{12x^2y}{120x^3y^5}\\\\&=\\frac{12}{120xy^4}\\\\&=\\frac{1}{10xy^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p18-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{p^5q^4}{6}\\div\\dfrac{p^2q^2}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3p^3q^2}{2}$",
          "worked": "$$\\begin{align*}\\frac{p^5q^4}{6}\\div\\frac{p^2q^2}{9}&=\\frac{p^5q^4}{6}\\times\\frac{9}{p^2q^2}\\\\&=\\frac{9p^5q^4}{6p^2q^2}\\\\&=\\frac{9p^3q^2}{6}\\\\&=\\frac{3p^3q^2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
