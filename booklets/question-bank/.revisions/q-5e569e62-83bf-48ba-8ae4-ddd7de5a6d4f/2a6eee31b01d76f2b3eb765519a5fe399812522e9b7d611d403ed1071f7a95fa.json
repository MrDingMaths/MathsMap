        "label": "a",
        "prompt": "$\\left( \\frac{x^{2}}{y} \\right)^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{6}}{y^{3}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{x^{2}}{y} \\right)^{3} &= \\frac{x^{2\\times3}}{y^{3}} \\\\\n&= \\frac{x^{6}}{y^{3}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left( \\frac{m^{4}}{n^{2}} \\right)^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{m^{12}}{n^{6}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{m^{4}}{n^{2}} \\right)^{3} &= \\frac{m^{4\\times3}}{n^{2\\times3}} \\\\\n&= \\frac{m^{12}}{n^{6}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left( \\frac{x^{3}}{y^{3}} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{6}}{y^{6}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{x^{3}}{y^{3}} \\right)^{2} &= \\frac{x^{3\\times2}}{y^{3\\times2}} \\\\\n&= \\frac{x^{6}}{y^{6}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left( \\frac{a}{b^{3}} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^{2}}{b^{6}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{a}{b^{3}} \\right)^{2} &= \\frac{a^{2}}{b^{3\\times2}} \\\\\n&= \\frac{a^{2}}{b^{6}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left( \\frac{p^{2}}{q^{5}} \\right)^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{p^{8}}{q^{20}}$",
          "worked": "$$\\begin{align*}\n\\left( \\frac{p^{2}}{q^{5}} \\right)^{4} &= \\frac{p^{2\\times4}}{q^{5\\times4}} \\\\\n&= \\frac{p^{8}}{q^{20}}\n\\end{align*}$$",
          "solutionDiagrams": []
