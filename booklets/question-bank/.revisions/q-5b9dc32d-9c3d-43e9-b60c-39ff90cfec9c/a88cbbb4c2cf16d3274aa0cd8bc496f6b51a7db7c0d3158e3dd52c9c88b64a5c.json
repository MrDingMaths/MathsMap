    "answer": {
      "short": "0 goals: 3 games; 2 goals: 6 games.\n\nUse the total goals to find two-goal games, then the total games to find zero-goal games.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p7-q12-worked-separated-1",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The one-goal and three-goal games account for ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "1\\times7+3\\times4=19\\text{ goals}.",
                "display": true
              },
              {
                "type": "text",
                "text": " Zero-goal games contribute no goals, so the remaining goals come from two-goal games. ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{align*}\\text{Remaining goals}&=31-19\\\\\\text{Remaining goals}&=12\\\\\\text{Two-goal games}&=12\\div2\\\\\\text{Two-goal games}&=6\\\\\\text{Zero-goal games}&=20-7-6-4\\\\\\text{Zero-goal games}&=3\\end{align*}",
                "display": true
              },
              {
                "type": "text",
                "text": " ",
                "marks": []
              }
            ]
          },
          {
            "id": "p7-q12-check-games",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Game-count check: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "3+7+6+4=20\\text{ games}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p7-q12-check-goals",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Goal-total check: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0\\times3+1\\times7+2\\times6+3\\times4=31\\text{ goals}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
