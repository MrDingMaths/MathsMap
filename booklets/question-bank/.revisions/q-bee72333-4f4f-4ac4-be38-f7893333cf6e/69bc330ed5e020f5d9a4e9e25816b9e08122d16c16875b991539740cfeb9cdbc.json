    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.08\\text{ mm}$",
      "worked": "Convert to millimetres, then divide by 500.\n$$\\begin{align*}4\\text{ cm} &= 40\\text{ mm}\\\\\\frac{40\\text{ mm}}{500} &= 0.08\\text{ mm}\\end{align*}$$",
