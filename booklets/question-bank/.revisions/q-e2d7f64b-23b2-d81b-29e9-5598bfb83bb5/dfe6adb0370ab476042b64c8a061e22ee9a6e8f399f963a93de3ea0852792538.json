    "children": [
      {
        "id": "p57-q29-root",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{18}-\\sqrt8+\\sqrt{50}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sqrt2$",
          "worked": "$$\\begin{align*}\\sqrt{18}-\\sqrt8+\\sqrt{50}&=\\sqrt{9\\times2}-\\sqrt{4\\times2}+\\sqrt{25\\times2}\\\\\\sqrt{18}-\\sqrt8+\\sqrt{50}&=3\\sqrt2-2\\sqrt2+5\\sqrt2\\\\\\sqrt{18}-\\sqrt8+\\sqrt{50}&=6\\sqrt2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p57-q30-root",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{32}-\\sqrt8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt2$",
          "worked": "$$\\begin{align*}\\sqrt{32}-\\sqrt8&=\\sqrt{16\\times2}-\\sqrt{4\\times2}\\\\\\sqrt{32}-\\sqrt8&=4\\sqrt2-2\\sqrt2\\\\\\sqrt{32}-\\sqrt8&=2\\sqrt2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p57-q31-root",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt3$",
          "worked": "$$\\begin{align*}\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}&=\\sqrt{25\\times3}-2\\sqrt{4\\times3}+\\sqrt{9\\times3}\\\\\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}&=5\\sqrt3-4\\sqrt3+3\\sqrt3\\\\\\sqrt{75}-2\\sqrt{12}+\\sqrt{27}&=4\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p57-q32-root",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sqrt3-\\sqrt2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5-2\\sqrt6$",
          "worked": "$$\\begin{align*}(\\sqrt3-\\sqrt2)^2&=(\\sqrt3)^2-2\\sqrt3\\sqrt2+(\\sqrt2)^2\\\\(\\sqrt3-\\sqrt2)^2&=3-2\\sqrt6+2\\\\(\\sqrt3-\\sqrt2)^2&=5-2\\sqrt6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
