  "content": {
    "id": "p32-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x+1}+\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+3}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}+\\frac{1}{x+2}&=\\frac{x+2}{(x+1)(x+2)}+\\frac{x+1}{(x+1)(x+2)}\\\\&=\\frac{(x+2)+(x+1)}{(x+1)(x+2)}\\\\&=\\frac{2x+3}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x+1}-\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}-\\frac{1}{x+2}&=\\frac{x+2}{(x+1)(x+2)}-\\frac{x+1}{(x+1)(x+2)}\\\\&=\\frac{(x+2)-(x+1)}{(x+1)(x+2)}\\\\&=\\frac{1}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{x+1}+\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+3}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}+\\frac{1}{x+2}&=\\frac{x+2}{(x+1)(x+2)}+\\frac{x+1}{(x+1)(x+2)}\\\\&=\\frac{(x+2)+(x+1)}{(x+1)(x+2)}\\\\&=\\frac{2x+3}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2}{x+1}-\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+1}-\\frac{1}{x+2}&=\\frac{2(x+2)}{(x+1)(x+2)}-\\frac{x+1}{(x+1)(x+2)}\\\\&=\\frac{2x+4-(x+1)}{(x+1)(x+2)}\\\\&=\\frac{x+3}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{1}{x+1}-\\dfrac{2}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{x}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}-\\frac{2}{x+2}&=\\frac{x+2}{(x+1)(x+2)}-\\frac{2(x+1)}{(x+1)(x+2)}\\\\&=\\frac{x+2-(2x+2)}{(x+1)(x+2)}\\\\&=-\\frac{x}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{2}{x+1}-\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+1}-\\frac{1}{x+2}&=\\frac{2(x+2)}{(x+1)(x+2)}-\\frac{x+1}{(x+1)(x+2)}\\\\&=\\frac{2x+4-(x+1)}{(x+1)(x+2)}\\\\&=\\frac{x+3}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{3}{x+2}-\\dfrac{2}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+2}-\\frac{2}{x+1}&=\\frac{3(x+1)}{(x+1)(x+2)}-\\frac{2(x+2)}{(x+1)(x+2)}\\\\&=\\frac{3x+3-(2x+4)}{(x+1)(x+2)}\\\\&=\\frac{x-1}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{2}{x+2}-\\dfrac{3}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{x+4}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x+2}-\\frac{3}{x+1}&=\\frac{2(x+1)}{(x+1)(x+2)}-\\frac{3(x+2)}{(x+1)(x+2)}\\\\&=\\frac{2x+2-(3x+6)}{(x+1)(x+2)}\\\\&=-\\frac{x+4}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p32-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{3}{x+2}-\\dfrac{2}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-1}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+2}-\\frac{2}{x+1}&=\\frac{3(x+1)}{(x+1)(x+2)}-\\frac{2(x+2)}{(x+1)(x+2)}\\\\&=\\frac{3x+3-(2x+4)}{(x+1)(x+2)}\\\\&=\\frac{x-1}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
