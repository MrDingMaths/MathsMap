        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$72 280 p.a.",
          "worked": "$$\\begin{align*}\\text{Annual wage} &= \\text{Weekly pay}\\times52\\\\&= \\$1390\\times52\\\\&= \\$72\\,280\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q14-e",
        "type": "part",
        "label": "b",
        "prompt": "Convert the Recruitment job to an annual wage.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$71 884.80 p.a.",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\$38.40\\times36\\\\&= \\$1382.40\\\\\\text{Annual wage} &= \\$1382.40\\times52\\\\&= \\$71\\,884.80\\text{ p.a.}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p35-q14-f",
        "type": "part",
        "label": "c",
        "prompt": "Which job pays better in a year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "HR Specialist.",
          "worked": "The HR Specialist pays better because \\$72 280 is greater than \\$71 884.80.",
