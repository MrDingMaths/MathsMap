    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why the relative frequency of selecting a blue pen is 0.25.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Blue was selected 5 times in 20 trials, so its relative frequency is $\\frac{5}{20}=\\frac{1}{4}=0.25$.",
          "worked": "Blue was selected 5 times in 20 trials.\n$$\\begin{align*}rf&=\\frac{\\text{Frequency of blue}}{\\text{Total trials}}\\\\rf&=\\frac{5}{20}\\\\rf&=\\frac{1}{4}\\\\rf&=0.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "What is the relative frequency of selecting a pen that is",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Black?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{7}{20}=0.35$",
              "worked": "$$\\begin{align*}rf&=\\frac{\\text{Frequency of black}}{\\text{Total trials}}\\\\rf&=\\frac{7}{20}\\\\rf&=0.35\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p24-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Green?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{8}{20}=\\frac{2}{5}=0.4$",
              "worked": "$$\\begin{align*}rf&=\\frac{\\text{Frequency of green}}{\\text{Total trials}}\\\\rf&=\\frac{8}{20}\\\\rf&=\\frac{2}{5}\\\\rf&=0.4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What do you notice about the sum of your relative frequencies?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "They add to 1, or 100%.",
          "worked": "$$0.25+0.35+0.4=1$$\nThe three outcomes account for all 20 trials, so their relative frequencies add to 1, or 100%.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
