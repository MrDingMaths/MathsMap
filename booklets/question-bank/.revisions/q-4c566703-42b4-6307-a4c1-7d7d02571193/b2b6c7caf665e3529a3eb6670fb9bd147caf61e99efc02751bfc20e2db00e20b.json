  "content": {
    "id": "p39-q40-group-root",
    "type": "question",
    "label": "10",
    "prompt": "Solve the following equation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q40-response",
        "type": "part",
        "label": "a",
        "prompt": "$$x^4-2x^2-15=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt5$.",
          "worked": "Let $u=x^2$.\n$$\\begin{align*}u^2-2u-15&=0\\\\(u-5)(u+3)&=0\\\\u&=5\\text{ or }u=-3\\\\x^2&=5\\text{ or }x^2=-3.\\end{align*}$$\nReject $x^2=-3$, which has no real solution. Hence $x=\\pm\\sqrt5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p39-q41-response",
        "type": "part",
        "label": "b",
        "prompt": "$$x-6\\sqrt{x}+8=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=16$.",
          "worked": "Let $u=\\sqrt{x}\\ge0$.\n$$\\begin{align*}u^2-6u+8&=0\\\\(u-2)(u-4)&=0\\\\u&=2\\text{ or }u=4\\\\\\sqrt{x}&=2\\text{ or }\\sqrt{x}=4\\\\x&=4\\text{ or }x=16.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p39-q42-response",
        "type": "part",
        "label": "c",
        "prompt": "$$9^x-26(3^x)-27=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$.",
          "worked": "Let $u=3^x>0$, so $9^x=u^2$.\n$$\\begin{align*}u^2-26u-27&=0\\\\(u-27)(u+1)&=0\\\\u&=27\\text{ or }u=-1.\\end{align*}$$\nReject $u=-1$ because $3^x>0$.\n$$\\begin{align*}3^x&=27\\\\3^x&=3^3\\\\x&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p39-q43-response",
        "type": "part",
        "label": "d",
        "prompt": "$$4^x-5(2^x)+4=0.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ or $x=2$.",
          "worked": "Let $u=2^x>0$, so $4^x=u^2$.\n$$\\begin{align*}u^2-5u+4&=0\\\\(u-1)(u-4)&=0\\\\u&=1\\text{ or }u=4\\\\2^x&=2^0\\text{ or }2^x=2^2\\\\x&=0\\text{ or }x=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
