        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p31-q3-e",
            "type": "part",
            "label": "e",
            "prompt": "$3^x+3^x+3^x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3^{x+1}$",
              "worked": "$$\\begin{align*}3^x+3^x+3^x&=3^x(1+1+1)\\\\&=3\\times3^x\\\\&=3^{x+1}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p31-q3-f",
            "type": "part",
            "label": "f",
            "prompt": "$3^8-3^7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2\\times3^7$",
              "worked": "$$\\begin{align*}3^8-3^7&=3^7(3-1)\\\\&=2\\times3^7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p31-q3-g",
            "type": "part",
            "label": "g",
            "prompt": "$3^n+3^{n+1}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4\\times3^n$",
              "worked": "$$\\begin{align*}3^n+3^{n+1}&=3^n(1+3)\\\\&=4\\times3^n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p31-q3-h",
            "type": "part",
            "label": "h",
            "prompt": "$\\dfrac{7^n+7^{n+2}}{7^{n-1}+7^{n+1}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}\\frac{7^n+7^{n+2}}{7^{n-1}+7^{n+1}}&=\\frac{7^n(1+7^2)}{7^{n-1}(1+7^2)}\\\\&=7^{n-(n-1)}\\\\&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p31-q3-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\dfrac{2^{2n}-2^{n-1}}{2^n-2^{-1}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^n$",
              "worked": "$$\\begin{align*}\\frac{2^{2n}-2^{n-1}}{2^n-2^{-1}}&=\\frac{2^n(2^n-2^{-1})}{2^n-2^{-1}}\\\\&=2^n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p31-q3-j",
            "type": "part",
            "label": "j",
            "prompt": "$\\dfrac{5^n-5^{n+1}}{5^{n+1}+5^n}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\dfrac{2}{3}$",
              "worked": "$$\\begin{align*}\\frac{5^n-5^{n+1}}{5^{n+1}+5^n}&=\\frac{5^n(1-5)}{5^n(5+1)}\\\\&=-\\frac{4}{6}\\\\&=-\\frac{2}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p31-q3-k",
            "type": "part",
            "label": "k",
            "prompt": "$5^n-5^{n-3}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$124\\times5^{n-3}$",
              "worked": "$$\\begin{align*}5^n-5^{n-3}&=5^{n-3}(5^3-1)\\\\&=124\\times5^{n-3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p31-q3-l",
            "type": "part",
            "label": "l",
            "prompt": "$\\dfrac{7^n+7^{n+2}}{7^{n-1}+7^{n+1}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7$",
              "worked": "$$\\begin{align*}\\frac{7^n+7^{n+2}}{7^{n-1}+7^{n+1}}&=\\frac{7^n(1+7^2)}{7^{n-1}(1+7^2)}\\\\&=7^{n-(n-1)}\\\\&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p31-q3-m",
            "type": "part",
            "label": "m",
            "prompt": "$\\dfrac{2^{2n}-2^{n-1}}{2^n-2^{-1}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^n$",
              "worked": "$$\\begin{align*}\\frac{2^{2n}-2^{n-1}}{2^n-2^{-1}}&=\\frac{2^n(2^n-2^{-1})}{2^n-2^{-1}}\\\\&=2^n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          },
          {
            "id": "p31-q3-n",
            "type": "part",
            "label": "n",
            "prompt": "$\\dfrac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{16}{3\\times2^n}$",
              "worked": "$$\\begin{align*}\\frac{2^{n+3}-4\\times2^n}{2^{2n}-4^{n-1}}&=\\frac{2^n(8-4)}{2^{2n}-2^{2n-2}}\\\\&=\\frac{4\\times2^n}{2^{2n-2}(4-1)}\\\\&=\\frac{2^{4-n}}{3}\\\\&=\\frac{16}{3\\times2^n}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p31-q3-o",
            "type": "part",
            "label": "o",
            "prompt": "$\\dfrac{2^{n+1}}{(2^n)^{n+1}}\\div\\dfrac{(2^{2n+1})^{n-1}}{4^n}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^{-3n^2+3n+2}$",
              "worked": "$$\\begin{align*}\\frac{2^{n+1}}{(2^n)^{n+1}}\\div\\frac{(2^{2n+1})^{n-1}}{4^n}&=\\frac{2^{n+1}}{2^{n(n+1)}}\\times\\frac{2^{2n}}{2^{(2n+1)(n-1)}}\\\\&=2^{n+1-n(n+1)+2n-(2n+1)(n-1)}\\\\&=2^{n+1-n^2-n+2n-(2n^2-n-1)}\\\\&=2^{-3n^2+3n+2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 52
          },
          {
            "id": "p31-q3-p",
            "type": "part",
            "label": "p",
            "prompt": "$\\dfrac{a^2x^m-b^2x^{m+4}}{a-bx^2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^m(a+bx^2)$",
              "worked": "$$\\begin{align*}\\frac{a^2x^m-b^2x^{m+4}}{a-bx^2}&=\\frac{x^m(a^2-b^2x^4)}{a-bx^2}\\\\&=\\frac{x^m(a-bx^2)(a+bx^2)}{a-bx^2}\\\\&=x^m(a+bx^2)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
