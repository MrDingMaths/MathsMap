  "content": {
    "id": "p16-q33-group-root",
    "type": "question",
    "label": "11",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q33-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{4m^2-36}{2m}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(m-3)(m+3)}{m}$, $m\\in\\mathbb R\\setminus\\{0\\}$.",
          "worked": "$$\\begin{align*}\\frac{4m^2-36}{2m}&=\\frac{4(m-3)(m+3)}{2m}\\\\\\frac{4m^2-36}{2m}&=\\frac{2(m-3)(m+3)}{m}\\end{align*}$$\nOriginal domain: $m\\in\\mathbb R\\setminus\\{0\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q34-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{4x^2-9y^2}{2x^2+3xy}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x-3y}{x}$, for real $x,y$ with $x\\ne0$ and $2x+3y\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{4x^2-9y^2}{2x^2+3xy}&=\\frac{(2x-3y)(2x+3y)}{x(2x+3y)}\\\\\\frac{4x^2-9y^2}{2x^2+3xy}&=\\frac{2x-3y}{x}\\end{align*}$$\nOriginal domain: real $x,y$ with $x\\ne0$ and $2x+3y\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p16-q35-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x^2-16}{4x-16}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{4}$, $x\\in\\mathbb R\\setminus\\{4\\}$.",
          "worked": "$$\\begin{align*}\\frac{x^2-16}{4x-16}&=\\frac{(x-4)(x+4)}{4(x-4)}\\\\\\frac{x^2-16}{4x-16}&=\\frac{x+4}{4}\\end{align*}$$\nOriginal domain: $x\\in\\mathbb R\\setminus\\{4\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q36-response",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{9p^2-81q^2}{3p-9q}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(p+3q)$, for real $p,q$ with $p\\ne3q$.",
          "worked": "$$\\begin{align*}\\frac{9p^2-81q^2}{3p-9q}&=\\frac{9(p-3q)(p+3q)}{3(p-3q)}\\\\\\frac{9p^2-81q^2}{3p-9q}&=3(p+3q)\\end{align*}$$\nOriginal domain: real $p,q$ with $p\\ne3q$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q37-response",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{4}{2x+1}-\\frac{2x-1}{4x^2-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2x+1}$, $x\\in\\mathbb R\\setminus\\{-\\tfrac12,\\tfrac12\\}$.",
          "worked": "$$\\begin{align*}\\frac{4}{2x+1}-\\frac{2x-1}{4x^2-1}&=\\frac{4}{2x+1}-\\frac{2x-1}{(2x-1)(2x+1)}\\\\\\frac{4}{2x+1}-\\frac{2x-1}{4x^2-1}&=\\frac{4}{2x+1}-\\frac{1}{2x+1}\\\\\\frac{4}{2x+1}-\\frac{2x-1}{4x^2-1}&=\\frac{3}{2x+1}\\end{align*}$$\nOriginal domain: $x\\in\\mathbb R\\setminus\\{-\\tfrac12,\\tfrac12\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-q38-response",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{3a}{4a-4}-\\frac{1}{a-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3a-4}{4(a-1)}$, $a\\in\\mathbb R\\setminus\\{1\\}$.",
          "worked": "$$\\begin{align*}\\frac{3a}{4a-4}-\\frac{1}{a-1}&=\\frac{3a}{4(a-1)}-\\frac{4}{4(a-1)}\\\\\\frac{3a}{4a-4}-\\frac{1}{a-1}&=\\frac{3a-4}{4(a-1)}\\end{align*}$$\nOriginal domain: $a\\in\\mathbb R\\setminus\\{1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q39-response",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{m+1}{m^2-m}-\\frac{2}{m-1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac1m$, $m\\in\\mathbb R\\setminus\\{0,1\\}$.",
          "worked": "$$\\begin{align*}\\frac{m+1}{m^2-m}-\\frac{2}{m-1}&=\\frac{m+1-2m}{m(m-1)}\\\\\\frac{m+1}{m^2-m}-\\frac{2}{m-1}&=\\frac{-(m-1)}{m(m-1)}\\\\\\frac{m+1}{m^2-m}-\\frac{2}{m-1}&=-\\frac1m\\end{align*}$$\nOriginal domain: $m\\in\\mathbb R\\setminus\\{0,1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p16-q40-response",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{x-1}{x+1}-\\frac{x-1}{1-x^2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{x+1}$, $x\\in\\mathbb R\\setminus\\{-1,1\\}$.",
          "worked": "$$\\begin{align*}\\frac{x-1}{x+1}-\\frac{x-1}{1-x^2}&=\\frac{x-1}{x+1}+\\frac{x-1}{(x-1)(x+1)}\\\\\\frac{x-1}{x+1}-\\frac{x-1}{1-x^2}&=\\frac{x-1}{x+1}+\\frac1{x+1}\\\\\\frac{x-1}{x+1}-\\frac{x-1}{1-x^2}&=\\frac{x}{x+1}\\end{align*}$$\nOriginal domain: $x\\in\\mathbb R\\setminus\\{-1,1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-q41-response",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac5{2x-3}-\\frac2{(2x-3)(x+3)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x+13}{(2x-3)(x+3)}$, $x\\in\\mathbb R\\setminus\\{\\tfrac32,-3\\}$.",
          "worked": "$$\\begin{align*}\\frac5{2x-3}-\\frac2{(2x-3)(x+3)}&=\\frac{5(x+3)-2}{(2x-3)(x+3)}\\\\\\frac5{2x-3}-\\frac2{(2x-3)(x+3)}&=\\frac{5x+13}{(2x-3)(x+3)}\\end{align*}$$\nOriginal domain: $x\\in\\mathbb R\\setminus\\{\\tfrac32,-3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-q42-response",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac3{a+4}+\\frac1{(a-2)(a+4)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3a-5}{(a+4)(a-2)}$, $a\\in\\mathbb R\\setminus\\{-4,2\\}$.",
          "worked": "$$\\begin{align*}\\frac3{a+4}+\\frac1{(a-2)(a+4)}&=\\frac{3(a-2)+1}{(a-2)(a+4)}\\\\\\frac3{a+4}+\\frac1{(a-2)(a+4)}&=\\frac{3a-5}{(a-2)(a+4)}\\end{align*}$$\nOriginal domain: $a\\in\\mathbb R\\setminus\\{-4,2\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p16-q43-response",
        "type": "part",
        "label": "k",
        "prompt": "$$\\frac{2x^2-2}{(x+2)(x-1)}\\times\\frac{x+2}{x+1}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$, $x\\in\\mathbb R\\setminus\\{-2,-1,1\\}$.",
          "worked": "$$\\begin{align*}\\frac{2x^2-2}{(x+2)(x-1)}\\times\\frac{x+2}{x+1}&=\\frac{2(x-1)(x+1)}{(x+2)(x-1)}\\times\\frac{x+2}{x+1}\\\\\\frac{2x^2-2}{(x+2)(x-1)}\\times\\frac{x+2}{x+1}&=2\\end{align*}$$\nOriginal domain: $x\\in\\mathbb R\\setminus\\{-2,-1,1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p16-q44-response",
        "type": "part",
        "label": "l",
        "prompt": "$$\\frac{a^2-1}{(a-3)(a-1)}\\times\\frac{4a-12}{(a+3)(a-1)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4(a+1)}{(a+3)(a-1)}$, $a\\in\\mathbb R\\setminus\\{-3,1,3\\}$.",
          "worked": "$$\\begin{align*}\\frac{a^2-1}{(a-3)(a-1)}\\times\\frac{4a-12}{(a+3)(a-1)}&=\\frac{(a-1)(a+1)}{(a-3)(a-1)}\\times\\frac{4(a-3)}{(a+3)(a-1)}\\\\\\frac{a^2-1}{(a-3)(a-1)}\\times\\frac{4a-12}{(a+3)(a-1)}&=\\frac{4(a+1)}{(a+3)(a-1)}\\end{align*}$$\nOriginal domain: $a\\in\\mathbb R\\setminus\\{-3,1,3\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p16-q45-response",
        "type": "part",
        "label": "m",
        "prompt": "$$\\frac{3y^2-6y}{(y-2)(y+1)}\\div\\frac{6y}{3y+6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(y+2)}{2(y+1)}$, $y\\in\\mathbb R\\setminus\\{-2,-1,0,2\\}$.",
          "worked": "$$\\begin{align*}\\frac{3y^2-6y}{(y-2)(y+1)}\\div\\frac{6y}{3y+6}&=\\frac{3y^2-6y}{(y-2)(y+1)}\\times\\frac{3y+6}{6y}\\\\\\frac{3y^2-6y}{(y-2)(y+1)}\\div\\frac{6y}{3y+6}&=\\frac{3y(y-2)}{(y-2)(y+1)}\\times\\frac{3(y+2)}{6y}\\\\\\frac{3y^2-6y}{(y-2)(y+1)}\\div\\frac{6y}{3y+6}&=\\frac{3(y+2)}{2(y+1)}\\end{align*}$$\nOriginal domain: $y\\in\\mathbb R\\setminus\\{-2,-1,0,2\\}$. The divisor must be defined and nonzero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p16-q46-response",
        "type": "part",
        "label": "n",
        "prompt": "$$\\frac{2x-1}{(x-1)(x+2)}+\\frac{3x}{x+2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x^2-x-1}{(x+2)(x-1)}$, $x\\in\\mathbb R\\setminus\\{-2,1\\}$.",
          "worked": "$$\\begin{align*}\\frac{2x-1}{(x-1)(x+2)}+\\frac{3x}{x+2}&=\\frac{2x-1+3x(x-1)}{(x-1)(x+2)}\\\\\\frac{2x-1}{(x-1)(x+2)}+\\frac{3x}{x+2}&=\\frac{3x^2-x-1}{(x-1)(x+2)}\\end{align*}$$\nOriginal domain: $x\\in\\mathbb R\\setminus\\{-2,1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
