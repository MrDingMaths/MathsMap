      {
        "id": "p53-q56-root",
        "type": "part",
        "label": "a",
        "prompt": "Positive even numbers or negative odd numbers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{n\\in\\mathbb Z\\text{ where }n>0\\text{ and }n\\text{ is even}\\}\\cup\\{n\\in\\mathbb Z\\text{ where }n<0\\text{ and }n\\text{ is odd}\\}$",
          "worked": "Use union for “or”, retaining both strict sign restrictions:\n$$\\{n\\in\\mathbb Z\\text{ where }n>0\\text{ and }n\\text{ is even}\\}\\cup\\{n\\in\\mathbb Z\\text{ where }n<0\\text{ and }n\\text{ is odd}\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p53-q57-root",
        "type": "part",
        "label": "b",
        "prompt": "Non-integer real numbers from $0$ to $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,1)\\cup(1,2)$",
          "worked": "Exclude the integers $0$, $1$ and $2$. The remaining real numbers form the two open intervals:\n$$(0,1)\\cup(1,2).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p53-q58-root",
        "type": "part",
        "label": "c",
        "prompt": "Non-integer real numbers from $0$ to $200$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[0,200]\\cap\\overline{\\mathbb Z}$, with complement relative to $\\mathbb R$.",
          "worked": "Take $U=\\mathbb R$. The non-integer reals form $\\overline{\\mathbb Z}$. Restrict them to the stated interval:\n$$[0,200]\\cap\\overline{\\mathbb Z}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p53-q59-root",
        "type": "part",
        "label": "d",
        "prompt": "Real numbers except $1$ and $-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,-1)\\cup(-1,1)\\cup(1,\\infty)$",
          "worked": "Split the real line at the two excluded values. All finite endpoints are open:\n$$(-\\infty,-1)\\cup(-1,1)\\cup(1,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p53-q60-root",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p53-q60-description",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Real numbers that are ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "not",
                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": " odd multiples of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\dfrac{\\pi}{2}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbb R\\cap\\overline{\\left\\{\\dfrac{(2n+1)\\pi}{2}\\text{ where }n\\in\\mathbb Z\\right\\}}$, with complement relative to $\\mathbb R$.\n\nWrite odd integers as $2n+1$ and exclude their multiples of $\\frac{\\pi}{2}$.",
          "worked": "Every odd integer has the form $2n+1$, where $n\\in\\mathbb Z$. The excluded values therefore form $\\{\\frac{(2n+1)\\pi}{2}\\text{ where }n\\in\\mathbb Z\\}$. With $U=\\mathbb R$, the required set is\n$$\\mathbb R\\cap\\overline{\\left\\{\\frac{(2n+1)\\pi}{2}\\text{ where }n\\in\\mathbb Z\\right\\}}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p53-q61-root",
        "type": "part",
        "label": "f",
        "prompt": "Rational numbers greater than $\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathbb Q\\cap(\\pi,\\infty)$",
          "worked": "Require both rational membership and $x>\\pi$:\n$$\\mathbb Q\\cap(\\pi,\\infty).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
