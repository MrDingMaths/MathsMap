        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(3x+2)$",
          "worked": "The cross terms are $4x-3x=x$, and $(-1)2=-2$.\n$$6x^2+x-2=(2x-1)(3x+2).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p31-q19-root",
        "type": "part",
        "label": "f",
        "prompt": "$$3x^2-13x+14$$",
