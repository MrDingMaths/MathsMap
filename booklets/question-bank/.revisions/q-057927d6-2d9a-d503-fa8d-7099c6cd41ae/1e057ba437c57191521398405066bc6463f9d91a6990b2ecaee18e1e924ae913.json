    "label": "10",
    "prompt": "Rationalise the denominator of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q41-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2}{1+\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}-1$\n\nMultiply numerator and denominator by $1-\\sqrt{3}$.",
          "worked": "$$\\begin{align*}\\frac{2}{1+\\sqrt{3}}&=\\frac{2}{1+\\sqrt{3}}\\times\\frac{1-\\sqrt{3}}{1-\\sqrt{3}}\\\\\\frac{2}{1+\\sqrt{3}}&=\\frac{2-2\\sqrt{3}}{1-3}\\\\\\frac{2}{1+\\sqrt{3}}&=\\frac{2-2\\sqrt{3}}{-2}\\\\\\frac{2}{1+\\sqrt{3}}&=\\sqrt{3}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q42-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{2-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt{3}$\n\nMultiply numerator and denominator by $2+\\sqrt{3}$.",
          "worked": "$$\\begin{align*}\\frac{1}{2-\\sqrt{3}}&=\\frac{1}{2-\\sqrt{3}}\\times\\frac{2+\\sqrt{3}}{2+\\sqrt{3}}\\\\\\frac{1}{2-\\sqrt{3}}&=\\frac{2+\\sqrt{3}}{4-3}\\\\\\frac{1}{2-\\sqrt{3}}&=2+\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
