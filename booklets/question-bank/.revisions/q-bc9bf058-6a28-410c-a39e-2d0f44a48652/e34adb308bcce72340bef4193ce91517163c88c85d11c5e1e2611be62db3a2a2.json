    "children": [
      {
        "id": "p35-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "Calculate the percentage of the whole represented by:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "English",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$40\\%$",
              "worked": "$$\\begin{align*}\\text{English percentage}&=\\frac{4}{10}\\times100\\%\\\\\\text{English percentage}&=40\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p35-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Maths",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$30\\%$",
              "worked": "$$\\begin{align*}\\text{Maths length}&=(8-5)\\text{ cm}\\\\\\text{Maths length}&=3\\text{ cm}\\\\\\text{Maths percentage}&=\\frac{3}{10}\\times100\\%\\\\\\text{Maths percentage}&=30\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p35-q8-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "History",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$20\\%$",
              "worked": "$$\\begin{align*}\\text{History length}&=(10-8)\\text{ cm}\\\\\\text{History length}&=2\\text{ cm}\\\\\\text{History percentage}&=\\frac{2}{10}\\times100\\%\\\\\\text{History percentage}&=20\\%\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p35-q8-b",
        "type": "group",
        "label": "b",
        "prompt": "If there were 30 students in the class, how many like:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q8-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Maths best?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9$ students",
              "worked": "$$\\begin{align*}\\text{Maths students}&=\\frac{3}{10}\\times30\\\\\\text{Maths students}&=9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p35-q8-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "History best?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6$ students",
              "worked": "$$\\begin{align*}\\text{History students}&=\\frac{2}{10}\\times30\\\\\\text{History students}&=6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p35-q8-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Science best?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$ students",
              "worked": "$$\\begin{align*}\\text{Science length}&=(5-4)\\text{ cm}\\\\\\text{Science length}&=1\\text{ cm}\\\\\\text{Science students}&=\\frac{1}{10}\\times30\\\\\\text{Science students}&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      }
    ]
  },
