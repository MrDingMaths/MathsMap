        "answer": {
          "short": "$P(\\text{not heads})=\\frac12$; sum $=1$.",
          "worked": "$$\\begin{align*}P(\\text{not heads})&=1-\\frac12\\\\P(\\text{not heads})&=\\frac12\\\\P(\\text{heads})+P(\\text{not heads})&=\\frac12+\\frac12\\\\P(\\text{heads})+P(\\text{not heads})&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p38-q8-row3",
        "type": "part",
        "label": "",
