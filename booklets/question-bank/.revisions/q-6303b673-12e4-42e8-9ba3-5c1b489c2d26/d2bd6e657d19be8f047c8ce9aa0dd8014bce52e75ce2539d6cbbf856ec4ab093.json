        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(\\text{2 or 5})=\\frac13$; sum $=1$.",
          "worked": "$$\\begin{align*}P(\\text{2 or 5})&=1-\\frac23\\\\P(\\text{2 or 5})&=\\frac13\\\\P(\\text{event})+P(\\text{not event})&=\\frac13+\\frac23\\\\P(\\text{event})+P(\\text{not event})&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p38-q8-row4",
        "type": "part",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(\\text{vowel})=\\frac25$; $P(\\text{not vowel})=\\frac35$; sum $=1$.",
          "worked": "The vowels are E and A. Each letter is equally likely to be selected.\n$$\\begin{align*}P(\\text{vowel})&=\\frac25\\\\P(\\text{not vowel})&=1-\\frac25\\\\P(\\text{not vowel})&=\\frac35\\\\P(\\text{vowel})+P(\\text{not vowel})&=\\frac25+\\frac35\\\\P(\\text{vowel})+P(\\text{not vowel})&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
