  "content": {
    "id": "p101-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "There are 50 black sheep and 42 white sheep in a paddock. How many black sheep must be removed so that $\\frac{1}{3}$ of the remaining sheep are black?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "29 black sheep",
      "worked": "The 42 white sheep remain unchanged. If $\\frac{1}{3}$ of the remaining sheep are black, $\\frac{2}{3}$ are white.\n\n$$\\begin{align*}\\text{Total remaining sheep} &= \\frac{42}{\\left(\\frac{2}{3}\\right)} \\\\ &= 63 \\\\ \\text{Remaining black sheep} &= 63-42 \\\\ &= 21 \\\\ \\text{Black sheep removed} &= 50-21 \\\\ &= 29\\end{align*}$$\n\nRemove 29 black sheep.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
