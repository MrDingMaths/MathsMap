  "content": {
    "id": "p46-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt[3]{59+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\sqrt[3]{59+5}&=\\sqrt[3]{64}\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p46-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt[3]{64\\times1000}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$$\\begin{align*}\\sqrt[3]{64\\times1000}&=\\sqrt[3]{64000}\\\\&=40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p46-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[3]{27}+\\sqrt[3]{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\sqrt[3]{27}+\\sqrt[3]{8}&=3+2\\\\&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p46-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{64}-4+\\sqrt{81}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}\\sqrt[3]{64}-4+\\sqrt{81}&=4-4+9\\\\&=0+9\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p46-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt[3]{125}+\\sqrt{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}\\sqrt[3]{125}+\\sqrt{100}&=5+10\\\\&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p46-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\sqrt[3]{216}-\\sqrt[3]{64}\\right)^2\\times25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100$",
          "worked": "$$\\begin{align*}\\left(\\sqrt[3]{216}-\\sqrt[3]{64}\\right)^2\\times25&=(6-4)^2\\times25\\\\&=2^2\\times25\\\\&=4\\times25\\\\&=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p46-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\sqrt[3]{5}\\right)^3+\\sqrt{25}+11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21$",
          "worked": "$$\\begin{align*}\\left(\\sqrt[3]{5}\\right)^3+\\sqrt{25}+11&=5+5+11\\\\&=10+11\\\\&=21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p46-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{\\sqrt[3]{64}}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt[3]{64}}8&=\\frac48\\\\&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
