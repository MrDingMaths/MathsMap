  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The width of a rectangle is $\\frac{3x}{5}$ cm. Its length is four times its width.\n\nWrite an expression for the area of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{36x^2}{25}\\text{ cm}^2$",
      "worked": "$$\\begin{align*}\n\\text{Length} &= 4\\times\\frac{3x}{5}=\\frac{12x}{5}\\text{ cm}\\\\\n\\text{Area} &= \\frac{3x}{5}\\times\\frac{12x}{5}\\\\\n&= \\frac{3x\\times12x}{5\\times5}\\\\\n&= \\frac{36x^2}{25}\\text{ cm}^2\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
