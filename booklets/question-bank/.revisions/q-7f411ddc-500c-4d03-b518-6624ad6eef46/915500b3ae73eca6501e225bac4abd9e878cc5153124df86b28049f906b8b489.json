  "content": {
    "id": "p11-q7",
    "type": "question",
    "label": "7",
    "prompt": "The perimeter of a rectangle of length $l$ and width $w$ is given by the formula $P = 2(l + w)$.\nUse the formula to:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "find $P$ when $l = 6$ and $w = 20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P = 52$",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ P &= 2(6+20) \\\\ P &= 52 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "find $l$ when $w = 6$ and $P = 20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l = 4$",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ 20 &= 2(l+6) \\\\ 10 &= l+6 \\\\ l &= 4 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "find $w$ when $P = 10$ and $l = 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w = 3$",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ 10 &= 2(2+w) \\\\ 5 &= 2+w \\\\ w &= 3 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "find area of a rectangle if its perimeter is 20 and width is 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l = 6$, so $A = 24$.",
          "worked": "$$\\begin{align*} P &= 2(l+w) \\\\ 20 &= 2(l+4) \\\\ 10 &= l+4 \\\\ l &= 6 \\end{align*}$$\n$$\\begin{align*} A &= lw \\\\ A &= (6)(4) \\\\ A &= 24 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 51
      },
      {
        "id": "p11-q7-bank-p11-q7-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p11-q7-bank-370e69d7-e224-4376-8c26-722539deefd6",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the area of a rectangle with perimeter 20 and width 3.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l = 7$, so $A = 21$.",
          "worked": "$$\\begin{align*}P &= 2(l+w) \\\\ 20 &= 2(l+3) \\\\ 10 &= l+3 \\\\ l &= 7\\end{align*}$$\n$$\\begin{align*}A &= lw \\\\ A &= (7)(3) \\\\ A &= 21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p11-q7-bank-p11-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "Optional: Find the area of a rectangle with perimeter 20 and width 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l = 5$, so $A = 25$.",
          "worked": "$$\\begin{align*}P &= 2(l+w) \\\\ 20 &= 2(l+5) \\\\ 10 &= l+5 \\\\ l &= 5\\end{align*}$$\n$$\\begin{align*}A &= lw \\\\ A &= (5)(5) \\\\ A &= 25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p11-q7-bank-p11-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "Optional: Do rectangles with perimeter 20 always have the same area? Explain using parts d–f.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. Parts d–f have areas $24$, $21$ and $25$, despite all having perimeter $20$.",
          "worked": "Parts d–f all have perimeter $20$, but their areas are $24$, $21$ and $25$. Equal perimeter does not determine a unique area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
