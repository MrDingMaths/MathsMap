        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20^{\\circ}$",
          "worked": "North is $90^{\\circ}$ anticlockwise from the positive $x$-axis. Subtract the clockwise bearing:\n$$\\begin{align*}\\theta&=90^{\\circ}-70^{\\circ}\\\\\\theta&=20^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$180^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$270^{\\circ}$",
          "worked": "Subtract the clockwise bearing from $90^{\\circ}$, then add a full turn to obtain the positive angle of inclination:\n$$\\begin{align*}\\theta&=90^{\\circ}-180^{\\circ}\\\\\\theta&=-90^{\\circ}+360^{\\circ}\\\\\\theta&=270^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$315^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135^{\\circ}$",
          "worked": "Subtract the clockwise bearing from $90^{\\circ}$, then add a full turn to obtain the positive angle of inclination:\n$$\\begin{align*}\\theta&=90^{\\circ}-315^{\\circ}\\\\\\theta&=-225^{\\circ}+360^{\\circ}\\\\\\theta&=135^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
