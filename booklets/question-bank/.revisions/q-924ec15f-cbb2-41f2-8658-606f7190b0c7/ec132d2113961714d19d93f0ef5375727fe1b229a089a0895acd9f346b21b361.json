      {
        "id": "index-t6-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{5w^{2}x^{5}}{25wx^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{wx^{2}}{5}$",
          "worked": "$$\\begin{align*}\n\\frac{5w^{2}x^{5}}{25wx^{3}} &= \\frac{5\\,w^{2 - 1}\\,x^{5 - 3}}{25} \\\\\n&= \\frac{wx^{2}}{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{7m^{7}y^{4}}{21m^{2}y^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{m^{5}y^{2}}{3}$",
          "worked": "$$\\begin{align*}\n\\frac{7m^{7}y^{4}}{21m^{2}y^{2}} &= \\frac{7\\,m^{7 - 2}\\,y^{4 - 2}}{21} \\\\\n&= \\frac{m^{5}y^{2}}{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{6a^{6}b^{16}}{a^{3}b^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6a^{3}b^{9}$",
          "worked": "$$\\begin{align*}\n\\frac{6a^{6}b^{16}}{a^{3}b^{7}} &= 6\\,a^{6 - 3}\\,b^{16 - 7} \\\\\n&= 6a^{3}b^{9}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{16x^{8}y^{6}}{12x^{2}y^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x^{6}y^{3}}{3}$",
          "worked": "$$\\begin{align*}\n\\frac{16x^{8}y^{6}}{12x^{2}y^{3}} &= \\frac{16\\,x^{8 - 2}\\,y^{6 - 3}}{12} \\\\\n&= \\frac{4x^{6}y^{3}}{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{6s^{6}t^{3}}{14s^{5}t}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3st^{2}}{7}$",
          "worked": "$$\\begin{align*}\n\\frac{6s^{6}t^{3}}{14s^{5}t} &= \\frac{6\\,s^{6 - 5}\\,t^{3 - 1}}{14} \\\\\n&= \\frac{3st^{2}}{7}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$- \\frac{5x^{2}y}{xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$- 5x$",
          "worked": "$$\\begin{align*}\n- \\frac{5x^{2}y}{xy} &= -5\\,x^{2 - 1}\\,y^{1 - 1} \\\\\n&= - 5x\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
