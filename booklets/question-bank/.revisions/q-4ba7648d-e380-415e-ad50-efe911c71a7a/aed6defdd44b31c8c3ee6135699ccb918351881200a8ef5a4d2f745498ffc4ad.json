                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "P(\\text{red})=\\dfrac{1}{3}",
                      "display": false
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p42-q25-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "B",
              "display": false
            },
            {
              "type": "text",
              "text": " denote blue and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "O",
              "display": false
            },
            {
              "type": "text",
              "text": " denote orange. For this question, write all probabilities as fractions:",
              "marks": []
            }
          ]
        }
