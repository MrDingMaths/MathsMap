    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "State the event complementary to picking blue.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not blue.",
          "worked": "The complement is picking a counter that is not blue: green, orange or red.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 5
      },
      {
        "id": "p42-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate $P(B')$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "$$\\begin{align*}P(B')&=1-P(B)\\\\P(B')&=1-\\frac{1}{5}\\\\P(B')&=\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p42-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate $P(O)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{15}$",
          "worked": "$$\\begin{align*}P(O)&=1-\\bigl(P(\\text{green})+P(\\text{blue})+P(\\text{red})\\bigr)\\\\P(O)&=1-\\left(\\frac{6}{15}+\\frac{1}{5}+\\frac{1}{3}\\right)\\\\P(O)&=1-\\frac{14}{15}\\\\P(O)&=\\frac{1}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 5
      },
      {
        "id": "p42-q25-d",
        "type": "part",
        "label": "d",
        "prompt": "Calculate $P(O')$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14}{15}$",
          "worked": "$$\\begin{align*}P(O')&=1-P(O)\\\\P(O')&=1-\\frac{1}{15}\\\\P(O')&=\\frac{14}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 5
      }
    ]
  },
