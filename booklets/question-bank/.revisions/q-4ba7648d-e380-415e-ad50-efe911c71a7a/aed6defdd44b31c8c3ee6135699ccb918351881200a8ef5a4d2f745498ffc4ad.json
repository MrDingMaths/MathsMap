          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "One counter is picked at random from a bucket containing green, blue, orange and red counters. The following probabilities are given:",
              "marks": []
            }
          ]
        },
        {
          "id": "p42-q25-givens",
          "type": "list",
          "ordered": false,
          "start": 1,
          "indent": 7,
          "items": [
            {
              "id": "p42-q25-given-green",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p42-q25-green",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "P(\\text{green})=\\dfrac{6}{15}",
                      "display": false
                    }
                  ]
                }
              ]
            },
            {
              "id": "p42-q25-given-blue",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p42-q25-blue",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "P(\\text{blue})=\\dfrac{1}{5}",
                      "display": false
                    }
                  ]
                }
              ]
            },
            {
              "id": "p42-q25-given-red",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p42-q25-red",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
