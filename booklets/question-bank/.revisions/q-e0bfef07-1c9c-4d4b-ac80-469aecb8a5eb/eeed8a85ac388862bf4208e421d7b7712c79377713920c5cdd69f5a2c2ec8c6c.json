  "content": {
    "id": "p76-q11",
    "type": "question",
    "label": "11",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p76-q11-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A class of 30 students guess how many sweets there are in a jar.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The mean guess is 648. One student's guess was 9000. If this outlier is removed:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q11a",
        "type": "part",
        "label": "a",
        "prompt": "Find the new mean of the guesses.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$ sweets.",
          "worked": "$$\\begin{align*}\\text{Original total}&=30\\times648\\\\\\text{Original total}&=19\\,440\\\\\\bar{x}&=\\frac{19\\,440-9000}{30-1}\\\\\\bar{x}&=\\frac{10\\,440}{29}\\\\\\bar{x}&=360\\end{align*}$$\nThe new mean is $360$ sweets.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p76-q11b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p76-q11b-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Work out the percentage change in the mean.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p76-q11b-percentage-reminder",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Recall: ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\text{Percentage change}=\\frac{\\text{new value}-\\text{original value}}{\\text{original value}}\\times100",
                  "display": false
                }
              ]
            },
            {
              "id": "p76-q11b-percentage-base",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "A negative result represents a decrease.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{360-648}{648}\\times100\\%=-\\dfrac{400}{9}\\%\\approx-44.4\\%$; a decrease.",
          "worked": "$$\\begin{align*}\\text{Percentage change}&=\\frac{\\text{new mean}-\\text{original mean}}{\\text{original mean}}\\times100\\%\\\\\\text{Percentage change}&=\\frac{360-648}{648}\\times100\\%\\\\\\text{Percentage change}&=\\frac{-288}{648}\\times100\\%\\\\\\text{Percentage change}&=-\\frac{400}{9}\\%\\\\\\text{Percentage change}&\\approx-44.4\\%\\end{align*}$$\nThe mean decreases by approximately $44.4\\%$ (to 1 decimal place).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
