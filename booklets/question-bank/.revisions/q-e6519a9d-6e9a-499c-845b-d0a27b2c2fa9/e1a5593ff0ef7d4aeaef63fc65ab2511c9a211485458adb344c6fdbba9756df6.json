      {
        "id": "p16-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2\\left(\\frac{1}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_2\\left(\\frac{1}{4}\\right) &= \\log_2 4^{-1}\\\\&= \\log_2 2^{-2}\\\\&= -2\\log_2 2\\\\&= -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3\\left(\\frac{1}{27}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}\\log_3\\left(\\frac{1}{27}\\right) &= \\log_3 27^{-1}\\\\&= \\log_3 3^{-3}\\\\&= -3\\log_3 3\\\\&= -3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_4\\left(\\frac{1}{64}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "$$\\begin{align*}\\log_4\\left(\\frac{1}{64}\\right) &= \\log_4 64^{-1}\\\\&= \\log_4 4^{-3}\\\\&= -3\\log_4 4\\\\&= -3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_5\\left(\\frac{1}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\log_5\\left(\\frac{1}{5}\\right) &= \\log_5 5^{-1}\\\\&= -\\log_5 5\\\\&= -1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{10}\\left(\\frac{1}{100}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}\\log_{10}\\left(\\frac{1}{100}\\right) &= \\log_{10}100^{-1}\\\\&= \\log_{10}10^{-2}\\\\&= -2\\log_{10}10\\\\&= -2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_{10}\\left(\\frac{1}{100000}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}\\log_{10}\\left(\\frac{1}{100000}\\right) &= \\log_{10}100000^{-1}\\\\&= \\log_{10}10^{-5}\\\\&= -5\\log_{10}10\\\\&= -5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p16-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_2 10-\\log_2 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_2 10-\\log_2 5 &= \\log_2\\left(\\frac{10}{5}\\right)\\\\&= \\log_2 2\\\\&= 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_3 30-\\log_3 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\log_3 30-\\log_3 10 &= \\log_3\\left(\\frac{30}{10}\\right)\\\\&= \\log_3 3\\\\&= 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log_4 128-\\log_4 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\log_4 128-\\log_4 2 &= \\log_4\\left(\\frac{128}{2}\\right)\\\\&= \\log_4 64\\\\&= \\log_4 4^3\\\\&= 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q9-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_4 8+\\log_4 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_4 8+\\log_4 2 &= \\log_4(8\\times2)\\\\&= \\log_4 16\\\\&= \\log_4 4^2\\\\&= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q9-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_8 16+\\log_8 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_8 16+\\log_8 4 &= \\log_8(16\\times4)\\\\&= \\log_8 64\\\\&= \\log_8 8^2\\\\&= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p16-q9-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\log_{10}50+\\log_{10}2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{10}50+\\log_{10}2 &= \\log_{10}(50\\times2)\\\\&= \\log_{10}100\\\\&= \\log_{10}10^2\\\\&= 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
