  "content": {
    "id": "p76-q12-content",
    "type": "question",
    "label": "12",
    "prompt": "Find the greatest common divisor and the least common multiple of the numbers 48, 66 and 72.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "GCD $=6$; LCM $=1584$. Use the smallest prime powers for the GCD and the largest for the LCM.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p76-q12-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}48&=2^4\\times3\\times11^0\\\\66&=2\\times3\\times11\\\\72&=2^3\\times3^2\\times11^0\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p76-q12-minimum-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Choose the smallest power of each prime for the GCD.",
                "marks": []
              }
            ]
          },
          {
            "id": "p76-q12-gcd-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\operatorname{GCD}(48,66,72)&=2\\times3\\times11^0\\\\\\operatorname{GCD}(48,66,72)&=6\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p76-q12-maximum-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Choose the largest power of each prime for the LCM.",
                "marks": []
              }
            ]
          },
          {
            "id": "p76-q12-lcm-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\operatorname{LCM}(48,66,72)&=2^4\\times3^2\\times11\\\\\\operatorname{LCM}(48,66,72)&=1584\\end{align*}",
                "display": true
              }
            ]
