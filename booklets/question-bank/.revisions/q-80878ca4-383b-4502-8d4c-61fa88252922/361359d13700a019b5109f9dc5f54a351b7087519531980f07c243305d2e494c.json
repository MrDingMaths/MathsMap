    "type": "question",
    "label": "16",
    "prompt": "Calculate the hourly wage if a person earned \\$454.50 from 12 hours of work, including an \\$82.50 tip.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$31/h",
      "worked": "$$\\begin{align*}\\text{Wages}&=\\$454.50-\\$82.50\\\\\\text{Wages}&=\\$372\\\\\\text{Hourly wage}&=\\frac{\\$372}{12\\text{ hours}}\\\\\\text{Hourly wage}&=\\$31/\\text{h}\\end{align*}$$",
      "solutionDiagrams": []
    },
