    "children": [
      {
        "id": "p39-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "What percentage of people liked Prawn Cocktail crisps the best?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$",
          "worked": "$$\\begin{align*}\\text{Prawn Cocktail percentage}&=\\frac{72}{360}\\times100\\%\\\\&=20\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q16-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p39-q16-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "45 people liked Salt and Vinegar crisps the best.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "How many people like Cheese and Onion?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "63 people\n\nFind the whole using $45\\div\\frac{90}{360}$, then take $\\frac{126}{360}$ of it.",
          "worked": "$$\\begin{align*}\\text{Total people}&=45\\div\\frac{90}{360}\\\\&=180\\\\\\text{Cheese and Onion}&=\\frac{126}{360}\\times180\\\\&=63\\text{ people}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "What fraction of people chose Ready Salted?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\text{Ready Salted angle}&=360^\\circ-90^\\circ-126^\\circ-72^\\circ\\\\&=72^\\circ\\\\\\text{Ready Salted fraction}&=\\frac{72}{360}\\\\&=\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
