  "content": {
    "id": "p66-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Write in the form $a+\\dfrac{b}{x+r}$. For j and k, keep the given denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p66-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x+4}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\dfrac{3}{x+1}$",
          "worked": "$$\\begin{align*}\\frac{x+4}{x+1}&=\\frac{x+1+3}{x+1}\\\\&=\\frac{x+1}{x+1}+\\frac{3}{x+1}\\\\&=1+\\frac{3}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+9}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\dfrac{4}{x+5}$",
          "worked": "$$\\begin{align*}\\frac{x+9}{x+5}&=\\frac{x+5+4}{x+5}\\\\&=\\frac{x+5}{x+5}+\\frac{4}{x+5}\\\\&=1+\\frac{4}{x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x+2}{x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\dfrac{4}{x+6}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{x+6}&=\\frac{x+6-4}{x+6}\\\\&=\\frac{x+6}{x+6}-\\frac{4}{x+6}\\\\&=1-\\frac{4}{x+6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+1}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\dfrac{3}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{x+1}{x+4}&=\\frac{x+4-3}{x+4}\\\\&=\\frac{x+4}{x+4}-\\frac{3}{x+4}\\\\&=1-\\frac{3}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{2x+7}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\dfrac{1}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{2x+7}{x+3}&=\\frac{2(x+3)+1}{x+3}\\\\&=\\frac{2(x+3)}{x+3}+\\frac{1}{x+3}\\\\&=2+\\frac{1}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{3x+10}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-\\dfrac{2}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{3x+10}{x+4}&=\\frac{3(x+4)-2}{x+4}\\\\&=\\frac{3(x+4)}{x+4}-\\frac{2}{x+4}\\\\&=3-\\frac{2}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{2x+3}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\dfrac{7}{x+5}$",
          "worked": "$$\\begin{align*}\\frac{2x+3}{x+5}&=\\frac{2(x+5)-7}{x+5}\\\\&=\\frac{2(x+5)}{x+5}-\\frac{7}{x+5}\\\\&=2-\\frac{7}{x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x+5}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\dfrac{7}{x-2}$",
          "worked": "$$\\begin{align*}\\frac{x+5}{x-2}&=\\frac{x-2+7}{x-2}\\\\&=\\frac{x-2}{x-2}+\\frac{7}{x-2}\\\\&=1+\\frac{7}{x-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{2x+3}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\dfrac{5}{x-1}$",
          "worked": "$$\\begin{align*}\\frac{2x+3}{x-1}&=\\frac{2(x-1)+5}{x-1}\\\\&=\\frac{2(x-1)}{x-1}+\\frac{5}{x-1}\\\\&=2+\\frac{5}{x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{4x+9}{2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\dfrac{7}{2x+1}$",
          "worked": "$$\\begin{align*}\\frac{4x+9}{2x+1}&=\\frac{2(2x+1)+7}{2x+1}\\\\&=\\frac{2(2x+1)}{2x+1}+\\frac{7}{2x+1}\\\\&=2+\\frac{7}{2x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{6x+5}{3x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\dfrac{7}{3x-1}$",
          "worked": "$$\\begin{align*}\\frac{6x+5}{3x-1}&=\\frac{2(3x-1)+7}{3x-1}\\\\&=\\frac{2(3x-1)}{3x-1}+\\frac{7}{3x-1}\\\\&=2+\\frac{7}{3x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p66-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{5-x}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1+\\dfrac{8}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{5-x}{x+3}&=\\frac{-(x+3)+8}{x+3}\\\\&=-\\frac{x+3}{x+3}+\\frac{8}{x+3}\\\\&=-1+\\frac{8}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
