    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5^{100}$.\n\nWrite $5^{101}=5\\times5^{100}$ and combine like terms.",
      "worked": "$$\\begin{align*}\\frac{5^{101}+5^{100}}6&=\\frac{5\\times5^{100}+1\\times5^{100}}6\\\\\\frac{5^{101}+5^{100}}6&=\\frac{6\\times5^{100}}6\\\\\\frac{5^{101}+5^{100}}6&=5^{100}\\end{align*}$$",
      "solutionDiagrams": []
