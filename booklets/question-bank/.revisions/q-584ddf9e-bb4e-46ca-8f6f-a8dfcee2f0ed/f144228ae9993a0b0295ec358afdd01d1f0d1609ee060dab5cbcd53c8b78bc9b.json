  "content": {
    "id": "p68-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Given that $4=2^2$, simplify these expressions to a single smallest base number.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$4\\times2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3$",
          "worked": "$$\\begin{aligned}4\\times2&=2^2\\times2^1\\\\&=2^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p68-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$8\\times4^2\\times2^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{10}$",
          "worked": "$$\\begin{aligned}8\\times4^2\\times2^3&=2^3\\times(2^2)^2\\times2^3\\\\&=2^{3+4+3}\\\\&=2^{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\times9\\times27^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^9$",
          "worked": "$$\\begin{aligned}3\\times9\\times27^2&=3^1\\times3^2\\times(3^3)^2\\\\&=3^{1+2+6}\\\\&=3^9\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$25^5\\div5^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^7$",
          "worked": "$$\\begin{aligned}25^5\\div5^3&=(5^2)^5\\div5^3\\\\&=5^{10-3}\\\\&=5^7\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$128^9\\div256^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{47}$",
          "worked": "$$\\begin{aligned}128^9\\div256^2&=(2^7)^9\\div(2^8)^2\\\\&=2^{63-16}\\\\&=2^{47}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q10-f",
        "type": "part",
        "label": "f",
