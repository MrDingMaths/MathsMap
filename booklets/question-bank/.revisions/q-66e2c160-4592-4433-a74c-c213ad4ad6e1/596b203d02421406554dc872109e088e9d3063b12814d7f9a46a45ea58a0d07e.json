  "content": {
    "id": "p7-q9",
    "type": "question",
    "label": "9",
    "prompt": "Let $S$ be the angle sum of a regular polygon with $n$ sides.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the rule for the size of an interior angle in terms of $S$ and $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\dfrac{S}{n}$",
          "worked": "The $n$ interior angles are equal, so $I=\\dfrac{S}{n}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Write a rule for the size of an interior angle in terms of $n$ only.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\dfrac{180(n-2)}{n}=180-\\dfrac{360}{n}$",
          "worked": "Substitute $S=180(n-2)$:\n$$\\begin{align*}I&=\\frac{180(n-2)}{n}\\\\I&=\\frac{180n-360}{n}\\\\I&=180-\\frac{360}{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q9-c",
        "type": "group",
        "label": "c",
        "prompt": "Use your rule to find the size of an interior angle of these polygons. Round to two decimal places where appropriate.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q9-c-i",
            "type": "part",
            "label": "i",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p7-q9-c-i-prompt",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "regular dodecagon ",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$150^{\\circ}$",
              "worked": "$$\\begin{align*}I&=\\frac{180(n-2)}{n}\\\\I&=\\frac{180(12-2)}{12}\\\\I&=150^{\\circ}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          },
          {
            "id": "p7-q9-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p7-q9-c-ii-prompt",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "82-sided regular polygon ",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$175.61^{\\circ}$ (to 2 d.p.)",
              "worked": "$$\\begin{align*}I&=\\frac{180(n-2)}{n}\\\\I&=\\frac{180(82-2)}{82}\\\\I&=\\frac{7200}{41}^{\\circ}\\\\I&\\approx175.61^{\\circ}\\end{align*}$$\nTo 2 decimal places.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          }
        ]
      }
    ]
  },
