  "content": {
    "id": "p13-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify $\\dfrac{24p^{-3}q^4}{8pq^2}$ and express as a fraction involving non-negative indices only.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{3q^2}{p^4}$",
      "worked": "$$\\begin{align*}\\frac{24p^{-3}q^4}{8pq^2} &= 3p^{-3-1}q^{4-2}\\\\ &= 3p^{-4}q^2\\\\ &= \\frac{3q^2}{p^4}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
