    "reasoningScore": 20,
    "difficulty": "Foundation",
    "difficultyReason": "Direct conversion of annual salary to weekly, fortnightly and monthly pay using the taught number-of-periods method."
  },
  "content": {
    "id": "p33-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Helene works full-time and earns a salary of \\$74 250 p.a.\nComplete the following to find how much she earns for these periods to the nearest cent.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1427.88 per week",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\frac{\\text{Annual pay}}{52}\\\\\\text{Weekly pay} &= \\frac{\\$74\\,250}{52}\\\\\\text{Weekly pay} &\\approx \\$1427.88\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Fortnight",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2855.77 per fortnight",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay} &= \\frac{\\text{Annual pay}}{26}\\\\\\text{Fortnightly pay} &= \\frac{\\$74\\,250}{26}\\\\\\text{Fortnightly pay} &\\approx \\$2855.77\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p33-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Month",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$6187.50 per month",
          "worked": "$$\\begin{align*}\\text{Monthly pay} &= \\frac{\\text{Annual pay}}{12}\\\\\\text{Monthly pay} &= \\frac{\\$74\\,250}{12}\\\\\\text{Monthly pay} &= \\$6187.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
