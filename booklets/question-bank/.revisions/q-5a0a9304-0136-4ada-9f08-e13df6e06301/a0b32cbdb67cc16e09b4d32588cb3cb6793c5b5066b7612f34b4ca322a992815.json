                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Explain how you know without calculations.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Less than $1\\%$: Earth has one moon out of more than 100.",
          "worked": "Earth has one moon out of more than 100 moons altogether. One out of more than 100 is less than one out of 100, so Earth's share is less than $1\\%$.",
