        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $37.64\\%$.",
          "worked": "$$\\begin{align*}\\text{Jupiter's percentage} &= \\frac{67}{178}\\times100\\%\\\\&\\approx37.64\\%\\end{align*}$$",
          "solutionDiagrams": []
