    "children": [
      {
        "id": "index-t7-q33-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3a^{5}bc^{3}}{6a^{4}c} \\times \\frac{4b^{3}}{2abc} \\times \\frac{2a^{3}b^{2}c}{2a^{2}b^{4}c^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab$",
          "worked": "$$\\begin{align*}\\frac{3a^5bc^3}{6a^4c}\\times\\frac{4b^3}{2abc}\\times\\frac{2a^3b^2c}{2a^2b^4c^2}&=\\frac{24a^8b^6c^4}{24a^7b^5c^4} \\\\ &=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q33-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3a^{4}b^{5}}{a^{5}b^{2}} \\div \\frac{6b^{3}}{2a^{2}b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab$",
          "worked": "$$\\begin{align*}\\frac{3a^4b^5}{a^5b^2}\\div\\frac{6b^3}{2a^2b}&=\\frac{3a^4b^5}{a^5b^2}\\times\\frac{2a^2b}{6b^3} \\\\ &=\\frac{6a^6b^6}{6a^5b^5}=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q33-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2a}{3a^{2}b^{3}} \\times \\frac{9a^{4}b^{7}}{ab^{5}} \\div \\frac{6a}{b^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab$",
          "worked": "$$\\begin{align*}\\frac{2a}{3a^2b^3}\\times\\frac{9a^4b^7}{ab^5}\\div\\frac{6a}{b^2}&=\\frac{2a}{3a^2b^3}\\times\\frac{9a^4b^7}{ab^5}\\times\\frac{b^2}{6a} \\\\ &=\\frac{18a^5b^9}{18a^4b^8}=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
