  "content": {
    "id": "p54-q75-group",
    "type": "question",
    "label": "75",
    "prompt": "Simplify the following and express your answer in terms of $\\overline A$, $\\overline B$ and $\\overline C$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q75-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overline{A\\cup B\\cup C}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overline A\\cap\\overline B\\cap\\overline C$",
          "worked": "Being outside $A\\cup B\\cup C$ means being outside each of $A$, $B$ and $C$. Therefore\n$$\\overline{A\\cup B\\cup C}=\\overline A\\cap\\overline B\\cap\\overline C.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p54-q75-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overline{A\\cap B\\cap C}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overline A\\cup\\overline B\\cup\\overline C$",
          "worked": "A point fails to belong to all three sets precisely when it is outside at least one of them. Therefore\n$$\\overline{A\\cap B\\cap C}=\\overline A\\cup\\overline B\\cup\\overline C.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
