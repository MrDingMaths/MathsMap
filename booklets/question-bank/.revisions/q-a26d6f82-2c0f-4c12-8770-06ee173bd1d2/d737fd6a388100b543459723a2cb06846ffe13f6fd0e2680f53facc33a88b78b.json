        "id": "p17-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Grant, who works 33 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$782.10$",
          "worked": "$$\\begin{align*}\\text{Total pay} &= 23.70 \\times 33\\\\\\text{Total pay} &= \\$782.10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p17-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Kylie, who works 40 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1007.25$",
          "worked": "Kylie works 35 normal hours and 5 hours at time-and-a-half.\n\n$$\\begin{align*}\\text{Normal pay} &= 23.70 \\times 35\\\\\\text{Normal pay} &= \\$829.50\\\\\\text{Overtime pay} &= 23.70 \\times 5 \\times 1.5\\\\\\text{Overtime pay} &= \\$177.75\\\\\\text{Total pay} &= 829.50 + 177.75\\\\\\text{Total pay} &= \\$1007.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p17-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "Noah, who works 44.5 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1220.55$",
          "worked": "Noah works 35 normal hours, 5 hours at time-and-a-half and $44.5-40=4.5$ hours at double time.\n\n$$\\begin{align*}\\text{Normal pay} &= 23.70 \\times 35\\\\\\text{Normal pay} &= \\$829.50\\\\\\text{Time-and-a-half pay} &= 23.70 \\times 5 \\times 1.5\\\\\\text{Time-and-a-half pay} &= \\$177.75\\\\\\text{Double-time pay} &= 23.70 \\times 4.5 \\times 2\\\\\\text{Double-time pay} &= \\$213.30\\\\\\text{Total pay} &= 829.50 + 177.75 + 213.30\\\\\\text{Total pay} &= \\$1220.55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
