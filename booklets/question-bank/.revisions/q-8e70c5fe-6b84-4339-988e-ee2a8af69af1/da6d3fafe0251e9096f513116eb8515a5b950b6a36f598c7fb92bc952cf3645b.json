  "content": {
    "id": "p11-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Vivian measured the mass of an iPhone as 251 g.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Identify the precision.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\text{ g}$",
          "worked": "The measurement is stated to the nearest gram, so the precision is $1\\text{ g}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the absolute error.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5\\text{ g}$",
          "worked": "$$\\begin{aligned}\\text{Absolute error} &= \\tfrac12\\times1\\\\&=0.5\\text{ g}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the limits of accuracy.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$250.5\\text{ g}$ to $251.5\\text{ g}$",
          "worked": "$$\\begin{aligned}\\text{Upper bound} &=251+0.5=251.5\\text{ g}\\\\\\text{Lower bound} &=251-0.5=250.5\\text{ g}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the percentage error. Answer correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.20\\%$",
          "worked": "$$\\begin{aligned}\\text{Percentage error} &=\\frac{0.5}{251}\\times100\\%\\\\\\text{Percentage error} &\\approx0.20\\%\\quad\\text{(2 d.p.)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
