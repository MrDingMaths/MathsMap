    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why each exterior angle of a regular hexagon is $60^{\\circ}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The six exterior angles are equal and sum to $360^{\\circ}$, so each is $360^{\\circ}\\div6=60^{\\circ}$.",
          "worked": "A regular hexagon has six equal exterior angles. Their sum is $360^{\\circ}$.\n\n$$E=\\frac{360^{\\circ}}{6}=60^{\\circ}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p17-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Work out the size of each exterior angle of a:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p17-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Regular pentagon",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$72^{\\circ}$",
              "worked": "$$\\begin{align*}E&=\\frac{360^{\\circ}}{5}\\\\E&=72^{\\circ}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p17-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Regular heptagon. Give your answer to 2 decimal places.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$51.43^{\\circ}$",
              "worked": "$$\\begin{align*}E&=\\frac{360^{\\circ}}{7}\\\\E&\\approx51.43^{\\circ}\\end{align*}$$\n\nTo 2 decimal places.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p17-q5-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Regular 30-sided polygon.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12^{\\circ}$",
              "worked": "$$\\begin{align*}E&=\\frac{360^{\\circ}}{30}\\\\E&=12^{\\circ}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "What happens to the size of each exterior angle as the number of sides of a regular polygon increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It decreases and approaches $0^{\\circ}$.",
          "worked": "Since $E=\\frac{360^{\\circ}}{n}$, increasing $n$ decreases each exterior angle. The angle approaches $0^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
