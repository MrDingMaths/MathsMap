  "title": "",
  "classification": {
    "primarySkillId": "parametric-to-cartesian",
    "secondarySkillIds": [],
    "reasoningScore": 40,
    "difficulty": "Development",
    "difficultyReason": "Eliminate a parameter from linear, quadratic and square-root coordinates, retaining implicit restrictions."
  },
  "content": {
    "id": "p67-g14-19-root",
    "type": "question",
    "label": null,
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p67-g14-19-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Find the Cartesian equation.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p67-q14",
        "type": "part",
        "label": "a",
        "prompt": "$(t+1,2t+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x+1$.",
          "worked": "$$\\begin{align*}t&=x-1\\\\y&=2(x-1)+3\\\\y&=2x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p67-q15",
        "type": "part",
        "label": "b",
        "prompt": "$(2t,4t^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2$.",
          "worked": "$$\\begin{align*}t&=\\frac{x}{2}\\\\y&=4\\left(\\frac{x}{2}\\right)^2\\\\y&=x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p67-q16",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(2t-1,\\frac{2t}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x+1}{3}$.",
          "worked": "$$\\begin{align*}t&=\\frac{x+1}{2}\\\\y&=\\frac{2}{3}\\left(\\frac{x+1}{2}\\right)\\\\y&=\\frac{x+1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p67-q17",
        "type": "part",
        "label": "d",
        "prompt": "$(t-2,t^2-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x^2+4x+1$.",
          "worked": "$$\\begin{align*}t&=x+2\\\\y&=(x+2)^2-3\\\\y&=x^2+4x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p67-q18",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt{t},2t-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^2-1$, where $x\\ge0$.",
          "worked": "$$\\begin{align*}t&=x^2\\\\y&=2x^2-1\\end{align*}$$\nSince $x=\\sqrt{t}$, retain $x\\ge0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p67-q19",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\sqrt{1-3t},\\frac{t+1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p67-q19-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=-\\frac{x^2}{6}+\\frac23,\\quad x\\ge0",
                    "display": false
                  }
                ]
              },
              {
                "id": "p67-q19-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Square the first coordinate and eliminate ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "t",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": "; retain the nonnegative square-root restriction.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}x^2&=1-3t\\\\t&=\\frac{1-x^2}{3}\\\\y&=\\frac{\\frac{1-x^2}{3}+1}{2}\\\\y&=-\\frac{x^2}{6}+\\frac23\\end{align*}$$\nSince $x=\\sqrt{1-3t}$, retain $x\\ge0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
