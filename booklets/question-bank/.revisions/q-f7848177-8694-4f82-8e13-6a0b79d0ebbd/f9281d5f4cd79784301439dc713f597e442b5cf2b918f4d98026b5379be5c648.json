  "content": {
    "id": "p5-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify these algebraic fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{m}{3}+\\frac{m+5}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7m+15}{12}$",
          "worked": "$$\\begin{align*}\\frac{m}{3}+\\frac{m+5}{4}&=\\frac{4m}{12}+\\frac{3(m+5)}{12}\\\\&=\\frac{4m+3m+15}{12}\\\\&=\\frac{7m+15}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4p-3}{5}-\\frac{2p}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18p-21}{35}$",
          "worked": "$$\\begin{align*}\\frac{4p-3}{5}-\\frac{2p}{7}&=\\frac{7(4p-3)}{35}-\\frac{5(2p)}{35}\\\\&=\\frac{7(4p-3)-5(2p)}{35}\\\\&=\\frac{28p-21-10p}{35}\\\\&=\\frac{18p-21}{35}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{p}{3}+\\frac{p+2}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7p+6}{12}$",
          "worked": "$$\\begin{align*}\\frac{p}{3}+\\frac{p+2}{4}&=\\frac{4p}{12}+\\frac{3(p+2)}{12}\\\\&=\\frac{4p+3p+6}{12}\\\\&=\\frac{7p+6}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{2}+\\frac{3x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x}{4}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}+\\frac{3x}{4}&=\\frac{2x}{4}+\\frac{3x}{4}\\\\&=\\frac{5x}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{y+1}{5}+\\frac{2y}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13y+3}{15}$",
          "worked": "$$\\begin{align*}\\frac{y+1}{5}+\\frac{2y}{3}&=\\frac{3(y+1)}{15}+\\frac{5(2y)}{15}\\\\&=\\frac{3(y+1)+5(2y)}{15}\\\\&=\\frac{3y+3+10y}{15}\\\\&=\\frac{13y+3}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{a+2}{3}-\\frac{a}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a+8}{12}$",
          "worked": "$$\\begin{align*}\\frac{a+2}{3}-\\frac{a}{4}&=\\frac{4(a+2)}{12}-\\frac{3a}{12}\\\\&=\\frac{4a+8-3a}{12}\\\\&=\\frac{a+8}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{k+4}{3}+\\frac{k-2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8k+14}{15}$",
          "worked": "$$\\begin{align*}\\frac{k+4}{3}+\\frac{k-2}{5}&=\\frac{5(k+4)}{15}+\\frac{3(k-2)}{15}\\\\&=\\frac{5(k+4)+3(k-2)}{15}\\\\&=\\frac{5k+20+3k-6}{15}\\\\&=\\frac{8k+14}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p5-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x+2}{3}+\\frac{x+1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x+11}{12}$",
          "worked": "$$\\begin{align*}\\frac{x+2}{3}+\\frac{x+1}{4}&=\\frac{4(x+2)}{12}+\\frac{3(x+1)}{12}\\\\&=\\frac{4(x+2)+3(x+1)}{12}\\\\&=\\frac{4x+8+3x+3}{12}\\\\&=\\frac{7x+11}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p5-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x-3}{4}+\\frac{x+2}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+1}{4}$",
          "worked": "$$\\begin{align*}\\frac{x-3}{4}+\\frac{x+2}{2}&=\\frac{x-3}{4}+\\frac{2(x+2)}{4}\\\\&=\\frac{x-3+2x+4}{4}\\\\&=\\frac{3x+1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{2x+1}{2}+\\frac{x-2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8x-1}{6}$",
          "worked": "$$\\begin{align*}\\frac{2x+1}{2}+\\frac{x-2}{3}&=\\frac{3(2x+1)}{6}+\\frac{2(x-2)}{6}\\\\&=\\frac{3(2x+1)+2(x-2)}{6}\\\\&=\\frac{6x+3+2x-4}{6}\\\\&=\\frac{8x-1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p5-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{3y-5}{4}+\\frac{2y-7}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19y-39}{20}$",
          "worked": "$$\\begin{align*}\\frac{3y-5}{4}+\\frac{2y-7}{10}&=\\frac{5(3y-5)}{20}+\\frac{2(2y-7)}{20}\\\\&=\\frac{5(3y-5)+2(2y-7)}{20}\\\\&=\\frac{15y-25+4y-14}{20}\\\\&=\\frac{19y-39}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p5-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{2x+3y}{6}+\\frac{5x-2y}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x+4y}{12}$",
          "worked": "$$\\begin{align*}\\frac{2x+3y}{6}+\\frac{5x-2y}{12}&=\\frac{2(2x+3y)}{12}+\\frac{5x-2y}{12}\\\\&=\\frac{4x+6y+5x-2y}{12}\\\\&=\\frac{9x+4y}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q2-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{5x+3}{14}+\\frac{2x-2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{43x-19}{42}$",
          "worked": "$$\\begin{align*}\\frac{5x+3}{14}+\\frac{2x-2}{3}&=\\frac{3(5x+3)}{42}+\\frac{14(2x-2)}{42}\\\\&=\\frac{3(5x+3)+14(2x-2)}{42}\\\\&=\\frac{15x+9+28x-28}{42}\\\\&=\\frac{43x-19}{42}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p5-q2-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{3-x}{14}+\\frac{x-1}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+1}{14}$",
          "worked": "$$\\begin{align*}\\frac{3-x}{14}+\\frac{x-1}{7}&=\\frac{3-x}{14}+\\frac{2(x-1)}{14}\\\\&=\\frac{3-x+2x-2}{14}\\\\&=\\frac{x+1}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q2-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{2x-3y}{8}+\\frac{2y+x}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{22x-5y}{56}$",
          "worked": "$$\\begin{align*}\\frac{2x-3y}{8}+\\frac{2y+x}{7}&=\\frac{7(2x-3y)}{56}+\\frac{8(2y+x)}{56}\\\\&=\\frac{7(2x-3y)+8(2y+x)}{56}\\\\&=\\frac{14x-21y+16y+8x}{56}\\\\&=\\frac{22x-5y}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
