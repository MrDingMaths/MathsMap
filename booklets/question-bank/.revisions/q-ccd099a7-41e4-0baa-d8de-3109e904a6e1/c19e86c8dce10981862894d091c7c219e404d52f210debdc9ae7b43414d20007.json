  "content": {
    "id": "p5-q43-group-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q43-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x^8}{x^3}\\times(x^5)^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{15}$, $x\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{x^8}{x^3}\\times(x^5)^2&=x^{8-3+5\\times2}\\\\\\frac{x^8}{x^3}\\times(x^5)^2&=x^{15}\\end{align*}$$\nThe original denominator requires $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q44-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{a^4}{a^6}\\times(3a^2)^3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27a^4$, $a\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{a^4}{a^6}\\times(3a^2)^3&=27a^{4-6+2\\times3}\\\\\\frac{a^4}{a^6}\\times(3a^2)^3&=27a^4\\end{align*}$$\nThe original denominator requires $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q45-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{a^5}{a^2}\\times\\frac{a^9}{a^4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^8$, $a\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{a^5}{a^2}\\times\\frac{a^9}{a^4}&=a^{5-2+9-4}\\\\\\frac{a^5}{a^2}\\times\\frac{a^9}{a^4}&=a^8\\end{align*}$$\nThe original denominators require $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q46-response",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{15a^3b^4}{a^4b^2}\\times\\frac{a^2b^6}{5a^3b^3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3b^5}{a^2}$, $a,b\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{15a^3b^4}{a^4b^2}\\times\\frac{a^2b^6}{5a^3b^3}&=\\frac{15}{5}a^{3+2-4-3}b^{4+6-2-3}\\\\\\frac{15a^3b^4}{a^4b^2}\\times\\frac{a^2b^6}{5a^3b^3}&=3a^{-2}b^5\\\\\\frac{15a^3b^4}{a^4b^2}\\times\\frac{a^2b^6}{5a^3b^3}&=\\frac{3b^5}{a^2}\\end{align*}$$\nThe original denominators require $a,b\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
