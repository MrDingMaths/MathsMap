  "content": {
    "id": "p40-q12",
    "type": "question",
    "label": "12",
    "prompt": "Shirley earns \\$67 000 per year. At the end of the year her company had revenue of \\$2.92 million and costs of \\$2.71 million. Shirley is paid a bonus of 1% of the profits of the company. How much is her income for that year?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$69 100; add 1% of the \\$210 000 profit to her salary.",
      "worked": "$$\\begin{align*}\\text{Profit} &= 2\\,920\\,000-2\\,710\\,000 = \\$210\\,000\\\\\\text{Bonus} &= 210\\,000\\times0.01 = \\$2100\\\\\\text{Annual income} &= 67\\,000+2100 = \\$69\\,100\\end{align*}$$",
      "solutionDiagrams": []
    },
