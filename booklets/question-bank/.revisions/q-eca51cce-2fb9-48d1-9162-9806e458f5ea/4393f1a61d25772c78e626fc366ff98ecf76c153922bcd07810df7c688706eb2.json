        "answer": {
          "short": "$5, 9, 13, 17$",
          "worked": "Shape 1 uses 5 matches. Each additional connected pentagon shares 1 edge and adds 4 matches:\nFor $x = 1$, $y = 5$.\nFor $x = 2$, $y = 5 + 4 = 9$.\nFor $x = 3$, $y = 9 + 4 = 13$.\nFor $x = 4$, $y = 13 + 4 = 17$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null,
        "responseSpace": "scaffold"
      },
