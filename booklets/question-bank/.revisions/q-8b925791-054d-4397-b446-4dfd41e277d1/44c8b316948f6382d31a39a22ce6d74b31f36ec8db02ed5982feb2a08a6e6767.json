  "content": {
    "id": "p30-q21-group",
    "type": "question",
    "label": null,
    "prompt": "A die was rolled 72 times. The results for this experiment are shown in the table.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p30-q21-table",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 30 p30-q21-table\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=0pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.4pt] (0,0) rectangle (78,52.5);\n\\draw[black,line width=0.4pt] (39,0)--(39,52.5);\n\\foreach \\y in {7.5,15,22.5,30,37.5,45}{\\draw[black,line width=0.4pt] (0,\\y)--(78,\\y);}\n\\node at (19.5,48.75) {\\textit{Number obtained}};\n\\node at (58.5,48.75) {\\textit{Frequency}};\n\\foreach \\y/\\n/\\f in {41.25/1/16,33.75/2/11,18.75/4/8,11.25/5/12,3.75/6/15}{\\node at (19.5,\\y) {\\n};\\node at (58.5,\\y) {\\f};}\n\\node at (19.5,26.25) {3};\n\\node at (58.5,26.25) {\\textbf{\\textit{A}}};\n\\end{tikzpicture}",
        "src": null,
