    "children": [
      {
        "id": "p30-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=10$",
          "worked": "$$\\begin{align*}A &= 72-(16+11+8+12+15)\\\\A &= 72-62\\\\A &= 10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p30-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "What was the relative frequency of obtaining a 4?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}\\text{Relative frequency of 4} &= \\frac{\\text{Frequency of 4}}{\\text{Total trials}}\\\\\\text{Relative frequency of 4} &= \\frac{8}{72}\\\\\\text{Relative frequency of 4} &= \\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p30-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "If the die was unbiased, which number was obtained the expected number of times?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5",
          "worked": "For an unbiased die, each outcome has probability $\\frac{1}{6}$.\n$$\\begin{align*}\\text{Expected frequency of each outcome} &= 72\\times\\frac{1}{6}\\\\\\text{Expected frequency of each outcome} &= 12\\end{align*}$$\nThe number 5 was obtained 12 times, matching its expected frequency.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
