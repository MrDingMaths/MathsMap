        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\frac{1}{2}$. The denominator groups sum to $\\frac{1}{2},1,1\\frac{1}{2},\\ldots,4\\frac{1}{2}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p104-q25-d-worked-grouping",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Group terms with the same denominator. Each group sum increases by ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{1}{2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ":",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p104-q25-d-worked-groups",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{1}{2}&=\\frac{1}{2}\\\\\\frac{1+2}{3}&=1\\\\\\frac{1+2+3}{4}&=1\\frac{1}{2}\\\\&\\vdots\\\\\\frac{1+2+\\cdots+9}{10}&=4\\frac{1}{2}\\end{aligned}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p104-q25-d-worked-total",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the nine group sums:",
                    "marks": []
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}&\\mathrel{\\phantom{=}}\\frac{1}{2}+1+1\\frac{1}{2}+2+2\\frac{1}{2}\\\\&\\mathrel{\\phantom{=}}\\qquad+3+3\\frac{1}{2}+4+4\\frac{1}{2}\\\\&=5+5+5+5+2\\frac{1}{2}\\\\&=22\\frac{1}{2}\\end{aligned}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
