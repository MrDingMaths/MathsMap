        "children": [],
        "answer": {
          "short": "$\\frac{6}{4}=1\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{4}+\\frac{2}{4}+\\frac{3}{4}&=\\frac{1+2+3}{4}\\\\&=\\frac{6}{4}\\\\&=1\\frac{1}{2}\\end{align*}$$",
