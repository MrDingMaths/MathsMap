        "id": "p104-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{6}+\\frac{2}{6}+\\frac{3}{6}+\\frac{4}{6}+\\frac{5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15}{6}=2\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{6}+\\frac{2}{6}+\\frac{3}{6}+\\frac{4}{6}+\\frac{5}{6}&=\\frac{1+2+3+4+5}{6}\\\\&=\\frac{15}{6}\\\\&=\\frac{5}{2}\\\\&=2\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p104-q25-d",
        "type": "part",
        "label": "d",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p104-q25-d-expression",
              "type": "paragraph",
