  "content": {
    "id": "p9-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Travis earns \\$28.63/h while Louis earns \\$31.55/h. If both work a 20-hour week, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Travis’ weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$572.60",
          "worked": "$$\\begin{align*}\\text{Travis’ weekly pay}&=\\text{Hourly rate}\\times\\text{Hours}\\\\\\text{Travis’ weekly pay}&=\\$28.63\\times20\\\\\\text{Travis’ weekly pay}&=\\$572.60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Louis’ weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$631",
          "worked": "$$\\begin{align*}\\text{Louis’ weekly pay}&=\\text{Hourly rate}\\times\\text{Hours}\\\\\\text{Louis’ weekly pay}&=\\$31.55\\times20\\\\\\text{Louis’ weekly pay}&=\\$631\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q10-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p9-q10-c-instruction",
              "type": "paragraph",
