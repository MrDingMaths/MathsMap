              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\frac{\\text{Travis’ Pay}}{\\text{Louis’ Pay}}\\times100=",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$90.74\\%$",
                  "width": 22
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90.74\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage}&=\\frac{\\text{Travis’ pay}}{\\text{Louis’ pay}}\\times100\\\\\\text{Percentage}&=\\frac{572.60}{631}\\times100\\\\\\text{Percentage}&\\approx90.74\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
