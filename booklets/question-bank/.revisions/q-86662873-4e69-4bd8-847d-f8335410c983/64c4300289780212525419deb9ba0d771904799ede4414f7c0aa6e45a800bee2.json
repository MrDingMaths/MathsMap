              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Travis’ weekly pay as a percentage of Louis’ pay. Give your answer to 2 decimal places.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p9-q10-c-scaffold",
              "type": "paragraph",
              "fontSize": null,
