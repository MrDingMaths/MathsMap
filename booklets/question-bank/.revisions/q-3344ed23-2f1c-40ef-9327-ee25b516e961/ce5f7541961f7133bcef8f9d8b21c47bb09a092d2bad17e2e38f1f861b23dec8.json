            "children": [],
            "answer": {
              "short": "Fraction: $\\frac{4}{20}=\\frac{1}{5}$; decimal: $0.2$; percentage: $20\\%$.",
              "worked": "Total: $6+4+7+3=20$.\n$$\\begin{align*}P(\\mathrm{green}) &= \\frac{4}{20}\\\\P(\\mathrm{green}) &= \\frac{1}{5}\\end{align*}$$\nDecimal: $1\\div5=0.2$.\nPercentage: $(0.2\\times100)\\%=20\\%$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          },
          {
            "id": "p12-q8-b",
            "type": "part",
            "label": "b",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Fraction: $\\frac{7}{20}$; decimal: $0.35$; percentage: $35\\%$.",
              "worked": "Total: $6+4+7+3=20$.\n$$P(\\mathrm{yellow})=\\frac{7}{20}$$\nDecimal: $7\\div20=0.35$.\nPercentage: $(0.35\\times100)\\%=35\\%$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          },
          {
            "id": "p12-q8-c",
            "type": "part",
            "label": "c",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Fraction: $\\frac{6}{20}=\\frac{3}{10}$; decimal: $0.3$; percentage: $30\\%$.",
              "worked": "Total: $6+4+7+3=20$.\n$$\\begin{align*}P(\\mathrm{red}) &= \\frac{6}{20}\\\\P(\\mathrm{red}) &= \\frac{3}{10}\\end{align*}$$\nDecimal: $3\\div10=0.3$.\nPercentage: $(0.3\\times100)\\%=30\\%$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          },
          {
            "id": "p12-q8-d",
            "type": "part",
            "label": "d",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Fraction: $\\frac{3}{20}$; decimal: $0.15$; percentage: $15\\%$.",
              "worked": "Total: $6+4+7+3=20$.\n$$P(\\mathrm{blue})=\\frac{3}{20}$$\nDecimal: $3\\div20=0.15$.\nPercentage: $(0.15\\times100)\\%=15\\%$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0,
            "responseSpace": "scaffold"
          }
        ]
      },
      {
        "id": "p12-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "Do all probabilities sum to 1?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}P(\\mathrm{green})+P(\\mathrm{yellow})+P(\\mathrm{red})+P(\\mathrm{blue}) &= \\frac{4+7+6+3}{20}\\\\P(\\mathrm{green})+P(\\mathrm{yellow})+P(\\mathrm{red})+P(\\mathrm{blue}) &= \\frac{20}{20}\\\\P(\\mathrm{green})+P(\\mathrm{yellow})+P(\\mathrm{red})+P(\\mathrm{blue}) &= 1\\end{align*}$$\nYes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
