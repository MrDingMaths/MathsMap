        "answer": {
          "short": "$\\theta=60^{\\circ}$ or $120^{\\circ}$. Reference angle $60^{\\circ}$; Q1 or Q2.",
          "worked": "1. Reference angle:\n$$\\begin{align*}A&=\\sin^{-1}\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\A&=60^{\\circ}\\end{align*}$$\n2. $\\sin\\theta>0$, so $\\theta$ is in Q1 or Q2.\n\n3. Solutions:\n$$\\begin{align*}\\theta&=60^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}-60^{\\circ}\\\\\\theta&=120^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p55-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\theta=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=45^{\\circ}$ or $225^{\\circ}$. Reference angle $45^{\\circ}$; Q1 or Q3.",
          "worked": "Reference angle:\n$$\\begin{align*}A&=\\tan^{-1}(1)\\\\A&=45^{\\circ}\\end{align*}$$\n$\\tan\\theta>0$, so $\\theta$ is in Q1 or Q3.\n$$\\begin{align*}\\theta&=45^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}+45^{\\circ}\\\\\\theta&=225^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p55-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\theta=\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^{\\circ}$ or $240^{\\circ}$. Reference angle $60^{\\circ}$; Q1 or Q3.",
          "worked": "Reference angle:\n$$\\begin{align*}A&=\\tan^{-1}(\\sqrt{3})\\\\A&=60^{\\circ}\\end{align*}$$\n$\\tan\\theta>0$, so $\\theta$ is in Q1 or Q3.\n$$\\begin{align*}\\theta&=60^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}+60^{\\circ}\\\\\\theta&=240^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p55-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\theta=-\\frac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=135^{\\circ}$ or $225^{\\circ}$. Reference angle $45^{\\circ}$; Q2 or Q3.",
          "worked": "Reference angle:\n$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{1}{\\sqrt{2}}\\right)\\\\A&=45^{\\circ}\\end{align*}$$\n$\\cos\\theta<0$, so $\\theta$ is in Q2 or Q3.\n$$\\begin{align*}\\theta&=180^{\\circ}-45^{\\circ}\\\\\\theta&=135^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}+45^{\\circ}\\\\\\theta&=225^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p55-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\tan\\theta=-\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^{\\circ}$ or $300^{\\circ}$. Reference angle $60^{\\circ}$; Q2 or Q4.",
          "worked": "Reference angle:\n$$\\begin{align*}A&=\\tan^{-1}(\\sqrt{3})\\\\A&=60^{\\circ}\\end{align*}$$\n$\\tan\\theta<0$, so $\\theta$ is in Q2 or Q4.\n$$\\begin{align*}\\theta&=180^{\\circ}-60^{\\circ}\\\\\\theta&=120^{\\circ}\\\\\\text{or }\\theta&=360^{\\circ}-60^{\\circ}\\\\\\theta&=300^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p55-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\cos\\theta=-\\frac{\\sqrt{3}}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=150^{\\circ}$ or $210^{\\circ}$. Reference angle $30^{\\circ}$; Q2 or Q3.",
          "worked": "Reference angle:\n$$\\begin{align*}A&=\\cos^{-1}\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\A&=30^{\\circ}\\end{align*}$$\n$\\cos\\theta<0$, so $\\theta$ is in Q2 or Q3.\n$$\\begin{align*}\\theta&=180^{\\circ}-30^{\\circ}\\\\\\theta&=150^{\\circ}\\\\\\text{or }\\theta&=180^{\\circ}+30^{\\circ}\\\\\\theta&=210^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
