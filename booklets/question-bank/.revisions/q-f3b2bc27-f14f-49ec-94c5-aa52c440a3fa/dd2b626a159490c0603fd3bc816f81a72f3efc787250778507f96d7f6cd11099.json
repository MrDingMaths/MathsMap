  "content": {
    "id": "p75-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "By writing out the first few square numbers, what digit(s) can square numbers never end in?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "2, 3, 7 or 8.",
      "worked": "The squares $0^2,1^2,2^2,\\ldots,9^2$ are $0,1,4,9,16,25,36,49,64,81$.\n\nTheir final digits are $0,1,4,9,6,5,6,9,4,1$. The final digit of a square depends only on the final digit of the original whole number, so square numbers can never end in 2, 3, 7 or 8.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
