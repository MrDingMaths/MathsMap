    "children": [
      {
        "id": "p8-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{6^n+3^n}{2^{n+1}+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3^n}{2}$\n\nRewrite $6^n=2^n3^n$ and cancel the common factor $2^n+1$.",
          "worked": "$$\\begin{align*}\\frac{6^n+3^n}{2^{n+1}+2}&=\\frac{2^n3^n+3^n}{2\\times2^n+2}\\\\\\frac{6^n+3^n}{2^{n+1}+2}&=\\frac{3^n(2^n+1)}{2(2^n+1)}\\\\\\frac{6^n+3^n}{2^{n+1}+2}&=\\frac{3^n}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p8-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{12^x+1}{6^{2x}+3^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3^x}$\n\nRewrite $6^{2x}=3^x12^x$ and factorise the denominator.",
          "worked": "$$\\begin{align*}\\frac{12^x+1}{6^{2x}+3^x}&=\\frac{12^x+1}{36^x+3^x}\\\\\\frac{12^x+1}{6^{2x}+3^x}&=\\frac{12^x+1}{3^x12^x+3^x}\\\\\\frac{12^x+1}{6^{2x}+3^x}&=\\frac{12^x+1}{3^x(12^x+1)}\\\\\\frac{12^x+1}{6^{2x}+3^x}&=\\frac{1}{3^x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p8-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{12^n-18^n}{3^n-2^n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2^n3^n$\n\nFactor out $6^n$; the remaining numerator is the negative of the denominator.",
          "worked": "$$\\begin{align*}\\frac{12^n-18^n}{3^n-2^n}&=\\frac{6^n2^n-6^n3^n}{3^n-2^n}\\\\\\frac{12^n-18^n}{3^n-2^n}&=\\frac{6^n(2^n-3^n)}{3^n-2^n}\\\\\\frac{12^n-18^n}{3^n-2^n}&=\\frac{-6^n(3^n-2^n)}{3^n-2^n}\\\\\\frac{12^n-18^n}{3^n-2^n}&=-2^n3^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
