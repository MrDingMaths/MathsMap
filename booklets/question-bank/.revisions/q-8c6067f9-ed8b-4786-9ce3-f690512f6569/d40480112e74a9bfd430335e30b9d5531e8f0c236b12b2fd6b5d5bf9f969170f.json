    "id": "p11-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The interest, $\\$I$, earned on a principal of $\\$P$ for 1 year is given by the formula $I=kP$, where $k$ is a constant.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "If an investment of $\\$6000$ earns interest of $\\$300$, find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=0.05$",
          "worked": "$$\\begin{align*}I&=kP\\\\300&=6000k\\\\k&=\\frac{300}{6000}\\\\k&=0.05\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
