    "reasoningScore": 55,
    "difficulty": "Mastery",
    "difficultyReason": "Convert monthly earnings to weekly earnings, then divide by weekly hours to find an hourly rate."
  },
  "content": {
    "id": "p37-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Calculate the hourly rate of pay.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "\\$3250/month at 25 hours/week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$30/h",
          "worked": "$\\begin{align*}\\text{Annual pay} &= \\$3250\\times12\\\\ &= \\$39\\,000\\\\ \\text{Weekly pay} &= \\frac{\\$39\\,000}{52}\\\\ &= \\$750\\\\ \\text{Hourly rate} &= \\frac{\\$750}{25}\\\\ &= \\frac{\\$30}{\\text{h}}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p37-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "\\$2372.50/month at 30 hours/week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$18.25/h",
          "worked": "$\\begin{align*}\\text{Annual pay} &= \\$2372.50\\times12\\\\ &= \\$28\\,470\\\\ \\text{Weekly pay} &= \\frac{\\$28\\,470}{52}\\\\ &= \\$547.50\\\\ \\text{Hourly rate} &= \\frac{\\$547.50}{30}\\\\ &= \\frac{\\$18.25}{\\text{h}}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
