  "content": {
    "id": "p22-q43-group-root",
    "type": "question",
    "label": "11",
    "prompt": "Rationalise the denominator of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q43-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{3+\\sqrt2}{3-\\sqrt2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11+6\\sqrt2}{7}$",
          "worked": "$$\\begin{align*}\\frac{3+\\sqrt2}{3-\\sqrt2}&=\\frac{(3+\\sqrt2)(3+\\sqrt2)}{(3-\\sqrt2)(3+\\sqrt2)}\\\\\\frac{3+\\sqrt2}{3-\\sqrt2}&=\\frac{9+6\\sqrt2+2}{9-2}\\\\\\frac{3+\\sqrt2}{3-\\sqrt2}&=\\frac{11+6\\sqrt2}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q44-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2+\\sqrt6}{3-\\sqrt3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\dfrac{\\sqrt3}{3}+\\dfrac{\\sqrt6}{2}+\\dfrac{\\sqrt2}{2}$",
          "worked": "$$\\begin{align*}\\frac{2+\\sqrt6}{3-\\sqrt3}&=\\frac{(2+\\sqrt6)(3+\\sqrt3)}{(3-\\sqrt3)(3+\\sqrt3)}\\\\\\frac{2+\\sqrt6}{3-\\sqrt3}&=\\frac{6+2\\sqrt3+3\\sqrt6+\\sqrt{18}}{9-3}\\\\\\frac{2+\\sqrt6}{3-\\sqrt3}&=\\frac{6+2\\sqrt3+3\\sqrt6+3\\sqrt2}{6}\\\\\\frac{2+\\sqrt6}{3-\\sqrt3}&=1+\\frac{\\sqrt3}{3}+\\frac{\\sqrt6}{2}+\\frac{\\sqrt2}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q45-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{1}{\\sqrt3+\\sqrt2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3-\\sqrt2$",
          "worked": "$$\\begin{align*}\\frac1{\\sqrt3+\\sqrt2}&=\\frac{\\sqrt3-\\sqrt2}{(\\sqrt3+\\sqrt2)(\\sqrt3-\\sqrt2)}\\\\\\frac1{\\sqrt3+\\sqrt2}&=\\frac{\\sqrt3-\\sqrt2}{3-2}\\\\\\frac1{\\sqrt3+\\sqrt2}&=\\sqrt3-\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q46-response",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac4{\\sqrt7-\\sqrt5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(\\sqrt7+\\sqrt5)$",
          "worked": "$$\\begin{align*}\\frac4{\\sqrt7-\\sqrt5}&=\\frac{4(\\sqrt7+\\sqrt5)}{(\\sqrt7-\\sqrt5)(\\sqrt7+\\sqrt5)}\\\\\\frac4{\\sqrt7-\\sqrt5}&=\\frac{4(\\sqrt7+\\sqrt5)}{7-5}\\\\\\frac4{\\sqrt7-\\sqrt5}&=2(\\sqrt7+\\sqrt5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q47-response",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4+\\sqrt{15}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}&=\\frac{(\\sqrt5+\\sqrt3)^2}{(\\sqrt5-\\sqrt3)(\\sqrt5+\\sqrt3)}\\\\\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}&=\\frac{5+2\\sqrt{15}+3}{5-3}\\\\\\frac{\\sqrt5+\\sqrt3}{\\sqrt5-\\sqrt3}&=4+\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q48-response",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt6+3}{5}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}&=\\frac{\\sqrt3(2\\sqrt2+\\sqrt3)}{(2\\sqrt2-\\sqrt3)(2\\sqrt2+\\sqrt3)}\\\\\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}&=\\frac{2\\sqrt6+3}{8-3}\\\\\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}&=\\frac{2\\sqrt6+3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
