        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x+11}{(x+2)(x+3)}$",
          "worked": "$$\\begin{align*}x^2+5x+6&=(x+2)(x+3)\\end{align*}$$\n$$\\begin{align*}\\frac{2}{x^2+5x+6}+\\frac{3}{x+2}&=\\frac{2}{(x+2)(x+3)}+\\frac{3(x+3)}{(x+2)(x+3)}\\\\&=\\frac{2+3x+9}{(x+2)(x+3)}\\\\&=\\frac{3x+11}{(x+2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
