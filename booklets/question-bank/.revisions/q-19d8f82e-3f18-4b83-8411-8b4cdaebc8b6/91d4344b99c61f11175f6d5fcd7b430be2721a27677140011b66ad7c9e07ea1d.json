        "id": "p33-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x+2}+\\dfrac{1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+5}{(x+2)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+2}+\\frac{1}{x+3}&=\\frac{x+3}{(x+2)(x+3)}+\\frac{x+2}{(x+2)(x+3)}\\\\&=\\frac{(x+3)+(x+2)}{(x+2)(x+3)}\\\\&=\\frac{2x+5}{(x+2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x+2}+\\dfrac{1}{x^2+5x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+4}{(x+2)(x+3)}$",
          "worked": "$$\\begin{align*}x^2+5x+6&=(x+2)(x+3)\\end{align*}$$\n$$\\begin{align*}\\frac{1}{x+2}+\\frac{1}{x^2+5x+6}&=\\frac{x+3}{(x+2)(x+3)}+\\frac{1}{(x+2)(x+3)}\\\\&=\\frac{x+3+1}{(x+2)(x+3)}\\\\&=\\frac{x+4}{(x+2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p33-q6-c",
