    "children": [
      {
        "id": "p16-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each diagonal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$CE=DF=\\sqrt{130}$ units.",
          "worked": "$$\\begin{align*}CE&=\\sqrt{(-1-2)^2+(-5-6)^2}\\\\CE&=\\sqrt{130}\\\\DF&=\\sqrt{(6-(-5))^2+(-1-2)^2}\\\\DF&=\\sqrt{130}\\end{align*}$$\nBoth diagonals have length $\\sqrt{130}$ units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoint of each diagonal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both midpoints are $\\left(\\frac12,\\frac12\\right)$.",
          "worked": "$$\\begin{align*}M_{CE}&=\\left(\\frac{2+(-1)}2,\\frac{6+(-5)}2\\right)\\\\M_{CE}&=\\left(\\frac12,\\frac12\\right)\\\\M_{DF}&=\\left(\\frac{-5+6}2,\\frac{2+(-1)}2\\right)\\\\M_{DF}&=\\left(\\frac12,\\frac12\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the diagonals are perpendicular.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{CE}=\\frac{11}{3}$ and $m_{DF}=-\\frac3{11}$; their product is $-1$, so $CE\\perp DF$.",
          "worked": "$$\\begin{align*}m_{CE}&=\\frac{-5-6}{-1-2}\\\\m_{CE}&=\\frac{11}{3}\\\\m_{DF}&=\\frac{-1-2}{6-(-5)}\\\\m_{DF}&=-\\frac3{11}\\\\m_{CE}\\times m_{DF}&=\\frac{11}{3}\\times\\left(-\\frac3{11}\\right)\\\\m_{CE}\\times m_{DF}&=-1\\end{align*}$$\nThe product of the gradients is $-1$, so the diagonals are perpendicular.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "What type of quadrilateral is $CDEF$? Explain.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "p16-q11-a",
          "p16-q11-b",
          "p16-q11-c"
        ],
        "answer": {
          "short": "A square: its diagonals are equal, bisect each other and are perpendicular. It is also a rhombus.",
          "worked": "The diagonals have equal length $\\sqrt{130}$ and the same midpoint $\\left(\\frac12,\\frac12\\right)$, so they bisect each other. Equal diagonals that bisect each other establish a rectangle. Since the diagonals are also perpendicular, they establish a rhombus. Therefore $CDEF$ is a square, and is also a rhombus.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
