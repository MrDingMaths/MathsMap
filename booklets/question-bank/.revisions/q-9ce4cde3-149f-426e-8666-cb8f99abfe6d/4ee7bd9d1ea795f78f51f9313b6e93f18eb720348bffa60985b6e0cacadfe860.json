        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 16, p16-q11-source-diagram\"}\n\\begin{tikzpicture}[x=0.42cm,y=0.42cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,black,line width=0.5pt] (-6.5,0)--(7.5,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-6.5)--(0,7.5) node[above] {$y$};\n\\coordinate (C) at (2,6);\n\\coordinate (D) at (-5,2);\n\\coordinate (E) at (-1,-5);\n\\coordinate (F) at (6,-1);\n\\draw[black,line width=0.8pt] (C)--(D)--(E)--(F)--cycle;\n\\fill[black] (C) circle (1.5pt) node[above right] {$C$};\n\\fill[black] (D) circle (1.5pt) node[above left] {$D$};\n\\fill[black] (E) circle (1.5pt) node[below left] {$E$};\n\\fill[black] (F) circle (1.5pt) node[below right] {$F$};\n\\end{tikzpicture}",
