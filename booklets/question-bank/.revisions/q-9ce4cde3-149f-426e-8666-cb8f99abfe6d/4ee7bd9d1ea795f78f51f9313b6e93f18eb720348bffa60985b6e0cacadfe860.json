  "content": {
    "id": "p16-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A quadrilateral has vertices $C(2,6)$, $D(-5,2)$, $E(-1,-5)$ and $F(6,-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p16-q11-diagram",
        "role": "question",
