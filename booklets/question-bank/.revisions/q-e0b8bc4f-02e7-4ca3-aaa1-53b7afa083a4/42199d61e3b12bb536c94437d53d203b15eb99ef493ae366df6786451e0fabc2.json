          "inlines": [
            {
              "type": "text",
              "text": "Calculate the amount to which ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "11\\,000",
              "display": false
            },
            {
              "type": "text",
              "text": " dollars will grow in 3 years if it is invested at 8% p.a. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Give monetary answers to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "simple interest",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13\\,640$",
          "worked": "$$\\begin{align*}I &= Prn\\\\I &= 11\\,000\\times0.08\\times3\\\\I &= 2640\\\\A &= P+I\\\\A &= 11\\,000+2640\\\\A &= \\$13\\,640\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "compound interest, compounded annually.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13\\,856.83$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 11\\,000(1+0.08)^3\\\\FV &= 13\\,856.832\\\\FV &\\approx \\$13\\,856.83\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Which method of calculating interest produces the greater amount and by how much?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Compound interest produces $\\$216.83$ more than simple interest.",
          "worked": "$$\\begin{align*}\\text{Difference} &= 13\\,856.832-13\\,640\\\\\\text{Difference} &= 216.832\\\\\\text{Difference} &\\approx \\$216.83\\end{align*}$$\nCompound interest produces the greater amount because interest is also earned on previously accumulated interest.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
