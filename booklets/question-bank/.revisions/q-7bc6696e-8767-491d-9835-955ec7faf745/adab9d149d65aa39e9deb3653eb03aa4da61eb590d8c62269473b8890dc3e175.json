    "children": [
      {
        "id": "p76-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the prime factorisation of 540.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p76-q9-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "540 = 2^2 \\times 3^3 \\times 5",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}540 &= 54 \\times 10\\\\540 &= (2 \\times 3 \\times 3 \\times 3) \\times (2 \\times 5)\\\\540 &= 2^2 \\times 3^3 \\times 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p76-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, show that 540 has twenty-four factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p76-q9-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Every factor has the form ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2^a \\times 3^b \\times 5^c",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", where ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a\\in\\{0,1,2\\},\\quad b\\in\\{0,1,2,3\\},\\quad c\\in\\{0,1\\}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". There are ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "3\\times4\\times2=24",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " factors.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Every factor has the form $2^a\\times3^b\\times5^c$, where $a\\in\\{0,1,2\\}$, $b\\in\\{0,1,2,3\\}$ and $c\\in\\{0,1\\}$.\n\nThere are 3 choices for $a$, 4 for $b$ and 2 for $c$. Each combination gives a different factor, so the number of factors is $3\\times4\\times2=24$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
