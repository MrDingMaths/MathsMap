  "content": {
    "id": "p81-q36-root",
    "type": "question",
    "label": "36",
    "prompt": "Think of a positive whole number. Double it, add one, then multiply by 5.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p81-q36-a",
        "type": "part",
        "label": "a",
        "prompt": "The answer always ends in a 5. Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(2x+1)=10x+5$, so the units digit is 5.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p81-q36-a-worked-definition",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "x",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " be the original positive whole number.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p81-q36-a-worked-equation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "5(2x+1)=10x+5",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p81-q36-a-worked-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "10x",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is a multiple of 10, so adding 5 gives a units digit of 5.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p81-q36-b",
        "type": "part",
        "label": "b",
        "prompt": "Strike off the 5, and the remaining number will be the original number. Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Removing the final digit 5 gives $\\dfrac{10x+5-5}{10}=x$, the original number.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p81-q36-b-worked-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Striking off the final digit 5 subtracts 5 and then divides by 10.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p81-q36-b-worked-equation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{10x+5-5}{10}=x",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p81-q36-b-worked-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The remaining number is the original number.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p81-q36-c",
        "type": "part",
        "label": "c",
        "prompt": "Choose a positive whole number. Triple it, add 2, then triple the result. Then add the original number to the result. Prove that this number always ends in 6.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
