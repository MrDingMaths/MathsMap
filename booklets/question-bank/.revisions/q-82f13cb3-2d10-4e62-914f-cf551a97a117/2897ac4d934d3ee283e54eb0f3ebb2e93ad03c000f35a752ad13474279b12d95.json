    "label": "78",
    "prompt": "Simplify $\\dfrac{12^x}{8^x}\\times\\dfrac{6^x}{3^x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3^x$.",
      "worked": "$$\\begin{align*}\\frac{12^x}{8^x}\\times\\frac{6^x}{3^x}&=\\left(\\frac{12\\times6}{8\\times3}\\right)^x\\\\\\frac{12^x}{8^x}\\times\\frac{6^x}{3^x}&=3^x\\end{align*}$$",
      "solutionDiagrams": []
    },
