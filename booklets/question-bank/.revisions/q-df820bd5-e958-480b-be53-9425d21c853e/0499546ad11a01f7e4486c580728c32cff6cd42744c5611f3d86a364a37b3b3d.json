    "difficultyReason": "Combine signed powered products and fractions through several linked operations."
  },
  "content": {
    "id": "index-t10-q6-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t10-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\left( - 2x^{2} \\right)^{3}}{- 4x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^{5}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( - 2x^{2} \\right)^{3}}{- 4x} &= \\frac{2^{3}\\,x^{2\\times3 - 1}}{4} \\\\\n&= 2x^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\left( 3xy^{3} \\right)^{3}}{3x^{2}y^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9xy^{5}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( 3xy^{3} \\right)^{3}}{3x^{2}y^{4}} &= \\frac{3^{3}\\,x^{3 - 2}\\,y^{3\\times3 - 4}}{3} \\\\\n&= 9xy^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{( - ab)^{3} \\times \\left( - ab^{2} \\right)^{2}}{- a^{5}b^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^{4}$",
          "worked": "$$\\begin{align*}\n\\frac{( - ab)^{3} \\times \\left( - ab^{2} \\right)^{2}}{- a^{5}b^{3}} &= a^{3 + 2 - 5}\\,b^{3 + 2\\times2 - 3} \\\\\n&= b^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{\\left( - 2a^{3}b^{2} \\right)^{2} \\times 16a^{7}b}{\\left( 2a^{2}b \\right)^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( - 2a^{3}b^{2} \\right)^{2} \\times 16a^{7}b}{\\left( 2a^{2}b \\right)^{5}} &= \\frac{2^{2}\\times16\\,a^{3\\times2 + 7 - 2\\times5}\\,b^{2\\times2 + 1 - 5}}{2^{5}} \\\\\n&= 2a^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4m^{2}n \\times 3\\left( m^{2}n \\right)^{3}\\ }{6m^{2}n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2m^{6}n^{3}$",
          "worked": "$$\\begin{align*}\n\\frac{4m^{2}n \\times 3\\left( m^{2}n \\right)^{3}\\ }{6m^{2}n} &= \\frac{4\\times3\\,m^{2 + 2\\times3 - 2}\\,n^{1 + 3 - 1}}{6} \\\\\n&= 2m^{6}n^{3}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\left( 7y^{2}z \\right)^{2} \\times 3yz^{2}}{7(yz)^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21y^{3}z^{2}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( 7y^{2}z \\right)^{2} \\times 3yz^{2}}{7(yz)^{2}} &= \\frac{7^{2}\\times3\\,y^{2\\times2 + 1 - 2}\\,z^{2 + 2 - 2}}{7} \\\\\n&= 21y^{3}z^{2}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2(ab)^{2} \\times \\left( 2a^{2}b \\right)^{3}}{4ab^{2} \\times 4a^{7}b^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\n\\frac{2(ab)^{2} \\times \\left( 2a^{2}b \\right)^{3}}{4ab^{2} \\times 4a^{7}b^{3}} &= \\frac{2\\times2^{3}\\,a^{2 + 2\\times3 - 1 - 7}\\,b^{2 + 3 - 2 - 3}}{4\\times4} \\\\\n&= 1\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t10-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{w^{8}}{18}$ $\\div$ $\\left( \\frac{w}{6} \\right)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2w^{6}$",
          "worked": "$$\\begin{align*}\\frac{w^8}{18}\\div\\left(\\frac w6\\right)^2&=\\frac{w^8}{18}\\times\\frac{36}{w^2} \\\\ &=2w^6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
