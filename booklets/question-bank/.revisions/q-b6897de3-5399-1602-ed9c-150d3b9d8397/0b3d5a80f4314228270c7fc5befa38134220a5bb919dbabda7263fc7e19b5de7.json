  "content": {
    "id": "p11-q49-group-root",
    "type": "question",
    "label": "12",
    "prompt": "Factorise the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q49-response",
        "type": "part",
        "label": "a",
        "prompt": "$a(2b+5)+3(2b+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2b+5)(a+3)$",
          "worked": "The common factor is $2b+5$.\n\n$$\\begin{align*}a(2b+5)+3(2b+5)&=(2b+5)(a+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q50-response",
        "type": "part",
        "label": "b",
        "prompt": "$y(x+3)-z(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(y-z)$",
          "worked": "The common factor is $x+3$.\n\n$$\\begin{align*}y(x+3)-z(x+3)&=(x+3)(y-z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q51-response",
        "type": "part",
        "label": "c",
        "prompt": "$(x-3)-x(3-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)(1+x)$\n\nUse $3-x=-(x-3)$, then take out $x-3$.",
          "worked": "$$\\begin{align*}(x-3)-x(3-x)&=(x-3)+x(x-3)\\\\(x-3)-x(3-x)&=(x-3)(1+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q52-response",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-y^2+4x-4y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y+4)$\n\nUse the difference of squares, then factor out $x-y$.",
          "worked": "$$\\begin{align*}x^2-y^2+4x-4y&=(x-y)(x+y)+4(x-y)\\\\x^2-y^2+4x-4y&=(x-y)(x+y+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q53-response",
        "type": "part",
        "label": "e",
        "prompt": "$4pq-6p+8q-12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(p+2)(2q-3)$\n\nGroup the terms in pairs, then factorise the remaining common factors.",
          "worked": "$$\\begin{align*}4pq-6p+8q-12&=2p(2q-3)+4(2q-3)\\\\4pq-6p+8q-12&=(2q-3)(2p+4)\\\\4pq-6p+8q-12&=2(p+2)(2q-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q54-response",
        "type": "part",
        "label": "f",
        "prompt": "$xy-xz-3y+3z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y-z)(x-3)$",
          "worked": "$$\\begin{align*}xy-xz-3y+3z&=x(y-z)-3(y-z)\\\\xy-xz-3y+3z&=(y-z)(x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q55-response",
        "type": "part",
        "label": "g",
        "prompt": "$9a^2-25b^2-6a+10b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3a-5b)(3a+5b-2)$\n\nFactorise the difference of squares, then take out $3a-5b$.",
          "worked": "$$\\begin{align*}9a^2-25b^2-6a+10b&=(3a-5b)(3a+5b)-2(3a-5b)\\\\9a^2-25b^2-6a+10b&=(3a-5b)(3a+5b-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q56-response",
        "type": "part",
        "label": "h",
        "prompt": "$3x^2-6xy+5x-10y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+5)(x-2y)$",
          "worked": "$$\\begin{align*}3x^2-6xy+5x-10y&=3x(x-2y)+5(x-2y)\\\\3x^2-6xy+5x-10y&=(3x+5)(x-2y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q57-response",
        "type": "part",
        "label": "i",
        "prompt": "$16u^2-9v^2-12ux-9vx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4u+3v)(4u-3v-3x)$\n\nFactorise the first pair as a difference of squares and the last pair as $-3x(4u+3v)$.",
          "worked": "$$\\begin{align*}16u^2-9v^2-12ux-9vx&=(4u-3v)(4u+3v)-3x(4u+3v)\\\\16u^2-9v^2-12ux-9vx&=(4u+3v)(4u-3v-3x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q58-response",
        "type": "part",
        "label": "j",
        "prompt": "$m^2+2mn+km+2kn$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m+2n)(m+k)$",
          "worked": "$$\\begin{align*}m^2+2mn+km+2kn&=m(m+2n)+k(m+2n)\\\\m^2+2mn+km+2kn&=(m+2n)(m+k)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
