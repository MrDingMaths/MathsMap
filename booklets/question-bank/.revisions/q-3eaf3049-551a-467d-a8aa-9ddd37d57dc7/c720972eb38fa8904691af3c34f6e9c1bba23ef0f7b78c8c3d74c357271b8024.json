        "type": "part",
        "label": "c",
        "prompt": "Why do you think there is an “other” row?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It groups colours not listed separately.",
          "worked": "“Other” combines cars with colours outside the named categories, keeping the table manageable.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p5-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Darius says “This is numerical data because I have used numbers” Explain why he is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Car colour is categorical nominal data; the numbers are frequencies.",
          "worked": "The recorded variable is car colour. Colour names have no numerical order, so the data are categorical nominal. The numbers count cars in each category.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
