        "type": "part",
        "label": "e",
        "prompt": "How many fewer silver cars passed Darius's house than black cars?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16 cars.",
          "worked": "$$\\begin{align*}\\text{Difference}&=31-15\\\\\\text{Difference}&=16\\end{align*}$$ There were 16 fewer silver cars.",
