    "children": [
      {
        "id": "p34-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x}+\\dfrac{1}{x+1}+\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x^2+6x+2}{x(x+1)(x+2)}$",
          "worked": "$$\\begin{aligned}\\frac{1}{x}+\\frac{1}{x+1}+\\frac{1}{x+2}&=\\frac{(x+1)(x+2)}{x(x+1)(x+2)}+\\frac{x(x+2)}{x(x+1)(x+2)}+\\frac{x(x+1)}{x(x+1)(x+2)}\\\\&=\\frac{x^2+3x+2+x^2+2x+x^2+x}{x(x+1)(x+2)}\\\\&=\\frac{3x^2+6x+2}{x(x+1)(x+2)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p34-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x+1}+\\dfrac{2}{x+2}-\\dfrac{1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x^2+5x+5)}{(x+1)(x+2)(x+3)}$",
          "worked": "$$\\begin{aligned}\\frac{1}{x+1}+\\frac{2}{x+2}-\\frac{1}{x+3}&=\\frac{(x+2)(x+3)}{(x+1)(x+2)(x+3)}+\\frac{2(x+1)(x+3)}{(x+1)(x+2)(x+3)}-\\frac{(x+1)(x+2)}{(x+1)(x+2)(x+3)}\\\\&=\\frac{x^2+5x+6+2x^2+8x+6-(x^2+3x+2)}{(x+1)(x+2)(x+3)}\\\\&=\\frac{2(x^2+5x+5)}{(x+1)(x+2)(x+3)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
