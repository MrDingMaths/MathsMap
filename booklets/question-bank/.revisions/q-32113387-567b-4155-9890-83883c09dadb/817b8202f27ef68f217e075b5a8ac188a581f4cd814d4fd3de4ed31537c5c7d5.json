  "content": {
    "id": "p30-q13-response",
    "type": "question",
    "label": "13",
    "prompt": "Harry is a salesperson. He earns a basic wage of \\$300 per week and receives commission on all sales. Last week he sold \\$20 000 worth of goods and earned \\$700.\nWhat was Harry’s rate of commission?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\%$",
      "worked": "Let $r$ be the commission rate as a decimal.\n$$\\begin{align*}\\text{Pay} &= \\text{Retainer} + r\\times\\text{Sales}\\\\700 &= 300 + r\\times20\\,000\\\\400 &= r\\times20\\,000\\\\r &= \\frac{400}{20\\,000}\\\\r &= 0.02\\end{align*}$$\nHarry’s rate of commission is $2\\%$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
