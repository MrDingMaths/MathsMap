  "content": {
    "id": "p10-q1-group-root",
    "type": "question",
    "label": "1",
    "prompt": "True or False?",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-response",
        "type": "part",
        "label": "a",
        "prompt": "$$(2a+3b)^2=4a^2+9b^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}(2a+3b)^2&=(2a)^2+2(2a)(3b)+(3b)^2\\\\(2a+3b)^2&=4a^2+12ab+9b^2\\end{align*}$$\nFalse: the middle term $12ab$ is missing.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q2-response",
        "type": "part",
        "label": "b",
        "prompt": "$$(a-2b)(a+2b)=a^2+4b^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}(a-2b)(a+2b)&=a^2-(2b)^2\\\\(a-2b)(a+2b)&=a^2-4b^2\\end{align*}$$\nFalse: the second term is $-4b^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q3-response",
        "type": "part",
        "label": "c",
        "prompt": "$$(-3a-4b)(3a-4b)=-9a^2-16b^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}(-3a-4b)(3a-4b)&=-9a^2+12ab-12ab+16b^2\\\\(-3a-4b)(3a-4b)&=-9a^2+16b^2\\end{align*}$$\nFalse: the final term is $+16b^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q4-response",
        "type": "part",
        "label": "d",
        "prompt": "$$(3a+b)(b-3a)=-9a^2+b^2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}(3a+b)(b-3a)&=(b+3a)(b-3a)\\\\(3a+b)(b-3a)&=b^2-9a^2\\\\(3a+b)(b-3a)&=-9a^2+b^2\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
