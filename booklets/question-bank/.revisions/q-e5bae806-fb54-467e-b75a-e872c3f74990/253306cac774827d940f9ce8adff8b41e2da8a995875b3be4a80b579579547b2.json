  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "$P(x)=x^3-x^2$, $Q(x)=4-3x$. Evaluate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(1)+Q(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}P(1)&=1^3-1^2=0\\\\Q(2)&=4-3(2)=-2\\\\P(1)+Q(2)&=0+(-2)\\\\&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(3)+Q(-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25$",
          "worked": "$$\\begin{align*}P(3)&=3^3-3^2=18\\\\Q(-1)&=4-3(-1)=7\\\\P(3)+Q(-1)&=18+7\\\\&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(-2)-Q(-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-22$",
          "worked": "$$\\begin{align*}P(-2)&=(-2)^3-(-2)^2\\\\&=-12\\\\Q(-2)&=4-3(-2)=10\\\\P(-2)-Q(-2)&=-12-10\\\\&=-22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$Q(1)-P(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-17$",
          "worked": "$$\\begin{align*}Q(1)&=4-3(1)=1\\\\P(3)&=3^3-3^2=18\\\\Q(1)-P(3)&=1-18\\\\&=-17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$(P(2))^2+(Q(1))^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17$",
          "worked": "$$\\begin{align*}P(2)&=2^3-2^2=4\\\\Q(1)&=4-3(1)=1\\\\(P(2))^2+(Q(1))^2&=4^2+1^2\\\\&=16+1\\\\&=17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(P(-1))^3-(Q(-1))^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-351$",
          "worked": "$$\\begin{align*}P(-1)&=(-1)^3-(-1)^2\\\\&=-2\\\\Q(-1)&=4-3(-1)=7\\\\(P(-1))^3-(Q(-1))^3&=(-2)^3-7^3\\\\&=-8-343\\\\&=-351\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
