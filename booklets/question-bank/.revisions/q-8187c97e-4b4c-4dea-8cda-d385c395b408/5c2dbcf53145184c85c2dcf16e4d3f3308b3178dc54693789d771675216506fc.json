            "answer": {
              "short": "$\\$1332.80$",
              "worked": "$$\\begin{align*}\\text{Total pay} &= 23.80\\times56\\\\&=\\$1332.80\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
