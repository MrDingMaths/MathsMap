    "children": [
      {
        "id": "p78-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the prime factorisation of 280.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$280=2^{3}\\times5\\times7$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p78-q22-a-factor-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}280&=28\\times10\\\\280&=(2\\times2\\times7)\\times(2\\times5)\\\\280&=2^{3}\\times5\\times7\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p78-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the least positive integer $n$ for which $280n$ is a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=70$. Multiply by $2\\times5\\times7$ to make every prime exponent even.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p78-q22-b-parity-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "A perfect square has even prime exponents. In ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "280=2^{3}\\times5\\times7",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", all three exponents are odd, so multiply by one more of each prime.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p78-q22-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}n&=2\\times5\\times7\\\\n&=70\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p78-q22-b-check",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}280\\times70&=2^{4}\\times5^{2}\\times7^{2}\\\\280\\times70&=140^{2}\\end{aligned}",
                    "display": true
                  },
                  {
                    "type": "text",
                    "text": "This uses the smallest additional powers, so 70 is the least possible value.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p78-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the least positive integer $n$ for which $\\dfrac{280}{n}$ is a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=70$. Divide by $2\\times5\\times7$; $280\\div70=2^{2}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p78-q22-c-parity-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Divide out one factor of each prime with an odd exponent, leaving even exponents.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p78-q22-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}n&=2\\times5\\times7\\\\n&=70\\\\\\frac{280}{70}&=2^{2}\\\\\\frac{280}{70}&=4\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p78-q22-c-minimum-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The quotient is a perfect square. Removing the smallest required powers gives the least divisor.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
