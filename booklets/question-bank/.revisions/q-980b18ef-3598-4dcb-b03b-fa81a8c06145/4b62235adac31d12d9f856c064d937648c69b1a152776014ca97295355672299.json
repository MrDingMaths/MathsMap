          "inlines": [
            {
              "type": "text",
              "text": "Loretta earns $2829 per fortnight. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "She has work-related clothing expenses of $8.90 per week and union fees of $15.10/week. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "She earned $78 in dividends for the year and donated $80 to charity. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Calculate her annual taxable income.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$72 304.",
      "worked": "$$\\begin{align*}\\text{Annual gross income} &=2829\\times26+78\\\\&=\\$73\\,632\\\\\\text{Annual deductions} &=(8.90+15.10)\\times52+80\\\\&=\\$1328\\\\\\text{Taxable income} &=73\\,632-1328\\\\&=\\$72\\,304\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
