        "children": [],
        "answer": {
          "short": "$QS = 20\\text{ cm},\\ RS = 15\\text{ cm}$.",
          "worked": "The square of the tangent equals the product of the external segment and the whole secant.\n\n$$\\begin{aligned}QP^2 &= QR\\times QS\\\\10^2 &= 5\\times QS\\\\100 &= 5QS\\\\QS &= 20\\text{ cm}\\end{aligned}$$\n\n$$\\begin{aligned}RS &= QS-QR\\\\RS &= 20-5\\\\RS &= 15\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
