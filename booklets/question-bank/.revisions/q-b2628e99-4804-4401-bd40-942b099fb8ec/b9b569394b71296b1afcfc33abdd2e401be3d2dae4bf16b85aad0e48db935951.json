        "answer": {
          "short": "25.",
          "worked": "The coefficient must also be squared: $5^2=25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Write as an expression without brackets: $\\left(\\frac{3a}{b}\\right)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{81a^4}{b^4}$",
          "worked": "$$\\begin{align*}\\left(\\frac{3a}{b}\\right)^4&=\\frac{3^4a^4}{b^4} \\\\ &=\\frac{81a^4}{b^4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
