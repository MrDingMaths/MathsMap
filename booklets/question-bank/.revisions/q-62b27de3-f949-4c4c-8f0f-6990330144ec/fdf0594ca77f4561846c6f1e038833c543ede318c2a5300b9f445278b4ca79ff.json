          ],
          "sourceTargetId": "page-93-q6-a"
        },
        "answer": {
          "short": "$k = -4$",
          "worked": "For no solution, the lines must be parallel, so their gradients must be equal. Therefore, $k = -4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "page-93-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = kx + 4$\n$3x - 2y = 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "compare-linear-equations",
            "rearrange-to-gradient-intercept"
          ],
          "role": "assesses",
          "prerequisiteIds": [
            "graph-linear-relationship",
            "slope-intercept-interpret",
            "solve-equation-negative-coefficient"
          ],
          "archetype": "lr-audit:parameter-extension+lr-audit:rearrange-extension",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            93
          ],
          "sourceTargetId": "page-93-q6-b"
        },
        "answer": {
          "short": "$k = \\frac{3}{2}$",
          "worked": "Rearranging $3x - 2y = 5$ gives $2y = 3x - 5 \\implies y = \\frac{3}{2}x - \\frac{5}{2}$. For no solution, the lines must be parallel, so $k = \\frac{3}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "page-93-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$kx - 3y = k$\n$y = 4x + 1$",
        "layout": "list",
