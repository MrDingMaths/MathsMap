    "type": "question",
    "label": null,
    "prompt": "For what value of $k$ will these pairs of simultaneous equations have no solution?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "page-93-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = -4x - 7$\n$y = kx + 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
