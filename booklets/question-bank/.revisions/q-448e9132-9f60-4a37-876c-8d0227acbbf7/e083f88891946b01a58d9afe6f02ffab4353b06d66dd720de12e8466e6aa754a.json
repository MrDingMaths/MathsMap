  "content": {
    "id": "p5-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Add and subtract these fractions, then simplify the result.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{5x}{10}+\\frac{3x}{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4x}{5}$",
          "worked": "$\\begin{aligned}\\frac{5x}{10}+\\frac{3x}{10}&=\\frac{8x}{10}\\\\&=\\frac{4x}{5}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p5-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{a}{8}+\\dfrac{a}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a}{4}$",
          "worked": "$\\begin{aligned}\\frac{a}{8}+\\frac{a}{8}&=\\frac{2a}{8}\\\\&=\\frac{a}{4}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3n}{4}+\\frac{n}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n$",
          "worked": "$\\begin{aligned}\\frac{3n}{4}+\\frac{n}{4}&=\\frac{4n}{4}\\\\&=n\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{8}{9x}-\\dfrac{2}{9x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3x}$",
          "worked": "$\\begin{aligned}\\frac{8}{9x}-\\frac{2}{9x}&=\\frac{6}{9x}\\\\&=\\frac{2}{3x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3c}{2}+\\frac{5c}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4c$",
          "worked": "$\\begin{aligned}\\frac{3c}{2}+\\frac{5c}{2}&=\\frac{8c}{2}\\\\&=4c\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{11h}{18}-\\dfrac{h}{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5h}{9}$",
          "worked": "$\\begin{aligned}\\frac{11h}{18}-\\frac{h}{18}&=\\frac{10h}{18}\\\\&=\\frac{5h}{9}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{11}{3x}-\\dfrac{2}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{x}$",
          "worked": "$\\begin{aligned}\\frac{11}{3x}-\\frac{2}{3x}&=\\frac{9}{3x}\\\\&=\\frac{3}{x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{5y}{12}+\\dfrac{3y}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2y}{3}$",
          "worked": "$\\begin{aligned}\\frac{5y}{12}+\\frac{3y}{12}&=\\frac{8y}{12}\\\\&=\\frac{2y}{3}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p5-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{13a}{18}-\\dfrac{4a}{18}$",
