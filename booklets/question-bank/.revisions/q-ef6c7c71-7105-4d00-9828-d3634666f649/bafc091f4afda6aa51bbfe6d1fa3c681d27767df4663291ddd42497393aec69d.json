    "children": [
      {
        "id": "p18-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\angle FBE$ and $\\angle DBE$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Complementary.",
          "worked": "$$\\angle FBE+\\angle DBE=90^\\circ$$\nThey divide the marked right angle $FBD$, so they are complementary.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\angle ABE$ and $\\angle CBE$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Supplementary.",
          "worked": "$$\\angle ABE+\\angle CBE=180^\\circ$$\nThey form the straight angle $ABC$, so they are supplementary.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\angle FBE$ and $\\angle DBC$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot be determined from the given information.",
          "worked": "The marked right angle and straight line give $\\angle FBA+\\angle DBC=90^\\circ$. The requested pair would be complementary if $\\angle FBE=\\angle FBA$, but no marking establishes or excludes this equality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\angle FBC$ and $\\angle FBA$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Supplementary.",
          "worked": "$$\\angle FBC+\\angle FBA=180^\\circ$$\nThey form the straight angle $ABC$, so they are supplementary.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\angle FBA$ and $\\angle DBC$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Complementary.",
          "worked": "Angles on the straight line sum to $180^\\circ$, and $\\angle FBD=90^\\circ$.\n$$\\begin{align*}\\angle FBA+90^\\circ+\\angle DBC&=180^\\circ\\\\\\angle FBA+\\angle DBC&=180^\\circ-90^\\circ\\\\\\angle FBA+\\angle DBC&=90^\\circ\\end{align*}$$\nThe angles are complementary.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p18-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\angle FBA$ and $\\angle EBD$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot be determined from the given information.",
          "worked": "The marked right angle gives $\\angle FBE+\\angle EBD=90^\\circ$. The requested pair would be complementary if $\\angle FBA=\\angle FBE$, but no marking establishes or excludes this equality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ],
