  "content": {
    "id": "p18-q8-group",
    "type": "question",
    "label": "8",
    "prompt": "State whether these pairs of angles are complementary, supplementary, or neither. If the given information is insufficient, say so.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "p18-q8-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 18, p18-q8-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,draw=black,text=black,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,inner sep=1.5pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (-1.8,0);\n\\coordinate (B) at (0,0);\n\\coordinate (C) at (1.8,0);\n\\coordinate (F) at (-1.4,1.5);\n\\coordinate (E) at (-0.3,1.8);\n\\coordinate (D) at (1.5,1.4);\n\\draw[line width=0.8pt] (A)--(B)--(C);\n\\draw[line width=0.8pt] (F)--(B)--(D);\n\\draw[line width=0.8pt] (B)--(E);\n\\coordinate (RF) at ($(B)!0.23cm!(F)$);\n\\coordinate (RD) at ($(B)!0.23cm!(D)$);\n\\coordinate (RC) at ($(RF)+(RD)-(B)$);\n\\draw[line width=0.4pt] (RF)--(RC)--(RD);\n\\path (A) node[left] {$A$} (B) node[below] {$B$} (C) node[right] {$C$} (F) node[above left] {$F$} (E) node[above] {$E$} (D) node[above right] {$D$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 48,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 18,
          "sourceRegion": "Question 8, right of the six-part response grid",
          "description": "Unshaded shared five-arm diagram at B. A–B–C is horizontal. Above the line, the arms occur in order BA, BF, BE, BD, BC. Endpoint labels are outside the geometry, with B below the vertex. A right-angle square spans BF to BD and is crossed by BE.",
          "mathematics": "A, B and C are collinear with B between A and C. BF is perpendicular to BD. BE lies strictly inside angle FBD. Coordinates reproduce the source arrangement and enforce the marked perpendicular relationship; they do not supply numerical angle measures or equal-angle claims.",
          "answerVisibility": "All arms, labels and the right-angle mark are permanent question content. No answers or additional measurements appear."
