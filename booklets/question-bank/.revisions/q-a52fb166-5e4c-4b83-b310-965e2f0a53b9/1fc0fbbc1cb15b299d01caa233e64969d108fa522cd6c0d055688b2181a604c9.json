    "answer": {
      "short": "$54$. Use the new total: $(5\\times62+14)\\div6$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p29-q23-supplied-answer",
