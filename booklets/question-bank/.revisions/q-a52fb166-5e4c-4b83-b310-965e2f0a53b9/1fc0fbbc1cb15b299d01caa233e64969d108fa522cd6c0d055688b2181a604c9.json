            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}x&=\\frac{5(62)+14}{6}\\\\x&=\\frac{324}{6}\\\\x&=54\\end{align*}",
                "display": true,
