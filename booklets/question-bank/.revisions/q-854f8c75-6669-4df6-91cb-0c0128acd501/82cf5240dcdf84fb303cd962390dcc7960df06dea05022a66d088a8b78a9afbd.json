        "id": "p39-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the height of the candle initially?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "300 mm",
          "worked": "At $t=0$, the graph shows a height of $300$ mm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p39-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "How long does it take for the height to decrease to 180 mm?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 hours",
          "worked": "Read across from $180$ mm to the line, then down to the time axis: $t=4$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "How long does it take for 180 mm of the candle to be used?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 hours",
          "worked": "The remaining height is $300-180=120$ mm. Read across from $120$ mm to the line, then down to the time axis: $t=6$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p39-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "At what rate is the candle’s height decreasing per hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "30 mm per hour",
          "worked": "$$\\begin{aligned}m&=\\frac{120-300}{6-0}\\\\m&=-30\\end{aligned}$$\nThe candle’s height decreases by $30$ mm per hour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p39-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Write an equation relating height $h$ and time $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=-30t+300$",
          "worked": "The gradient is $-30$ and the initial height is $300$ mm.\n$$\\begin{aligned}h&=mt+c\\\\h&=-30t+300\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p39-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "Predict when the candle will be completely used up.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "10 hours",
          "worked": "When the candle is completely used up, $h=0$.\n$$\\begin{aligned}0&=-30t+300\\\\30t&=300\\\\t&=10\\end{aligned}$$\nThe model predicts $10$ hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ],
