        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"parabola series\"}],\"reference\":\"PDF page 70, p70-q72-diagram\"}\n\\usetikzlibrary{calc}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-2.05,-0.45) rectangle (2.05,3.35);\n\\coordinate (V) at (0,0);\n\\coordinate (P) at (1.5,2.25);\n\\coordinate (Q) at (-0.6666667,0.4444444);\n\\draw[black,line width=0.5pt,->] (-1.9,0)--(1.95,0) node[below] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-0.4)--(0,3.2) node[left] {$y$};\n\\draw[curveBlue,line width=0.8pt,<->] plot[domain=-1.75:1.75,samples=100] (\\x,{\\x*\\x});\n\\draw[black,line width=0.8pt] (P)--(V)--(Q);\n\\draw[black,line width=0.4pt,dashed] (Q)--(P);\n\\coordinate (R1) at ($(V)!0.16cm!(P)$);\n\\coordinate (R3) at ($(V)!0.16cm!(Q)$);\n\\draw[black,line width=0.4pt] (R1)--($(R1)+(R3)-(V)$)--(R3);\n\\fill[black] (P) circle (1.3pt) node[right] {$P$};\n\\fill[black] (Q) circle (1.3pt) node[below left] {$Q$};\n\\end{tikzpicture}",
