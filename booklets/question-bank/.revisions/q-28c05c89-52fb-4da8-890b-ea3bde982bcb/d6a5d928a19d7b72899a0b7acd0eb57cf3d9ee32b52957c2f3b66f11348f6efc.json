        "children": [],
        "answer": {
          "short": "$36x^{11}y^{4}$",
          "worked": "$$\\begin{align*}\n12x^{6}y^{2} \\times 3x^{5}y^{2} &= 12\\times3\\,x^{6 + 5}\\,y^{2 + 2} \\\\\n&= 36x^{11}y^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-d",
