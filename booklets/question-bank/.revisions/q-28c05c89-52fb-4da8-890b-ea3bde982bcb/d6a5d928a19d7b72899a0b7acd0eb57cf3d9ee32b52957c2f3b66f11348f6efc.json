        "prompt": "$\\frac{a^{3} \\times a^{5}}{a^{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{2}$",
          "worked": "$$\\begin{align*}\n\\frac{a^{3} \\times a^{5}}{a^{6}} &= a^{3 + 5 - 6} \\\\\n&= a^{2}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x^{3} \\times 3x^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^{8}$",
          "worked": "$$\\begin{align*}\n2x^{3} \\times 3x^{5} &= 2\\times3\\,x^{3 + 5} \\\\\n&= 6x^{8}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{a^{6}}{a^{3} \\times a^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a^{2}}$",
          "worked": "$$\\begin{align*}\n\\frac{a^{6}}{a^{3} \\times a^{5}} &= \\frac{1}{a^{- 6 + 3 + 5}} \\\\\n&= \\frac{1}{a^{2}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-g",
        "type": "part",
        "label": "g",
        "prompt": "$2x^{3}y^{2} \\times 3x^{5}y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^{8}y^{4}$",
          "worked": "$$\\begin{align*}\n2x^{3}y^{2} \\times 3x^{5}y^{2} &= 2\\times3\\,x^{3 + 5}\\,y^{2 + 2} \\\\\n&= 6x^{8}y^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x^{6}}{a^{3} \\times a^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{6}}{a^{8}}$",
          "worked": "$$\\begin{align*}\n\\frac{x^{6}}{a^{3} \\times a^{5}} &= \\frac{x^{6}}{a^{3 + 5}} \\\\\n&= \\frac{x^{6}}{a^{8}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-h",
        "type": "part",
        "label": "h",
        "prompt": "$12x^{6}y^{2} \\times 3x^{5}y^{2}$",
        "layout": "list",
        "columns": null,
