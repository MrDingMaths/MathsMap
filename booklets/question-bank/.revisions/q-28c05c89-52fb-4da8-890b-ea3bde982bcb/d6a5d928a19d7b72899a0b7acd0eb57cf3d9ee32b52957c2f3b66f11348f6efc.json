        "answer": {
          "short": "$\\frac{2}{x^{2}}$",
          "worked": "$$\\begin{align*}\n\\frac{12x^{6}}{2x^{3} \\times 3x^{5}} &= \\frac{12}{2\\times3\\,x^{- 6 + 3 + 5}} \\\\\n&= \\frac{2}{x^{2}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
