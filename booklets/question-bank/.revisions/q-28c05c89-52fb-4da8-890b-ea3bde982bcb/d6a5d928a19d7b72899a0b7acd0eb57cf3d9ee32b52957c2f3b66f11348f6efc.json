          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q15-i",
        "type": "part",
        "label": "i",
        "prompt": "$12x^{6}y^{2} \\div 3x^{5}y^{2}$",
