    "children": [],
    "answer": {
      "short": "110 tiles. The largest tile has side length $\\operatorname{HCF}(60,66)=6\\text{ m}$, so $10\\times11=110$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p79-q28-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The fewest tiles are needed when their side length is the HCF of 60 and 66.",
                "marks": []
              }
            ]
          },
          {
            "id": "p79-q28-hcf-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}60&=2^2\\times3^1\\times5^1\\times11^0\\\\66&=2^1\\times3^1\\times5^0\\times11^1\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p79-q28-smallest-powers",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Choose the smallest power of each prime.",
                "marks": []
              }
            ]
          },
          {
            "id": "p79-q28-tile-side-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\operatorname{HCF}(60,66)&=2^1\\times3^1\\times5^0\\times11^0\\\\\\operatorname{HCF}(60,66)&=6\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "p79-q28-largest-tile",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The largest square tile has side length ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "6\\text{ m}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p79-q28-tile-count-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\text{Number of tiles}&=\\left(\\frac{60}{6}\\right)\\times\\left(\\frac{66}{6}\\right)\\\\\\text{Number of tiles}&=10\\times11\\\\\\text{Number of tiles}&=110\\end{align*}",
                "display": true
              }
            ]
          }
        ]
