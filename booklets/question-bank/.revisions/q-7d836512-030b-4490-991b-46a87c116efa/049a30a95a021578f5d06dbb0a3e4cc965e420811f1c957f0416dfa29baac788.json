        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"user-authorised rectangle, 16 October 2026\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,line width=0.8pt,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\draw (0,0) rectangle (44,40);\n\\node[below] at (22,0) {$66\\text{ m}$};\n\\node[left] at (0,20) {$60\\text{ m}$};\n\\end{tikzpicture}",
