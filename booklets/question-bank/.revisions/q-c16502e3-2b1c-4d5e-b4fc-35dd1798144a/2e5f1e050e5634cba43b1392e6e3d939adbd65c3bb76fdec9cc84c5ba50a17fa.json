    ],
    "children": [
      {
        "id": "p38-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "The Moon is approximately 384,400 km from the Earth.\nCalculate the distance the Moon travels in one orbit of Earth.\nRound to the nearest whole.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\,415\\,256\\text{ km}$",
          "worked": "$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi\\times384\\,400\\\\C&\\approx2\\,415\\,256\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p38-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "The Moon takes 27.32 days to orbit the Earth.\nCalculate how many kilometres it travels per hour.\nRound to the nearest whole.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3684\\text{ km/h}$. Divide the unrounded orbital distance by $27.32\\times24$ hours.",
          "worked": "$$\\begin{align*}\\text{Distance per day}&=\\frac{2\\pi\\times384\\,400}{27.32}\\text{ km/day}\\\\\\text{Distance per hour}&=\\frac{2\\pi\\times384\\,400}{27.32}\\div24\\text{ km/h}\\\\\\text{Distance per hour}&=\\frac{2\\pi\\times384\\,400}{27.32\\times24}\\text{ km/h}\\\\\\text{Distance per hour}&\\approx3684\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p38-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "The Earth is approximately 150 million km from the Sun. It orbits the Sun in 365.25 days.\nCalculate how many kilometres it travels around the Sun each hour.\nRound to the nearest whole.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$107\\,515\\text{ km/h}$. Divide $2\\pi\\times150\\,000\\,000$ km by $365.25\\times24$ hours.",
          "worked": "$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi\\times150\\,000\\,000\\text{ km}\\\\\\text{Orbital time}&=365.25\\times24\\text{ hours}\\\\\\text{Distance per hour}&=\\frac{2\\pi\\times150\\,000\\,000}{365.25\\times24}\\text{ km/h}\\\\\\text{Distance per hour}&\\approx107\\,515\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
