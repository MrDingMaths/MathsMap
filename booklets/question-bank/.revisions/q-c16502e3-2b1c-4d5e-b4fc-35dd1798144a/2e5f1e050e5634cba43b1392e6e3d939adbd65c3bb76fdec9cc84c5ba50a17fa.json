  "content": {
    "id": "p38-q14",
    "type": "question",
    "label": "14",
    "prompt": "An object in space orbits another object on a path that is very close to a circle.\nAnswer these questions rounded to the nearest whole number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p38-q14-orbit-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 38 p38-q14-orbit-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-2.85,-2.75) rectangle (2.75,2.75);\n\\coordinate (E) at (0,0);\n\\coordinate (M) at (192:2.35);\n\\draw[black,line width=0.8pt,dashed] (E) circle[radius=2.35];\n\\draw[black,line width=0.8pt] (M) -- node[midway,above,sloped] {$384\\,400\\ \\mathrm{km}$} (E);\n\\draw[black,line width=0.8pt] (E) circle[radius=0.09];\n\\fill[black] (E) circle[radius=0.025];\n\\fill[black] (M) circle[radius=0.035];\n\\node[above=2mm] at (E) {E};\n\\node[below right=1mm] at (M) {M};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 60,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 38,
          "sourceRegion": "Q14 orbit figure to the right of parts a and b",
          "description": "Dashed circular orbit centred on Earth E, with Moon M on its lower-left circumference and the Earth–Moon radius labelled 384 400 km.",
          "mathematics": "The Earth–Moon distance is the radius of the circular orbit.",
          "answerVisibility": "Permanent given diagram; no calculated responses."
        },
        "derived": false,
