      {
        "id": "p38-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "From the graph, find the cost of travelling 22 km.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$60$",
          "worked": "Read up from 22 km to the model line, then across to the cost axis: $\\$60$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "How far can a passenger travel for $\\$30$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "10 km",
          "worked": "Read across from $\\$30$ to the model line, then down to the distance axis: 10 km.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the $y$-intercept.\nWhat is its meaning in this situation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5$; the initial cost of hiring the taxi.",
          "worked": "The line meets the cost axis at $\\$5$, when the distance is 0 km. This is the initial cost of hiring the taxi.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p38-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Identify the gradient. What is its meaning in this situation?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2.5$; the cost increases by $\\$2.50$ per km.",
          "worked": "Using $(0,5)$ and $(10,30)$:\n$$\\begin{align*}m&=\\frac{\\text{change in cost}}{\\text{change in distance}}\\\\m&=\\frac{30-5}{10-0}\\\\m&=2.5\\end{align*}$$\nThe cost increases by $\\$2.50$ for each kilometre travelled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p38-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "Write an equation relating cost $C$ and distance $d$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C=2.5d+5$",
          "worked": "The gradient is 2.5 and the initial cost is 5.\n$$\\begin{align*}C&=md+c\\\\C&=2.5d+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ],
