  "content": {
    "id": "p9-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A rectangular room is 5.4 m long and 3.2 m wide.\nWhat is the lower limit for the area of the room?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16.8525\\text{ m}^2$, using the lower length and width limits.",
      "worked": "Both measurements have precision $0.1\\text{ m}$.\n$$\\begin{align*}\n\\text{Absolute error} &= \\tfrac12\\times0.1 = 0.05\\text{ m}\\\\\n\\text{Lower length limit} &= 5.4-0.05 = 5.35\\text{ m}\\\\\n\\text{Lower width limit} &= 3.2-0.05 = 3.15\\text{ m}\\\\\n\\text{Lower area limit} &= 5.35\\times3.15 = 16.8525\\text{ m}^2\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
