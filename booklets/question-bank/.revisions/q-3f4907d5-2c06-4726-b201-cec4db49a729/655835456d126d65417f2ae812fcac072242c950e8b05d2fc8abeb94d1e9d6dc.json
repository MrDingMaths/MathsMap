        "id": "p38-q13-rectangle",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User feedback 19 October 2026\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\draw[black] (0,0) rectangle (4.8,1);\n\\path (0,0)--(4.8,0) node[midway,below] {$24\\text{ m}$};\n\\path (0,0)--(0,1) node[midway,left] {$5\\text{ m}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 60,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
