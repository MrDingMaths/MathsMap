          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Hint: explore ",
              "marks": []
            },
            {
              "type": "text",
              "text": "construction 1",
              "marks": [],
              "href": "https://www.desmos.com/geometry/oi2zmkiaqn"
            },
