  "content": {
    "id": "index-t8-q9-root",
    "type": "question",
    "label": null,
    "prompt": "Read the example carefully and answer the questions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t8-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "By expanding and writing out $(ab^5)^2$, show why this is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "index-doc-1326",
            "role": "question",
            "format": "image",
            "code": null,
            "src": "/booklet-assets/projects/index-laws-complete-v1/3350f5dbe3bd-image59.png",
            "widthMm": 69.76180555555555,
            "alt": "Source mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "sourceRegion": {
              "x": 0,
              "y": 0,
              "width": 572,
              "height": 362,
              "sourceWidth": 572,
              "sourceHeight": 362
            },
            "derived": false
          }
        ],
        "children": [],
        "answer": {
          "short": "$a^2b^{10}$",
          "worked": "$$\\begin{align*}(ab^5)^2&=ab^5\\times ab^5 \\\\ &=a^2b^{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t8-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $(cj^3)^5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c^5j^{15}$",
          "worked": "$$\\begin{align*}(cj^3)^5&=c^5j^{3\\times5} \\\\ &=c^5j^{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t8-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why we need brackets for $(-10)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "index-doc-1327",
            "role": "question",
            "format": "image",
            "code": null,
            "src": "/booklet-assets/projects/index-laws-complete-v1/fec50f348e9e-image60.png",
            "widthMm": 68.65744444444445,
            "alt": "Source mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "sourceRegion": {
              "x": 0,
              "y": 0,
              "width": 384,
              "height": 295,
              "sourceWidth": 384,
              "sourceHeight": 295
            },
            "derived": false
          }
        ],
        "children": [],
        "answer": {
          "short": "$(-10)^2=100$, but $-10^2=-100$.",
          "worked": "The brackets make $-10$ the base: $(-10)(-10)=100$. Without brackets, only $10$ is squared, so $-10^2=-(10\\times10)=-100$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t8-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "Simplify $(-2b^3)^2\\times b^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b^{10}$",
          "worked": "$$\\begin{align*}(-2b^3)^2\\times b^4&=4b^6\\times b^4 \\\\ &=4b^{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
