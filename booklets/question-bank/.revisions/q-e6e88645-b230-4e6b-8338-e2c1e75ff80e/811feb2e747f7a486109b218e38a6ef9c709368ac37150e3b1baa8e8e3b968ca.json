            {
              "type": "text",
              "text": "Two teams play a game of football.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The probability that team A wins is 0.3.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The probability that team B wins is 0.23.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "What is the probability of a draw?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.47$",
      "worked": "$$\\begin{align*}P(\\text{draw})&=1-\\bigl(P(\\text{A wins})+P(\\text{B wins})\\bigr)\\\\P(\\text{draw})&=1-(0.3+0.23)\\\\P(\\text{draw})&=0.47\\end{align*}$$",
      "solutionDiagrams": []
    },
