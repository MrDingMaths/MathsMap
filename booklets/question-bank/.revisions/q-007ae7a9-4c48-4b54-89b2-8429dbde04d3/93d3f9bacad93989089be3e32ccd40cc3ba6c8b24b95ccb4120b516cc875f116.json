  "content": {
    "id": "p35-q22-root",
    "type": "question",
    "label": "22",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p35-q22-introduction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Some expressions with powers of 4 can be factorised as a difference of two squares.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Look at the example and factorise the following.",
              "marks": []
            }
          ]
        },
        {
          "id": "p35-q22-example",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}x^4-y^4&=(x^2+y^2)(x^2-y^2)\\\\&=(x^2+y^2)(x+y)(x-y)\\end{aligned}",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "$1-w^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-w)(1+w)(w^2+1)$",
          "worked": "$\\begin{align*}1-w^4&=(1-w^2)(1+w^2)\\\\&=(1-w)(1+w)(w^2+1)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^4}{3}-\\dfrac{y^4}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(x-y)(x+y)(x^2+y^2)}{3}$",
          "worked": "$\\begin{align*}\\frac{x^4}{3}-\\frac{y^4}{3}&=\\frac{x^4-y^4}{3}\\\\&=\\frac{(x^2+y^2)(x^2-y^2)}{3}\\\\&=\\frac{(x-y)(x+y)(x^2+y^2)}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p35-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "$2a^4-32b^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(a-2b)(a+2b)(a^2+4b^2)$",
          "worked": "$\\begin{align*}2a^4-32b^4&=2(a^4-16b^4)\\\\&=2(a^2-4b^2)(a^2+4b^2)\\\\&=2(a-2b)(a+2b)(a^2+4b^2)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p35-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3a^8}{16}-\\dfrac{3b^4}{625}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\left(\\dfrac{a^2}{2}-\\dfrac b5\\right)\\left(\\dfrac{a^2}{2}+\\dfrac b5\\right)\\left(\\dfrac{a^4}{4}+\\dfrac{b^2}{25}\\right)$",
          "worked": "$\\begin{align*}\\frac{3a^8}{16}-\\frac{3b^4}{625}&=3\\left[\\left(\\frac{a^4}{4}\\right)^2-\\left(\\frac{b^2}{25}\\right)^2\\right]\\\\&=3\\left(\\frac{a^4}{4}-\\frac{b^2}{25}\\right)\\left(\\frac{a^4}{4}+\\frac{b^2}{25}\\right)\\\\&=3\\left(\\frac{a^2}{2}-\\frac b5\\right)\\left(\\frac{a^2}{2}+\\frac b5\\right)\\times\\left(\\frac{a^4}{4}+\\frac{b^2}{25}\\right)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p35-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "$5w^5-80w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5w(w-2)(w+2)(w^2+4)$",
          "worked": "$\\begin{align*}5w^5-80w&=5w(w^4-16)\\\\&=5w(w^2-4)(w^2+4)\\\\&=5w(w-2)(w+2)(w^2+4)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p35-q22-f",
        "type": "part",
        "label": "f",
        "prompt": "$w^6-w^4-w^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(w-1)^2(w+1)^2(w^2+1)$",
          "worked": "$\\begin{align*}w^6-w^4-w^2+1&=w^4(w^2-1)-(w^2-1)\\\\&=(w^2-1)(w^4-1)\\\\&=(w^2-1)^2(w^2+1)\\\\&=(w-1)^2(w+1)^2(w^2+1)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
