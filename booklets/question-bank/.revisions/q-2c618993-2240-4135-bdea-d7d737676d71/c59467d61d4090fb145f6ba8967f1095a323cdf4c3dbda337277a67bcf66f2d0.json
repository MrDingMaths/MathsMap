  "content": {
    "id": "nr-p10-q6-content",
    "type": "question",
    "label": "6",
    "prompt": "A ship heads due north from point $A$ for $40\\text{ km}$ to point $B$, and then heads on a bearing of $100^\\circ$ to point $C$. The bearing from $C$ to $A$ is $240^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "nr-p10-q6-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[\"sourceblue\"],\"semantic\":[],\"reference\":\"nr-p10-q6-diagram\"}\n\\begin{tikzpicture}[every node/.style={font=\\LARGE}]\n% mathsmap-standard-palette 2026-09-11\n\\definecolor{ink}{HTML}{24282D}\n\\definecolor{blue}{HTML}{268CFF}\n\\definecolor{red}{HTML}{EF6068}\n\\definecolor{green}{HTML}{4F9B63}\n\\definecolor{orange}{HTML}{EF8B2C}\n\\definecolor{tableLabel}{HTML}{D3E8FC}\n\\definecolor{housegrid}{HTML}{CCCCCC}\n\\definecolor{skipped}{HTML}{C7C7C7}\n\\definecolor{housemuted}{HTML}{777777}\n\\definecolor{blueFill}{HTML}{D4E8FF}\n\\definecolor{redFill}{HTML}{FCDFE1}\n\\definecolor{greenFill}{HTML}{DCEBE0}\n\\definecolor{orangeFill}{HTML}{FCE8D5}\n\\usetikzlibrary{calc,arrows.meta}\n\\definecolor{sourceblue}{HTML}{000000}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\" data-graph-source-palette=\"253F8E\" data-graph-source-reference=\"PDF page 10, nr-p10-q6-diagram\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (0,3.5);\n\\coordinate (C) at (3.3,2.65);\n\\draw[sourceblue,line width=0.8pt] (A)--(B) node[midway,left,text=black] {$40\\text{ km}$};\n\\draw[sourceblue,line width=0.8pt] (B)--(C);\n\\draw[sourceblue,line width=0.8pt] (C)--(A);\n\\draw[black,line width=0.5pt,-{Stealth}] (B)--($(B)+(0,1.15)$) node[right] {$\\mathrm{N}$};\n\\draw[black,line width=0.5pt,-{Stealth}] (C)--($(C)+(0,1.15)$) node[right] {$\\mathrm{N}$};\n\\node[below left] at (A) {$A$};\n\\node[left] at (B) {$B$};\n\\node[right] at (C) {$C$};\n\\special{dvisvgm:raw <metadata data-diagram-colours=\"1\" data-diagram-kind=\"geometry\" data-diagram-base=\"sourceblue\" data-diagram-semantic-palette=\"\" data-diagram-semantic-reference=\"nr-p10-q6-diagram\" data-diagram-semantic-reasons=\"\"/>}\n\\end{tikzpicture}",
        "src": null,
