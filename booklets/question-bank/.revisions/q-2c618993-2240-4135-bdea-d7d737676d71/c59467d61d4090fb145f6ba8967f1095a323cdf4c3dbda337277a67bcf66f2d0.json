    "children": [
      {
        "id": "nr-p10-q6a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\angle ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle ABC=80^\\circ$",
          "worked": "$BA$ is due south from $B$.\n$$\\begin{align*}\\angle ABC&=180^\\circ-100^\\circ\\\\&=80^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "nr-p10-q6b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find distance $AC$, to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AC=61.3\\text{ km}$",
          "worked": "The reverse bearing from $A$ to $C$ is $240^\\circ-180^\\circ=60^\\circ$, so $\\angle BAC=60^\\circ$.\n$\\angle ACB=180^\\circ-80^\\circ-60^\\circ=40^\\circ$.\n$$\\begin{align*}\\frac{AC}{\\sin80^\\circ}&=\\frac{40}{\\sin40^\\circ}\\\\[8pt]AC&=\\frac{40\\sin80^\\circ}{\\sin40^\\circ}\\\\[8pt]AC&\\approx61.3\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "nr-p10-q6c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find distance $BC$, to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$BC=53.9\\text{ km}$",
          "worked": "$$\\begin{align*}\\frac{BC}{\\sin60^\\circ}&=\\frac{40}{\\sin40^\\circ}\\\\[8pt]BC&=\\frac{40\\sin60^\\circ}{\\sin40^\\circ}\\\\[8pt]BC&\\approx53.9\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
