  "content": {
    "id": "p12-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Find $A \\cup B$ and $A \\cap B$ for each pair of sets.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "$A=\\{1,3,5\\}$, $B=\\{3,5,7\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{1,3,5,7\\}$; $A\\cap B=\\{3,5\\}$.",
          "worked": "The union contains every element in either set, without repetition. The intersection contains the elements in both sets.\n$$\\begin{aligned}A\\cup B&=\\{1,3,5,7\\}\\\\A\\cap B&=\\{3,5\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "$A=\\{1,3,4,8,9\\}$, $B=\\{2,4,5,6,9,10\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{1,2,3,4,5,6,8,9,10\\}$; $A\\cap B=\\{4,9\\}$.",
          "worked": "List each element from either set once for the union. Only 4 and 9 belong to both sets.\n$$\\begin{aligned}A\\cup B&=\\{1,2,3,4,5,6,8,9,10\\}\\\\A\\cap B&=\\{4,9\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "$A=\\{h,o,b,a,r,t\\}$, $B=\\{b,i,c,h,e,n,o\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{h,o,b,a,r,t,i,c,e,n\\}$; $A\\cap B=\\{h,o,b\\}$.",
          "worked": "The union lists all distinct letters in either set. The common letters are $h$, $o$ and $b$.\n$$\\begin{aligned}A\\cup B&=\\{h,o,b,a,r,t,i,c,e,n\\}\\\\A\\cap B&=\\{h,o,b\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "$A=\\{j,a,c,k\\}$, $B=\\{e,m,m,a\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A\\cup B=\\{j,a,c,k,e,m\\}$; $A\\cap B=\\{a\\}$.",
          "worked": "The repeated $m$ represents one element. List each distinct element once for the union; only $a$ belongs to both sets.\n$$\\begin{aligned}A\\cup B&=\\{j,a,c,k,e,m\\}\\\\A\\cap B&=\\{a\\}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "$A=\\{\\text{prime numbers less than }10\\}$, $B=\\{\\text{odd numbers less than }10\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p12-q22-root-bank-p12-q22-e-givens",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "A=\\{2,3,5,7\\},\\quad B=\\{1,3,5,7,9\\}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p12-q22-root-bank-p12-q22-e-union",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "A\\cup B=\\{1,2,3,5,7,9\\}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p12-q22-root-bank-p12-q22-e-intersection",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "A\\cap B=\\{3,5,7\\}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{aligned}A&=\\{2,3,5,7\\}\\\\B&=\\{1,3,5,7,9\\}\\\\A\\cup B&=\\{1,2,3,5,7,9\\}\\\\A\\cap B&=\\{3,5,7\\}\\end{aligned}$$\nThe union contains all distinct elements in either set; the intersection contains the common elements.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
