          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A bag contains coins. The gold coins are the $1 and $2 coins. When a coin is chosen at random, the probability that it is $1 is ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{3}{10}",
              "display": false
            },
            {
              "type": "text",
              "text": " and the probability that it is $2 is ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{2}{5}",
              "display": false
            },
            {
              "type": "text",
              "text": ". What is the probability that it is not a gold coin?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{10}$",
      "worked": "$$\\begin{align*}P(\\text{not gold})&=1-P(\\text{gold})\\\\P(\\text{not gold})&=1-\\left(\\frac{3}{10}+\\frac{2}{5}\\right)\\\\P(\\text{not gold})&=1-\\left(\\frac{3}{10}+\\frac{4}{10}\\right)\\\\P(\\text{not gold})&=1-\\frac{7}{10}\\\\P(\\text{not gold})&=\\frac{3}{10}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
