  "content": {
    "id": "p11-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Cedric earns an amount $\\$x$ every week. He spends $\\frac{1}{3}$ of his income on rent and $\\frac{1}{4}$ on groceries.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an algebraic fraction for the amount of money he spends on rent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{3}$ dollars",
          "worked": "$$\\begin{align*}\\text{Rent} &= \\frac{1}{3}\\times x\\\\&= \\frac{x}{3}\\end{align*}$$\nThe amount is $\\frac{x}{3}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an algebraic fraction for the amount of money he spends on groceries.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{4}$ dollars",
          "worked": "$$\\begin{align*}\\text{Groceries} &= \\frac{1}{4}\\times x\\\\&= \\frac{x}{4}\\end{align*}$$\nThe amount is $\\frac{x}{4}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Write a simplified algebraic fraction for the total amount of money he spends on rent and groceries.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{12}$ dollars",
          "worked": "$$\\begin{align*}\\frac{x}{3}+\\frac{x}{4} &= \\frac{4x}{12}+\\frac{3x}{12}\\\\&= \\frac{4x+3x}{12}\\\\&= \\frac{7x}{12}\\end{align*}$$\nThe total amount is $\\frac{7x}{12}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q7-root-bank-p11-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Write a simplified algebraic fraction for the income Cedric has left after rent and groceries.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x}{12}$ dollars",
          "worked": "$$\\begin{align*}x-\\frac{7x}{12}&=\\frac{12x}{12}-\\frac{7x}{12}\\\\&=\\frac{5x}{12}\\end{align*}$$\nThe amount is $\\frac{5x}{12}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q7-root-bank-p11-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "How much more does he spend on rent and groceries than he has left?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{6}$ dollars",
          "worked": "$$\\begin{align*}\\frac{7x}{12}-\\frac{5x}{12}&=\\frac{2x}{12}\\\\&=\\frac{x}{6}\\end{align*}$$\nThe difference is $\\frac{x}{6}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
