      {
        "id": "p20-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2(x+1)}{3}>x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<-13$",
          "worked": "$$\\begin{align*}2(x+1)&>3(x+5)\\\\2x+2&>3x+15\\\\-x&>13\\\\x&<-13\\end{align*}$$\nReverse the inequality sign when dividing by $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p20-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x+3\\ge\\frac{x-6}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge-3$",
          "worked": "$$\\begin{align*}3(2x+3)&\\ge x-6\\\\6x+9&\\ge x-6\\\\5x&\\ge-15\\\\x&\\ge-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2-3x}{2}<2x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac{4}{7}$",
          "worked": "$$\\begin{align*}2-3x&<2(2x-1)\\\\2-3x&<4x-2\\\\-7x&<-4\\\\x&>\\frac{4}{7}\\end{align*}$$\nReverse the inequality sign when dividing by $-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p20-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{4(2x-1)}{3}\\le x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le\\frac{13}{5}$",
          "worked": "$$\\begin{align*}4(2x-1)&\\le3(x+3)\\\\8x-4&\\le3x+9\\\\5x&\\le13\\\\x&\\le\\frac{13}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p20-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$1-x>\\frac{7(2-3x)}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac{10}{17}$",
          "worked": "$$\\begin{align*}4(1-x)&>7(2-3x)\\\\4-4x&>14-21x\\\\17x&>10\\\\x&>\\frac{10}{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p20-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$2(3-2x)\\le4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge\\frac{3}{4}$",
          "worked": "$$\\begin{align*}6-4x&\\le4x\\\\-8x&\\le-6\\\\x&\\ge\\frac{3}{4}\\end{align*}$$\nReverse the inequality sign when dividing by $-8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
