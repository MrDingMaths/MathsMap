    "reasoningScore": 27,
    "difficulty": "Development",
    "difficultyReason": "Give a concrete outcome omitted by each purported pair of complementary events."
  },
  "content": {
    "id": "p34-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Explain why the following are not complementary events",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "‘sunny day’ and ‘rainy day’.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An overcast dry day is neither sunny nor rainy, so these events do not cover all possible outcomes.",
          "worked": "An overcast dry day belongs to neither event. The events therefore do not cover all possible outcomes and are not complementary.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p34-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "‘winning a game’ and ‘losing a game’, in a game that permits draws.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A draw is neither a win nor a loss.",
          "worked": "A draw is a possible outcome belonging to neither event. Winning and losing therefore do not cover all possible outcomes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
