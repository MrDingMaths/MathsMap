        "type": "part",
        "label": "a",
        "prompt": "Calculate its volume correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$502.65\\text{ m}^3$",
          "worked": "$$\\begin{align*}r&=\\frac{8}{2}=4\\text{ m}\\\\V&=\\pi r^2h\\\\V&=\\pi\\times4^2\\times10\\\\V&=160\\pi\\text{ m}^3\\\\V&\\approx502.65\\text{ m}^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q10-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p27-q10-b-stem",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Grain pours out at ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "48\\,000\\text{ cm}^3",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " per second. How long would it take a full hopper to empty?",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Answer correct to the nearest minute. ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "1\\,000\\,000\\text{ cm}^3=1\\text{ m}^3",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "175 minutes.",
          "worked": "$$\\begin{align*}V&=160\\pi\\times1\\,000\\,000\\text{ cm}^3\\\\t&=\\frac{160\\pi\\times1\\,000\\,000}{48\\,000}\\text{ s}\\\\t&=\\frac{160\\pi\\times1\\,000\\,000}{48\\,000\\times60}\\text{ min}\\\\t&=\\frac{500\\pi}{9}\\text{ min}\\\\t&\\approx175\\text{ min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
