    "type": "question",
    "label": "36",
    "prompt": "Simplify the following, expressing roots as fractional exponents. $x^2\\sqrt[3]{x}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^{\\frac73}$",
      "worked": "$$\\begin{align*}x^2\\sqrt[3]{x}&=x^2\\times x^{\\frac13}\\\\x^2\\sqrt[3]{x}&=x^{2+\\frac13}\\\\x^2\\sqrt[3]{x}&=x^{\\frac73}\\end{align*}$$",
