    "children": [
      {
        "id": "p93-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What is wrong with Flo's question?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p93-q3-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "It is leading: “ruin the view” uses negative emotional language, and “do you agree” invites agreement.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "“Ruin the view” uses emotional language and presents the development as harmful. “Do you agree” then invites agreement with that negative view. This leading wording may encourage respondents to oppose the development.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p93-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Flo asks ten of her friends. Why might Flo's sample be biased?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p93-q3-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Selection bias: Flo’s friends may share similar backgrounds or opinions, while other people’s views are excluded.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Selecting only friends may produce a group that does not represent the people whose opinions Flo wants to investigate. Her friends may share similar backgrounds or views, while others are excluded. The potential bias comes from this selection method; a sample of ten is not automatically biased merely because it is small.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
