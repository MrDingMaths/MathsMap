  "content": {
    "id": "p15-q21-group-root",
    "type": "question",
    "label": "5",
    "prompt": "Add or subtract the fractions and simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q21-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac2{x+2}+\\frac3{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x+4}{(x+2)(x-1)}$, $x\\ne-2,1$.",
          "worked": "$$\\begin{align*}\\frac2{x+2}+\\frac3{x-1}&=\\frac{2(x-1)+3(x+2)}{(x+2)(x-1)}\\\\\\frac2{x+2}+\\frac3{x-1}&=\\frac{2x-2+3x+6}{(x+2)(x-1)}\\\\\\frac2{x+2}+\\frac3{x-1}&=\\frac{5x+4}{(x+2)(x-1)}\\end{align*}$$\nOriginal domain: $x\\ne-2,1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q22-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac5{y-2}-\\frac3{y+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2y+16}{(y-2)(y+2)}$, $y\\ne-2,2$.",
          "worked": "$$\\begin{align*}\\frac5{y-2}-\\frac3{y+2}&=\\frac{5(y+2)-3(y-2)}{(y-2)(y+2)}\\\\\\frac5{y-2}-\\frac3{y+2}&=\\frac{5y+10-3y+6}{(y-2)(y+2)}\\\\\\frac5{y-2}-\\frac3{y+2}&=\\frac{2y+16}{(y-2)(y+2)}\\end{align*}$$\nOriginal domain: $y\\ne-2,2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q23-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac3{x+3}+\\frac{x}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2+6x-12}{(x+3)(x-4)}$, $x\\ne-3,4$.",
          "worked": "$$\\begin{align*}\\frac3{x+3}+\\frac{x}{x-4}&=\\frac{3(x-4)+x(x+3)}{(x+3)(x-4)}\\\\\\frac3{x+3}+\\frac{x}{x-4}&=\\frac{3x-12+x^2+3x}{(x+3)(x-4)}\\\\\\frac3{x+3}+\\frac{x}{x-4}&=\\frac{x^2+6x-12}{(x+3)(x-4)}\\end{align*}$$\nOriginal domain: $x\\ne-3,4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q24-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{x-1}-\\frac{x}{x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x}{(x-1)(x+5)}$, $x\\ne1,-5$.",
          "worked": "$$\\begin{align*}\\frac{x}{x-1}-\\frac{x}{x+5}&=\\frac{x(x+5)-x(x-1)}{(x-1)(x+5)}\\\\\\frac{x}{x-1}-\\frac{x}{x+5}&=\\frac{x^2+5x-x^2+x}{(x-1)(x+5)}\\\\\\frac{x}{x-1}-\\frac{x}{x+5}&=\\frac{6x}{(x-1)(x+5)}\\end{align*}$$\nOriginal domain: $x\\ne1,-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
