  "content": {
    "id": "p40-q7",
    "type": "question",
    "label": "7",
    "prompt": "A window washer is paid \\$22.50 per hour and a height allowance of \\$55 per day. In one week, he works 9 hours each weekday.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the amount earned each weekday.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$257.50",
          "worked": "$$\\begin{align*}\\text{Normal daily pay} &= 22.50\\times9 = \\$202.50\\\\\\text{Total daily pay} &= 202.50+55 = \\$257.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate his total weekly earnings for five days of work.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1287.50",
          "worked": "$$\\begin{align*}\\text{Weekly earnings} &= 257.50\\times5\\\\&= \\$1287.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p40-q7-bank-p40-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "The window washer instead works the same 45 hours over four days and receives the height allowance on each day. Calculate his weekly earnings.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1232.50",
          "worked": "$$\\begin{align*}\\text{Hourly wages}&=22.50\\times45=\\$1012.50\\\\\\text{Height allowance}&=55\\times4=\\$220\\\\\\text{Weekly earnings}&=1012.50+220=\\$1232.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p40-q7-bank-p40-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "How much less does he earn than for five days of work?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$55",
          "worked": "$$\\begin{align*}1287.50-1232.50&=\\$55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p40-q7-bank-p40-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Explain why his earnings change although his total hours stay the same.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Hourly wages stay the same, but he receives one fewer \\$55 daily allowance.",
          "worked": "Hourly wages depend on total hours, so they stay the same. He works one fewer allowance-bearing day, so his allowance falls by \\$55.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
