        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm3$.",
          "worked": "$$\\begin{align*}(x-3)(x+3)&=0\\\\x-3&=0\\text{ or }x+3=0\\\\x&=3\\text{ or }x=-3\\end{align*}$$",
