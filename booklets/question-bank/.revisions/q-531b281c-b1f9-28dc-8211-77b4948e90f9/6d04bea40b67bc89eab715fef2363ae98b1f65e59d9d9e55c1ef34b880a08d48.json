        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac92$ or $x=-\\dfrac13$.\n\nFactorise as $(2x-9)(3x+1)=0$.",
          "worked": "$$\\begin{align*}(2x-9)(3x+1)&=0\\\\2x-9&=0\\text{ or }3x+1=0\\\\x&=\\frac92\\text{ or }x=-\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q13-response",
        "type": "part",
        "label": "h",
        "prompt": "$$9x^2+6x+1=0$$",
