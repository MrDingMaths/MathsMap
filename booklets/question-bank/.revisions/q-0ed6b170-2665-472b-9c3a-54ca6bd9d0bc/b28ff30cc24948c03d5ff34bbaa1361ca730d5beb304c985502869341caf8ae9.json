    "reasoningScore": 25,
    "difficulty": "Development",
    "difficultyReason": "Calculate weekly hours from daily hours and days worked, then use the hourly wage to calculate weekly pay."
  },
  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Jessie earns \\$37.35 per hour. She works 7 hours per day, and 4 days in a week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find how many hours she works in total over a week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28\\text{ hours}$",
          "worked": "$$\\begin{align*}\\text{Weekly hours}&=7\\times4\\\\\\text{Weekly hours}&=28\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find her total weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1045.80",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\text{Hourly rate}\\times\\text{Weekly hours}\\\\\\text{Weekly pay}&=\\$37.35\\times28\\\\\\text{Weekly pay}&=\\$1045.80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
