    "label": "45",
    "prompt": "Rationalise the denominator of the following. $$\\frac{1}{\\sqrt3+\\sqrt2}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt3-\\sqrt2$",
      "worked": "$$\\begin{align*}\\frac1{\\sqrt3+\\sqrt2}&=\\frac{\\sqrt3-\\sqrt2}{(\\sqrt3+\\sqrt2)(\\sqrt3-\\sqrt2)}\\\\\\frac1{\\sqrt3+\\sqrt2}&=\\frac{\\sqrt3-\\sqrt2}{3-2}\\\\\\frac1{\\sqrt3+\\sqrt2}&=\\sqrt3-\\sqrt2\\end{align*}$$",
      "solutionDiagrams": []
    },
