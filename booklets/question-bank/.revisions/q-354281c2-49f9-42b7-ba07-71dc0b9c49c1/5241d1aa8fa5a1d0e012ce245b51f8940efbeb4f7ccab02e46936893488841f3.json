  "content": {
    "id": "p28-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Using a calculator, convert these to decimals.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q5-decimals",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q5-decimal-a",
            "type": "part",
            "label": "a",
            "prompt": "$\\frac{1}{999}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.\\overline{001}$",
              "worked": "$$\\begin{align*}1\\div999&=0.001001001\\ldots\\\\&=0.\\overline{001}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p28-q5-decimal-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\frac{12}{999}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.\\overline{012}$",
              "worked": "$$\\begin{align*}12\\div999&=0.012012012\\ldots\\\\&=0.\\overline{012}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p28-q5-decimal-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\frac{412}{999}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.\\overline{412}$",
              "worked": "$$\\begin{align*}412\\div999&=0.412412412\\ldots\\\\&=0.\\overline{412}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p28-q5-fractions",
        "type": "group",
        "label": "",
        "prompt": "Using the pattern above, express these as fractions:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p28-q5-fraction-d",
            "type": "part",
            "label": "d",
            "prompt": "$0.\\overline{942}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{942}{999}=\\frac{314}{333}$",
              "worked": "Three recurring digits give a denominator of $999$.\n$$\\begin{align*}0.\\overline{942}&=\\frac{942}{999}\\\\&=\\frac{942\\div3}{999\\div3}\\\\&=\\frac{314}{333}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p28-q5-fraction-e",
            "type": "part",
            "label": "e",
            "prompt": "$0.\\overline{023}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{23}{999}$",
              "worked": "The recurring block is $023$, including its initial zero. Three recurring digits give a denominator of $999$.\n$$0.\\overline{023}=\\frac{23}{999}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p28-q5-fraction-f",
            "type": "part",
            "label": "f",
            "prompt": "$0.\\overline{138}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{138}{999}$",
              "worked": "Three recurring digits give a denominator of $999$.\n$$0.\\overline{138}=\\frac{138}{999}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      }
    ]
