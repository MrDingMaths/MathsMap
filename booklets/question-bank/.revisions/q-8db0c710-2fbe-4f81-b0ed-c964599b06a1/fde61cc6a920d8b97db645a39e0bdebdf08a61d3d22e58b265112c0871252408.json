  "content": {
    "id": "p51-q5",
    "type": "question",
    "label": "5",
    "prompt": "The sector shown has a radius of 13 cm and an angle of $230^\\circ$.\nWhat is the perimeter of the sector to the nearest centimetre?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p51-q5-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 51 p51-q5-diagram\"}\n\\begin{tikzpicture}[line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (A) at (155:2.4);\n\\coordinate (B) at (25:2.4);\n\\draw[black,line width=0.8pt] (O)--(A) arc[start angle=155,end angle=385,radius=2.4]--cycle;\n\\draw[black,line width=0.4pt] (155:0.38) arc[start angle=155,end angle=385,radius=0.38];\n\\path (O)--(A) node[midway,above,sloped,text=black,font=\\fontsize{10}{12}\\selectfont] {$13\\text{ cm}$};\n\\path (O)--(270:0.75) node[pos=1,text=black,font=\\fontsize{10}{12}\\selectfont] {$230^\\circ$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 50,
        "alt": "Mathematical diagram",
        "overlayOf": null,
