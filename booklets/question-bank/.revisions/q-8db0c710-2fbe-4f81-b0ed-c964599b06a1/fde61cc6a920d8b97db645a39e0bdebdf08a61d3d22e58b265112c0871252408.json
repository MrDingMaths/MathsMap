    "children": [],
    "answer": {
      "short": "$78\\text{ cm}$",
      "worked": "$$\\begin{align*}P&=l+2r\\\\P&=\\frac{230}{360}\\times2\\pi(13)+2(13)\\\\P&=\\frac{299\\pi}{18}+26\\\\P&\\approx78\\text{ cm}\\quad\\text{(nearest centimetre)}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
