    "children": [
      {
        "id": "p6-q88-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose that $a_n<2$. Show that $a_{n+1}<2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{n+1}=(\\sqrt{2})^{a_n}<(\\sqrt{2})^2=2$, since $\\sqrt{2}>1$.",
          "worked": "Since $\\sqrt{2}>1$, increasing the exponent increases the power. Thus\n$$\\begin{align*}a_{n+1}&=(\\sqrt{2})^{a_n}\\\\a_{n+1}&<(\\sqrt{2})^2\\\\a_{n+1}&<2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p6-q88-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p6-q88-b-limit",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "As ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " gets larger, the overall value approaches a certain limit value ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "L",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
