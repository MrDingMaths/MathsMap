  "content": {
    "id": "p12-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "One of the angles in an isosceles triangle is $160^{\\circ}$. Work out the sizes of the other two angles.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-working-group",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q8-working",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10^{\\circ}$ and $10^{\\circ}$.",
              "worked": "The $160^{\\circ}$ angle is the unequal angle, so let each remaining angle be $x^{\\circ}$.\n$$\\begin{align*}2x+160&=180 &&\\text{(angle sum of a triangle)}\\\\2x&=20\\\\x&=10\\end{align*}$$\nThe other angles are $10^{\\circ}$ and $10^{\\circ}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      },
      {
        "id": "p12-q8-explain",
        "type": "part",
        "label": "",
        "prompt": "Explain why there is only one possible set of answers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$160^{\\circ}$ cannot be one of the equal angles because two such angles would already exceed $180^{\\circ}$.",
          "worked": "If $160^{\\circ}$ were one of the equal angles, their sum would be $160^{\\circ}+160^{\\circ}=320^{\\circ}$, exceeding the triangle's angle sum of $180^{\\circ}$. Therefore $160^{\\circ}$ must be the unequal angle, giving only $10^{\\circ}$ and $10^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
