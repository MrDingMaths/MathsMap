  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The points $A(3,1)$, $B(10,2)$, $C(5,7)$ and $D(-2,6)$ are the vertices of a quadrilateral.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the lengths of all four sides.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB=BC=CD=DA=\\sqrt{50}$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p14-q5-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}AB&=\\sqrt{(10-3)^2+(2-1)^2}=\\sqrt{50}\\\\BC&=\\sqrt{(5-10)^2+(7-2)^2}=\\sqrt{50}\\\\CD&=\\sqrt{(-2-5)^2+(6-7)^2}=\\sqrt{50}\\\\DA&=\\sqrt{(3-(-2))^2+(1-6)^2}=\\sqrt{50}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why $ABCD$ is a rhombus.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "p14-q5-a"
        ],
        "answer": {
          "short": "All four sides are equal, so $ABCD$ is a rhombus.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
