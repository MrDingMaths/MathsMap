  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "This box plot summarises the length of babies born in a particular week in a hospital.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p18-q3-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 18 p18-q3-diagram\"}\n\\begin{tikzpicture}[x=0.24cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[line width=0.8pt,black] (35,0.9)--(45,0.9) (55,0.9)--(60,0.9);\n\\draw[line width=0.8pt,black] (35,0.78)--(35,1.02) (60,0.78)--(60,1.02);\n\\draw[line width=0.8pt,black] (45,0.65) rectangle (55,1.15);\n\\fill[black] (49.94166667,0.65) rectangle (50.05833333,1.15);\n\\draw[<->,line width=0.5pt,black] (32.5,0.45)--(63,0.45);\n\\foreach \\v in {35,37.5,40,42.5,45,47.5,50,52.5,55,57.5,60} {\\draw[line width=0.4pt,black] (\\v,0.45)--(\\v,0.35);}\n\\foreach \\v in {35,40,45,50,55,60} {\\node[below,text=black] at (\\v,0.32) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\v$\\special{dvisvgm:raw </g>}};}\n\\node[anchor=west,text=black] at (63.5,0.45) {Length (cm)};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 105,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 18,
          "sourceRegion": "Question 3 box plot",
          "description": "Unfilled horizontal box plot above a double-ended axis. Labelled ticks are 35, 40, 45, 50, 55 and 60, with minor ticks every 2.5 cm. Ordinary source blue outlines use house black.",
          "mathematics": "Minimum 35 cm; lower quartile 45 cm; median 50 cm; upper quartile 55 cm; maximum 60 cm.",
          "answerVisibility": "The complete supplied box plot and its axis remain visible in the student edition."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p18-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "State the minimum and maximum baby lengths.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum: $35\\text{ cm}$; maximum: $60\\text{ cm}$.",
          "worked": "The whisker endpoints give a minimum of $35\\text{ cm}$ and a maximum of $60\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p18-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the range of the length of the babies.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\text{ cm}$",
          "worked": "$$\\begin{aligned}\\text{Range}&=60-35\\\\\\text{Range}&=25\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "State the median baby length.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\text{ cm}$",
          "worked": "The line inside the box gives the median, $50\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p18-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the interquartile range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ cm}$",
          "worked": "$$\\begin{aligned}\\text{IQR}&=Q_3-Q_1\\\\\\text{IQR}&=55-45\\\\\\text{IQR}&=10\\text{ cm}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$50\\%$ of the baby lengths are below what amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\text{ cm}$",
          "worked": "The median marks the halfway point, so the amount is $50\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p18-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$25\\%$ of the babies are born longer than what amount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$55\\text{ cm}$",
          "worked": "The upper quarter lies above the upper quartile, $55\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p18-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "If there were 80 babies born in the week, how many would be expected to be less than $45\\text{ cm}$ in length?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "20 babies",
          "worked": "$45\\text{ cm}$ is the lower quartile, so use $25\\%$ of the babies.\n$$\\begin{aligned}\\text{Expected number}&=80\\times0.25\\\\\\text{Expected number}&=20\\end{aligned}$$\n20 babies.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
