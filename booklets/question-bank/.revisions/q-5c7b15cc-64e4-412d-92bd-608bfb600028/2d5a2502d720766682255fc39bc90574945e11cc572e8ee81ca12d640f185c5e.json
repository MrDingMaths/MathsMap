    "children": [],
    "answer": {
      "short": "$005^\\circ$ (nearest degree).",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "nr-p59-q21-answer-intro",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let h be the tower height, and let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "d_A=OA,\\ d_B=OB,\\ d_C=OC",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-distances",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\color{#268cff}\\begin{align*}\\tan26^\\circ&=\\frac{h}{d_A}\\\\[8pt]d_A&=\\frac{h}{\\tan26^\\circ}\\end{align*}",
                "display": true
              },
              {
                "type": "text",
                "text": "Similarly, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\color{#268cff}d_B=\\frac{h}{\\tan28^\\circ},\\qquad d_C=\\frac{h}{\\tan30^\\circ}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-ground-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\triangle OAC",
                "display": false
              },
              {
                "type": "text",
                "text": " is right-angled because A is due north and C is due east of O. Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\alpha=\\angle OAC",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-ground-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\color{#268cff}\\begin{align*}\\tan\\alpha&=\\frac{d_C}{d_A}\\\\[8pt]&=\\frac{h/\\tan30^\\circ}{h/\\tan26^\\circ}\\\\[8pt]&=\\frac{\\tan26^\\circ}{\\tan30^\\circ}\\\\[8pt]\\alpha&=\\tan^{-1}\\!\\left(\\frac{\\tan26^\\circ}{\\tan30^\\circ}\\right)\\\\[8pt]\\alpha&\\approx40.19^\\circ\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-sine-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Using the sine rule in ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\triangle OAB",
                "display": false
              },
              {
                "type": "text",
                "text": ", let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\beta=\\angle ABO",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-sine-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\color{#268cff}\\begin{align*}\\frac{\\sin\\beta}{d_A}&=\\frac{\\sin\\alpha}{d_B}\\\\[8pt]\\sin\\beta&=\\sin\\alpha\\,\\frac{\\tan28^\\circ}{\\tan26^\\circ}\\\\[8pt]\\beta&\\approx44.71^\\circ\\text{ or }135.29^\\circ\\end{align*}",
                "display": true
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-branch",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\color{#268cff}\\angle OCA=\\tan^{-1}\\!\\left(\\frac{\\tan30^\\circ}{\\tan26^\\circ}\\right)\\approx49.81^\\circ",
                "display": true
              },
              {
                "type": "text",
                "text": "Since B lies between A and C, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\angle OBC=180^\\circ-\\beta",
                "display": false
              },
              {
                "type": "text",
                "text": ". The acute choice for ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\beta",
                "display": false
              },
              {
                "type": "text",
                "text": " gives ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\angle OBC+\\angle OCB\\approx135.29^\\circ+49.81^\\circ>180^\\circ",
                "display": false
              },
              {
                "type": "text",
                "text": ", which is impossible. Hence ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\beta\\approx135.29^\\circ",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\angle OBC\\approx44.71^\\circ",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "nr-p59-q21-answer-bearing",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\color{#268cff}\\begin{align*}\\angle AOB&=180^\\circ-\\alpha-\\beta\\\\[8pt]\\angle AOB&\\approx4.52^\\circ\\end{align*}",
                "display": true
              },
              {
                "type": "text",
                "text": "Measured clockwise from north, the bearing is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\color{#268cff}005^\\circ",
                "display": false
              },
              {
                "type": "text",
                "text": " to the nearest degree.",
                "marks": []
              }
            ]
          }
        ]
      },
