              "type": "text",
              "text": "After a season, a hockey team had won 17 matches, drawn 10 and lost 13.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "What angles would you draw on a pie chart to show this information?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Won: $153^\\circ$; drawn: $90^\\circ$; lost: $117^\\circ$.",
      "worked": "$$\\begin{align*}\\text{Total matches}&=17+10+13\\\\&=40\\\\\\text{Won angle}&=\\frac{17}{40}\\times360^\\circ\\\\&=153^\\circ\\\\\\text{Drawn angle}&=\\frac{10}{40}\\times360^\\circ\\\\&=90^\\circ\\\\\\text{Lost angle}&=\\frac{13}{40}\\times360^\\circ\\\\&=117^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
