  "content": {
    "id": "p58-q25-root",
    "type": "question",
    "label": "8",
    "prompt": "Let $A=\\{1,3,5,7\\}$ and $B=\\{2,5,8,11\\}$.\n\nWrite the following sets by listing their elements.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "$A\\cup B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,5,7,8,11\\}$",
          "worked": "List every element in either set once:\n$$A\\cup B=\\{1,2,3,5,7,8,11\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "$A\\cap B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{5\\}$",
          "worked": "$5$ is the only element in both sets, so $A\\cap B=\\{5\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p58-q25-c",
        "type": "part",
        "label": "c",
        "prompt": "$A\\cap\\overline B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,3,7\\}$",
          "worked": "Keep the elements of $A$ that are not in $B$:\n$$A\\cap\\overline B=\\{1,3,7\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q25-d",
        "type": "part",
        "label": "d",
        "prompt": "$B\\cap\\overline A$",
