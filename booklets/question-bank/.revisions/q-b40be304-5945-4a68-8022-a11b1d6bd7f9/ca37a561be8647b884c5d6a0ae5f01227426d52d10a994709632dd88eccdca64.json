    "children": [
      {
        "id": "nr-p55-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why $\\angle ABC=90^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The co-interior angle is $124^\\circ$, so $\\angle ABC=360^\\circ-124^\\circ-146^\\circ=90^\\circ$.",
          "worked": "The north lines are parallel. The angle co-interior to $56^\\circ$ is $180^\\circ-56^\\circ=124^\\circ$.\nAngles around $B$ give\n$$\\begin{align*}\\angle ABC&=360^\\circ-124^\\circ-146^\\circ\\\\&=90^\\circ.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "nr-p55-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "How far apart are the towns A and C,\ncorrect to the nearest kilometre?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$114\\text{ km}$",
          "worked": "$$\\begin{align*}AC^2&=70^2+90^2\\\\AC&=\\sqrt{13000}\\\\AC&\\approx114\\text{ km}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "nr-p55-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\angle BAC$, and hence find the bearing of town C from town A, to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle BAC\\approx52^\\circ$; bearing $108^\\circ\\text{T}$.",
          "worked": "$$\\begin{align*}\\tan\\angle BAC&=\\frac{90}{70}\\\\\\angle BAC&=\\tan^{-1}\\!\\left(\\frac{90}{70}\\right)\\\\\\angle BAC&\\approx52^\\circ.\\end{align*}$$\n$$\\begin{align*}\\text{Bearing of C from A}&=56^\\circ+\\tan^{-1}\\!\\left(\\frac{90}{70}\\right)\\\\&\\approx108^\\circ\\text{T}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
