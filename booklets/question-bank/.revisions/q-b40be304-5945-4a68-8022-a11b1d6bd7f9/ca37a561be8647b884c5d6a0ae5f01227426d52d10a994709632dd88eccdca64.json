    "id": "nr-p55-q15",
    "type": "question",
    "label": "15",
    "prompt": "A motorist drove 70km from town A to town B on a bearing of $056^\\circ$T,\nand then drove 90km from town B to town C on a bearing of $146^\\circ$T.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "nr-p55-q15-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"Source page 55, nr-p55-q15-diagram\"}\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n% mathsmap-standard-palette 2026-09-11\n\\definecolor{ink}{HTML}{24282D}\n\\definecolor{blue}{HTML}{268CFF}\n\\definecolor{red}{HTML}{EF6068}\n\\definecolor{green}{HTML}{4F9B63}\n\\definecolor{orange}{HTML}{EF8B2C}\n\\definecolor{tableLabel}{HTML}{D3E8FC}\n\\definecolor{housegrid}{HTML}{CCCCCC}\n\\definecolor{skipped}{HTML}{C7C7C7}\n\\definecolor{housemuted}{HTML}{777777}\n\\definecolor{blueFill}{HTML}{D4E8FF}\n\\definecolor{redFill}{HTML}{FCDFE1}\n\\definecolor{greenFill}{HTML}{DCEBE0}\n\\definecolor{orangeFill}{HTML}{FCE8D5}\n\\usetikzlibrary{calc,arrows.meta}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at ($(A)+(34:2.8)$);\n\\coordinate (C) at ($(B)+(-56:3.6)$);\n\\draw[line width=0.8pt] (A)--(B) node[midway,below,sloped] {$70\\,\\mathrm{km}$};\n\\draw[line width=0.8pt] (B)--(C) node[midway,above,sloped] {$90\\,\\mathrm{km}$};\n\\draw[line width=0.8pt] (C)--(A);\n\\draw[dashed,line width=0.5pt,-{Stealth}] (A)--($(A)+(0,2.5)$);\n\\draw[dashed,line width=0.5pt,-{Stealth}] (B)--($(B)+(0,1.8)$);\n\\node at ($(A)+(62:0.85)$) {$56^\\circ$};\n\\node[right] at ($(B)+(0,0.18)$) {$146^\\circ$};\n\\node[below left] at (A) {$A$};\n\\node[above left] at (B) {$B$};\n\\node[below] at (C) {$C$};\n\\special{dvisvgm:raw <metadata data-diagram-colours=\"1\" data-diagram-kind=\"geometry\" data-diagram-base=\"\" data-diagram-semantic-palette=\"\" data-diagram-semantic-reference=\"Source page 55, nr-p55-q15-diagram\" data-diagram-semantic-reasons=\"\"/>}\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 49,
