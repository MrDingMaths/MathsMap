    "children": [
      {
        "id": "nr-p36-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why we cannot directly use the SAS area rule to find the area of the triangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The included angle between the two known sides is not given.",
          "worked": "The $64^\\circ$ angle is not between the $21\\text{ cm}$ and $28\\text{ cm}$ sides, so $A=\\frac12 ab\\sin C$ cannot be used directly.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "nr-p36-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Using sine rule, find $\\angle DEF$ to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$42^\\circ$",
          "worked": "$$\\begin{align*}\n\\frac{\\sin E}{21}&=\\frac{\\sin64^\\circ}{28}\\\\[8pt]\nE&=\\sin^{-1}\\!\\left(\\frac{21\\sin64^\\circ}{28}\\right)\\\\[8pt]\nE&\\approx42^\\circ\n\\end{align*}$$\nThe supplementary angle is impossible because it and $64^\\circ$ exceed $180^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "nr-p36-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence calculate the area to the nearest square cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$282\\text{ cm}^2$",
          "worked": "Using the unrounded angle $E$:\n$$\\begin{align*}\nF&=180^\\circ-64^\\circ-E\\\\[8pt]\nA&=\\frac12(21)(28)\\sin F\\\\[8pt]\nA&\\approx282\\text{ cm}^2\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
