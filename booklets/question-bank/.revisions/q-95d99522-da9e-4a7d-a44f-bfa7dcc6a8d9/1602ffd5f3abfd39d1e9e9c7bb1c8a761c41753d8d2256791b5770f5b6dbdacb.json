              "type": "text",
              "text": "Charlotte wants to have $8200 in her bank account at the end of 8 years.",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q10-prompt-2",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "How much does she need to invest now if the interest is 4% p.a. compounded quarterly? Give your answer to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$5963.89$",
      "worked": "$r=\\frac{0.04}{4}=0.01$, $n=8\\times4=32$.\n\n$$\\begin{align*}FV&=PV(1+r)^n\\\\8200&=PV(1+0.01)^{32}\\\\PV&=\\frac{8200}{(1.01)^{32}}\\\\PV&\\approx\\$5963.89\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
