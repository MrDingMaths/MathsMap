  "content": {
    "id": "index-t9-q11-root",
    "type": "question",
    "label": null,
    "prompt": "The rule for the number of seeds germinating in a glass house over a two-week period is given by $N = \\left( \\frac{t}{2} \\right)^{3}$, where $N$ is the number of germinating seeds and $t$ is the number of days.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "index-t9-q11-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the number of germinating seeds after:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "index-t9-q11-a-i",
            "type": "part",
            "label": "i",
            "prompt": "4 days",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "8",
              "worked": "$$\\begin{align*}N&=\\left(\\frac42\\right)^3=2^3=8\\end{align*}$$\n\n8 seeds.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "index-t9-q11-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "10 days",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "125",
              "worked": "$$\\begin{align*}N&=\\left(\\frac{10}2\\right)^3=5^3=125\\end{align*}$$\n\n125 seeds.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          }
        ]
      },
      {
        "id": "index-t9-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Rewrite the rule without brackets using index laws",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$N = \\frac{t^{3}}{8}$",
          "worked": "$$\\begin{align*}N&=\\left(\\frac t2\\right)^3 \\\\ &=\\frac{t^3}{2^3}=\\frac{t^3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t9-q11-c",
        "type": "group",
        "label": "c",
        "prompt": "Use your rule in part b to find the number of days required to germinate:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "index-t9-q11-c-i",
            "type": "part",
            "label": "i",
            "prompt": "64 seeds",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t = \\sqrt[3]{512} = 8$",
              "worked": "$$\\begin{align*}64&=\\frac{t^3}{8} \\\\ t^3&=512 \\\\ t&=\\sqrt[3]{512}=8\\end{align*}$$\n\n8 days.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "index-t9-q11-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "1 seed",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$t = \\sqrt[3]{8} = 2$",
              "worked": "$$\\begin{align*}1&=\\frac{t^3}{8} \\\\ t^3&=8 \\\\ t&=\\sqrt[3]{8}=2\\end{align*}$$\n\n2 days.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          }
        ],
        "dependsOn": [
          "index-t9-q11-b"
        ]
      }
    ]
