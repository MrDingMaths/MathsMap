        "answerSpaceMm": 12
      },
      {
        "id": "p38-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\angle POS$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180-x$",
          "worked": "Angles on the straight line $SOQ$ sum to $180^\\circ$.\n$$\\begin{align*}\\angle POS&=180-\\angle POQ\\\\\\angle POS&=180-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\angle ROQ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180-x$",
          "worked": "Angles on the straight line $ROP$ sum to $180^\\circ$.\n$$\\begin{align*}\\angle ROQ&=180-\\angle POQ\\\\\\angle ROQ&=180-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\angle DFC$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180-y$",
          "worked": "Angles on the straight line $BFD$ sum to $180^\\circ$.\n$$\\begin{align*}\\angle DFC&=180-\\angle BFC\\\\\\angle DFC&=180-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\angle EFD$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$",
          "worked": "$\\angle EFD=\\angle CFB=y$ because vertically opposite angles are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\angle AFB$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90-y$",
          "worked": "$CFE$ is a straight line and $\\angle AFE=90^\\circ$, so $\\angle CFA=90^\\circ$. Angles within a right angle sum to $90^\\circ$.\n$$\\begin{align*}\\angle AFB&=90-\\angle CFB\\\\\\angle AFB&=90-y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
