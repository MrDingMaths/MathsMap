    "answer": {
      "short": "$95\\%$",
      "worked": "Accurate results are the 72 positive results for people with flu and the 256 negative results for people without flu.\n$$\\begin{align*}\\text{Number of accurate results}&=72+256\\\\&=328\\\\P(\\text{accurate result})&=\\frac{328}{347}\\\\\\text{Percentage accurate}&=\\frac{328}{347}\\times100\\%\\\\&\\approx95\\%\\end{align*}$$\nTo the nearest per cent, the probability is $95\\%$.",
      "solutionDiagrams": []
    },
