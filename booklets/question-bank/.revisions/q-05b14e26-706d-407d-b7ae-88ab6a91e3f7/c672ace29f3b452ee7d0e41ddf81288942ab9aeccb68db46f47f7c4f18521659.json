      {
        "id": "p37-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $\\sqrt{36}+\\sqrt{64}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}\\sqrt{36}+\\sqrt{64} &= 6+8\\\\&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p37-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Evaluate $\\sqrt{36+64}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\sqrt{36+64} &= \\sqrt{100}\\\\&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p37-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Is $\\sqrt{36}+\\sqrt{64}=\\sqrt{36+64}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No, $14\\ne10$.",
          "worked": "No. The left-hand side is $14$ and the right-hand side is $10$, so they are unequal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
