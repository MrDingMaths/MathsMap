          "inlines": [
            {
              "type": "text",
              "text": "Adam has spread out a pack of playing cards.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "He picks a card at random.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Hearts and diamonds are red.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Clubs and spades are black.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Picture cards are king, queen and jack.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Find:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [
      {
        "id": "p15-q18-deck",
        "role": "question",
        "format": "image",
        "code": null,
        "src": "/booklet-assets/projects/probability-v1/card-deck.png",
        "widthMm": 76.2,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "retentionReason": "The isolated original contains intricate king picture artwork within the overlapping 52-card display. Retaining this complex composite preserves the four king illustrations, all 52 rank/suit labels and source overlap without inventing replacement artwork.",
        "spec": {
          "sourcePage": 15,
          "sourceRegion": "Question 18, upper-right deck",
          "description": "Four overlapping suit rows: spades, clubs, diamonds, hearts. Each row shows A, 2–10, J, Q, K from left to right; hearts expose the longest card bodies.",
          "mathematics": "52 distinct cards: 13 per suit; 26 red, 26 black; 12 picture cards.",
          "answerVisibility": "Permanent question visual; no supplied answers embedded."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p15-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(\\text{spade})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$$\\begin{align*}P(\\text{spade})&=\\frac{13}{52}\\\\P(\\text{spade})&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(\\text{4 of hearts})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{52}$",
          "worked": "There is one 4 of hearts in the 52-card pack.\n$$P(\\text{4 of hearts})=\\frac1{52}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(\\text{club})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac14$",
          "worked": "$$\\begin{align*}P(\\text{club})&=\\frac{13}{52}\\\\P(\\text{club})&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(\\text{black 10})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{26}$",
          "worked": "The 10 of spades and 10 of clubs are black.\n$$\\begin{align*}P(\\text{black 10})&=\\frac2{52}\\\\P(\\text{black 10})&=\\frac1{26}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(\\text{ace})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{13}$",
          "worked": "There are four aces.\n$$\\begin{align*}P(\\text{ace})&=\\frac4{52}\\\\P(\\text{ace})&=\\frac1{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(\\text{picture card})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{13}$",
          "worked": "Each suit has three picture cards, so there are $4\\times3=12$.\n$$\\begin{align*}P(\\text{picture card})&=\\frac{12}{52}\\\\P(\\text{picture card})&=\\frac3{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-g",
        "type": "part",
        "label": "g",
        "prompt": "$P(\\text{5 or 6})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac2{13}$",
          "worked": "There are four 5s and four 6s.\n$$\\begin{align*}P(\\text{5 or 6})&=\\frac{4+4}{52}\\\\P(\\text{5 or 6})&=\\frac8{52}\\\\P(\\text{5 or 6})&=\\frac2{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-h",
        "type": "part",
        "label": "h",
        "prompt": "$P(\\text{green card})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "All suits are red or black, so there are no green cards.\n$$\\begin{align*}P(\\text{green card})&=\\frac0{52}\\\\P(\\text{green card})&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q18-i",
        "type": "part",
        "label": "i",
        "prompt": "$P(\\text{not a picture card})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{13}$",
          "worked": "A and 2–10 give ten non-picture cards per suit, so there are $4\\times10=40$.\n$$\\begin{align*}P(\\text{not a picture card})&=\\frac{40}{52}\\\\P(\\text{not a picture card})&=\\frac{10}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
