  "content": {
    "id": "p92-q9-group",
    "type": "question",
    "label": "9",
    "prompt": "Let $f(x)=x^2-4x-2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p92-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "State a largest interval domain for $f$ so that $f^{-1}$ exists and $f^{-1}(-2)$ is defined.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p92-q9-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Either ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(-\\infty,2]",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " or ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "[2,\\infty)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p92-q9-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Restrict to either side of the vertex; each branch contains a preimage of ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}f(x)&=x^2-4x-2\\\\f(x)&=(x-2)^2-6\\end{align*}$$\nThe vertex has $x$-coordinate $2$. Each maximal interval $(-\\infty,2]$ and $[2,\\infty)$ makes $f$ one-to-one. Since $f(0)=-2$ and $f(4)=-2$, $f^{-1}(-2)$ exists on either restricted branch.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p92-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "For the domain in part (a), find $f^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p92-q9-b-short-left",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\operatorname{dom}f=(-\\infty,2]",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ": ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f^{-1}(x)=2-\\sqrt{x+6}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p92-q9-b-short-right",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "For ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\operatorname{dom}f=[2,\\infty)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ": ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f^{-1}(x)=2+\\sqrt{x+6}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p92-q9-b-short-domain-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both inverse domains are ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x\\ge-6",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Choose the square-root sign to match the selected branch.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Interchange $x$ and $y$ in $y=(x-2)^2-6$.\n$$\\begin{align*}x&=(y-2)^2-6\\\\x+6&=(y-2)^2\\end{align*}$$\nFor the original domain $(-\\infty,2]$, the inverse values satisfy $y\\le2$:\n$$\\begin{align*}y-2&=-\\sqrt{x+6}\\\\y&=2-\\sqrt{x+6}\\end{align*}$$\nFor the original domain $[2,\\infty)$, the inverse values satisfy $y\\ge2$:\n$$\\begin{align*}y-2&=\\sqrt{x+6}\\\\y&=2+\\sqrt{x+6}\\end{align*}$$\nIn either case, the inverse domain is $x\\ge-6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
      }
    ]
