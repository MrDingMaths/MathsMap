                {
                  "type": "math",
                  "latex": "\\begin{aligned}y&=3\\left(x^2+2x+\\frac13\\right)\\\\y&=3\\left(x^2+2x+1-1+\\frac13\\right)\\\\y&=3\\left((x+1)^2-\\frac23\\right)\\\\y&=3(x+1)^2-2\\end{aligned}",
