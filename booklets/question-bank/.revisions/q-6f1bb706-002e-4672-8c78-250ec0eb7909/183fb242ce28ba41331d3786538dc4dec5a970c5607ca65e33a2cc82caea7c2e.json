              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 33 p33-q4-a-graph\"}\n\\begin{tikzpicture}[x=12mm,y=5mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-3.3,0)--(1.5,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-5)--(0,6) node[above] {$y$};\n\\draw[<->,line width=0.8pt,domain=-2.5:0.5,samples=81] plot (\\x,{3*(\\x+1)^2-2});\n\\coordinate (mmPoint19) at ({-1-sqrt(2/3)},0);\n\\node[name=mmLabel19,below left,xshift=-6mm,yshift=-12mm] at ({-1-sqrt(2/3)},0) {$-1-\\sqrt{\\frac23}$};\n\\draw[housegrid,dashed,line width=0.25pt] (mmPoint19)--(mmPoint19 |- mmLabel19.north east)--(mmLabel19.north east);\n\\coordinate (mmPoint20) at ({-1+sqrt(2/3)},0);\n\\node[name=mmLabel20,below right,xshift=6mm,yshift=-12mm] at ({-1+sqrt(2/3)},0) {$-1+\\sqrt{\\frac23}$};\n\\draw[housegrid,dashed,line width=0.25pt] (mmPoint20)--(mmPoint20 |- mmLabel20.north west)--(mmLabel20.north west);\n\\node[left] at (0,1) {$1$};\n\\node[below] at (-1,-2) {$(-1,-2)$};\n\\end{tikzpicture}",
