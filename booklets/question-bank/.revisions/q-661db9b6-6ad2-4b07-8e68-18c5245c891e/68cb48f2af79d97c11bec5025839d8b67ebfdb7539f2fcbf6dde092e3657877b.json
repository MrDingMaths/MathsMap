  "content": {
    "id": "p17-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Rearrange these equations to make the variable in the bracket the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$D=\\frac{m}{v}\\quad[v]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=\\frac{m}{D}$",
          "worked": "$$\\begin{align*}Dv&=m\\\\v&=\\frac{m}{D}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$T=\\frac{2\\pi}{n}\\quad[n]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{2\\pi}{T}$",
          "worked": "$$\\begin{align*}Tn&=2\\pi\\\\n&=\\frac{2\\pi}{T}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$E=\\frac{p^2}{2m}\\quad[m]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{p^2}{2E}$",
          "worked": "$$\\begin{align*}2Em&=p^2\\\\m&=\\frac{p^2}{2E}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$E=\\frac{m}{2r^2}\\quad[r]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\pm\\sqrt{\\frac{m}{2E}}$",
          "worked": "$$\\begin{align*}2Er^2&=m\\\\r^2&=\\frac{m}{2E}\\\\r&=\\pm\\sqrt{\\frac{m}{2E}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p17-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$a=\\sqrt{\\frac{x}{y}}\\quad[y]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{x}{a^2}$",
          "worked": "$$\\begin{align*}a^2&=\\frac{x}{y}\\\\a^2y&=x\\\\y&=\\frac{x}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$w=\\sqrt{\\frac{3V}{\\pi h}}\\quad[h]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\frac{3V}{\\pi w^2}$",
          "worked": "$$\\begin{align*}w^2&=\\frac{3V}{\\pi h}\\\\\\pi hw^2&=3V\\\\h&=\\frac{3V}{\\pi w^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{p}{q+r}=t\\quad[r]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\frac{p}{t}-q$",
          "worked": "$$\\begin{align*}p&=t(q+r)\\\\q+r&=\\frac{p}{t}\\\\r&=\\frac{p}{t}-q\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p17-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$u=1+\\frac{3}{v}\\quad[v]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=\\frac{3}{u-1}$",
          "worked": "$$\\begin{align*}u-1&=\\frac{3}{v}\\\\v(u-1)&=3\\\\v&=\\frac{3}{u-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p18-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{1}{x}-\\frac{1}{y}=\\frac{5}{n}\\quad[n]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac{5xy}{y-x}$",
          "worked": "$$\\begin{align*}\\frac{y-x}{xy}&=\\frac{5}{n}\\\\n(y-x)&=5xy\\\\n&=\\frac{5xy}{y-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p18-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{1}{x}-\\frac{1}{y}=\\frac{5}{n}\\quad[y]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{nx}{n-5x}$",
          "worked": "$$\\begin{align*}\\frac{1}{x}-\\frac{5}{n}&=\\frac{1}{y}\\\\\\frac{n-5x}{nx}&=\\frac{1}{y}\\\\\\frac{nx}{n-5x}&=y\\\\y&=\\frac{nx}{n-5x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p18-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$t=\\sqrt{\\frac{M}{M-m}}\\quad[m]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=M-\\frac{M}{t^2}$",
          "worked": "$$\\begin{align*}t^2&=\\frac{M}{M-m}\\\\t^2(M-m)&=M\\\\M-m&=\\frac{M}{t^2}\\\\m&=M-\\frac{M}{t^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p18-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$T=2\\pi\\sqrt{\\frac{W}{gF}}\\quad[F]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F=\\frac{4\\pi^2W}{gT^2}$",
          "worked": "$$\\begin{align*}\\frac{T}{2\\pi}&=\\sqrt{\\frac{W}{gF}}\\\\\\frac{T^2}{4\\pi^2}&=\\frac{W}{gF}\\\\gFT^2&=4\\pi^2W\\\\F&=\\frac{4\\pi^2W}{gT^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p18-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$M=\\sqrt{\\frac{ab}{t}+a^2}\\quad[t]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{ab}{M^2-a^2}$",
          "worked": "$$\\begin{align*}M^2&=\\frac{ab}{t}+a^2\\\\M^2-a^2&=\\frac{ab}{t}\\\\t(M^2-a^2)&=ab\\\\t&=\\frac{ab}{M^2-a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p18-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$x=a\\sqrt{\\frac{k}{ph+y}}\\quad[h]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\frac{ka^2}{px^2}-\\frac{y}{p}$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=\\sqrt{\\frac{k}{ph+y}}\\\\\\frac{x^2}{a^2}&=\\frac{k}{ph+y}\\\\x^2(ph+y)&=ka^2\\\\ph+y&=\\frac{ka^2}{x^2}\\\\ph&=\\frac{ka^2}{x^2}-y\\\\h&=\\frac{ka^2}{px^2}-\\frac{y}{p}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
