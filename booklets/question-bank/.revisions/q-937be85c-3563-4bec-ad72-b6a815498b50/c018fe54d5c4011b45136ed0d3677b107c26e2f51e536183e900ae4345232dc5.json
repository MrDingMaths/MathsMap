          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Bob observes that when solving rational inequalities where equality is included (",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\geq",
              "display": false
            },
            {
              "type": "text",
              "text": " or ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\leq",
              "display": false
            },
            {
              "type": "text",
              "text": "), his solution set seems to always have one inequality with the equal sign, and another inequality strict e.g. ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x\\geq1",
              "display": false
            },
            {
              "type": "text",
              "text": " or ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x<0",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        },
        {
          "id": "p81-q5-question",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 3,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Is this always the case when solving rational inequalities in the form",
              "marks": []
            }
          ]
        },
        {
          "id": "p81-q5-inequality",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\frac{a}{bx+c}\\geq d",
              "display": true
            }
          ]
        },
        {
          "id": "p81-q5-conditions",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "if ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "a,b,c,d\\ne0",
              "display": false
            },
            {
              "type": "text",
              "text": "? If there are exceptions, what are they?",
              "marks": []
            }
