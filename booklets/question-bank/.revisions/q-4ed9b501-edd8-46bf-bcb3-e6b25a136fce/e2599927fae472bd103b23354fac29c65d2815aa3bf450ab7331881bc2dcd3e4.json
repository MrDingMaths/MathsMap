  "content": {
    "id": "p26-q12-garden-root",
    "type": "question",
    "label": "12",
    "prompt": "A rectangular garden bed is 12 m long and 5 m wide.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p26-q12-garden-labelled-rectangle",
        "role": "question",
        "format": "tikz",
        "code": "\\begin{tikzpicture}[x=1mm,y=1mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=1pt}]\n\\draw[black,line width=0.8pt] (0,0) rectangle (48,20);\n\\node[above] at (24,20) {$12\\text{ m}$};\n\\node[right] at (48,10) {$5\\text{ m}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 65,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "description": "Rectangular garden: horizontal side 12 m and vertical side 5 m. No changed dimensions or derived area shown."
        },
        "derived": false
      }
    ],
    "children": [
      {
        "id": "p26-q12-garden-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of the garden bed. Show your working out.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\text{ m}^2$",
          "worked": "$$\\begin{align*}A&=12\\times5\\\\A&=60\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p26-q12-garden-b",
        "type": "part",
        "label": "b",
        "prompt": "The length is increased by $x$ cm and the width is decreased by $y$ cm. Find the new length and width of the garden in metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Divide each centimetre change by $100$. Length: $(12+\\frac{x}{100})\\text{ m}$; width: $(5-\\frac{y}{100})\\text{ m}$.",
          "worked": "Convert the changes to metres before combining them with the original dimensions.\n$$\\begin{align*}x\\text{ cm}&=\\frac{x}{100}\\text{ m}\\\\y\\text{ cm}&=\\frac{y}{100}\\text{ m}\\\\L&=\\left(12+\\frac{x}{100}\\right)\\text{ m}\\\\W&=\\left(5-\\frac{y}{100}\\right)\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q12-garden-c",
        "type": "part",
        "label": "c",
        "prompt": "Write an expression for the area of the new garden bed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Use $A=LW$: $(12+\\frac{x}{100})(5-\\frac{y}{100})\\text{ m}^2$.",
          "worked": "$$\\begin{align*}A&=LW\\\\A&=\\left(12+\\frac{x}{100}\\right)\\left(5-\\frac{y}{100}\\right)\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
