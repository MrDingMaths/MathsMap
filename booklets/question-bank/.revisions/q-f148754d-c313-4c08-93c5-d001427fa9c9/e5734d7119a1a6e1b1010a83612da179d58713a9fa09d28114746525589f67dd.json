  },
  "content": {
    "id": "p21-q5",
    "type": "question",
    "label": "5",
    "prompt": "A cylinder has a radius of $12\\text{ cm}$ and a height of $20\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the surface area of the cylinder to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2412.7\\text{ cm}^2$",
          "worked": "$$\\begin{align*} A &= 2\\pi r^2 + 2\\pi rh \\\\ A &= 2\\pi(12)^2 + 2\\pi(12)(20) \\\\ A &= 768\\pi \\approx 2412.7\\text{ cm}^2 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p21-q5-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p21-q5-b-height",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "The height of the cylinder is increased by 10%.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p21-q5-b-task",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Work out the new total surface area of the cylinder, rounded to 1 decimal place.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2563.5\\text{ cm}^2$",
          "worked": "$$\\begin{align*} h_{\\text{new}} &= 20\\times 1.10 = 22\\text{ cm} \\\\ A_{\\text{new}} &= 2\\pi r^2 + 2\\pi rh_{\\text{new}} \\\\ A_{\\text{new}} &= 2\\pi(12)^2 + 2\\pi(12)(22) \\\\ A_{\\text{new}} &= 816\\pi \\approx 2563.5\\text{ cm}^2 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Work out the percentage increase in the total surface area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.25\\%$ increase.",
          "worked": "$$\\begin{align*} \\text{Increase} &= 816\\pi - 768\\pi = 48\\pi\\text{ cm}^2 \\\\ \\text{Percentage increase} &= \\frac{48\\pi}{768\\pi}\\times 100\\% \\\\ \\text{Percentage increase} &= 6.25\\% \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q5-bank-p21-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Starting with the original cylinder, what height would give a total surface area $10\\%$ greater than the original?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23.2\\text{ cm}$",
          "worked": "$$\\begin{align*}A_{\\text{new}}&=1.10(768\\pi)=844.8\\pi\\\\288\\pi+24\\pi h&=844.8\\pi\\\\24\\pi h&=556.8\\pi\\\\h&=23.2\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p21-q5-bank-p21-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "What percentage increase in height is this?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage increase}&=\\frac{23.2-20}{20}\\times100\\%\\\\&=16\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
