  "content": {
    "id": "p20-q20",
    "type": "question",
    "label": "20",
    "prompt": "Emily says a number divisible by $4$ and $6$ must also be divisible by $24$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Give an example to show she is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$ is divisible by $4$ and $6$, but not by $24$.",
          "worked": "$12\\div4=3$ and $12\\div6=2$, so both divisions leave no remainder. However, $12$ is not a multiple of $24$. This shows Emily is incorrect.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q20-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p20-q20-b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "We need to pick two numbers that are ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "coprime",
                  "marks": [
                    "bold"
                  ]
                },
                {
                  "type": "text",
                  "text": " (have no common factor other than 1).",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "If a number is divisible by ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$3$",
                  "width": 11
                },
                {
                  "type": "text",
                  "text": " and ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "$8$",
                  "width": 11
                },
                {
                  "type": "text",
                  "text": ", it must be divisible by ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "24",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$ and $8$.",
          "worked": "$3$ and $8$ have no common factor other than $1$, and $3\\times8=24$. Their lowest common multiple is $24$, so a number divisible by both must be divisible by $24$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
