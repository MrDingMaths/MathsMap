    "difficulty": "Mastery",
    "difficultyReason": "Choose parameter expressions whose ranges give the required included and excluded values of x."
  },
  "content": {
    "id": "p68-q61-root",
    "type": "question",
    "label": null,
    "prompt": "Find a possible parametrisation for $y=x^2+1$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q61-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\ne2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\bigl(t+2,(t+2)^2+1\\bigr),\\quad t\\in\\mathbb R\\setminus\\{0\\}$.",
          "worked": "Choose $x=t+2$ and exclude $t=0$.\n$$\\begin{align*}y&=x^2+1\\\\y&=(t+2)^2+1\\end{align*}$$\nThus $(x,y)=\\bigl(t+2,(t+2)^2+1\\bigr)$ for $t\\in\\mathbb R\\setminus\\{0\\}$. Every $x\\ne2$ is obtained by taking $t=x-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p68-q61-b",
        "type": "part",
        "label": "b",
        "prompt": "$x>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(e^t,e^{2t}+1),\\quad t\\in\\mathbb R$.",
          "worked": "Choose $x=e^t$, which takes every positive value for $t\\in\\mathbb R$.\n$$\\begin{align*}y&=x^2+1\\\\y&=e^{2t}+1\\end{align*}$$\nA suitable parametrisation is $(e^t,e^{2t}+1)$, with $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p68-q61-c",
        "type": "part",
        "label": "c",
        "prompt": "$x\\ge0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(t^2,t^4+1),\\quad t\\in\\mathbb R$.",
          "worked": "Choose $x=t^2$, which takes every nonnegative value for $t\\in\\mathbb R$.\n$$\\begin{align*}y&=x^2+1\\\\y&=t^4+1\\end{align*}$$\nA suitable parametrisation is $(t^2,t^4+1)$, with $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p68-q61-d",
        "type": "part",
        "label": "d",
        "prompt": "$x<1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\bigl(1-e^t,(1-e^t)^2+1\\bigr),\\quad t\\in\\mathbb R$.",
          "worked": "Choose $x=1-e^t$. Since $e^t$ takes every positive value, $x$ takes every value less than $1$.\n$$\\begin{align*}y&=x^2+1\\\\y&=(1-e^t)^2+1\\end{align*}$$\nA suitable parametrisation is $\\bigl(1-e^t,(1-e^t)^2+1\\bigr)$, with $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
