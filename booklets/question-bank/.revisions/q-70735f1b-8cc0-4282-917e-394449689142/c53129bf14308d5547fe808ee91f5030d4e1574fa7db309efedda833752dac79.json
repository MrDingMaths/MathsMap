          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Alannah earns $58.21/h and works a 38-hour week. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "She has work-related clothing expenses of $6.30/week and union fees of $11.20/week. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "She earned $33.70 in bank interest for the year. Calculate her annual taxable income. ",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Round down to the nearest whole dollar.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$114 146, rounded down to the nearest whole dollar.",
      "worked": "$$\\begin{align*}\\text{Annual gross income} &= 58.21\\times38\\times52+33.70\\\\&=\\$115\\,056.66\\\\\\text{Annual deductions} &=(6.30+11.20)\\times52\\\\&=\\$910\\\\\\text{Taxable income} &=115\\,056.66-910\\\\&=\\$114\\,146.66\\end{align*}$$\nRounded down to the nearest whole dollar, Alannah’s annual taxable income is \\$114 146.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
