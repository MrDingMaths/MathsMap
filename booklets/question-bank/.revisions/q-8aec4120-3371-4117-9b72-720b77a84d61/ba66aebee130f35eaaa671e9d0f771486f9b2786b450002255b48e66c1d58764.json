        "id": "p6-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "How many pens do the class have in total?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "69 pens.\n\nMultiply each number of pens by its frequency, then add the products.",
          "worked": "$$\\begin{align*}\\text{Total pens}&=0\\times1+1\\times4+2\\times7+3\\times12+4\\times0+5\\times3\\\\\\text{Total pens}&=0+4+14+36+0+15\\\\\\text{Total pens}&=69\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
