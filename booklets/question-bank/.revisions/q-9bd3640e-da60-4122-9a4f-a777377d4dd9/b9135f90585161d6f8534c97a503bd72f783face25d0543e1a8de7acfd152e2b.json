  "content": {
    "id": "p92-q78-root",
    "type": "question",
    "label": "78",
    "prompt": "Find all unordered pairs of positive integers $m$ and $n$ whose greatest common divisor is 18 and whose least common multiple is 720.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(18,720)$ and $(90,144)$. Writing $m=18a$ and $n=18b$ gives $\\gcd(a,b)=1$ and $ab=40$, whose coprime factor pairs are $(1,40)$ and $(5,8)$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p92-q78-normalise",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Write ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "m=18a",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " and ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "n=18b",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ", where ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\gcd(a,b)=1",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ". Since a and b have no common prime factors, ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\operatorname{lcm}(m,n)=18ab",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p92-q78-product",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}18ab&=720\\\\ab&=40\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p92-q78-factor-pairs",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The factor pairs of 40 are ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "(1,40),(2,20),(4,10),(5,8)",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ". Only ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "(1,40)",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " and ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "(5,8)",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " are coprime.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p92-q78-pairs",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}(m,n)&=(18\\times1,18\\times40)=(18,720)\\\\(m,n)&=(18\\times5,18\\times8)=(90,144)\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
