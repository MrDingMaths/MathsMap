          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$566 per fortnight",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay}&=\\text{Number of weeks}\\\\&\\quad\\times\\text{Pay per week}\\\\\\text{Fortnightly pay}&=2\\times\\$283\\\\\\text{Fortnightly pay}&=\\$566\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "1 year",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$14 716 per year",
          "worked": "$$\\begin{align*}\\text{Annual pay}&=\\text{Number of weeks}\\\\&\\quad\\times\\text{Pay per week}\\\\\\text{Annual pay}&=52\\times\\$283\\\\\\text{Annual pay}&=\\$14\\,716\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
