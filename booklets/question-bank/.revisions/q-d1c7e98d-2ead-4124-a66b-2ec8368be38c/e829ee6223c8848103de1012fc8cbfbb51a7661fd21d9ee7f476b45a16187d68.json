              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}\\text{Total pay}&=\\text{Number of periods}\\\\&\\quad\\times\\text{Pay per period}\\end{aligned}",
                  "display": true
                }
              ]
