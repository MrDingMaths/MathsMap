    "children": [
      {
        "id": "p29-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the initial mass?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18\\text{ g}$",
          "worked": "Initially, $t=0$.\n$$\\begin{align*}M &= 18\\times(1.75)^{-\\frac{3(0)}{5}}\\\\M &= 18\\times(1.75)^0\\\\M &= 18\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p29-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the half-life? (How long will it take to decay to half its current mass?)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\log_{1.75}(0.5)}{-3}$ days $\\approx 2.06$ days",
          "worked": "Half the initial mass is $9\\text{ g}$.\n$$\\begin{align*}9 &= 18\\times(1.75)^{-\\frac{3t}{5}}\\\\0.5 &= (1.75)^{-\\frac{3t}{5}}\\\\-\\frac{3t}{5} &= \\log_{1.75}(0.5)\\\\t &= \\frac{5\\log_{1.75}(0.5)}{-3}\\\\t &\\approx 2.06\\text{ days}\\end{align*}$$\nThe exponential model has a constant half-life.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
