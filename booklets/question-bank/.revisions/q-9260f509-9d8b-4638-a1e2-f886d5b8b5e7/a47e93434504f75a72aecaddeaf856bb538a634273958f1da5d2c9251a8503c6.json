          {
            "id": "p6-kelly-explain",
            "type": "part",
            "label": "i",
            "prompt": "The $-3$ should have stayed in the numerator for Kelly’s final answer to be correct. Why does the $-3$ belong in the numerator?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Only $x$ is raised to the power of $-2$.",
              "worked": "The $-3$ is a coefficient. Only $x$ has the negative index, so $-3x^{-2}=-\\dfrac{3}{x^2}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p6-kelly-simplify",
            "type": "part",
            "label": "ii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p6-kelly-simplify-instruction",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Simplify: ",
                      "marks": []
                    },
                    {
                      "type": "math",
                      "latex": "-2x^{-4}",
                      "display": false
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-\\dfrac{2}{x^4}$",
              "worked": "$\\begin{aligned}-2x^{-4}&=-2\\times\\frac{1}{x^4}\\\\&=-\\frac{2}{x^4}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p6-danice-responses",
        "type": "group",
        "label": "b",
        "prompt": {
