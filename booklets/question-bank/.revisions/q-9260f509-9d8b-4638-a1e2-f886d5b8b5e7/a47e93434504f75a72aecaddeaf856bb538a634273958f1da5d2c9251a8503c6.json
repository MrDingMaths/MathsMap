        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-danice-explain",
            "type": "part",
            "label": "i",
            "prompt": "Why was $x$ not included in Danice’s answer?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^0=1$.",
              "worked": "$x^0=1$, so multiplying by $x^0$ does not change $\\dfrac{1}{y^2}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-danice-simplify",
            "type": "part",
            "label": "ii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p6-danice-simplify-instruction",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Simplify: ",
                      "marks": []
                    },
                    {
                      "type": "math",
                      "latex": "a^{-4}b^0",
                      "display": false
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{a^4}$",
              "worked": "$\\begin{aligned}a^{-4}b^0&=\\frac{1}{a^4}\\times1\\\\&=\\frac{1}{a^4}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
