        "children": [
          {
            "id": "p6-maya-coefficient",
            "type": "part",
            "label": "i",
            "prompt": "Where did the $9$ come from in Maya’s expression?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The $3$ is inside the brackets, so it is squared: $3^2=9$.",
              "worked": "The outer power applies to every factor inside the brackets, including $3$. Hence $3^2=9$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-maya-fraction",
            "type": "part",
            "label": "ii",
            "prompt": "The original expression did not contain a fraction. Why did Maya’s answer contain a fraction?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The negative index gives $b^{-10}=\\dfrac{1}{b^{10}}$.",
              "worked": "Squaring $b^{-5}$ gives $b^{-10}$. The negative index moves this factor to the denominator with a positive index: $9a^2b^{-10}=\\dfrac{9a^2}{b^{10}}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p6-maya-simplify",
            "type": "part",
            "label": "iii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p6-maya-simplify-instruction",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Simplify: ",
                      "marks": []
                    },
                    {
                      "type": "math",
                      "latex": "(5a^{-3}b)^2",
                      "display": false
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{25b^2}{a^6}$",
              "worked": "$\\begin{aligned}(5a^{-3}b)^2&=5^2a^{-6}b^2\\\\&=25a^{-6}b^2\\\\&=\\frac{25b^2}{a^6}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
