        "children": [
          {
            "id": "p64-q7-a",
            "type": "part",
            "label": "a",
            "prompt": "$x^2+7x+7y-y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x-y+7)(x+y)$",
              "worked": "$$\\begin{align*}x^2+7x+7y-y^2&=x^2-y^2+7x+7y\\\\&=(x+y)(x-y)+7(x+y)\\\\&=(x+y)(x-y+7)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p64-q7-b",
            "type": "part",
            "label": "b",
            "prompt": "$x^2-2x-2y-y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x-y-2)(x+y)$",
              "worked": "$$\\begin{align*}x^2-2x-2y-y^2&=x^2-y^2-2x-2y\\\\&=(x+y)(x-y)-2(x+y)\\\\&=(x+y)(x-y-2)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p64-q7-c",
            "type": "part",
            "label": "c",
            "prompt": "$4x^2+4x+6y-9y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(2x-3y+2)(2x+3y)$",
              "worked": "$$\\begin{align*}4x^2+4x+6y-9y^2&=4x^2-9y^2+4x+6y\\\\&=(2x+3y)(2x-3y)\\\\&\\quad{}+2(2x+3y)\\\\&=(2x+3y)(2x-3y+2)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p64-q7-d",
            "type": "part",
            "label": "d",
            "prompt": "$25y^2+15y-4x^2+6x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(5y+2x)(5y-2x+3)$",
              "worked": "$$\\begin{align*}25y^2+15y-4x^2+6x&=25y^2-4x^2+15y+6x\\\\&=(5y+2x)(5y-2x)+3(5y+2x)\\\\&=(5y+2x)(5y-2x+3)\\end{align*}$$",
              "solutionDiagrams": []
            },
