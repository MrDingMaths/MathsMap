          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The rule for distance travelled from home, ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "d",
              "display": false
            },
            {
              "type": "text",
              "text": " km, over ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "t",
              "display": false
            },
            {
              "type": "text",
              "text": " hours for a moving vehicle is given by",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "math",
              "latex": "d=50+80t.",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p48-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the speed of the vehicle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "80 km/h",
          "worked": "The coefficient of $t$ is 80, so the distance increases by 80 km each hour. The speed is 80 km/h.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p48-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "If the speed was 70 km per hour, how would this change the rule? Give the new rule.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d = 50 + 70t$",
          "worked": "Replace the rate 80 with 70 and retain the initial distance 50 km.\n$$d = 50 + 70t$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p48-q8-root-bank-p48-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Predict which term will change before writing each rule.\n\nIf the speed is 60 km/h, write the new rule.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=50+60t$",
          "worked": "The coefficient of $t$ changes from 80 to 60; the initial distance stays 50 km.\n$$d=50+60t$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p48-q8-root-bank-p48-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "If the speed is 40 km/h, write the new rule.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=50+40t$",
          "worked": "The coefficient of $t$ changes to 40; the initial distance stays 50 km.\n$$d=50+40t$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p48-q8-root-bank-p48-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "What do you think the 50 represents?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The initial distance from home is 50 km.",
          "worked": "At $t=0$, $d=50$. The vehicle is initially 50 km from home.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
