    "type": "question",
    "label": "4",
    "prompt": "True or False? $\\frac{2x+y}{x+y}+\\frac{x+2y}{x+y}=3$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "True, for $x+y\\ne0$.",
      "worked": "$$\\begin{align*}\\frac{2x+y}{x+y}+\\frac{x+2y}{x+y}&=\\frac{3x+3y}{x+y}\\\\\\frac{2x+y}{x+y}+\\frac{x+2y}{x+y}&=\\frac{3(x+y)}{x+y}\\\\\\frac{2x+y}{x+y}+\\frac{x+2y}{x+y}&=3\\end{align*}$$\nTrue on the original domain $x+y\\ne0$.",
      "solutionDiagrams": []
    },
