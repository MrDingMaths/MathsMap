  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The equation of the line of best fit connecting grape yield ($G$), in tonnes, of a vineyard and the number of frosts ($n$) during the growing season is $G = -0.14n + 5.6$. Predict:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "The yield when there are 5 frosts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4.9 t",
          "worked": "Let $n = 5$.\n$$\\begin{align*}G &= -0.14(5) + 5.6\\\\G &= 4.9\\end{align*}$$\nThe predicted yield is 4.9 t.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The yield when there are 12 frosts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3.92 t",
          "worked": "Let $n = 12$.\n$$\\begin{align*}G &= -0.14(12) + 5.6\\\\G &= 3.92\\end{align*}$$\nThe predicted yield is 3.92 t.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The most number of frosts if you want the yield to be at least 3.5 t.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "15 frosts",
          "worked": "Find the number of frosts when $G = 3.5$.\n$$\\begin{align*}3.5 &= -0.14n + 5.6\\\\-2.1 &= -0.14n\\\\n &= 15\\end{align*}$$\nThe yield decreases as the number of frosts increases. Therefore, at most 15 frosts gives a predicted yield of at least 3.5 t.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
