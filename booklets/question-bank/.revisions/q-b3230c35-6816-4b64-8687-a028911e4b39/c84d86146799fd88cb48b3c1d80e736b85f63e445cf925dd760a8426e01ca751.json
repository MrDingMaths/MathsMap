  "content": {
    "id": "p35-q7-root",
    "type": "question",
    "label": "7",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p35-q7-stem",
          "type": "paragraph",
