  "content": {
    "id": "p14-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Rearrange each formula so that the pronumeral in square brackets is the subject.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$a = c\\sqrt{b+2}-d\\qquad [b]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\left(\\dfrac{a+d}{c}\\right)^2-2$",
          "worked": "$$\\begin{align*}a+d &= c\\sqrt{b+2}\\\\\\frac{a+d}{c} &= \\sqrt{b+2}\\\\\\left(\\frac{a+d}{c}\\right)^2 &= b+2\\\\\\left(\\frac{a+d}{c}\\right)^2-2 &= b\\\\b &= \\left(\\frac{a+d}{c}\\right)^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p14-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$t = a+(n-1)d\\qquad [n]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{t-a}{d}+1$",
          "worked": "$$\\begin{align*}t-a &= (n-1)d\\\\\\frac{t-a}{d} &= n-1\\\\\\frac{t-a}{d}+1 &= n\\\\n &= \\frac{t-a}{d}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
