          "worked": "$$\\begin{align*}2\\div\\frac{x}{5}&=2\\times\\frac{5}{x}\\\\&=\\frac{10}{x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
