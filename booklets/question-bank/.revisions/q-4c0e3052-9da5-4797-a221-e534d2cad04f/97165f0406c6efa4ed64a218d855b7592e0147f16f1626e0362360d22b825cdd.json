        "answerSpaceMm": 42
      },
      {
        "id": "p20-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Rolling a number 8 or greater (150 trials).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{10}\\times150=45$",
          "worked": "The favourable faces are 8, 9 and 10.\n$$\\begin{align*}P(\\text{8 or greater})&=\\frac3{10}\\\\f&=np\\\\f&=150\\times\\frac3{10}\\\\f&=45\\end{align*}$$\nExpected frequency: 45 rolls of 8 or greater.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "Rolling a 2, 4, 6 or 8 (200 trials).",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac4{10}\\times200=80$",
          "worked": "There are four favourable faces: 2, 4, 6 and 8.\n$$\\begin{align*}P(\\text{2, 4, 6 or 8})&=\\frac4{10}\\\\f&=np\\\\f&=200\\times\\frac4{10}\\\\f&=80\\end{align*}$$\nExpected frequency: 80 rolls of 2, 4, 6 or 8.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
