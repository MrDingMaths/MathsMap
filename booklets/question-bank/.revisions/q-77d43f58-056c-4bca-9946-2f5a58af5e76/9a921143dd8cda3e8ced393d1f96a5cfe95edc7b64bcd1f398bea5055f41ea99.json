  "content": {
    "id": "p37-q6",
    "type": "question",
    "label": "6",
    "prompt": "A car park has 450 cars, 100 motor bikes, and 10 buses. One is selected at random.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that it is a car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{45}{56}$",
          "worked": "Total vehicles: $450+100+10=560$.\n$$\\begin{align*}P(\\text{car})&=\\frac{450}{560}\\\\P(\\text{car})&=\\frac{45}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p37-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability that it is not a car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{56}$",
          "worked": "$$\\begin{align*}P(\\text{not car})&=1-\\frac{45}{56}\\\\P(\\text{not car})&=\\frac{11}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
  },
