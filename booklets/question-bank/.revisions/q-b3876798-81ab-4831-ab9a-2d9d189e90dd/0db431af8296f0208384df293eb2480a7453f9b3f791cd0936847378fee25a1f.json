    "answer": {
      "short": "$22.5\\text{ kg}$",
      "worked": "$$\\begin{align*} V &= Ah \\\\ V &= (5\\times15)\\times1.5\\text{ m}^3 \\\\ V &= 112.5\\text{ m}^3 \\\\ C &= 112.5\\times1000\\text{ L} \\\\ C &= 112\\,500\\text{ L} \\\\ \\text{Salt needed} &= \\left(112\\,500\\div10\\,000\\right)\\times2\\text{ kg} \\\\ \\text{Salt needed} &= 22.5\\text{ kg} \\end{align*}$$",
