      },
      {
        "id": "p41-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Using the rounded equation from part a, predict the score in Mathematics of a student who scores 60 in Science. Give your answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An estimated Mathematics score of $55.9$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "a3d1ba5e-513a-4696-96ae-93aff817e577-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}60&=8.00+0.93M\\\\0.93M&=52\\\\M&=\\frac{52}{0.93}\\\\M&\\approx55.9\\end{align*}",
                    "display": true
