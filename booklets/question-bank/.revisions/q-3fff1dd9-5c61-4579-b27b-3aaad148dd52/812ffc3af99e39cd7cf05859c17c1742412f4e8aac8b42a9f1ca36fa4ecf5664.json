      {
        "id": "p41-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Using the rounded equation from part a, predict the score in Science of a student who scores 80 in Mathematics. Give your answer to 1 decimal place.",
        "layout": "list",
