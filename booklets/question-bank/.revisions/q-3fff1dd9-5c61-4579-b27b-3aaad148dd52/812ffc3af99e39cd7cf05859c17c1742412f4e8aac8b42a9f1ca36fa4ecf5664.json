        "id": "p41-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the regression line predicting Science score $S$ from Mathematics score $M$. Give the coefficients to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S = 8.00 + 0.93M$.",
          "worked": "Enter Mathematics scores as $x$ and Science scores as $y$ in the calculator's two-variable statistics mode. Select linear regression $y=a+bx$.\n$$\\begin{align*}a&=8.004145\\ldots\\\\b&=0.927461\\ldots\\\\S&\\approx8.00+0.93M\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
