      {
        "id": "index-t8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\begin{aligned}(5a)^3&=5a\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&=5\\times 5\\times 5\\times a\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&=5^3\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{3} \\times a^{3}$",
          "worked": "$$\\begin{align*}(5a)^3&=5a\\times5a\\times5a \\\\ &=5\\times5\\times5\\times a\\times a\\times a \\\\ &=5^3\\times a^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{aligned}(ab)^4&=ab\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&=a\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&\\phantom{=}\\textcolor{#268cff}{\\times b}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&=a^4\\times \\textcolor{#268cff}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{4} \\times b^{4}$",
          "worked": "$$\\begin{align*}(ab)^4&=ab\\times ab\\times ab\\times ab \\\\ &=a\\times a\\times a\\times a\\times b\\times b\\times b\\times b \\\\ &=a^4\\times b^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
  },
