        "answer": {
          "short": "$\\theta=0^\\circ$.",
          "worked": "$\\begin{align*}\\cos\\theta&=\\frac{A}{H}\\\\\\cos\\theta&=\\frac{5}{5}\\\\\\theta&=\\cos^{-1}(1)\\\\\\theta&=0^\\circ\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p33-q4-explain",
        "type": "part",
        "label": "b",
        "prompt": "Explain why this triangle is impossible.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "An internal angle cannot be $0^\\circ$. The hypotenuse must be longer than either other side.",
          "worked": "The calculation gives $\\theta=0^\\circ$, so the triangle would collapse into a line. Also, the hypotenuse and adjacent side are both $5\\,\\mathrm{cm}$, but the hypotenuse must be strictly longer than either other side in a right-angled triangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
