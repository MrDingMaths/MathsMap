    "answer": {
      "short": "\\$19 564.25",
      "worked": "$$\\begin{align*}\\text{Taxable income} &= 91\\,500-1350-620\\\\\\text{Taxable income} &= \\$89\\,530\\end{align*}$$\nThis is the third tax bracket.\n$$\\begin{align*}\\text{Excess} &= 89\\,530-45\\,000\\\\\\text{Excess} &= \\$44\\,530\\\\\\text{Tax payable} &= 5092+0.325\\times44\\,530\\\\\\text{Tax payable} &= \\$19\\,564.25\\end{align*}$$",
