  "content": {
    "id": "p65-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Evaluate the following expressions, give your answer as a basic numeral.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p65-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$7^{7}\\div7^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49$",
          "worked": "$$\\begin{align*}7^{7}\\div7^{5}&=7^{7-5}\\\\&=7^{2}\\\\&=49\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p65-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$10^{6}\\div10^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}10^{6}\\div10^{5}&=10^{6-5}\\\\&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p65-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$101^{5}\\div101^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$101$",
          "worked": "$$\\begin{align*}101^{5}\\div101^{4}&=101^{5-4}\\\\&=101\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p65-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$2^{3}\\times2^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32$",
          "worked": "$$\\begin{align*}2^{3}\\times2^{2}&=2^{3+2}\\\\&=2^{5}\\\\&=32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p65-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^{2}\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27$",
          "worked": "$$\\begin{align*}3^{2}\\times3&=3^{2+1}\\\\&=3^{3}\\\\&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p65-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$4^{4}\\div4^{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}4^{4}\\div4^{4}&=4^{4-4}\\\\&=4^{0}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p65-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$200^{30}\\div200^{28}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40\\,000$",
          "worked": "$$\\begin{align*}200^{30}\\div200^{28}&=200^{30-28}\\\\&=200^{2}\\\\&=40\\,000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p65-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$7\\times(31^{16}\\div31^{15})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$217$",
          "worked": "$$\\begin{align*}7\\times(31^{16}\\div31^{15})&=7\\times31^{16-15}\\\\&=7\\times31\\\\&=217\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p65-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$3\\times(50^{200}\\div50^{198})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7500$",
          "worked": "$$\\begin{align*}3\\times(50^{200}\\div50^{198})&=3\\times50^{200-198}\\\\&=3\\times50^{2}\\\\&=3\\times2500\\\\&=7500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
