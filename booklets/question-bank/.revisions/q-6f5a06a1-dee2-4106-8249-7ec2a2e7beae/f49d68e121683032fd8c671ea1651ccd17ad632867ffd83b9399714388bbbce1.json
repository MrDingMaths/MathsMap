  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Explain why these percentages are rational numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q3-explanation",
        "type": "part",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "These percentages can each be written as a fraction with integer numerator and non-zero integer denominator.",
          "worked": "Divide each percentage value by $100$. Where the numerator is a terminating decimal, multiply numerator and denominator by a suitable power of $10$ to obtain integers, then simplify. Each result has an integer numerator and a non-zero integer denominator, so it is rational.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q3-conversions",
        "type": "group",
        "label": "",
        "prompt": "Write these percentages in the form $\\frac{a}{b}$ where $a$ and $b$ are integers.",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "$60\\%$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{3}{5}$",
              "worked": "$$\\begin{align*}60\\%&=\\frac{60}{100}\\\\60\\%&=\\frac{3}{5}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p20-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "$1\\%$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{100}$",
              "worked": "$$1\\%=\\frac{1}{100}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p20-q3-c",
            "type": "part",
            "label": "c",
            "prompt": "$0.5\\%$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{200}$",
              "worked": "$$\\begin{align*}0.5\\%&=\\frac{0.5}{100}\\\\0.5\\%&=\\frac{5}{1000}\\\\0.5\\%&=\\frac{1}{200}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p20-q3-d",
            "type": "part",
            "label": "d",
            "prompt": "$12.5\\%$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{8}$",
              "worked": "$$\\begin{align*}12.5\\%&=\\frac{12.5}{100}\\\\12.5\\%&=\\frac{125}{1000}\\\\12.5\\%&=\\frac{1}{8}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
