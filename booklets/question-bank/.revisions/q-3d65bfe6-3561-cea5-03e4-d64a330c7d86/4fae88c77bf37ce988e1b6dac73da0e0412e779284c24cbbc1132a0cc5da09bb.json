  "content": {
    "id": "p45-q15-group-root",
    "type": "question",
    "label": "3",
    "prompt": "True or False? Consider the set $A=\\{a,b,c,\\{b\\},\\{b,c\\},d\\}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q15-response",
        "type": "part",
        "label": "a",
        "prompt": "$b\\in A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $b$ is explicitly listed as an element of $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q16-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\{d\\}\\in A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $d$ is listed in $A$, but the singleton set $\\{d\\}$ is not.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q17-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\{b,\\{b,c\\}\\}\\in A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The complete set $\\{b,\\{b,c\\}\\}$ is not one of the listed elements of $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q18-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\{b,\\{b,c\\}\\}\\subseteq A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The two elements of $\\{b,\\{b,c\\}\\}$ are $b$ and $\\{b,c\\}$, and both are listed in $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q19-response",
        "type": "part",
        "label": "e",
        "prompt": "$\\{\\{b\\}\\}\\subseteq A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The only element of $\\{\\{b\\}\\}$ is $\\{b\\}$, which is listed in $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q20-response",
        "type": "part",
        "label": "f",
        "prompt": "$\\{\\{d\\}\\}\\subseteq A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The only element of $\\{\\{d\\}\\}$ is $\\{d\\}$, and $\\{d\\}\\notin A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q21-response",
        "type": "part",
        "label": "g",
        "prompt": "$\\{b,c\\}\\in A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. The set $\\{b,c\\}$ is explicitly listed as one element of $A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q22-response",
        "type": "part",
        "label": "h",
        "prompt": "$\\{a,b\\}\\in A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $a$ and $b$ occur separately in $A$, but the set $\\{a,b\\}$ is not a listed element.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q23-response",
        "type": "part",
        "label": "i",
        "prompt": "$\\{a,\\{b\\}\\}\\subseteq A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Both $a$ and $\\{b\\}$ are elements of $A$, so $\\{a,\\{b\\}\\}\\subseteq A$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p45-q24-response",
        "type": "part",
        "label": "j",
        "prompt": "$\\{a,\\{c\\}\\}\\subseteq A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. Although $a\\in A$, the other proposed element $\\{c\\}$ is not in $A$. Therefore the subset condition fails.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
