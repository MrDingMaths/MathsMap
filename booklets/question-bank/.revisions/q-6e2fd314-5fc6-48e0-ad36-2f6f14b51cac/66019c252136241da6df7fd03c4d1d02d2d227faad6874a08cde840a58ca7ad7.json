        "id": "p62-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate his annual income tax payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$21\\,293.25$",
          "worked": "Use the \\$45 001–\\$120 000 bracket.\n$$\\begin{align*}\\text{Excess} &= 94\\,850-45\\,000\\\\\\text{Excess} &= 49\\,850\\\\\\text{Tax payable} &= 5\\,092+0.325\\times49\\,850\\\\\\text{Tax payable} &= \\$21\\,293.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p62-q2-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "39ce3654-0c53-4fa2-9f7d-e1881e07ed54",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "David has already paid $24 678 in tax throughout the year. ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Should he receive a tax refund or does he have a tax liability?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tax refund.",
          "worked": "$$\\begin{align*}\\text{Instalments}-\\text{Tax payable} &= 24\\,678-21\\,293.25\\\\\\text{Instalments}-\\text{Tax payable} &= \\$3\\,384.75\\end{align*}$$\nHe has paid more than his tax payable, so he receives a tax refund.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
