      {
        "id": "p80-q31-a",
        "type": "part",
        "label": "a",
        "prompt": "$3<\\sqrt{10}<4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^2=9<10<16=4^2$, so $3<\\sqrt{10}<4$.",
          "worked": "$$\\begin{align*}3^2&=9\\\\4^2&=16\\end{align*}$$\nSince $9<10<16$, taking square roots gives $3<\\sqrt{10}<4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p80-q31-b",
        "type": "part",
        "label": "b",
        "prompt": "$11<\\sqrt{130}<12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11^2=121<130<144=12^2$, so $11<\\sqrt{130}<12$.",
          "worked": "$$\\begin{align*}11^2&=121\\\\12^2&=144\\end{align*}$$\nSince $121<130<144$, taking square roots gives $11<\\sqrt{130}<12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p80-q31-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4}{3}<\\sqrt{2}<\\dfrac{3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac43\\right)^2=\\frac{16}{9}<2<\\frac94=\\left(\\frac32\\right)^2$, so $\\frac43<\\sqrt2<\\frac32$.",
          "worked": "$$\\begin{align*}\\left(\\frac43\\right)^2&=\\frac{16}{9}<\\frac{18}{9}=2\\\\\\left(\\frac32\\right)^2&=\\frac94>\\frac84=2\\end{align*}$$\nBoth bounds are positive, so taking square roots gives $\\dfrac43<\\sqrt2<\\dfrac32$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p80-q31-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5}{3}<\\sqrt{3}<\\dfrac{7}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac53\\right)^2=\\frac{25}{9}<3<\\frac{49}{16}=\\left(\\frac74\\right)^2$, so $\\frac53<\\sqrt3<\\frac74$.",
          "worked": "$$\\begin{align*}\\left(\\frac53\\right)^2&=\\frac{25}{9}<\\frac{27}{9}=3\\\\\\left(\\frac74\\right)^2&=\\frac{49}{16}>\\frac{48}{16}=3\\end{align*}$$\nBoth bounds are positive, so taking square roots gives $\\dfrac53<\\sqrt3<\\dfrac74$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p80-q31-e",
        "type": "part",
        "label": "e",
        "prompt": "$2<\\sqrt[3]{10}<3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3=8<10<27=3^3$, so $2<\\sqrt[3]{10}<3$.",
          "worked": "$$\\begin{align*}2^3&=8\\\\3^3&=27\\end{align*}$$\nSince $8<10<27$, taking cube roots gives $2<\\sqrt[3]{10}<3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p80-q31-f",
        "type": "part",
        "label": "f",
        "prompt": "$1.2<\\sqrt{1.5}<1.3$",
