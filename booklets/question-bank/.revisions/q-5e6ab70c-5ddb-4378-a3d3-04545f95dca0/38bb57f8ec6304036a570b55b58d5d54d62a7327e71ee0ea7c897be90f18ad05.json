              ]
            },
            {
              "id": "p40-q62-a-text-2-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "by dividing both sides by ",
                  "marks": []
