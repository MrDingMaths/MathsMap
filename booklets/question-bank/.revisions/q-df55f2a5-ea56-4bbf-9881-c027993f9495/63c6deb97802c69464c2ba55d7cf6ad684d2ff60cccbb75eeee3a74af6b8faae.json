    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(x+3)^2-18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+12x$",
          "worked": "$$\\begin{align*}2(x+3)^2-18 &= 2\\bigl(x^2+2(x)(3)+3^2\\bigr)-18\\\\ &= 2(x^2+6x+9)-18\\\\ &= 2x^2+12x+18-18\\\\ &= 2x^2+12x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+4)^2-(x-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16x$",
          "worked": "$$\\begin{align*}(x+4)^2-(x-4)^2 &= \\bigl(x^2+2(x)(4)+4^2\\bigr)\\\\ &\\quad-\\bigl(x^2+2(x)(-4)+(-4)^2\\bigr)\\\\ &= (x^2+8x+16)-(x^2-8x+16)\\\\ &= x^2+8x+16-x^2+8x-16\\\\ &= 16x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p9-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+a)^2-(x-a)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4ax$",
          "worked": "$$\\begin{align*}(x+a)^2-(x-a)^2 &= \\bigl(x^2+2(x)(a)+a^2\\bigr)\\\\ &\\quad-\\bigl(x^2+2(x)(-a)+(-a)^2\\bigr)\\\\ &= (x^2+2ax+a^2)-(x^2-2ax+a^2)\\\\ &= x^2+2ax+a^2-x^2+2ax-a^2\\\\ &= 4ax\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p9-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x+1)^2+(x-1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2+2$",
          "worked": "$$\\begin{align*}(x+1)^2+(x-1)^2 &= \\bigl(x^2+2(x)(1)+1^2\\bigr)\\\\ &\\quad+\\bigl(x^2+2(x)(-1)+(-1)^2\\bigr)\\\\ &= x^2+2x+1+x^2-2x+1\\\\ &= 2x^2+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
