  "classification": {
    "primarySkillId": "earning-money",
    "secondarySkillIds": [],
    "reasoningScore": 25,
    "difficulty": "Development",
    "difficultyReason": "Mixed annual, weekly, fortnightly and monthly conversions, including finding hours from earnings and calculating annual wages."
  },
  "content": {
    "id": "p34-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Answer these questions. Round all answers to 2 decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Convert \\$68 484 p.a. salary to weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1317.00 per week",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\frac{\\text{Annual salary}}{52}\\\\\\text{Weekly pay}&=\\frac{\\$68\\,484}{52}\\\\\\text{Weekly pay}&=\\$1317.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Ken earns \\$182 940 p.a. salary. Convert this to fortnightly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$7036.15 per fortnight",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay}&=\\frac{\\text{Annual salary}}{26}\\\\\\text{Fortnightly pay}&=\\frac{\\$182\\,940}{26}\\\\\\text{Fortnightly pay}&\\approx\\$7036.15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "What is Yasmeen’s annual salary if her salary per fortnight is \\$1610?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$41 860.00 p.a.",
          "worked": "$$\\begin{align*}\\text{Annual salary}&=\\text{Fortnightly pay}\\times26\\\\\\text{Annual salary}&=\\$1610\\times26\\\\\\text{Annual salary}&=\\$41\\,860.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Dylan receives a weekly salary payment of \\$1560. What is his annual salary?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$81 120.00 p.a.",
          "worked": "$$\\begin{align*}\\text{Annual salary}&=\\text{Weekly pay}\\times52\\\\\\text{Annual salary}&=\\$1560\\times52\\\\\\text{Annual salary}&=\\$81\\,120.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "Determine the wage for a 37-hour week for someone earning \\$12 per hour.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$444.00",
          "worked": "$$\\begin{align*}\\text{Weekly wage}&=\\text{Hourly rate}\\times\\text{Hours worked}\\\\\\text{Weekly wage}&=\\$12\\times37\\\\\\text{Weekly wage}&=\\$444.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "Grace earns \\$525 in a week. If her hourly rate of pay is \\$12.50, how many hours does she work in the week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "42.00 hours",
          "worked": "$$\\begin{align*}\\text{Hours worked}&=\\frac{\\text{Weekly earnings}}{\\text{Hourly rate}}\\\\\\text{Hours worked}&=\\frac{525}{12.50}\\\\\\text{Hours worked}&=42.00\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "What is Zachary’s fortnightly income if he earns an annual salary of \\$43 056?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1656.00 per fortnight",
          "worked": "$$\\begin{align*}\\text{Fortnightly income}&=\\frac{\\text{Annual salary}}{26}\\\\\\text{Fortnightly income}&=\\frac{\\$43\\,056}{26}\\\\\\text{Fortnightly income}&=\\$1656.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q12-h",
        "type": "part",
        "label": "h",
        "prompt": "Kim is a plumber who earned \\$477 for a day’s work. He is paid \\$53 per hour. How many hours did Kim work on this day?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9.00 hours",
          "worked": "$$\\begin{align*}\\text{Hours worked}&=\\frac{\\text{Daily earnings}}{\\text{Hourly rate}}\\\\\\text{Hours worked}&=\\frac{477}{53}\\\\\\text{Hours worked}&=9.00\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q12-i",
        "type": "part",
        "label": "i",
        "prompt": "Brianna earns \\$16.65/h and works 15 hours per week. How much does she earn in 1 year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$12 987.00",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\$16.65\\times15\\\\\\text{Weekly pay}&=\\$249.75\\\\\\text{Annual pay}&=\\$249.75\\times52\\\\\\text{Annual pay}&=\\$12\\,987.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p34-q12-j",
        "type": "part",
        "label": "j",
        "prompt": "Ehab earns \\$97 286.40 per year. How much is this per month?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$8107.20 per month",
          "worked": "$$\\begin{align*}\\text{Monthly pay}&=\\frac{\\text{Annual pay}}{12}\\\\\\text{Monthly pay}&=\\frac{\\$97\\,286.40}{12}\\\\\\text{Monthly pay}&=\\$8107.20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q12-k",
        "type": "part",
        "label": "k",
        "prompt": "Johnson earns \\$5126 monthly. How much is this per year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$61 512.00 per year",
          "worked": "$$\\begin{align*}\\text{Annual pay}&=\\text{Monthly pay}\\times12\\\\\\text{Annual pay}&=\\$5126\\times12\\\\\\text{Annual pay}&=\\$61\\,512.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q12-l",
        "type": "part",
        "label": "l",
        "prompt": "Dave earns \\$2895 per fortnight. How much is his yearly salary?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$75 270.00 p.a.",
          "worked": "$$\\begin{align*}\\text{Yearly salary}&=\\text{Fortnightly pay}\\times26\\\\\\text{Yearly salary}&=\\$2895\\times26\\\\\\text{Yearly salary}&=\\$75\\,270.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
