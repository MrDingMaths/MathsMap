        "answer": {
          "short": "$x=\\frac{2ac-5bd}{3}$",
          "worked": "$$\\begin{align*}5x+5bd&=2x+2ac\\\\5x-2x+5bd&=2ac\\\\3x&=2ac-5bd\\\\x&=\\frac{2ac-5bd}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q2-g",
        "type": "part",
