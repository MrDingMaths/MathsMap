    "label": "2",
    "prompt": "Make $x$ the subject of these formulas.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$5x+b=2x+a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{a-b}{3}$",
          "worked": "$$\\begin{align*}5x-2x+b&=a\\\\3x&=a-b\\\\x&=\\frac{a-b}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$5x+bd=2x+ac$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{ac-bd}{3}$",
          "worked": "$$\\begin{align*}5x-2x+bd&=ac\\\\3x&=ac-bd\\\\x&=\\frac{ac-bd}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$bx+5=ax+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-3}{b-a}$",
          "worked": "$$\\begin{align*}bx-ax+5&=2\\\\bx-ax&=-3\\\\x(b-a)&=-3\\\\x&=\\frac{-3}{b-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p21-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$bx+5d=ax+2c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2c-5d}{b-a}$",
          "worked": "$$\\begin{align*}bx-ax+5d&=2c\\\\bx-ax&=2c-5d\\\\x(b-a)&=2c-5d\\\\x&=\\frac{2c-5d}{b-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$5(x+b)=2(x+a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2a-5b}{3}$",
          "worked": "$$\\begin{align*}5x+5b&=2x+2a\\\\5x-2x+5b&=2a\\\\3x&=2a-5b\\\\x&=\\frac{2a-5b}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$5(x+bd)=2(x+ac)$",
