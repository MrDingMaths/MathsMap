  "content": {
    "id": "p25-q6-response",
    "type": "question",
    "label": null,
    "prompt": "Felix has a gaming chair that has a backrest that can lean all the way back until it is flat. If the angle between the chair and the backrest is $119°$, how much more will it have to turn to lay flat?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$61°$",
      "worked": "Let $x$ be the additional turn in degrees. Angles on a straight line add up to $180°$.\n$$\\begin{align*}x+119&=180\\\\x&=61\\end{align*}$$\nThe backrest must turn a further $61°$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
