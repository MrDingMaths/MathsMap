          "short": "$25$",
          "worked": "$\\begin{aligned}(4\\times2-3)^2&=(8-3)^2\\\\&=5^2\\\\&=25\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
