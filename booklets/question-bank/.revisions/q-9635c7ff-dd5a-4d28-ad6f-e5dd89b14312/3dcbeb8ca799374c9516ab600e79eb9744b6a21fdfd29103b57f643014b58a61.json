    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$4+2\\times3^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22$",
          "worked": "$\\begin{aligned}4+2\\times3^2&=4+2\\times9\\\\&=4+18\\\\&=22\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(4+2-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$\\begin{aligned}(4+2-3)^2&=(6-3)^2\\\\&=3^2\\\\&=9\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(4+2)\\times3^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$54$",
          "worked": "$\\begin{aligned}(4+2)\\times3^2&=6\\times3^2\\\\&=6\\times9\\\\&=54\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$4+(2-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$\\begin{aligned}4+(2-3)^2&=4+(-1)^2\\\\&=4+1\\\\&=5\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$4+(2\\times3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$",
          "worked": "$\\begin{aligned}4+(2\\times3)^2&=4+6^2\\\\&=4+36\\\\&=40\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$4\\times(2-3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$\\begin{aligned}4\\times(2-3)^2&=4\\times(-1)^2\\\\&=4\\times1\\\\&=4\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$(4+2\\times3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100$",
          "worked": "$\\begin{aligned}(4+2\\times3)^2&=(4+6)^2\\\\&=10^2\\\\&=100\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$(4\\times2-3)^2$",
