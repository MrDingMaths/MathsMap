    "reasoningScore": 62,
    "difficulty": "Mastery",
    "difficultyReason": "1F Q74: Structural selection, multiple connected steps, proof or admissible-case reasoning. The inspected square expansion gives parts a and b without solving for a or b. PDF27's fraction method gives parts c and d using part a."
  },
  "content": {
    "id": "p32-q74-root",
    "type": "question",
    "label": "74",
    "prompt": "If $a+b=S$ and $ab=P$, find the value of the following expressions in terms of $S$ and $P$ without solving for $a$ or $b$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q74-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^2+b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^2-2P$.",
          "worked": "$$\\begin{align*}a^2+b^2&=(a+b)^2-2ab\\\\a^2+b^2&=S^2-2P.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q74-b",
        "type": "part",
        "label": "b",
        "prompt": "$(a-b)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S^2-4P$.",
          "worked": "$$\\begin{align*}(a-b)^2&=a^2+b^2-2ab\\\\(a-b)^2&=S^2-2P-2P\\\\(a-b)^2&=S^2-4P.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p32-q74-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac1{a^2}+\\dfrac1{b^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{S^2-2P}{P^2}$, where $a,b\\ne0$ (equivalently $P\\ne0$).",
          "worked": "$$\\begin{align*}\\frac1{a^2}+\\frac1{b^2}&=\\frac{a^2+b^2}{a^2b^2}\\\\\\frac1{a^2}+\\frac1{b^2}&=\\frac{S^2-2P}{P^2}.\\end{align*}$$\nThe original denominators require $a,b\\ne0$, equivalently $P\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p32-q74-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac ab+\\dfrac ba$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{S^2-2P}{P}$, where $a,b\\ne0$ (equivalently $P\\ne0$).",
          "worked": "$$\\begin{align*}\\frac ab+\\frac ba&=\\frac{a^2+b^2}{ab}\\\\\\frac ab+\\frac ba&=\\frac{S^2-2P}{P}.\\end{align*}$$\nThe original denominators require $a,b\\ne0$, equivalently $P\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
