              "inlines": [
                {
                  "type": "math",
                  "latex": "(y\\times10^{-2})-(6\\times10^{-3})=0.044",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=5$, $x=6$",
          "worked": "$$\\begin{align*}0.01y-0.006 &= 0.044\\\\0.01y &= 0.05\\\\y &= 5\\\\x &= y+1\\\\x &= 6\\end{align*}$$",
          "solutionDiagrams": []
