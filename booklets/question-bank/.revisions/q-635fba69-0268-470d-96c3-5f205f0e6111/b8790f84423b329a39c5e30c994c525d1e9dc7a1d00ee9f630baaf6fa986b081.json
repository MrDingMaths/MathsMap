  "content": {
    "id": "p25-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Find the value of each letter,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$p$ and $q$ are positive integers less than 10.\n$$ (p \\times 10^7) + (q \\times 10^2) = 50\\,000\\,400 $$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not unique as written: $p=k$, $q=500\\,004-100\\,000k$, for any integer $k$. The supplied pair $p=5$, $q=4$ is one solution.",
          "worked": "$$\\begin{align*}100\\,000p+q &= 500\\,004\\\\q &= 500\\,004-100\\,000p\\end{align*}$$\nEvery integer choice of $p$ gives an integer $q$, so the values are not uniquely determined. For $p=5$,\n$$\\begin{align*}q &= 500\\,004-100\\,000(5)\\\\q &= 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$n$ is a positive integer less than 10.\n$$ (n \\times 10^8) - (n \\times 10^5) = 399\\,600\\,000 $$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4$",
          "worked": "$$\\begin{align*}99\\,900\\,000n &= 399\\,600\\,000\\\\n &= \\frac{399\\,600\\,000}{99\\,900\\,000}\\\\n &= 4\\end{align*}$$\nThis is a positive integer less than 10.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q18-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p25-q18-root-bank-p25-q18-c-integers",
