      {
        "id": "p27-q8-ab-explanation",
        "type": "part",
        "label": "",
        "prompt": "Explain why you can eliminate options A and B immediately.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both contain a factor of 5, but 424 is not divisible by 5.",
          "worked": "Both A and B contain a factor of 5. A multiple of 5 ends in 0 or 5, whereas 424 ends in 4, so neither can equal 424.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p27-q8-c-explanation",
        "type": "part",
        "label": "",
        "prompt": "Explain why C is not the correct answer:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8 is not prime ($8=2^{3}$).",
          "worked": "$8=2\\times2\\times2$, so 8 is composite. Although $53\\times8=424$, C is not a product of prime factors.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
