  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Factorise and use the null factor law to find the $x$-intercepts for these quadratics.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = x^2 + 3x + 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -2,\\ -1$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2+3x+2\\\\0&=(x+2)(x+1)\\\\x+2&=0\\quad\\text{or}\\quad x+1=0\\\\x&=-2\\quad\\text{or}\\quad x=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = x^2 + 2x - 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -4,\\ 2$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2+2x-8\\\\0&=(x+4)(x-2)\\\\x+4&=0\\quad\\text{or}\\quad x-2=0\\\\x&=-4\\quad\\text{or}\\quad x=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = x^2 - 8x + 16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 4$",
          "worked": "At the $x$-intercept, $y=0$.\n$$\\begin{align*}0&=x^2-8x+16\\\\0&=(x-4)^2\\\\x-4&=0\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = x^2 - 4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 0,\\ 4$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2-4x\\\\0&=x(x-4)\\\\x&=0\\quad\\text{or}\\quad x-4=0\\\\x&=0\\quad\\text{or}\\quad x=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y = x^2 - 6x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 0,\\ 6$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2-6x\\\\0&=x(x-6)\\\\x&=0\\quad\\text{or}\\quad x-6=0\\\\x&=0\\quad\\text{or}\\quad x=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y = 2x^2 + 10x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 0,\\ -5$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=2x^2+10x\\\\0&=2x(x+5)\\\\2x&=0\\quad\\text{or}\\quad x+5=0\\\\x&=0\\quad\\text{or}\\quad x=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$y = x^2 - 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -3,\\ 3$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2-9\\\\0&=(x+3)(x-3)\\\\x+3&=0\\quad\\text{or}\\quad x-3=0\\\\x&=-3\\quad\\text{or}\\quad x=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$y = x^2 - 25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -5,\\ 5$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2-25\\\\0&=(x+5)(x-5)\\\\x+5&=0\\quad\\text{or}\\quad x-5=0\\\\x&=-5\\quad\\text{or}\\quad x=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p7-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$y = x^2 - 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = -\\sqrt{10},\\ \\sqrt{10}$",
          "worked": "At the $x$-intercepts, $y=0$.\n$$\\begin{align*}0&=x^2-10\\\\0&=(x+\\sqrt{10})(x-\\sqrt{10})\\\\x+\\sqrt{10}&=0\\quad\\text{or}\\\\x-\\sqrt{10}&=0\\\\x&=-\\sqrt{10}\\quad\\text{or}\\\\x&=\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
