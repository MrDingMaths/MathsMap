    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{10}{13}$",
      "worked": "$$\\begin{align*}P(\\text{consonant})&=1-P(\\text{vowel})\\\\P(\\text{consonant})&=1-\\frac{3}{13}\\\\P(\\text{consonant})&=\\frac{10}{13}\\end{align*}$$",
      "solutionDiagrams": []
