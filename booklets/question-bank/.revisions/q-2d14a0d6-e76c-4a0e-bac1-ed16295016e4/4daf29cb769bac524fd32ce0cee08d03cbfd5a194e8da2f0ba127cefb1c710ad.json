  "content": {
    "id": "p47-q12",
    "type": "question",
    "label": "12",
    "prompt": "Factorise by grouping.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(a-3)-x(a-3)-c(a-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-3)(2-x-c)$",
          "worked": "$$\\begin{align*}2(a-3)-x(a-3)-c(a-3)&=(a-3)(2-x-c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p47-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$b(2a+1)+5(2a+1)-a(2a+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2a+1)(b+5-a)$",
          "worked": "$$\\begin{align*}b(2a+1)+5(2a+1)-a(2a+1)&=(2a+1)(b+5-a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p47-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$x(a+1)-4(a+1)-ba-b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+1)(x-4-b)$",
          "worked": "$$\\begin{align*}x(a+1)-4(a+1)-ba-b&=x(a+1)-4(a+1)-b(a+1)\\\\&=(a+1)(x-4-b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$c(1-a)-x+ax+2-2a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-a)(c-x+2)$",
          "worked": "$$\\begin{align*}c(1-a)-x+ax+2-2a&=c(1-a)-x(1-a)+2(1-a)\\\\&=(1-a)(c-x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^2-3ac-2ab+6bc+3abc-9bc^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-3c)(a-2b+3bc)$",
          "worked": "$$\\begin{align*}a^2-3ac-2ab+6bc+3abc-9bc^2&=a(a-3c)-2b(a-3c)\\\\&\\quad+3bc(a-3c)\\\\&=(a-3c)(a-2b+3bc)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p47-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$8z-4y+3x^2+xy-12x-2xz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-4)(3x+y-2z)$",
          "worked": "$$\\begin{align*}8z-4y+3x^2+xy-12x-2xz&=3x^2-12x+xy-4y-2xz+8z\\\\&=3x(x-4)+y(x-4)\\\\&\\quad-2z(x-4)\\\\&=(x-4)(3x+y-2z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
