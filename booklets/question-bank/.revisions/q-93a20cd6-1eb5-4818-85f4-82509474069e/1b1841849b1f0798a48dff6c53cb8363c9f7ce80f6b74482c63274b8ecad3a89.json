        "children": [],
        "answer": {
          "short": "$\\{b,d\\}$",
          "worked": "$A'=\\{b,d,f\\}$ within $U$.\n$$\\begin{align*}A'\\cap B&=\\{b,d,f\\}\\cap\\{b,c,d,e\\}\\\\A'\\cap B&=\\{b,d\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
