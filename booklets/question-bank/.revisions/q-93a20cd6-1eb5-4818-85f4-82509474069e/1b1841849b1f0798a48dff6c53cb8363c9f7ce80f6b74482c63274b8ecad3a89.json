        "type": "part",
        "label": "a",
        "prompt": "$A\\cap B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{c,e\\}$",
          "worked": "Both sets contain $c$ and $e$.\n$$A\\cap B=\\{c,e\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p52-q26-b",
