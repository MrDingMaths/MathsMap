        "answer": {
          "short": "$\\{a\\}$",
          "worked": "$B'=\\{a,f\\}$ within $U$.\n$$\\begin{align*}A\\cap B'&=\\{a,c,e\\}\\cap\\{a,f\\}\\\\A\\cap B'&=\\{a\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p52-q26-c",
        "type": "part",
