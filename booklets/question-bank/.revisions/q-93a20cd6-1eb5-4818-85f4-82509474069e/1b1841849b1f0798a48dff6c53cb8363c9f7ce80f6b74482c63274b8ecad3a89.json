  "content": {
    "id": "p52-q26-root",
    "type": "question",
    "label": "26",
    "prompt": "Define the universal set $U=\\{a,b,c,d,e,f\\}$. Let $A=\\{a,c,e\\}$ and $B=\\{b,c,d,e\\}$. List the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
