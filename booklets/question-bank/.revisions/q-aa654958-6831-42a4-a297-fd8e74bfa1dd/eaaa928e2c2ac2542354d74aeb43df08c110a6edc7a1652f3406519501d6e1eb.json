      },
      {
        "id": "p23-q6-female-plot",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 23 p23-q6-female-plot\"}\n\\begin{tikzpicture}[x=6.8mm,y=3.8mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{headingBorder}{HTML}{CCCCCC}\n\\path[use as bounding box] (4.6,-2.4) rectangle (12.4,10.2);\n\\node[draw=headingBorder,line width=0.4pt,inner sep=1pt,font=\\fontsize{10}{12}\\selectfont,text=black] at (8.5,9.4) {Female};\n\\draw[black,line width=0.5pt] (4.8,0)--(12.3,0);\n\\foreach \\x in {5,...,12} {\n\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-0.45);\n\\node[anchor=north,font=\\fontsize{8.5}{10}\\selectfont,text=black] at (\\x,-0.6) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\x\\special{dvisvgm:raw </g>}};\n}\n\\foreach \\x/\\n in {5/7,6/5,7/8,8/2,9/3,10/5,12/1} {\n\\foreach \\j in {1,...,\\n} {\\fill[black] (\\x,\\j) circle[radius=0.85mm];}\n}\n\\node[anchor=north,font=\\fontsize{10}{12}\\selectfont,text=black] at (8.5,-1.65) {Age (years)};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
