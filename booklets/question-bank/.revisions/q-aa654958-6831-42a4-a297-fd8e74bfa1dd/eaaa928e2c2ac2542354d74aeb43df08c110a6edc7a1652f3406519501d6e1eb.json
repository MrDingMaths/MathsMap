    "children": [
      {
        "id": "p23-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "How many children were male?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "29 children.",
          "worked": "Add the Male dot-stack frequencies.\n$$4+2+5+1+1+5+7+4=29\\text{ children}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p23-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many children were 7 years old?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "13 children.",
          "worked": "At age $7$, there are $5$ males and $8$ females.\n$$5+8=13\\text{ children}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p23-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "How many children were 11 or older?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 children.",
          "worked": "Count ages $11$ and $12$ in both plots.\n$$7+4+0+1=12\\text{ children}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p23-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "How many more 10-year-olds used the slide compared to 6-year-olds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 children.",
          "worked": "There are $5+5=10$ ten-year-olds and $2+5=7$ six-year-olds.\n$$10-7=3\\text{ more children}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p23-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "What percentage of 9-year-olds were male?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$.\n\nDivide the male nine-year-olds by all nine-year-olds, then multiply by 100%.",
          "worked": "Of the $1+3=4$ nine-year-olds, $1$ was male.\n$$\\frac{1}{4}\\times100\\%=25\\%$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p23-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "What percentage of 5-year-olds were female?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx63.6\\%$.",
          "worked": "Of the $4+7=11$ five-year-olds, $7$ were female.\n$$\\begin{align*}\\frac{7}{11}\\times100\\%&=\\frac{700}{11}\\%\\\\\\frac{7}{11}\\times100\\%&\\approx63.6\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p23-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "What percentage of females were 10 years old?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\approx16.1\\%$.\n\nDivide the ten-year-old females by all females, then multiply by 100%.",
          "worked": "Of the $31$ females, $5$ were ten years old.\n$$\\begin{align*}\\frac{5}{31}\\times100\\%&=\\frac{500}{31}\\%\\\\\\frac{5}{31}\\times100\\%&\\approx16.1\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
