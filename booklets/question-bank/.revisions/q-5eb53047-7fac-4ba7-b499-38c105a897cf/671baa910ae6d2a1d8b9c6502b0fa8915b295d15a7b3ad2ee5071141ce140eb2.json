    "label": "3",
    "prompt": "Describe the mistake and provide the correct solution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-a",
        "type": "group",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p6-q3-a-incorrect-working",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}\\frac{x+1}{5}+\\frac{x}{2}&=\\frac{2x+1}{10}+\\frac{5x}{10}\\\\&=\\frac{7x+1}{10}\\quad\\color{#ef6068}{\\boldsymbol{\\times}}\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q3-a-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The constant 1 was not multiplied by 2.",
              "worked": "Both terms in $x+1$ must be multiplied by 2: $2(x+1)=2x+2$, not $2x+1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p6-q3-a-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct solution:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{7x+2}{10}$",
              "worked": "$\\begin{aligned}\\frac{x+1}{5}+\\frac{x}{2}&=\\frac{2(x+1)}{10}+\\frac{5x}{10}\\\\&=\\frac{2x+2+5x}{10}\\\\&=\\frac{7x+2}{10}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      },
      {
        "id": "p6-q3-b",
        "type": "group",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p6-q3-b-incorrect-working",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}\\frac{5x}{3}+\\frac{x-1}{2}&=\\frac{10x}{6}+\\frac{3x-1}{6}\\\\&=\\frac{13x-1}{6}\\quad\\color{#ef6068}{\\boldsymbol{\\times}}\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q3-b-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The constant −1 was not multiplied by 3.",
              "worked": "Both terms in $x-1$ must be multiplied by 3: $3(x-1)=3x-3$, not $3x-1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p6-q3-b-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct solution:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{13x-3}{6}$",
              "worked": "$\\begin{aligned}\\frac{5x}{3}+\\frac{x-1}{2}&=\\frac{10x}{6}+\\frac{3(x-1)}{6}\\\\&=\\frac{10x+3x-3}{6}\\\\&=\\frac{13x-3}{6}\\end{aligned}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      }
    ]
  },
