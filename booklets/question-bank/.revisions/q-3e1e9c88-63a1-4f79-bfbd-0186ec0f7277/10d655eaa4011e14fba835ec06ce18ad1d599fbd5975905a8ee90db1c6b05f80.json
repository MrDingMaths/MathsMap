        "children": [
          {
            "id": "p15-q18-c-i",
            "type": "part",
            "label": "i",
            "prompt": "both marbles are red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "There is only one red marble, and it is not replaced. No path gives two red marbles.\n$P(\\text{both red})=\\frac{0}{6}=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p15-q18-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "both marbles are the same colour",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0$",
              "worked": "There is only one marble of each colour. No path gives two marbles of the same colour.\n$P(\\text{same colour})=\\frac{0}{6}=0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p15-q18-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "both marbles are different colours",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "All six paths give different colours.\n$P(\\text{different colours})=\\frac{6}{6}=1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q18-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "the first marble is red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "The favourable outcomes are RB and RW.\n$P(\\text{first red})=\\frac{2}{6}=\\frac{1}{3}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p15-q18-c-v",
            "type": "part",
            "label": "v",
            "prompt": "there is one blue and one white marble",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "The favourable outcomes are BW and WB.\n$P(\\text{one blue and one white})=\\frac{2}{6}=\\frac{1}{3}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p15-q18-c-vi",
            "type": "part",
            "label": "vi",
            "prompt": "exactly one marble is red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{3}$",
              "worked": "The favourable outcomes are RB, RW, BR and WR.\n$P(\\text{exactly one red})=\\frac{4}{6}=\\frac{2}{3}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q18-c-vii",
            "type": "part",
