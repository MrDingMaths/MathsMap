    "label": "32",
    "prompt": "Rationalise the denominator of $\\dfrac1{1+\\sqrt2+\\sqrt3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{2+\\sqrt2-\\sqrt6}{4}$.\n\nUse $1+\\sqrt2-\\sqrt3$, then multiply by $\\sqrt2$.",
      "worked": "$$\\begin{align*}\\frac1{1+\\sqrt2+\\sqrt3}&=\\frac{1+\\sqrt2-\\sqrt3}{(1+\\sqrt2)^2-3}\\\\\\frac1{1+\\sqrt2+\\sqrt3}&=\\frac{1+\\sqrt2-\\sqrt3}{2\\sqrt2}\\\\\\frac1{1+\\sqrt2+\\sqrt3}&=\\frac{\\sqrt2(1+\\sqrt2-\\sqrt3)}4\\\\\\frac1{1+\\sqrt2+\\sqrt3}&=\\frac{2+\\sqrt2-\\sqrt6}{4}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
