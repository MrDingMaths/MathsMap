        "id": "p59-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate tax payable using the tax table.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$17\\,232.38$",
          "worked": "The taxable income is in the $\\$45\\,001$–$\\$120\\,000$ bracket.\n$$\\begin{align*}\\text{Excess} &= 82\\,355-45\\,000\\\\&=37\\,355\\\\\\text{Tax payable} &= 5\\,092+0.325\\times37\\,355\\\\&=17\\,232.375\\\\&\\approx\\$17\\,232.38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p59-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the weekly PAYG instalment.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$331.39$ per week",
          "worked": "$$\\begin{align*}\\text{Weekly PAYG instalment} &= \\frac{17\\,232.38}{52}\\\\&\\approx\\$331.39\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p59-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate her weekly net earnings.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1\\,252.36$ per week",
          "worked": "$$\\begin{align*}\\text{Weekly gross earnings} &= \\frac{82\\,355}{52}\\\\&=\\$1\\,583.75\\\\\\text{Weekly net earnings} &= 1\\,583.75-331.39\\\\&=\\$1\\,252.36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
