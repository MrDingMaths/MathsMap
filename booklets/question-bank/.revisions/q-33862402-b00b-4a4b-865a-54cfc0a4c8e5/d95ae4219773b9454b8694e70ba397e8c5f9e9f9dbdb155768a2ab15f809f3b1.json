  "content": {
    "id": "p52-q36-stem",
    "type": "question",
    "label": "36",
    "prompt": "Let $f(x)=x^2$ and $g(x)=\\sqrt{x}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q36-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(g(x))=x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=(\\sqrt{x})^2=x$ for $x\\geq0$.",
          "worked": "$$\\begin{align*}f(g(x))&=f(\\sqrt{x})\\\\f(g(x))&=(\\sqrt{x})^2\\\\f(g(x))&=x\\end{align*}$$\nThis composition is defined for $x\\geq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p52-q36-b",
        "type": "part",
        "label": "b",
        "prompt": "Find a value of $a$ such that $g(f(a))\\ne a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $a=-1$, since $g(f(-1))=1\\ne-1$. Any $a<0$ works.",
          "worked": "Choose $a=-1$.\n$$\\begin{align*}g(f(-1))&=g(1)\\\\g(f(-1))&=1\\end{align*}$$\nThus $g(f(-1))\\ne-1$. More generally, $g(f(a))=\\sqrt{a^2}=|a|$, so any negative $a$ works.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
