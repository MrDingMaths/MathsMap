            "id": "p10-q5-number-lines",
            "type": "part",
            "label": "b",
            "prompt": "$12\\ge x$ and $x\\ge12$ mean two different things. Show the meaning of both using a number line.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
