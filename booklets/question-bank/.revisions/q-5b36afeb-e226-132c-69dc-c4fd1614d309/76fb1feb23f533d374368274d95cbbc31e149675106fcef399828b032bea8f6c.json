  "content": {
    "id": "p21-q1-group-root",
    "type": "question",
    "label": "1",
    "prompt": "True or False? Let $x,y\\geq0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q1-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\sqrt{x+y}=\\sqrt{x}+\\sqrt{y}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "For $x=y=1$, the left-hand side is $\\sqrt{2}$ and the right-hand side is $2$. Since $\\sqrt{2}\\ne2$, the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q2-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\sqrt{xy}=\\sqrt{x}\\sqrt{y}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "The square-root product rule $\\sqrt{xy}=\\sqrt{x}\\sqrt{y}$ applies because $x$ and $y$ are both non-negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q3-response",
        "type": "part",
        "label": "c",
        "prompt": "$$\\sqrt{\\frac{x}{y}}=\\frac{\\sqrt{x}}{\\sqrt{y}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for $x\\geq0$ and $y>0$; undefined when $y=0$.",
          "worked": "The square-root quotient rule applies for $x\\geq0$ and $y>0$. When $y=0$, both sides involve division by zero and are undefined. The printed condition $y\\geq0$ therefore includes an undefined case.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q4-response",
        "type": "part",
        "label": "d",
        "prompt": "$$(\\sqrt{x}+\\sqrt{y})^2=x+y$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$$\\begin{align*}(\\sqrt{x}+\\sqrt{y})^2&=x+2\\sqrt{xy}+y\\end{align*}$$\nThe cross term $2\\sqrt{xy}$ is generally nonzero, so the statement is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q5-response",
        "type": "part",
        "label": "e",
        "prompt": "The conjugate of $\\sqrt{5}$ is $\\sqrt{5}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Its conjugate is $-\\sqrt{5}$.",
          "worked": "Write $\\sqrt{5}=0+\\sqrt{5}$. Keeping the rational part and reversing the surd term gives $0-\\sqrt{5}=-\\sqrt{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q6-response",
        "type": "part",
        "label": "f",
        "prompt": "The conjugate of $10$ is $10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True. There is no surd term to change sign.",
          "worked": "The number $10$ is rational. It has no surd term to change sign, so its conjugate is $10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q7-response",
        "type": "part",
        "label": "g",
        "prompt": "The conjugate of $1+\\sqrt{2}$ is $1-\\sqrt{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Keep the rational term $1$ and reverse the sign of $\\sqrt{2}$. The conjugate is $1-\\sqrt{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q8-response",
        "type": "part",
        "label": "h",
        "prompt": "The conjugate of $\\sqrt{5}+1$ is $\\sqrt{5}-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False. Its conjugate is $-\\sqrt{5}+1$.",
          "worked": "The rational term $1$ stays unchanged and the surd term $\\sqrt{5}$ changes sign. The conjugate is $-\\sqrt{5}+1$, not $\\sqrt{5}-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
