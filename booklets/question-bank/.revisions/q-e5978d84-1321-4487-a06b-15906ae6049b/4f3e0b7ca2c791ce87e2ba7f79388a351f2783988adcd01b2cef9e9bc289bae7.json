            {
              "type": "text",
              "text": "Jessica invested $18 820 to buy a new car for her business.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "How many years would it take for this car to depreciate to $4520?",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Assume declining-balance depreciation at a rate of 30% p.a.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "(Answer to the nearest year.)",
              "marks": []
            }
          ]
        },
        {
          "id": "p26-q14-response-bank-p26-q14-response-trial-hint",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Hint: set up the compound depreciation equation and use trial and error to estimate n. Refine your trials around the target, then round the estimated time as requested.",
              "marks": []
            }
          ]
        }
      ]
