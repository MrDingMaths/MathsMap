    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$10cn+12n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2n(5c+6)$",
          "worked": "The HCF is $2n$.\n$$\\begin{align*}10cn+12n &= 2n\\left(\\frac{10cn}{2n}+\\frac{12n}{2n}\\right)\\\\10cn+12n &= 2n(5c+6)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$24y+8ry$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8y(3+r)$",
          "worked": "The HCF is $8y$.\n$$\\begin{align*}24y+8ry &= 8y\\left(\\frac{24y}{8y}+\\frac{8ry}{8y}\\right)\\\\24y+8ry &= 8y(3+r)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$14jn+10n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2n(7j+5)$",
          "worked": "The HCF is $2n$.\n$$\\begin{align*}14jn+10n &= 2n\\left(\\frac{14jn}{2n}+\\frac{10n}{2n}\\right)\\\\14jn+10n &= 2n(7j+5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$24g+20gj$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4g(6+5j)$",
          "worked": "The HCF is $4g$.\n$$\\begin{align*}24g+20gj &= 4g\\left(\\frac{24g}{4g}+\\frac{20gj}{4g}\\right)\\\\24g+20gj &= 4g(6+5j)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$10h+4z$",
