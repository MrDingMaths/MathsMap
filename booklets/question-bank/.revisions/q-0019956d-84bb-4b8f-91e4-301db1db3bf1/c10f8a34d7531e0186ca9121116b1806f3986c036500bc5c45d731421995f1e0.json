        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(5h+2z)$",
          "worked": "The HCF is $2$.\n$$\\begin{align*}10h+4z &= 2\\left(\\frac{10h}{2}+\\frac{4z}{2}\\right)\\\\10h+4z &= 2(5h+2z)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
