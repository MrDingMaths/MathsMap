        "answer": {
          "short": "\\$35 312",
          "worked": "$$\\begin{align*}\\text{Taxable income} &= (32\\,056 + 8159) - 4903\\\\\\text{Taxable income} &= \\$35\\,312\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p63-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the income tax payable on her taxable income.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3251.28",
          "worked": "Using the 2022–23 resident tax table, her taxable income is in the \\$18 201–\\$45 000 bracket.\n$$\\begin{align*}\\text{Excess} &= 35\\,312 - 18\\,200\\\\\\text{Excess} &= 17\\,112\\\\\\text{Tax payable} &= 0 + 0.19\\times17\\,112\\\\\\text{Tax payable} &= \\$3251.28\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p63-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find her tax refund or tax balance payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tax refund of \\$1872.62.",
          "worked": "$$\\begin{align*}\\text{Instalments} - \\text{tax payable} &= 5123.90 - 3251.28\\\\\\text{Instalments} - \\text{tax payable} &= \\$1872.62\\end{align*}$$\nShe has paid too much tax, so she receives a refund of \\$1872.62.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
