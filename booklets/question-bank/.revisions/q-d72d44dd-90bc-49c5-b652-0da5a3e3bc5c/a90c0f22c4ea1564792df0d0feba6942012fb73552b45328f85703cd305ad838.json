    "children": [
      {
        "id": "index-t7-q24-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\left( b^{2} \\right)^{5}}{b^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^{6}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( b^{2} \\right)^{5}}{b^{4}} &= b^{2\\times5 - 4} \\\\\n&= b^{6}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\left( x^{4} \\right)^{3}}{x^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{5}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( x^{4} \\right)^{3}}{x^{7}} &= x^{4\\times3 - 7} \\\\\n&= x^{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{\\left( y^{3} \\right)^{3}}{y^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^{6}$",
          "worked": "$$\\begin{align*}\n\\frac{\\left( y^{3} \\right)^{3}}{y^{3}} &= y^{3\\times3 - 3} \\\\\n&= y^{6}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3x^{4}\\  \\times \\ 6x^{3}}{9x^{12}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{x^{5}}$",
          "worked": "$$\\begin{align*}\n\\frac{3x^{4}\\  \\times \\ 6x^{3}}{9x^{12}} &= \\frac{3\\times6}{9\\,x^{- 4 - 3 + 12}} \\\\\n&= \\frac{2}{x^{5}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{5x^{5}\\  \\times \\ 4x^{2}}{2x^{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{x^{3}}$",
          "worked": "$$\\begin{align*}\n\\frac{5x^{5}\\  \\times \\ 4x^{2}}{2x^{10}} &= \\frac{5\\times4}{2\\,x^{- 5 - 2 + 10}} \\\\\n&= \\frac{10}{x^{3}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{24\\left( x^{4} \\right)^{4}}{8\\left( x^{4} \\right)^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^{8}$",
          "worked": "$$\\begin{align*}\n\\frac{24\\left( x^{4} \\right)^{4}}{8\\left( x^{4} \\right)^{2}} &= \\frac{24\\,x^{4\\times4 - 4\\times2}}{8} \\\\\n&= 3x^{8}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{4\\left( d^{4} \\right)^{3}\\  \\times \\ \\left( e^{4} \\right)^{2}}{8\\left( d^{2} \\right)^{5}\\  \\times \\ e^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d^{2}e}{2}$",
          "worked": "$$\\begin{align*}\n\\frac{4\\left( d^{4} \\right)^{3}\\  \\times \\ \\left( e^{4} \\right)^{2}}{8\\left( d^{2} \\right)^{5}\\  \\times \\ e^{7}} &= \\frac{4\\,d^{4\\times3 - 2\\times5}\\,e^{4\\times2 - 7}}{8} \\\\\n&= \\frac{d^{2}e}{2}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{6\\left( m^{3} \\right)^{2}\\left( n^{5} \\right)^{3}}{15\\left( m^{5} \\right)^{0}\\left( n^{2} \\right)^{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2m^{6}n}{5}$",
          "worked": "$$\\begin{align*}\n\\frac{6\\left( m^{3} \\right)^{2}\\left( n^{5} \\right)^{3}}{15\\left( m^{5} \\right)^{0}\\left( n^{2} \\right)^{7}} &= \\frac{6\\,m^{3\\times2 - 5\\times0}\\,n^{5\\times3 - 2\\times7}}{15} \\\\\n&= \\frac{2m^{6}n}{5}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q24-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{2\\left( a^{3} \\right)^{4}\\left( b^{2} \\right)^{6}}{16(a)^{0}\\left( b^{6} \\right)^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^{12}}{8}$",
          "worked": "$$\\begin{align*}\n\\frac{2\\left( a^{3} \\right)^{4}\\left( b^{2} \\right)^{6}}{16(a)^{0}\\left( b^{6} \\right)^{2}} &= \\frac{2\\,a^{3\\times4 - 0}\\,b^{2\\times6 - 6\\times2}}{16} \\\\\n&= \\frac{a^{12}}{8}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
