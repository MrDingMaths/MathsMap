            "prompt": "What was the highest score?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "43",
              "worked": "The largest stem is $4$ and its largest leaf is $3$, giving $43$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p27-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "Which score occurs only twice?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "18 if the missing leaf is 9; no score occurs exactly twice if it is 8.",
              "worked": "If the missing leaf is $9$, the two leaves $8$ on stem $1$ represent two scores of $18$. If the missing leaf is $8$, $18$ occurs three times and no score occurs exactly twice.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p27-q4-c",
            "type": "part",
            "label": "c",
            "prompt": "Which score has the highest frequency?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "37; if the missing leaf is 8, 18 and 37 tie for highest frequency.",
              "worked": "Stem $3$ has three leaves $7$, so $37$ occurs three times. If the missing leaf is $8$, $18$ also occurs three times. If it is $9$, only $37$ has the highest frequency.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          }
        ],
        "diagramPlacement": "right-of-prompt"
