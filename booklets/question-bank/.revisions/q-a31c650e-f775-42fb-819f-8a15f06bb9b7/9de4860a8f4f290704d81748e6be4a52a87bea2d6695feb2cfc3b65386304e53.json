  "content": {
    "id": "p29-q22-response",
    "type": "question",
    "label": "22",
    "prompt": "Leo has spent $\\$27\\,000$ on equipment to set up his painting business. The equipment depreciates at 18% p.a. Find how long it will take for the equipment to depreciate by a total of $\\$20\\,000$. Answer to the nearest year.\nHint: set up the compound depreciation equation and use trial and error to estimate n. Refine your trials around the target, then round the estimated time as requested.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "7 years; the target salvage value is $\\$7000$.",
      "worked": "A total depreciation of $\\$20\\,000$ leaves a salvage value of $\\$7000$.\n$$\\begin{align*}S&=27\\,000-20\\,000\\\\S&=7000\\\\7000&=27\\,000(0.82)^n\\end{align*}$$\nUsing trial and improvement in the depreciation formula gives $n\\approx6.80$. The time is **7 years**, to the nearest year.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
