  "content": {
    "id": "p33-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x-3}+\\dfrac{1}{3-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "Since $3-x=-(x-3)$,\n$$\\begin{align*}\\frac{1}{x-3}+\\frac{1}{3-x}&=\\frac{1}{x-3}-\\frac{1}{x-3}\\\\&=\\frac{1-1}{x-3}\\\\&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{x-3}+\\dfrac{3}{3-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{x-3}$",
          "worked": "Since $3-x=-(x-3)$,\n$$\\begin{align*}\\frac{2}{x-3}+\\frac{3}{3-x}&=\\frac{2}{x-3}-\\frac{3}{x-3}\\\\&=\\frac{2-3}{x-3}\\\\&=-\\frac{1}{x-3}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{x-3}+\\dfrac{1}{3-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "Since $3-x=-(x-3)$,\n$$\\begin{align*}\\frac{1}{x-3}+\\frac{1}{3-x}&=\\frac{1}{x-3}-\\frac{1}{x-3}\\\\&=\\frac{1-1}{x-3}\\\\&=0.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x}{x-2}+\\dfrac{4}{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-4}{x-2}$",
          "worked": "Since $2-x=-(x-2)$,\n$$\\begin{align*}\\frac{x}{x-2}+\\frac{4}{2-x}&=\\frac{x}{x-2}-\\frac{4}{x-2}\\\\&=\\frac{x-4}{x-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3}{x-1}-\\dfrac{2}{1-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{x-1}$",
          "worked": "Since $1-x=-(x-1)$,\n$$\\begin{align*}\\frac{3}{x-1}-\\frac{2}{1-x}&=\\frac{3}{x-1}+\\frac{2}{x-1}\\\\&=\\frac{3+2}{x-1}\\\\&=\\frac{5}{x-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x}{x-2}+\\dfrac{4}{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-4}{x-2}$",
          "worked": "Since $2-x=-(x-2)$,\n$$\\begin{align*}\\frac{x}{x-2}+\\frac{4}{2-x}&=\\frac{x}{x-2}-\\frac{4}{x-2}\\\\&=\\frac{x-4}{x-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{5}{2-x}+\\dfrac{3}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2}{x-2}$",
          "worked": "Since $2-x=-(x-2)$,\n$$\\begin{align*}\\frac{5}{2-x}+\\frac{3}{x-2}&=-\\frac{5}{x-2}+\\frac{3}{x-2}\\\\&=\\frac{-5+3}{x-2}\\\\&=-\\frac{2}{x-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{a}{x-b}+\\dfrac{c}{b-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-c}{x-b}$",
          "worked": "Since $b-x=-(x-b)$,\n$$\\begin{align*}\\frac{a}{x-b}+\\frac{c}{b-x}&=\\frac{a}{x-b}-\\frac{c}{x-b}\\\\&=\\frac{a-c}{x-b}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p33-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{5}{2-x}+\\dfrac{3}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2}{x-2}$",
          "worked": "Since $2-x=-(x-2)$,\n$$\\begin{align*}\\frac{5}{2-x}+\\frac{3}{x-2}&=-\\frac{5}{x-2}+\\frac{3}{x-2}\\\\&=\\frac{-5+3}{x-2}\\\\&=-\\frac{2}{x-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
