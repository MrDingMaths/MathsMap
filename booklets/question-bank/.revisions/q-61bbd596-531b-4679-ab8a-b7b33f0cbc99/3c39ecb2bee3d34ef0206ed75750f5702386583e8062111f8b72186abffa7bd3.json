    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{9-x^2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3-x$",
          "worked": "$$\\begin{aligned}\\frac{9-x^2}{x+3}&=\\frac{(3-x)(3+x)}{x+3}\\\\&=3-x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{9-x^2}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+3)$",
          "worked": "$$\\begin{aligned}\\frac{9-x^2}{x-3}&=\\frac{(3-x)(3+x)}{x-3}\\\\&=\\frac{-(x-3)(x+3)}{x-3}\\\\&=-(x+3)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-9}{3-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+3)$",
          "worked": "$$\\begin{aligned}\\frac{x^2-9}{3-x}&=\\frac{(x-3)(x+3)}{-(x-3)}\\\\&=-(x+3)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{16-x^2}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+4)$",
          "worked": "$$\\begin{aligned}\\frac{16-x^2}{x-4}&=\\frac{(4-x)(4+x)}{x-4}\\\\&=\\frac{-(x-4)(x+4)}{x-4}\\\\&=-(x+4)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{16-x^2}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x-4)$",
          "worked": "$$\\begin{aligned}\\frac{16-x^2}{x+4}&=\\frac{(4-x)(4+x)}{x+4}\\\\&=4-x\\\\&=-(x-4)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2-16}{4-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+4)$",
          "worked": "$$\\begin{aligned}\\frac{x^2-16}{4-x}&=\\frac{(x-4)(x+4)}{-(x-4)}\\\\&=-(x+4)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p16-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{25-4x^2}{2x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(2x+5)$",
          "worked": "$$\\begin{aligned}\\frac{25-4x^2}{2x-5}&=\\frac{(5-2x)(5+2x)}{2x-5}\\\\&=\\frac{-(2x-5)(2x+5)}{2x-5}\\\\&=-(2x+5)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p16-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{25-4x^2}{2x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(2x-5)$",
          "worked": "$$\\begin{aligned}\\frac{25-4x^2}{2x+5}&=\\frac{(5-2x)(5+2x)}{2x+5}\\\\&=5-2x\\\\&=-(2x-5)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
