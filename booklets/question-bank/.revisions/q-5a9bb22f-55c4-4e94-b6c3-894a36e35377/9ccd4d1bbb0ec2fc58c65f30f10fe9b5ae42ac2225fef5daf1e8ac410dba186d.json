        "answer": {
          "short": "\\$31.60/h",
          "worked": "$$\\begin{align*}\\text{Hourly rate}&=\\frac{\\text{Total pay}}{\\text{Hours}}\\\\\\text{Hourly rate}&=\\frac{\\$790}{25\\text{ hours}}\\\\\\text{Hourly rate}&=\\$31.60/\\text{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
