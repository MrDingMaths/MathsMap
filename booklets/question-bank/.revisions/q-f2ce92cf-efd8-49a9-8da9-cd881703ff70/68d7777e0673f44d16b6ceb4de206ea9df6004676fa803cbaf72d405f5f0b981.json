      {
        "id": "p8-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the population standard deviation for this set of data, rounded to the nearest dollar.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$191$",
          "worked": "Enter the seven wages in the calculator's 1-variable statistics mode and select population standard deviation $\\sigma_x$.\n$$\\begin{aligned}\\sigma_x &\\approx \\$191.0443906\\\\&\\approx \\$191\\quad\\text{(nearest dollar)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Each employee receives a $\\$20$ pay increase.\nExplain the effect that this increase will have on the standard deviation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Unchanged; the spread of the wages is unchanged.",
          "worked": "Every wage and the mean increase by $\\$20$, so each wage's distance from the mean stays the same. The standard deviation is unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
