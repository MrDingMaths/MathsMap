        "id": "p29-q19-decimal",
        "type": "part",
        "label": "",
        "prompt": "What is the relative frequency of obtaining the colour orange, as a decimal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.15$",
          "worked": "$$\\begin{align*}\\text{Frequency of orange} &= 40-(2+4+6+10+12) \\\\ \\text{Frequency of orange} &= 6 \\\\ \\text{Relative frequency} &= \\frac{\\text{Frequency of orange}}{\\text{Total trials}} \\\\ \\text{Relative frequency} &= \\frac{6}{40} \\\\ \\text{Relative frequency} &= \\frac{3}{20} \\\\ \\text{Relative frequency} &= 0.15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
