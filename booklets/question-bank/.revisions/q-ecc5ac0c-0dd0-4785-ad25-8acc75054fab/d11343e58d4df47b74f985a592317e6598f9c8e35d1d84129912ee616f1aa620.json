  "content": {
    "id": "p44-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Expand these binomial expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt{3}+1)(\\sqrt{2}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{6}+\\sqrt{2}-\\sqrt{3}-1$",
          "worked": "$$\\begin{align*}(\\sqrt{3}+1)(\\sqrt{2}-1)&=\\sqrt{6}-\\sqrt{3}+\\sqrt{2}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt{5}-2)(\\sqrt{7}+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{35}+3\\sqrt{5}-2\\sqrt{7}-6$",
          "worked": "$$\\begin{align*}(\\sqrt{5}-2)(\\sqrt{7}+3)&=\\sqrt{35}+3\\sqrt{5}-2\\sqrt{7}-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt{5}+\\sqrt{2})(\\sqrt{3}+\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{15}+\\sqrt{10}+\\sqrt{6}+2$",
          "worked": "$$\\begin{align*}(\\sqrt{5}+\\sqrt{2})(\\sqrt{3}+\\sqrt{2})&=\\sqrt{15}+\\sqrt{10}+\\sqrt{6}+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sqrt{6}-1)(\\sqrt{6}-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8-3\\sqrt{6}$",
          "worked": "$$\\begin{align*}(\\sqrt{6}-1)(\\sqrt{6}-2)&=6-2\\sqrt{6}-\\sqrt{6}+2\\\\&=8-3\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt{7}-2)(2\\sqrt{7}+5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4+\\sqrt{7}$",
          "worked": "$$\\begin{align*}(\\sqrt{7}-2)(2\\sqrt{7}+5)&=14+5\\sqrt{7}-4\\sqrt{7}-10\\\\&=4+\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p44-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(3\\sqrt{2}-1)(\\sqrt{6}-\\sqrt{3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\sqrt{3}-4\\sqrt{6}$",
          "worked": "$$\\begin{align*}(3\\sqrt{2}-1)(\\sqrt{6}-\\sqrt{3})&=3\\sqrt{12}-3\\sqrt{6}-\\sqrt{6}+\\sqrt{3}\\\\&=6\\sqrt{3}-4\\sqrt{6}+\\sqrt{3}\\\\&=7\\sqrt{3}-4\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
