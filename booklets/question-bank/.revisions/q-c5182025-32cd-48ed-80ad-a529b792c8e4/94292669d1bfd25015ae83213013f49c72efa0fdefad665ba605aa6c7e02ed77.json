  "content": {
    "id": "p6-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify the following expressions by writing them with powers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q3-left-column",
        "type": "group",
        "label": null,
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "$3\\times3\\times5\\times5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3^2\\times5^2$",
              "worked": "$$\\begin{align*}3\\times3\\times5\\times5&=(3\\times3)\\times(5\\times5)\\\\&=3^2\\times5^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "$8\\times8\\times5\\times5\\times5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8^2\\times5^3$",
              "worked": "$$\\begin{align*}8\\times8\\times5\\times5\\times5&=(8\\times8)\\times(5\\times5\\times5)\\\\&=8^2\\times5^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-q3-c",
            "type": "part",
            "label": "c",
            "prompt": "$8\\times8\\times8\\times11\\times11$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$8^3\\times11^2$",
              "worked": "There are three factors of $8$ and two factors of $11$.\n\n$$\\begin{align*}&\\mathrel{\\phantom{=}}8\\times8\\times8\\times11\\times11\\\\&=8^3\\times11^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-d",
            "type": "part",
            "label": "d",
            "prompt": "$7\\times7\\times2\\times2\\times7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^2\\times7^3$",
              "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}7\\times7\\times2\\times2\\times7\\\\&=(2\\times2)\\times(7\\times7\\times7)\\\\&=2^2\\times7^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-e",
            "type": "part",
            "label": "e",
            "prompt": "$12\\times9\\times9\\times12$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9^2\\times12^2$",
              "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}12\\times9\\times9\\times12\\\\&=(9\\times9)\\times(12\\times12)\\\\&=9^2\\times12^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-f",
            "type": "part",
            "label": "f",
            "prompt": "$6\\times3\\times6\\times3\\times6\\times3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3^3\\times6^3$",
              "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}6\\times3\\times6\\times3\\times6\\times3\\\\&=(3\\times3\\times3)\\times(6\\times6\\times6)\\\\&=3^3\\times6^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-g",
            "type": "part",
            "label": "g",
            "prompt": "$13\\times7\\times13\\times7\\times7\\times7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7^4\\times13^2$",
              "worked": "There are four factors of $7$ and two factors of $13$.\n\n$$\\begin{align*}&\\mathrel{\\phantom{=}}13\\times7\\times13\\times7\\times7\\times7\\\\&=7^4\\times13^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-h",
            "type": "part",
            "label": "h",
            "prompt": "$4\\times13\\times4\\times4\\times7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4^3\\times7\\times13$",
              "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}4\\times13\\times4\\times4\\times7\\\\&=(4\\times4\\times4)\\times7\\times13\\\\&=4^3\\times7\\times13\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      },
      {
        "id": "p6-q3-right-column",
        "type": "group",
        "label": null,
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p6-q3-i",
            "type": "part",
            "label": "i",
            "prompt": "$10\\times9\\times10\\times9\\times9\\times7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$7\\times9^3\\times10^2$",
              "worked": "There is one factor of $7$, three factors of $9$ and two factors of $10$.\n\n$$\\begin{align*}&\\mathrel{\\phantom{=}}10\\times9\\times10\\times9\\times9\\times7\\\\&=7\\times9^3\\times10^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-j",
            "type": "part",
            "label": "j",
            "prompt": "$(-2)\\times(-2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(-2)^2$",
              "worked": "$$(-2)\\times(-2)=(-2)^2$$\n\nThe base is $-2$, so it stays inside parentheses.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-q3-k",
            "type": "part",
            "label": "k",
            "prompt": "$(-1)\\times(-1)\\times(-1)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(-1)^3$",
              "worked": "$$(-1)\\times(-1)\\times(-1)=(-1)^3$$\n\nThe base is $-1$, so it stays inside parentheses.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-q3-l",
            "type": "part",
            "label": "l",
            "prompt": "$\\dfrac{3}{7}\\times\\dfrac{3}{7}\\times\\dfrac{3}{7}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\left(\\frac{3}{7}\\right)^3$",
              "worked": "$$\\frac{3}{7}\\times\\frac{3}{7}\\times\\frac{3}{7}=\\left(\\frac{3}{7}\\right)^3$$\n\nThe whole fraction is repeated three times.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p6-q3-m",
            "type": "part",
            "label": "m",
            "prompt": "$\\dfrac{7}{4}\\times\\dfrac{7}{4}\\times\\dfrac{7}{4}\\times\\dfrac{7}{4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\left(\\frac{7}{4}\\right)^4$",
              "worked": "The whole fraction is repeated four times.\n\n$$\\begin{align*}&\\mathrel{\\phantom{=}}\\frac{7}{4}\\times\\frac{7}{4}\\times\\frac{7}{4}\\times\\frac{7}{4}\\\\&=\\left(\\frac{7}{4}\\right)^4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p6-q3-n",
            "type": "part",
            "label": "n",
            "prompt": "$2^5\\times2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2^6$",
              "worked": "$$\\begin{align*}2^5\\times2&=(2\\times2\\times2\\times2\\times2)\\times2\\\\&=2^6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p6-q3-o",
            "type": "part",
            "label": "o",
            "prompt": "$x\\times x\\times x\\times x\\times x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^5$",
              "worked": "$$x\\times x\\times x\\times x\\times x=x^5$$\n\nThere are five factors of $x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p6-q3-p",
            "type": "part",
            "label": "p",
            "prompt": "$a\\times b\\times a\\times b\\times a\\times c$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a^3b^2c$",
              "worked": "$$\\begin{align*}&\\mathrel{\\phantom{=}}a\\times b\\times a\\times b\\times a\\times c\\\\&=(a\\times a\\times a)\\times(b\\times b)\\times c\\\\&=a^3b^2c\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      }
    ]
  },
