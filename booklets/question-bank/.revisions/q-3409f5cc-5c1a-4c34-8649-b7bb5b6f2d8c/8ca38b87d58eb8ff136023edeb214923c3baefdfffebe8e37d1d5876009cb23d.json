    "children": [
      {
        "id": "p39-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos(-60^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$; $\\cos(-60^{\\circ})=\\cos60^{\\circ}$.",
          "worked": "$$\\begin{align*}\\cos(-60^{\\circ})&=\\cos300^{\\circ}\\\\\\cos(-60^{\\circ})&=\\cos60^{\\circ}\\\\\\cos(-60^{\\circ})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin(-120^{\\circ})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt{3}}{2}$; $\\sin(-120^{\\circ})=-\\sin60^{\\circ}$.",
          "worked": "$$\\begin{align*}\\sin(-120^{\\circ})&=\\sin240^{\\circ}\\\\\\sin(-120^{\\circ})&=-\\sin60^{\\circ}\\\\\\sin(-120^{\\circ})&=-\\frac{\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(-120^{\\circ})$",
