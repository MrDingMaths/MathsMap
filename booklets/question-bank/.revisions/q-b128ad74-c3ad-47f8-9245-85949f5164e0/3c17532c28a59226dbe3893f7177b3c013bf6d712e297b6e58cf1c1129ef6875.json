  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x+2$.\nFind $a$ if $f(a)=14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4$",
          "worked": "$$\\begin{align*}14&=3a+2\\\\12&=3a\\\\a&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3x+2$.\nFind $a$ if $f(a)=-4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2$",
          "worked": "$$\\begin{align*}-4&=3a+2\\\\-6&=3a\\\\a&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^2+1$.\nFind all $a$ if $f(a)=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm3$",
          "worked": "$$\\begin{align*}10&=a^2+1\\\\a^2&=9\\\\a&=\\pm3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^2+1$.\nFind all $a$ if $f(a)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=0$",
          "worked": "$$\\begin{align*}1&=a^2+1\\\\a^2&=0\\\\a&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=x^2+1$.\nFind all real $a$ if $f(a)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution.",
          "worked": "$$\\begin{align*}0&=a^2+1\\\\a^2&=-1\\end{align*}$$\nNo real solution, since the square of a real number is non-negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=(x-2)^2$.\nFind all $a$ if $f(a)=9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5$ or $a=-1$",
          "worked": "$$\\begin{align*}(a-2)^2&=9\\\\a-2&=\\pm3\\\\a&=5\\text{ or }-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$f(x)=x^2+x+1$.\nFind all $a$ if $f(a)=7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-3$ or $a=2$",
          "worked": "$$\\begin{align*}7&=a^2+a+1\\\\0&=a^2+a-6\\\\0&=(a+3)(a-2)\\\\a&=-3\\text{ or }2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$f(x)=2x^2-8$.\nFind all $a$ if $f(a)=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm3$",
          "worked": "$$\\begin{align*}10&=2a^2-8\\\\18&=2a^2\\\\a^2&=9\\\\a&=\\pm3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
