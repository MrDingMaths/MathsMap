    "answer": {
      "short": "$8\\sqrt{2}$",
      "worked": "$$\\begin{align*}\\sqrt{50}+3\\sqrt{2}&=\\sqrt{25\\times2}+3\\sqrt{2}\\\\\\sqrt{50}+3\\sqrt{2}&=5\\sqrt{2}+3\\sqrt{2}\\\\\\sqrt{50}+3\\sqrt{2}&=8\\sqrt{2}\\end{align*}$$",
