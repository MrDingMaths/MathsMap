        "answer": {
          "short": "$\\displaystyle\\frac{x-1}{x+1}=\\frac{(x+1)-2}{x+1}=1-\\frac{2}{x+1}$, for $x\\ne-1$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p24-q10-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\frac{x-1}{x+1}&=\\frac{(x+1)-2}{x+1}\\\\[3pt]\\frac{x-1}{x+1}&=1-\\frac{2}{x+1}\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p24-q10-a-domain",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Valid for ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x\\ne-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
