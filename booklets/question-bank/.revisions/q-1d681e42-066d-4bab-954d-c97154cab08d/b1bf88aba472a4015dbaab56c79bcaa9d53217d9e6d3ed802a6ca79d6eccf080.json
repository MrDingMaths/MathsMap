    "type": "question",
    "label": "68",
    "prompt": "Let $x=1-\\sqrt2$. Show that $x^2+\\dfrac1{x^2}$ is rational.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
