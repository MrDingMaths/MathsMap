  "content": {
    "id": "p23-q79-root",
    "type": "question",
    "label": "79",
    "prompt": "Let $\\alpha=\\dfrac{1+\\sqrt5}{2}$. Show the following.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q79-grid",
        "type": "group",
        "label": null,
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q79-a",
            "type": "part",
            "label": "a",
            "prompt": "$\\alpha^2=\\alpha+1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\alpha^2=\\dfrac{3+\\sqrt5}{2}=\\alpha+1$.",
              "worked": "$$\\begin{align*}\\alpha^2&=\\left(\\frac{1+\\sqrt5}{2}\\right)^2\\\\\\alpha^2&=\\frac{1+2\\sqrt5+5}{4}\\\\\\alpha^2&=\\frac{3+\\sqrt5}{2}.\\end{align*}$$\nAlso,\n$$\\begin{align*}\\alpha+1&=\\frac{1+\\sqrt5}{2}+1\\\\\\alpha+1&=\\frac{3+\\sqrt5}{2}.\\end{align*}$$\nThus $\\alpha^2=\\alpha+1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q79-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\alpha^3=2\\alpha+1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\alpha^3=2\\alpha+1$.\n\nMultiply (a) by $\\alpha$ and substitute $\\alpha^2=\\alpha+1$.",
              "worked": "$$\\begin{align*}\\alpha^3&=\\alpha(\\alpha+1)\\\\\\alpha^3&=\\alpha^2+\\alpha\\\\\\alpha^3&=(\\alpha+1)+\\alpha\\\\\\alpha^3&=2\\alpha+1.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q79-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\alpha^4=3\\alpha+2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\alpha^4=3\\alpha+2$.\n\nMultiply (b) by $\\alpha$ and substitute $\\alpha^2=\\alpha+1$.",
              "worked": "$$\\begin{align*}\\alpha^4&=\\alpha(2\\alpha+1)\\\\\\alpha^4&=2\\alpha^2+\\alpha\\\\\\alpha^4&=2(\\alpha+1)+\\alpha\\\\\\alpha^4&=3\\alpha+2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p23-q79-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\alpha^5=5\\alpha+3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\alpha^5=5\\alpha+3$.\n\nMultiply (c) by $\\alpha$ and substitute $\\alpha^2=\\alpha+1$.",
              "worked": "$$\\begin{align*}\\alpha^5&=\\alpha(3\\alpha+2)\\\\\\alpha^5&=3\\alpha^2+2\\alpha\\\\\\alpha^5&=3(\\alpha+1)+2\\alpha\\\\\\alpha^5&=5\\alpha+3.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p23-q79-e",
        "type": "part",
        "label": "e",
        "prompt": "What kind of sequence do the coefficients of $\\alpha$ and the constant term in each successive expression form?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Fibonacci sequences, offset by one term.",
          "worked": "The coefficients of $\\alpha$ are $1,2,3,5,\\ldots$ and the constants are $1,1,2,3,\\ldots$. In each sequence, each new term is the sum of the previous two. These are Fibonacci sequences, offset by one term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
