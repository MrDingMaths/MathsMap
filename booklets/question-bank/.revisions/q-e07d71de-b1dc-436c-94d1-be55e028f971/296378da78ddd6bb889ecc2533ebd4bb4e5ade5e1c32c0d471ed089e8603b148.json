      {
        "id": "p24-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the relative frequency of getting a 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{10}=\\frac{1}{5}$",
          "worked": "$$\\begin{align*}rf&=\\frac{\\text{Frequency of 3}}{\\text{Total trials}}\\\\rf&=\\frac{2}{10}\\\\rf&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p24-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the relative frequency of getting an odd number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{10}=\\frac{2}{5}$",
          "worked": "The odd outcomes are $5,1,3,3$.\n$$\\begin{align*}rf&=\\frac{\\text{Frequency of odd}}{\\text{Total trials}}\\\\rf&=\\frac{4}{10}\\\\rf&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
