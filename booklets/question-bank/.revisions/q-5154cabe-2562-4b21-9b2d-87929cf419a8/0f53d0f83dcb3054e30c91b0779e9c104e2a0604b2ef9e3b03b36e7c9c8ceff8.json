            "prompt": "$P(x)+Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4x^2+2x-1$",
              "worked": "$\\begin{align*}P(x)+Q(x)&=(3x^2-5x+2)+(x^2+7x-3)\\\\&=4x^2+2x-1\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p11-q1-a-difference",
            "type": "part",
            "label": "ii",
            "prompt": "$P(x)-Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x^2-12x+5$",
              "worked": "$\\begin{align*}P(x)-Q(x)&=(3x^2-5x+2)-(x^2+7x-3)\\\\&=3x^2-5x+2-x^2-7x+3\\\\&=2x^2-12x+5\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
