            "children": [],
            "answer": {
              "short": "$3x^3+x^2-2x+9$",
              "worked": "$\\begin{align*}P(x)+Q(x)&=(x^3-2x^2+3x+7)\\\\&\\quad +(2x^3+3x^2-5x+2)\\\\&=3x^3+x^2-2x+9\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p11-q1-b-difference",
            "type": "part",
            "label": "ii",
            "prompt": "$P(x)-Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-x^3-5x^2+8x+5$",
              "worked": "$\\begin{align*}P(x)-Q(x)&=(x^3-2x^2+3x+7)\\\\&\\quad -(2x^3+3x^2-5x+2)\\\\&=x^3-2x^2+3x+7\\\\&\\quad -2x^3-3x^2+5x-2\\\\&=-x^3-5x^2+8x+5\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
