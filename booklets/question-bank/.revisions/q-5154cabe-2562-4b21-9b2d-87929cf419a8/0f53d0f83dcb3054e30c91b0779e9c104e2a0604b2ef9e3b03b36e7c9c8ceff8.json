        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q1-c-sum",
            "type": "part",
            "label": "i",
            "prompt": "$P(x)+Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^4+13x^3-x^2-4x-6$",
              "worked": "$\\begin{align*}P(x)+Q(x)&=(x^4+9x^3+7x^2-4x+9)\\\\&\\quad +(4x^3-8x^2-15)\\\\&=x^4+13x^3-x^2-4x-6\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p11-q1-c-difference",
            "type": "part",
            "label": "ii",
            "prompt": "$P(x)-Q(x)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^4+5x^3+15x^2-4x+24$",
              "worked": "$\\begin{align*}P(x)-Q(x)&=(x^4+9x^3+7x^2-4x+9)\\\\&\\quad -(4x^3-8x^2-15)\\\\&=x^4+9x^3+7x^2-4x+9\\\\&\\quad -4x^3+8x^2+15\\\\&=x^4+5x^3+15x^2-4x+24\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "How is the degree of $P(x)\\pm Q(x)$ related to the degree of $P(x)$ and $Q(x)$ for these polynomials?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For these polynomials, the degree of $P(x)\\pm Q(x)$ equals the maximum of the degrees of $P(x)$ and $Q(x)$.",
          "worked": "In parts a, b and c, both the sum and difference have degrees $2$, $3$ and $4$, respectively. Each is the maximum of the degrees of the corresponding $P(x)$ and $Q(x)$ because the leading terms do not cancel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "Will your answer to part d be true for all polynomials $P(x)$ and $Q(x)$?\n\n(Consider what happens if the leading terms of $P(x)$ and $Q(x)$ are opposites.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. For addition, opposite leading terms cancel. For subtraction, equal leading terms cancel. In either case, the degree can decrease.",
          "worked": "No.\n\nFor $P(x)+Q(x)$, if the polynomials have the same degree and their leading coefficients sum to zero, the leading terms cancel and the degree decreases.\n\nFor $P(x)-Q(x)$, if the polynomials have the same degree and equal leading coefficients, the leading terms cancel and the degree decreases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
