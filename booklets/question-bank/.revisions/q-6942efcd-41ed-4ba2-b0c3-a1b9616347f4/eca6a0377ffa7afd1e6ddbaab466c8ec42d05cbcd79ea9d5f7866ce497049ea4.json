    "children": [
      {
        "id": "p71-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that $\\angle CQY=180^\\circ-a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle CQX=a$ (corresponding angles on parallel lines), so $\\angle CQY=180^\\circ-a$ (angles on a straight line).",
          "worked": "$\\angle CQX=a$ (corresponding angles on parallel lines).\n\nAngles on a straight line sum to $180^\\circ$.\n$$\\begin{align*}\\angle CQX+\\angle CQY&=180^\\circ\\\\a+\\angle CQY&=180^\\circ\\\\\\angle CQY&=180^\\circ-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p71-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that $\\angle DQY=a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle CQY+\\angle DQY=180^\\circ$ (angles on a straight line). Using part a, $180^\\circ-a+\\angle DQY=180^\\circ$, so $\\angle DQY=a$.",
          "worked": "Angles on a straight line sum to $180^\\circ$. Substitute the result from part a.\n$$\\begin{align*}\\angle CQY+\\angle DQY&=180^\\circ\\\\180^\\circ-a+\\angle DQY&=180^\\circ\\\\\\angle DQY&=a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ],
