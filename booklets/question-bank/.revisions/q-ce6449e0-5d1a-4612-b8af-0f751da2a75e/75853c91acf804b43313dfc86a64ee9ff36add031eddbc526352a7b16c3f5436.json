          "inlines": [
            {
              "type": "text",
              "text": "If all four bells ring at the same time, then how long is it before they next ring at the same time?",
              "marks": []
            }
          ]
        },
        {
          "id": "p87-q60-hint",
          "type": "paragraph",
          "fontSize": null,
