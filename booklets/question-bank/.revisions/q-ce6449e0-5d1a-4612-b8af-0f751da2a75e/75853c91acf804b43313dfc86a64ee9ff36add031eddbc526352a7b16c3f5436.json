    "answer": {
      "short": "$840$ seconds. The LCM of the numerators is $840$ and the HCF of the denominators is $1$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p87-q60-integer-calculations",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\operatorname{LCM}(5,6,7,8)&=2^3\\times3\\times5\\times7=840\\\\\\operatorname{HCF}(4,5,6,7)&=1\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p87-q60-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}t&=\\frac{\\operatorname{LCM}(5,6,7,8)}{\\operatorname{HCF}(4,5,6,7)}\\\\t&=\\frac{840}{1}\\\\t&=840\\text{ seconds}\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
