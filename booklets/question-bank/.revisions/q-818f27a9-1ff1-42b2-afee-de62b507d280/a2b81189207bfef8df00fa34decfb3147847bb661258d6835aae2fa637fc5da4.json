            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\mathrm{LHS}&=\\frac{\\sin\\theta\\sin\\theta}{-\\cos\\theta\\cos\\theta}\\\\&=\\frac{\\sin^2\\theta}{-\\cos^2\\theta}\\\\&=-\\tan^2\\theta=\\mathrm{RHS}.\\end{align*}",
