  "content": {
    "id": "p51-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Let $f(x)=\\dfrac{x+1}{x-2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "State the domain and range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $(-\\infty,2)\\cup(2,\\infty)$.\n\nRange: $(-\\infty,1)\\cup(1,\\infty)$.",
          "worked": "$f(x)=1+\\dfrac{3}{x-2}$. The denominator excludes $x=2$, and $\\dfrac{3}{x-2}$ takes every nonzero real value, so $f(x)\\ne1$.\n\nDomain: $(-\\infty,2)\\cup(2,\\infty)$.\n\nRange: $(-\\infty,1)\\cup(1,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p51-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "State the domain and range of $f^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $(-\\infty,1)\\cup(1,\\infty)$.\n\nRange: $(-\\infty,2)\\cup(2,\\infty)$.",
          "worked": "The domain and range interchange for an inverse.\n\nDomain of $f^{-1}$: $(-\\infty,1)\\cup(1,\\infty)$.\n\nRange of $f^{-1}$: $(-\\infty,2)\\cup(2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $f^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=\\dfrac{2x+1}{x-1}$, $x\\ne1$.",
          "worked": "Let $y=\\dfrac{x+1}{x-2}$. Swap $x$ and $y$:\n$$\\begin{align*}x&=\\frac{y+1}{y-2}\\\\x(y-2)&=y+1\\\\xy-2x&=y+1\\\\xy-y&=2x+1\\\\y(x-1)&=2x+1\\\\y&=\\frac{2x+1}{x-1}.\\end{align*}$$\nTherefore $f^{-1}(x)=\\dfrac{2x+1}{x-1}$, with $x\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      }
    ]
  },
