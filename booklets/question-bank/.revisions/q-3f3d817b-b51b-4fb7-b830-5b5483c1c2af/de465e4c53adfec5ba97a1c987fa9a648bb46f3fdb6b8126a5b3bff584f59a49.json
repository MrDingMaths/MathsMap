  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If $P(x)=5x+2$ and $Q(x)=x^2-3x+1$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)+Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x+3$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=(5x+2)+(x^2-3x+1)\\\\P(x)+Q(x)&=x^2+2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$Q(x)+P(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2x+3$",
          "worked": "$$\\begin{align*}Q(x)+P(x)&=(x^2-3x+1)+(5x+2)\\\\Q(x)+P(x)&=x^2+2x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)-Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x^2+8x+1$",
          "worked": "$$\\begin{align*}P(x)-Q(x)&=(5x+2)-(x^2-3x+1)\\\\P(x)-Q(x)&=5x+2-x^2+3x-1\\\\P(x)-Q(x)&=-x^2+8x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$Q(x)-P(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-8x-1$",
          "worked": "$$\\begin{align*}Q(x)-P(x)&=(x^2-3x+1)-(5x+2)\\\\Q(x)-P(x)&=x^2-3x+1-5x-2\\\\Q(x)-P(x)&=x^2-8x-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(x)\\times Q(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x^3-13x^2-x+2$",
          "worked": "$$\\begin{align*}P(x)Q(x)&=(5x+2)(x^2-3x+1)\\\\P(x)Q(x)&=5x(x^2-3x+1)\\\\&\\quad+2(x^2-3x+1)\\\\P(x)Q(x)&=5x^3-15x^2+5x\\\\&\\quad+2x^2-6x+2\\\\P(x)Q(x)&=5x^3-13x^2-x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p12-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$Q(x)\\times P(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x^3-13x^2-x+2$",
          "worked": "$$\\begin{align*}Q(x)P(x)&=(x^2-3x+1)(5x+2)\\\\Q(x)P(x)&=x^2(5x+2)-3x(5x+2)\\\\&\\quad+(5x+2)\\\\Q(x)P(x)&=5x^3+2x^2-15x^2\\\\&\\quad-6x+5x+2\\\\Q(x)P(x)&=5x^3-13x^2-x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
