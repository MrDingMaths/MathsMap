        "answer": {
          "short": "$7^5$",
          "worked": "$$\\begin{align*}\\frac{1}{7^{-3}\\times7^{-2}}&=\\frac{1}{7^{-5}}\\\\&=7^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q6-root-bank-p14-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $n$ so that $\\dfrac{1}{7^{-3}\\times7^n}=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}\\frac{1}{7^{-3}\\times7^n}&=7^{3-n}\\\\3-n&=0\\\\n&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q6-root-bank-p14-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $n$ so that $\\dfrac{1}{7^{-3}\\times7^n}=7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$",
          "worked": "$$\\begin{align*}\\frac{1}{7^{-3}\\times7^n}&=7^{3-n}\\\\3-n&=1\\\\n&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
