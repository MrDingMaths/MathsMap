        "children": [
          {
            "id": "p37-q9-a",
            "type": "part",
            "label": "a",
            "prompt": "What ticket price should be charged to maximise the income from a movie session?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$14$",
              "worked": "The graph has its maximum at a ticket-price increase of $\\$6$.\n\n$$\\begin{aligned}\\text{Ticket price}&=\\$8+\\$6\\\\&=\\$14\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p37-q9-b",
            "type": "part",
            "label": "b",
            "prompt": "What is the number of tickets sold when the income is maximised?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "140 tickets",
              "worked": "The maximum income read from the graph is $\\$1960$.\n\n$$\\begin{aligned}\\text{Tickets sold}&=1960\\div14\\\\&=140\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p37-q9-c",
            "type": "part",
            "label": "c",
            "prompt": "The cost to the theatre owners of running each session is $\\$500$ plus $\\$2$ per ticket sold.\n\nCalculate the profit earned by the theatre owners when the income earned from a session is maximised.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1180$",
              "worked": "$$\\begin{aligned}\\text{Cost}&=500+2\\times140\\\\&=\\$780\\\\\\text{Profit}&=1960-780\\\\&=\\$1180\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ],
        "diagramPlacement": "beside-prompt"
      }
    ]
  },
