                  "type": "math",
                  "latex": "\\dfrac{1}{1+\\dfrac{1}{x}}=\\dfrac{x}{x+1}.",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{x+1}$, where $x\\ne0,-1$.\n\nMultiply numerator and denominator by $x$.",
          "worked": "$$\\begin{align*}\\dfrac{1}{1+\\dfrac1x}&=\\dfrac{1\\times x}{(1+\\dfrac1x)x}\\\\\\dfrac{1}{1+\\dfrac1x}&=\\dfrac{x}{x+1}.\\end{align*}$$\nThe original expression requires $x\\ne0,-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p17-q62-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p17-q62-b-text-0-0",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Simplify",
                  "marks": []
                }
              ]
            },
            {
              "id": "p17-q62-b-display-1",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\dfrac{1}{1+\\dfrac{1}{1+\\dfrac1x}}.",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{2x+1}$, where $x\\ne0,-1,-\\dfrac12$.",
          "worked": "Use part (a), then multiply numerator and denominator by $x+1$.\n$$\\begin{align*}\\dfrac{1}{1+\\dfrac{1}{1+\\dfrac1x}}&=\\dfrac{1}{1+\\dfrac{x}{x+1}}\\\\\\dfrac{1}{1+\\dfrac{1}{1+\\dfrac1x}}&=\\dfrac{x+1}{(x+1)+x}\\\\\\dfrac{1}{1+\\dfrac{1}{1+\\dfrac1x}}&=\\dfrac{x+1}{2x+1}.\\end{align*}$$\nRetain all original restrictions: $x\\ne0,-1,-\\dfrac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q62-c",
        "type": "part",
        "label": "c",
        "prompt": {
