        "children": [
          {
            "id": "p42-q27-a",
            "type": "part",
            "label": "a",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p42-q27-a-claim",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Justine claims that each of her friends is equally likely to win first prize.",
                      "marks": []
                    }
                  ]
                },
                {
                  "id": "p42-q27-a-reason",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Give a reason why Justine’s statement is NOT correct.",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Each person has a different number of tickets.",
              "worked": "Assuming each ticket is equally likely to win, each friend’s probability is their number of tickets divided by 100. Their ticket counts differ, so their probabilities of winning differ.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q27-b",
            "type": "part",
            "label": "b",
            "prompt": "What is the probability that first prize is NOT won by Khalid or Herman?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{69}{100}$",
              "worked": "Assuming each ticket is equally likely to win:\n$$\\begin{align*}P(\\text{neither Khalid nor Herman})&=1-P(\\text{Khalid or Herman})\\\\P(\\text{neither Khalid nor Herman})&=1-\\frac{5+26}{100}\\\\P(\\text{neither Khalid nor Herman})&=1-\\frac{31}{100}\\\\P(\\text{neither Khalid nor Herman})&=\\frac{69}{100}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
