    "children": [
      {
        "id": "p38-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "If 16 people participated in survey 1, how many chose a dog?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$ people",
          "worked": "The dog sector is three-eighths of the circle.\n$$\\begin{align*}\\text{People per eighth}&=16\\div8\\\\\\text{People per eighth}&=2\\\\\\text{People choosing a dog}&=3\\times2\\\\\\text{People choosing a dog}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "If 30 people participated in survey 2, how many chose a bird?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$ people",
          "worked": "The bird sector is one-third of the circle.\n$$\\begin{align*}\\text{People choosing a bird}&=30\\div3\\\\\\text{People choosing a bird}&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p38-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain why it’s not possible that 20 people participated in survey 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "One-eighth chose birds, but $20$ is not divisible by $8$.",
          "worked": "One-eighth of the participants chose birds.\n$$\\begin{align*}\\text{People choosing birds}&=20\\div8\\\\\\text{People choosing birds}&=2.5\\end{align*}$$\nA number of people must be a whole number, so the total cannot be $20$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p38-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why it’s not possible that 40 people participated in survey 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40$ is not divisible by $3$.",
          "worked": "Each pet was chosen by one-third of the participants.\n$$\\begin{align*}\\text{People per category}&=40\\div3\\\\\\text{People per category}&=13\\frac{1}{3}\\end{align*}$$\nA number of people must be a whole number, so the total cannot be $40$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
