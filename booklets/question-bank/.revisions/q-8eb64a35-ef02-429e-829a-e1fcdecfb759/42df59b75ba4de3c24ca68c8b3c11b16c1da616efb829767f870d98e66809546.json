        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 38 p38-q15-diagram-2\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=1pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) circle[radius=25];\n\\draw[black,line width=0.8pt] (0,0)--(90:25) (0,0)--(-30:25) (0,0)--(-150:25);\n\\node at (30:14) {dog};\n\\node at (-90:15) {bird};\n\\node at (150:14) {cat};\n\\node[anchor=south] at (0,27) {Survey 2};\n\\end{tikzpicture}",
