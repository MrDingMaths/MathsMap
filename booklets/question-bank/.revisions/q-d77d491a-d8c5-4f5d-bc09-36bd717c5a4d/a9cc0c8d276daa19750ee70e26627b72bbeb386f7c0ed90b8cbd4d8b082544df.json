  "content": {
    "id": "p45-q15-response",
    "type": "question",
    "label": "15",
    "prompt": "Find normal weekly pay if total holiday pay, including 4 weeks leave loading at 17.5%, is \\$6657. Round to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1416.38 per week.",
      "worked": "Total holiday pay is $117.5\\%$ of four weeks' normal pay.\n$$\\begin{align*}\\text{4 weeks' normal pay} &= 6657 \\div 1.175 \\\\ \\text{Normal weekly pay} &= (6657 \\div 1.175) \\div 4 \\\\ &\\approx \\$1416.38\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
