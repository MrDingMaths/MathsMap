    "difficulty": "Development",
    "difficultyReason": "Distinguish even and odd roots of negative numbers and evaluate an exact fractional cube root."
  },
  "content": {
    "id": "p75-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Determine, if possible, the values of:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p75-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt[3]{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Since $(-1)^3=-1$,\n$$\\sqrt[3]{-1}=-1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p75-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{-25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not real.",
          "worked": "The square of a real number is non-negative, so no real number has square $-25$. Hence $\\sqrt{-25}$ is not real.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p75-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[3]{-27}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$",
          "worked": "Since $(-3)^3=-27$,\n$$\\sqrt[3]{-27}=-3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p75-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[3]{-8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "Since $(-2)^3=-8$,\n$$\\sqrt[3]{-8}=-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p75-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt[4]{-81}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not real.",
          "worked": "The fourth power of a real number is non-negative, so no real number has fourth power $-81$. Hence $\\sqrt[4]{-81}$ is not real.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p75-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt[5]{-100\\,000}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "Since $(-10)^5=-100\\,000$,\n$$\\sqrt[5]{-100\\,000}=-10.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p75-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sqrt[5]{-32}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "Since $(-2)^5=-32$,\n$$\\sqrt[5]{-32}=-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p75-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\sqrt[3]{-\\frac{1}{8}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{2}$",
          "worked": "Since $\\left(-\\frac{1}{2}\\right)^3=-\\frac{1}{8}$,\n$$\\sqrt[3]{-\\frac{1}{8}}=-\\frac{1}{2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
