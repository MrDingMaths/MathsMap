  "content": {
    "id": "p13-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Rearrange each of these formulae to make $x$ the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\frac{x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5y$",
          "worked": "$$\\begin{align*}5y&=x\\\\x&=5y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{x}{5}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5(y-1)$",
          "worked": "$$\\begin{align*}y-1&=\\frac{x}{5}\\\\5(y-1)&=x\\\\x&=5(y-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x+1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5y-1$",
          "worked": "$$\\begin{align*}5y&=x+1\\\\5y-1&=x\\\\x&=5y-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x+\\frac{1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=y-\\frac{1}{5}$",
          "worked": "$$\\begin{align*}y-\\frac{1}{5}&=x\\\\x&=y-\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{3x-1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5y+1}{3}$",
          "worked": "$$\\begin{align*}5y&=3x-1\\\\5y+1&=3x\\\\\\frac{5y+1}{3}&=x\\\\x&=\\frac{5y+1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p13-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{3x^2-1}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt{\\frac{5y+1}{3}}$",
          "worked": "$$\\begin{align*}5y&=3x^2-1\\\\5y+1&=3x^2\\\\\\frac{5y+1}{3}&=x^2\\\\x&=\\pm\\sqrt{\\frac{5y+1}{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p13-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\frac{1-3x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{5y-1}{3}$",
          "worked": "$$\\begin{align*}5y&=1-3x\\\\5y-1&=-3x\\\\-\\frac{5y-1}{3}&=x\\\\x&=-\\frac{5y-1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p13-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\frac{1-3x^2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm\\sqrt{-\\frac{5y-1}{3}}$",
          "worked": "$$\\begin{align*}5y&=1-3x^2\\\\5y-1&=-3x^2\\\\-\\frac{5y-1}{3}&=x^2\\\\x&=\\pm\\sqrt{-\\frac{5y-1}{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\frac{(3x-1)^2}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1\\pm\\sqrt{5y}}{3}$",
          "worked": "$$\\begin{align*}5y&=(3x-1)^2\\\\\\pm\\sqrt{5y}&=3x-1\\\\1\\pm\\sqrt{5y}&=3x\\\\x&=\\frac{1\\pm\\sqrt{5y}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$y=3+\\frac{2(x+1)}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5(y-3)}{2}-1$",
          "worked": "$$\\begin{align*}y-3&=\\frac{2(x+1)}{5}\\\\5(y-3)&=2(x+1)\\\\\\frac{5(y-3)}{2}&=x+1\\\\x&=\\frac{5(y-3)}{2}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
