  "content": {
    "id": "p52-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The radii of a sector subtend an angle of $40^\\circ$ at the centre. Its perimeter is 10 cm.\n\nWhat is the radius? Answer to 2 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3.71\\text{ cm}$",
      "worked": "$$\\begin{align*}P &= l + 2r\\\\10 &= \\frac{40}{360}\\times 2\\pi r + 2r\\\\10 &= \\frac{2\\pi r}{9} + 2r\\\\10 &= r\\left(\\frac{2\\pi}{9}+2\\right)\\\\r &= \\frac{10}{\\frac{2\\pi}{9}+2}\\approx 3.71\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
