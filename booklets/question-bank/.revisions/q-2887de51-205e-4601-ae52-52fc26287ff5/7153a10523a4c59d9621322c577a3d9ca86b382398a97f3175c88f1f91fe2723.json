    "children": [
      {
        "id": "index-t7-q27-a",
        "type": "part",
        "label": "a",
        "prompt": "Rhys picks two cards and then divides the expressions. He gets the answer $y^{3}$. Which two cards does he pick? Find two different answers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10y^{4} \\div 10y,\\ \\ 12y^{3} \\div 12$",
          "worked": "$$\\begin{align*}10y^4\\div10y&=y^{4-1}=y^3 \\\\ 12y^3\\div12&=y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t7-q27-b",
        "type": "part",
        "label": "b",
        "prompt": "Huda picks two cards and then divides the expressions. She gets the answer $\\frac{3}{y^{2}}$. Which two cards does she pick?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18y^{6} \\div 6y^{8}$",
          "worked": "$$\\begin{align*}18y^6\\div6y^8&=\\frac{18y^6}{6y^8} \\\\ &=\\frac3{y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
