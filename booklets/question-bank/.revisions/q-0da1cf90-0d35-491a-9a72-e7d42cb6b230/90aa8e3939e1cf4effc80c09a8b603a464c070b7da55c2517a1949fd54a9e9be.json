    "type": "question",
    "label": "4",
    "prompt": "There are 11 cards, 6 of which are red. What is the probability of not selecting a red card?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{11}$",
      "worked": "Assuming each card is equally likely to be selected:\n$$\\begin{align*}P(\\text{not red})&=1-\\frac{6}{11}\\\\P(\\text{not red})&=\\frac{5}{11}\\end{align*}$$",
      "solutionDiagrams": []
