    "reasoningScore": 35,
    "difficulty": "Development",
    "difficultyReason": "Identify circle centres and exact radii, including completing the square and fractional radii."
  },
  "content": {
    "id": "p68-q45-question",
    "type": "question",
    "label": "45",
    "prompt": "Find a parametrisation for the following circles.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q45-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+y^2=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2\\cos t,2\\sin t)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $(0,0)$ and the radius is $\\sqrt4=2$.\n$$\\begin{align*}x&=2\\cos t\\\\y&=2\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p68-q45-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt2\\cos t,\\sqrt2\\sin t)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $(0,0)$ and the radius is $\\sqrt2$.\n$$\\begin{align*}x&=\\sqrt2\\cos t\\\\y&=\\sqrt2\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p68-q45-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+(y-2)^2=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\sqrt3\\cos t,2+\\sqrt3\\sin t)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $(0,2)$ and the radius is $\\sqrt3$.\n$$\\begin{align*}x&=\\sqrt3\\cos t\\\\y&=2+\\sqrt3\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p68-q45-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2-2x+y^2=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1+\\sqrt2\\cos t,\\sqrt2\\sin t)$, $t\\in\\mathbb R$.",
          "worked": "$$\\begin{align*}(x-1)^2+y^2&=1+1\\\\(x-1)^2+y^2&=2\\end{align*}$$\nThe centre is $(1,0)$ and the radius is $\\sqrt2$.\n$$\\begin{align*}x&=1+\\sqrt2\\cos t\\\\y&=\\sqrt2\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p68-q45-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+3)^2+(y-2)^2=9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3+3\\cos t,2+3\\sin t)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $(-3,2)$ and the radius is $3$.\n$$\\begin{align*}x&=-3+3\\cos t\\\\y&=2+3\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p68-q45-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x+2)^2+(y+1)^2=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2+2\\cos t,-1+2\\sin t)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $(-2,-1)$ and the radius is $2$.\n$$\\begin{align*}x&=-2+2\\cos t\\\\y&=-1+2\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p68-q45-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(x-\\frac12\\right)^2+\\left(y+\\frac32\\right)^2=\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac12+\\frac12\\cos t,-\\frac32+\\frac12\\sin t\\right)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $\\left(\\frac12,-\\frac32\\right)$ and the radius is $\\sqrt{\\frac14}=\\frac12$.\n$$\\begin{align*}x&=\\frac12+\\frac12\\cos t\\\\y&=-\\frac32+\\frac12\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p68-q45-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(x+\\frac32\\right)^2+\\left(y-\\frac12\\right)^2=\\frac19$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-\\frac32+\\frac13\\cos t,\\frac12+\\frac13\\sin t\\right)$, $t\\in\\mathbb R$.",
          "worked": "The centre is $\\left(-\\frac32,\\frac12\\right)$ and the radius is $\\sqrt{\\frac19}=\\frac13$.\n$$\\begin{align*}x&=-\\frac32+\\frac13\\cos t\\\\y&=\\frac12+\\frac13\\sin t\\end{align*}$$\nTake $t\\in\\mathbb R$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
