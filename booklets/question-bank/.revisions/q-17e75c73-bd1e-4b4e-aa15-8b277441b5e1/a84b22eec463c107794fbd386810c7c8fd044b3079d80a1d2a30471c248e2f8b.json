  "title": "",
  "classification": {
    "primarySkillId": "reciprocal-function-graph",
    "secondarySkillIds": [],
    "reasoningScore": 45,
    "difficulty": "Development",
    "difficultyReason": "Distinguishes reciprocal graph features from exceptions involving zero values and excluded domain points."
  },
  "content": {
    "id": "p10-q1-6-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p10-q1-6-shared-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "True or False?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1",
        "type": "part",
        "label": "a",
        "prompt": "The reciprocal graph of a stationary point always remains a stationary point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "A stationary point with a nonzero $y$-coordinate remains stationary. A stationary point on the $x$-axis instead gives a vertical asymptote.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q2",
        "type": "part",
        "label": "b",
        "prompt": "The reciprocal graph of an $x$-intercept results in a vertical asymptote.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Near an $x$-intercept, $f(x)$ approaches $0$, so $\\dfrac{1}{f(x)}$ becomes unbounded. The reciprocal graph has a vertical asymptote at that $x$-value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q3",
        "type": "part",
        "label": "c",
        "prompt": "The reciprocal graph of a vertical asymptote results in an $x$-intercept.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False: an open circle on the $x$-axis.",
          "worked": "The reciprocal approaches $0$ near the original vertical asymptote, but remains undefined at that $x$-value. Mark an open circle on the $x$-axis rather than an $x$-intercept.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q4",
        "type": "part",
        "label": "d",
        "prompt": "A point on $y=f(x)$ that has a $y$-coordinate of $1$ or $-1$ remains unchanged in the reciprocal graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Since $\\dfrac{1}{1}=1$ and $\\dfrac{1}{-1}=-1$, these $y$-coordinates remain unchanged. The $x$-coordinate also stays the same.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q5",
        "type": "part",
        "label": "e",
        "prompt": "A horizontal asymptote on $y=f(x)$ becomes another horizontal asymptote in the reciprocal graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False in general; true for a nonzero horizontal asymptote.",
          "worked": "A horizontal asymptote $y=h$ becomes $y=\\dfrac{1}{h}$ when $h\\ne0$. For example, $f(x)=\\dfrac{1}{x^2+1}$ has horizontal asymptote $y=0$, but its reciprocal $y=x^2+1$ has no horizontal asymptote.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p10-q6",
        "type": "part",
        "label": "f",
        "prompt": "Let $g(x)=\\dfrac{1}{f(x)}$. The graph of $y=\\dfrac{1}{g(x)}$ is just the same as $y=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False in general: zeroes of $f$ remain excluded.",
          "worked": "Taking the reciprocal twice restores $f(x)$ wherever $f(x)\\ne0$. At a zero of $f$, $g$ is undefined, so the second reciprocal has an open circle there.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
