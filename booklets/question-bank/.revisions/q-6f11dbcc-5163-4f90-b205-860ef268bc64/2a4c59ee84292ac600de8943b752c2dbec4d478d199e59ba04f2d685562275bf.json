        "answer": {
          "short": "From $138$ cm to $155$ cm, inclusive; either endpoint is allowed.",
          "worked": "The minimum is $138$ cm and the maximum is $155$ cm. Any height from $138$ cm to $155$ cm, inclusive, leaves these extremes unchanged, so the range remains $155-138=17$ cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q8b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p8-q8b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Another child joins the line. The range increases by ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "2\\,\\text{cm}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "What could the height of the child be?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$157$ cm or $136$ cm.\n\nExtend either end of the range by $2$ cm.",
          "worked": "The original range is $155-138=17$ cm, so the new range must be $19$ cm. The extra child must be $2$ cm taller than the maximum or $2$ cm shorter than the minimum. $$\\begin{align*}\\text{Taller height} &= (155+2)\\,\\text{cm}\\\\\\text{Taller height} &= 157\\,\\text{cm}\\\\\\text{Shorter height} &= (138-2)\\,\\text{cm}\\\\\\text{Shorter height} &= 136\\,\\text{cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
