  "content": {
    "id": "p36-q10",
    "type": "question",
    "label": "10",
    "prompt": "A student claimed that as time spent swimming training increases, the time to run a 1-kilometre time trial decreases.\n\nAfter analysing the data, the student found the correlation coefficient, $r$, to be $-0.73$.\n\nWhat does this correlation indicate about the relationship between the time a student spends swimming training and their 1-kilometre run time trial times?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Moderate negative correlation: as time spent swimming training increases, 1-kilometre run times tend to decrease.",
      "worked": "Since $r=-0.73$ is negative and its magnitude lies between $0.50$ and $0.75$ on the booklet’s scale, the correlation is moderate and negative. Students who spend more time swimming training tend to have shorter 1-kilometre run times.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
