      {
        "id": "index-t5-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^{3} \\times 3x^{5} = 5x^{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Added the coefficients instead of multiplying. Correct: $6x^{8}$",
          "worked": "Multiply the coefficients and add the exponents: $2x^3\\times3x^5=2\\times3x^{3+5}=6x^8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t5-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$4a^{2} \\times 3a^{5} = 12a^{10}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Multiplied the exponents instead of adding. Correct: $12a^{7}$",
          "worked": "Add the exponents when multiplying matching bases: $4a^2\\times3a^5=4\\times3a^{2+5}=12a^7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t5-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{8y^{6}}{2y^{2}}$ $= 4y^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Did not subtract the exponents correctly. Correct: $4y^{4}$",
          "worked": "Subtract the exponents when dividing: $\\frac{8y^6}{2y^2}=\\frac82y^{6-2}=4y^4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t5-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{10m^{4}}{10m^{4}}$ $= 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Everything cancels, but the answer should be 1.",
          "worked": "A nonzero expression divided by itself equals 1: $\\frac{10m^4}{10m^4}=1$ for $m\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t5-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$3p^{2} \\times 5p^{3} = 8p^{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Added the coefficients. Correct: $15p^{5}$",
          "worked": "Multiply the coefficients: $3p^2\\times5p^3=3\\times5p^{2+3}=15p^5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t5-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$- 2x^{4} \\times 3x^{2} = 6x^{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Forgot the negative sign. Correct: $- 6x^{6}$",
          "worked": "A negative times a positive is negative: $-2x^4\\times3x^2=-2\\times3x^{4+2}=-6x^6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
