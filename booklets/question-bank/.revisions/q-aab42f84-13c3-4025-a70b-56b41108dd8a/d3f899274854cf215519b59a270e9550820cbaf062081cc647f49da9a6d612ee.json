        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{x+1}{x-1}=\\frac{(x-1)+2}{x-1}=1+\\frac{2}{x-1}$, for $x\\ne1$.",
          "worked": "For $x\\ne1$,\n$$\\begin{align*}\\frac{x+1}{x-1}&=\\frac{(x-1)+2}{x-1}\\\\\\frac{x+1}{x-1}&=1+\\frac{2}{x-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p24-q09-b",
