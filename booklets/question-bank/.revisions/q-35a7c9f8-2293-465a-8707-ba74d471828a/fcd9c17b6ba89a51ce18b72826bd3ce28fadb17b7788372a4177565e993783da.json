    "type": "question",
    "label": "18",
    "prompt": "Find the smallest number divisible by 9 whose digits are all 2.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$222222222$",
      "worked": "A number is divisible by 9 when its digit sum is divisible by 9. With $k$ digits, all equal to 2, the digit sum is $2k$. The smallest positive even multiple of 9 is 18, so the smallest possible number of digits is\n$$\\begin{align*}2k &= 18\\\\k &= 9.\\end{align*}$$\nTherefore the smallest number is $222222222$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
