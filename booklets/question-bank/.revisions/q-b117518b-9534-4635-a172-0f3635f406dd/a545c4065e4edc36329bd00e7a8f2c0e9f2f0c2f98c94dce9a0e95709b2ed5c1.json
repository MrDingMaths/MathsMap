  "content": {
    "id": "p75-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "State the value(s) of $a$ for which the following inequalities have no solutions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p75-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x-2|\\le a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a<0$",
          "worked": "Since $|x-2|\\ge0$, there is no solution when $a<0$. When $a\\ge0$, $x=2$ satisfies the inequality. Hence the required values are $a<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p75-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$|x+1|\\le a-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a<2$",
          "worked": "Since $|x+1|\\ge0$, there is no solution when $a-2<0$, giving $a<2$. When $a\\ge2$, $x=-1$ satisfies the inequality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
