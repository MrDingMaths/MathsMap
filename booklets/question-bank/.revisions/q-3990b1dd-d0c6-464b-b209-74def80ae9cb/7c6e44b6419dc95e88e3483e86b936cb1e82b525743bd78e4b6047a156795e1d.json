        "answer": {
          "short": "$73$",
          "worked": "Substitute $x = 36$ into $y = 2x + 1$:\n$$y = 2(36) + 1 = 72 + 1 = 73$$\nWe need $73$ matches to make $36$ triangles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
