    ],
    "reasoningScore": 27,
    "difficulty": "Development",
    "difficultyReason": "Count repeated die faces and use the resulting probability in two expected-frequency calculations."
  },
  "content": {
    "id": "p21-q3",
    "type": "question",
    "label": "3",
    "prompt": "A fair 10-sided die has faces with the numbers: 3 3 3 5 8 8 8 9 10 10.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the theoretical probability, as a fraction, of rolling a 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "Three of the ten equally likely faces show 3.\n$$P(3)=\\frac{3}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p21-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the expected number of occurrences of rolling a 3 from 20 rolls.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$ occurrences",
          "worked": "$$P(3)=\\frac{3}{10}$$\n$$\\begin{align*}f&=np\\\\f&=20\\times\\frac{3}{10}\\\\f&=6\\end{align*}$$\nExpected frequency: 6 occurrences.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p21-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the theoretical probability, as a decimal, of rolling an odd number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5$",
          "worked": "The five odd-numbered faces are 3, 3, 3, 5 and 9.\n$$\\begin{align*}P(\\text{odd})&=\\frac{5}{10}\\\\P(\\text{odd})&=0.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p21-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Calculate the expected number of occurrences of rolling an odd number from 150 rolls.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75$ occurrences",
          "worked": "$$P(\\text{odd})=\\frac{5}{10}=0.5$$\n$$\\begin{align*}f&=np\\\\f&=150\\times0.5\\\\f&=75\\end{align*}$$\nExpected frequency: 75 occurrences.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
