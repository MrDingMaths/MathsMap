    "children": [
      {
        "id": "p25-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "How many families have no children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5 families",
          "worked": "The frequency beneath $0$ children is $5$, so $5$ families have no children.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p25-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "How many families have an even number of children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "40 families",
          "worked": "The even numbers of children are $0$, $2$ and $4$.\n$$\\begin{align*}\\text{Number of families} &= 5+32+3 \\\\ \\text{Number of families} &= 40\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p25-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "How many families participated in the survey?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "70 families",
          "worked": "$$\\begin{align*}\\text{Total families} &= 5+20+32+10+3 \\\\ \\text{Total families} &= 70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p25-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Based on this experiment, what is the relative frequency of a family having an even number of children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{7}$",
          "worked": "$$\\begin{align*}\\text{Relative frequency} &= \\frac{\\text{Frequency of outcome}}{\\text{Total trials}} \\\\ \\text{Relative frequency} &= \\frac{40}{70} \\\\ \\text{Relative frequency} &= \\frac{4}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p25-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "If 140 families were surveyed, how many would you expect to have an even number of children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "80 families",
          "worked": "$$\\begin{align*}\\text{Expected frequency} &= \\text{Relative frequency}\\times\\text{Total trials} \\\\ \\text{Expected frequency} &= \\frac{4}{7}\\times140 \\\\ \\text{Expected frequency} &= 80\\end{align*}$$\nExpect $80$ families to have an even number of children.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
