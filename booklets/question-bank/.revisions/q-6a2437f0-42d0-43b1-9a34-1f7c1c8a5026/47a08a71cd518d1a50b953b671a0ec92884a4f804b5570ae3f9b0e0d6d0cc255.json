    "answer": {
      "short": "\\$65 257.87",
      "worked": "The taxable income is in the \\$37 001–\\$87 000 bracket.\n\n$$\\begin{align*}\n\\text{Excess} &= 86\\,725-37\\,000 \\\\\n\\text{Excess} &= 49\\,725 \\\\\n\\text{Income tax} &= 3572+0.325\\times49\\,725 \\\\\n\\text{Income tax} &= \\$19\\,732.63\\quad\\text{(nearest cent)} \\\\\n\\text{Medicare levy} &= 0.02\\times86\\,725 \\\\\n\\text{Medicare levy} &= \\$1734.50 \\\\\n\\text{Total tax} &= 19\\,732.63+1734.50 \\\\\n\\text{Total tax} &= \\$21\\,467.13 \\\\\n\\text{Net income} &= 86\\,725-21\\,467.13 \\\\\n\\text{Net income} &= \\$65\\,257.87\n\\end{align*}$$",
      "solutionDiagrams": []
    },
