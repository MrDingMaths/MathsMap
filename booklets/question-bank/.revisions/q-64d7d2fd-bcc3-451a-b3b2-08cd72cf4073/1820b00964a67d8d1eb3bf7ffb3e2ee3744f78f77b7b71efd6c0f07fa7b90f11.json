    "difficulty": "Mastery",
    "difficultyReason": "Calculate total sales and reverse the retainer-plus-commission formula to find a percentage rate."
  },
  "content": {
    "id": "p30-q14",
    "type": "question",
    "label": "14",
    "prompt": "A door-to-door salesman sells 10 security systems in one week at \\$1200 each. For the week, he earns a total of \\$850, including a retainer of \\$300 and a commission.\n\nFind his percentage commission correct to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.58\\%$",
      "worked": "Let $r$ be the commission rate as a decimal.\n\n$$\\begin{align*}\\text{Sales} &= 10\\times1200 = \\$12\\,000\\\\\\text{Pay} &= \\text{Retainer}+r\\times\\text{Sales}\\\\850 &= 300+r\\times12\\,000\\\\550 &= 12\\,000r\\\\r &= \\frac{550}{12\\,000}\\\\\\text{Percentage commission} &= \\frac{550}{12\\,000}\\times100\\%\\\\&\\approx 4.58\\%\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 49
  },
