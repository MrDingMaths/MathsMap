  "content": {
    "id": "p72-q1-node",
    "type": "question",
    "label": "1",
    "prompt": "Determine the angle between the minute hand and hour hand at:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p72-q1-clock",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 72 p72-q1-clock\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,draw=black,text=black,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[line width=0.8pt] (0,0) circle[radius=21];\n\\foreach \\h in {1,...,12} {\n  \\draw[line width=0.4pt] ({90-30*\\h}:21) -- ({90-30*\\h}:19.9);\n  \\node[inner sep=0pt] at ({90-30*\\h}:17.4) {\\h};\n}\n\\fill[black] (0,0) circle[radius=0.65];\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 44,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 72,
          "sourceRegion": "Question 1, shared clock to the left of parts a–d",
          "description": "Unshaded circular clock face with twelve short radial hour ticks, numerals 1–12 in clockwise order, 12 at the top, and a black centre dot. No hands or angle arcs.",
          "mathematics": "Twelve equally spaced hour positions divide a complete revolution into 30-degree intervals.",
          "answerVisibility": "The empty clock face is supplied question content; no completed hands or answers are visible."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p72-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "6:00 pm",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180^\\circ$",
          "worked": "The minute hand is at 12 and the hour hand is at 6. Each hour interval is $360^\\circ\\div12=30^\\circ$.\n$$\\begin{align*}\\text{Angle}&=6\\times30^\\circ\\\\\\text{Angle}&=180^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p72-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "11:00 pm",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^\\circ$",
          "worked": "The smaller angle from 11 to 12 spans one hour interval.\n$$\\begin{align*}\\text{Angle}&=360^\\circ\\div12\\\\\\text{Angle}&=30^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p72-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "4:00 am",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120^\\circ$",
          "worked": "The smaller angle from 12 to 4 spans four hour intervals.\n$$\\begin{align*}\\text{Angle}&=4\\times30^\\circ\\\\\\text{Angle}&=120^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p72-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "3:30 pm",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75^\\circ$",
          "worked": "The minute hand is at 6. The hour hand is halfway between 3 and 4. Measured clockwise from 12:\n$$\\begin{align*}\\text{Minute-hand angle}&=6\\times30^\\circ\\\\\\text{Minute-hand angle}&=180^\\circ\\\\\\text{Hour-hand angle}&=3\\times30^\\circ+\\frac12\\times30^\\circ\\\\\\text{Hour-hand angle}&=105^\\circ\\\\\\text{Angle between hands}&=180^\\circ-105^\\circ\\\\\\text{Angle between hands}&=75^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
