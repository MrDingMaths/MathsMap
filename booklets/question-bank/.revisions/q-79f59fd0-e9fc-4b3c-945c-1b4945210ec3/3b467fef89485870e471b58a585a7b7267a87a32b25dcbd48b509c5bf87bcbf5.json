    "difficulty": "Development",
    "difficultyReason": "Calculate two weekly wages from hourly rates and compare the earnings by subtraction."
  },
  "content": {
    "id": "p9-q9",
    "type": "question",
    "label": "9",
    "prompt": "Ellen earns \\$43.85 per hour while Ben earns \\$27.90 per hour. If both work a 38-hour week, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Ellen’s weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1666.30",
          "worked": "$$\\begin{align*}\\text{Ellen’s weekly pay}&=\\text{Hourly rate}\\times\\text{Weekly hours}\\\\\\text{Ellen’s weekly pay}&=\\$43.85\\times38\\\\\\text{Ellen’s weekly pay}&=\\$1666.30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Ben’s weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1060.20",
          "worked": "$$\\begin{align*}\\text{Ben’s weekly pay}&=\\text{Hourly rate}\\times\\text{Weekly hours}\\\\\\text{Ben’s weekly pay}&=\\$27.90\\times38\\\\\\text{Ben’s weekly pay}&=\\$1060.20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "The difference in their weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$606.10",
          "worked": "$$\\begin{align*}\\text{Difference}&=\\text{Ellen’s weekly pay}-\\text{Ben’s weekly pay}\\\\\\text{Difference}&=\\$1666.30-\\$1060.20\\\\\\text{Difference}&=\\$606.10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
