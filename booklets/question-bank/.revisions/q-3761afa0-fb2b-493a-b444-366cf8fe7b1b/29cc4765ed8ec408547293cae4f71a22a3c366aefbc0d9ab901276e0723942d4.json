    "children": [
      {
        "id": "p63-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the fact that $(2^2)^3 = 2^6$ to simplify $((2^2)^3)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{24}$",
          "worked": "$$\\begin{align*}((2^2)^3)^4 &= (2^6)^4 \\\\ ((2^2)^3)^4 &= 2^{6\\times4} \\\\ ((2^2)^3)^4 &= 2^{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p63-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $((2^3)^4)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{60}$",
          "worked": "$$\\begin{align*}((2^3)^4)^5 &= (2^{12})^5 \\\\ ((2^3)^4)^5 &= 2^{12\\times5} \\\\ ((2^3)^4)^5 &= 2^{60}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p63-q16-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p63-q16-c-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Arrange these numbers in ascending order.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p63-q16-c-given-list",
              "type": "paragraph",
              "fontSize": null,
              "align": "center",
              "spaceBefore": 3,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "2^{100},\\ (2^7)^{10},\\ ((2^5)^6)^7,\\ ((2^3)^4)^5",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$((2^3)^4)^5,\\ (2^7)^{10},\\ 2^{100},\\ ((2^5)^6)^7$",
          "worked": "$$\\begin{align*}(2^7)^{10} &= 2^{7\\times10} \\\\ (2^7)^{10} &= 2^{70} \\\\ ((2^5)^6)^7 &= (2^{30})^7 \\\\ ((2^5)^6)^7 &= 2^{210} \\\\ ((2^3)^4)^5 &= (2^{12})^5 \\\\ ((2^3)^4)^5 &= 2^{60}\\end{align*}$$\nSince $2>1$ and $60<70<100<210$, the ascending order is\n$$((2^3)^4)^5,\\ (2^7)^{10},\\ 2^{100},\\ ((2^5)^6)^7.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
