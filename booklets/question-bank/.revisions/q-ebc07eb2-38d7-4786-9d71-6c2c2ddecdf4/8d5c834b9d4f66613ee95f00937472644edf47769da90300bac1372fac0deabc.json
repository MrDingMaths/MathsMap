  "content": {
    "id": "p32-q1",
    "type": "question",
    "label": "1",
    "prompt": "Convert these units of speed to metres per second.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$70\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$19.\\dot{4}\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{70\\text{ km}}{1\\text{ h}}\\\\\\text{speed}&=\\frac{(70\\times1000)\\text{ m}}{(1\\times60\\times60)\\text{ s}}\\\\\\text{speed}&=19.\\dot{4}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$45\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.5\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{45\\text{ km}}{1\\text{ h}}\\\\\\text{speed}&=\\frac{(45\\times1000)\\text{ m}}{(1\\times60\\times60)\\text{ s}}\\\\\\text{speed}&=12.5\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$76\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$21.\\dot{1}\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\text{speed}&=\\frac{76\\text{ km}}{1\\text{ h}}\\\\\\text{speed}&=\\frac{(76\\times1000)\\text{ m}}{(1\\times60\\times60)\\text{ s}}\\\\\\text{speed}&=21.\\dot{1}\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$54\\text{ km/h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\text{ m/s}$",
          "worked": "$$\\begin{align*}\\frac{54\\text{ km}}{1\\text{ h}}&=\\frac{54\\times1000\\text{ m}}{1\\times60\\times60\\text{ s}}\\\\&=15\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
