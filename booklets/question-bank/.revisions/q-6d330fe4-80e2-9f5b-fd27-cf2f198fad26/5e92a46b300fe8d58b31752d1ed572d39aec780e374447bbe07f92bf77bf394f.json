    "label": "14",
    "prompt": "Solve the following equations simultaneously for $x$ and $y$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q59-response",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}2^{x+y}&=4\\\\2^{x-y}&=16\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$, $y=-1$.",
          "worked": "$$\\begin{align*}2^{x+y}&=2^2\\\\2^{x-y}&=2^4\\\\x+y&=2\\\\x-y&=4\\end{align*}$$\nAdd the two linear equations.\n$$\\begin{align*}2x&=6\\\\x&=3\\\\3+y&=2\\\\y&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p5-q60-response",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}3^{x+2y}&=81\\\\2^{2x-y}&=8\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$, $y=1$.",
          "worked": "$$\\begin{align*}3^{x+2y}&=3^4\\\\2^{2x-y}&=2^3\\\\x+2y&=4\\\\2x-y&=3\\end{align*}$$\nAdd the first linear equation to twice the second.\n$$\\begin{align*}(x+2y)+2(2x-y)&=4+2(3)\\\\5x&=10\\\\x&=2\\\\2+2y&=4\\\\2y&=2\\\\y&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 88
      }
    ]
