  "content": {
    "id": "p68-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Evaluate these",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p68-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{2^{1001}\\times2^{2002}}{(2^{150})^{20}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{aligned}\\frac{2^{1001}\\times2^{2002}}{(2^{150})^{20}}&=\\frac{2^{3003}}{2^{3000}}\\\\&=2^3\\\\&=8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p68-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{5^{1000}\\times3^{1001}}{15^{999}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$",
          "worked": "$$\\begin{aligned}&\\frac{5^{1000}\\times3^{1001}}{15^{999}}\\\\&=\\frac{5^{1000}\\times3^{1001}}{5^{999}\\times3^{999}}\\\\&=5^{1000-999}\\times3^{1001-999}\\\\&=5\\times9\\\\&=45\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p68-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{8^{50}\\times4^{100}\\times2^{200}}{(2^{250})^2\\times2^{48}}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{aligned}&\\frac{8^{50}\\times4^{100}\\times2^{200}}{(2^{250})^2\\times2^{48}}\\\\&=\\frac{(2^3)^{50}\\times(2^2)^{100}\\times2^{200}}{2^{500}\\times2^{48}}\\\\&=\\frac{2^{150+200+200}}{2^{500+48}}\\\\&=2^{550-548}\\\\&=2^2\\\\&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
