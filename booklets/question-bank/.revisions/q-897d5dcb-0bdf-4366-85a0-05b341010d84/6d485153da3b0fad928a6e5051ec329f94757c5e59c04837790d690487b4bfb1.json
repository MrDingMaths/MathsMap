        "type": "part",
        "label": "a",
        "prompt": "Explain why you cannot find the range, mean, or median from this table.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p56-q7-a-supplied",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The orders are non-numerical categories with no natural order, so their mean, range and median are undefined.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The variable is the type of food ordered. Food categories have no numerical values for calculating a mean or range, and no natural order for identifying a median. The frequencies count orders; they are not the values of the food variable.",
