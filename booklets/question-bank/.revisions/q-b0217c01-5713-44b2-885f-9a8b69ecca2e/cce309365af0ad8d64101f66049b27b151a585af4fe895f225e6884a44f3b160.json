      {
        "id": "p20-q1-b",
        "type": "group",
        "label": "b",
        "prompt": "Calculate the area of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q1-b-i",
            "type": "part",
            "label": "i",
            "prompt": "The two circles. Answer in exact form.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$32\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A_{\\text{circles}}&=2\\pi r^2\\\\A_{\\text{circles}}&=2\\pi(4)^2\\\\A_{\\text{circles}}&=32\\pi\\text{ cm}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p20-q1-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "The rectangle. Answer in exact form.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$80\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A_{\\text{rectangle}}&=2\\pi rh\\\\A_{\\text{rectangle}}&=2\\pi(4)(10)\\\\A_{\\text{rectangle}}&=80\\pi\\text{ cm}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p20-q1-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Hence find the surface area of the cylinder to 1 d.p.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$351.9\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A&=32\\pi+80\\pi\\\\A&=112\\pi\\text{ cm}^2\\\\A&\\approx351.9\\text{ cm}^2\\quad\\text{(1 d.p.)}.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
