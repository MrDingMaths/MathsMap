        "type": "part",
        "label": "a",
        "prompt": "The probability of rolling an even number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "B",
          "worked": "The even outcomes are $2$, $4$ and $6$.\n$$\\begin{align*}P(\\text{even})&=\\frac{3}{6}\\\\P(\\text{even})&=\\frac{1}{2}\\end{align*}$$\nThe matching letter is B.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "The probability of rolling a 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A",
          "worked": "There is $1$ favourable outcome among $6$ equally likely outcomes.\n$$P(3)=\\frac{1}{6}$$\nThe matching letter is A.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "The probability of rolling a number greater than 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "C",
          "worked": "The favourable outcomes are $2$, $3$, $4$, $5$ and $6$.\n$$P(\\text{greater than }1)=\\frac{5}{6}$$\nThe matching letter is C.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
