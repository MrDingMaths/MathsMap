                  "latex": "\\sqrt{4+2\\sqrt3}=a+b\\sqrt3.",
                  "display": true
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1,\\ b=1$.\n\nSquare and compare rational and irrational terms; choose the positive root.",
          "worked": "$$4+2\\sqrt3=a^2+3b^2+2ab\\sqrt3.$$\nSince $a,b$ are rational, $a^2+3b^2=4$ and $ab=1$. Thus $a\\ne0$ and $b=\\frac{1}{a}$.\n$$\\begin{align*}a^2+\\frac3{a^2}&=4\\\\a^4-4a^2+3&=0\\\\(a^2-1)(a^2-3)&=0.\\end{align*}$$\nRationality excludes $a^2=3$. The remaining pairs are $(1,1)$ and $(-1,-1)$. The principal square root is positive, so $a=b=1$. Check: $(1+\\sqrt3)^2=4+2\\sqrt3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p23-q85-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p23-q85-b-text-0-0",
