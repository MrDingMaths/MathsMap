  "classification": {
    "primarySkillId": "arc-length-perimeter-sector",
    "secondarySkillIds": [],
    "reasoningScore": 45,
    "difficulty": "Development",
    "difficultyReason": "Using l=(theta/360)2pi r and l=r with r>0 gives theta=180/pi=57.3 degrees, independent of radius, and P=l+2r=3r. This assesses inverse sector arc-length and perimeter methods taught in the preceding sector section."
  },
  "content": {
    "id": "p52-sector-extension-root",
    "type": "question",
    "label": null,
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "15582279-5464-4cae-be2a-00360fb96a76",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 0,
          "lineHeight": 1.3199970000068182,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A sector has an arc length equal to its radius, where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "r>0",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-sector-extension-a",
        "type": "part",
        "label": "a",
        "prompt": "Find its angle, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$57.3^\\circ$",
          "worked": "$$\\begin{align*}\\frac{\\theta}{360}\\times2\\pi r&=r\\\\\\theta&=\\frac{360}{2\\pi}\\\\\\theta&\\approx57.3^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-sector-extension-b",
        "type": "part",
        "label": "b",
        "prompt": "Does the angle depend on the radius? Explain.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. The positive radius cancels from both sides.",
          "worked": "Divide both sides by $r$. The angle is $\\theta=\\frac{360}{2\\pi}$ for every positive radius.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-sector-extension-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that its perimeter is $3r$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=l+2r=r+2r=3r$.",
          "worked": "$$\\begin{align*}P&=l+2r\\\\P&=r+2r\\\\P&=3r\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
