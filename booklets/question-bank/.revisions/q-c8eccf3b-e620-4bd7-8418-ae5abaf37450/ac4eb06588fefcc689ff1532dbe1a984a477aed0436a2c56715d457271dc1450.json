  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The temperature in a lounge room is measured frequently throughout a particular day.\nThe results are presented in a line graph, as shown.\nOnly selected points are marked.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p20-q9-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"temperatureRed\",\"hex\":\"EF6068\",\"reason\":\"temperature trace and matched midnight reading guide\"},{\"name\":\"selectedBlue\",\"hex\":\"268CFF\",\"reason\":\"selected observed temperature markers\"},{\"name\":\"gridBlue\",\"hex\":\"CCCCCC\",\"reason\":\"restrained graph grid\"}],\"reference\":\"source page 20 p20-q9-graph\"}\n\\begin{tikzpicture}[x=2.65mm,y=1.06mm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{temperatureRed}{HTML}{EF6068}\n\\definecolor{selectedBlue}{HTML}{268CFF}\n\\definecolor{gridBlue}{HTML}{CCCCCC}\n\\draw[gridBlue,line width=0.25pt,xstep=2,ystep=5] (0,0) grid (20,35);\n\\draw[black,->,line width=0.5pt] (0,0)--(20,0);\n\\draw[black,->,line width=0.5pt] (0,0)--(0,35);\n\\foreach \\y in {0,10,20,30}{\\draw[black,line width=0.4pt] (0,\\y)--(-0.3,\\y);\\node[left,font=\\fontsize{8.5}{10}\\selectfont] at (-0.3,\\y) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\y\\special{dvisvgm:raw </g>}};}\n\\foreach \\x/\\lab in {0/{6 a.m.},2/{8 a.m.},4/{10 a.m.},6/{12 p.m.},8/{2 p.m.},10/{4 p.m.},12/{6 p.m.},14/{8 p.m.},16/{10 p.m.},18/{12 a.m.}}{\\draw[black,line width=0.4pt] (\\x,0)--(\\x,-0.7);\\node[rotate=50,anchor=east,font=\\fontsize{8.5}{10}\\selectfont] at (\\x,-1.5) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}\\lab\\special{dvisvgm:raw </g>}};}\n\\node[font=\\fontsize{10}{12}\\selectfont\\bfseries,above=2mm] at (10,35) {Temperature in a lounge room};\n\\node[rotate=90] at (-3.7,17.5) {\\textit{Temperature ($^{\\circ}$C)}};\n\\node[below=15mm] at (10,0) {\\textit{Time}};\n\\draw[temperatureRed,line width=0.8pt] (0,5)--(1,5) .. controls (1,12) and (1.5,18) .. (2,20) .. controls (2.8,14) and (6,10.5) .. (10,10) .. controls (11.5,9.8) and (13,9.9) .. (14,10) .. controls (14.5,18) and (16,24) .. (17,25) .. controls (16.9,20) and (17.3,17) .. (18,15) .. controls (18.4,14.1) and (19,13.8) .. (19.5,13.8);\n\\draw[temperatureRed,line width=0.4pt,dashed] (18,0)--(18,15);\n\\foreach \\x/\\y in {1/5,2/20,14/10,17/25,18/15}{\\fill[selectedBlue] (\\x,\\y) circle[radius=0.65mm];}\n\\end{tikzpicture}",
