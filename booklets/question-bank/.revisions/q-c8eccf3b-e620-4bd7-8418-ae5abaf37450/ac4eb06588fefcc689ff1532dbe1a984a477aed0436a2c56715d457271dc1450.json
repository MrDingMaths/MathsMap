    "children": [
      {
        "id": "p20-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Twice during the day the heating was switched on.\nAt what times do you think this happened?\nExplain your reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 7 a.m. and 8 p.m., when the temperature starts rising.",
          "worked": "The temperature starts rising at about 7 a.m. and again at about 8 p.m. These rises suggest the heating was switched on then.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "When was the heating switched off?\nExplain your reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately 8 a.m. and 11 p.m., when the temperature starts decreasing.",
          "worked": "The temperature reaches peaks at about 8 a.m. and 11 p.m., then decreases. This suggests the heating was switched off at those times.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q9-c",
        "type": "group",
        "label": "c",
        "prompt": "The house has a single occupant, who works during the day. Identify when you think that person is:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p20-q9-c-i",
            "type": "part",
            "label": "i",
            "prompt": "waking up",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Possibly about 7 a.m.",
              "worked": "The first temperature rise begins at about 7 a.m., suggesting the occupant may wake and switch on the heating then.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p20-q9-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "going to work",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Possibly about 8 a.m.",
              "worked": "The temperature starts falling at about 8 a.m., suggesting the occupant may switch off the heating and leave for work then.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p20-q9-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "coming home",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Possibly about 8 p.m.",
              "worked": "The evening temperature rise begins at about 8 p.m., suggesting the occupant may return home and switch on the heating then.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          },
          {
            "id": "p20-q9-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "going to bed",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Possibly about 11 p.m.",
              "worked": "The temperature starts falling at about 11 p.m., suggesting the occupant may switch off the heating and go to bed then.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 8
          }
        ]
      },
      {
        "id": "p20-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "If a burglar somehow got this information, how do you think they might use it?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "They might infer when the occupant is away and choose that time to burgle the house.",
          "worked": "The heating pattern may suggest when the occupant is away from home. A burglar might use that inference to choose a time to burgle the house, although the graph does not establish whether anyone is home.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
