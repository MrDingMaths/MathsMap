  "content": {
    "id": "p12-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find all real $a$ such that $f(a)=5$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4$",
          "worked": "$$\\begin{align*}5&=a+1\\\\a&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=2x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$",
          "worked": "$$\\begin{align*}5&=2a+1\\\\4&=2a\\\\a&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\pm2$",
          "worked": "$$\\begin{align*}5&=a^2+1\\\\a^2&=4\\\\a&=\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=x^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=0$",
          "worked": "$$\\begin{align*}5&=a^2+5\\\\a^2&=0\\\\a&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=x^2+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution.",
          "worked": "$$\\begin{align*}5&=a^2+6\\\\a^2&=-1\\end{align*}$$\nNo real solution, since the square of a real number is non-negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
