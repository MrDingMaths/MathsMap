        "answer": {
          "short": "$t<-\\frac{1}{2}$",
          "worked": "$$\\begin{align*}5t-5&<3t-6\\\\5t-3t&<-6+5\\\\2t&<-1\\\\t&<-\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p20-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$5(t-1)\\ge3(2-t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t\\ge\\frac{11}{8}$",
          "worked": "$$\\begin{align*}5t-5&\\ge6-3t\\\\5t+3t&\\ge6+5\\\\8t&\\ge11\\qquad t\\ge\\frac{11}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p20-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$5(1-t)\\le3(t-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t\\ge\\frac{11}{8}$",
          "worked": "$$\\begin{align*}5-5t&\\le3t-6\\\\-5t-3t&\\le-6-5\\\\-8t&\\le-11\\qquad t\\ge\\frac{11}{8}\\end{align*}$$\nReverse the inequality sign when dividing by $-8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p20-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$5(1-t)<3(2-t)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t>-\\frac{1}{2}$",
          "worked": "$$\\begin{align*}5-5t&<6-3t\\\\-5t+3t&<6-5\\\\-2t&<1\\qquad t>-\\frac{1}{2}\\end{align*}$$\nReverse the inequality sign when dividing by $-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
