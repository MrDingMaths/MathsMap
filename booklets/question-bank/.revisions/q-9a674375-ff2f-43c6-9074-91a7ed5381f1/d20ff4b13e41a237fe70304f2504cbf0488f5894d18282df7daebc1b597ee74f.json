    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain how all three people could have different answers for the same measurement, assuming they all measured correctly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "They used measuring instruments with different precisions.",
          "worked": "Their instruments measured to different precisions, so the same mass was rounded differently. For example, $5.846\\text{ kg}$ rounds to $6\\text{ kg}$, $5.8\\text{ kg}$ and $5.85\\text{ kg}$ at the stated precisions.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the possible precision of the measuring instrument being used by each person.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cody: $1\\text{ kg}$; Jacinta: $0.1\\text{ kg}$; Lachlan: $0.01\\text{ kg}$.",
          "worked": "Using the smallest stated place value:\n\nCody: nearest kilogram, so precision $1\\text{ kg}$.\n\nJacinta: nearest tenth of a kilogram, so precision $0.1\\text{ kg}$.\n\nLachlan: nearest hundredth of a kilogram, so precision $0.01\\text{ kg}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
