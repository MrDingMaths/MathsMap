      {
        "id": "index-t9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\begin{aligned}\\left(\\frac{x}{6}\\right)^3&=\\frac{x}{6}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&=\\frac{x\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}}{6\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}}\\\\[2mm]&=\\frac{x^3}{\\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^{3}}{6^{3}}$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{6}\\right)^{3}&=\\frac{x}{6}\\times\\frac{x}{6}\\times\\frac{x}{6} \\\\ &=\\frac{x\\times x\\times x}{6\\times6\\times6} \\\\ &=\\frac{x^{3}}{6^{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "index-t9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\begin{aligned}\\left(\\frac{a}{b}\\right)^5&=\\frac{a}{b}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\\\[2mm]&=\\frac{a\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}}{b\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}\\times \\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}}\\\\[2mm]&=\\frac{a^5}{\\textcolor{#253f8e}{\\boxed{\\rule{0pt}{4mm}\\hspace{5mm}}}}\\end{aligned}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^{5}}{b^{5}}$",
          "worked": "$$\\begin{align*}\\left(\\frac{a}{b}\\right)^{5}&=\\frac{a}{b}\\times\\frac{a}{b}\\times\\frac{a}{b}\\times\\frac{a}{b}\\times\\frac{a}{b} \\\\ &=\\frac{a\\times a\\times a\\times a\\times a}{b\\times b\\times b\\times b\\times b} \\\\ &=\\frac{a^{5}}{b^{5}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
