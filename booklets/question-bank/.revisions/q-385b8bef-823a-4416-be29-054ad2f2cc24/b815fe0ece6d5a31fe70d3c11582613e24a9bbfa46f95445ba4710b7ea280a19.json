    "children": [
      {
        "id": "p68-q5a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the amount of income tax he must pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$5904.50",
          "worked": "The taxable income is \\$47 500, in the \\$45 001–\\$120 000 bracket of the supplied 2022–23 table.\n$$\\begin{align*}\\text{Excess} &= 47\\,500-45\\,000\\\\\\text{Excess} &= 2500\\\\\\text{Income tax} &= 5092+0.325\\times2500\\\\\\text{Income tax} &= \\$5904.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p68-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the Medicare levy Joshua must pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$950",
          "worked": "$$\\begin{align*}\\text{Medicare levy} &= 0.02\\times47\\,500\\\\\\text{Medicare levy} &= \\$950\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p68-q5c",
        "type": "part",
        "label": "c",
        "prompt": "What is the total amount of tax Joshua must pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$6854.50",
          "worked": "$$\\begin{align*}\\text{Total tax} &= \\text{Income tax}+\\text{Medicare levy}\\\\\\text{Total tax} &= 5904.50+950\\\\\\text{Total tax} &= \\$6854.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
