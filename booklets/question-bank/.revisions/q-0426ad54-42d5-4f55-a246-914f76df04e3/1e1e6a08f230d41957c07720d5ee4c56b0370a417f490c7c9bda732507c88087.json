    "type": "question",
    "label": "81",
    "prompt": "Find half of $4^{100}$ in the form $a^b$ where $a$ and $b$ are integers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2^{199}$.",
      "worked": "$$\\begin{align*}\\frac{4^{100}}2&=\\frac{(2^2)^{100}}2\\\\\\frac{4^{100}}2&=2^{200-1}\\\\\\frac{4^{100}}2&=2^{199}\\end{align*}$$\nHere $a=2$ and $b=199$ are integers.",
      "solutionDiagrams": []
    },
