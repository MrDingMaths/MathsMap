  "content": {
    "id": "p37-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Samira has a 2-litre bottle of cola.\nShe pours the cola into cylindrical glasses with radius 3 cm and a height of 11 cm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the capacity of each cylindrical glass?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$99\\pi\\text{ mL}$",
          "worked": "$$\\begin{align*}V &= \\pi r^2h\\\\V &= \\pi(3)^2(11)\\\\V &= 99\\pi\\text{ cm}^3\\\\\\text{Capacity} &= 99\\pi\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "p37-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "How many full glasses can be filled from the bottle of cola?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 full glasses",
          "worked": "$$\\begin{align*}\\text{Cola available} &= 2000\\text{ mL}\\\\\\text{Number of glasses} &= \\frac{2000}{99\\pi}\\end{align*}$$\nSince $6<\\dfrac{2000}{99\\pi}<7$, 6 full glasses can be filled.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      }
    ]
  },
