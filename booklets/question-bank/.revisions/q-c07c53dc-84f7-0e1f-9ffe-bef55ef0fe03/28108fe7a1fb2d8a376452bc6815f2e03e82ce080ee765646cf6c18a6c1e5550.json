  "content": {
    "id": "p12-q69-group-root",
    "type": "question",
    "label": "14",
    "prompt": "Fully factorise the following expression:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q69-response",
        "type": "part",
        "label": "a",
        "prompt": "$(3a+2)^2-16$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(3a-2)(a+2)$",
          "worked": "$$\\begin{align*}(3a+2)^2-16&=(3a+2-4)(3a+2+4)\\\\(3a+2)^2-16&=(3a-2)(3a+6)\\\\(3a+2)^2-16&=3(3a-2)(a+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q70-response",
        "type": "part",
        "label": "b",
        "prompt": "$25-(x+y)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5+x+y)(5-x-y)$",
          "worked": "$$\\begin{align*}25-(x+y)^2&=[5-(x+y)][5+(x+y)]\\\\25-(x+y)^2&=(5+x+y)(5-x-y).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p12-q71-response",
        "type": "part",
        "label": "c",
        "prompt": "$(x+3)^2-(y+2)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y+1)(x+y+5)$",
          "worked": "$$\\begin{align*}(x+3)^2-(y+2)^2&=[(x+3)-(y+2)][(x+3)+(y+2)]\\\\(x+3)^2-(y+2)^2&=(x-y+1)(x+y+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q72-response",
        "type": "part",
        "label": "d",
        "prompt": "$(2a+5)^2-(a-3)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+8)(3a+2)$",
          "worked": "$$\\begin{align*}(2a+5)^2-(a-3)^2&=[(2a+5)-(a-3)][(2a+5)+(a-3)]\\\\(2a+5)^2-(a-3)^2&=(a+8)(3a+2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
