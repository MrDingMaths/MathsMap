        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8e}{3}$",
          "worked": "$$\\begin{align*}\\frac{4}{e}\\times\\frac{2e}{3}\\div\\frac{1}{e}&=\\frac{4}{e}\\times\\frac{2e}{3}\\times e\\\\&=\\frac{8e^2}{3e}\\\\&=\\frac{8e}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{ch}{2}\\div\\frac{1}{2}\\times\\frac{a}{h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ac$",
          "worked": "$$\\begin{align*}\\frac{ch}{2}\\div\\frac{1}{2}\\times\\frac{a}{h}&=\\frac{ch}{2}\\times2\\times\\frac{a}{h}\\\\&=\\frac{2ach}{2h}\\\\&=\\frac{ac}{1}\\\\&=ac\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2v}{5}\\times\\frac{3}{2}\\div\\frac{v^2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{5v}$",
          "worked": "$$\\begin{align*}\\frac{2v}{5}\\times\\frac{3}{2}\\div\\frac{v^2}{3}&=\\frac{2v}{5}\\times\\frac{3}{2}\\times\\frac{3}{v^2}\\\\&=\\frac{18v}{10v^2}\\\\&=\\frac{9}{5v}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{d}\\times\\frac{3d}{4}\\div\\frac{1}{d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3d}{4}$",
          "worked": "$$\\begin{align*}\\frac{1}{d}\\times\\frac{3d}{4}\\div\\frac{1}{d}&=\\frac{1}{d}\\times\\frac{3d}{4}\\times d\\\\&=\\frac{3d^2}{4d}\\\\&=\\frac{3d}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p20-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{q}{p}\\times\\frac{aq}{2p}\\div\\frac{4q}{5p}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5aq}{8p}$",
          "worked": "$$\\begin{align*}\\frac{q}{p}\\times\\frac{aq}{2p}\\div\\frac{4q}{5p}&=\\frac{q}{p}\\times\\frac{aq}{2p}\\times\\frac{5p}{4q}\\\\&=\\frac{5aq^2p}{8p^2q}\\\\&=\\frac{5aq}{8p}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
