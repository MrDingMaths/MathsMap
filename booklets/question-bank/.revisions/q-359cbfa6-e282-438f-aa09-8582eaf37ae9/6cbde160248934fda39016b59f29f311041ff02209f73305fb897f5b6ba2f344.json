                  "latex": "\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}\\times\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}\\times\\text{........}",
