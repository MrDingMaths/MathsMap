              "inlines": [
                {
                  "type": "math",
                  "latex": "=\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{12mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=\\frac{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}",
