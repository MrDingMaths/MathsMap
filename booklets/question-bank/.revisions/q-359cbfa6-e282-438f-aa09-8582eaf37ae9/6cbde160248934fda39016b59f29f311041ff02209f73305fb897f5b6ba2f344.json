        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{k}{3}\\div\\frac{2}{3}\\times\\frac{4}{k}&=\\frac{k}{3}\\times\\frac{3}{2}\\times\\frac{4}{k}\\\\&=\\frac{12k}{6k}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
