      {
        "id": "p31-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x+1}+\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+3}{(x+1)(x+2)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}+\\frac{1}{x+2}&=\\frac{x+2}{(x+1)(x+2)}+\\frac{x+1}{(x+1)(x+2)}\\\\&=\\frac{(x+2)+(x+1)}{(x+1)(x+2)}\\\\&=\\frac{2x+3}{(x+1)(x+2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p31-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x+1}+\\dfrac{1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x+2)}{(x+1)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}+\\frac{1}{x+3}&=\\frac{x+3}{(x+1)(x+3)}+\\frac{x+1}{(x+1)(x+3)}\\\\&=\\frac{(x+3)+(x+1)}{(x+1)(x+3)}\\\\&=\\frac{2x+4}{(x+1)(x+3)}\\\\&=\\frac{2(x+2)}{(x+1)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
