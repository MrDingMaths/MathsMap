        "type": "part",
        "label": "a",
        "prompt": "What is the prime factorisation of this number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^9\\times3^5\\times5\\times7^3\\times13\\times17^2\\times19$",
          "worked": {
            "format": "maths-editor-document-v1",
