      {
        "id": "p90-q72-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the prime factorisation to help you work out the number of students in the class, their ages and the number of students of each age.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "11 students: one aged 13, three aged 14, one aged 15, one aged 16, two aged 17, two aged 18 and one aged 19.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p90-q72-b-allocation",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Assign prime factors to teenage ages (13–19), using each prime exactly as many times as it appears.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p90-q72-b-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The factors 13, 17 and 19 give one 13-year-old, two 17-year-olds and one 19-year-old. The three factors of 7 give three 14-year-olds, and the factor of 5 gives one 15-year-old. This leaves ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2^6\\times3^4",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", which gives two 18-year-olds and one 16-year-old.",
                    "marks": []
                  }
                ]
