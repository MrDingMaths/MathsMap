                    "latex": "\\begin{aligned}15\\,231\\,236\\,267\\,520&=512\\times29\\,748\\,508\\,335\\\\15\\,231\\,236\\,267\\,520&=512\\times243\\times122\\,421\\,845\\\\15\\,231\\,236\\,267\\,520&=512\\times243\\times5\\times343\\times13\\times289\\times19\\end{aligned}",
