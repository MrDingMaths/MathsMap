    "label": "72",
    "prompt": "A teacher multiplied the ages of all the students (all teenagers) in her class and came up with the number $15\\,231\\,236\\,267\\,520$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
