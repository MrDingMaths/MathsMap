  "content": {
    "id": "p25-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write an expression for each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "There are 12 people on a bus.\n$x$ get off.\nHow many people remain?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12-x$ people",
          "worked": "Subtract the number getting off: $12-x$ people remain.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A train has 88 passengers.\n$y$ people get on.\nHow many are on the train?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$88+y$ people",
          "worked": "Add the number getting on: $88+y$ people are on the train.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "A can of lemonade costs $c$ dollars.\nHow much do 5 cans of lemonade cost?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5c$ dollars",
          "worked": "Five cans cost $5\\times c=5c$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p25-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Each ice block is $\\$3$.\nEach lolly bag is $\\$2$\nHow much money is earned from selling $x$ ice blocks and $y$ lolly bags?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+2y$ dollars",
          "worked": "Ice blocks earn $3x$ dollars and lolly bags earn $2y$ dollars. Total revenue is $3x+2y$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p25-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "A rope is $x$ metres long.\nI cut off four lengths of $y$ metres each.\nHow much rope remains?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-4y$ metres",
          "worked": "The four lengths total $4y$ metres. The remaining rope is $x-4y$ metres.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p25-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$n$ students go on an excursion.\nHow much should Ms Ali charge each student if she wants to share the bus hire fee of $\\$200$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{200}{n}$ dollars per student",
          "worked": "Share the fee equally among $n$ students: each pays $\\frac{200}{n}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
