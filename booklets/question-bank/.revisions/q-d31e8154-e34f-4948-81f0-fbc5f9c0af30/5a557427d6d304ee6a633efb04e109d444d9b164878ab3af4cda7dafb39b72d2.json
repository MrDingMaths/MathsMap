      {
        "id": "page-27-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "In which of these coordinate pairs is the $y$ value twice the $x$ value?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "point-satisfies-line"
          ],
          "role": "assesses",
          "prerequisiteIds": [
            "linear-representations",
            "verify-solutions-substitution"
          ],
          "archetype": "lr-audit:verify-pair",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            27
          ],
          "sourceTargetId": "page-27-q5-a"
        },
        "answer": {
          "short": "$(2, 4), (-3, -6), (0, 0), (19, 38), (-20, -40)$",
          "worked": "Test each pair using $y=2x$. For example, $2(2)=4$, whereas $2(4)=8\\ne2$.\n\n$(2, 4), (-3, -6), (0, 0), (19, 38), (-20, -40)$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 3
      },
      {
        "id": "page-27-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "The points you identified in part a lie on what line? Give the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "translate-expressions"
          ],
          "role": "assesses",
          "prerequisiteIds": [
            "algebraic-notation"
          ],
          "archetype": "lr-audit:word-rule",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            27
          ],
          "sourceTargetId": "page-27-q5-b"
        },
        "answer": {
          "short": "$y = 2x$",
          "worked": "Since every point has a $y$-value that is twice the $x$-value, the equation of the line is $y = 2x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 3
      },
      {
        "id": "page-27-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Will $(8, 16)$ lie on $y = 2x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "point-satisfies-line"
          ],
          "role": "assesses",
          "prerequisiteIds": [
            "linear-representations",
            "verify-solutions-substitution"
          ],
          "archetype": "lr-audit:verify-pair",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            27
          ],
          "sourceTargetId": "page-27-q5-c"
        },
        "answer": {
          "short": "Yes",
          "worked": "Substitute $x = 8$: $y = 2(8) = 16$. Since the $y$-value matches, $(8, 16)$ lies on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 3
      },
      {
        "id": "page-27-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Will $(9, 20)$ lie on $y = 2x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "teachingMapping": {
          "skillIds": [
            "point-satisfies-line"
          ],
          "role": "assesses",
          "prerequisiteIds": [
            "linear-representations",
            "verify-solutions-substitution"
          ],
          "archetype": "lr-audit:verify-pair",
          "rationale": "Classification of revised source content; no teaching-content edits.",
          "sourcePages": [
            27
          ],
          "sourceTargetId": "page-27-q5-d"
        },
        "answer": {
          "short": "No",
          "worked": "Substitute $x = 9$: $y = 2(9) = 18 \\ne 20$. Since the $y$-value does not match, $(9, 20)$ does not lie on the line.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 3
      }
