        "type": "part",
        "label": "a",
        "prompt": "What is Amber’s walking speed, correct to the nearest km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\text{ km/h}$",
          "worked": "$$\\begin{align*}t&=2+\\frac{30}{60}=2.5\\text{ h}\\\\v&=\\frac{19}{2.5}=7.6\\text{ km/h}\\\\v&\\approx8\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "nr-p50-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the distance from $P$ to $R$? Answer correct to the nearest kilometre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\text{ km}$",
          "worked": "$$\\begin{align*}PR^2&=19^2+17^2-2(19)(17)\\cos111^\\circ\\\\PR&=\\sqrt{19^2+17^2-2(19)(17)\\cos111^\\circ}\\\\PR&\\approx30\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "nr-p50-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "How long would it take Amber to walk from $P$ to $R$? Answer to the nearest minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\text{ h }54\\text{ min}$",
          "worked": "At the same walking speed, using the unrounded distance:\n$$\\begin{align*}t&=\\frac{\\sqrt{19^2+17^2-2(19)(17)\\cos111^\\circ}}{7.6}\\times60\\text{ min}\\\\t&\\approx234\\text{ min}\\\\t&=3\\text{ h }54\\text{ min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
