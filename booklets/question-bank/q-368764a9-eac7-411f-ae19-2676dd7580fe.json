    "children": [
      {
        "id": "v2-25d81-p66-practice-slot-13-slot-13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $x$ at which the curves $y=(2x-1)^3$ and $y=3x^2$ have parallel tangents.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac14$ and $x=1$.",
          "worked": "$$\\begin{align*}y=(2x-1)^3&\\Rightarrow y'=6(2x-1)^2\\\\y=3x^2&\\Rightarrow y'=6x\\end{align*}$$\nParallel tangents have equal gradients:\n$$\\begin{align*}6(2x-1)^2&=6x\\\\4x^2-4x+1&=x\\\\4x^2-5x+1&=0\\\\(4x-1)(x-1)&=0\\\\x&=\\tfrac14,\\,1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-25d81-p66-practice-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Which is steeper at $x=1$: the curve $y=\\dfrac{x^2}{x+1}$ or the curve $y=x(3-x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x(3-x)$ is steeper (gradient $1$, compared with $\\frac34$).",
          "worked": "For $y=\\dfrac{x^2}{x+1}$, using the quotient rule:\n$$\\begin{align*}y'&=\\frac{2x(x+1)-x^2}{(x+1)^2}\\\\&=\\frac{x^2+2x}{(x+1)^2}\\end{align*}$$\nAt $x=1$: $y'=\\dfrac{3}{4}$.\nFor $y=3x-x^2$: $y'=3-2x$, so at $x=1$: $y'=1$.\nSince $1>\\frac34$, $y=x(3-x)$ is steeper at $x=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
