        "label": "a",
        "prompt": "Find the exact value of $x$ using Pythagoras’ Theorem and the Quadratic Formula.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p34-q5-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 34 p34-q5-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,2.4);\n\\coordinate (B) at (4,2.4);\n\\coordinate (C) at (0,0);\n\\draw[black,line width=0.8pt] (A)--node[midway,above] {$x+3$} (B)--node[midway,below right] {$x+4$} (C)--node[midway,left] {$x$} cycle;\n\\draw[black,line width=0.4pt] ($(A)!0.08!(B)$)--($(A)!0.08!(B)+(0,-0.32)$)--($(A)+(0,-0.32)$);\n\\end{tikzpicture}",
            "src": null,
