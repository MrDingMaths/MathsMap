  "content": {
    "id": "p55-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The displacement of an object in cm over time $t$ seconds is given by $x=6e^{-0.34t}-5$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "the initial displacement",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\text{ cm}$",
          "worked": "$$\\begin{align*}x(0)&=6e^0-5\\\\&=1\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p55-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "the initial velocity",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2.04\\text{ cm/s}$",
          "worked": "$$\\begin{align*}v(t)=\\frac{dx}{dt}&=6(-0.34)e^{-0.34t}\\\\&=-2.04e^{-0.34t}\\\\v(0)&=-2.04e^0\\\\&=-2.04\\text{ cm/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p55-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "the displacement after $4$ s, correct to 2 decimal places",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3.46\\text{ cm}$",
          "worked": "$$\\begin{align*}x(4)&=6e^{-0.34(4)}-5\\\\&=6e^{-1.36}-5\\\\&\\approx-3.46\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p55-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "the velocity after $9$ s, correct to 3 decimal places",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.096\\text{ cm/s}$",
          "worked": "$$\\begin{align*}v(9)&=-2.04e^{-0.34(9)}\\\\&=-2.04e^{-3.06}\\\\&\\approx-0.096\\text{ cm/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p55-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "the acceleration after $2$ s, correct to 2 decimal places",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.35\\text{ cm/s}^2$",
          "worked": "$$\\begin{align*}a(t)=\\frac{dv}{dt}&=(-2.04)(-0.34)e^{-0.34t}\\\\&=0.6936e^{-0.34t}\\\\a(2)&=0.6936e^{-0.34(2)}\\\\&=0.6936e^{-0.68}\\\\&\\approx0.35\\text{ cm/s}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
