    "children": [
      {
        "id": "p23-review-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin675^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\sin675^\\circ&=\\sin(675^\\circ-360^\\circ)\\\\\\sin675^\\circ&=\\sin315^\\circ\\\\\\sin675^\\circ&=-\\sin45^\\circ\\\\\\sin675^\\circ&=-\\frac{1}{\\sqrt2}\\end{align*}$$\nSine is negative in the fourth quadrant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-review-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos480^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}\\cos480^\\circ&=\\cos(480^\\circ-360^\\circ)\\\\\\cos480^\\circ&=\\cos120^\\circ\\\\\\cos480^\\circ&=-\\cos60^\\circ\\\\\\cos480^\\circ&=-\\frac12\\end{align*}$$\nCosine is negative in the second quadrant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-review-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan510^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{\\sqrt3}$",
          "worked": "$$\\begin{align*}\\tan510^\\circ&=\\tan(510^\\circ-360^\\circ)\\\\\\tan510^\\circ&=\\tan150^\\circ\\\\\\tan510^\\circ&=-\\tan30^\\circ\\\\\\tan510^\\circ&=-\\frac{1}{\\sqrt3}\\end{align*}$$\nTangent is negative in the second quadrant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-review-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(-330^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\sin(-330^\\circ)&=\\sin(-330^\\circ+360^\\circ)\\\\\\sin(-330^\\circ)&=\\sin30^\\circ\\\\\\sin(-330^\\circ)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p23-review-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(-240^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}\\cos(-240^\\circ)&=\\cos(-240^\\circ+360^\\circ)\\\\\\cos(-240^\\circ)&=\\cos120^\\circ\\\\\\cos(-240^\\circ)&=-\\cos60^\\circ\\\\\\cos(-240^\\circ)&=-\\frac12\\end{align*}$$\nCosine is negative in the second quadrant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-review-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan(-210^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{\\sqrt3}$",
          "worked": "$$\\begin{align*}\\tan(-210^\\circ)&=\\tan(-210^\\circ+360^\\circ)\\\\\\tan(-210^\\circ)&=\\tan150^\\circ\\\\\\tan(-210^\\circ)&=-\\tan30^\\circ\\\\\\tan(-210^\\circ)&=-\\frac{1}{\\sqrt3}\\end{align*}$$\nTangent is negative in the second quadrant.",
          "solutionDiagrams": []
