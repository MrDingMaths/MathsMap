  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In a boxplot for a large data set, approximately what percentage of the data set is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "below the median?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\%$",
          "worked": "The median divides the ordered data into two equal halves, so approximately $50\\%$ of the data is below the median.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "below the lower quartile?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$",
          "worked": "The lower quartile marks the first quarter of the ordered data, so approximately $25\\%$ of the data is below it.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "in the box?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\%$",
          "worked": "The box extends from the lower quartile to the upper quartile and contains the middle $50\\%$ of the data.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p8-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "in each whisker?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$",
          "worked": "The lower whisker represents the lowest quarter and the upper whisker represents the highest quarter, so each represents approximately $25\\%$ of the data.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
