    "id": "p7-f4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider the quadratic in the form $y=a(x-h)^2+k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-f4-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the significance of the values of $h$ and $k$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h$ and $k$ are respectively the $x$- and $y$-coordinates of the vertex $(h,k)$.",
          "worked": "At $x=h$, the squared term is zero, so $y=k$. Since $(x-h)^2\\geq0$, this gives the minimum when $a>0$ or the maximum when $a<0$. Thus the vertex is $(h,k)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
