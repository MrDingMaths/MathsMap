        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For $c=9$: $x$-intercepts $(1,0)$ and $(9,0)$; vertex $(5,-16)$. For $c=16$: $x$-intercepts $(2,0)$ and $(8,0)$; vertex $(5,-9)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p74-q5-b-answer",
