                  {
                    "type": "math",
                    "latex": "y=(x-1)(x-9)",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", so the roots are 1 and 9.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p74-q5-b-case9-working",
                "type": "paragraph",
