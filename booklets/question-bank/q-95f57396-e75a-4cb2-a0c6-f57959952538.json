  "content": {
    "id": "p8-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "20% of a class of 30 are aged 13 years or under. How many of the class are over 13 years of age?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "24 students",
      "worked": "$$\\begin{align*}\\text{Number aged 13 or under}&=\\frac{20}{100}\\times30\\\\\\text{Number aged 13 or under}&=6\\\\\\text{Number over 13}&=30-6\\\\\\text{Number over 13}&=24\\end{align*}$$",
      "solutionDiagrams": []
    },
