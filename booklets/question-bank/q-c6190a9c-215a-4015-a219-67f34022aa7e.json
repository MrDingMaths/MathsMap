    "children": [
      {
        "id": "v2-c10bb-p19-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Given $f(x)=4x-7$ and $g(x)=6x+5$, work out the value of $x$ for which $f^{-1}(x)=g^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-31$",
          "worked": "For $f$:\n$$\\begin{align*}y&=4x-7\\\\x&=4y-7\\\\y&=\\frac{x+7}{4}\\\\f^{-1}(x)&=\\frac{x+7}{4}\\end{align*}$$\nFor $g$:\n$$\\begin{align*}y&=6x+5\\\\x&=6y+5\\\\y&=\\frac{x-5}{6}\\\\g^{-1}(x)&=\\frac{x-5}{6}\\end{align*}$$\nEquating the inverses:\n$$\\begin{align*}\\frac{x+7}{4}&=\\frac{x-5}{6}\\\\6x+42&=4x-20\\\\x&=-31\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-c10bb-p19-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Given $h(x)=\\frac{2x+1}{3}$ and $k(x)=3-2x$, work out the value of $x$ for which $h^{-1}(x)=k^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "For $h$:\n$$\\begin{align*}y&=\\frac{2x+1}{3}\\\\x&=\\frac{2y+1}{3}\\\\3x&=2y+1\\\\y&=\\frac{3x-1}{2}\\\\h^{-1}(x)&=\\frac{3x-1}{2}\\end{align*}$$\nFor $k$:\n$$\\begin{align*}y&=3-2x\\\\x&=3-2y\\\\y&=\\frac{3-x}{2}\\\\k^{-1}(x)&=\\frac{3-x}{2}\\end{align*}$$\nEquating the inverses:\n$$\\begin{align*}\\frac{3x-1}{2}&=\\frac{3-x}{2}\\\\3x-1&=3-x\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
