    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q25",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x^2}{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2x}{(1-x^2)^2}$",
          "worked": "Let $u=x^2$ and $v=1-x^2$. Then $u'=2x$ and $v'=-2x$.\n\n$$\\begin{align*}y'&=\\frac{2x(1-x^2)-x^2(-2x)}{(1-x^2)^2}\\\\y'&=\\frac{2x}{(1-x^2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q26",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^2}{3x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x(3x+10)}{(3x+5)^2}$",
          "worked": "Let $u=x^2$ and $v=3x+5$. Then $u'=2x$ and $v'=3$.\n\n$$\\begin{align*}y'&=\\frac{2x(3x+5)-3x^2}{(3x+5)^2}\\\\y'&=\\frac{x(3x+10)}{(3x+5)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q27",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{3x^2}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{3x(x-4)}{(x-2)^2}$",
          "worked": "Let $u=3x^2$ and $v=x-2$. Then $u'=6x$ and $v'=1$.\n\n$$\\begin{align*}y'&=\\frac{6x(x-2)-3x^2}{(x-2)^2}\\\\y'&=\\frac{3x(x-4)}{(x-2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q28",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac{x^2}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{x(x+4)}{(x+2)^2}$",
          "worked": "Let $u=x^2$ and $v=x+2$. Then $u'=2x$ and $v'=1$.\n\n$$\\begin{align*}y'&=\\frac{2x(x+2)-x^2}{(x+2)^2}\\\\y'&=\\frac{x(x+4)}{(x+2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q29",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\dfrac{2x+1}{x^2+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2(1-x-x^2)}{(x^2+1)^2}$",
          "worked": "Let $u=2x+1$ and $v=x^2+1$. Then $u'=2$ and $v'=2x$.\n\n$$\\begin{align*}y'&=\\frac{2(x^2+1)-(2x+1)(2x)}{(x^2+1)^2}\\\\y'&=\\frac{2(1-x-x^2)}{(x^2+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q30",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\dfrac{6x^2}{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{6x(4-x)}{(2-x)^2}$",
          "worked": "Let $u=6x^2$ and $v=2-x$. Then $u'=12x$ and $v'=-1$.\n\n$$\\begin{align*}y'&=\\frac{12x(2-x)-6x^2(-1)}{(2-x)^2}\\\\y'&=\\frac{6x(4-x)}{(2-x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q31",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\dfrac{-5x^2}{3x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{-5x(3x-4)}{(3x-2)^2}$",
          "worked": "Let $u=-5x^2$ and $v=3x-2$. Then $u'=-10x$ and $v'=3$.\n\n$$\\begin{align*}y'&=\\frac{-10x(3x-2)-(-5x^2)(3)}{(3x-2)^2}\\\\y'&=\\frac{-5x(3x-4)}{(3x-2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q32",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\dfrac{3x^2}{x^2+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{24x}{(x^2+4)^2}$",
          "worked": "Let $u=3x^2$ and $v=x^2+4$. Then $u'=6x$ and $v'=2x$.\n\n$$\\begin{align*}y'&=\\frac{6x(x^2+4)-3x^2(2x)}{(x^2+4)^2}\\\\y'&=\\frac{24x}{(x^2+4)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q33",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\dfrac{7x^3}{2x+5}$",
        "layout": "list",
