  "content": {
    "id": "v2-47c15-p39-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "A bike shop reduces the price of all helmets by $20\\%$. A helmet used to cost $\\$65$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-47c15-p39-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the discount.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$13$",
          "worked": "$$\\begin{align*}\\text{Discount} &= 0.20\\times\\$65\\\\\\text{Discount} &= \\$13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-47c15-p39-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the selling price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$52$",
          "worked": "$$\\begin{align*}\\text{Selling-price percentage} &= 100\\%-20\\%=80\\%\\\\\\text{Selling price} &= 0.80\\times\\$65\\\\\\text{Selling price} &= \\$52\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
