    "id": "p48-q7",
    "type": "question",
    "label": "7",
    "prompt": "Mackenzie earns a gross weekly pay of \\$1120. She donated \\$405 to charity this year.\nWhat is Mackenzie’s annual taxable income?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$57 835",
      "worked": "$\\begin{align*}\\text{Annual gross income} &= 1120 \\times 52 \\\\ &= \\$58\\,240 \\\\ \\text{Taxable income} &= 58\\,240 - 405 \\\\ &= \\$57\\,835\\end{align*}$",
