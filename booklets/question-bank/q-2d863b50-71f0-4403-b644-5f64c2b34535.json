  "content": {
    "id": "p54-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Suppose that $P$ is the point $(4,-1)$, $Q$ is the point $(-3,5)$ and $O$ is the origin.\n\nWrite as column vectors:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{OP}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}4\\\\-1\\end{pmatrix}$",
          "worked": "$$\\overrightarrow{OP}=\\begin{pmatrix}4\\\\-1\\end{pmatrix}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p54-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\overrightarrow{OP}-\\overrightarrow{OQ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}11\\\\-7\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}2\\overrightarrow{OP}&=\\begin{pmatrix}8\\\\-2\\end{pmatrix}\\\\\\overrightarrow{OQ}&=\\begin{pmatrix}-3\\\\5\\end{pmatrix}\\\\2\\overrightarrow{OP}-\\overrightarrow{OQ}&=\\begin{pmatrix}8-(-3)\\\\-2-5\\end{pmatrix}=\\begin{pmatrix}11\\\\-7\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p54-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{PQ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}-7\\\\6\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{PQ}&=\\overrightarrow{OQ}-\\overrightarrow{OP}\\\\&=\\begin{pmatrix}-3-4\\\\5-(-1)\\end{pmatrix}\\\\&=\\begin{pmatrix}-7\\\\6\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p54-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\overrightarrow{QP}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}7\\\\-6\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{QP}&=\\overrightarrow{OP}-\\overrightarrow{OQ}\\\\&=\\begin{pmatrix}4-(-3)\\\\(-1)-5\\end{pmatrix}\\\\&=\\begin{pmatrix}7\\\\-6\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
