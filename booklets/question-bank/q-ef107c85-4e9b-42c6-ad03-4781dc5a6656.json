  "content": {
    "id": "p7-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "A letter is chosen at random from the letters of the word SUCCESSION. What is the probability that the letter is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "N?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "There are 10 letter positions in SUCCESSION, including one N.\n\n$$P(N)=\\frac{1}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "S?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "Three of the 10 letters are S.\n\n$$P(S)=\\frac{3}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "a vowel?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "The four vowels are U, E, I and O.\n\n$$\\begin{align*}P(\\text{vowel})&=\\frac{4}{10}\\\\P(\\text{vowel})&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q23-d",
        "type": "part",
        "label": "d",
        "prompt": "not S?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{10}$",
          "worked": "Not S is the complement of S.\n\n$$\\begin{align*}P(\\text{not S})&=1-\\frac{3}{10}\\\\P(\\text{not S})&=\\frac{7}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
