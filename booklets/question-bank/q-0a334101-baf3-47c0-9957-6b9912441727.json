  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each of the following, expressing your answer using positive indices:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{1/3}\\times2^{2/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}2^{1/3}\\times2^{2/3}&=2^{1/3+2/3}\\\\2^{1/3}\\times2^{2/3}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^{1/4}\\div3^{1/2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3^{1/4}}$",
          "worked": "$$\\begin{align*}3^{1/4}\\div3^{1/2}&=3^{1/4-1/2}\\\\3^{1/4}\\div3^{1/2}&=3^{-1/4}\\\\3^{1/4}\\div3^{1/2}&=\\frac{1}{3^{1/4}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$5^{-1/6}\\times5^{2/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{1/2}$",
          "worked": "$$\\begin{align*}5^{-1/6}\\times5^{2/3}&=5^{-1/6+2/3}\\\\5^{-1/6}\\times5^{2/3}&=5^{1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$7^{-2/3}\\times7^{3/2}\\times7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{11/6}$",
          "worked": "$$\\begin{align*}7^{-2/3}\\times7^{3/2}\\times7&=7^{-2/3+3/2+1}\\\\7^{-2/3}\\times7^{3/2}\\times7&=7^{(-4+9+6)/6}\\\\7^{-2/3}\\times7^{3/2}\\times7&=7^{11/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$b^{2/3}\\times b^{1/6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^{5/6}$",
          "worked": "$$\\begin{align*}b^{2/3}\\times b^{1/6}&=b^{2/3+1/6}\\\\b^{2/3}\\times b^{1/6}&=b^{5/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$d^{1/4}\\div d^{2/3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{d^{5/12}}$",
          "worked": "$$\\begin{align*}d^{1/4}\\div d^{2/3}&=d^{1/4-2/3}\\\\d^{1/4}\\div d^{2/3}&=d^{-5/12}\\\\d^{1/4}\\div d^{2/3}&=\\frac{1}{d^{5/12}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$e^{-5/6}\\times e^{1/4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{e^{7/12}}$",
          "worked": "$$\\begin{align*}e^{-5/6}\\times e^{1/4}&=e^{-5/6+1/4}\\\\e^{-5/6}\\times e^{1/4}&=e^{-7/12}\\\\e^{-5/6}\\times e^{1/4}&=\\frac{1}{e^{7/12}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^{-1/2}\\times x^{2/3}\\times x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{7/6}$",
          "worked": "$$\\begin{align*}x^{-1/2}\\times x^{2/3}\\times x&=x^{-1/2+2/3+1}\\\\x^{-1/2}\\times x^{2/3}\\times x&=x^{7/6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{2^{1/3}}{2^{2/3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2^{1/3}}$",
          "worked": "$$\\begin{align*}\\frac{2^{1/3}}{2^{2/3}}&=2^{1/3-2/3}\\\\\\frac{2^{1/3}}{2^{2/3}}&=2^{-1/3}\\\\\\frac{2^{1/3}}{2^{2/3}}&=\\frac{1}{2^{1/3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{3^{1/4}}{3^{1/2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{3^{1/4}}$",
          "worked": "$$\\begin{align*}\\frac{3^{1/4}}{3^{1/2}}&=3^{1/4-1/2}\\\\\\frac{3^{1/4}}{3^{1/2}}&=3^{-1/4}\\\\\\frac{3^{1/4}}{3^{1/2}}&=\\frac{1}{3^{1/4}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{b^{2/3}}{b^{1/6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b^{1/2}$",
          "worked": "$$\\begin{align*}\\frac{b^{2/3}}{b^{1/6}}&=b^{2/3-1/6}\\\\\\frac{b^{2/3}}{b^{1/6}}&=b^{1/2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{d^{1/4}\\times d}{d^{2/3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d^{7/12}$",
          "worked": "$$\\begin{align*}\\frac{d^{1/4}\\times d}{d^{2/3}}&=d^{1/4+1-2/3}\\\\\\frac{d^{1/4}\\times d}{d^{2/3}}&=d^{7/12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
