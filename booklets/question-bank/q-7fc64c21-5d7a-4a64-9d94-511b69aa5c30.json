  "content": {
    "id": "p32-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Show that these functions are even:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=3x^2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=3x^2+2=f(x)$, so $f$ is even.",
          "worked": "$$\\begin{align*}f(-x)&=3(-x)^2+2\\\\f(-x)&=3x^2+2\\\\f(-x)&=f(x).\\end{align*}$$ Hence, $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=5x^4-3x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=5x^4-3x^2+1=f(x)$, so $f$ is even.",
          "worked": "$$\\begin{align*}f(-x)&=5(-x)^4-3(-x)^2+1\\\\f(-x)&=5x^4-3x^2+1\\\\f(-x)&=f(x).\\end{align*}$$ Hence, $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p32-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=(x-3)(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=(x+3)(x-3)=f(x)$, so $f$ is even.",
          "worked": "$$\\begin{align*}f(-x)&=(-x-3)(-x+3)\\\\f(-x)&=[-(x+3)][-(x-3)]\\\\f(-x)&=(x+3)(x-3)\\\\f(-x)&=f(x).\\end{align*}$$ Hence, $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p32-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{2}{3+x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=\\dfrac{2}{3+x^2}=f(x)$, so $f$ is even.",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{2}{3+(-x)^2}\\\\f(-x)&=\\frac{2}{3+x^2}\\\\f(-x)&=f(x).\\end{align*}$$ Hence, $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p32-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=5|x|-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=5|x|-3=f(x)$, so $f$ is even.",
          "worked": "$$\\begin{align*}f(-x)&=5|-x|-3\\\\f(-x)&=5|x|-3\\\\f(-x)&=f(x).\\end{align*}$$ Hence, $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p32-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=x\\sin(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=(-x)(-\\sin x)=f(x)$, so $f$ is even.",
          "worked": "Since $\\sin(-x)=-\\sin x$,\n$$\\begin{align*}f(-x)&=(-x)\\sin(-x)\\\\f(-x)&=(-x)(-\\sin x)\\\\f(-x)&=x\\sin x\\\\f(-x)&=f(x).\\end{align*}$$ Hence, $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
