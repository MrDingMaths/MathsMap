  "content": {
    "id": "p50-task29-32-root",
    "type": "question",
    "label": null,
    "prompt": "Find the minimum value of each of the following quadratic functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p50-task29-32-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x+4)^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum $5$, attained at $x=-4$.",
          "worked": "Since $(x+4)^2\\geq 0$, $y\\geq 5$. Equality holds when $x=-4$, so the minimum value is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p50-task29-32-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(x+2)(x-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum $-16$, attained at $x=2$.\n\nComplete the square: $y=(x-2)^2-16$.",
          "worked": "$$\\begin{align*}y&=x^2-4x-12\\\\y&=(x-2)^2-16\\end{align*}$$\n\nThe graph is concave up, so the minimum value is $-16$, attained at $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p50-task29-32-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^2-4x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum $-1$, attained at $x=2$.",
          "worked": "$$y=(x-2)^2-1$$\n\nThe graph is concave up, so the minimum value is $-1$, attained at $x=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p50-task29-32-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^2+3x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Minimum $-\\frac{17}{4}$, attained at $x=-\\frac{3}{2}$.\n\nComplete the square: $y=\\left(x+\\frac{3}{2}\\right)^2-\\frac{17}{4}$.",
          "worked": "$$\\begin{align*}y&=\\left(x+\\frac{3}{2}\\right)^2-\\frac{9}{4}-2\\\\y&=\\left(x+\\frac{3}{2}\\right)^2-\\frac{17}{4}\\end{align*}$$\n\nThe graph is concave up, so the minimum value is $-\\frac{17}{4}$, attained at $x=-\\frac{3}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
