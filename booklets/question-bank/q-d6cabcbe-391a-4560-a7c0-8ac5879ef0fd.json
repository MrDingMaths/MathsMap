  "content": {
    "id": "p3-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the angle of elevation of the sun when a tree $1.5\\text{ m}$ high casts a shadow of $75\\text{ cm}$. Give your answer to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$63.4^\\circ$",
      "worked": "The shadow is $75\\text{ cm}=0.75\\text{ m}$. Let the angle of elevation be $\\theta$.\n\n$$\\begin{align*}\\tan\\theta&=\\frac{1.5}{0.75}\\\\\\tan\\theta&=2\\\\\\theta&=\\tan^{-1}(2)\\\\\\theta&\\approx63.4^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
