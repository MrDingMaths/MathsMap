  "content": {
    "id": "v2-2-practice-section-slot-11-root",
    "type": "question",
    "label": null,
    "prompt": "A number is chosen from the set of positive integers between 1 and 12 inclusive.\nIn each case, state whether $A$ and $B$ are mutually exclusive.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-2-practice-section-slot-11-slot-11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$A$ is the set of even numbers, and $B$ is the set of factors of 9.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, they are mutually exclusive.",
          "worked": "$$\\begin{align*}A&=\\{2,4,6,8,10,12\\}\\\\B&=\\{1,3,9\\}\\end{align*}$$\nNo number is in both sets, so $A\\cap B=\\varnothing$ and the events are mutually exclusive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-2-practice-section-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$A$ is the set of multiples of 3, and $B$ is the set of factors of 12.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No, they are not mutually exclusive.",
          "worked": "$$\\begin{align*}A&=\\{3,6,9,12\\}\\\\B&=\\{1,2,3,4,6,12\\}\\end{align*}$$\nThe numbers 3, 6 and 12 are in both sets, so $A\\cap B\\neq\\varnothing$ and the events are not mutually exclusive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-2-practice-section-slot-11-slot-11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$A$ is the set of prime numbers, and $B$ is the set of multiples of 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, they are mutually exclusive.",
          "worked": "$$\\begin{align*}A&=\\{2,3,5,7,11\\}\\\\B&=\\{4,8,12\\}\\end{align*}$$\nNo number is in both sets, so $A\\cap B=\\varnothing$ and the events are mutually exclusive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
