      {
        "id": "p16-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(x)=x^2-x$, then $f(1-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$.",
          "worked": "$$\\begin{align*}f(1-x)&=(1-x)^2-(1-x)\\\\f(1-x)&=1-2x+x^2-1+x\\\\f(1-x)&=x^2-x\\\\f(x)&=x^2-x\\end{align*}$$\nBoth sides equal $x^2-x$, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "If $f(x)=x^2$, then $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2\\\\f(-x)&=x^2\\\\f(x)&=x^2\\end{align*}$$\nBoth sides equal $x^2$, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "If $f(x)=x^2+1$, then $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2+1\\\\f(-x)&=x^2+1\\\\f(x)&=x^2+1\\end{align*}$$\nBoth sides equal $x^2+1$, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "If $f(x)=x^2+x$, then $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not an identity (only true when $x=0$).",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2+(-x)\\\\f(-x)&=x^2-x\\\\f(x)&=x^2+x\\end{align*}$$\nThe sides are equal only when\n$$\\begin{align*}x^2-x&=x^2+x\\\\-2x&=0\\\\x&=0.\\end{align*}$$\nThe claim is not an identity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q21-e",
        "type": "part",
        "label": "e",
        "prompt": "If $f(x)=3x-2$, then $f(x+1)=f(x)+3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$.",
          "worked": "$$\\begin{align*}f(x+1)&=3(x+1)-2\\\\f(x+1)&=3x+1\\\\f(x)+3&=(3x-2)+3\\\\f(x)+3&=3x+1\\end{align*}$$\nBoth sides equal $3x+1$, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q21-f",
        "type": "part",
        "label": "f",
        "prompt": "If $f(x)=3x-2$, then $f(2x)=2f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not an identity.",
          "worked": "$$\\begin{align*}f(2x)&=3(2x)-2\\\\f(2x)&=6x-2\\\\2f(x)&=2(3x-2)\\\\2f(x)&=6x-4\\end{align*}$$\nThe sides differ by $2$ for every $x$, so the claim is not an identity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p16-q21-g",
        "type": "part",
        "label": "g",
        "prompt": "If $f(x)=\\dfrac{1}{x}$, then $f\\!\\left(\\dfrac{1}{x}\\right)=x$ for $x\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x\\ne0$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}f\\!\\left(\\frac1x\\right)&=\\frac{1}{\\frac1x}\\\\f\\!\\left(\\frac1x\\right)&=x.\\end{align*}$$\nThe right-hand side is $x$ too, so the claim is true for all $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p16-q21-h",
        "type": "part",
        "label": "h",
        "prompt": "If $f(x)=x+\\dfrac{1}{x}$, then $f\\!\\left(\\dfrac{1}{x}\\right)=f(x)$ for $x\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x\\ne0$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}f\\!\\left(\\frac1x\\right)&=\\frac1x+\\frac{1}{\\frac1x}\\\\f\\!\\left(\\frac1x\\right)&=\\frac1x+x\\\\f\\!\\left(\\frac1x\\right)&=x+\\frac1x\\\\f(x)&=x+\\frac1x.\\end{align*}$$\nBoth sides equal $x+\\frac1x$, so the claim is true for all $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
