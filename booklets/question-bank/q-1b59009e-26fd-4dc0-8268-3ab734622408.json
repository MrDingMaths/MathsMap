                ]
              },
              {
                "id": "p107-task59-62-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Centre distance exceeds the radius sum: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "5>1+2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The centres are $(-5,0)$ and $(0,0)$, with radii $1$ and $2$ respectively.\n\n$$\\begin{align*}d&=|-5-0|\\\\d&=5\\end{align*}$$\n\nSince $d=5>1+2$, the centre distance exceeds the sum of the radii. The circles are separated, so there are 0 points of intersection.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
