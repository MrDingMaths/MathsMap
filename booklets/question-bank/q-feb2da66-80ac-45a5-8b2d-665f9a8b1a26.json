        "answer": {
          "short": "$8,\\ 72,\\ 70,\\ 75,\\ 50,\\ 5$. The final number is $5$.",
          "worked": "$$\\begin{align*}5+3&=8\\\\8\\times9&=72\\\\72-2&=70\\\\70+5&=75\\\\75-25&=50\\\\50\\div10&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
