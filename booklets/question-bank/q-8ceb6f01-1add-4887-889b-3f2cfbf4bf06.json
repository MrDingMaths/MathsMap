      },
      {
        "id": "p3-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$|3x|=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm2$.",
          "worked": "$\\begin{aligned}3x&=\\pm6\\\\x&=\\pm2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p3-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$|x+2|=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=-7$.",
          "worked": "$\\begin{aligned}x+2&=\\pm5\\\\x&=-2\\pm5\\\\x&=3\\text{ or }-7\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p3-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$|x-9|=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=12$ or $x=6$.",
          "worked": "$\\begin{aligned}x-9&=\\pm3\\\\x&=9\\pm3\\\\x&=12\\text{ or }6\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p3-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$|5-x|=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=8$ or $x=2$.",
          "worked": "$|5-x|=|x-5|$.\n\n$\\begin{aligned}x-5&=\\pm3\\\\x&=5\\pm3\\\\x&=8\\text{ or }2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p3-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$|2x+1|=13$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$ or $x=-7$.",
          "worked": "$\\begin{aligned}2x+1&=\\pm13\\\\2x&=-1\\pm13\\\\x&=\\frac{-1\\pm13}{2}\\\\x&=6\\text{ or }-7\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p3-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$|3-2x|=11$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=7$ or $x=-4$.",
          "worked": "$|3-2x|=|2x-3|$.\n\n$\\begin{aligned}2x-3&=\\pm11\\\\2x&=3\\pm11\\\\x&=\\frac{3\\pm11}{2}\\\\x&=7\\text{ or }-4\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left|\\dfrac{x+2}{5}\\right|=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=-7$.",
          "worked": "$\\begin{aligned}\\frac{x+2}{5}&=\\pm1\\\\x+2&=\\pm5\\\\x&=-2\\pm5\\\\x&=3\\text{ or }-7\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p3-q7-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left|\\dfrac{2x+5}{3}\\right|=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $x=-10$.",
          "worked": "$\\begin{aligned}\\frac{2x+5}{3}&=\\pm5\\\\2x+5&=\\pm15\\\\2x&=-5\\pm15\\\\x&=\\frac{-5\\pm15}{2}\\\\x&=5\\text{ or }-10\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
