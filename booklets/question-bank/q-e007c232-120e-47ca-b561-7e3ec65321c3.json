      {
        "id": "p10-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2+\\sqrt5)(2-\\sqrt5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}(2+\\sqrt5)(2-\\sqrt5)&=2^2-(\\sqrt5)^2\\\\(2+\\sqrt5)(2-\\sqrt5)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(5+\\sqrt3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28+10\\sqrt3$",
          "worked": "$$\\begin{align*}(5+\\sqrt3)^2&=25+10\\sqrt3+3\\\\(5+\\sqrt3)^2&=28+10\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-5+2\\sqrt3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37-20\\sqrt3$",
          "worked": "$$\\begin{align*}(-5+2\\sqrt3)^2&=25-20\\sqrt3+12\\\\(-5+2\\sqrt3)^2&=37-20\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(\\sqrt2+\\sqrt3)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5+2\\sqrt6$",
          "worked": "$$\\begin{align*}(\\sqrt2+\\sqrt3)^2&=2+2\\sqrt2\\sqrt3+3\\\\(\\sqrt2+\\sqrt3)^2&=5+2\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(1+\\dfrac1{\\sqrt2}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac32+\\sqrt2$",
          "worked": "$$\\begin{align*}\\left(1+\\frac1{\\sqrt2}\\right)^2&=1+\\frac{2}{\\sqrt2}+\\frac12\\\\\\left(1+\\frac1{\\sqrt2}\\right)^2&=1+\\sqrt2+\\frac12\\\\\\left(1+\\frac1{\\sqrt2}\\right)^2&=\\frac32+\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\sqrt3-\\dfrac1{\\sqrt3}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac43$",
          "worked": "$$\\begin{align*}\\left(\\sqrt3-\\frac1{\\sqrt3}\\right)^2&=3-2\\cdot\\frac{\\sqrt3}{\\sqrt3}+\\frac13\\\\\\left(\\sqrt3-\\frac1{\\sqrt3}\\right)^2&=3-2+\\frac13\\\\\\left(\\sqrt3-\\frac1{\\sqrt3}\\right)^2&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
