  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify each of the following by using the change of base formula. Use any base of your choosing.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\log_5 6)(\\log_6 7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5 7$",
          "worked": "$$\\begin{align*}(\\log_5 6)(\\log_6 7)&=\\frac{\\log 6}{\\log 5}\\frac{\\log 7}{\\log 6}\\\\(\\log_5 6)(\\log_6 7)&=\\log_5 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\log_2 3)(\\log_3 4)(\\log_4 5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 5$",
          "worked": "$$\\begin{align*}(\\log_2 3)(\\log_3 4)(\\log_4 5)&=\\frac{\\log 3}{\\log 2}\\frac{\\log 4}{\\log 3}\\frac{\\log 5}{\\log 4}\\\\(\\log_2 3)(\\log_3 4)(\\log_4 5)&=\\log_2 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
