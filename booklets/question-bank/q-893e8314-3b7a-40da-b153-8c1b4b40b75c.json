        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q9-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Show that $y=x^3-x$ is an odd function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(-x)=-x^3+x=-f(x)$, so the function is odd.",
              "worked": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "p34-q9-a-i-worked-definition",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "right",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Let ",
                        "marks": []
                      },
                      {
                        "type": "math",
                        "latex": "f(x)=x^3-x",
                        "display": false
                      },
                      {
                        "type": "text",
                        "text": ".",
                        "marks": []
                      }
                    ]
                  },
                  {
                    "id": "p34-q9-a-i-worked-calculation",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "right",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "math",
                        "latex": "\\begin{aligned}f(-x)&=(-x)^3-(-x)\\\\f(-x)&=-x^3+x\\\\f(-x)&=-f(x)\\end{aligned}",
                        "display": true
                      }
                    ]
                  },
                  {
                    "id": "p34-q9-a-i-worked-conclusion",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "right",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Therefore the function is odd.",
                        "marks": []
                      }
                    ]
                  }
                ]
              },
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p34-q9-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This function is stretched horizontally by a factor of 2.\nWrite down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\frac18(x^3-4x)$",
              "worked": "Replace $x$ with $\\frac{x}{2}$.\n$$\\begin{aligned}y&=\\left(\\frac{x}{2}\\right)^3-\\frac{x}{2}\\\\y&=\\frac{x^3}{8}-\\frac{x}{2}\\\\y&=\\frac18(x^3-4x)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p34-q9-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Is the new function odd?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes.",
              "worked": "Yes. For $g(x)=\\frac18(x^3-4x)$,\n$$\\begin{aligned}g(-x)&=\\frac18\\bigl((-x)^3-4(-x)\\bigr)\\\\g(-x)&=\\frac18(-x^3+4x)\\\\g(-x)&=-g(x)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p34-q9-b",
        "type": "group",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q9-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Show that $y=1-x^2$ is an even function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(-x)=1-x^2=f(x)$, so the function is even.",
              "worked": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "p34-q9-b-i-worked-definition",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "right",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Let ",
                        "marks": []
                      },
                      {
                        "type": "math",
                        "latex": "f(x)=1-x^2",
                        "display": false
                      },
                      {
                        "type": "text",
                        "text": ".",
                        "marks": []
                      }
                    ]
                  },
                  {
                    "id": "p34-q9-b-i-worked-calculation",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "right",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "math",
                        "latex": "\\begin{aligned}f(-x)&=1-(-x)^2\\\\f(-x)&=1-x^2\\\\f(-x)&=f(x)\\end{aligned}",
                        "display": true
                      }
                    ]
                  },
                  {
                    "id": "p34-q9-b-i-worked-conclusion",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "right",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Therefore the function is even.",
                        "marks": []
                      }
                    ]
                  }
                ]
              },
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p34-q9-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "This function is stretched vertically by a factor of 3.\nWrite down the equation of this new function.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=3(1-x^2)$",
              "worked": "Replace $y$ with $\\frac{y}{3}$.\n$$\\begin{aligned}\\frac{y}{3}&=1-x^2\\\\y&=3(1-x^2)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p34-q9-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Is the new function even?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Yes.",
              "worked": "Yes. For $g(x)=3(1-x^2)$,\n$$\\begin{aligned}g(-x)&=3\\bigl(1-(-x)^2\\bigr)\\\\g(-x)&=3(1-x^2)\\\\g(-x)&=g(x)\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p34-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "What do you conclude about dilations and symmetry from these two examples?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Horizontal and vertical dilations preserve even and odd symmetry.",
          "worked": "Dilations preserve the symmetry shown here: an odd function retains symmetry about the origin, and an even function retains symmetry about the $y$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
