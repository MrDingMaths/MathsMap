    "children": [
      {
        "id": "p23-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3-7x^2+11x-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ 5$",
          "worked": "Let $P(x)=x^3-7x^2+11x-5$.\n$$P(1)=1-7+11-5=0.$$\nLong division by $x-1$ gives\n$$\\begin{align*}P(x)&=(x-1)(x^2-6x+5)\\\\P(x)&=(x-1)^2(x-5).\\end{align*}$$\nThus $(x-1)^2(x-5)=0$, so $x=1,\\ 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p23-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3-x^2-8x+12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,\\ 2$",
          "worked": "Let $P(x)=x^3-x^2-8x+12$.\n$$P(2)=8-4-16+12=0.$$\nLong division by $x-2$ gives\n$$\\begin{align*}P(x)&=(x-2)(x^2+x-6)\\\\P(x)&=(x-2)^2(x+3).\\end{align*}$$\nThus $x=-3,\\ 2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p23-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^4-12x^3+46x^2-60x+25=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ 5$",
          "worked": "Let $P(x)=x^4-12x^3+46x^2-60x+25$.\n$$P(1)=1-12+46-60+25=0.$$\nLong division gives $P(x)=(x-1)Q(x)$, where $Q(x)=x^3-11x^2+35x-25$.\n$$Q(1)=1-11+35-25=0.$$\nDividing again by $x-1$ gives\n$$\\begin{align*}P(x)&=(x-1)^2(x^2-10x+25)\\\\P(x)&=(x-1)^2(x-5)^2.\\end{align*}$$\nThus $x=1,\\ 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      },
      {
        "id": "p23-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^4+x^3-2x^2+4x-24=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,\\ 2$",
          "worked": "Let $P(x)=x^4+x^3-2x^2+4x-24$.\n$$P(2)=16+8-8+8-24=0.$$\nLong division gives $P(x)=(x-2)Q(x)$, where $Q(x)=x^3+3x^2+4x+12$.\n$$Q(-3)=-27+27-12+12=0.$$\nDividing $Q(x)$ by $x+3$ gives\n$$P(x)=(x-2)(x+3)(x^2+4).$$\nSince $x^2+4>0$ for real $x$, the solutions are $x=-3,\\ 2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      },
      {
        "id": "p23-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^5+9x^4+21x^3+19x^2+6x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6,\\ -1,\\ 0$",
          "worked": "Take out $x$ and let $Q(x)=x^4+9x^3+21x^2+19x+6$.\n$$Q(-1)=1-9+21-19+6=0.$$\nLong division gives $Q(x)=(x+1)R(x)$, where $R(x)=x^3+8x^2+13x+6$.\n$$R(-1)=-1+8-13+6=0.$$\nDividing again gives\n$$\\begin{align*}Q(x)&=(x+1)^2(x^2+7x+6)\\\\Q(x)&=(x+1)^3(x+6).\\end{align*}$$\nThe original equation is $x(x+1)^3(x+6)=0$.\nThus $x=-6,\\ -1,\\ 0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p23-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^5-4x^3-2x^2+3x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ 1,\\ 2$",
          "worked": "Let $P(x)=x^5-4x^3-2x^2+3x+2$.\n$$P(1)=1-4-2+3+2=0.$$\nLong division gives $P(x)=(x-1)Q(x)$, where $Q(x)=x^4+x^3-3x^2-5x-2$.\n$$Q(-1)=1-1-3+5-2=0.$$\nDividing gives $Q(x)=(x+1)R(x)$, where $R(x)=x^3-3x-2$.\n$$R(-1)=-1+3-2=0.$$\nDividing once more,\n$$\\begin{align*}R(x)&=(x+1)(x^2-x-2)\\\\R(x)&=(x+1)^2(x-2).\\end{align*}$$\nThus $(x-1)(x+1)^3(x-2)=0$, so $x=-1,\\ 1,\\ 2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 73
      }
