  "content": {
    "id": "p11-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Suppose $\\tan\\theta=0.5$. Find each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan(\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.5$",
          "worked": "$$\\begin{align*}\\tan(\\pi-\\theta)&=-\\tan\\theta\\\\\\tan(\\pi-\\theta)&=-0.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan(-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.5$",
          "worked": "$$\\begin{align*}\\tan(-\\theta)&=-\\tan\\theta\\\\\\tan(-\\theta)&=-0.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5$",
          "worked": "$$\\begin{align*}\\tan(\\pi+\\theta)&=\\tan\\theta\\\\\\tan(\\pi+\\theta)&=0.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan(3\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.5$",
          "worked": "$$\\begin{align*}\\tan(3\\pi-\\theta)&=\\tan(\\pi-\\theta)\\\\\\tan(3\\pi-\\theta)&=-\\tan\\theta\\\\\\tan(3\\pi-\\theta)&=-0.5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
