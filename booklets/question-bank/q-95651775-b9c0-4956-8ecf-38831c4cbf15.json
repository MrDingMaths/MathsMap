      {
        "id": "p38-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2f(x)-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "Dilate vertically by a factor of $2$, then translate down $1$ unit. Since $f(x)=2$,\n$$\\begin{align*}y_{\\mathrm{new}}&=2(2)-1\\\\y_{\\mathrm{new}}&=3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p38-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=4f(x)+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "Dilate vertically by a factor of $4$, then translate up $2$ units. Since $f(x)=2$,\n$$\\begin{align*}y_{\\mathrm{new}}&=4(2)+2\\\\y_{\\mathrm{new}}&=10.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p38-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-f(x)-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "Reflect in the $x$-axis, then translate down $3$ units. Since $f(x)=2$,\n$$\\begin{align*}y_{\\mathrm{new}}&=-(2)-3\\\\y_{\\mathrm{new}}&=-5.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p38-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=-3f(x)+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "Dilate vertically by a factor of $3$ and reflect in the $x$-axis, then translate up $5$ units. Since $f(x)=2$,\n$$\\begin{align*}y_{\\mathrm{new}}&=-3(2)+5\\\\y_{\\mathrm{new}}&=-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
