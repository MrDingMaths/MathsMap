    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Express the parabola $y=x^2-6x+10$ in vertex-form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x-3)^2+1$.",
          "worked": "$$\\begin{align*}y&=x^2-6x+10\\\\y&=(x-3)^2-9+10\\\\y&=(x-3)^2+1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p10-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, explain why the parabola is always above the $x$-axis, without drawing a sketch.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Since $(x-3)^2\\geq0$, $y=(x-3)^2+1\\geq1>0$.",
          "worked": "For every real $x$, $(x-3)^2\\geq0$. Therefore $y=(x-3)^2+1\\geq1$, so every point on the parabola is above the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q14-c",
        "type": "group",
        "label": "c",
        "prompt": "Use a similar technique to show that the following parabolas are either always above or below the $x$-axis.",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q14-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$y=x^2-4x+6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=(x-2)^2+2\\geq2>0$: always above the $x$-axis.",
              "worked": "$$\\begin{align*}y&=x^2-4x+6\\\\y&=(x-2)^2-4+6\\\\y&=(x-2)^2+2.\\end{align*}$$\nSince $(x-2)^2\\geq0$, $y\\geq2>0$. The parabola is always above the $x$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p10-q14-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$y=-x^2+2x-4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-(x-1)^2-3\\leq-3<0$: always below the $x$-axis.",
              "worked": "$$\\begin{align*}y&=-x^2+2x-4\\\\y&=-(x^2-2x)-4\\\\y&=-\\bigl((x-1)^2-1\\bigr)-4\\\\y&=-(x-1)^2-3.\\end{align*}$$\nSince $-(x-1)^2\\leq0$, $y\\leq-3<0$. The parabola is always below the $x$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      }
    ]
  },
