  "content": {
    "id": "p8-q13-root",
    "type": "question",
    "label": "",
    "prompt": "A computer can access its memory in $24\\ \\mathrm{ns}$. Convert this to microseconds.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.024\\ \\mu\\mathrm{s}$",
      "worked": "Microseconds are a larger unit than nanoseconds, so divide by $1000$.\n$$\\begin{align*}24\\ \\mathrm{ns}&=(24\\div1000)\\ \\mu\\mathrm{s}\\\\&=0.024\\ \\mu\\mathrm{s}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 16
  },
