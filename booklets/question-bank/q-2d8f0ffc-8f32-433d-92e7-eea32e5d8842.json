  "content": {
    "id": "p15-ch9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Simplify each expression, writing your answers with positive powers.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-ch9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(a^3)^2\\times a^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^4$",
          "worked": "$\\begin{align*}(a^3)^2\\times a^{-2}&=a^{6-2}\\\\(a^3)^2\\times a^{-2}&=a^4\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-ch9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2x^2y)^3\\times3xy^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24x^7y^5$",
          "worked": "$\\begin{align*}(2x^2y)^3\\times3xy^2&=8x^6y^3\\times3xy^2\\\\(2x^2y)^3\\times3xy^2&=24x^7y^5\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-ch9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{a}{b}\\right)^2\\times b^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2b$",
          "worked": "$\\begin{align*}\\left(\\frac{a}{b}\\right)^2\\times b^3&=\\frac{a^2b^3}{b^2}\\\\\\left(\\frac{a}{b}\\right)^2\\times b^3&=a^2b\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-ch9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a^{-2}b^3}{a^3b^4}\\times\\frac{a^2b^3}{ab^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{a^4}$",
          "worked": "$\\begin{align*}\\frac{a^{-2}b^3}{a^3b^4}\\times\\frac{a^2b^3}{ab^2}&=a^{-2-3+2-1}b^{3-4+3-2}\\\\\\frac{a^{-2}b^3}{a^3b^4}\\times\\frac{a^2b^3}{ab^2}&=a^{-4}b^0\\\\\\frac{a^{-2}b^3}{a^3b^4}\\times\\frac{a^2b^3}{ab^2}&=\\frac{1}{a^4}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-ch9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{8x^4y^2}{4x^3y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2xy$",
          "worked": "$\\begin{align*}\\frac{8x^4y^2}{4x^3y}&=2x^{4-3}y^{2-1}\\\\\\frac{8x^4y^2}{4x^3y}&=2xy\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-ch9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{3x^2y^3}{9x^3y}\\times\\frac{6xy}{y^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2y$",
          "worked": "$\\begin{align*}\\frac{3x^2y^3}{9x^3y}\\times\\frac{6xy}{y^2}&=\\frac{18x^3y^4}{9x^3y^3}\\\\\\frac{3x^2y^3}{9x^3y}\\times\\frac{6xy}{y^2}&=2y\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-ch9-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{12xy^2}{x^2y}\\div\\frac{6x^3y}{y^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2y^3}{x^4}$",
          "worked": "$\\begin{align*}\\frac{12xy^2}{x^2y}\\div\\frac{6x^3y}{y^3}&=\\frac{12xy^2}{x^2y}\\times\\frac{y^3}{6x^3y}\\\\\\frac{12xy^2}{x^2y}\\div\\frac{6x^3y}{y^3}&=\\frac{12xy^5}{6x^5y^2}\\\\\\frac{12xy^2}{x^2y}\\div\\frac{6x^3y}{y^3}&=\\frac{2y^3}{x^4}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-ch9-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{ab^2}{a^3b^{-2}}\\div\\frac{a^2b^{-1}}{a^3b^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{b^8}{a}$",
          "worked": "$\\begin{align*}\\frac{ab^2}{a^3b^{-2}}\\div\\frac{a^2b^{-1}}{a^3b^3}&=a^{-2}b^4\\div(a^{-1}b^{-4})\\\\\\frac{ab^2}{a^3b^{-2}}\\div\\frac{a^2b^{-1}}{a^3b^3}&=a^{-1}b^8\\\\\\frac{ab^2}{a^3b^{-2}}\\div\\frac{a^2b^{-1}}{a^3b^3}&=\\frac{b^8}{a}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-ch9-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x^2y^3}{x^{-1}y^2}\\times\\frac{x^{-3}y^2}{x^2y^{-1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y^4}{x^2}$",
          "worked": "$\\begin{align*}\\frac{x^2y^3}{x^{-1}y^2}\\times\\frac{x^{-3}y^2}{x^2y^{-1}}&=x^3y\\times x^{-5}y^3\\\\\\frac{x^2y^3}{x^{-1}y^2}\\times\\frac{x^{-3}y^2}{x^2y^{-1}}&=x^{-2}y^4\\\\\\frac{x^2y^3}{x^{-1}y^2}\\times\\frac{x^{-3}y^2}{x^2y^{-1}}&=\\frac{y^4}{x^2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
