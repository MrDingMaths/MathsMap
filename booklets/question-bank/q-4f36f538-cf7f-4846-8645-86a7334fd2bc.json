  "content": {
    "id": "p29-q8-root",
    "type": "question",
    "label": null,
    "prompt": "The length of a rectangular lawn is 15 m more than four times its width.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "If $x$ m is the width of the lawn, express the length of the lawn in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x+15)\\text{ m}$",
          "worked": "Four times the width is $4x$ m, so the length is $(4x+15)$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p29-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "If the perimeter of the lawn is 265 m, find the length and width of the lawn.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Length $109\\text{ m}$; width $23.5\\text{ m}$.",
          "worked": "$$\\begin{align*}2x+2(4x+15)&=265\\\\10x+30&=265\\\\10x&=235\\\\x&=23.5\\end{align*}$$\nThe width is $23.5$ m. The length is $4(23.5)+15=109$ m.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
