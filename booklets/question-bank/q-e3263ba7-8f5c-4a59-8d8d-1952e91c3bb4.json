  "content": {
    "id": "p11-p1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the domain of\n$$f(x)=\\frac{\\sqrt{2-x}+\\sqrt{2+x}}{4-x^2}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-2<x<2$.",
      "worked": "Both square roots must be defined:\n$$\\begin{align*}2-x&\\ge0\\\\x&\\le2\\\\2+x&\\ge0\\\\x&\\ge-2.\\end{align*}$$\nThe denominator must also be nonzero:\n$$\\begin{align*}4-x^2&\\ne0\\\\x&\\ne-2,\\ 2.\\end{align*}$$\nCombining these conditions, the domain is $(-2,2)$.",
      "solutionDiagrams": []
    },
