  "content": {
    "id": "p37-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the volume of a cone having slant length $5\\,\\mathrm{cm}$ and a radius of $3\\,\\mathrm{cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\pi\\,\\mathrm{cm}^3$",
      "worked": "$$\\begin{align*}h&=\\sqrt{5^2-3^2}\\\\h&=4\\ \\mathrm{cm}\\\\V&=\\frac13\\pi r^2h\\\\V&=\\frac13\\pi(3)^2(4)\\\\V&=12\\pi\\ \\mathrm{cm}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
