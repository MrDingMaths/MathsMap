    "answer": {
      "short": "$80\\text{ kg/person}$",
      "worked": "$$\\begin{align*}\\frac{1600\\text{ kg}}{20\\text{ people}}&=\\frac{(1600\\div20)\\text{ kg}}{(20\\div20)\\text{ people}}\\\\&=\\frac{80\\text{ kg}}{1\\text{ person}}\\\\&=80\\text{ kg/person}\\end{align*}$$",
      "solutionDiagrams": []
    },
