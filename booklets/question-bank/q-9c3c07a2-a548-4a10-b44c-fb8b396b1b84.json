  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Determine how many integers lie in each of the following intervals:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$[9,99]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$91$",
          "worked": "The integers are $9,10,\\ldots,99$. Their number is $99-9+1=91$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$[8,88)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80$",
          "worked": "The integers are $8,9,\\ldots,87$, since $88$ is excluded. Their number is $87-8+1=80$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$(7,77)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$69$",
          "worked": "Both endpoints are excluded, so the integers are $8,9,\\ldots,76$. Their number is $76-8+1=69$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
