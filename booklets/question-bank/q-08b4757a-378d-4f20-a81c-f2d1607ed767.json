      {
        "id": "p102-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the total distance walked by the three students?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35\\frac{47}{48}\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Total laps}&=4\\frac{1}{3}+5\\frac{1}{2}+3\\frac{1}{4}\\\\\\text{Total laps}&=\\frac{13}{3}+\\frac{11}{2}+\\frac{13}{4}\\\\\\text{Total laps}&=\\frac{52}{12}+\\frac{66}{12}+\\frac{39}{12}\\\\\\text{Total laps}&=\\frac{157}{12}\\\\\\text{Total distance}&=\\frac{157}{12}\\times\\frac{11}{4}\\\\\\text{Total distance}&=\\frac{1727}{48}\\\\\\text{Total distance}&=35\\frac{47}{48}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p102-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "How much farther than Benjamin did Nathan walk?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\frac{5}{24}\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Lap difference}&=5\\frac{1}{2}-4\\frac{1}{3}\\\\\\text{Lap difference}&=\\frac{11}{2}-\\frac{13}{3}\\\\\\text{Lap difference}&=\\frac{33}{6}-\\frac{26}{6}\\\\\\text{Lap difference}&=\\frac{7}{6}\\\\\\text{Distance difference}&=\\frac{7}{6}\\times\\frac{11}{4}\\\\\\text{Distance difference}&=\\frac{77}{24}\\\\\\text{Distance difference}&=3\\frac{5}{24}\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
