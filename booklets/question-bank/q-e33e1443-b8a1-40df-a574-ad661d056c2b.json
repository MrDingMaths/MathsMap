  "content": {
    "id": "p71-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Each of 10 cards has a letter written on it from A to J. If 3 cards are selected in order at random, find the probability that they spell out CAB.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{10\\times9\\times8}=\\dfrac{1}{720}$",
      "worked": "There are $10\\times9\\times8$ ordered selections without replacement. Only CAB is favourable.\n$$\\begin{aligned}P(\\text{CAB})&=\\frac{1}{10\\times9\\times8}\\\\&=\\frac{1}{720}.\\end{aligned}$$",
      "solutionDiagrams": []
    },
