  "content": {
    "id": "p32-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Kate walks due east for a distance of $3.0\\text{ km}$, turns $120^\\circ$ to her left and then walks $4.0\\text{ km}$ in the new direction. How far is Kate then from her starting point?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{13}\\text{ km}$",
      "worked": "The included angle at the turning point is $180^\\circ-120^\\circ=60^\\circ$. Let $d$ kilometres be the distance from the starting point.\n$$\\begin{align*}d^2&=3^2+4^2-2(3)(4)\\cos60^\\circ\\\\d^2&=9+16-12\\\\d^2&=13\\\\d&=\\sqrt{13}.\\end{align*}$$\nKate is $\\sqrt{13}\\text{ km}$ from her starting point.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
