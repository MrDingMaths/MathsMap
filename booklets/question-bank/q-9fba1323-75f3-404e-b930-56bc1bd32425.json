    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Consider the parabola $y=2(x-h)^2+3$. Find the value of $h$ if the $y$-intercept is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
