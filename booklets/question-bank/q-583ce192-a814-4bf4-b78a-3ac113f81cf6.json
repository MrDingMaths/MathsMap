  "content": {
    "id": "p12-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "The side length of a square is $l$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Write a formula to find the perimeter, $P$, of the square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=4l$",
          "worked": "A square has four equal sides.\n$$P=4l$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the formula to find $P$ when $l=23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=92$",
          "worked": "$$\\begin{align*}P&=4l\\\\P&=4(23)\\\\P&=92\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the formula to form and solve an equation to find $l$ when $P=23$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$l=5.75$",
          "worked": "$$\\begin{align*}P&=4l\\\\23&=4l\\\\l&=\\frac{23}{4}\\\\l&=5.75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
