    "children": [
      {
        "id": "v2-b4147-p10-practice-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $y=\\sin 2x$ is a solution of $y''+4y=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y''=-4\\sin2x$, so $y''+4y=-4\\sin2x+4\\sin2x=0$.",
          "worked": "$$\\begin{align*}y&=\\sin2x\\\\y'&=2\\cos2x\\\\y''&=-4\\sin2x.\\end{align*}$$\n$$\\begin{align*}\\text{LHS}&=y''+4y\\\\&=-4\\sin2x+4\\sin2x\\\\&=0=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-b4147-p10-practice-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "For a solution of $y''+4y=0$, find $y''$ at a point where $y=5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y''=-20$.",
          "worked": "$$\\begin{align*}y''&=-4y\\\\&=-4(5)\\\\&=-20.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-b4147-p10-practice-slot-3-slot-3-c",
        "type": "part",
        "label": "c",
        "prompt": "If $y=f(x)$ is a solution of this DE, what does the equation say about $f''(x)$? Answer in terms of a transformation of $f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(x)=-4f(x)$: the graph of $f''$ is the graph of $f$ reflected in the $x$-axis and dilated vertically by a factor of $4$.",
          "worked": "$$\\begin{align*}f''(x)+4f(x)&=0\\\\f''(x)&=-4f(x).\\end{align*}$$\nThus the graph of $f''$ is the graph of $f$ reflected in the $x$-axis and dilated vertically (from the $x$-axis) by a factor of $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
