  "content": {
    "id": "p20-q9-content",
    "type": "question",
    "label": "9",
    "prompt": "What sum of money needs to be invested now to accumulate a total of $\\$19600$ at an interest rate of 8% p.a. compounded weekly for 3 years? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$15\\,420.75$",
      "worked": "Using 52 weeks per year, $r=\\frac{0.08}{52}$ and $n=3\\times52=156$.\n\n$$\\begin{align*}FV&=PV(1+r)^n\\\\19600&=PV\\left(1+\\frac{0.08}{52}\\right)^{156}\\\\PV&=\\frac{19600}{\\left(1+\\frac{0.08}{52}\\right)^{156}}\\\\PV&\\approx\\$15\\,420.75\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
