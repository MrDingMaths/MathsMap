        "type": "part",
        "label": "a",
        "prompt": "Differentiate $y=e^{\\cos x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\sin x\\,e^{\\cos x}$",
          "worked": "$$\\begin{align*}y'&=e^{\\cos x}\\times(-\\sin x)\\\\y'&=-\\sin x\\,e^{\\cos x}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find, in the domain $0\\le x\\le 2\\pi$, the $x$-coordinates of the points on the curve $y=e^{\\cos x}$ where the tangent is horizontal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\pi,2\\pi$",
          "worked": "A horizontal tangent has gradient $0$.\n\n$$-\\sin x\\,e^{\\cos x}=0$$\n\nSince $e^{\\cos x}>0$, we need $\\sin x=0$.\n\nIn $0\\le x\\le 2\\pi$,\n\n$$x=0,\\pi,2\\pi.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
