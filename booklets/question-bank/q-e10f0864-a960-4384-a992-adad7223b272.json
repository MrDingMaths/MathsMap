  "content": {
    "id": "p17-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider the quadratic inequality $x^2+2x+c<0$. The solution to this inequality is $-3<x<1$. Find $c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$c=-3$.",
      "worked": "The upward-opening parabola is negative between its intercepts, so its roots are $-3$ and $1$. Its leading coefficient is $1$.\n$$\\begin{align*}x^2+2x+c&=(x+3)(x-1)\\\\x^2+2x+c&=x^2+2x-3\\\\c&=-3.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
