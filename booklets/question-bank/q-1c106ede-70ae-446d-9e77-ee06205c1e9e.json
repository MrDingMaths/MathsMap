        "label": "a",
        "prompt": "$\\frac{1}{x}+\\frac{1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x+1}{x(x+1)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x}+\\frac{1}{x+1}&=\\frac{x+1+x}{x(x+1)}\\\\\\frac{1}{x}+\\frac{1}{x+1}&=\\frac{2x+1}{x(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{x}-\\frac{1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{x(x+1)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x}-\\frac{1}{x+1}&=\\frac{x+1-x}{x(x+1)}\\\\\\frac{1}{x}-\\frac{1}{x+1}&=\\frac{1}{x(x+1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{x+1}+\\frac{1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{(x+1)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x+1}+\\frac{1}{x-1}&=\\frac{x-1+x+1}{(x+1)(x-1)}\\\\\\frac{1}{x+1}+\\frac{1}{x-1}&=\\frac{2x}{(x+1)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{x-3}+\\frac{3}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x-13}{(x-3)(x-2)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x-3}+\\frac{3}{x-2}&=\\frac{2(x-2)+3(x-3)}{(x-3)(x-2)}\\\\\\frac{2}{x-3}+\\frac{3}{x-2}&=\\frac{2x-4+3x-9}{(x-3)(x-2)}\\\\\\frac{2}{x-3}+\\frac{3}{x-2}&=\\frac{5x-13}{(x-3)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3}{x+1}-\\frac{2}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x-5}{(x+1)(x-1)}$",
          "worked": "$$\\begin{align*}\\frac{3}{x+1}-\\frac{2}{x-1}&=\\frac{3(x-1)-2(x+1)}{(x+1)(x-1)}\\\\\\frac{3}{x+1}-\\frac{2}{x-1}&=\\frac{3x-3-2x-2}{(x+1)(x-1)}\\\\\\frac{3}{x+1}-\\frac{2}{x-1}&=\\frac{x-5}{(x+1)(x-1)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2}{x-2}-\\frac{2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{(x-2)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{2}{x-2}-\\frac{2}{x+3}&=\\frac{2(x+3)-2(x-2)}{(x-2)(x+3)}\\\\\\frac{2}{x-2}-\\frac{2}{x+3}&=\\frac{2x+6-2x+4}{(x-2)(x+3)}\\\\\\frac{2}{x-2}-\\frac{2}{x+3}&=\\frac{10}{(x-2)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
