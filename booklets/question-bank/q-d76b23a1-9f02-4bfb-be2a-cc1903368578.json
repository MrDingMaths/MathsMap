  "content": {
    "id": "p11-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Fully factorise each of the following by making an appropriate substitution:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2x-1)^2-3(2x-1)-18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+1)(2x-7)$",
          "worked": "Let $y=2x-1$.\n$$\\begin{align*}(2x-1)^2-3(2x-1)-18 &= y^2-3y-18\\\\(2x-1)^2-3(2x-1)-18 &= (y-6)(y+3)\\\\(2x-1)^2-3(2x-1)-18 &= (2x-7)(2x+2)\\\\(2x-1)^2-3(2x-1)-18 &= 2(x+1)(2x-7).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3x-2)^2+2(3x-2)-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2)(3x-4)$",
          "worked": "Let $y=3x-2$.\n$$\\begin{align*}(3x-2)^2+2(3x-2)-8 &= y^2+2y-8\\\\(3x-2)^2+2(3x-2)-8 &= (y+4)(y-2)\\\\(3x-2)^2+2(3x-2)-8 &= (3x+2)(3x-4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(5x+2)^2+9(5x+2)+18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(5x+8)(x+1)$",
          "worked": "Let $y=5x+2$.\n$$\\begin{align*}(5x+2)^2+9(5x+2)+18 &= y^2+9y+18\\\\(5x+2)^2+9(5x+2)+18 &= (y+6)(y+3)\\\\(5x+2)^2+9(5x+2)+18 &= (5x+8)(5x+5)\\\\(5x+2)^2+9(5x+2)+18 &= 5(5x+8)(x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2x-3)^2+7(2x-3)+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x(2x+1)$",
          "worked": "Let $y=2x-3$.\n$$\\begin{align*}(2x-3)^2+7(2x-3)+12 &= y^2+7y+12\\\\(2x-3)^2+7(2x-3)+12 &= (y+3)(y+4)\\\\(2x-3)^2+7(2x-3)+12 &= (2x)(2x+1)\\\\(2x-3)^2+7(2x-3)+12 &= 2x(2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
