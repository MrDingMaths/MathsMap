  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve each of the following equations:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^n=\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac12$",
          "worked": "$$\\begin{align*}2^n&=2^{1/2}\\\\n&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^n=\\sqrt[3]{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac13$",
          "worked": "$$\\begin{align*}5^n&=5^{1/3}\\\\n&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{n+1}=\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-\\frac12$",
          "worked": "$$\\begin{align*}3^{n+1}&=3^{1/2}\\\\n+1&=\\frac12\\\\n&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$7^{n-1}=\\sqrt[3]{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\frac43$",
          "worked": "$$\\begin{align*}7^{n-1}&=7^{1/3}\\\\n-1&=\\frac13\\\\n&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p15-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$25^{n+1}=5\\sqrt{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-\\frac14$",
          "worked": "$$\\begin{align*}(5^2)^{n+1}&=5\\times5^{1/2}\\\\5^{2n+2}&=5^{3/2}\\\\2n+2&=\\frac32\\\\2n&=-\\frac12\\\\n&=-\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p15-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{1}{4^n}=8\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=-\\frac74$",
          "worked": "$$\\begin{align*}\\frac{1}{(2^2)^n}&=2^3\\times2^{1/2}\\\\2^{-2n}&=2^{7/2}\\\\-2n&=\\frac72\\\\n&=-\\frac74\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
