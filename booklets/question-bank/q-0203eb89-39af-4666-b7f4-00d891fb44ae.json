  "content": {
    "id": "p7-q22-root",
    "type": "question",
    "label": "",
    "prompt": "The distance, in metres, travelled by an object is given by the function $d(t)=2t^2+t$ where $t\\geq 0$ seconds.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the average speed over $1\\leq t\\leq 1.1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.2\\text{ m s}^{-1}$",
          "worked": "$d(1)=3$ and $d(1.1)=3.52$. \n\n$$\\begin{align*}v_{\\mathrm{avg}}&=\\frac{d(1.1)-d(1)}{1.1-1}\\\\v_{\\mathrm{avg}}&=\\frac{3.52-3}{0.1}\\\\v_{\\mathrm{avg}}&=5.2\\text{ m s}^{-1}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the average speed over $1\\leq t\\leq 1.01$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.02\\text{ m s}^{-1}$",
          "worked": "$d(1)=3$ and $d(1.01)=3.0502$. \n\n$$\\begin{align*}v_{\\mathrm{avg}}&=\\frac{d(1.01)-d(1)}{1.01-1}\\\\v_{\\mathrm{avg}}&=\\frac{3.0502-3}{0.01}\\\\v_{\\mathrm{avg}}&=5.02\\text{ m s}^{-1}\\end{align*}$$\n\n",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "Estimate the instantaneous speed when $t=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\text{ m s}^{-1}$. The average speeds approach this value as the interval shrinks towards $t=1$.",
          "worked": "The average speeds over $[1,1.1]$ and $[1,1.01]$ are $5.2$ and $5.02\\text{ m s}^{-1}$. As the interval shrinks towards $t=1$, the secant gradient approaches the tangent gradient. Hence the instantaneous speed is approximately $5\\text{ m s}^{-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
