  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt{2}-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{2}-1}&=\\frac{1}{\\sqrt{2}-1}\\times\\frac{\\sqrt{2}+1}{\\sqrt{2}+1}\\\\\\frac{1}{\\sqrt{2}-1}&=\\frac{\\sqrt{2}+1}{2-1}\\\\\\frac{1}{\\sqrt{2}-1}&=1+\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p20-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2+\\sqrt{5}}{2-\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9-4\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\frac{2+\\sqrt{5}}{2-\\sqrt{5}}&=\\frac{2+\\sqrt{5}}{2-\\sqrt{5}}\\times\\frac{2+\\sqrt{5}}{2+\\sqrt{5}}\\\\\\frac{2+\\sqrt{5}}{2-\\sqrt{5}}&=\\frac{(2+\\sqrt{5})^2}{4-5}\\\\\\frac{2+\\sqrt{5}}{2-\\sqrt{5}}&=\\frac{4+4\\sqrt{5}+5}{-1}\\\\\\frac{2+\\sqrt{5}}{2-\\sqrt{5}}&=-9-4\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p20-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{4+\\sqrt{2}}{1+\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2+3\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\frac{4+\\sqrt{2}}{1+\\sqrt{2}}&=\\frac{4+\\sqrt{2}}{1+\\sqrt{2}}\\times\\frac{\\sqrt{2}-1}{\\sqrt{2}-1}\\\\\\frac{4+\\sqrt{2}}{1+\\sqrt{2}}&=\\frac{4\\sqrt{2}-4+2-\\sqrt{2}}{2-1}\\\\\\frac{4+\\sqrt{2}}{1+\\sqrt{2}}&=-2+3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p20-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{3}{\\sqrt{6}-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+\\frac{3\\sqrt{6}}{2}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{6}-2}&=\\frac{3}{\\sqrt{6}-2}\\times\\frac{\\sqrt{6}+2}{\\sqrt{6}+2}\\\\\\frac{3}{\\sqrt{6}-2}&=\\frac{3\\sqrt{6}+6}{6-4}\\\\\\frac{3}{\\sqrt{6}-2}&=3+\\frac{3\\sqrt{6}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
