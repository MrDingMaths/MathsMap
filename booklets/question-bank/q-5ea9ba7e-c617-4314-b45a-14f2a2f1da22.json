        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "A 10% increase followed by a 10% decrease",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.00\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.10\\times0.90\\\\\\text{Combined multiplier}&=0.99\\\\\\text{Percentage decrease}&=(1-0.99)\\times100\\%\\\\\\text{Percentage decrease}&=1.00\\%\\end{align*}$$",
