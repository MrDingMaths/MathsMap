        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18.72\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=1.06\\times1.12\\\\\\text{Combined multiplier}&=1.1872\\\\\\text{Percentage increase}&=(1.1872-1)\\times100\\%\\\\\\text{Percentage increase}&=18.72\\%\\end{align*}$$",
