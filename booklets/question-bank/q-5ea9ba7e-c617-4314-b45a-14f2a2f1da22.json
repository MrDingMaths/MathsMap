          "short": "$22.72\\%$ decrease",
          "worked": "$$\\begin{align*}\\text{Combined multiplier}&=0.84\\times0.92\\\\\\text{Combined multiplier}&=0.7728\\\\\\text{Percentage decrease}&=(1-0.7728)\\times100\\%\\\\\\text{Percentage decrease}&=22.72\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
