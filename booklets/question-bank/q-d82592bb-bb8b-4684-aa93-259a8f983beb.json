  "content": {
    "id": "p4-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Convert these to decimals. Remember that $33\\frac{1}{3}\\%$ is the same as $\\frac{1}{3}$, which is the same as $0.\\dot{3}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$33\\frac{1}{3}\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.\\dot{3}$",
          "worked": "$$\\begin{align*}33\\frac{1}{3}\\% &= \\frac{100}{3}\\div100\\\\&=\\frac{1}{3}\\\\&=0.\\dot{3}\\end{align*}$$",
