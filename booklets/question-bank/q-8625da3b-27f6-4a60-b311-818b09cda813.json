        "id": "p10-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a$, if $P(x)=x^4-3x^2-5x+a$ and $P(2)=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=7$",
          "worked": "$$\\begin{align*}P(2)&=2^4-3(2)^2-5(2)+a\\\\P(2)&=16-12-10+a\\\\1&=-6+a\\\\a&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $b$, if $Q(x)=x^3-3x^2+bx+6$ and $Q(-1)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=2$",
          "worked": "$$\\begin{align*}Q(-1)&=(-1)^3-3(-1)^2+b(-1)+6\\\\Q(-1)&=-1-3-b+6\\\\0&=2-b\\\\b&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
