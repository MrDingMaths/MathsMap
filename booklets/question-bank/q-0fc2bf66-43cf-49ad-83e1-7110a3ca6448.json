  "content": {
    "id": "p18-r4-root",
    "type": "question",
    "label": "4",
    "prompt": "Re-write the following intervals using inequalities.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-r4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x\\in[-2,\\infty)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ge -2$",
          "worked": "The square bracket includes $-2$, and the interval extends to positive infinity. Hence $x\\ge -2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-r4-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\in(-1,4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x\\le 4$",
          "worked": "The round bracket excludes $-1$, and the square bracket includes $4$. Hence $-1<x\\le 4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-r4-c",
        "type": "part",
        "label": "c",
        "prompt": "$x\\in(-\\infty,6]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le 6$",
          "worked": "The interval extends from negative infinity up to and including $6$. Hence $x\\le 6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
