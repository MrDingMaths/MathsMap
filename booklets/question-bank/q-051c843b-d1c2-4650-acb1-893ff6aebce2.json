  "content": {
    "id": "p49-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A particle is projected from the origin $O$ with initial velocity vector $3\\mathbf{i}+\\mathbf{j}$. Use $g=10\\text{ m/s}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the initial speed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{10}\\text{ m/s}$",
          "worked": "$$\\begin{aligned}V&=\\sqrt{3^2+1^2}\\\\&=\\sqrt{10}\\text{ m/s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p49-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the parabolic path has parametric equations $x=3t$ and $y=t-5t^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3t$, $y=t-5t^2$.",
          "worked": "The initial velocity components are $\\dot{x}(0)=3$ and $\\dot{y}(0)=1$, and $x(0)=y(0)=0$.\n$$\\begin{aligned}\\ddot{x}&=0\\\\\\dot{x}&=3\\\\x&=3t\\end{aligned}$$\n$$\\begin{aligned}\\ddot{y}&=-10\\\\\\dot{y}&=1-10t\\\\y&=t-5t^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p49-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence show that the Cartesian equation is $9y=3x-5x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9y=3x-5x^2$.",
          "worked": "$$t=\\frac{x}{3}$$\n$$\\begin{aligned}y&=\\frac{x}{3}-5\\left(\\frac{x}{3}\\right)^2\\\\y&=\\frac{x}{3}-\\frac{5x^2}{9}\\\\9y&=3x-5x^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p49-q8-d",
        "type": "group",
        "label": "d",
        "prompt": "Find, to 1 d.p., the direction of motion when:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p49-q8-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$x=0.15$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9.5^\\circ$ above the horizontal.",
              "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=\\frac13-\\frac{10x}{9}\\\\\\left.\\frac{dy}{dx}\\right|_{x=0.15}&=\\frac13-\\frac{10(0.15)}9\\\\&=\\frac13-\\frac16\\\\&=\\frac16\\end{aligned}$$\n$$\\phi=\\tan^{-1}\\left(\\frac16\\right)\\approx9.5^\\circ$$\nThe direction is $9.5^\\circ$ above the horizontal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p49-q8-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$t=0.15$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$9.5^\\circ$ below the horizontal.",
              "worked": "At $t=0.15$,\n$$\\begin{aligned}\\dot{x}&=3\\\\\\dot{y}&=1-10(0.15)\\\\&=-\\frac12\\end{aligned}$$\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{\\dot{y}}{\\dot{x}}\\\\&=\\frac{-1/2}{3}\\\\&=-\\frac16\\end{aligned}$$\nThe direction is $\\tan^{-1}(\\frac{1}{6})\\approx9.5^\\circ$ below the horizontal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
    ]
  },
