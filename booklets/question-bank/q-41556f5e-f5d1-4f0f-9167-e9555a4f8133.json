        "prompt": "Find the area of a rectangle with height $\\sqrt{7}$ cm and width $\\sqrt{3}$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{21}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=hw\\\\A&=\\sqrt{7}\\times\\sqrt{3}\\\\A&=\\sqrt{21}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of a triangle with base $\\sqrt{6}$ cm and height $\\sqrt{5}$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{30}}{2}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{1}{2}bh\\\\A&=\\frac{1}{2}\\times\\sqrt{6}\\times\\sqrt{5}\\\\A&=\\frac{\\sqrt{30}}{2}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the area of a square with side length $\\sqrt{17}$ cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$17\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=s^2\\\\A&=(\\sqrt{17})^2\\\\A&=17\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "A square has area $11\\text{ cm}^2$. What is the length of each side?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{11}\\text{ cm}$",
          "worked": "Let $s$ be the side length in centimetres.\n$$\\begin{align*}s^2&=11\\\\s&=\\sqrt{11}\\end{align*}$$\nEach side is $\\sqrt{11}$ cm long, taking the positive square root because a length is positive.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "A square has area $63\\text{ cm}^2$. What is the length of each side?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{7}\\text{ cm}$",
          "worked": "Let $s$ be the side length in centimetres.\n$$\\begin{align*}s^2&=63\\\\s&=\\sqrt{63}\\\\s&=\\sqrt{9}\\times\\sqrt{7}\\\\s&=3\\sqrt{7}\\end{align*}$$\nEach side is $3\\sqrt{7}$ cm long, taking the positive square root because a length is positive.",
