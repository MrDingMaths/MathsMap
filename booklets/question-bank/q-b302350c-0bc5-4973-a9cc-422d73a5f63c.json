  "content": {
    "id": "p38-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Differentiate $y=(x-3)^2+12$ by:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Expanding the RHS and differentiating each term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2x-6$",
          "worked": "$$\\begin{aligned}y&=x^2-6x+21\\\\\\frac{dy}{dx}&=2x-6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p38-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "By treating the expression as two terms and using chain rule to differentiate the first term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=2(x-3)$, which is the same as part a.",
          "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=2(x-3)\\times1+0\\\\&=2(x-3)\\end{aligned}$$\nThis is the same as part a, since $2(x-3)=2x-6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
