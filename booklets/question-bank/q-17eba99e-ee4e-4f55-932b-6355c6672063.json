    "type": "question",
    "label": "4",
    "prompt": "It takes $2\\frac{1}{4}$ hours to paint a fence. One quarter of this time is spent sanding the wood down. What fraction of an hour is spent in sanding the wood?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{9}{16}$ hour",
      "worked": "$$\\begin{align*}\\text{Sanding time}&=\\frac{1}{4}\\times2\\frac{1}{4}\\text{ hours}\\\\&=\\frac{1}{4}\\times\\frac{9}{4}\\text{ hours}\\\\&=\\frac{9}{16}\\text{ hour}\\end{align*}$$",
      "solutionDiagrams": []
    },
