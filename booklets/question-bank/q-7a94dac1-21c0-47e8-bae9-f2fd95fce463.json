  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Use the special expansion $(a+b)(a-b)=a^2-b^2$ to expand and simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt{5}+1)(\\sqrt{5}-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(\\sqrt{5}+1)(\\sqrt{5}-1)&=(\\sqrt{5})^2-1^2\\\\(\\sqrt{5}+1)(\\sqrt{5}-1)&=5-1\\\\(\\sqrt{5}+1)(\\sqrt{5}-1)&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3-\\sqrt{7})(3+\\sqrt{7})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}(3-\\sqrt{7})(3+\\sqrt{7})&=3^2-(\\sqrt{7})^2\\\\(3-\\sqrt{7})(3+\\sqrt{7})&=9-7\\\\(3-\\sqrt{7})(3+\\sqrt{7})&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})&=(\\sqrt{3})^2-(\\sqrt{2})^2\\\\(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})&=3-2\\\\(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3\\sqrt{2}-\\sqrt{11})(3\\sqrt{2}+\\sqrt{11})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}(3\\sqrt{2}-\\sqrt{11})(3\\sqrt{2}+\\sqrt{11})&=(3\\sqrt{2})^2-(\\sqrt{11})^2\\\\(3\\sqrt{2}-\\sqrt{11})(3\\sqrt{2}+\\sqrt{11})&=9\\times2-11\\\\(3\\sqrt{2}-\\sqrt{11})(3\\sqrt{2}+\\sqrt{11})&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2\\sqrt{6}+3)(2\\sqrt{6}-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15$",
          "worked": "$$\\begin{align*}(2\\sqrt{6}+3)(2\\sqrt{6}-3)&=(2\\sqrt{6})^2-3^2\\\\(2\\sqrt{6}+3)(2\\sqrt{6}-3)&=4\\times6-9\\\\(2\\sqrt{6}+3)(2\\sqrt{6}-3)&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$(7-2\\sqrt{5})(7+2\\sqrt{5})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$29$",
          "worked": "$$\\begin{align*}(7-2\\sqrt{5})(7+2\\sqrt{5})&=7^2-(2\\sqrt{5})^2\\\\(7-2\\sqrt{5})(7+2\\sqrt{5})&=49-4\\times5\\\\(7-2\\sqrt{5})(7+2\\sqrt{5})&=29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
