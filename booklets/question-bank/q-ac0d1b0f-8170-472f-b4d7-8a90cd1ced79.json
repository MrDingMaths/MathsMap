  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Tom is designing a card game. His deck must be able to be divided evenly between $2$ to $6$ players. What is the smallest number of cards that his deck could have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "60 cards.\n\nUse $\\mathrm{LCM}(2,3,4,5,6)$ so the deck divides evenly for every permitted number of players.",
      "worked": "The deck size must be divisible by $2$, $3$, $4$, $5$ and $6$. Their greatest prime powers are $2^2$, $3$ and $5$.\n$$\\begin{align*}\\mathrm{LCM}(2,3,4,5,6)&=2^2\\times3\\times5\\\\\\mathrm{LCM}(2,3,4,5,6)&=60\\end{align*}$$\nThe smallest deck has $60$ cards.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
