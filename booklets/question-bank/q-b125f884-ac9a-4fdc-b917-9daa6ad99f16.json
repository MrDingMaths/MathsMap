  "content": {
    "id": "p34-q5-response",
    "type": "question",
    "label": "5",
    "prompt": "A missile has a probability of 0.75 of hitting a target. It has a probability of 0.65 of hitting two targets in a row. What is the probability that the missile will hit the second target given that it has hit the first target?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{13}{15}$",
      "worked": "$$\\begin{align*}P(\\text{second hit}\\mid\\text{first hit})&=\\frac{P(\\text{both hits})}{P(\\text{first hit})}\\\\&=\\frac{0.65}{0.75}\\\\&=\\frac{13}{15}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
