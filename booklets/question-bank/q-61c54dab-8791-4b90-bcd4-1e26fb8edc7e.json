        "children": [
          {
            "id": "p22-q2-explain",
            "type": "part",
            "label": "a",
            "prompt": "Dom’s working out is correct, but his answer is incomplete.\n\nWhat else does he need to do to finish solving the equations simultaneously?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Find the $y$-value.",
              "worked": "Substitute $x=2$ into $y=x-1$ to find $y=1$. He must give both values: $x=2$, $y=1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p22-q2-solve",
            "type": "part",
            "label": "b",
            "prompt": "Solve simultaneously:\n$$\\begin{aligned}x&=1-y\\qquad(1)\\\\2x-y&=5\\qquad(2)\\end{aligned}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x,y)=(2,-1)$",
              "worked": "Substitute (1) into (2).\n$$\\begin{align*}2(1-y)-y&=5\\\\2-2y-y&=5\\\\-3y&=3\\\\y&=-1\\end{align*}$$\nSubstitute $y=-1$ into (1).\n$$\\begin{align*}x&=1-(-1)\\\\x&=2\\end{align*}$$\nTherefore $(x,y)=(2,-1)$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 56
          }
        ]
      }
    ]
