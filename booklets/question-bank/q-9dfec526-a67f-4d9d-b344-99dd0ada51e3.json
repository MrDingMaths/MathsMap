        "children": [],
        "answer": {
          "short": "$7.6$ hours",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p16-q2-a-supplied-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\bar{x}&=\\frac{8+10+9+5+5+6+9+8+4+12}{10}\\\\\\bar{x}&=\\frac{76}{10}\\\\\\bar{x}&=7.6\\text{ hours}\\end{align*}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
