  "content": {
    "id": "p3-ch2-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A plane takes off and after climbing on a straight line path for a distance of $1\\text{ km}$, it has flown a horizontal distance of $900\\text{ m}$. What is the plane’s altitude, correct to the nearest metre?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$436\\text{ m}$",
      "worked": "The flight path is the hypotenuse and $1\\text{ km}=1000\\text{ m}$. Let $h$ be the altitude in metres.\n$$\\begin{align*}h^2+900^2&=1000^2\\\\h^2&=1000^2-900^2\\\\h^2&=190000\\\\h&=\\sqrt{190000}\\\\h&\\approx436\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
