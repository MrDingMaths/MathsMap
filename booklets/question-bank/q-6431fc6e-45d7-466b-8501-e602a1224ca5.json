  "content": {
    "id": "p23-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "If the average distance from the Earth to the Sun is $1.4951\\times10^8\\text{ km}$ and light travels at $3\\times10^5\\text{ km/s}$, how long does it take light to travel from the Sun to the Earth? Give your answer in minutes to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8.3$ minutes (approximately $8$ minutes $18$ seconds).",
      "worked": "$$\\begin{align*}t&=\\frac{\\text{distance}}{\\text{speed}}\\\\t&=\\frac{1.4951\\times10^8}{3\\times10^5}\\text{ s}\\\\t&=\\frac{1.4951}{3}\\times10^{8-5}\\text{ s}\\\\t&=\\frac{14951}{30}\\text{ s}\\\\t&=\\frac{14951}{1800}\\text{ min}\\\\t&\\approx8.3\\text{ min}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
