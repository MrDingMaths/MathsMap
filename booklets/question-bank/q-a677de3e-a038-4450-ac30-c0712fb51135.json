        "id": "p22-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "I get 1 on both spinners?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{15}$",
          "worked": "$$\\begin{align*}P(1,1)&=\\frac{1}{3}\\times\\frac{1}{5}\\\\&=\\frac{1}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "I get 2 on both spinners?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{15}$",
          "worked": "$$\\begin{align*}P(2,2)&=\\frac{1}{3}\\times\\frac{1}{5}\\\\&=\\frac{1}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "I get 1 on both spinners or 2 on both spinners?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{15}$",
          "worked": "The two outcomes are mutually exclusive.\n\n$$\\begin{align*}P((1,1)\\text{ or }(2,2))&=\\frac{1}{15}+\\frac{1}{15}\\\\&=\\frac{2}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "I get the same number on both spinners?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,1)$, $(2,2)$ or $(3,3)$; $\\frac{3}{15}=\\frac{1}{5}$.",
          "worked": "Favourable outcomes: $(1,1)$, $(2,2)$ and $(3,3)$.\n\nThere are $3\\times5=15$ equally likely outcomes.\n\n$$\\begin{align*}P(\\text{same number})&=\\frac{3}{15}\\\\&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "I get a sum of 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 ways: $(1,2)$ or $(2,1)$; $\\frac{2}{15}$.",
          "worked": "Favourable outcomes: $(1,2)$ and $(2,1)$.\n\nThere are $3\\times5=15$ equally likely outcomes.\n\n$$P(\\text{sum of }3)=\\frac{2}{15}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "I get a sum of 4?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 ways: $(1,3)$, $(2,2)$ or $(3,1)$; $\\frac{3}{15}$.",
          "worked": "Favourable outcomes: $(1,3)$, $(2,2)$ and $(3,1)$.\n\nThere are $3\\times5=15$ equally likely outcomes.\n\n$$P(\\text{sum of }4)=\\frac{3}{15}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
