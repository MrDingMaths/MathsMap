  "content": {
    "id": "p31-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Amina thinks that increasing a number by $100\\%$ is the same as multiplying the number by $2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why Amina is right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increasing by 100% means adding the entire original amount to itself, which is the same as multiplying by 2.",
          "worked": "100% of a number is the entire original number. Adding this to the original gives two copies of the number, so the result is the original number multiplied by 2.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p31-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage increase would be the same as multiplying by $3$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$200\\%$ increase",
          "worked": "Multiplying by 3 gives three copies of the original number. Two copies have been added, each representing 100% of the original.\n$$\\begin{align*}\\text{Percentage increase}&=100\\%+100\\%\\\\&=200\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
