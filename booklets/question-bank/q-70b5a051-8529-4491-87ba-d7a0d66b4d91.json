  "content": {
    "id": "p7-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Consider triangle $ABC$ with vertices at coordinates $A(1,1)$, $B(3,5)$ and $C(5,3)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the midpoint $M$ of $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M(2,3)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{1+3}{2},\\frac{1+5}{2}\\right)\\\\M&=(2,3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoint $N$ of $B$ and $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$N(4,4)$",
          "worked": "$$\\begin{align*}N&=\\left(\\frac{3+5}{2},\\frac{5+3}{2}\\right)\\\\N&=(4,4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $MN=\\frac12 AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$MN=\\sqrt{5}$ and $AC=2\\sqrt{5}$, so $MN=\\frac12 AC$.",
          "worked": "$$\\begin{align*}MN&=\\sqrt{(4-2)^2+(4-3)^2}\\\\MN&=\\sqrt{5}.\\end{align*}$$\n$$\\begin{align*}AC&=\\sqrt{(5-1)^2+(3-1)^2}\\\\AC&=\\sqrt{20}\\\\AC&=2\\sqrt{5}.\\end{align*}$$\nTherefore $MN=\\frac12 AC$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
