    "type": "question",
    "label": "1",
    "prompt": "Identify the mode of each dataset.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$3, 7, 4, 7, 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "Sorted data: $3, 4, 5, 7, 7$. The mode is $7$ because it occurs twice, more often than any other value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p10-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$1, 2, 3, 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No mode",
          "worked": "Each value occurs once, so there is no mode.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p10-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$2, 7, 2, 7, 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2, 7$",
          "worked": "Sorted data: $2, 2, 5, 7, 7$. Both $2$ and $7$ occur twice, the greatest frequency, so the modes are $2$ and $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p10-q1d",
        "type": "part",
        "label": "d",
        "prompt": "$12, 9, 12, 3, 12, 4, 7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "Sorted data: $3, 4, 7, 9, 12, 12, 12$. The mode is $12$ because it occurs three times, more often than any other value.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ]
