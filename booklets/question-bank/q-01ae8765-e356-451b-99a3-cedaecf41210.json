  "content": {
    "id": "p38-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "St Scholasticus Grammar School bought photocopying machines six years ago, which it then depreciated at 25% p.a. They are now worth $\\$72\\,000$. Give monetary answers and percentages to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How much were they worth one year ago?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$96\\,000.00$.",
          "worked": "$$\\begin{align*}\\text{Value one year ago}&=72\\,000\\div0.75\\\\\\text{Value one year ago}&=\\$96\\,000.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How much were they worth two years ago?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$128\\,000.00$.",
          "worked": "$$\\begin{align*}\\text{Value two years ago}&=72\\,000\\div0.75^2\\\\\\text{Value two years ago}&=\\$128\\,000.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "How much were they worth six years ago?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$404\\,543.21$.",
          "worked": "$$\\begin{align*}\\text{Original value}&=72\\,000\\div0.75^6\\\\\\text{Original value}&\\approx\\$404\\,543.21\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the total percentage depreciation on them over the six-year period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$82.20\\%$.",
          "worked": "$$\\begin{align*}\\text{Percentage depreciation}&=(1-0.75^6)\\times100\\%\\\\\\text{Percentage depreciation}&\\approx82.20\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "What was the average depreciation in dollars per year over the six-year period?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$55\\,423.87$ per year.",
          "worked": "Use the unrounded original value.\n$$\\begin{align*}\\text{Average annual depreciation}&=\\frac{72\\,000\\div0.75^6-72\\,000}{6}\\\\\\text{Average annual depreciation}&\\approx\\$55\\,423.87\\text{ per year}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
