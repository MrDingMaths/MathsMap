  "content": {
    "id": "p51-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Rationalise these denominators.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1+\\sqrt2}{\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3+\\sqrt6}{3}$",
          "worked": "$$\\begin{align*}\\frac{1+\\sqrt2}{\\sqrt3}&=\\frac{1+\\sqrt2}{\\sqrt3}\\times\\frac{\\sqrt3}{\\sqrt3}\\\\&=\\frac{\\sqrt3+\\sqrt6}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p51-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2-\\sqrt3}{\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt5-\\sqrt{15}}5$",
          "worked": "$$\\begin{align*}\\frac{2-\\sqrt3}{\\sqrt5}&=\\frac{2-\\sqrt3}{\\sqrt5}\\times\\frac{\\sqrt5}{\\sqrt5}\\\\&=\\frac{2\\sqrt5-\\sqrt{15}}5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p51-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\sqrt5+\\sqrt2}{\\sqrt7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{35}+\\sqrt{14}}7$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt5+\\sqrt2}{\\sqrt7}&=\\frac{\\sqrt5+\\sqrt2}{\\sqrt7}\\times\\frac{\\sqrt7}{\\sqrt7}\\\\&=\\frac{\\sqrt{35}+\\sqrt{14}}7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p51-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt2+\\sqrt7}{\\sqrt6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt3+\\sqrt{42}}6$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt2+\\sqrt7}{\\sqrt6}&=\\frac{\\sqrt2+\\sqrt7}{\\sqrt6}\\times\\frac{\\sqrt6}{\\sqrt6}\\\\&=\\frac{\\sqrt{12}+\\sqrt{42}}6\\\\&=\\frac{2\\sqrt3+\\sqrt{42}}6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p51-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{6-\\sqrt{10}}{\\sqrt5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6\\sqrt5-5\\sqrt2}5$",
          "worked": "$$\\begin{align*}\\frac{6-\\sqrt{10}}{\\sqrt5}&=\\frac{6-\\sqrt{10}}{\\sqrt5}\\times\\frac{\\sqrt5}{\\sqrt5}\\\\&=\\frac{6\\sqrt5-\\sqrt{50}}5\\\\&=\\frac{6\\sqrt5-5\\sqrt2}5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p51-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{3\\sqrt5+5\\sqrt2}{\\sqrt{10}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3\\sqrt2+2\\sqrt5}2$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt5+5\\sqrt2}{\\sqrt{10}}&=\\frac{3\\sqrt5+5\\sqrt2}{\\sqrt{10}}\\times\\frac{\\sqrt{10}}{\\sqrt{10}}\\\\&=\\frac{3\\sqrt{50}+5\\sqrt{20}}{10}\\\\&=\\frac{15\\sqrt2+10\\sqrt5}{10}\\\\&=\\frac{3\\sqrt2+2\\sqrt5}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
