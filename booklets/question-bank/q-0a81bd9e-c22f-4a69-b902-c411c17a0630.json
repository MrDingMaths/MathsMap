    "label": "2",
    "prompt": "Find the sum of the first 20 multiples of 4.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$840$",
      "worked": "The first term is $4$ and the last term is $20\\times4=80$.\n\n$$\\begin{align*}S_{20}&=20\\left(\\frac{4+80}{2}\\right)\\\\S_{20}&=20\\times42\\\\S_{20}&=840.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
