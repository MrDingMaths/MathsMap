    "type": "question",
    "label": "5",
    "prompt": "Five people have an average weight of 67 kg. If a child of weight 25 kg is added to the group, what is the average weight?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60.0\\text{ kg}$",
      "worked": "The original total weight is $5\\times67=335\\text{ kg}$. There are now $6$ people.\n\n$$\\begin{aligned}\\text{New average weight}&=\\frac{335+25}{6}\\\\\\text{New average weight}&=\\frac{360}{6}\\\\\\text{New average weight}&=60.0\\text{ kg}\\end{aligned}$$",
      "solutionDiagrams": []
    },
