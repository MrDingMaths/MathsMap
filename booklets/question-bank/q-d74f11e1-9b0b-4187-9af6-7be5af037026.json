  "content": {
    "id": "v2-641694-p7-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Priya works from 8:30 am to 5 pm Monday to Thursday and from 9 am to 1:30 pm on Friday. Her hourly rate is \\$31.20. Calculate her weekly wage.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1201.20 per week",
      "worked": "Monday to Thursday: $8.5$ hours each day. Friday: $4.5$ hours.\n$$\\begin{align*}\\text{Weekly hours}&=4\\times8.5+4.5\\\\\\text{Weekly hours}&=38.5\\\\\\text{Weekly wage}&=\\$31.20\\times38.5\\\\\\text{Weekly wage}&=\\$1201.20\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
