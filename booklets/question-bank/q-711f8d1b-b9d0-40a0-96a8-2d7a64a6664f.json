  "content": {
    "id": "p36-q13",
    "type": "question",
    "label": "13",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{1}{(x+3)(x+4)}+\\frac{2}{(x+4)(x+5)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x+11}{(x+3)(x+4)(x+5)}$",
          "worked": "$$\\begin{aligned}\\frac{1}{(x+3)(x+4)}+\\frac{2}{(x+4)(x+5)}&=\\frac{x+5+2(x+3)}{(x+3)(x+4)(x+5)}\\\\&=\\frac{x+5+2x+6}{(x+3)(x+4)(x+5)}\\\\&=\\frac{3x+11}{(x+3)(x+4)(x+5)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p36-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{3}{(x+1)(x+2)}-\\frac{5}{(x+1)(x+4)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2-2x}{(x+1)(x+2)(x+4)}$",
          "worked": "$$\\begin{aligned}\\frac{3}{(x+1)(x+2)}-\\frac{5}{(x+1)(x+4)}&=\\frac{3(x+4)-5(x+2)}{(x+1)(x+2)(x+4)}\\\\&=\\frac{3x+12-5x-10}{(x+1)(x+2)(x+4)}\\\\&=\\frac{2-2x}{(x+1)(x+2)(x+4)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p36-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{4}{(x-1)(x-3)}-\\frac{6}{(x-1)(2-x)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{26-10x}{(x-1)(x-3)(2-x)}$",
          "worked": "$$\\begin{aligned}\\frac{4}{(x-1)(x-3)}-\\frac{6}{(x-1)(2-x)}&=\\frac{4(2-x)-6(x-3)}{(x-1)(x-3)(2-x)}\\\\&=\\frac{8-4x-6x+18}{(x-1)(x-3)(2-x)}\\\\&=\\frac{26-10x}{(x-1)(x-3)(2-x)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p36-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{5x}{(x+1)(x-5)}-\\frac{2}{x-5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-2}{(x+1)(x-5)}$",
          "worked": "$$\\begin{aligned}\\frac{5x}{(x+1)(x-5)}-\\frac{2}{x-5}&=\\frac{5x-2(x+1)}{(x+1)(x-5)}\\\\&=\\frac{5x-2x-2}{(x+1)(x-5)}\\\\&=\\frac{3x-2}{(x+1)(x-5)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p36-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{7}{k(k-1)}-\\frac{4}{k(k+1)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3k+11}{k(k-1)(k+1)}$",
          "worked": "$$\\begin{aligned}\\frac{7}{k(k-1)}-\\frac{4}{k(k+1)}&=\\frac{7(k+1)-4(k-1)}{k(k-1)(k+1)}\\\\&=\\frac{7k+7-4k+4}{k(k-1)(k+1)}\\\\&=\\frac{3k+11}{k(k-1)(k+1)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p36-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{8}{(x+4)(x-7)}+\\frac{3}{x(x+4)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11x-21}{x(x-7)(x+4)}$",
          "worked": "$$\\begin{aligned}\\frac{8}{(x+4)(x-7)}+\\frac{3}{x(x+4)}&=\\frac{8x+3(x-7)}{x(x-7)(x+4)}\\\\&=\\frac{8x+3x-21}{x(x-7)(x+4)}\\\\&=\\frac{11x-21}{x(x-7)(x+4)}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
