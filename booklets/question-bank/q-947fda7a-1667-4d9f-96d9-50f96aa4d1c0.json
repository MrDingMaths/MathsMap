      {
        "id": "v2-91d46e-p8-practice-j4-211127-j4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos\\left(\\sin^{-1}0\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\sin^{-1}0&=0\\\\\\cos\\left(\\sin^{-1}0\\right)&=\\cos 0\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-91d46e-p8-practice-j4-211127-j4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan\\left(\\cos^{-1}\\left(\\frac12\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3$",
          "worked": "$$\\begin{aligned}\\cos^{-1}\\left(\\frac12\\right)&=\\frac{\\pi}{3}\\\\\\tan\\left(\\cos^{-1}\\left(\\frac12\\right)\\right)&=\\tan\\left(\\frac{\\pi}{3}\\right)\\\\&=\\sqrt3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-91d46e-p8-practice-j4-211127-j4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\left(\\cos^{-1}\\left(-\\frac1{\\sqrt2}\\right)\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt2}{2}$",
          "worked": "$$\\begin{aligned}\\cos^{-1}\\left(-\\frac1{\\sqrt2}\\right)&=\\frac{3\\pi}{4}\\\\\\sin\\left(\\cos^{-1}\\left(-\\frac1{\\sqrt2}\\right)\\right)&=\\sin\\left(\\frac{3\\pi}{4}\\right)\\\\&=\\frac{\\sqrt2}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
