  "content": {
    "id": "p37-q4",
    "type": "question",
    "label": "4",
    "prompt": "Starting with $f(x)$, write down the translation that is required to obtain $g(x)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{1}{x},\\quad g(x)=\\dfrac{1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 unit right.",
          "worked": "$g(x)=f(x-1)$. Replacing $x$ with $x-1$ translates the graph 1 unit right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p37-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{1}{x},\\quad g(x)=\\dfrac{1}{x}+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "1 unit up.",
          "worked": "$g(x)=f(x)+1$. In $y=f(x)$, replacing $y$ with $y-1$ gives $y-1=f(x)$, so the graph translates 1 unit up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p37-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=|x|,\\quad g(x)=|x-3|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 units right.",
          "worked": "$g(x)=f(x-3)$. Replacing $x$ with $x-3$ translates the graph 3 units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p37-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=|x|,\\quad g(x)=|x|-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 units down.",
          "worked": "$g(x)=f(x)-3$. In $y=f(x)$, replacing $y$ with $y+3$ gives $y+3=f(x)$, so the graph translates 3 units down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p37-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=-x^3,\\quad g(x)=-(x-2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2 units right.",
          "worked": "$g(x)=f(x-2)$. Replacing $x$ with $x-2$ translates the graph 2 units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p37-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=-x^3,\\quad g(x)=-x^3-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 units down.",
          "worked": "$g(x)=f(x)-3$. In $y=f(x)$, replacing $y$ with $y+3$ gives $y+3=f(x)$, so the graph translates 3 units down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
