        "type": "part",
        "label": "d",
        "prompt": "Find the point on the graph that corresponds to the largest rectangular area that Gidon can enclose using the 80 metres of fencing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(20,400)$, corresponding to a maximum area of $400\\text{ m}^2$.",
          "worked": "The highest point of the graph is its vertex, $(20,400)$. The maximum area is therefore $400\\text{ m}^2$, when both dimensions are $20$ m.",
