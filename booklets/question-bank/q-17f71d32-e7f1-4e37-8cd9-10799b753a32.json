  "content": {
    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write down the converse of each statement below. For which of these statements is the converse true?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "If it is raining, then the grass is wet.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If the grass is wet, then it is raining. False.",
          "worked": "Converse: If the grass is wet, then it is raining.\n\nThis is false: a sprinkler can wet the grass when it is not raining.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If water is frozen, then it is ice.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If water is ice, then it is frozen. True.",
          "worked": "Converse: If water is ice, then it is frozen.\n\nThis is true because ice is frozen water.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "If an adult has children, then they are a parent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If an adult is a parent, then they have children. True.",
          "worked": "Converse: If an adult is a parent, then they have children.\n\nThis is true by the definition of a parent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "If an animal is a dog, then it is a mammal.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If an animal is a mammal, then it is a dog. False.",
          "worked": "Converse: If an animal is a mammal, then it is a dog.\n\nThis is false: a cat is a mammal but is not a dog.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "If a polygon has four sides, then it is a quadrilateral.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If a polygon is a quadrilateral, then it has four sides. True.",
          "worked": "Converse: If a polygon is a quadrilateral, then it has four sides.\n\nThis is true by the definition of a quadrilateral.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "If a polygon is a square, then it is a rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If a polygon is a rectangle, then it is a square. False.",
          "worked": "Converse: If a polygon is a rectangle, then it is a square.\n\nThis is false: a rectangle with side lengths $2$ and $3$ has four right angles but does not have four equal sides.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "If a triangle has three equal angles, then it has three equal sides.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If a triangle has three equal sides, then it has three equal angles. True.",
          "worked": "Converse: If a triangle has three equal sides, then it has three equal angles.\n\nThis is true: angles opposite equal sides are equal, so all three angles are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
