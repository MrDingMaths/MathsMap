  "content": {
    "id": "v2-86a58-p13-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{v}|^2$ where $\\underset{\\sim}{v}=(2t+1)\\mathbf{i}+(t-3)\\mathbf{j}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$|\\underset{\\sim}{v}|^2=5t^2-2t+10=\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}$.",
      "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|^2&=(2t+1)^2+(t-3)^2\\\\&=4t^2+4t+1+t^2-6t+9\\\\&=5t^2-2t+10\\end{aligned}$$\n\n$$\\begin{aligned}\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}&=(2t+1)(2t+1)+(t-3)(t-3)\\\\&=4t^2+4t+1+t^2-6t+9\\\\&=5t^2-2t+10\\end{aligned}$$\n\nHence $\\underset{\\sim}{v}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{v}|^2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
