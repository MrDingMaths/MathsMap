    "children": [
      {
        "id": "p43-q6-original-response",
        "type": "part",
        "label": "a",
        "prompt": "Do you agree? Explain why or why not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. As fractions, $\\frac{1}{2}>\\frac{1}{4}$. The upper shaded area is smaller because the rectangles represent different-sized wholes.",
          "worked": "$\\begin{align*}\\frac{1}{2}&=\\frac{2}{4}\\\\\\frac{2}{4}&>\\frac{1}{4}\\end{align*}$\n\nNo. One half is greater than one quarter. The upper shaded area is smaller in this drawing because its whole rectangle is smaller. Compare fraction models using equal-sized wholes.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p43-q6-a",
        "type": "part",
        "label": "b",
        "prompt": "Rectangle A has area 12 square units and half is shaded. Rectangle B has one quarter shaded. What positive area must B have for its shaded area to equal A’s shaded area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "24 square units.",
          "worked": "A’s shaded area is $12\\div2=6$ square units. B’s area must be $6\\times4=24$ square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p43-q6-b",
        "type": "part",
        "label": "c",
        "prompt": "What positive area must B have for its shaded area to be greater than A’s shaded area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Greater than 24 square units.",
          "worked": "A quarter of B’s area must exceed 6 square units, so B’s area must exceed 24 square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p43-q6-c",
        "type": "part",
        "label": "d",
        "prompt": "What positive area must B have for its shaded area to be less than A’s shaded area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Between 0 and 24 square units.",
          "worked": "A quarter of B’s positive area must be less than 6 square units, so its area is between 0 and 24 square units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p43-q6-d",
        "type": "part",
        "label": "e",
        "prompt": "Explain how these results change if A has a different area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Compare B’s area with twice A’s area.",
          "worked": "A’s shaded area is half its area. B needs twice A’s area for its shaded quarter to equal that half. Larger or smaller positive areas of B give greater or smaller shaded amounts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
