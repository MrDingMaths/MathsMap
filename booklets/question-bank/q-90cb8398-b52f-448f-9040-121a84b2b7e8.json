      {
        "id": "p38-review-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the range of times to run 100 m in the class?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6.7 seconds",
          "worked": "$$\\begin{align*}\\text{Range}&=18.2-11.5\\\\\\text{Range}&=6.7\\text{ seconds}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p38-review-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the median time to run 100 m in the class?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "14.3 seconds",
          "worked": "There are 26 times. The 13th and 14th values are 14.2 and 14.4 seconds.\n\n$$\\begin{align*}\\text{Median}&=\\frac{14.2+14.4}{2}\\\\\\text{Median}&=14.3\\text{ seconds}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p38-review-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the interquartile range?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2.4 seconds",
          "worked": "Divide the ordered times into two groups of 13. Each quartile is the 7th value of its group: the 7th and 20th values overall.\n\n$$\\begin{align*}Q_1&=13.0\\text{ seconds}\\\\Q_3&=15.4\\text{ seconds}\\\\\\text{IQR}&=15.4-13.0\\\\\\text{IQR}&=2.4\\text{ seconds}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p38-review-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Would the median time change if the fastest and slowest times were removed?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No; it remains 14.3 seconds.",
          "worked": "Removing the smallest and largest times leaves 24 values. The new 12th and 13th values are the original 13th and 14th values, 14.2 and 14.4 seconds. Their average is still 14.3 seconds, so the median does not change.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
