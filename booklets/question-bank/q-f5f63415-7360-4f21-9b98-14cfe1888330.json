  "content": {
    "id": "p13-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "If $x^4=3$, find the value of:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^4-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}x^4-1&=3-1\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}x^8&=(x^4)^2\\\\&=3^2\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$162$",
          "worked": "$$\\begin{align*}2x^{16}&=2(x^4)^4\\\\&=2\\times3^4\\\\&=2\\times81\\\\&=162\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$3x^4-3x^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-18$",
          "worked": "$$\\begin{align*}3x^4-3x^8&=3x^4-3(x^4)^2\\\\&=3\\times3-3\\times3^2\\\\&=9-27\\\\&=-18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
