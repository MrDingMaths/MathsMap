        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$$\\begin{align*}P(R,B,R)&=\\frac{6}{10}\\times\\frac{4}{9}\\times\\frac{5}{8}\\\\&=\\frac{120}{720}\\\\&=\\frac{1}{6}\\end{align*}$$",
