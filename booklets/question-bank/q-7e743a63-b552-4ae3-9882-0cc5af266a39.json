        "children": [],
        "answer": {
          "short": "$\\frac{5}{8}$",
          "worked": "After a red and a blue pen are removed, eight pens remain and five of them are red.\n$$\\begin{align*}P(\\text{red third})&=\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
