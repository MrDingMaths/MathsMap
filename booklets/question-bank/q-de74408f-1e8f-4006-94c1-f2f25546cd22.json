    "children": [
      {
        "id": "p32-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Factorise $5^{n+1}+5^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\times5^n$",
          "worked": "$$\\begin{align*}5^{n+1}+5^n&=5^n(5+1)\\\\&=6\\times5^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence simplify $\\dfrac{5^{101}+5^{100}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5^{100}$",
          "worked": "Using part a with $n=100$:\n$$\\begin{align*}\\frac{5^{101}+5^{100}}{6}&=\\frac{6\\times5^{100}}{6}\\\\&=5^{100}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
