  "content": {
    "id": "p55-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find the values of $m$ and $n$ if $(x-1)$ and $(x-2)$ are factors of $P(x)=x^4+mx+n$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=-15,\\ n=14$. Use $P(1)=P(2)=0$.",
      "worked": "By the factor theorem, $P(1)=0$ and $P(2)=0$.\n$$\\begin{align*}P(1)&=1+m+n=0,\\\\m+n&=-1,\\\\P(2)&=16+2m+n=0,\\\\2m+n&=-16.\\end{align*}$$\nSubtracting $m+n=-1$ from $2m+n=-16$:\n$$\\begin{align*}m&=-15,\\\\n&=-1-(-15)=14.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
