  "content": {
    "id": "p14-q2-root",
    "type": "question",
    "label": "",
    "prompt": "Consider the equation $\\cos 2x-\\cos x=0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "By using a double-angle formula and then factoring, show that $\\cos x=1$ or $-\\frac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2\\cos x+1)(\\cos x-1)=0$, so $\\cos x=1$ or $-\\frac12$.",
          "worked": "$$\\begin{aligned}\\cos 2x-\\cos x&=0\\\\2\\cos^2x-1-\\cos x&=0\\\\2\\cos^2x-\\cos x-1&=0\\\\(2\\cos x+1)(\\cos x-1)&=0\\end{aligned}$$\nTherefore $\\cos x=1$ or $-\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence solve the equation for $0\\le x\\le2\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\frac{2\\pi}3,\\frac{4\\pi}3,2\\pi$.",
          "worked": "$$\\begin{aligned}\\cos x&=1:&x&=0,2\\pi\\\\\\cos x&=-\\frac12:&x&=\\frac{2\\pi}3,\\frac{4\\pi}3\\end{aligned}$$\nTherefore $x=0,\\frac{2\\pi}3,\\frac{4\\pi}3,2\\pi$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
