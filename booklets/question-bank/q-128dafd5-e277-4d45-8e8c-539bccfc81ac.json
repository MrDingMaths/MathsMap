  "content": {
    "id": "p5-q16-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f$ be the function for which $f(x+3)=x^2+8x+16$ for all $x\\in\\mathbb{R}$. Find $f(x)$. Hint: Let $a=x+3$ and find $f(a)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p5-q16-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "f(x)=x^2+2x+1",
                "display": false
              }
            ]
          },
          {
            "id": "p5-q16-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "a=x+3",
                "display": false
              },
              {
                "type": "text",
                "text": ", substitute ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x=a-3",
                "display": false
              },
              {
                "type": "text",
                "text": " and expand.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Let $a=x+3$, so $x=a-3$.\n$$\\begin{align*}f(a)&=(a-3)^2+8(a-3)+16\\\\f(a)&=a^2-6a+9+8a-24+16\\\\f(a)&=a^2+2a+1\\end{align*}$$\nTherefore, $f(x)=x^2+2x+1$.",
      "solutionDiagrams": []
    },
