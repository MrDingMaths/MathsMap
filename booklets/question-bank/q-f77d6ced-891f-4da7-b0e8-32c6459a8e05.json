  "content": {
    "id": "p52-q37-stem",
    "type": "question",
    "label": "37",
    "prompt": "Let $f(x)=\\log_2((x-1)^2)$. Suppose $g$ is the inverse function of $f$ restricted to the domain $(1,\\infty)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q37-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(x)=1+2^{\\frac{x}{2}}$.",
          "worked": "$$\\begin{align*}y&=\\log_2((x-1)^2)\\\\x&=\\log_2((y-1)^2)\\\\2^x&=(y-1)^2\\\\y&=1+2^{x/2}\\end{align*}$$\nThe branch $y>1$ requires the positive square root. Hence $g(x)=1+2^{\\frac{x}{2}}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p52-q37-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $f(g(x))=x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=\\log_2((2^{\\frac{x}{2}})^2)=\\log_2(2^x)=x$.",
          "worked": "$$\\begin{align*}f(g(x))&=\\log_2((1+2^{x/2}-1)^2)\\\\f(g(x))&=\\log_2((2^{x/2})^2)\\\\f(g(x))&=\\log_2(2^x)\\\\f(g(x))&=x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p52-q37-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $g(f(a))$ if $a>1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(f(a))=a$.",
          "worked": "$$\\begin{align*}g(f(a))&=1+2^{\\frac12\\log_2((a-1)^2)}\\\\g(f(a))&=1+\\sqrt{(a-1)^2}\\\\g(f(a))&=1+|a-1|\\\\g(f(a))&=a\\end{align*}$$\nSince $a>1$, $|a-1|=a-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p52-q37-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the value of $g(f(a))$ if $a<1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(f(a))=2-a$.\n\nUse $\\sqrt{(a-1)^2}=|a-1|=1-a$ when $a<1$.",
          "worked": "$$\\begin{align*}g(f(a))&=1+2^{\\frac12\\log_2((a-1)^2)}\\\\g(f(a))&=1+|a-1|\\\\g(f(a))&=1+(1-a)\\\\g(f(a))&=2-a\\end{align*}$$\nHere $a<1$, so $|a-1|=1-a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
