  "content": {
    "id": "p4-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the natural number $n$ for which:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$n<\\sqrt{19}<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4$",
          "worked": "$4^2=16<19<25=5^2$, so $4<\\sqrt{19}<5$. Therefore, $n=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$n<\\sqrt{101}<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=10$",
          "worked": "$10^2=100<101<121=11^2$, so $10<\\sqrt{101}<11$. Therefore, $n=10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$n<\\sqrt[3]{20}<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$",
          "worked": "$2^3=8<20<27=3^3$, so $2<\\sqrt[3]{20}<3$. Therefore, $n=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$n<\\sqrt[4]{100}<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$3^4=81<100<256=4^4$, so $3<\\sqrt[4]{100}<4$. Therefore, $n=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
