  "content": {
    "id": "p32-q10-root",
    "type": "question",
    "label": null,
    "prompt": "For $\\triangle ABC$ we are given that $c=\\sqrt6-\\sqrt2$, $b=2\\sqrt2$ and $a=2\\sqrt3$. Find the measure of $\\angle B$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\angle B=45^\\circ$.",
      "worked": "$$\\begin{align*}b^2&=a^2+c^2-2ac\\cos B\\\\\\cos B&=\\frac{a^2+c^2-b^2}{2ac}\\\\\\cos B&=\\frac{(2\\sqrt3)^2+(\\sqrt6-\\sqrt2)^2-(2\\sqrt2)^2}{2(2\\sqrt3)(\\sqrt6-\\sqrt2)}\\\\\\cos B&=\\frac{12+(8-4\\sqrt3)-8}{12\\sqrt2-4\\sqrt6}\\\\\\cos B&=\\frac{12-4\\sqrt3}{\\sqrt2(12-4\\sqrt3)}\\\\\\cos B&=\\frac{\\sqrt2}{2}\\\\B&=45^\\circ.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
