          {
            "id": "p43-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Two blue marbles",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac5{14}$",
              "worked": "$$\\begin{align*}P(BB)&=\\frac58\\times\\frac47\\\\&=\\frac{20}{56}\\\\&=\\frac5{14}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p43-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "A blue and a white in that order",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{15}{56}$",
              "worked": "$$\\begin{align*}P(BW)&=\\frac58\\times\\frac37\\\\&=\\frac{15}{56}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p43-q4-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "One of each colour",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$P(BW)+P(WB)=\\frac{30}{56}=\\frac{15}{28}$",
              "worked": "$$\\begin{align*}P(\\text{one of each})&=P(BW)+P(WB)\\\\&=\\frac{15}{56}+\\frac{15}{56}\\\\&=\\frac{30}{56}\\\\&=\\frac{15}{28}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p43-q4-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "At least one blue marble",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1-P(WW)=\\frac{25}{28}$",
              "worked": "The complementary event is two white marbles.\n$$\\begin{align*}P(\\text{at least one B})&=1-P(WW)\\\\&=1-\\frac3{28}\\\\&=\\frac{25}{28}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
