            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 43 p43-q4-tree\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-4,-6) rectangle (151,70);\n\\coordinate (O) at (0,32);\\coordinate (B) at (30,50);\\coordinate (W) at (30,14);\n\\coordinate (BB) at (62,62);\\coordinate (BW) at (62,38);\\coordinate (WB) at (62,26);\\coordinate (WW) at (62,2);\n\\draw (O)--(B) (O)--(W) (B)--(BB) (B)--(BW) (W)--(WB) (W)--(WW);\n\\node[fill=white,inner sep=1mm] at (B) {B};\\node[fill=white,inner sep=1mm] at (W) {W};\n\\node[right] at (BB) {B};\\node[right] at (BW) {W};\\node[right] at (WB) {B};\\node[right] at (WW) {W};\n\\node at (88,62) {$(B,B)$};\\node at (88,38) {$(B,W)$};\\node at (88,26) {$(W,B)$};\\node at (88,2) {$(W,W)$};\n\\draw[densely dotted,line width=0.4pt] (8,47)--(22,47) (8,17)--(22,17) (40,65)--(54,65) (40,39)--(54,39) (40,29)--(54,29) (40,0)--(54,0);\n\\draw[densely dotted,line width=0.4pt] (108,62)--(147,62) (108,38)--(147,38) (108,26)--(147,26) (108,2)--(147,2);\n\\end{tikzpicture}",
