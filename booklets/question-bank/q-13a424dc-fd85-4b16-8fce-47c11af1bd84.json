  "content": {
    "id": "p15-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Factorise the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$3a^2 + 9a + 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(a^2 + 3a + 4)$",
          "worked": "The HCF is $3$.\n$$\\begin{align*}3a^2 + 9a + 12 &= 3(a^2 + 3a + 4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$5z^2 - 10z + zy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z(5z - 10 + y)$",
          "worked": "The HCF is $z$.\n$$\\begin{align*}5z^2 - 10z + zy &= z(5z - 10 + y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2 - 2xy + x^2y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x - 2y + xy)$",
          "worked": "The HCF is $x$.\n$$\\begin{align*}x^2 - 2xy + x^2y &= x(x - 2y + xy)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p15-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$4by - 2b + 6b^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2b(2y - 1 + 3b)$",
          "worked": "The HCF is $2b$.\n$$\\begin{align*}4by - 2b + 6b^2 &= 2b(2y - 1 + 3b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$-12xy - 8yz - 20xyz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4y(3x + 2z + 5xz)$",
          "worked": "The HCF is $4y$. Take out $-4y$ to leave positive terms inside the brackets.\n$$\\begin{align*}-12xy - 8yz - 20xyz &= -4y(3x + 2z + 5xz)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$3ab + 4ab^2 + 6a^2b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab(3 + 4b + 6a)$",
          "worked": "The HCF is $ab$.\n$$\\begin{align*}3ab + 4ab^2 + 6a^2b &= ab(3 + 4b + 6a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
