    "id": "v2-fb109-p39-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "Find the vector $\\underset{\\sim}{a}$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-fb109-p39-practice-slot-13-slot-13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{\\hat a}=\\dfrac{5}{13}i+\\dfrac{12}{13}j$ and $|\\underset{\\sim}{a}|=26$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{a}=10i+24j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}&=|\\underset{\\sim}{a}|\\times\\underset{\\sim}{\\hat a}\\\\&=26\\left(\\frac{5}{13}i+\\frac{12}{13}j\\right)\\\\&=10i+24j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-fb109-p39-practice-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{\\hat a}=-\\dfrac{8}{17}i+\\dfrac{15}{17}j$ and $|\\underset{\\sim}{a}|=34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{a}=-16i+30j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}&=|\\underset{\\sim}{a}|\\times\\underset{\\sim}{\\hat a}\\\\&=34\\left(-\\frac{8}{17}i+\\frac{15}{17}j\\right)\\\\&=-16i+30j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
