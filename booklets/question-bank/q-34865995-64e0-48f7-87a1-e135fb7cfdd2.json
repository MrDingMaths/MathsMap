    "children": [
      {
        "id": "p20-q1a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the line with gradient $6$ that passes through the point $(5,6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=6x-24$.",
          "worked": "$$\\begin{align*}y-6&=6(x-5)\\\\y-6&=6x-30\\\\y&=6x-24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q1b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of the line with gradient $-4$ that passes through the point $(2,6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+14$.",
          "worked": "$$\\begin{align*}y-6&=-4(x-2)\\\\y-6&=-4x+8\\\\y&=-4x+14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q1c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the line with gradient $\\frac12$ that passes through the point $(-1,8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac12x+\\frac{17}{2}$.",
          "worked": "$$\\begin{align*}y-8&=\\frac12(x+1)\\\\y-8&=\\frac12x+\\frac12\\\\y&=\\frac12x+\\frac{17}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p20-q1d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the line parallel to the line $y=-3x+8$ and passing through the point $(1,8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3x+11$.",
          "worked": "Parallel lines have equal gradients, so $m=-3$.\n\n$$\\begin{align*}y-8&=-3(x-1)\\\\y-8&=-3x+3\\\\y&=-3x+11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q1e",
        "type": "part",
        "label": "e",
        "prompt": "Find the equation of the line with gradient $0$ that passes through the point $(-3,6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=6$.",
          "worked": "$$\\begin{align*}y-6&=0(x+3)\\\\y-6&=0\\\\y&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p20-q1f",
        "type": "part",
        "label": "f",
        "prompt": "Find the equation of the line parallel to the line $x=-4$ and passing through the point $(-7,11)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-7$.",
          "worked": "The line $x=-4$ is vertical. A parallel line is also vertical, so its $x$-coordinate is constant. Through $(-7,11)$, its equation is $x=-7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
