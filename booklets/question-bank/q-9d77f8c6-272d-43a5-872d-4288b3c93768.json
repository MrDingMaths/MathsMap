  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the equation of the resulting curve if the graph of $y=c(x-h)^2+k$ is rotated by $180^\\circ$ about the origin.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-c(x+h)^2-k$.",
      "worked": "A rotation by $180^\\circ$ about the origin maps $(x,y)$ to $(-x,-y)$. Substitute $-x$ for $x$ and $-y$ for $y$:\n$$\\begin{align*}-y&=c(-x-h)^2+k\\\\y&=-c(-x-h)^2-k\\\\y&=-c(x+h)^2-k.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
