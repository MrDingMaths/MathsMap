  "content": {
    "id": "p40-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Consider the DE $\\dfrac{dy}{dx}=\\dfrac{x-1}{y+1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Multiply through by $y+1$ and then by $dx$, so that the variables are separated.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y+1)\\,dy=(x-1)\\,dx$.",
          "worked": "$$\\begin{align*}(y+1)\\frac{dy}{dx}&=x-1\\\\(y+1)\\,dy&=(x-1)\\,dx\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p40-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the result $\\displaystyle\\int(x+a)^n\\,dx=\\dfrac{1}{n+1}(x+a)^{n+1}+C$ to find the general solution.\n\nWrite your answer without using fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y+1)^2=(x-1)^2+D$.",
          "worked": "$$\\begin{align*}\\int(y+1)\\,dy&=\\int(x-1)\\,dx\\\\\\frac{(y+1)^2}{2}&=\\frac{(x-1)^2}{2}+\\frac{C}{2}\\\\(y+1)^2&=(x-1)^2+D\\end{align*}$$\nHere $D$ is an arbitrary constant. Solutions are taken on intervals where $y\\ne-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
