    "label": "71",
    "prompt": "Fully factorise the following expression: $(x+3)^2-(y+2)^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-y+1)(x+y+5)$",
      "worked": "$$\\begin{align*}(x+3)^2-(y+2)^2&=[(x+3)-(y+2)][(x+3)+(y+2)]\\\\(x+3)^2-(y+2)^2&=(x-y+1)(x+y+5).\\end{align*}$$",
      "solutionDiagrams": []
    },
