  "content": {
    "id": "p22-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider the quadratic function $y=2x^2+9x-5$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Use $x=-\\dfrac{b}{2a}$ to find the $x$-coordinate of the turning point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac94$",
          "worked": "$$\\begin{aligned}x&=-\\frac{b}{2a}\\\\&=-\\frac{9}{2(2)}\\\\&=-\\frac94\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "By finding $f'(x)$ and letting it equal zero, find the $x$-coordinate of the turning point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac94$",
          "worked": "$$\\begin{aligned}f'(x)&=4x+9\\\\4x+9&=0\\\\x&=-\\frac94\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
