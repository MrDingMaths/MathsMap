  "content": {
    "id": "p28-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If $x=2$ is a double root of $ax^4-2x^3-8x+16=0$, find the value of $a$ and the sum of the other two roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=1$; the sum of the other two roots is $-2$.",
      "worked": "Since $2$ is a root,\n$$\\begin{aligned}P(2)&=16a-16-16+16=0\\\\16a-16&=0\\\\a&=1.\\end{aligned}$$\nLet the roots be $2,2,\\alpha,\\beta$. Using the sum of the roots,\n$$\\begin{aligned}4+\\alpha+\\beta&=\\frac2a\\\\4+\\alpha+\\beta&=2\\\\\\alpha+\\beta&=-2.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
