  "content": {
    "id": "p7-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the units digit of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{22}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "The units digits of successive powers of 2 repeat as $2,4,8,6$, with period 4.\n$$\\begin{align*}22&=5\\times4+2\\\\2^{22}&\\equiv2^2\\pmod{10}\\\\2^{22}&\\equiv4\\pmod{10}\\end{align*}$$\nThe units digit is 4.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^{33}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "The units digits of successive powers of 3 repeat as $3,9,7,1$, with period 4.\n$$\\begin{align*}33&=8\\times4+1\\\\3^{33}&\\equiv3^1\\pmod{10}\\\\3^{33}&\\equiv3\\pmod{10}\\end{align*}$$\nThe units digit is 3.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$7^{77}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "The units digits of successive powers of 7 repeat as $7,9,3,1$, with period 4.\n$$\\begin{align*}77&=19\\times4+1\\\\7^{77}&\\equiv7^1\\pmod{10}\\\\7^{77}&\\equiv7\\pmod{10}\\end{align*}$$\nThe units digit is 7.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$8^{88}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "The units digits of successive powers of 8 repeat as $8,4,2,6$, with period 4. A multiple of 4 selects the fourth digit.\n$$\\begin{align*}88&=22\\times4\\\\8^{88}&\\equiv8^4\\pmod{10}\\\\8^{88}&\\equiv6\\pmod{10}\\end{align*}$$\nThe units digit is 6.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
