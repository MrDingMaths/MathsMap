  "content": {
    "id": "p25-q3",
    "type": "question",
    "label": "3",
    "prompt": "Show that the following vectors are parallel.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\binom{3}{5}$ and $3\\binom{2}{\\frac{10}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both vectors equal $\\binom{6}{10}$, so they are parallel.",
          "worked": "$$\\begin{aligned}2\\binom{3}{5}&=\\binom{6}{10}\\\\3\\binom{2}{\\frac{10}{3}}&=\\binom{6}{10}\\end{aligned}$$\nThe vectors are equal, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\binom{4}{-6}+\\binom{2}{-3}$ and $\\binom{12}{-18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{12}{-18}=2\\binom{6}{-9}$, so the vectors are parallel.",
          "worked": "$$\\begin{aligned}\\binom{4}{-6}+\\binom{2}{-3}&=\\binom{6}{-9}\\\\\\binom{12}{-18}&=2\\binom{6}{-9}\\end{aligned}$$\nThe second vector is twice the first, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p25-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\binom{2}{7}-\\binom{1}{7}$ and $\\binom{10}{28}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\binom{10}{28}=2\\binom{5}{14}$, so the vectors are parallel.",
          "worked": "$$\\begin{aligned}3\\binom{2}{7}-\\binom{1}{7}&=\\binom{5}{14}\\\\\\binom{10}{28}&=2\\binom{5}{14}\\end{aligned}$$\nThe second vector is twice the first, so they are parallel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
