              "latex": "AC\\times BD=(AB\\times CD)+(BC\\times AD)",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p20-q7-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"diagonalRed\",\"hex\":\"EF6068\",\"reason\":\"highlights the two diagonals in Ptolemy’s identity\"}],\"reference\":\"source page 20, p20-q7-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\normalsize,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{diagonalRed}{HTML}{EF6068}\n\\coordinate (A) at (200:1.2);\n\\coordinate (B) at (115:1.2);\n\\coordinate (C) at (0:1.2);\n\\coordinate (D) at (250:1.2);\n\\draw[black] (0,0) circle (1.2);\n\\draw[black] (A)--(B)--(C)--(D)--cycle;\n\\draw[diagonalRed] (A)--(C) (B)--(D);\n\\foreach \\p in {A,B,C,D}{\\fill[black] (\\p) circle (0.025);}\n\\node[left] at (A) {$A$};\n\\node[above] at (B) {$B$};\n\\node[right] at (C) {$C$};\n\\node[below] at (D) {$D$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 43.6,
        "alt": "Mathematical diagram",
