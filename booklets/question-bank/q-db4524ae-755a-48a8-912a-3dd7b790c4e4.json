  "content": {
    "id": "v2-76b48-p20-practice-slot-13-root",
    "type": "question",
    "label": null,
    "prompt": "A cylinder has a radius of $4\\text{ cm}$ and a height of $6\\text{ cm}$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-76b48-p20-practice-slot-13-slot-13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine the surface area of the cylinder to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$251.3\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=2\\pi r^2+2\\pi rh\\\\A&=2\\pi(4)^2+2\\pi(4)(6)\\\\A&=80\\pi\\approx251.3\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-76b48-p20-practice-slot-13-slot-13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The height of the cylinder is increased by 50%.\n\nWork out the new total surface area of the cylinder, rounded to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$326.7\\text{ cm}^2$",
          "worked": "$$\\begin{align*}h_{\\text{new}}&=6\\times1.5=9\\text{ cm}\\\\A_{\\text{new}}&=2\\pi(4)^2+2\\pi(4)(9)\\\\A_{\\text{new}}&=104\\pi\\approx326.7\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-76b48-p20-practice-slot-13-slot-13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Work out the percentage increase in the total surface area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$ increase.",
          "worked": "$$\\begin{align*}\\text{Increase}&=104\\pi-80\\pi=24\\pi\\text{ cm}^2\\\\\\text{Percentage increase}&=\\frac{24\\pi}{80\\pi}\\times100\\%\\\\&=30\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-76b48-p20-practice-slot-13-slot-13-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Starting with the original cylinder, what height would give a total surface area of $100\\pi\\text{ cm}^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.5\\text{ cm}$",
          "worked": "$$\\begin{align*}32\\pi+8\\pi h&=100\\pi\\\\8\\pi h&=68\\pi\\\\h&=8.5\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
