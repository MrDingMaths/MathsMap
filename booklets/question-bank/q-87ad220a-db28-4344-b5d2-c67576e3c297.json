  "content": {
    "id": "p27-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A dead body is found in a room at midnight. Its temperature is measured at this time to be $29^\\circ\\mathrm{C}$. One hour later the temperature is measured to be $25^\\circ\\mathrm{C}$. The temperature $T^\\circ\\mathrm{C}$ of the body $t$ hours after midnight is given by the equation\n$$T(t)=21+A\\left(\\frac{1}{2}\\right)^{kt}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the values of $A$ and $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=8$, $k=1$.",
          "worked": "At midnight, $t=0$ and $T=29$.\n$$\\begin{align*}29&=21+A\\left(\\frac12\\right)^0\\\\29&=21+A\\\\A&=8\\end{align*}$$\nOne hour later, $t=1$ and $T=25$.\n$$\\begin{align*}25&=21+8\\left(\\frac12\\right)^k\\\\4&=8\\left(\\frac12\\right)^k\\\\\\left(\\frac12\\right)^k&=\\frac12\\\\k&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p27-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "The temperature of the body at the time of death was $37^\\circ\\mathrm{C}$. Estimate the time of death.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p27-q12-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "11 pm, one hour before it was found.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p27-q12-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Set ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "T=37",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in the model to obtain ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "t=-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " hour.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}37&=21+8\\left(\\frac12\\right)^t\\\\16&=8\\left(\\frac12\\right)^t\\\\\\left(\\frac12\\right)^t&=2\\\\\\left(\\frac12\\right)^t&=\\left(\\frac12\\right)^{-1}\\\\t&=-1\\end{align*}$$\nDeath occurred one hour before midnight, at 11 pm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
