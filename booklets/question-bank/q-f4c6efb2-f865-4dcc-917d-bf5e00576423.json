    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q44-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\cos\\theta$ and $\\tan\\theta$ in terms of $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q44-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\cos\\theta=\\frac{2|a|}{1+a^2},\\qquad\\tan\\theta=\\frac{1-a^2}{2|a|}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q44-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use Pythagoras to find the positive adjacent side ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "2|a|",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $\\theta$ is acute, $0<|a|<1$. Choose opposite side $1-a^2$ and hypotenuse $1+a^2$, and let the adjacent side be $d>0$.\n$$\\begin{align*}d^2&=(1+a^2)^2-(1-a^2)^2\\\\d^2&=4a^2\\\\d&=2|a|\\\\\\cos\\theta&=\\frac{2|a|}{1+a^2}\\\\\\tan\\theta&=\\frac{1-a^2}{2|a|}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p7-q44-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $\\sin^2\\theta+\\cos^2\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin^2\\theta+\\cos^2\\theta&=\\frac{(1-a^2)^2+4a^2}{(1+a^2)^2}\\\\\\sin^2\\theta+\\cos^2\\theta&=\\frac{1+2a^2+a^4}{(1+a^2)^2}\\\\\\sin^2\\theta+\\cos^2\\theta&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
