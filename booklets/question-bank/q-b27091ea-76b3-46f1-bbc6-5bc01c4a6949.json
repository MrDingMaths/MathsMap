  "content": {
    "id": "p42-q25",
    "type": "question",
    "label": "25",
    "prompt": "Elephants often weigh as much as 3 tonnes, while the heaviest mass a person can lift (usually in the Olympic games) is about 250 kg. What is the minimum number of people needed to lift an elephant?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12 people.",
      "worked": "$$\\begin{align*}\\text{Elephant's mass}&=3\\times1000\\text{ kg}\\\\\\text{Elephant's mass}&=3000\\text{ kg}\\\\\\text{Number of people}&=3000\\div250\\\\\\text{Number of people}&=12\\end{align*}$$\nThe minimum number is 12 people.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
  },
