  "content": {
    "id": "p37-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the average speed in km/h of a vehicle that travels:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "180 km in 2 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90\\text{ km/h}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{180}{2}\\\\s&=\\frac{90\\text{ km}}{1\\text{ h}}\\\\s&=90\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "485 km in 5 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$97\\text{ km/h}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{485}{5}\\\\s&=\\frac{97\\text{ km}}{1\\text{ h}}\\\\s&=97\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "360 km in 4.5 hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\text{ km/h}$",
          "worked": "$$\\begin{align*}s&=\\frac{d}{t}\\\\s&=\\frac{360}{4.5}\\\\s&=\\frac{80\\text{ km}}{1\\text{ h}}\\\\s&=80\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "21 km in $\\dfrac{1}{4}$ hour",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84\\text{ km/h}$",
          "worked": "$$\\begin{align*}t&=\\frac14\\text{ h}=0.25\\text{ h}\\\\s&=\\frac{d}{t}\\\\s&=\\frac{21}{0.25}\\\\s&=\\frac{84\\text{ km}}{1\\text{ h}}\\\\s&=84\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p37-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "240 km in $2\\dfrac{1}{2}$ hours",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$96\\text{ km/h}$",
          "worked": "$$\\begin{align*}t&=2\\frac12\\text{ h}=2.5\\text{ h}\\\\s&=\\frac{d}{t}\\\\s&=\\frac{240}{2.5}\\\\s&=\\frac{96\\text{ km}}{1\\text{ h}}\\\\s&=96\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p37-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "16 km in 20 minutes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ km/h}$",
          "worked": "$$\\begin{align*}t&=\\frac{20}{60}\\text{ h}=\\frac13\\text{ h}\\\\s&=\\frac{d}{t}\\\\s&=\\frac{16}{1/3}\\\\s&=\\frac{48\\text{ km}}{1\\text{ h}}\\\\s&=48\\text{ km/h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
