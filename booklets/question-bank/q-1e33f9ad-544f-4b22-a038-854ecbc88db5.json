  "content": {
    "id": "p43-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider $I=\\int x(x-1)^5\\,dx$, with $x=u+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $dx=du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$dx=du$.",
          "worked": "$$\\begin{aligned}x&=u+1\\\\\\frac{dx}{du}&=1\\\\dx&=du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p43-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $I=\\int u^5(u+1)\\,du$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\int u^5(u+1)\\,du$.",
          "worked": "$x=u+1$, so $u=x-1$ and $dx=du$.\n$$\\begin{aligned}I&=\\int (u+1)u^5\\,du\\\\&=\\int u^5(u+1)\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p43-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find $I$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\frac{(x-1)^7}{7}+\\frac{(x-1)^6}{6}+C$.",
          "worked": "$$\\begin{aligned}I&=\\int (u^6+u^5)\\,du\\\\&=\\frac{u^7}{7}+\\frac{u^6}{6}+C\\\\&=\\frac{(x-1)^7}{7}+\\frac{(x-1)^6}{6}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p43-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "Check by differentiating.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dx}\\left(\\frac{(x-1)^7}{7}+\\frac{(x-1)^6}{6}+C\\right)=x(x-1)^5$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\left(\\frac{(x-1)^7}{7}+\\frac{(x-1)^6}{6}+C\\right)&=(x-1)^6+(x-1)^5\\\\&=(x-1)^5(x-1+1)\\\\&=x(x-1)^5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
