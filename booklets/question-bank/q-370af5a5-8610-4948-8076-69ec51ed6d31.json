  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The triangle $ABC$ has vertices $A(-2,1)$, $B(-1,3)$ and $C(7,-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of $M$, the midpoint of $AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M(2.5,0)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{-2+7}{2},\\frac{1+(-1)}{2}\\right)\\\\M&=\\left(\\frac52,0\\right).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the distance $BM$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{85}}{2}$",
          "worked": "$$\\begin{align*}BM^2&=\\left(\\frac52-(-1)\\right)^2+(0-3)^2\\\\BM^2&=\\left(\\frac72\\right)^2+(-3)^2\\\\BM^2&=\\frac{49}{4}+9\\\\BM^2&=\\frac{85}{4}\\\\BM&=\\frac{\\sqrt{85}}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $M$ is equidistant from $A$, $B$ and $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AM=BM=CM=\\dfrac{\\sqrt{85}}{2}$, so $M$ is equidistant from $A$, $B$ and $C$.",
          "worked": "$$\\begin{align*}AC^2&=(7-(-2))^2+(-1-1)^2\\\\AC^2&=9^2+(-2)^2\\\\AC^2&=85\\\\AC&=\\sqrt{85}.\\end{align*}$$\nSince $M$ is the midpoint of $AC$, $AM=CM=\\dfrac{AC}{2}=\\dfrac{\\sqrt{85}}{2}$. From part b, $BM=\\dfrac{\\sqrt{85}}{2}$. Thus $AM=BM=CM$, so $M$ is equidistant from $A$, $B$ and $C$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
