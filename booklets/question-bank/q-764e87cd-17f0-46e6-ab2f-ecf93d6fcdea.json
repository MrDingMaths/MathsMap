            "answer": {
              "short": "$y<72$",
              "worked": "$$\\begin{align*}7y-18&<6y+54\\\\7y-6y&<54+18\\\\y&<72\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          }
