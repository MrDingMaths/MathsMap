            "type": "part",
            "label": "i",
            "prompt": "$\\frac{1}{3}x+5=\\frac{1}{4}x+7$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=24$",
              "worked": "$$\\begin{align*}4x+60&=3x+84\\\\4x-3x&=84-60\\\\x&=24\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p20-q11-equations-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\frac{3}{5}x+8=\\frac{3}{4}x+2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=40$",
              "worked": "$$\\begin{align*}12x+160&=15x+40\\\\12x-15x&=40-160\\\\-3x&=-120\\\\x&=40\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p20-q11-equations-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$10-\\frac{1}{2}x=\\frac{3}{4}x-10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=16$",
              "worked": "$$\\begin{align*}40-2x&=3x-40\\\\-2x-3x&=-40-40\\\\-5x&=-80\\\\x&=16\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          }
        ]
      },
      {
        "id": "p20-q11-inequalities",
