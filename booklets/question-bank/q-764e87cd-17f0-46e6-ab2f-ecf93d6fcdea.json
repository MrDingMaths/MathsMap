            "label": "iv",
            "prompt": "$\\frac{1}{5}y-3>\\frac{7}{10}y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y<-6$",
              "worked": "$$\\begin{align*}2y-30&>7y\\\\2y-7y&>30\\\\-5y&>30\\\\y&<-6\\end{align*}$$\nReverse the inequality sign when dividing by $-5$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 48
          },
          {
            "id": "p20-q11-inequalities-ii",
            "type": "part",
            "label": "v",
            "prompt": "$\\frac{5}{6}y-10\\le\\frac{2}{3}y-5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y\\le30$",
              "worked": "$$\\begin{align*}5y-60&\\le4y-30\\\\5y-4y&\\le60-30\\\\y&\\le30\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
