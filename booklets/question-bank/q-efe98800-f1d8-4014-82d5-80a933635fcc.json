  "content": {
    "id": "p24-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "For each of the following, write your answer in the form $y=mx+c$ where possible. Find the equation of the line through:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2,1)$ that is parallel to $y=2x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x-3$",
          "worked": "Parallel lines have equal gradients, so $m=2$.\n$$\\begin{align*}y-1&=2(x-2)\\\\y-1&=2x-4\\\\y&=2x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p24-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-2,3)$ that is parallel to $y=-3x+2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3x-3$",
          "worked": "Parallel lines have equal gradients, so $m=-3$.\n$$\\begin{align*}y-3&=-3(x+2)\\\\y-3&=-3x-6\\\\y&=-3x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p24-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1,2)$ that is parallel to $2y+3x=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac32x+\\frac72$",
          "worked": "$$\\begin{align*}2y&=-3x+6\\\\y&=-\\frac32x+3\\end{align*}$$\nThe required gradient is $m=-\\frac32$.\n$$\\begin{align*}y-2&=-\\frac32(x-1)\\\\y-2&=-\\frac32x+\\frac32\\\\y&=-\\frac32x+\\frac72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p24-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-3,-4)$ that is parallel to $4x-3y=12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac43x$",
          "worked": "$$\\begin{align*}3y&=4x-12\\\\y&=\\frac43x-4\\end{align*}$$\nThe required gradient is $m=\\frac43$.\n$$\\begin{align*}y+4&=\\frac43(x+3)\\\\y+4&=\\frac43x+4\\\\y&=\\frac43x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p24-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(1,4)$ that is parallel to $y=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=4$",
          "worked": "The line $y=3$ is horizontal. The horizontal line through $(1,4)$ is $y=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(3,5)$ that is parallel to $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "The line $x=2$ is vertical. The vertical line through $(3,5)$ is $x=3$. A vertical line cannot be written in the form $y=mx+c$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
