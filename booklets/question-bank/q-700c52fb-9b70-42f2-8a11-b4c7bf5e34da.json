  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A rectangle is four times as long as it is wide. The perimeter of the rectangle is 120 cm. Find the length and the width of the rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Length: $48\\text{ cm}$; width: $12\\text{ cm}$.",
      "worked": "Let the width be $x$ cm. Then the length is $4x$ cm.\n\n$$\\begin{align*}4x+4x+x+x&=120\\\\10x&=120\\\\x&=12\\end{align*}$$\n\nThe width is $12\\text{ cm}$ and the length is $4\\times12=48\\text{ cm}$.\n\nCheck: $2\\times48+2\\times12=120\\text{ cm}$ and $48=4\\times12$.",
      "solutionDiagrams": []
    },
