    "children": [
      {
        "id": "p23-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+y^2=9$ and $x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3,0)$",
          "worked": "Substitute $x=3$ into the circle equation:\n$$\\begin{align*}3^2+y^2&=9\\\\y^2&=0\\\\y&=0\\end{align*}$$\nThe point of intersection is $(3,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p23-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2=16$ and $y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-4,0)$ and $(4,0)$",
          "worked": "Substitute $y=0$ into the circle equation:\n$$\\begin{align*}x^2+0^2&=16\\\\x^2&=16\\\\x&=\\pm4\\end{align*}$$\nThe points of intersection are $(-4,0)$ and $(4,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p23-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+y^2=16$ and $y=\\sqrt{3}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,-2\\sqrt{3})$ and $(2,2\\sqrt{3})$",
          "worked": "Substitute $y=\\sqrt{3}x$ into the circle equation:\n$$\\begin{align*}x^2+(\\sqrt{3}x)^2&=16\\\\x^2+3x^2&=16\\\\4x^2&=16\\\\x^2&=4\\\\x&=\\pm2\\end{align*}$$\nWhen $x=-2$, $y=\\sqrt{3}(-2)=-2\\sqrt{3}$.\n\nWhen $x=2$, $y=\\sqrt{3}(2)=2\\sqrt{3}$.\n\nThe points of intersection are $(-2,-2\\sqrt{3})$ and $(2,2\\sqrt{3})$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
