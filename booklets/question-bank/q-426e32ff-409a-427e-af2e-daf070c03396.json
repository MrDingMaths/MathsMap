            "label": "ii",
            "prompt": "20 people lived in Melbourne and 30 people lived in Brisbane",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$31.4^\\circ\\mathrm{S},\\ 149.8^\\circ\\mathrm{E}$",
              "worked": "$$\\begin{align*}\\text{Average latitude}&=\\frac{20\\times38+30\\times27}{20+30}\\,{}^\\circ\\mathrm{S}\\\\\\text{Average latitude}&=\\frac{1570}{50}\\,{}^\\circ\\mathrm{S}\\\\\\text{Average latitude}&=31.4^\\circ\\mathrm{S}\\\\\\text{Average longitude}&=\\frac{20\\times145+30\\times153}{20+30}\\,{}^\\circ\\mathrm{E}\\\\\\text{Average longitude}&=\\frac{7490}{50}\\,{}^\\circ\\mathrm{E}\\\\\\text{Average longitude}&=149.8^\\circ\\mathrm{E}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
