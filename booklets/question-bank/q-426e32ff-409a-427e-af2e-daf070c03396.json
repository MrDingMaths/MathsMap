            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$34.3^\\circ\\mathrm{S},\\ 147.7^\\circ\\mathrm{E}$",
              "worked": "$$\\begin{align*}\\text{Average latitude}&=\\frac{10\\times38+5\\times27}{10+5}\\,{}^\\circ\\mathrm{S}\\\\\\text{Average latitude}&=\\frac{515}{15}\\,{}^\\circ\\mathrm{S}\\\\\\text{Average latitude}&\\approx34.3^\\circ\\mathrm{S}\\\\\\text{Average longitude}&=\\frac{10\\times145+5\\times153}{10+5}\\,{}^\\circ\\mathrm{E}\\\\\\text{Average longitude}&=\\frac{2215}{15}\\,{}^\\circ\\mathrm{E}\\\\\\text{Average longitude}&\\approx147.7^\\circ\\mathrm{E}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p29-challenge-q1-b-ii",
