  "content": {
    "id": "p23-review-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The temperature in Canberra had gone down to $-5^{\\circ}\\mathrm{C}$. The temperature in a heated house was a cosy $22^{\\circ}\\mathrm{C}$. What was the value of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-review-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "inside temperature $-$ outside temperature?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$27^{\\circ}\\mathrm{C}$",
          "worked": "$$\\begin{align*}22-(-5)&=22+5\\\\22-(-5)&=27\\end{align*}$$\nThe value is $27^{\\circ}\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-review-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "outside temperature $-$ inside temperature?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-27^{\\circ}\\mathrm{C}$",
          "worked": "$$\\begin{align*}-5-22&=-(5+22)\\\\-5-22&=-27\\end{align*}$$\nThe value is $-27^{\\circ}\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
