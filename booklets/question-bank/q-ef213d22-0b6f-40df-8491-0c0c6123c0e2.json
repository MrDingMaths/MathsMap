  "content": {
    "id": "p60-q20-root",
    "type": "question",
    "label": null,
    "prompt": "When an object is thrown up a hill, its maximum range $R$ is the greatest distance it can reach. The maximum range of an object varies directly with the square of the speed $V$ it is thrown at.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q20-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Write this algebraically using $k$ as the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=kV^2$.",
          "worked": "Direct variation with the square of $V$ gives $R=kV^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p60-q20-part-b",
        "type": "part",
        "label": "b",
        "prompt": "It is found that $R=5.505\\text{ m}$, correct to four significant figures, when $V=9\\text{ m s}^{-1}$. Evaluate $k$ correct to four significant figures.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=0.06796\\text{ s}^2\\text{ m}^{-1}$ (4 significant figures).",
          "worked": "$$\\begin{align*}5.505&=k\\times9^2\\\\k&=\\frac{5.505}{81}\\\\k&=\\frac{367}{5400}\\\\k&\\approx0.06796\\text{ s}^2\\text{ m}^{-1}\\quad\\text{(4 significant figures).}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p60-q20-part-c",
        "type": "part",
        "label": "c",
        "prompt": "What is $R$ when $V=15\\text{ m s}^{-1}$? Give your answer correct to the nearest centimetre.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R=15.29\\text{ m}$ (nearest centimetre).",
          "worked": "Using the unrounded constant from part b:\n$$\\begin{align*}R&=\\frac{367}{5400}\\times15^2\\\\R&=\\frac{367}{24}\\text{ m}\\\\R&\\approx15.29\\text{ m}\\quad\\text{(nearest centimetre).}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
