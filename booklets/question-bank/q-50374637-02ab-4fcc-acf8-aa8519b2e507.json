  "content": {
    "id": "v2-3b3-p16-foundation-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "The mean mass of 5 school bags is 6 kg. A sixth bag is added and the mean mass is now 7 kg.\nWhat is the mass of the sixth bag?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12$ kg",
      "worked": "Let $x$ be the mass of the sixth bag.\n\n$$\\begin{align*}7&=\\frac{5\\times6+x}{6}\\\\7&=\\frac{30+x}{6}\\\\42&=30+x\\\\x&=12\\end{align*}$$\n\nThe sixth bag has a mass of 12 kg.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
