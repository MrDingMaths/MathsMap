  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A bag of sweets contains 10 red ones, nine green ones, six yellow ones and five blue ones. They are all the same size and shape. You reach in and take one out at random. Find the probability that the sweet you pick is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "blue",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "Total sweets: $10+9+6+5=30$.\n\n$$\\begin{align*}P(\\text{blue})&=\\frac{5}{30}\\\\P(\\text{blue})&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "green or yellow",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are $30$ sweets altogether. Favourable sweets: $9+6=15$.\n\n$$\\begin{align*}P(\\text{green or yellow})&=\\frac{15}{30}\\\\P(\\text{green or yellow})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p11-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "not red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "There are $30$ sweets altogether. Sweets that are not red: $9+6+5=20$.\n\n$$\\begin{align*}P(\\text{not red})&=\\frac{20}{30}\\\\P(\\text{not red})&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "purple",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "There are no purple sweets among the $30$ sweets.\n\n$P(\\text{purple})=\\frac{0}{30}=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "neither yellow nor blue",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19}{30}$",
          "worked": "The favourable sweets are red or green: $10+9=19$. There are $30$ sweets altogether.\n\n$P(\\text{neither yellow nor blue})=\\frac{19}{30}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
