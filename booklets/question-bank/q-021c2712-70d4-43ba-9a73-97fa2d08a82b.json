  "content": {
    "id": "p7-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "In the Federal Parliament, there are 150 members in the House of Representatives, of whom 37 are from Victoria.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Correct to 1 decimal place, what percentage of members are from Victoria?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24.7\\%$",
          "worked": "$\\frac{37}{150}\\times100\\%\\approx24.7\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "The population of Australia is about 22.6 million. What percentage of Australians are members of the House of Representatives? Give your answer correct to 6 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.000664\\%$",
          "worked": "$22.6$ million $=22600000$. Hence $\\frac{150}{22600000}\\times100\\%\\approx0.000664\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
