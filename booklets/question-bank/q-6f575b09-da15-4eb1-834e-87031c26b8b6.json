                "type": "text",
                "text": "There are 4 aces and 48 other cards. The draws are without replacement.",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\begin{align*}P(Y=0)&=\\frac{48}{52}\\times\\frac{47}{51}=\\frac{188}{221}\\\\P(Y=5)&=\\frac{4}{52}\\times\\frac{48}{51}+\\frac{48}{52}\\times\\frac{4}{51}=\\frac{32}{221}\\\\P(Y=10)&=\\frac{4}{52}\\times\\frac{3}{51}=\\frac{1}{221}\\end{align*}",
                "display": true
