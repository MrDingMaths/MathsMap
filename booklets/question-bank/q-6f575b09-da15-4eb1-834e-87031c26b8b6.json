            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}E(Y)&=0\\left(\\frac{188}{221}\\right)+5\\left(\\frac{32}{221}\\right)+10\\left(\\frac{1}{221}\\right)\\\\E(Y)&=\\frac{10}{13}\\approx0.77\\\\E(Y^2)&=0^2\\left(\\frac{188}{221}\\right)+5^2\\left(\\frac{32}{221}\\right)+10^2\\left(\\frac{1}{221}\\right)\\\\E(Y^2)&=\\frac{900}{221}\\\\\\operatorname{Var}(Y)&=E(Y^2)-[E(Y)]^2\\\\\\operatorname{Var}(Y)&=\\frac{900}{221}-\\left(\\frac{10}{13}\\right)^2\\\\\\operatorname{Var}(Y)&=\\frac{10000}{2873}\\approx3.48\\\\\\sigma&=\\sqrt{\\frac{10000}{2873}}\\approx1.87\\end{align*}",
                "display": true
              }
            ]
