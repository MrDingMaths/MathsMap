  "content": {
    "id": "p13-q13",
    "type": "question",
    "label": "13",
    "prompt": "The radius of a sphere is increasing at a constant rate of $k\\text{ cm/s}$. If the radius is $R\\text{ cm}$, find the rate of increase of the following, in terms of $\\pi$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Surface area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\pi Rk\\text{ cm}^2/\\text{s}$.",
          "worked": "With $\\dfrac{dr}{dt}=k$,\n$$\\begin{aligned}S&=4\\pi r^2\\\\\\frac{dS}{dt}&=\\frac{dS}{dr}\\frac{dr}{dt}\\\\\\frac{dS}{dt}&=8\\pi rk.\\end{aligned}$$\nWhen $r=R$,\n$$\\frac{dS}{dt}=8\\pi Rk\\text{ cm}^2/\\text{s}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Volume.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\pi R^2k\\text{ cm}^3/\\text{s}$.",
          "worked": "With $\\dfrac{dr}{dt}=k$,\n$$\\begin{aligned}V&=\\frac{4}{3}\\pi r^3\\\\\\frac{dV}{dt}&=\\frac{dV}{dr}\\frac{dr}{dt}\\\\\\frac{dV}{dt}&=4\\pi r^2k.\\end{aligned}$$\nWhen $r=R$,\n$$\\frac{dV}{dt}=4\\pi R^2k\\text{ cm}^3/\\text{s}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
