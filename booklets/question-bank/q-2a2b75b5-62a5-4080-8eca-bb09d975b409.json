  "content": {
    "id": "p8-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Let $3-\\sqrt2$ be a root of the quadratic equation $x^2+mx+7=0$, where $m$ is a rational number. Find the",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "other root",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3+\\sqrt2$",
          "worked": "Let the other root be $\\beta$.\n$$\\begin{aligned}(3-\\sqrt2)\\beta&=7\\\\\\beta&=\\frac7{3-\\sqrt2}\\\\\\beta&=\\frac{7(3+\\sqrt2)}{9-2}\\\\\\beta&=3+\\sqrt2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "value of $m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-6$",
          "worked": "$$\\begin{aligned}(3-\\sqrt2)+(3+\\sqrt2)&=-m\\\\6&=-m\\\\m&=-6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
