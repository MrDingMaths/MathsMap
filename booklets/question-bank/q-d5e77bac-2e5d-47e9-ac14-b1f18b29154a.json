  "content": {
    "id": "p39-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Solve the following for $\\theta\\in[0^{\\circ},360^{\\circ}]$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos^{2}\\theta=\\sin\\theta-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=90^{\\circ}$",
          "worked": "$$\\begin{align*}1-\\sin^{2}\\theta&=\\sin\\theta-1\\\\\\sin^{2}\\theta+\\sin\\theta-2&=0\\\\(\\sin\\theta+2)(\\sin\\theta-1)&=0\\\\\\sin\\theta&=-2\\quad\\text{or}\\quad\\sin\\theta=1\\end{align*}$$\nSince $-1\\leq\\sin\\theta\\leq1$, reject $\\sin\\theta=-2$.\n$$\\theta=90^{\\circ}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p39-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sec^{2}\\theta-\\tan\\theta-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=0^{\\circ},45^{\\circ},180^{\\circ},225^{\\circ},360^{\\circ}$",
          "worked": "$$\\begin{align*}1+\\tan^{2}\\theta-\\tan\\theta-1&=0\\\\\\tan^{2}\\theta-\\tan\\theta&=0\\\\\\tan\\theta(\\tan\\theta-1)&=0\\\\\\tan\\theta&=0\\quad\\text{or}\\quad\\tan\\theta=1\\\\\\theta&=0^{\\circ},45^{\\circ},180^{\\circ},225^{\\circ},360^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos^{2}\\theta-\\sin^{2}\\theta+3\\cos\\theta+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=120^{\\circ},180^{\\circ},240^{\\circ}$",
          "worked": "$$\\begin{align*}2\\cos^{2}\\theta-1+3\\cos\\theta+2&=0\\\\2\\cos^{2}\\theta+3\\cos\\theta+1&=0\\\\(2\\cos\\theta+1)(\\cos\\theta+1)&=0\\\\\\cos\\theta&=-\\frac12\\quad\\text{or}\\quad\\cos\\theta=-1\\\\\\theta&=120^{\\circ},180^{\\circ},240^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\tan^{2}\\theta-\\sec\\theta-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\theta=60^{\\circ},180^{\\circ},300^{\\circ}$",
          "worked": "$$\\begin{align*}\\sec^{2}\\theta-1-\\sec\\theta-1&=0\\\\\\sec^{2}\\theta-\\sec\\theta-2&=0\\\\(\\sec\\theta-2)(\\sec\\theta+1)&=0\\\\\\sec\\theta&=2\\quad\\text{or}\\quad\\sec\\theta=-1\\\\\\cos\\theta&=\\frac12\\quad\\text{or}\\quad\\cos\\theta=-1\\\\\\theta&=60^{\\circ},180^{\\circ},300^{\\circ}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
