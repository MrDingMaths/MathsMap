        "answer": {
          "short": "$x\\geq2$ or $x\\leq2$.",
          "worked": "The turning point is $(2,0)$. Restrict to either side, including the turning point: $x\\geq2$ or $x\\leq2$.",
          "solutionDiagrams": []
