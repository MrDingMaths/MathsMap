        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\geq1$ or $x\\leq1$.",
          "worked": "$$\\begin{align*}y&=x^2-2x-3\\\\y&=(x-1)^2-4\\end{align*}$$\nThe turning point is $(1,-4)$. The two restrictions are $x\\geq1$ or $x\\leq1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
