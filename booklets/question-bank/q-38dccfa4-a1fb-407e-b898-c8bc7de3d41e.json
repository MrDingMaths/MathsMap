  "content": {
    "id": "v2-c46b1-p29-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of the tangent to the curve, in general form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-c46b1-p29-practice-slot-6-slot-6-qa",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^4-3x^2$ where $x=-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20x+y+36=0$",
          "worked": "Point of tangency:\n$$\\begin{align*}y_1&=(-2)^4-3(-2)^2\\\\&=4\\end{align*}$$\nGradient function and tangent gradient:\n$$\\begin{align*}\\frac{dy}{dx}&=4x^3-6x\\\\m&=4(-2)^3-6(-2)\\\\&=-20\\end{align*}$$\nEquation of the tangent:\n$$\\begin{align*}y-4&=-20(x+2)\\\\y-4&=-20x-40\\\\20x+y+36&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-c46b1-p29-practice-slot-6-slot-6-qb",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^3}{3}-2x+1$ where $x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7x-y-17=0$",
          "worked": "Point of tangency:\n$$\\begin{align*}y_1&=\\frac{3^3}{3}-2(3)+1\\\\&=4\\end{align*}$$\nGradient function and tangent gradient:\n$$\\begin{align*}\\frac{dy}{dx}&=x^2-2\\\\m&=3^2-2\\\\&=7\\end{align*}$$\nEquation of the tangent:\n$$\\begin{align*}y-4&=7(x-3)\\\\y-4&=7x-21\\\\7x-y-17&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
