  "content": {
    "id": "p4-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Without using a calculator, find an integer $n$ for which:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$n<\\log_2 12<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}2^3&=8\\\\2^4&=16\\end{align*}$$\nSince $8<12<16$, $3<\\log_2 12<4$. Hence $n=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$n<\\log_3 30<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=3$",
          "worked": "$$\\begin{align*}3^3&=27\\\\3^4&=81\\end{align*}$$\nSince $27<30<81$, $3<\\log_3 30<4$. Hence $n=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$n<\\log_5 30<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$",
          "worked": "$$\\begin{align*}5^2&=25\\\\5^3&=125\\end{align*}$$\nSince $25<30<125$, $2<\\log_5 30<3$. Hence $n=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$n<\\log_7 50<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=2$",
          "worked": "$$\\begin{align*}7^2&=49\\\\7^3&=343\\end{align*}$$\nSince $49<50<343$, $2<\\log_7 50<3$. Hence $n=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p4-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$n<\\log_{10}12\\,345<n+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=4$",
          "worked": "$$\\begin{align*}10^4&=10\\,000\\\\10^5&=100\\,000\\end{align*}$$\nSince $10\\,000<12\\,345<100\\,000$, $4<\\log_{10}12\\,345<5$. Hence $n=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
