        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}f(0)&=2(0)+1\\\\f(0)&=1\\\\g(f(0))&=5-1^2\\\\g(f(0))&=4\\end{align*}$$",
