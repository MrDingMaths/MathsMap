  "content": {
    "id": "v2-piecework-practice-slot-16-root",
    "type": "question",
    "label": null,
    "prompt": "Tahlia is comparing painters for her $140\\text{ m}^2$ of walls.\n\nNathan charges $\\$250+\\$11.60/\\text{m}^2$\n\nOlivia charges $\\$14.20/\\text{m}^2$\n\nWho offers the cheaper option for Tahlia’s walls, and by how much?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Nathan is cheaper by \\$114.00.",
      "worked": "$$\\begin{align*}\\text{Nathan's charge}&=\\$250+(140\\times\\$11.60)\\\\&=\\$1874.00\\\\\\text{Olivia's charge}&=140\\times\\$14.20\\\\&=\\$1988.00\\\\\\text{Difference}&=\\$1988.00-\\$1874.00\\\\&=\\$114.00\\end{align*}$$\nNathan offers the cheaper option by \\$114.00.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
