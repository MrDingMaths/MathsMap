  "content": {
    "id": "p14-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For each of the following, find the value(s) of $a$ so that the function is continuous.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$$f(x)=\\begin{cases}x^2+ax,&x\\leq1\\\\5x-2,&x>1\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$.",
          "worked": "For continuity at $x=1$, the two formulas must agree:\n$$\\begin{align*}1^2+a(1)&=5(1)-2\\\\1+a&=3\\\\a&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$f(x)=\\begin{cases}3x+a,&x<0\\\\x^2-2x+1,&x\\geq0\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$.",
          "worked": "For continuity at $x=0$,\n$$\\begin{align*}3(0)+a&=0^2-2(0)+1\\\\a&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p14-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$f(x)=\\begin{cases}2x+3,&x<1\\\\-x^2+a,&x\\geq1\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6$.",
          "worked": "For continuity at $x=1$,\n$$\\begin{align*}2(1)+3&=-(1)^2+a\\\\5&=-1+a\\\\a&=6.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p14-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$$f(x)=\\begin{cases}ax+2,&x\\leq2\\\\2a^2x,&x>2\\end{cases}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\frac12$ or $a=1$.",
          "worked": "For continuity at $x=2$,\n$$\\begin{align*}a(2)+2&=2a^2(2)\\\\2a+2&=4a^2\\\\2a^2-a-1&=0\\\\(2a+1)(a-1)&=0.\\end{align*}$$\nThus $a=-\\frac12$ or $a=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
