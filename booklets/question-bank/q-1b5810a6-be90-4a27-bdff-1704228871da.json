    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the coordinates of the point $R$ on the curve $y=e^{3x+1}$ where $x=-\\frac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$R\\left(-\\frac{1}{3},1\\right)$",
          "worked": "$$\\begin{align*}y&=e^{3(-\\frac{1}{3})+1}\\\\y&=e^0\\\\y&=1\\end{align*}$$\nThus $R\\left(-\\frac{1}{3},1\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\frac{dy}{dx}$ and hence show that the gradient of the tangent at $R$ is $3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\displaystyle\\frac{dy}{dx}=3e^{3x+1}$; at $R$, the tangent gradient is $3$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3e^{3x+1}\\\\m_{\\mathrm{tangent}}&=3e^{3(-\\frac{1}{3})+1}\\\\m_{\\mathrm{tangent}}&=3e^0\\\\m_{\\mathrm{tangent}}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p10-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the gradient of the normal at $R$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{3}$",
          "worked": "The normal is perpendicular to the tangent, so its gradient is the negative reciprocal:\n$$m_{\\mathrm{normal}}=-\\frac{1}{3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p10-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find the equation of the normal at $R$ in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+9y-8=0$",
          "worked": "$$\\begin{align*}y-1&=-\\frac{1}{3}\\left(x+\\frac{1}{3}\\right)\\\\3y-3&=-x-\\frac{1}{3}\\\\x+3y&=\\frac{8}{3}\\\\3x+9y-8&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
