  "content": {
    "id": "p26-q42-content",
    "type": "question",
    "label": "42",
    "prompt": "Find the $x$-coordinate of the point on $y=2x-4e^x$ where the normal is parallel to $x+y=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=-2\\ln2$",
      "worked": "The line $x+y=3$ has gradient $-1$, so the normal has gradient $-1$ and the tangent has gradient $1$.\n\n$$y'=2-4e^x$$\n\n$$\\begin{align*}2-4e^x&=1\\\\4e^x&=1\\\\e^x&=\\frac14\\\\x&=\\ln\\left(\\frac14\\right)=-2\\ln2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
