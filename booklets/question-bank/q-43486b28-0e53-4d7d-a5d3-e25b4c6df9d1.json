  "content": {
    "id": "p5-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Let $f(x)=px^2-x$. Find the value of $p$ if $f(-3)=2f(2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=-7$.",
      "worked": "$$\\begin{align*}f(-3)&=9p+3,\\\\f(2)&=4p-2.\\end{align*}$$\nUsing $f(-3)=2f(2)$,\n$$\\begin{align*}9p+3&=2(4p-2)\\\\9p+3&=8p-4\\\\p&=-7.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
