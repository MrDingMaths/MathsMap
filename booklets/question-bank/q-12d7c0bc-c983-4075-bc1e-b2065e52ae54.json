  "content": {
    "id": "p19-q2",
    "type": "question",
    "label": "4",
    "prompt": "Differentiate the following using the quotient rule.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\frac{x-1}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{2}{(x+1)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{(x+1)-(x-1)}{(x+1)^2}\\\\ y'&=\\frac{2}{(x+1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac{3x+1}{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{5}{(2x-1)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{3(2x-1)-2(3x+1)}{(2x-1)^2}\\\\ y'&=\\frac{6x-3-6x-2}{(2x-1)^2}\\\\ y'&=-\\frac{5}{(2x-1)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{x^2}{3x+5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{x(3x+10)}{(3x+5)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{2x(3x+5)-3x^2}{(3x+5)^2}\\\\ y'&=\\frac{3x^2+10x}{(3x+5)^2}\\\\ y'&=\\frac{x(3x+10)}{(3x+5)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p19-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{1-x^2}{1+x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{4x}{(1+x^2)^2}$",
          "worked": "$$\\begin{align*}y'&=\\frac{-2x(1+x^2)-2x(1-x^2)}{(1+x^2)^2}\\\\ y'&=\\frac{-2x-2x^3-2x+2x^3}{(1+x^2)^2}\\\\ y'&=-\\frac{4x}{(1+x^2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p19-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{a-x}{a+x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{2a}{(a+x)^2}$",
          "worked": "Treat $a$ as constant. $$\\begin{align*}y'&=\\frac{-(a+x)-(a-x)}{(a+x)^2}\\\\ y'&=\\frac{-a-x-a+x}{(a+x)^2}\\\\ y'&=-\\frac{2a}{(a+x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{ax+b}{bx+a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{a^2-b^2}{(bx+a)^2}$",
          "worked": "Treat $a$ and $b$ as constants. $$\\begin{align*}y'&=\\frac{a(bx+a)-b(ax+b)}{(bx+a)^2}\\\\ y'&=\\frac{abx+a^2-abx-b^2}{(bx+a)^2}\\\\ y'&=\\frac{a^2-b^2}{(bx+a)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
