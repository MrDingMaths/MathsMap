  "content": {
    "id": "p66-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "In each part, the angle of inclination $\\alpha$ and the $y$-intercept $c$ of a line are given. Use $m=\\tan\\alpha$ to find the gradient of each line, then find its equation in exact general form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p66-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha=45^{\\circ},\\ c=(0,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$; $x-y+3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan45^{\\circ}\\\\m&=1\\\\y&=x+3\\\\x-y+3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p66-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha=60^{\\circ},\\ c=(0,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\sqrt3$; $-\\sqrt3x+y+1=0$.",
          "worked": "$$\\begin{align*}m&=\\tan60^{\\circ}\\\\m&=\\sqrt3\\\\y&=\\sqrt3x-1\\\\-\\sqrt3x+y+1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p66-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha=30^{\\circ},\\ c=(0,-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\dfrac1{\\sqrt3}$; $x-\\sqrt3y-2\\sqrt3=0$.",
          "worked": "$$\\begin{align*}m&=\\tan30^{\\circ}\\\\m&=\\frac1{\\sqrt3}\\\\y&=\\frac{x}{\\sqrt3}-2\\\\\\sqrt3y&=x-2\\sqrt3\\\\x-\\sqrt3y-2\\sqrt3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p66-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\alpha=135^{\\circ},\\ c=(0,1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-1$; $x+y-1=0$.",
          "worked": "$$\\begin{align*}m&=\\tan135^{\\circ}\\\\m&=-1\\\\y&=-x+1\\\\x+y-1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
