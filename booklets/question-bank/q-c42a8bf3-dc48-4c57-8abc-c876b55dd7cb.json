  "content": {
    "id": "p19-g-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the equation of the line through the given pairs of points. Write your answers in standard form.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-g-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,1),(3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2y-x=1$",
          "worked": "$$m=\\frac{2-1}{3-1}=\\frac12$$\n$$\\begin{align*}y-1&=\\frac12(x-1)\\\\2(y-1)&=x-1\\\\2y-2&=x-1\\\\2y-x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p19-g-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1,2),(2,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y+3x=5$",
          "worked": "$$m=\\frac{-1-2}{2-1}=-3$$\n$$\\begin{align*}y-2&=-3(x-1)\\\\y-2&=-3x+3\\\\y+3x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-g-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(-2,1),(3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5y-x=7$",
          "worked": "$$m=\\frac{2-1}{3-(-2)}=\\frac15$$\n$$\\begin{align*}y-1&=\\frac15(x+2)\\\\5(y-1)&=x+2\\\\5y-5&=x+2\\\\5y-x&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p19-g-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-2,2),(-1,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-x=4$",
          "worked": "$$m=\\frac{3-2}{-1-(-2)}=1$$\n$$\\begin{align*}y-2&=1(x+2)\\\\y-2&=x+2\\\\y-x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-g-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-1,1),(1,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y+x=0$",
          "worked": "$$m=\\frac{-1-1}{1-(-1)}=-1$$\n$$\\begin{align*}y-1&=-(x+1)\\\\y-1&=-x-1\\\\y+x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-g-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac14,\\frac12\\right),\\left(\\frac12,\\frac34\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4y-4x=1$",
          "worked": "$$m=\\frac{\\frac34-\\frac12}{\\frac12-\\frac14}=\\frac{\\frac14}{\\frac14}=1$$\n$$\\begin{align*}y-\\frac12&=x-\\frac14\\\\4\\left(y-\\frac12\\right)&=4\\left(x-\\frac14\\right)\\\\4y-2&=4x-1\\\\4y-4x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
