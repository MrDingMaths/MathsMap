              "type": "text",
              "text": "The sum of three numbers in an arithmetic progression is 12, and the sum of their squares is 56. Find the numbers.",
              "marks": []
            }
          ]
        },
        {
          "id": "p5-q7-hint",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Hint: We can express the numbers as: ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "a-d,\\ a,\\ a+d",
              "display": false
            },
            {
              "type": "text",
