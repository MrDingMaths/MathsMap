  "content": {
    "id": "p14-q6",
    "type": "question",
    "label": "6",
    "prompt": "Find the values of $\\lambda$ for which the vectors $\\mathbf u=\\lambda^2\\mathbf i+2\\mathbf j$ and $\\mathbf v=3\\mathbf i-(2+2\\lambda)\\mathbf j$ are perpendicular.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\lambda=-\\frac23$ or $2$",
      "worked": "For perpendicular vectors, $\\mathbf u\\cdot\\mathbf v=0$.\n\n$$\\begin{align*}\\lambda^2(3)+2(-2-2\\lambda)&=0\\\\3\\lambda^2-4-4\\lambda&=0\\\\3\\lambda^2-4\\lambda-4&=0\\\\(3\\lambda+2)(\\lambda-2)&=0\\\\\\lambda&=-\\frac23\\text{ or }2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
