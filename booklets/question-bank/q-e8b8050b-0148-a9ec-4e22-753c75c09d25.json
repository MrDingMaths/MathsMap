  "content": {
    "id": "p4-q27-group-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q27-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{8a^5}{2a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^3$, $a\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{8a^5}{2a^2}&=\\frac82a^{5-2}\\\\\\frac{8a^5}{2a^2}&=4a^3\\end{align*}$$The original denominator requires $a\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q28-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{-4b^5}{b^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4b^2$, $b\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{-4b^5}{b^3}&=-4b^{5-3}\\\\\\frac{-4b^5}{b^3}&=-4b^2\\end{align*}$$The original denominator requires $b\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q29-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{10c^2}{15c^6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac2{3c^4}$, $c\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{10c^2}{15c^6}&=\\frac{10}{15}c^{2-6}\\\\\\frac{10c^2}{15c^6}&=\\frac23c^{-4}\\\\\\frac{10c^2}{15c^6}&=\\frac2{3c^4}\\end{align*}$$The original denominator requires $c\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p4-q30-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{8t^3}{2t^5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac4{t^2}$, $t\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{8t^3}{2t^5}&=\\frac82t^{3-5}\\\\\\frac{8t^3}{2t^5}&=4t^{-2}\\\\\\frac{8t^3}{2t^5}&=\\frac4{t^2}\\end{align*}$$The original denominator requires $t\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
