  "content": {
    "id": "p24-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A bag contains one blue and three red marbles. A marble is taken from the bag and its colour is noted. Without returning the marble, a second marble is chosen. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "both marbles are red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Without replacement, two red marbles remain among three marbles after the first red marble is drawn.\n$$\\begin{align*}\\Pr(\\text{both red})&=\\frac{3}{4}\\times\\frac{2}{3}\\\\\\Pr(\\text{both red})&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "both marbles are blue",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "There is only one blue marble, so drawing two blue marbles without replacement is impossible.\n$$\\Pr(\\text{both blue})=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p24-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "the first marble is red and the second is blue.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "After a red marble is drawn, one blue marble remains among three marbles.\n$$\\begin{align*}\\Pr(\\text{first red and second blue})&=\\frac{3}{4}\\times\\frac{1}{3}\\\\\\Pr(\\text{first red and second blue})&=\\frac{1}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
