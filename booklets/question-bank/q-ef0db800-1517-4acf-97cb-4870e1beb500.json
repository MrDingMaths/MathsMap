  "content": {
    "id": "p17-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Let $k$ be any real number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the discriminant of $x^2-kx=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k^2$",
          "worked": "$$\\begin{align*}\\Delta&=(-k)^2-4(1)(0)\\\\\\Delta&=k^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p17-q12-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
