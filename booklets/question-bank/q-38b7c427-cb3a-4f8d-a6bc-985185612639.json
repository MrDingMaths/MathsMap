  "content": {
    "id": "v2-04c12d-p5-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "The 2nd term of a geometric sequence is $-12$ and the 6th term is $-972$.\nFind the first term(s).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-4$ (when $r=3$) or $a=4$ (when $r=-3$).",
      "worked": "$$\\begin{align*}a_2&=ar=-12\\qquad (1)\\\\a_6&=ar^5=-972\\qquad (2)\\\\\\frac{(2)}{(1)}:\\quad r^4&=81\\\\r&=\\pm3\\end{align*}$$\nSubstituting into (1):\n$$\\text{If }r=3,\\ a=-4$$\n$$\\text{If }r=-3,\\ a=4$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
