    "children": [
      {
        "id": "p19-difference-of-squares-a",
        "type": "part",
        "label": "a",
        "prompt": "Use an area model to expand $(x-6)(x+6)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-36$",
          "worked": "The four products are $x^2$, $6x$, $-6x$ and $-36$.\n\n$(x-6)(x+6)=x^2+6x-6x-36=x^2-36$",
          "solutionDiagrams": [
            {
              "id": "p19-difference-of-squares-solution",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User-authorised area-model scaffold\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\path[use as bounding box] (-0.65,-0.15) rectangle (3.05,2.65);\n\\draw[black,line width=0.8pt] (0,0) rectangle (3,2);\n\\draw[black,dotted,line width=0.4pt] (1.5,0)--(1.5,2) (0,1)--(3,1);\n\\node[above] at (0.75,2) {$x$};\n\\node[above] at (2.25,2) {$6$};\n\\node[left] at (0,1.5) {$x$};\n\\node[left] at (0,0.5) {$-6$};\n\\node at (0.75,1.5) {$x^2$};\n\\node at (2.25,1.5) {$6x$};\n\\node at (0.75,0.5) {$-6x$};\n\\node at (2.25,0.5) {$-36$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 46,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "description": "Completed signed-product area model.",
                "mathematics": "Rows x, -6; columns x, 6; products x^2, 6x, -6x, -36.",
                "answerVisibility": "Solution only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p19-difference-of-squares-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why there is no $x$ term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The terms $6x$ and $-6x$ cancel because their sum is zero.",
          "worked": "The two linear products are $x\\times6=6x$ and $(-6)\\times x=-6x$. Their sum is $0$, so there is no $x$ term.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
