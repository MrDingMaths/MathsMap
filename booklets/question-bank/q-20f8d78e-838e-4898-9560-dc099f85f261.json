    "children": [
      {
        "id": "p24-q13a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can 15 identical coins be distributed among 4 children so that each child receives at least one coin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$364$",
          "worked": "Represent the 15 coins by 15 stars. Choose 3 of the 14 gaps between stars for bars, giving four non-empty groups.\n\n$$N=\\binom{14}{3}=364.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q13b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p24-q13b-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "How many ways can this be done so that each child receives at least 2 coins?",
                  "marks": []
                }
              ]
            },
            {
              "id": "p24-q13b-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Hint: Subtract 2 coins for each child and then allocate the rest.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$\n\nGive each child 2 coins, then distribute the remaining 7 using stars and bars.",
          "worked": "Give each child 2 coins first. There are $15-4\\times2=7$ coins left, with no minimum allocation. Arrange 7 stars and 3 bars.\n\n$$N=\\binom{7+3}{3}=\\binom{10}{3}=120.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p24-q13c",
        "type": "part",
        "label": "c",
        "prompt": "How many ways can this be done so that each child receives at least 3 coins?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$\n\nGive each child 3 coins, then distribute the remaining 3 using stars and bars.",
          "worked": "Give each child 3 coins first. There are $15-4\\times3=3$ coins left, with no minimum allocation. Arrange 3 stars and 3 bars.\n\n$$N=\\binom{3+3}{3}=\\binom{6}{3}=20.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
