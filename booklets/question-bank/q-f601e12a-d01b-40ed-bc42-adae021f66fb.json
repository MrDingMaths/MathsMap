    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\log_a(b)=\\frac{1}{\\log_b(a)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Changing to base $b$ gives $\\log_a(b)=\\dfrac{\\log_b(b)}{\\log_b(a)}=\\dfrac{1}{\\log_b(a)}$.",
          "worked": "For positive bases $a$ and $b$ with $a,b\\ne1$, change to base $b$.\n\n$$\\begin{align*}\\log_a(b)&=\\frac{\\log_b(b)}{\\log_b(a)}\\\\\\log_a(b)&=\\frac{1}{\\log_b(a)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the value of $\\log_{\\sqrt{27}}(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$\n\nTake the reciprocal of $\\log_3(\\sqrt{27})$ using part (a).",
          "worked": "Since $\\sqrt{27}=3^{3/2}$, apply the identity from part (a).\n\n$$\\begin{align*}\\log_{\\sqrt{27}}(3)&=\\frac{1}{\\log_3(\\sqrt{27})}\\\\\\log_{\\sqrt{27}}(3)&=\\frac{1}{3/2}\\\\\\log_{\\sqrt{27}}(3)&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
