  "content": {
    "id": "p34-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A normally distributed data set has mean 16 and standard deviation 1.9.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q15-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the scores between which:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q15-a-i",
            "type": "part",
            "label": "i",
            "prompt": "95% of data lies",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12.2$ to $19.8$",
              "worked": "The central $95\\%$ lies within two standard deviations of the mean.\n$$\\begin{aligned}\\mu-2\\sigma&=16-2(1.9)\\\\&=12.2\\\\\\mu+2\\sigma&=16+2(1.9)\\\\&=19.8\\end{aligned}$$\nThe scores are approximately $12.2$ to $19.8$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p34-q15-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "68% of data lies",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$14.1$ to $17.9$",
              "worked": "The central $68\\%$ lies within one standard deviation of the mean.\n$$\\begin{aligned}\\mu-\\sigma&=16-1.9\\\\&=14.1\\\\\\mu+\\sigma&=16+1.9\\\\&=17.9\\end{aligned}$$\nThe scores are approximately $14.1$ to $17.9$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p34-q15-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "99.7% of data lies",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10.3$ to $21.7$",
              "worked": "The central $99.7\\%$ lies within three standard deviations of the mean.\n$$\\begin{aligned}\\mu-3\\sigma&=16-3(1.9)\\\\&=10.3\\\\\\mu+3\\sigma&=16+3(1.9)\\\\&=21.7\\end{aligned}$$\nThe scores are approximately $10.3$ to $21.7$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      },
      {
        "id": "p34-q15-b",
        "type": "group",
        "label": "b",
        "prompt": "Calculate the $z$-score of each value. Give your answers to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q15-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$20$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$z\\approx2.1$",
              "worked": "$$\\begin{aligned}z&=\\frac{x-\\mu}{\\sigma}\\\\&=\\frac{20-16}{1.9}\\\\&\\approx2.1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p34-q15-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$13.5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$z\\approx-1.3$",
              "worked": "$$\\begin{aligned}z&=\\frac{x-\\mu}{\\sigma}\\\\&=\\frac{13.5-16}{1.9}\\\\&\\approx-1.3\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      },
      {
        "id": "p34-q15-c",
        "type": "group",
        "label": "c",
        "prompt": "Find the raw score with $z$-score:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q15-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$-3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$10.3$",
              "worked": "$$\\begin{aligned}x&=\\mu+z\\sigma\\\\&=16+(-3)(1.9)\\\\&=10.3\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p34-q15-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$1.1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18.09$",
              "worked": "$$\\begin{aligned}x&=\\mu+z\\sigma\\\\&=16+1.1(1.9)\\\\&=18.09\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
