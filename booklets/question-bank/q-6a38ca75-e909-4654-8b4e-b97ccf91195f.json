        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-ex5f-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-d=e$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=d+e$",
          "worked": "$$\\begin{align*}x-d&=e\\\\x&=e+d\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p19-ex5f-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$p-x=q$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=p-q$",
          "worked": "$$\\begin{align*}p-x&=q\\\\p-q&=x\\\\x&=p-q\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-ex5f-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$-x+m=n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=m-n$",
          "worked": "$$\\begin{align*}-x+m&=n\\\\m-n&=x\\\\x&=m-n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p19-ex5f-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$cx=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{b}{c}$",
          "worked": "$$\\begin{align*}cx&=b\\\\x&=\\frac{b}{c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-ex5f-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$c-bx=e$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{c-e}{b}$",
          "worked": "$$\\begin{align*}c-bx&=e\\\\c-e&=bx\\\\x&=\\frac{c-e}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-ex5f-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$a(x+b)=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{c-ab}{a}$",
          "worked": "$$\\begin{align*}a(x+b)&=c\\\\ax+ab&=c\\\\ax&=c-ab\\\\x&=\\frac{c-ab}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-ex5f-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$m(nx+p)=n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{n-mp}{mn}$",
          "worked": "$$\\begin{align*}m(nx+p)&=n\\\\mnx+mp&=n\\\\mnx&=n-mp\\\\x&=\\frac{n-mp}{mn}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-ex5f-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{x}{a}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=ab$",
          "worked": "$$\\begin{align*}\\frac{x}{a}&=b\\\\x&=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-ex5f-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{x+a}{b}=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=bc-a$",
          "worked": "$$\\begin{align*}\\frac{x+a}{b}&=c\\\\x+a&=bc\\\\x&=bc-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-ex5f-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{x}{a}+b=c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a(c-b)$",
          "worked": "$$\\begin{align*}\\frac{x}{a}+b&=c\\\\\\frac{x}{a}&=c-b\\\\x&=a(c-b)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-ex5f-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{mx}{n}=p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{np}{m}$",
          "worked": "$$\\begin{align*}\\frac{mx}{n}&=p\\\\mx&=np\\\\x&=\\frac{np}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-ex5f-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\dfrac{ax}{b}+c=d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{b(d-c)}{a}$",
          "worked": "$$\\begin{align*}\\frac{ax}{b}+c&=d\\\\\\frac{ax}{b}&=d-c\\\\ax&=b(d-c)\\\\x&=\\frac{b(d-c)}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p19-ex5f-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\dfrac{ax+b}{c}=d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{cd-b}{a}$",
          "worked": "$$\\begin{align*}\\frac{ax+b}{c}&=d\\\\ax+b&=cd\\\\ax&=cd-b\\\\x&=\\frac{cd-b}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-ex5f-q1-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\dfrac{mx-n}{n}=m$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{mn+n}{m}$",
          "worked": "$$\\begin{align*}\\frac{mx-n}{n}&=m\\\\mx-n&=mn\\\\mx&=mn+n\\\\x&=\\frac{mn+n}{m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p19-ex5f-q1-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\dfrac{x}{f}+\\dfrac{g}{h}=k$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{fhk-fg}{h}$",
          "worked": "$$\\begin{align*}\\frac{x}{f}+\\frac{g}{h}&=k\\\\\\frac{x}{f}&=k-\\frac{g}{h}\\\\x&=f\\left(k-\\frac{g}{h}\\right)\\\\x&=\\frac{fhk-fg}{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-ex5f-q1-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\dfrac{x}{a}-\\dfrac{a}{b}=b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{a^2+ab^2}{b}$",
          "worked": "$$\\begin{align*}\\frac{x}{a}-\\frac{a}{b}&=b\\\\\\frac{x}{a}&=b+\\frac{a}{b}\\\\x&=a\\left(b+\\frac{a}{b}\\right)\\\\x&=\\frac{a^2+ab^2}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p19-ex5f-q1-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\dfrac{x}{b}-b=\\dfrac{a}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=a+b^2$",
          "worked": "$$\\begin{align*}\\frac{x}{b}-b&=\\frac{a}{b}\\\\x-b^2&=a\\\\x&=a+b^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
