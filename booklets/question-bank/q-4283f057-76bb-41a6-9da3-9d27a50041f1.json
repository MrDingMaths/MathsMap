        "answer": {
          "short": "In order: $-1$, $-1$, undefined, $1$, $1$.",
          "worked": "$$\\begin{align*}f(-2)&=\\frac{|-2|}{-2}=-1\\\\f(-1)&=\\frac{|-1|}{-1}=-1\\\\f(1)&=\\frac{|1|}{1}=1\\\\f(2)&=\\frac{|2|}{2}=1.\\end{align*}$$\n$f(0)$ is undefined because its denominator is zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
