  "content": {
    "id": "p43-q39-root",
    "type": "question",
    "label": "39",
    "prompt": "The equation $x^2+px+q=0$ has roots $\\dfrac\\alpha2$ and $2\\alpha$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q39-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\alpha^2=q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha^2=q$ by the product of roots.",
          "worked": "By the product of roots,\n$$\\begin{align*}\\left(\\frac\\alpha2\\right)(2\\alpha)&=q,\\\\\\alpha^2&=q.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p43-q39-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the sum of roots to show that $\\alpha=-\\dfrac{2p}{5}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha=-\\dfrac{2p}{5}$, since $\\dfrac{5\\alpha}{2}=-p$.",
          "worked": "By the sum of roots,\n$$\\begin{align*}\\frac\\alpha2+2\\alpha&=-p,\\\\\\frac{5\\alpha}{2}&=-p,\\\\\\alpha&=-\\frac{2p}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p43-q39-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, show that $4p^2=25q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4p^2=25q$.\n\nSubstitute $\\alpha=-\\dfrac{2p}{5}$ into $\\alpha^2=q$.",
          "worked": "Substitute the result of part (b) into part (a):\n$$\\begin{align*}\\left(-\\frac{2p}{5}\\right)^2&=q,\\\\\\frac{4p^2}{25}&=q,\\\\4p^2&=25q.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
