    "children": [
      {
        "id": "v2-bc79b7-p5-practice-slot-3-s3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the exact length of $AE$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AE=3\\sqrt3-3\\text{ cm}$",
          "worked": "The altitude bisects $BC$, so $BD=3$.\n$$\\begin{align*}\\tan45^\\circ&=\\frac{DE}{BD}\\\\DE&=3\\end{align*}$$\n$$\\begin{align*}\\sin60^\\circ&=\\frac{AD}{6}\\\\AD&=6\\times\\frac{\\sqrt3}{2}\\\\AD&=3\\sqrt3\\end{align*}$$\n$$\\begin{align*}AE&=AD-DE\\\\AE&=3\\sqrt3-3\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-bc79b7-p5-practice-slot-3-s3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the exact distance from $E$ to $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3\\sqrt3-3}{2}\\text{ cm}$",
          "worked": "Let $F$ be the foot of the perpendicular from $E$ to $AB$. The altitude bisects the apex angle, so $\\angle EAF=30^\\circ$.\n$$\\begin{align*}\\sin30^\\circ&=\\frac{EF}{AE}\\\\\\frac12&=\\frac{EF}{3\\sqrt3-3}\\\\EF&=\\frac{3\\sqrt3-3}{2}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
