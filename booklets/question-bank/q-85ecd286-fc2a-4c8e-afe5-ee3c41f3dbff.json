    "label": null,
    "prompt": "Consider the equilateral triangle $ABC$ shown.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "v2-bc79b7-p5-practice-slot-3-s3-diagram",
        "role": "question",
        "format": "tikz",
        "code": "\\usetikzlibrary{angles,quotes,calc}\n\\begin{tikzpicture}[x=0.6cm,y=0.6cm,line cap=round,line join=round,font=\\fontsize{10}{12}\\selectfont]\n\\coordinate (B) at (0,0);\n\\coordinate (C) at (6,0);\n\\coordinate (A) at (3,{3*sqrt(3)});\n\\coordinate (D) at (3,0);\n\\coordinate (E) at (3,3);\n\\draw[line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[dashed,line width=0.4pt] (A)--(D);\n\\draw[line width=0.8pt] (B)--(E);\n\\draw[line width=0.4pt] (2.7,0)--(2.7,0.3)--(3,0.3);\n\\pic[draw,line width=0.4pt,angle radius=10mm,angle eccentricity=1.5,\"$45^\\circ$\"] {angle=C--B--E};\n\\path (A)--(C) node[midway,above,sloped] {$6\\text{ cm}$};\n\\node[above] at (A) {$A$};\n\\node[below left] at (B) {$B$};\n\\node[below right] at (C) {$C$};\n\\node[below] at (D) {$D$};\n\\node[right=2pt] at (E) {$E$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
        "alt": "Mathematical diagram",
