          "inlines": [
            {
              "type": "text",
              "text": "Using the first version of chain rule",
              "marks": [],
              "colour": "#268cff"
            },
            {
              "type": "text",
              "text": " Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=(2x^3+4)^5",
              "display": false
            },
            {
              "type": "text",
              "text": ". Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "u=2x^3+4",
              "display": false
            },
            {
              "type": "text",
              "text": ", so that ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "y=u^5",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q26-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $\\dfrac{dy}{du}$ and $\\dfrac{du}{dx}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{du}=5u^4$, $\\dfrac{du}{dx}=6x^2$.",
          "worked": "$$\\begin{align*}\\frac{dy}{du}&=\\frac{d}{du}(u^5)\\\\\\frac{dy}{du}&=5u^4\\\\\\frac{du}{dx}&=\\frac{d}{dx}(2x^3+4)\\\\\\frac{du}{dx}&=6x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p27-q26-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $\\dfrac{dy}{dx}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=30x^2(2x^3+4)^4$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\\\frac{dy}{dx}&=5u^4\\times6x^2\\\\\\frac{dy}{dx}&=30x^2(2x^3+4)^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
