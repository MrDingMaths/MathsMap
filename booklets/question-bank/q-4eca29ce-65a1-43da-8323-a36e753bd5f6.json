  "content": {
    "id": "p19-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "In a school of 1029 students, 504 are boys. What is the ratio of the number of boys to the number of girls?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$24:25$",
      "worked": "$$\\begin{align*}\\text{Number of girls}&=1029-504\\\\\\text{Number of girls}&=525\\end{align*}$$\n\nThe highest common factor of $504$ and $525$ is $21$.\n\n$$\\begin{align*}\\text{Boys : girls}&=504:525\\\\\\text{Boys : girls}&=(504\\div21):(525\\div21)\\\\\\text{Boys : girls}&=24:25\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
