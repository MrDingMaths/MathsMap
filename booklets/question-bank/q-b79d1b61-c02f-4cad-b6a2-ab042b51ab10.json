  "content": {
    "id": "v2-d7528-p52-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Find the unit vector in the direction of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d7528-p52-practice-slot-6-slot-6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{PQ}$, where $P$ is the point $(-2,5)$ and $Q$ is the point $(2,2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac45\\mathbf{i}-\\dfrac35\\mathbf{j}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{PQ}&=\\overrightarrow{OQ}-\\overrightarrow{OP}\\\\&=(2\\mathbf{i}+2\\mathbf{j})-(-2\\mathbf{i}+5\\mathbf{j})\\\\&=4\\mathbf{i}-3\\mathbf{j}\\\\|\\overrightarrow{PQ}|&=\\sqrt{4^2+(-3)^2}=5\\\\\\widehat{PQ}&=\\frac{4\\mathbf{i}-3\\mathbf{j}}{5}\\\\&=\\frac45\\mathbf{i}-\\frac35\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-d7528-p52-practice-slot-6-slot-6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{DC}$, where $C$ is the point $(5,-1)$ and $D$ is the point $(1,1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{\\sqrt5}\\mathbf{i}-\\dfrac{1}{\\sqrt5}\\mathbf{j}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{DC}&=\\overrightarrow{OC}-\\overrightarrow{OD}\\\\&=(5\\mathbf{i}-\\mathbf{j})-(\\mathbf{i}+\\mathbf{j})\\\\&=4\\mathbf{i}-2\\mathbf{j}\\\\|\\overrightarrow{DC}|&=\\sqrt{4^2+(-2)^2}=2\\sqrt5\\\\\\widehat{DC}&=\\frac{4\\mathbf{i}-2\\mathbf{j}}{2\\sqrt5}\\\\&=\\frac{2}{\\sqrt5}\\mathbf{i}-\\frac{1}{\\sqrt5}\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
