  "content": {
    "id": "p24-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Sketch $y=-3(x+2)^2-4$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "concavity:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Concave down.",
          "worked": "$a=-3<0$, so the parabola is concave down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p24-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y$-intercept:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-16)$",
          "worked": "Let $x=0$.\n$$\\begin{align*}y&=-3(0+2)^2-4\\\\y&=-12-4\\\\y&=-16\\end{align*}$$\nThe $y$-intercept is $(0,-16)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p24-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x$-intercepts:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No $x$-intercepts.",
          "worked": "Let $y=0$.\n$$\\begin{align*}0&=-3(x+2)^2-4\\\\3(x+2)^2&=-4\\\\(x+2)^2&=-\\frac43\\end{align*}$$\nA square cannot be negative, so there are no real solutions and no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "vertex:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p24-q5-graph",
        "answer": {
          "short": "$(-2,-4)$",
          "worked": "In $y=a(x-h)^2+k$, $h=-2$ and $k=-4$. The vertex is $(-2,-4)$; the parabola opens down and lies entirely below the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
    ],
    "sharedSolutionDiagrams": [
