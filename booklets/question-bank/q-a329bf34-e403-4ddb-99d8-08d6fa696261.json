    "children": [
      {
        "id": "v2-52079-p47-practice-retro-slot-10-225344-retro-slot-10-a",
        "type": "part",
        "label": "a",
        "prompt": "The perimeter of a rectangular courtyard is $64\\text{ m}$. The length and width are in the ratio $5:3$.\n\nWork out the area of the courtyard.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$240\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\text{Length}+\\text{width}&=64\\div2=32\\text{ m}\\\\5+3&=8\\text{ parts}\\\\8\\text{ parts}&=32\\text{ m}\\\\1\\text{ part}&=32\\div8=4\\text{ m}\\\\\\text{Length}&=5\\times4=20\\text{ m}\\\\\\text{Width}&=3\\times4=12\\text{ m}\\\\\\text{Area}&=20\\times12=240\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-52079-p47-practice-retro-slot-10-225344-retro-slot-10-b",
        "type": "part",
        "label": "b",
        "prompt": "The length and width of a rectangular paddock are in the ratio $5:2$. The width is $18\\text{ m}$.\n\nFencing costs $\\$12$ per metre. Find the cost of fencing all the way around the paddock.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1512$",
          "worked": "$$\\begin{align*}2\\text{ parts}&=18\\text{ m}\\\\1\\text{ part}&=18\\div2=9\\text{ m}\\\\5\\text{ parts}&=5\\times9=45\\text{ m}\\\\\\text{Perimeter}&=2(45+18)=126\\text{ m}\\\\\\text{Cost}&=126\\times12=\\$1512\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
