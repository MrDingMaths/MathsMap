  "content": {
    "id": "p20-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The weight of an object on the moon varies directly with its weight on Earth.\n\nAn astronaut who weighs 84 kg on Earth weighs only 14 kg on the moon.\n\nA lunar landing craft weighs 2449 kg when on the moon.\n\nCalculate the weight of this landing craft when on Earth.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$14\\,694$ kg",
      "worked": "Let $M$ be the weight on the moon and $E$ the weight on Earth, both in kilograms.\n$$\\begin{align*}M &= kE\\\\14 &= k\\times84\\\\k &= \\frac{14}{84}\\\\k &= \\frac16\\\\M &= \\frac16E\\\\2449 &= \\frac16E\\\\E &= 2449\\times6\\\\E &= 14\\,694\\end{align*}$$\nThe landing craft weighs $14\\,694$ kg on Earth.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
