  "content": {
    "id": "p18-q11-root",
    "type": "question",
    "label": null,
    "prompt": "Given that for two events $A$ and $B$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q11-a",
        "type": "group",
        "label": "a",
        "prompt": "$P(A)=0.6$, $P(B)=0.35$, and $P(B\\mid A)=0.5$, find",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q11-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac3{10}$",
              "worked": "$$\\begin{align*}P(A\\cap B)&=P(B\\mid A)P(A)\\\\P(A\\cap B)&=0.5\\times 0.6\\\\P(A\\cap B)&=\\frac3{10}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p18-q11-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(A\\mid B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac67$",
              "worked": "$$\\begin{align*}P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\P(A\\mid B)&=\\frac{0.30}{0.35}\\\\P(A\\mid B)&=\\frac67\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      },
      {
        "id": "p18-q11-b",
        "type": "group",
        "label": "b",
        "prompt": "$P(A)=0.7$, $P(B)=0.4$, and $P(A\\cup B)=0.8$, find",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q11-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac3{10}$",
              "worked": "$$\\begin{align*}P(A\\cap B)&=P(A)+P(B)-P(A\\cup B)\\\\P(A\\cap B)&=0.7+0.4-0.8\\\\P(A\\cap B)&=\\frac3{10}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p18-q11-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(A\\mid B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac34$",
              "worked": "$$\\begin{align*}P(A\\mid B)&=\\frac{P(A\\cap B)}{P(B)}\\\\P(A\\mid B)&=\\frac{0.3}{0.4}\\\\P(A\\mid B)&=\\frac34\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      },
      {
        "id": "p18-q11-c",
        "type": "group",
        "label": "c",
        "prompt": "$P(A)=0.6$, $P(B)=0.4$, and $P(A\\mid B)=0.8$, find",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q11-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac8{25}$",
              "worked": "$$\\begin{align*}P(A\\cap B)&=P(A\\mid B)P(B)\\\\P(A\\cap B)&=0.8\\times 0.4\\\\P(A\\cap B)&=\\frac8{25}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p18-q11-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(B\\mid A)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac8{15}$",
              "worked": "$$\\begin{align*}P(B\\mid A)&=\\frac{P(A\\cap B)}{P(A)}\\\\P(B\\mid A)&=\\frac{0.32}{0.6}\\\\P(B\\mid A)&=\\frac8{15}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          }
        ]
      }
