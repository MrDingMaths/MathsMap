    "questionDiagrams": [],
    "children": [
      {
        "id": "p43-q1-9-part-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\ln(x^2)$ is the same as $y=2\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "The domain of $\\ln(x^2)$ is $x\\ne0$, whereas the domain of $2\\ln(x)$ is $x>0$. The graphs agree for $x>0$, but the first graph also exists for $x<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\ln(x^3)$ is the same as $y=3\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Both graphs have domain $x>0$. By the logarithmic power law,\n$$\\ln(x^3)=3\\ln(x).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\ln(x^4)$ is the same as $y=4\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "The domain of $\\ln(x^4)$ is $x\\ne0$, whereas the domain of $4\\ln(x)$ is $x>0$. The graphs agree for $x>0$, but the first graph also exists for $x<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\ln(x^5)$ is the same as $y=5\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Both graphs have domain $x>0$. By the logarithmic power law,\n$$\\ln(x^5)=5\\ln(x).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\ln(\\sqrt{x})$ is the same as $y=\\dfrac12\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Both graphs have domain $x>0$.\n$$\\begin{align*}\\ln(\\sqrt{x})&=\\ln(x^{1/2})\\\\\\ln(\\sqrt{x})&=\\frac12\\ln(x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\ln(\\sqrt[3]{x})$ is the same as $y=\\dfrac13\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "The logarithm requires $\\sqrt[3]{x}>0$, so both graphs have domain $x>0$.\n$$\\begin{align*}\\ln(\\sqrt[3]{x})&=\\ln(x^{1/3})\\\\\\ln(\\sqrt[3]{x})&=\\frac13\\ln(x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\ln\\left(\\dfrac1x\\right)$ is the same as $y=-\\ln(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "Both graphs have domain $x>0$.\n$$\\begin{align*}\\ln\\left(\\frac1x\\right)&=\\ln(1)-\\ln(x)\\\\\\ln\\left(\\frac1x\\right)&=-\\ln(x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\log_{0.5}(x)$ is the same as $y=-\\log_2(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "For $x>0$, let $y=\\log_{0.5}(x)$, so $x=(\\frac{1}{2})^y=2^{-y}$.\n$$\\begin{align*}\\log_2(x)&=-y\\\\y&=-\\log_2(x).\\end{align*}$$\nBoth graphs have domain $x>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p43-q1-9-part-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\log_a(-x)$ does not exist.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "For a valid logarithm base $a>0$, $a\\ne1$, the argument condition is $-x>0$, giving $x<0$. The graph exists and is the reflection of $y=\\log_a(x)$ in the $y$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
