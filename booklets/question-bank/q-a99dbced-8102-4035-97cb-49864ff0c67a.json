        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$19\\,900$",
          "worked": "$$\\begin{align*}\\text{Taxable income} &= 22\\,500-2600\\\\\\text{Taxable income} &= \\$19\\,900\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p68-q6b",
        "type": "part",
        "label": "b",
        "prompt": "the income tax payable on his taxable income",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$323$",
          "worked": "The taxable income is in the \\$18 201–\\$45 000 bracket of the supplied 2022–23 table.\n$$\\begin{align*}\\text{Excess} &= 19\\,900-18\\,200\\\\\\text{Excess} &= 1700\\\\\\text{Income tax} &= 0+0.19\\times1700\\\\\\text{Income tax} &= \\$323\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p68-q6c",
        "type": "part",
        "label": "c",
        "prompt": "the Medicare levy payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$398$",
          "worked": "$$\\begin{align*}\\text{Medicare levy} &= 2\\%\\times19\\,900\\\\\\text{Medicare levy} &= 0.02\\times19\\,900\\\\\\text{Medicare levy} &= \\$398\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p68-q6d",
        "type": "part",
        "label": "d",
        "prompt": "the total tax payable.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$721$",
          "worked": "$$\\begin{align*}\\text{Total tax payable} &= 323+398\\\\\\text{Total tax payable} &= \\$721\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
