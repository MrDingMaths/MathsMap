        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"exponential function curve\"}],\"reference\":\"PDF page 38, printed page 440, question 26\"}\n\\begin{tikzpicture}[x=0.72cm,y=0.72cm,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\path[use as bounding box] (-1.05,-2.8) rectangle (5.8,3.55);\n\\draw[black,line width=0.5pt,->] (-1.4,0)--(5.35,0) node[below] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-2.55)--(0,3.35) node[right] {$y$};\n\\draw[black,dashed,line width=0.4pt] (-1.4,2)--(5.3,2);\n\\draw[black,dashed,line width=0.4pt] (0,0.5)--(1,0.5);\n\\draw[black,dashed,line width=0.4pt] (1,0)--(1,0.5);\n\\draw[curveBlue,line width=0.8pt,<->,domain=-0.6:5.3,samples=100] plot (\\x,{2-3*pow(2,-\\x)});\n\\fill[curveBlue] (1,0.5) circle (1.5pt);\n\\node[left] at (0,2.13) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[left] at (0,-1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\node[left] at (0,0.5) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\tfrac12$\\special{dvisvgm:raw </g>}};\n\\node[below] at (1,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
