  "content": {
    "id": "p17-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The quadrilateral $ABCD$ has vertices $A(1,-4)$, $B(3,2)$, $C(-5,6)$ and $D(-1,-2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the midpoints $P$ of $AB$, $Q$ of $BC$, $R$ of $CD$, and $S$ of $DA$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=(2,-1)$, $Q=(-1,4)$, $R=(-3,2)$, $S=(0,-3)$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q13-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}P&=\\left(\\frac{1+3}{2},\\frac{-4+2}{2}\\right)=(2,-1)\\\\Q&=\\left(\\frac{3+(-5)}{2},\\frac{2+6}{2}\\right)=(-1,4)\\\\R&=\\left(\\frac{-5+(-1)}{2},\\frac{6+(-2)}{2}\\right)=(-3,2)\\\\S&=\\left(\\frac{-1+1}{2},\\frac{-2+(-4)}{2}\\right)=(0,-3)\\end{align*}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p17-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that $PQRS$ is a parallelogram by showing that $PQ\\parallel RS$ and $PS\\parallel QR$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{PQ}=m_{RS}=-\\frac{5}{3}$ and $m_{PS}=m_{QR}=1$. Both pairs of opposite sides are parallel, so $PQRS$ is a parallelogram.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q13-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}m_{PQ}&=\\frac{4-(-1)}{-1-2}=-\\frac{5}{3}\\\\m_{RS}&=\\frac{-3-2}{0-(-3)}=-\\frac{5}{3}\\end{align*}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p17-q13-b-parallel-pq-rs",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "PQ\\parallel RS",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " since ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "m_{PQ}=m_{RS}",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p17-q13-b-gradients-ps-qr",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}m_{PS}&=\\frac{-3-(-1)}{0-2}=\\frac{-2}{-2}=1\\\\m_{QR}&=\\frac{2-4}{-3-(-1)}=1\\end{align*}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p17-q13-b-parallel-ps-qr",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "PS\\parallel QR",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " since ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "m_{PS}=m_{QR}",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p17-q13-b-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "PQRS",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " is a parallelogram since opposite sides are parallel.",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
