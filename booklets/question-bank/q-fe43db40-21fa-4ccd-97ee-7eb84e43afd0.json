  "content": {
    "id": "p7-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Evaluate each expression for $a=-3$, $b=\\frac25$ and $c=10$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$a+b-c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12\\frac35$",
          "worked": "$$\\begin{align*}a+b-c&=(-3)+\\frac25-10\\\\a+b-c&=-13+\\frac25\\\\a+b-c&=-12\\frac35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$abc$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12$",
          "worked": "$$\\begin{align*}abc&=(-3)\\times\\frac25\\times10\\\\abc&=-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$b^2(c+a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac3{25}$",
          "worked": "$$\\begin{align*}b^2(c+a)&=\\left(\\frac25\\right)^2(10+(-3))\\\\b^2(c+a)&=\\frac4{25}\\times7\\\\b^2(c+a)&=\\frac{28}{25}=1\\frac3{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$(c^2+a^2)-2b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$108\\frac15$",
          "worked": "$$\\begin{align*}(c^2+a^2)-2b&=(10^2+(-3)^2)-2\\times\\frac25\\\\(c^2+a^2)-2b&=109-\\frac45\\\\(c^2+a^2)-2b&=108\\frac15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{ca^2}{30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{ca^2}{30}&=\\frac{10\\times(-3)^2}{30}\\\\\\frac{ca^2}{30}&=\\frac{90}{30}\\\\\\frac{ca^2}{30}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{a^2b}{c-b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "$$\\begin{align*}\\frac{a^2b}{c-b}&=\\frac{(-3)^2\\times\\frac25}{10-\\frac25}\\\\\\frac{a^2b}{c-b}&=\\frac{18}{5}\\div\\frac{48}{5}\\\\\\frac{a^2b}{c-b}&=\\frac{18}{5}\\times\\frac5{48}\\\\\\frac{a^2b}{c-b}&=\\frac38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$a^2-b^2-c$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\frac4{25}$",
          "worked": "$$\\begin{align*}a^2-b^2-c&=(-3)^2-\\left(\\frac25\\right)^2-10\\\\a^2-b^2-c&=9-\\frac4{25}-10\\\\a^2-b^2-c&=-1\\frac4{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac ab(a-c)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$97\\frac12$",
          "worked": "$$\\begin{align*}\\frac ab(a-c)&=\\left((-3)\\div\\frac25\\right)((-3)-10)\\\\\\frac ab(a-c)&=-\\frac{15}{2}\\times(-13)\\\\\\frac ab(a-c)&=\\frac{195}{2}=97\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
