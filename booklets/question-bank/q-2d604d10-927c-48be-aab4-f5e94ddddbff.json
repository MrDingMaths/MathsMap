  "content": {
    "id": "v2-09d4b-p24-practice-slot-20-root",
    "type": "question",
    "label": null,
    "prompt": "A new ute that costs $\\$48\\,000$ depreciates by 14% of its value each year.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-09d4b-p24-practice-slot-20-slot-20-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the ute’s value after 5 years. Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$22\\,580.50$",
          "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\S &= 48\\,000(1-0.14)^5\\\\S &= 22\\,580.4968\\end{align*}$$\nThe ute’s value is $\\$22\\,580.50$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-09d4b-p24-practice-slot-20-slot-20-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How much did it depreciate by in that time? Give your answer to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$25\\,419.50$",
          "worked": "$$\\begin{align*}\\text{Depreciation} &= 48\\,000-22\\,580.4968\\\\\\text{Depreciation} &= 25\\,419.5032\\end{align*}$$\nIt depreciated by $\\$25\\,419.50$ to the nearest cent.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ],
    "responseKind": "group-answer",
    "answer": {
      "short": "a) $\\$22\\,580.50$ b) $\\$25\\,419.50$",
      "worked": "See parts.",
      "solutionDiagrams": []
    }
