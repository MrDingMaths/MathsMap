  "content": {
    "id": "p18-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "John and Minh walk each day for 12 days to keep fit. John walks 9 km a day, and Minh walks 5 km a day.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the total distance walked by John and Minh in the 12 days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$168\\text{ km}$",
          "worked": "$$\\begin{align*}12\\times9+12\\times5&=12\\times(9+5)\\\\12\\times9+12\\times5&=12\\times14\\\\12\\times9+12\\times5&=168\\end{align*}$$\n\nTogether they walked $168\\text{ km}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p18-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How many more kilometres than Minh has John walked in the 12 days?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48\\text{ km}$",
          "worked": "$$\\begin{align*}12\\times9-12\\times5&=12\\times(9-5)\\\\12\\times9-12\\times5&=12\\times4\\\\12\\times9-12\\times5&=48\\end{align*}$$\n\nJohn walked $48\\text{ km}$ more than Minh.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
