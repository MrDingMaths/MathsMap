    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the approximate probability that both people have blood type B?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Approximately $\\frac{1}{100}$.",
          "worked": "The two selections can be treated as independent.\n\n$$\\begin{aligned}P(\\text{both type B})&\\approx 0.1\\times0.1\\\\ &\\approx \\frac{1}{100}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Why are we allowed to multiply the probabilities?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The selections are approximately independent because choosing one person barely changes the proportion of people with blood type B.",
          "worked": "Australia’s population is large enough that selecting one person with blood type B has a negligible effect on the chance that the next person also has type B. We can therefore multiply the two probabilities as an approximation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
