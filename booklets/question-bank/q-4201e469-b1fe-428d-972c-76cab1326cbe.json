  "content": {
    "id": "p25-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "If a letter of the alphabet is chosen at random, what is the probability that it is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "a vowel?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{26}$",
          "worked": "The vowels are A, E, I, O and U: 5 favourable letters out of 26.\n$$P(\\text{vowel})=\\frac{5}{26}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "a consonant?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{26}$",
          "worked": "There are $26-5=21$ consonants.\n$$P(\\text{consonant})=\\frac{21}{26}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p25-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "one of the letters of AMSI?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{13}$",
          "worked": "The favourable letters are A, M, S and I.\n$$\\begin{align*}P(\\text{letter of AMSI})&=\\frac{4}{26}\\\\P(\\text{letter of AMSI})&=\\frac{2}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "one of the letters of ICE-EM?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{13}$",
          "worked": "The distinct favourable letters are I, C, E and M. E is counted once; the hyphen is not a letter.\n$$\\begin{align*}P(\\text{letter of ICE-EM})&=\\frac{4}{26}\\\\P(\\text{letter of ICE-EM})&=\\frac{2}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "one of the consonants of ICE-EM?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{13}$",
          "worked": "The favourable consonants are C and M.\n$$\\begin{align*}P(\\text{consonant of ICE-EM})&=\\frac{2}{26}\\\\P(\\text{consonant of ICE-EM})&=\\frac{1}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "one of the vowels of ICE-EM?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{13}$",
          "worked": "The distinct favourable vowels are I and E.\n$$\\begin{align*}P(\\text{vowel of ICE-EM})&=\\frac{2}{26}\\\\P(\\text{vowel of ICE-EM})&=\\frac{1}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
