      {
        "id": "p12-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "A basketball is dropped from a height of 100 cm and it bounces back up to 61 cm. Does this basketball fit the rules? Give $c$ to 3 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c\\approx0.781$. Yes.",
          "worked": "$$\\begin{align*}c&=\\sqrt{\\frac{h}{H}}\\\\c&=\\sqrt{\\frac{61}{100}}\\\\c&\\approx0.781\\end{align*}$$\nYes, since $0.76<\\sqrt{\\frac{61}{100}}<0.8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "A tennis ball has a coefficient of restitution of 0.82. If it is dropped from a height of 10 metres, how high would it bounce back up, to 2 d.p.?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h\\approx6.72\\text{ m}$",
          "worked": "$$\\begin{align*}c&=\\sqrt{\\frac{h}{H}}\\\\0.82&=\\sqrt{\\frac{h}{10}}\\\\0.82^2&=\\frac{h}{10}\\\\h&=10(0.82)^2\\\\h&=6.724\\text{ m}\\\\h&\\approx6.72\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "A table tennis ball has a coefficient of restitution of 0.923. If it is dropped from a height of 10 metres, how high would it bounce back up, to 2 d.p.?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h\\approx8.52\\text{ m}$",
          "worked": "$$\\begin{align*}c&=\\sqrt{\\frac{h}{H}}\\\\0.923&=\\sqrt{\\frac{h}{10}}\\\\0.923^2&=\\frac{h}{10}\\\\h&=10(0.923)^2\\\\h&=8.51929\\text{ m}\\\\h&\\approx8.52\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "A cricket ball has a coefficient of restitution of 0.42. If it bounces back up to a height of 10 metres, how high was it dropped from, to 2 d.p.?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$H\\approx56.69\\text{ m}$",
          "worked": "$$\\begin{align*}c&=\\sqrt{\\frac{h}{H}}\\\\0.42&=\\sqrt{\\frac{10}{H}}\\\\0.42^2&=\\frac{10}{H}\\\\H&=\\frac{10}{0.42^2}\\\\H&\\approx56.69\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
