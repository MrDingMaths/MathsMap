      {
        "id": "index-t3-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x^2)^3\\times x^{\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}}=x^{11}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "5",
          "worked": "$(x^2)^3=x^6$. Multiplication adds the indices, so the missing number is $11-6=5$. Check: $x^6\\times x^5=x^{11}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "index-t3-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x^4)^{\\boxed{\\rule{0pt}{3mm}\\hspace{3mm}}}\\times(x^3)^2=x^{14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2",
          "worked": "$(x^3)^2=x^6$, leaving $14-6=8$ as the first power. Since $4\\times2=8$, the missing number is 2. Check: $(x^4)^2\\times(x^3)^2=x^8\\times x^6=x^{14}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      }
    ]
