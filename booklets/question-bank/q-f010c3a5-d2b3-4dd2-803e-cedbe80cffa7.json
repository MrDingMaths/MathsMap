  "content": {
    "id": "p34-q05-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the constant term in $\\left(x+\\frac{2}{x^2}\\right)^9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$672$",
      "worked": "$$\\begin{align*}T_k&=\\binom{9}{k}x^{9-k}\\left(\\frac{2}{x^2}\\right)^k\\\\T_k&=\\binom{9}{k}2^kx^{9-3k}\\end{align*}$$\nThe constant term has exponent zero.\n$$\\begin{align*}9-3k&=0\\\\k&=3\\end{align*}$$\n$$\\begin{align*}T_3&=\\binom{9}{3}2^3\\\\T_3&=672\\end{align*}$$",
      "solutionDiagrams": []
    },
