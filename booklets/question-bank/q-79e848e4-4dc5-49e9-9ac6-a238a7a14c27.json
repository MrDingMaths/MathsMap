        "prompt": "Complete the table of values for $x^2y$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Completed $x^2y$ row: $100,\\ 100,\\ 100,\\ 100$.",
          "worked": "$$\\begin{align*}2^2\\times25&=100\\\\5^2\\times4&=100\\\\10^2\\times1&=100\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Assuming that there is a simple relationship between the two variables, find a formula for $y$ in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{100}{x^2}$",
          "worked": "The product $x^2y$ is constant for every column.\n$$\\begin{align*}x^2y&=100\\\\y&=\\frac{100}{x^2}\\end{align*}$$",
