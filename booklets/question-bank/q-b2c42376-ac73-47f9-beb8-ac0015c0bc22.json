  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Write the following as a single logarithm.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$4\\log_3(2)-\\log_3(4)+\\log_3(16)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3(64)$",
          "worked": "Let $L=4\\log_3(2)-\\log_3(4)+\\log_3(16)$.\n\n$$\\begin{align*}L&=\\log_3(2^4)-\\log_3(4)+\\log_3(16)\\\\L&=\\log_3\\left(\\frac{16\\cdot16}{4}\\right)\\\\L&=\\log_3(64)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac12\\log_2(x)-\\log_2(3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2\\left(\\frac{\\sqrt{x}}{3}\\right)$",
          "worked": "$$\\begin{align*}\\tfrac12\\log_2(x)-\\log_2(3)&=\\log_2(\\sqrt{x})-\\log_2(3)\\\\\\tfrac12\\log_2(x)-\\log_2(3)&=\\log_2\\left(\\frac{\\sqrt{x}}{3}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$1+\\log_{10}(5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}(50)$",
          "worked": "$$\\begin{align*}1+\\log_{10}(5)&=\\log_{10}(10)+\\log_{10}(5)\\\\1+\\log_{10}(5)&=\\log_{10}(10\\cdot5)\\\\1+\\log_{10}(5)&=\\log_{10}(50)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p6-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{10}(800)-3\\log_{10}(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{10}(100)$",
          "worked": "$$\\begin{align*}\\log_{10}(800)-3\\log_{10}(2)&=\\log_{10}(800)-\\log_{10}(2^3)\\\\\\log_{10}(800)-3\\log_{10}(2)&=\\log_{10}\\left(\\frac{800}{8}\\right)\\\\\\log_{10}(800)-3\\log_{10}(2)&=\\log_{10}(100)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p6-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_5(25x)-\\log_3(9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5(x)$",
          "worked": "$\\log_3(9)=2=\\log_5(25)$.\n\n$$\\begin{align*}\\log_5(25x)-\\log_3(9)&=\\log_5(25x)-\\log_5(25)\\\\\\log_5(25x)-\\log_3(9)&=\\log_5\\left(\\frac{25x}{25}\\right)\\\\\\log_5(25x)-\\log_3(9)&=\\log_5(x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p6-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$-2\\log_4(5)+\\frac12\\log_4(20)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4\\left(\\frac{2}{5\\sqrt5}\\right)$",
          "worked": "Let $L=-2\\log_4(5)+\\tfrac12\\log_4(20)$.\n\n$$\\begin{align*}L&=\\log_4(\\sqrt{20})-\\log_4(25)\\\\L&=\\log_4\\left(\\frac{\\sqrt{20}}{25}\\right)\\\\L&=\\log_4\\left(\\frac{2\\sqrt5}{25}\\right)\\\\L&=\\log_4\\left(\\frac{2}{5\\sqrt5}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
