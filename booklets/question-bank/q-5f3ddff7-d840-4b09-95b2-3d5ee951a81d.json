      {
        "id": "p7-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{d}{dx}\\cosh x=\\sinh x$ and $\\dfrac{d}{dx}\\sinh x=\\cosh x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}\\cosh x=\\dfrac{e^x-e^{-x}}{2}=\\sinh x$\n\n$\\dfrac{d}{dx}\\sinh x=\\dfrac{e^x+e^{-x}}{2}=\\cosh x$.",
          "worked": "$$\\begin{aligned}\\frac{d}{dx}\\cosh x&=\\frac{e^x-e^{-x}}{2}=\\sinh x,\\\\\\frac{d}{dx}\\sinh x&=\\frac{e^x-(-e^{-x})}{2}=\\cosh x.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p7-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\cosh^2 x-\\sinh^2 x=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cosh^2 x-\\sinh^2 x=\\dfrac{4}{4}=1$.",
          "worked": "$$\\begin{aligned}\\cosh^2 x-\\sinh^2 x&=\\left(\\frac{e^x+e^{-x}}{2}\\right)^2-\\left(\\frac{e^x-e^{-x}}{2}\\right)^2\\\\&=\\frac{e^{2x}+2+e^{-2x}}{4}-\\frac{e^{2x}-2+e^{-2x}}{4}\\\\&=\\frac{e^{2x}+2+e^{-2x}-e^{2x}+2-e^{-2x}}{4}\\\\&=\\frac{4}{4}=1.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
