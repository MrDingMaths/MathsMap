      {
        "id": "p54-q3-a",
        "type": "group",
        "label": "a",
        "prompt": "The value of $y$ is in proportion with $x$. What happens to the value of $y$ when the value of $x$ is:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q3-a-i",
            "type": "part",
            "label": "i",
            "prompt": "doubled?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ doubles.",
              "worked": "Since $y=kx$, replacing $x$ by $2x$ gives\n$$y_{\\text{new}}=k(2x)=2y.$$\nThus $y$ doubles.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p54-q3-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "halved?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ is halved.",
              "worked": "Since $y=kx$, replacing $x$ by $\\frac{x}{2}$ gives\n$$y_{\\text{new}}=k\\left(\\frac{x}{2}\\right)=\\frac{y}{2}.$$\nThus $y$ is halved.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p54-q3-b",
        "type": "group",
        "label": "b",
        "prompt": "The value of $y$ varies inversely with $x$. What happens to the value of $y$ when the value of $x$ is:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p54-q3-b-i",
            "type": "part",
            "label": "i",
            "prompt": "doubled?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ is halved.",
              "worked": "Since $y=\\frac{k}{x}$, replacing $x$ by $2x$ gives\n$$y_{\\text{new}}=\\frac{k}{2x}=\\frac{y}{2}.$$\nThus $y$ is halved.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p54-q3-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "halved?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y$ doubles.",
              "worked": "Since $y=\\frac{k}{x}$, replacing $x$ by $\\frac{x}{2}$ gives\n$$\\begin{align*}y_{\\text{new}}&=\\frac{k}{x/2}\\\\y_{\\text{new}}&=\\frac{2k}{x}=2y\\end{align*}$$\nThus $y$ doubles.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
