  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": null,
    "prompt": "Use the conditions for a square root and for a denominator together to find the domain of the following functions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>0$",
          "worked": "The square root must be defined and the denominator must be nonzero, so its radicand must be strictly positive.\n\n$$x>0$$\nDomain: $(0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{x+1}{\\sqrt{x+4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-4$",
          "worked": "The radicand in the denominator must be strictly positive.\n\n$$\\begin{align*}x+4&>0\\\\x&>-4\\end{align*}$$\nDomain: $(-4,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p9-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{2}{\\sqrt{3x-9}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>3$",
          "worked": "The radicand in the denominator must be strictly positive.\n\n$$\\begin{align*}3x-9&>0\\\\3x&>9\\\\x&>3\\end{align*}$$\nDomain: $(3,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\dfrac{3}{\\sqrt{4-2x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<2$",
          "worked": "The radicand in the denominator must be strictly positive. Dividing by $-2$ reverses the inequality.\n\n$$\\begin{align*}4-2x&>0\\\\-2x&>-4\\\\x&<2\\end{align*}$$\nDomain: $(-\\infty,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
