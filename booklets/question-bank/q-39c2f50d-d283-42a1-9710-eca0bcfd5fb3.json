    "children": [
      {
        "id": "p13-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{x-5}+\\frac{3}{x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{x-5}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-5}+\\frac{3}{x-5}&=\\frac{1+3}{x-5}\\\\\\frac{1}{x-5}+\\frac{3}{x-5}&=\\frac{4}{x-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4}{a+5}+\\frac{2}{a-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2(3a-5)}{(a-5)(a+5)}$",
          "worked": "$$\\begin{align*}\\frac{4}{a+5}+\\frac{2}{a-5}&=\\frac{4(a-5)+2(a+5)}{(a-5)(a+5)}\\\\\\frac{4}{a+5}+\\frac{2}{a-5}&=\\frac{4a-20+2a+10}{(a-5)(a+5)}\\\\\\frac{4}{a+5}+\\frac{2}{a-5}&=\\frac{2(3a-5)}{(a-5)(a+5)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{x-3}+\\frac{1}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2+5x-3}{(x-3)(x+4)}$",
          "worked": "$$\\begin{align*}\\frac{x}{x-3}+\\frac{1}{x+4}&=\\frac{x(x+4)+(x-3)}{(x-3)(x+4)}\\\\\\frac{x}{x-3}+\\frac{1}{x+4}&=\\frac{x^2+4x+x-3}{(x-3)(x+4)}\\\\\\frac{x}{x-3}+\\frac{1}{x+4}&=\\frac{x^2+5x-3}{(x-3)(x+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2x}{(x-2)^2}+\\frac{2}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4(x-1)}{(x-2)^2}$",
          "worked": "$$\\begin{align*}\\frac{2x}{(x-2)^2}+\\frac{2}{x-2}&=\\frac{2x+2(x-2)}{(x-2)^2}\\\\\\frac{2x}{(x-2)^2}+\\frac{2}{x-2}&=\\frac{4x-4}{(x-2)^2}\\\\\\frac{2x}{(x-2)^2}+\\frac{2}{x-2}&=\\frac{4(x-1)}{(x-2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{1}{a-5}-\\frac{2}{a-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{a-5}$",
          "worked": "$$\\begin{align*}\\frac{1}{a-5}-\\frac{2}{a-5}&=\\frac{1-2}{a-5}\\\\\\frac{1}{a-5}-\\frac{2}{a-5}&=-\\frac{1}{a-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2a}{a-4}+\\frac{3a}{a+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5a^2-4a}{(a-4)(a+4)}$",
          "worked": "$$\\begin{align*}\\frac{2a}{a-4}+\\frac{3a}{a+4}&=\\frac{2a(a+4)+3a(a-4)}{(a-4)(a+4)}\\\\\\frac{2a}{a-4}+\\frac{3a}{a+4}&=\\frac{2a^2+8a+3a^2-12a}{(a-4)(a+4)}\\\\\\frac{2a}{a-4}+\\frac{3a}{a+4}&=\\frac{5a^2-4a}{(a-4)(a+4)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{1}{(x-7)^2}-\\frac{2}{x-7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{15-2x}{(x-7)^2}$",
          "worked": "$$\\begin{align*}\\frac{1}{(x-7)^2}-\\frac{2}{x-7}&=\\frac{1-2(x-7)}{(x-7)^2}\\\\\\frac{1}{(x-7)^2}-\\frac{2}{x-7}&=\\frac{1-2x+14}{(x-7)^2}\\\\\\frac{1}{(x-7)^2}-\\frac{2}{x-7}&=\\frac{15-2x}{(x-7)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{2}{(a-1)^2}-\\frac{2a}{(a-1)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{1-a}$",
          "worked": "$$\\begin{align*}\\frac{2}{(a-1)^2}-\\frac{2a}{(a-1)^2}&=\\frac{2-2a}{(a-1)^2}\\\\\\frac{2}{(a-1)^2}-\\frac{2a}{(a-1)^2}&=\\frac{-2(a-1)}{(a-1)^2}\\\\\\frac{2}{(a-1)^2}-\\frac{2a}{(a-1)^2}&=\\frac{2}{1-a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{2x+3}{x-4}-\\frac{2x-4}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{x-4}$",
          "worked": "$$\\begin{align*}\\frac{2x+3}{x-4}-\\frac{2x-4}{x-4}&=\\frac{2x+3-(2x-4)}{x-4}\\\\\\frac{2x+3}{x-4}-\\frac{2x-4}{x-4}&=\\frac{7}{x-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
