                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-x-2$",
          "worked": "Using the quotient and zero remainder from part a,\n$$P(x)=(x+1)(x^2-x-2).$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p45-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, by factorising the quadratic, express $P(x)$ as the product of three linear factors.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=(x+1)^2(x-2)$.",
          "worked": "$$\\begin{aligned}x^2-x-2&=(x+1)(x-2)\\\\P(x)&=(x+1)(x+1)(x-2)\\\\P(x)&=(x+1)^2(x-2).\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
