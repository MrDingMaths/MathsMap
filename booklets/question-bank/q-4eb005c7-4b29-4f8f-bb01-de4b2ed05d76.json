    "children": [
      {
        "id": "p45-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Divide $P(x)$ by $x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Quotient $x^2-x-2$; remainder $0$.",
          "worked": "$$\\begin{array}{r|l}&x^2-x-2\\\\\\hline x+1&x^3+0x^2-3x-2\\\\&\\underline{-(x^3+x^2)}\\\\&-x^2-3x-2\\\\&\\underline{-(-x^2-x)}\\\\&-2x-2\\\\&\\underline{-(-2x-2)}\\\\&0\\end{array}$$\nThe quotient is $x^2-x-2$ and the remainder is $0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p45-q7-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p45-q7-b-completion",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
