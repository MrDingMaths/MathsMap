      {
        "id": "p23-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find two different fractions that add to give 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{1}{4}$ and $\\frac{3}{4}$.",
          "worked": "Choose two different fractions with denominator $4$ whose numerators add to $4$:\n$$\\frac{1}{4}+\\frac{3}{4}=\\frac{4}{4}=1.$$\nOther valid pairs are possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p23-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find two fractions that add to give $\\frac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{1}{6}$ and $\\frac{1}{6}$.",
          "worked": "$$\\begin{align*}\\frac{1}{6}+\\frac{1}{6}&=\\frac{2}{6}\\\\\\frac{1}{6}+\\frac{1}{6}&=\\frac{1}{3}\\end{align*}$$\nOther valid pairs are possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find three fractions that add to give an answer between 2 and 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For example, $\\frac{3}{4}$, $\\frac{3}{4}$ and $\\frac{3}{4}$; their sum is $2\\frac{1}{4}$.",
          "worked": "$$\\begin{align*}\\frac{3}{4}+\\frac{3}{4}+\\frac{3}{4}&=\\frac{9}{4}\\\\\\frac{3}{4}+\\frac{3}{4}+\\frac{3}{4}&=2\\frac{1}{4}\\end{align*}$$\nSince $2<2\\frac{1}{4}<3$, these fractions satisfy the condition. Other valid triples are possible.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
