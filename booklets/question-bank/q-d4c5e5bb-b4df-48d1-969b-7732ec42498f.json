  "content": {
    "id": "p44-q13-16-root",
    "type": "question",
    "label": "13",
    "prompt": "Simplify the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q13",
        "type": "part",
        "label": "a",
        "prompt": "$((n+1)!)^2-(n!)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n(n+2)(n!)^2$.",
          "worked": "$$\\begin{align*}((n+1)!)^2-(n!)^2&=(n+1)^2(n!)^2-(n!)^2\\\\((n+1)!)^2-(n!)^2&=[(n+1)^2-1](n!)^2\\\\((n+1)!)^2-(n!)^2&=(n^2+2n)(n!)^2\\\\((n+1)!)^2-(n!)^2&=n(n+2)(n!)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p44-q14",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(n+1)!-n!}{n!-(n-1)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n^2}{n-1}$.",
          "worked": "$$\\begin{align*}\\frac{(n+1)!-n!}{n!-(n-1)!}&=\\frac{(n+1)n!-n!}{n(n-1)!-(n-1)!}\\\\\\frac{(n+1)!-n!}{n!-(n-1)!}&=\\frac{n\\,n!}{(n-1)(n-1)!}\\\\\\frac{(n+1)!-n!}{n!-(n-1)!}&=\\frac{n^2(n-1)!}{(n-1)(n-1)!}\\\\\\frac{(n+1)!-n!}{n!-(n-1)!}&=\\frac{n^2}{n-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p44-q15",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{(n-1)!}+\\dfrac{1}{n!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n+1}{n!}$.",
          "worked": "$$\\begin{align*}\\frac{1}{(n-1)!}+\\frac{1}{n!}&=\\frac{n}{n!}+\\frac{1}{n!}\\\\\\frac{1}{(n-1)!}+\\frac{1}{n!}&=\\frac{n+1}{n!}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q16",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{n!}-\\dfrac{1}{(n+2)!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n^2+3n+1}{(n+2)!}$.",
          "worked": "$$\\begin{align*}\\frac{1}{n!}-\\frac{1}{(n+2)!}&=\\frac{(n+2)(n+1)}{(n+2)!}-\\frac{1}{(n+2)!}\\\\\\frac{1}{n!}-\\frac{1}{(n+2)!}&=\\frac{(n+2)(n+1)-1}{(n+2)!}\\\\\\frac{1}{n!}-\\frac{1}{(n+2)!}&=\\frac{n^2+3n+1}{(n+2)!}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
