  "content": {
    "id": "p17-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{(a+1)^2}{a+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+1$",
          "worked": "$$\\begin{aligned}\\frac{(a+1)^2}{a+1}&=\\frac{(a+1)(a+1)}{a+1}\\\\&=a+1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5(a-3)^2}{a-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(a-3)$",
          "worked": "$$\\begin{aligned}\\frac{5(a-3)^2}{a-3}&=\\frac{5(a-3)(a-3)}{a-3}\\\\&=5(a-3)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{7(x+7)^2}{14(x+7)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+7}{2}$",
          "worked": "$$\\begin{aligned}\\frac{7(x+7)^2}{14(x+7)}&=\\frac{7(x+7)(x+7)}{14(x+7)}\\\\&=\\frac{x+7}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3(x-1)(x+2)^2}{18(x-1)(x+2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+2}{6}$",
          "worked": "$$\\begin{aligned}\\frac{3(x-1)(x+2)^2}{18(x-1)(x+2)}&=\\frac{3(x+2)^2}{18(x+2)}\\\\&=\\frac{3(x+2)}{18}\\\\&=\\frac{x+2}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2+6x+9}{2x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{2}$",
          "worked": "$$\\begin{aligned}\\frac{x^2+6x+9}{2x+6}&=\\frac{(x+3)^2}{2(x+3)}\\\\&=\\frac{(x+3)(x+3)}{2(x+3)}\\\\&=\\frac{x+3}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{11x-22}{x^2-4x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11}{x-2}$",
          "worked": "$$\\begin{aligned}\\frac{11x-22}{x^2-4x+4}&=\\frac{11(x-2)}{(x-2)^2}\\\\&=\\frac{11(x-2)}{(x-2)(x-2)}\\\\&=\\frac{11}{x-2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q9-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x^2-6x+9}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3$",
          "worked": "$$\\begin{aligned}\\frac{x^2-6x+9}{x-3}&=\\frac{(x-3)^2}{x-3}\\\\&=\\frac{(x-3)(x-3)}{x-3}\\\\&=x-3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q9-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{4x+20}{x^2+10x+25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{x+5}$",
          "worked": "$$\\begin{aligned}\\frac{4x+20}{x^2+10x+25}&=\\frac{4(x+5)}{(x+5)^2}\\\\&=\\frac{4(x+5)}{(x+5)(x+5)}\\\\&=\\frac{4}{x+5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q9-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{x^2-14x+49}{5x-35}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-7}{5}$",
          "worked": "$$\\begin{aligned}\\frac{x^2-14x+49}{5x-35}&=\\frac{(x-7)^2}{5(x-7)}\\\\&=\\frac{(x-7)(x-7)}{5(x-7)}\\\\&=\\frac{x-7}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
