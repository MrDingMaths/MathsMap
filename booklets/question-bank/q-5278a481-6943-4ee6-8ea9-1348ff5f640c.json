      {
        "id": "p80-q33-a",
        "type": "part",
        "label": "a",
        "prompt": "Write 315 and 90 in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$315=3^{2}\\cdot5\\cdot7$, $90=2\\cdot3^{2}\\cdot5$.",
          "worked": "$$\\begin{align*}315&=9\\cdot35\\\\315&=3\\cdot3\\cdot5\\cdot7\\\\315&=3^{2}\\cdot5\\cdot7\\\\90&=9\\cdot10\\\\90&=2\\cdot3\\cdot3\\cdot5\\\\90&=2\\cdot3^{2}\\cdot5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p80-q33-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the LCM and HCF of 315 and 90. Answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "LCM: $2\\cdot3^{2}\\cdot5\\cdot7$; HCF: $3^{2}\\cdot5$.",
          "worked": "Align the prime bases, using zero indices for primes absent from either number.\n$$\\begin{align*}315&=2^{0}\\cdot3^{2}\\cdot5^{1}\\cdot7^{1}\\\\90&=2^{1}\\cdot3^{2}\\cdot5^{1}\\cdot7^{0}\\end{align*}$$\nChoose the largest index for each prime for the LCM, and the smallest for the HCF.\n$$\\begin{align*}\\operatorname{LCM}(315,90)&=2^{1}\\cdot3^{2}\\cdot5^{1}\\cdot7^{1}\\\\\\operatorname{HCF}(315,90)&=2^{0}\\cdot3^{2}\\cdot5^{1}\\cdot7^{0}\\\\\\operatorname{HCF}(315,90)&=3^{2}\\cdot5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p80-q33-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the product of the LCM and HCF. Answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cdot3^{4}\\cdot5^{2}\\cdot7$.",
          "worked": "$$\\begin{align*}\\operatorname{LCM}(315,90)\\cdot\\operatorname{HCF}(315,90)&=(2\\cdot3^{2}\\cdot5\\cdot7)(3^{2}\\cdot5)\\\\\\operatorname{LCM}(315,90)\\cdot\\operatorname{HCF}(315,90)&=2\\cdot3^{2+2}\\cdot5^{1+1}\\cdot7\\\\\\operatorname{LCM}(315,90)\\cdot\\operatorname{HCF}(315,90)&=2\\cdot3^{4}\\cdot5^{2}\\cdot7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p80-q33-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the product of 315 and 90. Answer in index form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cdot3^{4}\\cdot5^{2}\\cdot7$.",
          "worked": "$$\\begin{align*}315\\cdot90&=(3^{2}\\cdot5\\cdot7)(2\\cdot3^{2}\\cdot5)\\\\315\\cdot90&=2\\cdot3^{2+2}\\cdot5^{1+1}\\cdot7\\\\315\\cdot90&=2\\cdot3^{4}\\cdot5^{2}\\cdot7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p80-q33-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
