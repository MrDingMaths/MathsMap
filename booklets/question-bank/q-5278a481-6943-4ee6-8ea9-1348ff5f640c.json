              "inlines": [
                {
                  "type": "text",
                  "text": "Explain, using your knowledge of index laws, why the ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\mathit{HCF}\\times\\mathit{LCM}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " of two numbers is ",
                  "marks": []
                },
                {
                  "type": "text",
