        "type": "part",
        "label": "a",
        "prompt": "A rectangular playground measures 5 cm by 3 cm on a plan with scale $1:1000$. What is the real-life distance around its boundary? Give your answer in metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$160\\text{ m}$",
          "worked": "$$\\begin{aligned}\\text{Plan perimeter}&=2(5+3)=16\\text{ cm}\\\\\\text{Actual perimeter}&=16\\times1000=16\\,000\\text{ cm}\\\\&=160\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-0a48b-p32-practice-retro-slot-1-225344-retro-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A rectangular courtyard measures 7 cm by 5 cm on a plan with scale $1:200$. Edging costs $\\$15$ per metre. What is the cost of edging all the way around the courtyard?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$720$",
          "worked": "$$\\begin{aligned}\\text{Plan perimeter}&=2(7+5)=24\\text{ cm}\\\\\\text{Actual perimeter}&=24\\times200=4800\\text{ cm}\\\\&=48\\text{ m}\\\\\\text{Cost}&=48\\times\\$15=\\$720\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
