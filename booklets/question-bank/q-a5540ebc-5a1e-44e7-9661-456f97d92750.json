  "content": {
    "id": "p67-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "$N$ is a number divisible by 5. Prove that $(N+1)^2+(N+2)^2$ is also divisible by 5.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Writing $N=5L$ for an integer $L$ gives $(N+1)^2+(N+2)^2=5(10L^2+6L+1)$, so it is divisible by 5.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p67-q9-answer-introduction",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Write ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "N=5L",
                "display": false
              },
              {
                "type": "text",
                "text": ", where L is an integer.",
                "marks": []
              }
            ]
          },
          {
            "id": "p67-q9-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}(N+1)^2+(N+2)^2&=2N^2+6N+5\\\\(N+1)^2+(N+2)^2&=2(5L)^2+6(5L)+5\\\\(N+1)^2+(N+2)^2&=5(2\\times5L^2+6L+1)\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p67-q9-answer-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2\\times5L^2+6L+1",
                "display": false
              },
              {
                "type": "text",
                "text": " is an integer, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(N+1)^2+(N+2)^2",
                "display": false
              },
              {
                "type": "text",
                "text": " is divisible by 5.",
                "marks": []
              }
            ]
          }
        ]
