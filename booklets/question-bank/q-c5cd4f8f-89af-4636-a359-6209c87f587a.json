  "content": {
    "id": "v2-03008-p17-practice-slot-9-root",
    "type": "question",
    "label": null,
    "prompt": "Find the positive constants in each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-03008-p17-practice-slot-9-slot-9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=a\\sin^{-1}(bx)$ has domain $\\left[-\\frac14,\\frac14\\right]$ and range $\\left[-\\frac{3\\pi}{2},\\frac{3\\pi}{2}\\right]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=3,\\ b=4$",
          "worked": "The domain is $\\left[-\\frac1b,\\frac1b\\right]$, so $\\frac1b=\\frac14$.\n\nThe range is $\\left[-\\frac{a\\pi}{2},\\frac{a\\pi}{2}\\right]$, so $\\frac{a\\pi}{2}=\\frac{3\\pi}{2}$.\n\n$$a=3,\\qquad b=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-03008-p17-practice-slot-9-slot-9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=a\\cos^{-1}(x-d)$ has domain $[2,4]$ and range $[0,5\\pi]$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5,\\ d=3$",
          "worked": "The domain is $[d-1,d+1]=[2,4]$, so $d=3$.\n\nThe range is $[0,a\\pi]=[0,5\\pi]$, so $a=5$.\n\n$$a=5,\\qquad d=3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-03008-p17-practice-slot-9-slot-9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=a\\tan^{-1}x+c$ has range $(-\\pi,3\\pi)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=4,\\ c=\\pi$",
          "worked": "The range is $\\left(c-\\frac{a\\pi}{2},\\,c+\\frac{a\\pi}{2}\\right)$.\n\n$$\\begin{aligned}c-\\frac{a\\pi}{2}&=-\\pi\\\\c+\\frac{a\\pi}{2}&=3\\pi\\end{aligned}$$\n\nAdding gives $2c=2\\pi$, so $c=\\pi$. Subtracting gives $a\\pi=4\\pi$, so $a=4$.\n\n$$a=4,\\qquad c=\\pi$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
