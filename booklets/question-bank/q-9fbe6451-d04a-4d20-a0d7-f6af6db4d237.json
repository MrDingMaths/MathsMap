  "content": {
    "id": "p31-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The diagonal of a rectangle is 10 cm long. The rectangle is twice as long as it is wide.\nWhat are the dimensions of the rectangle? Round your answers to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p31-q12-rectangle",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"User feedback 19 October 2026\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\draw[black] (0,0) rectangle (4,2);\n\\draw[black,dashed,line width=0.4pt] (0,0)--(4,2);\n\\path (0,0)--(4,0) node[midway,below] {$2w$};\n\\path (0,0)--(0,2) node[midway,left] {$w$};\n\\path (0,0)--(4,2) node[midway,above,sloped] {$10\\text{ cm}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [],
    "answer": {
      "short": "Width $4.47\\text{ cm}$; length $8.94\\text{ cm}$.",
      "worked": "Let $w$ be the width in centimetres. The length is $2w$ centimetres.\n$$\\begin{aligned}w^2+(2w)^2&=10^2\\\\5w^2&=100\\\\w^2&=20\\\\w&=\\sqrt{20}\\\\&\\approx4.47\\end{aligned}$$\nThe width is $\\sqrt{20}\\text{ cm}\\approx4.47\\text{ cm}$ and the length is $2\\sqrt{20}\\text{ cm}\\approx8.94\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
