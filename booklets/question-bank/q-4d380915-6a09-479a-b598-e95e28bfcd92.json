  "content": {
    "id": "v2-612b9b-p5-practice-j9-094516-root",
    "type": "question",
    "label": null,
    "prompt": "A car had a full tank of 64 L at the start of a 280 km journey.\nAt the end of the journey, the fuel tank was three eighths full.\nHow much fuel was used on the journey?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$40\\text{ L}$",
      "worked": "$$\\begin{align*}\\text{Fuel left}&=\\frac{3}{8}\\times64\\\\\\text{Fuel left}&=24\\text{ L}\\\\\\text{Fuel used}&=64-24\\\\\\text{Fuel used}&=40\\text{ L}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
