  "content": {
    "id": "p13-q5",
    "type": "question",
    "label": "5",
    "prompt": "For the sector shown, Jerry calculated the fraction of the circle as $\\dfrac{240}{360}=\\dfrac{2}{3}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p13-q5-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 13, p13-q5-diagram\"}\n\\begin{tikzpicture}[font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (R) at (2.4,0);\n\\coordinate (U) at (120:2.4);\n\\draw[black,line width=0.8pt] (O)--(R) arc[start angle=0,end angle=120,radius=2.4]--cycle;\n\\draw[black,line width=0.4pt] (120:0.58) arc[start angle=120,end angle=360,radius=0.58];\n\\fill[black] (O) circle[radius=0.055];\n\\path (O)--(R) node[midway,below=2mm,text=black] {$6\\,\\mathrm{m}$};\n\\node[anchor=north east,text=black] at (225:0.78) {$240^\\circ$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 48,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 13,
          "sourceRegion": "Question 5, shared diagram at lower left",
          "description": "Unfilled minor sector with a horizontal radius extending right, another radius extending upward-left, a centre dot, a 6 m radius label and an exterior reflex-angle marker labelled 240°.",
          "mathematics": "The exterior angle is 240°, so the interior angle is 120°. The radius is 6 m.",
          "answerVisibility": "Only source givens are visible; the interior angle and area are not supplied in the question diagram."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why he is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The angle inside the sector is not $240^\\circ$.",
          "worked": "Jerry used the exterior angle. The fraction must use the angle inside the sector.\n$$\\begin{align*}\\theta &= 360^\\circ-240^\\circ\\\\\\theta &= 120^\\circ\\end{align*}$$\nThe correct fraction is $\\dfrac{120}{360}=\\dfrac{1}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the area of the sector, round to 1 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37.7\\,\\mathrm{m}^2$",
          "worked": "$$\\begin{align*}\\theta &= 360^\\circ-240^\\circ=120^\\circ\\\\A &= \\frac{\\theta}{360}\\times\\pi r^2\\\\A &= \\frac{120}{360}\\times\\pi(6)^2\\\\A &= 12\\pi\\,\\mathrm{m}^2\\\\A &\\approx 37.7\\,\\mathrm{m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
