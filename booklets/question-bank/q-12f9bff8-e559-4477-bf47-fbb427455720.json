  "content": {
    "id": "p55-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A metal ingot is cooled to $5^\\circ\\mathrm{C}$ then placed in a room at $25^\\circ\\mathrm{C}$.\n\nLet $H$ be the temperature after $t$ minutes.\n\n$$\\frac{dH}{dt}=k(H-25),\\quad\\text{for some constant }k.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the general solution of this DE.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$H=25+Ae^{kt}$.",
          "worked": "$$\\begin{align*}\\frac{dH}{H-25}&=k\\,dt\\\\\\ln|H-25|&=kt+C\\\\H-25&=Ae^{kt}\\\\H&=25+Ae^{kt}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p55-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the initial condition to determine the arbitrary constant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=-20$, hence $H=25-20e^{kt}$.",
          "worked": "Using $H(0)=5$:\n$$\\begin{align*}5&=25+A\\\\A&=-20\\\\H&=25-20e^{kt}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p55-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "After 10 minutes the ingot is at $15^\\circ\\mathrm{C}$. Determine the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-\\dfrac{\\ln 2}{10}\\ \\mathrm{min}^{-1}$.",
          "worked": "Using $H(10)=15$:\n$$\\begin{align*}25-20e^{10k}&=15\\\\e^{10k}&=\\frac12\\\\k&=-\\frac{1}{10}\\ln 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p55-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Find how long it takes, to the nearest minute, for the temperature to reach $24^\\circ\\mathrm{C}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "43 minutes.",
          "worked": "$$\\begin{align*}25-20e^{kt}&=24\\\\e^{kt}&=\\frac{1}{20}\\\\kt&=-\\ln20\\\\t&=\\frac{-\\ln20}{-\\left(\\frac{1}{10}\\right)\\ln2}\\\\t&=\\frac{10\\ln20}{\\ln2}\\\\t&\\approx43\\text{ minutes}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
