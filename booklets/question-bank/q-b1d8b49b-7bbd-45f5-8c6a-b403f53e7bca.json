  "content": {
    "id": "p24-cc1-6-root",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p24-cc1-6-shared-stem",
          "type": "paragraph",
          "fontSize": null,
