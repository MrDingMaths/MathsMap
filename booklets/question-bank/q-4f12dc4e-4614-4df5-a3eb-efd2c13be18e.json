  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Give a proof of each of the following statements:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose $a,b,c\\in\\mathbb Z$. If $a$ divides $b$ and $a$ divides $c$, then $a$ divides $b+c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Write $b=ak$ and $c=a\\ell$ with $k,\\ell\\in\\mathbb Z$. Then $b+c=a(k+\\ell)$.",
          "worked": "Since $a$ divides $b$ and $c$, write $b=ak$ and $c=a\\ell$, where $k,\\ell\\in\\mathbb Z$.\n$$\\begin{align*}b+c&=ak+a\\ell\\\\b+c&=a(k+\\ell).\\end{align*}$$\nSince $k+\\ell$ is an integer, $a$ divides $b+c$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose $a,b\\in\\mathbb Z$. If $a$ divides $b$, then $a^2$ divides $b^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Write $b=ak$, where $k\\in\\mathbb Z$. Then $b^2=a^2k^2$, so $a^2$ divides $b^2$.",
          "worked": "Since $a$ divides $b$, write $b=ak$, where $k\\in\\mathbb Z$.\n$$\\begin{align*}b^2&=(ak)^2\\\\b^2&=a^2k^2.\\end{align*}$$\nSince $k^2$ is an integer, $a^2$ divides $b^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Suppose $a,b,c,d\\in\\mathbb Z$. If $a$ divides $b$ and $c$ divides $d$, then $ac$ divides $bd$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Write $b=ak$ and $d=c\\ell$. Then $bd=ac(k\\ell)$, so $ac$ divides $bd$.",
          "worked": "Write $b=ak$ and $d=c\\ell$, where $k,\\ell\\in\\mathbb Z$.\n$$\\begin{align*}bd&=(ak)(c\\ell)\\\\bd&=ac(k\\ell).\\end{align*}$$\nSince $k\\ell$ is an integer, $ac$ divides $bd$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Suppose $x,y\\in\\mathbb R$. If $x^2+3y=y^2+3x$, then $x=y$ or $x+y=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(x+y-3)=0$, so $x=y$ or $x+y=3$.\n\nRearrange and factor using the difference of squares.",
          "worked": "Rearranging the given equality gives\n$$\\begin{align*}x^2-y^2-3x+3y&=0\\\\(x-y)(x+y)-3(x-y)&=0\\\\(x-y)(x+y-3)&=0.\\end{align*}$$\nBy the zero-product property, $x-y=0$ or $x+y-3=0$. Hence $x=y$ or $x+y=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p12-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "Suppose $a\\in\\mathbb Z$. If $a^2$ divides $a$, then $a\\in\\{-1,0,1\\}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a\\in\\{-1,0,1\\}$.\n\nWrite $a=ka^2$ and separate $a=0$ from $ka=1$.",
          "worked": "Since $a^2$ divides $a$, write $a=ka^2$ for some $k\\in\\mathbb Z$.\n$$\\begin{align*}ka^2-a&=0\\\\a(ka-1)&=0.\\end{align*}$$\nThus $a=0$ or $ka=1$. In the second case, the integer factors of $1$ are $1$ and $-1$, so $a=1$ or $a=-1$. Therefore $a\\in\\{-1,0,1\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
