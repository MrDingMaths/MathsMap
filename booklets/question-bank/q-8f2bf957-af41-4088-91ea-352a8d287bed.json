  "content": {
    "id": "p5-q15-root",
    "type": "question",
    "label": null,
    "prompt": "Suppose 28% of students in a class have black hair. Five black-haired students leave the class. Now 10% of the students have black hair. How many students were originally in the class?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p5-q15-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "25 students.",
                "marks": []
              }
            ]
          },
          {
            "id": "p5-q15-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Equate the remaining black-haired students to 10% of the remaining class: ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0.28x-5=0.10(x-5)",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Let $x$ be the original number of students. Initially $0.28x$ students have black hair. After five leave, $x-5$ students remain, including $0.28x-5$ with black hair.\n\n$$\\begin{align*}0.28x-5&=0.10(x-5)\\\\0.28x-5&=0.10x-0.5\\\\0.18x&=4.5\\\\x&=25\\end{align*}$$\n\nThere were originally 25 students.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
