  "content": {
    "id": "p10-probability-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A bag contains three red beads, two blue beads and four yellow beads. If one bead is drawn at random from the bag, find the probability that the bead is:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-probability-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "There are $3+2+4=9$ beads and 3 are red, so $P(\\text{red})=\\frac{3}{9}=\\frac{1}{3}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-probability-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "red or blue",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac59$",
          "worked": "The colour categories are disjoint: $\\frac{(3+2)}{9}=\\frac{5}{9}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-probability-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "red or yellow or blue",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Every bead has one of these three colours, so the event is certain: $\\frac{9}{9}=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
