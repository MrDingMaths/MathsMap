  "content": {
    "id": "p35-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A group of 10 friends all prepared to go out in the sun by putting on either sunscreen or a hat.\nIf 5 put on only sunscreen and 3 put on both sunscreen and a hat, find the probability that a friend who:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "put on sunscreen also put on a hat",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{8}$",
          "worked": "Let $S$ be putting on sunscreen and $H$ be putting on a hat. There are $5+3=8$ friends who put on sunscreen.\n$$\\begin{align*}P(H\\mid S)&=\\frac{P(H\\cap S)}{P(S)}\\\\P(H\\mid S)&=\\frac{3/10}{8/10}\\\\P(H\\mid S)&=\\frac{3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p35-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "put on a hat didn't put on sunscreen.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "Let $S$ be putting on sunscreen and $H$ be putting on a hat. There are $10-5-3=2$ friends who put on only a hat, and $2+3=5$ who put on a hat. The event $S'\\cap H$ means hat only.\n$$\\begin{align*}P(S'\\mid H)&=\\frac{P(S'\\cap H)}{P(H)}\\\\P(S'\\mid H)&=\\frac{2/10}{5/10}\\\\P(S'\\mid H)&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
