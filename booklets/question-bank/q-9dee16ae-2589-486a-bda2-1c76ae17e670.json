  "content": {
    "id": "p27-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Use the given fact to evaluate the given expression.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}\\log_5 125&=3\\\\\\log_{125}5&=\\ ?\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "$$\\begin{align*}\\log_{125}5&=\\frac{\\log_5 5}{\\log_5 125}\\\\\\log_{125}5&=\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}\\log_{100}10&=\\frac12\\\\\\log_{10}100&=\\ ?\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{10}100&=\\frac{\\log_{100}100}{\\log_{100}10}\\\\\\log_{10}100&=\\frac{1}{1/2}\\\\\\log_{10}100&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}\\log_4\\frac1{64}&=-3\\\\\\log_{64}\\frac14&=\\ ?\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac13$",
          "worked": "$$\\begin{align*}\\log_4 64&=-\\log_4\\frac1{64}\\\\\\log_4 64&=3\\\\\\log_{64}\\frac14&=\\frac{\\log_4(1/4)}{\\log_4 64}\\\\\\log_{64}\\frac14&=-\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p27-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}\\log_{36}6&=\\frac12\\\\\\log_{36}\\frac16&=\\ ?\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}\\log_{36}\\frac16&=\\frac{\\log_6(1/6)}{\\log_6 36}\\\\\\log_6 36&=\\frac{1}{\\log_{36}6}=2\\\\\\log_{36}\\frac16&=\\frac{-1}{2}\\\\\\log_{36}\\frac16&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
