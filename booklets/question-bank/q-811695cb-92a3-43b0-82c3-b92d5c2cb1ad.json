  "content": {
    "id": "p5-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A circle of radius $1$ is centred at $(1,1)$. A second circle of radius $2$ is centred at $(4,4)$. Find the shortest distance from a point on the first circle to a point on the second circle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3\\sqrt{2}-3$ units.\n\nSubtract both radii from the distance between the centres.",
      "worked": "The distance between the centres is\n$$\\begin{align*}d&=\\sqrt{(4-1)^2+(4-1)^2}\\\\d&=\\sqrt{18}\\\\d&=3\\sqrt{2}.\\end{align*}$$\nSince $3\\sqrt{2}>1+2$, the circles are separate. Their nearest points lie on the segment joining their centres.\n$$\\begin{align*}s&=3\\sqrt{2}-1-2\\\\s&=3\\sqrt{2}-3\\text{ units}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
