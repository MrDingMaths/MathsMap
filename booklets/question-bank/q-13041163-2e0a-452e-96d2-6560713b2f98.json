    "children": [
      {
        "id": "p11-q50-a",
        "type": "part",
        "label": "a",
        "prompt": "For what value(s) of $k$ will $y=f(x)+k$ and $y=g(x)$ have one point of intersection?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p11-q50-a-short-result",
                "type": "paragraph",
