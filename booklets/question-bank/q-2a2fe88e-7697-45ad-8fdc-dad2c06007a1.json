  "content": {
    "id": "p20-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Find the number of sides in an irregular polygon with one exterior angle of $45^{\\circ}$ and all others $15^{\\circ}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "22 sides.",
      "worked": "Let $n$ be the number of sides. The exterior angles sum to $360^{\\circ}$.\n$$\\begin{align*}45+15(n-1)&=360\\\\15(n-1)&=315\\\\n-1&=21\\\\n&=22\\end{align*}$$\nThe polygon has 22 sides.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
