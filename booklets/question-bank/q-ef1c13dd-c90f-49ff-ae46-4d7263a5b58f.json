        "label": "a",
        "prompt": "Find the size of each exterior angle of a regular 14-sided polygon. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25.71^{\\circ}$",
          "worked": "$$\\begin{aligned}E&=\\frac{360^{\\circ}}{14}\\\\&=\\frac{180^{\\circ}}{7}\\\\&\\approx25.71^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the size of each interior angle. Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$154.29^{\\circ}$",
          "worked": "$$\\begin{aligned}I&=180^{\\circ}-\\frac{180^{\\circ}}{7}\\\\&=\\frac{1080^{\\circ}}{7}\\\\&\\approx154.29^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
