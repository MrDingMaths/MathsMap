        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expression for the perimeter of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a+12$",
          "worked": "$$\\begin{align*}P&=2(2a+1)+2(5)\\\\P&=4a+2+10\\\\P&=4a+12\\end{align*}$$",
