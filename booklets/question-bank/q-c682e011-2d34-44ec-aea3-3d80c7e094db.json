  "content": {
    "id": "p23-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The probability that on any given day it will rain is $\\frac{1}{3}$.\nThe probability that on any given day I will wear my coat is $\\frac{1}{2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of it raining and I wear my coat, assuming these are independent events?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$\\begin{align*}P(\\text{rain and coat})&=P(\\text{rain})\\times P(\\text{coat})\\\\&=\\frac{1}{3}\\times\\frac{1}{2}\\\\&=\\frac{1}{6}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why, in real life, we cannot assume that the probability of it raining and I wear my coat is $\\frac{1}{6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The events are dependent: I am more likely to wear my coat if it rains.",
          "worked": "I am more likely to wear my coat if it rains, so wearing my coat and rain are dependent events. Multiplying their individual probabilities does not establish the probability of both occurring.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
