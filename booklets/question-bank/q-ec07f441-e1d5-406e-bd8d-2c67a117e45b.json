  "content": {
    "id": "p42-q17",
    "type": "question",
    "label": "17",
    "prompt": "Complete the square to determine the centre and radius of each circle.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+4x+y^2-8y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2)^2+(y-4)^2=20$. Centre $(-2,4)$, radius $2\\sqrt{5}$.",
          "worked": "$$\\begin{align*}(x^2+4x+4)+(y^2-8y+16)&=0+4+16\\\\(x+2)^2+(y-4)^2&=20\\\\r&=\\sqrt{20}\\\\r&=2\\sqrt{5}\\end{align*}$$\nCentre $(-2,4)$, radius $2\\sqrt{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p42-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-2x+y^2+4y=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-1)^2+(y+2)^2=4$. Centre $(1,-2)$, radius $2$.",
          "worked": "$$\\begin{align*}(x^2-2x+1)+(y^2+4y+4)&=-1+1+4\\\\(x-1)^2+(y+2)^2&=4\\\\r&=\\sqrt{4}\\\\r&=2\\end{align*}$$\nCentre $(1,-2)$, radius $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
