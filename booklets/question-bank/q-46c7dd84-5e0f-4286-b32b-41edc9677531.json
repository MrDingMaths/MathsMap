    "children": [
      {
        "id": "p15-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt[5]{10t^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10^{\\frac{1}{5}}t^{\\frac{2}{5}}$",
          "worked": "$\\begin{aligned}\\sqrt[5]{10t^2}&=(10t^2)^{\\frac{1}{5}}\\\\&=10^{\\frac{1}{5}}t^{\\frac{2}{5}}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt[8]{8m^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8^{\\frac{1}{8}}|m|^{\\frac{1}{2}}$",
          "worked": "$\\begin{aligned}\\sqrt[8]{8m^4}&=8^{\\frac{1}{8}}(m^4)^{\\frac{1}{8}}\\\\&=8^{\\frac{1}{8}}|m|^{\\frac{1}{2}}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[4]{7x^7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7^{\\frac{1}{4}}x^{\\frac{7}{4}}$",
          "worked": "$\\begin{aligned}\\sqrt[4]{7x^7}&=(7x^7)^{\\frac{1}{4}}\\\\&=7^{\\frac{1}{4}}x^{\\frac{7}{4}}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$6\\sqrt5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\times5^{\\frac{1}{2}}$",
          "worked": "$6\\sqrt5=6\\times5^{\\frac{1}{2}}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q1-e",
