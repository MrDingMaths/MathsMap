              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "wins both games, given he wins the first game.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{4}$",
          "worked": "The first win is already known, so winning both requires only a second win.\n$$\\begin{align*}P(\\text{both wins}\\mid\\text{first win})&=P(\\text{second win}\\mid\\text{first win})\\\\P(\\text{both wins}\\mid\\text{first win})&=\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
