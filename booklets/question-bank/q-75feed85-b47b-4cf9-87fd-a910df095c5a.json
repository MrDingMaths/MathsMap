  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Given that $y\\propto x^3$, what is the effect on $y$ when $x$ is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "doubled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is multiplied by 8.",
          "worked": "Since $y=kx^3$, choose $x=1$. Initially, $y=k$.\n\nWhen $x=2$:\n$$\\begin{align*}y&=k(2)^3\\\\y&=8k\\end{align*}$$\nThus $y$ is multiplied by 8.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "multiplied by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is multiplied by 27.",
          "worked": "Since $y=kx^3$, choose $x=1$. Initially, $y=k$.\n\nWhen $x=3$:\n$$\\begin{align*}y&=k(3)^3\\\\y&=27k\\end{align*}$$\nThus $y$ is multiplied by 27.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p14-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "divided by 4?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y$ is divided by 64.",
          "worked": "Since $y=kx^3$, choose $x=1$. Initially, $y=k$.\n\nWhen $x=\\frac14$:\n$$\\begin{align*}y&=k\\left(\\frac14\\right)^3\\\\y&=\\frac{k}{64}\\end{align*}$$\nThus $y$ is divided by 64.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
