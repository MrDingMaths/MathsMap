    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area of a square of perimeter 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{16}$ square units.",
          "worked": "Let $s$ be the side length.\n$$\\begin{align*}4s&=1\\\\s&=\\frac14\\end{align*}$$\n$$\\begin{align*}A&=s^2\\\\A&=\\left(\\frac14\\right)^2\\\\A&=\\frac1{16}\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p21-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of a circle of perimeter 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{4\\pi}$ square units.",
          "worked": "$$\\begin{align*}2\\pi r&=1\\\\r&=\\frac1{2\\pi}\\end{align*}$$\n$$\\begin{align*}A&=\\pi r^2\\\\A&=\\pi\\left(\\frac1{2\\pi}\\right)^2\\\\A&=\\frac1{4\\pi}\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p21-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Which of these two figures has the greater area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The circle, since $4\\pi<16$ and hence $\\dfrac1{4\\pi}>\\dfrac1{16}$.",
          "worked": "Since $\\pi<4$, we have $4\\pi<16$. Taking reciprocals of these positive numbers gives $\\dfrac1{4\\pi}>\\dfrac1{16}$. Therefore, the circle has the greater area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
