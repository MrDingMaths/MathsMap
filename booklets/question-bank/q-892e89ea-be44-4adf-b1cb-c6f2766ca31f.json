          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A particle has displacement equation",
              "marks": []
            }
          ]
        },
        {
          "id": "p79-q38-equation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "x(t)=t^{3}+at^{2}+bt+c",
              "display": false
            }
          ]
        },
        {
          "id": "p79-q38-condition",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Initially, the particle is at ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x=1",
              "display": false
            },
            {
              "type": "text",
              "text": " and after one second, the particle returns to its initial position.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p79-q38.a",
        "type": "part",
        "label": "a",
        "prompt": "Find $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=1$.",
          "worked": "$$\\begin{align*}x(0)&=c\\\\x(0)&=1\\\\c&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p79-q38.b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $a+b=-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b=-1$. Use $x(1)=1$.",
          "worked": "Since the particle returns to its initial position, $x(1)=x(0)=1$.\n$$\\begin{align*}x(1)&=1+a+b+c\\\\1&=1+a+b+1\\\\a+b&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p79-q38.c",
        "type": "part",
        "label": "c",
        "prompt": "At $t=2$, the velocity is $2\\text{ m s}^{-1}$. Show that $4a+b=-10$ and hence, find $x(t)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(t)=t^{3}-3t^{2}+2t+1$. Differentiate to get $v(t)=3t^{2}+2at+b$; then use $v(2)=2$.",
          "worked": "$$\\begin{align*}v(t)&=x'(t)=3t^{2}+2at+b\\\\v(2)&=12+4a+b=2\\\\4a+b&=-10\\end{align*}$$\nTogether with $a+b=-1$,\n$$\\begin{align*}3a&=-9\\\\a&=-3\\\\b&=2\\end{align*}$$\nTherefore $x(t)=t^{3}-3t^{2}+2t+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
