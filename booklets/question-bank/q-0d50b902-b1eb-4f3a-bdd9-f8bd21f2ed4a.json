  "content": {
    "id": "p39-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If $\\underset{\\sim}{u}=i+2j$, $\\underset{\\sim}{v}=-4i+3j$ and $\\underset{\\sim}{w}=\\underset{\\sim}{u}+\\underset{\\sim}{v}$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{\\hat u}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt5}i+\\dfrac{2}{\\sqrt5}j$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{u}|&=\\sqrt{1^2+2^2}\\\\&=\\sqrt5\\\\\\underset{\\sim}{\\hat u}&=\\frac{i+2j}{\\sqrt5}\\\\&=\\frac{1}{\\sqrt5}i+\\frac{2}{\\sqrt5}j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{\\hat v}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac45i+\\dfrac35j$",
          "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|&=\\sqrt{(-4)^2+3^2}\\\\&=5\\\\\\underset{\\sim}{\\hat v}&=\\frac{-4i+3j}{5}\\\\&=-\\frac45i+\\frac35j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p39-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{\\hat w}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{\\sqrt{34}}i+\\dfrac{5}{\\sqrt{34}}j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{w}&=(i+2j)+(-4i+3j)\\\\&=-3i+5j\\\\|\\underset{\\sim}{w}|&=\\sqrt{(-3)^2+5^2}\\\\&=\\sqrt{34}\\\\\\underset{\\sim}{\\hat w}&=\\frac{-3i+5j}{\\sqrt{34}}\\\\&=-\\frac3{\\sqrt{34}}i+\\frac5{\\sqrt{34}}j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
