          "inlines": [
            {
              "type": "text",
              "text": "Three different taps drip every 48 seconds, 72 seconds, and 108 seconds, respectively.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "If they all drip at midday, then when do they next drip simultaneously?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12:07:12 pm (7 minutes 12 seconds after midday). The LCM of the intervals is $432$ seconds.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p82-q38-worked-factorisations",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}48&=2^4\\times3^1\\\\72&=2^3\\times3^2\\\\108&=2^2\\times3^3\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p82-q38-worked-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Choose the largest power of each prime factor.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p82-q38-worked-lcm",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}\\operatorname{LCM}(48,72,108)&=2^4\\times3^3\\\\\\operatorname{LCM}(48,72,108)&=432\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p82-q38-worked-conversion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "432 seconds is 7 minutes 12 seconds after midday.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
