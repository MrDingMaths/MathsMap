  "content": {
    "id": "v2-bab18-p10-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Show that the rate of change of each quantity is proportional to the quantity.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-bab18-p10-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "The number $N$ of bacteria in a culture after $t$ hours is given by $N=500e^{0.3t}$.\n\nShow that $\\dfrac{dN}{dt}=0.3N$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dN}{dt}=0.3N$.",
          "worked": "$$\\begin{align*}N&=500e^{0.3t}\\\\\\frac{dN}{dt}&=500(0.3)e^{0.3t}\\\\&=0.3\\left(500e^{0.3t}\\right)\\\\&=0.3N\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-bab18-p10-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "The amount $A$ mg of a drug in a patient's body after $t$ hours is given by $A=120e^{-0.15t}$.\n\nShow that $\\dfrac{dA}{dt}=-0.15A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dt}=-0.15A$.",
          "worked": "$$\\begin{align*}A&=120e^{-0.15t}\\\\\\frac{dA}{dt}&=120(-0.15)e^{-0.15t}\\\\&=-0.15\\left(120e^{-0.15t}\\right)\\\\&=-0.15A\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
