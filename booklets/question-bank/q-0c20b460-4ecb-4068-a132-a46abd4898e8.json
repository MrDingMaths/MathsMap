  "content": {
    "id": "p7-ch15-q2",
    "type": "question",
    "label": "2",
    "prompt": "A card is drawn at random from a standard deck of playing cards. Find the probability that the card is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-ch15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "a Heart",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are 13 Hearts among the 52 cards.\n\n$$P(\\text{Heart})=\\frac{13}{52}=\\frac{1}{4}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-ch15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "a Jack",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{13}$",
          "worked": "There are 4 Jacks among the 52 cards.\n\n$$P(\\text{Jack})=\\frac{4}{52}=\\frac{1}{13}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-ch15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "the Ace of Hearts",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{52}$",
          "worked": "There is one Ace of Hearts among the 52 cards.\n\n$$P(\\text{Ace of Hearts})=\\frac{1}{52}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-ch15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "a court card (i.e. a Jack, King or Queen)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{13}$",
          "worked": "Each of the four suits contains a Jack, King and Queen, giving $4\\times3=12$ court cards.\n\n$$P(\\text{court card})=\\frac{12}{52}=\\frac{3}{13}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
