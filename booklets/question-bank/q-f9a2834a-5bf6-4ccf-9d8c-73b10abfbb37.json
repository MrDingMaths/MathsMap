  "content": {
    "id": "p14-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "In maths and physics, the \"equations of motion\" relate the displacement of an object ($s$) with its initial velocity ($u$), final velocity ($v$), acceleration ($a$) and time ($t$).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Acceleration is defined as \"change in velocity divided by time\".\n\nForm an equation for $a$ in terms of $v$, $u$ and $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{v-u}{t}$",
          "worked": "Change in velocity is $v-u$.\n\n$$\\begin{align*}a&=\\frac{v-u}{t}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p14-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that your answer to part **a** can be rearranged to give $v=u+at$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$at=v-u$, so $v=u+at$.",
          "worked": "$$\\begin{align*}a&=\\frac{v-u}{t}\\\\at&=v-u\\\\v&=u+at\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p14-q13-c",
        "type": "group",
        "label": "c",
        "prompt": "Another equation of motion is $v^2=u^2+2as$. Rearrange this formula to make:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q13-c-a",
            "type": "part",
            "label": "i",
            "prompt": "$a$ the subject",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\frac{v^2-u^2}{2s}$",
              "worked": "$$\\begin{align*}v^2&=u^2+2as\\\\v^2-u^2&=2as\\\\a&=\\frac{v^2-u^2}{2s}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p14-q13-c-s",
            "type": "part",
            "label": "ii",
            "prompt": "$s$ the subject",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$s=\\frac{v^2-u^2}{2a}$",
              "worked": "$$\\begin{align*}v^2&=u^2+2as\\\\v^2-u^2&=2as\\\\s&=\\frac{v^2-u^2}{2a}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p14-q13-c-u",
            "type": "part",
            "label": "iii",
            "prompt": "$u$ the subject",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$u=\\pm\\sqrt{v^2-2as}$",
              "worked": "$$\\begin{align*}v^2&=u^2+2as\\\\u^2&=v^2-2as\\\\u&=\\pm\\sqrt{v^2-2as}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      },
      {
        "id": "p14-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "Yet another equation of motion is $s=\\frac12(u+v)t$.\n\nUse the formula in part **b** to show that this leads to $s=ut+\\frac12at^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=\\frac12(u+(u+at))t=ut+\\frac12at^2$",
          "worked": "Substitute $v=u+at$.\n\n$$\\begin{align*}s&=\\frac12(u+v)t\\\\s&=\\frac12\\bigl(u+(u+at)\\bigr)t\\\\s&=\\frac12(2u+at)t\\\\s&=\\frac{t}{2}(2u+at)\\\\s&=ut+\\frac12at^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
