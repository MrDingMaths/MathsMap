  "content": {
    "id": "p37-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the stationary point on the curve $y=3x^2-12x+7$ and show that it is a minimum turning point.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(2,-5)$, a minimum turning point.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=6x-12\\\\6x-12&=0\\\\x&=2\\\\y(2)&=3(2)^2-12(2)+7\\\\y(2)&=-5\\\\\\frac{d^2y}{dx^2}&=6>0\\end{align*}$$\nTherefore, $(2,-5)$ is a minimum turning point.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
