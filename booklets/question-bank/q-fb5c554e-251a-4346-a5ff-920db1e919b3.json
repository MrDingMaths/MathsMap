  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use Pascal's triangle to expand:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1+2x)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+12x+60x^2+160x^3+240x^4+192x^5+64x^6$",
          "worked": "Row 6: $1,6,15,20,15,6,1$.\n$$\\begin{aligned}(1+2x)^6&=1+6(2x)+15(2x)^2+20(2x)^3+15(2x)^4+6(2x)^5+(2x)^6\\\\&=1+12x+60x^2+160x^3+240x^4+192x^5+64x^6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(1-2x)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-12x+60x^2-160x^3+240x^4-192x^5+64x^6$",
          "worked": "Row 6: $1,6,15,20,15,6,1$.\n$$\\begin{aligned}(1-2x)^6&=1-6(2x)+15(2x)^2-20(2x)^3+15(2x)^4-6(2x)^5+(2x)^6\\\\&=1-12x+60x^2-160x^3+240x^4-192x^5+64x^6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1+x)^9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+9x+36x^2+84x^3+126x^4+126x^5+84x^6+36x^7+9x^8+x^9$",
          "worked": "Row 9: $1,9,36,84,126,126,84,36,9,1$.\n$$\\begin{aligned}(1+x)^9&=1+9x+36x^2+84x^3+126x^4+126x^5+84x^6+36x^7+9x^8+x^9\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p10-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(1+2y)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+8y+24y^2+32y^3+16y^4$",
          "worked": "Row 4: $1,4,6,4,1$.\n$$\\begin{aligned}(1+2y)^4&=1+4(2y)+6(4y^2)+4(8y^3)+16y^4\\\\&=1+8y+24y^2+32y^3+16y^4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(1-\\frac{1}{x}\\right)^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\frac8x+\\frac{28}{x^2}-\\frac{56}{x^3}+\\frac{70}{x^4}-\\frac{56}{x^5}+\\frac{28}{x^6}-\\frac8{x^7}+\\frac1{x^8}$",
          "worked": "Row 8: $1,8,28,56,70,56,28,8,1$.\n$$\\begin{aligned}\\left(1-\\frac1x\\right)^8&=1+8\\left(-\\frac1x\\right)+28\\left(-\\frac1x\\right)^2+56\\left(-\\frac1x\\right)^3+70\\left(-\\frac1x\\right)^4+56\\left(-\\frac1x\\right)^5+28\\left(-\\frac1x\\right)^6\\\\&\\mathrel{\\phantom{=}}+8\\left(-\\frac1x\\right)^7+\\left(-\\frac1x\\right)^8\\\\&=1-\\frac8x+\\frac{28}{x^2}-\\frac{56}{x^3}+\\frac{70}{x^4}-\\frac{56}{x^5}+\\frac{28}{x^6}-\\frac8{x^7}+\\frac1{x^8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p10-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(1-3z)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-9z+27z^2-27z^3$",
          "worked": "Row 3: $1,3,3,1$.\n$$\\begin{aligned}(1-3z)^3&=1+3(-3z)+3(9z^2)+(-27z^3)\\\\&=1-9z+27z^2-27z^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(1+\\frac2x\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\frac{10}{x}+\\frac{40}{x^2}+\\frac{80}{x^3}+\\frac{80}{x^4}+\\frac{32}{x^5}$",
          "worked": "Row 5: $1,5,10,10,5,1$.\n$$\\begin{aligned}\\left(1+\\frac2x\\right)^5&=1+5\\left(\\frac2x\\right)+10\\left(\\frac4{x^2}\\right)+10\\left(\\frac8{x^3}\\right)+5\\left(\\frac{16}{x^4}\\right)+\\frac{32}{x^5}\\\\&=1+\\frac{10}{x}+\\frac{40}{x^2}+\\frac{80}{x^3}+\\frac{80}{x^4}+\\frac{32}{x^5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p10-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(1+\\frac yx\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\frac{5y}{x}+\\frac{10y^2}{x^2}+\\frac{10y^3}{x^3}+\\frac{5y^4}{x^4}+\\frac{y^5}{x^5}$",
          "worked": "Row 5: $1,5,10,10,5,1$.\n$$\\begin{aligned}\\left(1+\\frac yx\\right)^5&=1+5\\left(\\frac yx\\right)+10\\left(\\frac yx\\right)^2+10\\left(\\frac yx\\right)^3+5\\left(\\frac yx\\right)^4+\\left(\\frac yx\\right)^5\\\\&=1+\\frac{5y}{x}+\\frac{10y^2}{x^2}+\\frac{10y^3}{x^3}+\\frac{5y^4}{x^4}+\\frac{y^5}{x^5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
