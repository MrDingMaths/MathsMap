        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}f(g(4))&=f\\left(\\sqrt{4-3}\\right)\\\\f(g(4))&=f(1)\\\\f(g(4))&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p140-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(g(3))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}f(g(3))&=f\\left(\\sqrt{3-3}\\right)\\\\f(g(3))&=f(0)\\\\f(g(3))&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p140-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(g(2))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Undefined over the real numbers.",
          "worked": "$$\\begin{align*}g(2)&=\\sqrt{2-3}\\\\g(2)&=\\sqrt{-1}\\end{align*}$$\n\nThere is no real value of $g(2)$, so $f(g(2))$ is undefined over the real numbers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
