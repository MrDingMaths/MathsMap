  "content": {
    "id": "p16-q2",
    "type": "question",
    "label": "2",
    "prompt": "$y$ varies directly with $x$ and $y = 20$ when $x = 10$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y$ when $x = 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 16$",
          "worked": "$$\\begin{align*}y &= kx\\\\20 &= k(10)\\\\k &= \\frac{20}{10}\\\\k &= 2\\\\y &= 2x\\\\y &= 2(8)\\\\y &= 16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x$ when $y = 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = 6$",
          "worked": "Using $y = 2x$ from part a:\n$$\\begin{align*}12 &= 2x\\\\x &= \\frac{12}{2}\\\\x &= 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
