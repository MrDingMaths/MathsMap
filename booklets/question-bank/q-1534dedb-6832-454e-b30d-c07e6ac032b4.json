  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\sqrt{2}}{3}\\times\\frac{\\sqrt{2}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{2}}{3}\\times\\frac{\\sqrt{2}}{6}&=\\frac{2}{18}\\\\\\frac{\\sqrt{2}}{3}\\times\\frac{\\sqrt{2}}{6}&=\\frac{1}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sqrt{3}}{3}\\times\\frac{\\sqrt{3}}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{6}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}}{3}\\times\\frac{\\sqrt{3}}{6}&=\\frac{3}{18}\\\\\\frac{\\sqrt{3}}{3}\\times\\frac{\\sqrt{3}}{6}&=\\frac{1}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{\\sqrt{2}}\\times\\frac{1}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{2}}\\times\\frac{1}{\\sqrt{2}}&=\\frac{1}{(\\sqrt{2})^2}\\\\\\frac{1}{\\sqrt{2}}\\times\\frac{1}{\\sqrt{2}}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{\\sqrt{3}}\\times\\frac{3}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt{3}}\\times\\frac{3}{\\sqrt{3}}&=\\frac{6}{3}\\\\\\frac{2}{\\sqrt{3}}\\times\\frac{3}{\\sqrt{3}}&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{\\sqrt{8}}{\\sqrt{3}}\\times\\frac{\\sqrt{2}}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{3}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{8}}{\\sqrt{3}}\\times\\frac{\\sqrt{2}}{\\sqrt{3}}&=\\frac{\\sqrt{16}}{3}\\\\\\frac{\\sqrt{8}}{\\sqrt{3}}\\times\\frac{\\sqrt{2}}{\\sqrt{3}}&=\\frac{4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\sqrt{3}}{\\sqrt{2}}\\times\\frac{\\sqrt{12}}{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}}{\\sqrt{2}}\\times\\frac{\\sqrt{12}}{\\sqrt{2}}&=\\frac{\\sqrt{36}}{2}\\\\\\frac{\\sqrt{3}}{\\sqrt{2}}\\times\\frac{\\sqrt{12}}{\\sqrt{2}}&=\\frac{6}{2}\\\\\\frac{\\sqrt{3}}{\\sqrt{2}}\\times\\frac{\\sqrt{12}}{\\sqrt{2}}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2\\sqrt{8}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{2}}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{8}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{2}}{\\sqrt{3}}&=\\frac{6\\sqrt{16}}{6}\\\\\\frac{2\\sqrt{8}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{2}}{\\sqrt{3}}&=\\frac{24}{6}\\\\\\frac{2\\sqrt{8}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{2}}{\\sqrt{3}}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p13-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{3\\sqrt{6}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{3}}{\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{2}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{6}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{3}}{\\sqrt{6}}&=\\frac{9\\sqrt{18}}{2\\sqrt{18}}\\\\\\frac{3\\sqrt{6}}{2\\sqrt{3}}\\times\\frac{3\\sqrt{3}}{\\sqrt{6}}&=\\frac{9}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
