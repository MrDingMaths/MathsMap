  "content": {
    "id": "p6-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The graphs of $y=x^2+2$ and $y=-x^2+h$ intersect at $(-\\sqrt{5},p)$. Find the values of both $p$ and $h$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$p=7$ and $h=12$.",
      "worked": "The intersection lies on both graphs. Substituting $x=-\\sqrt{5}$ into $y=x^2+2$ gives\n$$\\begin{align*}p&=(-\\sqrt{5})^2+2\\\\p&=5+2\\\\p&=7.\\end{align*}$$\nSubstituting $(-\\sqrt{5},7)$ into $y=-x^2+h$ gives\n$$\\begin{align*}7&=-(-\\sqrt{5})^2+h\\\\7&=-5+h\\\\h&=12.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
