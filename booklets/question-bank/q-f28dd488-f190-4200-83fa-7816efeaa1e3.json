    "answer": {
      "short": "Customer Service pays \\$2067 more per year. Shop Assistant: \\$28 535 p.a.; Customer Service: \\$30 602 p.a.",
      "worked": "$$\\begin{align*}\\text{Shop Assistant annual pay} &= \\$1097.50\\times26\\\\&=\\$28\\,535\\\\\\text{Customer Service annual pay} &= \\$23.54\\times25\\times52\\\\&=\\$30\\,602\\\\\\text{Difference} &= \\$30\\,602-\\$28\\,535\\\\&=\\$2067\\end{align*}$$\nCustomer Service pays \\$2067 more per year.",
      "solutionDiagrams": []
    },
