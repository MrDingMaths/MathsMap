          "inlines": [
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "n\\ge 2",
              "display": false
            },
            {
              "type": "text",
              "text": " be a positive integer.",
              "marks": []
            }
