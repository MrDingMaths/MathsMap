        "label": "a",
        "prompt": "A rainwater tank holds 12 000 L and loses 7.5% of its water each week. Write an equation for the volume, $V$ litres, after $w$ weeks.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=12\\,000(0.925)^w$",
          "worked": "$$\\begin{align*}1-0.075&=0.925\\\\V&=12\\,000(0.925)^w\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b02ad-p42-practice-slot-7-upper-slot-7-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "A savings account of $\\$6000$ grows by 0.5% each month. Write an equation for the balance, $B$ dollars, after $m$ months.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B=6000(1.005)^m$",
          "worked": "$$\\begin{align*}1+0.005&=1.005\\\\B&=6000(1.005)^m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-b02ad-p42-practice-slot-7-upper-slot-7-upper-c",
        "type": "part",
        "label": "c",
        "prompt": "Use your equation in part a to find the volume of water in the tank after 4 weeks. Give your answer to the nearest litre.",
