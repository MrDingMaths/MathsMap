    "children": [
      {
        "id": "p50-q61a",
        "type": "part",
        "label": "a",
        "prompt": "Find the equation of the tangent to the curve at $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=x+3$",
          "worked": "$$\\begin{align*}f'(x)&=4x^3-6x^2-6x+5\\\\f'(-1)&=-4-6+6+5=1\\\\y-2&=1(x+1)\\\\y&=x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p50-q61b",
        "type": "part",
        "label": "b",
        "prompt": "There exists another point $Q$ on the curve such that $P$ and $Q$ share the same tangent. Find the point $Q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p50-q61b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "Q(2,5)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p50-q61b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Intersect ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "y=x+3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " with the curve: ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "(x+1)^2(x-2)^2=0",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The other double root is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x=2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "From part (a), the tangent is $y=x+3$. Intersect this line with the curve: \n\n$$\\begin{align*}f(x)-(x+3)&=x^4-2x^3-3x^2+4x+4\\\\f(x)-(x+3)&=(x+1)^2(x-2)^2\\\\0&=(x+1)^2(x-2)^2\\\\x&=2\\quad\\text{(the other root)}\\\\f(2)&=16-16-12+10+7=5\\\\f'(2)&=32-24-12+5=1\\end{align*}$$\n\n The gradient at $(2,5)$ is also $1$, so $y=x+3$ is tangent there. Hence $Q(2,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
