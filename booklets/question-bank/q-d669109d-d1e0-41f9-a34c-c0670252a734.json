        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268cff\",\"reason\":\"distinguishes the quartic from its tangent\"}],\"reference\":\"source PDF page 50, question 61 diagram\"}\n\\begin{tikzpicture}[x=12mm,y=5.5mm,>=Stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\clip (-2.05,-0.55) rectangle (3.2,10.35);\n\\draw[black,line width=0.5pt,-{Stealth[length=2mm]}] (-1.9,0)--(2.85,0);\n\\draw[black,line width=0.5pt,-{Stealth[length=2mm]}] (0,-0.3)--(0,9.6);\n\\node[black,right] at (2.85,0) {$x$};\n\\node[black,above] at (0,9.6) {$y$};\n\\draw[curveBlue,line width=0.8pt,{Stealth[length=2mm]}-{Stealth[length=2mm]},domain=-1.72:2.5,samples=140] plot (\\x,{\\x*\\x*\\x*\\x-2*\\x*\\x*\\x-3*\\x*\\x+5*\\x+7});\n\\draw[black,line width=0.8pt,{Stealth[length=2mm]}-{Stealth[length=2mm]}] (-1.8,1.2)--(2.72,5.72);\n\\fill[black] (-1,2) circle[radius=1.1pt];\n\\fill[black] (2,5) circle[radius=1.1pt];\n\\node[black,below left] at (-1,2) {$P$};\n\\node[black,below right] at (2,5) {$Q$};\n\\end{tikzpicture}",
        "src": null,
