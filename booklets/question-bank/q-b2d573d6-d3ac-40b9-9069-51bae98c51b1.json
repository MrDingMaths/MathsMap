  "content": {
    "id": "p20-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Given $g(x)=3x^3-1$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for $g^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p20-q11-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "g^{-1}(x)=\\sqrt[3]{\\frac{x+1}{3}}",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y&=3x^3-1\\\\x&=3y^3-1\\\\y^3&=\\frac{x+1}{3}\\\\y&=\\sqrt[3]{\\frac{x+1}{3}}\\\\g^{-1}(x)&=\\sqrt[3]{\\frac{x+1}{3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p20-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation $g^{-1}(x)=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p20-q11-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x=23",
                    "display": false
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}g(g^{-1}(x))&=g(2)\\\\x&=g(2)\\\\x&=3(2)^3-1\\\\x&=23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
