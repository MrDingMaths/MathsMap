  "content": {
    "id": "p39-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A quantity $Q$ is varying over time $t$ according to the formula $t=20\\log_2(2Q)$. Give non-exact numerical answers correct to four significant figures.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $t$ when $Q=4$, and when $Q=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=60$ and $t\\approx71.70$, respectively.",
          "worked": "When $Q=4$:\n$$\\begin{align*}t&=20\\log_2(2\\times4)\\\\t&=20\\times3\\\\t&=60\\end{align*}$$\nWhen $Q=6$:\n$$\\begin{align*}t&=20\\log_2(2\\times6)\\\\t&=\\frac{20\\log_{10}12}{\\log_{10}2}\\\\t&\\approx71.70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p39-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Rewrite the formula with $Q$ as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q=\\frac12\\times2^{t/20}$.",
          "worked": "$$\\begin{align*}\\frac{t}{20}&=\\log_2(2Q)\\\\2Q&=2^{t/20}\\\\Q&=\\frac12\\times2^{t/20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $Q$ when $t=40$, and when $t=45$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q=2$ and $Q\\approx2.378$, respectively.",
          "worked": "When $t=40$:\n$$\\begin{align*}Q&=\\frac12\\times2^{40/20}\\\\Q&=2\\end{align*}$$\nWhen $t=45$:\n$$\\begin{align*}Q&=\\frac12\\times2^{45/20}\\\\Q&\\approx2.378\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
