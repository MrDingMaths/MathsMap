    "type": "question",
    "label": "7",
    "prompt": "Daniel has 6 boxes of chocolates, each containing 20 chocolates, and he also has 54 loose chocolates. How many chocolates does he have altogether?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "174 chocolates",
      "worked": "$$\\begin{align*}6\\times20+54&=120+54\\\\6\\times20+54&=174\\end{align*}$$\nDaniel has 174 chocolates altogether.",
