  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Suppose that $\\tan 2\\theta=\\frac14$. Find the possible values of $\\tan\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\tan\\theta=-4\\pm\\sqrt{17}$.",
      "worked": "Let $t=\\tan\\theta$. Using the double-angle formula,\n$$\\begin{align*}\\frac{2t}{1-t^2}&=\\frac14\\\\8t&=1-t^2\\\\t^2+8t-1&=0\\\\t&=\\frac{-8\\pm\\sqrt{8^2-4(1)(-1)}}{2}\\\\t&=-4\\pm\\sqrt{17}.\\end{align*}$$\nHence $\\tan\\theta=-4+\\sqrt{17}$ or $\\tan\\theta=-4-\\sqrt{17}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
