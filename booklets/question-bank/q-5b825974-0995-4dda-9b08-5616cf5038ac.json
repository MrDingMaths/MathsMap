  "content": {
    "id": "p36-q33-root",
    "type": "question",
    "label": "33",
    "prompt": "A geometric series has limiting sum $40$ and its first term is $5$.\nFind the common ratio of the series.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$r=\\frac{7}{8}$",
      "worked": "$S_\\infty=40,\\quad a=5$\n$$\\begin{aligned}S_\\infty&=\\frac{a}{1-r}\\\\40&=\\frac{5}{1-r}\\\\40(1-r)&=5\\\\40-40r&=5\\\\35&=40r\\\\\\therefore\\ r&=\\frac{7}{8}\\end{aligned}$$",
      "solutionDiagrams": []
    },
