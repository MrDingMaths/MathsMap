  "content": {
    "id": "p52-boundary-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Use the supplied resident tax rates for 2022–23. Round tax payable to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-boundary-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the tax payable on a taxable income of \\$44 999.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$5091.81",
          "worked": "$$\\begin{align*}\\text{Tax payable}&=0.19\\times(44\\,999-18\\,200)\\\\&=\\$5091.81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p52-boundary-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the tax payable on a taxable income of \\$45 000.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$5092.00",
          "worked": "$$\\begin{align*}\\text{Tax payable}&=0.19\\times(45\\,000-18\\,200)\\\\&=\\$5092.00\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p52-boundary-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the tax payable on a taxable income of \\$45 001.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$5092.33",
          "worked": "$$\\begin{align*}\\text{Tax payable}&=5092+0.325\\times(45\\,001-45\\,000)\\\\&=5092.325\\\\&\\approx\\$5092.33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p52-boundary-d",
        "type": "part",
        "label": "d",
        "prompt": "Using your rounded tax amounts, how much did tax payable increase between \\$44 999 and \\$45 000?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$0.19",
          "worked": "$$\\begin{align*}5092.00-5091.81&=\\$0.19\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p52-boundary-e",
        "type": "part",
        "label": "e",
        "prompt": "Using your rounded tax amounts, how much did tax payable increase between \\$45 000 and \\$45 001?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$0.33",
          "worked": "$$\\begin{align*}5092.33-5092.00&=\\$0.33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
