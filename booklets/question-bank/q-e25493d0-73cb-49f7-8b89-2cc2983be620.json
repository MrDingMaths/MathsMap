    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Suppose that\n$$\\begin{aligned}\\Pr(A)&=\\frac13,\\\\\\Pr(B)&=\\frac12,\\\\\\Pr(A\\cap B)&=\\frac16.\\end{aligned}$$\nFind $\\Pr(A\\cup B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A\\cap B)\\\\\\Pr(A\\cup B)&=\\frac13+\\frac12-\\frac16\\\\\\Pr(A\\cup B)&=\\frac23.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose that\n$$\\begin{aligned}\\Pr(A)&=\\frac14,\\\\\\Pr(A\\cup B)&=\\frac13,\\\\\\Pr(A\\cap B)&=\\frac15.\\end{aligned}$$\nFind $\\Pr(B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{60}$",
          "worked": "Rearrange the addition law.\n$$\\begin{align*}\\Pr(B)&=\\Pr(A\\cup B)-\\Pr(A)+\\Pr(A\\cap B)\\\\\\Pr(B)&=\\frac13-\\frac14+\\frac15\\\\\\Pr(B)&=\\frac{17}{60}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p10-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "Suppose that\n$$\\begin{aligned}\\Pr(A)&=\\frac13,\\\\\\Pr(B)&=\\frac12,\\\\\\Pr(A\\cup B)&=\\frac23.\\end{aligned}$$\nFind $\\Pr(A\\cap B)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac16$",
          "worked": "Rearrange the addition law.\n$$\\begin{align*}\\Pr(A\\cap B)&=\\Pr(A)+\\Pr(B)-\\Pr(A\\cup B)\\\\\\Pr(A\\cap B)&=\\frac13+\\frac12-\\frac23\\\\\\Pr(A\\cap B)&=\\frac16.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
