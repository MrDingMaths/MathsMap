    "children": [
      {
        "id": "p80-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find its equation in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2(x+2)^2-7$",
          "worked": "Since the axis is $x=-2$, write $y=a(x+2)^2+k$.\n\nUsing $(-5,11)$ and $(0,1)$ gives\n$$\\begin{align*}9a+k&=11\\\\4a+k&=1\\end{align*}$$\nSubtracting,\n$$\\begin{align*}5a&=10\\\\a&=2\\end{align*}$$\nSubstitute $a=2$:\n$$\\begin{align*}4(2)+k&=1\\\\k&=-7\\\\y&=2(x+2)^2-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p80-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Express the equation in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2x^2+8x+1$",
          "worked": "Expanding,\n$$\\begin{align*}y&=2(x^2+4x+4)-7\\\\y&=2x^2+8x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p80-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the vertex.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,-7)$",
          "worked": "From $y=2(x+2)^2-7$, the vertex is $(-2,-7)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p80-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the $x$-intercepts exactly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(-2-\\dfrac{\\sqrt{14}}{2},0\\right)$ and $\\left(-2+\\dfrac{\\sqrt{14}}{2},0\\right)$",
          "worked": "Set $y=0$:\n$$\\begin{align*}2(x+2)^2-7&=0\\\\(x+2)^2&=\\frac{7}{2}\\\\x&=-2\\pm\\sqrt{\\frac{7}{2}}\\\\x&=-2\\pm\\frac{\\sqrt{14}}{2}\\end{align*}$$\nThe $x$-intercepts are $\\left(-2-\\frac{\\sqrt{14}}{2},0\\right)$ and $\\left(-2+\\frac{\\sqrt{14}}{2},0\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
