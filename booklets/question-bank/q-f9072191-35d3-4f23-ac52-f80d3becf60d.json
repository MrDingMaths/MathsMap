  "content": {
    "id": "p36-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Kim throws 8 dice. Find the probability that she throws:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "2 sixes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{109375}{419904}$",
          "worked": "Let $X$ be the number of sixes. Then $X\\sim\\operatorname{Bin}(8,\\frac16)$.\n$$\\begin{aligned}P(X=2)&=\\binom82\\left(\\frac16\\right)^2\\left(\\frac56\\right)^6\\\\P(X=2)&=\\frac{109375}{419904}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p36-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "5 sixes",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
