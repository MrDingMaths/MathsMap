  "content": {
    "id": "v2-7e076f-p9-practice-slot-5-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Determine the gradient and $y$-intercept of these lines.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7e076f-p9-practice-slot-5-upper-s5u-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(3x-y)=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=3,\\ c=-\\frac52$",
          "worked": "$$\\begin{align*}3x-y&=\\frac52\\\\-y&=-3x+\\frac52\\\\y&=3x-\\frac52\\end{align*}$$\n$m=3,\\ c=-\\frac52$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-7e076f-p9-practice-slot-5-upper-s5u-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{y}{3}+\\dfrac{x}{2}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac32,\\ c=3$",
          "worked": "$$\\begin{align*}\\frac{y}{3}&=1-\\frac{x}{2}\\\\y&=3-\\frac{3x}{2}\\\\y&=-\\frac32x+3\\end{align*}$$\n$m=-\\frac32,\\ c=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-7e076f-p9-practice-slot-5-upper-s5u-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$4x-3y+6=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac43,\\ c=2$",
          "worked": "$$\\begin{align*}-3y&=-4x-6\\\\y&=\\frac43x+2\\end{align*}$$\n$m=\\frac43,\\ c=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-7e076f-p9-practice-slot-5-upper-s5u-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$5(2y+1)=3x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{3}{10},\\ c=-\\frac65$",
          "worked": "$$\\begin{align*}10y+5&=3x-7\\\\10y&=3x-12\\\\y&=\\frac{3}{10}x-\\frac65\\end{align*}$$\n$m=\\frac{3}{10},\\ c=-\\frac65$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
