    "type": "question",
    "label": "18",
    "prompt": "Explain why a number divisible by 2 and 3 must also be divisible by 6.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The lowest common multiple of $2$ and $3$ is $6$.",
      "worked": "A number divisible by both $2$ and $3$ is a common multiple of them. Their lowest common multiple is $6$, so every common multiple is divisible by $6$.",
