        "id": "p34-part-e",
        "type": "part",
        "label": "e",
        "prompt": "$3^{2n}+7$ is divisible by $8$ for all integers $n\\geq1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
