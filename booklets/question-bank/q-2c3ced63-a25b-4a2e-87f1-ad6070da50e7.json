      {
        "id": "p27-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "How many axes of symmetry does this polygon have, and what is its order of rotational symmetry?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "12 axes of symmetry; rotational symmetry of order 12.",
          "worked": "There are six axes through pairs of opposite vertices and six through midpoints of opposite sides, giving 12 axes. The smallest rotation carrying the polygon onto itself is $360^\\circ\\div12=30^\\circ$, so its rotational symmetry has order 12.",
