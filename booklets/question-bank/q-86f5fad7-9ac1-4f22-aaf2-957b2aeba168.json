  "content": {
    "id": "p6-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "On a particular road map, a distance of $0.5$ cm on the map represents an actual distance of $10$ km. What actual distance would a distance of $6.5$ cm on the map represent?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$130\\text{ km}$",
      "worked": "Let $d$ be the actual distance in kilometres and $m$ the map distance in centimetres. Since $d\\propto m$, $d=km$ for a constant $k$.\n$$\\begin{align*}10&=k\\times0.5\\\\k&=20\\\\d&=20m\\end{align*}$$\nWhen $m=6.5$:\n$$\\begin{align*}d&=20\\times6.5\\\\d&=130\\text{ km}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
