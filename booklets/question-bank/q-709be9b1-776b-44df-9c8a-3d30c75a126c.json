      {
        "id": "p16-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sqrt{3}-1}{2-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{3}+1$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}-1}{2-\\sqrt{3}}&=\\frac{(\\sqrt{3}-1)(2+\\sqrt{3})}{(2-\\sqrt{3})(2+\\sqrt{3})}\\\\\\frac{\\sqrt{3}-1}{2-\\sqrt{3}}&=\\frac{2\\sqrt{3}+3-2-\\sqrt{3}}{4-3}\\\\\\frac{\\sqrt{3}-1}{2-\\sqrt{3}}&=\\sqrt{3}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p16-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2\\sqrt{5}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4-\\sqrt{10}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{5}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}&=\\frac{(2\\sqrt{5}-\\sqrt{2})(\\sqrt{5}-\\sqrt{2})}{(\\sqrt{5}+\\sqrt{2})(\\sqrt{5}-\\sqrt{2})}\\\\\\frac{2\\sqrt{5}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}&=\\frac{10-2\\sqrt{10}-\\sqrt{10}+2}{5-2}\\\\\\frac{2\\sqrt{5}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}&=\\frac{12-3\\sqrt{10}}{3}\\\\\\frac{2\\sqrt{5}-\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}&=4-\\sqrt{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
