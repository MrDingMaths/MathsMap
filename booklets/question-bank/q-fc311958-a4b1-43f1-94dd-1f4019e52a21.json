        "children": [],
        "answer": {
          "short": "$23$",
          "worked": "$$\\begin{align*}(3\\sqrt3-2)(3\\sqrt3+2)&=(3\\sqrt3)^2-2^2\\\\(3\\sqrt3-2)(3\\sqrt3+2)&=27-4\\\\(3\\sqrt3-2)(3\\sqrt3+2)&=23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$(2\\sqrt5+3\\sqrt2)(2\\sqrt5-3\\sqrt2)$",
