        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}(2\\sqrt5+3\\sqrt2)(2\\sqrt5-3\\sqrt2)&=(2\\sqrt5)^2-(3\\sqrt2)^2\\\\(2\\sqrt5+3\\sqrt2)(2\\sqrt5-3\\sqrt2)&=20-18\\\\(2\\sqrt5+3\\sqrt2)(2\\sqrt5-3\\sqrt2)&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
