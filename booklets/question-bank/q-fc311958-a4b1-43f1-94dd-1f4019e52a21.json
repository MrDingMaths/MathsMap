        "answer": {
          "short": "$17$",
          "worked": "$$\\begin{align*}(3\\sqrt2+1)(3\\sqrt2-1)&=(3\\sqrt2)^2-1^2\\\\(3\\sqrt2+1)(3\\sqrt2-1)&=18-1\\\\(3\\sqrt2+1)(3\\sqrt2-1)&=17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$(3\\sqrt3-2)(3\\sqrt3+2)$",
        "layout": "list",
        "columns": null,
