    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sqrt2+3)(\\sqrt2-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "$$\\begin{align*}(\\sqrt2+3)(\\sqrt2-3)&=(\\sqrt2)^2-3^2\\\\(\\sqrt2+3)(\\sqrt2-3)&=2-9\\\\(\\sqrt2+3)(\\sqrt2-3)&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\sqrt3+2)(\\sqrt3-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}(\\sqrt3+2)(\\sqrt3-2)&=(\\sqrt3)^2-2^2\\\\(\\sqrt3+2)(\\sqrt3-2)&=3-4\\\\(\\sqrt3+2)(\\sqrt3-2)&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2\\sqrt5+3)(2\\sqrt5-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11$",
          "worked": "$$\\begin{align*}(2\\sqrt5+3)(2\\sqrt5-3)&=(2\\sqrt5)^2-3^2\\\\(2\\sqrt5+3)(2\\sqrt5-3)&=20-9\\\\(2\\sqrt5+3)(2\\sqrt5-3)&=11\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3\\sqrt7-3)(3\\sqrt7+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$54$",
          "worked": "$$\\begin{align*}(3\\sqrt7-3)(3\\sqrt7+3)&=(3\\sqrt7)^2-3^2\\\\(3\\sqrt7-3)(3\\sqrt7+3)&=63-9\\\\(3\\sqrt7-3)(3\\sqrt7+3)&=54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)&=(\\sqrt5)^2-(\\sqrt2)^2\\\\(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)&=5-2\\\\(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\sqrt3-\\sqrt2)(\\sqrt3+\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}(\\sqrt3-\\sqrt2)(\\sqrt3+\\sqrt2)&=(\\sqrt3)^2-(\\sqrt2)^2\\\\(\\sqrt3-\\sqrt2)(\\sqrt3+\\sqrt2)&=3-2\\\\(\\sqrt3-\\sqrt2)(\\sqrt3+\\sqrt2)&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)&=(\\sqrt5)^2-(\\sqrt2)^2\\\\(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)&=5-2\\\\(\\sqrt5+\\sqrt2)(\\sqrt5-\\sqrt2)&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$(\\sqrt8-\\sqrt2)(\\sqrt8+\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}(\\sqrt8-\\sqrt2)(\\sqrt8+\\sqrt2)&=(\\sqrt8)^2-(\\sqrt2)^2\\\\(\\sqrt8-\\sqrt2)(\\sqrt8+\\sqrt2)&=8-2\\\\(\\sqrt8-\\sqrt2)(\\sqrt8+\\sqrt2)&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$(3\\sqrt2+1)(3\\sqrt2-1)$",
        "layout": "list",
