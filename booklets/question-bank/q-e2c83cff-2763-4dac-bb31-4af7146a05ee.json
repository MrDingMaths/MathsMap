  "content": {
    "id": "p35-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If a woman borrows $\\$750$ to buy a television and agrees to pay back $\\$870$ in one year’s time, what annual rate of simple interest is she being charged?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16\\%$ p.a.",
      "worked": "$$\\begin{align*}I&=870-750\\\\I&=120\\end{align*}$$\n\nUsing $I=PRT$ with $P=750$ and $T=1$:\n\n$$\\begin{align*}120&=750\\times R\\times1\\\\R&=\\frac{120}{750}\\\\R&=0.16\\\\R&=16\\%\\end{align*}$$\n\nThe annual rate is $16\\%$ p.a.",
      "solutionDiagrams": []
    },
