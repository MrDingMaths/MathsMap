  "content": {
    "id": "p4-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\log_a w=3$ and $\\log_b w=2$, then find $\\log_{ab}w$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac65$",
          "worked": "From the definition, $a=w^{1/3}$ and $b=w^{1/2}$.\n$$\\begin{align*}ab&=w^{1/3}w^{1/2}\\\\ab&=w^{5/6}\\\\(ab)^{6/5}&=w\\\\\\log_{ab}w&=\\frac65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p4-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\log_a w=4$ and $\\log_{ab}w=5$, then find $\\log_b w$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-20$",
          "worked": "From the definition, $a=w^{1/4}$ and $ab=w^{1/5}$.\n$$\\begin{align*}b&=\\frac{w^{1/5}}{w^{1/4}}\\\\b&=w^{-1/20}\\\\b^{-20}&=w\\\\\\log_b w&=-20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p4-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\log_a w=4$, $\\log_b w=5$ and $\\log_c w=6$, then find $\\log_{abc}w$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{60}{37}$",
          "worked": "From the definition, $a=w^{1/4}$, $b=w^{1/5}$ and $c=w^{1/6}$.\n$$\\begin{align*}abc&=w^{1/4}w^{1/5}w^{1/6}\\\\abc&=w^{37/60}\\\\(abc)^{60/37}&=w\\\\\\log_{abc}w&=\\frac{60}{37}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p4-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "If $\\log_a w=x$ and $\\log_b w=y$, with $w\\ne1$, then prove that $\\log_{ab}w=\\dfrac{xy}{x+y}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{ab}w=\\dfrac{xy}{x+y}$.\n\nWrite $a=w^{1/x}$ and $b=w^{1/y}$, then multiply and use the definition of a logarithm.",
          "worked": "Since $w\\ne1$, $x$ and $y$ are nonzero. From the definition, $a=w^{1/x}$ and $b=w^{1/y}$.\n$$\\begin{align*}ab&=w^{1/x}w^{1/y}\\\\ab&=w^{(x+y)/(xy)}\\\\(ab)^{xy/(x+y)}&=w\\\\\\log_{ab}w&=\\frac{xy}{x+y}\\end{align*}$$\nThe defined base $ab\\ne1$ ensures that $x+y\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
