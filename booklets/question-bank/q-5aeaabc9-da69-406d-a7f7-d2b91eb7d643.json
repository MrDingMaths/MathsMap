            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Add the relative frequencies from left to right. At 65 bpm the cumulative percentage is 40%. At 75 bpm it is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "40\\%+42\\%=82\\%",
                "display": false
              },
              {
                "type": "text",
                "text": ". The middle observations therefore fall at 75 bpm, so the median is 75 bpm.",
                "marks": []
              }
