  "content": {
    "id": "v2-63af3ca26-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Ava and Ben each take one shot at goal in netball.\nAva has a 70% chance of scoring and Ben has a 60% chance of scoring.\nAssume the two shots are independent.\nFind the probability that both shots have the same result.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$54\\%$",
      "worked": "Both shots have the same result when both score or both miss.\n$$\\begin{aligned}P(\\text{both score})&=0.7\\times0.6=0.42\\\\P(\\text{both miss})&=0.3\\times0.4=0.12\\\\P(\\text{same result})&=0.42+0.12\\\\P(\\text{same result})&=0.54=54\\%\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
