    "children": [],
    "answer": {
      "short": "$r=3$",
      "worked": "$a=7$, $a_6=1701$.\n\n$$\\begin{align*}a_6&=ar^5\\\\1701&=7r^5\\\\243&=r^5\\\\r^5&=3^5\\\\\\therefore r&=3\\end{align*}$$",
