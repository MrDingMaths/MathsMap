  "content": {
    "id": "v2-d7528-p52-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Find the values of the pronumerals.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d7528-p52-practice-slot-5-slot-5-a",
        "type": "part",
        "label": "a",
        "prompt": "Given $\\overrightarrow{OC}=\\begin{pmatrix}p\\\\q\\end{pmatrix}$ and $\\overrightarrow{OD}=\\begin{pmatrix}4\\\\-5\\end{pmatrix}$, the vector for $\\overrightarrow{CD}$ is $\\begin{pmatrix}-3\\\\8\\end{pmatrix}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=7,\\ q=-13$.",
          "worked": "$\\begin{aligned}\\overrightarrow{CD}&=\\overrightarrow{OD}-\\overrightarrow{OC}\\\\\\begin{pmatrix}-3\\\\8\\end{pmatrix}&=\\begin{pmatrix}4\\\\-5\\end{pmatrix}-\\begin{pmatrix}p\\\\q\\end{pmatrix}\\\\&=\\begin{pmatrix}4-p\\\\-5-q\\end{pmatrix}\\end{aligned}$\n\nEquating components:\n\n$\\begin{aligned}4-p&=-3\\\\p&=7\\\\-5-q&=8\\\\q&=-13\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-d7528-p52-practice-slot-5-slot-5-b",
        "type": "part",
        "label": "b",
        "prompt": "Given $\\overrightarrow{OE}=\\begin{pmatrix}-4\\\\1\\end{pmatrix}$ and $\\overrightarrow{OF}=\\begin{pmatrix}s\\\\t\\end{pmatrix}$, the vector for $\\overrightarrow{FE}$ is $\\begin{pmatrix}5\\\\-7\\end{pmatrix}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s=-9,\\ t=8$.",
          "worked": "$\\begin{aligned}\\overrightarrow{FE}&=\\overrightarrow{OE}-\\overrightarrow{OF}\\\\\\begin{pmatrix}5\\\\-7\\end{pmatrix}&=\\begin{pmatrix}-4\\\\1\\end{pmatrix}-\\begin{pmatrix}s\\\\t\\end{pmatrix}\\\\&=\\begin{pmatrix}-4-s\\\\1-t\\end{pmatrix}\\end{aligned}$\n\nEquating components:\n\n$\\begin{aligned}-4-s&=5\\\\s&=-9\\\\1-t&=-7\\\\t&=8\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
