  "content": {
    "id": "p59-q5-response",
    "type": "question",
    "label": "5",
    "prompt": "What is the drip rate per minute for 2.6 L of fluid over 6 h with a drip size giving 12 drops/mL?\nAnswer to the nearest whole number of drops.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$87\\text{ drops/min}$",
      "worked": "The three quantities are drops, volume and time.\n$$\\begin{align*}\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{12\\text{ drops}}{1\\text{ mL}}\\times\\frac{2.6\\text{ L}}{6\\text{ h}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{12\\text{ drops}}{1\\text{ mL}}\\times\\frac{2600\\text{ mL}}{360\\text{ min}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{260}{3}\\text{ drops/min}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &\\approx 87\\text{ drops/min}\n\\end{align*}$$\nThe drip rate is $87\\text{ drops/min}$ to the nearest whole number.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
