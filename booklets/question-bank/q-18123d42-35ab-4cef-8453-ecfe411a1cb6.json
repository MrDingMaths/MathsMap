  "content": {
    "id": "p48-q16-answer",
    "type": "question",
    "label": "16",
    "prompt": "One hundred tickets are sold in a raffle which offers two prizes.\nHazel buys five of the tickets.\n\nA ticket is drawn at random for the first prize.\nA second ticket is drawn from the remaining tickets for the other prize.\n\nWhat is the probability that Hazel wins both prizes?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{495}$",
      "worked": "$$\\begin{align*}P(\\text{both prizes})&=\\frac{5}{100}\\times\\frac{4}{99}\\\\&=\\frac{20}{9900}\\\\&=\\frac{1}{495}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
