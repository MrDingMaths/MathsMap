    "type": "question",
    "label": "8",
    "prompt": "Find the present value of money in a bank account if the future value after 4 years earning 9% p.a. compound interest, paid annually, is $\\$5000$. Answer to the nearest dollar.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$3542$",
      "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\5000 &= PV(1+0.09)^4\\\\\\frac{5000}{(1+0.09)^4} &= PV\\\\PV &\\approx \\$3542\\end{align*}$$",
      "solutionDiagrams": []
    },
