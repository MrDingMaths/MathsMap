  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Factorise the following using difference of two squares.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$4x^{2}-25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-5)(2x+5)$",
          "worked": "$\\begin{align*}4x^{2}-25&=(2x)^{2}-5^{2}\\\\&=(2x-5)(2x+5)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$25b^{2}-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5b-2)(5b+2)$",
          "worked": "$\\begin{align*}25b^{2}-4&=(5b)^{2}-2^{2}\\\\&=(5b-2)(5b+2)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$100y^{2}-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(10y-3)(10y+3)$",
          "worked": "$\\begin{align*}100y^{2}-9&=(10y)^{2}-3^{2}\\\\&=(10y-3)(10y+3)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-4x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1-2x)(1+2x)$",
          "worked": "$\\begin{align*}1-4x^{2}&=1^{2}-(2x)^{2}\\\\&=(1-2x)(1+2x)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$16-9y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4-3y)(4+3y)$",
          "worked": "$\\begin{align*}16-9y^{2}&=4^{2}-(3y)^{2}\\\\&=(4-3y)(4+3y)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$4x^{2}-25y^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-5y)(2x+5y)$",
          "worked": "$\\begin{align*}4x^{2}-25y^{2}&=(2x)^{2}-(5y)^{2}\\\\&=(2x-5y)(2x+5y)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$4p^{2}-25q^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2p-5q)(2p+5q)$",
          "worked": "$\\begin{align*}4p^{2}-25q^{2}&=(2p)^{2}-(5q)^{2}\\\\&=(2p-5q)(2p+5q)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$25a^{2}-49b^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5a-7b)(5a+7b)$",
          "worked": "$\\begin{align*}25a^{2}-49b^{2}&=(5a)^{2}-(7b)^{2}\\\\&=(5a-7b)(5a+7b)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$81m^{2}-4n^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(9m-2n)(9m+2n)$",
          "worked": "$\\begin{align*}81m^{2}-4n^{2}&=(9m)^{2}-(2n)^{2}\\\\&=(9m-2n)(9m+2n)\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
