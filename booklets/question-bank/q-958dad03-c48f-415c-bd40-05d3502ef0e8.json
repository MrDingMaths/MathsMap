  "content": {
    "id": "v2-d0ffe-p42-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Each function is a PDF for a continuous random variable. Find a general equation for the $p$th percentile by setting $F(x)=p$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d0ffe-p42-practice-slot-5-slot-5-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{x+2}{16}$, domain $[0,4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\sqrt{1+8p}-2$, where $0\\le p\\le1$.",
          "worked": "$$\\begin{align*}F(x)&=\\int_0^x\\frac{t+2}{16}\\,dt\\\\&=\\frac{x^2+4x}{32}\\end{align*}$$\nSet $F(x)=p$:\n$$\\begin{align*}x^2+4x-32p&=0\\\\(x+2)^2&=4+32p\\\\x+2&=\\pm2\\sqrt{1+8p}\\end{align*}$$\nSince $x\\ge0$, take the positive root: $x=2\\sqrt{1+8p}-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-d0ffe-p42-practice-slot-5-slot-5-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{k}{\\sqrt{x}}$, domain $[1,9]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=(1+2p)^2$, where $0\\le p\\le1$.",
          "worked": "$$\\begin{align*}\\int_1^9kt^{-1/2}\\,dt&=1\\\\k\\left[2\\sqrt t\\right]_1^9&=1\\\\4k&=1\\\\k&=\\frac14\\end{align*}$$\n$$F(x)=\\frac14\\left[2\\sqrt t\\right]_1^x=\\frac{\\sqrt x-1}{2}$$\nSet $F(x)=p$:\n$$\\begin{align*}\\sqrt x-1&=2p\\\\\\sqrt x&=1+2p\\\\x&=(1+2p)^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
