  "content": {
    "id": "p10-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A bag contains three red marbles numbered 1 to 3, five green marbles numbered 4 to 8, and two yellow marbles numbered 9 and 10. A single marble is withdrawn at random. Find the probability that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the marble is numbered 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "There are $3+5+2=10$ equally likely marbles. Only one is numbered 3.\n\n$$P(\\text{numbered }3)=\\frac{1}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the marble is green",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Five of the ten equally likely marbles are green.\n\n$$\\begin{align*}P(\\text{green})&=\\frac{5}{10}\\\\P(\\text{green})&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "the marble is yellow",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "Two of the ten equally likely marbles are yellow.\n\n$$\\begin{align*}P(\\text{yellow})&=\\frac{2}{10}\\\\P(\\text{yellow})&=\\frac{1}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "the number is odd",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The favourable numbers are $1,3,5,7,9$: five of the ten equally likely outcomes.\n\n$$\\begin{align*}P(\\text{odd})&=\\frac{5}{10}\\\\P(\\text{odd})&=\\frac{1}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "the number is greater than 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "The favourable numbers are $7,8,9,10$: four of the ten equally likely outcomes.\n\n$$\\begin{align*}P(\\text{greater than }6)&=\\frac{4}{10}\\\\P(\\text{greater than }6)&=\\frac{2}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q9-f",
        "type": "part",
