      {
        "id": "p62-q8",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{\\cos(\\alpha-\\beta)}{\\sin\\alpha\\cos\\beta}=\\cot\\alpha+\\tan\\beta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Expand $\\cos(\\alpha-\\beta)$ and split the fraction to obtain $\\cot\\alpha+\\tan\\beta$.",
          "worked": "$$\\begin{align*}\\frac{\\cos(\\alpha-\\beta)}{\\sin\\alpha\\cos\\beta}&=\\frac{\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta}{\\sin\\alpha\\cos\\beta}\\\\\\frac{\\cos(\\alpha-\\beta)}{\\sin\\alpha\\cos\\beta}&=\\frac{\\cos\\alpha\\cos\\beta}{\\sin\\alpha\\cos\\beta}+\\frac{\\sin\\alpha\\sin\\beta}{\\sin\\alpha\\cos\\beta}\\\\\\frac{\\cos(\\alpha-\\beta)}{\\sin\\alpha\\cos\\beta}&=\\cot\\alpha+\\tan\\beta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p62-q9",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{\\cos(\\alpha+\\beta)}{\\sin\\alpha\\sin\\beta}=\\cot\\alpha\\cot\\beta-1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Expand $\\cos(\\alpha+\\beta)$ and split the fraction to obtain $\\cot\\alpha\\cot\\beta-1$.",
          "worked": "$$\\begin{align*}\\frac{\\cos(\\alpha+\\beta)}{\\sin\\alpha\\sin\\beta}&=\\frac{\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta}{\\sin\\alpha\\sin\\beta}\\\\\\frac{\\cos(\\alpha+\\beta)}{\\sin\\alpha\\sin\\beta}&=\\frac{\\cos\\alpha\\cos\\beta}{\\sin\\alpha\\sin\\beta}-\\frac{\\sin\\alpha\\sin\\beta}{\\sin\\alpha\\sin\\beta}\\\\\\frac{\\cos(\\alpha+\\beta)}{\\sin\\alpha\\sin\\beta}&=\\cot\\alpha\\cot\\beta-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
