  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The letters in the set $\\{D,O,G\\}$ are placed in a bag. The letters are drawn one at a time from the bag and placed in a row. Find the probability that the letters spell the word DOG.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{6}$",
      "worked": "The six equally likely arrangements are DOG, DGO, ODG, OGD, GDO and GOD. Only DOG is favourable.\n\n$$\\begin{align*}\\Pr(\\text{DOG})&=\\frac{\\text{number of favourable outcomes}}{\\text{total number of outcomes}}\\\\\\Pr(\\text{DOG})&=\\frac{1}{6}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
