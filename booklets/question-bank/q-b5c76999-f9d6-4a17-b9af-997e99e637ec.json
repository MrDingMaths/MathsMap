  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2}{3x}+\\dfrac{5}{x}-\\dfrac{1}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{14}{3x}$",
          "worked": "$\\begin{aligned}\\frac{2}{3x}+\\frac{5}{x}-\\frac{1}{x}&=\\frac{2}{3x}+\\frac{15}{3x}-\\frac{3}{3x}\\\\&=\\frac{2+15-3}{3x}\\\\&=\\frac{14}{3x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$-\\dfrac{1}{2x}+\\dfrac{2}{x}-\\dfrac{4}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{6x}$",
          "worked": "$\\begin{aligned}-\\frac{1}{2x}+\\frac{2}{x}-\\frac{4}{3x}&=-\\frac{3}{6x}+\\frac{12}{6x}-\\frac{8}{6x}\\\\&=\\frac{-3+12-8}{6x}\\\\&=\\frac{1}{6x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\dfrac{4}{5x}-\\dfrac{1}{2x}+\\dfrac{3}{4x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{11}{20x}$",
          "worked": "$\\begin{aligned}-\\frac{4}{5x}-\\frac{1}{2x}+\\frac{3}{4x}&=-\\frac{16}{20x}-\\frac{10}{20x}+\\frac{15}{20x}\\\\&=\\frac{-16-10+15}{20x}\\\\&=-\\frac{11}{20x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p11-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{4}{x^2}+\\dfrac{3}{2x}-\\dfrac{5}{3x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{24-x}{6x^2}$",
          "worked": "$\\begin{aligned}\\frac{4}{x^2}+\\frac{3}{2x}-\\frac{5}{3x}&=\\frac{24}{6x^2}+\\frac{9x}{6x^2}-\\frac{10x}{6x^2}\\\\&=\\frac{24+9x-10x}{6x^2}\\\\&=\\frac{24-x}{6x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{5}{x}-\\dfrac{3}{2x^2}-\\dfrac{5}{7x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{60x-21}{14x^2}$",
          "worked": "$\\begin{aligned}\\frac{5}{x}-\\frac{3}{2x^2}-\\frac{5}{7x}&=\\frac{70x}{14x^2}-\\frac{21}{14x^2}-\\frac{10x}{14x^2}\\\\&=\\frac{70x-21-10x}{14x^2}\\\\&=\\frac{60x-21}{14x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{2}{x^2}-\\dfrac{4}{9x}-\\dfrac{5}{3x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3-4x}{9x^2}$",
          "worked": "$\\begin{aligned}\\frac{2}{x^2}-\\frac{4}{9x}-\\frac{5}{3x^2}&=\\frac{18}{9x^2}-\\frac{4x}{9x^2}-\\frac{15}{9x^2}\\\\&=\\frac{18-4x-15}{9x^2}\\\\&=\\frac{3-4x}{9x^2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{2}{x}+\\dfrac{x}{5}-\\dfrac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{30-2x^2}{15x}$",
          "worked": "$\\begin{aligned}\\frac{2}{x}+\\frac{x}{5}-\\frac{x}{3}&=\\frac{30}{15x}+\\frac{3x^2}{15x}-\\frac{5x^2}{15x}\\\\&=\\frac{30+3x^2-5x^2}{15x}\\\\&=\\frac{30-2x^2}{15x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{3x}{2}-\\dfrac{1}{2x}+\\dfrac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11x^2-3}{6x}$",
          "worked": "$\\begin{aligned}\\frac{3x}{2}-\\frac{1}{2x}+\\frac{x}{3}&=\\frac{9x^2}{6x}-\\frac{3}{6x}+\\frac{2x^2}{6x}\\\\&=\\frac{9x^2-3+2x^2}{6x}\\\\&=\\frac{11x^2-3}{6x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$-\\dfrac{4x}{9}+\\dfrac{2}{5x}+\\dfrac{2x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{18-2x^2}{45x}$",
          "worked": "$\\begin{aligned}-\\frac{4x}{9}+\\frac{2}{5x}+\\frac{2x}{5}&=-\\frac{20x^2}{45x}+\\frac{18}{45x}+\\frac{18x^2}{45x}\\\\&=\\frac{-20x^2+18+18x^2}{45x}\\\\&=\\frac{18-2x^2}{45x}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
