    "questionDiagrams": [],
    "children": [
      {
        "id": "sum-product-b2-1-root",
        "type": "part",
        "label": "a",
        "prompt": "If $\\alpha,\\beta,$ and $\\gamma$ are the roots of $x^3+3x^2-6x-8=0$, find $(\\alpha\\beta)^{-2}+(\\alpha\\gamma)^{-2}+(\\beta\\gamma)^{-2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{21}{64}$",
          "worked": "$\\alpha+\\beta+\\gamma=-\\dfrac31=-3$, $\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma=\\dfrac{-6}{1}=-6$, $\\alpha\\beta\\gamma=-\\dfrac{-8}{1}=8$\n$$\\begin{aligned}(\\alpha\\beta)^{-2}+(\\alpha\\gamma)^{-2}+(\\beta\\gamma)^{-2}&=\\frac{\\gamma^2+\\beta^2+\\alpha^2}{(\\alpha\\beta\\gamma)^2}\\\\&=\\frac{(\\alpha+\\beta+\\gamma)^2-2(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)}{8^2}\\\\&=\\frac{(-3)^2-2(-6)}{64}\\\\&=\\frac{21}{64}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "sum-product-b2-2-root",
        "type": "part",
        "label": "b",
        "prompt": "If $\\alpha,\\beta,$ and $\\gamma$ are the roots of $2x^3-5x^2-4x+3=0$, find $(\\alpha\\beta)^{-2}+(\\alpha\\gamma)^{-2}+(\\beta\\gamma)^{-2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{41}{9}$",
          "worked": "$\\alpha+\\beta+\\gamma=-\\dfrac{-5}{2}=\\dfrac52$, $\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma=\\dfrac{-4}{2}=-2$, $\\alpha\\beta\\gamma=-\\dfrac32$\n$$\\begin{aligned}(\\alpha\\beta)^{-2}+(\\alpha\\gamma)^{-2}+(\\beta\\gamma)^{-2}&=\\frac{\\gamma^2+\\beta^2+\\alpha^2}{(\\alpha\\beta\\gamma)^2}\\\\&=\\frac{(\\alpha+\\beta+\\gamma)^2-2(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)}{\\left(-\\frac32\\right)^2}\\\\&=\\frac{\\frac{25}{4}+4}{\\frac94}\\\\&=\\frac{41}{4}\\times\\frac49\\\\&=\\frac{41}{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
