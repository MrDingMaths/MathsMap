  "content": {
    "id": "p40-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Consider two tangent circles of radius $a$ and $b$ (where $a>b$), as shown in the diagram below.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p40-q16-diagram1",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 40, p40-q16-diagram1\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\pgfmathsetmacro{\\t}{acos(1/3)}\n\\coordinate (O) at (0,0);\n\\coordinate (P) at (3,0);\n\\coordinate (A) at ({2*cos(\\t)},{2*sin(\\t)});\n\\coordinate (B) at ({3+cos(\\t)},{sin(\\t)});\n\\coordinate (D) at ({2*cos(\\t)},{-2*sin(\\t)});\n\\coordinate (E) at ({3+cos(\\t)},{-sin(\\t)});\n\\draw[black,line width=0.4pt] (O) circle (2) (P) circle (1);\n\\draw[black] (A) arc[start angle=\\t,end angle={360-\\t},radius=2] -- (E) arc[start angle={-\\t},end angle=\\t,radius=1] -- cycle;\n\\draw[black,line width=0.4pt] (O)--(P) (O)--(A) node[midway,right] {$a$} (P)--(B) node[midway,right] {$b$};\n\\end{tikzpicture}",
