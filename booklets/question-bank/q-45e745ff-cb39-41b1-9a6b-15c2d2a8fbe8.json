    "answer": {
      "short": "$40\\,400$",
      "worked": "$$\\begin{align*}S_{100}&=\\frac{100}{2}(8+800)\\\\S_{100}&=50\\times808\\\\S_{100}&=40\\,400.\\end{align*}$$",
