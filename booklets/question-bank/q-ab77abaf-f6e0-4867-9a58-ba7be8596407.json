  "content": {
    "id": "p15-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A cone with radius 5 cm has a curved surface area of $400\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the slant height of the cone, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25.5\\text{ cm}$",
          "worked": "$\\begin{align*}\\pi rl &= 400\\\\l &= \\frac{400}{5\\pi}=\\frac{80}{\\pi}\\\\l &\\approx 25.5\\text{ cm}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the height of the cone, correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25.0\\text{ cm}$",
          "worked": "By Pythagoras, using the unrounded slant height:\n$$\\begin{align*}h^2 &= l^2-r^2\\\\h &= \\sqrt{\\left(\\frac{80}{\\pi}\\right)^2-5^2}\\\\h &\\approx 25.0\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
