  "content": {
    "id": "p3-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Draw a right-angled triangle with angle $\\theta$ for which $\\cos\\theta=\\frac23$. Find $\\tan\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\tan\\theta=\\frac{\\sqrt5}{2}$",
      "worked": "Choose adjacent side $2$ and hypotenuse $3$. Let $x$ be the opposite side.\n$$\\begin{align*}x^2+2^2&=3^2\\\\x^2&=5\\\\x&=\\sqrt5\\\\\\tan\\theta&=\\frac{\\sqrt5}{2}\\end{align*}$$",
