        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 55, p55-q3-unit-circle\"}\n\\begin{tikzpicture}[x=1.5cm,y=1.5cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-1.85,-1.4) rectangle (1.75,1.5);\n\\draw[black,line width=0.8pt] (0,0) circle[radius=1];\n\\draw[black,->,line width=0.5pt] (-1.7,0)--(1.65,0) node[below] {$x$};\n\\draw[black,->,line width=0.5pt] (0,-1.3)--(0,1.45) node[left] {$y$};\n\\fill[black] (1,0) circle[radius=1.6pt];\n\\fill[black] (0,1) circle[radius=1.6pt];\n\\fill[black] (-1,0) circle[radius=1.6pt];\n\\fill[black] (0,-1) circle[radius=1.6pt];\n\\node[black,above right] at (1,0) {$(1,0)$};\n\\node[black,above left] at (0,1) {$(0,1)$};\n\\node[black,above left] at (-1,0) {$(-1,0)$};\n\\node[black,below right] at (0,-1) {$(0,-1)$};\n\\end{tikzpicture}",
