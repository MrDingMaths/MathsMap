      {
        "id": "p71-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Differentiate $x\\ln x-x$, and hence find $\\displaystyle\\int\\ln x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d}{dx}(x\\ln x-x)=\\ln x$; $\\displaystyle\\int\\ln x\\,dx=x\\ln x-x+C$.",
          "worked": "$$\\begin{align*}\\frac{d}{dx}(x\\ln x-x)&=\\ln x+x\\left(\\frac1x\\right)-1\\\\&=\\ln x+1-1\\\\&=\\ln x\\end{align*}$$\nHence\n$$\\int\\ln x\\,dx=x\\ln x-x+C.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p71-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the change-of-base formula and part a to evaluate $\\displaystyle\\int_1^{10}\\log_{10}x\\,dx$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10-\\dfrac9{\\ln10}$",
          "worked": "$$\\log_{10}x=\\frac{\\ln x}{\\ln10}.$$\n$$\\begin{align*}\\int_1^{10}\\log_{10}x\\,dx&=\\frac1{\\ln10}[x\\ln x-x]_1^{10}\\\\&=\\frac1{\\ln10}[(10\\ln10-10)-(0-1)]\\\\&=\\frac{10\\ln10-9}{\\ln10}\\\\&=10-\\frac9{\\ln10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
