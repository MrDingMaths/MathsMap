    "id": "p57-q29-root",
    "type": "question",
    "label": "29",
    "prompt": "Find any stationary points and inflections of the curve $y=2\\sin x+x$ in the interval $0\\le x\\le2\\pi$, then sketch the curve.",
    "layout": "list",
