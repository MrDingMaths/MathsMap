            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}-2\\sin x&=0\\\\x&=0,\\pi,2\\pi\\\\y(\\pi)&=\\pi\\end{aligned}",
                "display": true
              },
              {
                "type": "text",
                "text": "For ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0<x<\\pi",
                "display": false
              },
              {
                "type": "text",
                "text": ", ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y''<0",
                "display": false
              },
              {
                "type": "text",
                "text": " and the curve is concave down. For ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\pi<x<2\\pi",
                "display": false
              },
              {
                "type": "text",
                "text": ", ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "y''>0",
                "display": false
              },
              {
                "type": "text",
                "text": " and the curve is concave up. Thus the point of inflection is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(\\pi,\\pi)",
                "display": false
              },
              {
                "type": "text",
                "text": ". The endpoints are not inflection points on this restricted domain.",
                "marks": []
              }
