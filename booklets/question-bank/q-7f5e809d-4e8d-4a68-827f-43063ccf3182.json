    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "What profit is made if the store owner sells 60 CDs?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$150$",
          "worked": "$$\\begin{align*}P&=5\\times60-150\\\\P&=300-150\\\\P&=150\\end{align*}$$\nThe profit is $\\$150$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Make $n$ the subject of the formula.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=\\dfrac{P+150}{5}$",
          "worked": "$$\\begin{align*}P&=5n-150\\\\P+150&=5n\\\\n&=\\frac{P+150}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q1-c",
        "type": "group",
        "label": "c",
        "prompt": "How many CDs were sold if the store made:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q1-c-i",
            "type": "part",
            "label": "i",
            "prompt": "a profit of $\\$275$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "85 CDs",
              "worked": "When $P=275$,\n$$\\begin{align*}n&=\\frac{275+150}{5}\\\\n&=\\frac{425}{5}\\\\n&=85\\end{align*}$$\n85 CDs were sold.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p11-q1-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "a profit of $\\$400$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "110 CDs",
              "worked": "When $P=400$,\n$$\\begin{align*}n&=\\frac{400+150}{5}\\\\n&=\\frac{550}{5}\\\\n&=110\\end{align*}$$\n110 CDs were sold.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p11-q1-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "a loss of $\\$100$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "10 CDs",
              "worked": "A loss of $\\$100$ means $P=-100$.\n$$\\begin{align*}n&=\\frac{-100+150}{5}\\\\n&=\\frac{50}{5}\\\\n&=10\\end{align*}$$\n10 CDs were sold.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p11-q1-c-iv",
            "type": "part",
            "label": "iv",
            "prompt": "no profit?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "30 CDs",
              "worked": "No profit means $P=0$.\n$$\\begin{align*}n&=\\frac{0+150}{5}\\\\n&=\\frac{150}{5}\\\\n&=30\\end{align*}$$\n30 CDs were sold.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          }
        ]
      }
    ]
