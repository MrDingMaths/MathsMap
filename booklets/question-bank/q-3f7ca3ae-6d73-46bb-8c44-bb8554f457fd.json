  "content": {
    "id": "v2-498a3-p21-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "The continuous PDF is defined by $f(x)=k(x+2)$ in the domain $[0,4]$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-498a3-p21-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac{1}{16}$",
          "worked": "$$\\begin{align*}\\int_0^4 k(x+2)\\,dx&=1\\\\k\\left[\\frac{x^2}{2}+2x\\right]_0^4&=1\\\\16k&=1\\\\k&=\\frac{1}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-498a3-p21-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $P(X\\le 2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{8}$",
          "worked": "$$\\begin{align*}P(X\\le2)&=\\int_0^2\\frac{x+2}{16}\\,dx\\\\&=\\frac{1}{16}\\left[\\frac{x^2}{2}+2x\\right]_0^2\\\\&=\\frac{6}{16}\\\\&=\\frac{3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-498a3-p21-practice-slot-3-slot-3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $P(X>3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{11}{32}$",
          "worked": "$$\\begin{align*}P(X>3)&=\\int_3^4\\frac{x+2}{16}\\,dx\\\\&=\\frac{1}{16}\\left[\\frac{x^2}{2}+2x\\right]_3^4\\\\&=\\frac{16-10.5}{16}\\\\&=\\frac{11}{32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
