    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^3\\frac{1}{\\sqrt{9-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac\\pi2$",
          "worked": "$$\\begin{aligned}\\int_0^3\\frac{1}{\\sqrt{9-x^2}}\\,dx&=\\int_0^3\\frac{\\frac13}{\\sqrt{1-(x/3)^2}}\\,dx\\\\&=\\left[\\sin^{-1}\\left(\\frac{x}{3}\\right)\\right]_0^3\\\\&=\\sin^{-1}(1)-\\sin^{-1}(0)\\\\&=\\frac\\pi2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^2\\frac{1}{4+x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac\\pi8$",
          "worked": "$$\\begin{aligned}\\int_0^2\\frac{1}{4+x^2}\\,dx&=\\frac12\\int_0^2\\frac{\\frac12}{1+(x/2)^2}\\,dx\\\\&=\\frac12\\left[\\tan^{-1}\\left(\\frac{x}{2}\\right)\\right]_0^2\\\\&=\\frac12\\left(\\frac\\pi4-0\\right)\\\\&=\\frac\\pi8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_0^1\\frac{1}{\\sqrt{2-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac\\pi4$",
          "worked": "$$\\begin{aligned}\\int_0^1\\frac{1}{\\sqrt{2-x^2}}\\,dx&=\\int_0^1\\frac{\\frac1{\\sqrt2}}{\\sqrt{1-(x/\\sqrt2)^2}}\\,dx\\\\&=\\left[\\sin^{-1}\\left(\\frac{x}{\\sqrt2}\\right)\\right]_0^1\\\\&=\\sin^{-1}\\left(\\frac1{\\sqrt2}\\right)-0\\\\&=\\frac\\pi4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{1/2}^{\\sqrt3/2}\\frac{\\frac12}{\\frac14+x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac\\pi{12}$",
          "worked": "$$\\begin{aligned}\\int_{1/2}^{\\sqrt3/2}\\frac{\\frac12}{\\frac14+x^2}\\,dx&=\\int_{1/2}^{\\sqrt3/2}\\frac{2}{1+(2x)^2}\\,dx\\\\&=\\left[\\tan^{-1}(2x)\\right]_{1/2}^{\\sqrt3/2}\\\\&=\\frac\\pi3-\\frac\\pi4\\\\&=\\frac\\pi{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p24-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_{\\sqrt3/6}^{1/6}\\frac{-1}{\\sqrt{\\frac19-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac\\pi6$",
          "worked": "$$\\begin{aligned}\\int_{\\sqrt3/6}^{1/6}\\frac{-1}{\\sqrt{\\frac19-x^2}}\\,dx&=\\int_{\\sqrt3/6}^{1/6}\\frac{-3}{\\sqrt{1-(3x)^2}}\\,dx\\\\&=\\left[\\cos^{-1}(3x)\\right]_{\\sqrt3/6}^{1/6}\\\\&=\\cos^{-1}\\left(\\frac12\\right)-\\cos^{-1}\\left(\\frac{\\sqrt3}{2}\\right)\\\\&=\\frac\\pi3-\\frac\\pi6\\\\&=\\frac\\pi6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p24-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-3\\sqrt2/4}^{3/4}\\frac{1}{\\sqrt{\\frac94-x^2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5\\pi}{12}$",
          "worked": "$$\\begin{aligned}\\int_{-3\\sqrt2/4}^{3/4}\\frac{1}{\\sqrt{\\frac94-x^2}}\\,dx&=\\int_{-3\\sqrt2/4}^{3/4}\\frac{\\frac23}{\\sqrt{1-(2x/3)^2}}\\,dx\\\\&=\\left[\\sin^{-1}\\left(\\frac{2x}{3}\\right)\\right]_{-3\\sqrt2/4}^{3/4}\\\\&=\\sin^{-1}\\left(\\frac12\\right)-\\sin^{-1}\\left(-\\frac{\\sqrt2}{2}\\right)\\\\&=\\frac\\pi6+\\frac\\pi4\\\\&=\\frac{5\\pi}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
