  "content": {
    "id": "p31-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A tank in the form of a rectangular prism has base dimensions $2.5\\text{ m}$ by $1.5\\text{ m}$ and holds water to a depth of $3\\text{ m}$. If the depth is increased by $2\\text{ m}$, what is the increase in the volume of the water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$7.5\\text{ m}^3$",
      "worked": "The additional water forms a rectangular prism with the same base and height $2\\text{ m}$.\n\n$$\\begin{align*}A&=2.5\\times1.5\\\\A&=3.75\\text{ m}^2\\\\\\text{Increase in volume}&=3.75\\times2\\\\\\text{Increase in volume}&=7.5\\text{ m}^3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
