  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Expand each of the following by inserting extra brackets where necessary:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+y+1)(x+y-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2xy+y^2-1$",
          "worked": "$$\\begin{align*}(x+y+1)(x+y-1)&=[(x+y)+1][(x+y)-1]\\\\(x+y+1)(x+y-1)&=(x+y)^2-1^2\\\\(x+y+1)(x+y-1)&=x^2+2xy+y^2-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(a+b+c)(a+b-c)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2+2ab+b^2-c^2$",
          "worked": "$$\\begin{align*}(a+b+c)(a+b-c)&=[(a+b)+c][(a+b)-c]\\\\(a+b+c)(a+b-c)&=(a+b)^2-c^2\\\\(a+b+c)(a+b-c)&=a^2+2ab+b^2-c^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x+3y+4z)(2x+3y-4z)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+12xy+9y^2-16z^2$",
          "worked": "$$\\begin{align*}(2x+3y+4z)(2x+3y-4z)&=[(2x+3y)+4z][(2x+3y)-4z]\\\\(2x+3y+4z)(2x+3y-4z)&=(2x+3y)^2-(4z)^2\\\\(2x+3y+4z)(2x+3y-4z)&=4x^2+12xy+9y^2-16z^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x+y+1)(x-y-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-y^2-2y-1$",
          "worked": "$$\\begin{align*}(x+y+1)(x-y-1)&=[x+(y+1)][x-(y+1)]\\\\(x+y+1)(x-y-1)&=x^2-(y+1)^2\\\\(x+y+1)(x-y-1)&=x^2-y^2-2y-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$(a+b+c)(a-b-c)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-b^2-2bc-c^2$",
          "worked": "$$\\begin{align*}(a+b+c)(a-b-c)&=[a+(b+c)][a-(b+c)]\\\\(a+b+c)(a-b-c)&=a^2-(b+c)^2\\\\(a+b+c)(a-b-c)&=a^2-b^2-2bc-c^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$(2x+3y+4z)(2x-3y-4z)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-9y^2-24yz-16z^2$",
          "worked": "$$\\begin{align*}(2x+3y+4z)(2x-3y-4z)&=[2x+(3y+4z)][2x-(3y+4z)]\\\\(2x+3y+4z)(2x-3y-4z)&=(2x)^2-(3y+4z)^2\\\\(2x+3y+4z)(2x-3y-4z)&=4x^2-(9y^2+24yz+16z^2)\\\\(2x+3y+4z)(2x-3y-4z)&=4x^2-9y^2-24yz-16z^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
