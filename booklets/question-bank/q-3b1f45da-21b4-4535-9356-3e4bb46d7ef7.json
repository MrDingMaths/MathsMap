  "content": {
    "id": "p64-q30-node",
    "type": "question",
    "label": "30",
    "prompt": "A sector of radius $r$ and angle $\\theta$ radians, where $0<\\theta<2\\pi$, has fixed perimeter $P$. Show that\n$$\\frac{P}{2(\\pi+1)}<r<\\frac{P}{2}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
