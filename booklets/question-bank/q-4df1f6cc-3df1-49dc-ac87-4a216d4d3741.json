    "children": [
      {
        "id": "p11-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Find a formula for the perimeter, $P$, of the hexagon in terms of $a$ and $b$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p11-q9-hexagon",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 11, p11-q9-hexagon\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0.55,1.98);\n\\coordinate (B) at (2.20,1.98);\n\\coordinate (C) at (2.75,1.38);\n\\coordinate (D) at (1.92,0.02);\n\\coordinate (E) at (0.84,0.02);\n\\coordinate (F) at (0,1.38);\n\\draw[black,line width=0.8pt] (A) -- node[midway,above] {$a$} (B) -- node[midway,above right] {$b$} (C) -- node[midway,below right] {$a$} (D) -- node[midway,below] {$b$} (E) -- node[midway,below left] {$a$} (F) -- node[midway,above left] {$b$} (A);\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 40,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 11,
              "sourceRegion": "Question 9, hexagon to the right of part a",
              "description": "Unshaded hexagon with horizontal top and bottom edges, a shorter bottom edge, and six exterior side labels. Ordinary outlines and labels use black.",
              "mathematics": "Clockwise from the top edge, labels are a, b, a, b, a, b. The perimeter is the sum of three a sides and three b sides. Coordinates reproduce the visible orientation and proportions without asserting measurements.",
              "answerVisibility": "Only the supplied side labels are visible in the question diagram; the perimeter expression belongs in the answer."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$P=3a+3b$",
          "worked": "$$\\begin{align*}P &= a+b+a+b+a+b\\\\P &= 3a+3b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Work out $P$ when $a=7$ and $b=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=30$",
          "worked": "$$\\begin{align*}P &= 3a+3b\\\\P &= 3(7)+3(3)\\\\P &= 30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Work out $a$ when $b=2$ and $P=21$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=5$",
          "worked": "$$\\begin{align*}P &= 3a+3b\\\\21 &= 3a+3(2)\\\\21 &= 3a+6\\\\15 &= 3a\\\\5 &= a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
