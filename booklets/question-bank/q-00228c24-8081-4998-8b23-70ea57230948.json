  "content": {
    "id": "p9-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Simplify, by factoring out $-1$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x-4}{4-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{x-4}{4-x}&=\\frac{x-4}{-(x-4)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{4-x}{x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{4-x}{x-4}&=\\frac{-(x-4)}{x-4}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2x-5}{5-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{2x-5}{5-2x}&=\\frac{2x-5}{-(2x-5)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{5-2x}{2x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{5-2x}{2x-5}&=\\frac{-(2x-5)}{2x-5}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3-x}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{3-x}{x-3}&=\\frac{-(x-3)}{x-3}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{a-b}{b-a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{a-b}{b-a}&=\\frac{a-b}{-(a-b)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{2(x-3)}{6-2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{2(x-3)}{6-2x}&=\\frac{2(x-3)}{2(3-x)}\\\\&=\\frac{2(x-3)}{-2(x-3)}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{3(x-2)}{4(2-x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{4}$",
          "worked": "$$\\begin{align*}\\frac{3(x-2)}{4(2-x)}&=\\frac{3(x-2)}{-4(x-2)}\\\\&=-\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q14-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{6(1-x)}{4(x-1)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{3}{2}$",
          "worked": "$$\\begin{align*}\\frac{6(1-x)}{4(x-1)}&=\\frac{-6(x-1)}{4(x-1)}\\\\&=-\\frac{6}{4}\\\\&=-\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
