      {
        "id": "p6-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=e^{\\frac{2x-1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23e^{\\frac{2x-1}{3}}$",
          "worked": "$$\\begin{aligned}y&=e^{\\frac23x-\\frac13}\\\\\\frac{dy}{dx}&=\\frac23e^{\\frac{2x-1}{3}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=e^{\\frac{2-3x}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac35e^{\\frac{2-3x}{5}}$",
          "worked": "$$\\begin{aligned}y&=e^{\\frac25-\\frac35x}\\\\\\frac{dy}{dx}&=-\\frac35e^{\\frac{2-3x}{5}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(e^x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3e^{3x}$",
          "worked": "$$\\begin{aligned}y&=e^{3x}\\\\\\frac{dy}{dx}&=3e^{3x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p6-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac1{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac1{e^x}$",
          "worked": "$$\\begin{aligned}y&=e^{-x}\\\\\\frac{dy}{dx}&=-e^{-x}\\\\\\frac{dy}{dx}&=-\\frac1{e^x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=e^x\\sqrt{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32e^{\\frac{3x}{2}}$",
          "worked": "$$\\begin{aligned}y&=e^xe^{x/2}\\\\y&=e^{3x/2}\\\\\\frac{dy}{dx}&=\\frac32e^{3x/2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{e^x+1}{e^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-e^{-x}$",
          "worked": "$$\\begin{aligned}y&=\\frac{e^x}{e^x}+\\frac1{e^x}\\\\y&=1+e^{-x}\\\\\\frac{dy}{dx}&=-e^{-x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
