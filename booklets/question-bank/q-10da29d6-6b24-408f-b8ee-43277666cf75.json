  "content": {
    "id": "p14-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Express each of the following natural numbers as a product of prime numbers. Hence, find the square root of each number.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$196$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$196=2^2\\times7^2$, $\\sqrt{196}=14$.",
          "worked": "$$\\begin{align*}196&=2\\times98\\\\196&=2\\times2\\times49\\\\196&=2^2\\times7^2\\end{align*}$$\n$$\\begin{align*}\\sqrt{196}&=\\sqrt{2^2\\times7^2}\\\\\\sqrt{196}&=2\\times7\\\\\\sqrt{196}&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$324$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$324=2^2\\times3^4$, $\\sqrt{324}=18$.",
          "worked": "$$\\begin{align*}324&=2\\times162\\\\324&=2^2\\times81\\\\324&=2^2\\times3\\times27\\\\324&=2^2\\times3^4\\end{align*}$$\n$$\\begin{align*}\\sqrt{324}&=\\sqrt{2^2\\times3^4}\\\\\\sqrt{324}&=2\\times3^2\\\\\\sqrt{324}&=18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p14-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$225$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$225=3^2\\times5^2$, $\\sqrt{225}=15$.",
          "worked": "$$\\begin{align*}225&=3\\times75\\\\225&=3^2\\times25\\\\225&=3^2\\times5^2\\end{align*}$$\n$$\\begin{align*}\\sqrt{225}&=\\sqrt{3^2\\times5^2}\\\\\\sqrt{225}&=3\\times5\\\\\\sqrt{225}&=15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p14-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$484$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$484=2^2\\times11^2$, $\\sqrt{484}=22$.",
          "worked": "$$\\begin{align*}484&=2\\times242\\\\484&=2^2\\times121\\\\484&=2^2\\times11^2\\end{align*}$$\n$$\\begin{align*}\\sqrt{484}&=\\sqrt{2^2\\times11^2}\\\\\\sqrt{484}&=2\\times11\\\\\\sqrt{484}&=22\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
