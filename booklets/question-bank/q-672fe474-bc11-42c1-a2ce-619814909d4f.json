    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q13-a",
        "type": "group",
        "label": "a",
        "prompt": "Consider the circle $x^2+y^2=4$ and the line $y=x+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q13-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Use substitution to obtain a quadratic equation in $x$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x^2+2x-3=0$.",
              "worked": "$$\\begin{align*}x^2+(x+1)^2&=4\\\\2x^2+2x+1&=4\\\\2x^2+2x-3&=0.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p15-q13-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p15-q13-a-ii-instruction",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Find the discriminant for this quadratic and hence state how many times the line intersects the circle. (Do ",
                      "marks": []
                    },
                    {
                      "type": "text",
                      "text": "NOT",
                      "marks": [
                        "bold"
                      ]
                    },
                    {
                      "type": "text",
                      "text": " solve the quadratic equation.)",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\Delta=28>0$; the line intersects the circle twice.",
              "worked": "$$\\begin{align*}\\Delta&=2^2-4\\times2\\times(-3)\\\\\\Delta&=28.\\end{align*}$$\nSince $\\Delta>0$, there are two distinct real values of $x$, so the line intersects the circle twice.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p15-q13-b",
        "type": "group",
        "label": "b",
        "prompt": "Likewise, determine how many times the line intersects the circle in each case.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q13-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$x^2+y^2=1$, $y=x+2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\Delta=-8$; the line and circle do not intersect.",
              "worked": "$$\\begin{align*}x^2+(x+2)^2&=1\\\\2x^2+4x+4&=1\\\\2x^2+4x+3&=0\\\\\\Delta&=4^2-4\\times2\\times3\\\\\\Delta&=-8.\\end{align*}$$\nSince $\\Delta<0$, there are no real solutions, so the line and circle do not intersect.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          },
          {
            "id": "p15-q13-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$x^2+y^2=5$, $y=-2x+5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\Delta=0$; the line intersects the circle once.",
              "worked": "$$\\begin{align*}x^2+(-2x+5)^2&=5\\\\5x^2-20x+25&=5\\\\5x^2-20x+20&=0\\\\\\Delta&=(-20)^2-4\\times5\\times20\\\\\\Delta&=0.\\end{align*}$$\nSince $\\Delta=0$, there is one double root, so the line intersects the circle once and is a tangent.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          }
        ]
      }
    ]
  },
