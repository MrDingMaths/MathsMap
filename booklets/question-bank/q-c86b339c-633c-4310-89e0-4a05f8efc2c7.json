  "content": {
    "id": "p8-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "The side length of a square is $x$ cm. If the side length is increased by 3 cm, then the area increases by $27\\text{ cm}^2$. Find the value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=3$",
      "worked": "$$\\begin{align*}(x+3)^2-x^2&=27\\\\x^2+6x+9-x^2&=27\\\\6x+9&=27\\\\6x&=18\\\\x&=3\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
