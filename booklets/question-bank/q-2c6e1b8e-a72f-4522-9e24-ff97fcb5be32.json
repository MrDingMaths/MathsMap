  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A square metal sheet is being heated such that its length is expanding at a uniform rate of 0.05 cm/s. Find the rate of change of its area at the instant when the length is 4 cm.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.4\\text{ cm}^2/\\text{s}$",
      "worked": "Let $x$ be the side length in centimetres. Then $A=x^2$ and $\\dfrac{dx}{dt}=0.05\\text{ cm/s}$.\n$$\\begin{align*}\\frac{dA}{dt}&=\\frac{dA}{dx}\\frac{dx}{dt}\\\\\\frac{dA}{dt}&=2x(0.05)\\\\\\frac{dA}{dt}&=0.1x\\end{align*}$$\nWhen $x=4$, $\\dfrac{dA}{dt}=0.1(4)=0.4\\text{ cm}^2/\\text{s}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
