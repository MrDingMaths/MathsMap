            }
          ]
        },
        {
          "id": "p98-q30-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "The sound intensity ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "I",
              "display": false
            },
            {
              "type": "text",
              "text": ", measured in ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\mu\\mathrm{W}\\,\\mathrm{m}^{-2}",
              "display": false
            },
            {
              "type": "text",
              "text": ", varies inversely with the square of the distance ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "r",
              "display": false
            },
            {
              "type": "text",
              "text": " m from the source.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p98-q30-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the rule linking $I$ with $r$, in terms of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$I=\\dfrac{k}{r^2}$",
          "worked": "Since $I$ varies inversely with $r^2$,\n$$I=\\frac{k}{r^2}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p98-q30-b",
        "type": "part",
        "label": "b",
        "prompt": "At a distance of $5\\,\\mathrm{m}$, the sound intensity is measured to be $80\\,\\mu\\mathrm{W}\\,\\mathrm{m}^{-2}$. Find the value of $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=2000\\,\\mu\\mathrm{W}$",
          "worked": "From $I=\\frac{k}{r^2}$, $k=Ir^2$.\n$$\\begin{align*}k&=(80\\,\\mu\\mathrm{W}\\,\\mathrm{m}^{-2})(5\\,\\mathrm{m})^2\\\\k&=2000\\,\\mu\\mathrm{W}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p98-q30-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate the intensity at a distance of $10\\,\\mathrm{m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\,\\mu\\mathrm{W}\\,\\mathrm{m}^{-2}$",
          "worked": "$$\\begin{align*}I&=\\frac{2000\\,\\mu\\mathrm{W}}{(10\\,\\mathrm{m})^2}\\\\I&=20\\,\\mu\\mathrm{W}\\,\\mathrm{m}^{-2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p98-q30-d",
        "type": "part",
        "label": "d",
        "prompt": "How far from the source is the sound intensity $20\\,\\mu\\mathrm{W}\\,\\mathrm{m}^{-2}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,\\mathrm{m}$",
          "worked": "From $I=\\frac{k}{r^2}$, $r^2=\\frac{k}{I}$.\n$$\\begin{align*}r^2&=\\frac{2000\\,\\mu\\mathrm{W}}{20\\,\\mu\\mathrm{W}\\,\\mathrm{m}^{-2}}\\\\r^2&=100\\,\\mathrm{m}^2\\\\r&=10\\,\\mathrm{m}.\\end{align*}$$\nTake the positive root because $r$ is a distance.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
