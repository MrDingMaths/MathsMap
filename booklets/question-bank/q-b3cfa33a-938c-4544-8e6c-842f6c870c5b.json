  "content": {
    "id": "p17-q100-102-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following if $n$ is an integer.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q100",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p17-q100-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "-\\sin\\theta",
                    "display": false
                  }
                ]
              },
              {
                "id": "p17-q100-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Remove full revolutions, then use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\sin(180^{\\circ}+\\theta)=-\\sin\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $n$ is an integer, $360n^{\\circ}$ represents full revolutions.\n$$\\begin{align*}\\sin\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)&=\\sin(360n^{\\circ}+180^{\\circ}+\\theta)\\\\\\sin\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)&=\\sin(180^{\\circ}+\\theta)\\\\\\sin\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)&=-\\sin\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q101",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)$",
