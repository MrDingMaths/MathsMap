                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "-\\cos\\theta",
                    "display": false
                  }
                ]
              },
              {
                "id": "p17-q101-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Remove full revolutions, then use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\cos(180^{\\circ}+\\theta)=-\\cos\\theta",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Since $n$ is an integer, remove the full revolutions and apply the third-quadrant cosine identity.\n$$\\begin{align*}\\cos\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)&=\\cos(360n^{\\circ}+180^{\\circ}+\\theta)\\\\\\cos\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)&=\\cos(180^{\\circ}+\\theta)\\\\\\cos\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)&=-\\cos\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q102",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan\\bigl(180(2n+1)^{\\circ}+\\theta\\bigr)$",
        "layout": "list",
        "columns": null,
