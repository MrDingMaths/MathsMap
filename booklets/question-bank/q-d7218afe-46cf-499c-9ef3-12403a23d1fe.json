    "type": "question",
    "label": "1",
    "prompt": "Simplify the following. $\\dfrac{x^4}{x^{-2}}\\times x^{-7}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac1x$, $x\\ne0$.",
      "worked": "The original expression requires $x\\ne0$.\n$$\\begin{align*}\\frac{x^4}{x^{-2}}\\times x^{-7}&=x^{4-(-2)-7}\\\\\\frac{x^4}{x^{-2}}\\times x^{-7}&=x^{-1}\\\\\\frac{x^4}{x^{-2}}\\times x^{-7}&=\\frac1x.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
