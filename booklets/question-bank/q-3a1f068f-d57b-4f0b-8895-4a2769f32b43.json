    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$8$ and $\\dfrac{1}{8}$ as powers of $2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^3,\\ 2^{-3}$",
          "worked": "$\\begin{align*}8&=2^3\\\\\\frac{1}{8}&=\\frac{1}{2^3}=2^{-3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
