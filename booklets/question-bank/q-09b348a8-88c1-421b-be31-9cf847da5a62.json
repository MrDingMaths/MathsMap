  "content": {
    "id": "p24-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the two spinners shown below. If each is spun once, find the probability that the two arrows:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p24-q1-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"spinnerRed\",\"hex\":\"FCDFE1\",\"reason\":\"red sectors identify the red outcome and its probability\"}],\"reference\":\"source PDF page 24, p24-q1-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{spinnerRed}{HTML}{FCDFE1}\n\\fill[spinnerRed] (0,0)--(0,1) arc[start angle=90,end angle=180,radius=1]--cycle;\n\\draw[black] (0,0) circle[radius=1];\n\\draw[black] (-1,0)--(0,0)--(0,1);\n\\draw[black,->] (0,0)--(0.72,0.68);\n\\fill[black] (0,0) circle[radius=0.035];\n\\node[below] at (0,-1.12) {Spinner A};\n\\fill[spinnerRed] (2.5,0)--(2.5,1) arc[start angle=90,end angle=360,radius=1]--cycle;\n\\draw[black] (2.5,0) circle[radius=1];\n\\draw[black] (2.5,1)--(2.5,0)--(3.5,0);\n\\draw[black,->] (2.5,0)--(3.22,0.68);\n\\fill[black] (2.5,0) circle[radius=0.035];\n\\node[below] at (2.5,-1.12) {Spinner B};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 85,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 24,
          "sourceRegion": "Question 1, paired spinners in the upper left column",
          "description": "Equal-sized spinners, A on the left and B on the right, with central pivots and upper-right arrows. A has a red upper-left quarter; B has a white upper-right quarter.",
          "mathematics": "A: red 1/4 and white 3/4. B: red 3/4 and white 1/4. The spins are independent.",
          "answerVisibility": "Sector givens and spinner labels remain visible; no calculated probabilities are printed in the question diagram."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p24-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "both point to white",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{16}$",
          "worked": "The spins are independent.\n$$\\begin{align*}\\Pr(\\text{both white})&=\\frac34\\times\\frac14\\\\\\Pr(\\text{both white})&=\\frac{3}{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "both point to red",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{16}$",
          "worked": "$$\\begin{align*}\\Pr(\\text{both red})&=\\frac14\\times\\frac34\\\\\\Pr(\\text{both red})&=\\frac{3}{16}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "point to the same colour",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "The arrows must both point to white or both point to red. These outcomes are mutually exclusive.\n$$\\begin{align*}\\Pr(\\text{same colour})&=\\frac34\\times\\frac14+\\frac14\\times\\frac34\\\\\\Pr(\\text{same colour})&=\\frac{3}{16}+\\frac{3}{16}\\\\\\Pr(\\text{same colour})&=\\frac38.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p24-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "point to different colours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac58$",
          "worked": "Add the probabilities of A white with B red and A red with B white.\n$$\\begin{align*}\\Pr(\\text{different colours})&=\\frac34\\times\\frac34+\\frac14\\times\\frac14\\\\\\Pr(\\text{different colours})&=\\frac{9}{16}+\\frac{1}{16}\\\\\\Pr(\\text{different colours})&=\\frac58.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
