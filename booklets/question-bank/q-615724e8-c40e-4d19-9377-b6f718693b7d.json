              "short": "$\\$30\\,600$",
              "worked": "$$\\begin{align*}\\text{First-year salary}&=30\\,000\\times1.02\\\\\\text{First-year salary}&=\\$30\\,600\\end{align*}$$",
              "solutionDiagrams": []
