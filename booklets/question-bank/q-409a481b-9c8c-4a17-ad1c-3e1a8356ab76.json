  "content": {
    "id": "p14-q10",
    "type": "question",
    "label": "10",
    "prompt": "For the triangle shown,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "use Pythagoras’ theorem to find the exact length $BC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p14-q10-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 14 p14-q10-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (B) at (0,0);\n\\coordinate (A) at (0,2);\n\\coordinate (C) at ({2*sqrt(3)},0);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(B)!0.18cm!(A)$)--($(B)!0.18cm!(A)+(B)!0.18cm!(C)-(B)$)--($(B)!0.18cm!(C)$);\n\\node[above] at (A) {$A$};\n\\node[below] at (B) {$B$};\n\\node[below] at (C) {$C$};\n\\path (A)--(B) node[midway,left] {$1$};\n\\path (A)--(C) node[midway,above right] {$2$};\n\\pic[draw=black,line width=0.4pt,angle radius=7mm,angle eccentricity=1.35,\"$30^\\circ$\"] {angle=A--C--B};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 48,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 14,
              "sourceRegion": "Question 10a, triangle beneath the instruction",
              "description": "Right triangle ABC with A upper left, B lower left and C lower right; unfilled black geometry and labels. Coordinates derive the 30° interior angle from the given side ratio.",
              "mathematics": "AB=1, AC=2, angle ABC=90°, angle ACB=30°. BC is unlabelled.",
              "answerVisibility": "All givens are permanent; the unknown side length is absent from the question diagram."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$BC=\\sqrt{3}$",
          "worked": "$$\\begin{aligned}BC^2&=AC^2-AB^2\\\\BC^2&=2^2-1^2\\\\BC^2&=3\\\\BC&=\\sqrt{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "use your result from part **a** to write down the exact values of:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q10-b-a",
            "type": "part",
            "label": "i",
            "prompt": "$\\sin 30^\\circ$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{2}$",
              "worked": "$$\\sin 30^\\circ=\\frac{\\text{opposite}}{\\text{hypotenuse}}=\\frac{1}{2}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p14-q10-b-b",
            "type": "part",
            "label": "ii",
            "prompt": "$\\cos 30^\\circ$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\sqrt{3}}{2}$",
              "worked": "$$\\cos 30^\\circ=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{\\sqrt{3}}{2}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p14-q10-b-c",
            "type": "part",
            "label": "iii",
            "prompt": "$\\tan 30^\\circ$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{\\sqrt{3}}$",
              "worked": "$$\\tan 30^\\circ=\\frac{\\text{opposite}}{\\text{adjacent}}=\\frac{1}{\\sqrt{3}}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p14-q10-b-d",
            "type": "part",
            "label": "iv",
            "prompt": "$\\sin 60^\\circ$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{\\sqrt{3}}{2}$",
              "worked": "$\\angle BAC=60^\\circ$, so $BC$ is opposite this angle.\n$$\\sin 60^\\circ=\\frac{\\text{opposite}}{\\text{hypotenuse}}=\\frac{\\sqrt{3}}{2}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p14-q10-b-e",
            "type": "part",
            "label": "v",
            "prompt": "$\\cos 60^\\circ$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{2}$",
              "worked": "$\\angle BAC=60^\\circ$, so $AB$ is adjacent to this angle.\n$$\\cos 60^\\circ=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{1}{2}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p14-q10-b-f",
            "type": "part",
            "label": "vi",
            "prompt": "$\\tan 60^\\circ$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\sqrt{3}$",
              "worked": "$\\angle BAC=60^\\circ$.\n$$\\begin{aligned}\\tan 60^\\circ&=\\frac{\\text{opposite}}{\\text{adjacent}}\\\\\\tan 60^\\circ&=\\frac{\\sqrt{3}}{1}\\\\\\tan 60^\\circ&=\\sqrt{3}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          }
        ]
      }
    ]
