  "content": {
    "id": "p21-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The equations of two lines are $y=x+3$ and $y=mx-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "For what values of $m$ will the two lines not intersect?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$.",
          "worked": "The lines have different $y$-intercepts, $3$ and $-2$. They do not intersect when their gradients are equal, so $m=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "For what values of $m$ will the two lines intersect?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\ne1$.",
          "worked": "The lines intersect when their gradients are different. Their gradients are $1$ and $m$, so $m\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that the lines intersect at $(5,8)$, find $m$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$.",
          "worked": "Substitute $x=5$ and $y=8$ into $y=mx-2$:\n$$\\begin{aligned}8&=5m-2\\\\5m&=10\\\\m&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
