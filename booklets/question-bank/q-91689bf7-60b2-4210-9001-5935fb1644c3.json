  "content": {
    "id": "p7-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the specified coefficient in each expansion.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coefficient of $x^2$ in the expansion of $(3x+2)^9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$41\\,472$",
          "worked": "The term involving $x^2$ is\n$$\\begin{align*}\\binom92(3x)^2 2^7&=36\\cdot9\\cdot128x^2\\\\\\binom92(3x)^2 2^7&=41\\,472x^2.\\end{align*}$$\nThe coefficient is $41\\,472$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the coefficient of $x$ in the expansion of $(2x+5)^8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\,250\\,000$",
          "worked": "The term involving $x$ is\n$$\\begin{align*}\\binom81(2x)5^7&=8\\cdot2\\cdot78\\,125x\\\\\\binom81(2x)5^7&=1\\,250\\,000x.\\end{align*}$$\nThe coefficient is $1\\,250\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the coefficient of $x^7$ in the expansion of $(x-5)^9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$900$",
          "worked": "The term involving $x^7$ is\n$$\\begin{align*}\\binom97 x^7(-5)^2&=36\\cdot25x^7\\\\\\binom97 x^7(-5)^2&=900x^7.\\end{align*}$$\nThe coefficient is $900$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the coefficient of $x^2$ in the expansion of $(2x-1)^{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180$",
          "worked": "The term involving $x^2$ is\n$$\\begin{align*}\\binom{10}2(2x)^2(-1)^8&=45\\cdot4x^2\\\\\\binom{10}2(2x)^2(-1)^8&=180x^2.\\end{align*}$$\nThe coefficient is $180$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
