  "content": {
    "id": "p32-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "A ball was projected from ground level and, when at its highest point, just cleared a $3\\text{ m}$ wall.\n\nGiven the initial velocity was $20\\text{ m/s}$ at angle $\\alpha$ to the horizontal, prove that $\\alpha=\\sin^{-1}\\left(\\dfrac{\\sqrt{15}}{10}\\right)$. Take $g=10\\text{ m/s}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\alpha=\\sin^{-1}\\left(\\dfrac{\\sqrt{15}}{10}\\right)$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p32-q18-answer-top",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "At the highest point, vertical velocity is zero.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p32-q18-answer-time",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\dot y&=20\\sin\\alpha-10t\\\\0&=20\\sin\\alpha-10t\\\\t&=\\frac{20\\sin\\alpha}{10}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p32-q18-answer-height",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The height at the highest point is 3 m:",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p32-q18-answer-calculation",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y&=-5t^2+20t\\sin\\alpha\\\\3&=-5\\left(\\frac{20\\sin\\alpha}{10}\\right)^2+20\\sin\\alpha\\left(\\frac{20\\sin\\alpha}{10}\\right)\\\\3&=-20\\sin^2\\alpha+40\\sin^2\\alpha\\\\\\sin^2\\alpha&=\\frac{3}{20}\\\\\\sin\\alpha&=\\frac{\\sqrt3}{\\sqrt{20}}\\\\&=\\frac{\\sqrt3}{2\\sqrt5}\\\\&=\\frac{\\sqrt{15}}{10}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p32-q18-answer-conclusion",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Since the angle of projection is acute, ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\alpha=\\sin^{-1}\\left(\\frac{\\sqrt{15}}{10}\\right)",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          }
