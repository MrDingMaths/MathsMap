  "content": {
    "id": "p8-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $a+b=2$ and $a^2+b^2=74$, find the value of $ab$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-35$",
          "worked": "$$\\begin{align*}(a+b)^2&=a^2+2ab+b^2\\\\2^2&=74+2ab\\\\2ab&=4-74\\\\ab&=-35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that $a+b=3$ and $ab=-18$, find the value of $a^2+b^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$45$",
          "worked": "$$\\begin{align*}(a+b)^2&=a^2+2ab+b^2\\\\3^2&=a^2+b^2+2(-18)\\\\a^2+b^2&=9+36\\\\a^2+b^2&=45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $x+\\frac1x=3$, find the value of $x^2+\\frac1{x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}\\left(x+\\frac1x\\right)^2&=x^2+2x\\left(\\frac1x\\right)+\\frac1{x^2}\\\\3^2&=x^2+2+\\frac1{x^2}\\\\x^2+\\frac1{x^2}&=9-2\\\\x^2+\\frac1{x^2}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p8-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Given that $x-\\frac1x=1$, find the value of $x^2+\\frac1{x^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\left(x-\\frac1x\\right)^2&=x^2-2x\\left(\\frac1x\\right)+\\frac1{x^2}\\\\1^2&=x^2-2+\\frac1{x^2}\\\\x^2+\\frac1{x^2}&=1+2\\\\x^2+\\frac1{x^2}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
