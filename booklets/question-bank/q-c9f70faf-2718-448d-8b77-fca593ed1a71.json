  "content": {
    "id": "p22-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Solve these simultaneous equations for $(x,y)$ using the elimination method.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}x+y&=1\\\\-x+y&=1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(0,1)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}2y&=2\\\\y&=1\\\\x+1&=1\\\\x&=0\\end{align*}$$\nTherefore, $(x,y)=(0,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}3x+y&=1\\\\2x-y&=4\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,-2)$",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}5x&=5\\\\x&=1\\\\3(1)+y&=1\\\\y&=-2\\end{align*}$$\nTherefore, $(x,y)=(1,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}x+2y&=3\\\\-x+2y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-1,2)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}4y&=8\\\\y&=2\\\\x+2(2)&=3\\\\x&=-1\\end{align*}$$\nTherefore, $(x,y)=(-1,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}2x+y&=1\\\\3x-y&=-6\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-1,3)$",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}5x&=-5\\\\x&=-1\\\\2(-1)+y&=1\\\\y&=3\\end{align*}$$\nTherefore, $(x,y)=(-1,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}2x+y&=7\\\\-2x+5y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac52,2\\right)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}6y&=12\\\\y&=2\\\\2x+2&=7\\\\2x&=5\\\\x&=\\frac52\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac52,2\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p22-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}2x-3y&=-4\\\\4x+3y&=1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac12,1\\right)$",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}6x&=-3\\\\x&=-\\frac12\\\\2\\left(-\\frac12\\right)-3y&=-4\\\\-1-3y&=-4\\\\-3y&=-3\\\\y&=1\\end{align*}$$\nTherefore, $(x,y)=\\left(-\\frac12,1\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p22-q14-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}x+y&=3\\\\-x-3y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(7,-4)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}-2y&=8\\\\y&=-4\\\\x-4&=3\\\\x&=7\\end{align*}$$\nTherefore, $(x,y)=(7,-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q14-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}2x+y&=2\\\\-3x-y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-5,12)$",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}-x&=5\\\\x&=-5\\\\2(-5)+y&=2\\\\y&=12\\end{align*}$$\nTherefore, $(x,y)=(-5,12)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p22-q14-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\begin{aligned}4x-4y&=11\\\\-4x-3y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac34,-2\\right)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}-7y&=14\\\\y&=-2\\\\4x-4(-2)&=11\\\\4x&=3\\\\x&=\\frac34\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac34,-2\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p22-q14-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\begin{aligned}-7x-2y&=5\\\\5x+2y&=-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-2,\\frac92\\right)$",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}-2x&=4\\\\x&=-2\\\\5(-2)+2y&=-1\\\\2y&=9\\\\y&=\\frac92\\end{align*}$$\nTherefore, $(x,y)=\\left(-2,\\frac92\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p22-q14-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\begin{aligned}3x-4y&=-4\\\\-3x-3y&=5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac{32}{21},-\\frac17\\right)$\n\nAdd the equations to eliminate $x$, then substitute for $y$.",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}-7y&=1\\\\y&=-\\frac17\\\\3x-4\\left(-\\frac17\\right)&=-4\\\\3x+\\frac47&=-4\\\\3x&=-\\frac{32}{7}\\\\x&=-\\frac{32}{21}\\end{align*}$$\nTherefore, $(x,y)=\\left(-\\frac{32}{21},-\\frac17\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p22-q14-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\begin{aligned}-5x+3y&=-1\\\\-x-3y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-\\frac13,-\\frac89\\right)$\n\nAdd the equations to eliminate $y$, then substitute for $x$.",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}-6x&=2\\\\x&=-\\frac13\\\\-\\left(-\\frac13\\right)-3y&=3\\\\\\frac13-3y&=3\\\\-3y&=\\frac83\\\\y&=-\\frac89\\end{align*}$$\nTherefore, $(x,y)=\\left(-\\frac13,-\\frac89\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p22-q14-m",
        "type": "part",
        "label": "m",
        "prompt": "$$\\begin{aligned}2x-5y&=-7\\\\-2x+3y&=-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac{13}{2},4\\right)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}-2y&=-8\\\\y&=4\\\\2x-5(4)&=-7\\\\2x&=13\\\\x&=\\frac{13}{2}\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac{13}{2},4\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p22-q14-n",
        "type": "part",
        "label": "n",
        "prompt": "$$\\begin{aligned}-5x+3y&=-1\\\\-3x-3y&=-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,\\frac12\\right)$",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}-8x&=-4\\\\x&=\\frac12\\\\-5\\left(\\frac12\\right)+3y&=-1\\\\-\\frac52+3y&=-1\\\\3y&=\\frac32\\\\y&=\\frac12\\end{align*}$$\nTherefore, $(x,y)=\\left(\\frac12,\\frac12\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      },
      {
        "id": "p22-q14-o",
        "type": "part",
        "label": "o",
        "prompt": "$$\\begin{aligned}\\frac{x}{2}-y&=1\\\\-\\frac{x}{2}+2y&=3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(10,4)$",
          "worked": "Add the equations to eliminate $x$.\n$$\\begin{align*}y&=4\\\\\\frac{x}{2}-4&=1\\\\\\frac{x}{2}&=5\\\\x&=10\\end{align*}$$\nTherefore, $(x,y)=(10,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p22-q14-p",
        "type": "part",
        "label": "p",
        "prompt": "$$\\begin{aligned}\\frac{x}{2}+\\frac{y}{3}&=3\\\\-\\frac{x}{4}-\\frac{y}{3}&=2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(20,-21)$\n\nAdd the equations to eliminate $y$, then substitute for $x$.",
          "worked": "Add the equations to eliminate $y$.\n$$\\begin{align*}\\frac{x}{4}&=5\\\\x&=20\\\\\\frac{20}{2}+\\frac{y}{3}&=3\\\\10+\\frac{y}{3}&=3\\\\\\frac{y}{3}&=-7\\\\y&=-21\\end{align*}$$\nTherefore, $(x,y)=(20,-21)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      }
    ]
