  "content": {
    "id": "p26-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $\\log_x(p)=1.6$, find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_x(p^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.2$",
          "worked": "$$\\begin{align*}\\log_x(p^2)&=2\\log_x(p)\\\\\\log_x(p^2)&=2\\times1.6=3.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p26-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_x(\\sqrt p)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8$",
          "worked": "$$\\begin{align*}\\log_x(\\sqrt p)&=\\log_x(p^{1/2})\\\\\\log_x(\\sqrt p)&=\\frac12\\log_x(p)\\\\\\log_x(\\sqrt p)&=\\frac12\\times1.6=0.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_x\\!\\left(\\frac1p\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1.6$",
          "worked": "$$\\begin{align*}\\log_x\\!\\left(\\frac1p\\right)&=\\log_x(p^{-1})\\\\\\log_x\\!\\left(\\frac1p\\right)&=-\\log_x(p)\\\\\\log_x\\!\\left(\\frac1p\\right)&=-1.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p26-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_x(p^x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.6x$",
          "worked": "$$\\begin{align*}\\log_x(p^x)&=x\\log_x(p)\\\\\\log_x(p^x)&=1.6x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
