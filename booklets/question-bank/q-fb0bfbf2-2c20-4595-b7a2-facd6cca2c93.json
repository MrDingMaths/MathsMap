  "content": {
    "id": "p28-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the first four terms of the sequences defined by the following linear recurrence relations:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$a_{n+1}=2a_n+1$, given that $a_1=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,\\ 5,\\ 11,\\ 23$",
          "worked": "$$\\begin{align*}a_2&=2(2)+1=5\\\\a_3&=2(5)+1=11\\\\a_4&=2(11)+1=23\\end{align*}$$\nThe first four terms are $2,\\ 5,\\ 11,\\ 23$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$a_{n+1}=3a_n+2$, given that $a_1=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3,\\ 11,\\ 35,\\ 107$",
          "worked": "$$\\begin{align*}a_2&=3(3)+2=11\\\\a_3&=3(11)+2=35\\\\a_4&=3(35)+2=107\\end{align*}$$\nThe first four terms are $3,\\ 11,\\ 35,\\ 107$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$a_{n+1}=2a_n-3$, given that $a_1=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,\\ 1,\\ -1,\\ -5$",
          "worked": "$$\\begin{align*}a_2&=2(2)-3=1\\\\a_3&=2(1)-3=-1\\\\a_4&=2(-1)-3=-5\\end{align*}$$\nThe first four terms are $2,\\ 1,\\ -1,\\ -5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q1d",
        "type": "part",
        "label": "d",
        "prompt": "$a_{n+1}=-a_n+1$, given that $a_1=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,\\ -1,\\ 2,\\ -1$",
          "worked": "$$\\begin{align*}a_2&=-(2)+1=-1\\\\a_3&=-(-1)+1=2\\\\a_4&=-(2)+1=-1\\end{align*}$$\nThe first four terms are $2,\\ -1,\\ 2,\\ -1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q1e",
        "type": "part",
        "label": "e",
        "prompt": "$a_{n+1}=-2a_n+3$, given that $a_1=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1,\\ 1,\\ 1,\\ 1$",
          "worked": "$$\\begin{align*}a_2&=-2(1)+3=1\\\\a_3&=-2(1)+3=1\\\\a_4&=-2(1)+3=1\\end{align*}$$\nThe first four terms are $1,\\ 1,\\ 1,\\ 1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p28-q1f",
        "type": "part",
        "label": "f",
        "prompt": "$a_{n+1}=-3a_n+2$, given that $a_1=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2,\\ -4,\\ 14,\\ -40$",
          "worked": "$$\\begin{align*}a_2&=-3(2)+2=-4\\\\a_3&=-3(-4)+2=14\\\\a_4&=-3(14)+2=-40\\end{align*}$$\nThe first four terms are $2,\\ -4,\\ 14,\\ -40$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
