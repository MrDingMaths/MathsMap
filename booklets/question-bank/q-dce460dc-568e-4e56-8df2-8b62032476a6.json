    "difficultyReason": "Combines negative integers, powers, nested grouping and fraction bars; part h also requires evaluating an exponent."
  },
  "content": {
    "id": "p59-q19-content",
    "type": "question",
    "label": "19",
    "prompt": "Evaluate the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p59-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$(-2)^3-(-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-12$",
          "worked": "$$\\begin{align*}(-2)^3-(-2)^2&=-8-(-2)^2\\\\&=-8-4\\\\&=-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p59-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(4-12)\\times(-3- -7)}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$\\begin{align*}\\frac{(4-12)\\times(-3- -7)}{4}&=\\frac{-8\\times(-3- -7)}{4}\\\\&=\\frac{-8\\times4}{4}\\\\&=\\frac{-32}{4}\\\\&=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p59-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$-20\\div[-2\\times4-3\\times-6]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$\\begin{align*}-20\\div[-2\\times4-3\\times-6]&=-20\\div[-8-3\\times-6]\\\\&=-20\\div[-8-(-18)]\\\\&=-20\\div10\\\\&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p59-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{-7+3}{-11- -7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{-7+3}{-11- -7}&=\\frac{-4}{-11- -7}\\\\&=\\frac{-4}{-4}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p59-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-3- -7)^2\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}(-3- -7)^2\\times3&=4^2\\times3\\\\&=16\\times3\\\\&=48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p59-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-1)^{100}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "The exponent is even, so the power is positive.\n\n$$(-1)^{100}=1$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p59-q19-g",
        "type": "part",
        "label": "g",
        "prompt": "$(-2\\times3)^3-(-3- -2)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-215$",
          "worked": "$$\\begin{align*}(-2\\times3)^3-(-3- -2)^3&=(-6)^3-(-3- -2)^3\\\\&=(-6)^3-(-1)^3\\\\&=-216-(-1)^3\\\\&=-216-(-1)\\\\&=-215\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p59-q19-h",
        "type": "part",
        "label": "h",
        "prompt": "$(-4- -6)^{(-2- -3)}-\\dfrac{3- -7}{5+(-10)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}(-4- -6)^{(-2- -3)}-\\frac{3- -7}{5+(-10)}&=2^{(-2- -3)}-\\frac{3- -7}{5+(-10)}\\\\&=2^1-\\frac{3- -7}{5+(-10)}\\\\&=2^1-\\frac{10}{5+(-10)}\\\\&=2^1-\\frac{10}{-5}\\\\&=2-\\frac{10}{-5}\\\\&=2-(-2)\\\\&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
