  "content": {
    "id": "p56-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "When the polynomial $P(x)$ is divided by $(x+1)(x-3)$, the remainder is $2x+7$.\nWhat is the remainder when $P(x)$ is divided by $x-3$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$13$, since $P(3)=2(3)+7=13$.",
      "worked": "$$\\begin{align*}P(x)&=(x+1)(x-3)Q(x)+2x+7\\\\P(3)&=(3+1)(3-3)Q(3)+2(3)+7\\\\P(3)&=13\\end{align*}$$\nBy the remainder theorem, the remainder is $13$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
