  "content": {
    "id": "p9-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "For the quadratic equation $x^2+bx+4=0$, find the values of $b$ for which the equation has:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "one solution",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\pm4$.",
          "worked": "One real solution requires $\\Delta=0$.\n$$\\begin{align*}\\Delta&=b^2-4(1)(4)\\\\\\Delta&=b^2-16\\\\b^2-16&=0\\\\b^2&=16\\\\b&=\\pm4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "two solutions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b<-4$ or $b>4$.",
          "worked": "Two distinct real solutions require $\\Delta>0$.\n$$\\begin{align*}\\Delta&=b^2-4(1)(4)\\\\\\Delta&=b^2-16\\\\b^2-16&>0\\\\b^2&>16\\end{align*}$$\nThus $b<-4$ or $b>4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p9-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "no solutions",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4<b<4$.",
          "worked": "No real solutions requires $\\Delta<0$.\n$$\\begin{align*}\\Delta&=b^2-4(1)(4)\\\\\\Delta&=b^2-16\\\\b^2-16&<0\\\\b^2&<16\\end{align*}$$\nThus $-4<b<4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
