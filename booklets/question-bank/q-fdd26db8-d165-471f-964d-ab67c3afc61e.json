  "content": {
    "id": "v2-32-salary-practice-slot-21-root",
    "type": "question",
    "label": null,
    "prompt": "Mohammed is a surveyor and earns a salary of \\$82 460 p.a.\nFind how much he earns for each period below. Round your answers to the nearest cent.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-32-salary-practice-slot-21-slot-21-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Week",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1585.77 per week",
          "worked": "$$\\begin{align*}\\text{Weekly pay} &= \\frac{\\text{Annual salary}}{52}\\\\\\text{Weekly pay} &= \\frac{\\$82\\,460}{52}\\\\\\text{Weekly pay} &\\approx \\$1585.77\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-32-salary-practice-slot-21-slot-21-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Month",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$6871.67 per month",
          "worked": "$$\\begin{align*}\\text{Monthly pay} &= \\frac{\\text{Annual salary}}{12}\\\\\\text{Monthly pay} &= \\frac{\\$82\\,460}{12}\\\\\\text{Monthly pay} &\\approx \\$6871.67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
