      {
        "id": "p20-q3a",
        "type": "part",
        "label": "a",
        "prompt": "Find the midpoint of the interval $AB$, where the coordinates of $A$ and $B$ are $(2,-1)$ and $(3,6)$, respectively.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\frac{5}{2},\\frac{5}{2}\\right)$",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{2+3}{2},\\frac{-1+6}{2}\\right)\\\\M&=\\left(\\frac{5}{2},\\frac{5}{2}\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q3b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of the line that passes through points $A$ and $B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7$",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{6-(-1)}{3-2}\\\\m_{AB}&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p20-q3c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of the line $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=7x-15$",
          "worked": "$$\\begin{align*}y+1&=7(x-2)\\\\y+1&=7x-14\\\\y&=7x-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p20-q3d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the perpendicular bisector of the interval $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p20-q3d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "y=-\\frac17x+\\frac{20}{7}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p20-q3d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use gradient ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-\\frac17",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and the midpoint ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\left(\\frac52,\\frac52\\right)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The perpendicular bisector passes through $M\\left(\\frac52,\\frac52\\right)$ and has gradient $-\\frac17$, since $7\\left(-\\frac17\\right)=-1$.\n\n$$\\begin{align*}y-\\frac52&=-\\frac17\\left(x-\\frac52\\right)\\\\y-\\frac52&=-\\frac17x+\\frac{5}{14}\\\\y&=-\\frac17x+\\frac{5}{14}+\\frac{35}{14}\\\\y&=-\\frac17x+\\frac{20}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
