  "content": {
    "id": "p49-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Sophie is currently 3 times her son’s age. In 14 years’ time, she will be twice her son’s age.\nWhat is Sophie’s current age?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Sophie is 42 years old.",
      "worked": "Let $x$ be Sophie’s current age and $y$ be her son’s current age, in years.\n$$\\begin{align*}x &= 3y \\qquad (1)\\\\x+14 &= 2(y+14) \\qquad (2)\\end{align*}$$\nSubstitute (1) into (2):\n$$\\begin{align*}3y+14 &= 2(y+14)\\\\3y+14 &= 2y+28\\\\y &= 14\\\\x &= 3(14)\\\\x &= 42\\end{align*}$$\nSophie is 42 years old.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
  },
