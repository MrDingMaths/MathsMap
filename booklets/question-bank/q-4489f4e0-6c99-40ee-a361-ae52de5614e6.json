    "label": "43",
    "prompt": "Simplify the following.\n$$\\frac{x^8}{x^3}\\times(x^5)^2$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^{15}$, $x\\ne0$.",
      "worked": "$$\\begin{align*}\\frac{x^8}{x^3}\\times(x^5)^2&=x^{8-3+5\\times2}\\\\\\frac{x^8}{x^3}\\times(x^5)^2&=x^{15}\\end{align*}$$\nThe original denominator requires $x\\ne0$.",
      "solutionDiagrams": []
    },
