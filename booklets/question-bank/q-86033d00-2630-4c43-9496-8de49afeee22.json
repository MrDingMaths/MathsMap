  "content": {
    "id": "p5-q9",
    "type": "question",
    "label": "9",
    "prompt": "In a maths competition, Harry scored 20. Each correct answer was worth 10 marks. For each incorrect answer, 2.5 marks were deducted. If Harry answered 5 questions correctly, how many incorrect answers did he have?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12$ incorrect answers.",
      "worked": "$$\\begin{align*}\\text{Marks for correct answers}&=5\\times10\\\\\\text{Marks for correct answers}&=50\\\\\\text{Marks deducted}&=50-20\\\\\\text{Marks deducted}&=30\\\\\\text{Incorrect answers}&=30\\div2.5\\\\\\text{Incorrect answers}&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
