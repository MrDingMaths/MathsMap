      {
        "id": "p34-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the area between $y=\\dfrac{1}{3x+2}$ and the $x$-axis for $0\\le x\\le1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13(\\ln5-\\ln2)\\text{ units}^2$",
          "worked": "$$\\begin{align*}A&=\\int_0^1\\frac{1}{3x+2}\\,dx\\\\&=\\left[\\frac13\\ln(3x+2)\\right]_0^1\\\\&=\\frac13(\\ln5-\\ln2)\\text{ units}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p34-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area between $y=\\dfrac{3}{x-1}$ and the $x$-axis for $2\\le x\\le e^3+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\text{ units}^2$",
          "worked": "$$\\begin{align*}A&=\\int_2^{e^3+1}\\frac{3}{x-1}\\,dx\\\\&=\\left[3\\ln(x-1)\\right]_2^{e^3+1}\\\\&=3\\ln(e^3)-3\\ln1\\\\&=9\\text{ units}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p34-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the area between $y=\\dfrac1x+x$ and the $x$-axis, from $x=\\dfrac12$ to $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(2\\ln2+\\dfrac{15}{8}\\right)\\text{ units}^2$",
          "worked": "$$\\begin{align*}A&=\\int_{1/2}^2\\left(\\frac1x+x\\right)\\,dx\\\\&=\\left[\\ln x+\\frac{x^2}{2}\\right]_{1/2}^2\\\\&=(\\ln2+2)-\\left(-\\ln2+\\frac18\\right)\\\\&=\\left(2\\ln2+\\frac{15}{8}\\right)\\text{ units}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p34-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the area between $y=\\dfrac1x+x^2$ and the $x$-axis, from $x=1$ to $x=3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\ln3+\\dfrac{26}{3}\\right)\\text{ units}^2$",
          "worked": "$$\\begin{align*}A&=\\int_1^3\\left(\\frac1x+x^2\\right)\\,dx\\\\&=\\left[\\ln x+\\frac{x^3}{3}\\right]_1^3\\\\&=(\\ln3+9)-\\left(0+\\frac13\\right)\\\\&=\\left(\\ln3+\\frac{26}{3}\\right)\\text{ units}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
