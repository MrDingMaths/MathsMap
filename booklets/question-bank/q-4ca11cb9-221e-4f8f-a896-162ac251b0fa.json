  "content": {
    "id": "p12-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the first four terms of the geometric sequence whose first term is $3$ and whose common ratio is $2$. Find a formula for the $n$th term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3,6,12,24$; $a_n=3\\cdot2^{n-1}$.",
      "worked": "Multiply each term by $2$:\n$$\\begin{align*}a_2&=3\\times2=6\\\\a_3&=6\\times2=12\\\\a_4&=12\\times2=24.\\end{align*}$$\nThe first four terms are $3,6,12,24$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=3\\cdot2^{n-1}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
