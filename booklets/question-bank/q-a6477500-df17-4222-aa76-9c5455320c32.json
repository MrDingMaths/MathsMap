  "content": {
    "id": "p17-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Find the value(s) of $m$ for which the quadratic equation",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2-8x+m=0$ has real roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\leq 8$",
          "worked": "Real roots require $\\Delta\\geq 0$. Here $\\Delta=(-8)^2-4(2)m=64-8m$, so\n\n$$\\begin{align*}64-8m&\\geq 0\\\\8m&\\leq 64\\\\m&\\leq 8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p17-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-(m-5)x+4=0$ has equal roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$ or $m=9$.",
          "worked": "Equal roots require $\\Delta=0$.\n\n$$\\begin{align*}\\Delta&=[-(m-5)]^2-4(1)(4)\\\\\\Delta&=(m-5)^2-16\\end{align*}$$\n\nSetting this expression equal to zero gives\n\n$$\\begin{align*}(m-5)^2&=16\\\\m-5&=\\pm 4\\\\m&=5\\pm 4\\end{align*}$$\n\nTherefore $m=1$ or $m=9$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p17-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$8x^2-3x+4m+9=0$ has $x=0$ as one of its roots.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=-\\frac{9}{4}$",
          "worked": "Substitute $x=0$.\n\n$$\\begin{align*}8(0)^2-3(0)+4m+9&=0\\\\4m+9&=0\\\\4m&=-9\\\\m&=-\\frac{9}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
