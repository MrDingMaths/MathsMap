  "content": {
    "id": "v2-3b8ba3-p44-section-slot-8-upper-root",
    "type": "question",
    "label": null,
    "prompt": "A parabola has $x$-intercepts at $x=-3$ and $x=2$. It passes through the point $(1,-8)$. Find the equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=2(x+3)(x-2)$",
      "worked": "$$\\begin{align*}y&=k(x+3)(x-2)\\\\-8&=k(1+3)(1-2)\\\\-8&=-4k\\\\k&=2\\\\\\therefore y&=2(x+3)(x-2)\\end{align*}$$",
      "solutionDiagrams": []
    },
