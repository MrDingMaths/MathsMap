        "prompt": "$2x^2+3x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x+1)$",
          "worked": "Product: $2\\times1=2$. Sum: $3$. Factor pair: $2,1$.\n$$\\begin{align*}2x^2+3x+1&=2x^2+2x+x+1\\\\&=2x(x+1)+(x+1)\\\\&=(2x+1)(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q6b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+5x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x+2)$",
          "worked": "Product: $2\\times2=4$. Sum: $5$. Factor pair: $4,1$.\n$$\\begin{align*}2x^2+5x+2&=2x^2+4x+x+2\\\\&=2x(x+2)+(x+2)\\\\&=(2x+1)(x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q6c",
        "type": "part",
        "label": "c",
        "prompt": "$2x^2+7x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x+3)$",
          "worked": "Product: $2\\times3=6$. Sum: $7$. Factor pair: $6,1$.\n$$\\begin{align*}2x^2+7x+3&=2x^2+6x+x+3\\\\&=2x(x+3)+(x+3)\\\\&=(2x+1)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
