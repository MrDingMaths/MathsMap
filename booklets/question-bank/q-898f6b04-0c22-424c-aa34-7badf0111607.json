  "content": {
    "id": "p12-q11-answer",
    "type": "question",
    "label": "11",
    "prompt": "A manufacturer of computer parts puts a serial number on each part, consisting of 3 letters, 4 numbers, then 4 letters. The number of parts sold is estimated to be 5 million. Will there be enough combinations on this serial number to cope with these sales?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes.",
      "worked": "There are 26 choices for each letter and 10 choices for each digit.\n\n$$\\begin{aligned}26^3\\times10^4\\times26^4&=26^7\\times10^4\\\\&>5\\,000\\,000\\end{aligned}$$\n\nYes, there are enough serial numbers.",
      "solutionDiagrams": []
    },
