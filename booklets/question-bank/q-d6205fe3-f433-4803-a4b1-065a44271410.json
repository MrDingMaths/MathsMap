          "inlines": [
            {
              "type": "text",
              "text": "Luke's normal rate of pay is $24.80 per hour. In one week, he worked 14 hours at the normal rate, 4 hours at time-and-a-half, and 3.5 hours at double time.",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q28-allowance",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "He was also paid a wet weather allowance of $50 for the week.",
              "marks": []
            }
          ]
        },
        {
          "id": "p20-q28-request",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "What was his pay for the week?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$719.60$",
      "worked": "$$\\begin{align*}\\text{Normal pay} &= 24.80\\times14 = \\$347.20\\\\\\text{Time-and-a-half pay} &= 24.80\\times4\\times1.5 = \\$148.80\\\\\\text{Double time pay} &= 24.80\\times3.5\\times2 = \\$173.60\\\\\\text{Total pay} &= 347.20+148.80+173.60+50\\\\&= \\$719.60\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
