  "content": {
    "id": "p97-q16-response",
    "type": "question",
    "label": "16",
    "prompt": "Seven people can do a certain job in twelve days. How many days will it take if six people are to do the same job?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "14 days",
      "worked": "Assuming equal work rates, the time $t$ days varies inversely with the number of people $n$.\n$$\\begin{align*}t&=\\frac{k}{n}\\\\12&=\\frac{k}{7}\\\\k&=84\\\\t&=\\frac{84}{6}\\\\t&=14\\end{align*}$$\nThe job will take 14 days.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 46
  },
