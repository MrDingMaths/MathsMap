        "answer": {
          "short": "Rectangle: $10\\pi\\text{ cm}\\times6\\text{ cm}$. Each circle: radius $5\\text{ cm}$.",
          "worked": "The rectangle's length is the circumference of a circular end:\n$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi(5)\\\\C&=10\\pi\\text{ cm}.\\end{align*}$$\nIts width is the cylinder's height, $6\\text{ cm}$. Each circle has radius $5\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-76b48-p20-practice-slot-11-slot-11-b",
        "type": "group",
        "label": "b",
        "prompt": "Calculate the area of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "v2-76b48-p20-practice-slot-11-slot-11-b-i",
            "type": "part",
            "label": "i",
            "prompt": "The two circles. Answer in exact form.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$50\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A_{\\text{circles}}&=2\\pi r^2\\\\A_{\\text{circles}}&=2\\pi(5)^2\\\\A_{\\text{circles}}&=50\\pi\\text{ cm}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "v2-76b48-p20-practice-slot-11-slot-11-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "The rectangle. Answer in exact form.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$60\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A_{\\text{rectangle}}&=2\\pi rh\\\\A_{\\text{rectangle}}&=2\\pi(5)(6)\\\\A_{\\text{rectangle}}&=60\\pi\\text{ cm}^2.\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "v2-76b48-p20-practice-slot-11-slot-11-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Hence find the surface area of the cylinder to 1 d.p.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$345.6\\text{ cm}^2$",
              "worked": "$$\\begin{align*}A&=50\\pi+60\\pi\\\\A&=110\\pi\\text{ cm}^2\\\\A&\\approx345.6\\text{ cm}^2\\quad\\text{(1 d.p.)}.\\end{align*}$$",
