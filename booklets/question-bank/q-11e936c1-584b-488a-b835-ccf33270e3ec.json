        "answer": {
          "short": "$\\dfrac{8\\sqrt3\\pi}{3}\\,\\mathrm{cm}^3$\n\nHalve the diameter, then use Pythagoras to find $h=2\\sqrt3\\,\\mathrm{cm}$.",
          "worked": "$$\\begin{align*}r&=\\frac42\\\\r&=2\\,\\mathrm{cm}\\\\h&=\\sqrt{4^2-2^2}\\\\h&=2\\sqrt3\\,\\mathrm{cm}.\\end{align*}$$\n$$\\begin{align*}V&=\\frac13\\pi r^2h\\\\V&=\\frac13\\pi(2^2)(2\\sqrt3)\\\\V&=\\frac{8\\sqrt3\\pi}{3}\\,\\mathrm{cm}^3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64,
        "responseSpace": "scaffold"
