    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p141-q23-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f(x)=\\sqrt{x}",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "g(x)=x+4",
              "display": false
            },
            {
              "type": "text",
              "text": ". Find:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p141-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x+4}$",
          "worked": "$$\\begin{align*}f(g(x))&=f(x+4)\\\\f(g(x))&=\\sqrt{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p141-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(f(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}+4$",
          "worked": "$$\\begin{align*}g(f(x))&=g(\\sqrt{x})\\\\g(f(x))&=\\sqrt{x}+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p141-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(g(x))$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+8$",
          "worked": "$$\\begin{align*}g(g(x))&=g(x+4)\\\\g(g(x))&=(x+4)+4\\\\g(g(x))&=x+8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p141-q23-d",
        "type": "part",
        "label": "d",
        "prompt": "which composition(s) produced $y=\\sqrt{x+8}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p141-q23-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "f(g(g(x)))=(f\\circ g\\circ g)(x)",
                    "display": false
                  }
                ]
              },
              {
                "id": "p141-q23-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Apply ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "g",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " twice, then ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "f",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Apply $g$ twice to add $8$, then apply $f$ to take the square root.\n\n$$\\begin{align*}f(g(g(x)))&=f(g(x+4))\\\\f(g(g(x)))&=f(x+8)\\\\f(g(g(x)))&=\\sqrt{x+8}\\end{align*}$$\n\nThe composition is $(f\\circ g\\circ g)(x)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
