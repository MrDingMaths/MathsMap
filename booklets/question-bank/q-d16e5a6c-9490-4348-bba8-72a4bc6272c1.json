  "content": {
    "id": "p29-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Prove that each of the following simplifies to zero by showing all steps.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q9-h",
        "type": "part",
        "label": "a",
        "prompt": "$5\\sqrt{3}-\\sqrt{108}+\\sqrt{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}5\\sqrt{3}-\\sqrt{108}+\\sqrt{3}&=5\\sqrt{3}-\\sqrt{36}\\sqrt{3}+\\sqrt{3}\\\\&=5\\sqrt{3}-6\\sqrt{3}+\\sqrt{3}\\\\&=(5-6+1)\\sqrt{3}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q9-i",
        "type": "part",
        "label": "b",
        "prompt": "$6\\sqrt{2}-2\\sqrt{32}+2\\sqrt{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}6\\sqrt{2}-2\\sqrt{32}+2\\sqrt{2}&=6\\sqrt{2}-2\\sqrt{16}\\sqrt{2}+2\\sqrt{2}\\\\&=6\\sqrt{2}-8\\sqrt{2}+2\\sqrt{2}\\\\&=(6-8+2)\\sqrt{2}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q9-j",
        "type": "part",
        "label": "c",
        "prompt": "$2\\sqrt{20}-7\\sqrt{5}+\\sqrt{45}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}2\\sqrt{20}-7\\sqrt{5}+\\sqrt{45}&=2\\sqrt{4}\\sqrt{5}-7\\sqrt{5}+\\sqrt{9}\\sqrt{5}\\\\&=4\\sqrt{5}-7\\sqrt{5}+3\\sqrt{5}\\\\&=(4-7+3)\\sqrt{5}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q9-k",
        "type": "part",
        "label": "d",
        "prompt": "$3\\sqrt{2}-2\\sqrt{27}-\\sqrt{50}+6\\sqrt{3}+\\sqrt{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$. The $\\sqrt{2}$ terms and the $\\sqrt{3}$ terms each cancel.",
          "worked": "$$\\begin{align*}3\\sqrt{2}-2\\sqrt{27}-\\sqrt{50}+6\\sqrt{3}+\\sqrt{8}&=3\\sqrt{2}-2\\sqrt{9}\\sqrt{3}-\\sqrt{25}\\sqrt{2}+6\\sqrt{3}+\\sqrt{4}\\sqrt{2}\\\\&=3\\sqrt{2}-6\\sqrt{3}-5\\sqrt{2}+6\\sqrt{3}+2\\sqrt{2}\\\\&=(3-5+2)\\sqrt{2}+(-6+6)\\sqrt{3}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
