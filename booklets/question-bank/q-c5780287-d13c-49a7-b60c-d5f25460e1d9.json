    "label": "11",
    "prompt": "Evaluate $\\left(1+\\frac12\\right)\\left(1+\\frac13\\right)\\left(1+\\frac14\\right)\\left(1+\\frac15\\right)\\left(1+\\frac16\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac72$",
      "worked": "$$\\begin{align*}\\left(1+\\frac12\\right)\\left(1+\\frac13\\right)\\left(1+\\frac14\\right)\\left(1+\\frac15\\right)\\left(1+\\frac16\\right)&=\\frac32\\times\\frac43\\times\\frac54\\times\\frac65\\times\\frac76\\\\\\left(1+\\frac12\\right)\\left(1+\\frac13\\right)\\left(1+\\frac14\\right)\\left(1+\\frac15\\right)\\left(1+\\frac16\\right)&=\\frac{3\\times4\\times5\\times6\\times7}{2\\times3\\times4\\times5\\times6}\\\\\\left(1+\\frac12\\right)\\left(1+\\frac13\\right)\\left(1+\\frac14\\right)\\left(1+\\frac15\\right)\\left(1+\\frac16\\right)&=\\frac72\\end{align*}$$",
      "solutionDiagrams": []
    },
