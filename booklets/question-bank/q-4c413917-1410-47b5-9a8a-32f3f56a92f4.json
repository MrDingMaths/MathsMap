  "content": {
    "id": "p2-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the distance between each of the following pairs of points:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(1,3)$ and $(4,7)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(4-1)^2+(7-3)^2}\\\\d&=\\sqrt{9+16}\\\\d&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(-2,1)$ and $(10,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(10-(-2))^2+(6-1)^2}\\\\d&=\\sqrt{144+25}\\\\d&=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(1,1)$ and $(2,3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt5$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(2-1)^2+(3-1)^2}\\\\d&=\\sqrt{1+4}\\\\d&=\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(-1,2)$ and $(2,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt2$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(2-(-1))^2+(-1-2)^2}\\\\d&=\\sqrt{9+9}\\\\d&=\\sqrt{18}\\\\d&=3\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(-5,1)$ and $(-1,-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt5$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(-1-(-5))^2+(-1-1)^2}\\\\d&=\\sqrt{16+4}\\\\d&=\\sqrt{20}\\\\d&=2\\sqrt5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$(-7,-2)$ and $(-6,-8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{37}$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(-6-(-7))^2+(-8-(-2))^2}\\\\d&=\\sqrt{1+36}\\\\d&=\\sqrt{37}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$(0,0)$ and $(\\sqrt2,\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(\\sqrt2-0)^2+(\\sqrt2-0)^2}\\\\d&=\\sqrt{2+2}\\\\d&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$(\\sqrt2,\\sqrt8)$ and $(\\sqrt8,\\sqrt2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}d&=\\sqrt{(\\sqrt8-\\sqrt2)^2+(\\sqrt2-\\sqrt8)^2}\\\\d&=\\sqrt{(\\sqrt2)^2+(-\\sqrt2)^2}\\\\d&=\\sqrt4\\\\d&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p2-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$(\\frac12,\\frac14)$ and $(\\frac32,\\frac34)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt5}{2}$",
          "worked": "$$\\begin{align*}d&=\\sqrt{\\left(\\frac32-\\frac12\\right)^2+\\left(\\frac34-\\frac14\\right)^2}\\\\d&=\\sqrt{1+\\frac14}\\\\d&=\\sqrt{\\frac54}\\\\d&=\\frac{\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p2-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$(\\frac12,\\frac34)$ and $(\\frac56,\\frac78)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{73}}{24}$",
          "worked": "$$\\begin{align*}d&=\\sqrt{\\left(\\frac56-\\frac12\\right)^2+\\left(\\frac78-\\frac34\\right)^2}\\\\d&=\\sqrt{\\left(\\frac13\\right)^2+\\left(\\frac18\\right)^2}\\\\d&=\\sqrt{\\frac19+\\frac1{64}}\\\\d&=\\sqrt{\\frac{73}{576}}\\\\d&=\\frac{\\sqrt{73}}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
