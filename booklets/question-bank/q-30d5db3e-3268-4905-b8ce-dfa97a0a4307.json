        "prompt": "$4^{x-2}=2^{3x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$$\\begin{align*}2^{2(x-2)}&=2^{3x-4}\\\\2(x-2)&=3x-4\\\\2x-4&=3x-4\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^{x+2}=16^{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$",
          "worked": "$$\\begin{align*}2^{2(x+2)}&=2^{4(x+1)}\\\\2(x+2)&=4(x+1)\\\\2x+4&=4x+4\\\\2x&=0\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$25^{x+1}=125^{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac54$",
          "worked": "$$\\begin{align*}5^{2(x+1)}&=5^{3(2x-1)}\\\\2(x+1)&=3(2x-1)\\\\2x+2&=6x-3\\\\4x&=5\\\\x&=\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
