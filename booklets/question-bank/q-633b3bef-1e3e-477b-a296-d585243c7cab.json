    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand and simplify $(n-1)n(n+1)+n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^3$",
          "worked": "$$\\begin{align*}(n-1)n(n+1)+n&=n(n-1)(n+1)+n\\\\(n-1)n(n+1)+n&=n(n^2-1)+n\\\\(n-1)n(n+1)+n&=n^3-n+n\\\\(n-1)n(n+1)+n&=n^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, express $(30\\times31\\times32)+31$ as the cube of some number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31^3$",
          "worked": "Use part (a) with $n=31$.\n\n$$\\begin{align*}(30\\times31\\times32)+31&=(31-1)\\times31\\times(31+1)+31\\\\(30\\times31\\times32)+31&=31^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
