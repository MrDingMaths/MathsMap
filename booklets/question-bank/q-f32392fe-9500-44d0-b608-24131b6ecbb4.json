  "content": {
    "id": "p14-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "I have equal numbers of 5 cents, 10 cents, 20 cents and 50 cent coins in my pocket and the sum of money is $\\$14.45$. How many coins do I have in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "68 coins",
      "worked": "Let $n$ be the number of coins of each denomination. The total value is $1445$ cents.\n$$\\begin{align*}5n+10n+20n+50n&=1445\\\\85n&=1445\\\\n&=17\\end{align*}$$\nThere are $4\\times17=68$ coins in total.",
      "solutionDiagrams": []
    },
