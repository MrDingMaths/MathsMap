    "children": [
      {
        "id": "p19-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x(x+2)=5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt6$",
          "worked": "$$\\begin{align*}x^2+2x&=5\\\\x^2+2x+1&=5+1\\\\(x+1)^2&=6\\\\x+1&=\\pm\\sqrt6\\\\x&=-1\\pm\\sqrt6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p19-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x(x-2)=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1\\pm\\sqrt2$",
          "worked": "$$\\begin{align*}x^2-2x&=1\\\\x^2-2x+1&=1+1\\\\(x-1)^2&=2\\\\x-1&=\\pm\\sqrt2\\\\x&=1\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p19-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\dfrac7x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2\\pm\\sqrt{11}$",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}x^2&=7-4x\\\\x^2+4x&=7\\\\x^2+4x+4&=7+4\\\\(x+2)^2&=11\\\\x+2&=\\pm\\sqrt{11}\\\\x&=-2\\pm\\sqrt{11}\\end{align*}$$\nBoth roots are nonzero, so both are valid in the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p19-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+\\dfrac4x=-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3\\pm\\sqrt5$",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}x^2+4&=-6x\\\\x^2+6x&=-4\\\\x^2+6x+9&=-4+9\\\\(x+3)^2&=5\\\\x+3&=\\pm\\sqrt5\\\\x&=-3\\pm\\sqrt5\\end{align*}$$\nBoth roots are nonzero, so both are valid in the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p19-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x+1}{x}=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1\\pm\\sqrt5}2$",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}x+1&=x^2\\\\x^2-x&=1\\\\x^2-x+\\tfrac14&=1+\\tfrac14\\\\(x-\\tfrac12)^2&=\\tfrac54\\\\x-\\tfrac12&=\\pm\\tfrac{\\sqrt5}2\\\\x&=\\tfrac{1\\pm\\sqrt5}2\\end{align*}$$\nBoth roots are nonzero, so both are valid in the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p19-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x+3}{x}=\\dfrac{2x}3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=-\\dfrac32$",
          "worked": "For $x\\ne0$, multiply by $3x$:\n$$\\begin{align*}3(x+3)&=2x^2\\\\2x^2-3x-9&=0\\\\2x^2-6x+3x-9&=0\\\\2x(x-3)+3(x-3)&=0\\\\(2x+3)(x-3)&=0\\\\2x+3=0&\\text{ or }x-3=0\\\\x=-\\tfrac32&\\text{ or }x=3\\end{align*}$$\nBoth roots are nonzero, so both are valid in the original equation.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
