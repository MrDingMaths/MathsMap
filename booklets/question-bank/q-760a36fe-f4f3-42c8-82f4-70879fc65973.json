  "content": {
    "id": "p23-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The lines with equations $y=2x+k$ and $y=mx-5$ intersect at $(15,40)$. Find $m$ and $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=3$, $k=10$.",
      "worked": "The point $(15,40)$ lies on both lines.\n\nSubstituting into $y=2x+k$:\n$$\\begin{align*}40&=2(15)+k\\\\40&=30+k\\\\k&=10\\end{align*}$$\nSubstituting into $y=mx-5$:\n$$\\begin{align*}40&=15m-5\\\\45&=15m\\\\m&=3\\end{align*}$$\nCheck: $2(15)+10=40$ and $3(15)-5=40$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
