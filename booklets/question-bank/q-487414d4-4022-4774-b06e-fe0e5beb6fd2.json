      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $k$ if $x-1$ is a factor of $P(x)=5x^3-2x^2+kx-7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=4$",
          "worked": "Since $x-1$ is a factor, $P(1)=0$.\n$$\\begin{align*}5(1)^3-2(1)^2+k(1)-7&=0\\\\5-2+k-7&=0\\\\k-4&=0\\\\k&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $m$ if $x+2$ is a factor of $P(x)=5x^3+mx^2-7x+10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=4$",
          "worked": "Since $x+2$ is a factor, $P(-2)=0$.\n$$\\begin{align*}5(-2)^3+m(-2)^2-7(-2)+10&=0\\\\-40+4m+14+10&=0\\\\4m-16&=0\\\\4m&=16\\\\m&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
