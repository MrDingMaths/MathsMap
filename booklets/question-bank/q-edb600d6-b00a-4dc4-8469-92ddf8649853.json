    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q8",
        "type": "part",
        "label": "a",
        "prompt": "By finding $10x$ and $100x$, show that $8.122222222222\\ldots=\\dfrac{731}{90}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100x-10x=731$, so $90x=731$ and $x=\\dfrac{731}{90}$.",
          "worked": "$$\\begin{align*}x&=8.1222\\ldots\\\\10x&=81.222\\ldots\\\\100x&=812.222\\ldots\\\\100x-10x&=812.222\\ldots-81.222\\ldots\\\\90x&=731\\\\x&=\\frac{731}{90}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q8-parts",
        "type": "group",
        "label": "",
        "prompt": "Convert these decimals to fractions.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p7-q8-a",
            "type": "part",
            "label": "b",
            "prompt": "$0.3\\dot{5}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{16}{45}$",
              "worked": "$$\\begin{align*}x&=0.3555\\ldots\\\\10x&=3.555\\ldots\\\\100x&=35.555\\ldots\\\\100x-10x&=35.555\\ldots-3.555\\ldots\\\\90x&=32\\\\x&=\\frac{32}{90}\\\\x&=\\frac{16}{45}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 45
          },
          {
            "id": "p7-q8-b",
            "type": "part",
            "label": "c",
            "prompt": "$0.51\\dot{2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{461}{900}$",
              "worked": "$$\\begin{align*}x&=0.51222\\ldots\\\\100x&=51.222\\ldots\\\\1000x&=512.222\\ldots\\\\1000x-100x&=512.222\\ldots-51.222\\ldots\\\\900x&=461\\\\x&=\\frac{461}{900}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 49
          },
          {
            "id": "p7-q8-c",
            "type": "part",
            "label": "d",
            "prompt": "$0.0\\dot{9}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{1}{10}$",
              "worked": "$$\\begin{align*}x&=0.0999\\ldots\\\\10x&=0.999\\ldots\\\\100x&=9.999\\ldots\\\\100x-10x&=9.999\\ldots-0.999\\ldots\\\\90x&=9\\\\x&=\\frac{9}{90}\\\\x&=\\frac{1}{10}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 45
          }
        ]
      }
    ]
  },
