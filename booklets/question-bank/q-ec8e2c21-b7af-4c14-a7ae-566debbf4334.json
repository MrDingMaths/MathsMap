  "content": {
    "id": "p12-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A greengrocer bought a sack of potatoes weighing 51 kg. He divided the potatoes into bags so that each bag held 3 kg of potatoes. How many bags of potatoes did he get from his sack?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "17 bags",
      "worked": "Using short division, $5\\div3=1$ remainder $2$; the remaining 2 tens and 1 unit make 21, and $21\\div3=7$.\n\n$$51\\div3=17$$\n\nHe got 17 bags of potatoes.",
      "solutionDiagrams": []
    },
