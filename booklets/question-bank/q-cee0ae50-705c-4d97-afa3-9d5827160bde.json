  "content": {
    "id": "p107-q36-root",
    "type": "question",
    "label": "36",
    "prompt": "The fractions follow the consecutive-integer pattern shown. $\\sqrt{\\frac{4}{3}\\times\\frac{5}{4}\\times\\frac{6}{5}\\times\\cdots\\times\\frac{a}{b}}=2$, find the value of $\\frac{a}{b}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{12}{11}$, using the consecutive-factor pattern.",
      "worked": "Using the intended consecutive-factor pattern, $b=a-1$. The intermediate factors cancel.\n$$\\begin{align*}\\sqrt{\\frac{4}{3}\\times\\frac{5}{4}\\times\\frac{6}{5}\\times\\cdots\\times\\frac{a}{a-1}}&=2\\\\\\sqrt{\\frac{a}{3}}&=2\\\\\\frac{a}{3}&=4\\\\a&=12\\\\b&=12-1=11\\\\\\frac{a}{b}&=\\frac{12}{11}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
