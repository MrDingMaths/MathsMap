  "content": {
    "id": "p18-q1",
    "type": "question",
    "label": "1",
    "prompt": "Oscar’s pay $p$ is directly proportional to the number of hours $h$ he works.\nFor a 9-hour day he receives $\\$193.50$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the constant of variation $k$. What does it represent in this scenario?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=21.5$: Oscar earns $\\$21.50$ per hour.",
          "worked": "$$\\begin{align*}p&=kh\\\\193.50&=9k\\\\k&=\\frac{193.50}{9}\\\\k&=21.5\\end{align*}$$\nThe constant represents Oscar’s hourly pay of $\\$21.50$ per hour.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an equation connecting $p$ and $h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=21.5h$",
          "worked": "Substituting $k=21.5$ into $p=kh$ gives $p=21.5h$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "What is Oscar’s pay if he works for 11 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$236.50$",
          "worked": "$$\\begin{align*}p&=21.5h\\\\p&=21.5\\times11\\\\p&=236.50\\end{align*}$$\nOscar’s pay is $\\$236.50$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p18-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "What is Oscar’s pay if he works for 6.5 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$139.75$",
          "worked": "$$\\begin{align*}p&=21.5h\\\\p&=21.5\\times6.5\\\\p&=139.75\\end{align*}$$\nOscar’s pay is $\\$139.75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p18-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "How many hours does Oscar have to work to earn $\\$365.50$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "17 hours",
          "worked": "$$\\begin{align*}p&=21.5h\\\\365.50&=21.5h\\\\h&=\\frac{365.50}{21.5}\\\\h&=17\\end{align*}$$\nOscar must work for 17 hours.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
