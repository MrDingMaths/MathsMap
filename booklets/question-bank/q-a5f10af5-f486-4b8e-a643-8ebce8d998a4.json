  "content": {
    "id": "p22-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Find points on each graph where the tangent has gradient $-1$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^4-5x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-4)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=4x^3-5\\\\4x^3-5&=-1\\\\4x^3&=4\\\\x&=1\\\\y&=1^4-5(1)\\\\y&=-4\\end{align*}$$\nThe point is $(1,-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p22-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^3-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1,-3)$ and $(-1,3)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2-4\\\\3x^2-4&=-1\\\\3x^2&=3\\\\x^2&=1\\\\x&=\\pm1\\end{align*}$$\nFor $x=1$:\n$$\\begin{align*}y&=1^3-4(1)\\\\y&=-3\\end{align*}$$\nFor $x=-1$:\n$$\\begin{align*}y&=(-1)^3-4(-1)\\\\y&=3\\end{align*}$$\nThe points are $(1,-3)$ and $(-1,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p22-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^3-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No points.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=3x^2\\\\3x^2&=-1\\\\x^2&=-\\frac13\\end{align*}$$\nA real square cannot be negative, so there are no points where the tangent has gradient $-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
