        "questionDiagrams": [],
        "children": [
          {
            "id": "p43-q1-a",
            "type": "part",
            "label": "a",
            "prompt": "$-2x+18=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=7$",
              "worked": "$$\\begin{align*}-2x&=4-18\\\\-2x&=-14\\\\x&=\\frac{-14}{-2}\\\\x&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p43-q1-b",
            "type": "part",
            "label": "b",
            "prompt": "$-3a+9=6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=1$",
              "worked": "$$\\begin{align*}-3a&=6-9\\\\-3a&=-3\\\\a&=\\frac{-3}{-3}\\\\a&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p43-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "$-\\dfrac{x}{3}+4=8$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-12$",
              "worked": "$$\\begin{align*}-\\frac{x}{3}&=8-4\\\\-\\frac{x}{3}&=4\\\\x&=4\\times(-3)\\\\x&=-12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p43-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "$-\\dfrac{x}{2}+1=-10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=22$",
              "worked": "$$\\begin{align*}-\\frac{x}{2}&=-10-1\\\\-\\frac{x}{2}&=-11\\\\x&=-11\\times(-2)\\\\x&=22\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p43-q1-e",
            "type": "part",
            "label": "e",
            "prompt": "$18-2x=4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=7$",
              "worked": "$$\\begin{align*}-2x&=4-18\\\\-2x&=-14\\\\x&=\\frac{-14}{-2}\\\\x&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p43-q1-f",
            "type": "part",
            "label": "f",
            "prompt": "$9-3a=6$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=1$",
              "worked": "$$\\begin{align*}-3a&=6-9\\\\-3a&=-3\\\\a&=\\frac{-3}{-3}\\\\a&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p43-q1-g",
            "type": "part",
            "label": "g",
            "prompt": "$4-\\dfrac{x}{3}=8$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-12$",
              "worked": "$$\\begin{align*}-\\frac{x}{3}&=8-4\\\\-\\frac{x}{3}&=4\\\\x&=4\\times(-3)\\\\x&=-12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          },
          {
            "id": "p43-q1-h",
            "type": "part",
            "label": "h",
            "prompt": "$1-\\dfrac{x}{2}=-10$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=22$",
              "worked": "$$\\begin{align*}-\\frac{x}{2}&=-10-1\\\\-\\frac{x}{2}&=-11\\\\x&=-11\\times(-2)\\\\x&=22\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36
          }
        ]
      },
      {
        "id": "p43-q1-explain",
        "type": "part",
        "label": "i",
        "prompt": "You should have gotten the same answer in each column. Explain why.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The equations in each column are the same, the terms are just switched around.",
          "worked": "Each pair contains the same signed terms in a different order. For example, $-2x+18=18-2x$. The paired equations are equivalent, so they have the same solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
