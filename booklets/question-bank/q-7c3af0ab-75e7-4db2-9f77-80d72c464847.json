    "children": [
      {
        "id": "p11-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that an increase of 10% followed by a decrease of 10% on the new price gives a result that is less than the original amount.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\times1.1\\times0.9=0.99x$, which is less than the original amount.",
          "worked": "Let the original price be $x$.\n$$\\begin{align*}\\text{Final price}&=x\\times1.1\\times0.9\\\\&=0.99x\\end{align*}$$\nThe final price is 99% of the original, so it is 1% less.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, explain why you cannot reverse a 10% increase by a 10% decrease",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The result is 99% of the original, so not the same as the original.",
          "worked": "The 10% decrease applies to the increased price, so it removes more than the original 10% increase added. The combined multiplier is $1.1\\times0.9=0.99$, leaving 99% of the original price.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
