    "id": "p35-q22-root",
    "type": "question",
    "label": "23",
    "prompt": "Evaluate $\\frac{20}{y}+3x$ when $x=\\frac15$, $y=2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\frac35$",
      "worked": "$$\\begin{align*}\\frac{20}{y}+3x&=\\frac{20}{2}+3\\left(\\frac15\\right)\\\\&=10+\\frac35\\\\&=10\\frac35\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
