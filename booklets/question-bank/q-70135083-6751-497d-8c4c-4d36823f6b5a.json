  "content": {
    "id": "p16-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Factorise each of the following expressions:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+2)^2+5(x+2)+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(x+5)$",
          "worked": "Let $u=x+2$. The numbers are $2$ and $3$.\n\n$$\\begin{align*}(x+2)^2+5(x+2)+6&=u^2+5u+6\\\\(x+2)^2+5(x+2)+6&=(u+2)(u+3)\\\\(x+2)^2+5(x+2)+6&=(x+4)(x+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(m-3)^2+9(m-3)+14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(m-1)(m+4)$",
          "worked": "Let $u=m-3$. The numbers are $2$ and $7$.\n\n$$\\begin{align*}(m-3)^2+9(m-3)+14&=u^2+9u+14\\\\(m-3)^2+9(m-3)+14&=(u+2)(u+7)\\\\(m-3)^2+9(m-3)+14&=(m-1)(m+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$(a+2)^2-8(a+2)+15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-3)(a-1)$",
          "worked": "Let $u=a+2$. The numbers are $-5$ and $-3$.\n\n$$\\begin{align*}(a+2)^2-8(a+2)+15&=u^2-8u+15\\\\(a+2)^2-8(a+2)+15&=(u-5)(u-3)\\\\(a+2)^2-8(a+2)+15&=(a-3)(a-1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x-2)^2-13(x-2)+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-14)(x-3)$",
          "worked": "Let $u=x-2$. The numbers are $-12$ and $-1$.\n\n$$\\begin{align*}(x-2)^2-13(x-2)+12&=u^2-13u+12\\\\(x-2)^2-13(x-2)+12&=(u-12)(u-1)\\\\(x-2)^2-13(x-2)+12&=(x-14)(x-3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2n+1)^2-10(2n+1)+24$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2n-5)(2n-3)$",
          "worked": "Let $u=2n+1$. The numbers are $-6$ and $-4$.\n\n$$\\begin{align*}(2n+1)^2-10(2n+1)+24&=u^2-10u+24\\\\(2n+1)^2-10(2n+1)+24&=(u-6)(u-4)\\\\(2n+1)^2-10(2n+1)+24&=(2n-5)(2n-3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x+3)^2+3(x+3)-18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(x+9)$",
          "worked": "Let $u=x+3$. The numbers are $-3$ and $6$.\n\n$$\\begin{align*}(x+3)^2+3(x+3)-18&=u^2+3u-18\\\\(x+3)^2+3(x+3)-18&=(u-3)(u+6)\\\\(x+3)^2+3(x+3)-18&=x(x+9).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$(y+1)^2+(y+1)-20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(y-3)(y+6)$",
          "worked": "Let $u=y+1$. The numbers are $-4$ and $5$.\n\n$$\\begin{align*}(y+1)^2+(y+1)-20&=u^2+u-20\\\\(y+1)^2+(y+1)-20&=(u-4)(u+5)\\\\(y+1)^2+(y+1)-20&=(y-3)(y+6).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$(x+3)^2-6(x+3)-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-5)(x+5)$",
          "worked": "Let $u=x+3$. The numbers are $-8$ and $2$.\n\n$$\\begin{align*}(x+3)^2-6(x+3)-16&=u^2-6u-16\\\\(x+3)^2-6(x+3)-16&=(u-8)(u+2)\\\\(x+3)^2-6(x+3)-16&=(x-5)(x+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$(a+3)^2-48(a+3)-100$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+5)(a-47)$",
          "worked": "Let $u=a+3$. The numbers are $2$ and $-50$.\n\n$$\\begin{align*}(a+3)^2-48(a+3)-100&=u^2-48u-100\\\\(a+3)^2-48(a+3)-100&=(u+2)(u-50)\\\\(a+3)^2-48(a+3)-100&=(a+5)(a-47).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
