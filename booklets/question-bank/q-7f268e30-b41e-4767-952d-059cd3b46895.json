  "content": {
    "id": "p28-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The mass of a proton is $1.6726 \\times 10^{-27}$ kg and the mass of an electron is $9.1095 \\times 10^{-31}$ kg.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate, correct to 4 s.f., the ratio of the mass of the proton to the mass of an electron (i.e. how many times as heavy is a proton compared to an electron?)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1836$ times as heavy. Divide the proton mass by the electron mass.",
          "worked": "$$\\begin{align*}\\text{Mass ratio}&=\\frac{1.6726\\times10^{-27}}{9.1095\\times10^{-31}}\\\\\\text{Mass ratio}&=\\frac{1.6726}{9.1095}\\times10^{4}\\\\\\text{Mass ratio}&\\approx1836\\quad(4\\text{ s.f.})\\end{align*}$$\nA proton is approximately $1836$ times as heavy as an electron.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p28-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How many protons are there in 1 kg? Answer in scientific notation to 4 s.f.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5.979 \\times 10^{26}$ protons. Divide $1$ kg by the mass of one proton.",
          "worked": "$$\\begin{align*}\\text{Number of protons}&=\\frac{1}{1.6726\\times10^{-27}}\\\\\\text{Number of protons}&=\\frac{1}{1.6726}\\times10^{27}\\\\\\text{Number of protons}&\\approx5.979\\times10^{26}\\quad(4\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
