      {
        "id": "p9-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "Conversion of a given temperature from the Fahrenheit scale to the Centigrade scale is done by means of the formula\n$$C=\\frac{5(F-32)}{9}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "The melting point of gold is $2280^\\circ\\mathrm{F}$. Convert this into Celsius (correct to the nearest degree).",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1249^\\circ\\mathrm{C}$",
              "worked": "$$\\begin{align*}C&=\\frac{5(2280-32)}{9}\\\\C&=\\frac{11240}{9}\\\\C&\\approx1249\\end{align*}$$\nThe temperature is $1249^\\circ\\mathrm{C}$, correct to the nearest degree.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p9-q4-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "A healthy human being’s temperature is approximately $36.9^\\circ\\mathrm{C}$. What is the equivalent on the Fahrenheit scale, correct to 1 decimal place?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$98.4^\\circ\\mathrm{F}$",
              "worked": "$$\\begin{align*}36.9&=\\frac{5(F-32)}{9}\\\\332.1&=5(F-32)\\\\66.42&=F-32\\\\F&=98.42\\\\F&\\approx98.4\\end{align*}$$\nThe temperature is $98.4^\\circ\\mathrm{F}$, correct to 1 decimal place.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p9-q4-b",
        "type": "group",
        "label": "b",
        "prompt": "A formula used in life insurance is $Q=\\dfrac{2m}{2+m}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Calculate $Q$ if $m=-0.7$ (correct to 4 significant figures).",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$Q=-1.077$",
              "worked": "$$\\begin{align*}Q&=\\frac{2(-0.7)}{2+(-0.7)}\\\\Q&=\\frac{-1.4}{1.3}\\\\Q&=-\\frac{14}{13}\\\\Q&\\approx-1.077\\end{align*}$$\nCorrect to 4 significant figures.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p9-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Calculate $m$ if $Q=3$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m=-6$",
              "worked": "$$\\begin{align*}3&=\\frac{2m}{2+m}\\\\3(2+m)&=2m\\\\6+3m&=2m\\\\6+m&=0\\\\m&=-6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      }
    ]
  },
