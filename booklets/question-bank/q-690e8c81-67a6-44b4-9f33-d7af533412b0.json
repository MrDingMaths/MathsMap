  "content": {
    "id": "p41-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the surface area of a sphere whose volume is $\\frac{\\pi}{6}\\text{ cm}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\pi\\text{ cm}^2$",
      "worked": "$$\\begin{align*}\\frac{4}{3}\\pi r^3&=\\frac{\\pi}{6}\\\\r^3&=\\frac18\\\\r&=\\frac12\\text{ cm}\\end{align*}$$\n$$\\begin{align*}A&=4\\pi r^2\\\\A&=4\\pi\\left(\\frac12\\right)^2\\\\A&=\\pi\\text{ cm}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 56
  },
