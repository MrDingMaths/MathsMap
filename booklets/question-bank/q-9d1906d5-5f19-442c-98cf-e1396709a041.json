  "content": {
    "id": "p60-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A common formula learnt in science is $D=S\\times T$, that is, distance equals the product of speed and time.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "How does distance vary with time when $S$ is constant?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Distance varies directly with time.",
          "worked": "With $S$ constant, $D=ST$ has the form $D=kT$, so distance varies directly with time.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p60-q19-b",
        "type": "group",
        "label": "b",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p60-q19-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Give an example of inverse variation using this equation.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "For a fixed distance, time varies inversely with speed: $T=\\dfrac{D}{S}$.",
              "worked": "Hold the distance $D$ constant. Rearranging gives $T=\\dfrac{D}{S}$, which has the inverse-variation form $T=\\dfrac{k}{S}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p60-q19-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "In your example, how will one variable change when the other is doubled?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "For a fixed distance, doubling the speed halves the time.",
              "worked": "For the same distance, replacing $S$ by $2S$ gives $\\dfrac{D}{2S}=\\dfrac{1}{2}\\dfrac{D}{S}=\\dfrac{T}{2}$. Thus the time halves.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
    ]
  },
