  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The front face of a prism is a parallelogram with base 8 cm and height 6 cm. If the depth is 12 m, find the volume.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$57\\,600\\text{ cm}^3$ (or $0.0576\\text{ m}^3$).",
      "worked": "Convert the depth to centimetres: $12\\text{ m}=1200\\text{ cm}$.\n\n$$\\begin{aligned}A&=8\\times6=48\\text{ cm}^2\\\\V&=Ah=48\\times1200=57\\,600\\text{ cm}^3\\end{aligned}$$",
      "solutionDiagrams": []
    },
