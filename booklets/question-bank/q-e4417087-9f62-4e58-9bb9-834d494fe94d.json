        "prompt": "$\\sin105^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt6+\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\sin105^{\\circ}&=\\sin(60^{\\circ}+45^{\\circ})\\\\\\sin105^{\\circ}&=\\sin60^{\\circ}\\cos45^{\\circ}+\\cos60^{\\circ}\\sin45^{\\circ}\\\\\\sin105^{\\circ}&=\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}+\\frac12\\cdot\\frac{\\sqrt2}{2}\\\\\\sin105^{\\circ}&=\\frac{\\sqrt6+\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
