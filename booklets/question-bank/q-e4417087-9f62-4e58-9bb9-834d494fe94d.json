      {
        "id": "p3-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\tan105^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2-\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan105^{\\circ}&=\\tan(60^{\\circ}+45^{\\circ})\\\\\\tan105^{\\circ}&=\\frac{\\tan60^{\\circ}+\\tan45^{\\circ}}{1-\\tan60^{\\circ}\\tan45^{\\circ}}\\\\\\tan105^{\\circ}&=\\frac{\\sqrt3+1}{1-\\sqrt3}\\\\\\tan105^{\\circ}&=\\frac{(\\sqrt3+1)(1+\\sqrt3)}{(1-\\sqrt3)(1+\\sqrt3)}\\\\\\tan105^{\\circ}&=\\frac{4+2\\sqrt3}{-2}\\\\\\tan105^{\\circ}&=-2-\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 74
      }
