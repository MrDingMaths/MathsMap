  "content": {
    "id": "p3-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find each of the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos75^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt6-\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\cos75^{\\circ}&=\\cos(45^{\\circ}+30^{\\circ})\\\\\\cos75^{\\circ}&=\\cos45^{\\circ}\\cos30^{\\circ}-\\sin45^{\\circ}\\sin30^{\\circ}\\\\\\cos75^{\\circ}&=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}-\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\cos75^{\\circ}&=\\frac{\\sqrt6-\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p3-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin75^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt6+\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\sin75^{\\circ}&=\\sin(45^{\\circ}+30^{\\circ})\\\\\\sin75^{\\circ}&=\\sin45^{\\circ}\\cos30^{\\circ}+\\cos45^{\\circ}\\sin30^{\\circ}\\\\\\sin75^{\\circ}&=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}+\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\sin75^{\\circ}&=\\frac{\\sqrt6+\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p3-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan75^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan75^{\\circ}&=\\tan(45^{\\circ}+30^{\\circ})\\\\\\tan75^{\\circ}&=\\frac{\\tan45^{\\circ}+\\tan30^{\\circ}}{1-\\tan45^{\\circ}\\tan30^{\\circ}}\\\\\\tan75^{\\circ}&=\\frac{1+1/\\sqrt3}{1-1/\\sqrt3}\\\\\\tan75^{\\circ}&=\\frac{\\sqrt3+1}{\\sqrt3-1}\\\\\\tan75^{\\circ}&=\\frac{(\\sqrt3+1)^2}{3-1}\\\\\\tan75^{\\circ}&=2+\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p3-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos15^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt6+\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\cos15^{\\circ}&=\\cos(45^{\\circ}-30^{\\circ})\\\\\\cos15^{\\circ}&=\\cos45^{\\circ}\\cos30^{\\circ}+\\sin45^{\\circ}\\sin30^{\\circ}\\\\\\cos15^{\\circ}&=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}+\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\cos15^{\\circ}&=\\frac{\\sqrt6+\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p3-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sin15^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt6-\\sqrt2}{4}$",
          "worked": "$$\\begin{align*}\\sin15^{\\circ}&=\\sin(45^{\\circ}-30^{\\circ})\\\\\\sin15^{\\circ}&=\\sin45^{\\circ}\\cos30^{\\circ}-\\cos45^{\\circ}\\sin30^{\\circ}\\\\\\sin15^{\\circ}&=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}-\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\sin15^{\\circ}&=\\frac{\\sqrt6-\\sqrt2}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p3-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan15^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan15^{\\circ}&=\\tan(45^{\\circ}-30^{\\circ})\\\\\\tan15^{\\circ}&=\\frac{\\tan45^{\\circ}-\\tan30^{\\circ}}{1+\\tan45^{\\circ}\\tan30^{\\circ}}\\\\\\tan15^{\\circ}&=\\frac{1-1/\\sqrt3}{1+1/\\sqrt3}\\\\\\tan15^{\\circ}&=\\frac{\\sqrt3-1}{\\sqrt3+1}\\\\\\tan15^{\\circ}&=\\frac{(\\sqrt3-1)^2}{3-1}\\\\\\tan15^{\\circ}&=2-\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p3-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\cos105^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2-\\sqrt6}{4}$",
          "worked": "$$\\begin{align*}\\cos105^{\\circ}&=\\cos(60^{\\circ}+45^{\\circ})\\\\\\cos105^{\\circ}&=\\cos60^{\\circ}\\cos45^{\\circ}-\\sin60^{\\circ}\\sin45^{\\circ}\\\\\\cos105^{\\circ}&=\\frac12\\cdot\\frac{\\sqrt2}{2}-\\frac{\\sqrt3}{2}\\cdot\\frac{\\sqrt2}{2}\\\\\\cos105^{\\circ}&=\\frac{\\sqrt2-\\sqrt6}{4}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
