  "content": {
    "id": "p15-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Identify the mistake in these expansions, then write out the correct expansion.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "$2(x+6)=2x+6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q10-a-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "The 6 was not multiplied by 2.",
              "worked": "Both terms inside the bracket must be multiplied by 2; $2\\times6=12$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q10-a-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct answer:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2x+12$",
              "worked": "$$\\begin{align*}2(x+6)&=2x+12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p15-q10-b",
        "type": "group",
        "label": "b",
        "prompt": "$x(x-4)=2x-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q10-b-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x\\times x=x^2$, not $2x$.",
              "worked": "The first product is $x\\times x=x^2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q10-b-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct answer:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x^2-4x$",
              "worked": "$$\\begin{align*}x(x-4)&=x^2-4x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p15-q10-c",
        "type": "group",
        "label": "c",
        "prompt": "$-3(x+4)=-3x+12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q10-c-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3\\times4=-12$, not $+12$.",
              "worked": "The constant inside the bracket is $+4$, so its product with $-3$ is $-12$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q10-c-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct answer:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3x-12$",
              "worked": "$$\\begin{align*}-3(x+4)&=-3x-12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p15-q10-d",
        "type": "group",
        "label": "d",
        "prompt": "$-7(x-7)=-7x-49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q10-d-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-7\\times(-7)=+49$, not $-49$.",
              "worked": "Multiplying the two negative numbers gives $+49$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q10-d-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct answer:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-7x+49$",
              "worked": "$$\\begin{align*}-7(x-7)&=-7x+49\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          }
        ]
      },
      {
        "id": "p15-q10-e",
        "type": "group",
        "label": "e",
        "prompt": "$$\\begin{aligned}5-2(x-7)&=5-2x-14\\\\&=-9-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q10-e-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2\\times(-7)=+14$, not $-14$.",
              "worked": "The multiplier is $-2$, so the constant product is $(-2)(-7)=14$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q10-e-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct answer:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$19-2x$",
              "worked": "$$\\begin{align*}5-2(x-7)&=5-2x+14\\\\&=19-2x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p15-q10-f",
        "type": "group",
        "label": "f",
        "prompt": "$$\\begin{aligned}4(x-2)-3(x+2)&=4x-8-3x+6\\\\&=x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q10-f-mistake",
            "type": "part",
            "label": "",
            "prompt": "Mistake:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-3\\times2=-6$, not $+6$.",
              "worked": "The multiplier of the second bracket is $-3$, so the final constant is $-6$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p15-q10-f-correct",
            "type": "part",
            "label": "",
            "prompt": "Correct answer:",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x-14$",
              "worked": "$$\\begin{align*}4(x-2)-3(x+2)&=4x-8-3x-6\\\\&=x-14\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
