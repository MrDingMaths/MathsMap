  "content": {
    "id": "p13-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In February Jennifer measured her height to be 125 cm. By the end of December she was 130 cm tall.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the ratio of her height in February to her height in December?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25:26$",
          "worked": "$$\\begin{align*}\\text{February height : December height}&=125:130\\\\\\text{February height : December height}&=25:26\\end{align*}$$\n\nDivide both terms by 5.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the ratio of the amount Jennifer had grown in this period to her height in February.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:25$",
          "worked": "$$\\begin{align*}\\text{Growth}&=130-125\\\\\\text{Growth}&=5\\text{ cm}\\\\\\text{Growth : February height}&=5:125\\\\\\text{Growth : February height}&=1:25\\end{align*}$$\n\nDivide both ratio terms by 5.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
