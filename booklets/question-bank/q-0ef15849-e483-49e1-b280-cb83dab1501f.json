            {
              "type": "text",
              "text": "Laura works a 37-hour week at a rate of $20.50 per hour.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "When she takes her 4 weeks annual leave, she is paid a loading of 17.5%.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "What is Laura’s holiday pay when she takes her leave?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$3564.95",
      "worked": "$$\\begin{align*}\\text{Weekly pay} &= 37\\times\\$20.50\\\\\\text{Weekly pay} &= \\$758.50\\\\\\text{Four weeks’ pay} &= 4\\times\\$758.50\\\\\\text{Four weeks’ pay} &= \\$3034.00\\\\\\text{Leave loading} &= 0.175\\times\\$3034.00\\\\\\text{Leave loading} &= \\$530.95\\\\\\text{Total holiday pay} &= \\$3034.00+\\$530.95\\\\\\text{Total holiday pay} &= \\$3564.95\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
