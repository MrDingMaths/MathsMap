      }
    ],
    "children": [
      {
        "id": "p21-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the horizontal distance covered by the water.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\text{ m}$.",
          "worked": "The water starts at $x=0$ and returns to ground level at $x=4$, so the horizontal distance is $4\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p21-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the maximum height reached by the water.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8\\text{ m}$.",
          "worked": "The turning point is midway between the $x$-intercepts, at $x=2$.\n$$\\begin{align*}y&=2(2)(4-2)\\\\y&=8.\\end{align*}$$\nThe maximum height is $8\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p21-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the values of $x$ for which the height of the water exceeds $6$ m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1<x<3$.\n\nThe downward-opening trajectory lies above $y=6$ between its intersections with that line.",
          "worked": "Find where the height equals $6$ m:\n$$\\begin{align*}2x(4-x)&=6\\\\8x-2x^2&=6\\\\x^2-4x+3&=0\\\\(x-1)(x-3)&=0\\\\x&=1,3.\\end{align*}$$\nThe parabola opens downwards, so the height exceeds $6$ m when $1<x<3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
