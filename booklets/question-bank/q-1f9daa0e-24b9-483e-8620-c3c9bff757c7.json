  "content": {
    "id": "p21-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A fountain of water is projected from the origin, $O(0,0)$. The height, $y$ m, of the water above ground level, $x$ m from the origin, is $y=2x(4-x)$, where $0\\le x\\le4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p21-q2-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"waterBlue\",\"hex\":\"268CFF\",\"reason\":\"function series representing the water trajectory\"}],\"reference\":\"source page 21 p21-q2-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=0.38cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{waterBlue}{HTML}{268CFF}\n\\draw[black,line width=0.5pt,->] (-0.25,0)--(4.9,0) node[fill=white,inner sep=1pt,right] {$x\\text{ m}$};\n\\draw[black,line width=0.5pt,->] (0,0)--(0,9.2) node[fill=white,inner sep=1pt,above] {$y\\text{ m}$};\n\\draw[waterBlue,line width=0.8pt,domain=0:4,samples=81] plot (\\x,{2*\\x*(4-\\x)});\n\\node[fill=white,inner sep=1pt,below] at (0,0) {$(0,0)$};\n\\node[fill=white,inner sep=1pt,below] at (4,0) {$(4,0)$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 21,
          "sourceRegion": "17H question 2, graph in right column after part (c)",
          "description": "Blue downward-opening water trajectory with arrowed axes, coordinate labels at both endpoints, no grid and no ticks. The vertex remains unlabelled.",
          "mathematics": "y=2x(4-x), restricted to 0<=x<=4; endpoints (0,0) and (4,0).",
          "answerVisibility": "Only the source endpoint labels are supplied; maximum height and height-exceedance interval remain hidden."
        },
