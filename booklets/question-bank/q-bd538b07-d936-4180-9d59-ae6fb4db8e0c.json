  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Fully simplify each of the following by solving a related exponential equation:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_4 2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Let $a=\\log_4 2$.\n$$\\begin{align*}4^a&=2\\\\(2^2)^a&=2^1\\\\2^{2a}&=2^1\\\\2a&=1\\\\a&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p3-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2(2\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2}$",
          "worked": "Let $a=\\log_2(2\\sqrt{2})$.\n$$\\begin{align*}2^a&=2\\sqrt{2}\\\\2^a&=2^{3/2}\\\\a&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p3-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_8\\sqrt{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "Let $a=\\log_8\\sqrt{4}$.\n$$\\begin{align*}8^a&=\\sqrt{4}\\\\(2^3)^a&=2\\\\2^{3a}&=2^1\\\\3a&=1\\\\a&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p3-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_9 27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{2}$",
          "worked": "Let $a=\\log_9 27$.\n$$\\begin{align*}9^a&=27\\\\(3^2)^a&=3^3\\\\3^{2a}&=3^3\\\\2a&=3\\\\a&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p3-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_9(3\\sqrt{3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}$",
          "worked": "Let $a=\\log_9(3\\sqrt{3})$.\n$$\\begin{align*}9^a&=3\\sqrt{3}\\\\(3^2)^a&=3^{3/2}\\\\3^{2a}&=3^{3/2}\\\\2a&=\\frac{3}{2}\\\\a&=\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p3-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_6\\sqrt{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "Let $a=\\log_6\\sqrt{6}$.\n$$\\begin{align*}6^a&=\\sqrt{6}\\\\6^a&=6^{1/2}\\\\a&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
