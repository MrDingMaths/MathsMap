  "content": {
    "id": "p15-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "The number $5! = 5 \\times 4 \\times 3 \\times 2 \\times 1 = 120$ concludes with just one zero. With how many zeroes does $100!$ conclude?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
