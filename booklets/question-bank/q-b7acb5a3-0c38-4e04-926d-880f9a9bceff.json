    "children": [
      {
        "id": "p7-q46-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\angle XYZ=\\angle XZT$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q46-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\angle XYZ=\\angle XZT",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q46-a-short-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Both are complementary to ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\angle YZT",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Let $\\angle XYZ=\\theta$. Since $T$ lies on $XY$, the angle at $Y$ in right triangle $YZT$ is also $\\theta$.\n\n$$\\begin{align*}\\angle YZT&=90^\\circ-\\theta\\\\\\angle XZT&=90^\\circ-(90^\\circ-\\theta)\\\\\\angle XZT&=\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q46-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\tan\\angle XYZ$ and $\\tan\\angle XZT$ in terms of $a$, $b$, $h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{align*}\\tan\\angle XYZ&=\\frac{h}{b}\\\\\\tan\\angle XZT&=\\frac{a}{h}\\end{align*}$$",
          "worked": "Use tangent = opposite/adjacent in triangles $YZT$ and $XZT$, respectively.\n\n$$\\begin{align*}\\tan\\angle XYZ&=\\frac{h}{b}\\\\\\tan\\angle XZT&=\\frac{a}{h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q46-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, show that $h^2=ab$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-q46-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "h^2=ab",
                    "display": false
                  }
                ]
              },
              {
                "id": "p7-q46-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Equate the tangent ratios from (b), using the equal angles from (a).",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The angles in (a) are equal, so their tangent ratios in (b) are equal.\n\n$$\\begin{align*}\\frac{h}{b}&=\\frac{a}{h}\\\\h^2&=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
