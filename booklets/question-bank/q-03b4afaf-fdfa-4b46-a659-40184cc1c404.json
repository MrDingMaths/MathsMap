      {
        "id": "flow-a32772c1-e467-4131-8c6f-aa067b8d643b",
        "type": "part",
        "label": "c",
        "prompt": "How many people were 30 minutes late?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 people",
          "worked": "30 minutes is half an hour. There are $6$ dots above $0.5$ hours, representing $6$ people.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "flow-a184f6d2-dfc7-4b36-b497-a3d3e3168650",
        "type": "part",
        "label": "d",
        "prompt": "What is the mean lateness in hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{37}{24}\\approx1.54$ hours",
          "worked": "$$\\begin{align*}\\bar{x}&=\\frac{(6\\times0.5)+(5\\times1)+(3\\times1.5)+(3\\times2)+(5\\times2.5)+(2\\times3)}{24}\\\\\\bar{x}&=\\frac{37}{24}\\\\\\bar{x}&\\approx1.54\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ],
