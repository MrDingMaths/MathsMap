        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"source page 40 p40-q7-diagram\"}\n\\begin{tikzpicture}[x=20mm,y=4mm,line cap=round,line join=round,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.5pt] (0,0) -- (3,0);\n\\foreach \\x in {0,0.5,1,1.5,2,2.5,3} {\n  \\draw[black,line width=0.4pt] (\\x,-0.15) -- (\\x,0.15);\n}\n\\foreach \\x in {0,1,2,3} {\n  \\node[anchor=north,inner sep=0pt,text=black,font=\\fontsize{8.5}{10.2}\\selectfont] at (\\x,-0.45) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\x$\\special{dvisvgm:raw </g>}};\n}\n\\foreach \\x/\\frequency in {0.5/6,1/5,1.5/3,2/3,2.5/5,3/2} {\n  \\foreach \\level in {1,...,\\frequency} {\n    \\filldraw[draw=black,fill=black,line width=0.8pt] (\\x,\\level) circle[radius=1.3mm];\n  }\n}\n\\node[anchor=center,inner sep=0pt,text=black] at (1.5,9) {Lateness (in hours)};\n\\end{tikzpicture}",
