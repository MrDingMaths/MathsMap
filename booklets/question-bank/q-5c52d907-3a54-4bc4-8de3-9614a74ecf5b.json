    "children": [
      {
        "id": "p11-q12-a",
        "type": "group",
        "label": "a",
        "prompt": "Let $a_n$ be the sequence $8,16,24,\\ldots$ of positive multiples of 8.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q12-a-i",
            "type": "part",
            "label": "i",
            "prompt": "Show that the sequence is an AP, and find a formula for $a_n$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "AP with $a=8$ and $d=8$; $a_n=8n$.",
              "worked": "$$\\begin{align*}a_2-a_1&=16-8=8\\\\a_3-a_2&=24-16=8\\end{align*}$$\nConsecutive positive multiples of 8 differ by 8, so the sequence is an AP with $a=8$ and $d=8$.\n$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=8+(n-1)(8)\\\\a_n&=8n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          },
          {
            "id": "p11-q12-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Find the first term of the sequence greater than 500 and the last term less than 850.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$504$ and $848$, respectively.",
              "worked": "$$\\begin{align*}a_n&>500\\\\8n&>500\\\\n&>62.5\\end{align*}$$\nThe smallest integer index is 63.\n$$a_{63}=8(63)=504$$\nThus the first term greater than 500 is 504.\n$$\\begin{align*}a_n&<850\\\\8n&<850\\\\n&<106.25\\end{align*}$$\nThe greatest integer index is 106.\n$$a_{106}=8(106)=848$$\nThus the last term less than 850 is 848.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p11-q12-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "Hence find the number of multiples of 8 between 500 and 850.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$44$ multiples.",
              "worked": "The terms run from $a_{63}$ to $a_{106}$, inclusive.\n$$\\text{Number of terms}=106-63+1=44$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 11
          }
        ]
      }
    ]
  },
