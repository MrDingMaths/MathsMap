        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{18}+\\sqrt{32}&=\\sqrt{9\\times2}+\\sqrt{16\\times2}\\\\\\sqrt{18}+\\sqrt{32}&=3\\sqrt{2}+4\\sqrt{2}\\\\\\sqrt{18}+\\sqrt{32}&=7\\sqrt{2}\\end{align*}$$",
