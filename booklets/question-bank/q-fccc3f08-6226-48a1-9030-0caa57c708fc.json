  "content": {
    "id": "p5-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the area of the floor of the room that is left uncovered if a carpet measuring 4 m by 3 m is laid in a room 5 metres square.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$13\\text{ m}^2$",
      "worked": "“5 metres square” means a square with side length 5 m. $$\\begin{aligned}A_{\\text{uncovered}}&=5^2-4(3)\\\\A_{\\text{uncovered}}&=25-12=13\\text{ m}^2.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
