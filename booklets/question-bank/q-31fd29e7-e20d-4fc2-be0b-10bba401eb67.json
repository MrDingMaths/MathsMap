      {
        "id": "p46-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sqrt{2}\\sin\\left(x+\\frac{\\pi}{4}\\right)=\\sin x+\\cos x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}\\sin\\left(x+\\frac{\\pi}{4}\\right)=\\sin x+\\cos x$.",
          "worked": "$$\\begin{align*}\\sqrt{2}\\sin\\left(x+\\frac{\\pi}{4}\\right)&=\\sqrt{2}\\left(\\sin x\\cos\\frac{\\pi}{4}+\\cos x\\sin\\frac{\\pi}{4}\\right)\\\\&=\\sqrt{2}\\left(\\frac{\\sin x+\\cos x}{\\sqrt{2}}\\right)\\\\&=\\sin x+\\cos x.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p46-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, or otherwise, find the exact area under one arch of the curve $y=\\sin x+\\cos x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{2}$ square units.",
          "worked": "One arch of $y=\\sin x+\\cos x=\\sqrt{2}\\sin\\left(x+\\frac{\\pi}{4}\\right)$ lies above the $x$-axis from $x=-\\frac{\\pi}{4}$ to $x=\\frac{3\\pi}{4}$.\n\n$$\\begin{align*}A&=\\int_{-\\pi/4}^{3\\pi/4}\\sqrt{2}\\sin\\left(x+\\frac{\\pi}{4}\\right)\\,dx\\\\&=\\left[-\\sqrt{2}\\cos\\left(x+\\frac{\\pi}{4}\\right)\\right]_{-\\pi/4}^{3\\pi/4}\\\\&=\\sqrt{2}+\\sqrt{2}\\\\&=2\\sqrt{2}\\text{ square units}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      }
    ]
  },
