  "content": {
    "id": "p14-q24-root",
    "type": "question",
    "label": null,
    "prompt": "Let $P(x)=x^3-4x^2+ax+6$. When $P(x)$ is divided by $x+2$, the remainder is $-10$. Find $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-4$",
      "worked": "By the remainder theorem, $P(-2)=-10$.\n$$\\begin{align*}(-2)^3-4(-2)^2+a(-2)+6&=-10\\\\-18-2a&=-10\\\\-2a&=8\\\\a&=-4\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
