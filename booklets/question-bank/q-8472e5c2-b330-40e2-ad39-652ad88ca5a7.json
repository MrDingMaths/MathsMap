        "type": "part",
        "label": "a",
        "prompt": "The common ratio is $3$ and the fourth term is $54$. Find the second term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{aligned}a_4&=ar^3\\\\54&=a(3)^3\\\\54&=27a\\\\a&=2\\\\a_2&=ar=2(3)=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-p30-mixed-practice-slot-6-slot-6-b",
        "type": "part",
        "label": "b",
        "prompt": "The common ratio is $-2$ and the fifth term is $48$. Find the third term.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{aligned}a_5&=ar^4\\\\48&=a(-2)^4\\\\48&=16a\\\\a&=3\\\\a_3&=ar^2=3(-2)^2=12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
