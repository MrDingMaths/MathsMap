  "content": {
    "id": "p24-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "For $f(x)=x^2-ax$:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q16-derivative",
        "type": "part",
        "label": "a",
        "prompt": "Find the derivative.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=2x-a$",
          "worked": "Treat $a$ as a constant.\n$$f'(x)=2x-a$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p24-q16-conditions",
        "type": "group",
        "label": "",
        "prompt": "Find the value of $a$ when:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p24-q16-a",
            "type": "part",
            "label": "b",
            "prompt": "the tangent at the origin has gradient $7$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=-7$",
              "worked": "At the origin, $x=0$.\n$$\\begin{align*}f'(0)&=7\\\\2(0)-a&=7\\\\a&=-7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p24-q16-b",
            "type": "part",
            "label": "c",
            "prompt": "$y=f(x)$ has a horizontal tangent at $x=3$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=6$",
              "worked": "A horizontal tangent has gradient $0$.\n$$\\begin{align*}f'(3)&=0\\\\2(3)-a&=0\\\\a&=6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p24-q16-c",
            "type": "part",
            "label": "d",
            "prompt": "the tangent at the point where $x=1$ has an angle of inclination of $45^\\circ$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=1$",
              "worked": "$$m=\\tan45^\\circ=1$$\n$$\\begin{align*}f'(1)&=1\\\\2(1)-a&=1\\\\a&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p24-q16-d",
            "type": "part",
            "label": "e",
            "prompt": "the tangent at the non-zero $x$-intercept has gradient $5$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=5$",
              "worked": "At an $x$-intercept:\n$$\\begin{align*}x^2-ax&=0\\\\x(x-a)&=0\\end{align*}$$\nThe non-zero intercept has $x=a$.\n$$\\begin{align*}f'(a)&=5\\\\2a-a&=5\\\\a&=5\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p24-q16-e",
            "type": "part",
            "label": "f",
            "prompt": "the tangent at the vertex has $y$-intercept $-9$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=6$ or $a=-6$",
              "worked": "The tangent at the vertex is horizontal, so its equation is $y=-9$ and the vertex has $y$-coordinate $-9$.\n$$\\begin{align*}f'(x)&=0\\\\2x-a&=0\\\\x&=\\frac a2\\end{align*}$$\n$$\\begin{align*}f\\left(\\frac a2\\right)&=-9\\\\\\left(\\frac a2\\right)^2-a\\left(\\frac a2\\right)&=-9\\\\-\\frac{a^2}{4}&=-9\\\\a^2&=36\\\\a&=\\pm6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      }
    ]
  },
