        "id": "p37-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why, in this context, the model only makes sense for the bold section of the graph.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A rectangle's width cannot be negative.",
          "worked": "The bold section represents nonnegative widths. Negative values of $w$ cannot represent the width of a rectangle.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p37-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "The area of the rectangle is $18\\text{ cm}^{2}$.\n\nCalculate the perimeter of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$22\\text{ cm}$",
          "worked": "Reading the bold section of the graph at $A=18$ gives $w=2\\text{ cm}$.\n\n$$\\begin{align*}\n\\text{Length} &= \\frac{18}{2}\\\\\n&=9\\text{ cm}\\\\\nP &=2(9+2)\\\\\n&=22\\text{ cm}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
