    "id": "p16-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Factorise $25x^2+70x+48$.\n\nHint: let $a=5x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(5x+6)(5x+8)$",
      "worked": "Let $a=5x$. Since $6+8=14$ and $6\\times8=48$,\n\n$$\\begin{align*}25x^2+70x+48&=a^2+14a+48\\\\&=(a+6)(a+8)\\\\&=(5x+6)(5x+8).\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
