  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A ribbon of length 12 m is divided into $x$ parts of equal length.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the length of each part, in terms of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{12}{x}$ m",
          "worked": "Divide the total length by the number of equal parts.\n\n$$\\text{Length of each part}=\\frac{12}{x}\\text{ m}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "If $x=10$, what is the length of each part?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{1}{5}$ m",
          "worked": "For $x=10$:\n\n$$\\begin{align*}\\frac{12}{x}&=\\frac{12}{10}\\\\\\frac{12}{x}&=\\frac{6}{5}\\\\\\frac{12}{x}&=1\\frac{1}{5}\\end{align*}$$\n\nEach part is $1\\frac{1}{5}$ m long.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
