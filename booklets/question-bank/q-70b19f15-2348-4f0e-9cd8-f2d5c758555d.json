  "content": {
    "id": "v2-65792-p37-practice-j21-215016-root",
    "type": "question",
    "label": null,
    "prompt": "Compare the trigonometric ratios of an angle and its negative.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-65792-p37-practice-j21-215016-j21-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the exact values of $\\sin150^{\\circ}$ and $\\sin(-150^{\\circ})$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin150^{\\circ}=\\dfrac12$, $\\sin(-150^{\\circ})=-\\dfrac12$",
          "worked": "$$\\begin{align*}\\sin150^{\\circ}&=\\sin30^{\\circ}=\\frac12\\\\\\sin(-150^{\\circ})&=\\sin210^{\\circ}=-\\sin30^{\\circ}=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-65792-p37-practice-j21-215016-j21-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the exact values of $\\cos120^{\\circ}$ and $\\cos(-120^{\\circ})$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both equal $-\\dfrac12$",
          "worked": "$$\\begin{align*}\\cos120^{\\circ}&=-\\cos60^{\\circ}=-\\frac12\\\\\\cos(-120^{\\circ})&=\\cos240^{\\circ}=-\\cos60^{\\circ}=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-65792-p37-practice-j21-215016-j21-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the exact values of $\\tan210^{\\circ}$ and $\\tan(-210^{\\circ})$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan210^{\\circ}=\\dfrac{1}{\\sqrt3}$, $\\tan(-210^{\\circ})=-\\dfrac{1}{\\sqrt3}$",
          "worked": "$$\\begin{align*}\\tan210^{\\circ}&=\\tan30^{\\circ}=\\frac{1}{\\sqrt3}\\\\\\tan(-210^{\\circ})&=\\tan150^{\\circ}=-\\tan30^{\\circ}=-\\frac{1}{\\sqrt3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-65792-p37-practice-j21-215016-j21-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Use your answers to write $\\sin(-\\theta)$, $\\cos(-\\theta)$ and $\\tan(-\\theta)$ in terms of $\\sin\\theta$, $\\cos\\theta$ and $\\tan\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin(-\\theta)=-\\sin\\theta$, $\\cos(-\\theta)=\\cos\\theta$, $\\tan(-\\theta)=-\\tan\\theta$",
          "worked": "$$\\begin{align*}\\sin(-\\theta)&=-\\sin\\theta\\\\\\cos(-\\theta)&=\\cos\\theta\\\\\\tan(-\\theta)&=-\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-65792-p37-practice-j21-215016-j21-q-e",
        "type": "part",
        "label": "e",
        "prompt": "Simplify $\\sin(-\\theta)\\cos(-\\theta)+\\sin\\theta\\cos\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\sin(-\\theta)\\cos(-\\theta)+\\sin\\theta\\cos\\theta&=(-\\sin\\theta)(\\cos\\theta)+\\sin\\theta\\cos\\theta\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
