    "children": [
      {
        "id": "v2-a9ecf-p17-practice-slot-9-slot-9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(x+\\dfrac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2+\\dfrac{1}{x^2}$",
          "worked": "$a=x$, $b=\\dfrac{1}{x}$.\n$$\\begin{align*}\\left(x+\\dfrac{1}{x}\\right)^2&=x^2+2(x)\\left(\\dfrac{1}{x}\\right)+\\left(\\dfrac{1}{x}\\right)^2\\\\&=x^2+2+\\dfrac{1}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-a9ecf-p17-practice-slot-9-slot-9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(y-\\dfrac{1}{y}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2-2+\\dfrac{1}{y^2}$",
          "worked": "$a=y$, $b=-\\dfrac{1}{y}$.\n$$\\begin{align*}\\left(y-\\dfrac{1}{y}\\right)^2&=y^2+2(y)\\left(-\\dfrac{1}{y}\\right)+\\left(-\\dfrac{1}{y}\\right)^2\\\\&=y^2-2+\\dfrac{1}{y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-a9ecf-p17-practice-slot-9-slot-9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(2a+\\dfrac{1}{a}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2+4+\\dfrac{1}{a^2}$",
          "worked": "$a=2a$, $b=\\dfrac{1}{a}$.\n$$\\begin{align*}\\left(2a+\\dfrac{1}{a}\\right)^2&=(2a)^2+2(2a)\\left(\\dfrac{1}{a}\\right)+\\left(\\dfrac{1}{a}\\right)^2\\\\&=4a^2+4+\\dfrac{1}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "v2-a9ecf-p17-practice-slot-9-slot-9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(3m-\\dfrac{2}{m}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9m^2-12+\\dfrac{4}{m^2}$",
          "worked": "$a=3m$, $b=-\\dfrac{2}{m}$.\n$$\\begin{align*}\\left(3m-\\dfrac{2}{m}\\right)^2&=(3m)^2+2(3m)\\left(-\\dfrac{2}{m}\\right)+\\left(-\\dfrac{2}{m}\\right)^2\\\\&=9m^2-12+\\dfrac{4}{m^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
