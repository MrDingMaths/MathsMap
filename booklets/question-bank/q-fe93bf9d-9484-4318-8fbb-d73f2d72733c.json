    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for the area of the field.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy\\text{ m}^2$",
          "worked": "$\\begin{align*}A&=xy\\end{align*}$\nThe area is $xy\\text{ m}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p15-q7-b",
        "type": "group",
        "label": "b",
        "prompt": "A smaller section is fenced off. It is $\\frac{1}{2}$ the length and $\\frac{3}{4}$ the breadth.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q7-b-i",
            "type": "part",
            "label": "i",
            "prompt": "Write an expression for the length and breadth of the smaller section.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Length: $\\frac{x}{2}\\text{ m}$; breadth: $\\frac{3y}{4}\\text{ m}$.",
              "worked": "$\\begin{align*}\\text{Length}&=\\frac{1}{2}\\times x=\\frac{x}{2}\\text{ m}\\\\\\text{Breadth}&=\\frac{3}{4}\\times y=\\frac{3y}{4}\\text{ m}\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p15-q7-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Hence, write an expression for the area of the smaller section.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{3xy}{8}\\text{ m}^2$",
              "worked": "$\\begin{align*}A_{\\text{smaller}}&=\\frac{x}{2}\\times\\frac{3y}{4}\\\\&=\\frac{x\\times3y}{2\\times4}\\\\&=\\frac{3xy}{8}\\text{ m}^2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          }
        ]
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the percentage of the smaller area compared to the larger area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$37.5\\%$",
          "worked": "$\\begin{align*}\\text{Percentage}&=\\frac{\\frac{3xy}{8}}{xy}\\times100\\%\\\\&=\\frac{3}{8}\\times100\\%\\\\&=37.5\\%\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ],
    "diagramPlacement": "before-prompt"
  },
