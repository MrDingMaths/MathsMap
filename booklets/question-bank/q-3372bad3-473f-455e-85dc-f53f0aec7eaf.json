  "content": {
    "id": "p10-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "In an arithmetic sequence, the sum of the first six terms is 171. The sum of the next six terms is 351. Find the sum of the six terms after that.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$531$",
      "worked": "Let $d$ be the common difference. Each term in the second group is $6d$ greater than its corresponding term in the first group, so each successive six-term sum increases by $36d$.\n\n$$\\begin{align*}36d&=351-171\\\\36d&=180\\\\a_{13}+a_{14}+\\cdots+a_{18}&=351+180\\\\a_{13}+a_{14}+\\cdots+a_{18}&=531\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
