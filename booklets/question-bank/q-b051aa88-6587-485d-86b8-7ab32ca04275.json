        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AG}$",
          "worked": "$\\overrightarrow{AB}+\\overrightarrow{BG}=\\overrightarrow{AG}$ by the triangle law.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{GE}+\\overrightarrow{EF}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{GF}$",
          "worked": "$\\overrightarrow{GE}+\\overrightarrow{EF}=\\overrightarrow{GF}$ by the triangle law.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{BG}-\\overrightarrow{CG}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{BC}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{BG}-\\overrightarrow{CG}&=\\overrightarrow{BG}+\\overrightarrow{GC}\\\\\\overrightarrow{BG}-\\overrightarrow{CG}&=\\overrightarrow{BC}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\overrightarrow{GC}-\\overrightarrow{BC}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{GB}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{GC}-\\overrightarrow{BC}&=\\overrightarrow{GC}+\\overrightarrow{CB}\\\\\\overrightarrow{GC}-\\overrightarrow{BC}&=\\overrightarrow{GB}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p44-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\overrightarrow{GE}+\\overrightarrow{EF}+\\overrightarrow{FA}$",
