        "children": [],
        "answer": {
          "short": "$\\overrightarrow{GA}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{GE}+\\overrightarrow{EF}+\\overrightarrow{FA}&=\\overrightarrow{GF}+\\overrightarrow{FA}\\\\\\overrightarrow{GE}+\\overrightarrow{EF}+\\overrightarrow{FA}&=\\overrightarrow{GA}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
