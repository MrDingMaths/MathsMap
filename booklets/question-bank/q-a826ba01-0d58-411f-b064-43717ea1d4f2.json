  "content": {
    "id": "v2-bb60af-p5-practice-slot-1-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A single sheet of paper is folded in half again and again. Each fold doubles the number of layers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-bb60af-p5-practice-slot-1-lower-s1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the number of layers after 4 folds as a product of 2s.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times2\\times2\\times2$",
          "worked": "Each fold multiplies the number of layers by 2, so after 4 folds there are $2\\times2\\times2\\times2$ layers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-bb60af-p5-practice-slot-1-lower-s1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How many layers are there after 15 folds, in index form?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{15}$ layers",
          "worked": "The index equals the number of folds. After 15 folds there are $2^{15}$ layers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-bb60af-p5-practice-slot-1-lower-s1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "After the last fold, there are $2^9$ layers. How many layers were there before that fold, in index form?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^8$ layers",
          "worked": "$$\\begin{align*}\\text{Folds so far}&=9\\\\\\text{Folds before the last}&=9-1\\\\&=8\\end{align*}$$\nThere were $2^8$ layers.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
