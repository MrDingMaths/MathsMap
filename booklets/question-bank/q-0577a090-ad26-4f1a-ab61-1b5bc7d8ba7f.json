  "content": {
    "id": "p11-p2-root",
    "type": "question",
    "label": "2",
    "prompt": "A bicycle wheel of radius $36\\text{ cm}$ turns through an angle of $\\frac{2\\pi}{3}$ radians in $0.16$ seconds. At what speed is the bicycle being ridden, in metres per minute? Give your answer correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$282.7\\text{ metres per minute}$",
      "worked": "The distance travelled is the wheel's arc length.\n$$\\begin{align*}l&=0.36\\times\\frac{2\\pi}{3}\\\\l&=0.24\\pi\\text{ m}\\\\v&=\\frac{0.24\\pi}{0.16}\\times60\\\\v&=90\\pi\\text{ metres per minute}\\\\v&\\approx282.7\\text{ metres per minute}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
