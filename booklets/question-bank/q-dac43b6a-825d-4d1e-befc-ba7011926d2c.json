  "content": {
    "id": "p28-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "At the start of the first minute there are 10 smidges. Each minute, 2 smidges die, and then their numbers double. Let $a_n$ be the number of smidges at the start of the $n$th minute.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q3a",
        "type": "part",
        "label": "a",
        "prompt": "Find $a_2$, the number of smidges at the start of the second minute.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_2=16$ smidges.",
          "worked": "$$\\begin{align*}a_2&=2(10-2)\\\\a_2&=16\\end{align*}$$\nThere are 16 smidges.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q3b",
        "type": "part",
        "label": "b",
        "prompt": "Find a recursive equation for $a_{n+1}$ in terms of $a_n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{n+1}=2(a_n-2)=2a_n-4$.",
          "worked": "Subtract 2 before doubling.\n$$\\begin{align*}a_{n+1}&=2(a_n-2)\\\\a_{n+1}&=2a_n-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p28-q3c",
        "type": "part",
        "label": "c",
        "prompt": "Find a general formula for $a_n$ in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p28-q3c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "a_n=6\\times2^{n-1}+4",
                    "display": false
                  }
                ]
              },
              {
                "id": "p28-q3c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use the first two terms to determine ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "p",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "q",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " in ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a_n=p2^{n-1}+q",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The multiplier is $r=2$, so write $a_n=p2^{n-1}+q$. Using $a_1=10$ and $a_2=16$ gives\n$$\\begin{align*}10&=p+q\\\\16&=2p+q\\\\16-10&=(2p+q)-(p+q)\\\\6&=p\\\\q&=10-6\\\\q&=4\\\\a_n&=6\\times2^{n-1}+4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      }
    ]
  },
