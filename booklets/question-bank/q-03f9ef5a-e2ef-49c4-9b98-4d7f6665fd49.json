  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider triangle $ABC$ with vertices at coordinates $A(1,3)$, $B(-1,5)$ and $C(3,-1)$. Let $M$ be the midpoint of $A$ and $B$ and let $N$ be the midpoint of $B$ and $C$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $MN=\\frac12AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M(0,4)$, $N(1,2)$; $MN=\\sqrt5$ and $AC=2\\sqrt5$, so $MN=\\frac12AC$.",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{1+(-1)}2,\\frac{3+5}2\\right)\\\\M&=(0,4)\\\\N&=\\left(\\frac{-1+3}2,\\frac{5+(-1)}2\\right)\\\\N&=(1,2)\\\\MN&=\\sqrt{(1-0)^2+(2-4)^2}\\\\MN&=\\sqrt5\\\\AC&=\\sqrt{(3-1)^2+(-1-3)^2}\\\\AC&=\\sqrt{20}\\\\AC&=2\\sqrt5\\end{align*}$$\nTherefore $MN=\\frac12AC$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 86
      },
      {
        "id": "p9-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that line segment $MN$ has the same gradient as line segment $AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{MN}=m_{AC}=-2$.",
          "worked": "Using $M(0,4)$ and $N(1,2)$,\n$$\\begin{align*}m_{MN}&=\\frac{2-4}{1-0}\\\\m_{MN}&=-2\\\\m_{AC}&=\\frac{-1-3}{3-1}\\\\m_{AC}&=-2\\end{align*}$$\nThus $MN$ and $AC$ have the same gradient.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
