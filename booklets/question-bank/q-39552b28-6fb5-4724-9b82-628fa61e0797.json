        "answer": {
          "short": "$6000\\text{ cm}^3$",
          "worked": "$$\\begin{align*}V&=A\\times h\\\\V&=(30\\times20)\\times10\\\\V&=6000\\text{ cm}^3\\end{align*}$$",
