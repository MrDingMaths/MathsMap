        "type": "part",
        "label": "c",
        "prompt": "$2x+1=3(x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=13$",
          "worked": "$$\\begin{align*}2x+1&=3(x-4)\\\\2x+1&=3x-12\\\\1&=x-12\\\\13&=x\\\\x&=13\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=2\\times13+1\\\\\\text{LHS}&=27\\\\\\text{RHS}&=3(13-4)\\\\\\text{RHS}&=27\\end{align*}$$\nLHS = RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p22-review-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+3=4x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{4}{3}$",
          "worked": "$$\\begin{align*}x+3&=4x-1\\\\3&=3x-1\\\\4&=3x\\\\x&=\\frac{4}{3}\\end{align*}$$\nCheck:\n$$\\begin{align*}\\text{LHS}&=\\frac{4}{3}+3\\\\\\text{LHS}&=\\frac{13}{3}\\\\\\text{RHS}&=4\\times\\frac{4}{3}-1\\\\\\text{RHS}&=\\frac{13}{3}\\end{align*}$$\nLHS = RHS.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
