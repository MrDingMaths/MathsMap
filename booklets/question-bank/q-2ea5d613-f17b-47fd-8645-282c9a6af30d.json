  "content": {
    "id": "feedback-power-misconceptions-root",
    "type": "question",
    "label": "",
    "prompt": "Assume $x>0$. Keep brackets where they show which expression is squared.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "feedback-power-misconceptions-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $\\log(3x^2)$ using the log laws.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log 3+2\\log x$",
          "worked": "$$\\begin{align*}\\log(3x^2) &= \\log 3+\\log(x^2) \\\\ &= \\log 3+2\\log x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "feedback-power-misconceptions-b",
        "type": "part",
        "label": "b",
        "prompt": "Expand $\\log((3x)^2)$ using the log laws.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log 3+2\\log x$",
          "worked": "$$\\begin{align*}\\log((3x)^2) &= 2\\log(3x) \\\\ &= 2(\\log 3+\\log x) \\\\ &= 2\\log 3+2\\log x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "feedback-power-misconceptions-c",
        "type": "part",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "2da3bae8-69d6-4031-a1a6-90abf77a495c",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 0,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "A student writes ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\log(3x^2)=2\\log(3x)",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ". Explain the mistake and show these expressions are not equivalent.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Only $x$ is squared. At $x=1$, the two sides are $\\log 3$ and $2\\log 3$, which differ.",
          "worked": "The power law applies to the entire argument only when the entire argument is raised to that power. Here $3x^2$ squares $x$ only, while $(3x)^2=9x^2$. For $x=1$, $\\log 3\\ne2\\log 3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "feedback-power-misconceptions-d",
        "type": "part",
        "label": "d",
        "prompt": "Write $2\\log(3x)$ as a single logarithm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log((3x)^2)=\\log(9x^2)$",
          "worked": "$$\\begin{align*}2\\log(3x) &= \\log((3x)^2) \\\\ &= \\log(9x^2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
