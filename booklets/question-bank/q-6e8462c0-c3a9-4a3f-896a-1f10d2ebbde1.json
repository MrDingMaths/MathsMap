        "children": [],
        "answer": {
          "short": "$\\sqrt{5}$",
          "worked": "$$\\begin{align*}h(1)&=\\sqrt{1+4}\\\\&=\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q6-c",
        "type": "part",
