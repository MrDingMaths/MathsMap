  "content": {
    "id": "p14-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Consider the points $P(4,7)$ and $Q(6,-1)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the length of $PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{68}$",
          "worked": "$$\\begin{aligned}PQ&=\\sqrt{(6-4)^2+(-1-7)^2}\\\\PQ&=\\sqrt{4+64}\\\\PQ&=\\sqrt{68}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the midpoint of $PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5,3)$",
          "worked": "$$\\begin{aligned}M&=\\left(\\frac{4+6}{2},\\frac{7+(-1)}{2}\\right)\\\\M&=(5,3)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p14-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the gradient of $PQ$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{aligned}m&=\\frac{-1-7}{6-4}\\\\m&=-4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p14-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the equation of the line passing through $P$ and $Q$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+23$",
          "worked": "Using $m=-4$ and $P(4,7)$:\n$$\\begin{aligned}y-7&=-4(x-4)\\\\y-7&=-4x+16\\\\y&=-4x+23\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
