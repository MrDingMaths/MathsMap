    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{x+1}{4}=\\frac{x}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "$$\\begin{align*}3(x+1)&=4x\\\\3x+3&=4x\\\\3&=x\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2x-1}{6}=\\frac{3x}{5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{5}{8}$",
          "worked": "$$\\begin{align*}5(2x-1)&=18x\\\\10x-5&=18x\\\\-5&=8x\\\\x&=-\\frac{5}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{x-2}{3}=\\frac{x}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$",
          "worked": "$$\\begin{align*}2(x-2)&=3x\\\\2x-4&=3x\\\\-4&=x\\\\x&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{x+3}{4}=\\frac{x-1}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$",
          "worked": "$$\\begin{align*}2(x+3)&=4(x-1)\\\\2x+6&=4x-4\\\\6&=2x-4\\\\10&=2x\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{x+2}{3}=\\frac{x+1}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}2(x+2)&=3(x+1)\\\\2x+4&=3x+3\\\\4&=x+3\\\\1&=x\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{3+x}{2}=\\frac{2-x}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}3(3+x)&=2(2-x)\\\\9+3x&=4-2x\\\\9+5x&=4\\\\5x&=-5\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{2x+4}{4}=\\frac{x+6}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$",
          "worked": "$$\\begin{align*}3(2x+4)&=4(x+6)\\\\6x+12&=4x+24\\\\2x+12&=24\\\\2x&=12\\\\x&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{2x+12}{7}=\\frac{3x+5}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}4(2x+12)&=7(3x+5)\\\\8x+48&=21x+35\\\\48&=13x+35\\\\13&=13x\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{3x-5}{4}=\\frac{2x-8}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-17$",
          "worked": "$$\\begin{align*}3(3x-5)&=4(2x-8)\\\\9x-15&=8x-32\\\\x-15&=-32\\\\x&=-17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac{10-x}{2}=\\frac{x+1}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{28}{5}$",
          "worked": "$$\\begin{align*}3(10-x)&=2(x+1)\\\\30-3x&=2x+2\\\\30&=5x+2\\\\28&=5x\\\\x&=\\frac{28}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\frac{1-x}{5}=\\frac{2-x}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{7}{2}$",
          "worked": "$$\\begin{align*}3(1-x)&=5(2-x)\\\\3-3x&=10-5x\\\\3+2x&=10\\\\2x&=7\\\\x&=\\frac{7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\frac{6-2x}{3}=\\frac{5x-1}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{27}{23}$",
          "worked": "$$\\begin{align*}4(6-2x)&=3(5x-1)\\\\24-8x&=15x-3\\\\24&=23x-3\\\\27&=23x\\\\x&=\\frac{27}{23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$$\\frac{2(x+1)}{3}=\\frac{3(2x-1)}{2}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{13}{14}$",
          "worked": "$$\\begin{align*}4(x+1)&=9(2x-1)\\\\4x+4&=18x-9\\\\4&=14x-9\\\\13&=14x\\\\x&=\\frac{13}{14}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-n",
        "type": "part",
        "label": "n",
        "prompt": "$$\\frac{3(6-x)}{2}=\\frac{2(x+1)}{5}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{86}{19}$",
          "worked": "$$\\begin{align*}15(6-x)&=4(x+1)\\\\90-15x&=4x+4\\\\90&=19x+4\\\\86&=19x\\\\x&=\\frac{86}{19}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-o",
        "type": "part",
        "label": "o",
        "prompt": "$$\\frac{-2(x-1)}{3}=\\frac{2-x}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2}{5}$",
          "worked": "$$\\begin{align*}-8(x-1)&=3(2-x)\\\\-8x+8&=6-3x\\\\8&=6+5x\\\\2&=5x\\\\x&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
