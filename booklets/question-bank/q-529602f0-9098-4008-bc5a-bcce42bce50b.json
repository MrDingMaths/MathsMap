    "type": "question",
    "label": "11",
    "prompt": "Find the value of $n$ for which $\\binom{n}{2}=66$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=12$.",
      "worked": "$$\\begin{align*}\\binom{n}{2}&=66\\\\\\frac{n!}{2!(n-2)!}&=66\\\\\\frac{n(n-1)}{2}&=66\\\\n(n-1)&=132\\end{align*}$$\nSince $12\\times11=132$, $n=12$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
