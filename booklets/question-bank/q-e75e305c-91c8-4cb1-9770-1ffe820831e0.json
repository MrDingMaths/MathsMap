  "content": {
    "id": "p33-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Georgina works for 3 days a week and earns \\$670.85 per week.\nHow much does she earn per period below? Give answers to the nearest cent.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Fortnight",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1341.70",
          "worked": "$$\\begin{align*}\\text{Fortnightly pay} &= \\$670.85\\times 2\\\\\\text{Fortnightly pay} &= \\$1341.70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Year",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$34 884.20",
          "worked": "$$\\begin{align*}\\text{Annual pay} &= \\$670.85\\times 52\\\\\\text{Annual pay} &= \\$34\\,884.20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p33-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Month",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$2907.02",
          "worked": "$$\\begin{align*}\\text{Annual pay} &= \\$670.85\\times 52\\\\\\text{Annual pay} &= \\$34\\,884.20\\\\\\text{Monthly pay} &= \\frac{\\$34\\,884.20}{12}\\\\\\text{Monthly pay} &\\approx \\$2907.02\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
