  "content": {
    "id": "v2-5bb6f-p27-practice-slot-14-root",
    "type": "question",
    "label": null,
    "prompt": "A right-angled triangle has one shorter side exactly $\\sqrt{46}$ cm long and its longest side is exactly $\\sqrt{190}$ cm long. How long is the other shorter side?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\text{ cm}$",
      "worked": "Let $a$ be the other shorter side.\n$$\\begin{align*}a &= \\sqrt{(\\sqrt{190})^2-(\\sqrt{46})^2}\\\\a &= \\sqrt{190-46}\\\\a &= \\sqrt{144}\\\\a &= 12\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
