  "content": {
    "id": "p6-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A soccer match lasted 92 minutes (including injury time). If team A was in possession for 55% of the match, for how many minutes and seconds was team A in possession?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "50 minutes 36 seconds.",
      "worked": "$92\\times0.55=50.6$ minutes. The fractional minute is $0.6\\times60=36$ seconds, so 50 minutes 36 seconds.",
      "solutionDiagrams": []
    },
