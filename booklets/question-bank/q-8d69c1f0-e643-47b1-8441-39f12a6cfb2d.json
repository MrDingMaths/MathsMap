        "type": "part",
        "label": "",
        "prompt": "Why is method 2, rooting before raising to the power, easier?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "You work with smaller numbers.",
          "worked": "Rooting first gives $\\sqrt[4]{16}=2$, so only $2^5$ needs to be calculated. Raising to the power first gives $16^5=1\\,048\\,576$, a much larger number.",
          "solutionDiagrams": []
        },
