                {
                  "id": "p11-q3-method2",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 1,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "math",
                      "latex": "\\begin{aligned}16^{\\frac{5}{4}}&=(16^{\\frac{1}{4}})^5=(\\sqrt[4]{16})^5\\\\&=2^5=32\\end{aligned}",
