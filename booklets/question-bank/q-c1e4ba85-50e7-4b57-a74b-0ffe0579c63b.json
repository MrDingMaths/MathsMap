    "children": [
      {
        "id": "p7-q11-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Find the remainder when $55^5$ is divided by $6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $55\\equiv1\\pmod6$,\n$$\\begin{align*}55^5&\\equiv1^5\\pmod6\\\\55^5&\\equiv1\\pmod6.\\end{align*}$$\nThe remainder is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q11-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Find the remainder when $6^{66}$ is divided by $7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Since $6\\equiv-1\\pmod7$ and $66$ is even,\n$$\\begin{align*}6^{66}&\\equiv(-1)^{66}\\pmod7\\\\6^{66}&\\equiv1\\pmod7.\\end{align*}$$\nThe remainder is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q11-c-node",
        "type": "part",
        "label": "c",
        "prompt": "Find the remainder when $77^{77}$ is divided by $8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Since $77\\equiv5\\pmod8$ and $5^2=25\\equiv1\\pmod8$,\n$$\\begin{align*}77^{77}&\\equiv5^{77}\\pmod8\\\\77^{77}&\\equiv(5^2)^{38}\\times5\\pmod8\\\\77^{77}&\\equiv1^{38}\\times5\\pmod8\\\\77^{77}&\\equiv5\\pmod8.\\end{align*}$$\nThe remainder is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
