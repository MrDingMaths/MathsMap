  "content": {
    "id": "estimating-r6-atpoint-2-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $f(x)=2x^2-x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "estimating-r6-atpoint-2-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(3)=15$ and $f(3+h)=15+11h+2h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(3)=2(3)^2-3=15$ and $f(3+h)=2(9+6h+h^2)-3-h=15+11h+2h^2$.",
          "worked": "$$\\begin{align*}f(3)&=2(3)^2-3\\\\f(3)&=18-3\\\\f(3)&=15\\end{align*}$$\n$$\\begin{align*}f(3+h)&=2(3+h)^2-(3+h)\\\\f(3+h)&=2(9+6h+h^2)-3-h\\\\f(3+h)&=18+12h+2h^2-3-h\\\\f(3+h)&=15+11h+2h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "estimating-r6-atpoint-2-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\dfrac{f(3+h)-f(3)}{h}=11+2h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{f(3+h)-f(3)}{h}=\\dfrac{11h+2h^2}{h}=11+2h$, for $h\\ne0$.",
          "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(3+h)-f(3)}{h}&=\\frac{15+11h+2h^2-15}{h}\\\\\\frac{f(3+h)-f(3)}{h}&=\\frac{h(11+2h)}{h}\\\\\\frac{f(3+h)-f(3)}{h}&=11+2h.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "estimating-r6-atpoint-2-c",
        "type": "part",
        "label": "c",
        "prompt": "Take the limit as $h\\to0$ to show that $f'(3)=11$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(3)=\\lim_{h\\to0}(11+2h)=11$.",
          "worked": "$$\\begin{align*}f'(3)&=\\lim_{h\\to0}\\frac{f(3+h)-f(3)}{h}\\\\f'(3)&=\\lim_{h\\to0}(11+2h)\\\\f'(3)&=11.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
