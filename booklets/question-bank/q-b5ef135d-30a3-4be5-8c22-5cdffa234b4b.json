  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A bag contains 120 balls, some of which are red and the rest black. The probability of a ball, drawn at random, being red is $\\frac{2}{15}$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "the number of red balls in the bag",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "16 red balls",
          "worked": "$$\\begin{align*}\\text{Number of red balls}&=\\frac{2}{15}\\times120\\\\\\text{Number of red balls}&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "the number of black balls in the bag",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "104 black balls",
          "worked": "$$\\text{Number of black balls}=120-16=104.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p22-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "the number of red balls that should be added to the bag to change the probability of obtaining a red ball to $\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "88 red balls\n\nFor probability $\\frac12$, the red and black counts must be equal.",
          "worked": "The number of black balls remains 104. For the probability of red to be $\\frac12$, there must also be 104 red balls.\n\n$$\\text{Red balls to add}=104-16=88.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
