  "content": {
    "id": "p25-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "A fair six-sided die is rolled twice and the two results are recorded. Find the probability that the second number exceeds the first number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{12}$",
      "worked": "There are $6\\times6=36$ equally likely ordered outcomes. For first-roll results $1,2,3,4,5,6$, respectively, there are $5,4,3,2,1,0$ possible second-roll results that exceed the first.\n$$\\begin{align*}N(\\text{second exceeds first})&=5+4+3+2+1+0\\\\N(\\text{second exceeds first})&=15\\\\\\Pr(\\text{second exceeds first})&=\\frac{15}{36}\\\\\\Pr(\\text{second exceeds first})&=\\frac{5}{12}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
