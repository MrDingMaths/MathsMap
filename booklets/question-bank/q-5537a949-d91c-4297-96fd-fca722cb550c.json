  "content": {
    "id": "p13-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "How many arrangements of the word KANGAROO are there if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q8a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\,080$",
          "worked": "There are eight letters, with two A’s and two O’s.\n$$\\begin{align*}N&=\\frac{8!}{2!\\times2!}\\\\N&=10\\,080\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q8b",
        "type": "part",
        "label": "b",
        "prompt": "the O’s are at either end?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360$",
          "worked": "Fix one O at each end. Arrange the six remaining letters, including two identical A’s.\n$$\\begin{align*}N&=\\frac{6!}{2!}\\\\N&=360\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q8c",
        "type": "part",
        "label": "c",
        "prompt": "the A’s are not together?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q8c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "7560",
                    "display": false
                  }
                ]
              },
              {
                "id": "p13-q8c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Arrange the other six letters, then place the A’s in two different gaps.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Arrange K, N, G, R, O, O in $6!/2!$ ways. These letters create seven gaps. Place the two A’s in different gaps, dividing by $2!$ because the A’s are identical.\n$$\\begin{align*}N&=\\frac{6!}{2!}\\times\\frac{7\\times6}{2!}\\\\N&=7560\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
