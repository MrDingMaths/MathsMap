  "content": {
    "id": "p22-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "There are 24 children in a class. The ratio of the number of boys to the number of girls is $3:5$. How many boys and how many girls are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "9 boys, 15 girls.",
      "worked": "There are $3+5=8$ parts in total.\n$$\\begin{align*}\\text{One part}&=24\\div8=3\\text{ children}\\\\\\text{Number of boys}&=3\\times3=9\\\\\\text{Number of girls}&=5\\times3=15\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
