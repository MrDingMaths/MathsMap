      {
        "id": "p7-q3-part-a",
        "type": "part",
        "label": "a",
        "prompt": "If today is Monday, then what day will it be 365 days from today?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tuesday",
          "worked": "$$365 = 52\\times7+1.$$ The week repeats every 7 days, so 365 days from Monday is one day after Monday: Tuesday.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q3-part-b",
        "type": "part",
        "label": "b",
        "prompt": "If today is Tuesday, what day was it 1000 days prior?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Wednesday",
          "worked": "$$1000 = 142\\times7+6.$$ The week repeats every 7 days, so 1000 days before Tuesday is six days before Tuesday: Wednesday.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
