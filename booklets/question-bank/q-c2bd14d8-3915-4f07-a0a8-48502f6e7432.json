              "type": "text",
              "text": "Let ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "f(x)=-\\sqrt{x}",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q30-a",
        "type": "part",
        "label": "a",
        "prompt": "State the domain and range of $f$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $[0,\\infty)$. Range: $(-\\infty,0]$.",
          "worked": "The square root requires $x\\ge0$. Since $\\sqrt{x}\\ge0$, $-\\sqrt{x}\\le0$, with every non-positive value attained.\n\nDomain: $[0,\\infty)$. Range: $(-\\infty,0]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q30-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $f^{-1}(x)$ and state the domain and range.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{-1}(x)=x^2$, with domain $(-\\infty,0]$ and range $[0,\\infty)$.",
          "worked": "Interchange $x$ and $y$:\n$$\\begin{align*}y&=-\\sqrt{x}\\\\x&=-\\sqrt{y}\\\\y&=x^2.\\end{align*}$$\nThe swapped equation requires $x\\le0$. The inverse's domain and range are the original range and domain.\n\nTherefore, $f^{-1}(x)=x^2$, with domain $(-\\infty,0]$ and range $[0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p52-q30-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph of $y=f(x)$, $y=f^{-1}(x)$ and $y=x$ on the same Cartesian plane.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Blue: $y=-\\sqrt{x}$, $x\\ge0$. Red: $y=x^2$, $x\\le0$. Dashed: $y=x$.",
          "worked": "Sketch $y=-\\sqrt{x}$ from its endpoint $(0,0)$ into the fourth quadrant. Reflect it in $y=x$ to obtain $y=x^2$ for $x\\le0$, with the same endpoint. Include the line $y=x$ on the same plane.",
          "solutionDiagrams": [
            {
              "id": "p52-q30-c-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"functionBlue\",\"hex\":\"268CFF\",\"reason\":\"original function\"},{\"name\":\"inverseRed\",\"hex\":\"EF6068\",\"reason\":\"inverse function reflected in y=x\"}],\"reference\":\"source PDF52 Q30(c), teacher PDF9 printed313\"}\n\\begin{tikzpicture}[x=1cm,y=1cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{functionBlue}{HTML}{268CFF}\n\\definecolor{inverseRed}{HTML}{EF6068}\n\\path[use as bounding box] (-3.6,-2.4) rectangle (3.7,3.7);\n\\draw[black,line width=0.5pt,->] (-3.3,0)--(3.4,0) node[below] {$x$};\n\\draw[black,line width=0.5pt,->] (0,-2.1)--(0,3.4) node[left] {$y$};\n\\draw[black,line width=0.4pt,dashed,<->] (-2.0,-2.0)--(3.1,3.1);\n\\draw[functionBlue,line width=0.8pt,->,domain=0:3.2,samples=101] plot (\\x,{-sqrt(\\x)});\n\\draw[inverseRed,line width=0.8pt,<-,domain=-1.78:0,samples=101] plot (\\x,{\\x*\\x});\n\\fill[black] (0,0) circle (1.5pt);\n\\node[functionBlue] at (2.3,-0.8) {$f$};\n\\node[inverseRed] at (-2.25,2.5) {$f^{-1}$};\n\\node[black,above left] at (2.25,2.25) {$y=x$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 50,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 52,
                "sourceRegion": "Question 30(c); answer graph on teacher PDF9, printed page 313",
                "description": "One Cartesian plane showing the original square-root branch, its reflected quadratic branch, and y=x; no grid or numerical ticks.",
                "mathematics": "f(x)=-sqrt(x), x>=0; inverse x^2, x<=0. Both include (0,0). Equal x/y units preserve reflection.",
                "answerVisibility": "Answer editions only; the student question has no supplied graph."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 66
      }
    ]
