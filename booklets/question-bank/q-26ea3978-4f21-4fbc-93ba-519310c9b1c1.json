    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the $y$-intercept by substituting $x=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-2)$",
          "worked": "$$\\begin{align*}y&=3(0)-2\\\\y&=-2\\end{align*}$$\nThe $y$-intercept is $(0,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the $x$-intercept by substituting $y=0$ then solving.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(\\frac23,0)$",
          "worked": "$$\\begin{align*}0&=3x-2\\\\2&=3x\\\\\\frac23&=x\\end{align*}$$\nThe $x$-intercept is $(\\frac23,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Sketch the graph on the axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Straight line through $(0,-2)$ and $(\\frac23,0)$.",
          "worked": "Plot $(0,-2)$ and $(\\frac23,0)$. Connect the intercepts and extend the straight line in both directions.",
          "solutionDiagrams": [
            {
              "id": "p7-q2-graph-answer",
              "role": "solution",
              "format": "tikz",
