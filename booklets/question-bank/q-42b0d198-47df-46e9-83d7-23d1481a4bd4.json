  "content": {
    "id": "p74-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the prime factorisations of $2475$ and $165$. Hence, simplify $\\dfrac{2475}{165}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2475=3^2\\times5^2\\times11$, $165=3\\times5\\times11$; $\\dfrac{2475}{165}=15$.",
      "worked": "$$\\begin{align*}2475&=3^2\\times5^2\\times11\\\\165&=3\\times5\\times11\\\\\\frac{2475}{165}&=\\frac{3^2\\times5^2\\times11}{3\\times5\\times11}\\\\\\frac{2475}{165}&=3\\times5\\\\\\frac{2475}{165}&=15\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
