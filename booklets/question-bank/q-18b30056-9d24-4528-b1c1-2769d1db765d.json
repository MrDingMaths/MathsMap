  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "",
    "prompt": "A spherical balloon is being inflated by a pump at a constant rate of $8\\pi\\text{ cm}^3/\\text{min}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression in terms of $r$ for the rate at which the radius of the balloon changes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dr}{dt}=\\dfrac{2}{r^2}\\text{ cm/min}$",
          "worked": "$$\\begin{align*}V&=\\frac43\\pi r^3\\\\\\frac{dV}{dr}&=4\\pi r^2\\\\\\frac{dr}{dt}&=\\frac{dr}{dV}\\times\\frac{dV}{dt}\\\\\\frac{dr}{dt}&=\\frac{1}{4\\pi r^2}\\times8\\pi\\\\\\frac{dr}{dt}&=\\frac{2}{r^2}\\text{ cm/min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the rate at which the radius of the balloon is changing when the radius is 4 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac18\\text{ cm/min}$",
          "worked": "When $r=4$,\n$$\\begin{align*}\\frac{dr}{dt}&=\\frac{2}{4^2}\\\\\\frac{dr}{dt}&=\\frac{2}{16}\\\\\\frac{dr}{dt}&=\\frac18\\text{ cm/min}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the rate at which the radius of the balloon is changing when the volume is $36\\pi\\text{ cm}^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac29\\text{ cm/min}$",
          "worked": "When $V=36\\pi$,\n$$\\begin{align*}\\frac43\\pi r^3&=36\\pi\\\\r^3&=27\\\\r&=3\\text{ cm}.\\end{align*}$$\nHence\n$$\\begin{align*}\\frac{dr}{dt}&=\\frac{2}{3^2}\\\\\\frac{dr}{dt}&=\\frac29\\text{ cm/min}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
