      {
        "id": "p11-ch7-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "A parabola has vertex $(3,-2)$ and $y$-intercept $16$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2(x-3)^2-2=2x^2-12x+16$",
          "worked": "The vertex gives $y=a(x-3)^2-2$. The $y$-intercept is the point $(0,16)$.\n$$\\begin{align*}16&=a(0-3)^2-2\\\\16&=9a-2\\\\18&=9a\\\\a&=2\\\\y&=2(x-3)^2-2\\\\y&=2x^2-12x+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p11-ch7-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "A parabola has vertex $(2,5)$ and passes through the point $(1,2)$. Find the equation of the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3(x-2)^2+5=-3x^2+12x-7$",
          "worked": "The vertex gives $y=a(x-2)^2+5$. Substitute the point $(1,2)$.\n$$\\begin{align*}2&=a(1-2)^2+5\\\\2&=a+5\\\\a&=-3\\\\y&=-3(x-2)^2+5\\\\y&=-3x^2+12x-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
