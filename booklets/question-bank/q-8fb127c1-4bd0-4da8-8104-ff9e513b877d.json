  "content": {
    "id": "p34-q24-root",
    "type": "question",
    "label": "24",
    "prompt": "Find the first value of $n$ for which a term of the sequence $100, 93, 86, \\ldots$ is less than $20$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$n=13$",
      "worked": "$a=100$, $d=-7$.\n$$\\begin{align*}a_n&<20\\\\100+(n-1)(-7)&<20\\\\100-7n+7&<20\\\\107-7n&<20\\\\87&<7n\\\\n&>\\frac{87}{7}\\end{align*}$$\nSince $n$ is an integer, the first value is $n=13$.",
      "solutionDiagrams": []
    },
