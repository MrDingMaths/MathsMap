  "content": {
    "id": "p34-q1",
    "type": "question",
    "label": "1",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p34-q1-model-introduction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Use the simplified magnitude–amplitude model",
              "marks": []
            }
          ]
        },
        {
          "id": "p34-q1-formula",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "M=\\log_{10}A",
              "display": true
            }
          ]
        },
        {
          "id": "p34-q1-definition-m",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "M",
              "display": false
            },
            {
              "type": "text",
              "text": " is earthquake magnitude.",
              "marks": []
            }
          ]
        },
        {
          "id": "p34-q1-definition-a",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "A",
              "display": false
            },
            {
              "type": "text",
              "text": " is ground-motion amplitude relative to a common reference.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Rewrite the formula with $A$ as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=10^M$.",
          "worked": "$$\\begin{align*}M&=\\log_{10}A\\\\A&=10^M\\end{align*}$$\nHere $A>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p34-q1-comparison-instructions",
        "type": "group",
        "label": null,
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p34-q1-ratio-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Find the ratio of the larger ground-motion amplitude to the smaller for each pair, using this model.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p34-q1-precision-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Answer to 2 s.f.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p34-q1-b",
            "type": "part",
            "label": "b",
            "prompt": {
              "format": "maths-editor-document-v1",
              "version": 1,
              "blocks": [
                {
                  "id": "p34-q1-b-magnitudes",
                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Magnitude 2 (smallest humans can feel)",
                      "marks": []
                    },
                    {
                      "type": "break"
                    },
                    {
                      "type": "text",
                      "text": "Magnitude 6 (major damage)",
                      "marks": []
                    }
                  ]
                }
              ]
            },
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1.0\\times10^4$ times the amplitude.",
              "worked": "$$\\begin{align*}A_6&=10^6\\\\A_2&=10^2\\\\\\frac{A_6}{A_2}&=\\frac{10^6}{10^2}\\\\\\frac{A_6}{A_2}&=10^4\\end{align*}$$\nThe magnitude 6 earthquake has $1.0\\times10^4$ times the amplitude (2 s.f.).",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p34-q1-c",
            "type": "part",
            "label": "c",
            "prompt": "3.5 and 6?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3.2\\times10^2$ times the amplitude.",
              "worked": "$$\\begin{align*}A_6&=10^6\\\\A_{3.5}&=10^{3.5}\\\\\\frac{A_6}{A_{3.5}}&=\\frac{10^6}{10^{3.5}}\\\\\\frac{A_6}{A_{3.5}}&=10^{2.5}\\\\\\frac{A_6}{A_{3.5}}&\\approx3.2\\times10^2\\end{align*}$$\nThe magnitude 6 earthquake has $3.2\\times10^2$ times the amplitude (2 s.f.).",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p34-q1-d",
            "type": "part",
            "label": "d",
            "prompt": "3.2 and 8.6?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2.5\\times10^5$ times the amplitude.",
              "worked": "$$\\begin{align*}A_{8.6}&=10^{8.6}\\\\A_{3.2}&=10^{3.2}\\\\\\frac{A_{8.6}}{A_{3.2}}&=\\frac{10^{8.6}}{10^{3.2}}\\\\\\frac{A_{8.6}}{A_{3.2}}&=10^{5.4}\\\\\\frac{A_{8.6}}{A_{3.2}}&\\approx2.5\\times10^5\\end{align*}$$\nThe magnitude 8.6 earthquake has $2.5\\times10^5$ times the amplitude (2 s.f.).",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p34-q1-e",
            "type": "part",
            "label": "e",
            "prompt": "2.8 and 3.6?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6.3$ times the amplitude.",
              "worked": "$$\\begin{align*}A_{3.6}&=10^{3.6}\\\\A_{2.8}&=10^{2.8}\\\\\\frac{A_{3.6}}{A_{2.8}}&=\\frac{10^{3.6}}{10^{2.8}}\\\\\\frac{A_{3.6}}{A_{2.8}}&=10^{0.8}\\\\\\frac{A_{3.6}}{A_{2.8}}&\\approx6.3\\end{align*}$$\nThe magnitude 3.6 earthquake has $6.3$ times the amplitude (2 s.f.).",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      }
    ]
  },
