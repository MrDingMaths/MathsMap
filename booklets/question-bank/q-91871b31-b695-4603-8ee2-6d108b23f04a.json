    "type": "question",
    "label": "15",
    "prompt": "A large tank in the shape of a rectangular prism has internal dimensions $3\\text{ m}\\times2\\text{ m}\\times1.5\\text{ m}$. How many litres does the tank hold when full?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9000\\text{ L}$",
      "worked": "$V=3\\times2\\times1.5=9\\text{ m}^3$. Since $1\\text{ m}^3=1000\\text{ L}$, capacity $=9\\times1000=9000\\text{ L}$.",
