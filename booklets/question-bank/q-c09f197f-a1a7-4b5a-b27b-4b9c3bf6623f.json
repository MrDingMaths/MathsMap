  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Identify the dilation factor for the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=f(2x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "For a horizontal dilation, replace $x$ by $\\frac{x}{k}$.\n$$\\begin{align*}2x&=\\frac{x}{k}\\\\k&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=f\\left(\\dfrac{x}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "For a horizontal dilation, replace $x$ by $\\frac{x}{k}$.\n$$\\begin{align*}\\frac{x}{3}&=\\frac{x}{k}\\\\k&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=f\\left(\\dfrac{2x}{\\pi}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\pi}{2}$",
          "worked": "For a horizontal dilation, replace $x$ by $\\frac{x}{k}$.\n$$\\begin{align*}\\frac{2x}{\\pi}&=\\frac{x}{\\pi/2}\\\\k&=\\frac{\\pi}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=f\\left(\\dfrac{3x}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{3}$",
          "worked": "For a horizontal dilation, replace $x$ by $\\frac{x}{k}$.\n$$\\begin{align*}\\frac{3x}{2}&=\\frac{x}{2/3}\\\\k&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
