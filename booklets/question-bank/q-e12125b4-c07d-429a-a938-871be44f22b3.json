        "answer": {
          "short": "True.",
          "worked": "True: $16^{\\frac12}=\\sqrt{16}=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p7-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$27^{\\frac13}=9$",
