        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False: $5^{\\frac13}=\\sqrt[3]{5}$, whereas $\\sqrt5=5^{\\frac12}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p7-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$10^{\\frac16}=\\sqrt[10]{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False: $10^{\\frac16}=\\sqrt[6]{10}$. The denominator gives the root index; the base stays inside the root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p7-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$8^{\\frac12}=4$",
