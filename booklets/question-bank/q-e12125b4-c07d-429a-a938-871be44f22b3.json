        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False: $8^{\\frac12}=\\sqrt8$. Since $4^2=16$, $4$ is not the square root of $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p7-q10-f",
        "type": "part",
