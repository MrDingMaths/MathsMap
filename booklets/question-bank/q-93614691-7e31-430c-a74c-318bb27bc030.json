      {
        "id": "index-t6-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f^8g^3\\div(f^2g^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f^{6}g$",
          "worked": "$$\\begin{align*}\nf^8g^3\\div(f^2g^2) &= f^{8 - 2}\\,g^{3 - 2} \\\\\n&= f^{6}g\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f^8g^2\\div(f^2g^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{f^{6}}{g}$",
          "worked": "$$\\begin{align*}\nf^8g^2\\div(f^2g^3) &= \\frac{f^{8 - 2}}{g^{3 - 2}} \\\\\n&= \\frac{f^{6}}{g}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$f^2g^3\\div(f^8g^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{g}{f^{6}}$",
          "worked": "$$\\begin{align*}\nf^2g^3\\div(f^8g^2) &= \\frac{g^{3 - 2}}{f^{8 - 2}} \\\\\n&= \\frac{g}{f^{6}}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t6-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$f^2g^2\\div(f^8g^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{f^{6}g}$",
          "worked": "$$\\begin{align*}\nf^2g^2\\div(f^8g^3) &= \\frac{1}{f^{8 - 2}\\,g^{3 - 2}} \\\\\n&= \\frac{1}{f^{6}g}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      }
