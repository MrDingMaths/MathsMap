  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A circle has diameter $AC=13$. Given $AB=5$ for a point $B$ on the circle, find $BC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12$",
      "worked": "$\\angle ABC=90^\\circ$ because it is an angle in a semicircle.\n$$\\begin{align*}BC^2+5^2&=13^2\\\\BC^2&=144\\\\BC&=12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
