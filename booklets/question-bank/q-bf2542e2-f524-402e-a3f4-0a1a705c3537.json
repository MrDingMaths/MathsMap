    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:200\\,000$",
      "worked": "Use the same units for image and original.\n$$\\begin{align*}2\\text{ km}&=200\\,000\\text{ cm}\\\\\\text{Image}:\\text{Original}&=1\\text{ cm}:200\\,000\\text{ cm}\\\\&=1:200\\,000\\end{align*}$$",
