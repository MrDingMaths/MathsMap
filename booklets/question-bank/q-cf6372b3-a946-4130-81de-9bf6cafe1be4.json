    "label": "2",
    "prompt": "Solve each quadratic equation by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-8x+15=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$ or $x=5$.",
          "worked": "$$\\begin{align*}x^2-8x&=-15\\\\x^2-8x+16&=-15+16\\\\(x-4)^2&=1\\\\x-4&=\\pm1\\\\x&=3\\text{ or }5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$t^2-11t+30=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=5$ or $t=6$.",
          "worked": "$$\\begin{align*}t^2-11t&=-30\\\\t^2-11t+\\frac{121}{4}&=-30+\\frac{121}{4}\\\\\\left(t-\\frac{11}{2}\\right)^2&=\\frac14\\\\t-\\frac{11}{2}&=\\pm\\frac12\\\\t&=5\\text{ or }6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p26-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\pm\\sqrt3$.",
          "worked": "$$\\begin{align*}x^2-4x&=-1\\\\x^2-4x+4&=-1+4\\\\(x-2)^2&=3\\\\x-2&=\\pm\\sqrt3\\\\x&=2\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+2x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1\\pm\\sqrt2$.",
          "worked": "$$\\begin{align*}x^2+2x&=1\\\\x^2+2x+1&=1+1\\\\(x+1)^2&=2\\\\x+1&=\\pm\\sqrt2\\\\x&=-1\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y^2+y=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac{-1\\pm\\sqrt{13}}2$.",
          "worked": "$$\\begin{align*}y^2+y+\\frac14&=3+\\frac14\\\\\\left(y+\\frac12\\right)^2&=\\frac{13}{4}\\\\y+\\frac12&=\\pm\\frac{\\sqrt{13}}2\\\\y&=\\frac{-1\\pm\\sqrt{13}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p26-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$v^2-20v=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=10\\pm\\sqrt{107}$.",
          "worked": "$$\\begin{align*}v^2-20v+100&=7+100\\\\(v-10)^2&=107\\\\v-10&=\\pm\\sqrt{107}\\\\v&=10\\pm\\sqrt{107}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p26-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2-3x=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3\\pm\\sqrt{37}}2$.",
          "worked": "$$\\begin{align*}x^2-3x+\\frac94&=7+\\frac94\\\\\\left(x-\\frac32\\right)^2&=\\frac{37}{4}\\\\x-\\frac32&=\\pm\\frac{\\sqrt{37}}2\\\\x&=\\frac{3\\pm\\sqrt{37}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p26-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$z^2-2z=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z=3$ or $z=-1$.",
          "worked": "$$\\begin{align*}z^2-2z+1&=3+1\\\\(z-1)^2&=4\\\\z-1&=\\pm2\\\\z&=3\\text{ or }-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p26-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$2z^2+4z=64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$z=-1\\pm\\sqrt{33}$.",
          "worked": "$$\\begin{align*}z^2+2z&=32\\\\z^2+2z+1&=32+1\\\\(z+1)^2&=33\\\\z+1&=\\pm\\sqrt{33}\\\\z&=-1\\pm\\sqrt{33}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p26-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$2x^2-5x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=\\dfrac12$.",
          "worked": "$$\\begin{align*}2x^2-5x&=-2\\\\x^2-\\frac52x&=-1\\\\x^2-\\frac52x+\\frac{25}{16}&=-1+\\frac{25}{16}\\\\\\left(x-\\frac54\\right)^2&=\\frac9{16}\\\\x-\\frac54&=\\pm\\frac34\\\\x&=2\\text{ or }\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p26-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$3x^2+x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-1\\pm\\sqrt{37}}6$.",
          "worked": "$$\\begin{align*}3x^2+x&=3\\\\x^2+\\frac13x&=1\\\\x^2+\\frac13x+\\frac1{36}&=1+\\frac1{36}\\\\\\left(x+\\frac16\\right)^2&=\\frac{37}{36}\\\\x+\\frac16&=\\pm\\frac{\\sqrt{37}}6\\\\x&=\\frac{-1\\pm\\sqrt{37}}6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p26-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$4x^2-3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{3\\pm\\sqrt{41}}8$.",
          "worked": "$$\\begin{align*}4x^2-3x&=2\\\\x^2-\\frac34x&=\\frac12\\\\x^2-\\frac34x+\\frac9{64}&=\\frac12+\\frac9{64}\\\\\\left(x-\\frac38\\right)^2&=\\frac{41}{64}\\\\x-\\frac38&=\\pm\\frac{\\sqrt{41}}8\\\\x&=\\frac{3\\pm\\sqrt{41}}8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      }
