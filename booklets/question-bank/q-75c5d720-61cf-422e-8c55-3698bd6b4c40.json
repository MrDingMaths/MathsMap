        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"PDF page 12, p12-q6-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black},line cap=round,line join=round]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n% Solid model in centimetres: A=(-5,-5,0), B=(5,-5,0), C=(5,5,0), D=(-5,5,0), O=(0,0,0), H=(0,0,sqrt(14)).\n% Faces: ABCD, HAB, HBC, HCD, HDA. Orthographic projection: X=.18x+.39y+2.85; Y=-.12x+.06y+(3.9/sqrt(14))z+.9.\n% Direction toward viewer is proportional to (1.521/sqrt(14),-0.702/sqrt(14),0.0576). HAB and HBC are visible; HCD, HDA and the base are hidden. HA and HC are silhouettes. HO is an interior construction, not a solid edge.\n\\coordinate (A) at (0,1.2);\n\\coordinate (B) at (1.8,0);\n\\coordinate (C) at (5.7,.6);\n\\coordinate (D) at (3.9,1.8);\n\\coordinate (O) at (2.85,.9);\n\\coordinate (H) at (2.85,4.8);\n\\draw[black,line width=.8pt,dashed] (A)--(D)--(C) (D)--(H);\n\\draw[black,line width=.4pt,dashed] (H)--(O);\n\\draw[black,line width=.8pt] (A)--(B)--(C)--(H)--(A) (H)--(B);\n% Equality ticks use the projected edge midpoints and normals.\n\\draw[black,line width=.4pt] (.845,.52)--(.955,.68);\n\\draw[black,line width=.4pt] (3.735,.40)--(3.765,.20);\n\\draw[black,line width=.4pt] (4.745,1.12)--(4.855,1.28);\n\\draw[black,line width=.4pt] (1.935,1.60)--(1.965,1.40);\n\\path (A)--(H) node[midway,left=4pt] {$8\\text{ cm}$};\n\\path (B)--(C) node[midway,below=5pt] {$10\\text{ cm}$};\n\\fill[black] (A) circle (1.2pt) (B) circle (1.2pt) (C) circle (1.2pt) (D) circle (1.2pt) (H) circle (1.2pt) (O) circle (1.2pt);\n\\node[below left=2pt] at (A) {$A$};\n\\node[below=3pt] at (B) {$B$};\n\\node[below right=2pt] at (C) {$C$};\n\\node[below=3pt] at (D) {$D$};\n\\node[above=3pt] at (H) {$H$};\n\\node[below=3pt] at (O) {$O$};\n\\end{tikzpicture}",
        "src": null,
