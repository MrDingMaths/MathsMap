  "content": {
    "id": "p10-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find answers to these questions in $\\mathrm{cm}^2$ and $\\mathrm{cm}^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q6-a",
        "type": "group",
        "label": "a",
        "prompt": "A square-based pyramid has base side length $10\\text{ cm}$ and perpendicular height $12\\text{ cm}$.\n\nCalculate:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q6-a-i",
            "type": "part",
            "label": "i",
            "prompt": "the surface area",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$360\\text{ cm}^2$",
              "worked": "The slant height $s$ runs from the vertex to the midpoint of a base edge.\n\n$$\\begin{align*}s&=\\sqrt{12^2+5^2}\\\\s&=13\\text{ cm}\\\\S&=10^2+4\\left(\\frac12\\times10\\times13\\right)\\\\S&=100+260\\\\S&=360\\text{ cm}^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 43
          },
          {
            "id": "p10-q6-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the volume",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$400\\text{ cm}^3$",
              "worked": "$$\\begin{align*}V&=\\frac13Ah\\\\V&=\\frac13\\times10^2\\times12\\\\V&=400\\text{ cm}^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          }
        ]
      },
      {
        "id": "p10-q6-b",
        "type": "group",
        "label": "b",
        "prompt": "A cone has a radius of $6\\text{ cm}$ and a slant height of $10\\text{ cm}$.\n\nCalculate:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q6-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the surface area",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$96\\pi\\text{ cm}^2$",
              "worked": "$$\\begin{align*}S&=\\pi r^2+\\pi rs\\\\S&=\\pi\\times6^2+\\pi\\times6\\times10\\\\S&=96\\pi\\text{ cm}^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p10-q6-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the volume",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$96\\pi\\text{ cm}^3$",
              "worked": "$$\\begin{align*}h&=\\sqrt{10^2-6^2}\\\\h&=8\\text{ cm}\\\\V&=\\frac13\\pi r^2h\\\\V&=\\frac13\\times\\pi\\times6^2\\times8\\\\V&=96\\pi\\text{ cm}^3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 39
          }
        ]
      }
    ]
  },
