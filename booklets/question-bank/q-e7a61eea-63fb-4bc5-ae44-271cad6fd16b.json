    "id": "p29-q7",
    "type": "question",
    "label": "7",
    "prompt": "20, 99 and $x$ form a Pythagorean triad, where $x$ is the largest number. Find the value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$101$",
      "worked": "Since $x$ is the largest number, it is the hypotenuse.\n$$\\begin{align*}x &= \\sqrt{20^2+99^2}\\\\x &= \\sqrt{10201}\\\\x &= 101\\end{align*}$$",
      "solutionDiagrams": []
    },
