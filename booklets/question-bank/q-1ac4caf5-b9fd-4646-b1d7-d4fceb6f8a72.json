  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find $\\Pr(A)$ if $A$ and $B$ are independent and\n$$\\Pr(A\\cup B)=0.8,\\quad \\Pr(B)=0.6.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.5$",
      "worked": "$$\\begin{align*}\\Pr(A\\cup B)&=\\Pr(A)+\\Pr(B)-\\Pr(A)\\Pr(B)\\\\0.8&=\\Pr(A)+0.6-0.6\\Pr(A)\\\\0.2&=0.4\\Pr(A)\\\\\\Pr(A)&=0.5.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
