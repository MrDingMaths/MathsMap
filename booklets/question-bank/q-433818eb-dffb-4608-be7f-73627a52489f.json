    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin45^{\\circ}+\\cos30^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2+\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\sin45^{\\circ}+\\cos30^{\\circ}&=\\frac{1}{\\sqrt2}+\\frac{\\sqrt3}{2}\\\\\\sin45^{\\circ}+\\cos30^{\\circ}&=\\frac{\\sqrt2}{2}+\\frac{\\sqrt3}{2}\\\\\\sin45^{\\circ}+\\cos30^{\\circ}&=\\frac{\\sqrt2+\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p8-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos45^{\\circ}+\\sin60^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2+\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\cos45^{\\circ}+\\sin60^{\\circ}&=\\frac{1}{\\sqrt2}+\\frac{\\sqrt3}{2}\\\\\\cos45^{\\circ}+\\sin60^{\\circ}&=\\frac{\\sqrt2}{2}+\\frac{\\sqrt3}{2}\\\\\\cos45^{\\circ}+\\sin60^{\\circ}&=\\frac{\\sqrt2+\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p8-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin45^{\\circ}\\cos45^{\\circ}+\\sin30^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\sin45^{\\circ}\\cos45^{\\circ}+\\sin30^{\\circ}&=\\frac{1}{\\sqrt2}\\times\\frac{1}{\\sqrt2}+\\frac12\\\\\\sin45^{\\circ}\\cos45^{\\circ}+\\sin30^{\\circ}&=\\frac12+\\frac12\\\\\\sin45^{\\circ}\\cos45^{\\circ}+\\sin30^{\\circ}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p8-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin60^{\\circ}\\cos30^{\\circ}-\\cos60^{\\circ}\\sin30^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}\\sin60^{\\circ}\\cos30^{\\circ}-\\cos60^{\\circ}\\sin30^{\\circ}&=\\frac{\\sqrt3}{2}\\times\\frac{\\sqrt3}{2}-\\frac12\\times\\frac12\\\\\\sin60^{\\circ}\\cos30^{\\circ}-\\cos60^{\\circ}\\sin30^{\\circ}&=\\frac34-\\frac14\\\\\\sin60^{\\circ}\\cos30^{\\circ}-\\cos60^{\\circ}\\sin30^{\\circ}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p8-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$1+\\tan^2 60^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{align*}1+\\tan^2 60^{\\circ}&=1+(\\sqrt3)^2\\\\1+\\tan^2 60^{\\circ}&=1+3\\\\1+\\tan^2 60^{\\circ}&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{1}{\\sin^2 30^{\\circ}}-\\dfrac{1}{\\tan^2 30^{\\circ}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sin^2 30^{\\circ}}-\\frac{1}{\\tan^2 30^{\\circ}}&=\\frac{1}{(\\frac12)^2}-\\frac{1}{(\\frac{1}{\\sqrt3})^2}\\\\\\frac{1}{\\sin^2 30^{\\circ}}-\\frac{1}{\\tan^2 30^{\\circ}}&=\\frac{1}{\\frac14}-\\frac{1}{\\frac13}\\\\\\frac{1}{\\sin^2 30^{\\circ}}-\\frac{1}{\\tan^2 30^{\\circ}}&=4-3\\\\\\frac{1}{\\sin^2 30^{\\circ}}-\\frac{1}{\\tan^2 30^{\\circ}}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
