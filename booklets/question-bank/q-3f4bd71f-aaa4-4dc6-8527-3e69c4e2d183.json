        "id": "p32-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}+\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}+\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=\\frac{(\\sqrt{5}-\\sqrt{3})^2}{5-3}+\\frac{(\\sqrt{5}+\\sqrt{3})^2}{5-3}\\\\\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}+\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=\\frac{8-2\\sqrt{15}}{2}+\\frac{8+2\\sqrt{15}}{2}\\\\\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}+\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=\\frac{16}{2}\\\\\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}+\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}-\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sqrt{15}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}-\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=\\frac{(\\sqrt{5}-\\sqrt{3})^2}{5-3}-\\frac{(\\sqrt{5}+\\sqrt{3})^2}{5-3}\\\\\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}-\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=\\frac{8-2\\sqrt{15}-(8+2\\sqrt{15})}{2}\\\\\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}-\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=\\frac{-4\\sqrt{15}}{2}\\\\\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}-\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}&=-2\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p32-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{5}{(\\sqrt{7}-\\sqrt{2})^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9+2\\sqrt{14}}{5}$",
          "worked": "$$\\begin{align*}\\frac{5}{(\\sqrt{7}-\\sqrt{2})^2}&=\\frac{5}{7-2\\sqrt{14}+2}\\\\\\frac{5}{(\\sqrt{7}-\\sqrt{2})^2}&=\\frac{5}{9-2\\sqrt{14}}\\times\\frac{9+2\\sqrt{14}}{9+2\\sqrt{14}}\\\\\\frac{5}{(\\sqrt{7}-\\sqrt{2})^2}&=\\frac{5(9+2\\sqrt{14})}{81-56}\\\\\\frac{5}{(\\sqrt{7}-\\sqrt{2})^2}&=\\frac{5(9+2\\sqrt{14})}{25}\\\\\\frac{5}{(\\sqrt{7}-\\sqrt{2})^2}&=\\frac{9+2\\sqrt{14}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
