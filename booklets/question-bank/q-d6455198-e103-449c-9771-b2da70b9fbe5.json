      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What percentage of the animals on the farm are two-legged?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$",
          "worked": "The chickens and geese are two-legged.\n\n$$\\begin{aligned}\\text{Total animals}&=6+3+25+2+4+4+6\\\\\\text{Total animals}&=50\\\\\\text{Two-legged animals}&=6+4\\\\\\text{Two-legged animals}&=10\\\\\\text{Percentage two-legged}&=\\frac{10}{50}\\times100\\%\\\\\\text{Percentage two-legged}&=20\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "What percentage of the animals on the farm are not sheep?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50\\%$",
          "worked": "There are 50 animals altogether and 25 are sheep.\n\n$$\\begin{aligned}\\text{Animals that are not sheep}&=50-25\\\\\\text{Animals that are not sheep}&=25\\\\\\text{Percentage not sheep}&=\\frac{25}{50}\\times100\\%\\\\\\text{Percentage not sheep}&=50\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
