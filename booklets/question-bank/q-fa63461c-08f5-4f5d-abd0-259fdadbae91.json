  "content": {
    "id": "p15-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "If $\\alpha,\\beta,$ and $\\gamma$ are the roots of $2x^3+5x^2-x-3=0$, find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha\\beta\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac32$",
          "worked": "$\\alpha\\beta\\gamma=-\\dfrac{d}{a}=-\\dfrac{-3}{2}=\\dfrac32$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma=\\dfrac{c}{a}=\\dfrac{-1}{2}=-\\dfrac12$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha+\\beta+\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac52$",
          "worked": "$\\alpha+\\beta+\\gamma=-\\dfrac{b}{a}=-\\dfrac52$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac1\\alpha+\\dfrac1\\beta+\\dfrac1\\gamma$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac13$",
          "worked": "$\\begin{aligned}\\frac1\\alpha+\\frac1\\beta+\\frac1\\gamma&=\\frac{\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma}{\\alpha\\beta\\gamma}\\\\&=\\frac{-\\frac{1}{2}}{\\frac{3}{2}}\\\\&=-\\frac13\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\alpha+1)(\\beta+1)(\\gamma+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$\\begin{aligned}(\\alpha+1)(\\beta+1)(\\gamma+1)&=\\alpha\\beta\\gamma+(\\alpha\\beta+\\alpha\\gamma+\\beta\\gamma)\\\\&\\quad +(\\alpha+\\beta+\\gamma)+1\\\\&=\\frac32-\\frac12-\\frac52+1\\\\&=-\\frac12\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
