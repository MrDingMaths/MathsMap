  "content": {
    "id": "p17-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "To say that a number $x$ is positive is to say that $x>0$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "If $10x-40$ is positive, find all the possible values of $x$. That is, solve $10x-40>0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>4$",
          "worked": "$$\\begin{align*}10x-40&>0\\\\10x&>40\\\\x&>4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find all $k$ values that make $2k-6$ positive.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k>3$",
          "worked": "$$\\begin{align*}2k-6&>0\\\\2k&>6\\\\k&>3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p17-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "If $3a+6$ is negative and $10-2a$ is positive, what are the possible values of $a$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a<-2$; this satisfies both conditions.",
          "worked": "$$\\begin{align*}3a+6&<0\\\\3a&<-6\\\\a&<-2\\end{align*}$$\n$$\\begin{align*}10-2a&>0\\\\-2a&>-10\\\\a&<5\\end{align*}$$\nDividing by $-2$ reverses the inequality sign. Both conditions hold when $a<-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p17-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "If $5a+10$ is negative and $10a+30$ is positive, what are the possible values of $a$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3<a<-2$",
          "worked": "$$\\begin{align*}5a+10&<0\\\\5a&<-10\\\\a&<-2\\end{align*}$$\n$$\\begin{align*}10a+30&>0\\\\10a&>-30\\\\a&>-3\\end{align*}$$\nBoth conditions hold when $-3<a<-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
