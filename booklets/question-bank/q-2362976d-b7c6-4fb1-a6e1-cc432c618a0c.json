    "type": "question",
    "label": "8",
    "prompt": "Jane sells jewellery. Her commission is based on a sliding scale of 6% on the first \\$2000 of her sales, 3.5% on the next \\$1000, and 2% thereafter.\nWhat is Jane’s commission when her total sales are \\$5670?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$208.40: \\$120 + \\$35 + \\$53.40.",
      "worked": "$$\\begin{align*}\\text{Remaining sales}&=5670-2000-1000\\\\&=\\$2670\\\\\\text{Commission}&=0.06\\times2000+0.035\\times1000+0.02\\times2670\\\\&=120+35+53.40\\\\&=\\$208.40\\end{align*}$$",
      "solutionDiagrams": []
    },
