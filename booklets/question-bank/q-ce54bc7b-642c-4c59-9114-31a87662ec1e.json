  "content": {
    "id": "p12-q8-response",
    "type": "question",
    "label": "",
    "prompt": "The length of a netball court is measured to be 30.50 metres, correct to the nearest centimetre.\n\nWhat is the lower limit for the length of the netball court?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$30.495\\text{ m}$; subtract half the precision, $0.005\\text{ m}$.",
      "worked": "$$\\begin{aligned}\\text{Precision}&=1\\text{ cm}=0.01\\text{ m}\\\\\\text{Absolute error}&=\\tfrac12\\times0.01\\text{ m}=0.005\\text{ m}\\\\\\text{Lower limit}&=30.50\\text{ m}-0.005\\text{ m}=30.495\\text{ m}\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
