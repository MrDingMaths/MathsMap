  "content": {
    "id": "p15-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2+6x+9}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+3$",
          "worked": "$$\\begin{align*}\\frac{x^2+6x+9}{x+3}&=\\frac{(x+3)^2}{x+3}\\\\&=x+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-6x+9}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-3$",
          "worked": "$$\\begin{align*}\\frac{x^2-6x+9}{x-3}&=\\frac{(x-3)^2}{x-3}\\\\&=x-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2+4x+4}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2$",
          "worked": "$$\\begin{align*}\\frac{x^2+4x+4}{x+2}&=\\frac{(x+2)^2}{x+2}\\\\&=x+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+3}{x^2+6x+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{x^2+6x+9}&=\\frac{x+3}{(x+3)^2}\\\\&=\\frac{1}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x^2+6x+9}{x^2-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{x-3}$",
          "worked": "$$\\begin{align*}\\frac{x^2+6x+9}{x^2-9}&=\\frac{(x+3)^2}{(x-3)(x+3)}\\\\&=\\frac{x+3}{x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2-9}{x^2+6x+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-3}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x^2-9}{x^2+6x+9}&=\\frac{(x-3)(x+3)}{(x+3)^2}\\\\&=\\frac{x-3}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{x^2-4x+4}{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x-2}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{x^2-4x+4}{x^2-4}&=\\frac{(x-2)^2}{(x-2)(x+2)}\\\\&=\\frac{x-2}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x^2+10x+25}{x^2-25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+5}{x-5}$",
          "worked": "$$\\begin{align*}\\frac{x^2+10x+25}{x^2-25}&=\\frac{(x+5)^2}{(x-5)(x+5)}\\\\&=\\frac{x+5}{x-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
