    "children": [
      {
        "id": "p12-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the rate of flow in litres/min.\nChoose two points that you can read clearly.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\text{ L/min}$",
          "worked": "Using $(0,0)$ and $(5,60)$:\n$$\\begin{align*}\n\\text{Rate of flow} &= \\frac{\\text{rise}}{\\text{run}}\\\\\n&= \\frac{60-0}{5-0}\\\\\n&= 12\\text{ L/min}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How much water will flow into the tank in 1 hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$720\\text{ L}$",
          "worked": "$1\\text{ hour}=60\\text{ minutes}$.\n$$\\begin{align*}\nV &= 12t\\\\\nV &= 12(60)\\\\\nV &= 720\\text{ L}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "The capacity of the tank is 1800 litres.\nHow long will it take to completely fill the tank at the rate you found in part a?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150\\text{ min}$",
          "worked": "$$\\begin{align*}\n1800 &= 12t\\\\\n\\frac{1800}{12} &= t\\\\\nt &= 150\\text{ min}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
