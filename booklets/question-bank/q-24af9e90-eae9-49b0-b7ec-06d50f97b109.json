        "label": "b",
        "prompt": "$6x^2-11x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-3)(3x-1)$",
          "worked": "$(-9)(-2)=18$ and $-9-2=-11$.\n$$\\begin{align*}6x^2-11x+3&=6x^2-9x-2x+3\\\\6x^2-11x+3&=3x(2x-3)-(2x-3)\\\\6x^2-11x+3&=(2x-3)(3x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
