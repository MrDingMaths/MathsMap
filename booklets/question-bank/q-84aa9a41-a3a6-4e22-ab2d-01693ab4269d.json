  "content": {
    "id": "p37-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the exact value of each definite integral using the given substitution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p37-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^1 x^2(2+x^3)^3\\,dx,\\quad u=2+x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{65}{12}$",
          "worked": "Let $u=2+x^3$.\n$$\\begin{aligned}\\frac{du}{dx}&=3x^2\\\\dx&=\\frac{du}{3x^2}\\end{aligned}$$\nWhen $x=0$, $u=2$; when $x=1$, $u=3$.\n$$\\begin{aligned}\\int_0^1x^2(2+x^3)^3\\,dx&=\\frac13\\int_2^3u^3\\,du\\\\&=\\left[\\frac{u^4}{12}\\right]_2^3\\\\&=\\frac{81-16}{12}\\\\&=\\frac{65}{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p37-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^1\\frac{2x^3}{\\sqrt{1+x^4}}\\,dx,\\quad u=1+x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2-1$",
          "worked": "Let $u=1+x^4$.\n$$\\begin{aligned}\\frac{du}{dx}&=4x^3\\\\dx&=\\frac{du}{4x^3}\\end{aligned}$$\nWhen $x=0$, $u=1$; when $x=1$, $u=2$.\n$$\\begin{aligned}\\int_0^1\\frac{2x^3}{\\sqrt{1+x^4}}\\,dx&=\\frac12\\int_1^2u^{-1/2}\\,du\\\\&=\\left[u^{1/2}\\right]_1^2\\\\&=\\sqrt2-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p37-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_0^{\\pi/2}\\cos^2x\\sin x\\,dx,\\quad u=\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13$",
          "worked": "Let $u=\\cos x$.\n$$\\begin{aligned}\\frac{du}{dx}&=-\\sin x\\\\dx&=-\\frac{du}{\\sin x}\\end{aligned}$$\nWhen $x=0$, $u=1$; when $x=\\frac{\\pi}{2}$, $u=0$.\n$$\\begin{aligned}\\int_0^{\\pi/2}\\cos^2x\\sin x\\,dx&=-\\int_1^0u^2\\,du\\\\&=-\\left[\\frac{u^3}{3}\\right]_1^0\\\\&=\\frac13\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p37-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{\\sqrt3/2}^1x\\sqrt{1-x^2}\\,dx,\\quad u=1-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{24}$",
          "worked": "Let $u=1-x^2$.\n$$\\begin{aligned}\\frac{du}{dx}&=-2x\\\\dx&=-\\frac{du}{2x}\\end{aligned}$$\nWhen $x=\\frac{\\sqrt3}{2}$, $u=\\frac{1}{4}$; when $x=1$, $u=0$.\n$$\\begin{aligned}\\int_{\\sqrt3/2}^1x\\sqrt{1-x^2}\\,dx&=-\\frac12\\int_{1/4}^0u^{1/2}\\,du\\\\&=-\\frac13\\left[u^{3/2}\\right]_{1/4}^0\\\\&=-\\frac13\\left(0-\\frac18\\right)\\\\&=\\frac1{24}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p37-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_1^{e^2}\\frac{\\ln x}{x}\\,dx,\\quad u=\\ln x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "Let $u=\\ln x$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\frac1x\\\\dx&=x\\,du\\end{aligned}$$\nWhen $x=1$, $u=0$; when $x=e^2$, $u=2$.\n$$\\begin{aligned}\\int_1^{e^2}\\frac{\\ln x}{x}\\,dx&=\\int_0^2u\\,du\\\\&=\\left[\\frac{u^2}{2}\\right]_0^2\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p37-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_0^4\\frac{e^{\\sqrt x}}{4\\sqrt x}\\,dx,\\quad u=\\sqrt x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12(e^2-1)$",
          "worked": "Let $u=\\sqrt x$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\frac1{2\\sqrt x}\\\\dx&=2\\sqrt x\\,du\\end{aligned}$$\nWhen $x=0$, $u=0$; when $x=4$, $u=2$.\n$$\\begin{aligned}\\int_0^4\\frac{e^{\\sqrt x}}{4\\sqrt x}\\,dx&=\\frac12\\int_0^2e^u\\,du\\\\&=\\frac12\\left[e^u\\right]_0^2\\\\&=\\frac12(e^2-1)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p37-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\displaystyle\\int_0^{\\pi/4}\\sin^4(2x)\\cos(2x)\\,dx,\\quad u=\\sin2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac1{10}$",
          "worked": "Let $u=\\sin2x$.\n$$\\begin{aligned}\\frac{du}{dx}&=2\\cos2x\\\\dx&=\\frac{du}{2\\cos2x}\\end{aligned}$$\nWhen $x=0$, $u=0$; when $x=\\frac{\\pi}{4}$, $u=1$.\n$$\\begin{aligned}\\int_0^{\\pi/4}\\sin^4(2x)\\cos(2x)\\,dx&=\\frac12\\int_0^1u^4\\,du\\\\&=\\left[\\frac{u^5}{10}\\right]_0^1\\\\&=\\frac1{10}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p37-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\displaystyle\\int_0^1\\frac{(\\sin^{-1}x)^3}{\\sqrt{1-x^2}}\\,dx,\\quad u=\\sin^{-1}x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\pi^4}{64}$",
          "worked": "Let $u=\\sin^{-1}x$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\frac1{\\sqrt{1-x^2}}\\\\dx&=\\sqrt{1-x^2}\\,du\\end{aligned}$$\nWhen $x=0$, $u=0$; when $x=1$, $u=\\frac{\\pi}{2}$.\n$$\\begin{aligned}\\int_0^1\\frac{(\\sin^{-1}x)^3}{\\sqrt{1-x^2}}\\,dx&=\\int_0^{\\pi/2}u^3\\,du\\\\&=\\left[\\frac{u^4}{4}\\right]_0^{\\pi/2}\\\\&=\\frac14\\left(\\frac\\pi2\\right)^4\\\\&=\\frac{\\pi^4}{64}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p37-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\displaystyle\\int_0^2\\frac{x+1}{\\sqrt[3]{x^2+2x}}\\,dx,\\quad u=x^2+2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "Let $u=x^2+2x$.\n$$\\begin{aligned}\\frac{du}{dx}&=2x+2\\\\dx&=\\frac{du}{2(x+1)}\\end{aligned}$$\nWhen $x=0$, $u=0$; when $x=2$, $u=8$.\n$$\\begin{aligned}\\int_0^2\\frac{x+1}{\\sqrt[3]{x^2+2x}}\\,dx&=\\frac12\\int_0^8u^{-1/3}\\,du\\\\&=\\frac34\\left[u^{2/3}\\right]_0^8\\\\&=\\frac34(4-0)\\\\&=3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p37-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\displaystyle\\int_{\\pi/4}^{\\pi/3}\\frac{\\sec^2x}{\\tan x}\\,dx,\\quad u=\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12\\ln3$",
          "worked": "Let $u=\\tan x$.\n$$\\begin{aligned}\\frac{du}{dx}&=\\sec^2x\\\\dx&=\\frac{du}{\\sec^2x}\\end{aligned}$$\nWhen $x=\\frac{\\pi}{4}$, $u=1$; when $x=\\frac{\\pi}{3}$, $u=\\sqrt3$.\n$$\\begin{aligned}\\int_{\\pi/4}^{\\pi/3}\\frac{\\sec^2x}{\\tan x}\\,dx&=\\int_1^{\\sqrt3}\\frac1u\\,du\\\\&=\\left[\\ln u\\right]_1^{\\sqrt3}\\\\&=\\ln\\sqrt3-\\ln1\\\\&=\\frac12\\ln3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
