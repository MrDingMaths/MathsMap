    "children": [
      {
        "id": "p39-q21-24-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5!}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{align*}\\frac{5!}{5}&=\\frac{5\\times4!}{5}\\\\\\frac{5!}{5}&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p39-q21-24-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{6!}{4!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30$",
          "worked": "$$\\begin{align*}\\frac{6!}{4!}&=\\frac{6\\times5\\times4!}{4!}\\\\\\frac{6!}{4!}&=30\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p39-q21-24-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{4!+6!}{4!+5!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{31}{6}$",
          "worked": "$$\\begin{align*}\\frac{4!+6!}{4!+5!}&=\\frac{4!(1+6\\times5)}{4!(1+5)}\\\\\\frac{4!+6!}{4!+5!}&=\\frac{1+30}{1+5}\\\\\\frac{4!+6!}{4!+5!}&=\\frac{31}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p39-q21-24-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{9!-8!}{8!-7!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{64}{7}$",
          "worked": "$$\\begin{align*}\\frac{9!-8!}{8!-7!}&=\\frac{8!(9-1)}{7!(8-1)}\\\\\\frac{9!-8!}{8!-7!}&=\\frac{8\\times8}{7}\\\\\\frac{9!-8!}{8!-7!}&=\\frac{64}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
