              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "(A) The same percentage of people in each group earned more than $325 per week.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p22-q6-option-b",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
