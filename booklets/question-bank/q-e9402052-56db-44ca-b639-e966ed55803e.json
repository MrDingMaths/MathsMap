              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "(B) Approximately 75% of people under 21 earned less than $350 per week.",
                  "marks": []
                }
              ]
            },
            {
              "id": "p22-q6-option-c",
              "type": "paragraph",
