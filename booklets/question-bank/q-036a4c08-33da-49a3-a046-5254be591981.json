  "content": {
    "id": "p9-q9-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $y=Ae^x+Be^{-x}$ satisfies the differential equation $y''-y=0$ for any real values of $A$ and $B$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y''=Ae^x+Be^{-x}=y$, so $y''-y=0$.",
      "worked": "$$\\begin{align*} y'&=Ae^x-Be^{-x}\\\\ y''&=Ae^x+Be^{-x}\\\\ y''-y&=(Ae^x+Be^{-x})-(Ae^x+Be^{-x})\\\\ y''-y&=0.\\end{align*}$$",
      "solutionDiagrams": []
    },
