            "type": "part",
            "label": "i",
            "prompt": "volume after 8.5 hours",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$17000\\text{ L}$",
              "worked": "$$\\begin{aligned}V&=2000(8.5)\\\\V&=17000\\text{ L}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p9-q6-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "time to fill 7500 litres",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3.75\\text{ h}$",
              "worked": "$$\\begin{aligned}7500&=2000t\\\\\\frac{7500}{2000}&=t\\\\t&=3.75\\text{ h}\\end{aligned}$$",
              "solutionDiagrams": []
            },
