            "id": "p9-q6-a",
            "type": "part",
            "label": "a",
            "prompt": "Find the gradient.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2000$",
              "worked": "$$\\begin{aligned}k&=\\frac{\\text{rise}}{\\text{run}}\\\\&=\\frac{6000}{3}\\\\&=2000\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p9-q6-b",
            "type": "part",
            "label": "b",
            "prompt": "What does the gradient represent in this scenario?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "2000 litres per hour.",
              "worked": "Water is poured into the tank at a rate of 2000 litres per hour.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p9-q6-c",
            "type": "part",
            "label": "c",
            "prompt": "Write the equation relating volume $V$ and time $t$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$V=2000t$",
              "worked": "$$\\begin{aligned}V&=kt\\\\V&=2000t\\end{aligned}$$\nHere $V$ is in litres and $t$ is in hours.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ],
        "diagramPlacement": "beside-prompt"
