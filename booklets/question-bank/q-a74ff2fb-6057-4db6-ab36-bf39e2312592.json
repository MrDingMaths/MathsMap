  "content": {
    "id": "p52-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Find the percentage change (increase or decrease) when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "15 g becomes 18 g",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\%$ increase.",
          "worked": "$$\\begin{align*}\\text{Change}&=18-15\\\\&=3\\text{ g}\\\\\\%\\text{ change}&=\\frac{3}{15}\\times100\\\\&=20\\%\\end{align*}$$\nThe mass increased by $20\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p52-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "18 g becomes 15 g",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16.\\dot{6}\\%$ decrease.",
          "worked": "$$\\begin{align*}\\text{Change}&=15-18\\\\&=-3\\text{ g}\\\\\\%\\text{ change}&=\\frac{-3}{18}\\times100\\\\&=-\\frac{50}{3}\\%\\\\&=-16.\\dot{6}\\%\\end{align*}$$\nThe mass decreased by $16.\\dot{6}\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p52-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "4 m becomes 24 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$500\\%$ increase.",
          "worked": "$$\\begin{align*}\\text{Change}&=24-4\\\\&=20\\text{ m}\\\\\\%\\text{ change}&=\\frac{20}{4}\\times100\\\\&=500\\%\\end{align*}$$\nThe length increased by $500\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p52-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "24 m becomes 4 m",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$83.3\\dot{3}\\%$ decrease.",
          "worked": "$$\\begin{align*}\\text{Change}&=4-24\\\\&=-20\\text{ m}\\\\\\%\\text{ change}&=\\frac{-20}{24}\\times100\\\\&=-\\frac{250}{3}\\%\\\\&=-83.3\\dot{3}\\%\\end{align*}$$\nThe length decreased by $83.3\\dot{3}\\%$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
