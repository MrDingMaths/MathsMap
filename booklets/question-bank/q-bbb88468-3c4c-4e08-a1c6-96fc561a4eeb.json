  "content": {
    "id": "p41-q25-root",
    "type": "question",
    "label": "25",
    "prompt": "In a bag there are 3 six-sided dice. Two of the dice have faces marked 1, 2, 3, 4, 5, 6.\nThe other is a special die with faces marked 1, 2, 3, 5, 5, 5.\nOne die is randomly selected and tossed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q25-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability that the die shows a 5?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{18}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q25-a-tree-advice",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "A probability tree is useful here.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p41-q25-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(5)&=\\frac13\\times\\frac16+\\frac13\\times\\frac16+\\frac13\\times\\frac36\\\\P(5)&=\\frac{1+1+3}{18}\\\\P(5)&=\\frac5{18}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p41-q25-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that the die shows a 5, what is the probability that it is the special die?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac35$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p41-q25-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{special}\\mid 5\\text{ shown})&=\\frac{P(\\text{special}\\cap 5)}{P(5)}\\\\P(\\text{special}\\mid 5\\text{ shown})&=\\frac{\\frac13\\times\\frac12}{\\frac5{18}}\\\\P(\\text{special}\\mid 5\\text{ shown})&=\\frac35\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
