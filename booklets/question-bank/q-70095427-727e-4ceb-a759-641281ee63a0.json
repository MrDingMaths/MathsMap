    "type": "question",
    "label": "8",
    "prompt": "Simplify $\\left(\\frac{3y^3}{2}\\right)^{-2}$ and express as a fraction involving non-negative indices only.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{4}{9y^6}$",
      "worked": "$$\\begin{align*}\\left(\\frac{3y^3}{2}\\right)^{-2}&=\\left(\\frac{2}{3y^3}\\right)^2\\\\&=\\frac{2^2}{3^2(y^3)^2}\\\\&=\\frac{4}{9y^6}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
