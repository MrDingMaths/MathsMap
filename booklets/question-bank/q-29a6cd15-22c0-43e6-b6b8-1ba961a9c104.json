  "content": {
    "id": "p24-q14",
    "type": "question",
    "label": "14",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p24-q14-stem",
          "type": "paragraph",
          "fontSize": null,
