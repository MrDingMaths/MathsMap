    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$75 479",
      "worked": "$\\begin{align*}\\text{Annual gross income} &= 2802 \\times 26 + 4055 \\\\ &= \\$76\\,907 \\\\ \\text{Total deductions} &= 900 + 528 \\\\ &= \\$1428 \\\\ \\text{Taxable income} &= 76\\,907 - 1428 \\\\ &= \\$75\\,479\\end{align*}$",
      "solutionDiagrams": []
    },
