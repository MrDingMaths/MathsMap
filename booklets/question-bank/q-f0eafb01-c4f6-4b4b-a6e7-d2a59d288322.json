        "answer": {
          "short": "$2\\,471\\,520$",
          "worked": "Repeated subtractions of the same number are combined on one line.\n$$\\begin{align*}1824-1355&=469\\\\1355-2\\times469&=417\\\\469-417&=52\\\\417-8\\times52&=1\\\\52-51\\times1&=1\\\\\\operatorname{GCD}(1355,1824)&=1\\\\\\operatorname{LCM}(1355,1824)&=\\frac{1355\\times1824}{1}\\\\\\operatorname{LCM}(1355,1824)&=2\\,471\\,520\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 84
