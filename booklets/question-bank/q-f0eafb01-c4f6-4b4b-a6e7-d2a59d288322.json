      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$972,864$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7776$",
          "worked": "Repeated subtractions of the same number are combined on one line.\n$$\\begin{align*}972-864&=108\\\\864-7\\times108&=108\\\\\\operatorname{GCD}(972,864)&=108\\\\\\operatorname{LCM}(972,864)&=\\frac{972\\times864}{108}\\\\\\operatorname{LCM}(972,864)&=7776\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$3312,1802$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\,984\\,112$",
          "worked": "Repeated subtractions of the same number are combined on one line.\n$$\\begin{align*}3312-1802&=1510\\\\1802-1510&=292\\\\1510-5\\times292&=50\\\\292-5\\times50&=42\\\\50-42&=8\\\\42-5\\times8&=2\\\\8-3\\times2&=2\\\\\\operatorname{GCD}(3312,1802)&=2\\\\\\operatorname{LCM}(3312,1802)&=\\frac{3312\\times1802}{2}\\\\\\operatorname{LCM}(3312,1802)&=2\\,984\\,112\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 100
      },
      {
        "id": "p24-q2-c",
