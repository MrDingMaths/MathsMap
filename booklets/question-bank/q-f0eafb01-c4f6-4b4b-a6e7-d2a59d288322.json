          "inlines": [
            {
              "type": "text",
              "text": "The Euclidean algorithm allows us to quickly find the greatest common divisor of a pair of numbers. Using this technique in conjunction with the identity",
              "marks": []
            }
          ]
        },
        {
          "id": "p24-q2-identity-paragraph",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\operatorname{GCD}(a,b)\\times\\operatorname{LCM}(a,b)=ab",
              "display": true
            }
          ]
        },
        {
          "id": "p24-q2-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "allows us to efficiently find their least common multiple as well. Use this approach to find the least common multiple of the following pairs of numbers:",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
