  "content": {
    "id": "p29-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A quiz has 20 multiple-choice questions, each with a choice of 4 answers. If Jay guesses an answer for each question at random, find the probability that he will score 75% on this quiz, correct to 2 significant figures.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3.4\\times10^{-6}$",
      "worked": "75% of 20 questions is 15 correct answers. Let $X$ be the number of correct answers, so $X\\sim\\operatorname{Bin}(20,\\frac14)$.\n$$\\begin{aligned}P(X=15)&=\\binom{20}{15}\\left(\\frac14\\right)^{15}\\left(\\frac34\\right)^5\\\\P(X=15)&\\approx3.4\\times10^{-6}.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 23
  },
