    "children": [
      {
        "id": "p5-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Prove that the square of any even number is of the form $4n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If $m=2k$, then $m^2=4k^2=4n$, where $n=k^2$ is an integer.",
          "worked": "Let $m=2k$, where $k\\in\\mathbb Z$.\n$$\\begin{align*}m^2&=(2k)^2\\\\m^2&=4k^2.\\end{align*}$$\nTaking $n=k^2$ gives the required form $4n$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p5-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that the square of any odd number is of the form $4n+1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "If $m=2k+1$, then $m^2=4(k^2+k)+1=4n+1$, where $n=k^2+k$ is an integer.",
          "worked": "Let $m=2k+1$, where $k\\in\\mathbb Z$.\n$$\\begin{align*}m^2&=(2k+1)^2\\\\m^2&=4k^2+4k+1\\\\m^2&=4(k^2+k)+1.\\end{align*}$$\nTaking $n=k^2+k$ gives the required form $4n+1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p5-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Prove that $999$ cannot be expressed as the sum of two perfect squares.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A sum of two squares has remainder $0$, $1$ or $2$ on division by $4$, whereas $999=4\\times249+3$.",
          "worked": "By parts (a) and (b), every perfect square has remainder $0$ or $1$ on division by $4$. The possible sums therefore have remainders $0+0=0$, $0+1=1$ or $1+1=2$.\n$$999=4\\times249+3.$$\nIts remainder is $3$, so $999$ cannot be the sum of two perfect squares.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p5-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Prove that the sum of two odd perfect squares is never a perfect square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two odd squares sum to $4(r+s)+2$, which has remainder $2$ on division by $4$. A square has remainder $0$ or $1$.",
          "worked": "By part (b), write the two odd perfect squares as $4r+1$ and $4s+1$, where $r,s$ are integers.\n$$\\begin{align*}(4r+1)+(4s+1)&=4r+4s+2\\\\(4r+1)+(4s+1)&=4(r+s)+2.\\end{align*}$$\nThe sum has remainder $2$ on division by $4$. Parts (a) and (b) show that a perfect square has remainder $0$ or $1$, so this sum cannot be a perfect square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
