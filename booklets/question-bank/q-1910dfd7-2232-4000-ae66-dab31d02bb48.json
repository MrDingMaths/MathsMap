  "content": {
    "id": "p13-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "How many numbers with 7 digits can be made by arranging the digits in $1\\,010\\,101$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$20$",
      "worked": "The digits are four 1s and three 0s. The first digit must be 1, leaving three 1s and three 0s to arrange.\n\n$$\\begin{align*}N&=\\frac{6!}{3!\\,3!}\\\\N&=20\\end{align*}$$",
      "solutionDiagrams": []
    },
