  "content": {
    "id": "p33-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Two cars are travelling along roads that intersect at right angles to one another. One starts 200 km away and travels towards the intersection at $80\\text{ km h}^{-1}$, while the other starts at 120 km away and travels towards the intersection at $60\\text{ km h}^{-1}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that their distance apart after $t$ hours is given by $d^2=10000t^2-46400t+54400$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d^2=(200-80t)^2+(120-60t)^2=10000t^2-46400t+54400$.",
          "worked": "By Pythagoras,\n$$\\begin{align*}d^2&=(200-80t)^2+(120-60t)^2\\\\d^2&=40000-32000t+6400t^2+14400-14400t+3600t^2\\\\d^2&=10000t^2-46400t+54400.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p33-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find their minimum distance apart.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "24 km.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p33-q22-b-distance",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "d=\\sqrt{10000t^2-46400t+54400},\\qquad t\\geq0",
                    "display": true
                  }
                ]
              },
              {
                "id": "p33-q22-b-stationary",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}d'(t)&=\\frac{20000t-46400}{2\\sqrt{10000t^2-46400t+54400}}\\\\0&=\\frac{20000t-46400}{2\\sqrt{10000t^2-46400t+54400}}\\\\0&=20000t-46400\\\\t&=2.32\\text{ h}.\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p33-q22-b-substitution",
                "type": "paragraph",
