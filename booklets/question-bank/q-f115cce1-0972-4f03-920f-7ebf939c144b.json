      {
        "id": "p4-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "A page of writing is reflected in a mirror. Is the image congruent to the real page?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Reflection preserves size and shape, so the mirror image is congruent to the page.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Think of two large jacaranda trees that you have seen. Are they congruent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The trees have different branching shapes and cannot coincide exactly, even if their overall sizes are similar.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Is a model of the Sydney Harbour Bridge congruent to the real bridge?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The model is smaller than the real bridge. Congruent figures must have the same size as well as the same shape.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Two identical twins stand at attention in army uniform. Are they congruent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, approximately.",
          "worked": "Treating the twins as identical in size and shape and standing in the same pose gives congruent figures. In reality, small physical differences make this approximate.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Think of two cumulus clouds of about the same size. Are they congruent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "Having approximately the same size is insufficient: the clouds have different shapes and do not coincide exactly.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "Are two copies of the same photograph congruent?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes, if printed at the same size.",
          "worked": "Copies printed at the same size have matching shapes and dimensions and can be placed exactly on top of one another.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p4-q3-g",
        "type": "part",
        "label": "g",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p4-q3-g-response",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What lower-case letter, apart from b itself, is congruent to b? ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "d",
                  "width": 12
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "d or p; possibly q, depending on the font.",
          "worked": "A reflection across a vertical line can map b to d, and a reflection across a horizontal line can map b to p. A half-turn may map b to q, depending on the font.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q3-h",
        "type": "part",
        "label": "h",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p4-q3-h-response",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What digit, apart from 9 itself, is congruent to 9? ",
                  "marks": []
                },
                {
                  "type": "cloze",
                  "answer": "6",
                  "width": 12
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6.",
          "worked": "Rotating 9 through $180^{\\circ}$ gives 6 in the usual matching digit style.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
