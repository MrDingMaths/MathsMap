  "content": {
    "id": "p9-q9-root",
    "type": "question",
    "label": null,
    "prompt": "From a set of 20 cards numbered 1 to 20, a card is drawn at random. What is the probability that it is either a multiple of 5 or a multiple of 4?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{5}$.",
      "worked": "Let $F$ be drawing a multiple of 5 and $G$ be drawing a multiple of 4. There are 4 multiples of 5 and 5 multiples of 4. The number 20 belongs to both events.\n$$\\begin{align*}P(F\\cup G)&=\\frac{4+5-1}{20}\\\\ P(F\\cup G)&=\\frac{2}{5}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
