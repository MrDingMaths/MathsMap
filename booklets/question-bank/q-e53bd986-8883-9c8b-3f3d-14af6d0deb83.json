    "children": [
      {
        "id": "p11-q59-response",
        "type": "part",
        "label": "a",
        "prompt": "$(2x+1)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+4x+1$",
          "worked": "$$\\begin{align*}(2x+1)^2&=(2x)^2+2(2x)(1)+1^2\\\\(2x+1)^2&=4x^2+4x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q60-response",
        "type": "part",
        "label": "b",
        "prompt": "$(3x-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-24x+16$",
          "worked": "$$\\begin{align*}(3x-4)^2&=(3x)^2+2(3x)(-4)+(-4)^2\\\\(3x-4)^2&=9x^2-24x+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q61-response",
        "type": "part",
        "label": "c",
        "prompt": "$(3xy-4)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2y^2-24xy+16$",
          "worked": "$$\\begin{align*}(3xy-4)^2&=(3xy)^2+2(3xy)(-4)+(-4)^2\\\\(3xy-4)^2&=9x^2y^2-24xy+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q62-response",
        "type": "part",
        "label": "d",
        "prompt": "$(3x-4y)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9x^2-24xy+16y^2$",
          "worked": "$$\\begin{align*}(3x-4y)^2&=(3x)^2+2(3x)(-4y)+(-4y)^2\\\\(3x-4y)^2&=9x^2-24xy+16y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q63-response",
        "type": "part",
        "label": "e",
        "prompt": "$(2x+1)(3x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2-5x-4$",
          "worked": "$$\\begin{align*}(2x+1)(3x-4)&=6x^2-8x+3x-4\\\\(2x+1)(3x-4)&=6x^2-5x-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q64-response",
        "type": "part",
        "label": "f",
        "prompt": "$(2x-3y)(2x+3y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-9y^2$",
          "worked": "$$\\begin{align*}(2x-3y)(2x+3y)&=(2x)^2-(3y)^2\\\\(2x-3y)(2x+3y)&=4x^2-9y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q65-response",
        "type": "part",
        "label": "g",
        "prompt": "$(2x+y)(3x-4y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2-5xy-4y^2$",
          "worked": "$$\\begin{align*}(2x+y)(3x-4y)&=6x^2-8xy+3xy-4y^2\\\\(2x+y)(3x-4y)&=6x^2-5xy-4y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q66-response",
        "type": "part",
        "label": "h",
        "prompt": "$(2x-3y)(3x-2y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2-13xy+6y^2$",
          "worked": "$$\\begin{align*}(2x-3y)(3x-2y)&=6x^2-4xy-9xy+6y^2\\\\(2x-3y)(3x-2y)&=6x^2-13xy+6y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q67-response",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(x+\\frac{1}{x}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+2+\\frac{1}{x^2}$, $x\\ne0$.\n\nUse the perfect-square identity; the middle term is $2x\\left(\\frac{1}{x}\\right)=2$.",
          "worked": "$$\\begin{align*}\\left(x+\\frac{1}{x}\\right)^2&=x^2+2x\\left(\\frac{1}{x}\\right)+\\left(\\frac{1}{x}\\right)^2\\\\\\left(x+\\frac{1}{x}\\right)^2&=x^2+2+\\frac{1}{x^2}\\end{align*}$$\n\n$x\\ne0$, since the original expression contains a denominator $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q68-response",
        "type": "part",
        "label": "j",
        "prompt": "$\\left(x+\\frac{1}{y}\\right)\\left(y+\\frac{1}{x}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy+2+\\frac{1}{xy}$, $x\\ne0$ and $y\\ne0$.\n\nExpand the four products; the two middle products each equal $1$.",
          "worked": "$$\\begin{align*}\\left(x+\\frac{1}{y}\\right)\\left(y+\\frac{1}{x}\\right)&=xy+\\frac{x}{x}+\\frac{y}{y}+\\frac{1}{xy}\\\\\\left(x+\\frac{1}{y}\\right)\\left(y+\\frac{1}{x}\\right)&=xy+2+\\frac{1}{xy}\\end{align*}$$\n\n$x\\ne0$ and $y\\ne0$, since both occur as denominators in the original expression.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
