  "content": {
    "id": "p38-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "State the range of these functions, using $x^2\\ge 0$, $\\sqrt{x}\\ge 0$, $\\frac{1}{x}\\ne 0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=7-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 7$",
          "worked": "$$\\begin{align*}x^2&\\ge 0\\\\-x^2&\\le 0\\\\7-x^2&\\le 7\\end{align*}$$\nRange: $y\\le 7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\sqrt{x+6}-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge -4$",
          "worked": "$$\\begin{align*}\\sqrt{x+6}&\\ge 0\\\\\\sqrt{x+6}-4&\\ge -4\\end{align*}$$\nRange: $y\\ge -4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p38-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\frac{3}{x-2}+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ne 5$",
          "worked": "$$\\begin{align*}\\frac{3}{x-2}&\\ne 0\\\\\\frac{3}{x-2}+5&\\ne 5\\end{align*}$$\nRange: $y\\ne 5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p38-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=2(x+1)^2-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge -6$",
          "worked": "$$\\begin{align*}(x+1)^2&\\ge 0\\\\2(x+1)^2&\\ge 0\\\\2(x+1)^2-6&\\ge -6\\end{align*}$$\nRange: $y\\ge -6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$f(x)=8-\\sqrt{3x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 8$",
          "worked": "$$\\begin{align*}\\sqrt{3x-1}&\\ge 0\\\\-\\sqrt{3x-1}&\\le 0\\\\8-\\sqrt{3x-1}&\\le 8\\end{align*}$$\nRange: $y\\le 8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p38-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$f(x)=\\frac{3}{x-2}-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ne -4$",
          "worked": "$$\\begin{align*}\\frac{3}{x-2}&\\ne 0\\\\\\frac{3}{x-2}-4&\\ne -4\\end{align*}$$\nRange: $y\\ne -4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
