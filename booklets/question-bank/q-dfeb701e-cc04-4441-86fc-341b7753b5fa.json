  "content": {
    "id": "p19-q8-root",
    "type": "question",
    "label": null,
    "prompt": "A bullet is fired at an angle of $60^\\circ$ above the horizontal and a speed of $120\\text{ m s}^{-1}$. Use $g=10\\text{ m s}^{-2}$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "the exact time taken to reach maximum height,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\sqrt3\\text{ s}$",
          "worked": "$$\\begin{aligned}\\dot y(t)&=-10t+120\\sin60^\\circ\\\\&=-10t+60\\sqrt3\\end{aligned}$$\n\nAt maximum height, $\\dot y(t)=0$.\n\n$$\\begin{aligned}0&=-10t+60\\sqrt3\\\\t&=6\\sqrt3\\text{ s}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p19-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "the bullet's maximum height above its launch point.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$540\\text{ m}$",
          "worked": "Taking the launch point as $y=0$,\n\n$$\\begin{aligned}y(t)&=-5t^2+60\\sqrt3t\\\\y(6\\sqrt3)&=-5(6\\sqrt3)^2+60\\sqrt3(6\\sqrt3)\\\\&=540\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
