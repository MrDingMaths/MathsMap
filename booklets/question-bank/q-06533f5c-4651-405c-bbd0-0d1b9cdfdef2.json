    "children": [
      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{\\tan(2\\pi-\\theta)}{\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sec\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\tan(2\\pi-\\theta)}{\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)}&=\\frac{-\\tan\\theta}{\\sin\\theta}\\\\\\frac{\\tan(2\\pi-\\theta)}{\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)}&=-\\frac{\\sin\\theta}{\\cos\\theta}\\times\\frac{1}{\\sin\\theta}\\\\\\frac{\\tan(2\\pi-\\theta)}{\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)}&=-\\frac{1}{\\cos\\theta}\\\\\\frac{\\tan(2\\pi-\\theta)}{\\cos\\left(\\frac{\\pi}{2}-\\theta\\right)}&=-\\sec\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{\\sin(\\pi+\\theta)}{\\cos(\\pi-\\theta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\sin(\\pi+\\theta)}{\\cos(\\pi-\\theta)}&=\\frac{-\\sin\\theta}{-\\cos\\theta}\\\\\\frac{\\sin(\\pi+\\theta)}{\\cos(\\pi-\\theta)}&=\\frac{\\sin\\theta}{\\cos\\theta}\\\\\\frac{\\sin(\\pi+\\theta)}{\\cos(\\pi-\\theta)}&=\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
