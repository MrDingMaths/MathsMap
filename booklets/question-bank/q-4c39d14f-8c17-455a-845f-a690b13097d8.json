  "content": {
    "id": "p51-q62-response",
    "type": "question",
    "label": null,
    "prompt": "Find the value(s) of $k$ so that $x^2-4x+2k=0$ has no real roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k>2$.\n\nRequire $\\Delta<0$.",
      "worked": "$$\\begin{align*}\\Delta&=(-4)^2-4(1)(2k)\\\\\\Delta&=16-8k\\end{align*}$$\n\nFor no real roots, require $\\Delta<0$.\n\n$$\\begin{align*}16-8k&<0\\\\k&>2\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
