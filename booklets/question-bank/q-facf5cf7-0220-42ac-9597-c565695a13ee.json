  "content": {
    "id": "p27-q45-root",
    "type": "question",
    "label": "45",
    "prompt": "The graph of $y=9^{x+1}$ is horizontally dilated by a factor of $h$ and vertically dilated by a factor of $k$ to give $y=27^x$. Find the values of $h$ and $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q45-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "h=\\frac23,\\quad k=\\frac19",
                "display": false
              }
            ]
          },
          {
            "id": "p27-q45-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Apply both reciprocal substitutions and write both rules with base 3.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Replace $x\\mapsto \\frac{x}{h}$ and $y\\mapsto \\frac{y}{k}$.\n$$\\begin{align*}\\frac{y}{k}&=9^{x/h+1}\\\\y&=9k\\,3^{2x/h}\\end{align*}$$\nThe target is $y=27^x=3^{3x}$. Comparing the rules gives\n$$\\begin{align*}9k&=1\\\\k&=\\frac19\\\\\\frac2h&=3\\\\h&=\\frac23\\end{align*}$$",
      "solutionDiagrams": []
    },
