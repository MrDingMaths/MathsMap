    "id": "p20-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the area bounded by the curve $y=\\sqrt{x}$, the $y$-axis and the horizontal lines through the points on the curve where $x=0$ and $x=4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{8}{3}\\text{ units}^2$",
      "worked": "Rearrange for $x$ and change the limits.\n$$\\begin{aligned}x&=y^2\\\\x=0:&\\quad y=0\\\\x=4:&\\quad y=2\\\\A&=\\int_0^2 y^2\\,dy\\\\&=\\left[\\frac{y^3}{3}\\right]_0^2\\\\&=\\frac{8}{3}-0\\\\&=\\frac{8}{3}\\text{ units}^2=2\\frac{2}{3}\\text{ units}^2\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 39
  },
