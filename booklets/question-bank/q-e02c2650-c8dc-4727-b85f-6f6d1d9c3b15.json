  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Consider the formula $U = 8a + 4$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $U$ if $a = -1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$U = -4$",
          "worked": "$$\\begin{align*}U &= 8a + 4\\\\U &= 8(-1) + 4\\\\U &= -8 + 4\\\\U &= -4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $a$ if $U = 44$. Set up an equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = 5$",
          "worked": "$$\\begin{align*}U &= 8a + 4\\\\44 &= 8a + 4\\\\40 &= 8a\\\\5 &= a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p10-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $a$ if $U = 92$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = 11$",
          "worked": "$$\\begin{align*}U &= 8a + 4\\\\92 &= 8a + 4\\\\88 &= 8a\\\\11 &= a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p10-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "If $U = -12$, find the value of $a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = -2$",
          "worked": "$$\\begin{align*}U &= 8a + 4\\\\-12 &= 8a + 4\\\\-16 &= 8a\\\\-2 &= a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
