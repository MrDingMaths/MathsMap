    "children": [
      {
        "id": "p13-q9a",
        "type": "part",
        "label": "a",
        "prompt": "Determine $\\phi(5)$ and $\\phi(13)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\phi(5)=4$, $\\phi(13)=12$.",
          "worked": "Since 5 and 13 are prime, $\\phi(p)=p-1$ gives\n$$\\begin{align*}\\phi(5)&=5-1=4,\\\\\\phi(13)&=13-1=12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q9b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, determine $\\phi(65)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\phi(65)=48$.",
          "worked": "Since $65=5\\times13$ and 5 and 13 are coprime,\n$$\\begin{align*}\\phi(65)&=\\phi(5)\\phi(13)\\\\\\phi(65)&=4\\times12\\\\\\phi(65)&=48.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
