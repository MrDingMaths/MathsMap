  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Einstein worked out that energy ($E$), mass ($m$) and the speed of light ($c$) are connected by the formula $E=mc^2$. Use this formula to",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $m$ in terms of $E$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{E}{c^2}$",
          "worked": "$$\\begin{align*}\\frac{E}{c^2}&=m\\\\m&=\\frac{E}{c^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $c$ in terms of $E$ and $m$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\sqrt{\\frac{E}{m}}$",
          "worked": "$$\\begin{align*}\\frac{E}{m}&=c^2\\\\c&=\\sqrt{\\frac{E}{m}}\\end{align*}$$\nTake the positive root because $c$ is the speed of light.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
