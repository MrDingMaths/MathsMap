        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Jayden: blue, starting at $\\$24$ and increasing by $\\$6$ per hour. Ruby: red, starting at $\\$10$ and increasing by $\\$8$ per hour.",
          "worked": "The blue line has vertical intercept $24$ and gradient $6$, matching Jayden’s initial savings and hourly earnings. The red line has vertical intercept $10$ and gradient $8$, matching Ruby’s initial savings and hourly earnings.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
