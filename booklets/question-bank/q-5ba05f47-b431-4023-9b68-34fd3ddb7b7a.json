      {
        "id": "p13-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Write the coordinates of the point of intersection.\nShow that these values satisfy both Ruby and Jayden’s equations.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(7,66)$. Ruby: $10+8(7)=66$. Jayden: $24+6(7)=66$.",
          "worked": "The graph shows the intersection at $(7,66)$.\n\nRuby:\n$$\\begin{align*}10+8(7)&=10+56\\\\&=66\\end{align*}$$\nJayden:\n$$\\begin{align*}24+6(7)&=24+42\\\\&=66\\end{align*}$$\nBoth equations give $A=66$ when $n=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
