  "content": {
    "id": "v2-e0e51-p15-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "A bakery serves 60 customers in one hour. 38 buy a pie, 31 buy a sausage roll.\nIf every customer buys at least one of these, how many buy both?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "9 customers.",
      "worked": "Every customer buys at least one item, so the union contains 60 customers. Let $x$ be the number who buy both.\nUsing the addition rule:\n$$\\begin{align*}60&=38+31-x\\\\60&=69-x\\\\x&=9\\end{align*}$$\n9 customers buy both.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
