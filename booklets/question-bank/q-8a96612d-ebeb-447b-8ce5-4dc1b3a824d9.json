  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve each of the following equations by first putting the quadratic equation in standard form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)^2=4x+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\ 2$",
          "worked": "$$\\begin{align*}x^2+2x+1&=4x+1\\\\x^2-2x&=0\\\\x(x-2)&=0\\\\x&=0,\\ 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+2)^2=5x+10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ 3$",
          "worked": "$$\\begin{align*}x^2+4x+4&=5x+10\\\\x^2-x-6&=0\\\\(x+2)(x-3)&=0\\\\x&=-2,\\ 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x+3)^2=2x^2-18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,\\ 9$",
          "worked": "$$\\begin{align*}x^2+6x+9&=2x^2-18\\\\x^2-6x-27&=0\\\\(x+3)(x-9)&=0\\\\x&=-3,\\ 9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x-2)^2=4-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0,\\ 3$",
          "worked": "$$\\begin{align*}x^2-4x+4&=4-x\\\\x^2-3x&=0\\\\x(x-3)&=0\\\\x&=0,\\ 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x-3)^2=2x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ 7$",
          "worked": "$$\\begin{align*}x^2-6x+9&=2x+2\\\\x^2-8x+7&=0\\\\(x-1)(x-7)&=0\\\\x&=1,\\ 7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$(2x+3)^2=5x+20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{11}{4},\\ 1$",
          "worked": "$$\\begin{align*}4x^2+12x+9&=5x+20\\\\4x^2+7x-11&=0\\\\(4x+11)(x-1)&=0\\\\x&=-\\frac{11}{4},\\ 1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$(3x+2)^2=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1,\\ -\\frac12$",
          "worked": "$$\\begin{align*}9x^2+12x+4&=x^2\\\\8x^2+12x+4&=0\\\\2x^2+3x+1&=0\\\\(2x+1)(x+1)&=0\\\\x&=-1,\\ -\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p7-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$(3x-2)^2=4x+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac29,\\ 2$",
          "worked": "$$\\begin{align*}9x^2-12x+4&=4x+8\\\\9x^2-16x-4&=0\\\\(9x+2)(x-2)&=0\\\\x&=-\\frac29,\\ 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$(4x-3)^2=x^2+x-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ \\frac23$",
          "worked": "$$\\begin{align*}16x^2-24x+9&=x^2+x-1\\\\15x^2-25x+10&=0\\\\3x^2-5x+2&=0\\\\(3x-2)(x-1)&=0\\\\x&=1,\\ \\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
