      {
        "id": "p9-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3x^2}{2x+1}\\times\\dfrac{4x^2-1}{x^3+5x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3(2x-1)}{x+5}$",
          "worked": "$$\\begin{align*}\\frac{3x^2}{2x+1}\\times\\frac{4x^2-1}{x^3+5x^2}&=\\frac{3x^2}{2x+1}\\times\\frac{(2x-1)(2x+1)}{x^2(x+5)}\\\\\\frac{3x^2}{2x+1}\\times\\frac{4x^2-1}{x^3+5x^2}&=\\frac{3(2x-1)}{x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p9-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x^2-x-2}{x^2+3x}\\times\\dfrac{5x}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5(x+1)}{x+3}$",
          "worked": "$$\\begin{align*}\\frac{x^2-x-2}{x^2+3x}\\times\\frac{5x}{x-2}&=\\frac{(x-2)(x+1)}{x(x+3)}\\times\\frac{5x}{x-2}\\\\\\frac{x^2-x-2}{x^2+3x}\\times\\frac{5x}{x-2}&=\\frac{5(x+1)}{x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p9-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2x^2+3x-2}{x^2+2x}\\times\\dfrac{x^2-4x}{x^2-5x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(2x-1)(x-4)}{x^2-5x-4}$",
          "worked": "$$\\begin{align*}\\frac{2x^2+3x-2}{x^2+2x}\\times\\frac{x^2-4x}{x^2-5x-4}&=\\frac{(2x-1)(x+2)}{x(x+2)}\\times\\frac{x(x-4)}{x^2-5x-4}\\\\\\frac{2x^2+3x-2}{x^2+2x}\\times\\frac{x^2-4x}{x^2-5x-4}&=\\frac{(2x-1)(x-4)}{x^2-5x-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p9-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{3x^2-10x+3}{3x^2-7x+2}\\times\\dfrac{3x^2-6x}{4x^2-11x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x}{4x+1}$",
          "worked": "$$\\begin{align*}\\frac{3x^2-10x+3}{3x^2-7x+2}\\times\\frac{3x^2-6x}{4x^2-11x-3}&=\\frac{(3x-1)(x-3)}{(3x-1)(x-2)}\\times\\frac{3x(x-2)}{(4x+1)(x-3)}\\\\\\frac{3x^2-10x+3}{3x^2-7x+2}\\times\\frac{3x^2-6x}{4x^2-11x-3}&=\\frac{3x}{4x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
