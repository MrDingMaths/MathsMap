      {
        "id": "p14-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+2x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1-\\sqrt5)(x+1+\\sqrt5)$",
          "worked": "$$\\begin{align*}x^2+2x-4&=(x^2+2x+1)-1-4\\\\x^2+2x-4&=(x+1)^2-(\\sqrt5)^2\\\\x^2+2x-4&=(x+1-\\sqrt5)(x+1+\\sqrt5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2-\\sqrt2)(x+2+\\sqrt2)$",
          "worked": "$$\\begin{align*}x^2+4x+2&=(x^2+4x+4)-4+2\\\\x^2+4x+2&=(x+2)^2-(\\sqrt2)^2\\\\x^2+4x+2&=(x+2-\\sqrt2)(x+2+\\sqrt2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+6x-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3-\\sqrt{17})(x+3+\\sqrt{17})$",
          "worked": "$$\\begin{align*}x^2+6x-8&=(x^2+6x+9)-9-8\\\\x^2+6x-8&=(x+3)^2-(\\sqrt{17})^2\\\\x^2+6x-8&=(x+3-\\sqrt{17})(x+3+\\sqrt{17})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p14-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$-x^2-8x+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x+4-\\sqrt{21})(x+4+\\sqrt{21})$",
          "worked": "$$\\begin{align*}-x^2-8x+5&=-(x^2+8x-5)\\\\-x^2-8x+5&=-[(x^2+8x+16)-16-5]\\\\-x^2-8x+5&=-[(x+4)^2-(\\sqrt{21})^2]\\\\-x^2-8x+5&=-(x+4-\\sqrt{21})(x+4+\\sqrt{21})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$-x^2+6x-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-(x-3-\\sqrt2)(x-3+\\sqrt2)$",
          "worked": "$$\\begin{align*}-x^2+6x-7&=-(x^2-6x+7)\\\\-x^2+6x-7&=-[(x^2-6x+9)-9+7]\\\\-x^2+6x-7&=-[(x-3)^2-(\\sqrt2)^2]\\\\-x^2+6x-7&=-(x-3-\\sqrt2)(x-3+\\sqrt2)\\end{align*}$$",
          "solutionDiagrams": []
