    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q8-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p25-q8-a-prompt",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Another two cards are added. The median is now 33 and the range is now 20.",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "What are the values of the two cards?",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p25-q8-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "33",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "46",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The fourth value is 33; the maximum is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "26+20=46",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p25-q8-a-worked-median",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "With seven cards, the median is the fourth value, so one new card is 33. The other new card cannot be below 33: there would then be four values below 33. The minimum therefore remains 26.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p25-q8-a-worked-maximum",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\text{Maximum}&=26+20\\\\\\text{Maximum}&=46\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p25-q8-a-worked-ordered",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The ordered cards are ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "26,\\;28,\\;30,\\;33,\\;36,\\;40,\\;46",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The two new cards are 33 and 46.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Another card is added. The range and median both increase. What is the new median, and explain why the new median does not depend on this new card.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p25-q8-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Median ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "=\\frac{33+36}{2}=34.5",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". The new card must be greater than 46, so the middle pair remains 33 and 36.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p25-q8-b-worked-range",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "To increase the range, the new card must be below 26 or above 46. A card below 26 would make the middle pair 30 and 33, giving a median of ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{30+33}{2}=31.5",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", which is smaller. Therefore the new card must be greater than 46.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p25-q8-b-worked-middle-pair",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "There are now eight cards. The fourth and fifth values remain 33 and 36.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p25-q8-b-worked-median",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}\\text{Median}&=\\frac{33+36}{2}\\\\\\text{Median}&=34.5\\end{align*}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p25-q8-b-worked-independence",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Changing the new largest value does not change these two middle values, so the median stays 34.5.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
