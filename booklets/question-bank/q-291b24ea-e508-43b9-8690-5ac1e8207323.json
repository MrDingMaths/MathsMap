  "content": {
    "id": "p65-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Factorise fully:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p65-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$9(x-1)^2-4(x+2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5x+1)(x-7)$",
          "worked": "$$\\begin{align*}9(x-1)^2-4(x+2)^2&=[3(x-1)-2(x+2)]\\,[3(x-1)+2(x+2)]\\\\&=(3x-3-2x-4)(3x-3+2x+4)\\\\&=(x-7)(5x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p65-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$25(a+b)^2-4(a-b)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(7a+3b)(3a+7b)$",
          "worked": "$$\\begin{align*}25(a+b)^2-4(a-b)^2&=[5(a+b)-2(a-b)]\\,[5(a+b)+2(a-b)]\\\\&=(5a+5b-2a+2b)(5a+5b+2a-2b)\\\\&=(3a+7b)(7a+3b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p65-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^8-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^4+1)(x^2+1)(x+1)(x-1)$",
          "worked": "$$\\begin{align*}x^8-1&=(x^4-1)(x^4+1)\\\\&=(x^2-1)(x^2+1)(x^4+1)\\\\&=(x-1)(x+1)(x^2+1)(x^4+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p65-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^4-y^4+x^2-y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+y)(x-y)(x^2+y^2+1)$",
          "worked": "$$\\begin{align*}x^4-y^4+x^2-y^2&=(x^2-y^2)(x^2+y^2)+(x^2-y^2)\\\\&=(x^2-y^2)(x^2+y^2+1)\\\\&=(x+y)(x-y)(x^2+y^2+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p65-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$a^2(a+1)-b^2(a+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+1)(a+b)(a-b)$",
          "worked": "$$\\begin{align*}a^2(a+1)-b^2(a+1)&=(a+1)(a^2-b^2)\\\\&=(a+1)(a+b)(a-b).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p65-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$(x^2+x)^2-(x^2+x)-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+x-3)(x^2+x+2)$",
          "worked": "Let $u=x^2+x$. The required factor pair has product $-6$ and sum $-1$: $-3$ and $2$.\n$$\\begin{align*}u^2-u-6&=u^2-3u+2u-6\\\\&=u(u-3)+2(u-3)\\\\&=(u-3)(u+2).\\end{align*}$$\nSubstituting $u=x^2+x$ gives $(x^2+x-3)(x^2+x+2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
