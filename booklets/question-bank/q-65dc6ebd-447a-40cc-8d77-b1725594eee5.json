      {
        "id": "p5-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$M(4,2)$ is the midpoint of the interval $AC$, where $C$ has coordinates $(12,3)$. Find the coordinates of $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A(-4,1)$",
          "worked": "Let $A=(x,y)$. Using the midpoint formula:\n$$\\begin{align*}4&=\\frac{x+12}{2}\\\\x+12&=8\\\\x&=-4\\\\2&=\\frac{y+3}{2}\\\\y+3&=4\\\\y&=1\\end{align*}$$\nTherefore, $A=(-4,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p5-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$M(10,-2)$ is the midpoint of the interval $AC$, where $A$ has coordinates $(-2,6)$. Find the coordinates of $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$C(22,-10)$",
          "worked": "Let $C=(x,y)$. Using the midpoint formula:\n$$\\begin{align*}10&=\\frac{-2+x}{2}\\\\-2+x&=20\\\\x&=22\\\\-2&=\\frac{6+y}{2}\\\\6+y&=-4\\\\y&=-10\\end{align*}$$\nTherefore, $C=(22,-10)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
