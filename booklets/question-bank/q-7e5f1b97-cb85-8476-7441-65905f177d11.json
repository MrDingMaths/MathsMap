    "children": [
      {
        "id": "p21-q37-response",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5}{\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}\\frac{5}{\\sqrt{3}}&=\\frac{5}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\frac{5}{\\sqrt{3}}&=\\frac{5\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p21-q38-response",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2}{3\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{7}}{21}$",
          "worked": "$$\\begin{align*}\\frac{2}{3\\sqrt{7}}&=\\frac{2}{3\\sqrt{7}}\\times\\frac{\\sqrt{7}}{\\sqrt{7}}\\\\\\frac{2}{3\\sqrt{7}}&=\\frac{2\\sqrt{7}}{3\\times7}\\\\\\frac{2}{3\\sqrt{7}}&=\\frac{2\\sqrt{7}}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p21-q39-response",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{6}{\\sqrt{6}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{6}$",
          "worked": "$$\\begin{align*}\\frac{6}{\\sqrt{6}}&=\\frac{6}{\\sqrt{6}}\\times\\frac{\\sqrt{6}}{\\sqrt{6}}\\\\\\frac{6}{\\sqrt{6}}&=\\frac{6\\sqrt{6}}{6}\\\\\\frac{6}{\\sqrt{6}}&=\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p21-q40-response",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{2\\sqrt{3}}{3\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{6}}{3}$",
          "worked": "$$\\begin{align*}\\frac{2\\sqrt{3}}{3\\sqrt{2}}&=\\frac{2\\sqrt{3}}{3\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\\\frac{2\\sqrt{3}}{3\\sqrt{2}}&=\\frac{2\\sqrt{6}}{6}\\\\\\frac{2\\sqrt{3}}{3\\sqrt{2}}&=\\frac{\\sqrt{6}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
