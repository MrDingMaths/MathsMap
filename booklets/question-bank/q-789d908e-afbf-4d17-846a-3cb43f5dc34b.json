  "content": {
    "id": "p13-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A windows shop charges $\\$500$ for the first window, then $\\$300$ for each additional window.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the cost of 1 window, 2 windows, 3 windows, 4 windows, …",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$500$, $\\$800$, $\\$1100$, $\\$1400$",
          "worked": "Add $\\$300$ for each additional window: $\\$500$, $\\$800$, $\\$1100$, $\\$1400$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p13-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the formula $a_n=a+(n-1)d$ to find the cost of 15 windows.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$4700$",
          "worked": "The costs form an AP with $a=500$ and $d=300$.\n$$\\begin{aligned}a_{15}&=a+(15-1)d\\\\a_{15}&=500+14(300)\\\\a_{15}&=4700\\end{aligned}$$\nThe cost is $\\$4700$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the cost of $n$ windows.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$(200+300n)$",
          "worked": "$$\\begin{aligned}a_n&=a+(n-1)d\\\\a_n&=500+(n-1)(300)\\\\a_n&=500+300n-300\\\\a_n&=200+300n\\end{aligned}$$\nThe cost is $\\$(200+300n)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the maximum number of windows whose total cost is less than $\\$10\\,000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "32 windows",
          "worked": "$$\\begin{aligned}a_n&<10000\\\\200+300n&<10000\\\\300n&<9800\\\\n&<32\\tfrac{2}{3}\\end{aligned}$$\nSince $n$ is a whole number, the maximum is 32 windows.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
