    "label": null,
    "prompt": "Express $5x^{-2}(yz)^{-3}$ using positive indices.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{5}{x^2y^3z^3}$",
      "worked": "$$\\begin{align*}5x^{-2}(yz)^{-3}&=5\\times\\frac{1}{x^2}\\times\\frac{1}{(yz)^3}\\\\&=\\frac{5}{x^2y^3z^3}\\end{align*}$$",
      "solutionDiagrams": []
    },
