  "content": {
    "id": "p61-q29-root",
    "type": "question",
    "label": "29",
    "prompt": "Find values of $x$ for which the gradient of the tangent to $y=\\dfrac{4x-1}{2x-1}$ is $-2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=0$ or $x=1$.",
      "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{4(2x-1)-2(4x-1)}{(2x-1)^2}\\\\\\frac{dy}{dx}&=-\\frac{2}{(2x-1)^2}.\\end{align*}$$\nSet the derivative equal to $-2$:\n$$\\begin{align*}-\\frac{2}{(2x-1)^2}&=-2\\\\(2x-1)^2&=1\\\\2x-1&=\\pm1\\\\x&=0\\text{ or }1.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
