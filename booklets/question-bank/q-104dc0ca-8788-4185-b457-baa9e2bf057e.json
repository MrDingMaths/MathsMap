      {
        "id": "p12-q6-a",
        "type": "group",
        "label": "a",
        "prompt": "Given that $p\\propto q$ and $p=9$ when $q=1.5$, find the formula for $p$ in terms of $q$ and the exact value of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q6-a-formula",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$p=6q$",
              "worked": "$$\\begin{aligned}p&=kq\\\\9&=1.5k\\\\k&=\\frac{9}{1.5}\\\\k&=6\\\\p&=6q\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30,
            "responseSpace": "scaffold"
          },
          {
            "id": "p12-q6-a-values",
            "type": "group",
            "label": "",
            "prompt": "",
            "layout": "grid",
            "columns": 2,
            "questionDiagrams": [],
            "children": [
              {
                "id": "p12-q6-a-i",
                "type": "part",
                "label": "i",
                "prompt": "$p$ when $q=4$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$24$",
                  "worked": "$$\\begin{aligned}p&=6\\times4\\\\p&=24\\end{aligned}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 14
              },
              {
                "id": "p12-q6-a-ii",
                "type": "part",
                "label": "ii",
                "prompt": "$q$ when $p=27$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$\\frac{9}{2}$",
                  "worked": "$$\\begin{aligned}27&=6q\\\\q&=\\frac{27}{6}\\\\q&=\\frac{9}{2}\\end{aligned}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 23
              }
            ]
          }
        ]
      },
      {
        "id": "p12-q6-b",
        "type": "group",
        "label": "b",
        "prompt": "Given that $m\\propto n^2$ and $m=10$ when $n=2$, find the formula for $m$ in terms of $n$ and the exact value of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p12-q6-b-formula",
            "type": "part",
            "label": "",
            "prompt": "",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$m=\\frac{5}{2}n^2$",
              "worked": "$$\\begin{aligned}m&=kn^2\\\\10&=k\\times2^2\\\\10&=4k\\\\k&=\\frac{5}{2}\\\\m&=\\frac{5}{2}n^2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 36,
            "responseSpace": "scaffold"
          },
          {
            "id": "p12-q6-b-values",
            "type": "group",
            "label": "",
            "prompt": "",
            "layout": "grid",
            "columns": 2,
            "questionDiagrams": [],
            "children": [
              {
                "id": "p12-q6-b-i",
                "type": "part",
                "label": "i",
                "prompt": "$m$ when $n=5$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$\\frac{125}{2}$",
                  "worked": "$$\\begin{aligned}m&=\\frac{5}{2}\\times5^2\\\\m&=\\frac{5}{2}\\times25\\\\m&=\\frac{125}{2}\\end{aligned}$$",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 24
              },
              {
                "id": "p12-q6-b-ii",
                "type": "part",
                "label": "ii",
                "prompt": "$n$ when $m=12$",
                "layout": "list",
                "columns": null,
                "questionDiagrams": [],
                "children": [],
                "answer": {
                  "short": "$n=\\sqrt{\\frac{24}{5}}=\\frac{2\\sqrt{30}}{5}$",
                  "worked": "$$\\begin{aligned}12&=\\frac{5}{2}n^2\\\\n^2&=\\frac{24}{5}\\\\n&=\\sqrt{\\frac{24}{5}}\\\\n&=\\frac{2\\sqrt{30}}{5}\\end{aligned}$$\n\nTake the positive square root because all variables in Exercise 18B are positive.",
                  "solutionDiagrams": []
                },
                "answerSpaceMm": 35
              }
            ]
          }
        ]
      }
    ]
