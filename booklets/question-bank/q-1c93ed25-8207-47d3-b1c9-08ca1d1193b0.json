  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the gradient of the tangent on the following curves where $x=1$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\frac{dy}{dx}=2x-1.$$ $$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=1}&=2(1)-1\\\\\\left.\\frac{dy}{dx}\\right|_{x=1}&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p11-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$y=x^{1/2}.$$ $$\\frac{dy}{dx}=\\frac12 x^{-1/2}.$$ $$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=1}&=\\frac12(1)^{-1/2}\\\\\\left.\\frac{dy}{dx}\\right|_{x=1}&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x-2)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$y=x^2-4x+4.$$ $$\\frac{dy}{dx}=2x-4.$$ $$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=1}&=2(1)-4\\\\\\left.\\frac{dy}{dx}\\right|_{x=1}&=-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\frac{1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2$",
          "worked": "$$y=x^{-2}.$$ $$\\frac{dy}{dx}=-2x^{-3}.$$ $$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=1}&=-2(1)^{-3}\\\\\\left.\\frac{dy}{dx}\\right|_{x=1}&=-2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{x^2-1}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$y=1-x^{-2}.$$ $$\\frac{dy}{dx}=2x^{-3}.$$ $$\\begin{align*}\\left.\\frac{dy}{dx}\\right|_{x=1}&=2(1)^{-3}\\\\\\left.\\frac{dy}{dx}\\right|_{x=1}&=2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
