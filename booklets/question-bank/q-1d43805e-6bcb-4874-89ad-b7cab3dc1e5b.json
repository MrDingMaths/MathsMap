        "children": [],
        "answer": {
          "short": "$27\\sqrt{3}-9\\sqrt{7}$",
          "worked": "$$\\begin{align*}3\\sqrt{3}(9-\\sqrt{21})&=27\\sqrt{3}-3\\sqrt{63}\\\\&=27\\sqrt{3}-9\\sqrt{7}\\end{align*}$$",
          "solutionDiagrams": []
