  "content": {
    "id": "p42-q1",
    "type": "question",
    "label": "1",
    "prompt": "Use the distributive law to expand the following and simplify the surds where necessary.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{2}(\\sqrt{10}-\\sqrt{2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{5}-2$",
          "worked": "$$\\begin{align*}\\sqrt{2}(\\sqrt{10}-\\sqrt{2})&=\\sqrt{20}-\\sqrt{4}\\\\&=2\\sqrt{5}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{6}(3+\\sqrt{3})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{6}+3\\sqrt{2}$",
          "worked": "$$\\begin{align*}\\sqrt{6}(3+\\sqrt{3})&=3\\sqrt{6}+\\sqrt{18}\\\\&=3\\sqrt{6}+3\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{5}(\\sqrt{15}+4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5\\sqrt{3}+4\\sqrt{5}$",
          "worked": "$$\\begin{align*}\\sqrt{5}(\\sqrt{15}+4)&=\\sqrt{75}+4\\sqrt{5}\\\\&=5\\sqrt{3}+4\\sqrt{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{6}(\\sqrt{8}-2)$",
