        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{3}-2\\sqrt{6}$",
          "worked": "$$\\begin{align*}\\sqrt{6}(\\sqrt{8}-2)&=\\sqrt{48}-2\\sqrt{6}\\\\&=4\\sqrt{3}-2\\sqrt{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$3\\sqrt{3}(9-\\sqrt{21})$",
