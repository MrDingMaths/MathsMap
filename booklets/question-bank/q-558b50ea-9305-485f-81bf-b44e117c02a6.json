  "content": {
    "id": "p17-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A fair 12-sided die is rolled. Find the probability that the roll is a 3 given that the roll is odd.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{1}{6}$",
      "worked": "Given that the roll is odd, the restricted sample space is $\\{1,3,5,7,9,11\\}$. These six outcomes are equally likely, and only one is 3.\n\n$$\\Pr(3\\mid\\text{odd})=\\frac{1}{6}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 22
  },
