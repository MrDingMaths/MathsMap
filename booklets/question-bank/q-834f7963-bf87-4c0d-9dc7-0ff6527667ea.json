  "content": {
    "id": "p18-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "\\$3000 is invested for 3 years compounded monthly at 1.5% per annum. Calculate the future value to the nearest dollar.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$3138",
      "worked": "$$\\begin{align*}r&=\\frac{0.015}{12}=0.00125\\\\n&=3\\times12=36\\\\FV&=PV(1+r)^n\\\\FV&=3000(1+0.00125)^{36}\\\\FV&\\approx\\$3138\\end{align*}$$\nTo the nearest dollar.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 35
  },
