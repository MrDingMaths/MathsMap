        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6b+4a-4$",
          "worked": "$$\\begin{align*}4a-4+5b+b&=4a-4+(5+1)b\\\\&=6b+4a-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+7x+3y-4x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x+4y$",
          "worked": "$$\\begin{align*}x+7x+3y-4x+y&=(1+7-4)x+(3+1)y\\\\&=4x+4y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q6-c",
        "type": "part",
