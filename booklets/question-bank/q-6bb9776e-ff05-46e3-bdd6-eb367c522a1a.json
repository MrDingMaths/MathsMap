    "type": "question",
    "label": "5",
    "prompt": "Show that the point $A(8,4)$ is equidistant (that is, the same distance) from points $B(-4,-1)$ and $C(13,16)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$AB=AC=13$, so $A$ is equidistant from $B$ and $C$.",
      "worked": "$$\\begin{align*}AB^2&=(-4-8)^2+(-1-4)^2\\\\AB^2&=144+25=169\\\\AB&=13\\\\AC^2&=(13-8)^2+(16-4)^2\\\\AC^2&=25+144=169\\\\AC&=13\\end{align*}$$\nThus $AB=AC$, so $A$ is equidistant from $B$ and $C$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
  },
