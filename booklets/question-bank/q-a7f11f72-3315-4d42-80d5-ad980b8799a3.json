              ]
            },
            {
              "id": "d97076c5-1794-425f-92d5-ec21f1034836",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "(circumference is ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "C=2\\pi r",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ")",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.183\\text{ cm}$",
          "worked": "$$\\begin{align*}C&=2\\pi r\\\\20&=2\\pi r\\\\\\frac{20}{2\\pi}&=r\\\\\\frac{10}{\\pi}&=r\\\\r&\\approx3.183\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p26-q5-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "6d9e4ddb-f1b1-406e-b0b0-edab7f5eb1a9",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.3199970000068182,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "What is the area that his plate covers? ",
                  "marks": []
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Give your answer to 2 d.p.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31.83\\text{ cm}^2$",
          "worked": "Use the exact radius from part a.\n\n$$\\begin{align*}A&=\\pi r^2\\\\A&=\\pi\\left(\\frac{10}{\\pi}\\right)^2\\\\A&=\\frac{100}{\\pi}\\\\A&\\approx31.83\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p26-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "A second circular plate has circumference 40 cm. Find its radius to 3 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6.366\\text{ cm}$",
          "worked": "$$\\begin{align*}40&=2\\pi r\\\\r&=\\frac{40}{2\\pi}\\\\r&\\approx6.366\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the second plate’s area to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$127.32\\text{ cm}^2$",
          "worked": "Using the unrounded radius:\n$$\\begin{align*}A&=\\pi r^2\\\\A&=\\pi\\left(\\frac{20}{\\pi}\\right)^2\\\\A&\\approx127.32\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p26-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "How many times the first plate’s area is the second plate’s area?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 times.",
          "worked": "Doubling the circumference doubles the radius. Since $A=\\pi r^2$, the area is multiplied by $2^2=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
