  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Ferdinand measures the circumference of his circular plate to be $20\\text{ cm}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
