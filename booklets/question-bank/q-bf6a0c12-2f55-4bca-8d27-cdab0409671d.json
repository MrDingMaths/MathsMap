  "content": {
    "id": "v2-ifficulty-metadata-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "A netball team scored 45 goals in two games.\nThey scored 9 fewer goals in the second game than in the first game.\nHow many goals did the team score in the second game?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "18 goals; $x+(x-9)=45$.",
      "worked": "Let $x$ be the number of goals scored in the first game. The second game had $x-9$ goals.\n\n$$\\begin{align*}x+(x-9)&=45\\\\2x-9&=45\\\\2x&=54\\\\x&=27\\end{align*}$$\n\nThe team scored $27-9=18$ goals in the second game.\n\nCheck: $27+18=45$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
