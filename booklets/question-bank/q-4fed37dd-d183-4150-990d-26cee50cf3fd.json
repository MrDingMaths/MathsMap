  "content": {
    "id": "p35-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Fourteen people enter five identical rooms so that three of the rooms have four people inside, and two of the rooms have one person inside. How many ways can this be done?",
    "layout": "list",
    "columns": null,
