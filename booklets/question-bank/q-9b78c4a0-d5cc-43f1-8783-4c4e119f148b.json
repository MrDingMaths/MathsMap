  "content": {
    "id": "p41-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A butcher gives a free leg of lamb to any customer who can prove a 1 kg mince packet weighs under 980 g. Mean weight is 1 kg, standard deviation 10 g. Assume packet weights are normally distributed. What percentage of customers should expect a free leg?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Approximately $2.5\\%$.",
      "worked": "The mean weight is $1000\\text{ g}$.\n$$\\begin{aligned}z&=\\frac{980-1000}{10}=-2\\\\P(X<980)&=P(Z<-2)\\\\P(X<980)&\\approx\\frac{1-0.95}{2}=0.025\\end{aligned}$$\nApproximately $2.5\\%$ of customers should expect a free leg.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
