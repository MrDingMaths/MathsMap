          "inlines": [
            {
              "type": "text",
              "text": "We can easily find the prime factorisation of 391 by recognising that it is the difference of two squares:",
              "marks": []
            }
          ]
        },
        {
          "id": "p7-q6-working",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{aligned}391&=400-9\\\\&=20^2-3^2\\\\&=(20-3)(20+3)\\\\&=17\\times23.\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p7-q6-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Similarly, express each of the following numbers as a product of prime numbers:",
              "marks": []
            }
          ]
        }
      ]
    },
