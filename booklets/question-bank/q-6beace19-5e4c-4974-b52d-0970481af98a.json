            "inlines": [
              {
                "type": "text",
                "text": "Partition the interval into ten intervals of length ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "0.1",
                "display": false
              },
              {
                "type": "text",
                "text": ". By the pigeonhole principle, two of the eleven points lie in the same interval, so their distance is at most ",
                "marks": []
              },
