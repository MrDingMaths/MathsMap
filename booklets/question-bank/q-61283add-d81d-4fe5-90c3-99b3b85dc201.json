  "content": {
    "id": "p9-q1",
    "type": "question",
    "label": "1",
    "prompt": "Simplify these algebraic fractions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{9w}{10}-\\dfrac{w+5}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{17w-50}{30}$",
          "worked": "$$\\begin{align*}\\frac{9w}{10}-\\frac{w+5}{3}&=\\frac{27w}{30}-\\frac{10(w+5)}{30}\\\\&=\\frac{27w-10(w+5)}{30}\\\\&=\\frac{27w-10w-50}{30}\\\\&=\\frac{17w-50}{30}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5a}{9}-\\dfrac{2a+5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4a-15}{18}$",
          "worked": "$$\\begin{align*}\\frac{5a}{9}-\\frac{2a+5}{6}&=\\frac{10a}{18}-\\frac{3(2a+5)}{18}\\\\&=\\frac{10a-3(2a+5)}{18}\\\\&=\\frac{10a-6a-15}{18}\\\\&=\\frac{4a-15}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{2a}{6}-\\dfrac{a-5}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5a+15}{24}$",
          "worked": "$$\\begin{align*}\\frac{2a}{6}-\\frac{a-5}{8}&=\\frac{8a}{24}-\\frac{3(a-5)}{24}\\\\&=\\frac{8a-3(a-5)}{24}\\\\&=\\frac{8a-3a+15}{24}\\\\&=\\frac{5a+15}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+3}{4}-\\dfrac{x+2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-x+1}{12}$",
          "worked": "$$\\begin{align*}\\frac{x+3}{4}-\\frac{x+2}{3}&=\\frac{3(x+3)}{12}-\\frac{4(x+2)}{12}\\\\&=\\frac{3(x+3)-4(x+2)}{12}\\\\&=\\frac{3x+9-4x-8}{12}\\\\&=\\frac{-x+1}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3-x}{5}-\\dfrac{x+4}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-7x-14}{10}$",
          "worked": "$$\\begin{align*}\\frac{3-x}{5}-\\frac{x+4}{2}&=\\frac{2(3-x)}{10}-\\frac{5(x+4)}{10}\\\\&=\\frac{2(3-x)-5(x+4)}{10}\\\\&=\\frac{6-2x-5x-20}{10}\\\\&=\\frac{-7x-14}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{5x-1}{4}-\\dfrac{2+x}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{9x-4}{8}$",
          "worked": "$$\\begin{align*}\\frac{5x-1}{4}-\\frac{2+x}{8}&=\\frac{2(5x-1)}{8}-\\frac{2+x}{8}\\\\&=\\frac{2(5x-1)-(2+x)}{8}\\\\&=\\frac{10x-2-2-x}{8}\\\\&=\\frac{9x-4}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p9-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{1+3x}{4}-\\dfrac{2x+3}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5x-3}{12}$",
          "worked": "$$\\begin{align*}\\frac{1+3x}{4}-\\frac{2x+3}{6}&=\\frac{3(1+3x)}{12}-\\frac{2(2x+3)}{12}\\\\&=\\frac{3(1+3x)-2(2x+3)}{12}\\\\&=\\frac{3+9x-4x-6}{12}\\\\&=\\frac{5x-3}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{x+5}{5}-\\dfrac{x-1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-3x+15}{10}$",
          "worked": "$$\\begin{align*}\\frac{x+5}{5}-\\frac{x-1}{2}&=\\frac{2(x+5)}{10}-\\frac{5(x-1)}{10}\\\\&=\\frac{2(x+5)-5(x-1)}{10}\\\\&=\\frac{2x+10-5x+5}{10}\\\\&=\\frac{-3x+15}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{5x-9}{7}-\\dfrac{2-x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{22x-41}{21}$",
          "worked": "$$\\begin{align*}\\frac{5x-9}{7}-\\frac{2-x}{3}&=\\frac{3(5x-9)}{21}-\\frac{7(2-x)}{21}\\\\&=\\frac{3(5x-9)-7(2-x)}{21}\\\\&=\\frac{15x-27-14+7x}{21}\\\\&=\\frac{22x-41}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p9-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{4x+3}{3}-\\dfrac{5-2x}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{14x+4}{9}$",
          "worked": "$$\\begin{align*}\\frac{4x+3}{3}-\\frac{5-2x}{9}&=\\frac{3(4x+3)}{9}-\\frac{5-2x}{9}\\\\&=\\frac{3(4x+3)-(5-2x)}{9}\\\\&=\\frac{12x+9-5+2x}{9}\\\\&=\\frac{14x+4}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{2x-1}{4}-\\dfrac{1-3x}{14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{20x-9}{28}$",
          "worked": "$$\\begin{align*}\\frac{2x-1}{4}-\\frac{1-3x}{14}&=\\frac{7(2x-1)}{28}-\\frac{2(1-3x)}{28}\\\\&=\\frac{7(2x-1)-2(1-3x)}{28}\\\\&=\\frac{14x-7-2+6x}{28}\\\\&=\\frac{20x-9}{28}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p9-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{3x-2}{8}-\\dfrac{4x-3}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{-11x+10}{56}$",
          "worked": "$$\\begin{align*}\\frac{3x-2}{8}-\\frac{4x-3}{7}&=\\frac{7(3x-2)}{56}-\\frac{8(4x-3)}{56}\\\\&=\\frac{7(3x-2)-8(4x-3)}{56}\\\\&=\\frac{21x-14-32x+24}{56}\\\\&=\\frac{-11x+10}{56}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
