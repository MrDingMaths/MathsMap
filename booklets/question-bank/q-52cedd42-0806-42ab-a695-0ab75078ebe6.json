  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Slips of paper numbered $1, 2, 3, \\ldots, 10$ are placed in a hat and one is drawn at random. What is the probability that the number on the slip of paper is not a multiple of four?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{4}{5}$",
      "worked": "The multiples of four are $4$ and $8$, so $10-2=8$ numbers are not multiples of four. The ten outcomes are equally likely.\n\n$$\\begin{align*}P(\\text{not a multiple of four})&=\\frac{8}{10}\\\\P(\\text{not a multiple of four})&=\\frac{4}{5}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
