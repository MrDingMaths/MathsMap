  "content": {
    "id": "p18-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A tank in the form of a rectangular prism has base dimensions 2.3 m by 1.4 m and holds water to a depth of 2 m. If the depth is increased by 3 m, what is the increase in the volume of the water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9.66\\text{ m}^3$",
      "worked": "The added water has the same base and height $3\\text{ m}$. Thus the increase is $\\Delta V=2.3\\times1.4\\times3=9.66\\text{ m}^3$.",
      "solutionDiagrams": []
    },
