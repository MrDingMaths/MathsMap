        "id": "p34-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\sin(180^{\\circ}+\\beta)}{\\cos(360^{\\circ}-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\tan\\beta$",
          "worked": "$$\\begin{align*}\\frac{\\sin(180^{\\circ}+\\beta)}{\\cos(360^{\\circ}-\\beta)}&=\\frac{-\\sin\\beta}{\\cos\\beta}\\\\&=-\\tan\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p34-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\cos(180^{\\circ}-\\beta)}{\\sin(90^{\\circ}-\\beta)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{\\cos(180^{\\circ}-\\beta)}{\\sin(90^{\\circ}-\\beta)}&=\\frac{-\\cos\\beta}{\\cos\\beta}\\\\&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p34-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin(180^{\\circ}+\\beta)\\cos(90^{\\circ}-\\beta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sin^{2}\\beta$",
          "worked": "$$\\begin{align*}\\sin(180^{\\circ}+\\beta)\\cos(90^{\\circ}-\\beta)&=(-\\sin\\beta)\\sin\\beta\\\\&=-\\sin^{2}\\beta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
