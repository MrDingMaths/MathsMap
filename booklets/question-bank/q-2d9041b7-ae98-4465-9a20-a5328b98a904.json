  "content": {
    "id": "p70-q75-root",
    "type": "question",
    "label": "75",
    "prompt": "For which values of $a$ does the curve given by the parametric equations\n$$\\left(2\\cos(t)+a\\sin(t),\\ \\cos(t)+2\\sin(t)\\right)$$\nrepresent a circle centred at the origin? Find the equation of the circle, stating any necessary restrictions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p70-q75-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "a=-1",
                "display": false
              },
              {
                "type": "text",
                "text": " gives ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x^2+y^2=5",
                "display": false
              },
              {
                "type": "text",
                "text": ". The entire circle is traced for ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "t\\in\\mathbb R",
                "display": false
              },
              {
                "type": "text",
