    "children": [
      {
        "id": "p9-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Determine a formula for the straight-line distance $d$ to the horizon, in terms of the radius $R$ of a planet, and the height $h$ from which the horizon is viewed.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p9-q10-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 9 p9-q10-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (O) at (0,0);\n\\coordinate (S) at (0,1);\n\\coordinate (P) at (0,1.35);\n\\coordinate (T) at ({sqrt(1-1/1.35^2)},{1/1.35});\n\\draw (O) circle[radius=1];\n\\draw (O)--(S) node[midway,left] {$R$};\n\\draw (S)--(P) node[midway,left] {$h$};\n\\draw (O)--(T) node[midway,below right] {$R$};\n\\draw (P)--(T) node[midway,above right] {$d$};\n\\fill (O) circle[radius=0.015];\n\\fill (S) circle[radius=0.015];\n\\fill (P) circle[radius=0.015];\n\\fill (T) circle[radius=0.015];\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 65,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 9,
              "sourceRegion": "Right column, question 10(a), before part (b)",
              "description": "Observer above an unshaded circular planet; vertical radius R continued by height h, tangent sight line d and radius R to the tangent point. Source pale fill omitted.",
              "mathematics": "The sight line is tangent; the centre-to-observer distance is R+h, and the radius to the tangent point is perpendicular to d.",
              "answerVisibility": "Supplied symbolic labels R, R, h and d only."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$d=\\sqrt{2Rh+h^2}$.",
          "worked": "The sight line is tangent to the planet, so it is perpendicular to the radius at the horizon.\n$$\\begin{align*}d^2+R^2&=(R+h)^2\\\\d^2&=R^2+2Rh+h^2-R^2\\\\d^2&=2Rh+h^2\\\\d&=\\sqrt{2Rh+h^2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p9-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If $h$ is tiny compared to $R$, then explain why $d\\approx\\sqrt{2Rh}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h^2$ is much smaller than $2Rh$, so $d\\approx\\sqrt{2Rh}$.",
          "worked": "When $h$ is tiny compared to $R$, $h^2$ is much smaller than $2Rh$. Neglecting $h^2$ in $d=\\sqrt{2Rh+h^2}$ gives $d\\approx\\sqrt{2Rh}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
