  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Consider the equation $y=56-14x$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $y$ when $x=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=98$.",
          "worked": "$$\\begin{align*}y&=56-14(-3)\\\\y&=56+42\\\\y&=98\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Factorise the right-hand side of the equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=14(4-x)$.",
          "worked": "$$\\begin{align*}y&=14\\times4-14x\\\\y&=14(4-x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve the equation for $y=50.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{11}{28}$.",
          "worked": "$$\\begin{align*}50.5&=56-14x\\\\14x&=56-50.5\\\\14x&=5.5\\\\x&=\\frac{5.5}{14}=\\frac{11}{28}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Write down the gradient and $y$-intercept of the line.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Gradient $-14$; $y$-intercept $(0,56)$.",
          "worked": "In $y=-14x+56$, the coefficient of $x$ is $-14$ and the constant term is $56$. Hence the gradient is $-14$ and the $y$-intercept is $(0,56)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
