    "label": "12",
    "prompt": "Simplify the following. $\\frac{3x^2+6x}{6x^2-3x}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{x+2}{2x-1}$, $x\\ne0,\\frac12$.",
      "worked": "$$\\begin{align*}\\frac{3x^2+6x}{6x^2-3x}&=\\frac{3x(x+2)}{3x(2x-1)}\\\\\\frac{3x^2+6x}{6x^2-3x}&=\\frac{x+2}{2x-1}\\end{align*}$$\nOriginal domain: $x\\ne0,\\frac12$.",
      "solutionDiagrams": []
