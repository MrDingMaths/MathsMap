    "id": "p17-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Use the result volume = area of base × height to express the volume of each solid, in terms of the given pronumerals.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "The volume of a cube of side length $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^3$",
          "worked": "$$\\begin{aligned}V&=a^2\\times a=a^3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "The volume of a rectangular prism with length $a$, width $b$ and height $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$abc$",
          "worked": "$$\\begin{aligned}V&=(ab)c=abc.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p17-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "The volume of a cylinder with radius $a$ and height $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pi a^2b$",
          "worked": "$$\\begin{aligned}V&=(\\pi a^2)b=\\pi a^2b.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
