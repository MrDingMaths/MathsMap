          {
            "id": "p9-q6-a",
            "type": "part",
            "label": "a",
            "prompt": "$\\dfrac{6x^2+x-2}{10x^2-9x+2}\\times\\dfrac{10x^2+x-2}{6x^2+7x+2}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{aligned}\\frac{6x^2+x-2}{10x^2-9x+2}\\times\\frac{10x^2+x-2}{6x^2+7x+2}&=\\frac{(3x+2)(2x-1)}{(5x-2)(2x-1)}\\times\\frac{(5x-2)(2x+1)}{(3x+2)(2x+1)}\\\\\\frac{6x^2+x-2}{10x^2-9x+2}\\times\\frac{10x^2+x-2}{6x^2+7x+2}&=1\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p9-q6-b",
            "type": "part",
            "label": "b",
            "prompt": "$\\dfrac{x^2-9}{2x^2-7x+3}\\div\\dfrac{2x^2-3x+1}{x^2-1}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{(x+3)(x+1)}{(2x-1)^2}$",
              "worked": "$$\\begin{aligned}\\frac{x^2-9}{2x^2-7x+3}\\div\\frac{2x^2-3x+1}{x^2-1}&=\\frac{x^2-9}{2x^2-7x+3}\\times\\frac{x^2-1}{2x^2-3x+1}\\\\\\frac{x^2-9}{2x^2-7x+3}\\div\\frac{2x^2-3x+1}{x^2-1}&=\\frac{(x-3)(x+3)}{(2x-1)(x-3)}\\times\\frac{(x-1)(x+1)}{(2x-1)(x-1)}\\\\\\frac{x^2-9}{2x^2-7x+3}\\div\\frac{2x^2-3x+1}{x^2-1}&=\\frac{(x+3)(x+1)}{(2x-1)^2}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          },
          {
            "id": "p9-q6-c",
            "type": "part",
            "label": "c",
            "prompt": "$\\dfrac{x^2}{2x^2-7x+3}\\times\\dfrac{2x^2-11x+15}{2x^2-5x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{x}{2x-1}$",
              "worked": "$$\\begin{aligned}\\frac{x^2}{2x^2-7x+3}\\times\\frac{2x^2-11x+15}{2x^2-5x}&=\\frac{x^2}{(2x-1)(x-3)}\\times\\frac{(2x-5)(x-3)}{x(2x-5)}\\\\\\frac{x^2}{2x^2-7x+3}\\times\\frac{2x^2-11x+15}{2x^2-5x}&=\\frac{x}{2x-1}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p9-q6-d",
            "type": "part",
            "label": "d",
            "prompt": "$\\dfrac{2x^2-x-3}{x^2-1}\\div\\dfrac{2x^2-5x+3}{x^2+2x+1}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{(x+1)^2}{(x-1)^2}$",
              "worked": "$$\\begin{aligned}\\frac{2x^2-x-3}{x^2-1}\\div\\frac{2x^2-5x+3}{x^2+2x+1}&=\\frac{2x^2-x-3}{x^2-1}\\times\\frac{x^2+2x+1}{2x^2-5x+3}\\\\\\frac{2x^2-x-3}{x^2-1}\\div\\frac{2x^2-5x+3}{x^2+2x+1}&=\\frac{(2x-3)(x+1)}{(x-1)(x+1)}\\times\\frac{(x+1)^2}{(2x-3)(x-1)}\\\\\\frac{2x^2-x-3}{x^2-1}\\div\\frac{2x^2-5x+3}{x^2+2x+1}&=\\frac{(x+1)^2}{(x-1)^2}\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 54
          }
        ]
      },
      {
        "id": "p9-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{p^2-q^2}{2p^2+p}\\times\\dfrac{2pq+q}{p^2-pq}\\div(p+q)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{q}{p^2}$",
          "worked": "$$\\begin{aligned}\\frac{p^2-q^2}{2p^2+p}\\times\\frac{2pq+q}{p^2-pq}\\div(p+q)&=\\frac{(p-q)(p+q)}{p(2p+1)}\\times\\frac{q(2p+1)}{p(p-q)}\\times\\frac{1}{p+q}\\\\\\frac{p^2-q^2}{2p^2+p}\\times\\frac{2pq+q}{p^2-pq}\\div(p+q)&=\\frac{q}{p^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p9-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{2a^2-32}{a^2+7a+12}\\div\\dfrac{4a^2-4a-48}{12a^2+15a}\\div\\dfrac{(a-1)(4a+5)}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3a^2}{2(a-1)(a+3)^2}$",
          "worked": "$$\\begin{aligned}\\frac{2a^2-32}{a^2+7a+12}\\div\\frac{4a^2-4a-48}{12a^2+15a}\\div\\frac{(a-1)(4a+5)}{a}&=\\frac{2a^2-32}{a^2+7a+12}\\times\\frac{12a^2+15a}{4a^2-4a-48}\\times\\frac{a}{(a-1)(4a+5)}\\\\\\frac{2a^2-32}{a^2+7a+12}\\div\\frac{4a^2-4a-48}{12a^2+15a}\\div\\frac{(a-1)(4a+5)}{a}&=\\frac{2(a-4)(a+4)}{(a+3)(a+4)}\\times\\frac{3a(4a+5)}{4(a-4)(a+3)}\\times\\frac{a}{(a-1)(4a+5)}\\\\\\frac{2a^2-32}{a^2+7a+12}\\div\\frac{4a^2-4a-48}{12a^2+15a}\\div\\frac{(a-1)(4a+5)}{a}&=\\frac{3a^2}{2(a-1)(a+3)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
