    "children": [
      {
        "id": "p84-q29-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the displacement of the particle at $t=3$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(3)=7\\text{ m}$.",
          "worked": "$$\\begin{align*}x(3)&=2(3)^2-4(3)+1\\\\x(3)&=7\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p84-q29-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the velocity-time equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=4t-4\\text{ m s}^{-1}$.",
          "worked": "$$\\begin{align*}v(t)&=\\frac{dx}{dt}\\\\v(t)&=4t-4\\text{ m s}^{-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p84-q29-c",
        "type": "part",
        "label": "c",
        "prompt": "Find when the particle has speed $4\\text{ m s}^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=0\\text{ s}$ or $t=2\\text{ s}$, since $|v(t)|=4$.",
          "worked": "$$\\begin{align*}|v(t)|&=4\\\\|4t-4|&=4\\\\4t-4&=4\\quad\\text{or}\\quad4t-4=-4\\\\t&=2\\text{ s}\\quad\\text{or}\\quad t=0\\text{ s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p84-q29-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the total distance travelled after three seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\text{ m}$. The particle reverses direction at $t=1\\text{ s}$; add the distances on either side.",
          "worked": "$$\\begin{align*}v(t)&=4t-4\\\\v(1)&=0\\\\x(0)&=1\\text{ m}\\\\x(1)&=-1\\text{ m}\\\\x(3)&=7\\text{ m}\\\\\\text{Total distance}&=|x(1)-x(0)|+|x(3)-x(1)|\\\\\\text{Total distance}&=|-1-1|+|7-(-1)|\\\\\\text{Total distance}&=10\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
