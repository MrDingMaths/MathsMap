  "content": {
    "id": "p30-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Mr Ho invests an amount of money for one year at $5\\%$ per annum interest. The bank tells him that at the end of the year he will have $\\$126\\,000$. How much does Mr Ho invest?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$120\\,000$",
      "worked": "The final balance represents $100\\%+5\\%=105\\%$ of the investment.\n\n$$\\begin{align*}\\text{Value of }1\\%&=\\$126\\,000\\div105\\\\\\text{Value of }1\\%&=\\$1200\\\\\\text{Investment}&=\\$1200\\times100\\\\\\text{Investment}&=\\$120\\,000\\end{align*}$$",
      "solutionDiagrams": []
    },
