    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3240^{\\circ}$",
      "worked": "$$\\begin{align*}n&=\\frac{360^{\\circ}}{18^{\\circ}}\\\\&=20\\end{align*}$$\n$$\\begin{align*}S&=180(n-2)\\\\&=180(20-2)\\\\&=180(18)\\\\&=3240^{\\circ}\\end{align*}$$",
      "solutionDiagrams": []
    },
