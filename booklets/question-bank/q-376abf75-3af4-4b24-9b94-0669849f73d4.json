    "children": [
      {
        "id": "p5-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an expression for the area of the pool in expanded form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(10-2x)(15-2x)=4x^2-50x+150$; area in $\\text{m}^2$.",
          "worked": "The pool dimensions are $(10-2x)$ m and $(15-2x)$ m.\n$$\\begin{align*}A_{\\text{pool}}&=(10-2x)(15-2x)\\\\&=150-20x-30x+4x^2\\\\&=(4x^2-50x+150)\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p5-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the area of the pool if $x=2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$66\\text{ m}^2$",
          "worked": "$$\\begin{align*}A_{\\text{pool}}&=4(2)^2-50(2)+150\\\\&=16-100+150\\\\&=66\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
