    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac2{\\sqrt3-2}+\\dfrac2{\\sqrt3+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4\\sqrt3$",
          "worked": "$$\\begin{align*}\\frac2{\\sqrt3-2}+\\frac2{\\sqrt3+2}&=\\frac{2(\\sqrt3+2)+2(\\sqrt3-2)}{(\\sqrt3-2)(\\sqrt3+2)}\\\\\\frac2{\\sqrt3-2}+\\frac2{\\sqrt3+2}&=\\frac{4\\sqrt3}{3-4}\\\\\\frac2{\\sqrt3-2}+\\frac2{\\sqrt3+2}&=-4\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac2{\\sqrt3-2}-\\dfrac2{\\sqrt3+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$\\begin{align*}\\frac2{\\sqrt3-2}-\\frac2{\\sqrt3+2}&=\\frac{2(\\sqrt3+2)-2(\\sqrt3-2)}{(\\sqrt3-2)(\\sqrt3+2)}\\\\\\frac2{\\sqrt3-2}-\\frac2{\\sqrt3+2}&=\\frac8{3-4}\\\\\\frac2{\\sqrt3-2}-\\frac2{\\sqrt3+2}&=-8.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac2{\\sqrt3-2}\\times\\dfrac2{\\sqrt3+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}\\frac2{\\sqrt3-2}\\times\\frac2{\\sqrt3+2}&=\\frac4{(\\sqrt3-2)(\\sqrt3+2)}\\\\\\frac2{\\sqrt3-2}\\times\\frac2{\\sqrt3+2}&=\\frac4{3-4}\\\\\\frac2{\\sqrt3-2}\\times\\frac2{\\sqrt3+2}&=-4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p23-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac2{\\sqrt3-2}\\div\\dfrac2{\\sqrt3+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7-4\\sqrt3$\n\nMultiply by the reciprocal, then rationalise using the conjugate.",
          "worked": "$$\\begin{align*}\\frac2{\\sqrt3-2}\\div\\frac2{\\sqrt3+2}&=\\frac2{\\sqrt3-2}\\times\\frac{\\sqrt3+2}{2}\\\\\\frac2{\\sqrt3-2}\\div\\frac2{\\sqrt3+2}&=\\frac{\\sqrt3+2}{\\sqrt3-2}\\\\\\frac2{\\sqrt3-2}\\div\\frac2{\\sqrt3+2}&=\\frac{(\\sqrt3+2)^2}{3-4}\\\\\\frac2{\\sqrt3-2}\\div\\frac2{\\sqrt3+2}&=-7-4\\sqrt3.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
  },
