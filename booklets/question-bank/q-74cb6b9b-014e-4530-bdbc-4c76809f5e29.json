    "label": "5",
    "prompt": "Jono says $\\sqrt{18}$ is a surd. Explain why he is correct.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\sqrt{18}$ is irrational: its decimal is non-terminating and non-recurring.",
      "worked": "$\\sqrt{18}$ cannot be expressed as a fraction with integer numerator and non-zero integer denominator. Its decimal is non-terminating and non-recurring, so it is an irrational root and therefore a surd.",
