  "content": {
    "id": "p46-q32-group-root",
    "type": "question",
    "label": "11",
    "prompt": "Write the following description of a set in set notation.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q32-node",
        "type": "part",
        "label": "a",
        "prompt": "Integers from 1 to 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,4,5\\}$",
          "worked": "Include every integer from 1 to 5, including both endpoints: $\\{1,2,3,4,5\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p46-q33-node",
        "type": "part",
        "label": "b",
        "prompt": "Even integers between $-3$ and $7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{-2,0,2,4,6\\}$",
          "worked": "The even integers strictly between $-3$ and $7$ are $-2,0,2,4,6$.\n\n$$\\left\\{x\\in\\mathbb Z\\text{ where }-3<x<7\\text{ and }\\frac{x}{2}\\in\\mathbb Z\\right\\}=\\{-2,0,2,4,6\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p46-q34-node",
        "type": "part",
        "label": "c",
        "prompt": "Integers from 100 to 400.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{x\\in\\mathbb Z\\text{ where }100\\le x\\le400\\}$",
          "worked": "Use the integer domain and include both endpoints:\n$$\\{x\\in\\mathbb Z\\text{ where }100\\le x\\le400\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p46-q35-node",
        "type": "part",
        "label": "d",
        "prompt": "Odd integers between 100 and 200.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{101,103,\\ldots,199\\}$",
          "worked": "The first odd integer is 101. Increase by 2, ending at 199:\n$$\\{101,103,\\ldots,199\\}.$$\nEquivalently,\n$$\\left\\{x\\in\\mathbb Z\\text{ where }100<x<200\\text{ and }\\frac{x+1}{2}\\in\\mathbb Z\\right\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p46-q36-node",
        "type": "part",
        "label": "e",
        "prompt": "Real numbers greater than 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{x\\in\\mathbb R\\text{ where }x>2\\}$",
          "worked": "The domain is $\\mathbb R$, and “greater than 2” gives the strict condition $x>2$:\n$$\\{x\\in\\mathbb R\\text{ where }x>2\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p46-q37-node",
        "type": "part",
        "label": "f",
        "prompt": "All real numbers not equal to 0.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{x\\in\\mathbb R\\text{ where }x\\ne0\\}$",
          "worked": "Exclude zero from the real-number domain:\n$$\\{x\\in\\mathbb R\\text{ where }x\\ne0\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
