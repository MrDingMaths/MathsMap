    "children": [
      {
        "id": "p31-q5-differentiate",
        "type": "part",
        "label": "",
        "prompt": "Differentiate $y=x^2+bx+c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=2x+b$",
          "worked": "$$\\begin{align*}y'&=2x+b\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p31-q5-conditions",
        "type": "group",
        "label": "",
        "prompt": "Hence find $b$ and $c$ given that:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p31-q5-a",
            "type": "part",
            "label": "a",
            "prompt": "the parabola passes through the origin, and the tangent there has gradient $7$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=7,\\ c=0$",
              "worked": "At the origin, $x=0$ and $y=0$.\n$$\\begin{align*}0&=0^2+b(0)+c\\\\c&=0\\\\7&=2(0)+b\\\\b&=7\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p31-q5-b",
            "type": "part",
            "label": "b",
            "prompt": "the parabola has $y$-intercept $-3$ and gradient $-2$ there,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=-2,\\ c=-3$",
              "worked": "At the $y$-intercept, $x=0$.\n$$\\begin{align*}-3&=0^2+b(0)+c\\\\c&=-3\\\\-2&=2(0)+b\\\\b&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p31-q5-c",
            "type": "part",
            "label": "c",
            "prompt": "the parabola is tangent to the $x$-axis at the point $(5,0)$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=-10,\\ c=25$",
              "worked": "The $x$-axis has gradient $0$, so $y'(5)=0$.\n$$\\begin{align*}0&=2(5)+b\\\\b&=-10\\\\0&=5^2+(-10)(5)+c\\\\0&=-25+c\\\\c&=25\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p31-q5-d",
            "type": "part",
            "label": "d",
            "prompt": "when $x=3$ the gradient is $5$, and $x=2$ is a zero,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=-1,\\ c=-2$",
              "worked": "$$\\begin{align*}5&=2(3)+b\\\\b&=-1\\end{align*}$$\nSince $x=2$ is a zero, $y=0$ there.\n$$\\begin{align*}0&=2^2+(-1)(2)+c\\\\0&=2+c\\\\c&=-2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 21
          },
          {
            "id": "p31-q5-e",
            "type": "part",
            "label": "e",
            "prompt": "the parabola is tangent to $3x+y-5=0$ at the point $T(3,-4)$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=-9,\\ c=14$",
              "worked": "$$\\begin{align*}y&=-3x+5\\end{align*}$$\nThe tangent has gradient $-3$.\n$$\\begin{align*}-3&=2(3)+b\\\\b&=-9\\end{align*}$$\nSubstitute $T(3,-4)$ into the parabola.\n$$\\begin{align*}-4&=3^2+(-9)(3)+c\\\\-4&=-18+c\\\\c&=14\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p31-q5-f",
            "type": "part",
            "label": "f",
            "prompt": "the line $3x+y-5=0$ is a normal at the point $T(3,-4)$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b=-\\dfrac{17}{3},\\ c=4$",
              "worked": "$$\\begin{align*}y&=-3x+5\\\\m_{\\perp}&=-3\\\\m&=-\\frac{1}{-3}\\\\m&=\\frac13\\end{align*}$$\nThus the tangent gradient at $x=3$ is $\\frac13$.\n$$\\begin{align*}\\frac13&=2(3)+b\\\\b&=-\\frac{17}{3}\\end{align*}$$\nSubstitute $T(3,-4)$ into the parabola.\n$$\\begin{align*}-4&=3^2-\\frac{17}{3}(3)+c\\\\-4&=-8+c\\\\c&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 35
          }
        ]
      }
    ]
  },
