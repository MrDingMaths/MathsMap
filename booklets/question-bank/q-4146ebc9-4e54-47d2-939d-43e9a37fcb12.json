          "inlines": [
            {
              "type": "text",
              "text": "Michelle can complete a landscaping job in 6 days and Danielle can complete the job in 4 days.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Working together, in how many days could they complete the job?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "2.4 days, or 2 days 9 hours 36 minutes",
      "worked": "$$\\begin{align*}\\text{Combined rate}&=\\frac{1\\text{ job}}{6\\text{ days}}+\\frac{1\\text{ job}}{4\\text{ days}}\\\\\\text{Combined rate}&=\\frac{5\\text{ jobs}}{12\\text{ days}}\\\\\\text{Combined rate}&=\\frac{1\\text{ job}}{\\frac{12}{5}\\text{ days}}\\\\\\text{Time}&=2.4\\text{ days}\\end{align*}$$\nConvert the fractional day to hours and minutes.\n$$\\begin{align*}0.4\\text{ day}&=0.4\\times24\\text{ hours}=9.6\\text{ hours}\\\\0.6\\text{ hour}&=0.6\\times60\\text{ minutes}=36\\text{ minutes}\\end{align*}$$\nThey will take **2.4 days**, or **2 days 9 hours 36 minutes**.",
      "solutionDiagrams": []
    },
