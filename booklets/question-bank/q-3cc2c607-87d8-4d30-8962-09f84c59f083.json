  "content": {
    "id": "p10-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve for $x$, correct to four decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(0.01)^x=7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx-0.4225$",
          "worked": "$$\\begin{align*}x\\log_{10}(0.01)&=\\log_{10}7\\\\-2x&=\\log_{10}7\\\\x&=-\\frac{\\log_{10}7}{2}\\\\x&\\approx-0.4225\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p10-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^{1-2x}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx0.1587$",
          "worked": "$$\\begin{align*}(1-2x)\\log_{10}5&=\\log_{10}3\\\\1-2x&=\\frac{\\log_{10}3}{\\log_{10}5}\\\\2x&=1-\\frac{\\log_{10}3}{\\log_{10}5}\\\\x&=\\frac{\\log_{10}5-\\log_{10}3}{2\\log_{10}5}\\\\x&\\approx0.1587\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p10-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^{2x-1}=7^{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx-5.3847$\n\nTake base 10 logarithms of both sides and collect the terms containing $x$.",
          "worked": "$$\\begin{align*}(2x-1)\\log_{10}4&=(x-3)\\log_{10}7\\\\2x\\log_{10}4-\\log_{10}4&=x\\log_{10}7-3\\log_{10}7\\\\x(2\\log_{10}4-\\log_{10}7)&=\\log_{10}4-3\\log_{10}7\\\\x&=\\frac{\\log_{10}4-3\\log_{10}7}{2\\log_{10}4-\\log_{10}7}\\\\x&\\approx-5.3847\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p10-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$3^{3x-3}=5^{5x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}(3x-3)\\log_{10}3&=(5x-5)\\log_{10}5\\\\3(x-1)\\log_{10}3&=5(x-1)\\log_{10}5\\\\(x-1)(3\\log_{10}3-5\\log_{10}5)&=0\\end{align*}$$\nSince $3\\log_{10}3-5\\log_{10}5\\ne0$,\n$$\\begin{align*}x-1&=0\\\\x&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
