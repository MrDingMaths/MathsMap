    "type": "question",
    "label": "16",
    "prompt": "A tank that is $\\frac{2}{3}$ full contains 1350 L of water. How many litres does it hold when it is full?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "2025 L",
      "worked": "$$\\begin{align*}\\text{Full capacity}&=1350\\div\\frac{2}{3}\\\\\\text{Full capacity}&=1350\\times\\frac{3}{2}\\\\\\text{Full capacity}&=675\\times3\\\\\\text{Full capacity}&=2025\\text{ L}\\end{align*}$$",
      "solutionDiagrams": []
    },
