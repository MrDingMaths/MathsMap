  "content": {
    "id": "p33-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the area enclosed between each curve and the $x$-axis over the stated interval.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sin x$, from $x=\\frac{\\pi}{3}$ to $x=\\frac{\\pi}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$ square units",
          "worked": "$$\\begin{align*}A&=\\int_{\\pi/3}^{\\pi/2}\\sin x\\,dx\\\\&=[-\\cos x]_{\\pi/3}^{\\pi/2}\\\\&=0+\\frac12\\\\&=\\frac12\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p33-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sin 2x$, from $x=\\frac{\\pi}{4}$ to $x=\\frac{\\pi}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$ square units",
          "worked": "$$\\begin{align*}A&=\\int_{\\pi/4}^{\\pi/2}\\sin 2x\\,dx\\\\&=\\left[-\\frac12\\cos 2x\\right]_{\\pi/4}^{\\pi/2}\\\\&=\\frac12+0\\\\&=\\frac12\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\cos x$, from $x=\\frac{\\pi}{3}$ to $x=\\frac{\\pi}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2-\\sqrt3}{2}$ square units",
          "worked": "$$\\begin{align*}A&=\\int_{\\pi/3}^{\\pi/2}\\cos x\\,dx\\\\&=[\\sin x]_{\\pi/3}^{\\pi/2}\\\\&=1-\\frac{\\sqrt3}{2}\\\\&=\\frac12(2-\\sqrt3)\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\cos 3x$, from $x=\\frac{\\pi}{12}$ to $x=\\frac{\\pi}{6}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2-\\sqrt2}{6}$ square units",
          "worked": "$$\\begin{align*}A&=\\int_{\\pi/12}^{\\pi/6}\\cos 3x\\,dx\\\\&=\\left[\\frac13\\sin 3x\\right]_{\\pi/12}^{\\pi/6}\\\\&=\\frac13\\left(\\sin\\frac{\\pi}{2}-\\sin\\frac{\\pi}{4}\\right)\\\\&=\\frac16(2-\\sqrt2)\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\sec^2 x$, from $x=\\frac{\\pi}{6}$ to $x=\\frac{\\pi}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2\\sqrt3}{3}$ square units",
          "worked": "$$\\begin{align*}A&=\\int_{\\pi/6}^{\\pi/3}\\sec^2 x\\,dx\\\\&=[\\tan x]_{\\pi/6}^{\\pi/3}\\\\&=\\sqrt3-\\frac1{\\sqrt3}\\\\&=\\frac{2\\sqrt3}{3}\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p33-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\sec^2\\left(\\frac{x}{2}\\right)$, from $x=-\\frac{\\pi}{2}$ to $x=\\frac{\\pi}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$ square units",
          "worked": "$$\\begin{align*}A&=\\int_{-\\pi/2}^{\\pi/2}\\sec^2\\left(\\frac{x}{2}\\right)\\,dx\\\\&=\\left[2\\tan\\left(\\frac{x}{2}\\right)\\right]_{-\\pi/2}^{\\pi/2}\\\\&=2(1)-2(-1)\\\\&=4\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
