  "content": {
    "id": "p12-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the first four terms of the geometric sequence whose first term is $4$ and whose common ratio is $\\frac{1}{2}$. Find a formula for the $n$th term.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4,\\ 2,\\ 1,\\ \\frac{1}{2}$; $a_n=4\\left(\\frac{1}{2}\\right)^{n-1}$.",
      "worked": "$$\\begin{align*}a_2&=4\\times\\frac{1}{2}=2\\\\a_3&=2\\times\\frac{1}{2}=1\\\\a_4&=1\\times\\frac{1}{2}=\\frac{1}{2}\\end{align*}$$\nThe first four terms are $4,2,1,\\frac{1}{2}$.\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=4\\left(\\frac{1}{2}\\right)^{n-1}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
