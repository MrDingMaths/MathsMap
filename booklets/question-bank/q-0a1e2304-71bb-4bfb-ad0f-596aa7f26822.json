      {
        "id": "p8-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{x^2}{y}\\right)^2\\times\\left(\\frac{y^2}{x}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy^4$",
          "worked": "$\\begin{aligned}\\left(\\frac{x^2}{y}\\right)^2\\times\\left(\\frac{y^2}{x}\\right)^3&=\\frac{x^4}{y^2}\\times\\frac{y^6}{x^3}\\\\\\left(\\frac{x^2}{y}\\right)^2\\times\\left(\\frac{y^2}{x}\\right)^3&=\\frac{x^4y^6}{x^3y^2}\\\\\\left(\\frac{x^2}{y}\\right)^2\\times\\left(\\frac{y^2}{x}\\right)^3&=xy^4\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{4a^2}{b}\\right)^2\\times\\left(\\frac{b}{2a}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2ab$",
          "worked": "$\\begin{aligned}\\left(\\frac{4a^2}{b}\\right)^2\\times\\left(\\frac{b}{2a}\\right)^3&=\\frac{16a^4}{b^2}\\times\\frac{b^3}{8a^3}\\\\\\left(\\frac{4a^2}{b}\\right)^2\\times\\left(\\frac{b}{2a}\\right)^3&=\\frac{16a^4b^3}{8a^3b^2}\\\\\\left(\\frac{4a^2}{b}\\right)^2\\times\\left(\\frac{b}{2a}\\right)^3&=2ab\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{x^3}{y^2}\\right)^2\\div\\left(\\frac{x}{y^2}\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3y^2$",
          "worked": "$\\begin{aligned}\\left(\\frac{x^3}{y^2}\\right)^2\\div\\left(\\frac{x}{y^2}\\right)^3&=\\frac{x^6}{y^4}\\div\\frac{x^3}{y^6}\\\\\\left(\\frac{x^3}{y^2}\\right)^2\\div\\left(\\frac{x}{y^2}\\right)^3&=\\frac{x^6}{y^4}\\times\\frac{y^6}{x^3}\\\\\\left(\\frac{x^3}{y^2}\\right)^2\\div\\left(\\frac{x}{y^2}\\right)^3&=x^3y^2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p8-q20-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{2x^4}{y}\\right)^5\\div\\left(\\frac{4x^3}{y^3}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^{14}y$",
          "worked": "$\\begin{aligned}\\left(\\frac{2x^4}{y}\\right)^5\\div\\left(\\frac{4x^3}{y^3}\\right)^2&=\\frac{32x^{20}}{y^5}\\div\\frac{16x^6}{y^6}\\\\\\left(\\frac{2x^4}{y}\\right)^5\\div\\left(\\frac{4x^3}{y^3}\\right)^2&=\\frac{32x^{20}}{y^5}\\times\\frac{y^6}{16x^6}\\\\\\left(\\frac{2x^4}{y}\\right)^5\\div\\left(\\frac{4x^3}{y^3}\\right)^2&=2x^{14}y\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
