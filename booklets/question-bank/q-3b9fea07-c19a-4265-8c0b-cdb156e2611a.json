    "id": "p18-q25-root",
    "type": "question",
    "label": "25",
    "prompt": "Find the least multiple of 5 that when divided by 6, 7, and 8, leaves 4 as the remainder in each case.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
