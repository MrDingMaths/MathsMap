  "content": {
    "id": "p9-q40-content",
    "type": "question",
    "label": null,
    "prompt": "Let $y = 2e^{x} - x^{2}$. Find the equation of the tangent to the curve at $x = 1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
