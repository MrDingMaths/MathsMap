  "content": {
    "id": "p39-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "To hire a tennis court, you must pay a $\\$5$ booking fee plus $\\$10$ per hour.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the cost of booking a court for 2 hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$25$",
          "worked": "$$\\begin{align*}\\text{Total cost} &= 5 + 10 \\times 2\\\\\\text{Total cost} &= 25\\end{align*}$$\nThe cost is $\\$25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p39-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the cost, in dollars, of booking a court for $x$ hours? Write an expression.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10x + 5$",
          "worked": "The hourly charge is $10x$ dollars. Adding the booking fee gives a total cost of $10x + 5$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
