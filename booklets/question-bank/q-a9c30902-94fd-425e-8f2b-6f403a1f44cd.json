  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the discriminant $\\Delta$ for each equation. Hence state how many roots there are, and whether or not they are rational.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-4x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=4$; two distinct rational roots.",
          "worked": "$$\\begin{align*}\\Delta&=(-4)^2-4(1)(3)\\\\\\Delta&=4\\end{align*}$$\nSince $4=2^2>0$, there are two distinct rational roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+2x-7=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=32$; two distinct irrational roots.",
          "worked": "$$\\begin{align*}\\Delta&=2^2-4(1)(-7)\\\\\\Delta&=32\\end{align*}$$\nSince $32>0$ and is not a square, there are two distinct irrational roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+3x+4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-7$; no real roots.",
          "worked": "$$\\begin{align*}\\Delta&=3^2-4(1)(4)\\\\\\Delta&=-7\\end{align*}$$\nSince $\\Delta<0$, there are no real roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2+4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=0$; one double rational root.",
          "worked": "$$\\begin{align*}\\Delta&=4^2-4(4)(1)\\\\\\Delta&=0\\end{align*}$$\nSince $\\Delta=0$, there is one double rational root.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-3x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=-11$; no real roots.",
          "worked": "$$\\begin{align*}\\Delta&=(-3)^2-4(1)(5)\\\\\\Delta&=-11\\end{align*}$$\nSince $\\Delta<0$, there are no real roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p13-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$6x^2+11x-10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Delta=361$; two distinct rational roots.",
          "worked": "$$\\begin{align*}\\Delta&=11^2-4(6)(-10)\\\\\\Delta&=361\\end{align*}$$\nSince $361=19^2>0$, there are two distinct rational roots.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
