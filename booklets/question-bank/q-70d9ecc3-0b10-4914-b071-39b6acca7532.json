  "content": {
    "id": "p13-q13-root",
    "type": "question",
    "label": "",
    "prompt": "",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find 40% of $\\$3920$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$1568$",
          "worked": "$$\\begin{align*}\\text{Amount} &= 3920\\times 0.40\\\\\\text{Amount} &= \\text{\\$}1568\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Increase $\\$3920$ by 40%",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$5488$",
          "worked": "$$\\begin{align*}\\text{New amount} &= 3920(1+0.40)\\\\\\text{New amount} &= 3920\\times 1.40\\\\\\text{New amount} &= \\text{\\$}5488\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "A number is increased by 40% to get $\\$3920$. What was the number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$2800$",
          "worked": "$$\\begin{align*}1.40x &= 3920\\\\x &= \\frac{3920}{1.40}\\\\x &= 2800\\end{align*}$$\nThe original amount was $\\$2800$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\$3920$ is invested at 40% p.a. compounded annually. How much money is there after 3 years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$10\\,756.48$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 3920(1+0.40)^3\\\\FV &= \\text{\\$}10\\,756.48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
