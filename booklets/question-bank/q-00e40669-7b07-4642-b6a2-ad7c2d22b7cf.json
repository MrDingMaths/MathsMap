    ],
    "children": [
      {
        "id": "p36-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "The perimeter of the rectangle is $19$ cm. Find the value of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4.5$ cm",
          "worked": "$$\\begin{align*}2\\bigl[2(x-1)+(x-2)\\bigr]&=19\\\\6x-8&=19\\\\6x&=27\\\\x&=\\frac{9}{2}\\end{align*}$$\nThus $x=4.5$ cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Write an expanded expression for the area of the rectangle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x^2-6x+4$ cm$^2$",
          "worked": "$$\\begin{align*}A&=2(x-1)(x-2)\\\\A&=2(x^2-3x+2)\\\\A&=2x^2-6x+4\\end{align*}$$\nThe area is $(2x^2-6x+4)$ cm$^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p36-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $x$ such that the length is $5$ times the width.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{8}{3}$ cm",
          "worked": "$$\\begin{align*}2(x-1)&=5(x-2)\\\\2x-2&=5x-10\\\\8&=3x\\\\x&=\\frac{8}{3}\\end{align*}$$\nThus $x=\\frac{8}{3}$ cm.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p36-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "The area of the rectangle is $1.5$ cm$^2$. Find the length.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$ cm; use $x=\\frac{5}{2}$, since $x>2$.",
          "worked": "$$\\begin{align*}2(x-1)(x-2)&=\\frac{3}{2}\\\\2x^2-6x+\\frac{5}{2}&=0\\end{align*}$$\n$a=2$, $b=-6$, $c=\\frac{5}{2}$.\n$$\\begin{align*}x&=\\frac{-(-6)\\pm\\sqrt{(-6)^2-4(2)(\\frac{5}{2})}}{2(2)}\\\\x&=\\frac{6\\pm\\sqrt{16}}{4}\\\\x&=\\frac{5}{2}\\text{ or }\\frac{1}{2}\\end{align*}$$\nSince $x-2>0$, reject $x=\\frac{1}{2}$.\n$$\\begin{align*}\\text{Length}&=2\\left(\\frac{5}{2}-1\\right)\\\\\\text{Length}&=3\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
