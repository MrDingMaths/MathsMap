    "label": "11",
    "prompt": "Consider this rectangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p36-q11-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 36 p36-q11-diagram\"}\n\\begin{tikzpicture}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (5,0);\n\\coordinate (C) at (5,3);\n\\coordinate (D) at (0,3);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--(D)--cycle;\n\\path (D)--(C) node[midway,above,font=\\fontsize{10}{12}\\selectfont] {$2(x-1)$};\n\\path (B)--(C) node[midway,right,font=\\fontsize{10}{12}\\selectfont] {$x-2$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 58,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 36,
          "sourceRegion": "Question 11 shared rectangle",
          "description": "Unshaded horizontal rectangle with the longer top side labelled 2(x−1) and the right side labelled x−2. Illustrative proportions are not measurements.",
          "mathematics": "Length 2(x−1), width x−2; physical side lengths require x>2.",
          "answerVisibility": "All outlines and both side labels are permanent student-visible givens."
        },
