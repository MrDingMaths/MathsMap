  "content": {
    "id": "p35-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "A magician deals cards from two different decks for a trick.\nThe probability of dealing a red card from deck 1 is 0.3.\nThe probability of a red card from deck 2 is three times the probability of a red from deck 1.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the probability of picking two reds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.27$",
          "worked": "$$\\begin{align*}P(R_2)&=3\\times0.3=0.9\\\\P(R_1\\text{ and }R_2)&=0.3\\times0.9=0.27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the probability of picking a red from deck 1 and a black from deck 2?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.03$",
          "worked": "$$\\begin{align*}P(R_2)&=3\\times0.3=0.9\\\\P(B_2)&=1-0.9=0.1\\\\P(R_1\\text{ and }B_2)&=0.3\\times0.1=0.03\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the probability of picking a black from deck 1 and a red from deck 2?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.63$",
          "worked": "$$\\begin{align*}P(B_1)&=1-0.3=0.7\\\\P(R_2)&=3\\times0.3=0.9\\\\P(B_1\\text{ and }R_2)&=0.7\\times0.9=0.63\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p35-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "What is the probability of picking no reds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.07$",
          "worked": "$$\\begin{align*}P(B_1)&=1-0.3=0.7\\\\P(R_2)&=3\\times0.3=0.9\\\\P(B_2)&=1-0.9=0.1\\\\P(\\text{no reds})&=0.7\\times0.1=0.07\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
