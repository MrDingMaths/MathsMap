    "children": [
      {
        "id": "p37-q13-part1",
        "type": "part",
        "label": "a",
        "prompt": "What is the equation of the least-squares regression line relating to the dataset?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=3.2x+2$",
          "worked": "The line crosses the $y$-axis at 2. Two points read from the line are approximately $(0,2)$ and $(5,18)$.\n$$\\begin{aligned}m&=\\frac{18-2}{5-0}\\\\&=3.2\\\\y&=3.2x+2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p37-q13-part2",
        "type": "part",
        "label": "b",
        "prompt": "Suppose a sixth dataset was collected on a day that had 10 hours of sunshine and 45 bottles of lemonade sold. What would happen to the gradient of the line?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The gradient would increase: the line would become steeper.",
          "worked": "The new point $(10,45)$ is above the current line and to the right of the existing points. It pulls the right-hand end of the fitted line upwards, so the gradient increases.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ],
