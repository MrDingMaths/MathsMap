  "content": {
    "id": "p7-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Tibor is currently 7 times his son’s age. In 8 years’ time, he will be 3 times his son’s age. What is Tibor’s current age?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "28 years.",
      "worked": "Let $t$ and $s$ be Tibor’s and his son’s current ages in years.\n$$\\begin{align*}t&=7s\\\\t+8&=3(s+8)\\end{align*}$$\nSubstitute $t=7s$:\n$$\\begin{align*}7s+8&=3(s+8)\\\\7s+8&=3s+24\\\\4s&=16\\\\s&=4\\\\t&=7(4)\\\\t&=28\\end{align*}$$\nCheck: $28=7(4)$ and $28+8=3(4+8)$. Tibor is currently 28 years old.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
