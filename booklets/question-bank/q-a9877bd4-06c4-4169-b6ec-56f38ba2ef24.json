    "id": "p63-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Show that $\\dfrac{\\sin 3\\theta}{\\sin\\theta}+\\dfrac{\\cos 3\\theta}{\\cos\\theta}=4\\cos 2\\theta$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Identity proved.\n\nCombine the fractions, then use the sine sum and double-angle formulas.",
      "worked": "$$\\begin{align*}\\frac{\\sin 3\\theta}{\\sin\\theta}+\\frac{\\cos 3\\theta}{\\cos\\theta}&=\\frac{\\sin 3\\theta\\cos\\theta+\\cos 3\\theta\\sin\\theta}{\\sin\\theta\\cos\\theta}\\\\\\frac{\\sin 3\\theta}{\\sin\\theta}+\\frac{\\cos 3\\theta}{\\cos\\theta}&=\\frac{\\sin 4\\theta}{\\tfrac12\\sin 2\\theta}\\\\\\frac{\\sin 3\\theta}{\\sin\\theta}+\\frac{\\cos 3\\theta}{\\cos\\theta}&=\\frac{2\\sin 2\\theta\\cos 2\\theta}{\\tfrac12\\sin 2\\theta}\\\\\\frac{\\sin 3\\theta}{\\sin\\theta}+\\frac{\\cos 3\\theta}{\\cos\\theta}&=4\\cos 2\\theta.\\end{align*}$$",
      "solutionDiagrams": []
    },
