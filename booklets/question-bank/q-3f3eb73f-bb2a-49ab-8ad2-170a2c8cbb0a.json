    "label": "3",
    "prompt": "A line passes through the $y$-axis at $(0,6)$ and has a gradient of $\\frac57$. What is its equation?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=\\frac{5x}{7}+6$",
      "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-6&=\\frac57(x-0)\\\\y&=\\frac{5x}{7}+6\\end{aligned}$$",
