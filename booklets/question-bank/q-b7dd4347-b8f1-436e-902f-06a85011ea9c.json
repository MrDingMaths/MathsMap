  "content": {
    "id": "p36-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "$ABCD$ is a cyclic quadrilateral. Its diagonals $AC$ and $BD$ intersect at $P$. Prove that $\\triangle APD$ is similar to $\\triangle BPC$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\triangle APD\\sim\\triangle BPC$ (AA).",
      "worked": "$\\angle PAD=\\angle PBC$ (angles subtended by chord $CD$).\n\n$\\angle ADP=\\angle BCP$ (angles subtended by chord $AB$).\n\nTherefore $\\triangle APD\\sim\\triangle BPC$ (AA), with $A\\leftrightarrow B$, $P\\leftrightarrow P$, $D\\leftrightarrow C$.",
      "solutionDiagrams": []
    },
