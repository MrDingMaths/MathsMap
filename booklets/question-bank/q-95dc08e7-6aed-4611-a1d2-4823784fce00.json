  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "In a football tournament, each of the 12 teams plays every other team once. How many games take place?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "66 games.",
      "worked": "Each game corresponds to one unordered pair of teams.\n$$\\begin{align*}\\binom{12}{2}&=\\frac{12!}{2!10!}\\\\\\binom{12}{2}&=\\frac{12\\times11}{2}\\\\\\binom{12}{2}&=66\\end{align*}$$\nTherefore, 66 games take place.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
