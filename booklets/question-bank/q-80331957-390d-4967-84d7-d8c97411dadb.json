  "content": {
    "id": "p8-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The lines $k$ and $l$ are shown in the diagram. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p8-q12-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"lineBlue\",\"hex\":\"268CFF\",\"reason\":\"distinguishes line k\"},{\"name\":\"lineRed\",\"hex\":\"EF6068\",\"reason\":\"distinguishes line l\"}],\"reference\":\"source page 8 p8-q12-diagram\"}\n\\begin{tikzpicture}[x=0.68cm,y=0.68cm,>=Stealth,font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{lineBlue}{HTML}{268CFF}\n\\definecolor{lineRed}{HTML}{EF6068}\n\\coordinate (A) at (0,4.5);\n\\coordinate (B) at (5,2);\n\\coordinate (C) at (0,-3);\n\\coordinate (P) at (1,4);\n\\coordinate (X) at (3,0);\n\\draw[black,line width=0.5pt,<->] (-1.8,0)--(6.1,0) node[below left] {$x$};\n\\draw[black,line width=0.5pt,<->] (0,-5)--(0,6.2) node[above left] {$y$};\n\\draw[lineBlue,line width=0.8pt,<->] (-1.6,-4.6)--(6.1,3.1);\n\\draw[lineRed,line width=0.8pt,<->] (-1.6,5.3)--(6.1,1.45);\n\\fill[lineRed] (A) circle (1.4pt);\n\\fill[lineRed] (P) circle (1.4pt);\n\\fill[lineBlue] (B) circle (1.4pt);\n\\fill[lineBlue] (C) circle (1.4pt);\n\\fill[lineBlue] (X) circle (1.4pt);\n\\node[black,below left] at (A) {$A$};\n\\node[black,above left] at (B) {$B$};\n\\node[black,above left] at (C) {$C$};\n\\node[black,above right] at (P) {$(1,4)$};\n\\node[black,right] at (B) {$(5,2)$};\n\\node[black,above left] at (-1.3,5.15) {$l$};\n\\node[black,above left] at (6.0,3.0) {$k$};\n\\node[black,below left] at (0,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$0$\\special{dvisvgm:raw </g>}};\n\\node[black,below] at (X) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 8,
          "sourceRegion": "Question 12 shared coordinate diagram",
          "description": "Unnumbered coordinate axes with arrows at both ends, origin labelled 0 and x-intercept labelled 3. Blue line k and red line l have arrows at both ends. A and C identify the y-intercepts without revealing their coordinates. Display bounds provide framing only; the source specifies no numerical axis bounds.",
          "mathematics": "Line k passes through (3,0) and B(5,2). Line l passes through (1,4) and B(5,2). A and C are their respective y-intercepts. No grid or right-angle marker.",
          "answerVisibility": "Only source givens appear: (1,4), (5,2), the x-intercept 3, and point names A, B and C."
        },
