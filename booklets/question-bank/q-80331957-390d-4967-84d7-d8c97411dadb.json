    "children": [
      {
        "id": "p8-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "The equation of line $k$, in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-y-3=0$",
          "worked": "Line $k$ passes through $(3,0)$ and $(5,2)$.\n$$\\begin{align*}m_k&=\\frac{2-0}{5-3}\\\\m_k&=1\\\\y-0&=1(x-3)\\\\y&=x-3\\\\x-y-3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p8-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "The equation of line $l$, in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-9=0$",
          "worked": "Line $l$ passes through $(1,4)$ and $(5,2)$.\n$$\\begin{align*}m_l&=\\frac{2-4}{5-1}\\\\m_l&=-\\frac12\\\\y-4&=-\\frac12(x-1)\\\\2y-8&=-x+1\\\\x+2y-9&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p8-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "The coordinates of point $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,4.5)$",
          "worked": "At the $y$-intercept of line $l$, $x=0$.\n$$\\begin{align*}0+2y-9&=0\\\\2y&=9\\\\y&=4.5\\end{align*}$$\nThus $A=(0,4.5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "The coordinates of point $C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,-3)$",
          "worked": "At the $y$-intercept of line $k$, $x=0$.\n$$\\begin{align*}0-y-3&=0\\\\y&=-3\\end{align*}$$\nThus $C=(0,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "The area of $\\triangle ABC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18.75$ square units",
          "worked": "$AC$ lies on the $y$-axis, so the perpendicular height from $B(5,2)$ is $5$ units.\n$$\\begin{align*}AC&=4.5-(-3)\\\\AC&=7.5\\\\\\text{Area}&=\\frac12\\times7.5\\times5\\\\\\text{Area}&=18.75\\text{ square units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
