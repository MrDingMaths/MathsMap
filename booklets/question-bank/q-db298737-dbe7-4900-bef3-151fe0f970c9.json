  "content": {
    "id": "p55-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the equation of the line that is perpendicular to $y=8x+9$ and passes through $(0,-1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-\\frac18x-1$",
      "worked": "The perpendicular gradient is the negative reciprocal.\n$$\\begin{align*}m_{\\mathrm{orig}}&=8\\\\m_{\\mathrm{perp}}&=-\\frac18\\\\c_{\\mathrm{perp}}&=-1\\\\y&=-\\frac18x-1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
