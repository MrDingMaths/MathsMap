  "content": {
    "id": "v2-83495-p26-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "A fruit bowl contains 4 mandarins, 3 bananas and 2 pears. Two pieces of fruit are selected at random, and the first is not replaced before the second is selected. Find the probability of selecting:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-83495-p26-practice-slot-10-s10-fruit-a",
        "type": "part",
        "label": "a",
        "prompt": "one mandarin and one banana,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{3}$",
          "worked": "Let M mean mandarin and B mean banana. Either order is possible.\n$$\\begin{align*}P(\\text{one mandarin, one banana})&=P(MB)+P(BM)\\\\P(\\text{one mandarin, one banana})&=\\frac{4}{9}\\times\\frac{3}{8}+\\frac{3}{9}\\times\\frac{4}{8}\\\\P(\\text{one mandarin, one banana})&=\\frac{24}{72}\\\\P(\\text{one mandarin, one banana})&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-83495-p26-practice-slot-10-s10-fruit-b",
        "type": "part",
        "label": "b",
        "prompt": "two pieces of the same fruit,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{18}$",
          "worked": "$$\\begin{align*}P(\\text{same fruit})&=P(MM)+P(BB)+P(PP)\\\\P(\\text{same fruit})&=\\frac{4}{9}\\times\\frac{3}{8}+\\frac{3}{9}\\times\\frac{2}{8}+\\frac{2}{9}\\times\\frac{1}{8}\\\\P(\\text{same fruit})&=\\frac{12+6+2}{72}\\\\P(\\text{same fruit})&=\\frac{20}{72}=\\frac{5}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-83495-p26-practice-slot-10-s10-fruit-c",
        "type": "part",
        "label": "c",
        "prompt": "at least one pear.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{12}$",
          "worked": "$$\\begin{align*}P(\\text{at least one pear})&=1-P(\\text{no pear})\\\\P(\\text{at least one pear})&=1-\\frac{7}{9}\\times\\frac{6}{8}\\\\P(\\text{at least one pear})&=1-\\frac{42}{72}\\\\P(\\text{at least one pear})&=\\frac{30}{72}=\\frac{5}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
