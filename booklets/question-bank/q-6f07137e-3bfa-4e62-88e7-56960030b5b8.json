        "diagramPlacement": "right-of-prompt",
        "answer": {
          "short": "$a=\\dfrac{4}{81}$",
          "worked": "$$\\begin{align*}\n\\int_0^3 ax^3\\,dx&=1\\\\\n\\left[\\frac{ax^4}{4}\\right]_0^3&=1\\\\\n\\frac{81a}{4}&=1\\\\\na&=\\frac{4}{81}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q16-b",
        "type": "group",
        "label": "b",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q16-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(1\\le X\\le3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{80}{81}$",
              "worked": "$$\\begin{align*}\nP(1\\le X\\le3)&=\\int_1^3\\frac{4x^3}{81}\\,dx\\\\\nP(1\\le X\\le3)&=\\left[\\frac{x^4}{81}\\right]_1^3\\\\\nP(1\\le X\\le3)&=\\frac{81-1}{81}\\\\\nP(1\\le X\\le3)&=\\frac{80}{81}\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q16-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(X<2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{16}{81}$",
              "worked": "$$\\begin{align*}\nP(X<2)&=\\int_0^2\\frac{4x^3}{81}\\,dx\\\\\nP(X<2)&=\\left[\\frac{x^4}{81}\\right]_0^2\\\\\nP(X<2)&=\\frac{16-0}{81}\\\\\nP(X<2)&=\\frac{16}{81}\n\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
