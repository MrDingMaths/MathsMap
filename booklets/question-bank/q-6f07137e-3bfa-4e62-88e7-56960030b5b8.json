            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"densityBlue\",\"hex\":\"268CFF\",\"reason\":\"probability density curve\"}],\"reference\":\"source page 22 question 16\"}\n\\begin{tikzpicture}[x=1.25cm,y=2.15cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{densityBlue}{HTML}{268CFF}\n\\draw[->,black,line width=0.5pt] (-0.65,0)--(4.25,0) node[right] {$x$};\n\\draw[->,black,line width=0.5pt] (0,-0.35)--(0,1.65) node[above left] {$f(x)$};\n\\draw[densityBlue,line width=0.8pt,domain=0:3,samples=70] plot (\\x,{pow(\\x,3)/20.25});\n\\draw[densityBlue,line width=0.8pt] (3,0)--(3,1.333333);\n\\draw[black,line width=0.4pt] (3,0)--(3,-0.055);\n\\node[below] at (3,-0.055) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$3$\\special{dvisvgm:raw </g>}};\n\\node[above left] at (2.25,0.5625) {$y=ax^3$};\n\\end{tikzpicture}",
            "src": null,
