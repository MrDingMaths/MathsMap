  "content": {
    "id": "p12-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "When multiplying two polynomials, $P(x)$ and $Q(x)$, the degree of the resulting product $P(x)Q(x)$ will be the sum of the degrees of $P(x)$ and $Q(x)$. Explain why this is true.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The leading terms multiply, and their powers add. Their product has the highest power and a nonzero coefficient.",
      "worked": "If the leading terms are $ax^m$ and $bx^n$, their product is $abx^{m+n}$ by the index law of multiplication. Since $a$ and $b$ are nonzero, $ab$ is nonzero. Every other product of terms has lower degree, so the degree of $P(x)Q(x)$ is $m+n$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
