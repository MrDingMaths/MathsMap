  "content": {
    "id": "p31-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Given $\\underset{\\sim}{a}=\\begin{pmatrix}7\\\\-4\\end{pmatrix}$ and $\\underset{\\sim}{b}=\\begin{pmatrix}12\\\\6\\end{pmatrix}$, find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}4\\\\2\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac{\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}}{|\\underset{\\sim}{b}|^2}\\underset{\\sim}{b}\\\\\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=7(12)+(-4)(6)=60\\\\|\\underset{\\sim}{b}|^2&=144+36=180\\\\\\operatorname{proj}_{\\underset{\\sim}{b}}\\underset{\\sim}{a}&=\\frac{60}{180}\\begin{pmatrix}12\\\\6\\end{pmatrix}=\\begin{pmatrix}4\\\\2\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p31-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\operatorname{proj}_{\\underset{\\sim}{a}}\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{60}{65}\\begin{pmatrix}7\\\\-4\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\operatorname{proj}_{\\underset{\\sim}{a}}\\underset{\\sim}{b}&=\\frac{\\underset{\\sim}{b}\\cdot\\underset{\\sim}{a}}{|\\underset{\\sim}{a}|^2}\\underset{\\sim}{a}\\\\|\\underset{\\sim}{a}|^2&=49+16=65\\\\\\operatorname{proj}_{\\underset{\\sim}{a}}\\underset{\\sim}{b}&=\\frac{60}{65}\\begin{pmatrix}7\\\\-4\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
