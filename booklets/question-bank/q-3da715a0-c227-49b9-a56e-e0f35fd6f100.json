  "content": {
    "id": "v2-1f1e9-p35-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "Find each indefinite integral using the given substitution.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1f1e9-p35-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{1}{(x-1)\\sqrt{x-2}}\\,dx,\\quad u=\\sqrt{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\tan^{-1}\\sqrt{x-2}+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{1}{(x-1)\\sqrt{x-2}}\\,dx&=\\int\\frac{2u}{(u^2+1)u}\\,du\\\\&=2\\int\\frac{1}{u^2+1}\\,du\\\\&=2\\tan^{-1}u+C\\\\&=2\\tan^{-1}\\sqrt{x-2}+C\\end{aligned}$$\n$$\\begin{aligned}u&=\\sqrt{x-2}\\\\u^2&=x-2\\\\x&=u^2+2\\\\x-1&=u^2+1\\\\\\frac{dx}{du}&=2u\\\\dx&=2u\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "v2-1f1e9-p35-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{x}{\\sqrt{2x+1}}\\,dx,\\quad u=\\sqrt{2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(2x+1)^{3/2}}{6}-\\dfrac{\\sqrt{2x+1}}{2}+C$, which equals $\\dfrac{(x-1)\\sqrt{2x+1}}{3}+C$",
          "worked": "$$\\begin{aligned}\\int\\frac{x}{\\sqrt{2x+1}}\\,dx&=\\int\\frac{u^2-1}{2u}\\cdot u\\,du\\\\&=\\frac12\\int(u^2-1)\\,du\\\\&=\\frac12\\left(\\frac{u^3}{3}-u\\right)+C\\\\&=\\frac{(2x+1)^{3/2}}{6}-\\frac{\\sqrt{2x+1}}{2}+C\\end{aligned}$$\n$$\\begin{aligned}u&=\\sqrt{2x+1}\\\\u^2&=2x+1\\\\x&=\\frac{u^2-1}{2}\\\\\\frac{dx}{du}&=u\\\\dx&=u\\,du\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
