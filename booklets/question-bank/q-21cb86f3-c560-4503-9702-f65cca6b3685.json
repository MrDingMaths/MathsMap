    "children": [
      {
        "id": "v2-783a5-p12-practice-slot-3-lower-slot-3-lower-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\sin^2\\theta=\\dfrac{1-\\cos2\\theta}{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos2\\theta=1-2\\sin^2\\theta$, so $\\sin^2\\theta=\\dfrac{1-\\cos2\\theta}{2}$.",
          "worked": "$$\\begin{align*}\\cos2\\theta&=1-2\\sin^2\\theta\\\\2\\sin^2\\theta&=1-\\cos2\\theta\\\\\\sin^2\\theta&=\\frac{1-\\cos2\\theta}{2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-783a5-p12-practice-slot-3-lower-slot-3-lower-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the exact value of $\\sin\\dfrac{\\pi}{8}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{2-\\sqrt2}}{2}$",
          "worked": "Let $\\theta=\\dfrac{\\pi}{8}$.\n$$\\begin{align*}\\sin^2\\frac{\\pi}{8}&=\\frac{1-\\cos\\frac{\\pi}{4}}{2}\\\\&=\\frac{1-\\frac1{\\sqrt2}}{2}\\\\&=\\frac{\\sqrt2-1}{2\\sqrt2}\\\\&=\\frac{2-\\sqrt2}{4}.\\end{align*}$$\nSince $\\dfrac{\\pi}{8}$ is in the first quadrant, $\\sin\\dfrac{\\pi}{8}>0$. Therefore $\\sin\\dfrac{\\pi}{8}=\\dfrac{\\sqrt{2-\\sqrt2}}{2}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
