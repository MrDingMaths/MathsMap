      },
      {
        "id": "p27-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "five bruised fingers on two hands",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{10}=\\frac{1}{2}$",
          "worked": "Two hands have 10 fingers, including thumbs. Five are bruised.\n$$\\begin{align*}\\frac{5}{10}&=\\frac{5\\div5}{10\\div5}\\\\\\frac{5}{10}&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p27-q2-d",
