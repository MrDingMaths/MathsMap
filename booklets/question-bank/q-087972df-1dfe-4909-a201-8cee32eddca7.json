        "type": "part",
        "label": "a",
        "prompt": "three weeks in December",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{31}$",
          "worked": "Three weeks contain $3\\times7=21$ days. December contains 31 days, so the fraction is $\\frac{21}{31}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p27-q2-b",
        "type": "part",
