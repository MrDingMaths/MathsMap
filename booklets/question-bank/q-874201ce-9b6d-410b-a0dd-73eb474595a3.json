    "label": null,
    "prompt": "The surface area of this rectangular prism is $558\\text{ cm}^2$. Work out the length of its longest edge.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "v2-5021a0-p9-practice-slot-7-slot-7-q-diagram",
        "role": "question",
        "format": "tikz",
        "code": "\\begin{tikzpicture}[x=1cm,y=1cm,line join=round,font=\\fontsize{10}{12}\\selectfont]\n\\coordinate (A) at (0,0);\\coordinate (B) at (3,0.4);\\coordinate (C) at (3,1.6);\\coordinate (D) at (0,1.2);\\coordinate (E) at (-1.8,0.95);\\coordinate (H) at (-1.8,2.15);\\coordinate (G) at (1.2,2.55);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--(D)--cycle (E)--(A) (E)--(H)--(D) (H)--(G)--(C);\n\\draw[black,line width=0.4pt,<->] (-1.85,0.7)--(-0.05,-0.25) node[midway,below left] {$3x\\text{ cm}$};\n\\draw[black,line width=0.4pt,<->] (0,-0.28)--(3,0.12) node[midway,below] {$5x\\text{ cm}$};\n\\draw[black,line width=0.4pt,<->] (3.28,0.4)--(3.28,1.6) node[midway,right] {$2x\\text{ cm}$};\n\\end{tikzpicture}",
