        "label": "a",
        "prompt": "When is the particle at rest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=0,\\ t_2,\\ t_4,\\ t_6$.",
          "worked": "The particle is at rest when $v=0$. The graph meets the time axis at $t=0,\\ t_2,\\ t_4$ and $t_6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "When is the acceleration zero?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=t_1,\\ t_3,\\ t_5$.",
          "worked": "Acceleration is the gradient of the velocity–time graph: $a=\\dfrac{dv}{dt}$. The gradient is zero at the turning points, $t=t_1,\\ t_3$ and $t_5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "For $0\\leq t\\leq t_6$, when is the speed the greatest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=t_5$.",
          "worked": "Speed is $|v|$, the vertical distance from the velocity graph to the time axis. On $0\\leq t\\leq t_6$, this distance is greatest at $t=t_5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p22-q11-d",
        "type": "group",
        "label": "d",
        "prompt": "Describe the motion of the particle at:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q11-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$t_2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Momentarily at rest and changing from the positive to the negative direction.",
              "worked": "At $t_2$, $v=0$. Immediately before $t_2$, $v>0$, and immediately after it, $v<0$. The particle stops momentarily and reverses from the positive to the negative direction.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          },
          {
            "id": "p22-q11-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$t_3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Moving in the negative direction with zero acceleration; its speed is at a local maximum.",
              "worked": "At $t_3$, $v<0$, so the particle moves in the negative direction. The velocity graph has a horizontal tangent, so $a=0$. Its speed increases before $t_3$ and decreases after it, giving a local maximum speed.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 26
          }
        ]
      }
