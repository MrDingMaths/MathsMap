  "content": {
    "id": "p3-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "One token is drawn from a bag containing one red, one blue and one green token and the outcome is recorded.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the sample space.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Omega=\\{R,B,G\\}$.",
          "worked": "Let $R$, $B$ and $G$ denote red, blue and green respectively. The possible outcomes are\n$$\\Omega=\\{R,B,G\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p3-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Recall that an event is any subset of the sample space. There are eight events. List them.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\varnothing$, $\\{R\\}$, $\\{B\\}$, $\\{G\\}$, $\\{R,B\\}$, $\\{R,G\\}$, $\\{B,G\\}$, $\\{R,B,G\\}$.",
          "worked": "List the subsets by their number of elements:\n\nNo elements: $\\varnothing$.\n\nOne element: $\\{R\\}$, $\\{B\\}$, $\\{G\\}$.\n\nTwo elements: $\\{R,B\\}$, $\\{R,G\\}$, $\\{B,G\\}$.\n\nThree elements: $\\{R,B,G\\}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p3-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the probability corresponding to each of these events.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\Pr(\\varnothing)=0$.\n\n$\\Pr(\\{R\\})=\\Pr(\\{B\\})=\\Pr(\\{G\\})=\\frac13$.\n\n$\\Pr(\\{R,B\\})=\\Pr(\\{R,G\\})=\\Pr(\\{B,G\\})=\\frac23$.\n\n$\\Pr(\\{R,B,G\\})=1$.",
          "worked": "The three outcomes are equally likely, so $\\Pr(E)=\\frac{n(E)}{3}$.\n$$\\begin{align*}\n\\Pr(\\varnothing)&=\\frac03=0\\\\\n\\Pr(\\{R\\})&=\\frac13\\\\\n\\Pr(\\{B\\})&=\\frac13\\\\\n\\Pr(\\{G\\})&=\\frac13\\\\\n\\Pr(\\{R,B\\})&=\\frac23\\\\\n\\Pr(\\{R,G\\})&=\\frac23\\\\\n\\Pr(\\{B,G\\})&=\\frac23\\\\\n\\Pr(\\{R,B,G\\})&=\\frac33=1.\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
