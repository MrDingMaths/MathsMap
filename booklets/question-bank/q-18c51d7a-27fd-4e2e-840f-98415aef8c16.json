    "children": [
      {
        "id": "p23-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $\\tan^2x$ in terms of $\\sec^2x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan^2x=\\sec^2x-1$",
          "worked": "$$\\begin{aligned}\\sec^2x&=1+\\tan^2x\\\\\\tan^2x&=\\sec^2x-1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p23-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "The region bounded by the curve $y=\\tan x$, the $x$-axis and the vertical line $x=\\frac{\\pi}{3}$ is rotated about the $x$-axis. Find the volume of the solid generated.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pi\\left(\\sqrt3-\\frac{\\pi}{3}\\right)\\text{ units}^3$",
          "worked": "$$\\begin{aligned}V&=\\pi\\int_0^{\\pi/3}\\tan^2x\\,dx\\\\V&=\\pi\\int_0^{\\pi/3}(\\sec^2x-1)\\,dx\\\\V&=\\pi[\\tan x-x]_0^{\\pi/3}\\\\V&=\\pi\\left(\\sqrt3-\\frac{\\pi}{3}\\right)\\text{ units}^3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
