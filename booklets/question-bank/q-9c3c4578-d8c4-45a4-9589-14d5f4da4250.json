  "content": {
    "id": "p40-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Find the following indefinite integrals, where $a$, $b$, $u$ and $v$ are constants and $u\\ne0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int a\\sin(ax+b)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cos(ax+b)+C$",
          "worked": "$$\\begin{align*}\\int a\\sin(ax+b)\\,dx&=-\\cos(ax+b)+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p40-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\pi^2\\cos\\pi x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pi\\sin\\pi x+C$",
          "worked": "$$\\begin{align*}\\int\\pi^2\\cos\\pi x\\,dx&=\\pi^2\\left(\\frac1\\pi\\right)\\sin\\pi x+C\\\\&=\\pi\\sin\\pi x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p40-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac1u\\sec^2(v+ux)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{u^2}\\tan(v+ux)+C$",
          "worked": "$$\\begin{align*}\\int\\frac1u\\sec^2(v+ux)\\,dx&=\\frac1u\\cdot\\frac1u\\tan(v+ux)+C\\\\&=\\frac1{u^2}\\tan(v+ux)+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p40-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{a}{\\cos^2 ax}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan ax+C$",
          "worked": "$$\\begin{align*}\\int\\frac{a}{\\cos^2 ax}\\,dx&=\\int a\\sec^2 ax\\,dx\\\\&=\\tan ax+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
