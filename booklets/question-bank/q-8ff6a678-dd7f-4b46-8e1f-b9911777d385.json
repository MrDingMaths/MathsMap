      {
        "id": "p42-q51-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $x+1,\\ 2x+4,\\ 3x+7,\\ldots$ are the first 3 terms in an arithmetic sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both successive differences are $x+3$, so the sequence is arithmetic with $d=x+3$.",
          "worked": "$$\\begin{align*}(2x+4)-(x+1)&=x+3\\\\(3x+7)-(2x+4)&=x+3\\end{align*}$$\nThe successive differences are equal, so the sequence is an AP with common difference $d=x+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p42-q51-b",
        "type": "part",
        "label": "b",
        "prompt": "Find an expression for the sum of the first 50 terms of the sequence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25(51x+149)$",
          "worked": "$a=x+1$, $d=x+3$.\n$$\\begin{align*}S_{50}&=\\frac{50}{2}[2a+49d]\\\\S_{50}&=25[2(x+1)+49(x+3)]\\\\S_{50}&=25[2x+2+49x+147]\\\\S_{50}&=25[51x+149]\\\\S_{50}&=25(51x+149)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
