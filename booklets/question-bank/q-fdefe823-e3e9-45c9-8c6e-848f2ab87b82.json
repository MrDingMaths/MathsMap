      {
        "id": "v2-2e5df0-p5-practice-j2-034347-j2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=(a+2)x^3+x^2-5x+1$ has degree 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2$.",
          "worked": "The degree is 2, so the coefficient of $x^3$ is zero.\n$$\\begin{align*}a+2&=0\\\\a&=-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-2e5df0-p5-practice-j2-034347-j2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=(2b-3)x^2+x-5$ is monic.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=2$.",
          "worked": "Since $P(x)$ is monic, the coefficient of $x^2$ is 1.\n$$\\begin{align*}2b-3&=1\\\\2b&=4\\\\b&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
