    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sqrt{e^{5x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{5\\sqrt{e^{5x}}}{2}$",
          "worked": "$$\\begin{align*}y&=e^{5x/2}\\\\y'&=\\frac52e^{5x/2}\\\\&=\\frac{5\\sqrt{e^{5x}}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\sqrt[3]{e^{2x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2\\sqrt[3]{e^{2x}}}{3}$",
          "worked": "$$\\begin{align*}y&=e^{2x/3}\\\\y'&=\\frac23e^{2x/3}\\\\&=\\frac{2\\sqrt[3]{e^{2x}}}3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac1{\\sqrt{e^{3x}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac3{2\\sqrt{e^{3x}}}$",
          "worked": "$$\\begin{align*}y&=e^{-3x/2}\\\\y'&=-\\frac32e^{-3x/2}\\\\&=-\\frac3{2\\sqrt{e^{3x}}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\dfrac1{\\sqrt[3]{e^{4x}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac4{3\\sqrt[3]{e^{4x}}}$",
          "worked": "$$\\begin{align*}y&=e^{-4x/3}\\\\y'&=-\\frac43e^{-4x/3}\\\\&=-\\frac4{3\\sqrt[3]{e^{4x}}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p19-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$e^{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{e^{\\sqrt{x}}}{2\\sqrt{x}}$",
          "worked": "$$\\begin{align*}y'&=e^{\\sqrt{x}}\\cdot\\frac1{2\\sqrt{x}}\\\\&=\\frac{e^{\\sqrt{x}}}{2\\sqrt{x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$e^{-\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{e^{-\\sqrt{x}}}{2\\sqrt{x}}$",
          "worked": "$$\\begin{align*}y'&=e^{-\\sqrt{x}}\\left(-\\frac1{2\\sqrt{x}}\\right)\\\\&=-\\frac{e^{-\\sqrt{x}}}{2\\sqrt{x}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$e^{1/x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\dfrac{e^{1/x}}{x^2}$",
          "worked": "$$\\begin{align*}y'&=e^{1/x}(-x^{-2})\\\\&=-\\frac{e^{1/x}}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$e^{-1/x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{e^{-1/x}}{x^2}$",
          "worked": "$$\\begin{align*}y'&=e^{-1/x}(x^{-2})\\\\&=\\frac{e^{-1/x}}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
