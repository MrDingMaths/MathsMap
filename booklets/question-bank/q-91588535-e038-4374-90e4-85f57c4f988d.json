    "children": [
      {
        "id": "p21-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\pi^{2},\\quad y'=2\\times\\pi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. $\\pi^{2}$ is constant, so $y'=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=x^{\\pi},\\quad y'=\\pi\\times x^{\\pi-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $\\pi$ is a constant exponent, so the power rule gives $y'=\\pi x^{\\pi-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=2^{x},\\quad y'=x\\times2^{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The power rule applies to $x$ raised to a constant exponent; here the exponent is $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x^{x},\\quad y'=x\\times x^{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "False. The exponent $x$ varies, so the stated constant-exponent power rule does not apply.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^{\\sqrt{2}},\\quad y'=\\sqrt{2}\\times x^{\\sqrt{2}-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. $\\sqrt{2}$ is a real constant, so $y'=\\sqrt{2}x^{\\sqrt{2}-1}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      },
      {
        "id": "p21-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=x^{\\frac{1}{\\sqrt{2}-1}},\\quad y'=(\\sqrt{2}+1)x^{\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "True. Since $\\frac{1}{\\sqrt{2}-1}=\\sqrt{2}+1$, the power rule gives $y'=(\\sqrt{2}+1)x^{\\sqrt{2}}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 6
      }
    ]
  },
