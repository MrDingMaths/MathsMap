  "content": {
    "id": "p28-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "How many subsets of $\\{1,2,3,4,5,6,7\\}$ contain at least one even number?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$112$",
      "worked": "There are $2^7$ subsets in total. Subsets containing no even numbers use only $\\{1,3,5,7\\}$, so there are $2^4$ of these, including the empty set.\n\n$$\\begin{align*}N&=2^7-2^4\\\\N&=128-16\\\\N&=112.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
