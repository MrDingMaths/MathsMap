  "content": {
    "id": "p20-q27-response",
    "type": "question",
    "label": "27",
    "prompt": "The product of the ages of Sally and Joey now is 175 more than the product of their ages 5 years prior. If Sally is 20 years older than Joey, what are their current ages?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Joey is 10 years old and Sally is 30 years old. Use $S=J+20$ and $SJ=175+(S-5)(J-5)$.",
      "worked": "Let $J$ and $S$ be Joey's and Sally's current ages in years.\n$$\\begin{align*}S&=J+20\\\\SJ&=175+(S-5)(J-5)\\\\J(J+20)&=175+(J+15)(J-5)\\\\J^2+20J&=175+J^2+10J-75\\\\10J&=100\\\\J&=10\\\\S&=10+20=30\\end{align*}$$\nJoey is 10 years old and Sally is 30 years old.\nCheck: their current product is $30\\times10=300$ and their product five years ago was $25\\times5=125$. The difference is $300-125=175$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 70
  },
