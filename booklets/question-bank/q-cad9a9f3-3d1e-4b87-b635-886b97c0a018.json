  "content": {
    "id": "p20-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Write down the range of the following, using interval notation.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-3,3]$.",
          "worked": "Since $-1\\leq\\cos x\\leq1$, multiplying by $3$ gives $-3\\leq3\\cos x\\leq3$. Thus $y\\in[-3,3]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=-4\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-4,4]$.",
          "worked": "Since $\\sin x\\in[-1,1]$, multiplication by $-4$ gives the endpoint values $4$ and $-4$. Thus $y\\in[-4,4]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=5\\tan x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in(-\\infty,\\infty)$.",
          "worked": "Tangent takes every real value. Multiplication by $5$ preserves this range, so $y\\in(-\\infty,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p20-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=2-3\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-1,5]$.",
          "worked": "Since $\\cos x\\in[-1,1]$, we have $-3\\cos x\\in[-3,3]$. Adding $2$ gives $y\\in[-1,5]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=-2+6\\sin x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-8,4]$.",
          "worked": "Since $\\sin x\\in[-1,1]$, we have $6\\sin x\\in[-6,6]$. Subtracting $2$ gives $y\\in[-8,4]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p20-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=-4-4\\cos x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\in[-8,0]$.",
          "worked": "Since $\\cos x\\in[-1,1]$, we have $-4\\cos x\\in[-4,4]$. Subtracting $4$ gives $y\\in[-8,0]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
