    "type": "question",
    "label": "3",
    "prompt": "Find $f(3)$ and $f(-2)$ for each function.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^2+4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(3)=21$, $f(-2)=-4$.",
          "worked": "$$\\begin{align*}f(3)&=3^2+4\\times3\\\\f(3)&=9+12\\\\f(3)&=21\\end{align*}$$\n$$\\begin{align*}f(-2)&=(-2)^2+4\\times(-2)\\\\f(-2)&=4-8\\\\f(-2)&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p58-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^3-3x^2+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(3)=5$, $f(-2)=-15$.",
          "worked": "$$\\begin{align*}f(3)&=3^3-3\\times3^2+5\\\\f(3)&=27-27+5\\\\f(3)&=5\\end{align*}$$\n$$\\begin{align*}f(-2)&=(-2)^3-3\\times(-2)^2+5\\\\f(-2)&=-8-12+5\\\\f(-2)&=-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
