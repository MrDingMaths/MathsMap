        "id": "p31-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\frac35-\\frac12}{\\frac45}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac18$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac35-\\frac12}{\\frac45}&=\\left(\\frac6{10}-\\frac5{10}\\right)\\div\\frac45\\\\\\dfrac{\\frac35-\\frac12}{\\frac45}&=\\frac1{10}\\times\\frac54\\\\\\dfrac{\\frac35-\\frac12}{\\frac45}&=\\frac18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p31-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\frac6{11}-\\frac13}{\\frac79}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac3{11}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac6{11}-\\frac13}{\\frac79}&=\\left(\\frac{18}{33}-\\frac{11}{33}\\right)\\div\\frac79\\\\\\dfrac{\\frac6{11}-\\frac13}{\\frac79}&=\\frac7{33}\\times\\frac97\\\\\\dfrac{\\frac6{11}-\\frac13}{\\frac79}&=\\frac3{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p31-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\frac58}{3\\frac12-1\\frac14}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac5{18}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac58}{3\\frac12-1\\frac14}&=\\frac58\\div\\left(\\frac{14}4-\\frac54\\right)\\\\\\dfrac{\\frac58}{3\\frac12-1\\frac14}&=\\frac58\\div\\frac94\\\\\\dfrac{\\frac58}{3\\frac12-1\\frac14}&=\\frac58\\times\\frac49\\\\\\dfrac{\\frac58}{3\\frac12-1\\frac14}&=\\frac5{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p31-q23-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\frac7{11}}{2\\frac23-1\\frac12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac6{11}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac7{11}}{2\\frac23-1\\frac12}&=\\frac7{11}\\div\\left(\\frac{16}6-\\frac96\\right)\\\\\\dfrac{\\frac7{11}}{2\\frac23-1\\frac12}&=\\frac7{11}\\div\\frac76\\\\\\dfrac{\\frac7{11}}{2\\frac23-1\\frac12}&=\\frac7{11}\\times\\frac67\\\\\\dfrac{\\frac7{11}}{2\\frac23-1\\frac12}&=\\frac6{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p31-q23-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{\\frac58-\\frac13}{\\frac58+\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac7{23}$",
          "worked": "$$\\begin{align*}\\dfrac{\\frac58-\\frac13}{\\frac58+\\frac13}&=\\dfrac{\\frac{15}{24}-\\frac8{24}}{\\frac{15}{24}+\\frac8{24}}\\\\\\dfrac{\\frac58-\\frac13}{\\frac58+\\frac13}&=\\frac7{24}\\div\\frac{23}{24}\\\\\\dfrac{\\frac58-\\frac13}{\\frac58+\\frac13}&=\\frac7{24}\\times\\frac{24}{23}\\\\\\dfrac{\\frac58-\\frac13}{\\frac58+\\frac13}&=\\frac7{23}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p31-q23-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{5\\frac49}{2\\frac13+5\\frac13}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{49}{69}$",
          "worked": "$$\\begin{align*}\\dfrac{5\\frac49}{2\\frac13+5\\frac13}&=\\frac{49}9\\div\\left(\\frac73+\\frac{16}3\\right)\\\\\\dfrac{5\\frac49}{2\\frac13+5\\frac13}&=\\frac{49}9\\div\\frac{23}3\\\\\\dfrac{5\\frac49}{2\\frac13+5\\frac13}&=\\frac{49}9\\times\\frac3{23}\\\\\\dfrac{5\\frac49}{2\\frac13+5\\frac13}&=\\frac{49}{69}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p31-q23-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\frac12+\\frac34+\\frac56}{\\frac23+\\frac14+\\frac76}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$\n\nThe numerator and denominator both equal $\\frac{25}{12}$.",
          "worked": "$$\\begin{align*}\\dfrac{\\frac12+\\frac34+\\frac56}{\\frac23+\\frac14+\\frac76}&=\\dfrac{\\frac6{12}+\\frac9{12}+\\frac{10}{12}}{\\frac8{12}+\\frac3{12}+\\frac{14}{12}}\\\\\\dfrac{\\frac12+\\frac34+\\frac56}{\\frac23+\\frac14+\\frac76}&=\\frac{25}{12}\\div\\frac{25}{12}\\\\\\dfrac{\\frac12+\\frac34+\\frac56}{\\frac23+\\frac14+\\frac76}&=\\frac{25}{12}\\times\\frac{12}{25}\\\\\\dfrac{\\frac12+\\frac34+\\frac56}{\\frac23+\\frac14+\\frac76}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p31-q23-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{3\\frac14-2\\frac35}{3\\frac14-2\\frac35}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$\n\nThe numerator and denominator both equal $\\frac{13}{20}$.",
          "worked": "$$\\begin{align*}\\dfrac{3\\frac14-2\\frac35}{3\\frac14-2\\frac35}&=\\dfrac{\\frac{65}{20}-\\frac{52}{20}}{\\frac{65}{20}-\\frac{52}{20}}\\\\\\dfrac{3\\frac14-2\\frac35}{3\\frac14-2\\frac35}&=\\frac{13}{20}\\div\\frac{13}{20}\\\\\\dfrac{3\\frac14-2\\frac35}{3\\frac14-2\\frac35}&=\\frac{13}{20}\\times\\frac{20}{13}\\\\\\dfrac{3\\frac14-2\\frac35}{3\\frac14-2\\frac35}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
