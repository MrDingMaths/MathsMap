        "type": "part",
        "label": "a",
        "prompt": "Explain why $\\frac{3^{2}}{3^{2}}$ $= 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Anything divided by itself is 1",
          "worked": "$3^2=9$, so $\\frac{3^2}{3^2}=\\frac99=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "index-t4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Using your answer to part a, explain why $3^{0} = 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "dependsOn": [
          "index-t4-q2-a"
        ],
        "answer": {
          "short": "$3^{2} \\div 3^{2} = 3^{0} = 1$",
          "worked": "From part a, $\\frac{3^2}{3^2}=1$. The division law also gives $\\frac{3^2}{3^2}=3^{2-2}=3^0$, so $3^0=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
