  "content": {
    "id": "p44-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Write each expression in terms of $\\log_a x$, $\\log_a y$ and $\\log_a z$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a xyz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a x+\\log_a y+\\log_a z$",
          "worked": "$$\\begin{align*}\\log_a xyz&=\\log_a x+\\log_a(yz)\\\\\\log_a xyz&=\\log_a x+\\log_a y+\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p44-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac{x}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_a x-\\log_a y$",
          "worked": "By the quotient law,\n$$\\log_a\\frac{x}{y}=\\log_a x-\\log_a y.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p44-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\log_a x$",
          "worked": "By the power law,\n$$\\log_a x^3=3\\log_a x.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p44-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\frac{1}{z^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\log_a z$",
          "worked": "$$\\begin{align*}\\log_a\\frac{1}{z^2}&=\\log_a z^{-2}\\\\\\log_a\\frac{1}{z^2}&=-2\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p44-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a x^2y^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_a x+5\\log_a y$",
          "worked": "$$\\begin{align*}\\log_a x^2y^5&=\\log_a x^2+\\log_a y^5\\\\\\log_a x^2y^5&=2\\log_a x+5\\log_a y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p44-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a\\frac{y^2}{xz^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_a y-\\log_a x-2\\log_a z$",
          "worked": "$$\\begin{align*}\\log_a\\frac{y^2}{xz^2}&=\\log_a y^2-\\log_a(xz^2)\\\\\\log_a\\frac{y^2}{xz^2}&=2\\log_a y-\\log_a x-\\log_a z^2\\\\\\log_a\\frac{y^2}{xz^2}&=2\\log_a y-\\log_a x-2\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p44-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_a\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_a x$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt{x}&=\\log_a x^{1/2}\\\\\\log_a\\sqrt{x}&=\\frac12\\log_a x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p44-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\sqrt{xyz}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12\\log_a x+\\frac12\\log_a y+\\frac12\\log_a z$",
          "worked": "$$\\begin{align*}\\log_a\\sqrt{xyz}&=\\log_a(xyz)^{1/2}\\\\\\log_a\\sqrt{xyz}&=\\frac12\\log_a(xyz)\\\\\\log_a\\sqrt{xyz}&=\\frac12\\log_a x+\\frac12\\log_a y+\\frac12\\log_a z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
