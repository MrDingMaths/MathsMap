    "type": "question",
    "label": null,
    "prompt": "Without using a calculator, decide which is greater: $15\\%$ of $360$ or $12.5\\%$ of $400$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$15\\%$ of $360$ is greater (54 compared with 50).",
      "worked": "$$\\begin{align*}10\\%\\text{ of }360&=360\\div10=36\\\\5\\%\\text{ of }360&=36\\div2=18\\\\15\\%\\text{ of }360&=36+18=54\\\\25\\%\\text{ of }400&=400\\div4=100\\\\12.5\\%\\text{ of }400&=100\\div2=50\\end{align*}$$\n$54>50$, so $15\\%$ of $360$ is greater.",
      "solutionDiagrams": []
    },
