  "content": {
    "id": "p7-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "An empty plastic box has mass 750 g. It is packed with 8 bottles of drink, each of mass 1.25 kg. Calculate the total mass (in g) of the packed box.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$10\\,750\\text{ g}$",
      "worked": "$$\\begin{align*}\\text{Mass of one bottle}&=1.25\\times1000\\text{ g}=1250\\text{ g}\\\\\\text{Mass of eight bottles}&=8\\times1250\\text{ g}=10\\,000\\text{ g}\\\\\\text{Mass of packed box}&=(10\\,000+750)\\text{ g}=10\\,750\\text{ g}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 22
  },
