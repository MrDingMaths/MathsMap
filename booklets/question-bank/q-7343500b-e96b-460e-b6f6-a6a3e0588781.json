  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The point $M$ is the midpoint of the interval $AB$. Find the coordinates of $B$ given that the coordinates of $A$ and $M$ are:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$A(1,6)$ and $M(10,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(19,6)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{x+1}{2}&=10 & \\frac{y+6}{2}&=6\\\\ x+1&=20 & y+6&=12\\\\ x&=19 & y&=6.\\end{align*}$$\nThus $B=(19,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$A(1,6)$ and $M(-10,6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(-21,6)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{x+1}{2}&=-10 & \\frac{y+6}{2}&=6\\\\ x+1&=-20 & y+6&=12\\\\ x&=-21 & y&=6.\\end{align*}$$\nThus $B=(-21,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$A(-1,4)$ and $M(-3,2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(-5,0)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{x+(-1)}{2}&=-3 & \\frac{y+4}{2}&=2\\\\ x-1&=-6 & y+4&=4\\\\ x&=-5 & y&=0.\\end{align*}$$\nThus $B=(-5,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$A(2,-6)$ and $M(1,8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(0,22)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{x+2}{2}&=1 & \\frac{y+(-6)}{2}&=8\\\\ x+2&=2 & y-6&=16\\\\ x&=0 & y&=22.\\end{align*}$$\nThus $B=(0,22)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$A(3,-1)$ and $M(-2,10)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$B(-7,21)$",
          "worked": "Let $B=(x,y)$. Using the midpoint formula,\n$$\\begin{align*}\\frac{x+3}{2}&=-2 & \\frac{y+(-1)}{2}&=10\\\\ x+3&=-4 & y-1&=20\\\\ x&=-7 & y&=21.\\end{align*}$$\nThus $B=(-7,21)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
