  "content": {
    "id": "p13-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A rectangle has length $15\\text{ cm}$ and width $6\\text{ cm}$. A second rectangle has length $18\\text{ cm}$ and width $24\\text{ cm}$. Find the ratio of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the lengths of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5:6$",
          "worked": "$$\\begin{align*}\\text{First length : second length}&=15:18\\\\\\text{First length : second length}&=5:6\\end{align*}$$\nDivide both terms by $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the widths of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:4$",
          "worked": "$$\\begin{align*}\\text{First width : second width}&=6:24\\\\\\text{First width : second width}&=1:4\\end{align*}$$\nDivide both terms by $6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "the perimeters of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:2$\n\nCalculate each perimeter using $2(l+w)$, then simplify their ratio.",
          "worked": "$$\\begin{align*}P_1&=2(15+6)\\text{ cm}\\\\P_1&=42\\text{ cm}\\\\P_2&=2(18+24)\\text{ cm}\\\\P_2&=84\\text{ cm}\\\\P_1:P_2&=42:84\\\\P_1:P_2&=1:2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p13-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "the areas of the rectangles",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5:24$\n\nCalculate each area using $l\\times w$, then simplify their ratio.",
          "worked": "$$\\begin{align*}A_1&=15\\times6\\text{ cm}^2\\\\A_1&=90\\text{ cm}^2\\\\A_2&=18\\times24\\text{ cm}^2\\\\A_2&=432\\text{ cm}^2\\\\A_1:A_2&=90:432\\\\A_1:A_2&=5:24\\end{align*}$$\nDivide both terms of $90:432$ by $18$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
