  "content": {
    "id": "p16-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Determine the centre and radius of these circles by completing the square, if necessary.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)^2+y^2=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-1,0)$; radius $2$.",
          "worked": "Comparing with $(x-a)^2+(y-b)^2=r^2$, the centre is $(-1,0)$ and $r=\\sqrt{4}=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)^2+(y-2)^2=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(1,2)$; radius $1$.",
          "worked": "Comparing with $(x-a)^2+(y-b)^2=r^2$, the centre is $(1,2)$ and $r=\\sqrt{1}=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p16-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-10x+y^2=-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(5,0)$; radius $3$.",
          "worked": "$$\\begin{align*}(x^2-10x+25)-25+y^2&=-16\\\\(x-5)^2+y^2-25&=-16\\\\(x-5)^2+y^2&=9\\end{align*}$$\nCentre $(5,0)$; radius $\\sqrt{9}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+y^2+14x=33$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-7,0)$; radius $\\sqrt{82}$.",
          "worked": "$$\\begin{align*}(x^2+14x+49)-49+y^2&=33\\\\(x+7)^2+y^2-49&=33\\\\(x+7)^2+y^2&=82\\end{align*}$$\nCentre $(-7,0)$; radius $\\sqrt{82}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p16-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2-2x+y^2-4y-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(1,2)$; radius $3$.",
          "worked": "$$\\begin{align*}&(x^2-2x+1)-1+(y^2-4y+4)-4-4=0\\\\&(x-1)^2+(y-2)^2-9=0\\\\&(x-1)^2+(y-2)^2=9\\end{align*}$$\nCentre $(1,2)$; radius $\\sqrt{9}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x^2+6x+y^2-8y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-3,4)$; radius $5$.",
          "worked": "$$\\begin{align*}&(x^2+6x+9)-9+(y^2-8y+16)-16=0\\\\&(x+3)^2+(y-4)^2-25=0\\\\&(x+3)^2+(y-4)^2=25\\end{align*}$$\nCentre $(-3,4)$; radius $\\sqrt{25}=5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^2-10x+y^2+8y+32=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(5,-4)$; radius $3$.",
          "worked": "$$\\begin{align*}&(x^2-10x+25)-25+(y^2+8y+16)-16+32=0\\\\&(x-5)^2+(y+4)^2-9=0\\\\&(x-5)^2+(y+4)^2=9\\end{align*}$$\nCentre $(5,-4)$; radius $\\sqrt{9}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$x^2+14x+14+y^2-2y=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-7,1)$; radius $6$.",
          "worked": "$$\\begin{align*}&(x^2+14x+49)-49+14+(y^2-2y+1)-1=0\\\\&(x+7)^2+(y-1)^2-36=0\\\\&(x+7)^2+(y-1)^2=36\\end{align*}$$\nCentre $(-7,1)$; radius $\\sqrt{36}=6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$x^2+4x+y^2-2y+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(-2,1)$; radius $2$.",
          "worked": "$$\\begin{align*}&(x^2+4x+4)-4+(y^2-2y+1)-1+1=0\\\\&(x+2)^2+(y-1)^2-4=0\\\\&(x+2)^2+(y-1)^2=4\\end{align*}$$\nCentre $(-2,1)$; radius $\\sqrt{4}=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$x^2-6x+y^2-4y-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Centre $(3,2)$; radius $4$.",
          "worked": "$$\\begin{align*}&(x^2-6x+9)-9+(y^2-4y+4)-4-3=0\\\\&(x-3)^2+(y-2)^2-16=0\\\\&(x-3)^2+(y-2)^2=16\\end{align*}$$\nCentre $(3,2)$; radius $\\sqrt{16}=4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
