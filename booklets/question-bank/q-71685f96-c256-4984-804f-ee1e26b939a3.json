    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int e^x(e^x+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12e^{2x}+e^x+C$",
          "worked": "$$\\begin{align*}\\int e^x(e^x+1)\\,dx&=\\int(e^{2x}+e^x)\\,dx\\\\&=\\frac{e^{2x}}{2}+e^x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int e^{-x}(2e^{-x}-1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e^{-x}-e^{-2x}+C$",
          "worked": "$$\\begin{align*}\\int e^{-x}(2e^{-x}-1)\\,dx&=\\int(2e^{-2x}-e^{-x})\\,dx\\\\&=\\frac{2e^{-2x}}{-2}-\\frac{e^{-x}}{-1}+C\\\\&=e^{-x}-e^{-2x}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int(e^x-1)^2\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12e^{2x}-2e^x+x+C$",
          "worked": "$$\\begin{align*}\\int(e^x-1)^2\\,dx&=\\int(e^{2x}-2e^x+1)\\,dx\\\\&=\\frac{e^{2x}}{2}-2e^x+x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
