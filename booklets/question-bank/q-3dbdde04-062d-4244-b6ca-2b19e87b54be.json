        "type": "part",
        "label": "a",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p32-q2a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 32 question 2(a)\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (L) at (0,0); \\coordinate (R) at (3.96,0); \\coordinate (T) at (1.3418,1.2);\n\\draw[black] (L)--(T)--(R)--cycle;\n\\path (L)--(T) node[midway,above left] {$5\\,\\mathrm{cm}$};\n\\path (T)--(R) node[midway,above right] {$8\\,\\mathrm{cm}$};\n\\path (L)--(R) node[midway,below] {$11\\,\\mathrm{cm}$};\n\\node at (2.98,0.22) {$\\theta$};\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 65,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 32,
              "sourceRegion": "Question 2(a), upper-left triangle",
              "description": "Horizontal base; 5 cm left side, 8 cm right side and 11 cm base. The angle theta is inside the right base vertex. Ordinary outlines and labels use black.",
              "mathematics": "Theta lies between sides 8 cm and 11 cm and is opposite the 5 cm side.",
              "answerVisibility": "Only supplied lengths and theta are visible."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$25^\\circ$",
          "worked": "$$\\begin{align*}\\cos\\theta &= \\frac{8^2+11^2-5^2}{2(8)(11)}\\\\\\cos\\theta &= \\frac{10}{11}\\\\\\theta &= \\cos^{-1}\\left(\\frac{10}{11}\\right)\\\\\\theta &\\approx 25^\\circ\\quad\\text{(nearest degree).}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38,
        "responseSpace": "scaffold"
      },
