  "content": {
    "id": "p5-p1-root",
    "type": "question",
    "label": "19",
    "prompt": "Find the original function $f(x)$ if",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x+3)=x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x+4$.",
          "worked": "Let $u=x+3$, so $x=u-3$.\n$$\\begin{align*}f(u)&=(u-3)+7\\\\f(u)&=u+4.\\end{align*}$$\nThus $f(x)=x+4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x-2)=x^2-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x^2+4x$.",
          "worked": "Let $u=x-2$, so $x=u+2$.\n$$\\begin{align*}f(u)&=(u+2)^2-4\\\\f(u)&=u^2+4u+4-4\\\\f(u)&=u^2+4u.\\end{align*}$$\nThus $f(x)=x^2+4x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p5-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x+1)=x^2-3x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=x^2-5x+8$.",
          "worked": "Let $u=x+1$, so $x=u-1$.\n$$\\begin{align*}f(u)&=(u-1)^2-3(u-1)+4\\\\f(u)&=u^2-2u+1-3u+3+4\\\\f(u)&=u^2-5u+8.\\end{align*}$$\nThus $f(x)=x^2-5x+8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p5-p1-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(2x)=\\dfrac{x}{3x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=\\dfrac{x}{3x-2}$, $x\\ne\\dfrac23$.",
          "worked": "Let $u=2x$, so $x=\\dfrac u2$.\n$$\\begin{align*}f(u)&=\\frac{u/2}{3u/2-1}\\\\f(u)&=\\frac{u}{3u-2}.\\end{align*}$$\nThus $f(x)=\\dfrac{x}{3x-2}$, where $x\\ne\\dfrac23$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
