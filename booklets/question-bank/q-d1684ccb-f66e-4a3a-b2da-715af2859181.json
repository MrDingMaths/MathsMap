  "content": {
    "id": "p4-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{5x}{5y}\\times\\dfrac{3y}{20x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{20x}$",
          "worked": "$$\\begin{align*}\\frac{5x}{5y}\\times\\frac{3y}{20x^2}&=\\frac{15xy}{100x^2y}\\\\&=\\frac{3}{20x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p4-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5x}{6}\\div\\dfrac{15xy}{9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2y}$",
          "worked": "$$\\begin{align*}\\frac{5x}{6}\\div\\frac{15xy}{9}&=\\frac{5x}{6}\\times\\frac{9}{15xy}\\\\&=\\frac{45x}{90xy}\\\\&=\\frac{1}{2y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p4-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x-2}{x+3}\\times\\dfrac{x^2-x-6}{x^2-6x+9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{(x-2)(x+2)}{(x-3)(x+3)}$",
          "worked": "$$\\begin{align*}\\frac{x-2}{x+3}\\times\\frac{x^2-x-6}{x^2-6x+9}&=\\frac{(x-2)(x-3)(x+2)}{(x+3)(x-3)^2}\\\\&=\\frac{(x-2)(x+2)}{(x-3)(x+3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p4-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2-9}{x^2-2x-15}\\div\\dfrac{x^2-5x+6}{3x^2-12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3(x+2)}{x-5}$\n\nMultiply by the reciprocal of the divisor, then factor and cancel.",
          "worked": "$$\\begin{align*}\\frac{x^2-9}{x^2-2x-15}\\div\\frac{x^2-5x+6}{3x^2-12}&=\\frac{x^2-9}{x^2-2x-15}\\times\\frac{3x^2-12}{x^2-5x+6}\\\\&=\\frac{(x-3)(x+3)\\,3(x-2)(x+2)}{(x-5)(x+3)(x-2)(x-3)}\\\\&=\\frac{3(x+2)}{x-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
