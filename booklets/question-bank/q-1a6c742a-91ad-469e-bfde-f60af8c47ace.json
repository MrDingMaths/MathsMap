  "content": {
    "id": "p15-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Use your understanding of the graph of $y=e^x$ to find the range of the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=e^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y>0$",
          "worked": "The horizontal compression leaves the range unchanged. The graph takes every positive $y$-value, so $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2e^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y>0$",
          "worked": "Doubling the positive ordinates still gives every positive $y$-value, so $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=-e^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y<0$",
          "worked": "Reflect $y=e^{2x}$ across the $x$-axis. The positive range becomes all negative $y$-values, so $y<0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=2e^x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y>-3$",
          "worked": "The range of $y=2e^x$ is $y>0$. Shifting down by 3 units moves the lower boundary to $-3$, so $y>-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=e^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y>0$",
          "worked": "Reflecting across the $y$-axis preserves the ordinates of $y=e^x$, so $y>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p15-q7-f",
