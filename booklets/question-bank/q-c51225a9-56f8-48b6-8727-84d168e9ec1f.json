        "children": [
          {
            "id": "p15-q6-a",
            "type": "part",
            "label": "a",
            "prompt": "$x:3=2:5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\frac{6}{5}$",
              "worked": "$$\\begin{align*}\\frac{x}{3}&=\\frac{2}{5}\\\\5x&=6\\\\x&=\\frac{6}{5}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p15-q6-b",
            "type": "part",
            "label": "b",
            "prompt": "$2:x=3:4$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=\\frac{8}{3}$",
              "worked": "$$\\begin{align*}\\frac{2}{x}&=\\frac{3}{4}\\\\3x&=8\\\\x&=\\frac{8}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p15-q6-c",
            "type": "part",
            "label": "c",
            "prompt": "$(x+3):3=2:3$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=-1$",
              "worked": "$$\\begin{align*}\\frac{x+3}{3}&=\\frac{2}{3}\\\\x+3&=2\\\\x&=-1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p15-q6-d",
            "type": "part",
            "label": "d",
            "prompt": "$3:(x-4)=3:5$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=9$",
              "worked": "$$\\begin{align*}\\frac{3}{x-4}&=\\frac{3}{5}\\\\3(x-4)&=15\\\\x-4&=5\\\\x&=9\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p15-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x+3):2=(x-3):3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-15$",
          "worked": "$$\\begin{align*}\\frac{x+3}{2}&=\\frac{x-3}{3}\\\\3(x+3)&=2(x-3)\\\\3x+9&=2x-6\\\\x+9&=-6\\\\x&=-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p15-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$2:(x-2)=3:(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10$",
          "worked": "$$\\begin{align*}\\frac{2}{x-2}&=\\frac{3}{x+2}\\\\2(x+2)&=3(x-2)\\\\2x+4&=3x-6\\\\4&=x-6\\\\x&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
