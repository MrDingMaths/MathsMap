        "id": "v2-587e0-p27-practice-j5-104354-j5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $\\sqrt{75}-\\sqrt{12}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\sqrt{3}$",
          "worked": "$$\\begin{align*}\\sqrt{75}-\\sqrt{12}&=\\sqrt{25\\times3}-\\sqrt{4\\times3}\\\\&=5\\sqrt{3}-2\\sqrt{3}\\\\&=3\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-587e0-p27-practice-j5-104354-j5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the value of $x$ if $\\sqrt{75}-\\sqrt{12}=\\sqrt{x}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=27$",
          "worked": "$$\\begin{align*}\\sqrt{x}&=3\\sqrt{3}\\\\&=\\sqrt{9}\\times\\sqrt{3}\\\\&=\\sqrt{27}\\\\x&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
