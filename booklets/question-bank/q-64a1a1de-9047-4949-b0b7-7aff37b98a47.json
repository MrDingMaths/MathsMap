  "content": {
    "id": "p25-q6",
    "type": "question",
    "label": "6",
    "prompt": "Simplify.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x(x+1)}{(x+3)}\\div\\dfrac{x+1}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$",
          "worked": "$\\begin{aligned}\\frac{x(x+1)}{x+3}\\div\\frac{x+1}{x+3}&=\\frac{x(x+1)}{x+3}\\times\\frac{x+3}{x+1}\\\\&=x\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+3}{x+2}\\div\\dfrac{x+3}{2(x-2)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2(x-2)}{x+2}$",
          "worked": "$\\begin{aligned}\\frac{x+3}{x+2}\\div\\frac{x+3}{2(x-2)}&=\\frac{x+3}{x+2}\\times\\frac{2(x-2)}{x+3}\\\\&=\\frac{2(x-2)}{x+2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{5(2x-3)}{x+7}\\div\\dfrac{(x+2)(2x-3)}{x+7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5}{x+2}$",
          "worked": "$\\begin{aligned}\\frac{5(2x-3)}{x+7}\\div\\frac{(x+2)(2x-3)}{x+7}&=\\frac{5(2x-3)}{x+7}\\times\\frac{x+7}{(x+2)(2x-3)}\\\\&=\\frac{5}{x+2}\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
