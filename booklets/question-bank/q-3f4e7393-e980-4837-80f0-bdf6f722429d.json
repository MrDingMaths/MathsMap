  "content": {
    "id": "p35-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For each $x$ and $y$, find an equation relating $x$ and $y$ that is independent of $\\theta$.\nUse the method in the previous question.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=a\\cos\\theta$ and\n\n$y=a\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+y^2=a^2$",
          "worked": "Using $\\cos^2\\theta+\\sin^2\\theta=1$:\n$$\\begin{aligned}x^2+y^2&=(a\\cos\\theta)^2+(a\\sin\\theta)^2\\\\&=a^2(\\cos^2\\theta+\\sin^2\\theta)\\\\&=a^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p35-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=a\\tan\\theta$ and\n\n$y=b\\sec\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{y^2}{b^2}-\\dfrac{x^2}{a^2}=1$",
          "worked": "For non-zero $a$ and $b$,\n$$\\tan\\theta=\\frac{x}{a},\\qquad\\sec\\theta=\\frac{y}{b}.$$\nUsing $\\sec^2\\theta-\\tan^2\\theta=1$:\n$$\\frac{y^2}{b^2}-\\frac{x^2}{a^2}=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p35-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=2+\\cos\\theta$ and\n\n$y=1+\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2+(y-1)^2=1$",
          "worked": "$$\\cos\\theta=x-2,\\qquad\\sin\\theta=y-1.$$\nUsing $\\cos^2\\theta+\\sin^2\\theta=1$:\n$$(x-2)^2+(y-1)^2=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
