  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p6-q2-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A television costs ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\$500",
              "display": false
            },
            {
              "type": "text",
              "text": ". Its price is ",
              "marks": []
            },
            {
              "type": "text",
              "text": "increased",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " by 10%.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is its new price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$550$",
          "worked": "$$\\begin{align*}\\text{New price} &= \\$500\\times1.1\\\\\\text{New price} &= \\$550\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "After a year its price is increased by another 10%. What is its price now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$605$",
          "worked": "$$\\begin{align*}\\text{Price after two increases} &= \\$500\\times1.1\\times1.1\\\\\\text{Price after two increases} &= \\$500\\times1.21\\\\\\text{Price after two increases} &= \\$605\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find 120% of 500",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$600$",
          "worked": "$$\\begin{align*}120\\%\\text{ of }500 &= 1.2\\times500\\\\120\\%\\text{ of }500 &= 600\\end{align*}$$\nThe corresponding television price is $\\$600$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Is increasing by 10% then 10% again the same as increasing by 20%?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. Two 10% increases give a 21% overall increase.",
          "worked": "$$\\begin{align*}\\text{Combined multiplier} &= 1.1\\times1.1\\\\\\text{Combined multiplier} &= 1.21\\end{align*}$$\nNo. The overall increase is $121\\%-100\\%=21\\%$. The second 10% increase applies to the increased price, so the final price is $\\$605$, compared with $\\$600$ for a single 20% increase.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
