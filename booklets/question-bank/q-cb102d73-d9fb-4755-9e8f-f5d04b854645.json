        "answer": {
          "short": "$125\\text{ hours}$",
          "worked": "$1.5\\text{ kg}=1500\\text{ g}$.$$\\begin{align*}1500&=12t\\\\t&=\\frac{1500}{12}\\\\t&=125\\text{ hours}\\end{align*}$$",
