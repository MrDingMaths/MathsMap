  "content": {
    "id": "p18-practice-root",
    "type": "question",
    "label": "",
    "prompt": "Alison is rolling a die and spinning a spinner.\n\nWhat is the probability that she gets:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [
      {
        "id": "p18-practice-devices",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 18 p18-practice-devices\"}\n\\begin{tikzpicture}[x=10mm,y=10mm,line width=0.8pt]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw (0,0) rectangle (1,1);\\draw (0,1)--(.3,1.3)--(1.3,1.3)--(1,1);\\draw (1,0)--(1.3,.3)--(1.3,1.3);\n\\foreach \\x in {.23,.5,.77}{\\foreach \\y in {.25,.75}{\\fill (\\x,\\y) circle (.055);}}\n\\foreach \\x in {.42,.7,.98}{\\fill (\\x,1.15) circle (.045);}\\fill (1.15,.55) circle (.045);\\fill (1.15,1.02) circle (.045);\n\\draw (1.8,0) rectangle (3.1,1.3);\\draw (1.8,0)--(3.1,1.3);\\draw (1.8,1.3)--(3.1,0);\n\\node at (2.45,1.06) {A};\\node at (2.86,.65) {B};\\node at (2.45,.24) {C};\\node at (2.04,.65) {D};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 52,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 18,
          "sourceRegion": "Practice devices",
          "description": "Die left and square spinner right, with diagonals dividing four equal sectors. Decorative fills omitted.",
          "mathematics": "Six die outcomes; spinner sectors A top, B right, C bottom, D left.",
          "answerVisibility": "Permanent givens."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p18-practice-a",
        "type": "part",
        "label": "a",
        "prompt": "1 on the die and C on the spinner.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{24}$",
          "worked": "$$\\begin{aligned}P(1,C)&=P(1)\\times P(C)\\\\&=\\frac16\\times\\frac14\\\\&=\\frac1{24}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p18-practice-b",
        "type": "part",
        "label": "b",
        "prompt": "An even number and a consonant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac38$",
          "worked": "Even outcomes: 2, 4, 6. Consonants: B, C, D.\n$$\\begin{aligned}P(\\text{even},\\text{consonant})&=P(\\text{even})\\times P(\\text{consonant})\\\\&=\\frac36\\times\\frac34\\\\&=\\frac9{24}=\\frac38\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p18-practice-c",
        "type": "part",
        "label": "c",
        "prompt": "A number greater than 4 and a vowel.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{12}$",
          "worked": "Numbers greater than 4: 5, 6. The only vowel is A.\n$$\\begin{aligned}P(>4,\\text{vowel})&=P(>4)\\times P(\\text{vowel})\\\\&=\\frac26\\times\\frac14\\\\&=\\frac2{24}=\\frac1{12}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
