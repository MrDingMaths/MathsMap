  "content": {
    "id": "p51-q18-root",
    "type": "question",
    "label": "",
    "prompt": "It is given that $\\theta$ is an acute angle and that $\\tan\\theta=\\dfrac{\\sqrt{5}}{2}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Draw a right-angled triangle to show this information.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A right-angled triangle with opposite side $\\sqrt{5}$ and adjacent side $2$, relative to $\\theta$.",
          "worked": "$\\tan\\theta=\\dfrac{\\text{opposite}}{\\text{adjacent}}=\\dfrac{\\sqrt{5}}{2}$. Label the side opposite $\\theta$ as $\\sqrt{5}$ and the adjacent side as $2$.",
          "solutionDiagrams": [
            {
              "id": "p51-q18-a-solution-triangle",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 51 question 18a solution\"}\n\\begin{tikzpicture}[x=1.5cm,y=1.5cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (2,0);\n\\coordinate (C) at (2,{sqrt(5)});\n\\draw[black] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.4pt] ($(B)!0.10!(A)$)--($($(B)!0.10!(A)$)+($(B)!0.09!(C)$)-(B)$)--($(B)!0.09!(C)$);\n\\path (A)--(B) node[midway,below] {$2$};\n\\path (B)--(C) node[midway,right] {$\\sqrt{5}$};\n\\pic[draw=black,line width=0.4pt,angle radius=7mm,angle eccentricity=1.35,\"$\\theta$\"] {angle=B--A--C};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 60,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 51,
                "sourceRegion": "Question 18a response area",
                "description": "Authored solution triangle showing the given tangent ratio; the hypotenuse remains unlabelled for part b.",
                "mathematics": "The legs have lengths 2 and sqrt(5), with theta opposite sqrt(5).",
                "answerVisibility": "Solution only; no supplied triangle appears in the student prompt."
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p51-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Use Pythagoras’ theorem to find the length of the unknown side.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{9}=3$",
          "worked": "$$\\begin{align*}h^2&=2^2+(\\sqrt{5})^2\\\\h^2&=4+5\\\\h^2&=9\\\\h&=\\sqrt{9}=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p51-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence write the exact values of $\\sin\\theta$ and $\\cos\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\theta=\\dfrac{\\sqrt{5}}{\\sqrt{9}}=\\dfrac{\\sqrt{5}}{3},\\quad\\cos\\theta=\\dfrac{2}{\\sqrt{9}}=\\dfrac{2}{3}$",
          "worked": "$$\\begin{align*}\\sin\\theta&=\\frac{\\text{opposite}}{\\text{hypotenuse}}\\\\\\sin\\theta&=\\frac{\\sqrt{5}}{3}\\\\\\cos\\theta&=\\frac{\\text{adjacent}}{\\text{hypotenuse}}\\\\\\cos\\theta&=\\frac{2}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $\\sin^2\\theta+\\cos^2\\theta=1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\left(\\dfrac{\\sqrt{5}}{\\sqrt{9}}\\right)^2+\\left(\\dfrac{2}{\\sqrt{9}}\\right)^2=\\dfrac{5}{9}+\\dfrac{4}{9}=1$",
          "worked": "$$\\begin{align*}\\sin^2\\theta+\\cos^2\\theta&=\\left(\\frac{\\sqrt{5}}{\\sqrt{9}}\\right)^2+\\left(\\frac{2}{\\sqrt{9}}\\right)^2\\\\\\sin^2\\theta+\\cos^2\\theta&=\\frac{5}{9}+\\frac{4}{9}\\\\\\sin^2\\theta+\\cos^2\\theta&=\\frac{9}{9}\\\\\\sin^2\\theta+\\cos^2\\theta&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
