    "children": [
      {
        "id": "p14-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the formula for the distance $d$ (in kilometres) travelled by the car in $t$ hours?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$d=95t$",
          "worked": "Distance equals speed multiplied by time.\n\n$$\\begin{align*}d&=95\\times t\\\\d&=95t\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the gradient of the straight-line graph of $d$ against $t$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$95$",
          "worked": "For $d=95t$, the gradient is the coefficient of $t$, so the gradient is $95$. It represents the speed of $95\\text{ km/h}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
