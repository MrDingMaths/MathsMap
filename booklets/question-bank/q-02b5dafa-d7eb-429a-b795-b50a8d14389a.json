  "content": {
    "id": "p14-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "$\\$16\\,000$ is invested for 5 years at 8% compounded annually.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the total interest earned over the 5 years to the nearest cent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$7509.25$",
          "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\FV &= 16000(1.08)^5\\\\I &= FV-PV\\\\I &= 16000(1.08)^5-16000\\\\I &\\approx \\$7509.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p14-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the simple interest rate that would deliver the same overall interest at the end of the 5 years. Round to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9.39% p.a.",
          "worked": "$$\\begin{align*}I &= Prn\\\\16000(1.08)^5-16000 &= 16000\\times r\\times5\\\\r &= \\frac{16000(1.08)^5-16000}{16000\\times5}\\\\r &\\approx 0.09386561536\\end{align*}$$\nThe simple interest rate is $9.39\\%$ p.a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
