  "content": {
    "id": "p41-q10-root",
    "type": "question",
    "label": "10",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p41-q10-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "[pH of a solution] The pH of a liquid is traditionally defined on a logarithmic scale as ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\mathrm{pH}=-\\log_{10}[\\mathrm{H}^{+}]",
              "display": false
            },
            {
              "type": "text",
              "text": ", where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "[\\mathrm{H}^{+}]",
              "display": false
            },
            {
              "type": "text",
              "text": " is the hydrogen ion concentration in units of moles per litre (mol/L). It is not necessary to understand the units, except to know that the greater the concentration of hydrogen ions, the greater the acidity.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Rewrite the formula with $[\\mathrm{H}^{+}]$ as the subject.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$[\\mathrm{H}^{+}]=10^{-\\mathrm{pH}}$.",
          "worked": "$$\\begin{align*}\\log_{10}[\\mathrm{H}^{+}]&=-\\mathrm{pH}\\\\{}[\\mathrm{H}^{+}]&=10^{-\\mathrm{pH}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p41-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Pure water has a pH of about 7. What is its hydrogen ion concentration?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "About $10^{-7}\\ \\mathrm{mol/L}$.",
          "worked": "$$\\begin{align*}[\\mathrm{H}^{+}]&=10^{-7}\\ \\mathrm{mol/L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Lemon juice typically has a pH of about 2.0. What is its hydrogen ion concentration? How many times more acidic is it than pure water?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "About $10^{-2}\\ \\mathrm{mol/L}$; about $100\\,000$ times more acidic than pure water.",
          "worked": "$$\\begin{align*}[\\mathrm{H}^{+}]&=10^{-2}\\ \\mathrm{mol/L}\\\\\\frac{[\\mathrm{H}^{+}]_{\\text{lemon}}}{[\\mathrm{H}^{+}]_{\\text{water}}}&=\\frac{10^{-2}}{10^{-7}}\\\\\\frac{[\\mathrm{H}^{+}]_{\\text{lemon}}}{[\\mathrm{H}^{+}]_{\\text{water}}}&=10^5\\end{align*}$$\nLemon juice is about $100\\,000$ times more acidic than pure water.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p41-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Sea water typically has a pH of about 8.1. What is its hydrogen ion concentration? How many times more alkaline (meaning ‘less acidic’) is it than pure water? Give answers to three significant figures.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "About $7.94\\times10^{-9}\\ \\mathrm{mol/L}$; about $12.6$ times less acidic than pure water.",
          "worked": "$$\\begin{align*}[\\mathrm{H}^{+}]&=10^{-8.1}\\ \\mathrm{mol/L}\\\\{}[\\mathrm{H}^{+}]&\\approx7.94\\times10^{-9}\\ \\mathrm{mol/L}\\\\\\frac{[\\mathrm{H}^{+}]_{\\text{water}}}{[\\mathrm{H}^{+}]_{\\text{sea}}}&=\\frac{10^{-7}}{10^{-8.1}}\\\\\\frac{[\\mathrm{H}^{+}]_{\\text{water}}}{[\\mathrm{H}^{+}]_{\\text{sea}}}&=10^{1.1}\\\\\\frac{[\\mathrm{H}^{+}]_{\\text{water}}}{[\\mathrm{H}^{+}]_{\\text{sea}}}&\\approx12.6\\end{align*}$$\nSea water is about $12.6$ times less acidic than pure water, using the question’s meaning of ‘more alkaline’.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
