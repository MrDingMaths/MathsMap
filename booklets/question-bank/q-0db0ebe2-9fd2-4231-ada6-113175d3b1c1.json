  "content": {
    "id": "p7-f4-root",
    "type": "question",
    "label": "4",
    "prompt": "Factorise the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-f4-a",
        "type": "part",
        "label": "a",
        "prompt": "$a^{n+1}-a^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^n(a-1)$",
          "worked": "$$\\begin{align*}a^{n+1}-a^n&=a^n\\cdot a-a^n\\cdot1\\\\a^{n+1}-a^n&=a^n(a-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p7-f4-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{3n}-a^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^n(a^{2n}-1)$",
          "worked": "$$\\begin{align*}a^{3n}-a^n&=a^n\\cdot a^{2n}-a^n\\cdot1\\\\a^{3n}-a^n&=a^n(a^{2n}-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p7-f4-c",
        "type": "part",
        "label": "c",
        "prompt": "$(ab)^n-a^n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^n(b^n-1)$",
          "worked": "$$\\begin{align*}(ab)^n-a^n&=a^nb^n-a^n\\cdot1\\\\(ab)^n-a^n&=a^n(b^n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
