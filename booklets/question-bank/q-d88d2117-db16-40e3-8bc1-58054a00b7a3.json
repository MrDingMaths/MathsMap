    "type": "question",
    "label": "11",
    "prompt": "State the range of these functions, using $x^2\\ge 0$, $\\sqrt{x}\\ge 0$, $\\dfrac{1}{x}\\ne 0$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=7-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\le 7$",
          "worked": "$$\\begin{aligned}x^2&\\ge 0\\\\-x^2&\\le 0\\\\7-x^2&\\le 7\\end{aligned}$$\nRange: $y\\le 7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p38-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\sqrt{x+6}-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y\\ge -4$",
          "worked": "$$\\begin{aligned}\\sqrt{x+6}&\\ge 0\\\\\\sqrt{x+6}-4&\\ge -4\\end{aligned}$$\nRange: $y\\ge -4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p38-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\dfrac{3}{x-2}+5$",
