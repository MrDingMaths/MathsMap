    "type": "question",
    "label": null,
    "prompt": "Simplify $\\frac{5ab^{2}}{2ab^{2}} \\div \\frac{10a^{4}b^{7}}{4a^{3}b^{8}}$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{b}{a}$\n\nMultiply by the reciprocal of the divisor, then simplify.",
      "worked": "$$\\begin{align*}\\frac{5ab^2}{2ab^2}\\div\\frac{10a^4b^7}{4a^3b^8}&=\\frac52\\times\\frac{4a^3b^8}{10a^4b^7} \\\\ &=\\frac ba\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 8
