    "children": [
      {
        "id": "p33-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{3^{-2}a}{b^{2}}\\right)^{-2}\\times\\frac{27}{a^{2}b^{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3^{7}b^{2}}{a^{4}}$\n\nApply the outer power to every factor, then combine indices.",
          "worked": "$$\\begin{align*}\\left(\\frac{3^{-2}a}{b^{2}}\\right)^{-2}\\times\\frac{27}{a^{2}b^{2}}&=\\frac{3^{4}b^{4}}{a^{2}}\\times\\frac{3^{3}}{a^{2}b^{2}}\\\\\\left(\\frac{3^{-2}a}{b^{2}}\\right)^{-2}\\times\\frac{27}{a^{2}b^{2}}&=\\frac{3^{4+3}b^{4-2}}{a^{2+2}}\\\\\\left(\\frac{3^{-2}a}{b^{2}}\\right)^{-2}\\times\\frac{27}{a^{2}b^{2}}&=\\frac{3^{7}b^{2}}{a^{4}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{x^{2}}{y^{-2}}\\right)^{-3}\\times\\left(\\frac{x^{2}}{y^{3}}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{x^{4}y^{9}}$\n\nApply the power to the quotient and combine the indices of each variable.",
          "worked": "$$\\begin{align*}\\left(\\frac{x^{2}}{y^{-2}}\\right)^{-3}\\times\\left(\\frac{x^{2}}{y^{3}}\\right)&=\\frac{x^{-6}}{y^{6}}\\times\\frac{x^{2}}{y^{3}}\\\\\\left(\\frac{x^{2}}{y^{-2}}\\right)^{-3}\\times\\left(\\frac{x^{2}}{y^{3}}\\right)&=x^{-6+2}y^{-6-3}\\\\\\left(\\frac{x^{2}}{y^{-2}}\\right)^{-3}\\times\\left(\\frac{x^{2}}{y^{3}}\\right)&=\\frac{1}{x^{4}y^{9}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p33-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{(3a^{2})^{3}}{(2ab^{2})^{2}}\\times\\frac{(2b)^{-5}}{(3a)^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3^{7}a^{8}}{2^{7}b^{9}}$\n\nExpand each power before combining numerical and algebraic factors.",
          "worked": "$$\\begin{align*}\\frac{(3a^{2})^{3}}{(2ab^{2})^{2}}\\times\\frac{(2b)^{-5}}{(3a)^{-4}}&=\\frac{3^{3}a^{6}}{2^{2}a^{2}b^{4}}\\times\\frac{2^{-5}b^{-5}}{3^{-4}a^{-4}}\\\\\\frac{(3a^{2})^{3}}{(2ab^{2})^{2}}\\times\\frac{(2b)^{-5}}{(3a)^{-4}}&=3^{3+4}2^{-2-5}a^{6-2+4}b^{-4-5}\\\\\\frac{(3a^{2})^{3}}{(2ab^{2})^{2}}\\times\\frac{(2b)^{-5}}{(3a)^{-4}}&=3^{7}2^{-7}a^{8}b^{-9}\\\\\\frac{(3a^{2})^{3}}{(2ab^{2})^{2}}\\times\\frac{(2b)^{-5}}{(3a)^{-4}}&=\\frac{3^{7}a^{8}}{2^{7}b^{9}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p33-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{(a^{2}b)^{3}\\times(ab^{3})^{-1}}{(a^{-1}b)^{-4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$ab^{4}$",
          "worked": "$$\\begin{align*}\\frac{(a^{2}b)^{3}\\times(ab^{3})^{-1}}{(a^{-1}b)^{-4}}&=\\frac{a^{6}b^{3}\\times a^{-1}b^{-3}}{a^{4}b^{-4}}\\\\\\frac{(a^{2}b)^{3}\\times(ab^{3})^{-1}}{(a^{-1}b)^{-4}}&=a^{6-1-4}b^{3-3+4}\\\\\\frac{(a^{2}b)^{3}\\times(ab^{3})^{-1}}{(a^{-1}b)^{-4}}&=ab^{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
