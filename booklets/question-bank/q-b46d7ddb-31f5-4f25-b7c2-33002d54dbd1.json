  "content": {
    "id": "p62-q17-response",
    "type": "question",
    "label": "17",
    "prompt": "A sector with arc length $2\\pi$ cm is subtended by an angle of $\\frac{\\pi}{6}$. Find the area of the sector.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12\\pi\\text{ cm}^2$",
      "worked": "Using $l=r\\theta$,\n$$\\begin{align*}r&=\\frac{l}{\\theta}\\\\r&=\\frac{2\\pi}{\\pi/6}\\\\r&=12\\text{ cm}.\\end{align*}$$\nThe sector area is\n$$\\begin{align*}A&=\\frac12r^2\\theta\\\\A&=\\frac12(12)^2\\left(\\frac{\\pi}{6}\\right)\\\\A&=12\\pi\\text{ cm}^2.\\end{align*}$$",
      "solutionDiagrams": []
    },
