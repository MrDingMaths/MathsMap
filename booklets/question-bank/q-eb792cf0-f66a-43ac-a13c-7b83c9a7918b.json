  "content": {
    "id": "p6-q19-response",
    "type": "question",
    "label": "19",
    "prompt": "A plane flies $50\\text{ km}$ on a bearing of $110^\\circ$. How far south did it fly? Give your answer correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$17.1\\text{ km}$",
      "worked": "The direction is $110^\\circ-90^\\circ=20^\\circ$ south of east. Let $s$ be the distance south in kilometres.\n\n$$\\begin{align*}\\sin 20^\\circ &= \\frac{s}{50}\\\\s &= 50\\sin 20^\\circ\\\\s &\\approx 17.1\\end{align*}$$\n\nThe plane flew $17.1\\text{ km}$ south.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
