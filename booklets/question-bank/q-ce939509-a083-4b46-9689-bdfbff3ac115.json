    "children": [
      {
        "id": "p26-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{7}a^2+\\frac{2}{3}a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{23a^2}{21}$",
          "worked": "$$\\begin{align*}\\frac{3}{7}a^2+\\frac{2}{3}a^2&=\\frac{9a^2}{21}+\\frac{14a^2}{21}\\\\\\frac{3}{7}a^2+\\frac{2}{3}a^2&=\\frac{(9+14)a^2}{21}\\\\\\frac{3}{7}a^2+\\frac{2}{3}a^2&=\\frac{23a^2}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3a}{b}+\\frac{5a}{2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11a}{2b}$",
          "worked": "$$\\begin{align*}\\frac{3a}{b}+\\frac{5a}{2b}&=\\frac{6a}{2b}+\\frac{5a}{2b}\\\\\\frac{3a}{b}+\\frac{5a}{2b}&=\\frac{(6+5)a}{2b}\\\\\\frac{3a}{b}+\\frac{5a}{2b}&=\\frac{11a}{2b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2x}{y^3}+\\frac{7x}{3y^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13x}{3y^3}$",
          "worked": "$$\\begin{align*}\\frac{2x}{y^3}+\\frac{7x}{3y^3}&=\\frac{6x}{3y^3}+\\frac{7x}{3y^3}\\\\\\frac{2x}{y^3}+\\frac{7x}{3y^3}&=\\frac{(6+7)x}{3y^3}\\\\\\frac{2x}{y^3}+\\frac{7x}{3y^3}&=\\frac{13x}{3y^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p26-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2a^2b}{5}-\\frac{2a^2b}{5}+\\frac{6m}{n^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6m}{n^2}$",
          "worked": "$$\\begin{align*}\\frac{2a^2b}{5}-\\frac{2a^2b}{5}+\\frac{6m}{n^2}&=0+\\frac{6m}{n^2}\\\\\\frac{2a^2b}{5}-\\frac{2a^2b}{5}+\\frac{6m}{n^2}&=\\frac{6m}{n^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
