    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_3(32)\\times\\log_2(9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}\\log_2(9)&=2\\log_2(3)\\\\\\log_3(32)\\times\\log_2(9)&=\\frac{\\log_2(32)}{\\log_2(3)}\\times2\\log_2(3)\\\\\\log_3(32)\\times\\log_2(9)&=2\\log_2(32)\\\\\\log_3(32)\\times\\log_2(9)&=2\\times5=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p26-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_9(\\log_2 8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$$\\begin{align*}\\log_2(8)&=3\\\\\\log_9(\\log_2 8)&=\\log_9(3)\\\\\\log_9(\\log_2 8)&=\\frac12\\end{align*}$$\nsince $9^{1/2}=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p26-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_4(2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "Since $4^{1/2}=2$, $\\log_4(2)=\\frac12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      }
    ]
