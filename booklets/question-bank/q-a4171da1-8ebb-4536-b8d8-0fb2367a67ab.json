      {
        "id": "p14-q4-a",
        "type": "group",
        "label": "a",
        "prompt": "What is the estimated probability that the next counter she withdraws is:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q4-a-i",
            "type": "part",
            "label": "i",
            "prompt": "blue?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{9}{50}$",
              "worked": "$$\\begin{align*}P(\\text{blue})&\\approx\\frac{18}{100}\\\\P(\\text{blue})&\\approx\\frac{9}{50}\\end{align*}$$",
              "solutionDiagrams": []
            },
