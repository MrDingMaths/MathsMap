    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin\\left(x+\\frac{\\pi}{4}\\right)+\\sin\\left(x-\\frac{\\pi}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{2}\\sin x$",
          "worked": "$$\\begin{align*}\\sin\\left(x+\\frac{\\pi}{4}\\right)+\\sin\\left(x-\\frac{\\pi}{4}\\right)&=\\sin x\\cos\\frac{\\pi}{4}+\\cos x\\sin\\frac{\\pi}{4}\\\\&\\quad+\\sin x\\cos\\frac{\\pi}{4}-\\cos x\\sin\\frac{\\pi}{4}\\\\&=2\\sin x\\cos\\frac{\\pi}{4}\\\\&=\\sqrt{2}\\sin x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p4-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos\\left(x+\\frac{\\pi}{3}\\right)+\\cos\\left(x-\\frac{\\pi}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x$",
          "worked": "$$\\begin{align*}\\cos\\left(x+\\frac{\\pi}{3}\\right)+\\cos\\left(x-\\frac{\\pi}{3}\\right)&=\\cos x\\cos\\frac{\\pi}{3}-\\sin x\\sin\\frac{\\pi}{3}\\\\&\\quad+\\cos x\\cos\\frac{\\pi}{3}+\\sin x\\sin\\frac{\\pi}{3}\\\\&=2\\cos x\\cos\\frac{\\pi}{3}\\\\&=\\cos x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p4-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin\\left(x+\\frac{\\pi}{6}\\right)-\\sin\\left(x-\\frac{\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos x$",
          "worked": "$$\\begin{align*}\\sin\\left(x+\\frac{\\pi}{6}\\right)-\\sin\\left(x-\\frac{\\pi}{6}\\right)&=\\sin x\\cos\\frac{\\pi}{6}+\\cos x\\sin\\frac{\\pi}{6}\\\\&\\quad-\\sin x\\cos\\frac{\\pi}{6}+\\cos x\\sin\\frac{\\pi}{6}\\\\&=2\\cos x\\sin\\frac{\\pi}{6}\\\\&=\\cos x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p4-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin\\left(x+\\frac{\\pi}{6}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{3}}{2}\\sin x+\\frac12\\cos x$",
          "worked": "$$\\begin{align*}\\sin\\left(x+\\frac{\\pi}{6}\\right)&=\\sin x\\cos\\frac{\\pi}{6}+\\cos x\\sin\\frac{\\pi}{6}\\\\&=\\frac{\\sqrt{3}}2\\sin x+\\frac12\\cos x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos\\left(x-\\frac{\\pi}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{\\sqrt{2}}\\cos x+\\frac{1}{\\sqrt{2}}\\sin x$",
          "worked": "$$\\begin{align*}\\cos\\left(x-\\frac{\\pi}{4}\\right)&=\\cos x\\cos\\frac{\\pi}{4}+\\sin x\\sin\\frac{\\pi}{4}\\\\&=\\frac1{\\sqrt2}\\cos x+\\frac1{\\sqrt2}\\sin x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$2\\sin\\left(x+\\frac{\\pi}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin x+\\sqrt{3}\\cos x$",
          "worked": "$$\\begin{align*}2\\sin\\left(x+\\frac{\\pi}{3}\\right)&=2\\left(\\sin x\\cos\\frac{\\pi}{3}+\\cos x\\sin\\frac{\\pi}{3}\\right)\\\\&=2\\left(\\frac12\\sin x+\\frac{\\sqrt3}2\\cos x\\right)\\\\&=\\sin x+\\sqrt3\\cos x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
