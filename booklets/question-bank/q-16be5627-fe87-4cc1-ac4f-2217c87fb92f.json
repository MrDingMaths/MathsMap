  "content": {
    "id": "p13-q2",
    "type": "question",
    "label": "2",
    "prompt": "Repeat the steps from Q1 to find the dimensions of a rectangle with:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Area $60\\text{ m}^2$ and its length is $4\\text{ m}$ more than its breadth.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Breadth $6\\text{ m}$, length $10\\text{ m}$.",
          "worked": "Let $x$ be the breadth in metres. The length is $(x+4)$ metres.\n$$\\begin{align*}\nx(x+4)&=60\\\\\nx^2+4x-60&=0\\\\\n(x+10)(x-6)&=0\\\\\nx&=-10\\text{ or }6\n\\end{align*}$$\nReject $x=-10$ because a length must be positive. The breadth is $6\\text{ m}$ and the length is $6+4=10\\text{ m}$. Check: $6\\times10=60\\text{ m}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Area $154\\text{ cm}^2$ and its length is $3\\text{ cm}$ less than its breadth.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Breadth $14\\text{ cm}$, length $11\\text{ cm}$.",
          "worked": "Let $x$ be the breadth in centimetres. The length is $(x-3)$ centimetres.\n$$\\begin{align*}\nx(x-3)&=154\\\\\nx^2-3x-154&=0\\\\\n(x-14)(x+11)&=0\\\\\nx&=14\\text{ or }-11\n\\end{align*}$$\nReject $x=-11$ because a length must be positive. The breadth is $14\\text{ cm}$ and the length is $14-3=11\\text{ cm}$. Check: $14\\times11=154\\text{ cm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
