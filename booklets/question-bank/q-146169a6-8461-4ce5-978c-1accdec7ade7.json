  "content": {
    "id": "p29-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Suppose $A$ and $B$ are independent events such that $P(A)=0.2$ and $P(B)=0.6$. Find the value of",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(A\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{25}$",
          "worked": "By independence,\n\n$$\\begin{align*}P(A\\cap B)&=P(A)P(B)\\\\P(A\\cap B)&=0.2\\times0.6\\\\P(A\\cap B)&=\\frac{3}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p29-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(A\\mid B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "By independence,\n\n$$\\begin{align*}P(A\\mid B)&=P(A)\\\\P(A\\mid B)&=0.2\\\\P(A\\mid B)&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p29-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(B\\mid A)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "By independence,\n\n$$\\begin{align*}P(B\\mid A)&=P(B)\\\\P(B\\mid A)&=0.6\\\\P(B\\mid A)&=\\frac{3}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
