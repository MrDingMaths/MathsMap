      {
        "id": "p44-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x^2}{x^4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2}{x^3}$",
          "worked": "$$\\begin{align*}y&=x^{-2}\\\\\\frac{dy}{dx}&=-2x^{-3}\\\\\\frac{dy}{dx}&=-\\frac{2}{x^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p44-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3\\sqrt{x}}{2}$",
          "worked": "$$\\begin{align*}y&=x^{\\frac32}\\\\\\frac{dy}{dx}&=\\frac32x^{\\frac12}\\\\\\frac{dy}{dx}&=\\frac{3\\sqrt{x}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p44-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{1}{\\sqrt[3]{x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2}{3\\sqrt[3]{x^5}}$",
          "worked": "$$\\begin{align*}y&=x^{-\\frac23}\\\\\\frac{dy}{dx}&=-\\frac23x^{-\\frac53}\\\\\\frac{dy}{dx}&=-\\frac{2}{3\\sqrt[3]{x^5}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{\\sqrt{x}}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3}{2\\sqrt{x^5}}$",
          "worked": "$$\\begin{align*}y&=x^{-\\frac32}\\\\\\frac{dy}{dx}&=-\\frac32x^{-\\frac52}\\\\\\frac{dy}{dx}&=-\\frac{3}{2\\sqrt{x^5}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
