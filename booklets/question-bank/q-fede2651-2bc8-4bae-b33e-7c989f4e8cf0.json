    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\cos^4\\alpha-\\sin^4\\alpha=\\cos 2\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos^4\\alpha-\\sin^4\\alpha=(\\cos^2\\alpha-\\sin^2\\alpha)(\\cos^2\\alpha+\\sin^2\\alpha)=\\cos 2\\alpha$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\cos^4\\alpha-\\sin^4\\alpha\\\\&=(\\cos^2\\alpha-\\sin^2\\alpha)(\\cos^2\\alpha+\\sin^2\\alpha)\\\\&=\\cos^2\\alpha-\\sin^2\\alpha\\\\&=\\cos 2\\alpha\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos 2x+\\cos x=(\\cos x+1)(2\\cos x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos 2x+\\cos x=2\\cos^2x+\\cos x-1=(\\cos x+1)(2\\cos x-1)$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\cos 2x+\\cos x\\\\&=2\\cos^2x-1+\\cos x\\\\&=2\\cos^2x+\\cos x-1\\\\&=(2\\cos x-1)(\\cos x+1)\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{\\sin 2A}{1-\\cos 2A}=\\cot A$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sin 2A}{1-\\cos 2A}=\\frac{2\\sin A\\cos A}{2\\sin^2A}=\\cot A$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\frac{\\sin 2A}{1-\\cos 2A}\\\\&=\\frac{2\\sin A\\cos A}{1-(1-2\\sin^2A)}\\\\&=\\frac{\\sin A\\cos A}{\\sin^2A}\\\\&=\\frac{\\cos A}{\\sin A}\\\\&=\\cot A\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos\\theta-\\sin\\theta\\sin 2\\theta=\\cos\\theta\\cos 2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta-\\sin\\theta\\sin 2\\theta=\\cos\\theta(1-2\\sin^2\\theta)=\\cos\\theta\\cos 2\\theta$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\cos\\theta-\\sin\\theta\\sin 2\\theta\\\\&=\\cos\\theta-2\\sin^2\\theta\\cos\\theta\\\\&=\\cos\\theta(1-2\\sin^2\\theta)\\\\&=\\cos\\theta\\cos 2\\theta\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p13-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\tan\\left(\\frac\\pi4+\\alpha\\right)-\\tan\\left(\\frac\\pi4-\\alpha\\right)=2\\tan 2\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1+\\tan\\alpha}{1-\\tan\\alpha}-\\frac{1-\\tan\\alpha}{1+\\tan\\alpha}=\\frac{4\\tan\\alpha}{1-\\tan^2\\alpha}=2\\tan 2\\alpha$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\tan\\left(\\frac\\pi4+\\alpha\\right)-\\tan\\left(\\frac\\pi4-\\alpha\\right)\\\\&=\\frac{\\tan\\frac\\pi4+\\tan\\alpha}{1-\\tan\\frac\\pi4\\tan\\alpha}-\\frac{\\tan\\frac\\pi4-\\tan\\alpha}{1+\\tan\\frac\\pi4\\tan\\alpha}\\\\&=\\frac{1+\\tan\\alpha}{1-\\tan\\alpha}-\\frac{1-\\tan\\alpha}{1+\\tan\\alpha}\\\\&=\\frac{(1+\\tan\\alpha)^2-(1-\\tan\\alpha)^2}{(1-\\tan\\alpha)(1+\\tan\\alpha)}\\\\&=\\frac{4\\tan\\alpha}{1-\\tan^2\\alpha}\\\\&=2\\tan 2\\alpha\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 69
      },
      {
        "id": "p13-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\sin 2\\theta+\\sin\\theta}{\\cos 2\\theta+\\cos\\theta+1}=\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sin 2\\theta+\\sin\\theta}{\\cos 2\\theta+\\cos\\theta+1}=\\frac{\\sin\\theta(2\\cos\\theta+1)}{\\cos\\theta(2\\cos\\theta+1)}=\\tan\\theta$",
          "worked": "$$\\begin{aligned}\\text{LHS}&=\\frac{\\sin 2\\theta+\\sin\\theta}{\\cos 2\\theta+\\cos\\theta+1}\\\\&=\\frac{2\\sin\\theta\\cos\\theta+\\sin\\theta}{\\cos 2\\theta+\\cos\\theta+1}\\\\&=\\frac{\\sin\\theta(2\\cos\\theta+1)}{2\\cos^2\\theta+\\cos\\theta}\\\\&=\\frac{\\sin\\theta(2\\cos\\theta+1)}{\\cos\\theta(2\\cos\\theta+1)}\\\\&=\\tan\\theta\\\\&=\\text{RHS}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
