  "content": {
    "id": "v2-9eb16b-p7-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "A garden sprinkler uses water at a constant rate. It uses 36 litres in 8 minutes.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-9eb16b-p7-practice-slot-1-slot-1-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an equation relating the volume $V$ litres and the time $t$ minutes.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=4.5t$",
          "worked": "$$\\begin{align*}V&=kt\\\\36&=8k\\\\k&=\\frac{36}{8}\\\\k&=4.5\\end{align*}$$So $V=4.5t$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-9eb16b-p7-practice-slot-1-slot-1-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use your equation to find the volume used in 1.5 hours.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$405\\text{ L}$",
          "worked": "$1.5\\text{ hours}=90\\text{ minutes}$.$$\\begin{align*}V&=4.5(90)\\\\V&=405\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-9eb16b-p7-practice-slot-1-slot-1-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the time taken to use 270 litres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60\\text{ min}$",
          "worked": "$$\\begin{align*}270&=4.5t\\\\t&=\\frac{270}{4.5}\\\\t&=60\\text{ min}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
