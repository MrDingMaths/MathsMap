  "content": {
    "id": "p25-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A 10 cm length of wire is cut into two pieces from which two squares are formed.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "If one piece has length $x$, find the side length of each square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{4}$ cm and $\\dfrac{10-x}{4}$ cm.",
          "worked": "Each side is one quarter of its square's perimeter.\n$$\\begin{align*}s_1&=\\frac{x}{4}\\text{ cm}\\\\s_2&=\\frac{10-x}{4}\\text{ cm}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p25-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that the combined area of the two squares is $A=\\dfrac{x^2-10x+50}{8}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=\\dfrac{x^2-10x+50}{8}$.",
          "worked": "$$\\begin{align*}A&=\\left(\\frac{x}{4}\\right)^2+\\left(\\frac{10-x}{4}\\right)^2\\\\A&=\\frac{2x^2-20x+100}{16}\\\\A&=\\frac{x^2-10x+50}{8}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p25-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $\\dfrac{dA}{dx}$ and hence find the value of $x$ that minimises $A$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dx}=\\dfrac{x-5}{4}$; the minimum occurs at $x=5$ cm.",
          "worked": "$$\\begin{align*}\\frac{dA}{dx}&=\\frac{2x-10}{8}\\\\\\frac{dA}{dx}&=\\frac{x-5}{4}\\\\\\frac{x-5}{4}&=0\\\\x&=5.\\end{align*}$$\nSince $\\dfrac{d^2A}{dx^2}=\\dfrac14>0$ for all $x$, the function is concave up. Thus $A$ is minimised at $x=5$ cm, within the physical domain $0<x<10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p25-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the least possible combined area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{25}{8}\\text{ cm}^2$.",
          "worked": "$$\\begin{align*}A(5)&=\\frac{5^2-10(5)+50}{8}\\\\A(5)&=\\frac{25}{8}\\text{ cm}^2.\\end{align*}$$\nThe least possible combined area is $\\dfrac{25}{8}\\text{ cm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
