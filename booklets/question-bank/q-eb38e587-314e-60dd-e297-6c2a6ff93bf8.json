  "content": {
    "id": "p53-q51-group-root",
    "type": "question",
    "label": "18",
    "prompt": "For each of the following, determine if the sets are disjoint or not disjoint.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p53-q51-root",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}A&=\\{2,4,6,8\\}\\\\B&=\\{1,3,5,7\\}\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Disjoint.",
          "worked": "No element occurs in both sets, so $A\\cap B=\\varnothing$. The sets are disjoint.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p53-q52-root",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}A&=\\{\\text{even \\#’s}\\}\\\\B&=\\{\\text{prime \\#’s}\\}\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not disjoint; common element $2$.",
          "worked": "$2$ is both even and prime, so $2\\in A\\cap B$. Thus the intersection is nonempty and the sets are not disjoint.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p53-q53-root",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}A&=[0,1)\\\\B&=[1,2)\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Disjoint.",
          "worked": "Every member of $A$ is less than $1$, while every member of $B$ is at least $1$. Hence $A\\cap B=\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p53-q54-root",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}A&=[0,1]\\\\B&=(-\\infty,1]\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not disjoint; $A\\cap B=[0,1]$.",
          "worked": "Every member of $A$ belongs to $B$, so $A\\cap B=A=[0,1]$. This is nonempty.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p53-q55-root",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}A&=\\{1,2,3,4,5\\}\\\\B&=\\{x\\in\\mathbb Z\\text{ where }x^2>25\\}\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Disjoint.",
          "worked": "For every $x\\in A$, $x^2\\leq25$. No member satisfies the strict condition $x^2>25$, so $A\\cap B=\\varnothing$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
