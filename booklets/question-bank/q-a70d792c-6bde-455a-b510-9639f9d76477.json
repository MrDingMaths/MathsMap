  "content": {
    "id": "routine-arithmetic-r9-accumulation-1-root",
    "type": "question",
    "label": null,
    "prompt": "A student saves $\\$20$ in the first week of a savings plan. In each following week she saves $\\$3$ more than in the previous week. How much has she saved in total after 12 weeks?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$438$",
      "worked": "The weekly savings form an AP with $a=20$, $d=3$ and $n=12$.\n$$\\begin{aligned}S_{12}&=\\frac{12}{2}\\left[2(20)+11(3)\\right]\\\\&=6(40+33)\\\\&=6(73)\\\\&=\\$438\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 48
