    "id": "p5-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "An ice-cream cone measures 4.6 cm in diameter and is 9 cm high.\n\nCalculate the volume of the cone. Answer correct to two decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$49.86\\,\\mathrm{cm}^{3}$",
      "worked": "$\\begin{aligned}r&=\\frac{4.6}{2}=2.3\\,\\mathrm{cm}\\\\V&=\\frac13\\pi r^{2}h\\\\V&=\\frac13\\pi(2.3)^{2}\\times9\\\\V&=15.87\\pi\\,\\mathrm{cm}^{3}\\\\V&\\approx49.86\\,\\mathrm{cm}^{3}\\end{aligned}$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
