  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Show that each of these functions is not injective:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$g:\\mathbb{R}\\to\\mathbb{R}$ where $g(x)=x^2+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(1)=g(-1)=2$, although $1\\ne-1$.",
          "worked": "$$\\begin{align*}g(1)&=1^2+1=2\\\\g(-1)&=(-1)^2+1=2\\end{align*}$$\nSince $1\\ne-1$ but $g(1)=g(-1)$, $g$ is not injective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f=\\{(1,2),(2,3),(3,2),(4,1)\\}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(1)=f(3)=2$, although $1\\ne3$.",
          "worked": "The ordered pairs $(1,2)$ and $(3,2)$ give $f(1)=f(3)=2$. Since $1\\ne3$, $f$ is not injective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f:\\mathbb{R}\\to\\mathbb{R}$, where $f(x)=|x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(1)=f(-1)=1$, although $1\\ne-1$.",
          "worked": "$$\\begin{align*}f(1)&=|1|=1\\\\f(-1)&=|-1|=1\\end{align*}$$\nSince $1\\ne-1$ but $f(1)=f(-1)$, $f$ is not injective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$g:\\mathbb{R}\\to\\mathbb{R}$, where $g(x)=x(1-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(0)=g(1)=0$, although $0\\ne1$.",
          "worked": "$$\\begin{align*}g(0)&=0(1-0)=0\\\\g(1)&=1(1-1)=0\\end{align*}$$\nSince $0\\ne1$ but $g(0)=g(1)$, $g$ is not injective.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
