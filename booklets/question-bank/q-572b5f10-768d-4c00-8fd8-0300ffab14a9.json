  "content": {
    "id": "p11-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Factorise each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x^2-x+1)$",
          "worked": "$$\\begin{align*}x^3+1&=x^3+1^3\\\\x^3+1&=(x+1)(x^2-x\\cdot1+1^2)\\\\x^3+1&=(x+1)(x^2-x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)(x^2+2x+4)$",
          "worked": "$$\\begin{align*}x^3-8&=x^3-2^3\\\\x^3-8&=(x-2)(x^2+2x+2^2)\\\\x^3-8&=(x-2)(x^2+2x+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^3+125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+5)(x^2-5x+25)$",
          "worked": "$$\\begin{align*}x^3+125&=x^3+5^3\\\\x^3+125&=(x+5)(x^2-5x+5^2)\\\\x^3+125&=(x+5)(x^2-5x+25).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$8-x^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2-x)(x^2+2x+4)$",
          "worked": "$$\\begin{align*}8-x^3&=2^3-x^3\\\\8-x^3&=(2-x)(2^2+2x+x^2)\\\\8-x^3&=(2-x)(x^2+2x+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$8x^3+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(4x^2-2x+1)$",
          "worked": "$$\\begin{align*}8x^3+1&=(2x)^3+1^3\\\\8x^3+1&=(2x+1)((2x)^2-2x+1)\\\\8x^3+1&=(2x+1)(4x^2-2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$27x^3-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-2)(9x^2+6x+4)$",
          "worked": "$$\\begin{align*}27x^3-8&=(3x)^3-2^3\\\\27x^3-8&=(3x-2)((3x)^2+6x+2^2)\\\\27x^3-8&=(3x-2)(9x^2+6x+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "$x^3+64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(x^2-4x+16)$",
          "worked": "$$\\begin{align*}x^3+64&=x^3+4^3\\\\x^3+64&=(x+4)(x^2-4x+4^2)\\\\x^3+64&=(x+4)(x^2-4x+16).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$8x^3-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x-1)(4x^2+2x+1)$",
          "worked": "$$\\begin{align*}8x^3-1&=(2x)^3-1^3\\\\8x^3-1&=(2x-1)((2x)^2+2x+1)\\\\8x^3-1&=(2x-1)(4x^2+2x+1).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-i",
        "type": "part",
        "label": "i",
        "prompt": "$64x^3-27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x-3)(16x^2+12x+9)$",
          "worked": "$$\\begin{align*}64x^3-27&=(4x)^3-3^3\\\\64x^3-27&=(4x-3)((4x)^2+12x+3^2)\\\\64x^3-27&=(4x-3)(16x^2+12x+9).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-j",
        "type": "part",
        "label": "j",
        "prompt": "$8x^3+27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+3)(4x^2-6x+9)$",
          "worked": "$$\\begin{align*}8x^3+27&=(2x)^3+3^3\\\\8x^3+27&=(2x+3)((2x)^2-6x+3^2)\\\\8x^3+27&=(2x+3)(4x^2-6x+9).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-k",
        "type": "part",
        "label": "k",
        "prompt": "$27x^3-125$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x-5)(9x^2+15x+25)$",
          "worked": "$$\\begin{align*}27x^3-125&=(3x)^3-5^3\\\\27x^3-125&=(3x-5)((3x)^2+15x+5^2)\\\\27x^3-125&=(3x-5)(9x^2+15x+25).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q3-l",
        "type": "part",
        "label": "l",
        "prompt": "$8x^3-1000$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8(x-5)(x^2+5x+25)$\n\nTake out the common factor $8$, then use the difference of cubes.",
          "worked": "$$\\begin{align*}8x^3-1000&=8(x^3-125)\\\\8x^3-1000&=8(x^3-5^3)\\\\8x^3-1000&=8(x-5)(x^2+5x+5^2)\\\\8x^3-1000&=8(x-5)(x^2+5x+25).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
