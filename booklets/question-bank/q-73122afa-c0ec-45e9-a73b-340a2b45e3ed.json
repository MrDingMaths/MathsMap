  "content": {
    "id": "p60-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Find the gradient of the tangent where $t=3$ given $x=(2t-5)(t+1)^3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$176$",
      "worked": "Using the product rule:\n$$\\begin{align*}\\frac{dx}{dt}&=2(t+1)^3+3(2t-5)(t+1)^2\\\\&=(t+1)^2(8t-13).\\end{align*}$$\nAt $t=3$:\n$$\\begin{align*}\\frac{dx}{dt}&=(3+1)^2\\bigl(8(3)-13\\bigr)\\\\&=16\\times11\\\\&=176.\\end{align*}$$",
      "solutionDiagrams": []
    },
