  "content": {
    "id": "p8-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find $\\dfrac{dy}{dx}$ for each function. Then evaluate $\\dfrac{dy}{dx}$ at $x=3$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\log_e(2x-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2}{2x-1}$, $y'(3)=\\dfrac25$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{2}{2x-1}\\\\y'(3)&=\\frac{2}{2(3)-1}\\\\y'(3)&=\\frac25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\log_e(4x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{4}{4x+3}$, $y'(3)=\\dfrac4{15}$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\frac{4}{4x+3}\\\\y'(3)&=\\frac{4}{4(3)+3}\\\\y'(3)&=\\frac4{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=6\\ln(2x+9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{12}{2x+9}$, $y'(3)=\\dfrac45$.",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=6\\left(\\frac{2}{2x+9}\\right)\\\\\\frac{dy}{dx}&=\\frac{12}{2x+9}\\\\y'(3)&=\\frac{12}{2(3)+9}\\\\y'(3)&=\\frac45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
