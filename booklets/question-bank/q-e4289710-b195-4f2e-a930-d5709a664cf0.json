  "content": {
    "id": "p51-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "$y=k(x-2)(x-8)$ is the form of a quadratic with $x$-intercepts at $x=2$ and $x=8$.\nFind the value of $k$ if:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "The coefficient of $x^2$ is $3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=3$",
          "worked": "The coefficient of $x^2$ in $k(x-2)(x-8)$ is $k$, so $k=3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p51-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "The $y$-intercept is $-16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-1$",
          "worked": "At the $y$-intercept, $x=0$.\n$$\\begin{align*}-16&=k(0-2)(0-8)\\\\-16&=16k\\\\k&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p51-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "The vertex is $(5,-12)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=\\dfrac43$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-q14-root-bank-2c0b0f09-5aa6-47c8-9734-9922252a6854",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}-12&=k(5-2)(5-8)\\\\-12&=-9k\\\\k&=\\frac43\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p51-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "The curve passes through $(1,-20)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-\\dfrac{20}{7}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-q14-root-bank-e8bb7b9d-175c-41c0-a317-dab34ede01f5",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.2,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{align*}-20&=k(1-2)(1-8)\\\\-20&=7k\\\\k&=-\\frac{20}{7}\\end{align*}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
