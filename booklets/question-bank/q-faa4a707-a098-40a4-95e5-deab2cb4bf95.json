  "content": {
    "id": "p28-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$48x^2y^3\\div4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^2y^3$",
          "worked": "$$\\begin{align*}48x^2y^3\\div4&=\\frac{48x^2y^3}{4}\\\\48x^2y^3\\div4&=12x^2y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$48x^2y^3\\div8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2y^3$",
          "worked": "$$\\begin{align*}48x^2y^3\\div8&=\\frac{48x^2y^3}{8}\\\\48x^2y^3\\div8&=6x^2y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$48x^2y^3\\div(4x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12xy^3$",
          "worked": "$$\\begin{align*}48x^2y^3\\div(4x)&=\\frac{4x\\times12xy^3}{4x}\\\\48x^2y^3\\div(4x)&=12xy^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$48x^2y^3\\div(8y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^2y^2$",
          "worked": "$$\\begin{align*}48x^2y^3\\div(8y)&=\\frac{8y\\times6x^2y^2}{8y}\\\\48x^2y^3\\div(8y)&=6x^2y^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$48x^2y^3\\div(12xy)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4xy^2$",
          "worked": "$$\\begin{align*}48x^2y^3\\div(12xy)&=\\frac{12xy\\times4xy^2}{12xy}\\\\48x^2y^3\\div(12xy)&=4xy^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$48x^2y^3\\div(6x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8y^3$",
          "worked": "$$\\begin{align*}48x^2y^3\\div(6x^2)&=\\frac{6x^2\\times8y^3}{6x^2}\\\\48x^2y^3\\div(6x^2)&=8y^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$48x^2y^3\\div(6y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8x^2y$",
          "worked": "$$\\begin{align*}48x^2y^3\\div(6y^2)&=\\frac{6y^2\\times8x^2y}{6y^2}\\\\48x^2y^3\\div(6y^2)&=8x^2y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$48x^2y^3\\div(16x^2y^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y$",
          "worked": "$$\\begin{align*}48x^2y^3\\div(16x^2y^2)&=\\frac{16x^2y^2\\times3y}{16x^2y^2}\\\\48x^2y^3\\div(16x^2y^2)&=3y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$48x^2y^3\\div(48x^2y^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$48x^2y^3\\div(48x^2y^3)=1$$\nA nonzero term divided by itself is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
