  "content": {
    "id": "p21-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac13\\right)^2+\\left(\\frac14\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{25}{144}$",
          "worked": "$$\\begin{align*}\\left(\\frac13\\right)^2+\\left(\\frac14\\right)^2&=\\frac19+\\frac1{16}\\\\\\left(\\frac13\\right)^2+\\left(\\frac14\\right)^2&=\\frac{16}{144}+\\frac9{144}\\\\\\left(\\frac13\\right)^2+\\left(\\frac14\\right)^2&=\\frac{25}{144}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac13\\right)^3-\\left(\\frac12\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{19}{216}$",
          "worked": "$$\\begin{align*}\\left(\\frac13\\right)^3-\\left(\\frac12\\right)^3&=\\frac1{27}-\\frac18\\\\\\left(\\frac13\\right)^3-\\left(\\frac12\\right)^3&=\\frac8{216}-\\frac{27}{216}\\\\\\left(\\frac13\\right)^3-\\left(\\frac12\\right)^3&=-\\frac{19}{216}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac23\\right)^2+\\left(\\frac32\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{275}{72}$",
          "worked": "$$\\begin{align*}\\left(\\frac23\\right)^2+\\left(\\frac32\\right)^3&=\\frac49+\\frac{27}{8}\\\\\\left(\\frac23\\right)^2+\\left(\\frac32\\right)^3&=\\frac{32}{72}+\\frac{243}{72}\\\\\\left(\\frac23\\right)^2+\\left(\\frac32\\right)^3&=\\frac{275}{72}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac12\\right)^4-\\left(\\frac12\\right)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{32}$",
          "worked": "$$\\begin{align*}\\left(\\frac12\\right)^4-\\left(\\frac12\\right)^5&=\\frac1{16}-\\frac1{32}\\\\\\left(\\frac12\\right)^4-\\left(\\frac12\\right)^5&=\\frac2{32}-\\frac1{32}\\\\\\left(\\frac12\\right)^4-\\left(\\frac12\\right)^5&=\\frac1{32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac23\\right)^2\\times\\left(\\frac32\\right)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32$",
          "worked": "$$\\begin{align*}\\left(\\frac23\\right)^2\\times\\left(\\frac32\\right)^3&=\\frac49\\times\\frac{27}{8}\\\\\\left(\\frac23\\right)^2\\times\\left(\\frac32\\right)^3&=\\frac12\\times\\frac31\\\\\\left(\\frac23\\right)^2\\times\\left(\\frac32\\right)^3&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p21-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac45\\right)^3\\times\\left(\\frac52\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16}{5}$",
          "worked": "$$\\begin{align*}\\left(\\frac45\\right)^3\\times\\left(\\frac52\\right)^2&=\\frac{64}{125}\\times\\frac{25}{4}\\\\\\left(\\frac45\\right)^3\\times\\left(\\frac52\\right)^2&=\\frac{16}{5}\\times\\frac11\\\\\\left(\\frac45\\right)^3\\times\\left(\\frac52\\right)^2&=\\frac{16}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
