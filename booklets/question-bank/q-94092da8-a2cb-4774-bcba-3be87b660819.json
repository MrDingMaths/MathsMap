  },
  "content": {
    "id": "p60-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the missing values by equating coefficients.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x + 4)(x - 6) + ax + b = x^2 + 8x - 25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = 10,\\ b = -1$",
          "worked": "$$\\begin{align*}\nx^2 - 2x - 24 + ax + b &= x^2 + 8x - 25 \\\\\na - 2 &= 8 \\\\\na &= 10 \\\\\nb - 24 &= -25 \\\\\nb &= -1\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p60-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2x - 5)(2x - 7) + ax^2 + b = 3x^2 - 24x + 12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = -1,\\ b = -23$",
          "worked": "$$\\begin{align*}\n4x^2 - 24x + 35 + ax^2 + b &= 3x^2 - 24x + 12 \\\\\n4 + a &= 3 \\\\\na &= -1 \\\\\n35 + b &= 12 \\\\\nb &= -23\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p60-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x - 2)^2 + x + a(x + b) = x^2 + 1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a = 3,\\ b = -1$",
          "worked": "$$\\begin{align*}\nx^2 - 4x + 4 + x + ax + ab &= x^2 + 1 \\\\\na - 3 &= 0 \\\\\na &= 3 \\\\\n4 + ab &= 1 \\\\\n4 + 3b &= 1 \\\\\nb &= -1\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p60-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x + b)^2 = x^2 + cx + 49$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(b,c) = (7,14)$ or $(-7,-14)$",
          "worked": "$$\\begin{align*}\nx^2 + 2bx + b^2 &= x^2 + cx + 49 \\\\\n2b &= c \\\\\nb^2 &= 49 \\\\\nb &= \\pm 7\n\\end{align*}$$\nIf $b = 7$, then $c = 14$. If $b = -7$, then $c = -14$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p60-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x + 2c)(x + c) = x^2 + dx + 50$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(c,d) = (5,15)$ or $(-5,-15)$",
          "worked": "$$\\begin{align*}\nx^2 + 3cx + 2c^2 &= x^2 + dx + 50 \\\\\n3c &= d \\\\\n2c^2 &= 50 \\\\\nc^2 &= 25 \\\\\nc &= \\pm 5\n\\end{align*}$$\nIf $c = 5$, then $d = 15$. If $c = -5$, then $d = -15$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
