  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Solve for $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{1}{5}\\right)^{x+1}=\\left(\\frac{1}{125}\\right)^{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$",
          "worked": "$\\begin{align*}5^{-x-1}&=5^{-3x+3}\\\\-x-1&=-3x+3\\\\2x&=4\\\\x&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p25-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}=256^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$. The equation becomes $2^{10x}=2^{8x}$.",
          "worked": "$\\begin{align*}\\left(2^{4x}\\times2^{4x}\\times2^{12x}\\right)^{\\frac{1}{2}}&=2^{8x}\\\\\\left(2^{20x}\\right)^{\\frac{1}{2}}&=2^{8x}\\\\2^{10x}&=2^{8x}\\\\10x&=8x\\\\x&=0\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
