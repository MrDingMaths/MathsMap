    "children": [
      {
        "id": "p24-q3a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can three different coins be distributed to five different children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$125$",
          "worked": "Each of the three different coins has five choices of recipient. Children may receive more than one coin.\n$$\\begin{align*}\\text{Number of distributions} &= 5\\times5\\times5\\\\\\text{Number of distributions} &= 125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q3b",
        "type": "part",
        "label": "b",
        "prompt": "What if each child can receive at most one coin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$60$",
          "worked": "For the three different coins, there are respectively five, four and three available recipients, since each child can receive at most one coin.\n$$\\begin{align*}\\text{Number of distributions} &= 5\\times4\\times3\\\\\\text{Number of distributions} &= 60\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
