  "content": {
    "id": "p18-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Give exact values of:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{25}45-\\log_{25}9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\log_{25}45-\\log_{25}9&=\\log_{25}\\left(\\frac{45}{9}\\right)\\\\\\log_{25}45-\\log_{25}9&=\\log_{25}5\\\\\\log_{25}45-\\log_{25}9&=\\log_{25}\\left(25^{1/2}\\right)\\\\\\log_{25}45-\\log_{25}9&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_{81}12-\\log_{81}36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\log_{81}12-\\log_{81}36&=\\log_{81}\\left(\\frac{12}{36}\\right)\\\\\\log_{81}12-\\log_{81}36&=\\log_{81}\\left(\\frac{1}{3}\\right)\\\\\\log_{81}12-\\log_{81}36&=\\log_{81}\\left(81^{-1/4}\\right)\\\\\\log_{81}12-\\log_{81}36&=-\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_8 3-\\log_8 96$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{5}{3}$",
          "worked": "$$\\begin{align*}\\log_8 3-\\log_8 96&=\\log_8\\left(\\frac{3}{96}\\right)\\\\\\log_8 3-\\log_8 96&=\\log_8\\left(\\frac{1}{32}\\right)\\\\\\log_8 3-\\log_8 96&=\\log_8\\left(8^{-5/3}\\right)\\\\\\log_8 3-\\log_8 96&=-\\frac{5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p18-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{\\frac{1}{32}}5-\\log_{\\frac{1}{32}}10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\log_{\\frac{1}{32}}5-\\log_{\\frac{1}{32}}10&=\\log_{\\frac{1}{32}}\\left(\\frac{5}{10}\\right)\\\\\\log_{\\frac{1}{32}}5-\\log_{\\frac{1}{32}}10&=\\log_{\\frac{1}{32}}\\left(\\frac{1}{2}\\right)\\\\\\log_{\\frac{1}{32}}5-\\log_{\\frac{1}{32}}10&=\\log_{\\frac{1}{32}}\\left(\\left(\\frac{1}{32}\\right)^{1/5}\\right)\\\\\\log_{\\frac{1}{32}}5-\\log_{\\frac{1}{32}}10&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
