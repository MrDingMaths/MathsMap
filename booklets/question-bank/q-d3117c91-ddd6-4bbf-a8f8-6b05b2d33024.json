        "id": "v2-25a4f-p19-dividing-slot-9-upper-s9u-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{3x}{4}\\div\\frac{9}{2}+\\frac{x}{6}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{3}$",
          "worked": "$$\\begin{align*}\\frac{3x}{4}\\div\\frac{9}{2}+\\frac{x}{6}&=\\frac{3x}{4}\\times\\frac{2}{9}+\\frac{x}{6}\\\\&=\\frac{x}{6}+\\frac{x}{6}\\\\&=\\frac{x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-25a4f-p19-dividing-slot-9-upper-s9u-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{2a}{3}-\\frac{a}{2}\\times\\frac{4}{9}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4a}{9}$",
          "worked": "$$\\begin{align*}\\frac{2a}{3}-\\frac{a}{2}\\times\\frac{4}{9}&=\\frac{2a}{3}-\\frac{2a}{9}\\\\&=\\frac{6a}{9}-\\frac{2a}{9}\\\\&=\\frac{4a}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-25a4f-p19-dividing-slot-9-upper-s9u-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{3m}{8}+\\frac{5m}{6}\\div\\frac{10}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{5m}{8}$",
          "worked": "$$\\begin{align*}\\frac{3m}{8}+\\frac{5m}{6}\\div\\frac{10}{3}&=\\frac{3m}{8}+\\frac{5m}{6}\\times\\frac{3}{10}\\\\&=\\frac{3m}{8}+\\frac{m}{4}\\\\&=\\frac{3m}{8}+\\frac{2m}{8}\\\\&=\\frac{5m}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-25a4f-p19-dividing-slot-9-upper-s9u-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\left(\\frac{x}{3}+\\frac{x}{6}\\right)\\div\\frac{x}{4}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{3}+\\frac{x}{6}\\right)\\div\\frac{x}{4}&=\\frac{3x}{6}\\div\\frac{x}{4}\\\\&=\\frac{x}{2}\\times\\frac{4}{x}\\\\&=\\frac{4x}{2x}\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
