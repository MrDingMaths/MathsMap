  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Let $\\alpha$ and $\\beta$ be the roots of $x^2-4x+2=0$. Find:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\alpha+\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "$$\\begin{aligned}\\alpha+\\beta&=-\\frac{b}{a}\\\\&=-\\frac{-4}{1}\\\\&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\alpha\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\alpha\\beta&=\\frac{c}{a}\\\\&=\\frac{2}{1}\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\alpha^2\\beta+\\alpha\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "$$\\begin{aligned}\\alpha^2\\beta+\\alpha\\beta^2&=\\alpha\\beta(\\alpha+\\beta)\\\\&=2(4)\\\\&=8\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{1}{\\alpha}+\\dfrac{1}{\\beta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\frac{1}{\\alpha}+\\frac{1}{\\beta}&=\\frac{\\alpha+\\beta}{\\alpha\\beta}\\\\&=\\frac{4}{2}\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$(\\alpha+2)(\\beta+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{aligned}(\\alpha+2)(\\beta+2)&=\\alpha\\beta+2\\alpha+2\\beta+4\\\\&=\\alpha\\beta+2(\\alpha+\\beta)+4\\\\&=2+2(4)+4\\\\&=14\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\alpha^2+\\beta^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12$",
          "worked": "$$\\begin{aligned}\\alpha^2+\\beta^2&=(\\alpha+\\beta)^2-2\\alpha\\beta\\\\&=4^2-2(2)\\\\&=12\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p7-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{\\alpha}{\\beta}+\\dfrac{\\beta}{\\alpha}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{aligned}\\frac{\\alpha}{\\beta}+\\frac{\\beta}{\\alpha}&=\\frac{\\alpha^2+\\beta^2}{\\alpha\\beta}\\\\&=\\frac{(\\alpha+\\beta)^2-2\\alpha\\beta}{\\alpha\\beta}\\\\&=\\frac{4^2-2(2)}{2}\\\\&=6\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\alpha\\beta^3+\\alpha^3\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{aligned}\\alpha\\beta^3+\\alpha^3\\beta&=\\alpha\\beta(\\alpha^2+\\beta^2)\\\\&=\\alpha\\beta\\bigl((\\alpha+\\beta)^2-2\\alpha\\beta\\bigr)\\\\&=2\\bigl(4^2-2(2)\\bigr)\\\\&=24\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\left(\\alpha+\\dfrac{1}{\\alpha}\\right)\\left(\\beta+\\dfrac{1}{\\beta}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{17}{2}$",
          "worked": "$$\\begin{aligned}\\left(\\alpha+\\frac{1}{\\alpha}\\right)\\left(\\beta+\\frac{1}{\\beta}\\right)&=\\alpha\\beta+\\frac{\\alpha}{\\beta}+\\frac{\\beta}{\\alpha}+\\frac{1}{\\alpha\\beta}\\\\&=\\alpha\\beta+\\frac{\\alpha^2+\\beta^2}{\\alpha\\beta}+\\frac{1}{\\alpha\\beta}\\\\&=2+\\frac{12}{2}+\\frac{1}{2}\\\\&=\\frac{17}{2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
