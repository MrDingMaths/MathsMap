  "content": {
    "id": "p12-q11",
    "type": "question",
    "label": "11",
    "prompt": "A rectangular prism storage crate measures $0.8$ m by $1$ m by $1.5$ m.\nClaudia paints all the faces of the crate.\nOne tin of paint costs $\\$8$. Each tin covers $4\\text{ m}^2$.\nWork out the total cost of the paint that Claudia needs.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$16$",
      "worked": "$$\\begin{align*}A&=2(0.8\\times1)+2(0.8\\times1.5)+2(1\\times1.5)\\\\&=1.6+2.4+3\\\\&=7\\text{ m}^2\\\\\\text{Tins required}&=7\\div4\\\\&=1.75\\end{align*}$$\nClaudia needs $2$ whole tins.\n$$\\begin{align*}\\text{Cost}&=\\$8\\times2\\\\&=\\$16\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 43
  },
