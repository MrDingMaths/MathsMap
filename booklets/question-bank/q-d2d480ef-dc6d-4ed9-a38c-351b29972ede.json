      {
        "id": "p10-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^2(x+1)^4\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{242}{5}$",
          "worked": "$$\\begin{align*}\\int_0^2(x+1)^4\\,dx&=\\left[\\frac{(x+1)^5}{5}\\right]_0^2\\\\&=\\frac{3^5-1^5}{5}\\\\&=\\frac{242}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p10-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_2^3(2x-5)^3\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\int_2^3(2x-5)^3\\,dx&=\\left[\\frac{(2x-5)^4}{8}\\right]_2^3\\\\&=\\frac{1^4-(-1)^4}{8}\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p10-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_{-2}^2(1-x)^5\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{364}{3}$",
          "worked": "$$\\begin{align*}\\int_{-2}^2(1-x)^5\\,dx&=\\left[-\\frac{(1-x)^6}{6}\\right]_{-2}^2\\\\&=-\\frac{(-1)^6}{6}+\\frac{3^6}{6}\\\\&=\\frac{728}{6}\\\\&=\\frac{364}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_0^5\\left(1-\\frac{x}{5}\\right)^4\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}\\int_0^5\\left(1-\\frac{x}{5}\\right)^4\\,dx&=\\left[\\frac{(1-x/5)^5}{(-1/5)(5)}\\right]_0^5\\\\&=\\left[-(1-x/5)^5\\right]_0^5\\\\&=-0^5+1^5\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_0^1\\sqrt{9-8x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13}{6}$",
          "worked": "$$\\begin{align*}\\int_0^1\\sqrt{9-8x}\\,dx&=\\left[\\frac{(9-8x)^{3/2}}{-8(3/2)}\\right]_0^1\\\\&=\\left[-\\frac{(9-8x)^{3/2}}{12}\\right]_0^1\\\\&=\\frac{-1+27}{12}\\\\&=\\frac{13}{6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_2^7\\frac{1}{\\sqrt{x+2}}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\int_2^7\\frac{1}{\\sqrt{x+2}}\\,dx&=\\left[2\\sqrt{x+2}\\right]_2^7\\\\&=2\\sqrt9-2\\sqrt4\\\\&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p10-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\displaystyle\\int_{-2}^0\\sqrt[3]{x+1}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\int_{-2}^0\\sqrt[3]{x+1}\\,dx&=\\left[\\frac34\\left(\\sqrt[3]{x+1}\\right)^4\\right]_{-2}^0\\\\&=\\frac34\\left(1^4-(-1)^4\\right)\\\\&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p10-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\displaystyle\\int_1^5\\sqrt{3x+1}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{112}{9}$",
          "worked": "$$\\begin{align*}\\int_1^5\\sqrt{3x+1}\\,dx&=\\left[\\frac{(3x+1)^{3/2}}{3(3/2)}\\right]_1^5\\\\&=\\frac29\\left(16^{3/2}-4^{3/2}\\right)\\\\&=\\frac29(64-8)\\\\&=\\frac{112}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q13-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\displaystyle\\int_{-3}^0\\sqrt{1-5x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{42}{5}$",
          "worked": "$$\\begin{align*}\\int_{-3}^0\\sqrt{1-5x}\\,dx&=\\left[\\frac{(1-5x)^{3/2}}{-5(3/2)}\\right]_{-3}^0\\\\&=-\\frac{2}{15}\\left(1-16^{3/2}\\right)\\\\&=\\frac{126}{15}\\\\&=\\frac{42}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
