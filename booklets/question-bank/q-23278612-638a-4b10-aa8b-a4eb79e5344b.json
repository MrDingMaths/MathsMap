    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{x-2}-\\dfrac{2}{x-1}+\\dfrac{1}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x-7}{(x-2)(x-1)(x-3)}$",
          "worked": "$$\\begin{align*}\\frac{1}{x-2}-\\frac{2}{x-1}+\\frac{1}{x-3}&=\\frac{(x-1)(x-3)-2(x-2)(x-3)+(x-2)(x-1)}{(x-2)(x-1)(x-3)}\\\\\\frac{1}{x-2}-\\frac{2}{x-1}+\\frac{1}{x-3}&=\\frac{x^2-4x+3-2x^2+10x-12+x^2-3x+2}{(x-2)(x-1)(x-3)}\\\\\\frac{1}{x-2}-\\frac{2}{x-1}+\\frac{1}{x-3}&=\\frac{3x-7}{(x-2)(x-1)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p36-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3x}{x^2-3x+2}-\\dfrac{4}{x-1}+\\dfrac{1}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{7}{(x-1)(x-2)}$",
          "worked": "$$x^2-3x+2=(x-1)(x-2)$$\n$$\\begin{align*}\\frac{3x}{x^2-3x+2}-\\frac{4}{x-1}+\\frac{1}{x-2}&=\\frac{3x-4(x-2)+(x-1)}{(x-1)(x-2)}\\\\\\frac{3x}{x^2-3x+2}-\\frac{4}{x-1}+\\frac{1}{x-2}&=\\frac{3x-4x+8+x-1}{(x-1)(x-2)}\\\\\\frac{3x}{x^2-3x+2}-\\frac{4}{x-1}+\\frac{1}{x-2}&=\\frac{7}{(x-1)(x-2)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      },
      {
        "id": "p36-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{8}{x^2-5x+6}-\\dfrac{5}{x^2-3x+2}-\\dfrac{3}{x^2-4x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{13}{(x-1)(x-2)(x-3)}$\n\nFactor the denominators, then combine over their lowest common denominator.",
          "worked": "$$\\begin{align*}x^2-5x+6&=(x-2)(x-3)\\\\x^2-3x+2&=(x-1)(x-2)\\\\x^2-4x+3&=(x-1)(x-3)\\end{align*}$$\n$$\\begin{align*}\\frac{8}{x^2-5x+6}-\\frac{5}{x^2-3x+2}-\\frac{3}{x^2-4x+3}&=\\frac{8(x-1)-5(x-3)-3(x-2)}{(x-1)(x-2)(x-3)}\\\\\\frac{8}{x^2-5x+6}-\\frac{5}{x^2-3x+2}-\\frac{3}{x^2-4x+3}&=\\frac{8x-8-5x+15-3x+6}{(x-1)(x-2)(x-3)}\\\\\\frac{8}{x^2-5x+6}-\\frac{5}{x^2-3x+2}-\\frac{3}{x^2-4x+3}&=\\frac{13}{(x-1)(x-2)(x-3)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
