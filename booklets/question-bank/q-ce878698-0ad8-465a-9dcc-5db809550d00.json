  "content": {
    "id": "p47-q13-response",
    "type": "question",
    "label": "",
    "prompt": "A jar contains 12 red, 10 black and 13 white lollies.\nAlex picks out a red lolly and eats it. He then randomly picks a second lolly.\nWhat is the probability that the second lolly is also red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{11}{34}$",
      "worked": "After Alex eats a red lolly, 11 red lollies remain among 34 lollies.\n$$\\begin{align*}P(\\text{second red}\\mid\\text{first red})&=\\frac{12-1}{12+10+13-1}\\\\&=\\frac{11}{34}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
