        "answer": {
          "short": "$1$",
          "worked": "$D(-1,-2)$ and $B(3,2)$.\n$$\\begin{align*}m_{DB}&=\\frac{y_2-y_1}{x_2-x_1}\\\\m_{DB}&=\\frac{2-(-2)}{3-(-1)}\\\\m_{DB}&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
