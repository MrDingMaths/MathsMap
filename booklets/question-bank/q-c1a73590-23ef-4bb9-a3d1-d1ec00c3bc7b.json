        "answer": {
          "short": "$-1$",
          "worked": "$F(1,4)$ and $B(3,2)$.\n$$\\begin{align*}m_{FB}&=\\frac{y_2-y_1}{x_2-x_1}\\\\m_{FB}&=\\frac{2-4}{3-1}\\\\m_{FB}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p8-q1-d",
        "type": "part",
