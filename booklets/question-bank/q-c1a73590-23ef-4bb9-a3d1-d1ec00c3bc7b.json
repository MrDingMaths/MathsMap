        "prompt": "$A$ to $E$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$A(-2,3)$ and $E(3,-2)$.\n$$\\begin{align*}m_{AE}&=\\frac{y_2-y_1}{x_2-x_1}\\\\m_{AE}&=\\frac{-2-3}{3-(-2)}\\\\m_{AE}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
