        "answer": {
          "short": "$0$",
          "worked": "$D(-1,-2)$ and $E(3,-2)$.\n$$\\begin{align*}m_{DE}&=\\frac{y_2-y_1}{x_2-x_1}\\\\m_{DE}&=\\frac{-2-(-2)}{3-(-1)}\\\\m_{DE}&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
