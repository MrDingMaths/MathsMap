        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2}{6}-\\frac{2a}{3}-2$",
          "worked": "$$\\begin{align*}\\left(\\frac{a}{2}+1\\right)\\left(\\frac{a}{3}-2\\right)&=\\frac{a^2}{6}-a+\\frac{a}{3}-2\\\\\\left(\\frac{a}{2}+1\\right)\\left(\\frac{a}{3}-2\\right)&=\\frac{a^2}{6}-\\frac{2a}{3}-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p29-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{2x}{3}+6\\right)(x-4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x^2}{3}+\\frac{10x}{3}-24$",
          "worked": "$$\\begin{align*}\\left(\\frac{2x}{3}+6\\right)(x-4)&=\\frac{2x^2}{3}-\\frac{8x}{3}+6x-24\\\\\\left(\\frac{2x}{3}+6\\right)(x-4)&=\\frac{2x^2}{3}+\\frac{10x}{3}-24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p29-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{a}{2}-1\\right)\\left(\\frac{a}{2}+1\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2}{4}-1$",
          "worked": "$$\\begin{align*}\\left(\\frac{a}{2}-1\\right)\\left(\\frac{a}{2}+1\\right)&=\\left(\\frac{a}{2}\\right)^2-1^2\\\\\\left(\\frac{a}{2}-1\\right)\\left(\\frac{a}{2}+1\\right)&=\\frac{a^2}{4}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p29-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{3x}{5}-1\\right)\\left(\\frac{2x}{5}+3\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6x^2}{25}+\\frac{7x}{5}-3$",
          "worked": "$$\\begin{align*}\\left(\\frac{3x}{5}-1\\right)\\left(\\frac{2x}{5}+3\\right)&=\\frac{6x^2}{25}+\\frac{9x}{5}-\\frac{2x}{5}-3\\\\\\left(\\frac{3x}{5}-1\\right)\\left(\\frac{2x}{5}+3\\right)&=\\frac{6x^2}{25}+\\frac{7x}{5}-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
