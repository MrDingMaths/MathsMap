  "content": {
    "id": "p35-q7-root",
    "type": "question",
    "label": null,
    "prompt": "Solve each pair of equations for $x$ and $y$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$25^x=125^y$, $16^x\\div8=2\\times4^{2y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$, $y=2$",
          "worked": "Express both sides using common bases and equate indices.\n$$\\begin{align*}5^{2x}&=5^{3y}\\\\2x&=3y\\\\2^{4x-3}&=2^{1+4y}\\\\4x-3&=1+4y\\\\x-y&=1\\\\2(y+1)&=3y\\\\y&=2\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p35-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^{y-1}=9^x$, $4^y\\times64^x=128$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac12$, $y=2$",
          "worked": "$$\\begin{align*}3^{y-1}&=3^{2x}\\\\y-1&=2x\\\\y&=2x+1\\\\2^{2y+6x}&=2^7\\\\2y+6x&=7\\\\2(2x+1)+6x&=7\\\\10x&=5\\\\x&=\\frac12\\\\y&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p35-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$10^{5y}=10^5\\times100^x$, $49^y=7\\times7^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$, $y=3$",
          "worked": "$$\\begin{align*}10^{5y}&=10^{5+2x}\\\\5y&=5+2x\\\\7^{2y}&=7^{1+x}\\\\2y&=1+x\\\\x&=2y-1\\\\5y&=5+2(2y-1)\\\\y&=3\\\\x&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p35-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$a^{2x}=a^{y-1}$, $b^{2+y}=b^{3x}$, where $a,b>0$ and $a,b\\ne1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$, $y=7$, assuming $a,b>0$ and $a,b\\ne1$.",
          "worked": "For positive bases other than 1, equate indices.\n$$\\begin{align*}2x&=y-1\\\\y&=2x+1\\\\2+y&=3x\\\\2+(2x+1)&=3x\\\\x&=3\\\\y&=7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
