      {
        "id": "p5-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each side of the triangle formed by $P(0,3)$, $Q(1,7)$ and $R(5,8)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PQ=QR=\\sqrt{17}$ units; $PR=\\sqrt{50}$ units.",
          "worked": "$$\\begin{align*}PQ&=\\sqrt{(1-0)^2+(7-3)^2}\\\\PQ&=\\sqrt{17}\\text{ units}\\\\QR&=\\sqrt{(5-1)^2+(8-7)^2}\\\\QR&=\\sqrt{17}\\text{ units}\\\\PR&=\\sqrt{(5-0)^2+(8-3)^2}\\\\PR&=\\sqrt{50}\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p5-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that $\\triangle PQR$ is isosceles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PQ=QR=\\sqrt{17}$, so $\\triangle PQR$ is isosceles.",
          "worked": "$PQ=QR=\\sqrt{17}$. The triangle has two sides of equal length, so $\\triangle PQR$ is isosceles.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
