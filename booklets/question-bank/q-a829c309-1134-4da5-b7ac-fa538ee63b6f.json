  "content": {
    "id": "v2-69002-p11-practice-slot-3-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Determine whether $f(x)=\\sin^{-1}x-2\\tan^{-1}x$ is an odd function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes, $f$ is odd, since $f(-x)=-f(x)$.",
      "worked": "$$\\begin{aligned}f(-x)&=\\sin^{-1}(-x)-2\\tan^{-1}(-x)\\\\&=-\\sin^{-1}x+2\\tan^{-1}x\\\\&=-\\left(\\sin^{-1}x-2\\tan^{-1}x\\right)\\\\&=-f(x)\\end{aligned}$$\nHence $f$ is odd.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
