  "content": {
    "id": "p19-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "It is given that $a(x+3)+b(x-2)=3x-1$ for all values of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "Substitute $x=2$ to find $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1$",
          "worked": "Substitute $x=2$:\n$$\\begin{align*}5a+0b&=5\\\\5a&=5\\\\a&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute $x=-3$ to find $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=2$",
          "worked": "Substitute $x=-3$:\n$$\\begin{align*}0a-5b&=-10\\\\-5b&=-10\\\\b&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p19-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Why were the values $x=2$ and $x=-3$ chosen?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each makes one bracket zero, eliminating one unknown.",
          "worked": "When $x=2$, the bracket $x-2$ is zero, leaving an equation in $a$ only. When $x=-3$, the bracket $x+3$ is zero, leaving an equation in $b$ only.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p19-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "Equate the coefficients of like terms to get a pair of simultaneous equations in $a$ and $b$, then solve them. Do you get the same answer?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b=3$, $3a-2b=-1$; hence $a=1$, $b=2$. Yes, the answers agree.",
          "worked": "Expanding the left-hand side gives $(a+b)x+3a-2b$. Equating coefficients:\n$$\\begin{align*}a+b&=3\\qquad(1)\\\\3a-2b&=-1\\qquad(2)\n\\end{align*}$$\nAdd twice equation (1) to equation (2):\n$$\\begin{align*}5a&=5\\\\a&=1\\end{align*}$$\nSubstitute into equation (1):\n$$\\begin{align*}1+b&=3\\\\b&=2\\end{align*}$$\nYes, these are the same answers as in parts a and b.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
