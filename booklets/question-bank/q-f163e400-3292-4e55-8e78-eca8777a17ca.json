    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "the floor area in square metres",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$49.92\\text{ m}^2$",
          "worked": "$6400$ mm $=6.4$ m and $7800$ mm $=7.8$ m, so $A=6.4\\times7.8=49.92\\text{ m}^2$.",
