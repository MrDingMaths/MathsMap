  "content": {
    "id": "v2-7bec8-p22-practice-j4-104354-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $\\sqrt{450}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7bec8-p22-practice-j4-104354-j4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Which of $4,\\ 9,\\ 25,\\ 100$ and $225$ are factors of $450$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9,\\ 25$ and $225$",
          "worked": "$$\\begin{align*}450\\div4&=112.5\\\\450\\div9&=50\\\\450\\div25&=18\\\\450\\div100&=4.5\\\\450\\div225&=2\\end{align*}$$\n$9,\\ 25$ and $225$ are factors of $450$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-7bec8-p22-practice-j4-104354-j4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, simplify $\\sqrt{450}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15\\sqrt{2}$",
          "worked": "The highest square factor is $225$.\n$$\\begin{align*}\\sqrt{450}&=\\sqrt{225\\times2}\\\\&=\\sqrt{225}\\times\\sqrt{2}\\\\&=15\\sqrt{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
