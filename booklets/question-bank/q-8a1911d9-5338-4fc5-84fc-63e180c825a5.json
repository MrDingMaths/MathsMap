  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Do not use a calculator.\n\nExpress each logarithm in terms of $\\log_2 3$ and $\\log_2 5$. Remember that $\\log_2 2=1$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_2 3$",
          "worked": "$$\\begin{align*}\\log_2 9&=\\log_2(3^2)\\\\\\log_2 9&=2\\log_2 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_2 25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\log_2 5$",
          "worked": "$$\\begin{align*}\\log_2 25&=\\log_2(5^2)\\\\\\log_2 25&=2\\log_2 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p22-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\log_2 3$",
          "worked": "$$\\begin{align*}\\log_2 6&=\\log_2(2\\times3)\\\\\\log_2 6&=\\log_2 2+\\log_2 3\\\\\\log_2 6&=1+\\log_2 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_2 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+\\log_2 5$",
          "worked": "$$\\begin{align*}\\log_2 10&=\\log_2(2\\times5)\\\\\\log_2 10&=\\log_2 2+\\log_2 5\\\\\\log_2 10&=1+\\log_2 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_2 18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+2\\log_2 3$",
          "worked": "$$\\begin{align*}\\log_2 18&=\\log_2(2\\times3^2)\\\\\\log_2 18&=\\log_2 2+2\\log_2 3\\\\\\log_2 18&=1+2\\log_2 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_2 20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\log_2 5$",
          "worked": "$$\\begin{align*}\\log_2 20&=\\log_2(2^2\\times5)\\\\\\log_2 20&=2\\log_2 2+\\log_2 5\\\\\\log_2 20&=2+\\log_2 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_2\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-\\log_2 3$",
          "worked": "$$\\begin{align*}\\log_2\\frac{2}{3}&=\\log_2 2-\\log_2 3\\\\\\log_2\\frac{2}{3}&=1-\\log_2 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p22-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_2\\left(2\\frac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1+\\log_2 5$",
          "worked": "$$\\begin{align*}\\log_2\\left(2\\frac{1}{2}\\right)&=\\log_2\\frac{5}{2}\\\\\\log_2\\left(2\\frac{1}{2}\\right)&=\\log_2 5-\\log_2 2\\\\\\log_2\\left(2\\frac{1}{2}\\right)&=-1+\\log_2 5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
