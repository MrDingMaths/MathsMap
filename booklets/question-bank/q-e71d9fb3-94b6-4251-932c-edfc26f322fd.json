  "content": {
    "id": "p9-f2-root",
    "type": "question",
    "label": "2",
    "prompt": "Express the following in index form. Assume $x>0$ and $n$ is an integer with $n\\ge 2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-f2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac12}$",
          "worked": "$$\\sqrt{x}=x^{\\frac12}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-f2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac32}$",
          "worked": "$$\\begin{align*}x\\sqrt{x}&=x^{1+\\frac12}\\\\[0.8mm]&=x^{\\frac32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-f2-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac52}$",
          "worked": "$$\\begin{align*}x^2\\sqrt{x}&=x^{2+\\frac12}\\\\[0.8mm]&=x^{\\frac52}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-f2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{-\\frac12}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{x}}&=\\frac{1}{x^{\\frac12}}\\\\\\frac{1}{\\sqrt{x}}&=x^{-\\frac12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p9-f2-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt[n]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac1n}$",
          "worked": "$$\\sqrt[n]{x}=x^{\\frac1n}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-f2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt[n]{x^m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{\\frac mn}$",
          "worked": "$$\\begin{align*}\\sqrt[n]{x^m}&=(x^m)^{\\frac1n}\\\\[0.8mm]&=x^{\\frac mn}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
