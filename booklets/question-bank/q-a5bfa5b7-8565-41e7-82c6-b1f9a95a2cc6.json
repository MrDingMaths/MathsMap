  "content": {
    "id": "v2-x-topic-8-practice-j19-104053-root",
    "type": "question",
    "label": null,
    "prompt": "Work out each pair of values.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-x-topic-8-practice-j19-104053-j19-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2\\times3)^{2}$ and $2^{2}\\times3^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$ and $36$",
          "worked": "$$\\begin{align*}(2\\times3)^{2}&=6^{2}=36\\\\2^{2}\\times3^{2}&=4\\times9=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-x-topic-8-practice-j19-104053-j19-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2+3)^{2}$ and $2^{2}+3^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25$ and $13$",
          "worked": "$$\\begin{align*}(2+3)^{2}&=5^{2}=25\\\\2^{2}+3^{2}&=4+9=13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-x-topic-8-practice-j19-104053-j19-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Use your answers to a and b to explain why $(ab)^{2}=a^{2}b^{2}$ but $(a+b)^{2}\\ne a^{2}+b^{2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The power applies to every factor in a product, so $(2\\times3)^{2}=2^{2}\\times3^{2}$. It does not apply to each term of a sum: $25\\ne13$.",
          "worked": "Part a gives equal values, so the power can be shared across the factors of a product. Part b gives $25$ and $13$, so the power cannot be shared across the terms of a sum.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "v2-x-topic-8-practice-j19-104053-j19-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Amir says $(a+b)^{3}=a^{3}+b^{3}$. Use $a=1$ and $b=1$ to show he is wrong.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(1+1)^{3}=8$ but $1^{3}+1^{3}=2$",
          "worked": "$$\\begin{align*}(1+1)^{3}&=2^{3}=8\\\\1^{3}+1^{3}&=1+1=2\\end{align*}$$ Since $8\\ne2$, Amir is wrong.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
