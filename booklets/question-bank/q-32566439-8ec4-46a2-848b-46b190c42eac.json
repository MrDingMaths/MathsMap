  "content": {
    "id": "p21-q21-root",
    "type": "question",
    "label": null,
    "prompt": "The regular hexagon below has side length $1$. A circle passes through each of its vertices.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p21-q21-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 21, p21-q21-diagram\"}\n\\begin{tikzpicture}[x=2cm,y=2cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black] (0,0) circle[radius=1];\n\\draw[black] (0:1)--(60:1)--(120:1)--(180:1)--(240:1)--(300:1)--cycle;\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 40,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 21,
          "sourceRegion": "Question 21, lower right",
          "description": "Regular hexagon inscribed in a circle, with horizontal top and bottom sides. The source red interior is omitted under the unshaded house convention.",
          "mathematics": "All six vertices lie on the circle. The regular hexagon has side length 1, supplied in the stem.",
          "answerVisibility": "No radii, construction lines or derived measurements appear in the question figure."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p21-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the perimeter of the hexagon. Hint: divide the hexagon into equilateral triangles.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}P&=6\\times1\\\\P&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p21-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the circumference of the circle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\pi$",
          "worked": "Joining the centre to the six vertices forms six equilateral triangles. Each radius therefore equals the side length, so $r=1$.\n\n$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi\\times1\\\\C&=2\\pi\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p21-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "Explain how this shows $\\pi>3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\pi>3$.\n\nThe circle’s circumference exceeds the hexagon’s perimeter, so $2\\pi>6$.",
          "worked": "Each arc between adjacent vertices is longer than the straight side joining them. Hence the circle’s circumference exceeds the hexagon’s perimeter.\n\n$$\\begin{align*}2\\pi&>6\\\\\\pi&>3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
