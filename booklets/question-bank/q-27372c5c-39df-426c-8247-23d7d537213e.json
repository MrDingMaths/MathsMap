  "content": {
    "id": "p17-p2-root",
    "type": "question",
    "label": "6",
    "prompt": "Eliminate $\\theta$ from each of the following by using one of the trig identities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-p2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\operatorname{cosec}\\theta$ and $y=2\\cot\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-y^2=4$",
          "worked": "Since $\\operatorname{cosec}^2\\theta-\\cot^2\\theta=1$:\n$$\\begin{align*}x^2-\\left(\\frac y2\\right)^2&=1\\\\4x^2-y^2&=4.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p17-p2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=3\\sec\\theta$ and $y=3\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-y^2=9$",
          "worked": "Since $\\sec^2\\theta-\\tan^2\\theta=1$:\n$$\\begin{align*}\\left(\\frac x3\\right)^2-\\left(\\frac y3\\right)^2&=1\\\\x^2-y^2&=9.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
