  "content": {
    "id": "p39-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find the amount required for each of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "A bottle of shampoo is labelled \"25% extra free\". The bottle contains 250 mL of shampoo. Work out how much shampoo a normal-sized bottle contains.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "200 mL",
          "worked": "The bottle contains $125\\%$ of the normal amount.\n$$\\begin{align*}125\\% &= 250\\text{ mL}\\\\1\\% &= \\frac{250}{125}\\text{ mL}=2\\text{ mL}\\\\100\\% &= 2\\times100\\text{ mL}=200\\text{ mL}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Abby’s restaurant bill comes to \\$38.50. This includes a 10% service charge. Calculate the cost of the meal before the service charge was added.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$35",
          "worked": "The bill represents $110\\%$ of the meal cost.\n$$\\begin{align*}110\\% &= \\$38.50\\\\1\\% &= \\frac{\\$38.50}{110}=\\$0.35\\\\100\\% &= \\$0.35\\times100=\\$35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "A sunflower is 180 cm tall. This is an increase of 5% on its height a week earlier. What was the height last week? Answer to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "171.4 cm",
          "worked": "The current height represents $105\\%$ of last week's height.\n$$\\begin{align*}105\\% &= 180\\text{ cm}\\\\1\\% &= \\frac{180}{105}\\text{ cm}=\\frac{12}{7}\\text{ cm}\\\\100\\% &= \\frac{12}{7}\\times100\\text{ cm}=\\frac{1200}{7}\\text{ cm}\\\\100\\% &\\approx171.4\\text{ cm}\\end{align*}$$\nLast week's height was 171.4 cm, to 1 decimal place.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p39-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Emily sells her car for \\$3500. She makes a 12% profit on the price she paid. How much did Emily pay for the car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3125",
          "worked": "The selling price represents $112\\%$ of the price Emily paid.\n$$\\begin{align*}112\\% &= \\$3500\\\\1\\% &= \\frac{\\$3500}{112}=\\$31.25\\\\100\\% &= \\$31.25\\times100=\\$3125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "After an 8% pay rise, Faith earns \\$91.80 a week. How much was Faith paid before the pay rise?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$85 a week",
          "worked": "The new weekly pay represents $108\\%$ of the original pay.\n$$\\begin{align*}108\\% &= \\$91.80\\\\1\\% &= \\frac{\\$91.80}{108}=\\$0.85\\\\100\\% &= \\$0.85\\times100=\\$85\\end{align*}$$\nFaith was paid \\$85 a week.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "The cost of a theatre ticket is reduced by 5% to \\$42.75. What was the cost before the decrease?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$45",
          "worked": "The reduced price represents $95\\%$ of the original cost.\n$$\\begin{align*}95\\% &= \\$42.75\\\\1\\% &= \\frac{\\$42.75}{95}=\\$0.45\\\\100\\% &= \\$0.45\\times100=\\$45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "Because of a 10% increase, the price of Chloe's train ticket increases by \\$2.30. Work out the price before the increase.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$23",
          "worked": "The increase of \\$2.30 represents $10\\%$ of the original price.\n$$\\begin{align*}10\\% &= \\$2.30\\\\1\\% &= \\frac{\\$2.30}{10}=\\$0.23\\\\100\\% &= \\$0.23\\times100=\\$23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p39-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "In a sale, the price of a fridge is reduced by 40%. The fridge now costs \\$279. Work out the original price of the fridge.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$465",
          "worked": "The sale price represents $60\\%$ of the original price.\n$$\\begin{align*}60\\% &= \\$279\\\\1\\% &= \\frac{\\$279}{60}=\\$4.65\\\\100\\% &= \\$4.65\\times100=\\$465\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "A pair of jeans cost \\$59.50 in a \"15% off everything\" sale. How much did the jeans cost before the sale?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$70",
          "worked": "The sale price represents $85\\%$ of the original price.\n$$\\begin{align*}85\\% &= \\$59.50\\\\1\\% &= \\frac{\\$59.50}{85}=\\$0.70\\\\100\\% &= \\$0.70\\times100=\\$70\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "A car dealer makes a 25% profit when she sells a car for \\$4000. How much did she pay for the car?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$3200",
          "worked": "The selling price represents $125\\%$ of the price she paid.\n$$\\begin{align*}125\\% &= \\$4000\\\\1\\% &= \\frac{\\$4000}{125}=\\$32\\\\100\\% &= \\$32\\times100=\\$3200\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
