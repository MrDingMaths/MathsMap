  "content": {
    "id": "p45-q60-root",
    "type": "question",
    "label": "60",
    "prompt": "A stack of logs has 1 on the top, then 3 on the next row down, and each successive row has 2 more logs than the one on top of it.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q60-a",
        "type": "part",
        "label": "a",
        "prompt": "How many logs are in the 20th row?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "39 logs",
          "worked": "$a=1$, $d=2$.\n$$\\begin{align*}a_{20}&=a+19d\\\\a_{20}&=1+19(2)\\\\a_{20}&=39\\end{align*}$$\nThere are 39 logs in the 20th row.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p45-q60-b",
        "type": "part",
        "label": "b",
        "prompt": "Which row has 57 logs?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The 29th row.",
          "worked": "$$\\begin{align*}a_n&=57\\\\1+(n-1)2&=57\\\\1+2n-2&=57\\\\2n&=58\\\\n&=29\\end{align*}$$\nThe 29th row has 57 logs.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p45-q60-c",
        "type": "part",
        "label": "c",
        "prompt": "If there are 1024 logs altogether, how many rows are in the stack?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "32 rows",
          "worked": "$a=1$, $d=2$, $S_n=1024$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2a+(n-1)d]\\\\1024&=\\frac{n}{2}[2(1)+(n-1)2]\\\\2048&=n[2+2n-2]\\\\2048&=2n^2\\\\n^2&=1024\\\\n&=32\\end{align*}$$\nSince the number of rows is positive, the stack has 32 rows.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
