  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "By drawing a sketch, or otherwise, solve the following inequalities.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x-4\\leq 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq 2$",
          "worked": "$$\\begin{align*}2x-4&\\leq 0\\\\2x&\\leq 4\\\\x&\\leq 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p24-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$1-3x\\geq 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\leq \\frac{1}{3}$",
          "worked": "$$\\begin{align*}1-3x&\\geq 0\\\\-3x&\\geq -1\\\\x&\\leq \\frac{1}{3}\\end{align*}$$Dividing by $-3$ reverses the inequality sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$2-\\frac{1}{2}x<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>4$",
          "worked": "$$\\begin{align*}2-\\frac{1}{2}x&<0\\\\-\\frac{1}{2}x&<-2\\\\x&>4\\end{align*}$$Multiplying by $-2$ reverses the inequality sign.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2x}{3}+\\frac{1}{2}>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>-\\frac{3}{4}$",
          "worked": "$$\\begin{align*}\\frac{2x}{3}+\\frac{1}{2}&>0\\\\\\frac{2x}{3}&>-\\frac{1}{2}\\\\x&>-\\frac{1}{2}\\times\\frac{3}{2}\\\\x&>-\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
