    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$",
      "worked": "$$\\begin{align*}(12\\,345)^2-(12\\,344)(12\\,346)&=(12\\,345)^2-(12\\,345-1)(12\\,345+1)\\\\(12\\,345)^2-(12\\,344)(12\\,346)&=(12\\,345)^2-\\big((12\\,345)^2-1\\big)\\\\(12\\,345)^2-(12\\,344)(12\\,346)&=1.\\end{align*}$$",
