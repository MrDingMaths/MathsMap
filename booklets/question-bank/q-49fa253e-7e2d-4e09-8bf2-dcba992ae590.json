  "content": {
    "id": "p20-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Eliminate $\\theta$ from the following by using a relevant trigonometric identity.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\cos\\theta$ and $y=2\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+y^2=4$.",
          "worked": "$$\\begin{align*}\\cos^2\\theta+\\sin^2\\theta&=1\\\\x^2+\\left(\\frac{y}{2}\\right)^2&=1\\\\4x^2+y^2&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p20-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=3\\sec\\theta$ and $y=4\\tan\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16x^2-9y^2=144$.",
          "worked": "$$\\begin{align*}\\sec^2\\theta-\\tan^2\\theta&=1\\\\\\left(\\frac{x}{3}\\right)^2-\\left(\\frac{y}{4}\\right)^2&=1\\\\16x^2-9y^2&=144\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p20-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=2-\\cos\\theta$ and $y=1+\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-2)^2+(y-1)^2=1$.",
          "worked": "Here $\\cos\\theta=2-x$ and $\\sin\\theta=y-1$.\n$$\\begin{align*}\\cos^2\\theta+\\sin^2\\theta&=1\\\\(2-x)^2+(y-1)^2&=1\\\\(x-2)^2+(y-1)^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
