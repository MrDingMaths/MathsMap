  "content": {
    "id": "p20-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Solve, by dividing both sides by the coefficient of $x^2$ and then completing the square:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2-4x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{2+\\sqrt6}{2}$ or $x=\\dfrac{2-\\sqrt6}{2}$.",
          "worked": "$$\\begin{align*}x^2-2x-\\frac12&=0\\\\x^2-2x&=\\frac12\\\\x^2-2x+1&=\\frac32\\\\(x-1)^2&=\\frac32\\\\x-1&=\\pm\\frac{\\sqrt6}{2}\\\\x&=\\frac{2+\\sqrt6}{2}\\text{ or }\\frac{2-\\sqrt6}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+8x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{-4+\\sqrt{10}}{2}$ or $x=\\dfrac{-4-\\sqrt{10}}{2}$.",
          "worked": "$$\\begin{align*}x^2+4x+\\frac32&=0\\\\x^2+4x&=-\\frac32\\\\x^2+4x+4&=\\frac52\\\\(x+2)^2&=\\frac52\\\\x+2&=\\pm\\frac{\\sqrt{10}}2\\\\x&=\\frac{-4+\\sqrt{10}}2\\text{ or }\\frac{-4-\\sqrt{10}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p20-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2+6x+5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution.",
          "worked": "$$\\begin{align*}x^2+2x+\\frac53&=0\\\\x^2+2x&=-\\frac53\\\\x^2+2x+1&=-\\frac23\\\\(x+1)^2&=-\\frac23\\end{align*}$$\nA square cannot be negative for real $x$, so there is no real solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p20-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2+4x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\dfrac32$ or $x=\\dfrac12$.",
          "worked": "$$\\begin{align*}x^2+x-\\frac34&=0\\\\x^2+x&=\\frac34\\\\x^2+x+\\frac14&=1\\\\\\left(x+\\frac12\\right)^2&=1\\\\x+\\frac12&=\\pm1\\\\x&=-\\frac32\\text{ or }\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p20-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$4x^2-2x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{1+\\sqrt5}{4}$ or $x=\\dfrac{1-\\sqrt5}{4}$.",
          "worked": "$$\\begin{align*}x^2-\\frac12x-\\frac14&=0\\\\x^2-\\frac12x&=\\frac14\\\\x^2-\\frac12x+\\frac1{16}&=\\frac5{16}\\\\\\left(x-\\frac14\\right)^2&=\\frac5{16}\\\\x-\\frac14&=\\pm\\frac{\\sqrt5}{4}\\\\x&=\\frac{1+\\sqrt5}{4}\\text{ or }\\frac{1-\\sqrt5}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p20-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$2x^2-10x+7=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{5+\\sqrt{11}}{2}$ or $x=\\dfrac{5-\\sqrt{11}}{2}$.",
          "worked": "$$\\begin{align*}x^2-5x+\\frac72&=0\\\\x^2-5x&=-\\frac72\\\\x^2-5x+\\frac{25}4&=\\frac{11}4\\\\\\left(x-\\frac52\\right)^2&=\\frac{11}4\\\\x-\\frac52&=\\pm\\frac{\\sqrt{11}}2\\\\x&=\\frac{5+\\sqrt{11}}2\\text{ or }\\frac{5-\\sqrt{11}}2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
