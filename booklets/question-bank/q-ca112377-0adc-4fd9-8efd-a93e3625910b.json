    "children": [
      {
        "id": "p4-additional-29-34-a",
        "type": "part",
        "label": "a",
        "prompt": "$(2x+3)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32x^5+240x^4+720x^3+1080x^2+810x+243$",
          "worked": "Row 5 of Pascal’s triangle is $1,5,10,10,5,1$.\n\n$$\\begin{align*}(2x+3)^5&=(2x)^5+5(2x)^4(3)+10(2x)^3(3)^2+10(2x)^2(3)^3+5(2x)(3)^4+3^5\\\\(2x+3)^5&=32x^5+240x^4+720x^3+1080x^2+810x+243\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p4-additional-29-34-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2x-3y)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16x^4-96x^3y+216x^2y^2-216xy^3+81y^4$",
          "worked": "Use row 4 coefficients $1,4,6,4,1$, treating the second term as $-3y$.\n\n$$\\begin{align*}(2x-3y)^4&=(2x)^4+4(2x)^3(-3y)+6(2x)^2(-3y)^2+4(2x)(-3y)^3+(-3y)^4\\\\(2x-3y)^4&=16x^4-96x^3y+216x^2y^2-216xy^3+81y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p4-additional-29-34-c",
        "type": "part",
        "label": "c",
        "prompt": "$(3x+5y^2)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81x^4+540x^3y^2+1350x^2y^4+1500xy^6+625y^8$",
          "worked": "Use row 4 coefficients $1,4,6,4,1$.\n\n$$\\begin{align*}(3x+5y^2)^4&=(3x)^4+4(3x)^3(5y^2)+6(3x)^2(5y^2)^2+4(3x)(5y^2)^3+(5y^2)^4\\\\(3x+5y^2)^4&=81x^4+540x^3y^2+1350x^2y^4+1500xy^6+625y^8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p4-additional-29-34-d",
        "type": "part",
        "label": "d",
        "prompt": "$(4x^2-5)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$64x^6-240x^4+300x^2-125$",
          "worked": "Use row 3 coefficients $1,3,3,1$, treating the second term as $-5$.\n\n$$\\begin{align*}(4x^2-5)^3&=(4x^2)^3+3(4x^2)^2(-5)+3(4x^2)(-5)^2+(-5)^3\\\\(4x^2-5)^3&=64x^6-240x^4+300x^2-125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p4-additional-29-34-e",
        "type": "part",
        "label": "e",
        "prompt": "$(2+x)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4+8x^3+24x^2+32x+16$",
          "worked": "Use row 4 coefficients $1,4,6,4,1$.\n\n$$\\begin{align*}(2+x)^4&=2^4+4(2^3)x+6(2^2)x^2+4(2)x^3+x^4\\\\(2+x)^4&=16+32x+24x^2+8x^3+x^4\\\\(2+x)^4&=x^4+8x^3+24x^2+32x+16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-additional-29-34-f",
        "type": "part",
        "label": "f",
        "prompt": "$(1-3x)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-27x^3+27x^2-9x+1$",
          "worked": "Use row 3 coefficients $1,3,3,1$, treating the second term as $-3x$.\n\n$$\\begin{align*}(1-3x)^3&=1^3+3(1^2)(-3x)+3(1)(-3x)^2+(-3x)^3\\\\(1-3x)^3&=1-9x+27x^2-27x^3\\\\(1-3x)^3&=-27x^3+27x^2-9x+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
