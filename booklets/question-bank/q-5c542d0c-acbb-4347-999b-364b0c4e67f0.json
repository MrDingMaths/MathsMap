        "prompt": "$(2x+1)(x-3)=(x+2)^2-21$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=7$.",
          "worked": "$$\\begin{align*}2x^2-5x-3&=x^2+4x-17\\\\x^2-9x+14&=0\\\\(x-2)(x-7)&=0\\end{align*}$$\nBy the null factor law, $x=2$ or $x=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-9cb9c2-p5-practice-slot-1-upper-s1u-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-3)(x+4)-(x+1)(x-2)=(x-5)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5$ or $x=7$.",
          "worked": "$$\\begin{align*}x^2+x-12-(x^2-x-2)&=x^2-10x+25\\\\2x-10&=x^2-10x+25\\\\x^2-12x+35&=0\\\\(x-5)(x-7)&=0\\end{align*}$$\nBy the null factor law, $x=5$ or $x=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
