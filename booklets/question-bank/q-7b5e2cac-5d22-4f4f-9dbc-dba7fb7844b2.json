  "content": {
    "id": "p49-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A box contains 10 chocolates, all of identical appearance. Three of the chocolates have caramel centres and the other seven have mint centres. Hugo randomly selects and eats three chocolates from the box. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "the first chocolate Hugo eats is caramel,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q19-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "P(\\text{first is caramel})=\\frac{3}{10}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p49-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Hugo eats three mint chocolates,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{24}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q19-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{three mint})&=\\frac{7}{10}\\times\\frac{6}{9}\\times\\frac{5}{8}\\\\P(\\text{three mint})&=\\frac{210}{720}\\\\P(\\text{three mint})&=\\frac{7}{24}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p49-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "Hugo eats exactly one caramel chocolate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{40}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p49-q19-c-orders",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The orders CMM, MCM and MMC have equal probabilities, where C means caramel and M means mint.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p49-q19-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{exactly one caramel})&=3\\times\\frac{3}{10}\\times\\frac{7}{9}\\times\\frac{6}{8}\\\\P(\\text{exactly one caramel})&=\\frac{378}{720}\\\\P(\\text{exactly one caramel})&=\\frac{21}{40}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
