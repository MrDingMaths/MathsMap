  "content": {
    "id": "p25-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "The interval $PQ$ has gradient $-3$. A second line passes through $A(-2,4)$ and $B(1,k)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $k$ if $AB$ is parallel to $PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-5$",
          "worked": "$m_{PQ}=-3$. Parallel lines have equal gradients.\n$$\\begin{align*}\\frac{k-4}{1-(-2)}&=-3\\\\\\frac{k-4}{3}&=-3\\\\k-4&=-9\\\\k&=-5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p25-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $k$ if $AB$ is perpendicular to $PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=5$",
          "worked": "The perpendicular gradient is $-\\dfrac{1}{-3}=\\dfrac13$.\n$$\\begin{align*}\\frac{k-4}{1-(-2)}&=\\frac13\\\\\\frac{k-4}{3}&=\\frac13\\\\k-4&=1\\\\k&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
