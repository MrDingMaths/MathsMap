  "content": {
    "id": "p11-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "$A(3,6)$ and $B(4,7)$ are two adjacent vertices of a square $ABCD$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of each side of the square.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt2$",
          "worked": "$$\\begin{align*}AB^2&=(4-3)^2+(7-6)^2\\\\AB^2&=2\\\\AB&=\\sqrt2.\\end{align*}$$\nAll sides of a square are equal, so each side has length $\\sqrt2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p11-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}m_{AB}&=\\frac{7-6}{4-3}\\\\m_{AB}&=1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the gradient of $CD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Opposite sides of a square are parallel, so $CD\\parallel AB$. Parallel lines have equal gradients, hence $m_{CD}=m_{AB}=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
