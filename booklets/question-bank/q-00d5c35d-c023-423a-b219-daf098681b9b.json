    "label": "6",
    "prompt": "Find the indefinite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{x^2+2x}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{2}+2x+C$",
          "worked": "$$\\begin{align*}\\int\\frac{x^2+2x}{x}\\,dx&=\\int(x+2)\\,dx\\\\&=\\frac{x^2}{2}+2x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{x^7+x^8}{x^6}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{2}+\\dfrac{x^3}{3}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{x^7+x^8}{x^6}\\,dx&=\\int(x+x^2)\\,dx\\\\&=\\frac{x^2}{2}+\\frac{x^3}{3}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{2x^3-x^4}{4x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^3}{6}-\\dfrac{x^4}{16}+C$",
          "worked": "$$\\begin{align*}\\int\\frac{2x^3-x^4}{4x}\\,dx&=\\int\\left(\\frac{x^2}{2}-\\frac{x^3}{4}\\right)\\,dx\\\\&=\\frac{x^3}{2(3)}-\\frac{x^4}{4(4)}+C\\\\&=\\frac{x^3}{6}-\\frac{x^4}{16}+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
