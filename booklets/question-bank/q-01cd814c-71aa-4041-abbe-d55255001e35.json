    "children": [
      {
        "id": "p27-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the relative frequency of a family having 3 children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{25}$",
          "worked": "$$\\begin{align*}\\text{Total frequency}&=3+9+7+4+2\\\\\\text{Total frequency}&=25\\\\\\text{Relative frequency}&=\\frac{\\text{Frequency of outcome}}{\\text{Total trials}}\\\\\\text{Relative frequency}&=\\frac{7}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p27-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If 100 families were surveyed, how many families would you expect to have 3 children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "28 families",
          "worked": "$$\\begin{align*}\\text{Expected frequency}&=\\text{Relative frequency}\\times\\text{Total trials}\\\\\\text{Expected frequency}&=\\frac{7}{25}\\times100\\\\\\text{Expected frequency}&=28\\end{align*}$$\nWe would expect 28 families.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p27-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the relative frequency of a family having 4 children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{25}$",
          "worked": "$$\\begin{align*}\\text{Total frequency}&=3+9+7+4+2\\\\\\text{Total frequency}&=25\\\\\\text{Relative frequency}&=\\frac{\\text{Frequency of outcome}}{\\text{Total trials}}\\\\\\text{Relative frequency}&=\\frac{4}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p27-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "If 500 families were surveyed, how many families would you expect to have 4 children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "80 families",
          "worked": "$$\\begin{align*}\\text{Expected frequency}&=\\text{Relative frequency}\\times\\text{Total trials}\\\\\\text{Expected frequency}&=\\frac{4}{25}\\times500\\\\\\text{Expected frequency}&=80\\end{align*}$$\nWe would expect 80 families.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
