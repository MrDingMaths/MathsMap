  "content": {
    "id": "p15-g31-34-root",
    "type": "question",
    "label": null,
    "prompt": "Find the domain of the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-g31-34-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\log_3(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,\\infty)$",
          "worked": "The logarithm requires $x>0$.\n\nHence, the domain is $(0,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-g31-34-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=7\\log_5(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,\\infty)$",
          "worked": "The logarithm requires\n$$\\begin{align*}x+2&>0\\\\x&>-2\\end{align*}$$\nHence, the domain is $(-2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-g31-34-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=\\log_2(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2,\\infty)$",
          "worked": "The logarithm requires\n$$\\begin{align*}x-2&>0\\\\x&>2\\end{align*}$$\nHence, the domain is $(2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p15-g31-34-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=\\log_{10}(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-\\infty,4)$",
          "worked": "The logarithm requires\n$$\\begin{align*}4-x&>0\\\\-x&>-4\\\\x&<4\\end{align*}$$\nHence, the domain is $(-\\infty,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
