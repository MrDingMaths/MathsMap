              "type": "text",
              "text": "A plant is 1.6 m tall. One month later, the plant is 2 m tall.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Find the percentage increase in the height of the plant.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25\\%$ increase.",
      "worked": "$$\\begin{align*}\\text{Change}&=2-1.6\\\\&=0.4\\text{ m}\\\\\\%\\text{ change}&=\\frac{0.4}{1.6}\\times100\\\\&=25\\%\\end{align*}$$\nThe height increased by $25\\%$.",
      "solutionDiagrams": []
    },
