  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve the following logarithmic equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_3(2x+1)=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}2x+1&=3^2\\\\2x+1&=9\\\\2x&=8\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_x(2)=\\dfrac12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}x^{1/2}&=2\\\\x&=2^2\\\\x&=4\\end{align*}$$\n\nThe base $4$ is positive and differs from $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_x(81)=4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3$",
          "worked": "A logarithm base satisfies $x>0$ and $x\\ne1$.\n\n$$\\begin{align*}x^4&=81\\\\x&=\\sqrt[4]{81}\\\\x&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_9(x)=1.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=27$",
          "worked": "$$\\begin{align*}x&=9^{3/2}\\\\x&=(\\sqrt9)^3\\\\x&=3^3\\\\x&=27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_x\\left(\\dfrac1{64}\\right)=-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}x^{-3}&=\\frac1{64}\\\\x^3&=64\\\\x&=\\sqrt[3]{64}\\\\x&=4\\end{align*}$$\n\nThe base $4$ is positive and differs from $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_4(x)=0.25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\sqrt2$",
          "worked": "$$\\begin{align*}x&=4^{1/4}\\\\x&=(2^2)^{1/4}\\\\x&=\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
  },
