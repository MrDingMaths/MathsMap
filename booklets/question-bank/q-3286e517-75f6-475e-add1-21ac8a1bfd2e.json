    "children": [
      {
        "id": "p38-q6-response-bank-p38-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Which has the larger value, $f$ or $g$? Explain your reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4f=130$ (vertically opposite angles), so $f=32.5$. $2g+130=180$ (angles on a straight line), so $g=25$. Hence $f>g$.",
          "worked": "Vertically opposite angles are equal.\n$$\\begin{align*}4f&=130\\\\f&=\\frac{130}{4}\\\\f&=32.5\\end{align*}$$\nAngles on a straight line sum to $180^\\circ$.\n$$\\begin{align*}2g&=180-130\\\\2g&=50\\\\g&=25\\end{align*}$$\nSince $32.5>25$, $f$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p38-q6-response-bank-p38-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Replace $130^\\circ$ with $120^\\circ$. Find $f$ and $g$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f=30$, $g=30$.",
          "worked": "Vertically opposite angles give $4f=120$, so $f=30$. Angles on a straight line give $2g+120=180$, so $2g=60$ and $g=30$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q6-response-bank-p38-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Replace $130^\\circ$ with $100^\\circ$. Which is larger, $f$ or $g$? Explain your reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f=25$, $g=40$; $g$ is larger.",
          "worked": "Vertically opposite angles give $4f=100$, so $f=25$. Angles on a straight line give $2g+100=180$, so $g=40$. Since $40>25$, $g$ is larger.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
