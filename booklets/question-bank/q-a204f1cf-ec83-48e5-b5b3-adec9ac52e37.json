        },
        "answerSpaceMm": 0
      },
      {
        "id": "p20-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "How many times as large is the area of the new rectangle as the area of the original rectangle?\nShow your reasoning.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 times as large.",
          "worked": "$$\\begin{align*}6\\times2a&=12a\\\\12a\\div(3a)&=4\\end{align*}$$\nThe new area is 4 times as large as the original area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p20-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "How many times as large would the area be as the original area if both the original length and breadth were tripled?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9 times as large.",
          "worked": "The dimensions would be $3a$ and $9$.\n$$\\begin{align*}3\\times a&=3a\\\\3\\times3&=9\\\\9\\times3a&=27a\\\\27a\\div(3a)&=9\\end{align*}$$\nThe area would be 9 times as large as the original area.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
