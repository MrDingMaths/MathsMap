              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 20,
                "sourceRegion": "Question 9(a), paired rectangles",
                "description": "Complete paired figure with the same geometry and bounding box as the question figure; label the new horizontal dimension 2a and vertical dimension 6.",
                "mathematics": "Doubling a gives 2a; doubling 3 gives 6.",
                "answerVisibility": "The new labels are solution-only."
              },
              "derived": false,
              "reviewStatus": "needs-review"
