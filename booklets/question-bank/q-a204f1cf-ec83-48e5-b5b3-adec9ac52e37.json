        "answer": {
          "short": "Horizontal dimension $2a$; vertical dimension $6$.",
          "worked": "$$\\begin{align*}2\\times a&=2a\\\\2\\times3&=6\\end{align*}$$",
          "solutionDiagrams": [
            {
              "id": "p20-q9-a-solution-diagrams",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 20 p20-q9-a-solution-diagrams\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,draw=black,every node/.style={text=black,font=\\fontsize{10}{12}\\selectfont}]\n\\path[use as bounding box] (-0.7,-0.35) rectangle (13.6,4.9);\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (3.4,0);\n\\coordinate (C) at (3.4,2.4);\n\\coordinate (D) at (0,2.4);\n\\coordinate (E) at (7.6,0);\n\\coordinate (F) at (13.45,0);\n\\coordinate (G) at (13.45,4.2);\n\\coordinate (H) at (7.6,4.2);\n\\draw (A)--(B)--(C)--(D)--cycle;\n\\draw (E)--(F)--(G)--(H)--cycle;\n\\path (D)--(C) node[midway,above=2mm] {$a$};\n\\path (A)--(D) node[midway,left=2mm] {$3$};\n\\path (H)--(G) node[midway,above=2mm] {$2a$};\n\\path (E)--(H) node[midway,left=2mm] {$6$};\n\\end{tikzpicture}",
              "src": null,
