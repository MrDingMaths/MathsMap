  "content": {
    "id": "p8-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "How many arrangements of the letters of the word FACTORISE have the vowels appear in alphabetical order, not necessarily all together?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{9!}{4!}=15\\,120$\n\nOnly one of the $4!$ vowel orders is alphabetical.",
      "worked": "The nine letters are distinct, so there are $9!$ unrestricted arrangements. The four vowels A, E, I and O have $4!$ equally frequent relative orders. Only one is alphabetical.\n\n$$\\begin{align*}N&=\\frac{9!}{4!}\\\\N&=15\\,120\\end{align*}$$",
      "solutionDiagrams": []
    },
