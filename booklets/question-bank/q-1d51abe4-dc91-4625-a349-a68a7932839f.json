  "content": {
    "id": "p16-q10",
    "type": "question",
    "label": "10",
    "prompt": "Consider $x^2+y^2=r^2$, the circle with centre the origin and radius $r$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q10a",
        "type": "part",
        "label": "a",
        "prompt": "Show that this equation is unchanged when reflected in either the $x$-axis or the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+(-y)^2=x^2+y^2$ and $(-x)^2+y^2=x^2+y^2$.",
          "worked": "For reflection in the $x$-axis, replace $y$ by $-y$:\n$$\\begin{align*}x^2+(-y)^2&=r^2\\\\x^2+y^2&=r^2.\\end{align*}$$\nFor reflection in the $y$-axis, replace $x$ by $-x$:\n$$\\begin{align*}(-x)^2+y^2&=r^2\\\\x^2+y^2&=r^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q10b",
        "type": "part",
        "label": "b",
        "prompt": "Explain this result geometrically.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The circle is symmetric in both axes.",
          "worked": "Both coordinate axes pass through the centre. Each is a line of symmetry, so reflection in either axis leaves the circle unchanged.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
