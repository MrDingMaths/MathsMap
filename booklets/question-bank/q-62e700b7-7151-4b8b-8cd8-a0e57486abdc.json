                  "type": "paragraph",
                  "fontSize": null,
                  "align": "left",
                  "spaceBefore": 0,
                  "spaceAfter": 2,
                  "lineHeight": 1.4,
                  "indent": 0,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Heads:",
                      "marks": [
