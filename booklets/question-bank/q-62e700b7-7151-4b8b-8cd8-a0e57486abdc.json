          "inlines": [
            {
              "type": "text",
              "text": "A student flips a coin multiple times to test whether it is fair. The results of 200 flips are recorded:",
              "marks": []
            }
          ]
        },
        {
          "id": "p23-q8-givens",
          "type": "list",
          "ordered": false,
          "start": 1,
          "indent": 7,
          "items": [
