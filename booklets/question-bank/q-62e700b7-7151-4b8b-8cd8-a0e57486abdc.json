    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Estimate the probability of obtaining a tail.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.41$.",
          "worked": "$$\\begin{align*} \\text{Estimated probability of tails}&=\\frac{82}{200}\\\\ \\text{Estimated probability of tails}&=0.41 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p23-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Based on this probability, predict how many tails would be expected in 500 flips.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "205 tails.",
          "worked": "$$\\begin{align*} \\text{Predicted number of tails}&=500\\times0.41\\\\ \\text{Predicted number of tails}&=205 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p23-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Discuss whether the coin appears to be fair, using the relative frequency as evidence.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The coin appears to favour heads because the relative frequency of tails was $0.41$, below the fair-coin probability of $0.50$.",
          "worked": "The observed proportion of tails was $0.41$, compared with $0.50$ for a fair coin. The difference of 9 percentage points suggests a bias towards heads. Chance variation in the 200 flips is also possible, so this result alone does not establish that the coin is biased.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Suggest one way the experiment could be improved to obtain a more reliable probability estimate.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Increase the number of flips.",
          "worked": "Flip the same coin many more times and recalculate the proportion of tails using all the flips. A larger sample reduces the effect of chance variation on the estimate.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
