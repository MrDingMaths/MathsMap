        "id": "p37-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "How many litres of soft drink does she need to buy?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.3\\text{ L}$",
          "worked": "Including Samantha, there are $19$ people.\n$$\\begin{align*}\\text{Drink required} &= 19\\times700\\text{ mL}\\\\\\text{Drink required} &= 13\\,300\\text{ mL}\\\\\\text{Drink required} &= 13.3\\text{ L}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      },
      {
        "id": "p37-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "If each large bottle of soft drink is 2.5 L, how many bottles does she need?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 bottles",
          "worked": "$$\\begin{align*}\\text{Bottles required} &= 13.3\\div2.5\\\\\\text{Bottles required} &= 5.32\\end{align*}$$\nShe needs 6 whole bottles to have enough soft drink.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": null
      }
    ]
