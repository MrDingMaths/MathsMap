  "content": {
    "id": "p5-p1",
    "type": "question",
    "label": "1",
    "prompt": "Consider the function $y=|x-2|$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the equation of the reflection across the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-|x-2|$",
          "worked": "Reflection across the $x$-axis negates each output, giving $y=-|x-2|$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p5-p1-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p5-p1-b-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Now, write down the reflection of ",
                  "marks": []
                },
                {
                  "type": "text",
                  "text": "that",
                  "marks": [
                    "italic"
                  ]
                },
                {
                  "type": "text",
                  "text": " curve across the ",
                  "marks": []
                },
                {
                  "type": "math",
