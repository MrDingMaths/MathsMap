  "content": {
    "id": "p72-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Apples are sold in bags weighing $1\\frac{1}{2}$ kg. How many bags can be made from 45 kg of apples?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "30 bags",
      "worked": "$$\\begin{align*}\\text{Number of bags}&=45\\div1\\frac{1}{2}\\\\&=45\\div\\frac{3}{2}\\\\&=\\frac{45}{1}\\times\\frac{2}{3}\\\\&=30\\end{align*}$$\n\n30 bags can be made.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 28
  },
