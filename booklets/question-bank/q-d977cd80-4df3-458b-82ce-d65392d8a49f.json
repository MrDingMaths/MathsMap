  "content": {
    "id": "p52-q39-root",
    "type": "question",
    "label": "39",
    "prompt": "Let $f(x)=x^2-4x+13$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q39-a",
        "type": "part",
        "label": "a",
        "prompt": "State the maximal positive domain $D$ for which $f^{-1}(x)$ exists.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$D=[2,\\infty)$.",
          "worked": "$$f(x)=(x-2)^2+9.$$\nThe vertex is $(2,9)$. On the positive branch $x\\ge2$, the graph passes the horizontal line test, so $D=[2,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p52-q39-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the equation of $f^{-1}(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p52-q39-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "f^{-1}(x)=2+\\sqrt{x-9},\\quad x\\ge9",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p52-q39-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Choose the positive square root because the original domain is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x\\ge2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Interchange $x$ and $y$. The original domain requires $y\\ge2$.\n$$\\begin{align*}x&=(y-2)^2+9\\\\(y-2)^2&=x-9\\\\y-2&=\\sqrt{x-9}\\\\y&=2+\\sqrt{x-9}\\end{align*}$$\nTherefore $f^{-1}(x)=2+\\sqrt{x-9}$, with domain $[9,\\infty)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p52-q39-c",
        "type": "part",
        "label": "c",
        "prompt": "Let $a\\in D$. Simplify $f^{-1}\\!\\left(f(a)\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a$.",
          "worked": "$$\\begin{align*}f^{-1}(f(a))&=2+\\sqrt{a^2-4a+13-9}\\\\f^{-1}(f(a))&=2+|a-2|\\\\f^{-1}(f(a))&=a\\end{align*}$$\nHere $a\\ge2$, so $|a-2|=a-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p52-q39-d",
        "type": "part",
        "label": "d",
        "prompt": "Let $a\\notin D$. Simplify $f^{-1}\\!\\left(f(a)\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p52-q39-d-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "4-a",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p52-q39-d-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "a<2",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "|a-2|=2-a",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Evaluate $f(a)$ using the original quadratic rule.\n$$\\begin{align*}f^{-1}(f(a))&=2+\\sqrt{a^2-4a+13-9}\\\\f^{-1}(f(a))&=2+|a-2|\\\\f^{-1}(f(a))&=4-a\\end{align*}$$\nHere $a<2$, so $|a-2|=2-a$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
