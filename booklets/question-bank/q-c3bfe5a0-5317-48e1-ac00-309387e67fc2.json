      {
        "id": "p11-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "The speed $v$ km/h of a car over a given distance is inversely proportional to the time $t$ hours of travel.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v\\propto\\dfrac{1}{t}$",
          "worked": "Inverse proportionality to $t$ means direct proportionality to its reciprocal:\n$$v\\propto\\frac{1}{t}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$m$ is inversely proportional to the square root of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m\\propto\\dfrac{1}{\\sqrt{n}}$",
          "worked": "The square root of $n$ is $\\sqrt{n}$. Inverse proportionality gives\n$$m\\propto\\frac{1}{\\sqrt{n}}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p11-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$s$ is inversely proportional to the cube of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$s\\propto\\dfrac{1}{t^{3}}$",
          "worked": "The cube of $t$ is $t^3$. Inverse proportionality gives\n$$s\\propto\\frac{1}{t^3}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
