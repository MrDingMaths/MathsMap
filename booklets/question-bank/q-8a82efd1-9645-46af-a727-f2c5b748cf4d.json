      {
        "id": "v2-47f22-p31-practice-slot-18-slot-18-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\cot\\alpha}{\\operatorname{cosec}\\alpha-\\sin\\alpha}=\\sec\\alpha$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{1}{\\cos\\alpha}=\\sec\\alpha=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{\\dfrac{\\cos\\alpha}{\\sin\\alpha}}{\\dfrac{1}{\\sin\\alpha}-\\sin\\alpha}\\\\\\mathrm{LHS}&=\\frac{\\dfrac{\\cos\\alpha}{\\sin\\alpha}}{\\dfrac{1-\\sin^2\\alpha}{\\sin\\alpha}}\\\\\\mathrm{LHS}&=\\frac{\\cos\\alpha}{\\sin\\alpha}\\cdot\\frac{\\sin\\alpha}{\\cos^2\\alpha}\\\\\\mathrm{LHS}&=\\frac{1}{\\cos\\alpha}\\\\\\mathrm{LHS}&=\\sec\\alpha\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-47f22-p31-practice-slot-18-slot-18-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1+\\tan\\beta}{1+\\cot\\beta}=\\tan\\beta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathrm{LHS}=\\dfrac{\\sin\\beta}{\\cos\\beta}=\\tan\\beta=\\mathrm{RHS}$.",
          "worked": "$$\\begin{align*}\\mathrm{LHS}&=\\frac{1+\\dfrac{\\sin\\beta}{\\cos\\beta}}{1+\\dfrac{\\cos\\beta}{\\sin\\beta}}\\\\\\mathrm{LHS}&=\\frac{\\dfrac{\\cos\\beta+\\sin\\beta}{\\cos\\beta}}{\\dfrac{\\sin\\beta+\\cos\\beta}{\\sin\\beta}}\\\\\\mathrm{LHS}&=\\frac{\\cos\\beta+\\sin\\beta}{\\cos\\beta}\\cdot\\frac{\\sin\\beta}{\\sin\\beta+\\cos\\beta}\\\\\\mathrm{LHS}&=\\frac{\\sin\\beta}{\\cos\\beta}\\\\\\mathrm{LHS}&=\\tan\\beta\\\\\\mathrm{LHS}&=\\mathrm{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
