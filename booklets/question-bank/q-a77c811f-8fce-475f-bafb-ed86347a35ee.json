  "content": {
    "id": "v2-221dc-p46-practice-slot-6-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Find the points of intersection of $y=-2x^{2}$ and $y=\\frac{16}{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(-2,-8)$",
      "worked": "$$\\begin{align*}-2x^{2}&=\\frac{16}{x}\\\\-2x^{3}&=16\\\\x^{3}&=-8\\\\x&=-2\\end{align*}$$\nSubstitute into $y=-2x^{2}$:\n$$\\begin{align*}y&=-2(-2)^{2}\\\\y&=-8\\end{align*}$$\nThe point of intersection is $(-2,-8)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
