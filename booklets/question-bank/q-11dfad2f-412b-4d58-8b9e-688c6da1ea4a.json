            "inlines": [
              {
                "type": "text",
                "text": "Differentiate to obtain the tangent gradient 1; the normal gradient is −1. Use the point-gradient formula through ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(\\ln 3,\\,3-2\\ln 3)",
                "display": false
