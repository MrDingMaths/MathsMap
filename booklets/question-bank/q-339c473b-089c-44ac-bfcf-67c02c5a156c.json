        "type": "part",
        "label": "a",
        "prompt": "Find its equation in factorised form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-(3-\\sqrt{5}))(x-(3+\\sqrt{5}))$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p79-q10-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Begin with",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "y=a(x-(3-\\sqrt{5}))(x-(3+\\sqrt{5})).",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "At ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "x=0",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ", the product of the two factors is",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "(\\sqrt{5}-3)(-3-\\sqrt{5})=4.",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Using the y-intercept:",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}4a&=-4\\\\a&=-1\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "text",
                    "text": "Thus",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "y=-(x-(3-\\sqrt{5}))(x-(3+\\sqrt{5})).",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p79-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Express it in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-(x-3)^2+5$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p79-q10-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The factors are conjugates:",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(x-(3-\\sqrt{5}))(x-(3+\\sqrt{5}))&=(x-3)^2-5\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "y=-(x-3)^2+5.",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p79-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "Express it in general form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-x^2+6x-4$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p79-q10-c-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Expanding gives",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "break"
                  },
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}y&=-(x^2-6x+9)+5\\\\y&=-x^2+6x-4.\\end{aligned}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
