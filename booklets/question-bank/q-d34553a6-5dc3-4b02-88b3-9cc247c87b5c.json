  "content": {
    "id": "v2-5e43e-p12-practice-j9-021008-root",
    "type": "question",
    "label": null,
    "prompt": "Replace $77$ with $n$ to find the gap between a square and a nearby product.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-5e43e-p12-practice-j9-021008-p15-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand and simplify $n^2-(n+1)(n-1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}n^2-(n+1)(n-1)&=n^2-(n^2-1^2)\\\\&=n^2-n^2+1\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-5e43e-p12-practice-j9-021008-p15-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "Expand and simplify $n^2-(n+4)(n-4)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "$$\\begin{align*}n^2-(n+4)(n-4)&=n^2-(n^2-4^2)\\\\&=n^2-n^2+16\\\\&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-5e43e-p12-practice-j9-021008-p15-q17-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that $n^2-(n+k)(n-k)=k^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^2-(n+k)(n-k)=k^2$",
          "worked": "$$\\begin{align*}n^2-(n+k)(n-k)&=n^2-(n^2-k^2)\\\\&=n^2-n^2+k^2\\\\&=k^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-5e43e-p12-practice-j9-021008-p15-q17-d",
        "type": "part",
        "label": "d",
        "prompt": "A square paddock has side length $120$ m. One side is lengthened by $9$ m and the other is shortened by $9$ m. Find the decrease in area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$ m$^2$",
          "worked": "$n=120$, $k=9$.\n$$\\begin{align*}120^2-(120+9)(120-9)&=9^2\\\\&=81\\end{align*}$$\nThe area decreases by $81$ m$^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
