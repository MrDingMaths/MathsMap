  "content": {
    "id": "p47-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Adriana scored 70 in a test for which the marks were normally distributed with a mean of 64 and a standard deviation of 12. What is the probability that a randomly chosen student scored a lower mark than Adriana? Give your answer to 4 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.6915$",
      "worked": "$$\\begin{aligned}z&=\\frac{70-64}{12}\\\\z&=0.5\\\\P(X<70)&=P(Z<0.5)\\\\P(X<70)&\\approx0.6915\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 21
