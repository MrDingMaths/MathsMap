    "children": [],
    "answer": {
      "short": "$213$ chocolates",
      "worked": "$$\\begin{align*}568\\div8\\times3&=71\\times3\\\\568\\div8\\times3&=213\\end{align*}$$\nJane receives 213 chocolates.",
