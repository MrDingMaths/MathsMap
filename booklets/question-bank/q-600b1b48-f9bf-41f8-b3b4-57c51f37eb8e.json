  "content": {
    "id": "p54-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the equation of the final curve in the form $y=f(ax+b)$ if $y=f(x)$ is",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Dilated horizontally by $\\frac{1}{2}$, then translated left by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=f(2x+2)$",
          "worked": "Dilate horizontally by factor $\\frac{1}{2}$: replace $x$ by $2x$.\n$$\\begin{align*}y&=f(2x)\\end{align*}$$\nTranslate left by 1: replace $x$ by $x+1$ in the dilated rule.\n$$\\begin{align*}y&=f\\bigl(2(x+1)\\bigr)\\\\y&=f(2x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p54-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Dilated horizontally by 3, then translated right by 6 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=f\\left(\\frac{x}{3}-2\\right)$",
          "worked": "Dilate horizontally by factor 3: replace $x$ by $\\frac{x}{3}$.\n$$\\begin{align*}y&=f\\left(\\frac{x}{3}\\right)\\end{align*}$$\nTranslate right by 6: replace $x$ by $x-6$ in the dilated rule.\n$$\\begin{align*}y&=f\\left(\\frac{x-6}{3}\\right)\\\\y&=f\\left(\\frac{x}{3}-2\\right)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
