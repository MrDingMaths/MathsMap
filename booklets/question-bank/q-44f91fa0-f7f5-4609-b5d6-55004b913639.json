        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}\\sin(-60^\\circ)&=-\\sin60^\\circ\\\\\\sin(-60^\\circ)&=-\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p14-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\tan(-60^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan(-60^\\circ)&=-\\tan60^\\circ\\\\\\tan(-60^\\circ)&=-\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p14-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(-120^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt3$",
          "worked": "$$\\begin{align*}\\tan(-120^\\circ)&=-\\tan120^\\circ\\\\\\tan(-120^\\circ)&=-(-\\tan60^\\circ)\\\\\\tan(-120^\\circ)&=\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos(-45^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\cos(-45^\\circ)&=\\cos45^\\circ\\\\\\cos(-45^\\circ)&=\\frac1{\\sqrt2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p14-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(-120^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac12$",
          "worked": "$$\\begin{align*}\\cos(-120^\\circ)&=\\cos120^\\circ\\\\\\cos(-120^\\circ)&=-\\cos60^\\circ\\\\\\cos(-120^\\circ)&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sin(-585^\\circ)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\sin(-585^\\circ)&=\\sin(-585^\\circ+720^\\circ)\\\\\\sin(-585^\\circ)&=\\sin135^\\circ\\\\\\sin(-585^\\circ)&=\\sin45^\\circ\\\\\\sin(-585^\\circ)&=\\frac1{\\sqrt2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
