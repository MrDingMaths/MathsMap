                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{dT}{dx}=\\frac{x}{8\\sqrt{36+x^2}}-\\frac{1}{10}",
                    "display": true
                  }
