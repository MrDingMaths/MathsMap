  "content": {
    "id": "p30-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A man in a rowing boat is presently 6 km from the nearest point $A$ on the shore. He wants to reach, as soon as possible, a point $B$ that is a further 20 km along the shore from $A$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p30-q16-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 30 p30-q16-diagram\"}\n\\begin{tikzpicture}[line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont},>=stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,2.5);\n\\coordinate (B) at (4,2.5);\n\\coordinate (M) at (0,0);\n\\coordinate (C) at (1.5,2.5);\n\\coordinate (R) at (4,0);\n\\draw[black,line width=0.8pt] (M)--(A)--(B)--(R)--cycle;\n\\draw[black,line width=0.8pt] (M)--(C);\n\\draw[black,line width=0.4pt] ($(A)!0.24cm!(B)$)--($(A)!0.24cm!(B)+(0,-0.24)$)--($(A)+(0,-0.24)$);\n\\fill[black] (M) circle (1.6pt);\n\\node[above left] at (A) {$A$};\n\\node[above right] at (B) {$B$};\n\\node[below] at (M) {man};\n\\path (M)--(A) node[midway,left,rotate=90,anchor=south] {$6\\text{ km}$};\n\\path (A)--(C) node[midway,above] {$x\\text{ km}$};\n\\draw[black,<->,line width=0.5pt] ($(A)+(0,0.8)$)--($(B)+(0,0.8)$) node[midway,fill=white,inner sep=3pt] {$20\\text{ km}$};\n\\end{tikzpicture}",
