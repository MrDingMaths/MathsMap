  "content": {
    "id": "p31-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Expand and collect like terms.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x-1)(x^2+x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-1$",
          "worked": "$$\\begin{align*}(x-1)(x^2+x+1)&=x^3+x^2+x-x^2-x-1\\\\(x-1)(x^2+x+1)&=x^3-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p31-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-1)(x^4+x^3+x^2+x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^5-1$",
          "worked": "$$\\begin{align*}(x-1)(x^4+x^3+x^2+x+1)&=x^5+x^4+x^3+x^2+x\\\\&\\quad{}-x^4-x^3-x^2-x-1\\\\(x-1)(x^4+x^3+x^2+x+1)&=x^5-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p31-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "What do you expect the result of expanding $(x-1)(x^9+x^8+\\cdots+1)$ will be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^{10}-1$.\n\nAll intermediate powers cancel.",
          "worked": "$$\\begin{align*}(x-1)(x^9+x^8+\\cdots+1)&=(x^{10}+x^9+\\cdots+x)\\\\&\\quad{}-(x^9+x^8+\\cdots+1)\\\\(x-1)(x^9+x^8+\\cdots+1)&=x^{10}-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
