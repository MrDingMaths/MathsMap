  "content": {
    "id": "p18-q4",
    "type": "question",
    "label": "4",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$w\\times w$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w^{2}$",
          "worked": "$$\\begin{align*}w\\times w &= w^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^{2}\\times a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{3}$",
          "worked": "$$\\begin{align*}a^{2}\\times a &= a\\times a\\times a\\\\a^{2}\\times a &= a^{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3d\\times d$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3d^{2}$",
          "worked": "$$\\begin{align*}3d\\times d &= 3d^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p18-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$2k\\times k^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2k^{3}$",
          "worked": "$$\\begin{align*}2k\\times k^{2} &= 2(k\\times k\\times k)\\\\2k\\times k^{2} &= 2k^{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$p\\times 7p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7p^{2}$",
          "worked": "$$\\begin{align*}p\\times 7p &= 7(p\\times p)\\\\p\\times 7p &= 7p^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$q\\times 3q^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3q^{3}$",
          "worked": "$$\\begin{align*}q\\times 3q^{2} &= 3(q\\times q\\times q)\\\\q\\times 3q^{2} &= 3q^{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$6x\\times 2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^{2}$",
          "worked": "$$\\begin{align*}6x\\times 2x &= (6\\times 2)(x\\times x)\\\\6x\\times 2x &= 12x^{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$3z\\times 5z^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$15z^{4}$",
          "worked": "$$\\begin{align*}3\\times 5 &= 15\\\\z\\times z^{3} &= z\\times z\\times z\\times z = z^{4}\\\\3z\\times 5z^{3} &= 15z^{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$-3x\\times 9x\\times 2xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-54x^{3}y$",
          "worked": "$$\\begin{align*}(-3)\\times 9\\times 2 &= -54\\\\x\\times x\\times x\\times y &= x^{3}y\\\\-3x\\times 9x\\times 2xy &= -54x^{3}y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
