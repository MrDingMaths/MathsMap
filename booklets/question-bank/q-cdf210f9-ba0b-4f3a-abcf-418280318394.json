  "content": {
    "id": "p41-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Tammy desperately wants to buy a new mountain bike that has a regular price of \\$350.\nShe has only \\$220. The local bike store regularly has sales with discounts in multiples of 5%.\nWhat is the smallest discount that will allow her to purchase the bike?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p41-q21-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "40% off.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "$$\\begin{align*}\\text{Price with 35\\% off} &= \\$350\\times0.65\\\\&=\\$227.50\\\\\\text{Price with 40\\% off} &= \\$350\\times0.60\\\\&=\\$210\\end{align*}$$\nA 35% discount leaves the price above \\$220; every smaller discount also costs too much. A 40% discount makes the bike affordable, so the smallest permitted discount is **40% off**.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
