  "content": {
    "id": "p9-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The polynomial $P(x)=x^3-27x+54$ has a double zero.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the zeroes of $P'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pm3$.",
          "worked": "$$\\begin{aligned}P'(x)&=3x^2-27\\end{aligned}$$\nFor the zeroes,\n$$\\begin{aligned}3x^2-27&=0\\\\x^2&=9\\\\x&=\\pm3.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p9-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine which of the zeroes of $P'(x)$ is the double zero of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$ is the double zero.",
          "worked": "$$\\begin{aligned}P(3)&=27-81+54\\\\&=0\\\\P(-3)&=-27+81+54\\\\&=108\\ne0\\end{aligned}$$\nSince the polynomial has a double zero, it must be $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p9-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the remaining simple zero of $P(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6$.",
          "worked": "Let the zeroes, counted with multiplicity, be $3,3,\\alpha$. The coefficient of $x^2$ is $0$, so\n$$\\begin{aligned}3+3+\\alpha&=-\\frac{0}{1}\\\\6+\\alpha&=0\\\\\\alpha&=-6.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
