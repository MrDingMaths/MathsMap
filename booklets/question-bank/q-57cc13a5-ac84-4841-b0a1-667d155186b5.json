  "content": {
    "id": "p18-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find a fraction that is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q1a",
        "type": "part",
        "label": "a",
        "prompt": "nearly 8",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{79}{10}$.",
          "worked": "$$\\begin{align*}\\frac{79}{10}&=7\\frac{9}{10}\\\\8-\\frac{79}{10}&=\\frac{1}{10}\\end{align*}$$\nThis fraction is only $\\frac{1}{10}$ less than 8.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q1b",
        "type": "part",
        "label": "b",
        "prompt": "close to one half",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{49}{100}$.",
          "worked": "$$\\begin{align*}\\frac{1}{2}&=\\frac{50}{100}\\\\\\frac{1}{2}-\\frac{49}{100}&=\\frac{1}{100}\\end{align*}$$\nThis fraction is only $\\frac{1}{100}$ less than one half.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p18-q1c",
        "type": "part",
        "label": "c",
        "prompt": "a bit more than one quarter but less than one half",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $\\frac{3}{10}$.",
          "worked": "$$\\begin{align*}\\frac{1}{4}&=\\frac{5}{20}\\\\\\frac{3}{10}&=\\frac{6}{20}\\\\\\frac{1}{2}&=\\frac{10}{20}\\end{align*}$$\nSince $\\frac{5}{20}<\\frac{6}{20}<\\frac{10}{20}$, $\\frac{3}{10}$ is a little more than one quarter and less than one half.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
