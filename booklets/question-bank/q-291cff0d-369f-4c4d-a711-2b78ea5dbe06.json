  "content": {
    "id": "p16-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Factorise each of the following expressions:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{2n}-2^n-20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2^n-5)(2^n+4)$",
          "worked": "Let $u=2^n$, so $2^{2n}=u^2$. The numbers are $-5$ and $4$.\n\n$$\\begin{align*}2^{2n}-2^n-20&=u^2-u-20\\\\2^{2n}-2^n-20&=(u-5)(u+4)\\\\2^{2n}-2^n-20&=(2^n-5)(2^n+4).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^{2n}-(2\\times3^n)-35$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3^n-7)(3^n+5)$",
          "worked": "Let $u=3^n$, so $3^{2n}=u^2$. The numbers are $-7$ and $5$.\n\n$$\\begin{align*}3^{2n}-(2\\times3^n)-35&=u^2-2u-35\\\\3^{2n}-(2\\times3^n)-35&=(u-7)(u+5)\\\\3^{2n}-(2\\times3^n)-35&=(3^n-7)(3^n+5).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^{2n}+(3\\times4^n)-40$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4^n-5)(4^n+8)$",
          "worked": "Let $u=4^n$, so $4^{2n}=u^2$. The numbers are $-5$ and $8$.\n\n$$\\begin{align*}4^{2n}+(3\\times4^n)-40&=u^2+3u-40\\\\4^{2n}+(3\\times4^n)-40&=(u-5)(u+8)\\\\4^{2n}+(3\\times4^n)-40&=(4^n-5)(4^n+8).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
