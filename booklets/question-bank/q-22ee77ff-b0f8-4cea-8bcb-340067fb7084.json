    "children": [
      {
        "id": "p54-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the domain of $y=\\log_e(1+x^2)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\in\\mathbb{R}$",
          "worked": "Since $1+x^2\\geq1>0$ for every real $x$, the domain is $\\mathbb{R}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Is the curve even, odd or neither?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Even.",
          "worked": "$$\\begin{aligned}f(-x)&=\\ln(1+(-x)^2)\\\\&=\\ln(1+x^2)\\\\&=f(x).\\end{aligned}$$The function is even, so the curve is symmetric about the $y$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p54-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "Find where the function is zero, and explain what its sign is otherwise.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Zero at $x=0$; positive for every $x\\ne0$.",
          "worked": "$$\\begin{aligned}\\ln(1+x^2)&=0\\\\1+x^2&=1\\\\x&=0.\\end{aligned}$$\n\nFor $x\\ne0$, $1+x^2>1$, so $\\ln(1+x^2)>0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p54-q22-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $y'=\\dfrac{2x}{1+x^2}$ and $y''=\\dfrac{2(1-x^2)}{(1+x^2)^2}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{2x}{1+x^2}$ and $y''=\\dfrac{2(1-x^2)}{(1+x^2)^2}$.",
          "worked": "$$\\begin{aligned}y'&=\\frac{1}{1+x^2}\\times2x\\\\&=\\frac{2x}{1+x^2},\\\\y''&=\\frac{(1+x^2)(2)-(2x)(2x)}{(1+x^2)^2}\\\\&=\\frac{2+2x^2-4x^2}{(1+x^2)^2}\\\\&=\\frac{2(1-x^2)}{(1+x^2)^2}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p54-q22-e",
        "type": "part",
        "label": "e",
        "prompt": "Hence show that $y=\\log_e(1+x^2)$ has one stationary point, and determine its nature.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The only stationary point is $(0,0)$, a minimum.",
