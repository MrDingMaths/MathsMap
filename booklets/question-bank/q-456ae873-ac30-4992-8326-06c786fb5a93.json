  "content": {
    "id": "p33-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "An odd digit is selected at random and then a second odd digit is chosen at random (they may be equal). What is the probability that the sum of the two digits is greater than 10?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{2}{5}$",
      "worked": "The odd digits are $1,3,5,7,9$. There are $5\\times5=25$ equally likely ordered pairs. The favourable pairs are\n\n$$\\begin{aligned}&(3,9),\\\\&(5,7),(5,9),\\\\&(7,5),(7,7),(7,9),\\\\&(9,3),(9,5),(9,7),(9,9).\\end{aligned}$$\n\n$$\\begin{align*}P(\\text{sum}>10)&=\\frac{10}{25}\\\\P(\\text{sum}>10)&=\\frac{2}{5}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
