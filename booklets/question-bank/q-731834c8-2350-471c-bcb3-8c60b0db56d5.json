            {
              "type": "text",
              "text": "$2000 is invested at 8% compound interest per year, compounded annually. After how many whole years will it exceed $20 000?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "30 years",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "a43d25dc-f976-4212-9557-6cd7af2200b8",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " be the number of years, with ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "n",
                "display": false
              },
              {
                "type": "text",
                "text": " a nonnegative integer.",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{align*}2000(1.08)^n &> 20000\\\\(1.08)^n &> 10\\\\n &> \\log_{1.08}(10)\\end{align*}",
                "display": true
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "The base ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "1.08>1",
                "display": false
              },
              {
                "type": "text",
                "text": ", so the inequality direction is unchanged. Since ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "29<\\log_{1.08}(10)<30",
                "display": false
              },
              {
                "type": "text",
                "text": ", the investment first exceeds $20 000 after 30 whole years.",
                "marks": []
