  "content": {
    "id": "p39-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Solve these equations by making a substitution so that they can be considered a quadratic.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^{2x}-2^x-12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$. Let $u=2^x>0$; solve $(u-4)(u+3)=0$.",
          "worked": "Let $u=2^x$, so $u>0$ and $2^{2x}=u^2$.\n$$\\begin{align*}u^2-u-12&=0\\\\(u-4)(u+3)&=0\\\\u&=4\\text{ or }-3\\end{align*}$$\nReject $u=-3$ because $2^x>0$.\n$$\\begin{align*}2^x&=4\\\\2^x&=2^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p39-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^{2x}-8\\times3^x-9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$. Let $u=3^x>0$; solve $(u-9)(u+1)=0$.",
          "worked": "Let $u=3^x$, so $u>0$ and $3^{2x}=u^2$.\n$$\\begin{align*}u^2-8u-9&=0\\\\(u-9)(u+1)&=0\\\\u&=9\\text{ or }-1\\end{align*}$$\nReject $u=-1$ because $3^x>0$.\n$$\\begin{align*}3^x&=9\\\\3^x&=3^2\\\\x&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p39-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\times9^x-3^{x+1}-18=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$. Let $u=3^x>0$; solve $(u-3)(u+2)=0$.",
          "worked": "Let $u=3^x$, so $u>0$. Then $9^x=u^2$ and $3^{x+1}=3u$.\n$$\\begin{align*}3u^2-3u-18&=0\\\\u^2-u-6&=0\\\\(u-3)(u+2)&=0\\\\u&=3\\text{ or }-2\\end{align*}$$\nReject $u=-2$ because $3^x>0$.\n$$\\begin{align*}3^x&=3\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p39-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$(x^2+x)^2-8(x^2+x)+12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3,-2,1\\text{ or }2$. Let $u=x^2+x$; then $u=2$ or $6$.",
          "worked": "Let $u=x^2+x$.\n$$\\begin{align*}u^2-8u+12&=0\\\\(u-2)(u-6)&=0\\\\u&=2\\text{ or }6\\end{align*}$$\nFor $u=2$:\n$$\\begin{align*}x^2+x&=2\\\\x^2+x-2&=0\\\\(x+2)(x-1)&=0\\\\x&=-2\\text{ or }1\\end{align*}$$\nFor $u=6$:\n$$\\begin{align*}x^2+x&=6\\\\x^2+x-6&=0\\\\(x+3)(x-2)&=0\\\\x&=-3\\text{ or }2\\end{align*}$$\nThus $x=-3,-2,1\\text{ or }2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
