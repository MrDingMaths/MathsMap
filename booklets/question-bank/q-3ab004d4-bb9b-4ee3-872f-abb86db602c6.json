  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Find the sum $P(x)+Q(x)$ and the difference $P(x)-Q(x)$, given that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(x)=x^3+4x+7$ and $Q(x)=-2x^3+3x^2-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=-x^3+3x^2+7$\n\n$P(x)-Q(x)=3x^3-3x^2+8x+7$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=x^3+4x+7-2x^3+3x^2-4x\\\\P(x)+Q(x)&=-x^3+3x^2+7\\\\P(x)-Q(x)&=x^3+4x+7-(-2x^3+3x^2-4x)\\\\P(x)-Q(x)&=x^3+4x+7+2x^3-3x^2+4x\\\\P(x)-Q(x)&=3x^3-3x^2+8x+7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(x)=-3x^5-3x+7$ and $Q(x)=3x^5+x^2-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=x^2-3x$\n\n$P(x)-Q(x)=-6x^5-x^2-3x+14$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=-3x^5-3x+7+3x^5+x^2-7\\\\P(x)+Q(x)&=x^2-3x\\\\P(x)-Q(x)&=-3x^5-3x+7-(3x^5+x^2-7)\\\\P(x)-Q(x)&=-3x^5-3x+7-3x^5-x^2+7\\\\P(x)-Q(x)&=-6x^5-x^2-3x+14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(x)=4x^3-5x^2-6x+6$ and $Q(x)=-4x^3+5x^2+5x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)+Q(x)=-x+2$\n\n$P(x)-Q(x)=8x^3-10x^2-11x+10$",
          "worked": "$$\\begin{align*}P(x)+Q(x)&=4x^3-5x^2-6x+6-4x^3+5x^2+5x-4\\\\P(x)+Q(x)&=-x+2\\\\P(x)-Q(x)&=4x^3-5x^2-6x+6-(-4x^3+5x^2+5x-4)\\\\P(x)-Q(x)&=4x^3-5x^2-6x+6+4x^3-5x^2-5x+4\\\\P(x)-Q(x)&=8x^3-10x^2-11x+10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
