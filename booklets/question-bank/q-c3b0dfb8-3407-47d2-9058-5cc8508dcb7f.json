    "type": "question",
    "label": "8",
    "prompt": "Find the area enclosed between the curve $y=x^3-2$ and the $y$-axis between $y=-1$ and $y=25$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60\\text{ units}^2$",
      "worked": "Rearranging gives $x=(y+2)^{1/3}$. The curve lies to the right of the $y$-axis throughout the interval.\n$$\\begin{align*}A&=\\int_{-1}^{25}(y+2)^{1/3}\\,dy\\\\&=\\left[\\frac34(y+2)^{4/3}\\right]_{-1}^{25}\\\\&=\\frac34\\left[27^{4/3}-1^{4/3}\\right]\\\\&=\\frac34[81-1]\\\\&=60\\text{ units}^2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 41
  },
