      {
        "id": "p8-q9a",
        "type": "part",
        "label": "a",
        "prompt": "How many terms of sequence $a_n=2n-5$ are less than 100?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "52 terms.",
          "worked": "$$\\begin{align*}2n-5&<100\\\\2n&<105\\\\n&<\\frac{105}{2}.\\end{align*}$$\nSince $n$ is a positive integer, $n=1,2,\\ldots,52$. There are 52 terms.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p8-q9b",
        "type": "part",
        "label": "b",
        "prompt": "What is the first term of sequence $a_n=7n-44$ greater than 100?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{21}=103$.",
          "worked": "$$\\begin{align*}7n-44&>100\\\\7n&>144\\\\n&>\\frac{144}{7}.\\end{align*}$$\nThe smallest positive integer satisfying this is $n=21$.\n$$\\begin{align*}a_{21}&=7(21)-44\\\\a_{21}&=103.\\end{align*}$$\nThe first term greater than 100 is $a_{21}=103$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
