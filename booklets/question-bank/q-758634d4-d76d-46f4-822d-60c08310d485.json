  "content": {
    "id": "p7-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "In a raffle, 500 tickets are sold. If you bought 20 tickets, what is the probability that you will not win first prize?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{24}{25}$",
      "worked": "Let $A$ be the event ‘you win first prize’.\n$$\\begin{align*}P(A)&=\\frac{20}{500}\\\\P(A)&=\\frac{1}{25}\\\\P(A^c)&=1-P(A)\\\\P(A^c)&=1-\\frac{1}{25}\\\\P(A^c)&=\\frac{24}{25}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
