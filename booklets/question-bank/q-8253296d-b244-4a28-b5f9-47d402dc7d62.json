          "worked": "$$\\begin{align*}ab&=\\frac{2}{3}\\times\\frac{3}{5}\\\\ab&=\\frac{6}{15}\\\\ab&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p8-q16-f",
        "type": "part",
        "label": "f",
