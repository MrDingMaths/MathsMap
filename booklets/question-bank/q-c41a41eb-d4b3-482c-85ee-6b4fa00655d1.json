    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int\\frac{x+1}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+\\ln|x|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{x+1}{x}\\,dx&=\\int\\left(1+\\frac1x\\right)\\,dx\\\\&=x+\\ln|x|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p32-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int\\frac{x+3}{5x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{5}+\\frac35\\ln|x|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{x+3}{5x}\\,dx&=\\int\\left(\\frac15+\\frac{3}{5x}\\right)\\,dx\\\\&=\\frac{x}{5}+\\frac35\\ln|x|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int\\frac{1-8x}{9x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac19\\ln|x|-\\frac89x+C$",
          "worked": "$$\\begin{align*}\\int\\frac{1-8x}{9x}\\,dx&=\\int\\left(\\frac{1}{9x}-\\frac89\\right)\\,dx\\\\&=\\frac19\\ln|x|-\\frac89x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int\\frac{3x^2-2x}{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-2\\ln|x|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{3x^2-2x}{x^2}\\,dx&=\\int\\left(3-\\frac2x\\right)\\,dx\\\\&=3x-2\\ln|x|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p32-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int\\frac{2x^2+x-4}{x}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2+x-4\\ln|x|+C$",
          "worked": "$$\\begin{align*}\\int\\frac{2x^2+x-4}{x}\\,dx&=\\int\\left(2x+1-\\frac4x\\right)\\,dx\\\\&=x^2+x-4\\ln|x|+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p32-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int\\frac{x^4-x+2}{x^2}\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^3}{3}-\\ln|x|-\\frac2x+C$",
          "worked": "$$\\begin{align*}\\int\\frac{x^4-x+2}{x^2}\\,dx&=\\int\\left(x^2-\\frac1x+2x^{-2}\\right)\\,dx\\\\&=\\frac{x^3}{3}-\\ln|x|-2x^{-1}+C\\\\&=\\frac{x^3}{3}-\\ln|x|-\\frac2x+C\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
