  "content": {
    "id": "p50-q7",
    "type": "question",
    "label": "7",
    "prompt": "Consider a necklace of six differently coloured beads. Because the necklace can be turned over, clockwise and anti-clockwise arrangements of the beads do not yield different orders. Hence find how many different arrangements there are of the six beads on the necklace.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60$",
      "worked": "There are $(6-1)!$ circular arrangements. Turning the necklace over identifies each arrangement with its reverse, so divide by $2$.\n$$\\begin{aligned}N&=\\frac{(6-1)!}{2}\\\\&=\\frac{120}{2}\\\\&=60\\end{aligned}$$",
      "solutionDiagrams": []
    },
