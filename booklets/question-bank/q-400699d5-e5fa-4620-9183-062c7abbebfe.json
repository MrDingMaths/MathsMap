    "type": "question",
    "label": "9",
    "prompt": "What is the sum of $\\frac{1}{5}$ and half of $\\frac{1}{5}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{3}{10}$",
      "worked": "$$\\begin{align*}\\frac{1}{5}+\\frac{1}{2}\\times\\frac{1}{5}&=\\frac{1}{5}+\\frac{1}{10}\\\\\\frac{1}{5}+\\frac{1}{2}\\times\\frac{1}{5}&=\\frac{2}{10}+\\frac{1}{10}\\\\\\frac{1}{5}+\\frac{1}{2}\\times\\frac{1}{5}&=\\frac{3}{10}\\end{align*}$$",
      "solutionDiagrams": []
