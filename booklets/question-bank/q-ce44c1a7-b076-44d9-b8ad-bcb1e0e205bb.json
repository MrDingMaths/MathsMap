      {
        "id": "p40-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand and simplify $(2\\sqrt5-\\sqrt3)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$23-4\\sqrt{15}$",
          "worked": "$$\\begin{align*}(2\\sqrt5-\\sqrt3)^2&=(2\\sqrt5)^2-2(2\\sqrt5)(\\sqrt3)+(\\sqrt3)^2\\\\(2\\sqrt5-\\sqrt3)^2&=20-4\\sqrt{15}+3\\\\(2\\sqrt5-\\sqrt3)^2&=23-4\\sqrt{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p40-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify $\\frac{2}{\\sqrt3-2}+\\frac{2}{\\sqrt3}$, expressing your answer with a rational denominator.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{4\\sqrt3}{3}-4$",
          "worked": "$$\\begin{align*}\\frac{2}{\\sqrt3-2}+\\frac{2}{\\sqrt3}&=\\frac{2(\\sqrt3+2)}{(\\sqrt3-2)(\\sqrt3+2)}+\\frac{2\\sqrt3}{3}\\\\\\frac{2}{\\sqrt3-2}+\\frac{2}{\\sqrt3}&=\\frac{2\\sqrt3+4}{3-4}+\\frac{2\\sqrt3}{3}\\\\\\frac{2}{\\sqrt3-2}+\\frac{2}{\\sqrt3}&=-2\\sqrt3-4+\\frac{2\\sqrt3}{3}\\\\\\frac{2}{\\sqrt3-2}+\\frac{2}{\\sqrt3}&=-\\frac{4\\sqrt3}{3}-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
