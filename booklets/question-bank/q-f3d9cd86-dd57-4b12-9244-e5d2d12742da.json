  "content": {
    "id": "v2-0d7ce0-p5-practice-j6-095526-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the equation $x^2+10=k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-0d7ce0-p5-practice-j6-095526-j6-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Solve the equation when $k=14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$ or $x=-2$.",
          "worked": "$$\\begin{align*}x^2+10&=14\\\\x^2&=4\\\\x&=\\pm2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-0d7ce0-p5-practice-j6-095526-j6-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation when $k=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0$ only.",
          "worked": "$$\\begin{align*}x^2+10&=10\\\\x^2&=0\\\\x&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-0d7ce0-p5-practice-j6-095526-j6-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Solve the equation when $k=6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "$$\\begin{align*}x^2+10&=6\\\\x^2&=-4\\end{align*}$$\nThere is no solution because the square of a real number cannot be negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-0d7ce0-p5-practice-j6-095526-j6-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the values of $k$ for which the equation has two solutions, one solution, and no solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two solutions when $k>10$; one solution when $k=10$; no solutions when $k<10$.",
          "worked": "$$\\begin{align*}x^2+10&=k\\\\x^2&=k-10\\end{align*}$$\nTwo solutions when $k-10>0$, so $k>10$.\nOne solution when $k-10=0$, so $k=10$.\nNo solutions when $k-10<0$, so $k<10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
