              "type": "text",
              "text": "A car travels 20 km from Cranung to Doville.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "It travels ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "d",
              "display": false
            },
            {
              "type": "text",
              "text": " km at 60 km/h and the remainder at 80 km/h.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "How far does the car travel at 80 km/h?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(20-d)\\text{ km}$",
          "worked": "$$\\begin{align*}\\text{Remaining distance}&=(20-d)\\text{ km}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q15-b",
        "type": "group",
        "label": "b",
        "prompt": "For how long, in terms of $d$, does the car travel at:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q15-b-i",
            "type": "part",
            "label": "i",
            "prompt": "60 km/h?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{d}{60}\\text{ h}$",
              "worked": "Time = distance ÷ speed.\n$$\\begin{align*}t_{60}&=\\frac{d}{60}\\text{ h}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p21-q15-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "80 km/h?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{20-d}{80}\\text{ h}$",
              "worked": "Time = distance ÷ speed.\n$$\\begin{align*}t_{80}&=\\frac{20-d}{80}\\text{ h}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p21-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "What is the total time for the journey, in terms of $d$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{d+60}{240}\\text{ h}$",
          "worked": "$$\\begin{align*}t&=\\frac{d}{60}+\\frac{20-d}{80}\\\\t&=\\frac{4d+3(20-d)}{240}\\\\t&=\\frac{4d+60-3d}{240}\\\\t&=\\frac{d+60}{240}\\text{ h}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p21-q15-d",
        "type": "group",
        "label": "d",
        "prompt": "Find the total time taken, in minutes, if:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q15-d-i",
            "type": "part",
            "label": "i",
            "prompt": "$d=6\\text{ km}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$16\\tfrac12\\text{ min}$",
              "worked": {
                "format": "maths-editor-document-v1",
                "version": 1,
                "blocks": [
                  {
                    "id": "p21-q15-d-conversion",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "left",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Convert to minutes:",
                        "marks": []
                      },
                      {
                        "type": "math",
                        "latex": "\\begin{align*}t_{\\text{min}}&=\\frac{d+60}{240}\\times60=\\frac{d+60}{4}\\text{ min}\\end{align*}",
                        "display": true
                      }
                    ]
                  },
                  {
                    "id": "p21-q15-d-i-substitution",
                    "type": "paragraph",
                    "fontSize": null,
                    "align": "left",
                    "spaceBefore": 0,
                    "spaceAfter": 2,
                    "lineHeight": 1.4,
                    "indent": 0,
                    "inlines": [
                      {
                        "type": "math",
                        "latex": "\\begin{align*}t_{\\text{min}}&=\\frac{6+60}{4}\\\\t_{\\text{min}}&=16\\tfrac12\\text{ min}\\end{align*}",
                        "display": true
                      }
                    ]
                  }
                ]
              },
              "solutionDiagrams": []
            },
            "answerSpaceMm": 49
          },
          {
            "id": "p21-q15-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$d=12\\text{ km}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$18\\text{ min}$",
              "worked": "Convert to minutes:\n$$\\begin{align*}t_{\\text{min}}&=\\frac{d+60}{240}\\times60=\\frac{d+60}{4}\\text{ min}\\\\t_{\\text{min}}&=\\frac{12+60}{4}\\\\t_{\\text{min}}&=18\\text{ min}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 49
          },
          {
            "id": "p21-q15-d-iii",
