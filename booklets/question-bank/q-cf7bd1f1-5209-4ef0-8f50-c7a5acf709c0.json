  "content": {
    "id": "p10-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "A rural property is rectangular in shape with sides $350\\,\\text{m}$ and $500\\,\\text{m}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p10-q17-feedback-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\": 1, \"kind\": \"geometry\", \"base\": [], \"semantic\": [], \"reference\": \"Authorised feedback p10-q17-feedback-diagram\"}\n\\begin{tikzpicture}[x=1mm,y=1mm,line cap=round,line join=round,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black,inner sep=2pt}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[black,line width=0.8pt] (0,0) rectangle (38,23);\n\\node[below] at (19.0,0) {$500\\,\\mathrm{m}$};\n\\node[right] at (38,11.5) {$350\\,\\mathrm{m}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 58,
