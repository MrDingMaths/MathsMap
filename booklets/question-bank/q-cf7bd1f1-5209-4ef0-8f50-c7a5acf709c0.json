    "children": [
      {
        "id": "p10-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Find its area in square metres and then in hectares.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$175\\,000\\,\\text{m}^2 = 17.5\\,\\text{ha}$",
          "worked": "$$\\begin{align*}\\text{Area}&=350\\times500\\,\\text{m}^2\\\\\\text{Area}&=175\\,000\\,\\text{m}^2\\\\\\text{Area in hectares}&=175\\,000\\div100^2\\\\\\text{Area in hectares}&=17.5\\,\\text{ha}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p10-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "The owner wants to plant 8 mangroves per ha, how many trees should be planted?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "140 trees",
          "worked": "$$\\begin{align*}\\text{Number of trees}&=17.5\\times8\\\\\\text{Number of trees}&=140\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
