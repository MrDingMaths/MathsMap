  "content": {
    "id": "p47-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "From a total of 10 people, 5 like apples, 6 like bananas, and 4 like both. Let $A$ represent people who like apples and $B$ represent people who like bananas.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q2-drawing",
        "type": "part",
        "label": "a",
        "prompt": "Draw a Venn diagram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p47-q2-answer-diagram",
        "answer": {
          "short": "$A$ only: 1; both: 4; $B$ only: 2; neither: 3.",
          "worked": "$$\\begin{align*}n(A\\cap B)&=4\\\\n(A\\cap B')&=5-4=1\\\\n(A'\\cap B)&=6-4=2\\\\n(A'\\cap B')&=10-(1+4+2)=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p47-q2-quantities",
        "type": "group",
        "label": "",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p47-q2-a",
            "type": "part",
            "label": "b",
            "prompt": "$n(A'\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$$\\begin{align*}n(A'\\cap B)&=6-4\\\\&=2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p47-q2-b",
            "type": "part",
            "label": "c",
            "prompt": "$n(A'\\cap B')$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3$",
              "worked": "$$\\begin{align*}n(A\\cup B)&=5+6-4=7\\\\n(A'\\cap B')&=10-7\\\\&=3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p47-q2-c",
            "type": "part",
            "label": "d",
            "prompt": "$P(A\\cap B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{5}$",
              "worked": "$$\\begin{align*}P(A\\cap B)&=\\frac{4}{10}\\\\&=\\frac{2}{5}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p47-q2-d",
            "type": "part",
            "label": "e",
            "prompt": "$P(A\\cup B)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{7}{10}$",
              "worked": "$$\\begin{align*}P(A\\cup B)&=\\frac{5}{10}+\\frac{6}{10}-\\frac{4}{10}\\\\&=\\frac{7}{10}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
      }
    ],
