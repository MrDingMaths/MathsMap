  "content": {
    "id": "p14-cc-9-response",
    "type": "question",
    "label": "9",
    "prompt": "Explain why $f(x)=c$ and $f(x)=mx+c$, where $m$ and $c$ are constants, do not require differentiating from first principles to find $f'(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Their graphs are lines with known gradients: $f'(x)=0$ for $f(x)=c$, and $f'(x)=m$ for $f(x)=mx+c$.",
      "worked": "The derivative gives the tangent gradient. The graph of $f(x)=c$ is horizontal with gradient $0$; the graph of $f(x)=mx+c$ is a straight line with gradient $m$. Thus their derivatives are $0$ and $m$, respectively.",
      "solutionDiagrams": []
    },
