  "content": {
    "id": "p10-q3-root",
    "type": "question",
    "label": "5",
    "prompt": "State the domain and range of each circle with the following features.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Centre $(0,0)$ and radius $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $-2\\leq x\\leq2$. Range: $-2\\leq y\\leq2$.",
          "worked": "The horizontal and vertical coordinates each extend $2$ units either side of $0$.\n\nDomain: $-2\\leq x\\leq2$. Range: $-2\\leq y\\leq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p10-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Centre $(3,-2)$ and radius $2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $1\\leq x\\leq5$. Range: $-4\\leq y\\leq0$.",
          "worked": "The horizontal extremes are $3-2=1$ and $3+2=5$. The vertical extremes are $-2-2=-4$ and $-2+2=0$.\n\nDomain: $1\\leq x\\leq5$. Range: $-4\\leq y\\leq0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p10-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Centre $(-2,1)$ and radius $\\sqrt3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $-2-\\sqrt3\\leq x\\leq-2+\\sqrt3$.\n\nRange: $1-\\sqrt3\\leq y\\leq1+\\sqrt3$.",
          "worked": "The horizontal extremes are $-2\\pm\\sqrt3$; the vertical extremes are $1\\pm\\sqrt3$.\n\nDomain: $-2-\\sqrt3\\leq x\\leq-2+\\sqrt3$.\n\nRange: $1-\\sqrt3\\leq y\\leq1+\\sqrt3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p10-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Centre $(-1,1)$ and radius $\\frac14$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $-\\frac54\\leq x\\leq-\\frac34$. Range: $\\frac34\\leq y\\leq\\frac54$.",
          "worked": "The horizontal extremes are $-1-\\frac14=-\\frac54$ and $-1+\\frac14=-\\frac34$. The vertical extremes are $1-\\frac14=\\frac34$ and $1+\\frac14=\\frac54$.\n\nDomain: $-\\frac54\\leq x\\leq-\\frac34$. Range: $\\frac34\\leq y\\leq\\frac54$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
