              },
              {
                "type": "math",
                "latex": "\\frac{249}{100}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p42-q8-answer-fiftieths",
            "type": "paragraph",
