  "content": {
    "id": "p42-q8-response",
    "type": "question",
    "label": "8",
    "prompt": "Write three different fractions with different denominators that are between $2.4$ and $2.5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "For example, $\\frac{49}{20}$, $\\frac{249}{100}$ and $\\frac{123}{50}$. Many other answers are possible.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p42-q8-answer-endpoints",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The endpoints are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{24}{10}",
                "display": false
              },
              {
                "type": "text",
                "text": " and ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{25}{10}",
                "display": false
              },
              {
                "type": "text",
                "text": ". Use equivalent fractions with larger denominators.",
                "marks": []
              }
            ]
          },
          {
            "id": "p42-q8-answer-twentieths",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\frac{24}{10}&=\\frac{48}{20}\\\\\\frac{25}{10}&=\\frac{50}{20}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p42-q8-answer-first",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "One fraction between them is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\frac{49}{20}",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p42-q8-answer-hundredths",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}2.4&=\\frac{240}{100}\\\\2.5&=\\frac{250}{100}\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p42-q8-answer-second",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Another fraction between them is ",
