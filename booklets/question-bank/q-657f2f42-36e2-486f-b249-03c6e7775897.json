  "content": {
    "id": "p11-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Find the area of a circle with the given diameter. Give each area in terms of $\\pi$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$10\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}r&=10\\div2=5\\text{ cm}\\\\A&=\\pi r^2\\\\A&=\\pi\\times5^2\\\\A&=25\\pi\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\text{ cm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac14\\pi\\text{ cm}^2$",
          "worked": "$$\\begin{align*}r&=5\\div2=\\frac52\\text{ cm}\\\\A&=\\pi r^2\\\\A&=\\pi\\left(\\frac52\\right)^2\\\\A&=\\frac{25\\pi}{4}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p11-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$20\\text{ mm}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$100\\pi\\text{ mm}^2$",
          "worked": "$$\\begin{align*}r&=20\\div2=10\\text{ mm}\\\\A&=\\pi r^2\\\\A&=\\pi\\times10^2\\\\A&=100\\pi\\text{ mm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p11-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$15\\text{ m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$56\\frac14\\pi\\text{ m}^2$",
          "worked": "$$\\begin{align*}r&=15\\div2=\\frac{15}{2}\\text{ m}\\\\A&=\\pi r^2\\\\A&=\\pi\\left(\\frac{15}{2}\\right)^2\\\\A&=\\frac{225\\pi}{4}\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
