    "children": [
      {
        "id": "p12-q6a",
        "type": "part",
        "label": "a",
        "prompt": "A geometric sequence is given by the formula $a_n = 3\\cdot 2^{n-1}$. Find $a_5$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$48$",
          "worked": "$$\\begin{align*}a_5 &= 3\\cdot 2^{5-1}\\\\a_5 &= 3\\cdot 16\\\\a_5 &= 48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q6b",
        "type": "part",
        "label": "b",
        "prompt": "A geometric sequence is given by the formula $a_n = b\\cdot 3^{n-1}$. Find $b$ if $a_4 = 9$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b=\\dfrac{1}{3}$",
          "worked": "$$\\begin{align*}9 &= b\\cdot 3^{4-1}\\\\9 &= 27b\\\\b &= \\frac{9}{27}\\\\b &= \\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q6c",
        "type": "part",
        "label": "c",
        "prompt": "A geometric sequence is given by the formula $a_n = 2\\cdot r^{n-1}$. Find $r$ if $a_5 = 8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=\\pm\\sqrt{2}$",
          "worked": "$$\\begin{align*}8 &= 2\\cdot r^{5-1}\\\\8 &= 2r^4\\\\r^4 &= 4\\\\r^2 &= 2\\\\r &= \\pm\\sqrt{2}\\end{align*}$$\nBoth signs satisfy $2r^4=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
