  "content": {
    "id": "p14-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The formula for the area of a trapezium is $A = \\frac{1}{2}h(a + b)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $A$ given that $a = 7$, $b = 8$ and $h = 10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A = 75$",
          "worked": "$$\\begin{align*} A &= \\frac{1}{2}h(a+b) \\\\ A &= \\frac{1}{2}(10)(7+8) \\\\ A &= 5(15) \\\\ A &= 75 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $h$ given that $A = 72$, $a = 6$ and $b = 10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h = 9$",
          "worked": "$$\\begin{align*} A &= \\frac{1}{2}h(a+b) \\\\ 72 &= \\frac{1}{2}h(6+10) \\\\ 72 &= 8h \\\\ h &= 9 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p14-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the value of $b$ given that $A = 78$, $a = 7$ and $h = 12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$b = 6$",
          "worked": "$$\\begin{align*} A &= \\frac{1}{2}h(a+b) \\\\ 78 &= \\frac{1}{2}(12)(7+b) \\\\ 78 &= 6(7+b) \\\\ 13 &= 7+b \\\\ b &= 6 \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
