    "children": [
      {
        "id": "p13-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can the deck be arranged? Express your answer in the form $n!$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6!$",
          "worked": "The six cards are distinct.\n\n$$N=6!.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If two identical decks are combined, then how many ways can the cards be arranged? Express your answer in the form $\\dfrac{a!}{(b!)^c}$ where $a,b,c$ are positive integers.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{12!}{(2!)^6}$",
          "worked": "There are 12 cards, with two identical copies of each of the six numbers.\n\n$$\\begin{align*}N&=\\frac{12!}{2!\\,2!\\,2!\\,2!\\,2!\\,2!}\\\\N&=\\frac{12!}{(2!)^6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p13-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "If $n$ identical decks are combined, then find an expression for the number of ways that the cards can be arranged.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(6n)!}{(n!)^6}$\n\nDivide the arrangements of $6n$ cards by $n!$ for each of the six groups of identical cards.",
          "worked": "There are $6n$ cards, with $n$ identical copies of each of the six numbers.\n\n$$\\begin{align*}N&=\\frac{(6n)!}{n!\\,n!\\,n!\\,n!\\,n!\\,n!}\\\\N&=\\frac{(6n)!}{(n!)^6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
