  "content": {
    "id": "p14-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Evaluate each expression for $x=-0.4$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.4$",
          "worked": "$$\\begin{align*}-x&=-(-0.4)\\\\-x&=0.4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$5x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}5x+7&=5\\times(-0.4)+7\\\\5x+7&=-2+7\\\\5x+7&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p14-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$5x-7.8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-9.8$",
          "worked": "$$\\begin{align*}5x-7.8&=5\\times(-0.4)-7.8\\\\5x-7.8&=-2-7.8\\\\5x-7.8&=-9.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p14-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$6x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.96$",
          "worked": "$$\\begin{align*}6x^2&=6\\times(-0.4)^2\\\\6x^2&=6\\times0.16\\\\6x^2&=0.96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
