  "content": {
    "id": "p33-q17-response",
    "type": "question",
    "label": null,
    "prompt": "A group of five students sit a quiz. The quizzes are then distributed amongst the same group of five students for correction. No student is to correct their own quiz. How many ways can this be done?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$44$ ways.\n\nUse inclusion–exclusion to exclude distributions in which students receive their own quizzes.",
      "worked": "Let $A_i$ be the set of distributions in which student $i$ receives their own quiz. There are $5!$ distributions in total. For any chosen $k$ students receiving their own quizzes, the remaining quizzes can be distributed in $(5-k)!$ ways. Applying inclusion–exclusion, the number $N$ of permitted distributions is\n$$\\begin{aligned}N&=5!-\\binom51 4!+\\binom52 3!-\\binom53 2!+\\binom54 1!-\\binom55 0!\\\\N&=120-120+60-20+5-1\\\\N&=44.\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
