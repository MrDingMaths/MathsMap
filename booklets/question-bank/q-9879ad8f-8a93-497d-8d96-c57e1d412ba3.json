    "id": "p13-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Seven-eighths of the trees in a forest are eucalypts. It is known that there are 5000 trees in the forest.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "How many eucalypts are there in the forest?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4375 eucalypts.",
          "worked": "$$\\begin{align*}\\frac{7}{8}\\times5000&=7\\times625\\\\\\frac{7}{8}\\times5000&=4375\\end{align*}$$\nThere are 4375 eucalypts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the trees are not eucalypts?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$1-\\frac{7}{8}=\\frac{1}{8}$$\nThe fraction that are not eucalypts is $\\frac{1}{8}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
