  "content": {
    "id": "p17-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The mean of the numbers $11, 17, 18, 22, 38, x$ is $24$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p17-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the value of $x$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=38$",
          "worked": "The six values have total $6\\times24=144$. The five known values have total $11+17+18+22+38=106$.\n\n$$\\begin{align*}x&=144-106\\\\x&=38\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p17-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the median?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "In order, the values are $11,17,18,22,38,38$. There are six values, so take the average of the two middle values.\n\n$$\\begin{align*}\\text{Median}&=\\frac{18+22}{2}\\\\\\text{Median}&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
