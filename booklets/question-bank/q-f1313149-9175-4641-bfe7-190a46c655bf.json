  "content": {
    "id": "v2-a6564-p25-practice-j10-084451-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=x^2-3$.\n\nFor each $g(x)$, simplify $f(g(x))$, hence state the domain.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a6564-p25-practice-j10-084451-j10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(x)=x-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=x^2-4x+1$, with domain $(-\\infty,\\infty)$.",
          "worked": "$$\\begin{align*}f(g(x))&=(x-2)^2-3\\\\&=x^2-4x+1\\end{align*}$$\nSince $g(x)=x-2$ is defined for all $x$, the domain of $f(g(x))$ is all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-a6564-p25-practice-j10-084451-j10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(x)=\\sqrt{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=x-5$, with domain $[2,\\infty)$.",
          "worked": "$$\\begin{align*}f(g(x))&=(\\sqrt{x-2})^2-3\\\\&=x-5\\end{align*}$$\nSince the domain of $g(x)$ is $x\\geq2$, the domain of $f(g(x))$ is $x\\geq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-a6564-p25-practice-j10-084451-j10-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(x)=\\dfrac{1}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=\\dfrac{1}{(x-2)^2}-3$, with domain $x\\neq2$.",
          "worked": "$$\\begin{align*}f(g(x))&=\\left(\\dfrac{1}{x-2}\\right)^2-3\\\\&=\\dfrac{1}{(x-2)^2}-3\\end{align*}$$\nSince $g(x)$ is undefined at $x=2$, the domain of $f(g(x))$ is $x\\neq2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-a6564-p25-practice-j10-084451-j10-q-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(x)=\\sqrt{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=x-2$, with domain $[-1,\\infty)$.",
          "worked": "$$\\begin{align*}f(g(x))&=(\\sqrt{x+1})^2-3\\\\&=x-2\\end{align*}$$\nSince the domain of $g(x)$ is $x\\geq-1$, the domain of $f(g(x))$ is $x\\geq-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
