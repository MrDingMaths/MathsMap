  "content": {
    "id": "p10-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A particle is projected from the origin with speed 20 m/s at $60^\\circ$ to the horizontal. By integrating, find the velocity and displacement, and write the acceleration, velocity, and displacement in vector form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\mathbf a=-10\\mathbf j\\text{ m s}^{-2}$, $\\mathbf v=10\\mathbf i+(10\\sqrt3-10t)\\mathbf j\\text{ m s}^{-1}$, $\\mathbf r=10t\\mathbf i+(10\\sqrt3t-5t^2)\\mathbf j\\text{ m}$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p10-q1-answer-intro",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Shown here is the derivation using ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\mathbf i",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " and ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "\\mathbf j",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " notation.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p10-q1-answer-velocity",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\mathbf a&=0\\mathbf i-10\\mathbf j\\\\\\mathbf v&=C_1\\mathbf i+(-10t+C_2)\\mathbf j\\\\\\mathbf v(0)&=20\\cos60^\\circ\\mathbf i+20\\sin60^\\circ\\mathbf j\\\\\\mathbf v(0)&=10\\mathbf i+10\\sqrt3\\mathbf j\\\\C_1&=10,\\qquad C_2=10\\sqrt3\\\\\\mathbf v&=\\boxed{10\\mathbf i+(10\\sqrt3-10t)\\mathbf j}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p10-q1-answer-displacement",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 4,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\mathbf r&=(10t+C_3)\\mathbf i+(10\\sqrt3t-5t^2+C_4)\\mathbf j\\\\\\mathbf r(0)&=0\\mathbf i+0\\mathbf j\\\\C_3&=0,\\qquad C_4=0\\\\\\mathbf r&=\\boxed{10t\\mathbf i+(10\\sqrt3t-5t^2)\\mathbf j}\\\\\\mathbf a&=\\boxed{-10\\mathbf j}\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
