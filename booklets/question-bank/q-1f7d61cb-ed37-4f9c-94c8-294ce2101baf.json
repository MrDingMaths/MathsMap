      "evidence": ".booklet-work/reasoning-ratings/calls/enrichment-maths-1-ch16-part18/020bc7f20a0c6d3397106bcddf50cb672e56564c8104d0b404480e5147a6371a-1792558083004/last-message.txt"
    }
  },
  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Let $A=\\{2,3,4\\}$ and $B=\\{3,4,5\\}$ have universal set $\\Omega=\\{1,2,3,4,5,6\\}$. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$A\\cap B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{3,4\\}$",
          "worked": "The elements common to $A$ and $B$ are 3 and 4.\n$$A\\cap B=\\{3,4\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$A\\cup B$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{2,3,4,5\\}$",
          "worked": "Include every element belonging to either set, without repetition.\n$$A\\cup B=\\{2,3,4,5\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$A\\cup A'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,3,4,5,6\\}$",
          "worked": "A set together with its complement contains every element of the universal set.\n$$A\\cup A'=\\Omega=\\{1,2,3,4,5,6\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$A\\cap A'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\varnothing$",
          "worked": "No element belongs to both a set and its complement.\n$$A\\cap A'=\\varnothing.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p7-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$A'\\cup B'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,5,6\\}$",
          "worked": "$$\\begin{align*}A'&=\\{1,5,6\\}\\\\B'&=\\{1,2,6\\}\\\\A'\\cup B'&=\\{1,2,5,6\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$(A\\cap B)'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,2,5,6\\}$",
          "worked": "$$A\\cap B=\\{3,4\\}.$$\nTake the elements of $\\Omega$ outside this intersection.\n$$(A\\cap B)'=\\{1,2,5,6\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p7-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$A'\\cap B'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,6\\}$",
          "worked": "$$\\begin{align*}A'&=\\{1,5,6\\}\\\\B'&=\\{1,2,6\\}\\\\A'\\cap B'&=\\{1,6\\}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$(A\\cup B)'$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\{1,6\\}$",
          "worked": "$$A\\cup B=\\{2,3,4,5\\}.$$\nTake the elements of $\\Omega$ outside this union.\n$$(A\\cup B)'=\\{1,6\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      }
    ]
  },
