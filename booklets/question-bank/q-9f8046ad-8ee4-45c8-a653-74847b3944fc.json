              "type": "text",
              "text": "The ",
              "marks": []
            },
            {
              "type": "text",
              "text": "Frobenius coin problem",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " asks for the largest monetary amount that cannot be obtained using only coins of denominations ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "m",
              "display": false
            },
            {
              "type": "text",
              "text": " and ",
