    "children": [
      {
        "id": "p38-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "A jacket originally costs $\\$80$. Its price increased by $20\\%$. What is its new price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$96$",
          "worked": "$$\\begin{align*}\\text{New price}&=\\$80\\times1.20\\\\&=\\$96\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p38-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "A jacket originally costs $\\$80$. Its price was reduced to $\\$20$. What was the percentage discount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75\\%$ discount",
          "worked": "$$\\begin{align*}\\text{Discount}&=\\$80-\\$20=\\$60\\\\\\text{Percentage discount}&=\\frac{60}{80}\\times100\\%\\\\&=75\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p38-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "A jacket originally costs $\\$80$. Its price decreased by $\\$20$. What is the percentage discount?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$ discount",
          "worked": "The discount is $\\$20$ from the original price of $\\$80$.\n$$\\begin{align*}\\text{Percentage discount}&=\\frac{20}{80}\\times100\\%\\\\&=25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p38-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "A jacket originally costs $\\$80$. It's selling for $20\\%$ off. What is the sale price?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$64$",
          "worked": "The sale price is $80\\%$ of the original price.\n$$\\begin{align*}\\text{Sale price}&=\\$80\\times0.80\\\\&=\\$64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
