  "content": {
    "id": "v2-8a855d2d5-p8-topic-slot-2-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Find the $x$-intercept of the tangent to $y=e^x$ at the point $P(2,e^2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=1$",
      "worked": "$$\\begin{aligned}\\frac{dy}{dx}&=e^x\\\\m&=e^2\\end{aligned}$$\nThe tangent is\n$$\\begin{aligned}y-e^2&=e^2(x-2).\\end{aligned}$$\nAt $y=0$:\n$$\\begin{aligned}-e^2&=e^2(x-2)\\\\-1&=x-2\\\\x&=1\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
