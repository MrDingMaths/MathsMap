  "content": {
    "id": "p11-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Simplify these expressions.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{z}{4}+\\frac{z}{3}+\\frac{z}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2z}{3}$",
          "worked": "$$\\begin{align*}\\frac{z}{4}+\\frac{z}{3}+\\frac{z}{12}&=\\frac{3z}{12}+\\frac{4z}{12}+\\frac{z}{12}\\\\&=\\frac{8z}{12}\\\\&=\\frac{2z}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p11-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{2x}{5}+\\frac{x}{2}-\\frac{x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{10}$",
          "worked": "$$\\begin{align*}\\frac{2x}{5}+\\frac{x}{2}-\\frac{x}{5}&=\\frac{4x}{10}+\\frac{5x}{10}-\\frac{2x}{10}\\\\&=\\frac{7x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{7u}{2}+\\frac{3u}{4}-\\frac{5u}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{29u}{8}$",
          "worked": "$$\\begin{align*}\\frac{7u}{2}+\\frac{3u}{4}-\\frac{5u}{8}&=\\frac{28u}{8}+\\frac{6u}{8}-\\frac{5u}{8}\\\\&=\\frac{29u}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{8k}{3}+\\frac{k}{6}-\\frac{5k}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{29k}{12}$",
          "worked": "$$\\begin{align*}\\frac{8k}{3}+\\frac{k}{6}-\\frac{5k}{12}&=\\frac{32k}{12}+\\frac{2k}{12}-\\frac{5k}{12}\\\\&=\\frac{29k}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{p}{4}+\\frac{p}{2}-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3p-12}{4}$",
          "worked": "$$\\begin{align*}\\frac{p}{4}+\\frac{p}{2}-3&=\\frac{p}{4}+\\frac{2p}{4}-\\frac{12}{4}\\\\&=\\frac{3p-12}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p11-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{5j}{12}-\\frac{j}{3}+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{j+24}{12}$",
          "worked": "$$\\begin{align*}\\frac{5j}{12}-\\frac{j}{3}+2&=\\frac{5j}{12}-\\frac{4j}{12}+\\frac{24}{12}\\\\&=\\frac{j+24}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
