  "content": {
    "id": "v2-4ab09-p14-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "Tamsin is paid \\$1043.10 for a regular 38-hour week.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4ab09-p14-practice-slot-10-slot-10-q-a",
        "type": "part",
        "label": "a",
        "prompt": "What is her hourly rate of pay?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$27.45/h",
          "worked": "$\\begin{align*}\\text{Hourly rate}&=1043.10\\div38\\\\\\text{Hourly rate}&=\\$27.45/\\text{h}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-4ab09-p14-practice-slot-10-slot-10-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What is her wage for a week in which she works 46 hours, if overtime hours are paid at double time?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$1482.30",
          "worked": "$\\begin{align*}\\text{Overtime hours}&=46-38\\\\\\text{Overtime hours}&=8\\\\\\text{Overtime pay}&=27.45\\times8\\times2\\\\\\text{Overtime pay}&=\\$439.20\\\\\\text{Total wage}&=1043.10+439.20\\\\\\text{Total wage}&=\\$1482.30\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      }
    ]
  },
