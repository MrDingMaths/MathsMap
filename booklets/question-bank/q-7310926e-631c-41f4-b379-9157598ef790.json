  "content": {
    "id": "p24-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Simplify",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x^2-4}{x+2}\\times\\dfrac{1}{x-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{x^2-4}{x+2}\\times\\frac{1}{x-2}&=\\frac{(x-2)(x+2)}{x+2}\\times\\frac{1}{x-2}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p24-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{x^2-4}\\times(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x-2}$",
          "worked": "$$\\begin{aligned}\\frac{1}{x^2-4}\\times(x+2)&=\\frac{x+2}{(x-2)(x+2)}\\\\&=\\frac{1}{x-2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p24-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x^2-4)\\times\\dfrac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-2$",
          "worked": "$$\\begin{aligned}(x^2-4)\\times\\frac{1}{x+2}&=\\frac{(x-2)(x+2)}{x+2}\\\\&=x-2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x^2-9}{x+3}\\div(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{x^2-9}{x+3}\\div(x-3)&=\\frac{x^2-9}{x+3}\\times\\frac{1}{x-3}\\\\&=\\frac{(x-3)(x+3)}{(x+3)(x-3)}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p24-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$(x^2-9)\\div\\dfrac{x+3}{x-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-3)^2$",
          "worked": "$$\\begin{aligned}(x^2-9)\\div\\frac{x+3}{x-3}&=(x^2-9)\\times\\frac{x-3}{x+3}\\\\&=\\frac{(x-3)(x+3)(x-3)}{x+3}\\\\&=(x-3)^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p24-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x+3}{x^2-9}\\times(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{x+3}{x^2-9}\\times(x-3)&=\\frac{(x+3)(x-3)}{(x-3)(x+3)}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
