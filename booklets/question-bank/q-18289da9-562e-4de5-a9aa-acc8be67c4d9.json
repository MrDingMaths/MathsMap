  "content": {
    "id": "p73-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Suppose $\\angle ABC$ is obtuse. What type of angle is $\\angle DEF$, given that $\\angle DEF=2\\angle ABC$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Reflex",
      "worked": "$\\angle ABC$ is obtuse, so $90^\\circ<\\angle ABC<180^\\circ$.\n$$\\begin{align*}\\angle DEF&=2\\angle ABC\\end{align*}$$\nTherefore $180^\\circ<\\angle DEF<360^\\circ$.\n\n$\\angle DEF$ is reflex.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
