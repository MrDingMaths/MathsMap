  "content": {
    "id": "p29-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Simplify using $|xy|=|x||y|$ and $\\left|\\frac{x}{y}\\right|=\\frac{|x|}{|y|}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$|3x|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3|x|$",
          "worked": "$$\\begin{align*}|3x|&=|3||x|\\\\&=3|x|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$|-5xy|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5|x||y|$",
          "worked": "$$\\begin{align*}|-5xy|&=|-5||x||y|\\\\&=5|x||y|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left|\\frac{x}{3}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{|x|}{3}$",
          "worked": "$$\\begin{align*}\\left|\\frac{x}{3}\\right|&=\\frac{|x|}{|3|}\\\\&=\\frac{|x|}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left|-\\frac{3}{2x}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{2|x|}$, $x\\ne0$.",
          "worked": "$$\\begin{align*}\\left|-\\frac{3}{2x}\\right|&=\\frac{|-3|}{|2||x|}\\\\&=\\frac{3}{2|x|}\\end{align*}$$\nHere $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$|2x(x+1)|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2|x||x+1|$",
          "worked": "$$\\begin{align*}|2x(x+1)|&=|2||x||x+1|\\\\&=2|x||x+1|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left|\\frac{x-y}{x+y}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{|x-y|}{|x+y|}$, $x+y\\ne0$.",
          "worked": "$$\\begin{align*}\\left|\\frac{x-y}{x+y}\\right|&=\\frac{|x-y|}{|x+y|}\\end{align*}$$\nHere $x+y\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$|-x(x+5)|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|x||x+5|$",
          "worked": "$$\\begin{align*}|-x(x+5)|&=|-x||x+5|\\\\&=|x||x+5|\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left|-\\frac{x^2}{3y}\\right|$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^2}{3|y|}$, $y\\ne0$.",
          "worked": "$$\\begin{align*}\\left|-\\frac{x^2}{3y}\\right|&=\\frac{|-x^2|}{|3||y|}\\\\&=\\frac{|x^2|}{3|y|}\\\\&=\\frac{x^2}{3|y|}\\end{align*}$$\nSince $x^2\\ge0$, $|x^2|=x^2$. Here $y\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
