      {
        "id": "p18-q10-a",
        "type": "group",
        "label": "a",
        "prompt": "If $\\angle BAE=30^{\\circ}$, find the size of:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q10-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$\\angle ABE$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$60^{\\circ}$",
              "worked": "$$\\begin{align*}\\angle ABE&=180^{\\circ}-90^{\\circ}-30^{\\circ}\\\\\\angle ABE&=60^{\\circ}\\end{align*}$$\nThe angles in triangle $ABE$ sum to $180^{\\circ}$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p18-q10-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$\\angle CDE$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$30^{\\circ}$",
              "worked": "$E$ lies on $AC$ and $BD$, so $\\angle BAE=\\angle BAC$ and $\\angle CDE=\\angle CDB$.\n$$\\begin{align*}\\angle CDE&=\\angle BAC\\\\\\angle CDE&=30^{\\circ}\\end{align*}$$\nAngles subtended by the same chord $BC$ in the same segment are equal.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\angle BAE=a^{\\circ}$ and $\\angle ECD=b^{\\circ}$, find an equation relating $a$ and $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a+b=90$",
          "worked": "Angles subtended by chord $BC$ in the same segment are equal, so $\\angle CDE=a^{\\circ}$. In right-angled triangle $CED$,\n$$\\begin{align*}a+b+90&=180\\\\a+b&=90.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q10-c",
        "type": "group",
        "label": "c",
        "prompt": {
          "format": "maths-editor-document-v1",
