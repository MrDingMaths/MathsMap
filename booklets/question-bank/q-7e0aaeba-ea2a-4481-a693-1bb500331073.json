          {
            "id": "p18-q10-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$CE$ in terms of $x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(10-x)\\text{ cm}$",
              "worked": "$$\\begin{align*}CE&=AC-AE\\\\CE&=(10-x)\\text{ cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          },
          {
            "id": "p18-q10-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$DE$ in terms of $y$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(10-y)\\text{ cm}$",
              "worked": "$$\\begin{align*}DE&=BD-BE\\\\DE&=(10-y)\\text{ cm}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 12
          }
        ]
      },
      {
        "id": "p18-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "Show that $x=y$ or $x+y=10$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-y)(10-x-y)=0$, so $x=y$ or $x+y=10$.",
          "worked": "By the intersecting-chords theorem, $AE\\times CE=BE\\times DE$.\n$$\\begin{align*}x(10-x)&=y(10-y)\\\\10x-x^2-10y+y^2&=0\\\\10(x-y)-(x-y)(x+y)&=0\\\\(x-y)(10-x-y)&=0.\\end{align*}$$\nHence $x=y$ or $x+y=10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p18-q10-e",
        "type": "group",
        "label": "e",
        "prompt": "Find, in terms of $x$ and $y$:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p18-q10-e-i",
            "type": "part",
            "label": "i",
            "prompt": "area $\\triangle ABE$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{xy}{2}\\text{ cm}^2$",
              "worked": "$AE$ and $BE$ are perpendicular.\n$$\\begin{align*}\\operatorname{Area}(\\triangle ABE)&=\\frac12\\times AE\\times BE\\\\\\operatorname{Area}(\\triangle ABE)&=\\frac{xy}{2}\\text{ cm}^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          },
          {
            "id": "p18-q10-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "area $\\triangle CED$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{(10-x)(10-y)}{2}\\text{ cm}^2$",
              "worked": "$CE$ and $DE$ are perpendicular.\n$$\\begin{align*}\\operatorname{Area}(\\triangle CED)&=\\frac12\\times CE\\times DE\\\\\\operatorname{Area}(\\triangle CED)&=\\frac{(10-x)(10-y)}{2}\\text{ cm}^2\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 19
          }
        ]
      },
      {
        "id": "p18-q10-f",
        "type": "part",
        "label": "f",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p18-q10-area-instruction",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Next, suppose that ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "\\operatorname{Area}(\\triangle ABE)=\\operatorname{Area}(\\triangle CED).",
                  "display": false
                }
              ]
            },
            {
              "id": "p18-q10-f-show",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Show that ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "x+y=10.",
                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+y=10$",
          "worked": "$$\\begin{align*}\\frac{xy}{2}&=\\frac{(10-x)(10-y)}{2}\\\\xy&=100-10x-10y+xy\\\\10x+10y&=100\\\\10(x+y)&=100\\\\x+y&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p18-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "Find the area of $\\triangle ABE$ in terms of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x(10-x)}{2}\\text{ cm}^2$",
          "worked": "Since $x+y=10$, $y=10-x$.\n$$\\begin{align*}\\operatorname{Area}(\\triangle ABE)&=\\frac{xy}{2}\\\\\\operatorname{Area}(\\triangle ABE)&=\\frac{x(10-x)}{2}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p18-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "Find $x$ if the area of $\\triangle ABE$ is $12\\text{ cm}^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$ or $x=6$.",
          "worked": "$$\\begin{align*}\\frac{x(10-x)}{2}&=12\\\\10x-x^2&=24\\\\x^2-10x+24&=0\\\\(x-4)(x-6)&=0\\end{align*}$$\nThus $x=4$ or $x=6$. Both satisfy $0<x<10$ and give area $\\tfrac12\\times4\\times6=12\\text{ cm}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
