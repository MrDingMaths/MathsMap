    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\tan^{-1}(e^{3x})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3e^{3x}}{1+e^{6x}}$.",
          "worked": "$$\\begin{aligned}u&=e^{3x},&\\frac{du}{dx}&=3e^{3x}.\\end{aligned}$$\n$$\\begin{aligned}y&=\\tan^{-1}u,&\\frac{dy}{du}&=\\frac{1}{1+u^2}.\\end{aligned}$$\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\&=\\frac{1}{1+u^2}\\times3e^{3x}\\\\&=\\frac{3e^{3x}}{1+e^{6x}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sin^{-1}(x^3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3x^2}{\\sqrt{1-x^6}}$.",
          "worked": "$$\\begin{aligned}u&=x^3,&\\frac{du}{dx}&=3x^2.\\end{aligned}$$\n$$\\begin{aligned}y&=\\sin^{-1}u,&\\frac{dy}{du}&=\\frac{1}{\\sqrt{1-u^2}}.\\end{aligned}$$\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\&=\\frac{1}{\\sqrt{1-u^2}}\\times3x^2\\\\&=\\frac{3x^2}{\\sqrt{1-x^6}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p18-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\cos^{-1}(\\log_e x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{x\\sqrt{1-(\\log_e x)^2}}$.",
          "worked": "$$\\begin{aligned}u&=\\log_e x,&\\frac{du}{dx}&=\\frac1x.\\end{aligned}$$\n$$\\begin{aligned}y&=\\cos^{-1}u,&\\frac{dy}{du}&=-\\frac{1}{\\sqrt{1-u^2}}.\\end{aligned}$$\n$$\\begin{aligned}\\frac{dy}{dx}&=\\frac{dy}{du}\\times\\frac{du}{dx}\\\\&=-\\frac{1}{\\sqrt{1-u^2}}\\times\\frac1x\\\\&=\\frac{-1/x}{\\sqrt{1-(\\log_e x)^2}}\\\\&=-\\frac{1}{x\\sqrt{1-(\\log_e x)^2}}.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
