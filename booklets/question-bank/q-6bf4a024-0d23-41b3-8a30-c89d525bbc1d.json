  "content": {
    "id": "p9-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{x+2}{3}-\\frac{x-1}{2}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}\\frac{2(x+2)}{6}-\\frac{3(x-1)}{6}&=1\\\\\\frac{2x+4-3x+3}{6}&=1\\\\\\frac{-x+7}{6}&=1\\\\-x+7&=6\\\\7&=x+6\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p9-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x-4}{5}-\\frac{x+2}{3}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-26$",
          "worked": "$$\\begin{align*}\\frac{3(x-4)}{15}-\\frac{5(x+2)}{15}&=2\\\\\\frac{3x-12-5x-10}{15}&=2\\\\\\frac{-2x-22}{15}&=2\\\\-2x-22&=30\\\\-52&=2x\\\\x&=-26\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      },
      {
        "id": "p9-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x+1}{5}-\\frac{x+1}{6}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=59$",
          "worked": "$$\\begin{align*}\\frac{6(x+1)}{30}-\\frac{5(x+1)}{30}&=2\\\\\\frac{6x+6-5x-5}{30}&=2\\\\\\frac{x+1}{30}&=2\\\\x+1&=60\\\\x&=59\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p9-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x+5}{2}-\\frac{x-1}{4}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}\\frac{2(x+5)}{4}-\\frac{x-1}{4}&=3\\\\\\frac{2x+10-x+1}{4}&=3\\\\\\frac{x+11}{4}&=3\\\\x+11&=12\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p9-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{2y-1}{4}-\\frac{y-2}{6}=-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{13}{4}$",
          "worked": "$$\\begin{align*}\\frac{3(2y-1)}{12}-\\frac{2(y-2)}{12}&=-1\\\\\\frac{6y-3-2y+4}{12}&=-1\\\\\\frac{4y+1}{12}&=-1\\\\4y+1&=-12\\\\4y&=-13\\\\y&=-\\frac{13}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p9-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2x+3}{4}-\\frac{7x-1}{6}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{13}{8}$",
          "worked": "$$\\begin{align*}\\frac{3(2x+3)}{12}-\\frac{2(7x-1)}{12}&=2\\\\\\frac{6x+9-14x+2}{12}&=2\\\\\\frac{-8x+11}{12}&=2\\\\-8x+11&=24\\\\-13&=8x\\\\x&=-\\frac{13}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
