  "content": {
    "id": "bridge-product-coefficient-root",
    "type": "question",
    "label": "",
    "prompt": "Consider $(2-x)(1+x)^4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "bridge-product-coefficient-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(1+x)^4$ as far as the term in $x^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1+4x+6x^2+\\cdots$",
          "worked": "$$(1+x)^4=1+\\binom41x+\\binom42x^2+\\cdots=1+4x+6x^2+\\cdots.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "bridge-product-coefficient-b",
        "type": "part",
        "label": "b",
        "prompt": "Which two products contribute to the term in $x^2$ when this expansion is multiplied by $(2-x)$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(6x^2)$ and $(-x)(4x)$.",
          "worked": "The exponents must add to $2$: $0+2=2$ and $1+1=2$. The contributions are $2(6x^2)=12x^2$ and $(-x)(4x)=-4x^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "bridge-product-coefficient-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the coefficient of $x^2$ in $(2-x)(1+x)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "The coefficient is $2(6)-4=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
