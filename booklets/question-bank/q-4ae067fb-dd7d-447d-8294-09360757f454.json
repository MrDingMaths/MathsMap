  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Consider the function $h(x)=x^3+3x^2-2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q5-a-node",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $h(-x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h(-x)=-x^3+3x^2-2$.",
          "worked": "$$\\begin{align*}h(-x)&=(-x)^3+3(-x)^2-2\\\\h(-x)&=-x^3+3x^2-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p21-q5-b-node",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that $h(x)$ is neither even nor odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h(-x)\\ne h(x)$ and $h(-x)\\ne-h(x)$, so $h$ is neither even nor odd.",
          "worked": "$$\\begin{align*}-h(x)&=-(x^3+3x^2-2)\\\\-h(x)&=-x^3-3x^2+2\\end{align*}$$\nThe expression $h(-x)=-x^3+3x^2-2$ equals neither $h(x)$ nor $-h(x)$ identically. Therefore $h$ is neither even nor odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
