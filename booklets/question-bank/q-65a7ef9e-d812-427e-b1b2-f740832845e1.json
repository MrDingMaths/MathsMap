    "children": [
      {
        "id": "p6-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(x)=x^4+2x^2+3$, show that $f(-x)=f(x)$ for all values of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=x^4+2x^2+3=f(x)$ for all real $x$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^4+2(-x)^2+3\\\\f(-x)&=x^4+2x^2+3\\\\f(-x)&=f(x)\\end{align*}$$\nEven powers are unchanged when $x$ is replaced by $-x$, so the identity holds for all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "If $g(x)=x^3+\\dfrac{4}{x}$, show that $g(-x)=-g(x)$ whenever $x\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(-x)=-x^3-\\dfrac4x=-g(x)$ whenever $x\\ne0$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}g(-x)&=(-x)^3+\\frac4{-x}\\\\g(-x)&=-x^3-\\frac4x\\\\g(-x)&=-\\left(x^3+\\frac4x\\right)\\\\g(-x)&=-g(x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p6-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "If $h(x)=\\dfrac{x}{x^2+1}$, show that $h\\!\\left(\\dfrac1x\\right)=h(x)$ whenever $x\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h\\!\\left(\\dfrac1x\\right)=\\dfrac{x}{x^2+1}=h(x)$ whenever $x\\ne0$.\n\nSubstitute $\\frac{1}{x}$ and multiply the numerator and denominator by $x^2$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}h\\!\\left(\\frac1x\\right)&=\\frac{\\frac1x}{\\left(\\frac1x\\right)^2+1}\\\\h\\!\\left(\\frac1x\\right)&=\\frac{\\frac1x\\times x^2}{\\left(\\frac1{x^2}+1\\right)x^2}\\\\h\\!\\left(\\frac1x\\right)&=\\frac{x}{1+x^2}\\\\h\\!\\left(\\frac1x\\right)&=h(x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
