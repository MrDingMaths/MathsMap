  "content": {
    "id": "v2-660d8-p50-practice-slot-11-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Factorise the following using difference of two squares.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-660d8-p50-practice-slot-11-upper-slot-11-upper-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+4)^{2}-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+7)$",
          "worked": "$$\\begin{align*}(x+4)^{2}-9&=(x+4)^{2}-3^{2}\\\\&=(x+4-3)(x+4+3)\\\\&=(x+1)(x+7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-660d8-p50-practice-slot-11-upper-slot-11-upper-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x-2)^{2}-36$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x-8)(x+4)$",
          "worked": "$$\\begin{align*}(x-2)^{2}-36&=(x-2)^{2}-6^{2}\\\\&=(x-2-6)(x-2+6)\\\\&=(x-8)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-660d8-p50-practice-slot-11-upper-slot-11-upper-c",
        "type": "part",
        "label": "c",
        "prompt": "$49-(x+3)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4-x)(10+x)$",
          "worked": "$$\\begin{align*}49-(x+3)^{2}&=7^{2}-(x+3)^{2}\\\\&=(7-(x+3))(7+(x+3))\\\\&=(4-x)(10+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "v2-660d8-p50-practice-slot-11-upper-slot-11-upper-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2x+1)^{2}-(x-3)^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)(3x-2)$",
          "worked": "$$\\begin{align*}(2x+1)^{2}-(x-3)^{2}&=(2x+1-(x-3))(2x+1+(x-3))\\\\&=(x+4)(3x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
