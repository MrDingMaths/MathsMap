  "content": {
    "id": "p2-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Convert the following index forms to logarithmic form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^3=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2(8)=3$",
          "worked": "Use base $2$ and argument $8$. The logarithm equals the index $3$.\n\n$$\\log_2(8)=3$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4^2=16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4(16)=2$",
          "worked": "Use base $4$ and argument $16$. The logarithm equals the index $2$.\n\n$$\\log_4(16)=2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^{1/2}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4(2)=\\frac{1}{2}$",
          "worked": "Use base $4$ and argument $2$. The logarithm equals the index $\\frac{1}{2}$.\n\n$$\\log_4(2)=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$8^{1/3}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_8(2)=\\frac{1}{3}$",
          "worked": "Use base $8$ and argument $2$. The logarithm equals the index $\\frac{1}{3}$.\n\n$$\\log_8(2)=\\frac{1}{3}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$5^{-2}=\\frac{1}{25}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5\\left(\\frac{1}{25}\\right)=-2$",
          "worked": "Use base $5$ and argument $\\frac{1}{25}$. The logarithm equals the index $-2$.\n\n$$\\log_5\\left(\\frac{1}{25}\\right)=-2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p2-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$16^{-1/2}=0.25$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_{16}(0.25)=-\\frac{1}{2}$",
          "worked": "Use base $16$ and argument $0.25$. The logarithm equals the index $-\\frac{1}{2}$.\n\n$$\\log_{16}(0.25)=-\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
