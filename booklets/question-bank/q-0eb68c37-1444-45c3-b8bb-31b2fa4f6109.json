              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Given that ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "T=2\\pi\\sqrt{\\frac{L}{g}}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", where ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "g\\,\\mathrm{m}\\,\\mathrm{s}^{-2}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " is the acceleration due to gravity, estimate the value of ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "g",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", correct to two significant figures.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p98-q29-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "g\\approx11\\,\\mathrm{m}\\,\\mathrm{s}^{-2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " (2 s.f.).",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p98-q29-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "g=\\frac{4\\pi^2L}{T^2}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " with the original measurements.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Compare $T=k\\sqrt{L}$ with $T=\\frac{2\\pi}{\\sqrt{g}}\\sqrt{L}$. Use the unrounded value of $k$ from (a).\n\n$$\\begin{align*}k&=\\frac{2\\pi}{\\sqrt{g}}\\\\g&=\\frac{4\\pi^2}{k^2}\\\\g&=\\frac{4\\pi^2(1.5)}{(2.3)^2}\\\\g&\\approx11\\,\\mathrm{m}\\,\\mathrm{s}^{-2}\\quad(2\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
