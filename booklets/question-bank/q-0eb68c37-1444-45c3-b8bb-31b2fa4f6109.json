        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k\\approx1.9\\,\\mathrm{s}\\,\\mathrm{m}^{-1/2}$ (2 s.f.).",
          "worked": "$$\\begin{align*}T&=k\\sqrt{L}\\\\2.3&=k\\sqrt{1.5}\\\\k&=\\frac{2.3}{\\sqrt{1.5}}\\\\k&\\approx1.9\\,\\mathrm{s}\\,\\mathrm{m}^{-1/2}\\quad(2\\text{ s.f.})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p98-q29-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
