  "content": {
    "id": "p97-q22-root",
    "type": "question",
    "label": null,
    "prompt": "The variable $y$ varies directly with $x$ and inversely with $z$. If $y = 10$ when $x = 5$ and $z = 2$,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p97-q22-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the constant of proportionality.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = 4$",
          "worked": "Direct variation with $x$ places $x$ in the numerator; inverse variation with $z$ places $z$ in the denominator.\n\n$$\\begin{align*}y &= \\frac{kx}{z}\\\\10 &= \\frac{5k}{2}\\\\k &= 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p97-q22-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $y$ when $x = 4$ and $z = 1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y = 16$",
          "worked": "Using $k = 4$,\n\n$$\\begin{align*}y &= \\frac{4\\times4}{1}\\\\y &= 16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p97-q22-c",
        "type": "part",
        "label": "c",
        "prompt": "Find $x$ when $y = 5$ and $z = 2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x = \\frac{5}{2}$",
          "worked": "$$\\begin{align*}5 &= \\frac{4x}{2}\\\\5 &= 2x\\\\x &= \\frac{5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
