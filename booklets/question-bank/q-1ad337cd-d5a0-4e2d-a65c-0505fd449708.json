  "content": {
    "id": "p5-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Suppose $x^2=3x+4$. Find an expression for $x^3$ and simplify as much as possible.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$13x+12$",
      "worked": "$$\\begin{align*}x^3&=x(3x+4)\\\\x^3&=3x^2+4x\\\\x^3&=3(3x+4)+4x\\\\x^3&=9x+12+4x\\\\x^3&=13x+12\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
