  "content": {
    "id": "p22-q40-root",
    "type": "question",
    "label": "",
    "prompt": "Let $y=(x+1)^2-(x-1)^2$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q40-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand and simplify $(x+1)^2-(x-1)^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x$",
          "worked": "$$\\begin{align*}(x+1)^2-(x-1)^2&=(x^2+2x+1)-(x^2-2x+1)\\\\(x+1)^2-(x-1)^2&=x^2+2x+1-x^2+2x-1\\\\(x+1)^2-(x-1)^2&=4x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p22-q40-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find $y'$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4$",
          "worked": "$$\\begin{align*}y&=4x\\\\y'&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
