  "content": {
    "id": "p27-q39-content",
    "type": "question",
    "label": "39",
    "prompt": "The graph of $y=\\ln(x)$ is horizontally dilated by a factor of 2. What is the equivalent vertical translation to give the same result?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q39-short-result",
            "type": "paragraph",
            "fontSize": null,
