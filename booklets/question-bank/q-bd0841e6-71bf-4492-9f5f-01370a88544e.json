            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Vertical translation down ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\ln(2)",
                "display": false
              },
              {
                "type": "text",
                "text": " units.",
                "marks": []
              }
            ]
          },
          {
            "id": "p27-q39-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
