            "inlines": [
              {
                "type": "text",
                "text": "Replace ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "x\\mapsto\\frac{x}{2}",
                "display": false
              },
              {
                "type": "text",
                "text": " and use ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\ln\\left(\\frac{x}{2}\\right)=\\ln(x)-\\ln(2)",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
