  "content": {
    "id": "p25-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A car uses 14 L of petrol to travel 147 km.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "How much petrol is needed to travel 100 km? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9.52\\text{ L}$",
          "worked": "Let $x$ be the petrol needed, in litres.\n$$\\begin{align*}\\frac{14}{147}&=\\frac{x}{100}\\\\x&=\\frac{14\\times100}{147}\\\\x&\\approx9.52\\end{align*}$$\nThe car needs $9.52\\text{ L}$ of petrol.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p25-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "How far can it travel using 100 L of petrol?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1050\\text{ km}$",
          "worked": "Let $x$ be the distance travelled, in kilometres.\n$$\\begin{align*}\\frac{14}{147}&=\\frac{100}{x}\\end{align*}$$\nTake the reciprocal of both sides.\n$$\\begin{align*}\\frac{147}{14}&=\\frac{x}{100}\\\\x&=\\frac{147\\times100}{14}\\\\x&=1050\\end{align*}$$\nThe car can travel $1050\\text{ km}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
