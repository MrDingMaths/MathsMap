  "content": {
    "id": "p22-q15-root",
    "type": "question",
    "label": "15",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p22-q15-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Nina plans to invest $35 000 for 1 year. She is offered two different investment options.",
              "marks": []
            }
          ]
        },
        {
          "id": "p22-q15-option-a",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Option A: Interest is paid at 6% per annum compounded monthly.",
              "marks": []
            }
          ]
        },
        {
          "id": "p22-q15-option-b",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Option B: Interest is paid at ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "r\\%",
              "display": false
            },
            {
              "type": "text",
              "text": " per annum simple interest.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q15-task1",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the future value of Nina's investment after 1 year if she chooses Option A. Give your answer correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$37\\,158.72$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p22-q15-task1-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}FV&=PV(1+\\text{rate per period})^{\\text{number of periods}}\\\\FV&=35000\\left(1+\\frac{0.06}{12}\\right)^{1\\times12}\\\\FV&\\approx\\$37\\,158.72\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p22-q15-task2",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $r$ in Option B that would give Nina the same future value after 1 year as for Option A. Give your answer correct to two decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=6.17$ (an annual simple-interest rate of $6.17\\%$).",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p22-q15-task2-rate-convention",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The decimal rate for Option B is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "\\frac{r}{100}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ". Use the unrounded interest from Option A.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p22-q15-task2-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}I&=35000\\left[\\left(1+\\frac{0.06}{12}\\right)^{12}-1\\right]\\\\I&=P\\times\\frac{r}{100}\\times n\\\\35000\\left[\\left(1+\\frac{0.06}{12}\\right)^{12}-1\\right]&=35000\\times\\frac{r}{100}\\times1\\\\r&=100\\left[\\left(1+\\frac{0.06}{12}\\right)^{12}-1\\right]\\\\r&\\approx6.17\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p22-q15-task2-rate-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The annual simple-interest rate is 6.17%.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
