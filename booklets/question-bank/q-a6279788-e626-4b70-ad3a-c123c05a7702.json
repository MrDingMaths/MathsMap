  "content": {
    "id": "p29-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "From this list of fractions: $\\frac{35}{42},\\frac{22}{33},\\frac{10}{15},\\frac{17}{34},\\frac{112}{224},\\frac{20}{24},\\frac{18}{21},\\frac{6}{7}$ write two fractions that are equivalent to each of the following.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{12}{18}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{22}{33},\\frac{10}{15}$",
          "worked": "$$\\begin{align*}\\frac{12}{18}&=\\frac{12\\div6}{18\\div6}=\\frac23\\\\\\frac{22}{33}&=\\frac{22\\div11}{33\\div11}=\\frac23\\\\\\frac{10}{15}&=\\frac{10\\div5}{15\\div5}=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p29-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{35}{42},\\frac{20}{24}$",
          "worked": "$$\\begin{align*}\\frac56&=\\frac{5\\times7}{6\\times7}=\\frac{35}{42}\\\\\\frac56&=\\frac{5\\times4}{6\\times4}=\\frac{20}{24}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p29-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{42}{49}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{18}{21},\\frac{6}{7}$",
          "worked": "$$\\begin{align*}\\frac{42}{49}&=\\frac{42\\div7}{49\\div7}=\\frac67\\\\\\frac{18}{21}&=\\frac{18\\div3}{21\\div3}=\\frac67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p29-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{34},\\frac{112}{224}$",
          "worked": "$$\\begin{align*}\\frac12&=\\frac{1\\times17}{2\\times17}=\\frac{17}{34}\\\\\\frac12&=\\frac{1\\times112}{2\\times112}=\\frac{112}{224}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
