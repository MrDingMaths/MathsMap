    "type": "question",
    "label": "17",
    "prompt": "Simplify the expression\n$$\\sec\\left(\\left(n-\\frac12\\right)\\pi-\\theta\\right),$$\nwhere $n$ is an integer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
