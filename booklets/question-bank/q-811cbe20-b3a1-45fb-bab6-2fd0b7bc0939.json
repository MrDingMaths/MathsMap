    "id": "v2-471db7-p3-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "The dot product of $\\begin{pmatrix}-3\\\\y\\end{pmatrix}$ and $\\begin{pmatrix}2\\\\7\\end{pmatrix}$ is $-27$. Find the value of $y$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-3$",
      "worked": "$$\\begin{align*}\\begin{pmatrix}-3\\\\y\\end{pmatrix}\\cdot\\begin{pmatrix}2\\\\7\\end{pmatrix}&=-27\\\\-6+7y&=-27\\\\7y&=-21\\\\y&=-3\\end{align*}$$",
      "solutionDiagrams": []
    },
