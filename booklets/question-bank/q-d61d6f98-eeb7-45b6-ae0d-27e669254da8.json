                    "type": "text",
                    "text": "Replacement keeps the probabilities unchanged at each draw.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p21-q11-a-worked-calculation",
                "type": "paragraph",
                "fontSize": null,
