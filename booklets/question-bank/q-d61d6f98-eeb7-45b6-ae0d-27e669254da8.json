        "prompt": "What is the probability that the discs selected are red, green, red in that order?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{180}{1331}$",
          "worked": {
            "format": "maths-editor-document-v1",
