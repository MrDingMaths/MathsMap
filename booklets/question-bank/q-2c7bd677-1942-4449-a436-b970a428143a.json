  "content": {
    "id": "p18-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The ratio of the number of boys to the number of girls in a class is $3:4$. If there are 21 boys, how many girls are there?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "28 girls.",
      "worked": "The boys represent 3 parts and the girls represent 4 parts.\n$$\\begin{align*}\\text{1 part}&=21\\div3\\\\\\text{1 part}&=7\\\\\\text{Number of girls}&=4\\times7\\\\\\text{Number of girls}&=28\\end{align*}$$\nThere are 28 girls.",
      "solutionDiagrams": []
    },
