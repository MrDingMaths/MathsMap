    "questionDiagrams": [],
    "children": [
      {
        "id": "p52-q5a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2+5x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+1)(x+4)$",
          "worked": "Product: $1\\times4=4$. Sum: $5$. Factor pair: $1,4$.\n$$\\begin{align*}x^2+5x+4&=x^2+x+4x+4\\\\&=x(x+1)+4(x+1)\\\\&=(x+1)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q5b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+9x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(2x+1)(x+4)$",
          "worked": "Product: $2\\times4=8$. Sum: $9$. Factor pair: $8,1$.\n$$\\begin{align*}2x^2+9x+4&=2x^2+8x+x+4\\\\&=2x(x+4)+(x+4)\\\\&=(2x+1)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q5c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2+13x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+1)(x+4)$",
          "worked": "Product: $3\\times4=12$. Sum: $13$. Factor pair: $12,1$.\n$$\\begin{align*}3x^2+13x+4&=3x^2+12x+x+4\\\\&=3x(x+4)+(x+4)\\\\&=(3x+1)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p52-q5d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2+17x+4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4x+1)(x+4)$",
          "worked": "Product: $4\\times4=16$. Sum: $17$. Factor pair: $16,1$.\n$$\\begin{align*}4x^2+17x+4&=4x^2+16x+x+4\\\\&=4x(x+4)+(x+4)\\\\&=(4x+1)(x+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
