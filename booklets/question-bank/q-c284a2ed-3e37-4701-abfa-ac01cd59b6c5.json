      {
        "id": "p6-q6-reciprocal",
        "type": "part",
        "label": "a",
        "prompt": "How does a negative exponent affect its base?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It takes the reciprocal of the base, with the corresponding positive exponent.",
          "worked": "A negative exponent means taking the reciprocal: $a^{-n}=\\dfrac{1}{a^n}$. It does not make the value negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p6-q6-correction",
        "type": "part",
        "label": "b",
        "prompt": "What is the correct answer to this problem?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{16}$",
          "worked": "$\\begin{align*}4^{-2}&=\\frac{1}{4^2}\\\\&=\\frac{1}{16}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p6-q6-transfer",
        "type": "part",
        "label": "c",
        "prompt": "Write as an expression without indices:\n\n$5^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{125}$",
          "worked": "$\\begin{align*}5^{-3}&=\\frac{1}{5^3}\\\\&=\\frac{1}{125}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
