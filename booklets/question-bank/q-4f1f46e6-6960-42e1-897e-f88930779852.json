    "children": [
      {
        "id": "p19-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "If $\\displaystyle\\int_1^3 f(x)\\,dx=7$, then what is the value of $\\displaystyle\\int_3^1 f(x)\\,dx$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "Reversing the limits changes the sign.\n\n$$\\begin{align*}\\int_3^1 f(x)\\,dx&=-\\int_1^3 f(x)\\,dx\\\\\\int_3^1 f(x)\\,dx&=-7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p19-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If $\\displaystyle\\int_2^1 g(x)\\,dx=-5$, then what is the value of $\\displaystyle\\int_1^2 g(x)\\,dx$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "Reversing the limits changes the sign.\n\n$$\\begin{align*}\\int_1^2 g(x)\\,dx&=-\\int_2^1 g(x)\\,dx\\\\\\int_1^2 g(x)\\,dx&=-(-5)\\\\\\int_1^2 g(x)\\,dx&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      }
    ]
  },
