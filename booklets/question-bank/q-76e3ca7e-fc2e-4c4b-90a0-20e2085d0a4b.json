  "content": {
    "id": "p6-q21-response",
    "type": "question",
    "label": "21",
    "prompt": "Bob walks $120\\text{ m}$ on a bearing of $\\mathrm{N}40^\\circ\\mathrm{E}$. How far east did he walk? Give your answer correct to one decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$77.1\\text{ m}$",
      "worked": "The direction is $40^\\circ$ east of north. Let $e$ be the distance east in metres.\n\n$$\\begin{align*}\\sin 40^\\circ &= \\frac{e}{120}\\\\e &= 120\\sin 40^\\circ\\\\e &\\approx 77.1\\end{align*}$$\n\nBob walked $77.1\\text{ m}$ east.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
