  "content": {
    "id": "v2-95578-p20-practice-j11-031945-root",
    "type": "question",
    "label": null,
    "prompt": "The time taken ($t$ in hours) to fill a swimming pool depends on the number of identical pumps ($n$) used. It takes 12 hours to fill the pool when 3 pumps are used.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-95578-p20-practice-j11-031945-j11-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find an equation relating $t$ and $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{36}{n}$",
          "worked": "$$\\begin{align*}t&=\\frac{k}{n}\\\\12&=\\frac{k}{3}\\\\k&=12\\times3\\\\k&=36\\\\t&=\\frac{36}{n}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-95578-p20-practice-j11-031945-j11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the time taken to fill the pool when 6 pumps are used.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "6 hours",
          "worked": "$$\\begin{align*}t&=\\frac{36}{6}\\\\t&=6\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-95578-p20-practice-j11-031945-j11-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the time taken to fill the pool when 12 pumps are used.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 hours",
          "worked": "$$\\begin{align*}t&=\\frac{36}{12}\\\\t&=3\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-95578-p20-practice-j11-031945-j11-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Each time the number of pumps is doubled, what happens to the time taken to fill the pool? Explain using the value of $nt$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The time is halved, because $nt=36$ is constant.",
          "worked": "$$\\begin{align*}3\\times12&=36\\\\6\\times6&=36\\\\12\\times3&=36\\end{align*}$$\nThe product $nt$ is always 36. If $n$ is doubled, $t$ must be halved to keep the product the same: $12\\to6\\to3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
