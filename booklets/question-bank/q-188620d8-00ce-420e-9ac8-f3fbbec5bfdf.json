  "content": {
    "id": "v2-86a58-p13-practice-slot-7-root",
    "type": "question",
    "label": null,
    "prompt": "Suppose that A, B and C are the points $(-1,4)$, $(1,5)$ and $(-4,5)$ respectively.\n\nIt is known that the angle between the vectors $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is $135^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-86a58-p13-practice-slot-7-slot-7-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the vectors $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ in component form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\overrightarrow{AB}=2\\mathbf{i}+\\mathbf{j}$, $\\overrightarrow{AC}=-3\\mathbf{i}+\\mathbf{j}$.",
          "worked": "$$\\begin{aligned}\\overrightarrow{AB}&=(1-(-1),5-4)=2\\mathbf{i}+\\mathbf{j}\\\\\\overrightarrow{AC}&=(-4-(-1),5-4)=-3\\mathbf{i}+\\mathbf{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-86a58-p13-practice-slot-7-slot-7-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $\\overrightarrow{AB}\\cdot\\overrightarrow{AC}$ using the result $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=x_1x_2+y_1y_2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AB}\\cdot\\overrightarrow{AC}&=2(-3)+1(1)\\\\&=-6+1\\\\&=-5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-86a58-p13-practice-slot-7-slot-7-c",
        "type": "part",
        "label": "c",
        "prompt": "Confirm your answer to part b using the result $\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}=|\\underset{\\sim}{u}||\\underset{\\sim}{v}|\\cos\\theta$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$|\\overrightarrow{AB}||\\overrightarrow{AC}|\\cos135^\\circ=-5$.",
          "worked": "$$\\begin{aligned}|\\overrightarrow{AB}|&=\\sqrt{4+1}=\\sqrt5\\\\|\\overrightarrow{AC}|&=\\sqrt{9+1}=\\sqrt{10}\\end{aligned}$$\n\n$$\\begin{aligned}\\overrightarrow{AB}\\cdot\\overrightarrow{AC}&=|\\overrightarrow{AB}||\\overrightarrow{AC}|\\cos135^\\circ\\\\&=\\sqrt5\\times\\sqrt{10}\\times\\left(-\\frac{1}{\\sqrt2}\\right)\\\\&=-5\\end{aligned}$$\n\nThis agrees with part b.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
