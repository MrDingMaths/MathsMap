    "prompt": "Prove that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin 2\\theta=\\dfrac{2\\tan\\theta}{1+\\tan^{2}\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin 2\\theta=\\dfrac{2\\tan\\theta}{1+\\tan^{2}\\theta}$.\n\nUse the sine double-angle formula and $\\sec^{2}\\theta=1+\\tan^{2}\\theta$.",
          "worked": "$$\\begin{align*}\\sin 2\\theta&=2\\sin\\theta\\cos\\theta\\\\\\sin 2\\theta&=2\\tan\\theta\\cos^{2}\\theta\\\\\\sin 2\\theta&=\\frac{2\\tan\\theta}{\\sec^{2}\\theta}\\\\\\sin 2\\theta&=\\frac{2\\tan\\theta}{1+\\tan^{2}\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos 2\\theta=\\dfrac{1-\\tan^{2}\\theta}{1+\\tan^{2}\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos 2\\theta=\\dfrac{1-\\tan^{2}\\theta}{1+\\tan^{2}\\theta}$.\n\nUse $\\cos^{2}\\theta+\\sin^{2}\\theta=1$, then divide numerator and denominator by $\\cos^{2}\\theta$.",
          "worked": "$$\\begin{align*}\\cos 2\\theta&=\\frac{\\cos^{2}\\theta-\\sin^{2}\\theta}{\\cos^{2}\\theta+\\sin^{2}\\theta}\\\\\\cos 2\\theta&=\\frac{1-\\dfrac{\\sin^{2}\\theta}{\\cos^{2}\\theta}}{1+\\dfrac{\\sin^{2}\\theta}{\\cos^{2}\\theta}}\\\\\\cos 2\\theta&=\\frac{1-\\tan^{2}\\theta}{1+\\tan^{2}\\theta}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
