    "type": "question",
    "label": null,
    "prompt": "If you double the age Oscar was three years ago and then add 5, you get 31. How old is Oscar now?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Oscar is 16 years old.",
      "worked": "Let $x$ be Oscar's current age in years.\n\n$$\\begin{align*}2(x-3)+5&=31\\\\2(x-3)&=26\\\\x-3&=13\\\\x&=16\\end{align*}$$\n\nOscar is 16 years old.\n\nCheck: $2(16-3)+5=31$.",
      "solutionDiagrams": []
    },
