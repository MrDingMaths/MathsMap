    "questionDiagrams": [
      {
        "id": "p9-q12-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 9 p9-q12-diagram\"}\n\\begin{tikzpicture}[x=2cm,y=2cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\path[use as bounding box] (-0.15,-0.28) rectangle (3.94,1.22);\n\\coordinate (P) at (0,0);\n\\coordinate (Q) at (2,0);\n\\coordinate (R) at ({2+sqrt(3)},0);\n\\coordinate (S) at ({2+sqrt(3)},1);\n\\draw[black,line width=0.8pt] (P)--(R)--(S)--cycle;\n\\draw[black,line width=0.8pt] (Q)--(S);\n\\draw[black,line width=0.4pt] ($(R)!0.02411543!(P)$)--($(R)!0.02411543!(P)+(R)!0.09!(S)-(R)$)--($(R)!0.09!(S)$);\n\\pic[draw=black,line width=0.4pt,angle radius=8mm] {angle=R--P--S};\n\\path (P) ++(15:0.51) node[anchor=south,yshift=2pt] {$15^\\circ$};\n\\pic[draw=black,line width=0.4pt,angle radius=6mm] {angle=R--Q--S};\n\\path (Q) ++(30:0.43) node[anchor=south,yshift=3pt] {$30^\\circ$};\n\\node[below] at (P) {$P$};\n\\node[below] at (Q) {$Q$};\n\\node[below] at (R) {$R$};\n\\node[above] at (S) {$S$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 84,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 9,
          "sourceRegion": "Question 12, shared diagram to the right of the stem and parts",
          "description": "Unshaded shallow triangle PRS with P, Q and R in order on a horizontal baseline, S vertically above R, and QS drawn inside the triangle. P, Q and R are labelled beneath the baseline; S is labelled above the upper-right vertex.",
          "mathematics": "Angle SPR is 15°, angle SQR is 30°, and angle PRS is 90°. Coordinates use SR=1 as a construction unit to reproduce the stated angle relationships; no length is printed on the figure.",
          "answerVisibility": "All source givens remain visible. SR=1 is supplied only in part b; no inferred lengths, proof angles or answers are shown."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p9-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $PQ=QS$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle PQS=150^\\circ$ and $\\angle PSQ=15^\\circ=\\angle QPS$. Hence $PQ=QS$, since sides opposite equal angles are equal.",
          "worked": "$$\\begin{align*}\\angle PQS&=180^\\circ-30^\\circ\\\\&=150^\\circ\\end{align*}$$\nAngles on a straight line sum to $180^\\circ$.\n$$\\begin{align*}\\angle PSQ&=180^\\circ-150^\\circ-15^\\circ\\\\&=15^\\circ\\end{align*}$$\nThus $\\angle PSQ=\\angle QPS$. Therefore $PQ=QS$, since sides opposite equal angles in a triangle are equal.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Given that the length of $SR$ is 1 unit, write the lengths of $QR$, $QS$, and $PQ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$QR=\\sqrt3$ units, $QS=2$ units and $PQ=2$ units. Use $\\tan30^\\circ=\\frac{1}{\\sqrt3}$, $\\sin30^\\circ=\\frac{1}{2}$ and part a.",
          "worked": "In right-angled triangle $QRS$,\n$$\\begin{align*}\\sin30^\\circ&=\\frac{SR}{SQ}\\\\\\frac12&=\\frac1{SQ}\\\\SQ&=2\\end{align*}$$\nBy part a, $PQ=QS=2$ units.\n$$\\begin{align*}\\tan30^\\circ&=\\frac{SR}{QR}\\\\\\frac1{\\sqrt3}&=\\frac1{QR}\\\\QR&=\\sqrt3\\end{align*}$$\nTherefore $QR=\\sqrt3$ units, $QS=2$ units and $PQ=2$ units.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p9-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Deduce that $\\tan15^\\circ=2-\\sqrt3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PR=2+\\sqrt3$, so $\\tan15^\\circ=\\dfrac1{2+\\sqrt3}=2-\\sqrt3$ after rationalising the denominator.",
          "worked": "$$\\begin{align*}PR&=PQ+QR\\\\&=2+\\sqrt3\\end{align*}$$\nIn right-angled triangle $PRS$,\n$$\\begin{align*}\\tan15^\\circ&=\\frac{SR}{PR}\\\\&=\\frac1{2+\\sqrt3}\\\\&=\\frac1{2+\\sqrt3}\\times\\frac{2-\\sqrt3}{2-\\sqrt3}\\\\&=\\frac{2-\\sqrt3}{4-3}\\\\&=2-\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ],
    "diagramPlacement": "right-of-prompt"
  },
