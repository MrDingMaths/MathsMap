        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y&=x+4\\\\y&=2x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=5$.",
          "worked": "Substitute $y=x+4$ into the second equation.\n$$\\begin{align*}x+4&=2x+3\\\\4&=x+3\\\\x&=1\\end{align*}$$\n$$\\begin{align*}y&=1+4\\\\y&=5\\end{align*}$$\nCheck: $5=2(1)+3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}y&=3x-2\\\\y&=2x-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=1$.",
          "worked": "Substitute $y=3x-2$ into the second equation.\n$$\\begin{align*}3x-2&=2x-1\\\\x-2&=-1\\\\x&=1\\end{align*}$$\n$$\\begin{align*}y&=3(1)-2\\\\y&=1\\end{align*}$$\nCheck: $1=2(1)-1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}y&=2x-3\\\\y&=3x-5\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=1$.",
          "worked": "Substitute $y=2x-3$ into the second equation.\n$$\\begin{align*}2x-3&=3x-5\\\\-3&=x-5\\\\x&=2\\end{align*}$$\n$$\\begin{align*}y&=2(2)-3\\\\y&=1\\end{align*}$$\nCheck: $1=3(2)-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}y&=x+1\\\\y&=4-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ y=2$.",
          "worked": "Substitute $y=x+1$ into the second equation.\n$$\\begin{align*}x+1&=4-2x\\\\3x+1&=4\\\\3x&=3\\\\x&=1\\end{align*}$$\n$$\\begin{align*}y&=1+1\\\\y&=2\\end{align*}$$\nCheck: $2=4-2(1)$.",
          "solutionDiagrams": []
        },
