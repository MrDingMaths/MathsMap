  "content": {
    "id": "p17-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Prices have increased with inflation by an average of $3.4\\%$ since the same time last year. When finding your estimate, assume that the average increase applies to all items. Give monetary estimates to the nearest cent.",
