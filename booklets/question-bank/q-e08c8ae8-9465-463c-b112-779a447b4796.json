  "content": {
    "id": "p67-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Show that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p67-q15-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p67-q15-a-statement",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "math",
                  "latex": "n^3-n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " is divisible by 6 for all integers ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "n",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ".",
                  "marks": []
                }
              ]
            },
            {
              "id": "p67-q15-a-hint",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 1,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "(hint: a number is divisible by 6 if it is divisible by 2 and 3)",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^3-n=n(n+1)(n-1)$ is a product of three consecutive integers, so it contains a factor of 2 and a factor of 3 and is divisible by 6.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p67-q15-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}n^3-n&=n(n^2-1)\\\\n^3-n&=n(n+1)(n-1)\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p67-q15-a-answer-reason",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "This is the product of three consecutive integers. At least one is even and one is divisible by 3. Therefore the product is divisible by 6.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p67-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$n^4+2n^3-n^2-2n$ is divisible by 24 for all integers $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n^4+2n^3-n^2-2n=n(n+1)(n-1)(n+2)$ is a product of four consecutive integers. It is divisible by 8 and by 3, hence by 24.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p67-q15-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}n^4+2n^3-n^2-2n&=n^3(n+2)-n(n+2)\\\\n^4+2n^3-n^2-2n&=(n+2)(n^3-n)\\\\n^4+2n^3-n^2-2n&=n(n+1)(n-1)(n+2)\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p67-q15-b-answer-consecutive",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "This is a product of four consecutive integers.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p67-q15-b-answer-eight",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Two of them are even, and one of those is divisible by 4, so their product is divisible by 8.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p67-q15-b-answer-three",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "At least one of the four integers is divisible by 3.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p67-q15-b-answer-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Since 8 and 3 are coprime, the product is divisible by 24.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p67-q15-b-answer-note",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Note: proving divisibility by 4 and 6 is insufficient because they are not coprime. For example, 12 is divisible by both 4 and 6 but not by 24.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
    ]
  },
