  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find and simplify the expression for the sum of the first $n$ terms of each series.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$5+10+15+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=\\dfrac{5n(n+1)}{2}$",
          "worked": "$a=5,\\ d=5$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2a+(n-1)d]\\\\S_n&=\\frac{n(10+5n-5)}{2}\\\\S_n&=\\frac{n(5+5n)}{2}\\\\S_n&=\\frac{5n(1+n)}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$10+13+16+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=\\dfrac{n(3n+17)}{2}$",
          "worked": "$a=10,\\ d=3$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2(10)+(n-1)3]\\\\S_n&=\\frac{n(20+3n-3)}{2}\\\\S_n&=\\frac{n(17+3n)}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p22-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$3+7+11+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=n(2n+1)$",
          "worked": "$a=3,\\ d=4$.\n$$\\begin{align*}S_n&=\\frac{n}{2}(6+4n-4)\\\\S_n&=\\frac{n(2+4n)}{2}\\\\S_n&=n(1+2n)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p22-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$-9-4+1+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=\\dfrac{n(5n-23)}{2}$",
          "worked": "$a=-9,\\ d=5$.\n$$\\begin{align*}S_n&=\\frac{n}{2}[2(-9)+(n-1)5]\\\\S_n&=\\frac{n(-18+5n-5)}{2}\\\\S_n&=\\frac{n(5n-23)}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$5+4\\frac{1}{2}+4+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$S_n=\\dfrac{n(21-n)}{4}$",
          "worked": "$a=5,\\ d=-\\frac12$.\n$$\\begin{align*}S_n&=\\frac{n}{2}\\left[2(5)+(n-1)\\left(-\\frac12\\right)\\right]\\\\S_n&=\\frac{n}{2}\\left(10-\\frac{n}{2}+\\frac12\\right)\\\\S_n&=\\frac{n}{2}\\left(\\frac{21}{2}-\\frac{n}{2}\\right)\\\\S_n&=\\frac{n(21-n)}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
