  "content": {
    "id": "p5-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Consider the function $A(r)=\\pi r^2$. The input for this function is the radius of a circle and the output is its area.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find $A(3)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\pi$",
          "worked": "$$\\begin{align*}A(3)&=\\pi(3)^2\\\\A(3)&=9\\pi\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p5-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find $r$ such that $A(r)=16\\pi$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r=4$",
          "worked": "$$\\begin{align*}\\pi r^2&=16\\pi\\\\r^2&=16\\\\r&=4\\end{align*}$$\nThe radius is non-negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the rule for the function whose input is the area $A$ of a circle, and whose output is its radius.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r(A)=\\sqrt{\\dfrac{A}{\\pi}}$",
          "worked": "$$\\begin{align*}A&=\\pi r^2\\\\\\frac{A}{\\pi}&=r^2\\\\r&=\\sqrt{\\frac{A}{\\pi}}\\end{align*}$$\nTaking the non-negative square root gives $r(A)=\\sqrt{\\frac{A}{\\pi}}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
