  "content": {
    "id": "v2-408aa4f17-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Find the values of $c$ for which each function has the given gradient.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-408aa4f17-practice-slot-4-slot-4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{4x}{x-1}$ and $f'(c)=-1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=3$ or $-1$.",
          "worked": "Let $u=4x$ and $v=x-1$, so $u'=4$ and $v'=1$.\n$$\\begin{align*}f'(x)&=\\frac{4(x-1)-4x(1)}{(x-1)^2}\\\\f'(x)&=-\\frac{4}{(x-1)^2}\\\\-\\frac{4}{(c-1)^2}&=-1\\\\(c-1)^2&=4\\\\c-1&=\\pm2\\\\c&=3\\text{ or }-1\\end{align*}$$\nBoth values satisfy $c\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-408aa4f17-practice-slot-4-slot-4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=\\dfrac{x^2}{x-1}$ and $f'(c)=-3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$c=\\dfrac12$ or $\\dfrac32$.",
          "worked": "Let $u=x^2$ and $v=x-1$, so $u'=2x$ and $v'=1$.\n$$\\begin{align*}f'(x)&=\\frac{2x(x-1)-x^2(1)}{(x-1)^2}\\\\f'(x)&=\\frac{x^2-2x}{(x-1)^2}\\\\\\frac{c^2-2c}{(c-1)^2}&=-3\\\\c^2-2c&=-3(c-1)^2\\\\c^2-2c&=-3c^2+6c-3\\\\4c^2-8c+3&=0\\\\(2c-1)(2c-3)&=0\\\\c&=\\frac12\\text{ or }\\frac32\\end{align*}$$\nBoth values satisfy $c\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
