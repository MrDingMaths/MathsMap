  "content": {
    "id": "p2-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise each of the following expressions by taking out the greatest common divisor:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$4x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(2x+1)$",
          "worked": "$$\\begin{align*}4x+2&=2(2x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$9xy-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(3xy-1)$",
          "worked": "$$\\begin{align*}9xy-3&=3(3xy-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$10x+12y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(5x+6y)$",
          "worked": "$$\\begin{align*}10x+12y&=2(5x+6y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(2x-3)$",
          "worked": "$$\\begin{align*}4x-6&=2(2x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$15x-18y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(5x-6y)$",
          "worked": "$$\\begin{align*}15x-18y&=3(5x-6y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p2-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$6x^2+3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x(2x+1)$",
          "worked": "$$\\begin{align*}6x^2+3x&=3x(2x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p2-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$24a+18a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6a(4+3a)$",
          "worked": "$$\\begin{align*}24a+18a^2&=6a(4+3a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p2-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$6a^2-8a^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2a^2(3-4a)$",
          "worked": "$$\\begin{align*}6a^2-8a^3&=2a^2(3-4a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p2-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$4a^4-8a^3+12a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2(a^2-2a+3)$",
          "worked": "$$\\begin{align*}4a^4-8a^3+12a^2&=4a^2(a^2-2a+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p2-q1-j",
        "type": "part",
        "label": "j",
        "prompt": "$x^3y^4+x^4y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3y^3(y+x)$",
          "worked": "$$\\begin{align*}x^3y^4+x^4y^3&=x^3y^3(y+x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p2-q1-k",
        "type": "part",
        "label": "k",
        "prompt": "$2a^2bc+3ab^2c+4abc^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$abc(2a+3b+4c)$",
          "worked": "The greatest common divisor is $abc$.\n\n$$\\begin{align*}2a^2bc+3ab^2c+4abc^2&=abc(2a+3b+4c)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q1-l",
        "type": "part",
        "label": "l",
        "prompt": "$12x^5y^3-18x^3y^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x^3y^3(2x^2-3y^5)$",
          "worked": "The greatest common divisor is $6x^3y^3$.\n\n$$\\begin{align*}12x^5y^3-18x^3y^8&=6x^3y^3(2x^2-3y^5)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p2-q1-m",
        "type": "part",
        "label": "m",
        "prompt": "$2x+3y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+3y$; no common factor other than $1$.",
          "worked": "The greatest common divisor of $2x$ and $3y$ is $1$, so $2x+3y$ cannot be factorised further.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
