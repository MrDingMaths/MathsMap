  "content": {
    "id": "p8-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The triangle $ABC$ has vertices $A(2,1)$, $B(4,5)$ and $C(6,1)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the coordinates of the midpoints $M$ and $N$ of sides $AB$ and $BC$ respectively.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M(3,3)$, $N(5,3)$.",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{2+4}{2},\\frac{1+5}{2}\\right)\\\\M&=(3,3)\\\\N&=\\left(\\frac{4+6}{2},\\frac{5+1}{2}\\right)\\\\N&=(5,3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(4,1)$ is the midpoint of side $AC$. Show that $BC=2MP$ and $AB=2PN$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$MP=PN=\\sqrt5$ and $BC=AB=2\\sqrt5$, so $BC=2MP$ and $AB=2PN$.",
          "worked": "$$\\begin{align*}BC&=\\sqrt{(6-4)^2+(1-5)^2}\\\\BC&=\\sqrt{20}=2\\sqrt5\\\\MP&=\\sqrt{(4-3)^2+(1-3)^2}\\\\MP&=\\sqrt5\\\\2MP&=2\\sqrt5=BC.\\end{align*}$$\n$$\\begin{align*}AB&=\\sqrt{(4-2)^2+(5-1)^2}\\\\AB&=\\sqrt{20}=2\\sqrt5\\\\PN&=\\sqrt{(5-4)^2+(3-1)^2}\\\\PN&=\\sqrt5\\\\2PN&=2\\sqrt5=AB.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
  },
