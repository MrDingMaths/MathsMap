  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A unit square is subdivided into 16 squares of equal area. Seven of these squares are painted blue and the remainder are painted red. What fraction of the unit square is red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac9{16}$",
      "worked": "$$\\begin{align*}1-\\frac7{16}&=\\frac{16}{16}-\\frac7{16}\\\\1-\\frac7{16}&=\\frac9{16}\\end{align*}$$\n$\\frac9{16}$ of the unit square is red.",
      "solutionDiagrams": []
    },
