  "content": {
    "id": "p42-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "For the CDF $F(x)=\\dfrac{x^2}{64}$, find",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "the median $Q_2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_2=4\\sqrt{2}$",
          "worked": "$$\\begin{aligned}F(Q_2)&=\\frac12\\\\\\frac{Q_2^2}{64}&=\\frac12\\\\Q_2^2&=32\\\\Q_2&=4\\sqrt2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p42-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$Q_1$ and $Q_3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_1=4$, $Q_3=4\\sqrt3$",
          "worked": "$$\\begin{aligned}F(Q_1)&=\\frac14\\\\\\frac{Q_1^2}{64}&=\\frac14\\\\Q_1^2&=16\\\\Q_1&=4\\end{aligned}$$\n$$\\begin{aligned}F(Q_3)&=\\frac34\\\\\\frac{Q_3^2}{64}&=\\frac34\\\\Q_3^2&=48\\\\Q_3&=4\\sqrt3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      }
    ]
  },
