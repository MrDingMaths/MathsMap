  "content": {
    "id": "p14-q2-root",
    "type": "question",
    "label": "4",
    "prompt": "Use the chain rule to differentiate the following.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(2x+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=10(2x+1)^4$",
          "worked": "$$\\begin{align*}y'&=5(2x+1)^4\\times2\\\\y'&=10(2x+1)^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p14-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(x^2+1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=10x(x^2+1)^4$",
          "worked": "$$\\begin{align*}y'&=5(x^2+1)^4\\times2x\\\\y'&=10x(x^2+1)^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p14-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\frac{1}{2-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{1}{(2-x)^2}$",
          "worked": "$$\\begin{align*}y&=(2-x)^{-1}\\\\y'&=-(2-x)^{-2}\\times(-1)\\\\y'&=\\frac{1}{(2-x)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=\\sqrt{2x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\frac{1}{\\sqrt{2x-1}}$",
          "worked": "$$\\begin{align*}y'&=\\tfrac12(2x-1)^{-\\frac12}\\times2\\\\y'&=\\frac{1}{\\sqrt{2x-1}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=\\frac{1}{1+x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{2x}{(1+x^2)^2}$",
          "worked": "$$\\begin{align*}y&=(1+x^2)^{-1}\\\\y'&=-(1+x^2)^{-2}\\times2x\\\\y'&=-\\frac{2x}{(1+x^2)^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p14-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$y=\\frac{1}{\\sqrt{2x+1}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{1}{\\sqrt{(2x+1)^3}}$",
          "worked": "$$\\begin{align*}y&=(2x+1)^{-\\frac12}\\\\y'&=-\\tfrac12(2x+1)^{-\\frac32}\\times2\\\\y'&=-\\frac{1}{\\sqrt{(2x+1)^3}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p14-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$y=\\sqrt{1-x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{x}{\\sqrt{1-x^2}}$",
          "worked": "$$\\begin{align*}y'&=\\tfrac12(1-x^2)^{-\\frac12}(-2x)\\\\y'&=-\\frac{x}{\\sqrt{1-x^2}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$y=\\left(x-\\frac{1}{x}\\right)^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=4\\left(x-\\frac{1}{x}\\right)^3\\left(1+\\frac{1}{x^2}\\right)$",
          "worked": "$$\\begin{align*}u&=x-x^{-1}\\\\\\frac{du}{dx}&=1+\\frac{1}{x^2}\\\\y&=u^4\\\\y'&=4u^3\\left(1+\\frac{1}{x^2}\\right)\\end{align*}$$\nSubstitute $u=x-\\frac{1}{x}$. $$y'=4\\left(x-\\frac{1}{x}\\right)^3\\left(1+\\frac{1}{x^2}\\right)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p14-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=\\frac{1}{(3x-4)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=-\\frac{6}{(3x-4)^3}$",
          "worked": "$$\\begin{align*}y&=(3x-4)^{-2}\\\\y'&=-2(3x-4)^{-3}\\times3\\\\y'&=-\\frac{6}{(3x-4)^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
