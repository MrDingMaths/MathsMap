  "content": {
    "id": "p16-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "$f(x)=x^2+5x$. Find, in simplest form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\frac{f(1+h)-f(1)}{h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7+h$, for $h\\ne0$.",
          "worked": "$$\\begin{align*}f(1+h)&=(1+h)^2+5(1+h)\\\\&=1+2h+h^2+5+5h\\\\&=h^2+7h+6\\\\f(1)&=1^2+5(1)\\\\&=6\\end{align*}$$\n$$\\begin{align*}\\frac{f(1+h)-f(1)}{h}&=\\frac{h^2+7h+6-6}{h}\\\\&=\\frac{h(h+7)}{h}\\\\&=h+7\\qquad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p16-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\frac{f(p)-f(q)}{p-q}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p+q+5$, for $p\\ne q$.",
          "worked": "$$\\begin{align*}f(p)&=p^2+5p\\\\f(q)&=q^2+5q\\\\f(p)-f(q)&=p^2+5p-(q^2+5q)\\\\&=p^2-q^2+5(p-q)\\\\&=(p-q)(p+q+5)\\end{align*}$$\n$$\\begin{align*}\\frac{f(p)-f(q)}{p-q}&=\\frac{(p-q)(p+q+5)}{p-q}\\\\&=p+q+5\\qquad(p\\ne q)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p16-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\frac{f(x+h)-f(x)}{h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+h+5$, for $h\\ne0$.",
          "worked": "$$\\begin{align*}f(x+h)&=(x+h)^2+5(x+h)\\\\&=x^2+2xh+h^2+5x+5h\\\\f(x)&=x^2+5x\\\\f(x+h)-f(x)&=x^2+2xh+h^2+5x+5h\\\\&\\quad-(x^2+5x)\\\\&=2xh+h^2+5h\\\\&=h(2x+h+5)\\end{align*}$$\n$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{h(2x+h+5)}{h}\\\\&=2x+h+5\\qquad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
