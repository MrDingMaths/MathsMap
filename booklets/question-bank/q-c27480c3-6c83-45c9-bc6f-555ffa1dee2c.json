        "answer": {
          "short": "$5^{10x - 1}$",
          "worked": "$$\\begin{align*}5^{3x-1}\\times5^{7x} &=5^{3x-1+7x} \\\\ &=5^{10x-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t1-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$r^{2y + 3} \\times r^{y - 2}$",
