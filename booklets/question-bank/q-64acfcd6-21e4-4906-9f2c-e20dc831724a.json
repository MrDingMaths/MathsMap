  "content": {
    "id": "p14-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Evaluate each expression for $x=-2$, $y=0.1$ and $z=-\\frac{1}{2}$.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$xyz$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1$",
          "worked": "$$\\begin{align*}xyz&=(-2)\\times0.1\\times\\left(-\\frac12\\right)\\\\xyz&=(-0.2)\\times\\left(-\\frac12\\right)\\\\xyz&=0.1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1.9$",
          "worked": "$$\\begin{align*}x+y&=-2+0.1\\\\x+y&=-1.9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p14-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$y\\div z$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-0.2$",
          "worked": "$$\\begin{align*}y\\div z&=0.1\\div\\left(-\\frac12\\right)\\\\y\\div z&=0.1\\times(-2)\\\\y\\div z&=-0.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x+z-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4.6$",
          "worked": "$$\\begin{align*}2x+z-y&=2(-2)-\\frac12-0.1\\\\2x+z-y&=-4-0.5-0.1\\\\2x+z-y&=-4.6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{yz}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.0125$",
          "worked": "$$\\begin{align*}\\frac{yz}{2x}&=\\frac{0.1\\times(-\\frac12)}{2\\times(-2)}\\\\\\frac{yz}{2x}&=\\frac{-0.05}{-4}\\\\\\frac{yz}{2x}&=0.0125\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$y(5.5+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.35$",
          "worked": "$$\\begin{align*}y(5.5+x)&=0.1(5.5+(-2))\\\\y(5.5+x)&=0.1\\times3.5\\\\y(5.5+x)&=0.35\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$-z-3y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2$",
          "worked": "$$\\begin{align*}-z-3y&=-\\left(-\\frac12\\right)-3(0.1)\\\\-z-3y&=0.5-0.3\\\\-z-3y&=0.2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p14-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x}{z}-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.9$",
          "worked": "$$\\begin{align*}\\frac{x}{z}-y&=\\frac{-2}{-\\frac12}-0.1\\\\\\frac{x}{z}-y&=4-0.1\\\\\\frac{x}{z}-y&=3.9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
