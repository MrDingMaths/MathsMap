        "prompt": "$x^2-2x-24=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=6$ or $x=-4$.",
          "worked": "Here $a=1$, $b=-2$, $c=-24$.\n\n$$\\begin{align*}b^2-4ac&=(-2)^2-4(1)(-24)\\\\b^2-4ac&=100\\\\x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{2\\pm\\sqrt{100}}{2}\\\\x&=\\frac{2\\pm10}{2}\\\\x&=6\\text{ or }x=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p26-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+3x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=\\frac12$.",
          "worked": "Here $a=2$, $b=3$, $c=-2$.\n\n$$\\begin{align*}b^2-4ac&=3^2-4(2)(-2)\\\\b^2-4ac&=25\\\\x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{-3\\pm\\sqrt{25}}{4}\\\\x&=\\frac{-3\\pm5}{4}\\\\x&=-2\\text{ or }x=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p26-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2+x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-1\\pm\\sqrt5}{2}$.",
          "worked": "Here $a=1$, $b=1$, $c=-1$.\n\n$$\\begin{align*}b^2-4ac&=1^2-4(1)(-1)\\\\b^2-4ac&=5\\\\x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{-1\\pm\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
      },
      {
        "id": "p26-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$2x^2+5x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-5\\pm\\sqrt{17}}{4}$.",
          "worked": "Here $a=2$, $b=5$, $c=1$.\n\n$$\\begin{align*}b^2-4ac&=5^2-4(2)(1)\\\\b^2-4ac&=17\\\\x&=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\\\\x&=\\frac{-5\\pm\\sqrt{17}}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 53
