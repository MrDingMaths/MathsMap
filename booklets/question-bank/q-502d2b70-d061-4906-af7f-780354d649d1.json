    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q12-a",
        "type": "group",
        "label": "a",
        "prompt": "Given that $h(x)=f(x)\\times g(x)$, determine what symmetry $h(x)$ has if:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q12-a-i",
            "type": "part",
            "label": "i",
            "prompt": "both $f$ and $g$ are even,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Even.",
              "worked": "$$\\begin{align*}h(-x)&=f(-x)g(-x)\\\\h(-x)&=f(x)g(x)\\\\h(-x)&=h(x).\\end{align*}$$\nHence $h$ is even.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          },
          {
            "id": "p22-q12-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "both $f$ and $g$ are odd,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Even.",
              "worked": "$$\\begin{align*}h(-x)&=f(-x)g(-x)\\\\h(-x)&=(-f(x))(-g(x))\\\\h(-x)&=h(x).\\end{align*}$$\nHence $h$ is even.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          },
          {
            "id": "p22-q12-a-iii",
            "type": "part",
            "label": "iii",
            "prompt": "one is even and the other odd.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Odd.",
              "worked": "Taking $f$ even and $g$ odd,\n$$\\begin{align*}h(-x)&=f(-x)g(-x)\\\\h(-x)&=f(x)(-g(x))\\\\h(-x)&=-h(x).\\end{align*}$$\nHence $h$ is odd. Interchanging $f$ and $g$ gives the same result.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          }
        ]
      },
      {
        "id": "p22-q12-b",
        "type": "group",
        "label": "b",
        "prompt": "Given that $h(x)=f(x)+g(x)$, determine what symmetry $h(x)$ has if:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q12-b-i",
            "type": "part",
            "label": "i",
            "prompt": "both $f$ and $g$ are even,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Even.",
              "worked": "$$\\begin{align*}h(-x)&=f(-x)+g(-x)\\\\h(-x)&=f(x)+g(x)\\\\h(-x)&=h(x).\\end{align*}$$\nHence $h$ is even.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          },
          {
            "id": "p22-q12-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "both $f$ and $g$ are odd,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Odd.",
              "worked": "$$\\begin{align*}h(-x)&=f(-x)+g(-x)\\\\h(-x)&=-f(x)-g(x)\\\\h(-x)&=-h(x).\\end{align*}$$\nHence $h$ is odd.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          },
          {
            "id": "p22-q12-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "one is even and the other odd.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "In general, neither.",
              "worked": "Taking $f$ even and $g$ odd,\n$$\\begin{align*}h(-x)&=f(-x)+g(-x)\\\\h(-x)&=f(x)-g(x).\\end{align*}$$\nIn general this is neither $h(x)$ nor $-h(x)$, so $h$ is neither even nor odd. For example, $f(x)=1$ and $g(x)=x$ give $h(x)=1+x$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 0
          }
        ]
      }
    ]
  },
