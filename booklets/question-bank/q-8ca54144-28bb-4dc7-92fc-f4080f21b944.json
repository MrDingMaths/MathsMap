  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "$\\triangle ABC\\equiv\\triangle PQR$ (where the vertices are in matching order).",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Which angle in $\\triangle PQR$ is equal in size to $\\angle ABC$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle PQR$",
          "worked": "The correspondence is $A\\leftrightarrow P$, $B\\leftrightarrow Q$, $C\\leftrightarrow R$. Hence $\\angle ABC=\\angle PQR$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Which angle in $\\triangle PQR$ is equal in size to $\\angle CAB$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\angle RPQ$",
          "worked": "The vertices $C,A,B$ correspond to $R,P,Q$, respectively. Hence $\\angle CAB=\\angle RPQ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "Which side in $\\triangle PQR$ is equal in length to $AC$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$PR$",
          "worked": "$A\\leftrightarrow P$ and $C\\leftrightarrow R$, so $AC=PR$ (matching sides of congruent triangles).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p19-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "Which side in $\\triangle ABC$ is equal in length to $QR$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$BC$",
          "worked": "$Q\\leftrightarrow B$ and $R\\leftrightarrow C$, so $QR=BC$ (matching sides of congruent triangles).",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
