  "content": {
    "id": "p12-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Find the $n$th term of each GP in fully simplified form.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt6,\\ 2\\sqrt3,\\ 2\\sqrt6,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=\\sqrt3(\\sqrt2)^n$",
          "worked": "$$a=\\sqrt6,\\qquad r=\\frac{2\\sqrt3}{\\sqrt6}=\\sqrt2$$\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=\\sqrt6(\\sqrt2)^{n-1}\\\\a_n&=\\sqrt6\\sqrt{2^{n-1}}\\\\a_n&=\\sqrt{6\\times2^{n-1}}\\\\a_n&=\\sqrt3\\sqrt{2\\times2^{n-1}}\\\\a_n&=\\sqrt3(\\sqrt2)^n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$ax,\\ a^2x^3,\\ a^3x^5,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=a^nx^{2n-1}$",
          "worked": "The first term is $ax$ and the common ratio is $ax^2$.\n$$\\begin{align*}a_n&=(ax)(ax^2)^{n-1}\\\\a_n&=ax\\times a^{n-1}x^{2n-2}\\\\a_n&=a^nx^{2n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$-\\frac{x}{y},\\ -1,\\ -\\frac{y}{x},\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=-x^{2-n}y^{n-2}$",
          "worked": "$$a=-\\frac{x}{y},\\qquad r=\\frac{-1}{-x/y}=\\frac{y}{x}$$\n$$\\begin{align*}a_n&=ar^{n-1}\\\\a_n&=\\left(-\\frac{x}{y}\\right)\\left(\\frac{y}{x}\\right)^{n-1}\\\\a_n&=-x^{1-(n-1)}y^{n-1-1}\\\\a_n&=-x^{2-n}y^{n-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
