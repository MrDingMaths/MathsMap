  "content": {
    "id": "p4-q13",
    "type": "question",
    "label": "13",
    "prompt": "[Recursions]\n\nFor the following functions, find $f(3)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(n)=f(n-1)+3$, where $f(1)=3$, and $n\\ge2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}f(2)&=f(1)+3\\\\f(2)&=3+3=6\\end{align*}$$\n$$\\begin{align*}f(3)&=f(2)+3\\\\f(3)&=6+3=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p4-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(n)=n\\times f(n-1)$, where $f(1)=1$, and $n\\ge2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}f(2)&=2\\times f(1)\\\\f(2)&=2\\times1=2\\end{align*}$$\n$$\\begin{align*}f(3)&=3\\times f(2)\\\\f(3)&=3\\times2=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
