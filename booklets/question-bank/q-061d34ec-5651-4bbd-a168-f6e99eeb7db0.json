    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{2\\cos^3\\theta-\\cos\\theta}{\\sin\\theta\\cos^2\\theta-\\sin^3\\theta}=\\cot\\theta$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\dfrac{\\cos\\theta}{\\sin\\theta}=\\cot\\theta=\\text{RHS}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\frac{2\\cos^3\\theta-\\cos\\theta}{\\sin\\theta\\cos^2\\theta-\\sin^3\\theta}\\\\&=\\frac{\\cos\\theta(2\\cos^2\\theta-1)}{\\sin\\theta(\\cos^2\\theta-\\sin^2\\theta)}\\\\&=\\frac{\\cos\\theta(2\\cos^2\\theta-1)}{\\sin\\theta(\\cos^2\\theta-(1-\\cos^2\\theta))}\\\\&=\\frac{\\cos\\theta(2\\cos^2\\theta-1)}{\\sin\\theta(2\\cos^2\\theta-1)}\\\\&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\&=\\cot\\theta\\\\&=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p36-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\sec y+\\tan y+\\cot y=\\frac{1+\\sin y}{\\sin y\\cos y}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\dfrac{\\sin y+1}{\\sin y\\cos y}=\\text{RHS}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\frac1{\\cos y}+\\frac{\\sin y}{\\cos y}+\\frac{\\cos y}{\\sin y}\\\\&=\\frac{1+\\sin y}{\\cos y}+\\frac{\\cos y}{\\sin y}\\\\&=\\frac{(1+\\sin y)\\sin y+\\cos^2y}{\\sin y\\cos y}\\\\&=\\frac{\\sin y+\\sin^2y+\\cos^2y}{\\sin y\\cos y}\\\\&=\\frac{\\sin y+1}{\\sin y\\cos y}\\\\&=\\frac{1+\\sin y}{\\sin y\\cos y}\\\\&=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 59
      },
      {
        "id": "p36-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{\\cos A-\\tan A\\sin A}{\\cos A+\\tan A\\sin A}=1-2\\sin^2A$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\cos^2A-\\sin^2A=1-2\\sin^2A=\\text{RHS}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\frac{\\cos A-\\frac{\\sin A}{\\cos A}\\cdot\\sin A}{\\cos A+\\frac{\\sin A}{\\cos A}\\cdot\\sin A}\\\\&=\\frac{\\cos A-\\frac{\\sin^2A}{\\cos A}}{\\cos A+\\frac{\\sin^2A}{\\cos A}}\\\\&=\\frac{\\frac{\\cos^2A-\\sin^2A}{\\cos A}}{\\frac{\\cos^2A+\\sin^2A}{\\cos A}}\\\\&=\\frac{\\cos^2A-\\sin^2A}{\\cos^2A+\\sin^2A}\\\\&=\\cos^2A-\\sin^2A\\\\&=(1-\\sin^2A)-\\sin^2A\\\\&=1-2\\sin^2A\\\\&=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      },
      {
        "id": "p37-d",
        "type": "part",
        "label": "d",
        "prompt": "$$(\\sin\\varphi+\\cos\\varphi)(\\sec\\varphi+\\operatorname{cosec}\\varphi)=2+\\tan\\varphi+\\cot\\varphi$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both sides simplify to $2+\\dfrac1{\\sin\\varphi\\cos\\varphi}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=(\\sin\\varphi+\\cos\\varphi)\\left(\\frac1{\\cos\\varphi}+\\frac1{\\sin\\varphi}\\right)\\\\&=(\\sin\\varphi+\\cos\\varphi)\\cdot\\frac{\\sin\\varphi+\\cos\\varphi}{\\sin\\varphi\\cos\\varphi}\\\\&=\\frac{(\\sin\\varphi+\\cos\\varphi)^2}{\\sin\\varphi\\cos\\varphi}\\\\&=\\frac{\\sin^2\\varphi+2\\sin\\varphi\\cos\\varphi+\\cos^2\\varphi}{\\sin\\varphi\\cos\\varphi}\\\\&=\\frac{1+2\\sin\\varphi\\cos\\varphi}{\\sin\\varphi\\cos\\varphi}\\\\&=\\frac1{\\sin\\varphi\\cos\\varphi}+\\frac{2\\sin\\varphi\\cos\\varphi}{\\sin\\varphi\\cos\\varphi}\\\\&=\\frac1{\\sin\\varphi\\cos\\varphi}+2.\\end{align*}$$\n$$\\begin{align*}\\text{RHS}&=2+\\frac{\\sin\\varphi}{\\cos\\varphi}+\\frac{\\cos\\varphi}{\\sin\\varphi}\\\\&=2+\\frac{\\sin^2\\varphi+\\cos^2\\varphi}{\\sin\\varphi\\cos\\varphi}\\\\&=2+\\frac1{\\sin\\varphi\\cos\\varphi}.\\end{align*}$$\nTherefore $\\text{LHS}=\\text{RHS}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 94
      },
      {
        "id": "p37-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac1{1+\\tan^2x}-\\frac1{1+\\sec^2x}=\\frac{\\cos^4x}{1+\\cos^2x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=\\dfrac{\\cos^4x}{1+\\cos^2x}=\\text{RHS}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\frac1{\\sec^2x}-\\frac1{1+\\sec^2x}\\\\&=\\cos^2x-\\frac1{1+\\frac1{\\cos^2x}}\\\\&=\\cos^2x-\\frac1{\\frac{\\cos^2x+1}{\\cos^2x}}\\\\&=\\cos^2x-\\frac{\\cos^2x}{\\cos^2x+1}\\\\&=\\frac{\\cos^2x(\\cos^2x+1)-\\cos^2x}{\\cos^2x+1}\\\\&=\\frac{\\cos^4x+\\cos^2x-\\cos^2x}{\\cos^2x+1}\\\\&=\\frac{\\cos^4x}{\\cos^2x+1}\\\\&=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      },
      {
        "id": "p37-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\sin^2x(1+n\\cot^2x)+\\cos^2x(1+n\\tan^2x)=n+1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\text{LHS}=1+n(\\cos^2x+\\sin^2x)=n+1=\\text{RHS}$.",
          "worked": "$$\\begin{align*}\\text{LHS}&=\\sin^2x+n\\sin^2x\\cot^2x+\\cos^2x+n\\cos^2x\\tan^2x\\\\&=\\sin^2x+\\cos^2x+n\\sin^2x\\cdot\\frac{\\cos^2x}{\\sin^2x}+n\\cos^2x\\cdot\\frac{\\sin^2x}{\\cos^2x}\\\\&=1+n\\cos^2x+n\\sin^2x\\\\&=1+n(\\cos^2x+\\sin^2x)\\\\&=1+n\\\\&=\\text{RHS}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
    ]
