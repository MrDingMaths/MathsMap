  "content": {
    "id": "p23-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "If $x=\\log_a2$, $y=\\log_a3$ and $z=\\log_a5$, simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_a64$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6x$",
          "worked": "$$\\begin{align*}\\log_a64&=\\log_a(2^6)\\\\\\log_a64&=6\\log_a2\\\\\\log_a64&=6x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_a\\frac{1}{30}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x-y-z$",
          "worked": "$$\\begin{align*}\\log_a\\frac{1}{30}&=-\\log_a30\\\\\\log_a\\frac{1}{30}&=-\\log_a2-\\log_a3-\\log_a5\\\\\\log_a\\frac{1}{30}&=-x-y-z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_a(27a^5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3y+5$",
          "worked": "$$\\begin{align*}\\log_a(27a^5)&=\\log_a(3^3)+\\log_a(a^5)\\\\\\log_a(27a^5)&=3\\log_a3+5\\log_a a\\\\\\log_a(27a^5)&=3y+5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_a\\frac{100}{a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+2z-1$",
          "worked": "$$\\begin{align*}\\log_a\\frac{100}{a}&=\\log_a(2^2\\times5^2)-\\log_a a\\\\\\log_a\\frac{100}{a}&=2\\log_a2+2\\log_a5-1\\\\\\log_a\\frac{100}{a}&=2x+2z-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_a1.5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y-x$",
          "worked": "$$\\begin{align*}\\log_a1.5&=\\log_a\\frac{3}{2}\\\\\\log_a1.5&=\\log_a3-\\log_a2\\\\\\log_a1.5&=y-x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_a\\frac{18}{25a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x+2y-2z-1$",
          "worked": "$$\\begin{align*}\\log_a\\frac{18}{25a}&=\\log_a(2\\times3^2)-\\log_a(5^2a)\\\\\\log_a\\frac{18}{25a}&=\\log_a2+2\\log_a3-2\\log_a5-\\log_a a\\\\\\log_a\\frac{18}{25a}&=x+2y-2z-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p23-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_a0.04$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2z$",
          "worked": "$$\\begin{align*}\\log_a0.04&=\\log_a(5^{-2})\\\\\\log_a0.04&=-2\\log_a5\\\\\\log_a0.04&=-2z\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p23-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\log_a\\frac{8}{15a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x-y-z-2$",
          "worked": "$$\\begin{align*}\\log_a\\frac{8}{15a^2}&=\\log_a(2^3)-\\log_a(3\\times5\\times a^2)\\\\\\log_a\\frac{8}{15a^2}&=3\\log_a2-\\log_a3-\\log_a5-2\\log_a a\\\\\\log_a\\frac{8}{15a^2}&=3x-y-z-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
