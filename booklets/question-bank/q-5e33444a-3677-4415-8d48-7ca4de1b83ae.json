        "prompt": "$$\\begin{aligned}5x+2y&=19\\\\3x+2y&=13\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=3,\\ y=2$.",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(5x+2y)-(3x+2y)&=19-13\\\\2x&=6\\\\x&=3\\end{align*}$$\nSubstitute $x=3$ into the first equation.\n$$\\begin{align*}5(3)+2y&=19\\\\2y&=4\\\\y&=2\\end{align*}$$\nTherefore $x=3,\\ y=2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-9e3d4-p35-practice-slot-11-slot-11-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}4x+3y&=2\\\\2x-3y&=10\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ y=-2$.",
          "worked": "Add the two equations.\n$$\\begin{align*}(4x+3y)+(2x-3y)&=2+10\\\\6x&=12\\\\x&=2\\end{align*}$$\nSubstitute $x=2$ into the first equation.\n$$\\begin{align*}4(2)+3y&=2\\\\3y&=-6\\\\y&=-2\\end{align*}$$\nTherefore $x=2,\\ y=-2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
