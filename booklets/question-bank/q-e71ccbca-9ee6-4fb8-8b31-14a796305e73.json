      {
        "id": "p45-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "there are no restrictions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7!=5040$",
          "worked": "There are eight distinct letters. Rotations count as the same arrangement.\n\n$$\\begin{align*}N&=(8-1)!\\\\N&=7!\\\\N&=5040\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p45-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the vowels are all separate.",
