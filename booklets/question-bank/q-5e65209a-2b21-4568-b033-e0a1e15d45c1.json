    "children": [
      {
        "id": "p13-q35-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(\\overline{A}\\cap B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1$",
          "worked": "$$\\begin{align*}P(\\overline{A}\\cap B)&=P(B)-P(A\\cap B)\\\\P(\\overline{A}\\cap B)&=0.15-0.05\\\\P(\\overline{A}\\cap B)&=0.1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q35-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(\\overline{A}\\cap C)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.25$",
          "worked": "$$\\begin{align*}P(\\overline{A}\\cap C)&=P(C)-P(A\\cap C)\\\\P(\\overline{A}\\cap C)&=0.65-0.4\\\\P(\\overline{A}\\cap C)&=0.25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q35-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(A\\cup B)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.7$",
          "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=0.6+0.15-0.05\\\\P(A\\cup B)&=0.7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q35-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(B\\cup C)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.8$",
          "worked": "Since $B$ and $C$ are disjoint, $P(B\\cap C)=0$.\n\n$$\\begin{align*}P(B\\cup C)&=P(B)+P(C)\\\\P(B\\cup C)&=0.15+0.65\\\\P(B\\cup C)&=0.8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p13-q35-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(\\overline{A}\\cap\\overline{B}\\cap\\overline{C})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p13-q35-e-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "0.05",
                    "display": false
                  }
                ]
              },
              {
                "id": "p13-q35-e-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use disjointness and the addition rule to find ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "P(A\\cup B\\cup C)=0.95",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ", then take the complement.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Let $U=B\\cup C$. From (d), $P(U)=0.8$. Since $B$ and $C$ are disjoint, $A\\cap B$ and $A\\cap C$ are disjoint.\n\n$$\\begin{align*}P(A\\cap U)&=P(A\\cap B)+P(A\\cap C)\\\\P(A\\cap U)&=0.05+0.4\\\\P(A\\cap U)&=0.45\\end{align*}$$\n\n$$\\begin{align*}P(A\\cup U)&=P(A)+P(U)-P(A\\cap U)\\\\P(A\\cup U)&=0.6+0.8-0.45\\\\P(A\\cup U)&=0.95\\end{align*}$$\n\n$$\\begin{align*}P(\\overline{A}\\cap\\overline{B}\\cap\\overline{C})&=1-P(A\\cup U)\\\\P(\\overline{A}\\cap\\overline{B}\\cap\\overline{C})&=1-0.95\\\\P(\\overline{A}\\cap\\overline{B}\\cap\\overline{C})&=0.05\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 92
      }
