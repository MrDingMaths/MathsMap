  "content": {
    "id": "v2-a4943-p66-practice-slot-11-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Write in the form $a+\\dfrac{b}{cx+d}$, keeping the given denominator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-a4943-p66-practice-slot-11-lower-slot-11-lower-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{3x+4}{2x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac32+\\dfrac{5}{2}\\cdot\\dfrac{1}{2x+1}$, that is $a=\\dfrac32,\\ b=\\dfrac52$",
          "worked": "$$\\begin{align*}\\frac{3x+4}{2x+1}&=\\frac{\\frac32(2x+1)+\\frac52}{2x+1}\\\\&=\\frac{\\frac32(2x+1)}{2x+1}+\\frac{\\frac52}{2x+1}\\\\&=\\frac32+\\frac{\\frac52}{2x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-a4943-p66-practice-slot-11-lower-slot-11-lower-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{5x+9}{2x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac52+\\dfrac{\\frac32}{2x+3}$, that is $a=\\dfrac52,\\ b=\\dfrac32$",
          "worked": "$$\\begin{align*}\\frac{5x+9}{2x+3}&=\\frac{\\frac52(2x+3)+\\frac32}{2x+3}\\\\&=\\frac{\\frac52(2x+3)}{2x+3}+\\frac{\\frac32}{2x+3}\\\\&=\\frac52+\\frac{\\frac32}{2x+3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
