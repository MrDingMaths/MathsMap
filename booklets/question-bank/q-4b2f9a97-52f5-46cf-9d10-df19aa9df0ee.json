  "content": {
    "id": "p31-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find $\\operatorname{proj}_{\\underset{\\sim}{u}}\\underset{\\sim}{v}$ given:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}\\underset{\\sim}{u}&=\\begin{pmatrix}3\\\\6\\end{pmatrix}\\\\\\underset{\\sim}{v}&=\\begin{pmatrix}-2\\\\6\\end{pmatrix}\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\begin{pmatrix}2\\\\4\\end{pmatrix}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=3(-2)+6(6)=30\\\\|\\underset{\\sim}{u}|^2&=9+36=45\\\\\\operatorname{proj}_{\\underset{\\sim}{u}}\\underset{\\sim}{v}&=\\frac{30}{45}\\begin{pmatrix}3\\\\6\\end{pmatrix}=\\begin{pmatrix}2\\\\4\\end{pmatrix}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p31-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}\\underset{\\sim}{u}&=-3\\underset{\\sim}{i}-2\\underset{\\sim}{j}\\\\\\underset{\\sim}{v}&=4\\underset{\\sim}{i}-19\\underset{\\sim}{j}\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-6\\underset{\\sim}{i}-4\\underset{\\sim}{j}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(-3)(4)+(-2)(-19)=26\\\\|\\underset{\\sim}{u}|^2&=9+4=13\\\\\\operatorname{proj}_{\\underset{\\sim}{u}}\\underset{\\sim}{v}&=\\frac{26}{13}(-3\\underset{\\sim}{i}-2\\underset{\\sim}{j})\\\\&=-6\\underset{\\sim}{i}-4\\underset{\\sim}{j}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
