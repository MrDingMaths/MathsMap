  "content": {
    "id": "p9-q5-root",
    "type": "question",
    "label": null,
    "prompt": "Differentiate each expression by first rewriting it as a power of $e$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$4^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4^x\\ln 4$",
          "worked": "$$\\begin{align*}4^x&=e^{x\\ln 4}\\\\ \\frac{d}{dx}(4^x)&=(\\ln 4)e^{x\\ln 4}\\\\ \\frac{d}{dx}(4^x)&=4^x\\ln 4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$3^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^x\\ln 3$",
          "worked": "$$\\begin{align*}3^x&=e^{x\\ln 3}\\\\ \\frac{d}{dx}(3^x)&=(\\ln 3)e^{x\\ln 3}\\\\ \\frac{d}{dx}(3^x)&=3^x\\ln 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$3^{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(\\ln 3)3^{2x}$",
          "worked": "$$\\begin{align*}3^{2x}&=e^{(2\\ln 3)x}\\\\ \\frac{d}{dx}(3^{2x})&=(2\\ln 3)e^{(2\\ln 3)x}\\\\ \\frac{d}{dx}(3^{2x})&=2(\\ln 3)3^{2x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p9-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$4^{\\frac{x}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^x\\ln 2$",
          "worked": "$$\\begin{align*}4^{\\frac{x}{2}}&=(2^2)^{\\frac{x}{2}}\\\\ 4^{\\frac{x}{2}}&=2^x\\\\ 4^{\\frac{x}{2}}&=e^{x\\ln 2}\\\\ \\frac{d}{dx}\\bigl(4^{\\frac{x}{2}}\\bigr)&=(\\ln 2)e^{x\\ln 2}\\\\ \\frac{d}{dx}\\bigl(4^{\\frac{x}{2}}\\bigr)&=2^x\\ln 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
