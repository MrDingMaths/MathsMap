            "inlines": [
              {
                "type": "text",
                "text": "Let the repeated digit be ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "d\\in\\{1,2,\\ldots,9\\}",
                "display": false
              },
              {
                "type": "text",
                "text": ". The number is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\overline{ddd}",
                "display": false
              },
              {
                "type": "text",
                "text": ", where the bar denotes digits written together.",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "The number formed by the last two digits is ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\overline{dd}=10d+d=11d",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Since 11 has no factor in common with 4, ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "11d",
                "display": false
              },
              {
                "type": "text",
                "text": " is divisible by 4 exactly when ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "d",
