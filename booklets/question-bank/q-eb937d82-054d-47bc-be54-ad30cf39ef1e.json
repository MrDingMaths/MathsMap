    "children": [
      {
        "id": "p16-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "If $f(x)=x^2-x$,\nthen $f(1-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$; both sides simplify to $x^2-x$.",
          "worked": "$$\\begin{align*}f(1-x)&=(1-x)^2-(1-x)\\\\f(1-x)&=1-2x+x^2-1+x\\\\f(1-x)&=x^2-x\\\\f(x)&=x^2-x\\end{align*}$$\nBoth sides are equal, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p16-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "If $f(x)=x^2$,\nthen $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$; both sides simplify to $x^2$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2\\\\f(-x)&=x^2\\\\f(x)&=x^2\\end{align*}$$\nBoth sides are equal, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q21-c",
        "type": "part",
        "label": "c",
        "prompt": "If $f(x)=x^2+1$,\nthen $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$; both sides simplify to $x^2+1$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2+1\\\\f(-x)&=x^2+1\\\\f(x)&=x^2+1\\end{align*}$$\nBoth sides are equal, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p16-q21-d",
        "type": "part",
        "label": "d",
        "prompt": "If $f(x)=x^2+x$,\nthen $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not an identity: $x^2-x$ and $x^2+x$ are equal only when $x=0$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2+(-x)\\\\f(-x)&=x^2-x\\\\f(x)&=x^2+x\\end{align*}$$\nFor equality,\n$$\\begin{align*}x^2-x&=x^2+x\\\\-2x&=0\\\\x&=0\\end{align*}$$\nNot an identity; the claim is true only when $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p16-q21-e",
        "type": "part",
        "label": "e",
        "prompt": "If $f(x)=3x-2$,\nthen $f(x+1)=f(x)+3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x$; both sides simplify to $3x+1$.",
          "worked": "$$\\begin{align*}f(x+1)&=3(x+1)-2\\\\f(x+1)&=3x+1\\\\f(x)+3&=(3x-2)+3\\\\f(x)+3&=3x+1\\end{align*}$$\nBoth sides are equal, so the claim is true for all $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q21-f",
        "type": "part",
        "label": "f",
        "prompt": "If $f(x)=3x-2$,\nthen $f(2x)=2f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Not an identity: the sides simplify to $6x-2$ and $6x-4$.",
          "worked": "$$\\begin{align*}f(2x)&=3(2x)-2\\\\f(2x)&=6x-2\\\\2f(x)&=2(3x-2)\\\\2f(x)&=6x-4\\end{align*}$$\nThe sides differ by $2$ for every $x$, so the claim is not an identity.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p16-q21-g",
        "type": "part",
        "label": "g",
        "prompt": "If $f(x)=\\frac{1}{x}$,\nthen $f\\left(\\frac{1}{x}\\right)=x$ for $x\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x\\ne0$; both sides simplify to $x$.",
          "worked": "$$\\begin{align*}f\\left(\\frac{1}{x}\\right)&=\\frac{1}{\\frac{1}{x}}\\\\f\\left(\\frac{1}{x}\\right)&=x\\\\\\text{RHS}&=x\\end{align*}$$\nBoth sides are equal for every $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p16-q21-h",
        "type": "part",
        "label": "h",
        "prompt": "If $f(x)=x+\\frac{1}{x}$,\nthen $f\\left(\\frac{1}{x}\\right)=f(x)$ for $x\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True for all $x\\ne0$; both sides simplify to $x+\\frac{1}{x}$.",
          "worked": "$$\\begin{align*}f\\left(\\frac{1}{x}\\right)&=\\frac{1}{x}+\\frac{1}{\\frac{1}{x}}\\\\f\\left(\\frac{1}{x}\\right)&=\\frac{1}{x}+x\\\\f(x)&=x+\\frac{1}{x}\\end{align*}$$\nBoth sides are equal for every $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
