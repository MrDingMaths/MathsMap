    "children": [
      {
        "id": "p41-25j-q4a",
        "type": "part",
        "label": "a",
        "prompt": "Three numbers are chosen at random from $1,\\ldots,10$. Find the probability they are consecutive.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{15}$",
          "worked": "There are $\\binom{10}{3}=120$ equally likely selections. A consecutive triple is $\\{r,r+1,r+2\\}$, where $r=1,\\ldots,8$, so there are 8 favourable selections.\n\n$$\\begin{align*}\\Pr(\\text{consecutive})&=\\frac{8}{\\binom{10}{3}}\\\\\\Pr(\\text{consecutive})&=\\frac{8}{120}\\\\\\Pr(\\text{consecutive})&=\\frac{1}{15}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p41-25j-q4b",
        "type": "part",
        "label": "b",
        "prompt": "For $n\\geq3$, find the probability that three numbers chosen from $1,\\ldots,n$ are consecutive.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6}{n(n-1)}$\n\nThere are $n-2$ consecutive triples among $\\binom{n}{3}$ equally likely selections.",
          "worked": "A consecutive triple is $\\{r,r+1,r+2\\}$, where $r=1,\\ldots,n-2$. Thus there are $n-2$ favourable selections among $\\binom{n}{3}$ equally likely selections.\n\n$$\\begin{align*}\\Pr(\\text{consecutive})&=\\frac{n-2}{\\binom{n}{3}}\\\\\\Pr(\\text{consecutive})&=\\frac{n-2}{n(n-1)(n-2)/6}\\\\\\Pr(\\text{consecutive})&=\\frac{6}{n(n-1)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
