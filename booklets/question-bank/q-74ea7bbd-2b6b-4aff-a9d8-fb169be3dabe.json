  "content": {
    "id": "p10-q2",
    "type": "question",
    "label": "2",
    "prompt": "Solve for the unknown variable.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q2-a",
        "type": "group",
        "label": "a",
        "prompt": "$v^{2}=u^{2}+2as,$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q2-a-1",
            "type": "part",
            "label": "i",
            "prompt": "Find $s$ when $v=22$, $u=6$, $a=12$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$s=\\dfrac{56}{3}$",
              "worked": "$$\\begin{align*}v^{2}&=u^{2}+2as\\\\22^{2}&=6^{2}+2(12)s\\\\484&=36+24s\\\\24s&=448\\\\s&=\\frac{448}{24}\\\\s&=\\frac{56}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 42
          },
          {
            "id": "p10-q2-a-2",
            "type": "part",
            "label": "ii",
            "prompt": "Find $v$ when $u=0$, $a=10$, $s=60$. Give your answers to 2 decimal places.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$v\\approx\\pm34.64$",
              "worked": "$$\\begin{align*}v^{2}&=u^{2}+2as\\\\v^{2}&=0^{2}+2(10)(60)\\\\v^{2}&=1200\\\\v&=\\pm\\sqrt{1200}\\\\v&\\approx\\pm34.64\\end{align*}$$\nTo 2 decimal places.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          }
        ]
      },
      {
        "id": "p10-q2-b",
        "type": "group",
        "label": "b",
        "prompt": "$m=\\sqrt{\\dfrac{x}{y}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p10-q2-b-1",
            "type": "part",
            "label": "i",
            "prompt": "Find $y$ when $m=8$, $x=4$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac{1}{16}$",
              "worked": "$$\\begin{align*}m&=\\sqrt{\\frac{x}{y}}\\\\8&=\\sqrt{\\frac{4}{y}}\\\\64&=\\frac{4}{y}\\\\64y&=4\\\\y&=\\frac{4}{64}\\\\y&=\\frac{1}{16}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 46
          },
          {
            "id": "p10-q2-b-2",
            "type": "part",
            "label": "ii",
            "prompt": "Find $x$ when $y=2$, $m=10$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x=200$",
              "worked": "$$\\begin{align*}m&=\\sqrt{\\frac{x}{y}}\\\\10&=\\sqrt{\\frac{x}{2}}\\\\100&=\\frac{x}{2}\\\\x&=200\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 34
          }
        ]
      }
    ]
  },
