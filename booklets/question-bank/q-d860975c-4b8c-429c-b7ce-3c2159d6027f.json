    "type": "question",
    "label": "4",
    "prompt": "$f(x)=mx+c$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Use first principles differentiation to find $f'(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(x)=m$",
          "worked": "$$\\begin{align*}f'(x)&=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{m(x+h)+c-(mx+c)}{h}\\\\f'(x)&=\\lim_{h\\to0}\\frac{mh}{h}\\\\f'(x)&=\\lim_{h\\to0}m\\\\f'(x)&=m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Interpret your answer for $f(x)=mx+c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The rate of change of a linear graph is its gradient $m$.",
          "worked": "The derivative is the gradient of the tangent. A straight line has the same gradient $m$ at every point, so its rate of change is constant and equal to $m$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
