            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-2$",
              "worked": "$$\\begin{align*}m_{BC}&=\\frac{4-2}{2-3}\\\\m_{BC}&=-2\\end{align*}$$",
              "solutionDiagrams": []
