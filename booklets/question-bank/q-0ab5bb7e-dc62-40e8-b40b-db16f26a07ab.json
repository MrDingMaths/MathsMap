        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 13, p13-q11-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\n\\coordinate (B) at (2,0);\n\\coordinate (C) at (2,2);\n\\coordinate (D) at (0,2);\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--(D)--cycle;\n\\draw[black,line width=0.8pt] (A)--(C) node[midway,above left] {$\\ell$};\n\\path (A)--(B) node[midway,below] {$x$};\n\\path (B)--(C) node[midway,right] {$x$};\n\\end{tikzpicture}",
        "src": null,
