    "type": "question",
    "label": "11",
    "prompt": "The side length $x$ of a square shadow is increasing at $6\\text{ cm/s}$. If the area is $A$ and the length of the diagonal is $\\ell$,",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p13-q11-diagram",
