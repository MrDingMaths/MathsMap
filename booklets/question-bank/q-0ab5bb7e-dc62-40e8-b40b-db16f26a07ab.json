    "children": [
      {
        "id": "p13-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "show that $\\dfrac{dA}{dt}=2x\\left(\\dfrac{dx}{dt}\\right)$ and $\\dfrac{d\\ell}{dt}=\\sqrt{2}\\left(\\dfrac{dx}{dt}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dA}{dt}=2x\\dfrac{dx}{dt}$ and $\\dfrac{d\\ell}{dt}=\\sqrt{2}\\dfrac{dx}{dt}$.",
          "worked": "$$\\begin{aligned}A&=x^2\\\\\\frac{dA}{dt}&=\\frac{dA}{dx}\\frac{dx}{dt}\\\\\\frac{dA}{dt}&=2x\\frac{dx}{dt}\\end{aligned}$$\nBy Pythagoras, $\\ell^2=x^2+x^2$, so $\\ell=x\\sqrt{2}$.\n$$\\begin{aligned}\\frac{d\\ell}{dt}&=\\frac{d\\ell}{dx}\\frac{dx}{dt}\\\\\\frac{d\\ell}{dt}&=\\sqrt{2}\\frac{dx}{dt}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q11-followup",
        "type": "group",
        "label": "",
        "prompt": "Hence find the rates of increase of the area and the diagonal when:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p13-q11-b",
            "type": "part",
            "label": "b",
            "prompt": "the side length is $70\\text{ cm}$,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Area: $840\\text{ cm}^2/\\text{s}$; diagonal: $6\\sqrt{2}\\text{ cm/s}$.",
              "worked": "When $x=70\\text{ cm}$ and $\\dfrac{dx}{dt}=6\\text{ cm/s}$,\n$$\\begin{aligned}\\frac{dA}{dt}&=2(70)(6)\\\\\\frac{dA}{dt}&=840\\text{ cm}^2/\\text{s}\\\\\\frac{d\\ell}{dt}&=\\sqrt{2}(6)\\\\\\frac{d\\ell}{dt}&=6\\sqrt{2}\\text{ cm/s}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p13-q11-c",
            "type": "part",
            "label": "c",
            "prompt": "the area is $1\\text{ m}^2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Area: $1200\\text{ cm}^2/\\text{s}$; diagonal: $6\\sqrt{2}\\text{ cm/s}$.",
              "worked": "$$\\begin{aligned}A&=1\\text{ m}^2=10000\\text{ cm}^2\\\\x^2&=10000\\\\x&=100\\text{ cm}\\\\\\frac{dA}{dt}&=2(100)(6)\\\\\\frac{dA}{dt}&=1200\\text{ cm}^2/\\text{s}\\\\\\frac{d\\ell}{dt}&=\\sqrt{2}(6)\\\\\\frac{d\\ell}{dt}&=6\\sqrt{2}\\text{ cm/s}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      }
