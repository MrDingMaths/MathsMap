              "type": "text",
              "text": "What sum of money needs to be invested to accumulate a total of $40 000 after 10 years at 9.25% p.a. interest compounding annually? Answer to the nearest cent.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$16\\,513.74$",
      "worked": "$$\\begin{align*}FV &= PV(1+r)^n\\\\40\\,000 &= PV(1+0.0925)^{10}\\\\\\frac{40\\,000}{(1+0.0925)^{10}} &= PV\\\\PV &\\approx \\$16\\,513.74\\end{align*}$$",
      "solutionDiagrams": []
    },
