  "content": {
    "id": "p36-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "In how many ways can ten people be arranged in a line:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "without restriction,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\,628\\,800$",
          "worked": "$$10!=3\\,628\\,800$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p36-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "if one particular person must sit at either end,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$725\\,760$",
          "worked": "Choose either end for the particular person, then arrange the other 9 people.\n$$2\\times9!=725\\,760$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p36-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "if two particular people must sit next to one another,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$725\\,760$",
          "worked": "Treat the two people as one unit. Arrange the 9 units and the 2 people within their unit.\n$$9!\\times2!=725\\,760$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p36-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "if neither of two particular people, A and B, can sit on either end of the row?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\,257\\,920$",
          "worked": "Count the unacceptable arrangements.\n\nA on either end: $2\\times9!$.\n\nB on either end: $2\\times9!$.\n\nThese counts include arrangements with A and B both on the ends twice. Subtract their overlap, $2\\times8!$, once from the unacceptable count.\n$$\\begin{aligned}\\text{Unacceptable}&=2\\times9!+2\\times9!-2\\times8!\\\\\\text{Acceptable}&=10!-(2\\times9!+2\\times9!-2\\times8!)\\\\&=2\\,257\\,920\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
  },
