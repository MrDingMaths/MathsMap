  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "$65\\%$ of a group of 4300 teenagers said they like healthy food.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "How many of the teenagers said they like healthy food?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "2795 teenagers",
          "worked": "$$\\begin{align*}65\\%\\text{ of }4300&=\\frac{65}{100}\\times4300\\\\65\\%\\text{ of }4300&=2795\\end{align*}$$\n\n2795 teenagers said they like healthy food.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the percentage of the teenagers who said they do not like healthy food?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$35\\%$",
          "worked": "The whole group represents $100\\%$.\n\n$$100\\%-65\\%=35\\%$$\n\n$35\\%$ of the teenagers said they do not like healthy food.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
