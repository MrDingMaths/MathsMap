  "content": {
    "id": "p44-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Differentiate the following with respect to $x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p44-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2(2-3x)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(2-3x)^4(4-21x)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x(2-3x)^5-15x^2(2-3x)^4\\\\\\frac{dy}{dx}&=x(2-3x)^4[2(2-3x)-15x]\\\\\\frac{dy}{dx}&=x(2-3x)^4(4-21x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p44-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(3x+1)^4(2x-1)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(3x+1)^3(2x-1)^4(27x-1)$",
          "worked": "By the product and chain rules,\n\n$$\\begin{align*}\\frac{dy}{dx}&=12(3x+1)^3(2x-1)^5\\\\&\\quad+10(3x+1)^4(2x-1)^4\\\\\\frac{dy}{dx}&=2(3x+1)^3(2x-1)^4\\\\&\\quad\\times[6(2x-1)+5(3x+1)]\\\\\\frac{dy}{dx}&=2(3x+1)^3(2x-1)^4(27x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p44-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x\\sqrt{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3x+2}{2\\sqrt{x+1}}$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=\\sqrt{x+1}+\\frac{x}{2\\sqrt{x+1}}\\\\\\frac{dy}{dx}&=\\frac{2(x+1)+x}{2\\sqrt{x+1}}\\\\\\frac{dy}{dx}&=\\frac{3x+2}{2\\sqrt{x+1}}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p44-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=x(x^2+1)^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+1)^2(7x^2+1)$",
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=(x^2+1)^3+6x^2(x^2+1)^2\\\\\\frac{dy}{dx}&=(x^2+1)^2[(x^2+1)+6x^2]\\\\\\frac{dy}{dx}&=(x^2+1)^2(7x^2+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
