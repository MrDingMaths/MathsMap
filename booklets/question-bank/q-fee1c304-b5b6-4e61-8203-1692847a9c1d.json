  "content": {
    "id": "p27-q43-root",
    "type": "question",
    "label": "43",
    "prompt": "The graph of $y=\\ln(x)$ is vertically dilated by a factor of $k$ to give $y=\\log_{10}(x)$. Find the value of $k$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\dfrac{1}{\\ln 10}$.",
      "worked": "Replace $y\\mapsto \\frac{y}{k}$.\n\n$$\\begin{align*}\\frac{y}{k}&=\\ln x\\\\y&=k\\ln x\\end{align*}$$\n\nBy change of base, $\\log_{10}x=\\dfrac{\\ln x}{\\ln 10}$. Matching the multiplier gives $k=\\dfrac{1}{\\ln 10}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
