  "content": {
    "id": "v2-ae597-p27-practice-slot-15-root",
    "type": "question",
    "label": null,
    "prompt": "The expression $x^2+bx+20$ completes to give $(x+a)^2+4$.\nFind all possible values of $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b=\\pm8$.",
      "worked": "$$\\begin{align*}x^2+bx+20&=x^2+bx+\\left(\\frac b2\\right)^2-\\left(\\frac b2\\right)^2+20\\\\&=\\left(x+\\frac b2\\right)^2+20-\\frac{b^2}{4}\\end{align*}$$\nSo\n$$\\begin{align*}20-\\frac{b^2}{4}&=4\\\\b^2&=64\\\\b&=\\pm8\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
