  "content": {
    "id": "p55-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The displacement of a particle over time $t$ seconds is given by $x=2e^{4t}$ metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p55-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the initial displacement?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ m}$",
          "worked": "At $t=0$:\n$$\\begin{align*}x(0)&=2e^{4(0)}\\\\&=2\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p55-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the exact velocity after $10\\text{ s}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8e^{40}\\text{ m/s}$",
          "worked": "$$\\begin{align*}v(t)=\\frac{dx}{dt}&=2(4)e^{4t}\\\\&=8e^{4t}.\\end{align*}$$\nAt $t=10$:\n$$\\begin{align*}v(10)&=8e^{4(10)}\\\\&=8e^{40}\\text{ m/s}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p55-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the acceleration after $2\\text{ s}$ correct to 1 decimal place.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$95\\,390.7\\text{ m/s}^2$",
          "worked": "$$\\begin{align*}v(t)&=8e^{4t}\\\\a(t)=\\frac{dv}{dt}&=8(4)e^{4t}\\\\&=32e^{4t}.\\end{align*}$$\nAt $t=2$:\n$$\\begin{align*}a(2)&=32e^{4(2)}\\\\&=32e^8\\\\&\\approx95\\,390.7\\text{ m/s}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
  },
