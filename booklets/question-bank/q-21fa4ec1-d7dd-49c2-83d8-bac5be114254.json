        "id": "p13-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the smallest number of each spoon that would make the lines equal in length?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "3 teaspoons, 2 spoons",
          "worked": "Multiples of 14: $14, 28, 42, \\ldots$\n\nMultiples of 21: $21, 42, \\ldots$\n\nThe smallest shared length is $42\\text{ cm}$.\n\n$\\begin{aligned}\\text{Number of teaspoons} &= 42\\div14\\\\&=3\\\\\\text{Number of spoons} &=42\\div21\\\\&=2\\end{aligned}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p13-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "How long would that line be?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$42\\text{ cm}$",
          "worked": "$\\text{Line length}=3\\times14=42\\text{ cm}$, also $2\\times21=42\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
