        "prompt": ": $y=(3x+2)e^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(3x+5)e^x$",
          "worked": "$$\\begin{aligned}y'&=3e^x+(3x+2)e^x\\\\&=(3x+5)e^x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=xe^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(1-x)e^{-x}$",
          "worked": "$$\\begin{aligned}y'&=e^{-x}-xe^{-x}\\\\&=(1-x)e^{-x}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=(x-1)e^x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=xe^x$",
          "worked": "$$\\begin{aligned}y'&=e^x+(x-1)e^x\\\\&=xe^x\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p15-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$y=(x+1)e^{3x-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(3x+4)e^{3x-4}$",
          "worked": "$$\\begin{aligned}y'&=e^{3x-4}+3(x+1)e^{3x-4}\\\\&=(3x+4)e^{3x-4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p15-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$y=x^2e^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=(2x-x^2)e^{-x}$",
          "worked": "$$\\begin{aligned}y'&=2xe^{-x}-x^2e^{-x}\\\\&=(2x-x^2)e^{-x}\\end{aligned}$$",
          "solutionDiagrams": []
