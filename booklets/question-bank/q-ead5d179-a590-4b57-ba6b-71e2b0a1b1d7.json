  "content": {
    "id": "p10-q16",
    "type": "question",
    "label": "",
    "prompt": "If $\\alpha$ and $\\beta$ are the roots of $5x^2+mx-5=0$, find the exact value of $(5\\alpha+m)(5\\beta+m)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-25$.",
      "worked": "$\\alpha+\\beta=-\\frac{m}{5}$, $\\alpha\\beta=-1$.\n\n$$\\begin{aligned}&\\mathrel{\\phantom{=}}(5\\alpha+m)(5\\beta+m)\\\\&=25\\alpha\\beta+5\\alpha m+5\\beta m+m^2\\\\&=25\\alpha\\beta+5m(\\alpha+\\beta)+m^2\\\\&=25(-1)+5m\\left(-\\frac{m}{5}\\right)+m^2\\\\&=-25-m^2+m^2\\\\&=-25\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 39
  },
