  "content": {
    "id": "p23-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "If $f(x)=\\dfrac{1}{x-1}$ and $g(x)=\\dfrac{x+1}{x}$, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q4-calculations",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p23-q4-a",
            "type": "part",
            "label": "a",
            "prompt": "$g(f(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$\\begin{align*}f(2)&=\\frac{1}{2-1}\\\\f(2)&=1\\\\g(f(2))&=\\frac{1+1}{1}\\\\g(f(2))&=2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p23-q4-b",
            "type": "part",
            "label": "b",
            "prompt": "$f(g(2))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2$",
              "worked": "$\\begin{align*}g(2)&=\\frac{2+1}{2}\\\\g(2)&=\\frac32\\\\f(g(2))&=\\frac{1}{\\frac32-1}\\\\f(g(2))&=2\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p23-q4-c",
            "type": "part",
            "label": "c",
            "prompt": "$g(f(4))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$\\begin{align*}f(4)&=\\frac{1}{4-1}\\\\f(4)&=\\frac13\\\\g(f(4))&=\\frac{\\frac13+1}{\\frac13}\\\\g(f(4))&=4\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p23-q4-d",
            "type": "part",
            "label": "d",
            "prompt": "$f(g(4))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4$",
              "worked": "$\\begin{align*}g(4)&=\\frac{4+1}{4}\\\\g(4)&=\\frac54\\\\f(g(4))&=\\frac{1}{\\frac54-1}\\\\f(g(4))&=4\\end{align*}$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 38
          },
          {
            "id": "p23-q4-e",
            "type": "part",
            "label": "e",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x$, for $x\\ne0$.",
              "worked": "$\\begin{align*}f(g(x))&=\\frac{1}{\\frac{x+1}{x}-1}\\\\f(g(x))&=\\frac{1}{\\frac{x+1-x}{x}}\\\\f(g(x))&=\\frac{1}{\\frac{1}{x}}\\\\f(g(x))&=x\\end{align*}$\n\nThis composition is defined for $x\\ne0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          },
          {
            "id": "p23-q4-f",
            "type": "part",
            "label": "f",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x$, for $x\\ne1$.",
              "worked": "$\\begin{align*}g(f(x))&=\\frac{\\frac{1}{x-1}+1}{\\frac{1}{x-1}}\\\\g(f(x))&=\\frac{\\frac{x}{x-1}}{\\frac{1}{x-1}}\\\\g(f(x))&=x\\end{align*}$\n\nThis composition is defined for $x\\ne1$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 40
          }
        ]
      },
      {
        "id": "p23-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "Describe the relationship between $f(x)$ and $g(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f$ and $g$ are inverses of each other.\n\nBoth compositions return the original input.",
          "worked": "Parts e and f show that $f(g(x))=x$ for every $x$ in the domain of $g$, and $g(f(x))=x$ for every $x$ in the domain of $f$. Hence, $f$ and $g$ are inverses of each other.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
