  "content": {
    "id": "p76-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "A family of five are seated in a row at the cinema. Find the probability that:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "the parents sit on the end and the three children are in the middle,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "The parents occupy the two end positions in $2!$ ways. The children occupy the middle positions in $3!$ ways. There are $5!$ arrangements altogether.\n$$P=\\frac{2!\\times3!}{5!}=\\frac{1}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p76-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "the parents sit next to one another.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "Treat the parents as one unit, giving $4!$ arrangements. The parents can be arranged within their unit in $2!$ ways.\n$$P=\\frac{4!\\times2!}{5!}=\\frac{2}{5}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
