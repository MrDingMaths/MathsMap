    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A circular wheel of radius $0.1\\text{ m}$ rolls along a flat surface through ten revolutions without slipping. Find the distance covered by the centre of the wheel in metres, accurate to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$6.28\\text{ m}$.",
      "worked": "Without slipping, each revolution moves the centre forward by one circumference.\n$$\\begin{align*}d&=10\\times2\\pi r\\\\d&=10\\times2\\pi\\times0.1\\\\d&=2\\pi\\text{ m}\\\\d&\\approx6.28\\text{ m}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
