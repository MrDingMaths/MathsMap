  "content": {
    "id": "p41-l-response",
    "type": "question",
    "label": "l",
    "prompt": "A ball is dropped from a height of $150\\text{ cm}$. After each bounce, it reaches a height 20% lower than previously. What height does it reach after the fourth bounce?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$61.44\\text{ cm}$",
      "worked": "Each bounce multiplies the previous height by $1-0.20=0.8$.\n$$\\begin{align*}\\text{Height after four bounces}&=150\\times0.8\\times0.8\\times0.8\\times0.8\\\\\\text{Height after four bounces}&=150\\times0.4096\\\\\\text{Height after four bounces}&=61.44\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
