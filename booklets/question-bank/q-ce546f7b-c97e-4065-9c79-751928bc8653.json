    "label": "11",
    "prompt": "Find the area of an equilateral triangle of side length $a$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
