            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Jasmine is 8 years old, Frank is 16 years old and Richard is 22 years old.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p21-q27-answer-check",
            "type": "paragraph",
