            {
              "type": "text",
              "text": "Jasmine, Frank and Richard all have their birthdays on the same day.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Richard’s present age is two years less than the sum of Jasmine’s and Frank’s present ages.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "Frank is twice as old as Jasmine.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "In 6 years time Richard will be twice as old as Jasmine.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "At present, the sum of all their ages is 46. How old is each person now?",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Jasmine: 8 years; Frank: 16 years; Richard: 22 years. Let Jasmine’s age be $x$: $x+2x+(3x-2)=46$, so $x=8$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q27-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let Jasmine’s present age be ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "x",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " years. Frank’s age is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "2x",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " years and Richard’s age is ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "(x+2x)-2=3x-2",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": " years.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p21-q27-answer-working",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}x+2x+(3x-2)&=46\\\\6x-2&=46\\\\6x&=48\\\\x&=8\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p21-q27-answer-result",
            "type": "paragraph",
