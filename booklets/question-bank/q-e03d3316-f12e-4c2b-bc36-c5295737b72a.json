  "content": {
    "id": "v2-d0ffe-p42-practice-slot-4-root",
    "type": "question",
    "label": null,
    "prompt": "Each function is a PDF for a continuous random variable. Find the lower and upper quartiles correct to 2 decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d0ffe-p42-practice-slot-4-slot-4-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=\\dfrac{k}{x^2}$, domain $[1,4]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_1\\approx1.23$, $Q_3\\approx2.29$",
          "worked": "$$\\begin{align*}\\int_1^4kx^{-2}\\,dx&=1\\\\k\\left[-\\frac1x\\right]_1^4&=1\\\\\\frac{3k}{4}&=1\\\\k&=\\frac43\\end{align*}$$\n$$F(x)=\\frac43\\left(1-\\frac1x\\right)$$\n$$\\begin{align*}F(Q_1)=\\frac14&\\Rightarrow1-\\frac1{Q_1}=\\frac3{16}\\Rightarrow Q_1=\\frac{16}{13}\\approx1.23\\\\F(Q_3)=\\frac34&\\Rightarrow1-\\frac1{Q_3}=\\frac9{16}\\Rightarrow Q_3=\\frac{16}{7}\\approx2.29\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "v2-d0ffe-p42-practice-slot-4-slot-4-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=k\\sqrt{x}$, domain $[0,9]$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$Q_1\\approx3.57$, $Q_3\\approx7.43$",
          "worked": "$$\\begin{align*}\\int_0^9kx^{1/2}\\,dx&=1\\\\k\\left[\\frac23x^{3/2}\\right]_0^9&=1\\\\18k&=1\\\\k&=\\frac1{18}\\end{align*}$$\n$$F(x)=\\frac{x^{3/2}}{27}$$\n$$\\begin{align*}\\frac{Q_1^{3/2}}{27}=\\frac14&\\Rightarrow Q_1=\\left(\\frac{27}{4}\\right)^{2/3}\\approx3.57\\\\\\frac{Q_3^{3/2}}{27}=\\frac34&\\Rightarrow Q_3=\\left(\\frac{81}{4}\\right)^{2/3}\\approx7.43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      }
    ]
  },
