  "content": {
    "id": "p21-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "The temperature in Canberra had gone down to $-3^\\circ\\mathrm{C}$. The temperature in a heated house was a cosy $22^\\circ\\mathrm{C}$. What was the value of:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "(inside temperature) $-$ (outside temperature)?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}22-(-3)&=22+3\\\\22-(-3)&=25\\end{align*}$$\nThe value is $25^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "(outside temperature) $-$ (inside temperature)?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-25^\\circ\\mathrm{C}$",
          "worked": "$$\\begin{align*}-3-22&=-(3+22)\\\\-3-22&=-25\\end{align*}$$\nThe value is $-25^\\circ\\mathrm{C}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
