      {
        "id": "p19-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$y=-(x+2)^2$ and $x+y=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-3,-1)$ and $(0,-4)$.",
          "worked": "$$\\begin{align*}-(x+2)^2&=-4-x\\\\-x^2-4x-4&=-4-x\\\\x^2+3x&=0\\\\x(x+3)&=0\\\\x&=0,-3\\end{align*}$$\nSubstituting into $y=-4-x$ gives $(0,-4)$ and $(-3,-1)$. The parabola has vertex $(-2,0)$ and $y$-intercept $(0,-4)$; the line has $x$-intercept $(-4,0)$.",
          "solutionDiagrams": [
            {
              "id": "p19-q1-i-solution-graph",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"parabola\"},{\"name\":\"lineRed\",\"hex\":\"EF6068\",\"reason\":\"line\"}],\"reference\":\"p19 1(i)\"}\n\\begin{tikzpicture}[x=0.9cm,y=0.55cm]\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\\definecolor{curveBlue}{HTML}{268CFF}\\definecolor{lineRed}{HTML}{EF6068}\\draw[->,line width=0.5pt](-5.2,0)--(1.3,0)node[fill=white,inner sep=1pt,right]{$x$};\\draw[->,line width=0.5pt](0,-6.3)--(0,1.8)node[fill=white,inner sep=1pt,above]{$y$};\\draw[curveBlue,line width=0.8pt,domain=-4.4:0.4,samples=90]plot(\\x,{-(\\x+2)^2});\\draw[lineRed,line width=0.8pt](-5,1)--(1,-5);\\fill(-3,-1)circle(1.4pt)node[fill=white,inner sep=1pt,below left]{$(-3,-1)$};\\fill(0,-4)circle(1.4pt)node[fill=white,inner sep=1pt,right]{$(0,-4)$};\\fill(-2,0)circle(1.2pt)node[fill=white,inner sep=1pt,above]{$(-2,0)$};\\fill(-4,0)circle(1.2pt)node[fill=white,inner sep=1pt,above left]{$(-4,0)$};\\end{tikzpicture}",
