        "prompt": "$$\\int_{-1/3}^{1/3}\\sin^{-1}x\\,dx$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$\\sin^{-1}x$ is an odd function and the limits are symmetric about $0$, so\n$$\\int_{-1/3}^{1/3}\\sin^{-1}x\\,dx=0.$$",
