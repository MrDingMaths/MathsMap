  "content": {
    "id": "p41-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Explain why $y=x^2-2x+1$ has only one $x$-intercept.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "The discriminant is $0$, so there is one $x$-intercept.",
      "worked": "$$\\begin{align*}\\Delta&=b^2-4ac\\\\\\Delta&=(-2)^2-4(1)(1)\\\\\\Delta&=0\\end{align*}$$\nSince $\\Delta=0$, there is one repeated real root, so the parabola touches the $x$-axis at one point.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
