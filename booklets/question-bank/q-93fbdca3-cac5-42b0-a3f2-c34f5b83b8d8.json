  "content": {
    "id": "p41-n-response",
    "type": "question",
    "label": "n",
    "prompt": "Ms Harris sold a house for \\$462 000, making a 65% profit on the amount she paid for the house. How much profit did she make?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$182 000. The sale price represents 165%; the profit is $462\\,000\\div165\\times65$.",
      "worked": "The sale price represents $100\\%+65\\%=165\\%$ of the purchase price.\n$$\\begin{align*}165\\%&=\\$462\\,000\\\\1\\%&=\\frac{\\$462\\,000}{165}=\\$2\\,800\\\\65\\%&=\\$2\\,800\\times65=\\$182\\,000\\end{align*}$$\nShe made a profit of \\$182 000.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
