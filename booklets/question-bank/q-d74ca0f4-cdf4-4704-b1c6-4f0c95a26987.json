    "label": "6",
    "prompt": "Solve the simultaneous equations using the elimination method.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}3x+2y&=10\\\\3x-y&=7\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac83,\\ y=1$.",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(3x+2y)-(3x-y)&=10-7\\\\3y&=3\\\\y&=1\\end{align*}$$\nSubstitute into the second equation.\n$$\\begin{align*}3x-1&=7\\\\3x&=8\\\\x&=\\frac83\\end{align*}$$\nCheck: $3(\\frac83)+2(1)=10$ and $3(\\frac83)-1=7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p22-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}2x-y&=-3\\\\5x+y&=-11\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ y=-1$.",
          "worked": "Add the equations.\n$$\\begin{align*}(2x-y)+(5x+y)&=-3-11\\\\7x&=-14\\\\x&=-2\\end{align*}$$\nSubstitute into the first equation.\n$$\\begin{align*}2(-2)-y&=-3\\\\-y&=1\\\\y&=-1\\end{align*}$$\nCheck: $2(-2)-(-1)=-3$ and $5(-2)+(-1)=-11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p22-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}x-3y&=5\\\\-x+y&=-19\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=26,\\ y=7$.",
          "worked": "Add the equations.\n$$\\begin{align*}(x-3y)+(-x+y)&=5-19\\\\-2y&=-14\\\\y&=7\\end{align*}$$\nSubstitute into the first equation.\n$$\\begin{align*}x-3(7)&=5\\\\x-21&=5\\\\x&=26\\end{align*}$$\nCheck: $26-3(7)=5$ and $-26+7=-19$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
      {
        "id": "p22-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}3x-7y&=-17\\\\2x-7y&=-13\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4,\\ y=\\frac57$.",
          "worked": "Subtract the second equation from the first.\n$$\\begin{align*}(3x-7y)-(2x-7y)&=-17-(-13)\\\\x&=-4\\end{align*}$$\nSubstitute into the second equation.\n$$\\begin{align*}2(-4)-7y&=-13\\\\-8-7y&=-13\\\\-7y&=-5\\\\y&=\\frac57\\end{align*}$$\nCheck: $3(-4)-7(\\frac57)=-17$ and $2(-4)-7(\\frac57)=-13$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
