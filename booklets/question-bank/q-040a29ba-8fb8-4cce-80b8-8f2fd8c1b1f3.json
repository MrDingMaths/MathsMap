    "label": "5",
    "prompt": "If $p=4$, $q=-3$, $r=5$, work out the value of:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$pq+qr$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-27$",
          "worked": "$$\\begin{align*}pq+qr&=4(-3)+(-3)5\\\\pq+qr&=-12+(-15)\\\\pq+qr&=-27\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p39-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$pq-qr$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}pq-qr&=4(-3)-(-3)5\\\\pq-qr&=-12-(-15)\\\\pq-qr&=-12+15\\\\pq-qr&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p39-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$p^2+q^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25$",
          "worked": "$$\\begin{align*}p^2+q^2&=4^2+(-3)^2\\\\p^2+q^2&=16+9\\\\p^2+q^2&=25\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p39-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$(r-q)\\div(p-6)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-4$",
          "worked": "$$\\begin{align*}(r-q)\\div(p-6)&=[5-(-3)]\\div(4-6)\\\\(r-q)\\div(p-6)&=8\\div(-2)\\\\(r-q)\\div(p-6)&=-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
