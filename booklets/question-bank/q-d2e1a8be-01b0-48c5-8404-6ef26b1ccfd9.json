  "content": {
    "id": "p28-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A few years ago, Rahul and Fiona were interested in building a new garage, whose price is rising with inflation at $5\\%$ per annum. Its price then was $\\$12\\,000$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Explain why the cost $C$ in dollars is $C=12\\,000\\times1.05^n$, where $n$ is the years since.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The initial cost is $\\$12\\,000$. Each year it is multiplied by $1.05$, so after $n$ years, $C=12\\,000\\times1.05^n$.",
          "worked": "A $5\\%$ annual increase multiplies the previous year's cost by $1+0.05=1.05$. After one year the cost is $12\\,000\\times1.05$; after two years it is $12\\,000\\times1.05^2$. Continuing gives $C=12\\,000\\times1.05^n$ dollars after $n$ years.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p28-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Substitute into the formula to find, correct to the nearest $0.1$ years, how many years later the cost will be $\\$18\\,000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8.3$ years.",
          "worked": "$$\\begin{align*}18\\,000&=12\\,000\\times1.05^n\\\\1.05^n&=\\frac{18\\,000}{12\\,000}\\\\1.05^n&=1.5\\\\n&=\\log_{1.05}1.5\\\\n&=\\frac{\\log_{10}1.5}{\\log_{10}1.05}\\\\n&\\approx8.3\\text{ years}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
