  "content": {
    "id": "p9-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Use the fact that $\\left(\\frac{4}{9}\\right)^{\\frac{1}{2}}=\\sqrt{\\frac{4}{9}}=\\frac{2}{3}$ to evaluate the following:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\left(\\frac{16}{25}\\right)^{\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "$\\begin{align*}\\left(\\frac{16}{25}\\right)^{\\frac{1}{2}}&=\\sqrt{\\frac{16}{25}}\\\\&=\\frac{\\sqrt{16}}{\\sqrt{25}}\\\\&=\\frac{4}{5}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{9}{49}\\right)^{\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{7}$",
          "worked": "$\\begin{align*}\\left(\\frac{9}{49}\\right)^{\\frac{1}{2}}&=\\sqrt{\\frac{9}{49}}\\\\&=\\frac{\\sqrt{9}}{\\sqrt{49}}\\\\&=\\frac{3}{7}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{4}{81}\\right)^{\\frac{1}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{9}$",
          "worked": "$\\begin{align*}\\left(\\frac{4}{81}\\right)^{\\frac{1}{2}}&=\\sqrt{\\frac{4}{81}}\\\\&=\\frac{\\sqrt{4}}{\\sqrt{81}}\\\\&=\\frac{2}{9}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{8}{27}\\right)^{\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$\\begin{align*}\\left(\\frac{8}{27}\\right)^{\\frac{1}{3}}&=\\sqrt[3]{\\frac{8}{27}}\\\\&=\\frac{\\sqrt[3]{8}}{\\sqrt[3]{27}}\\\\&=\\frac{2}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac{64}{125}\\right)^{\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "$\\begin{align*}\\left(\\frac{64}{125}\\right)^{\\frac{1}{3}}&=\\sqrt[3]{\\frac{64}{125}}\\\\&=\\frac{\\sqrt[3]{64}}{\\sqrt[3]{125}}\\\\&=\\frac{4}{5}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{16}{81}\\right)^{\\frac{1}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$\\begin{align*}\\left(\\frac{16}{81}\\right)^{\\frac{1}{4}}&=\\sqrt[4]{\\frac{16}{81}}\\\\&=\\frac{\\sqrt[4]{16}}{\\sqrt[4]{81}}\\\\&=\\frac{2}{3}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\left(\\frac{256}{625}\\right)^{\\frac{1}{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "$\\begin{align*}\\left(\\frac{256}{625}\\right)^{\\frac{1}{4}}&=\\sqrt[4]{\\frac{256}{625}}\\\\&=\\frac{\\sqrt[4]{256}}{\\sqrt[4]{625}}\\\\&=\\frac{4}{5}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q16-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\left(\\frac{1000}{343}\\right)^{\\frac{1}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{7}$",
          "worked": "$\\begin{align*}\\left(\\frac{1000}{343}\\right)^{\\frac{1}{3}}&=\\sqrt[3]{\\frac{1000}{343}}\\\\&=\\frac{\\sqrt[3]{1000}}{\\sqrt[3]{343}}\\\\&=\\frac{10}{7}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
