  "content": {
    "id": "p2-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Write each expression as a single fraction.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p2-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{a}{5}-\\frac{2a}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{7a}{15}$",
          "worked": "$$\\begin{align*}\\frac{a}{5}-\\frac{2a}{3}&=\\frac{3a}{15}-\\frac{10a}{15}\\\\\\frac{a}{5}-\\frac{2a}{3}&=\\frac{3a-10a}{15}\\\\\\frac{a}{5}-\\frac{2a}{3}&=-\\frac{7a}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p2-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3x}{8}-\\frac{2x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{x}{40}$",
          "worked": "$$\\begin{align*}\\frac{3x}{8}-\\frac{2x}{5}&=\\frac{15x}{40}-\\frac{16x}{40}\\\\\\frac{3x}{8}-\\frac{2x}{5}&=\\frac{15x-16x}{40}\\\\\\frac{3x}{8}-\\frac{2x}{5}&=-\\frac{x}{40}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p2-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{a}{5}\\times\\frac{2a}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2a^2}{15}$",
          "worked": "$$\\begin{align*}\\frac{a}{5}\\times\\frac{2a}{3}&=\\frac{a\\times2a}{5\\times3}\\\\\\frac{a}{5}\\times\\frac{2a}{3}&=\\frac{2a^2}{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{a}{2b}\\times\\frac{2ab}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{a^2}{7}$",
          "worked": "$$\\begin{align*}\\frac{a}{2b}\\times\\frac{2ab}{7}&=\\frac{2a^2b}{14b}\\\\\\frac{a}{2b}\\times\\frac{2ab}{7}&=\\frac{a^2}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p2-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{3x}{4}\\div\\frac{6x}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{8}$",
          "worked": "$$\\begin{align*}\\frac{3x}{4}\\div\\frac{6x}{7}&=\\frac{3x}{4}\\times\\frac{7}{6x}\\\\\\frac{3x}{4}\\div\\frac{6x}{7}&=\\frac{21x}{24x}\\\\\\frac{3x}{4}\\div\\frac{6x}{7}&=\\frac{7}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p2-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{ab}{3}\\div\\frac{6b}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{ab}{18}$",
          "worked": "$$\\begin{align*}\\frac{ab}{3}\\div\\frac{6b}{b}&=\\frac{ab}{3}\\times\\frac{b}{6b}\\\\\\frac{ab}{3}\\div\\frac{6b}{b}&=\\frac{ab^2}{18b}\\\\\\frac{ab}{3}\\div\\frac{6b}{b}&=\\frac{ab}{18}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
