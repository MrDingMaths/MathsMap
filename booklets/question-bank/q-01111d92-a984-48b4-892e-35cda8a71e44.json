  "content": {
    "id": "p40-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Abbey worked for $n$ hours this week at \\$25 an hour and received an additional bonus of \\$100.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p40-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "Write an expression for her total pay this week.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25n+100$",
          "worked": "Hourly pay is $25n$ dollars. Including the bonus, total pay is $25n+100$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p40-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is her total pay if she worked 14 hours this week?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$450",
          "worked": "$$\\begin{align*}\\text{Total pay}&=25(14)+100\\\\\\text{Total pay}&=350+100\\\\\\text{Total pay}&=450\\end{align*}$$\nHer total pay is \\$450.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
