  "content": {
    "id": "p8-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Define the function $f(x)=x^2+x$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the secant that connects $P(1,f(1))$ to $Q(1+h,f(1+h))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h+3$",
          "worked": "$$\\begin{align*}f(1)&=2\\\\f(1+h)&=(1+h)^2+(1+h)\\\\f(1+h)&=h^2+3h+2\\\\m_{PQ}&=\\frac{h^2+3h+2-2}{h}\\\\m_{PQ}&=h+3\\qquad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the limit of the gradient as $h\\to0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\lim_{h\\to0}(h+3)=3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Describe the significance of this result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It is the gradient of the tangent at $x=1$.",
          "worked": "As $Q$ approaches $P(1,2)$, the secant approaches the tangent. The tangent to $y=x^2+x$ at $P$ therefore has gradient $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
    ]
  },
