        "prompt": "Complete the table.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=10$: $1440^{\\circ}$, $144^{\\circ}$; $n=100$: $17\\,640^{\\circ}$, $176.4^{\\circ}$; $n=1000$: $179\\,640^{\\circ}$, $179.64^{\\circ}$.",
          "worked": "$$\\begin{aligned}S&=180(10-2)=1440^{\\circ}\\\\I&=\\frac{1440}{10}=144^{\\circ}\\end{aligned}$$\n$$\\begin{aligned}S&=180(100-2)=17\\,640^{\\circ}\\\\I&=\\frac{17\\,640}{100}=176.4^{\\circ}\\end{aligned}$$\n$$\\begin{aligned}S&=180(1000-2)=179\\,640^{\\circ}\\\\I&=\\frac{179\\,640}{1000}=179.64^{\\circ}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "v2-165a9d-p5-practice-j9-213913-j9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "What do you notice about the size of each interior angle as $n$ increases?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "It increases and gets closer to $180^{\\circ}$.",
          "worked": "The interior angles are $144^{\\circ}$, $176.4^{\\circ}$ and $179.64^{\\circ}$. They increase and get closer to $180^{\\circ}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
