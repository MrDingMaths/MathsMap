  "content": {
    "id": "p20-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Rationalise the denominator and simplify:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{1}{\\sqrt3+\\sqrt2}+\\frac{2\\sqrt3-1}{2\\sqrt3-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5+5\\sqrt3-4\\sqrt2}{4}$\n\nMultiply each fraction by its denominator's conjugate, then combine.",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt3+\\sqrt2}&=\\frac{\\sqrt3-\\sqrt2}{3-2}\\\\\\frac{1}{\\sqrt3+\\sqrt2}&=\\sqrt3-\\sqrt2\\end{align*}$$\n$$\\begin{align*}\\frac{2\\sqrt3-1}{2\\sqrt3-2}&=\\frac{(2\\sqrt3-1)(2\\sqrt3+2)}{12-4}\\\\\\frac{2\\sqrt3-1}{2\\sqrt3-2}&=\\frac{10+2\\sqrt3}{8}\\\\\\frac{2\\sqrt3-1}{2\\sqrt3-2}&=\\frac{5+\\sqrt3}{4}\\end{align*}$$\n$$\\begin{align*}\\frac{1}{\\sqrt3+\\sqrt2}+\\frac{2\\sqrt3-1}{2\\sqrt3-2}&=\\sqrt3-\\sqrt2+\\frac{5+\\sqrt3}{4}\\\\\\frac{1}{\\sqrt3+\\sqrt2}+\\frac{2\\sqrt3-1}{2\\sqrt3-2}&=\\frac{5+5\\sqrt3-4\\sqrt2}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 65
      },
      {
        "id": "p20-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3}{2\\sqrt5+1}+\\frac{1}{\\sqrt5-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{37\\sqrt5+19\\sqrt2-9}{57}$\n\nRationalise both denominators before using a common denominator.",
          "worked": "$$\\begin{align*}\\frac{3}{2\\sqrt5+1}&=\\frac{3(2\\sqrt5-1)}{20-1}\\\\\\frac{3}{2\\sqrt5+1}&=\\frac{6\\sqrt5-3}{19}\\end{align*}$$\n$$\\begin{align*}\\frac{1}{\\sqrt5-\\sqrt2}&=\\frac{\\sqrt5+\\sqrt2}{5-2}\\\\\\frac{1}{\\sqrt5-\\sqrt2}&=\\frac{\\sqrt5+\\sqrt2}{3}\\end{align*}$$\n$$\\begin{align*}\\frac{3}{2\\sqrt5+1}+\\frac{1}{\\sqrt5-\\sqrt2}&=\\frac{3(6\\sqrt5-3)+19(\\sqrt5+\\sqrt2)}{57}\\\\\\frac{3}{2\\sqrt5+1}+\\frac{1}{\\sqrt5-\\sqrt2}&=\\frac{37\\sqrt5+19\\sqrt2-9}{57}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p20-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3\\sqrt2}{\\sqrt2+\\sqrt5}+\\frac{4\\sqrt2}{3\\sqrt2-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17\\sqrt{10}+4\\sqrt2-10}{17}$\n\nUse conjugates, simplify each fraction, then collect terms.",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt2}{\\sqrt2+\\sqrt5}&=\\frac{3\\sqrt2(\\sqrt2-\\sqrt5)}{2-5}\\\\\\frac{3\\sqrt2}{\\sqrt2+\\sqrt5}&=\\sqrt{10}-2\\end{align*}$$\n$$\\begin{align*}\\frac{4\\sqrt2}{3\\sqrt2-1}&=\\frac{4\\sqrt2(3\\sqrt2+1)}{18-1}\\\\\\frac{4\\sqrt2}{3\\sqrt2-1}&=\\frac{24+4\\sqrt2}{17}\\end{align*}$$\n$$\\begin{align*}\\frac{3\\sqrt2}{\\sqrt2+\\sqrt5}+\\frac{4\\sqrt2}{3\\sqrt2-1}&=\\sqrt{10}-2+\\frac{24+4\\sqrt2}{17}\\\\\\frac{3\\sqrt2}{\\sqrt2+\\sqrt5}+\\frac{4\\sqrt2}{3\\sqrt2-1}&=\\frac{17\\sqrt{10}+4\\sqrt2-10}{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p20-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{2\\sqrt5+\\sqrt3}-\\frac{4}{2\\sqrt5-\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{2(3\\sqrt3+2\\sqrt5)}{17}$",
          "worked": "$$\\begin{align*}\\frac{2}{2\\sqrt5+\\sqrt3}-\\frac{4}{2\\sqrt5-\\sqrt3}&=\\frac{2(2\\sqrt5-\\sqrt3)}{20-3}-\\frac{4(2\\sqrt5+\\sqrt3)}{20-3}\\\\\\frac{2}{2\\sqrt5+\\sqrt3}-\\frac{4}{2\\sqrt5-\\sqrt3}&=\\frac{4\\sqrt5-2\\sqrt3-8\\sqrt5-4\\sqrt3}{17}\\\\\\frac{2}{2\\sqrt5+\\sqrt3}-\\frac{4}{2\\sqrt5-\\sqrt3}&=-\\frac{2(3\\sqrt3+2\\sqrt5)}{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4}{2\\sqrt3+\\sqrt2}-\\frac{1}{2\\sqrt3-\\sqrt2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6\\sqrt3-5\\sqrt2}{10}$",
          "worked": "$$\\begin{align*}\\frac{4}{2\\sqrt3+\\sqrt2}-\\frac{1}{2\\sqrt3-\\sqrt2}&=\\frac{4(2\\sqrt3-\\sqrt2)}{12-2}-\\frac{2\\sqrt3+\\sqrt2}{12-2}\\\\\\frac{4}{2\\sqrt3+\\sqrt2}-\\frac{1}{2\\sqrt3-\\sqrt2}&=\\frac{8\\sqrt3-4\\sqrt2-2\\sqrt3-\\sqrt2}{10}\\\\\\frac{4}{2\\sqrt3+\\sqrt2}-\\frac{1}{2\\sqrt3-\\sqrt2}&=\\frac{6\\sqrt3-5\\sqrt2}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{\\sqrt2+\\sqrt3}{\\sqrt2-\\sqrt3}+\\frac{\\sqrt2-\\sqrt3}{\\sqrt2+\\sqrt3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-10$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt2+\\sqrt3}{\\sqrt2-\\sqrt3}+\\frac{\\sqrt2-\\sqrt3}{\\sqrt2+\\sqrt3}&=\\frac{(\\sqrt2+\\sqrt3)^2}{2-3}+\\frac{(\\sqrt2-\\sqrt3)^2}{2-3}\\\\\\frac{\\sqrt2+\\sqrt3}{\\sqrt2-\\sqrt3}+\\frac{\\sqrt2-\\sqrt3}{\\sqrt2+\\sqrt3}&=-(5+2\\sqrt6)-(5-2\\sqrt6)\\\\\\frac{\\sqrt2+\\sqrt3}{\\sqrt2-\\sqrt3}+\\frac{\\sqrt2-\\sqrt3}{\\sqrt2+\\sqrt3}&=-10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
