    "id": "p12-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If a coin is tossed 6 times, then how many different outcomes are there consisting of 2 heads and 4 tails?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$15$",
      "worked": "Count the arrangements of HHTTTT.\n$$\\begin{align*}N&=\\frac{6!}{2!4!}\\\\N&=15\\end{align*}$$",
