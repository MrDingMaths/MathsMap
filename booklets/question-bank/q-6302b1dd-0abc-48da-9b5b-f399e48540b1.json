  "content": {
    "id": "p33-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Find the term independent of $x$ in the expansion of $\\left(2x-\\frac{1}{x}\\right)^6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-160$",
      "worked": "$$\\begin{align*}T_k&=\\binom{6}{k}(2x)^{6-k}\\left(-\\frac{1}{x}\\right)^k\\\\T_k&=\\binom{6}{k}2^{6-k}(-1)^kx^{6-2k}\\end{align*}$$\nFor the term independent of $x$, $6-2k=0$, so $k=3$.\n$$\\begin{align*}T_3&=\\binom{6}{3}2^3(-1)^3\\\\T_3&=-160\\end{align*}$$",
      "solutionDiagrams": []
    },
