  "content": {
    "id": "p12-q8-node",
    "type": "question",
    "label": "8",
    "prompt": "Solve the following equations using natural logarithms where applicable. Express your solutions to 2 decimal places.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^x=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx3.32$",
          "worked": "$$\\begin{align*}\\ln(2^x)&=\\ln 10\\\\x\\ln 2&=\\ln 10\\\\x&=\\frac{\\ln 10}{\\ln 2}\\\\x&\\approx3.32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^{2x}=8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx0.65$",
          "worked": "$$\\begin{align*}\\ln(5^{2x})&=\\ln 8\\\\2x\\ln 5&=\\ln 8\\\\x&=\\frac{\\ln 8}{2\\ln 5}\\\\x&\\approx0.65\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p12-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$2^{-2x-1}=-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution.",
          "worked": "$2^{-2x-1}>0$ for every real $x$, so it cannot equal $-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p12-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$3^{3x-2}=15$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx1.49$",
          "worked": "$$\\begin{align*}\\ln(3^{3x-2})&=\\ln 15\\\\(3x-2)\\ln 3&=\\ln 15\\\\3x-2&=\\frac{\\ln 15}{\\ln 3}\\\\3x&=2+\\frac{\\ln 15}{\\ln 3}\\\\x&=\\frac{1}{3}\\left(2+\\frac{\\ln 15}{\\ln 3}\\right)\\\\x&\\approx1.49\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "$3e^{-5x}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx0.08$",
          "worked": "$$\\begin{align*}e^{-5x}&=\\frac{2}{3}\\\\\\ln(e^{-5x})&=\\ln\\left(\\frac{2}{3}\\right)\\\\-5x&=\\ln\\left(\\frac{2}{3}\\right)\\\\x&=-\\frac{1}{5}\\ln\\left(\\frac{2}{3}\\right)\\\\x&\\approx0.08\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "$3e^{2x}-2e^x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx-0.41$",
          "worked": "$$\\begin{align*}e^x(3e^x-2)&=0\\end{align*}$$\nSince $e^x>0$, the second factor must be zero.\n$$\\begin{align*}3e^x-2&=0\\\\e^x&=\\frac{2}{3}\\\\x&=\\ln\\left(\\frac{2}{3}\\right)\\\\x&\\approx-0.41\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p12-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "$e^{x+\\ln(4)}=3e^x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\approx0.69$",
          "worked": "$$\\begin{align*}e^xe^{\\ln(4)}&=3e^x+2\\\\4e^x&=3e^x+2\\\\e^x&=2\\\\x&=\\ln 2\\\\x&\\approx0.69\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p12-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "$e^{2x}+e^x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No real solution.",
          "worked": "$$\\begin{align*}e^{2x}+e^x&=e^x(e^x+1)\\end{align*}$$\nBoth factors are positive for every real $x$, so their product cannot be zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
