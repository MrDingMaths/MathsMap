  "content": {
    "id": "p29-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The price of gemfish has been rising. The price has risen by 10%, 15% and 35% in three successive years, and they now cost $\\$24$ per kg. Find the following prices, correct to the nearest cent:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the price one year ago",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$17.78$ per kg",
          "worked": "$$\\begin{align*}\\text{Price one year ago}&=24\\div1.35\\\\\\text{Price one year ago}&\\approx\\$17.78\\text{ per kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p29-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the price two years ago",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$15.46$ per kg",
          "worked": "$$\\begin{align*}\\text{Price two years ago}&=24\\div1.35\\div1.15\\\\\\text{Price two years ago}&\\approx\\$15.46\\text{ per kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p29-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "the original price three years ago",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$14.05$ per kg",
          "worked": "$$\\begin{align*}\\text{Original price}&=24\\div(1.35\\times1.15\\times1.10)\\\\\\text{Original price}&\\approx\\$14.05\\text{ per kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
