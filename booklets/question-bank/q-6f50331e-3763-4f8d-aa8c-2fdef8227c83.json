    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=\\pm4$",
      "worked": "$$\\begin{aligned}|\\underset{\\sim}{v}|&=\\sqrt{a^2+3^2}=5\\\\a^2+9&=25\\\\a^2&=16\\\\a&=\\pm4\\end{aligned}$$",
