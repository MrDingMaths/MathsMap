  "content": {
    "id": "p13-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Five-twelfths of the students in a particular school are girls. There are 1344 students in the school.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "How many girls are there in the school?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "560 girls.",
          "worked": "$$\\begin{align*}\\frac{5}{12}\\times1344&=5\\times112\\\\\\frac{5}{12}\\times1344&=560\\end{align*}$$\nThere are 560 girls.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "What fraction of the students in the school are boys?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{12}$",
          "worked": "$$1-\\frac{5}{12}=\\frac{7}{12}$$\nThe fraction of students who are boys is $\\frac{7}{12}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ]
