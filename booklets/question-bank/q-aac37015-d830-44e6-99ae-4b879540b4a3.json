  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Find all triangles with area $1$ and two sides of length $2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p21-q5-short-result",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Two isosceles triangles: sides ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "2,2",
                "display": false
              },
              {
                "type": "text",
                "text": " with included angle ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "30^\\circ",
                "display": false
              },
              {
                "type": "text",
                "text": " or ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "150^\\circ",
                "display": false
              },
              {
                "type": "text",
                "text": ".",
                "marks": []
              }
            ]
          },
          {
            "id": "p21-q5-short-method",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The area rule gives ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\sin C=\\frac12",
                "display": false
              },
              {
                "type": "text",
                "text": "; the acute angle and its supplement both satisfy it.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "Let $C$ be the angle between the two sides of length $2$.\n$$\\begin{align*}1&=\\frac12(2)(2)\\sin C\\\\1&=2\\sin C\\\\\\sin C&=\\frac12.\\end{align*}$$\nSince $0^\\circ<C<180^\\circ$, $C=30^\\circ$ or $C=150^\\circ$. Thus there are two isosceles triangles, each with sides $2,2$ and one of these included angles.",
      "solutionDiagrams": []
    },
