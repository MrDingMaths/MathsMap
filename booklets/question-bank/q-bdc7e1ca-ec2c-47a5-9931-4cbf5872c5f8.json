  "content": {
    "id": "p11-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each of the following expressions:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{\\cos3\\theta+\\cos\\theta}{\\sin3\\theta-\\sin\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\cos3\\theta+\\cos\\theta}{\\sin3\\theta-\\sin\\theta}&=\\frac{2\\cos2\\theta\\cos\\theta}{2\\cos2\\theta\\sin\\theta}\\\\\\frac{\\cos3\\theta+\\cos\\theta}{\\sin3\\theta-\\sin\\theta}&=\\frac{\\cos\\theta}{\\sin\\theta}\\\\\\frac{\\cos3\\theta+\\cos\\theta}{\\sin3\\theta-\\sin\\theta}&=\\cot\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{\\sin5\\theta-\\sin3\\theta}{\\sin5\\theta+\\sin3\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta\\cot4\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\sin5\\theta-\\sin3\\theta}{\\sin5\\theta+\\sin3\\theta}&=\\frac{2\\cos4\\theta\\sin\\theta}{2\\sin4\\theta\\cos\\theta}\\\\\\frac{\\sin5\\theta-\\sin3\\theta}{\\sin5\\theta+\\sin3\\theta}&=\\frac{\\sin\\theta}{\\cos\\theta}\\frac{\\cos4\\theta}{\\sin4\\theta}\\\\\\frac{\\sin5\\theta-\\sin3\\theta}{\\sin5\\theta+\\sin3\\theta}&=\\tan\\theta\\cot4\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\cos5\\theta-\\cos\\theta}{\\sin5\\theta-\\sin\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\tan3\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\cos5\\theta-\\cos\\theta}{\\sin5\\theta-\\sin\\theta}&=\\frac{-2\\sin3\\theta\\sin2\\theta}{2\\cos3\\theta\\sin2\\theta}\\\\\\frac{\\cos5\\theta-\\cos\\theta}{\\sin5\\theta-\\sin\\theta}&=-\\frac{\\sin3\\theta}{\\cos3\\theta}\\\\\\frac{\\cos5\\theta-\\cos\\theta}{\\sin5\\theta-\\sin\\theta}&=-\\tan3\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\cos6\\theta+\\cos2\\theta}{\\sin6\\theta+\\sin2\\theta}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cot4\\theta$",
          "worked": "$$\\begin{align*}\\frac{\\cos6\\theta+\\cos2\\theta}{\\sin6\\theta+\\sin2\\theta}&=\\frac{2\\cos4\\theta\\cos2\\theta}{2\\sin4\\theta\\cos2\\theta}\\\\\\frac{\\cos6\\theta+\\cos2\\theta}{\\sin6\\theta+\\sin2\\theta}&=\\frac{\\cos4\\theta}{\\sin4\\theta}\\\\\\frac{\\cos6\\theta+\\cos2\\theta}{\\sin6\\theta+\\sin2\\theta}&=\\cot4\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
