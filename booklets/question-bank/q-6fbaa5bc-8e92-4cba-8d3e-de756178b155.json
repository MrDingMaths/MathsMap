  "content": {
    "id": "p16-q9",
    "type": "question",
    "label": "11",
    "prompt": "Jakub cycles $1\\frac{3}{4}$ km on Monday, and $2\\frac{1}{8}$ km on Tuesday. How far does he cycle in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{31}{8}$ km",
      "worked": "$$\\begin{align*}1\\frac{3}{4}+2\\frac{1}{8}&=\\frac{7}{4}+\\frac{17}{8}\\\\&=\\frac{14}{8}+\\frac{17}{8}\\\\&=\\frac{31}{8}\\end{align*}$$\nJakub cycles $\\frac{31}{8}$ km in total.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
