    "children": [
      {
        "id": "p9-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the first term $a$ and the common difference $d$ of the AP $6,16,26,\\ldots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6,\\ d=10$",
          "worked": "$a=6$ and $d=16-6=10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p9-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the ninth term $a_9$, the 21st term $a_{21}$ and the 100th term $a_{100}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_9=86,\\ a_{21}=206,\\ a_{100}=996$",
          "worked": "$$\\begin{align*}a_9&=6+8(10)\\\\a_9&=86\\end{align*}$$\n$$\\begin{align*}a_{21}&=6+20(10)\\\\a_{21}&=206\\end{align*}$$\n$$\\begin{align*}a_{100}&=6+99(10)\\\\a_{100}&=996\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p9-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "Use the formula $a_n=a+(n-1)d$ to find a formula for the $n$th term $a_n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_n=10n-4$",
          "worked": "$$\\begin{align*}a_n&=a+(n-1)d\\\\a_n&=6+(n-1)(10)\\\\a_n&=6+10n-10\\\\a_n&=10n-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
