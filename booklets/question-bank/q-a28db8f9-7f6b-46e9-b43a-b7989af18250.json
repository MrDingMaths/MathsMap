  "content": {
    "id": "v2-p16-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "Find the area of the region bounded by the given curve and the $x$-axis.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-p16-practice-slot-2-s2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=(x-4)(x+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36\\text{ units}^2$",
          "worked": "$y=(x-4)(x+2)=x^2-2x-8$, with zeros at $x=-2$ and $x=4$. The curve is below the $x$-axis between them.\n$$\\begin{aligned}A&=-\\int_{-2}^{4}(x^2-2x-8)\\,dx\\\\&=-\\left[\\frac{x^3}{3}-x^2-8x\\right]_{-2}^{4}\\\\&=-\\left[\\left(\\frac{64}{3}-16-32\\right)-\\left(-\\frac83-4+16\\right)\\right]\\\\&=-\\left[-\\frac{80}{3}-\\frac{28}{3}\\right]\\\\&=36\\text{ units}^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "v2-p16-practice-slot-2-s2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=(3-x)(1+x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10\\dfrac{2}{3}\\text{ units}^2$",
          "worked": "$y=(3-x)(1+x)=3+2x-x^2$, with zeros at $x=-1$ and $x=3$. The curve is above the $x$-axis between them.\n$$\\begin{aligned}A&=\\int_{-1}^{3}(3+2x-x^2)\\,dx\\\\&=\\left[3x+x^2-\\frac{x^3}{3}\\right]_{-1}^{3}\\\\&=(9+9-9)-\\left(-3+1+\\frac13\\right)\\\\&=9+\\frac53\\\\&=\\frac{32}{3}=10\\frac23\\text{ units}^2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
  },
