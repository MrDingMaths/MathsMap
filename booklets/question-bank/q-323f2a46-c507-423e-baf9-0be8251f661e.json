          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "An electronics store is selling a sound system for ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\$1000",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "The manager wanted to make more money, so she increased the price by 100%.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "However, the manager realised no one was buying at the new price, so she decreased the price by 100%.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "She notices that now everyone is buying a sound system.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q21-a",
        "type": "part",
        "label": "a",
        "prompt": "How much is each customer paying?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$0$",
          "worked": "$$\\begin{align*}\\text{Final price}&=\\$1000\\times2\\times0\\\\\\text{Final price}&=\\$1000\\times0\\\\\\text{Final price}&=\\$0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q21-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why this is not the original price.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A 100% decrease removes the whole new price, making the sound system free.",
          "worked": "The increase doubles the price to $\\$2000$. The 100% decrease then removes all of this new price, leaving $\\$0$, rather than the original $\\$1000$. The changes apply to different amounts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q21-cd-instruction",
        "type": "group",
        "label": null,
        "prompt": "Calculate the results of these repeated percentage changes:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p11-q21-c",
            "type": "part",
            "label": "c",
            "prompt": "Increase $\\$280$ by 10% and then decrease the result by 10%.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$277.20$",
              "worked": "$$\\begin{align*}\\text{Final amount}&=\\$280\\times1.1\\times0.9\\\\\\text{Final amount}&=\\$280\\times0.99\\\\\\text{Final amount}&=\\$277.20\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p11-q21-d",
            "type": "part",
            "label": "d",
            "prompt": "Decrease $\\$1400$ by 5% and then increase the result by 5%.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\$1396.50$",
              "worked": "$$\\begin{align*}\\text{Final amount}&=\\$1400\\times0.95\\times1.05\\\\\\text{Final amount}&=\\$1400\\times0.9975\\\\\\text{Final amount}&=\\$1396.50\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
