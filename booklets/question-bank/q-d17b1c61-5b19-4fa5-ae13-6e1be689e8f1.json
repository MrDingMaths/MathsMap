        "id": "p13-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "A rectangle has area $x\\text{ cm}^2$ and width $2\\text{ cm}$. What is the perimeter of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)\\text{ cm}$",
          "worked": "Length = area ÷ width.\n\n$$l=\\frac{x}{2}\\text{ cm}$$\n\n$$\\begin{align*}P&=2\\left(\\frac{x}{2}+2\\right)\\\\P&=x+4\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p13-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "A rectangle has area $(x+3)\\text{ cm}^2$ and width $2\\text{ cm}$. What is the perimeter of the rectangle?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+7)\\text{ cm}$",
          "worked": "Length = area ÷ width.\n\n$$l=\\frac{x+3}{2}\\text{ cm}$$\n\n$$\\begin{align*}P&=2\\left(\\frac{x+3}{2}+2\\right)\\\\P&=x+3+4\\\\P&=x+7\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
