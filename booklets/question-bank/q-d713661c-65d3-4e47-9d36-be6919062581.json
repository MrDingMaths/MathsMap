  "content": {
    "id": "p14-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A field contains 40 white sheep and 50 black sheep. How many white sheep need to be removed so that $\\frac{1}{3}$ of the sheep are now white?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "15 white sheep",
      "worked": "Let $x$ be the number of white sheep removed. There are then $40-x$ white sheep and $90-x$ sheep altogether.\n$$\\begin{align*}40-x&=\\frac{1}{3}(90-x)\\\\120-3x&=90-x\\\\30&=2x\\\\x&=15\\end{align*}$$\nRemove 15 white sheep.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
