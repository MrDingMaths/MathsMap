  "content": {
    "id": "p15-q17-root",
    "type": "question",
    "label": "17",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p15-q17-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A bag contains one red, one blue and one white marble.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "One marble is chosen at random from the bag, and then ",
              "marks": []
            },
            {
              "type": "text",
              "text": "replaced",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " into the bag.",
              "marks": []
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "text": "A second marble is chosen.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q17-a",
        "type": "part",
        "label": "a",
        "prompt": "Draw a tree diagram of the situation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p15-q17-tree-solution",
        "answer": {
          "short": "Three first-draw branches, R, B and W; each has three second-draw branches, R, B and W.",
          "worked": "Let R, B and W denote red, blue and white. Replacement leaves the same three possibilities for the second draw after every first draw. The tree has $3\\times3=9$ complete paths.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p15-q17-b",
        "type": "part",
        "label": "b",
        "prompt": "List the outcomes to the right of the branches.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "sharedSolutionDiagramId": "p15-q17-tree-solution",
        "answer": {
          "short": "$RR,\\ RB,\\ RW,\\ BR,\\ BB,\\ BW,\\ WR,\\ WB,\\ WW$.",
          "worked": "Write each ordered outcome beside its terminal branch, with the first draw first: $RR, RB, RW, BR, BB, BW, WR, WB, WW$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p15-q17-c",
        "type": "group",
        "label": "c",
        "prompt": "Find the probability that:",
        "layout": "grid",
        "columns": 4,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q17-c-a",
            "type": "part",
            "label": "i",
            "prompt": "both marbles are red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{9}$",
              "worked": "Only $RR$ is favourable among the nine equally likely outcomes.\n$$P(\\text{both red})=\\frac{1}{9}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q17-c-b",
            "type": "part",
            "label": "ii",
            "prompt": "both marbles are the same colour",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "The favourable outcomes are $RR, BB, WW$.\n$$\\begin{aligned}P(\\text{same colour})&=\\frac{3}{9}\\\\&=\\frac{1}{3}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q17-c-c",
            "type": "part",
            "label": "iii",
            "prompt": "both marbles are different colours",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{3}$",
              "worked": "The favourable outcomes are $RB, RW, BR, BW, WR, WB$.\n$$\\begin{aligned}P(\\text{different colours})&=\\frac{6}{9}\\\\&=\\frac{2}{3}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 30
          },
          {
            "id": "p15-q17-c-d",
            "type": "part",
            "label": "iv",
            "prompt": "the first marble is red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{1}{3}$",
              "worked": "The favourable outcomes are $RR, RB, RW$.\n$$\\begin{aligned}P(\\text{first red})&=\\frac{3}{9}\\\\&=\\frac{1}{3}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q17-c-e",
            "type": "part",
            "label": "v",
            "prompt": "there is one blue and one white marble",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{2}{9}$",
              "worked": "Both orders count: $BW$ and $WB$.\n$$P(\\text{one blue and one white})=\\frac{2}{9}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p15-q17-c-f",
            "type": "part",
            "label": "vi",
            "prompt": "exactly one marble is red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{4}{9}$",
              "worked": "The favourable outcomes are $RB, RW, BR, WR$; $RR$ is excluded.\n$$P(\\text{exactly one red})=\\frac{4}{9}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q17-c-g",
            "type": "part",
            "label": "vii",
            "prompt": "at least one marble is red",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{5}{9}$",
              "worked": "The favourable outcomes are $RR, RB, RW, BR, WR$.\n$$P(\\text{at least one red})=\\frac{5}{9}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p15-q17-c-h",
            "type": "part",
            "label": "viii",
            "prompt": "no marbles are blue",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\frac{4}{9}$",
              "worked": "The favourable outcomes are $RR, RW, WR, WW$.\n$$P(\\text{no blue})=\\frac{4}{9}.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ],
