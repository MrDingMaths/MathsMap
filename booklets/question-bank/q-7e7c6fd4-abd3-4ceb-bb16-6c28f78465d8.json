  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A bag contains 10 marbles numbered 1 to 10. If a marble is taken out at random, what is the probability of getting:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "a 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "Only the marble numbered 3 is favourable. There are 10 equally likely outcomes.\n\n$$P(3)=\\frac{1}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "an even number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "The favourable outcomes are 2, 4, 6, 8 and 10.\n\n$$\\begin{align*}P(\\text{even})&=\\frac{5}{10}\\\\P(\\text{even})&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "a number greater than 2?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "The favourable outcomes are 3, 4, 5, 6, 7, 8, 9 and 10: eight outcomes.\n\n$$\\begin{align*}P(\\text{greater than }2)&=\\frac{8}{10}\\\\P(\\text{greater than }2)&=\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p10-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "a number divisible by 3?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "The favourable outcomes are 3, 6 and 9.\n\n$$P(\\text{divisible by }3)=\\frac{3}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "a number greater than 1?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{10}$",
          "worked": "The favourable outcomes are 2 through 10: nine outcomes.\n\n$$P(\\text{greater than }1)=\\frac{9}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
