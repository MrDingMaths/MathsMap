        "answer": {
          "short": "$y'=\\dfrac{2}{(x+1)^2}$.",
          "worked": "$$\\begin{aligned}y'&=\\dfrac{(x+1)-(x-1)}{(x+1)^2}\\\\y'&=\\dfrac{2}{(x+1)^2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
