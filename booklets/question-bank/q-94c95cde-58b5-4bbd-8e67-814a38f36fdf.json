  "content": {
    "id": "v2-82039-p24-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the exponential curve $y=-3(0.4)^{-x}$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-82039-p24-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Rewrite the equation in the form $y=k\\cdot a^x$, where $a>1$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-3\\left(\\frac52\\right)^x$",
          "worked": "$$\\begin{align*}y&=-3(0.4)^{-x}\\\\y&=-3\\left(\\frac25\\right)^{-x}\\\\y&=-3\\left(\\frac52\\right)^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-82039-p24-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Use your equation to find $y$ when $x=-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-\\frac{12}{25}$",
          "worked": "$$\\begin{align*}y&=-3\\left(\\frac52\\right)^{-2}\\\\y&=-3\\left(\\frac25\\right)^{2}\\\\y&=-3\\times\\frac{4}{25}\\\\y&=-\\frac{12}{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
