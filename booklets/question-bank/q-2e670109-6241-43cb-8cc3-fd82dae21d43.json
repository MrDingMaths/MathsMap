  "content": {
    "id": "v2-d2748-p15-practice-j17-034235-root",
    "type": "question",
    "label": null,
    "prompt": "An object moves according to $x=3e^{-0.5t}$, where $x$ is its displacement in metres and $t$ is time in seconds.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-d2748-p15-practice-j17-034235-j17-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find its velocity $v$ as a function of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v=-1.5e^{-0.5t}$",
          "worked": "$$\\begin{align*}v&=\\frac{dx}{dt}\\\\&=3(-0.5)e^{-0.5t}\\\\&=-1.5e^{-0.5t}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-d2748-p15-practice-j17-034235-j17-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find its displacement and velocity at $t=2$ seconds, correct to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(2)\\approx1.10\\text{ m}$; $v(2)\\approx-0.55\\text{ m/s}$.",
          "worked": "$$\\begin{align*}x(2)&=3e^{-1}\\\\&\\approx1.10\\text{ m}\\end{align*}$$\n$$\\begin{align*}v(2)&=-1.5e^{-1}\\\\&\\approx-0.55\\text{ m/s}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
