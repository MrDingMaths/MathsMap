  "content": {
    "id": "p22-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "The continuous PDF is defined by $f(x)=ax^2$ in the domain $[0,5]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Evaluate $a$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\dfrac{3}{125}$",
          "worked": "$$\\begin{align*}\\int_0^5 ax^2\\,dx&=1\\\\\\left[\\frac{ax^3}{3}\\right]_0^5&=1\\\\\\frac{125a}{3}&=1\\\\a&=\\frac{3}{125}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p22-q15-b",
        "type": "group",
        "label": "b",
        "prompt": "Find:",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p22-q15-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(X\\le 3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{27}{125}$",
              "worked": "$$\\begin{align*}P(X\\le3)&=\\int_0^3\\frac{3x^2}{125}\\,dx\\\\&=\\left[\\frac{x^3}{125}\\right]_0^3\\\\&=\\frac{27}{125}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p22-q15-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(1<X<4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{63}{125}$",
              "worked": "$$\\begin{align*}P(1<X<4)&=\\int_1^4\\frac{3x^2}{125}\\,dx\\\\&=\\left[\\frac{x^3}{125}\\right]_1^4\\\\&=\\frac{64-1}{125}\\\\&=\\frac{63}{125}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          },
          {
            "id": "p22-q15-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(X>2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\dfrac{117}{125}$",
              "worked": "$$\\begin{align*}P(X>2)&=\\int_2^5\\frac{3x^2}{125}\\,dx\\\\&=\\left[\\frac{x^3}{125}\\right]_2^5\\\\&=\\frac{125-8}{125}\\\\&=\\frac{117}{125}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 29
          }
        ]
      }
    ]
  },
