  "content": {
    "id": "p19-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Jonathon has 27 CDs and 60 DVDs in his collection. Write down the ratio of the number of CDs to the number of DVDs in his collection. Express your ratio in simplest form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$9:20$",
      "worked": "The highest common factor of $27$ and $60$ is $3$.\n\n$$\\begin{align*}\\text{CDs}:\\text{DVDs}&=27:60\\\\\\text{CDs}:\\text{DVDs}&=(27\\div3):(60\\div3)\\\\\\text{CDs}:\\text{DVDs}&=9:20\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 18
  },
