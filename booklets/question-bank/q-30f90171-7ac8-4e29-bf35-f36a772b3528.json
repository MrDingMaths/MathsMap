  "content": {
    "id": "p20-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "Find values of $a$ and $b$ such that $\\dfrac{x^2+ax+b}{x+3}=x-4$ for all valid $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-1,\\ b=-12$",
      "worked": "Multiply both sides by $x+3$.\n$$\\begin{align*}x^2+ax+b&=(x+3)(x-4)\\\\x^2+ax+b&=x^2-x-12\\end{align*}$$\nComparing coefficients gives $a=-1$ and $b=-12$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
