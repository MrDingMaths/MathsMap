  "content": {
    "id": "p51-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Calculate the scale factor for each of the following. Reminder to convert all units to the same.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "2 cm on a scale drawing represents an actual distance of 50 cm.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:25$",
          "worked": "$$\\begin{aligned}\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{2}{50}\\\\&=\\frac{1}{25}\\end{aligned}$$\nScale factor $=1:25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p51-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "4 cm on a scale drawing represents an actual distance of 2 km.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:50\\,000$",
          "worked": "$2\\text{ km}=200\\,000\\text{ cm}$.\n$$\\begin{aligned}\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{4}{200\\,000}\\\\&=\\frac{1}{50\\,000}\\end{aligned}$$\nScale factor $=1:50\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p51-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "1.2 cm on a scale drawing represents an actual distance of 0.6 km.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:50\\,000$",
          "worked": "$0.6\\text{ km}=60\\,000\\text{ cm}$.\n$$\\begin{aligned}\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{1.2}{60\\,000}\\\\&=\\frac{1}{50\\,000}\\end{aligned}$$\nScale factor $=1:50\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p51-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "5 cm on a scale drawing represents an actual distance of 900 m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:18\\,000$",
          "worked": "$900\\text{ m}=90\\,000\\text{ cm}$.\n$$\\begin{aligned}\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{5}{90\\,000}\\\\&=\\frac{1}{18\\,000}\\end{aligned}$$\nScale factor $=1:18\\,000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p51-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "An actual length of 7 mm is represented by 4.9 cm on a scaled drawing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7:1$",
          "worked": "$4.9\\text{ cm}=49\\text{ mm}$.\n$$\\begin{aligned}\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{49}{7}\\\\&=7\\end{aligned}$$\nScale factor $=7:1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p51-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "An actual length of 0.2 mm is represented by 12 cm on a scaled drawing.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$600:1$",
          "worked": "$12\\text{ cm}=120\\text{ mm}$.\n$$\\begin{aligned}\\text{Scale factor}&=\\frac{\\text{image}}{\\text{original}}\\\\&=\\frac{120}{0.2}\\\\&=600\\end{aligned}$$\nScale factor $=600:1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
