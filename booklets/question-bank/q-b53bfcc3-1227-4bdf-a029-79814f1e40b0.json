    "label": "12",
    "prompt": "Simplify\n$$\\frac{1}{n}+\\frac{(n+1)(n-1)}{n}-(n+1)$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-1$",
      "worked": "$$\\begin{aligned}\\frac{1}{n}+\\frac{(n+1)(n-1)}{n}-(n+1)&=\\frac{1+(n+1)(n-1)-n(n+1)}{n}\\\\&=\\frac{1+n^2-1-n^2-n}{n}\\\\&=\\frac{-n}{n}\\\\&=-1\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 44
  },
