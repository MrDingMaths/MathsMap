  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "If $h(x)=x^2-4$, find and simplify:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$h(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-4$",
          "worked": "$$h(a)=a^2-4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p13-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$h(y+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y^2+4y$",
          "worked": "$$\\begin{align*}h(y+2)&=(y+2)^2-4\\\\h(y+2)&=y^2+4y+4-4\\\\h(y+2)&=y^2+4y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p13-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$h(2b)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4b^2-4$",
          "worked": "$$\\begin{align*}h(2b)&=(2b)^2-4\\\\h(2b)&=4b^2-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$h(-3c-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9c^2+6c-3$",
          "worked": "$$\\begin{align*}h(-3c-1)&=(-3c-1)^2-4\\\\h(-3c-1)&=9c^2+6c+1-4\\\\h(-3c-1)&=9c^2+6c-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p13-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$h(x^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^4-4$",
          "worked": "$$\\begin{align*}h(x^2)&=(x^2)^2-4\\\\h(x^2)&=x^4-4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q6-f",
        "type": "part",
        "label": "f",
