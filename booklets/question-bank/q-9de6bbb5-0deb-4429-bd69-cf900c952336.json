  "content": {
    "id": "v2-6283f-p10-practice-slot-4-upper-root",
    "type": "question",
    "label": null,
    "prompt": "Find the exact value of $\\operatorname{cosec}\\theta-\\cot\\theta$, given $\\tan\\theta=2\\sqrt2$ and $\\theta$ is acute.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{\\sqrt2}$",
      "worked": "A reference triangle has opposite side $2\\sqrt2$ and adjacent side $1$.\n\n$$\\begin{align*}\\mathrm{Hyp}&=\\sqrt{(2\\sqrt2)^2+1^2}\\\\&=3\\\\\\operatorname{cosec}\\theta&=\\frac{\\mathrm{Hyp}}{\\mathrm{Opp}}=\\frac{3}{2\\sqrt2}\\\\\\cot\\theta&=\\frac{\\mathrm{Adj}}{\\mathrm{Opp}}=\\frac{1}{2\\sqrt2}\\\\\\operatorname{cosec}\\theta-\\cot\\theta&=\\frac{2}{2\\sqrt2}\\\\&=\\frac{1}{\\sqrt2}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
