      {
        "id": "v2-nr-p42-s1-slot-17-slot-17-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of $QR$ to 2 d.p.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.60\\text{ cm}$",
          "worked": "$$\\begin{align*}QR^2&=14^2+9^2-2(14)(9)\\cos62^\\circ\\\\QR&=\\sqrt{14^2+9^2-2(14)(9)\\cos62^\\circ}\\\\QR&\\approx12.60\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-nr-p42-s1-slot-17-slot-17-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the size of $\\angle PQR$ to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$39^\\circ$",
          "worked": "$$\\begin{align*}\\frac{\\sin Q}{9}&=\\frac{\\sin62^\\circ}{QR}\\\\\\sin Q&=\\frac{9\\sin62^\\circ}{\\sqrt{14^2+9^2-2(14)(9)\\cos62^\\circ}}\\\\\\angle PQR&=\\sin^{-1}\\left(\\frac{9\\sin62^\\circ}{\\sqrt{14^2+9^2-2(14)(9)\\cos62^\\circ}}\\right)\\\\\\angle PQR&\\approx39^\\circ\\end{align*}$$\n$PR$ is the shortest side, so $\\angle PQR$ is acute.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      }
    ]
  },
