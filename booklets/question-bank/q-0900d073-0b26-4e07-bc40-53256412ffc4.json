  "content": {
    "id": "p23-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "Three mangoes and two avocados cost $\\$18$, while three mangoes and five avocados cost $\\$27$. Find the price of each mango and avocado.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Each mango costs $\\$4$ and each avocado costs $\\$3$.",
      "worked": "Let $m$ and $a$ be the prices in dollars of one mango and one avocado.\n$$\\begin{align*}3m+2a&=18\\\\3m+5a&=27\\\\3a&=9\\\\a&=3\\\\3m+2(3)&=18\\\\3m&=12\\\\m&=4\\end{align*}$$\nEach mango costs $\\$4$ and each avocado costs $\\$3$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 76
  },
