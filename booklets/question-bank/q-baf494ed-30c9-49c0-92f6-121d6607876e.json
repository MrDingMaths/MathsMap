        "id": "p15-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve the equation $x^2+2x-3=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=1$.",
          "worked": "$$\\begin{align*}(x+3)(x-1)&=0\\\\x+3&=0\\quad\\text{or}\\quad x-1=0\\\\x&=-3\\quad\\text{or}\\quad x=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p15-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "How would you read the solution to the equation $x^2+2x-3=0$ from the graph?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Read the $x$-coordinates where the graph crosses the $x$-axis: $-3$ and $1$.",
          "worked": "On the $x$-axis, $y=0$, so the $x$-coordinates of the crossings solve $x^2+2x-3=0$. The crossings are $(-3,0)$ and $(1,0)$, giving $x=-3$ or $x=1$.",
          "solutionDiagrams": []
        },
