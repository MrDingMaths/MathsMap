    "type": "question",
    "label": "14",
    "prompt": "Three-sevenths of a sum of money is $\\$36$. How much is $\\frac{4}{7}$ of the sum of money?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$48$",
      "worked": "$$\\begin{align*}\\text{Whole sum}&=36\\div\\frac{3}{7}\\\\\\text{Whole sum}&=36\\times\\frac{7}{3}\\\\\\text{Whole sum}&=84\\\\\\text{Required amount}&=\\frac{4}{7}\\times84\\\\\\text{Required amount}&=48\\end{align*}$$\nThe required amount is $\\$48$.",
      "solutionDiagrams": []
    },
