  "content": {
    "id": "p25-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Sarah buys a car that depreciates at the rate of 20% per annum. After six years the car has a salvage value of $\\$6400$. How much did Sarah pay for the car, to the nearest dollar?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$24\\,414$",
      "worked": "$$\\begin{align*}S &= V_0(1-r)^n\\\\6400 &= V_0(1-0.20)^6\\\\V_0 &= \\frac{6400}{0.8^6}\\\\V_0 &= 24\\,414.0625\\end{align*}$$\nSarah paid $\\$24\\,414$ to the nearest dollar.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
