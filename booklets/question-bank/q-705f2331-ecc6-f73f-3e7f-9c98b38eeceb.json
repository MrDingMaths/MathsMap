  "content": {
    "id": "p47-q79-group-root",
    "type": "question",
    "label": "24",
    "prompt": "Given a set $X$, its $\\mathit{power\\ set}$, $\\mathcal P(X)$, is the set containing all subsets of $X$. Write down $\\mathcal P(X)$ for",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p47-q79-response",
        "type": "part",
        "label": "a",
        "prompt": "$$X=\\{p\\}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathcal P(X)=\\{\\varnothing,\\{p\\}\\}$",
          "worked": "The subsets are the empty set and $\\{p\\}$. Thus\n$$\\mathcal P(X)=\\{\\varnothing,\\{p\\}\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q80-response",
        "type": "part",
        "label": "b",
        "prompt": "$$X=\\{0,1\\}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathcal P(X)=\\{\\varnothing,\\{0\\},\\{1\\},\\{0,1\\}\\}$",
          "worked": "List the empty subset, the two singletons and the full set:\n$$\\mathcal P(X)=\\{\\varnothing,\\{0\\},\\{1\\},\\{0,1\\}\\}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p47-q81-response",
        "type": "part",
        "label": "c",
        "prompt": "$$X=\\{x,y,z\\}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\mathcal P(X)=\\{\\varnothing,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}\\}$.\n\nList subsets by size: $1+3+3+1=8$ subsets.",
          "worked": "List subsets with zero, one, two and three elements. Order within a subset does not matter.\n$$\\mathcal P(X)=\\bigl\\{\\varnothing,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}\\bigr\\}.$$\nThere are $1+3+3+1=8$ subsets.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p47-q82-response",
        "type": "part",
        "label": "d",
        "prompt": "$$X=\\{a,b,c,d\\}.$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$\\begin{aligned}\\mathcal P(X)=\\{&\\varnothing,\\\\&\\{a\\},\\{b\\},\\{c\\},\\{d\\},\\\\&\\{a,b\\},\\{a,c\\},\\{a,d\\},\\\\&\\{b,c\\},\\{b,d\\},\\{c,d\\},\\\\&\\{a,b,c\\},\\{a,b,d\\},\\\\&\\{a,c,d\\},\\{b,c,d\\},\\\\&\\{a,b,c,d\\}\\}.\\end{aligned}$$\n\nList subsets by size: $1+4+6+4+1=16$ subsets.",
          "worked": "List subsets with zero, one, two, three and four elements, counting each subset once:\n$$\\begin{aligned}\\mathcal P(X)=\\{&\\varnothing,\\\\&\\{a\\},\\{b\\},\\{c\\},\\{d\\},\\\\&\\{a,b\\},\\{a,c\\},\\{a,d\\},\\\\&\\{b,c\\},\\{b,d\\},\\{c,d\\},\\\\&\\{a,b,c\\},\\{a,b,d\\},\\\\&\\{a,c,d\\},\\{b,c,d\\},\\\\&\\{a,b,c,d\\}\\}.\\end{aligned}$$\nThe count is $1+4+6+4+1=16$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      }
    ]
  },
