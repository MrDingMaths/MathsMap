  "content": {
    "id": "p22-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Rearrange these equations to make $a$ the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$$ab+ac=3$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{3}{b+c}$",
          "worked": "$$\\begin{align*}a(b+c)&=3\\\\a&=\\frac{3}{b+c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$$3a+ay=x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{x}{3+y}$",
          "worked": "$$\\begin{align*}a(3+y)&=x\\\\a&=\\frac{x}{3+y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p22-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$$a(3+y)+2a=x$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{x}{5+y}$",
          "worked": "$$\\begin{align*}3a+ay+2a&=x\\\\a(5+y)&=x\\\\a&=\\frac{x}{5+y}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$$2a=x+ak$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{x}{2-k}$",
          "worked": "$$\\begin{align*}2a-ak&=x\\\\a(2-k)&=x\\\\a&=\\frac{x}{2-k}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$$ay+k=3a$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-\\frac{k}{y-3}$",
          "worked": "$$\\begin{align*}ay-3a&=-k\\\\a(y-3)&=-k\\\\a&=-\\frac{k}{y-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$$ay-x=ab$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{x}{y-b}$",
          "worked": "$$\\begin{align*}ay-ab&=x\\\\a(y-b)&=x\\\\a&=\\frac{x}{y-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$$ay+b=3b+ax$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{2b}{y-x}$",
          "worked": "$$\\begin{align*}ay-ax&=2b\\\\a(y-x)&=2b\\\\a&=\\frac{2b}{y-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p22-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "$$m(a+y)=x(a+b)$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{bx-my}{m-x}$",
          "worked": "$$\\begin{align*}ma+my&=ax+bx\\\\ma-ax&=bx-my\\\\a(m-x)&=bx-my\\\\a&=\\frac{bx-my}{m-x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p22-q4-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{y-a}{x+a}=b$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{y-bx}{1+b}$",
          "worked": "$$\\begin{align*}y-a&=b(x+a)\\\\y-a&=bx+ba\\\\a+ba&=y-bx\\\\a(1+b)&=y-bx\\\\a&=\\frac{y-bx}{1+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q4-j",
        "type": "part",
        "label": "j",
        "prompt": "$$a-n=\\frac{a+2}{n}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{n^2+2}{n-1}$",
          "worked": "$$\\begin{align*}n(a-n)&=a+2\\\\na-n^2&=a+2\\\\na-a&=n^2+2\\\\a(n-1)&=n^2+2\\\\a&=\\frac{n^2+2}{n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q4-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\sqrt{\\frac{a+x}{a-x}}=2$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{5x}{3}$",
          "worked": "$$\\begin{align*}\\frac{a+x}{a-x}&=4\\\\a+x&=4(a-x)\\\\a+x&=4a-4x\\\\3a&=5x\\\\a&=\\frac{5x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p22-q4-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\sqrt{\\frac{m(a+n)}{a}}=p$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=\\frac{-mn}{m-p^2}$",
          "worked": "$$\\begin{align*}\\frac{m(a+n)}{a}&=p^2\\\\m(a+n)&=ap^2\\\\ma+mn&=ap^2\\\\ma-ap^2&=-mn\\\\a(m-p^2)&=-mn\\\\a&=\\frac{-mn}{m-p^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
