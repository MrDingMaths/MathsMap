  "content": {
    "id": "p15-q37-root",
    "type": "question",
    "label": null,
    "prompt": "Given $f(x)=4x+1$, find the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q37-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(2a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8a+1$",
          "worked": "$$\\begin{align*}f(2a)&=4(2a)+1\\\\f(2a)&=8a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q37-b",
        "type": "part",
        "label": "b",
        "prompt": "$2f(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8a+2$",
          "worked": "$$\\begin{align*}2f(a)&=2(4a+1)\\\\2f(a)&=8a+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q37-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(a^2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2+1$",
          "worked": "$$\\begin{align*}f(a^2)&=4(a^2)+1\\\\f(a^2)&=4a^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p15-q37-d",
        "type": "part",
        "label": "d",
        "prompt": "$(f(a))^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4a+1)^2=16a^2+8a+1$",
          "worked": "$$\\begin{align*}(f(a))^2&=(4a+1)^2\\\\(f(a))^2&=16a^2+2(4a)(1)+1\\\\(f(a))^2&=16a^2+8a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
