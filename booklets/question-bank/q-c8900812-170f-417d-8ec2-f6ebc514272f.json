    "children": [
      {
        "id": "p4-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3}{4}(a+2)+\\frac{1}{2}(a-1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{4}a+1$",
          "worked": "$$\\begin{align*}\\frac{3}{4}(a+2)+\\frac{1}{2}(a-1)&=\\frac{3}{4}a+\\frac{3}{2}+\\frac{1}{2}a-\\frac{1}{2}\\\\&=\\left(\\frac{3}{4}+\\frac{2}{4}\\right)a+1\\\\&=\\frac{5}{4}a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$5\\left(\\frac{b}{3}+\\frac{1}{6}\\right)-3\\left(\\frac{b}{6}-\\frac{1}{2}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{6}b+\\frac{7}{3}$",
          "worked": "$$\\begin{align*}5\\left(\\frac{b}{3}+\\frac{1}{6}\\right)-3\\left(\\frac{b}{6}-\\frac{1}{2}\\right)&=\\frac{5b}{3}+\\frac{5}{6}-\\frac{b}{2}+\\frac{3}{2}\\\\&=\\frac{10b-3b}{6}+\\frac{5+9}{6}\\\\&=\\frac{7}{6}b+\\frac{7}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2}{3}x(x+5)+\\frac{1}{4}x(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{12}x^2+\\frac{31}{12}x$",
          "worked": "$$\\begin{align*}\\frac{2}{3}x(x+5)+\\frac{1}{4}x(x-3)&=\\frac{2}{3}x^2+\\frac{10}{3}x+\\frac{1}{4}x^2-\\frac{3}{4}x\\\\&=\\frac{8+3}{12}x^2+\\frac{40-9}{12}x\\\\&=\\frac{11}{12}x^2+\\frac{31}{12}x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{2}{5}y\\left(\\frac{3}{4}y-1\\right)-\\frac{1}{2}y\\left(2y-\\frac{3}{5}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{7}{10}y^2-\\frac{1}{10}y$",
          "worked": "$$\\begin{align*}\\frac{2}{5}y\\left(\\frac{3}{4}y-1\\right)-\\frac{1}{2}y\\left(2y-\\frac{3}{5}\\right)&=\\frac{3}{10}y^2-\\frac{2}{5}y-y^2+\\frac{3}{10}y\\\\&=\\left(\\frac{3}{10}-1\\right)y^2+\\left(-\\frac{4}{10}+\\frac{3}{10}\\right)y\\\\&=-\\frac{7}{10}y^2-\\frac{1}{10}y\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\left(\\frac{2}{3}x+1\\right)\\left(x+\\frac{1}{4}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}x^2+\\frac{7}{6}x+\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\left(\\frac{2}{3}x+1\\right)\\left(x+\\frac{1}{4}\\right)&=\\frac{2}{3}x^2+\\frac{1}{6}x+x+\\frac{1}{4}\\\\&=\\frac{2}{3}x^2+\\left(\\frac{1}{6}+1\\right)x+\\frac{1}{4}\\\\&=\\frac{2}{3}x^2+\\frac{7}{6}x+\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p4-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\left(\\frac{2}{3}y+3\\right)\\left(\\frac{5}{6}y+2\\right)-\\left(y-\\frac{1}{4}\\right)\\left(y+\\frac{1}{3}\\right)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{4}{9}y^2+\\frac{15}{4}y+\\frac{73}{12}$",
          "worked": "$$\\begin{align*}\\left(\\frac{2}{3}y+3\\right)\\left(\\frac{5}{6}y+2\\right)-\\left(y-\\frac{1}{4}\\right)\\left(y+\\frac{1}{3}\\right)&=\\frac{5}{9}y^2+\\frac{4}{3}y+\\frac{5}{2}y+6\\\\&\\quad-\\left(y^2+\\frac{1}{3}y-\\frac{1}{4}y-\\frac{1}{12}\\right)\\\\&=\\left(\\frac{5}{9}-1\\right)y^2\\\\&\\quad+\\left(\\frac{4}{3}+\\frac{5}{2}-\\frac{1}{3}+\\frac{1}{4}\\right)y+6+\\frac{1}{12}\\\\&=-\\frac{4}{9}y^2+\\frac{15}{4}y+\\frac{73}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      }
