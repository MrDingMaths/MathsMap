      {
        "id": "p19-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that the area, $A\\text{ cm}^2$, of a rectangle of perimeter $20\\text{ cm}$ is given by the formula $A=w(10-w)$, where $w\\text{ cm}$ is the width.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\ell=10-w$, so $A=w\\ell=w(10-w)$.",
          "worked": "Let the length be $\\ell\\text{ cm}$.\n\n$$\\begin{align*}2\\ell+2w&=20\\\\\\ell+w&=10\\\\\\ell&=10-w\\\\A&=w\\ell\\\\A&=w(10-w).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p19-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Complete the square for the quadratic expression $10w-w^2$ and hence show $A\\leq25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$A=25-(w-5)^2\\leq25$, since $(w-5)^2\\geq0$.",
          "worked": "$$\\begin{align*}A&=10w-w^2\\\\A&=-(w^2-10w+25)+25\\\\A&=25-(w-5)^2.\\end{align*}$$\n\nSince $(w-5)^2\\geq0$, $A\\leq25$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p19-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "What value of $w$ makes the area equal to $25\\text{ cm}^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=5\\text{ cm}$.",
          "worked": "For the rectangle in part a, $A=25-(w-5)^2$. For $A=25\\text{ cm}^2$:\n\n$$\\begin{align*}25-(w-5)^2&=25\\\\(w-5)^2&=0\\\\w&=5.\\end{align*}$$\n\nThe width is $5\\text{ cm}$; the length is also $5\\text{ cm}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p19-q3-d",
        "type": "part",
        "label": "d",
        "prompt": {
