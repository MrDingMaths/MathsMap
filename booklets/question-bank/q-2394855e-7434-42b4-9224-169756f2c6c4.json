  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The sum of a number and its reciprocal is $\\frac{34}{15}$. Find the number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=\\frac53$ or $x=\\frac35$.",
      "worked": "Let $x$ be the number, where $x\\ne0$.\n$$\\begin{align*}x+\\frac1x&=\\frac{34}{15}\\\\15x^2+15&=34x\\\\15x^2-34x+15&=0\\\\(3x-5)(5x-3)&=0\\\\x&=\\frac53\\text{ or }\\frac35\\end{align*}$$\nBoth values satisfy the original equation.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
