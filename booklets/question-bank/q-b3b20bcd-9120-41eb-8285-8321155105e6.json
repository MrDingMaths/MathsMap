  "content": {
    "id": "p51-q84-root",
    "type": "question",
    "label": null,
    "prompt": "Let $f(x)=x^2+px+1$ such that $f(-1)=f(7)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q84-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $p$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=-6$.",
          "worked": "$$\\begin{align*}f(-1)&=(-1)^2+p(-1)+1\\\\f(7)&=7^2+7p+1\\end{align*}$$\nUsing $f(-1)=f(7)$,\n$$\\begin{align*}2-p&=50+7p\\\\8p&=-48\\\\p&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p51-q84-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, find the value of $f(-1)$ and $f(7)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-1)=f(7)=8$.",
          "worked": "With $p=-6$,\n$$\\begin{align*}f(-1)&=(-1)^2-6(-1)+1\\\\f(-1)&=8\\end{align*}$$\nThe given equality therefore gives $f(7)=8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
