        {
          "id": "p98-charles-law-definition",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 1,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "Charles’ Law",
              "marks": [
                "italic"
              ]
            },
            {
              "type": "text",
              "text": " states that the volume of a given mass of gas varies directly with the temperature, measured in Kelvins (K), at constant pressure.",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p98-charles-law-a",
        "type": "part",
        "label": "a",
        "prompt": "A gas occupies $2.5\\text{ L}$ at $300\\text{ K}$. What volume will it occupy at $400\\text{ K}$, assuming pressure is constant?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{10}{3}\\text{ L}\\approx3.33\\text{ L}$",
          "worked": "Let $V$ be the volume in litres and $T$ the temperature in kelvins. Charles’ Law gives\n$$\\begin{align*}V&=kT\\\\2.5&=300k\\\\k&=\\frac{1}{120}.\\end{align*}$$\nAt $400\\text{ K}$,\n$$\\begin{align*}V&=\\frac{1}{120}\\times400\\\\V&=\\frac{10}{3}\\text{ L}\\\\V&\\approx3.33\\text{ L}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p98-charles-law-b",
        "type": "part",
        "label": "b",
        "prompt": "A gas expands from $4.0\\text{ L}$ to $6.0\\text{ L}$ as the temperature increases from $250\\text{ K}$. Find the final temperature.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$375\\text{ K}$",
          "worked": "Let $V$ be the volume in litres and $T$ the temperature in kelvins. Charles’ Law gives\n$$\\begin{align*}V&=kT\\\\4.0&=250k\\\\k&=\\frac{2}{125}.\\end{align*}$$\nFor a volume of $6.0\\text{ L}$,\n$$\\begin{align*}6.0&=\\frac{2}{125}T\\\\T&=\\frac{6.0\\times125}{2}\\\\T&=375\\text{ K}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p98-charles-law-c",
        "type": "part",
        "label": "c",
        "prompt": "A gas sample has a volume of $7.0\\text{ L}$ at $300\\text{ K}$. At what temperature will the volume expand to $9.5\\text{ L}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2850}{7}\\text{ K}\\approx407.14\\text{ K}$",
          "worked": "Let $V$ be the volume in litres and $T$ the temperature in kelvins. Charles’ Law gives\n$$\\begin{align*}V&=kT\\\\7.0&=300k\\\\k&=\\frac{7}{300}.\\end{align*}$$\nFor a volume of $9.5\\text{ L}$,\n$$\\begin{align*}9.5&=\\frac{7}{300}T\\\\T&=\\frac{9.5\\times300}{7}\\\\T&=\\frac{2850}{7}\\text{ K}\\\\T&\\approx407.14\\text{ K}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
