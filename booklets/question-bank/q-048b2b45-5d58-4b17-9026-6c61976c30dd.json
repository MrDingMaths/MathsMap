  "content": {
    "id": "v2-7eec2e848-practice-j3-084451-root",
    "type": "question",
    "label": null,
    "prompt": "Show that $f(x)=\\dfrac{3^{2x}+1}{3^x}$ is even.\n\nThe first line of the proof is\n$$f(-x)=\\frac{3^{-2x}+1}{3^{-x}}$$",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-7eec2e848-practice-j3-084451-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Simplify $f(-x)$ by splitting it into two fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(-x)=3^{-x}+3^x$",
          "worked": "$$\\begin{align*}f(-x)&=\\frac{3^{-2x}+1}{3^{-x}}\\\\&=\\frac{3^{-2x}}{3^{-x}}+\\frac{1}{3^{-x}}\\\\&=3^{-x}+3^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-7eec2e848-practice-j3-084451-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that $f(-x)=f(x)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(x)=3^x+3^{-x}=f(-x)$, so $f$ is even.",
          "worked": "$$\\begin{align*}f(x)&=\\frac{3^{2x}+1}{3^x}\\\\&=\\frac{3^{2x}}{3^x}+\\frac{1}{3^x}\\\\&=3^x+3^{-x}\\\\&=f(-x)\\end{align*}$$\nTherefore $f$ is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
