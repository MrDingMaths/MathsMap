t=-2pt,font=\\fontsize{8.5}{10}\\selectfont,inner sep=0pt] at (2,0) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$2$\\special{dvisvgm:raw </g>}};\n\\node[anchor=west,xshift=2pt,font=\\fontsize{8.5}{10}\\selectfont,inner sep=0pt] at (0,1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$1$\\special{dvisvgm:raw </g>}};\n\\node[anchor=east,xshift=-2pt,font=\\fontsize{8.5}{10}\\selectfont,inner sep=0pt] at (0,-1) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$-1$\\special{dvisvgm:raw </g>}};\n\\draw[black,line width=0.4pt] (-2,0)--(-3.4,-0.95);\n\\node at (-4.15,-1.35) {$(-2,0)$};\n\\draw[black,line width=0.4pt] (0,-1)--(3.8,-2.1);\n\\node at (5,-2.5) {$(0,-1)$};\n\\draw[black,line width=0.4pt] (-1,{-1/3})--(-2.55,-2.9)--(-3.2,-3.15);\n\\node[anchor=north,yshift=-2pt] at (-3.2,-3.15) {$\\left(-1,-\\frac13\\right)$};\n\\filldraw[fill=white,draw=functionBlue,line width=0.8pt] (-1,{-1/3}) circle[radius=1.9pt];\n\\end{tikzpicture}",
