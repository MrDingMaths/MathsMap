  "content": {
    "id": "p59-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Decide whether you are finding the selling price or calculating the percentage change.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p59-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Xavier purchased materials for \\$48 and made a dog kennel.\nLater, he sold the kennel for \\$84.\nCalculate the percentage profit or loss.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Percentage change: 75% profit.",
          "worked": "Calculate the percentage change.\n$$\\begin{align*}\\text{Profit/loss}&=\\$84-\\$48\\\\\\text{Profit/loss}&=\\$36\\\\\\text{Percentage profit}&=\\frac{36}{48}\\times100\\\\\\text{Percentage profit}&=75\\%\\end{align*}$$\nThe change is positive, so this is a 75% profit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p59-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Jemma purchased a \\$400 foal.\nHow much should she sell it for if she wants to make a 30% profit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Selling price: \\$520.",
          "worked": "Find the selling price.\n$$\\begin{align*}\\text{Selling price}&=\\$400\\times1.30\\\\\\text{Selling price}&=\\$520\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p59-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Lee purchased a \\$5000 car, which she later sold for \\$2800.\nCalculate the percentage profit or loss.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Percentage change: 44% loss.",
          "worked": "Calculate the percentage change.\n$$\\begin{align*}\\text{Profit/loss}&=\\$2800-\\$5000\\\\\\text{Profit/loss}&=-\\$2200\\\\\\text{Percentage profit/loss}&=\\frac{-2200}{5000}\\times100\\\\\\text{Percentage profit/loss}&=-44\\%\\end{align*}$$\nThe change is negative, so this is a 44% loss.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p59-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Estelle purchased a piece of sporting equipment for \\$120.\nShe sold it for a loss of 35%. How much did she sell it for?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Selling price: \\$78.",
          "worked": "Find the selling price.\n$$\\begin{align*}\\text{Selling price}&=\\$120\\times0.65\\\\\\text{Selling price}&=\\$78\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p59-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "Helen creates bracelets using materials costing \\$0.80 and sell them for \\$10 each.\nCalculate the percentage profit or loss.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Percentage change: 1150% profit.",
          "worked": "Calculate the percentage change.\n$$\\begin{align*}\\text{Profit/loss}&=\\$10-\\$0.80\\\\\\text{Profit/loss}&=\\$9.20\\\\\\text{Percentage profit}&=\\frac{9.20}{0.80}\\times100\\\\\\text{Percentage profit}&=1150\\%\\end{align*}$$\nThe change is positive, so this is a 1150% profit.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p59-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "Charlotte wants to sell her knitted squares for a 250% profit.\nIf the squares cost her \\$1.30 to make in materials, how much should she sell them for?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Selling price: \\$4.55.",
          "worked": "Find the selling price. A 250% profit gives a selling price of 350% of the cost price.\n$$\\begin{align*}\\text{Selling price}&=\\$1.30\\times3.50\\\\\\text{Selling price}&=\\$4.55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
