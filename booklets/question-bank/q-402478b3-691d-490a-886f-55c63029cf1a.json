  "content": {
    "id": "p46-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Show the working out to evaluate the following. Check your answer using a calculator.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p46-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$(6\\times6)\\div3^2-1+11^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$124$",
          "worked": "$$\\begin{align*}(6\\times6)\\div3^2-1+11^2&=36\\div3^2-1+11^2\\\\&=36\\div9-1+121\\\\&=4-1+121\\\\&=3+121\\\\&=124\\end{align*}$$\nCalculator check: $124$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p46-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$10+\\left((10-4)\\times(2^3-6)\\right)^2\\div2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84$",
          "worked": "$$\\begin{align*}10+\\left((10-4)\\times(2^3-6)\\right)^2\\div2+2&=10+(6\\times(8-6))^2\\div2+2\\\\&=10+(6\\times2)^2\\div2+2\\\\&=10+12^2\\div2+2\\\\&=10+144\\div2+2\\\\&=10+72+2\\\\&=82+2\\\\&=84\\end{align*}$$\nCalculator check: $84$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p46-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{\\left(12\\times2^2-(4^2-4)\\right)}\\times3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18$",
          "worked": "$$\\begin{align*}\\sqrt{\\left(12\\times2^2-(4^2-4)\\right)}\\times3&=\\sqrt{12\\times4-(16-4)}\\times3\\\\&=\\sqrt{12\\times4-12}\\times3\\\\&=\\sqrt{48-12}\\times3\\\\&=\\sqrt{36}\\times3\\\\&=6\\times3\\\\&=18\\end{align*}$$\nCalculator check: $18$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 47
      },
      {
        "id": "p46-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{\\frac{2+4^2}{8-2\\times3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{2+4^2}{8-2\\times3}}&=\\sqrt{\\frac{2+16}{8-2\\times3}}\\\\&=\\sqrt{\\frac{18}{8-6}}\\\\&=\\sqrt{\\frac{18}{2}}\\\\&=\\sqrt9\\\\&=3\\end{align*}$$\nCalculator check: $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p46-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{\\left((5^2-17)+(6^2-7)+2\\right)\\div3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{13}$",
          "worked": "$$\\begin{align*}\\sqrt{\\left((5^2-17)+(6^2-7)+2\\right)\\div3}&=\\sqrt{((25-17)+(36-7)+2)\\div3}\\\\&=\\sqrt{(8+29+2)\\div3}\\\\&=\\sqrt{(37+2)\\div3}\\\\&=\\sqrt{39\\div3}\\\\&=\\sqrt{13}\\end{align*}$$\nCalculator check: $\\sqrt{13}\\approx3.605551275$. The exact answer is $\\sqrt{13}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p46-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{\\frac{\\left(45\\div(30-5\\times3)\\right)^3\\times\\sqrt{4+5}}{(-3)^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{\\left(45\\div(30-5\\times3)\\right)^3\\times\\sqrt{4+5}}{(-3)^2}}&=\\sqrt{\\frac{(45\\div(30-15))^3\\times\\sqrt{4+5}}{(-3)^2}}\\\\&=\\sqrt{\\frac{(45\\div15)^3\\times\\sqrt{4+5}}{(-3)^2}}\\\\&=\\sqrt{\\frac{3^3\\times\\sqrt{4+5}}{(-3)^2}}\\\\&=\\sqrt{\\frac{3^3\\times\\sqrt9}{(-3)^2}}\\\\&=\\sqrt{\\frac{27\\times3}{9}}\\\\&=\\sqrt{\\frac{81}{9}}\\\\&=\\sqrt9\\\\&=3\\end{align*}$$\nCalculator check: $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 83
      }
    ]
  },
