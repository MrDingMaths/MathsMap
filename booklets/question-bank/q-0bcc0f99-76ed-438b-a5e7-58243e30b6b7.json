  "content": {
    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the angle between the vectors, correct to the nearest degree.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}-3\\\\4\\end{pmatrix}$ and $\\underset{\\sim}{v}=\\begin{pmatrix}-5\\\\12\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14^\\circ$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=(-3)(-5)+4(12)=63\\\\|\\underset{\\sim}{u}|&=\\sqrt{(-3)^2+4^2}=5\\\\|\\underset{\\sim}{v}|&=\\sqrt{(-5)^2+12^2}=13\\\\\\cos\\theta&=\\frac{63}{5\\times13}=\\frac{63}{65}\\\\\\theta&=\\cos^{-1}\\!\\left(\\frac{63}{65}\\right)\\\\&\\approx14^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}1\\\\-2\\end{pmatrix}$ and $\\underset{\\sim}{v}=\\begin{pmatrix}-3\\\\1\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$135^\\circ$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=1(-3)+(-2)(1)=-5\\\\|\\underset{\\sim}{u}|&=\\sqrt{1^2+(-2)^2}=\\sqrt5\\\\|\\underset{\\sim}{v}|&=\\sqrt{(-3)^2+1^2}=\\sqrt{10}\\\\\\cos\\theta&=\\frac{-5}{\\sqrt5\\times\\sqrt{10}}\\\\&=-\\frac5{\\sqrt{50}}=-\\frac1{\\sqrt2}\\\\\\theta&=135^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p8-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{u}=\\begin{pmatrix}6\\\\-3\\end{pmatrix}$ and $\\underset{\\sim}{v}=\\begin{pmatrix}2\\\\4\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90^\\circ$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=6(2)+(-3)(4)=0\\\\\\cos\\theta&=0\\\\\\theta&=90^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\underset{\\sim}{u}=2\\underset{\\sim}{i}+5\\underset{\\sim}{j}$ and $\\underset{\\sim}{v}=3\\underset{\\sim}{i}+\\underset{\\sim}{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50^\\circ$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{u}\\cdot\\underset{\\sim}{v}&=2(3)+5(1)=11\\\\|\\underset{\\sim}{u}|&=\\sqrt{2^2+5^2}=\\sqrt{29}\\\\|\\underset{\\sim}{v}|&=\\sqrt{3^2+1^2}=\\sqrt{10}\\\\\\cos\\theta&=\\frac{11}{\\sqrt{29}\\times\\sqrt{10}}\\\\&=\\frac{11}{\\sqrt{290}}\\\\\\theta&=\\cos^{-1}\\!\\left(\\frac{11}{\\sqrt{290}}\\right)\\\\&\\approx50^\\circ\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
