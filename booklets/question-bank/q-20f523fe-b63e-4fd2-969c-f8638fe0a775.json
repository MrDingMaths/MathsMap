        "answer": {
          "short": "$-5$",
          "worked": "$$\\begin{align*}1-2\\times(-3)\\div(-3-(-2))&=1-2\\times(-3)\\div(-3+2)\\\\&=1-2\\times(-3)\\div(-1)\\\\&=1-(-6)\\div(-1)\\\\&=1-6\\\\&=-5\\end{align*}$$\nCalculator check: $-5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p55-q7-j",
        "type": "part",
        "label": "j",
        "prompt": "$(-3 + (-5)) \\times (-2 - (-1))$",
        "layout": "list",
