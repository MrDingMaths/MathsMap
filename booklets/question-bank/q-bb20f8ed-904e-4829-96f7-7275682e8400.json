  "content": {
    "id": "p23-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Part-way through a cricket season, a batsman has had scores of 15, 76, 42 and 27. Assume that the batsman is dismissed in each innings.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the batsman’s average.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$40.0$ runs",
          "worked": "$$\\begin{align*}\\text{Average}&=\\frac{15+76+42+27}{4}\\\\\\text{Average}&=\\frac{160}{4}\\\\\\text{Average}&=40.0\\text{ runs}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "If his average after the next innings is 42, how many runs did he score in that innings?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$50$ runs",
          "worked": "$$\\begin{align*}\\text{Total after 5 innings}&=42\\times5\\\\\\text{Total after 5 innings}&=210\\text{ runs}\\\\\\text{Fifth-innings score}&=210-160\\\\\\text{Fifth-innings score}&=50\\text{ runs}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "The batsman has 12 innings in a season. He wants to have an average of 50 at the end of the season. How many runs does he need to score in the remaining 7 innings?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p23-q6-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "390\\text{ runs}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p23-q6-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Subtract the total after five innings from the required season total.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Using the total of 210 runs after five innings from part b:\n\n$$\\begin{align*}\\text{Required season total}&=50\\times12\\\\\\text{Required season total}&=600\\text{ runs}\\\\\\text{Runs needed in remaining 7 innings}&=600-210\\\\\\text{Runs needed in remaining 7 innings}&=390\\text{ runs}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
