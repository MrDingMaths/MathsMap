        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(-1,0)$; $y$-intercept: $(0,1)$.",
          "worked": "For the $y$-intercept, substitute $x=0$:\n$$\\begin{align*}y&=0+1\\\\y&=1\\end{align*}$$\nFor the $x$-intercept, substitute $y=0$:\n$$\\begin{align*}0&=x+1\\\\-1&=x\\end{align*}$$\n$x$-intercept: $(-1,0)$; $y$-intercept: $(0,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\frac12x-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(6,0)$; $y$-intercept: $(0,-3)$.",
          "worked": "Substitute $x=0$:\n$$\\begin{align*}y&=\\tfrac12(0)-3\\\\y&=-3\\end{align*}$$\nSubstitute $y=0$:\n$$\\begin{align*}0&=\\tfrac12x-3\\\\3&=\\tfrac12x\\\\6&=x\\end{align*}$$\n$x$-intercept: $(6,0)$; $y$-intercept: $(0,-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both intercepts are $(0,0)$.",
          "worked": "Substitute $x=0$: $y=0$.\nSubstitute $y=0$: $0=x$.\nBoth intercepts are $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$y-3x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Both intercepts are $(0,0)$.",
          "worked": "Substitute $x=0$:\n$$\\begin{align*}y-3(0)&=0\\\\y&=0\\end{align*}$$\nSubstitute $y=0$:\n$$\\begin{align*}0-3x&=0\\\\x&=0\\end{align*}$$\nBoth intercepts are $(0,0)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$x+y-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(1,0)$; $y$-intercept: $(0,1)$.",
          "worked": "Substitute $x=0$:\n$$\\begin{align*}0+y-1&=0\\\\y&=1\\end{align*}$$\nSubstitute $y=0$:\n$$\\begin{align*}x+0-1&=0\\\\x&=1\\end{align*}$$\n$x$-intercept: $(1,0)$; $y$-intercept: $(0,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p7-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$x-3y-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(3,0)$; $y$-intercept: $(0,-1)$.",
          "worked": "Substitute $x=0$:\n$$\\begin{align*}0-3y-3&=0\\\\-3y&=3\\\\y&=-1\\end{align*}$$\nSubstitute $y=0$:\n$$\\begin{align*}x-3(0)-3&=0\\\\x&=3\\end{align*}$$\n$x$-intercept: $(3,0)$; $y$-intercept: $(0,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p7-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$2x-3y-12=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(6,0)$; $y$-intercept: $(0,-4)$.",
          "worked": "Substitute $x=0$:\n$$\\begin{align*}2(0)-3y-12&=0\\\\-3y&=12\\\\y&=-4\\end{align*}$$\nSubstitute $y=0$:\n$$\\begin{align*}2x-3(0)-12&=0\\\\2x&=12\\\\x&=6\\end{align*}$$\n$x$-intercept: $(6,0)$; $y$-intercept: $(0,-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$5x+2y-10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x$-intercept: $(2,0)$; $y$-intercept: $(0,5)$.",
          "worked": "Substitute $x=0$:\n$$\\begin{align*}5(0)+2y-10&=0\\\\2y&=10\\\\y&=5\\end{align*}$$\nSubstitute $y=0$:\n$$\\begin{align*}5x+2(0)-10&=0\\\\5x&=10\\\\x&=2\\end{align*}$$\n$x$-intercept: $(2,0)$; $y$-intercept: $(0,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
