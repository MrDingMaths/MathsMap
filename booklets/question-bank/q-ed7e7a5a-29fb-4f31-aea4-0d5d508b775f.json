        "label": "a",
        "prompt": "$\\left(\\frac{x}{2}+3\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{4}+3x+9$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}+3\\right)^2&=\\left(\\frac{x}{2}\\right)^2+2\\times\\frac{x}{2}\\times3+3^2\\\\\\left(\\frac{x}{2}+3\\right)^2&=\\frac{x^2}{4}+3x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p21-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\left(\\frac{x}{3}-2\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x^2}{9}-\\frac{4x}{3}+4$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{3}-2\\right)^2&=\\left(\\frac{x}{3}\\right)^2-2\\times\\frac{x}{3}\\times2+2^2\\\\\\left(\\frac{x}{3}-2\\right)^2&=\\frac{x^2}{9}-\\frac{4x}{3}+4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p21-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\left(\\frac{2x}{5}-1\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4x^2}{25}-\\frac{4x}{5}+1$",
          "worked": "$$\\begin{align*}\\left(\\frac{2x}{5}-1\\right)^2&=\\left(\\frac{2x}{5}\\right)^2-2\\times\\frac{2x}{5}\\times1+1^2\\\\\\left(\\frac{2x}{5}-1\\right)^2&=\\frac{4x^2}{25}-\\frac{4x}{5}+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p21-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\left(\\frac{3x}{4}+\\frac{2}{3}\\right)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9x^2}{16}+x+\\frac{4}{9}$",
          "worked": "$$\\begin{align*}\\left(\\frac{3x}{4}+\\frac{2}{3}\\right)^2&=\\left(\\frac{3x}{4}\\right)^2+2\\times\\frac{3x}{4}\\times\\frac{2}{3}+\\left(\\frac{2}{3}\\right)^2\\\\\\left(\\frac{3x}{4}+\\frac{2}{3}\\right)^2&=\\frac{9x^2}{16}+\\frac{12x}{12}+\\frac{4}{9}\\\\\\left(\\frac{3x}{4}+\\frac{2}{3}\\right)^2&=\\frac{9x^2}{16}+x+\\frac{4}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
