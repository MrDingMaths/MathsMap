    "children": [
      {
        "id": "v2-727073-p8-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "If $P(x)=(x-4)^2Q(x)$, then $P'(4)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True.",
          "worked": "$$\\begin{align*}P'(x)&=2(x-4)Q(x)+(x-4)^2Q'(x)\\\\P'(4)&=0+0=0\\end{align*}$$Every term of $P'(x)$ contains the factor $(x-4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-727073-p8-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "If $P(2)=0$ and $P'(2)=0$, then $P(x)=(x-2)^2Q(x)$ where $Q(2)\\ne0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "$P(2)=P'(2)=0$ gives $P(x)=(x-2)^2Q(x)$, but $Q(2)$ may be $0$. For example, $P(x)=(x-2)^3$ has $P(2)=P'(2)=0$, and here $Q(x)=x-2$, so $Q(2)=0$. The zero is only known to have multiplicity at least $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-727073-p8-practice-slot-3-slot-3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "If $P(x)=(x-1)^3Q(x)$ where $Q(1)\\ne0$, then $P''(1)=0$ and $P'''(1)=0$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False.",
          "worked": "The zero $1$ has multiplicity exactly $3$, so $P(1)=P'(1)=P''(1)=0$. However, $P'''(1)=6Q(1)\\ne0$. So $P''(1)=0$ is true but $P'''(1)=0$ is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
