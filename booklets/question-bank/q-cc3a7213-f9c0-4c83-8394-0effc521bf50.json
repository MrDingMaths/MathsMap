  "content": {
    "id": "p51-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Evaluate these expressions using the log law $\\ln a^n=n\\ln a$ and the fact that $\\ln e=1$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$e\\ln e$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$e$",
          "worked": "$$\\begin{align*}e\\ln e&=e\\times1\\\\e\\ln e&=e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p51-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{1}{e}\\ln\\frac{1}{e}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{1}{e}$",
          "worked": "$$\\begin{align*}\\frac1e\\ln\\frac1e&=\\frac1e\\ln e^{-1}\\\\\\frac1e\\ln\\frac1e&=-\\frac1e\\ln e\\\\\\frac1e\\ln\\frac1e&=-\\frac1e\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p51-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$3\\ln e^2$",
