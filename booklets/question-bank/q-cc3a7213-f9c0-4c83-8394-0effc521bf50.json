        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}\\ln e^5&=5\\ln e\\\\\\ln e^5&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p51-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\ln e^{200}$",
