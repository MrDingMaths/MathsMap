        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}3\\ln e^2&=3\\times2\\ln e\\\\3\\ln e^2&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p51-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\ln e^5$",
