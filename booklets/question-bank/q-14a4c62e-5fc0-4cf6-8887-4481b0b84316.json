    "questionDiagrams": [],
    "children": [
      {
        "id": "p33-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the number $\\frac{3}{10}$ as the sum of two different unit fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}+\\frac{1}{10}$",
          "worked": "$$\\begin{align*}\\frac{3}{10}&=\\frac{2}{10}+\\frac{1}{10}\\\\\\frac{3}{10}&=\\frac{1}{5}+\\frac{1}{10}\\end{align*}$$\n\nBoth numerators are 1 and the denominators are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "Write $\\frac{19}{20}$ as the sum of three different unit fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{5}$",
          "worked": "$$\\begin{align*}\\frac{19}{20}&=\\frac{10}{20}+\\frac{5}{20}+\\frac{4}{20}\\\\\\frac{19}{20}&=\\frac{1}{2}+\\frac{1}{4}+\\frac{1}{5}\\end{align*}$$\n\nAll three numerators are 1 and the denominators are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p33-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "Write $\\frac{2}{5}$ as the sum of four different unit fractions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}+\\frac{1}{10}+\\frac{1}{15}+\\frac{1}{30}$\n\nUse a common denominator of 30 to check the sum.",
          "worked": "$$\\begin{align*}\\frac{2}{5}&=\\frac{12}{30}\\\\\\frac{2}{5}&=\\frac{6}{30}+\\frac{3}{30}+\\frac{2}{30}+\\frac{1}{30}\\\\\\frac{2}{5}&=\\frac{1}{5}+\\frac{1}{10}+\\frac{1}{15}+\\frac{1}{30}\\end{align*}$$\n\nAll four numerators are 1 and the denominators are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
