          "inlines": [
            {
              "type": "text",
              "text": "For example, ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{2}{3}=\\frac{1}{2}+\\frac{1}{6}",
              "display": false
            },
            {
