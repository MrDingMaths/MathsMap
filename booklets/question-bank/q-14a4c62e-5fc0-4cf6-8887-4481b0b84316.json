            {
              "type": "text",
              "text": "A unit fraction is of the form ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\frac{1}{n}",
              "display": false
            },
            {
              "type": "text",
              "text": " where ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "n",
              "display": false
            },
            {
              "type": "text",
              "text": " is a positive whole number. Remarkably, every fraction can be written as the sum of different unit fractions.",
              "marks": []
            }
          ]
        },
        {
          "id": "p33-q9-example-paragraph",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
