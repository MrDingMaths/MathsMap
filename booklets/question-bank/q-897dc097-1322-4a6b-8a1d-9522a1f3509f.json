  "content": {
    "id": "p16-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A particle is projected from horizontal ground with a speed of $40\\text{ m/s}$ at an angle of $30^\\circ$ to the horizontal.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q2-part-a",
        "type": "part",
        "label": "a",
        "prompt": "Starting with $\\ddot{x}=0$ and $\\ddot{y}=-10$, show that $\\dot{x}=20\\sqrt{3}$ and $\\dot{y}=-10t+20$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dot{x}=20\\sqrt{3},\\quad \\dot{y}=-10t+20$.",
          "worked": "Integrating the horizontal acceleration:\n$$\\begin{aligned}\\dot{x}&=C_1\\\\\\dot{x}(0)&=40\\cos30^\\circ=20\\sqrt{3}\\\\C_1&=20\\sqrt{3}\\\\\\therefore\\ \\dot{x}&=20\\sqrt{3}.\\end{aligned}$$\nIntegrating the vertical acceleration:\n$$\\begin{aligned}\\dot{y}&=-10t+C_2\\\\\\dot{y}(0)&=40\\sin30^\\circ=20\\\\C_2&=20\\\\\\therefore\\ \\dot{y}&=-10t+20.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p16-q2-part-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find $x$ and $y$ in terms of $t$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=20\\sqrt{3}t,\\quad y=-5t^2+20t$.",
          "worked": "Taking the launch point as the origin:\n$$\\begin{aligned}x&=20\\sqrt{3}t+C_3\\\\y&=-5t^2+20t+C_4.\\end{aligned}$$\nAt $t=0$, $x=y=0$, so $C_3=C_4=0$.\n$$\\begin{aligned}x&=20\\sqrt{3}t\\\\y&=-5t^2+20t.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q2-part-c",
        "type": "group",
        "label": "c",
        "prompt": "Find:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p16-q2-part-c-i",
            "type": "part",
            "label": "i",
            "prompt": "when the particle returns to the ground,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$4\\text{ s}$.",
              "worked": "$$\\begin{aligned}0&=-5t^2+20t\\\\0&=t(-5t+20)\\\\t&=0\\text{ or }4.\\end{aligned}$$\nThe particle returns to the ground at $t=4\\text{ s}$; $t=0$ is launch.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          },
          {
            "id": "p16-q2-part-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the horizontal distance travelled,",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$80\\sqrt{3}\\text{ m}$.",
              "worked": "$$\\begin{aligned}x(4)&=20\\sqrt{3}(4)\\\\&=80\\sqrt{3}\\text{ m}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 13
          },
          {
            "id": "p16-q2-part-c-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the greatest height reached.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$20\\text{ m}$.",
              "worked": "At greatest height, $\\dot{y}=0$.\n$$\\begin{aligned}0&=-10t+20\\\\t&=2\\text{ s}\\\\y(2)&=-5(2)^2+20(2)\\\\&=-20+40\\\\&=20\\text{ m}.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      }
    ]
  },
