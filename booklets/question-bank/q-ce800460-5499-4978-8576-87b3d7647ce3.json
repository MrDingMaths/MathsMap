  "content": {
    "id": "p21-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "For $\\triangle ABC$ we are given that $a=2$, $b=3\\sqrt2$ and $\\angle C=45^\\circ$. Find the area of the triangle.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3$",
      "worked": "$$\\begin{align*}A&=\\frac12ab\\sin C\\\\A&=\\frac12(2)(3\\sqrt2)\\frac{\\sqrt2}{2}\\\\A&=3.\\end{align*}$$",
      "solutionDiagrams": []
    },
