  "content": {
    "id": "p7-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A rectangle has length $7$ cm and width $\\sqrt{3}$ cm. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "the area of the rectangle",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7\\sqrt{3}\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=lw\\\\A&=7\\times\\sqrt{3}\\\\A&=7\\sqrt{3}\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "the length of a diagonal",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sqrt{13}\\text{ cm}$",
          "worked": "Let $d$ cm be the diagonal length. By Pythagoras’ theorem,\n$$\\begin{align*}d^2&=7^2+(\\sqrt{3})^2\\\\d^2&=49+3\\\\d^2&=52\\\\d&=\\sqrt{52}\\\\d&=\\sqrt{4\\times13}\\\\d&=2\\sqrt{13}\\end{align*}$$\nThe diagonal is $2\\sqrt{13}$ cm long.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
