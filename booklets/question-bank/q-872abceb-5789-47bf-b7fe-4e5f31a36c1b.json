  "content": {
    "id": "v2-0b24d3-p3-practice-j13-104354-root",
    "type": "question",
    "label": null,
    "prompt": "",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-0b24d3-p3-practice-j13-104354-j13-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Using the pattern for denominators of $9$, write $0.\\dot{9}$ as a fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{9}$",
          "worked": "The repeating digit is the numerator, with denominator $9$.\n$$0.\\dot{9}=\\frac{9}{9}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-0b24d3-p3-practice-j13-104354-j13-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Simplify your answer to part a. What whole number does $0.\\dot{9}$ equal?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}0.\\dot{9}&=\\frac{9}{9}\\\\&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "v2-0b24d3-p3-practice-j13-104354-j13-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence, write $0.0\\dot{9}$ as a fraction.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "One extra decimal place before the repetition divides the recurring contribution by $10$.\n$$\\begin{align*}0.0\\dot{9}&=0.\\dot{9}\\div10\\\\&=1\\div10\\\\&=\\frac{1}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-0b24d3-p3-practice-j13-104354-j13-q-d",
        "type": "part",
        "label": "d",
        "prompt": "Write $0.4\\dot{9}$ as a fraction in simplest form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}0.4\\dot{9}&=0.4+0.0\\dot{9}\\\\&=\\frac{4}{10}+\\frac{1}{10}\\\\&=\\frac{5}{10}\\\\&=\\frac{1}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
