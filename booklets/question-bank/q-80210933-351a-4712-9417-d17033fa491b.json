  "content": {
    "id": "p51-q3-root",
    "type": "question",
    "label": "",
    "prompt": "Use the results $\\sin^2\\theta=\\frac12-\\frac12\\cos 2\\theta$ and $\\cos^2\\theta=\\frac12+\\frac12\\cos 2\\theta$ to evaluate:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p51-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_0^\\pi\\sin^2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi}{2}$",
          "worked": "$$\\begin{aligned}\\int_0^\\pi\\sin^2x\\,dx&=\\frac12\\int_0^\\pi(1-\\cos 2x)\\,dx\\\\&=\\left[\\frac{x}{2}-\\frac14\\sin 2x\\right]_0^\\pi\\\\&=\\left(\\frac\\pi2-\\frac14\\sin 2\\pi\\right)-\\left(0-\\frac14\\sin 0\\right)\\\\&=\\frac\\pi2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p51-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^{\\pi/4}\\cos^2x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\pi+2}{8}$",
          "worked": "$$\\begin{aligned}\\int_0^{\\pi/4}\\cos^2x\\,dx&=\\frac12\\int_0^{\\pi/4}(1+\\cos 2x)\\,dx\\\\&=\\left[\\frac{x}{2}+\\frac14\\sin 2x\\right]_0^{\\pi/4}\\\\&=\\left(\\frac\\pi8+\\frac14\\sin\\frac\\pi2\\right)-\\left(0+\\frac14\\sin 0\\right)\\\\&=\\frac\\pi8+\\frac14\\\\&=\\frac{\\pi+2}{8}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
