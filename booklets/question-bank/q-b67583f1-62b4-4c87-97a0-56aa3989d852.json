  "content": {
    "id": "v2-fc7d35-p4-practice-slot-2-root",
    "type": "question",
    "label": null,
    "prompt": "If $V=x^3-6x$ and $\\dfrac{dx}{dt}=4$, evaluate $\\dfrac{dV}{dt}$ when $x=3$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$84$",
      "worked": "Variables: $V,x,t$.\n$$\\begin{aligned}\\frac{dV}{dt}&=\\frac{dV}{dx}\\times\\frac{dx}{dt}\\\\\\frac{dV}{dt}&=(3x^2-6)\\times4\\end{aligned}$$\nAt $x=3$:\n$$\\begin{aligned}\\frac{dV}{dt}&=(3(3)^2-6)\\times4\\\\\\frac{dV}{dt}&=84\\end{aligned}$$",
      "solutionDiagrams": []
    },
