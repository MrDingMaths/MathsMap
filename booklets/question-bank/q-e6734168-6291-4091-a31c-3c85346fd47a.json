  "content": {
    "id": "p35-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A continuous probability distribution is defined by $f(x)=\\dfrac{2e^{2x}}{e^{10}-1}$ in the domain $[0,5]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the CDF.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$F(x)=\\dfrac{e^{2x}-1}{e^{10}-1}$ for $0\\le x\\le5$; $F(x)=0$ for $x<0$ and $F(x)=1$ for $x>5$.",
          "worked": "$$\\begin{aligned}F(x)&=\\int_0^x\\frac{2e^{2t}}{e^{10}-1}\\,dt\\\\&=\\left[\\frac{e^{2t}}{e^{10}-1}\\right]_0^x\\\\&=\\frac{e^{2x}-1}{e^{10}-1},\\qquad 0\\le x\\le5.\\end{aligned}$$\nFor $x<0$, $F(x)=0$; for $x>5$, $F(x)=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p35-q6-b",
        "type": "group",
        "label": "b",
        "prompt": "Calculate each probability correct to 2 significant figures.",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p35-q6-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$P(X\\le2)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.0024$",
              "worked": "$$\\begin{aligned}P(X\\le2)&=F(2)\\\\&=\\frac{e^4-1}{e^{10}-1}\\\\&\\approx0.0024.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p35-q6-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$P(X\\le4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.14$",
              "worked": "$$\\begin{aligned}P(X\\le4)&=F(4)\\\\&=\\frac{e^8-1}{e^{10}-1}\\\\&\\approx0.14.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p35-q6-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "$P(X>3)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.98$",
              "worked": "$$\\begin{aligned}P(X>3)&=1-F(3)\\\\&=1-\\frac{e^6-1}{e^{10}-1}\\\\&\\approx0.98.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p35-q6-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "$P(X\\ge2.8)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.99$",
              "worked": "$$\\begin{aligned}P(X\\ge2.8)&=1-F(2.8)\\\\&=1-\\frac{e^{5.6}-1}{e^{10}-1}\\\\&\\approx0.99.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          },
          {
            "id": "p35-q6-b-v",
            "type": "part",
            "label": "v",
            "prompt": "$P(2\\le X\\le4)$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$0.13$",
              "worked": "$$\\begin{aligned}P(2\\le X\\le4)&=F(4)-F(2)\\\\&=\\frac{e^8-e^4}{e^{10}-1}\\\\&\\approx0.13.\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 20
          }
        ]
      }
    ]
  },
