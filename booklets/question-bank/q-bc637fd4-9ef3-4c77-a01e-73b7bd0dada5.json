  "content": {
    "id": "p38-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Use the quadratic formula to find the roots $\\alpha$ and $\\beta$ of each quadratic equation. Hence show in each case that both $\\alpha+\\beta=-\\dfrac ba$ and $\\alpha\\beta=\\dfrac ca$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p38-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-6x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha=3+2\\sqrt2$, $\\beta=3-2\\sqrt2$; $\\alpha+\\beta=6=-\\frac{b}{a}$, $\\alpha\\beta=1=\\frac{c}{a}$.",
          "worked": "$$\\begin{align*}\\Delta&=(-6)^2-4(1)(1)=32\\\\x&=\\frac{6\\pm\\sqrt{32}}2\\\\x&=3\\pm2\\sqrt2\\\\\\alpha+\\beta&=(3+2\\sqrt2)+(3-2\\sqrt2)=6\\\\\\alpha+\\beta&=-\\frac{-6}{1}=-\\frac ba\\\\\\alpha\\beta&=(3+2\\sqrt2)(3-2\\sqrt2)=9-8=1\\\\\\alpha\\beta&=\\frac11=\\frac ca\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      },
      {
        "id": "p38-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-2x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha=1+\\sqrt5$, $\\beta=1-\\sqrt5$; $\\alpha+\\beta=2=-\\frac{b}{a}$, $\\alpha\\beta=-4=\\frac{c}{a}$.",
          "worked": "$$\\begin{align*}\\Delta&=(-2)^2-4(1)(-4)=20\\\\x&=\\frac{2\\pm\\sqrt{20}}2\\\\x&=1\\pm\\sqrt5\\\\\\alpha+\\beta&=(1+\\sqrt5)+(1-\\sqrt5)=2\\\\\\alpha+\\beta&=-\\frac{-2}{1}=-\\frac ba\\\\\\alpha\\beta&=(1+\\sqrt5)(1-\\sqrt5)=1-5=-4\\\\\\alpha\\beta&=\\frac{-4}{1}=\\frac ca\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      },
      {
        "id": "p38-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$-3x^2+10x-5=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\alpha=\\dfrac{5+\\sqrt{10}}3$, $\\beta=\\dfrac{5-\\sqrt{10}}3$; $\\alpha+\\beta=\\dfrac{10}3=-\\frac{b}{a}$, $\\alpha\\beta=\\dfrac53=\\frac{c}{a}$.",
          "worked": "$$\\begin{align*}\\Delta&=10^2-4(-3)(-5)=40\\\\x&=\\frac{-10\\pm\\sqrt{40}}{-6}\\\\x&=\\frac{5\\pm\\sqrt{10}}3\\\\\\alpha+\\beta&=\\frac{5+\\sqrt{10}+5-\\sqrt{10}}3=\\frac{10}3\\\\\\alpha+\\beta&=-\\frac{10}{-3}=-\\frac ba\\\\\\alpha\\beta&=\\frac{(5+\\sqrt{10})(5-\\sqrt{10})}{9}\\\\\\alpha\\beta&=\\frac{25-10}{9}=\\frac53\\\\\\alpha\\beta&=\\frac{-5}{-3}=\\frac ca\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 85
      }
    ]
  },
