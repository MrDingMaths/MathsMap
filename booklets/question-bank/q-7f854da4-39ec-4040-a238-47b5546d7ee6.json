    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=15$",
      "worked": "Using complementary angles:\n$$\\begin{align*}(15-k)+(2k+60)&=90\\\\k+75&=90\\\\k&=15\\end{align*}$$\nFor $k=15$, both sides equal $1$.",
