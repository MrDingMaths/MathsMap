        "answer": {
          "short": "$4x^2+16x+15$",
          "worked": "$$\\begin{align*}(2x+3)(2x+5)&=4x^2+10x+6x+15\\\\(2x+3)(2x+5)&=4x^2+16x+15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$(2x+3)(2x-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-4x-15$",
          "worked": "$$\\begin{align*}(2x+3)(2x-5)&=4x^2-10x+6x-15\\\\(2x+3)(2x-5)&=4x^2-4x-15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$(2x+3)(2x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2+12x+9$",
          "worked": "$$\\begin{align*}(2x+3)(2x+3)&=(2x)^2+2(2x)(3)+3^2\\\\(2x+3)(2x+3)&=4x^2+12x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p18-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$(2x+3)(2x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4x^2-9$",
          "worked": "$$\\begin{align*}(2x+3)(2x-3)&=(2x)^2-3^2\\\\(2x+3)(2x-3)&=4x^2-9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q3-e",
        "type": "part",
        "label": "e",
