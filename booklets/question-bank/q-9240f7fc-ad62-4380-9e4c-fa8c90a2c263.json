  "content": {
    "id": "p12-q5-p62-q14-response",
    "type": "question",
    "label": "5",
    "prompt": "A sector with radius $5\\text{ cm}$ has area $10\\pi\\text{ cm}^2$. Find the arc length of the sector in exact form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4\\pi\\text{ cm}$",
      "worked": "$$\\begin{align*}10\\pi &= \\frac{1}{2}(5)^2\\theta\\\\\\theta &= \\frac{4\\pi}{5}\\\\l &= 5\\left(\\frac{4\\pi}{5}\\right)\\\\l &= 4\\pi\\text{ cm}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
