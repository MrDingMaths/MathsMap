        "id": "p8-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "Ted works 38 hours a week and is paid \\$15.25 per hour. Work out his weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$579.50",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\text{Hourly rate}\\times\\text{Hours worked}\\\\\\text{Weekly pay}&=\\$15.25\\times38\\\\\\text{Weekly pay}&=\\$579.50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "Anne works 13 hours a week and is paid \\$31.20 per hour. Work out her weekly pay.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$405.60",
          "worked": "$$\\begin{align*}\\text{Weekly pay}&=\\text{Hourly rate}\\times\\text{Hours worked}\\\\\\text{Weekly pay}&=\\$31.20\\times13\\\\\\text{Weekly pay}&=\\$405.60\\end{align*}$$",
