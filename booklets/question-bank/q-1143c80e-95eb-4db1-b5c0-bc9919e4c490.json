  "content": {
    "id": "p10-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A letter is chosen at random from the 10 letters of the word ‘COMMISSION’. What is the probability that the letter is:",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q5a",
        "type": "part",
        "label": "a",
        "prompt": "$N$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "There is one N among the 10 letters.\n$$P(N)=\\frac{1}{10}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p10-q5b",
        "type": "part",
        "label": "b",
        "prompt": "$S$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{5}$",
          "worked": "There are two S letters.\n$$\\begin{align*}P(S)&=\\frac{2}{10}\\\\P(S)&=\\frac{1}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q5c",
        "type": "part",
        "label": "c",
        "prompt": "a vowel?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "The vowels are O, I, I, O: four letters.\n$$\\begin{align*}P(\\text{vowel})&=\\frac{4}{10}\\\\P(\\text{vowel})&=\\frac{2}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p10-q5d",
        "type": "part",
        "label": "d",
        "prompt": "not $S$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "$$\\begin{align*}P(\\text{not }S)&=1-\\frac{2}{10}\\\\P(\\text{not }S)&=\\frac{8}{10}\\\\P(\\text{not }S)&=\\frac{4}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
