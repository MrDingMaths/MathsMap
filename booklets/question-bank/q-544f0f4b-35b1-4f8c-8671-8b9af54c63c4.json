        "answer": {
          "short": "$10.79\\,\\text{cm}$; arc length plus two radii.",
          "worked": "$$\\begin{align*}l&=\\frac{\\theta}{360}(2\\pi r)\\\\l&=\\frac{40}{360}(2\\pi\\times4)\\\\l&=\\frac{8\\pi}{9}\\,\\text{cm}\\\\P&=l+2r\\\\P&=\\frac{8\\pi}{9}+2(4)\\\\P&\\approx10.79\\,\\text{cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 49
      },
