          "short": "$5.59\\,\\text{cm}^2$",
          "worked": "$$\\begin{align*}A&=\\frac{\\theta}{360}\\pi r^2\\\\A&=\\frac{40}{360}\\pi(4)^2\\\\A&=\\frac{16\\pi}{9}\\,\\text{cm}^2\\\\A&\\approx5.59\\,\\text{cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
