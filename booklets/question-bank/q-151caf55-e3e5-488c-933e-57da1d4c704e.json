        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $10\\,800$.",
          "worked": "Choose $10\\,800$. It has five digits, with $0$ appearing three times.\n\nThe digit sum is $1+0+8+0+0=9$, which is divisible by $3$. Its last two digits form $0$, which is divisible by $4$. Therefore $10\\,800$ is divisible by both $3$ and $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "divisible by 11",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $11\\,132$.",
          "worked": "Choose $11\\,132$. It has five digits, with $1$ appearing three times.\n\nThe difference between the alternating digit sums is $(1+1+2)-(1+3)=0$. Since $0$ is divisible by $11$, $11\\,132$ is divisible by $11$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "divisible by 8 and 3",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answer: $24\\,000$.",
          "worked": "Choose $24\\,000$. It has five digits, with $0$ appearing three times.\n\nIts last three digits form $0$, which is divisible by $8$. The digit sum is $2+4+0+0+0=6$, which is divisible by $3$. Therefore $24\\,000$ is divisible by both $8$ and $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p25-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "divisible by 2 and 11 but not 4",
