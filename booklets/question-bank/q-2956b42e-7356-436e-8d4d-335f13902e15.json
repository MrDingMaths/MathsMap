  "content": {
    "id": "p4-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "The clock below displays the time 12:15.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p4-q8-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 4 p4-q8-diagram\"}\n\\begin{tikzpicture}[font=\\fontsize{10}{12}\\selectfont]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[line width=0.8pt] (0,0) circle (2);\n\\foreach \\n in {1,...,12}{\\draw[line width=0.4pt] ({90-30*\\n}:1.82)--({90-30*\\n}:2);\\node at ({90-30*\\n}:1.52) {\\n};}\n\\draw[line width=0.8pt,line cap=round] (0,0)--(0:1.05);\n\\draw[line width=0.8pt,line cap=round] (0,0)--(82.5:0.85);\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 41.1,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 4,
          "sourceRegion": "Question 8, lower left",
          "description": "Twelve-number analogue clock. Minute hand points to 3; hour hand is slightly clockwise from 12. Decorative pale blue face omitted under house style.",
          "mathematics": "At 12:15 the minute hand has turned 90 degrees and the hour hand 7.5 degrees clockwise from 12.",
          "answerVisibility": "No angle value or answer annotation is printed."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p4-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "The angle between the two hands is not $90^\\circ$. Why not?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The hour hand has also moved past 12.",
          "worked": "The hour hand moves continuously. By 12:15 it has moved towards 1, so the angle between the hands is less than $90^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "How many degrees does the minute hand move each hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$360^\\circ$",
          "worked": "The minute hand completes one revolution each hour, so it moves $360^\\circ$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p4-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "How many degrees does the minute hand move each minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6^\\circ$",
          "worked": "$$\\frac{360^\\circ}{60}=6^\\circ$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "How many degrees does the hour hand move each hour?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30^\\circ$",
          "worked": "The hour hand completes a revolution in 12 hours.\n$$\\frac{360^\\circ}{12}=30^\\circ$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p4-q8-e",
        "type": "part",
        "label": "e",
        "prompt": "How many degrees does the hour hand move each minute?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5^\\circ$",
          "worked": "$$\\frac{30^\\circ}{60}=0.5^\\circ$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p4-q8-f",
        "type": "part",
        "label": "f",
        "prompt": "Find the angle between the minute and hour hand at 12:15.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$82.5^\\circ$",
          "worked": "Measured clockwise from 12, the minute hand is at $15\\times6^\\circ=90^\\circ$ and the hour hand is at $15\\times0.5^\\circ=7.5^\\circ$.\n$$\\begin{align*}\\text{Angle between the hands}&=90^\\circ-7.5^\\circ\\\\\\text{Angle between the hands}&=82.5^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p4-q8-g",
        "type": "part",
        "label": "g",
        "prompt": "What was the previous time for which there was the same angle between the minute and hour hand?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "11:45.\n\nReflect the hand positions about the line through 12 and 6.",
          "worked": "Reflecting the 12:15 hand positions about the line through 12 and 6 gives 11:45. The minute hand is $90^\\circ$ anticlockwise from 12 and the hour hand is $7.5^\\circ$ anticlockwise from 12, leaving $82.5^\\circ$ between them. Between 11:45 and 12:15, the angle decreases to $0^\\circ$ at 12:00 and then increases to $82.5^\\circ$, so 11:45 is the previous occurrence.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p4-q8-h",
        "type": "part",
        "label": "h",
        "prompt": "Determine the first time after 12:00 when the angle between the minute and hour hand is $90^\\circ$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\frac{4}{11}$ minutes after 12:00.\n\nThe hands separate at $5.5^\\circ$ per minute.",
          "worked": "The minute hand gains $6^\\circ-0.5^\\circ=5.5^\\circ$ each minute. Let $t$ be the number of minutes after 12:00.\n$$\\begin{align*}5.5t&=90\\\\t&=\\frac{90}{5.5}\\\\t&=16\\frac{4}{11}\\end{align*}$$\nThe first time is $16\\frac{4}{11}$ minutes after 12:00.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p4-q8-i",
        "type": "part",
        "label": "i",
        "prompt": "Determine the first time after 12:00 when the minute and hour hands are pointing in opposite directions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$32\\frac{8}{11}$ minutes after 12:00.\n\nThe hands separate at $5.5^\\circ$ per minute until they are $180^\\circ$ apart.",
          "worked": "Opposite directions give an angle of $180^\\circ$. Let $t$ be the number of minutes after 12:00.\n$$\\begin{align*}5.5t&=180\\\\t&=\\frac{180}{5.5}\\\\t&=32\\frac{8}{11}\\end{align*}$$\nThe first time is $32\\frac{8}{11}$ minutes after 12:00.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
