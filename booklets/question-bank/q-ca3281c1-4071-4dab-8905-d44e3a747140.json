  "content": {
    "id": "p49-q62-70-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify the following expressions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q62-70-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin(\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sin\\theta$",
          "worked": "Reflection in the vertical diameter preserves the sine coordinate.\n$$\\begin{align*}\\sin(\\pi-\\theta)&=\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q62-70-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos(\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cos\\theta$",
          "worked": "Reflection in the vertical diameter reverses the cosine coordinate.\n$$\\begin{align*}\\cos(\\pi-\\theta)&=-\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q62-70-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\tan(\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\tan\\theta$",
          "worked": "Use the related-angle sine and cosine values, where tangent is defined.\n$$\\begin{align*}\\tan(\\pi-\\theta)&=\\frac{\\sin\\theta}{-\\cos\\theta}\\\\\\tan(\\pi-\\theta)&=-\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p49-q62-70-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin(\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sin\\theta$",
          "worked": "A half-turn reverses both unit-circle coordinates.\n$$\\begin{align*}\\sin(\\pi+\\theta)&=-\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q62-70-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\cos(\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\cos\\theta$",
          "worked": "A half-turn reverses both unit-circle coordinates.\n$$\\begin{align*}\\cos(\\pi+\\theta)&=-\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q62-70-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\tan(\\pi+\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan\\theta$",
          "worked": "A half-turn reverses both coordinates, so their quotient is unchanged where tangent is defined.\n$$\\begin{align*}\\tan(\\pi+\\theta)&=\\frac{-\\sin\\theta}{-\\cos\\theta}\\\\\\tan(\\pi+\\theta)&=\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p49-q62-70-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\sin(2\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\sin\\theta$",
          "worked": "Reflection in the horizontal diameter reverses the sine coordinate.\n$$\\begin{align*}\\sin(2\\pi-\\theta)&=-\\sin\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q62-70-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\cos(2\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\cos\\theta$",
          "worked": "Reflection in the horizontal diameter preserves the cosine coordinate.\n$$\\begin{align*}\\cos(2\\pi-\\theta)&=\\cos\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p49-q62-70-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\tan(2\\pi-\\theta)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\tan\\theta$",
          "worked": "Use the reflected sine and cosine values, where tangent is defined.\n$$\\begin{align*}\\tan(2\\pi-\\theta)&=\\frac{-\\sin\\theta}{\\cos\\theta}\\\\\\tan(2\\pi-\\theta)&=-\\tan\\theta\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
