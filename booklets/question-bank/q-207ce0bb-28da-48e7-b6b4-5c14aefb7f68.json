  "content": {
    "id": "p22-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "Find the fraction of the large circle that is shaded.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q23-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the diagram below.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p22-q23-a-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"shadedBlue\",\"hex\":\"D4E8FF\",\"reason\":\"requested shaded interior disks\"}],\"reference\":\"source page 22, p22-q23-a-diagram\"}\n\\begin{tikzpicture}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{shadedBlue}{HTML}{D4E8FF}\n\\draw[black,line width=0.8pt] (0,0) circle[radius=2];\n\\draw[black,line width=0.8pt,fill=shadedBlue] (-1,0) circle[radius=1];\n\\draw[black,line width=0.8pt,fill=shadedBlue] (1,0) circle[radius=1];\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 41.1,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 22,
              "sourceRegion": "Question 23(a), left column",
              "description": "Two equal shaded circles form a horizontal diameter chain inside an unshaded enclosing circle.",
              "mathematics": "Enclosing radius R; each interior radius R/2. The interior circles touch each other and the enclosing circle at its horizontal extremes.",
              "answerVisibility": "Only the source geometry and requested shading are visible."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "Let the large circle have radius $R$. Each smaller circle has radius $\\frac{R}{2}$.\n$$\\begin{align*}\\text{Shaded fraction}&=\\frac{2\\pi(R/2)^2}{\\pi R^2}\\\\\\text{Shaded fraction}&=\\frac12.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q23-b",
        "type": "part",
        "label": "b",
        "prompt": "Use the diagram below.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [
          {
            "id": "p22-q23-b-diagram",
            "role": "question",
            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"shadedBlue\",\"hex\":\"D4E8FF\",\"reason\":\"requested shaded interior disks\"}],\"reference\":\"source page 22, p22-q23-b-diagram\"}\n\\begin{tikzpicture}\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{shadedBlue}{HTML}{D4E8FF}\n\\draw[black,line width=0.8pt] (0,0) circle[radius=3];\n\\draw[black,line width=0.8pt,fill=shadedBlue] (-2,0) circle[radius=1];\n\\draw[black,line width=0.8pt,fill=shadedBlue] (0,0) circle[radius=1];\n\\draw[black,line width=0.8pt,fill=shadedBlue] (2,0) circle[radius=1];\n\\end{tikzpicture}",
            "src": null,
            "widthMm": 40.7,
            "alt": "Mathematical diagram",
            "overlayOf": null,
            "transparent": false,
            "axes": null,
            "spec": {
              "sourcePage": 22,
              "sourceRegion": "Question 23(b), left column",
              "description": "Three equal shaded circles form a horizontal diameter chain inside an unshaded enclosing circle.",
              "mathematics": "Enclosing radius R; each interior radius R/3. Adjacent interior circles are tangent; the outer circles touch the enclosing circle at its horizontal extremes.",
              "answerVisibility": "Only the source geometry and requested shading are visible."
            },
            "derived": false,
            "reviewStatus": "needs-review"
          }
        ],
        "children": [],
        "answer": {
          "short": "$\\frac13$",
          "worked": "Let the large circle have radius $R$. Each smaller circle has radius $\\frac{R}{3}$.\n$$\\begin{align*}\\text{Shaded fraction}&=\\frac{3\\pi(R/3)^2}{\\pi R^2}\\\\\\text{Shaded fraction}&=\\frac13.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p22-q23-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the shaded fraction when there are $n$ equal interior circles arranged along a diameter as in parts (a) and (b), in terms of $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1n$\n\nEach interior radius is $\\frac{1}{n}$ of the large radius; add the areas of the $n$ interior circles.",
          "worked": "Let the large circle have radius $R$ and each interior circle have radius $r$. Their diameters fill the large diameter.\n$$\\begin{align*}2nr&=2R\\\\r&=\\frac{R}{n}.\\end{align*}$$\n$$\\begin{align*}\\text{Shaded fraction}&=\\frac{n\\pi(R/n)^2}{\\pi R^2}\\\\\\text{Shaded fraction}&=\\frac1n.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
    ]
  },
