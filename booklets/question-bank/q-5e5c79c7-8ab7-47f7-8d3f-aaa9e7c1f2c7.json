  "content": {
    "id": "p48-q7",
    "type": "question",
    "label": "7",
    "prompt": "Find all the values of $b$ for which $2x^2+x+b+1=0$ has two real solutions.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$b<-\\dfrac{7}{8}$; two distinct real solutions require $\\Delta>0$.",
      "worked": "The constant coefficient is $b+1$. Two distinct real solutions require $\\Delta>0$.\n$$\\begin{align*}\\Delta&=1^2-4(2)(b+1)\\\\\\Delta&=-8b-7\\\\-8b-7&>0\\\\-8b&>7\\\\b&<-\\frac{7}{8}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
