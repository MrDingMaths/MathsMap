  "content": {
    "id": "p73-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The integers from 1 to 10 inclusive are written on ten separate pieces of paper. Four pieces of paper are drawn at random. Find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p73-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "the four numbers drawn are 1, 2, 3 and 6,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{210}$",
          "worked": "There is one favourable set among $\\binom{10}{4}$ possible sets.\n$$\\begin{aligned}P&=\\frac{1}{\\binom{10}{4}}\\\\&=\\frac{1}{210}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p73-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "the number 9 is one of the numbers drawn,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2}{5}$",
          "worked": "Include 9 and choose the other three numbers from the remaining nine.\n$$\\begin{aligned}P&=\\frac{\\binom{9}{3}}{\\binom{10}{4}}\\\\&=\\frac{84}{210}\\\\&=\\frac{2}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p73-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "the number 8 is not drawn,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{5}$",
          "worked": "Choose all four numbers from the nine numbers other than 8.\n$$\\begin{aligned}P&=\\frac{\\binom{9}{4}}{\\binom{10}{4}}\\\\&=\\frac{126}{210}\\\\&=\\frac{3}{5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p73-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "the number 7 is drawn but the number 1 is not.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4}{15}$",
          "worked": "Include 7, exclude 1 and choose the other three numbers from the remaining eight.\n$$\\begin{aligned}P&=\\frac{\\binom{8}{3}}{\\binom{10}{4}}\\\\&=\\frac{56}{210}\\\\&=\\frac{4}{15}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
    ]
  },
