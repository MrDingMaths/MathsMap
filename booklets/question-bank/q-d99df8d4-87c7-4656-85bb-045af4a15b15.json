  "content": {
    "id": "p42-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The sum of two numbers is 1633 and their difference is 35. Find the two numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "834 and 799.",
      "worked": "Let $x$ be the larger number and $y$ the smaller number.\n$$\\begin{align*}x+y&=1633 &&(1)\\\\x-y&=35 &&(2)\\end{align*}$$\n$(1)+(2)$:\n$$\\begin{align*}2x&=1668\\\\x&=834\\end{align*}$$\nSubstitute $x=834$ into (1):\n$$\\begin{align*}834+y&=1633\\\\y&=799\\end{align*}$$\nThe two numbers are 834 and 799.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
