        "id": "p27-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2+12x+18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x+3)^2$",
          "worked": "$$\\begin{align*}2x^2+12x+18&=2(x^2+6x+9)\\\\&=2(x+3)^2\\end{align*}$$\nCheck: $2\\times x\\times3=6x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$3x^2-6x+3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x-1)^2$",
          "worked": "$$\\begin{align*}3x^2-6x+3&=3(x^2-2x+1)\\\\&=3(x-1)^2\\end{align*}$$\nCheck: $2\\times x\\times1=2x$; the middle term is negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$5x^2+20x+20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(x+2)^2$",
          "worked": "$$\\begin{align*}5x^2+20x+20&=5(x^2+4x+4)\\\\&=5(x+2)^2\\end{align*}$$\nCheck: $2\\times x\\times2=4x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p27-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2+16xy+16y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4(x+2y)^2$",
          "worked": "$$\\begin{align*}4x^2+16xy+16y^2&=4(x^2+4xy+4y^2)\\\\&=4(x+2y)^2\\end{align*}$$\nCheck: $2\\times x\\times2y=4xy$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p27-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$-2x^2+8x-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2(x-2)^2$",
          "worked": "$$\\begin{align*}-2x^2+8x-8&=-2(x^2-4x+4)\\\\&=-2(x-2)^2\\end{align*}$$\nCheck: $2\\times x\\times2=4x$; the middle term inside the brackets is negative.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
