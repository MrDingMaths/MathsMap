  "content": {
    "id": "p16-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "A student simplifies $\\dfrac{x^2+4}{x+2}$ and writes the answer as $x+2$. Explain the error.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x^2+4\\ne(x+2)^2$. The numerator has no factor $x+2$, so cancellation is not possible.",
      "worked": "$$(x+2)^2=x^2+4x+4\\ne x^2+4.$$ The expression $x^2+4$ cannot be factorised over the real numbers, so $x+2$ is not a factor of the numerator. Only common factors can be cancelled.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
  },
