  "content": {
    "id": "p39-challenge-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A cylindrical container of diameter $80\\text{ cm}$ and height $h\\text{ cm}$ is filled with water. How many cylinders of diameter $20\\text{ cm}$ and height $h\\text{ cm}$ would you need to hold the same amount of water?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "16 cylinders.\n\nWith equal heights, compare the squares of the radii.",
      "worked": "The radii are $40\\text{ cm}$ and $10\\text{ cm}$, and the heights are equal.\n\n$$\\text{Number}=\\frac{\\pi\\times40^2h}{\\pi\\times10^2h}=\\frac{1600}{100}=16.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 14
  },
