    "id": "p53-q54-root",
    "type": "question",
    "label": "54",
    "prompt": "For each of the following, determine if the sets are disjoint or not disjoint.\n$$\\begin{aligned}A&=[0,1]\\\\B&=(-\\infty,1]\\end{aligned}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Not disjoint; $A\\cap B=[0,1]$.",
      "worked": "Every member of $A$ belongs to $B$, so $A\\cap B=A=[0,1]$. This is nonempty.",
      "solutionDiagrams": []
