        "answer": {
          "short": "$(x+\\sqrt{5})(x-\\sqrt{5})$",
          "worked": "$$\\begin{align*}x^2-5&=x^2-(\\sqrt{5})^2\\\\x^2-5&=(x+\\sqrt{5})(x-\\sqrt{5})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-ch5-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$(x+2)^2-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+2-2\\sqrt{2})(x+2+2\\sqrt{2})$",
          "worked": "$$\\begin{align*}(x+2)^2-8&=(x+2)^2-(\\sqrt{8})^2\\\\(x+2)^2-8&=(x+2)^2-(2\\sqrt{2})^2\\\\(x+2)^2-8&=(x+2-2\\sqrt{2})(x+2+2\\sqrt{2})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p8-ch5-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$2(x-3)^2-10$",
