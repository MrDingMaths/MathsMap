        "children": [],
        "answer": {
          "short": "$2(x-3-\\sqrt{5})(x-3+\\sqrt{5})$",
          "worked": "$$\\begin{align*}2(x-3)^2-10&=2\\bigl((x-3)^2-5\\bigr)\\\\2(x-3)^2-10&=2\\bigl((x-3)^2-(\\sqrt{5})^2\\bigr)\\\\2(x-3)^2-10&=2(x-3-\\sqrt{5})(x-3+\\sqrt{5})\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
