  "content": {
    "id": "p11-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "A book has 150 pages. The book is randomly opened at a page.\nFind the probability that the page number is:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "greater than 140,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{15}$",
          "worked": "Pages 141 to 150 give 10 favourable outcomes.\n\n$$P(\\text{greater than }140)=\\frac{10}{150}=\\frac{1}{15}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "a multiple of 20",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7}{150}$",
          "worked": "The multiples are 20, 40, 60, 80, 100, 120 and 140: 7 favourable outcomes.\n\n$$P(\\text{multiple of }20)=\\frac{7}{150}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p11-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "an odd number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "There are 75 odd page numbers from 1 to 149.\n\n$$P(\\text{odd})=\\frac{75}{150}=\\frac{1}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "a number less than 25,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{25}$",
          "worked": "Pages 1 to 24 give 24 favourable outcomes.\n\n$$P(\\text{less than }25)=\\frac{24}{150}=\\frac{4}{25}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-e",
        "type": "part",
        "label": "e",
        "prompt": "either 72 or 111",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{75}$",
          "worked": "The two favourable page numbers are 72 and 111.\n\n$$P(72\\text{ or }111)=\\frac{2}{150}=\\frac{1}{75}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p11-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "a three-digit number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{17}{50}$",
          "worked": "The three-digit page numbers run from 100 to 150 inclusive, giving $150-100+1=51$ favourable outcomes.\n\n$$P(\\text{three digits})=\\frac{51}{150}=\\frac{17}{50}$$",
