    "label": null,
    "prompt": "Find the value(s) of $k$ so that $x^2+3x+k=0$ has two equal roots.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$k=\\frac{9}{4}$.\n\nSet $\\Delta=0$.",
      "worked": "For equal roots, $\\Delta=b^2-4ac=0$.\n\n$$\\begin{align*}3^2-4(1)k &= 0\\\\9-4k &= 0\\\\k &= \\frac{9}{4}\\end{align*}$$",
      "solutionDiagrams": []
