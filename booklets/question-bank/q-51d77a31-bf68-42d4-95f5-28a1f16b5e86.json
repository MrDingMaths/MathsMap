  "content": {
    "id": "p24-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "A bag of ants is 4 kg. Each ant is roughly 0.000 002 kg.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "First, express 0.000 002 kg in scientific notation:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\times10^{-6}$ kg",
          "worked": "Move the decimal point six places to the right to obtain 2, so the exponent is $-6$.\n$$0.000\\,002\\text{ kg}=2\\times10^{-6}\\text{ kg}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p24-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine how many ants are in each bag.\nYou shouldn’t need a calculator if you know your index laws!",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "About $2\\times10^6$ ants; divide the bag’s mass by the mass of one ant.",
          "worked": "$$\\begin{align*}\\text{Number of ants}&=\\frac{4}{2\\times10^{-6}}\\\\&=2\\times10^{0-(-6)}\\\\&=2\\times10^6\\end{align*}$$\nThere are about $2\\times10^6$ ants in each bag.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "If an average ant weighs 2 mg and there are around 20 quadrillion ($20\\times10^{15}$) ants in the world, how much do all the ants in the world weigh?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "About $4\\times10^{10}$ kg; use $2\\text{ mg}=2\\times10^{-6}\\text{ kg}$ and multiply by the number of ants.",
          "worked": "$$2\\text{ mg}=2\\times10^{-6}\\text{ kg}$$\n$$\\begin{align*}\\text{Total ant mass}&=(20\\times10^{15})(2\\times10^{-6})\\text{ kg}\\\\&=40\\times10^{15-6}\\text{ kg}\\\\&=40\\times10^9\\text{ kg}\\\\&=4\\times10^{10}\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "If an average human weighs 60 kg and there are 8 billion ($8\\times10^9$) humans, how much do all the humans in the world weigh?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "About $4.8\\times10^{11}$ kg; multiply 60 kg by $8\\times10^9$.",
          "worked": "$$\\begin{align*}\\text{Total human mass}&=60(8\\times10^9)\\text{ kg}\\\\&=480\\times10^9\\text{ kg}\\\\&=4.8\\times10^{11}\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p24-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "Do all the ants in the world weigh more or all the humans?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All the humans; $4.8\\times10^{11}\\text{ kg}>4\\times10^{10}\\text{ kg}$.",
          "worked": "$$4.8\\times10^{11}\\text{ kg}=48\\times10^{10}\\text{ kg}>4\\times10^{10}\\text{ kg}$$\nAll the humans weigh more.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
