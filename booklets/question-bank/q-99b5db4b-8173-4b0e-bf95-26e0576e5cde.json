  "content": {
    "id": "p3-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Suppose the sample space $\\Omega$ contains $n$ distinct outcomes. Find an expression for the total number of events.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2^n$",
      "worked": "An event is a subset of $\\Omega$. Each of the $n$ outcomes has two choices: it is included in the event or excluded. By the multiplication principle, the total number of events is $2^n$, including the empty event and $\\Omega$ itself.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
