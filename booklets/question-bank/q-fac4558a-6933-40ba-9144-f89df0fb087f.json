  "content": {
    "id": "p26-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "For each of the following functions, state the values of $x$ for which $f(x)$ is increasing.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=x^2-4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>2$.",
          "worked": "$$y'=2x-4$$\nFor the function to be increasing, $2x-4>0$.\n$$\\begin{align*}2x&>4\\\\x&>2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p26-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=6+4x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x<2$.",
          "worked": "$$y'=4-2x$$\nFor the function to be increasing, $4-2x>0$.\n$$\\begin{align*}2x&<4\\\\x&<2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p26-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=x^3-3x^2-9x+27$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p26-q5-c-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "x<-1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " or ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "x>3",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              },
              {
                "id": "p26-q5-c-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The factored derivative is positive outside its two zeros.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}y'&=3x^2-6x-9\\\\y'&=3(x+1)(x-3)\\end{align*}$$\nThe zeros are $x=-1$ and $x=3$. The factors are both negative for $x<-1$ and both positive for $x>3$. Between the zeros they have opposite signs. Hence the function is increasing for $x<-1$ or $x>3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
