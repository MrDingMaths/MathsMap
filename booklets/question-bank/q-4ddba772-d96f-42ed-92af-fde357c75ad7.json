      {
        "id": "p40-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$5(x-4)+3(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2(x-4)$",
          "worked": "$$\\begin{align*}5(x-4)+3(4-x)&=5(x-4)-3(x-4)\\\\&=(x-4)(5-3)\\\\&=2(x-4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p40-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$x(x-4)-3(4-x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+3)(x-4)$",
          "worked": "$$\\begin{align*}x(x-4)-3(4-x)&=x(x-4)+3(x-4)\\\\&=(x-4)(x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p40-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$2x(3-x)+5(x-3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(5-2x)(x-3)$",
          "worked": "$$\\begin{align*}2x(3-x)+5(x-3)&=-2x(x-3)+5(x-3)\\\\&=(x-3)(5-2x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p40-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2(2-x)-4(x-2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x^2+4)(2-x)$",
          "worked": "$$\\begin{align*}x^2(2-x)-4(x-2)&=x^2(2-x)+4(2-x)\\\\&=(2-x)(x^2+4)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
