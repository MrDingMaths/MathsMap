        "children": [],
        "answer": {
          "short": "$18.6\\%$",
          "worked": "Multiply the annual increase multipliers, retaining the full product until the final rounding.\n\n$$\\begin{aligned}M&=1.023\\times1.027\\times1.038\\times1.023\\times1.044\\times1.018\\\\M&=1.185679582108761216\\end{aligned}$$\n\n$$\\begin{aligned}\\text{Percentage increase}&=(1.185679582108761216-1)\\times100\\%\\\\\\text{Percentage increase}&\\approx18.6\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "during the first four-year period",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$11.6\\%$",
          "worked": "Use the rates for the years ending June 2005, 2006, 2007 and 2008.\n\n$$\\begin{aligned}M&=1.023\\times1.027\\times1.038\\times1.023\\\\M&=1.115627123754\\end{aligned}$$\n\n$$\\begin{aligned}\\text{Percentage increase}&=(1.115627123754-1)\\times100\\%\\\\\\text{Percentage increase}&\\approx11.6\\%\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
