  "content": {
    "id": "p39-q3",
    "type": "question",
    "label": "3",
    "prompt": "Jenni works as a secretary and earns a salary of \\$58 600 per year.\nAt the end of the year her employer pays her a bonus of three months’ salary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p39-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate Jenni’s bonus.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$14 650",
          "worked": "$$\\begin{align*}\\text{Bonus} &= 58\\,600 \\div 12 \\times 3 \\\\ &= \\$14\\,650\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p39-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate her total annual earnings.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$73 250",
          "worked": "$$\\begin{align*}\\text{Total annual earnings} &= 58\\,600 + 14\\,650 \\\\ &= \\$73\\,250\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
