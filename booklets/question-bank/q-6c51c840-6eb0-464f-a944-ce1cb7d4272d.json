      {
        "id": "p8-p2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{12^x}{8^x}\\times\\frac{6^x}{3^x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3^x$",
          "worked": "$$\\begin{align*}\\frac{12^x}{8^x}\\times\\frac{6^x}{3^x}&=\\left(\\frac{12\\times6}{8\\times3}\\right)^x\\\\\\frac{12^x}{8^x}\\times\\frac{6^x}{3^x}&=3^x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p8-p2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^{10x}$",
          "worked": "$$\\begin{align*}\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=\\sqrt{2^{4x}\\times2^{4x}\\times2^{12x}}\\\\\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=\\sqrt{2^{20x}}\\\\\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=(2^{20x})^{1/2}\\\\\\sqrt{2^{4x}\\times4^{2x}\\times8^{4x}}&=2^{10x}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
