  "content": {
    "id": "p20-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Determine if each given ordered pair $(x,y)$ is a solution of the corresponding system of equations.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q1a",
        "type": "part",
        "label": "a",
        "prompt": "$(x,y)=(3,4)$\n$$\\begin{aligned}y&=2x-2\\\\y&=x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}2x-2&=2(3)-2\\\\2x-2&=4=y\\\\x+1&=3+1\\\\x+1&=4=y\\end{align*}$$\nBoth equations are satisfied, so $(3,4)$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p20-q1b",
        "type": "part",
        "label": "b",
        "prompt": "$(x,y)=(3,5)$\n$$\\begin{aligned}y&=x+2\\\\y&=2x-2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}x+2&=3+2\\\\x+2&=5=y\\\\2x-2&=2(3)-2\\\\2x-2&=4\\ne y\\end{align*}$$\nThe second equation is not satisfied, so $(3,5)$ is not a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p20-q1c",
        "type": "part",
        "label": "c",
        "prompt": "$(x,y)=(1,2)$\n$$\\begin{aligned}x+y&=3\\\\y-x&=1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}x+y&=1+2\\\\x+y&=3\\\\y-x&=2-1\\\\y-x&=1\\end{align*}$$\nBoth equations are satisfied, so $(1,2)$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p20-q1d",
        "type": "part",
        "label": "d",
        "prompt": "$(x,y)=(-2,1)$\n$$\\begin{aligned}3y+2x&=-1\\\\2y-3x&=9\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}3y+2x&=3(1)+2(-2)\\\\3y+2x&=-1\\\\2y-3x&=2(1)-3(-2)\\\\2y-3x&=8\\ne9\\end{align*}$$\nThe second equation is not satisfied, so $(-2,1)$ is not a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p20-q1e",
        "type": "part",
        "label": "e",
        "prompt": "$(x,y)=\\left(\\frac12,2\\right)$\n$$\\begin{aligned}4x+y&=4\\\\6x-2y&=-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "$$\\begin{align*}4x+y&=4\\left(\\frac12\\right)+2\\\\4x+y&=4\\\\6x-2y&=6\\left(\\frac12\\right)-2(2)\\\\6x-2y&=-1\\end{align*}$$\nBoth equations are satisfied, so $\\left(\\frac12,2\\right)$ is a solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
  },
