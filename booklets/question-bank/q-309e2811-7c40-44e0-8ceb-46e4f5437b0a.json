    "children": [
      {
        "id": "p14-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Using subtraction, write down an expression for the remaining area.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^2-b^2$",
          "worked": "Remaining area = original square area − removed square area.\n$$a^2-b^2$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p14-q12-b",
        "type": "group",
        "label": "b",
        "prompt": "Write expressions for the area of the regions:",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p14-q12-b-i",
            "type": "part",
            "label": "i",
            "prompt": "A",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(a-b)^2$",
              "worked": "Region A is a square with side length $a-b$.\n$$\\begin{aligned}A&=(a-b)(a-b)\\\\&=(a-b)^2\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p14-q12-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "B",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b(a-b)$",
              "worked": "Region B is a rectangle with side lengths $b$ and $a-b$.\n$$B=b(a-b)$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p14-q12-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "C",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$b(a-b)$",
              "worked": "Region C is a rectangle with side lengths $b$ and $a-b$.\n$$C=b(a-b)$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p14-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Add all the expressions from part **b** and confirm you get your answer from part **a**.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a-b)^2+b(a-b)+b(a-b)=a^2-b^2$, agreeing with part a.",
          "worked": "$$\\begin{aligned}(a-b)^2+b(a-b)+b(a-b)&=a^2-2ab+b^2+ab-b^2+ab-b^2\\\\&=a^2-b^2\\end{aligned}$$\nThis agrees with the remaining area found in part a.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
