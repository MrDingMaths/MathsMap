  "content": {
    "id": "v2-725bd-p30-practice-slot-8-root",
    "type": "question",
    "label": null,
    "prompt": "Find the ratio $r:s$ if $r\\underset{\\sim}{a}+s\\underset{\\sim}{b}=0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-725bd-p30-practice-slot-8-slot-8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=2i-3j$ and $\\underset{\\sim}{b}=-6i+9j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r:s=3:1$",
          "worked": "$$\\begin{aligned}r(2i-3j)+s(-6i+9j)&=0\\\\(2r-6s)i+(-3r+9s)j&=0\\end{aligned}$$\nEquate both components:\n$$\\begin{aligned}2r-6s&=0\\\\r&=3s\\\\-3r+9s&=0\\\\r&=3s\\end{aligned}$$\nThus $r:s=3:1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-725bd-p30-practice-slot-8-slot-8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}=4i+6j$ and $\\underset{\\sim}{b}=10i+15j$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$r:s=-5:2$",
          "worked": "$$\\begin{aligned}r(4i+6j)+s(10i+15j)&=0\\\\(4r+10s)i+(6r+15s)j&=0\\end{aligned}$$\nEquate both components:\n$$\\begin{aligned}4r+10s&=0\\\\2r&=-5s\\\\6r+15s&=0\\\\2r&=-5s\\end{aligned}$$\nThus $r:s=-5:2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
