  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write using a single logarithm:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_2 3+\\log_2 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 15$",
          "worked": "$$\\begin{align*}\\log_2 3+\\log_2 5&=\\log_2(3\\times5)\\\\\\log_2 3+\\log_2 5&=\\log_2 15\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_3 12-\\log_3 6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 2$",
          "worked": "$$\\begin{align*}\\log_3 12-\\log_3 6&=\\log_3\\frac{12}{6}\\\\\\log_3 12-\\log_3 6&=\\log_3 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_2 5+2\\log_2 6-\\log_2 10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 18$",
          "worked": "$$\\begin{align*}\\log_2 5+2\\log_2 6-\\log_2 10&=\\log_2 5+\\log_2 36-\\log_2 10\\\\\\log_2 5+2\\log_2 6-\\log_2 10&=\\log_2\\frac{5\\times36}{10}\\\\\\log_2 5+2\\log_2 6-\\log_2 10&=\\log_2 18\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_4 4+2\\log_4 6-\\log_4 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4 48$",
          "worked": "$$\\begin{align*}\\log_4 4+2\\log_4 6-\\log_4 3&=\\log_4 4+\\log_4 36-\\log_4 3\\\\\\log_4 4+2\\log_4 6-\\log_4 3&=\\log_4\\frac{4\\times36}{3}\\\\\\log_4 4+2\\log_4 6-\\log_4 3&=\\log_4 48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\log_5 3+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5 45$",
          "worked": "$$\\begin{align*}2\\log_5 3+1&=\\log_5 9+\\log_5 5\\\\2\\log_5 3+1&=\\log_5(9\\times5)\\\\2\\log_5 3+1&=\\log_5 45\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\log_4 5+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4 80$",
          "worked": "$$\\begin{align*}\\log_4 5+2&=\\log_4 5+\\log_4 16\\\\\\log_4 5+2&=\\log_4(5\\times16)\\\\\\log_4 5+2&=\\log_4 80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\log_2 12-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 6$",
          "worked": "$$\\begin{align*}\\log_2 12-1&=\\log_2 12-\\log_2 2\\\\\\log_2 12-1&=\\log_2\\frac{12}{2}\\\\\\log_2 12-1&=\\log_2 6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac12\\log_2 121+\\log_2 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_2 33$",
          "worked": "$$\\begin{align*}\\frac12\\log_2 121+\\log_2 3&=\\log_2 11+\\log_2 3\\\\\\frac12\\log_2 121+\\log_2 3&=\\log_2(11\\times3)\\\\\\frac12\\log_2 121+\\log_2 3&=\\log_2 33\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\log_5 50-2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_5 2$",
          "worked": "$$\\begin{align*}\\log_5 50-2&=\\log_5 50-\\log_5 25\\\\\\log_5 50-2&=\\log_5\\frac{50}{25}\\\\\\log_5 50-2&=\\log_5 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\log_3 2+\\log_3 4+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_3 24$",
          "worked": "$$\\begin{align*}\\log_3 2+\\log_3 4+1&=\\log_3 2+\\log_3 4+\\log_3 3\\\\\\log_3 2+\\log_3 4+1&=\\log_3(2\\times4\\times3)\\\\\\log_3 2+\\log_3 4+1&=\\log_3 24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p7-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\log_4 12-2\\log_4 2+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\log_4 48$",
          "worked": "$$\\begin{align*}\\log_4 12-2\\log_4 2+2&=\\log_4 12-\\log_4 4+\\log_4 16\\\\\\log_4 12-2\\log_4 2+2&=\\log_4\\frac{12\\times16}{4}\\\\\\log_4 12-2\\log_4 2+2&=\\log_4 48\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
