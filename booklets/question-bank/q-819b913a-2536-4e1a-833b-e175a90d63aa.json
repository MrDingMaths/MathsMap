  "content": {
    "id": "p13-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The population of a country is increasing at a yearly rate of $6.9\\%$; that is, $\\dfrac{dP}{dt}=0.069P$.\n\nIf the population was $50000$ at the start of 2015, find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "a formula for the population growth in terms of $e$ and $t$, where $t$ is the number of years after the start of 2015.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=50000e^{0.069t}$, where $t$ is measured in years after the start of 2015.",
          "worked": "$$\\begin{align*}P&=Ae^{kt}\\\\P'&=kAe^{kt}\\\\P'&=kP\\\\P'&=0.069P\\end{align*}$$\nThus $k=0.069$. Initially $t=0$ and $P=50000$, so $A=50000$.\n$$P=50000e^{0.069t}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p13-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "the population in the year 2020, to the nearest person.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70599$ people.",
          "worked": "At the start of 2020, $t=5$.\n$$\\begin{align*}P(5)&=50000e^{0.069\\times5}\\\\P(5)&\\approx70599\\text{ people}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p13-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "the rate at which the population will be growing in the year 2020, to the nearest person per year.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4871$ people per year.",
          "worked": "$$\\begin{align*}P'(5)&=0.069P(5)\\\\P'(5)&=0.069\\times50000e^{0.069\\times5}\\\\P'(5)&\\approx4871\\text{ people per year}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p13-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "in which year the population will reach $300000$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Towards the end of 2040.",
          "worked": "$$\\begin{align*}300000&=50000e^{0.069t}\\\\e^{0.069t}&=6\\\\0.069t&=\\ln 6\\\\t&=\\frac{\\ln 6}{0.069}\\\\t&\\approx25.97\\text{ years}.\\end{align*}$$\nThis is about $25.97$ years after the start of 2015, towards the end of 2040.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
