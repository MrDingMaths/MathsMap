  "content": {
    "id": "p49-q4",
    "type": "question",
    "label": "4",
    "prompt": "Find the value of $k$ in these polynomials.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "When $P(x)=x^3+2x^2+kx-4$ is divided by $(x-1)$, the remainder is $4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=5$",
          "worked": "$$\\begin{align*}P(1)&=4\\\\1^3+2(1)^2+k(1)-4&=4\\\\k-1&=4\\\\k&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p49-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "When $P(x)=2x^3+kx^2+3x-4$ is divided by $(x+2)$, the remainder is $-6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=5$",
          "worked": "$$\\begin{align*}P(-2)&=-6\\\\2(-2)^3+k(-2)^2+3(-2)-4&=-6\\\\4k-26&=-6\\\\4k&=20\\\\k&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p49-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "When $P(x)=kx^3+7x^2-x-4$ is divided by $(x-2)$, the remainder is $-2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-3$",
          "worked": "$$\\begin{align*}P(2)&=-2\\\\k(2)^3+7(2)^2-2-4&=-2\\\\8k+22&=-2\\\\8k&=-24\\\\k&=-3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
