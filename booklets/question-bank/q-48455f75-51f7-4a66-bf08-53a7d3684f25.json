    "prompt": "Evaluate all the powers of 5 up to $5^5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5^1=5$, $5^2=25$, $5^3=125$, $5^4=625$, $5^5=3125$.",
      "worked": "$$\\begin{align*}5^1&=5\\\\5^2&=5\\times5=25\\\\5^3&=5\\times5\\times5=125\\\\5^4&=5\\times5\\times5\\times5=625\\\\5^5&=5\\times5\\times5\\times5\\times5=3125\\end{align*}$$",
      "solutionDiagrams": []
