  "content": {
    "id": "p28-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "A fruit blend can be made from a selection of six different fruits. How many different blends can be made assuming at least one type of fruit is used?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "63 blends.",
      "worked": "Each fruit is either included or excluded, giving $2^6$ subsets. Exclude the empty subset because at least one type of fruit must be used.\n\n$$\\begin{align*}\\text{Number of blends}&=2^6-1\\\\\\text{Number of blends}&=64-1\\\\\\text{Number of blends}&=63.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
