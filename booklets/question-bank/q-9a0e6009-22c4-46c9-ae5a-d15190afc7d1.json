  "content": {
    "id": "p28-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Money borrowed at an interest rate of $8\\%$ p.a., compounded annually, grew to $\\$100\\,000$ in seven years. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p28-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "the original amount invested, correct to the nearest cent",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$58\\,349.04$",
          "worked": "$$\\begin{align*}A_n&=P(1+R)^n\\\\100\\,000&=P(1.08)^7\\\\P&=\\frac{100\\,000}{(1.08)^7}\\\\P&\\approx\\$58\\,349.04\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p28-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "the total percentage increase in the investment, correct to the nearest $1\\%$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$71\\%$",
          "worked": "The final amount is $(1.08)^7$ times the original amount.\n\n$$\\begin{align*}\\text{Percentage increase}&=\\big((1.08)^7-1\\big)\\times100\\%\\\\\\text{Percentage increase}&=71.38242687795208\\ldots\\%\\\\\\text{Percentage increase}&\\approx71\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
