        "children": [],
        "answer": {
          "short": "$\\frac98$",
          "worked": "$a=1$, $r=\\frac1{3^2}=\\frac19$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac1{1-\\frac19}\\\\S&=\\frac98\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$1-\\frac1{4^2}+\\frac1{4^4}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{16}{17}$",
          "worked": "$a=1$, $r=-\\frac1{4^2}=-\\frac1{16}$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac1{1-(-\\frac1{16})}\\\\S&=\\frac{16}{17}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac25+\\frac2{5^3}+\\frac2{5^5}+\\cdots$",
