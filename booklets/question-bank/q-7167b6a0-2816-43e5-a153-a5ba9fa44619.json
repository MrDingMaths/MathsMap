        "children": [],
        "answer": {
          "short": "$\\frac{24}{7}$",
          "worked": "$a=3$, $r=\\frac1{2^3}=\\frac18$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac3{1-\\frac18}\\\\S&=\\frac{24}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-n",
        "type": "part",
        "label": "n",
        "prompt": "$12-9+\\frac{27}{4}-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{48}{7}$",
          "worked": "$a=12$.\n\n$$\\begin{align*}r&=\\frac{-9}{12}\\\\r&=-\\frac34\\end{align*}$$\n\nSince $|r|<1$,\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac{12}{1-(-\\frac34)}\\\\S&=\\frac{48}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
