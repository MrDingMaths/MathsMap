  "content": {
    "id": "p22-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the sum of each of the following infinite geometric series:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac13+\\frac1{3^2}+\\frac1{3^3}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$a=\\frac13$, $r=\\frac13$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac{\\frac13}{1-\\frac13}\\\\S&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$1+\\frac14+\\frac1{4^2}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac43$",
          "worked": "$a=1$, $r=\\frac14$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac1{1-\\frac14}\\\\S&=\\frac43\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac25+\\frac2{5^2}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac12$",
          "worked": "$a=\\frac25$, $r=\\frac15$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac{\\frac25}{1-\\frac15}\\\\S&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$1-\\frac12+\\frac14-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac23$",
          "worked": "$a=1$, $r=-\\frac12$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac1{1-(-\\frac12)}\\\\S&=\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$2-\\frac23+\\frac29-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32$",
          "worked": "$a=2$, $r=-\\frac13$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac2{1-(-\\frac13)}\\\\S&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$3+\\frac37+\\frac3{7^2}+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac72$",
          "worked": "$a=3$, $r=\\frac17$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac3{1-\\frac17}\\\\S&=\\frac72\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac23+\\left(\\frac23\\right)^2+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$a=\\frac23$, $r=\\frac23$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac{\\frac23}{1-\\frac23}\\\\S&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$2-\\frac23+\\frac2{3^2}-\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac32$",
          "worked": "$a=2$, $r=-\\frac13$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac2{1-(-\\frac13)}\\\\S&=\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$1+\\frac45+\\left(\\frac45\\right)^2+\\cdots$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$a=1$, $r=\\frac45$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac1{1-\\frac45}\\\\S&=5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$1+\\frac1{3^2}+\\frac1{3^4}+\\cdots$",
        "layout": "list",
        "columns": null,
