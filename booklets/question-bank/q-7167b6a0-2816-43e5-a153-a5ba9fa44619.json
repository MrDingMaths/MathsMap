        "children": [],
        "answer": {
          "short": "$\\frac5{12}$",
          "worked": "$a=\\frac25$, $r=\\frac1{5^2}=\\frac1{25}$ and $|r|<1$.\n\n$$\\begin{align*}S&=\\frac{a}{1-r}\\\\S&=\\frac{\\frac25}{1-\\frac1{25}}\\\\S&=\\frac5{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p22-q2-m",
        "type": "part",
        "label": "m",
        "prompt": "$3+\\frac3{2^3}+\\frac3{2^6}+\\cdots$",
        "layout": "list",
        "columns": null,
