        "id": "p140-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $f(g(3))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$24$",
          "worked": "$$\\begin{align*}f(g(3))&=f(5)\\\\f(g(3))&=5^2-1\\\\f(g(3))&=24\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p140-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $g(f(3))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}g(f(3))&=g(8)\\\\g(f(3))&=8+2\\\\g(f(3))&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p140-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the rules for $f(g(x))$ and $g(f(x))$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(g(x))=x^2+4x+3$.\n\n$g(f(x))=x^2+1$.",
          "worked": "$$\\begin{align*}f(g(x))&=f(x+2)\\\\f(g(x))&=(x+2)^2-1\\\\f(g(x))&=x^2+4x+4-1\\\\f(g(x))&=x^2+4x+3\\end{align*}$$\n\n$$\\begin{align*}g(f(x))&=g(x^2-1)\\\\g(f(x))&=(x^2-1)+2\\\\g(f(x))&=x^2+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
