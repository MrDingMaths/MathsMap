        "label": "b",
        "prompt": "$2x^{3} \\times 6x^{4} \\div 4x^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^{5}$",
          "worked": "$$\\begin{align*}\n2x^{3} \\times 6x^{4} \\div 4x^{2} &= \\frac{2\\times6\\,x^{3 + 4 - 2}}{4} \\\\\n&= 3x^{5}\n\\end{align*}$$",
