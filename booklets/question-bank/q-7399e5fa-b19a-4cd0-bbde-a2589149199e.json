        "prompt": "$\\frac{6x^{5} \\times 2x^{3}}{4x^{4}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^{4}$",
          "worked": "$$\\begin{align*}\n\\frac{6x^{5} \\times 2x^{3}}{4x^{4}} &= \\frac{6\\times2\\,x^{5 + 3 - 4}}{4} \\\\\n&= 3x^{4}\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "index-t5-q11-b",
