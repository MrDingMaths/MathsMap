      {
        "id": "p5-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$(x+1)(x+2)(x+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3+6x^2+11x+6$",
          "worked": "$$\\begin{align*}(x+1)(x+2)(x+3)&=(x^2+3x+2)(x+3)\\\\(x+1)(x+2)(x+3)&=x^3+3x^2+2x+3x^2+9x+6\\\\(x+1)(x+2)(x+3)&=x^3+6x^2+11x+6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$(m+2)(m-2)(m+3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^3+3m^2-4m-12$",
          "worked": "$$\\begin{align*}(m+2)(m-2)(m+3)&=(m^2+2m-2m-4)(m+3)\\\\(m+2)(m-2)(m+3)&=(m^2-4)(m+3)\\\\(m+2)(m-2)(m+3)&=m^3-4m+3m^2-12\\\\(m+2)(m-2)(m+3)&=m^3+3m^2-4m-12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p5-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$(x-2)(x+5)(x-5)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^3-2x^2-25x+50$",
          "worked": "$$\\begin{align*}(x-2)(x+5)(x-5)&=(x-2)(x^2+5x-5x-25)\\\\(x-2)(x+5)(x-5)&=(x-2)(x^2-25)\\\\(x-2)(x+5)(x-5)&=x^3-2x^2-25x+50\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p5-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$(m-2)(m-4)(m-8)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m^3-14m^2+56m-64$",
          "worked": "$$\\begin{align*}(m-2)(m-4)(m-8)&=(m^2-2m-4m+8)(m-8)\\\\(m-2)(m-4)(m-8)&=(m^2-6m+8)(m-8)\\\\(m-2)(m-4)(m-8)&=m^3-6m^2+8m-8m^2+48m-64\\\\(m-2)(m-4)(m-8)&=m^3-14m^2+56m-64\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
