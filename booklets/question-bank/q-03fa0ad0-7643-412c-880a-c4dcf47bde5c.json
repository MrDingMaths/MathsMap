  "content": {
    "id": "p28-q1-response",
    "type": "question",
    "label": "1",
    "prompt": "The graph of the cubic $y=P(x)$ has $x$-intercepts at $x=2,3,4$ and passes through the point $(1,24)$. Determine $P(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$P(x)=-4(x-2)(x-3)(x-4)$.",
      "worked": "By the Factor Theorem, $P(x)=a(x-2)(x-3)(x-4)$. Since $P(1)=24$,\n$$\\begin{align*}a(1-2)(1-3)(1-4)&=24\\\\-6a&=24\\\\a&=-4.\\end{align*}$$\nTherefore, $P(x)=-4(x-2)(x-3)(x-4)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
