  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Evaluate these definite integrals.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_1^4(x+2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$13.5$",
          "worked": "$$\\begin{aligned}\\int_1^4(x+2)\\,dx&=\\left[\\frac{x^2}{2}+2x\\right]_1^4\\\\&=(8+8)-\\left(\\frac12+2\\right)\\\\&=\\frac{27}{2}\\\\&=13.5\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p30-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_0^2(x^2+x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{14}{3}$",
          "worked": "$$\\begin{aligned}\\int_0^2(x^2+x)\\,dx&=\\left[\\frac{x^3}{3}+\\frac{x^2}{2}\\right]_0^2\\\\&=\\left(\\frac83+2\\right)-0\\\\&=\\frac{14}{3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_0^3(x^3+x^2)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{117}{4}$",
          "worked": "$$\\begin{aligned}\\int_0^3(x^3+x^2)\\,dx&=\\left[\\frac{x^4}{4}+\\frac{x^3}{3}\\right]_0^3\\\\&=\\left(\\frac{81}{4}+9\\right)-0\\\\&=\\frac{117}{4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p30-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\displaystyle\\int_{-1}^1(x^3-x+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{aligned}\\int_{-1}^1(x^3-x+1)\\,dx&=\\left[\\frac{x^4}{4}-\\frac{x^2}{2}+x\\right]_{-1}^1\\\\&=\\left(\\frac14-\\frac12+1\\right)-\\left(\\frac14-\\frac12-1\\right)\\\\&=\\frac34-\\left(-\\frac54\\right)\\\\&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p30-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\displaystyle\\int_{-2}^3(2x^2-3x+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{125}{6}$",
          "worked": "$$\\begin{aligned}\\int_{-2}^3(2x^2-3x+1)\\,dx&=\\left[\\frac{2x^3}{3}-\\frac{3x^2}{2}+x\\right]_{-2}^3\\\\&=\\left(18-\\frac{27}{2}+3\\right)-\\left(-\\frac{16}{3}-6-2\\right)\\\\&=\\frac{15}{2}+\\frac{40}{3}\\\\&=\\frac{125}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p30-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\displaystyle\\int_{-4}^{-2}(16-x^3-x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$98$",
          "worked": "$$\\begin{aligned}\\int_{-4}^{-2}(16-x^3-x)\\,dx&=\\left[16x-\\frac{x^4}{4}-\\frac{x^2}{2}\\right]_{-4}^{-2}\\\\&=(-32-4-2)-(-64-64-8)\\\\&=-38-(-136)\\\\&=98\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
