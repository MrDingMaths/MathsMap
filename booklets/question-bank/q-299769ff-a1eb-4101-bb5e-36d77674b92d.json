  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Jackson says: “$2.3 \\times 10^{4} = 230\\,000$”\n\nExplain why he is incorrect and write $2.3 \\times 10^{4}$ in decimal form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$23\\,000$. Jackson moved the decimal point 5 places instead of 4.",
      "worked": "Jackson moved the decimal point 5 places to the right instead of 4.\n$$\\begin{align*}2.3 \\times 10^{4} &= 2.3 \\times 10\\,000\\\\2.3 \\times 10^{4} &= 23\\,000\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
