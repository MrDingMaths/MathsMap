        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(n+1)(n-1)$",
          "worked": "$$\\begin{align*}\\frac{(n+1)!\\,(n-1)!}{n!\\,(n-2)!}&=\\frac{(n+1)n!\\,(n-1)(n-2)!}{n!\\,(n-2)!}\\\\&=(n+1)(n-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-cdb2ac-p6-practice-j3-133602-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{(n+1)!\\,(n-2)!}{(n-1)!\\,n!}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{n+1}{n-1}$",
          "worked": "$$\\begin{align*}\\frac{(n+1)!\\,(n-2)!}{(n-1)!\\,n!}&=\\frac{(n+1)n!\\,(n-2)!}{(n-1)(n-2)!\\,n!}\\\\&=\\frac{n+1}{n-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
