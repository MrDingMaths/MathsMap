  "content": {
    "id": "p30-q15",
    "type": "question",
    "label": "15",
    "prompt": "A particle is projected from a point $O$ with initial speed $V$ m/s at an angle of $\\theta$ to the horizontal. After 2 seconds its horizontal and vertical displacements from $O$ are both 30 m. Use $g=10\\text{ m s}^{-2}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $V\\cos\\theta=15$ and $V\\sin\\theta=25$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V\\cos\\theta=15$ and $V\\sin\\theta=25$.",
          "worked": "$$\\begin{aligned}x(2)&=2V\\cos\\theta=30\\\\V\\cos\\theta&=15\\\\y(2)&=-5(2)^2+2V\\sin\\theta=30\\\\2V\\sin\\theta&=50\\\\V\\sin\\theta&=25\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p30-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that $V=5\\sqrt{34}\\text{ m/s}$ and $\\theta=\\tan^{-1}\\!\\left(\\frac{5}{3}\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$V=5\\sqrt{34}\\text{ m/s}$ and $\\theta=\\tan^{-1}\\!\\left(\\frac{5}{3}\\right)$.",
          "worked": "$$\\begin{aligned}V&=\\sqrt{15^2+25^2}\\\\V&=\\sqrt{225+625}\\\\V&=5\\sqrt{34}\\text{ m/s}\\end{aligned}$$\n$$\\begin{aligned}\\tan\\theta&=\\frac{25}{15}=\\frac{5}{3}\\\\\\theta&=\\tan^{-1}\\!\\left(\\frac{5}{3}\\right)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
