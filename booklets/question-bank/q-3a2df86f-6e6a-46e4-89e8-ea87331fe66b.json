  "content": {
    "id": "v2-3b8ba3-p44-section-slot-8-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A parabola has $x$-intercepts at $x=-2$ and $x=4$. It passes through the point $(3,5)$. Find the equation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-(x+2)(x-4)$",
      "worked": "$$\\begin{align*}y&=k(x+2)(x-4)\\\\5&=k(3+2)(3-4)\\\\5&=-5k\\\\k&=-1\\\\\\therefore y&=-(x+2)(x-4)\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
