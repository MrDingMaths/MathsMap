  "content": {
    "id": "p4-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Write in the box the number needed to make each statement true.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p4-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$2^8\\div2^5=2^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}2^8\\div2^5&=2^{8-5}\\\\2^8\\div2^5&=2^3\\end{align*}$$\n\nThe missing number is $3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$5^3\\times5^2=5^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$",
          "worked": "$$\\begin{align*}5^3\\times5^2&=5^{3+2}\\\\5^3\\times5^2&=5^5\\end{align*}$$\n\nThe missing number is $5$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$4^3\\times4^2=2^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$",
          "worked": "$$\\begin{align*}4^3\\times4^2&=4^{3+2}\\\\4^3\\times4^2&=4^5\\\\4^3\\times4^2&=(2^2)^5\\\\4^3\\times4^2&=2^{10}\\end{align*}$$\n\nThe missing number is $10$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$6^7\\div3^7=\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}^{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}6^7\\div3^7&=(6\\div3)^7\\\\6^7\\div3^7&=2^7\\end{align*}$$\n\nThe missing number is $2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$(3^2)^2=\\boxed{\\rule{0pt}{5mm}\\hspace{11mm}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}(3^2)^2&=9^2\\\\(3^2)^2&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}^{5}\\div6^5=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$6^5\\div6^5=1$$\n\nThe numerator must equal the denominator, so the missing base is $6$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$3^3\\times3^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=81$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$81=3^4$. Since $3+1=4$,\n\n$$3^3\\times3^1=3^4=81.$$\n\nThe missing number is $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-h",
        "type": "part",
        "label": "h",
        "prompt": "$(5^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}})^2=5^{16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$",
          "worked": "The indices multiply when a power is raised to a power. Since $16\\div2=8$,\n\n$$\\begin{align*}(5^8)^2&=5^{8\\times2}\\\\(5^8)^2&=5^{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p4-q6-i",
        "type": "part",
        "label": "i",
        "prompt": "$(7^{13}\\div7^8)^{\\boxed{\\rule{0pt}{3mm}\\hspace{8mm}}}=7^{15}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}7^{13}\\div7^8&=7^{13-8}\\\\7^{13}\\div7^8&=7^5\\end{align*}$$\n\nSince $15\\div5=3$,\n\n$$\\begin{align*}(7^{13}\\div7^8)^3&=(7^5)^3\\\\(7^{13}\\div7^8)^3&=7^{15}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      }
    ]
