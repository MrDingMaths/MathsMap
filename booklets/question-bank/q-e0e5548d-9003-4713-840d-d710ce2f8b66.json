  "content": {
    "id": "p40-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A fence is required for a rectangular block of land that measures $51.6\\text{ m}$ down each of the two sides and $16.85\\text{ m}$ across the back, with no fence at the front. How long is the fence in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$120.05\\text{ m}$",
      "worked": "Only the two sides and the back need fencing.\n$$\\begin{align*}\\text{Fence length}&=51.6+51.6+16.85\\\\\\text{Fence length}&=103.2+16.85\\\\\\text{Fence length}&=120.05\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
