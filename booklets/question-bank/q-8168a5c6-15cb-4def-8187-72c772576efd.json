  "content": {
    "id": "p72-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A triangle $ABC$ has $AB=6\\text{ m}$, $AC=10\\text{ m}$ and $\\angle B=120^\\circ$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p72-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the sine rule to find the two candidate values of $\\angle C$, correct to the nearest degree.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31^\\circ$ and $149^\\circ$.",
          "worked": "$$\\begin{align*}\\frac{\\sin C}{6}&=\\frac{\\sin120^\\circ}{10}\\\\\\sin C&=\\frac{6\\sin120^\\circ}{10}\\\\C_1&=\\sin^{-1}\\left(\\frac{6\\sin120^\\circ}{10}\\right)\\\\C_1&\\approx31^\\circ\\\\C_2&=180^\\circ-\\sin^{-1}\\left(\\frac{6\\sin120^\\circ}{10}\\right)\\\\C_2&\\approx149^\\circ\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p72-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Explain why there is only one solution for $\\angle C$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The obtuse candidate is invalid because $120^\\circ+149^\\circ>180^\\circ$. Therefore $\\angle C\\approx31^\\circ$ only.",
          "worked": "A triangle can have only one obtuse angle. Since $\\angle B=120^\\circ$, the obtuse candidate for $\\angle C$ would make the angle sum exceed $180^\\circ$. The acute candidate gives $\\angle A\\approx29^\\circ>0^\\circ$, so $\\angle C\\approx31^\\circ$ is the only valid solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
