  "content": {
    "id": "p25-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "In a multiple choice test, 8 marks are awarded for each correct answer and 5 marks are subtracted for each incorrect answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "If after 26 questions are answered, Kevin scored 0, how many questions did he answer correctly?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "10 correct answers.",
          "worked": "Let $c$ be the number of correct answers. Then $26-c$ answers are incorrect.\n$$\\begin{align*}8c-5(26-c)&=0\\\\8c-130+5c&=0\\\\13c&=130\\\\c&=10\\end{align*}$$\nKevin answered 10 questions correctly.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p25-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "If a test has 50 questions and every question is answered, how many have to be correct to score at least 20 marks?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "At least 21 correct answers.",
          "worked": "Let $c$ be the number of correct answers. Then $50-c$ answers are incorrect.\n$$\\begin{align*}8c-5(50-c)&\\geq20\\\\8c-250+5c&\\geq20\\\\13c&\\geq270\\\\c&\\geq\\frac{270}{13}\\end{align*}$$\nSince $c$ is a whole number, at least 21 correct answers are required.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
