  "content": {
    "id": "p59-q4-response",
    "type": "question",
    "label": "4",
    "prompt": "What is the drip rate per minute for 850 mL of fluid over 5 h with a drip size giving 8 drops/mL?\nRound to the nearest whole.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$23\\text{ drops/min}$",
      "worked": "The three quantities are drops, volume and time.\n$$\\begin{align*}\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{\\text{Drops}}{\\text{Volume}}\\times\\frac{\\text{Volume}}{\\text{Time}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{8\\text{ drops}}{1\\text{ mL}}\\times\\frac{850\\text{ mL}}{5\\text{ h}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{8\\text{ drops}}{1\\text{ mL}}\\times\\frac{850\\text{ mL}}{300\\text{ min}}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &= \\frac{68}{3}\\text{ drops/min}\\\\\n\\frac{\\text{Drops}}{\\text{Time}} &\\approx 23\\text{ drops/min}\n\\end{align*}$$\nThe drip rate is $23\\text{ drops/min}$ to the nearest whole number.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 55
  },
