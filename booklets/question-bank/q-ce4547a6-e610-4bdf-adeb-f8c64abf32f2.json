  "content": {
    "id": "p21-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "$A(1,1)$, $B(1,6)$, $C(6,6)$ and $D(6,1)$ are the vertices of a square $ABCD$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q8-a",
        "type": "group",
        "label": "a",
        "prompt": "Find the midpoint of:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p21-q8-a-i",
            "type": "part",
            "label": "i",
            "prompt": "$AC$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\left(3\\frac{1}{2},3\\frac{1}{2}\\right)$",
              "worked": "$$\\begin{align*}M_{AC}&=\\left(\\frac{1+6}{2},\\frac{1+6}{2}\\right)\\\\M_{AC}&=\\left(\\frac{7}{2},\\frac{7}{2}\\right).\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          },
          {
            "id": "p21-q8-a-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$BD$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\left(3\\frac{1}{2},3\\frac{1}{2}\\right)$",
              "worked": "$$\\begin{align*}M_{BD}&=\\left(\\frac{1+6}{2},\\frac{6+1}{2}\\right)\\\\M_{BD}&=\\left(\\frac{7}{2},\\frac{7}{2}\\right).\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 28
          }
        ]
      },
      {
        "id": "p21-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the gradient of $AC$ and $BD$, and hence show that $AC$ is perpendicular to $BD$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m_{AC}=1$, $m_{BD}=-1$.\n\nTheir product is $-1$, so $AC\\perp BD$.",
          "worked": "$$\\begin{align*}m_{AC}&=\\frac{6-1}{6-1}\\\\m_{AC}&=1.\\end{align*}$$\n$$\\begin{align*}m_{BD}&=\\frac{1-6}{6-1}\\\\m_{BD}&=-1.\\end{align*}$$\n$$m_{AC}m_{BD}=1\\times(-1)=-1.$$\nThe product of the gradients is $-1$, so $AC$ is perpendicular to $BD$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
  },
