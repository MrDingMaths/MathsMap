  "content": {
    "id": "p24-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "A family travelling to Sale covers one-third of the journey before 1 p.m. and a further one-quarter of the journey between 1 p.m. and 2 p.m. What fraction of the journey have they travelled by 2 p.m.?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac7{12}$",
      "worked": "$$\\begin{align*}\\frac13+\\frac14&=\\frac4{12}+\\frac3{12}\\\\\\frac13+\\frac14&=\\frac7{12}\\end{align*}$$\nThey have travelled $\\frac7{12}$ of the journey.",
