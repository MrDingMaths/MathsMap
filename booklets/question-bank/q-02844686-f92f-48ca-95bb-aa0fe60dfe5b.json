  "content": {
    "id": "p67-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Write as a sum of two fractions:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p67-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{6}{(x-1)(x+1)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{x-1}-\\dfrac{3}{x+1}$",
          "worked": "$$\\begin{align*}\\frac{6}{(x-1)(x+1)}&=\\frac{a}{x-1}+\\frac{b}{x+1}\\\\6&=a(x+1)+b(x-1)\\\\6&=x(a+b)+(a-b)\\end{align*}$$\nComparing coefficients:\n$$\\begin{align*}a+b&=0\\quad(1)\\\\a-b&=6\\quad(2)\\end{align*}$$\nAdding (1) and (2):\n$$\\begin{align*}2a&=6\\\\a&=3\\end{align*}$$\nSubstitute $a=3$ into (1):\n$$\\begin{align*}3+b&=0\\\\b&=-3\\\\\\frac{6}{(x-1)(x+1)}&=\\frac{3}{x-1}-\\frac{3}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p67-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{7}{(x+2)(2x-3)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{x+2}+\\dfrac{2}{2x-3}$",
          "worked": "$$\\begin{align*}\\frac{7}{(x+2)(2x-3)}&=\\frac{a}{x+2}+\\frac{b}{2x-3}\\\\7&=a(2x-3)+b(x+2)\\\\7&=x(2a+b)+(-3a+2b)\\end{align*}$$\nComparing coefficients:\n$$\\begin{align*}2a+b&=0\\quad(1)\\\\-3a+2b&=7\\quad(2)\\end{align*}$$\nTwice (1) minus (2):\n$$\\begin{align*}7a&=-7\\\\a&=-1\\end{align*}$$\nSubstitute $a=-1$ into (1):\n$$\\begin{align*}-2+b&=0\\\\b&=2\\\\\\frac{7}{(x+2)(2x-3)}&=-\\frac{1}{x+2}+\\frac{2}{2x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 90
      },
      {
        "id": "p68-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{-5}{(2x-1)(3x+1)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{2}{2x-1}+\\dfrac{3}{3x+1}$",
          "worked": "$$\\begin{align*}\\frac{-5}{(2x-1)(3x+1)}&=\\frac{a}{2x-1}+\\frac{b}{3x+1}\\\\-5&=a(3x+1)+b(2x-1)\\\\-5&=x(3a+2b)+(a-b)\\end{align*}$$\nComparing coefficients:\n$$\\begin{align*}3a+2b&=0\\quad(1)\\\\a-b&=-5\\quad(2)\\end{align*}$$\nAdding (1) and twice (2):\n$$\\begin{align*}5a&=-10\\\\a&=-2\\end{align*}$$\nSubstitute $a=-2$ into (2):\n$$\\begin{align*}-2-b&=-5\\\\b&=3\\\\\\frac{-5}{(2x-1)(3x+1)}&=-\\frac{2}{2x-1}+\\frac{3}{3x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 90
      },
      {
        "id": "p68-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{9x+4}{(3x-1)(x+2)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{3x-1}+\\dfrac{2}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{9x+4}{(3x-1)(x+2)}&=\\frac{a}{3x-1}+\\frac{b}{x+2}\\\\9x+4&=a(x+2)+b(3x-1)\\\\9x+4&=x(a+3b)+(2a-b)\\end{align*}$$\nComparing coefficients:\n$$\\begin{align*}a+3b&=9\\quad(1)\\\\2a-b&=4\\quad(2)\\end{align*}$$\nAdding (1) and three times (2):\n$$\\begin{align*}7a&=21\\\\a&=3\\end{align*}$$\nSubstitute $a=3$ into (2):\n$$\\begin{align*}6-b&=4\\\\b&=2\\\\\\frac{9x+4}{(3x-1)(x+2)}&=\\frac{3}{3x-1}+\\frac{2}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 90
      },
      {
        "id": "p68-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{2x-1}{(x+3)(x-4)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{x+3}+\\dfrac{1}{x-4}$",
          "worked": "$$\\begin{align*}\\frac{2x-1}{(x+3)(x-4)}&=\\frac{a}{x+3}+\\frac{b}{x-4}\\\\2x-1&=a(x-4)+b(x+3)\\\\2x-1&=x(a+b)+(-4a+3b)\\end{align*}$$\nComparing coefficients:\n$$\\begin{align*}a+b&=2\\quad(1)\\\\-4a+3b&=-1\\quad(2)\\end{align*}$$\nThree times (1) minus (2):\n$$\\begin{align*}7a&=7\\\\a&=1\\end{align*}$$\nSubstitute $a=1$ into (1):\n$$\\begin{align*}1+b&=2\\\\b&=1\\\\\\frac{2x-1}{(x+3)(x-4)}&=\\frac{1}{x+3}+\\frac{1}{x-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 90
      },
      {
        "id": "p68-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{1-x}{(2x-1)(4-x)}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{7(2x-1)}-\\dfrac{3}{7(4-x)}$",
          "worked": "$$\\begin{align*}\\frac{1-x}{(2x-1)(4-x)}&=\\frac{a}{2x-1}+\\frac{b}{4-x}\\\\1-x&=a(4-x)+b(2x-1)\\\\1-x&=x(-a+2b)+(4a-b)\\end{align*}$$\nComparing coefficients:\n$$\\begin{align*}-a+2b&=-1\\quad(1)\\\\4a-b&=1\\quad(2)\\end{align*}$$\nAdding (1) and twice (2):\n$$\\begin{align*}7a&=1\\\\a&=\\frac17\\end{align*}$$\nSubstitute $a=\\frac17$ into (2):\n$$\\begin{align*}\\frac47-b&=1\\\\b&=-\\frac37\\\\\\frac{1-x}{(2x-1)(4-x)}&=\\frac{1}{7(2x-1)}-\\frac{3}{7(4-x)}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 95
      }
    ]
  },
