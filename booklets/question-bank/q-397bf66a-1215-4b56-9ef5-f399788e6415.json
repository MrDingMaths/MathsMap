  "content": {
    "id": "p22-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Let $a$ and $b$ be positive real numbers.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Sketch the triangle whose vertices are $O(0,0)$, $A(a,0)$ and $B(0,b)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "A first-quadrant triangle with $OA$ on the positive $x$-axis and $OB$ on the positive $y$-axis.",
          "worked": "Plot $O(0,0)$, $A(a,0)$ and $B(0,b)$, then join the three vertices.",
          "solutionDiagrams": [
            {
              "id": "p22-q7-a-solution",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"teacher PDF page 71, 13H 7(a)\"}\n\\begin{tikzpicture}[x=12mm,y=12mm,every node/.style={font=\\normalsize,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-0.6,0)--(4.6,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-0.6)--(0,3.6) node[above] {$y$};\n\\draw[line width=0.8pt] (0,0)--(4,0)--(0,3)--cycle;\n\\fill (0,0) circle (1.5pt) node[below left] {$O(0,0)$};\n\\fill (4,0) circle (1.5pt) node[below] {$A(a,0)$};\n\\fill (0,3) circle (1.5pt) node[left] {$B(0,b)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 70,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 22,
                "sourceRegion": "13H question 7(a); teacher PDF page 71, lower left",
                "description": "Symbolic coordinate sketch; no numeric ticks or grid. The vertex name O is required by the task.",
                "mathematics": "a>0 and b>0; O=(0,0), A=(a,0), B=(0,b). Drawing proportions are illustrative.",
                "answerVisibility": "solution-only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p22-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $M$ be the midpoint of $OA$ and let $N$ be the midpoint of $OB$. Find the coordinates of $M$ and $N$, and add these points to your diagram.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$M\\left(\\frac a2,0\\right)$, $N\\left(0,\\frac b2\\right)$.",
          "worked": "$$\\begin{align*}M&=\\left(\\frac{0+a}{2},\\frac{0+0}{2}\\right)\\\\M&=\\left(\\frac a2,0\\right)\\\\N&=\\left(\\frac{0+0}{2},\\frac{0+b}{2}\\right)\\\\N&=\\left(0,\\frac b2\\right)\\end{align*}$$\nMark $M$ halfway along $OA$ and $N$ halfway along $OB$ on the sketch from part (a).",
          "solutionDiagrams": [
            {
              "id": "p22-q7-b-solution",
              "role": "solution",
              "format": "tikz",
              "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"teacher PDF page 71, 13H 7(b)\"}\n\\begin{tikzpicture}[x=14mm,y=14mm,every node/.style={font=\\normalsize,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\draw[<->,line width=0.5pt] (-0.6,0)--(4.6,0) node[right] {$x$};\n\\draw[<->,line width=0.5pt] (0,-0.8)--(0,3.6) node[above] {$y$};\n\\draw[line width=0.8pt] (0,0)--(4,0)--(0,3)--cycle;\n\\draw[line width=0.8pt] (0,3)--(2,0) (4,0)--(0,1.5);\n\\fill (0,0) circle (1.5pt) node[below left] {$O$};\n\\fill (4,0) circle (1.5pt) node[below right] {$A(a,0)$};\n\\fill (0,3) circle (1.5pt) node[left] {$B(0,b)$};\n\\fill (2,0) circle (1.5pt) node[below] {$M(\\frac a2,0)$};\n\\fill (0,1.5) circle (1.5pt) node[left] {$N(0,\\frac b2)$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 80,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
                "sourcePage": 22,
                "sourceRegion": "13H question 7(b); teacher PDF page 71, lower left",
                "description": "The existing triangle with midpoint labels; BM and AN are included as in the teacher sketch for the following parts. No numeric ticks or grid.",
                "mathematics": "M=(a/2,0), N=(0,b/2); BM and AN join their named endpoints.",
                "answerVisibility": "solution-only"
              },
              "derived": false,
              "reviewStatus": "needs-review"
            }
          ]
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p22-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "Find the equation of lines $AB$, $BM$ and $AN$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$AB: bx+ay=ab$; $BM:2bx+ay=ab$; $AN:bx+2ay=ab$.",
          "worked": "For $AB$:\n$$\\begin{align*}m_{AB}&=\\frac{0-b}{a-0}\\\\m_{AB}&=-\\frac ba\\\\y-b&=-\\frac ba(x-0)\\\\bx+ay&=ab\\end{align*}$$\nFor $BM$:\n$$\\begin{align*}m_{BM}&=\\frac{0-b}{a/2-0}\\\\m_{BM}&=-\\frac{2b}{a}\\\\y-b&=-\\frac{2b}{a}(x-0)\\\\2bx+ay&=ab\\end{align*}$$\nFor $AN$:\n$$\\begin{align*}m_{AN}&=\\frac{b/2-0}{0-a}\\\\m_{AN}&=-\\frac{b}{2a}\\\\y&=-\\frac{b}{2a}(x-a)\\\\bx+2ay&=ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 132
      },
      {
        "id": "p22-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the coordinates of $P$, the point of intersection of lines $BM$ and $AN$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P\\left(\\frac a3,\\frac b3\\right)$.",
          "worked": "$$\\begin{align*}2bx+ay&=ab\\qquad(1)\\\\bx+2ay&=ab\\qquad(2)\\\\4bx+2ay&=2ab\\qquad 2\\times(1)\\\\3bx&=ab\\qquad 2\\times(1)-(2)\\\\x&=\\frac a3\\\\2b\\left(\\frac a3\\right)+ay&=ab\\\\ay&=\\frac{ab}{3}\\\\y&=\\frac b3\\end{align*}$$\nHence $P\\left(\\frac a3,\\frac b3\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p22-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "Show that line $OP$ passes through the midpoint of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$OP:y=\\frac ba x$. Its intersection with $AB$ is $\\left(\\frac a2,\\frac b2\\right)$, the midpoint of $AB$.\n\nSolve the equations of $OP$ and $AB$ together and compare with the midpoint coordinates.",
          "worked": "$$\\begin{align*}m_{OP}&=\\frac{b/3-0}{a/3-0}\\\\m_{OP}&=\\frac ba\\\\y&=\\frac ba x\\\\ay-bx&=0\\qquad(1)\\\\bx+ay&=ab\\qquad(2)\\\\2ay&=ab\\qquad(1)+(2)\\\\y&=\\frac b2\\\\bx+a\\left(\\frac b2\\right)&=ab\\\\bx&=\\frac{ab}{2}\\\\x&=\\frac a2\\end{align*}$$\nThe midpoint of $AB$ is\n$$\\left(\\frac{a+0}{2},\\frac{0+b}{2}\\right)=\\left(\\frac a2,\\frac b2\\right).$$\nThis is the intersection of $OP$ and $AB$, so $OP$ passes through the midpoint of $AB$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 116
      }
    ]
  },
