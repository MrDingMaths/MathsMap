  "content": {
    "id": "p14-q3",
    "type": "question",
    "label": "3",
    "prompt": "Zach writes $5x^2+5x+3x^2=13x^2$. Explain why Zach is incorrect. Draw a diagram if necessary.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5x$ is not like the $x^2$ terms because the powers of $x$ differ. The correct expression is $8x^2+5x$.",
      "worked": "$5x$ contains $x^1$, whereas $5x^2$ and $3x^2$ contain $x^2$. Only the squared terms are like terms.\n$$\\begin{align*}5x^2+5x+3x^2&=(5+3)x^2+5x\\\\&=8x^2+5x\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
