  "content": {
    "id": "p49-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Rewrite the following in the form $\\frac{\\sqrt{a}}{\\sqrt{b}}$ and then rationalise the denominators.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{\\frac{2}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{6}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{2}{3}}&=\\frac{\\sqrt{2}}{\\sqrt{3}}\\\\\\sqrt{\\frac{2}{3}}&=\\frac{\\sqrt{2}}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\sqrt{\\frac{2}{3}}&=\\frac{\\sqrt{6}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p49-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\sqrt{\\frac{5}{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{35}}{7}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{5}{7}}&=\\frac{\\sqrt{5}}{\\sqrt{7}}\\\\\\sqrt{\\frac{5}{7}}&=\\frac{\\sqrt{5}}{\\sqrt{7}}\\times\\frac{\\sqrt{7}}{\\sqrt{7}}\\\\\\sqrt{\\frac{5}{7}}&=\\frac{\\sqrt{35}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p49-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt{\\frac{2}{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{10}}{5}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{2}{5}}&=\\frac{\\sqrt{2}}{\\sqrt{5}}\\\\\\sqrt{\\frac{2}{5}}&=\\frac{\\sqrt{2}}{\\sqrt{5}}\\times\\frac{\\sqrt{5}}{\\sqrt{5}}\\\\\\sqrt{\\frac{2}{5}}&=\\frac{\\sqrt{10}}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p49-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt{\\frac{7}{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{21}}{3}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{7}{3}}&=\\frac{\\sqrt{7}}{\\sqrt{3}}\\\\\\sqrt{\\frac{7}{3}}&=\\frac{\\sqrt{7}}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\\\sqrt{\\frac{7}{3}}&=\\frac{\\sqrt{21}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p49-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\sqrt{\\frac{6}{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{42}}{7}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{6}{7}}&=\\frac{\\sqrt{6}}{\\sqrt{7}}\\\\\\sqrt{\\frac{6}{7}}&=\\frac{\\sqrt{6}}{\\sqrt{7}}\\times\\frac{\\sqrt{7}}{\\sqrt{7}}\\\\\\sqrt{\\frac{6}{7}}&=\\frac{\\sqrt{42}}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p49-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\sqrt{\\frac{17}{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{\\sqrt{34}}{2}$",
          "worked": "$$\\begin{align*}\\sqrt{\\frac{17}{2}}&=\\frac{\\sqrt{17}}{\\sqrt{2}}\\\\\\sqrt{\\frac{17}{2}}&=\\frac{\\sqrt{17}}{\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\\\sqrt{\\frac{17}{2}}&=\\frac{\\sqrt{34}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      }
    ]
