    "type": "question",
    "label": "16",
    "prompt": "Use $\\cot x=\\dfrac{\\cos x}{\\sin x}$ to find $\\displaystyle\\int_{\\pi/6}^{\\pi/2}\\cot x\\,dx$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\ln 2$",
      "worked": "$$\\begin{align*}\\int_{\\pi/6}^{\\pi/2}\\cot x\\,dx&=\\int_{\\pi/6}^{\\pi/2}\\frac{\\cos x}{\\sin x}\\,dx\\\\&=\\left[\\ln(\\sin x)\\right]_{\\pi/6}^{\\pi/2}\\\\&=\\ln 1-\\ln\\left(\\frac12\\right)\\\\&=\\ln 2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
