    "answer": {
      "short": "$1$",
      "worked": "$$\\begin{align*}\\frac{1}{96}+\\frac{97\\times95}{96}-95&=\\frac{1+(96+1)(96-1)}{96}-95\\\\&=\\frac{1+96^2-1}{96}-95\\\\&=\\frac{96^2}{96}-95\\\\&=96-95\\\\&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
