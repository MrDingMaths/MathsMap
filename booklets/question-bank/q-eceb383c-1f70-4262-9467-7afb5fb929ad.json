  "content": {
    "id": "p13-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "In a large university, the student population is 45% male and 55% female. Two students are selected at random to take part in a survey. Treat the selections as independent because the student population is large. Find the probability that",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "both are female.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{121}{400}$",
          "worked": "$$\\begin{align*} P(\\text{both female}) &= 0.55\\times0.55 \\\\ P(\\text{both female}) &= \\frac{121}{400} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p13-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "both are of the same sex.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{101}{200}$",
          "worked": "$$\\begin{align*} P(\\text{same sex}) &= P(\\text{both female})+P(\\text{both male}) \\\\ P(\\text{same sex}) &= 0.55^2+0.45^2 \\\\ P(\\text{same sex}) &= \\frac{101}{200} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p13-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "one is male and one is female.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{99}{200}$",
          "worked": "The two orders, male then female and female then male, are disjoint.\n\n$$\\begin{align*} P(\\text{one of each}) &= 0.45\\times0.55+0.55\\times0.45 \\\\ P(\\text{one of each}) &= \\frac{99}{200} \\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      }
    ]
  },
