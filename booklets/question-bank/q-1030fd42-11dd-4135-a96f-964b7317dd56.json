    "id": "p45-q18-response",
    "type": "question",
    "label": "18",
    "prompt": "Charlie is taking his holidays and receives 4 weeks’ holiday pay, including leave loading, of \\$4592.60.\nCalculate his annual salary. Round to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$50 811.74 per year.",
      "worked": "Holiday pay is $117.5\\%$ of normal pay for the leave period.\n$$\\begin{align*}\\text{4 weeks’ normal pay}&=4592.60\\div1.175\\\\\\text{Weekly pay}&=4592.60\\div1.175\\div4\\\\\\text{Annual salary}&=4592.60\\div1.175\\div4\\times52\\\\\\text{Annual salary}&\\approx\\$50\\,811.74\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 34
  },
