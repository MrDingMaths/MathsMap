  "content": {
    "id": "p76-q16-node",
    "type": "question",
    "label": "16",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p76-q16-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A particle is projected vertically upwards from the ground. The particle’s distance from the ground is",
              "marks": []
            }
          ]
        },
        {
          "id": "p76-q16-equation",
          "type": "paragraph",
          "fontSize": null,
          "align": "center",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "math",
              "latex": "y(t)=20t-5t^2",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the initial speed of the particle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ m/s}$",
          "worked": "\n\n$$\\begin{align*}v(t)&=y'(t)=20-10t\\\\v(0)&=20\\end{align*}$$\n\n The initial speed is $|v(0)|=20\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p76-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the maximum height of the particle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ m}$; $v(t)=0$ at $t=2$.",
          "worked": "\n\n$$\\begin{align*}v(t)&=20-10t\\\\0&=20-10t\\\\t&=2\\\\y(2)&=20(2)-5(2)^2=20\\end{align*}$$\n\n The velocity changes from positive to negative at $t=2$, so the maximum height is $20\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p76-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Find when the particle has a height of 15 metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\text{ s}$ and $t=3\\text{ s}$.",
          "worked": "\n\n$$\\begin{align*}20t-5t^2&=15\\\\t^2-4t+3&=0\\\\(t-1)(t-3)&=0\\\\t&=1,\\ 3\\end{align*}$$\n\n The particle is $15\\text{ m}$ above the ground after $1\\text{ s}$ and $3\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p76-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "After how many seconds does the particle land back on the ground?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\text{ s}$; use the positive return time from $y(t)=0$.",
          "worked": "\n\n$$\\begin{align*}20t-5t^2&=0\\\\5t(4-t)&=0\\\\t&=0,\\ 4\\end{align*}$$\n\n The particle starts on the ground at $t=0$ and lands back after $4\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-q16-e",
        "type": "part",
        "label": "e",
        "prompt": "Find the speed of the particle when it lands back on the ground.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20\\text{ m/s}$; $|v(4)|=20$.",
          "worked": "\n\n$$\\begin{align*}v(t)&=20-10t\\\\v(4)&=20-10(4)=-20\\end{align*}$$\n\n The landing speed is $|v(4)|=20\\text{ m/s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
