  "content": {
    "id": "p9-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "From a point on the ground, Emma measures the angle of elevation of an $80\\text{ m}$ tower to be $27^{\\circ}$. Find how far Emma is from the base of the tower, correct to the nearest metre.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$157\\text{ m}$",
      "worked": "Let $x$ be Emma's horizontal distance from the base of the tower in metres.\n$$\\begin{align*}\\tan 27^{\\circ} &= \\frac{80}{x}\\\\x &= \\frac{80}{\\tan 27^{\\circ}}\\\\x &\\approx 157\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
