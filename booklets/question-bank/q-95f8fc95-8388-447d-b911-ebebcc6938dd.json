  "content": {
    "id": "p76-q12",
    "type": "question",
    "label": "12",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p76-q12-instruction",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "In this exercise, all units are in metres and seconds.",
              "marks": [
                "italic"
              ]
            }
          ]
        },
        {
          "id": "p76-q12-stem",
          "type": "paragraph",
          "fontSize": null,
          "align": "left",
          "spaceBefore": 0,
          "spaceAfter": 2,
          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "A particle has displacement-time equation ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "x(t)=t^{2}+3t+1",
              "display": false
            },
            {
              "type": "text",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p76-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Where is the particle initially?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(0)=1\\text{ m}$",
          "worked": "$$\\begin{align*}x(0)&=0^{2}+3(0)+1\\\\x(0)&=1\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p76-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the particle’s position after two seconds?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(2)=11\\text{ m}$",
          "worked": "$$\\begin{align*}x(2)&=2^{2}+3(2)+1\\\\x(2)&=11\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p76-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "When is the particle at $x=5$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\text{ s}$",
          "worked": "\n\n$$\\begin{align*}t^{2}+3t+1&=5\\\\t^{2}+3t-4&=0\\\\(t+4)(t-1)&=0\\\\t&=-4,\\ 1.\\end{align*}$$\n\n Since time after the start is nonnegative, $t=1\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p76-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Does the particle ever return to its original position?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No. Its only nonnegative time at the starting position is $t=0$.",
          "worked": "The starting position is $x(0)=1$. \n\n$$\\begin{align*}t^{2}+3t+1&=1\\\\t(t+3)&=0\\\\t&=0,\\ -3.\\end{align*}$$\n\n Only $t=0$ is after the clock starts, so the particle does not return.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p76-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "When is the particle 11 units away from the starting position?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\dfrac{\\sqrt{53}-3}{2}\\text{ s}\\approx2.14\\text{ s}$. Set $|x(t)-x(0)|=11$ and keep the nonnegative time.",
          "worked": "Since $x(0)=1$, the distance from the starting position is $|x(t)-1|$. For $t\\geq0$, $x(t)-1=t^{2}+3t\\geq0$. \n\n$$\\begin{align*}t^{2}+3t&=11\\\\t^{2}+3t-11&=0\\\\t&=\\frac{-3\\pm\\sqrt{3^{2}+44}}{2}\\\\t&=\\frac{-3\\pm\\sqrt{53}}{2}.\\end{align*}$$\n\n The nonnegative solution is $t=\\dfrac{\\sqrt{53}-3}{2}\\text{ s}\\approx2.14\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
    ]
  },
