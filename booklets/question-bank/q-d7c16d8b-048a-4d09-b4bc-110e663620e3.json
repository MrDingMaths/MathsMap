        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dy}(y^2+2y)=2y+2$",
          "worked": "$$\\begin{align*}\\frac{d}{dy}(y^2+2y)&=2y+2(1)\\\\\\frac{d}{dy}(y^2+2y)&=2y+2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p11-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$6z^3-5z^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dz}(6z^3-5z^2)=18z^2-10z$",
          "worked": "$$\\begin{align*}\\frac{d}{dz}(6z^3-5z^2)&=6(3z^2)-5(2z)\\\\\\frac{d}{dz}(6z^3-5z^2)&=18z^2-10z.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$t^3-2t^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dt}(t^3-2t^2)=3t^2-4t$",
          "worked": "$$\\begin{align*}\\frac{d}{dt}(t^3-2t^2)&=3t^2-2(2t)\\\\\\frac{d}{dt}(t^3-2t^2)&=3t^2-4t.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$p-p^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{dp}(p-p^3)=1-3p^2$",
          "worked": "The derivative of $p$ with respect to $p$ is $1$. Applying the power rule to the cubic term gives $$\\frac{d}{dp}(p-p^3)=1-3p^2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 13
      },
      {
        "id": "p11-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$4u^2-u$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{d}{du}(4u^2-u)=8u-1$",
          "worked": "$$\\begin{align*}\\frac{d}{du}(4u^2-u)&=4(2u)-1\\\\\\frac{d}{du}(4u^2-u)&=8u-1.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p11-q5-f",
