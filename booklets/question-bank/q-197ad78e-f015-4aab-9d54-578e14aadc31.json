    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q3a-node",
        "type": "part",
        "label": "a",
        "prompt": "Given that $a_{n+1}=a_n+5$ and $a_2=6$, find $a_8$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$36$",
          "worked": "The common difference is $d=5$.\n$$\\begin{align*}a_8&=a_2+6d\\\\a_8&=6+6\\times5\\\\a_8&=36\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q3b-node",
        "type": "part",
        "label": "b",
        "prompt": "Given that $a_{n+1}=a_n+\\frac12$ and $a_2=10$, find $a_{14}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16$",
          "worked": "The common difference is $d=\\frac12$.\n$$\\begin{align*}a_{14}&=a_2+12d\\\\a_{14}&=10+12\\times\\frac12\\\\a_{14}&=16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p5-q3c-node",
        "type": "part",
        "label": "c",
        "prompt": "Given that $a_{n+1}=a_n-3$ and $a_5=99$, find $a_{10}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$84$",
          "worked": "The common difference is $d=-3$.\n$$\\begin{align*}a_{10}&=a_5+5d\\\\a_{10}&=99+5(-3)\\\\a_{10}&=84\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q3d-node",
        "type": "part",
        "label": "d",
        "prompt": "Given that $a_{n+1}=a_n+6$ and $a_8=30$, find $a_4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "The common difference is $d=6$. Move back four terms.\n$$\\begin{align*}a_4&=a_8-4d\\\\a_4&=30-4\\times6\\\\a_4&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p5-q3e-node",
        "type": "part",
        "label": "e",
        "prompt": "Given that $a_{n+1}=a_n+\\frac13$ and $a_{10}=1$, find $a_4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "The common difference is $d=\\frac13$. Move back six terms.\n$$\\begin{align*}a_4&=a_{10}-6d\\\\a_4&=1-6\\times\\frac13\\\\a_4&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p5-q3f-node",
        "type": "part",
        "label": "f",
        "prompt": "Given that $a_{n+1}=a_n-4$ and $a_9=10$, find $a_3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$34$",
          "worked": "The common difference is $d=-4$. Move back six terms.\n$$\\begin{align*}a_3&=a_9-6d\\\\a_3&=10-6(-4)\\\\a_3&=34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
