    "id": "p6-f1-root",
    "type": "question",
    "label": "1",
    "prompt": "Let $f$ be a function and $b,c>0$. In each part, circle the direction in which the graph of $y=f(x)$ is translated.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-f1-a",
        "type": "part",
        "label": "a",
        "prompt": "The graph of $y=f(x)+c$ is translated $c$ units up/down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Up.",
          "worked": "Adding $c$ to each output moves each point $c$ units up.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p6-f1-b",
        "type": "part",
        "label": "b",
        "prompt": "The graph of $y=f(x)-c$ is translated $c$ units up/down.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Down.",
          "worked": "Subtracting $c$ from each output moves each point $c$ units down.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p6-f1-c",
        "type": "part",
        "label": "c",
        "prompt": "The graph of $y=f(x-b)$ is translated $b$ units left/right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Right.",
          "worked": "At $x=u+b$, the input $x-b$ is $u$. The point originally at $x=u$ moves $b$ units right.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
      },
      {
        "id": "p6-f1-d",
        "type": "part",
        "label": "d",
        "prompt": "The graph of $y=f(x+b)$ is translated $b$ units left/right.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Left.",
          "worked": "At $x=u-b$, the input $x+b$ is $u$. The point originally at $x=u$ moves $b$ units left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0
