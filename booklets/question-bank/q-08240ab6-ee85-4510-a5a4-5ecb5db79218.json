  "content": {
    "id": "v2-ac439-p13-practice-slot-1-root",
    "type": "question",
    "label": null,
    "prompt": "A line with gradient $-\\frac34$ passes through $(-2,9)$. Find its $x$-intercept.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=10$",
      "worked": "$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-9&=-\\frac34(x+2)\\end{aligned}$$\nAt the $x$-intercept $y=0$:\n$$\\begin{aligned}-9&=-\\frac34(x+2)\\\\12&=x+2\\\\x&=10\\end{aligned}$$",
      "solutionDiagrams": []
    },
