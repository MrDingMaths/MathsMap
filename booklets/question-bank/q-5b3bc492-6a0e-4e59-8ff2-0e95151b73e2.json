  "content": {
    "id": "p7-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A box of 60 coloured crayons contains a mixture of colours. Only 10 of the crayons are red. If one crayon is chosen at random, what is the probability that it is not red?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{5}{6}$",
      "worked": "$$\\begin{align*}P(\\text{red})&=\\frac{10}{60}\\\\P(\\text{not red})&=1-\\frac{10}{60}\\\\P(\\text{not red})&=\\frac{50}{60}\\\\P(\\text{not red})&=\\frac{5}{6}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 26
