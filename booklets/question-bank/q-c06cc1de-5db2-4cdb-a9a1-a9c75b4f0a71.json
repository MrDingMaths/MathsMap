  "content": {
    "id": "p3-p1-root",
    "type": "question",
    "label": "1",
    "prompt": "Factorise the following.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-p1-a",
        "type": "part",
        "label": "a",
        "prompt": "$16-81x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(4+9x^2)(2+3x)(2-3x)$",
          "worked": "$$\\begin{align*}16-81x^4&=4^2-(9x^2)^2\\\\16-81x^4&=(4+9x^2)(4-9x^2)\\\\16-81x^4&=(4+9x^2)(2+3x)(2-3x).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-p1-b",
        "type": "part",
        "label": "b",
        "prompt": "$a^2(a+2)-4(a+2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(a+2)^2(a-2)$",
          "worked": "$$\\begin{align*}a^2(a+2)-4(a+2)&=(a+2)(a^2-4)\\\\a^2(a+2)-4(a+2)&=(a+2)(a+2)(a-2)\\\\a^2(a+2)-4(a+2)&=(a+2)^2(a-2).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-p1-c",
        "type": "part",
        "label": "c",
        "prompt": "$6x^2-5x-6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2)(2x-3)$",
          "worked": "Split the middle term using $-9$ and $4$, whose sum is $-5$ and whose product is $6(-6)=-36$.\n\n$$\\begin{align*}6x^2-5x-6&=6x^2-9x+4x-6\\\\6x^2-5x-6&=3x(2x-3)+2(2x-3)\\\\6x^2-5x-6&=(3x+2)(2x-3).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-p1-d",
        "type": "part",
        "label": "d",
        "prompt": "$6x^2-5xy-6y^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(3x+2y)(2x-3y)$",
          "worked": "Split $-5xy$ into $-9xy$ and $4xy$.\n\n$$\\begin{align*}6x^2-5xy-6y^2&=6x^2-9xy+4xy-6y^2\\\\6x^2-5xy-6y^2&=3x(2x-3y)+2y(2x-3y)\\\\6x^2-5xy-6y^2&=(3x+2y)(2x-3y).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
