        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$(3a^{2}b^{-2})^{3}\\times(2a^{4})^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{27}{4a^{2}b^{6}}$",
          "worked": "$$\\begin{aligned}(3a^{2}b^{-2})^{3}\\times(2a^{4})^{-2}&=27a^{6}b^{-6}\\times\\frac14a^{-8}\\\\(3a^{2}b^{-2})^{3}\\times(2a^{4})^{-2}&=\\frac{27}{4}a^{-2}b^{-6}\\\\(3a^{2}b^{-2})^{3}\\times(2a^{4})^{-2}&=\\frac{27}{4a^{2}b^{6}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$(5x^{4}y^{6})^{-3}\\times(5^{2}xy^{-1})^{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{125}{x^{9}y^{21}}$",
          "worked": "$$\\begin{aligned}(5x^{4}y^{6})^{-3}\\times(5^{2}xy^{-1})^{3}&=5^{-3}x^{-12}y^{-18}\\times5^{6}x^{3}y^{-3}\\\\(5x^{4}y^{6})^{-3}\\times(5^{2}xy^{-1})^{3}&=5^{3}x^{-9}y^{-21}\\\\(5x^{4}y^{6})^{-3}\\times(5^{2}xy^{-1})^{3}&=\\frac{125}{x^{9}y^{21}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$(5m^{2}n^{-3})^{-2}\\times2(m^{-2}n^{3})^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2n^{12}}{25m^{8}}$",
          "worked": "$$\\begin{aligned}(5m^{2}n^{-3})^{-2}\\times2(m^{-2}n^{3})^{2}&=\\frac1{25}m^{-4}n^{6}\\times2m^{-4}n^{6}\\\\(5m^{2}n^{-3})^{-2}\\times2(m^{-2}n^{3})^{2}&=\\frac2{25}m^{-8}n^{12}\\\\(5m^{2}n^{-3})^{-2}\\times2(m^{-2}n^{3})^{2}&=\\frac{2n^{12}}{25m^{8}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-d",
        "type": "part",
        "label": "d",
        "prompt": "$(6a^{5}b^{-4})^{-3}\\times2(a^{3}b^{-3})^{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{b^{6}}{108a^{9}}$",
          "worked": "$$\\begin{aligned}(6a^{5}b^{-4})^{-3}\\times2(a^{3}b^{-3})^{2}&=\\frac1{216}a^{-15}b^{12}\\times2a^{6}b^{-6}\\\\(6a^{5}b^{-4})^{-3}\\times2(a^{3}b^{-3})^{2}&=\\frac1{108}a^{-9}b^{6}\\\\(6a^{5}b^{-4})^{-3}\\times2(a^{3}b^{-3})^{2}&=\\frac{b^{6}}{108a^{9}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{(x^{2})^{2}}{y}\\times\\dfrac{(y^{2})^{-3}}{x^{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{y^{7}}$",
          "worked": "$$\\begin{aligned}\\frac{(x^{2})^{2}}{y}\\times\\frac{(y^{2})^{-3}}{x^{3}}&=\\frac{x^{4}}{y}\\times\\frac{y^{-6}}{x^{3}}\\\\\\frac{(x^{2})^{2}}{y}\\times\\frac{(y^{2})^{-3}}{x^{3}}&=x^{4-3}y^{-6-1}\\\\\\frac{(x^{2})^{2}}{y}\\times\\frac{(y^{2})^{-3}}{x^{3}}&=\\frac{x}{y^{7}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{(2x^{3})^{-2}}{y^{4}}\\times\\dfrac{(2x^{7})^{2}}{3y^{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x^{8}}{3y^{9}}$",
          "worked": "$$\\begin{aligned}\\frac{(2x^{3})^{-2}}{y^{4}}\\times\\frac{(2x^{7})^{2}}{3y^{5}}&=\\frac{x^{-6}}{4y^{4}}\\times\\frac{4x^{14}}{3y^{5}}\\\\\\frac{(2x^{3})^{-2}}{y^{4}}\\times\\frac{(2x^{7})^{2}}{3y^{5}}&=\\frac{x^{-6+14}}{3y^{4+5}}\\\\\\frac{(2x^{3})^{-2}}{y^{4}}\\times\\frac{(2x^{7})^{2}}{3y^{5}}&=\\frac{x^{8}}{3y^{9}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p14-q10-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\dfrac{(2a^{4}b^{-2})^{3}}{c^{2}}\\times\\dfrac{(2^{2}a^{-3}b^{2})^{-1}}{c}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2a^{15}}{b^{8}c^{3}}$",
          "worked": "$$\\begin{aligned}\\frac{(2a^{4}b^{-2})^{3}}{c^{2}}\\times\\frac{(2^{2}a^{-3}b^{2})^{-1}}{c}&=\\frac{8a^{12}b^{-6}}{c^{2}}\\times\\frac{a^{3}b^{-2}}{4c}\\\\\\frac{(2a^{4}b^{-2})^{3}}{c^{2}}\\times\\frac{(2^{2}a^{-3}b^{2})^{-1}}{c}&=2a^{15}b^{-8}c^{-3}\\\\\\frac{(2a^{4}b^{-2})^{3}}{c^{2}}\\times\\frac{(2^{2}a^{-3}b^{2})^{-1}}{c}&=\\frac{2a^{15}}{b^{8}c^{3}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p14-q10-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\dfrac{(m^{2}n^{3})^{2}}{p^{-3}}\\times(mnp^{-2})^{-3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$mn^{3}p^{9}$",
          "worked": "$$\\begin{aligned}\\frac{(m^{2}n^{3})^{2}}{p^{-3}}\\times(mnp^{-2})^{-3}&=m^{4}n^{6}p^{3}\\times m^{-3}n^{-3}p^{6}\\\\\\frac{(m^{2}n^{3})^{2}}{p^{-3}}\\times(mnp^{-2})^{-3}&=m^{4-3}n^{6-3}p^{3+6}\\\\\\frac{(m^{2}n^{3})^{2}}{p^{-3}}\\times(mnp^{-2})^{-3}&=mn^{3}p^{9}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p14-q10-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\dfrac{(a^{2})^{3}}{b^{3}}\\div\\left(\\dfrac{a}{b^{2}}\\right)^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a^{8}}{b^{7}}$",
          "worked": "$$\\begin{aligned}\\frac{(a^{2})^{3}}{b^{3}}\\div\\left(\\frac{a}{b^{2}}\\right)^{-2}&=\\frac{a^{6}}{b^{3}}\\times\\left(\\frac{a}{b^{2}}\\right)^{2}\\\\\\frac{(a^{2})^{3}}{b^{3}}\\div\\left(\\frac{a}{b^{2}}\\right)^{-2}&=\\frac{a^{6}}{b^{3}}\\times\\frac{a^{2}}{b^{4}}\\\\\\frac{(a^{2})^{3}}{b^{3}}\\div\\left(\\frac{a}{b^{2}}\\right)^{-2}&=\\frac{a^{8}}{b^{7}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p14-q10-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\dfrac{(2a^{4})^{2}}{b^{7}}\\div\\dfrac{(a^{2})^{-3}}{2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{8a^{14}}{b^{6}}$",
          "worked": "$$\\begin{aligned}\\frac{(2a^{4})^{2}}{b^{7}}\\div\\frac{(a^{2})^{-3}}{2b}&=\\frac{4a^{8}}{b^{7}}\\div\\frac{a^{-6}}{2b}\\\\\\frac{(2a^{4})^{2}}{b^{7}}\\div\\frac{(a^{2})^{-3}}{2b}&=\\frac{4a^{8}}{b^{7}}\\times2ba^{6}\\\\\\frac{(2a^{4})^{2}}{b^{7}}\\div\\frac{(a^{2})^{-3}}{2b}&=\\frac{8a^{14}}{b^{6}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p14-q10-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\dfrac{(4c^{4}d^{-3})^{2}}{9}\\div\\dfrac{3c^{-2}}{d}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{16c^{10}}{27d^{5}}$",
          "worked": "$$\\begin{aligned}\\frac{(4c^{4}d^{-3})^{2}}{9}\\div\\frac{3c^{-2}}{d}&=\\frac{16c^{8}d^{-6}}9\\times\\frac{c^{2}d}{3}\\\\\\frac{(4c^{4}d^{-3})^{2}}{9}\\div\\frac{3c^{-2}}{d}&=\\frac{16}{27}c^{10}d^{-5}\\\\\\frac{(4c^{4}d^{-3})^{2}}{9}\\div\\frac{3c^{-2}}{d}&=\\frac{16c^{10}}{27d^{5}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p14-q10-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\dfrac{(3m^{2}n^{3})^{-2}}{p^{4}}\\div\\dfrac{p^{-3}}{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{9m^{3}n^{6}p}$",
          "worked": "$$\\begin{aligned}\\frac{(3m^{2}n^{3})^{-2}}{p^{4}}\\div\\frac{p^{-3}}m&=\\frac{m^{-4}n^{-6}}{9p^{4}}\\times mp^{3}\\\\\\frac{(3m^{2}n^{3})^{-2}}{p^{4}}\\div\\frac{p^{-3}}m&=\\frac19m^{-3}n^{-6}p^{-1}\\\\\\frac{(3m^{2}n^{3})^{-2}}{p^{4}}\\div\\frac{p^{-3}}m&=\\frac1{9m^{3}n^{6}p}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      }
