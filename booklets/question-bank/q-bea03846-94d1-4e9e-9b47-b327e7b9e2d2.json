  "content": {
    "id": "p72-q3-node",
    "type": "question",
    "label": "3",
    "prompt": "Suppose $A$, $B$ and $C$ are three points on a line, in that order. If $\\angle ABX=40^\\circ$, then find $\\angle CBX$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\angle CBX=140^\\circ$",
      "worked": "Angles on straight line $ABC$ sum to $180^\\circ$.\n$$\\begin{align*}\\angle ABX+\\angle CBX&=180^\\circ\\\\40^\\circ+\\angle CBX&=180^\\circ\\\\\\angle CBX&=140^\\circ\\end{align*}$$",
      "solutionDiagrams": []
    },
