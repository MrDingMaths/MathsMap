  "content": {
    "id": "p32-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Factorise these expressions using rational coefficients, if possible.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p32-q11-left",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p32-q11-a",
            "type": "part",
            "label": "a",
            "prompt": "$x^2-9x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x(x-9)$",
              "worked": "$$x^2-9x=x(x-9)$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p32-q11-b",
            "type": "part",
            "label": "b",
            "prompt": "$x^2+9x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$x(x+9)$",
              "worked": "$$x^2+9x=x(x+9)$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p32-q11-c",
            "type": "part",
            "label": "c",
            "prompt": "$x^2+9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Cannot be factorised using rational coefficients.",
              "worked": "There is no common factor other than $1$, and a sum of squares does not factorise over the real numbers.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p32-q11-d",
            "type": "part",
            "label": "d",
            "prompt": "$x^2-9$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$(x-3)(x+3)$",
              "worked": "$$x^2-9=(x-3)(x+3)$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p32-q11-e",
            "type": "part",
            "label": "e",
            "prompt": "$x^2-8$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Cannot be factorised using rational coefficients.",
              "worked": "There is no common factor other than $1$, and $8$ is not a rational square, so the taught difference-of-squares method does not give rational factors.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          },
          {
            "id": "p32-q11-f",
            "type": "part",
            "label": "f",
            "prompt": "$2x^2-50$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2(x-5)(x+5)$",
              "worked": "$$\\begin{align*}2x^2-50&=2(x^2-25)\\\\&=2(x-5)(x+5)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-g",
            "type": "part",
            "label": "g",
            "prompt": "$50-2x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2(5-x)(5+x)$",
              "worked": "$$\\begin{align*}50-2x^2&=2(25-x^2)\\\\&=2(5-x)(5+x)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p32-q11-right",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p32-q11-h",
            "type": "part",
            "label": "h",
            "prompt": "$200-2x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$2(10-x)(10+x)$",
              "worked": "$$\\begin{align*}200-2x^2&=2(100-x^2)\\\\&=2(10-x)(10+x)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-i",
            "type": "part",
            "label": "i",
            "prompt": "$300-3x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3(10-x)(10+x)$",
              "worked": "$$\\begin{align*}300-3x^2&=3(100-x^2)\\\\&=3(10-x)(10+x)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-j",
            "type": "part",
            "label": "j",
            "prompt": "$300-27x^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3(10-3x)(10+3x)$",
              "worked": "$$\\begin{align*}300-27x^2&=3(100-9x^2)\\\\&=3(10-3x)(10+3x)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-k",
            "type": "part",
            "label": "k",
            "prompt": "$12x^2-3y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3(2x-y)(2x+y)$",
              "worked": "$$\\begin{align*}12x^2-3y^2&=3(4x^2-y^2)\\\\&=3(2x-y)(2x+y)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-l",
            "type": "part",
            "label": "l",
            "prompt": "$3x^2-3y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3(x-y)(x+y)$",
              "worked": "$$\\begin{align*}3x^2-3y^2&=3(x^2-y^2)\\\\&=3(x-y)(x+y)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-m",
            "type": "part",
            "label": "m",
            "prompt": "$3x^2-27y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$3(x-3y)(x+3y)$",
              "worked": "$$\\begin{align*}3x^2-27y^2&=3(x^2-9y^2)\\\\&=3(x-3y)(x+3y)\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p32-q11-n",
            "type": "part",
            "label": "n",
            "prompt": "$x^2-27y^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Cannot be factorised using rational coefficients.",
              "worked": "There is no common factor other than $1$, and $27$ is not a rational square, so the taught difference-of-squares method does not give rational factors.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 14
          }
        ]
