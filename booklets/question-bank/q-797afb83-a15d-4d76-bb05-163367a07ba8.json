  "content": {
    "id": "p59-q6-response",
    "type": "question",
    "label": "6",
    "prompt": "A patient is to receive 800 mL of liquid through an intravenous drip delivering 25 drops/min.\nIf there are 16 drops/mL, how long will it take to deliver the required dose?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "8 h 32 min",
      "worked": "The three quantities are time, volume and drops.\n$$\\begin{align*}\\frac{\\text{Time}}{\\text{Volume}} &= \\frac{\\text{Time}}{\\text{Drops}}\\times\\frac{\\text{Drops}}{\\text{Volume}}\\\\\\frac{x\\text{ min}}{800\\text{ mL}} &= \\frac{1\\text{ min}}{25\\text{ drops}}\\times\\frac{16\\text{ drops}}{1\\text{ mL}}\\\\\\frac{x\\text{ min}}{800\\text{ mL}} &= \\frac{16\\text{ min}}{25\\text{ mL}}\\\\x &= \\frac{800\\times16}{25}\\\\x &= 512\\end{align*}$$\nSince $512=8\\times60+32$, the required time is **8 h 32 min**.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 58
  },
