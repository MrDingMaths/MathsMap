  "content": {
    "id": "p8-q2",
    "type": "question",
    "label": "2",
    "prompt": "Factorise these expressions, if possible.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$30x+18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(5x+3)$",
          "worked": "HCF $=6$. Divide each term by $6$:\n$$\\begin{align*}30x+18&=6\\left(\\frac{30x}{6}+\\frac{18}{6}\\right)\\\\30x+18&=6(5x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$30x-18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(5x-3)$",
          "worked": "HCF $=6$. Divide each term by $6$:\n$$\\begin{align*}30x-18&=6\\left(\\frac{30x}{6}-\\frac{18}{6}\\right)\\\\30x-18&=6(5x-3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$30x-19$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Cannot factorise using a common integer factor greater than $1$.",
          "worked": "The HCF of $30$ and $19$ is $1$, and $19$ has no factor of $x$. There is no common integer factor greater than $1$ to take outside brackets.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p8-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$30x-20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10(3x-2)$",
          "worked": "HCF $=10$. Divide each term by $10$:\n$$\\begin{align*}30x-20&=10\\left(\\frac{30x}{10}-\\frac{20}{10}\\right)\\\\30x-20&=10(3x-2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$30x+20$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10(3x+2)$",
          "worked": "HCF $=10$. Divide each term by $10$:\n$$\\begin{align*}30x+20&=10\\left(\\frac{30x}{10}+\\frac{20}{10}\\right)\\\\30x+20&=10(3x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$35x+21$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7(5x+3)$",
          "worked": "HCF $=7$. Divide each term by $7$:\n$$\\begin{align*}35x+21&=7\\left(\\frac{35x}{7}+\\frac{21}{7}\\right)\\\\35x+21&=7(5x+3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$33x+18$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(11x+6)$",
          "worked": "The HCF is $3$.\n$$\\begin{aligned}33x+18&=3\\left(\\frac{33x}{3}+\\frac{18}{3}\\right)\\\\&=3(11x+6)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$27x+18$",
        "layout": "list",
        "columns": null,
