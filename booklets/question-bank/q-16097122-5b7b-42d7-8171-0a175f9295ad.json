        "children": [],
        "answer": {
          "short": "$18(x+1)$",
          "worked": "HCF $=18$. Divide each term by $18$:\n$$\\begin{align*}18x+18&=18\\left(\\frac{18x}{18}+\\frac{18}{18}\\right)\\\\18x+18&=18(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
