        "children": [],
        "answer": {
          "short": "$9(3x+2)$",
          "worked": "HCF $=9$. Divide each term by $9$:\n$$\\begin{align*}27x+18&=9\\left(\\frac{27x}{9}+\\frac{18}{9}\\right)\\\\27x+18&=9(3x+2)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p8-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$18x+18$",
        "layout": "list",
