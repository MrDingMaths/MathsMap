  "content": {
    "id": "p6-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Find $g(a)$, $g(-a)$ and $g(a+1)$ for each function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(x)=2x-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(a)=2a-4$, $g(-a)=-2a-4$, $g(a+1)=2a-2$.",
          "worked": "$$\\begin{align*}g(a)&=2a-4\\\\g(-a)&=2(-a)-4\\\\g(-a)&=-2a-4\\\\g(a+1)&=2(a+1)-4\\\\g(a+1)&=2a-2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(x)=2-x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(a)=2-a$, $g(-a)=2+a$, $g(a+1)=1-a$.",
          "worked": "$$\\begin{align*}g(a)&=2-a\\\\g(-a)&=2-(-a)\\\\g(-a)&=2+a\\\\g(a+1)&=2-(a+1)\\\\g(a+1)&=1-a\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(x)=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(a)=a^2$, $g(-a)=a^2$, $g(a+1)=a^2+2a+1$.",
          "worked": "$$\\begin{align*}g(a)&=a^2\\\\g(-a)&=(-a)^2\\\\g(-a)&=a^2\\\\g(a+1)&=(a+1)^2\\\\g(a+1)&=a^2+2a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p6-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(x)=\\dfrac{1}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$g(a)=\\dfrac{1}{a-1}$, $g(-a)=-\\dfrac{1}{a+1}$, $g(a+1)=\\dfrac{1}{a}$.",
          "worked": "$$\\begin{align*}g(a)&=\\frac{1}{a-1}\\\\g(-a)&=\\frac{1}{-a-1}\\\\g(-a)&=-\\frac{1}{a+1}\\\\g(a+1)&=\\frac{1}{(a+1)-1}\\\\g(a+1)&=\\frac{1}{a}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      }
    ]
  },
