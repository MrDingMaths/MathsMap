    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Divide each term in the numerator by the denominator, then differentiate.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{x^3-3x+8}{x^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=1+3x^{-2}-16x^{-3}$",
          "worked": "$$\\begin{aligned}y&=\\frac{x^3}{x^2}-\\frac{3x}{x^2}+\\frac{8}{x^2}\\\\y&=x-3x^{-1}+8x^{-2}\\\\\\frac{dy}{dx}&=1+3x^{-2}-16x^{-3}\\\\\\frac{dy}{dx}&=1+\\frac{3}{x^2}-\\frac{16}{x^3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p14-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{x^2+6x\\sqrt{x}+x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=1+3x^{-\\frac12}$",
          "worked": "$$\\begin{aligned}y&=\\frac{x^2}{x}+\\frac{6x\\sqrt{x}}{x}+\\frac{x}{x}\\\\y&=x+6x^{\\frac12}+1\\\\\\frac{dy}{dx}&=1+3x^{-\\frac12}\\\\\\frac{dy}{dx}&=1+\\frac{3}{\\sqrt{x}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p14-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=\\dfrac{3x-2\\sqrt{x}}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{dy}{dx}=\\dfrac32x^{-\\frac12}$",
          "worked": "$$\\begin{aligned}y&=\\frac{3x}{\\sqrt{x}}-\\frac{2\\sqrt{x}}{\\sqrt{x}}\\\\y&=3x^{\\frac12}-2\\\\\\frac{dy}{dx}&=\\frac32x^{-\\frac12}\\\\\\frac{dy}{dx}&=\\frac{3}{2\\sqrt{x}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
