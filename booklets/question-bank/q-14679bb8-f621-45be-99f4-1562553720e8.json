  "content": {
    "id": "p3-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A card is drawn randomly from a standard deck of 52 cards. Find the probability that the card drawn is",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q4a",
        "type": "part",
        "label": "a",
        "prompt": "a heart.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{4}$",
          "worked": "There are $13$ hearts among the $52$ cards. $$\\begin{align*}P(\\text{heart})&=\\frac{13}{52}\\\\P(\\text{heart})&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p3-q4b",
        "type": "part",
        "label": "b",
        "prompt": "a heart or a king.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p3-q4b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{4}{13}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p3-q4b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Count the king of hearts once.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "There are $13$ hearts and $4$ kings. The king of hearts belongs to both groups. $$\\begin{align*}P(\\text{heart or king})&=\\frac{13+4-1}{52}\\\\P(\\text{heart or king})&=\\frac{4}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p3-q4c",
        "type": "part",
        "label": "c",
        "prompt": "the queen of diamonds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{52}$",
          "worked": "The queen of diamonds is one card among the $52$. $$P(\\text{queen of diamonds})=\\frac{1}{52}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 11
      },
      {
        "id": "p3-q4d",
        "type": "part",
        "label": "d",
        "prompt": "not a diamond.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{4}$",
          "worked": "There are $13$ diamonds. Use the complement of drawing a diamond. $$\\begin{align*}P(\\text{not a diamond})&=1-\\frac{13}{52}\\\\P(\\text{not a diamond})&=\\frac{3}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-q4e",
        "type": "part",
        "label": "e",
        "prompt": "a red jack.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{26}$",
          "worked": "The jack of hearts and the jack of diamonds are the two red jacks. $$\\begin{align*}P(\\text{red jack})&=\\frac{2}{52}\\\\P(\\text{red jack})&=\\frac{1}{26}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p3-q4f",
        "type": "part",
        "label": "f",
        "prompt": "a queen or a red card.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p3-q4f-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{7}{13}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p3-q4f-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Add the two black queens to the 26 red cards.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The $26$ red cards already include the two red queens. The two black queens give two more favourable cards. $$\\begin{align*}P(\\text{queen or red card})&=\\frac{26+2}{52}\\\\P(\\text{queen or red card})&=\\frac{7}{13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
