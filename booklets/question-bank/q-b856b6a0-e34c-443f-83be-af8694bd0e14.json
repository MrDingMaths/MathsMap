    "children": [
      {
        "id": "v2-03008-p17-practice-slot-7-slot-7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=3\\sin^{-1}(x+1)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $[-2,0]$. Range: $\\left[-\\frac{3\\pi}{2},\\frac{3\\pi}{2}\\right]$.",
          "worked": "$$\\begin{aligned}-1&\\le x+1\\le1\\\\-2&\\le x\\le0\\end{aligned}$$\n\n$$\\begin{aligned}-\\frac{\\pi}{2}&\\le\\sin^{-1}(x+1)\\le\\frac{\\pi}{2}\\\\-\\frac{3\\pi}{2}&\\le3\\sin^{-1}(x+1)\\le\\frac{3\\pi}{2}\\end{aligned}$$\n\nDomain: $[-2,0]$. Range: $\\left[-\\frac{3\\pi}{2},\\frac{3\\pi}{2}\\right]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-03008-p17-practice-slot-7-slot-7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2\\cos^{-1}(3x)+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $\\left[-\\frac13,\\frac13\\right]$. Range: $[1,2\\pi+1]$.",
          "worked": "$$\\begin{aligned}-1&\\le3x\\le1\\\\-\\frac13&\\le x\\le\\frac13\\end{aligned}$$\n\n$$\\begin{aligned}0&\\le\\cos^{-1}(3x)\\le\\pi\\\\0&\\le2\\cos^{-1}(3x)\\le2\\pi\\\\1&\\le2\\cos^{-1}(3x)+1\\le2\\pi+1\\end{aligned}$$\n\nDomain: $\\left[-\\frac13,\\frac13\\right]$. Range: $[1,2\\pi+1]$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-03008-p17-practice-slot-7-slot-7-c",
        "type": "part",
        "label": "c",
        "prompt": "$y=4\\tan^{-1}(x-2)-\\pi$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $\\mathbb R$. Range: $(-3\\pi,\\pi)$.",
          "worked": "Inverse tangent accepts every real input, so $x-2$ places no restriction on $x$.\n\n$$\\begin{aligned}-\\frac{\\pi}{2}&<\\tan^{-1}(x-2)<\\frac{\\pi}{2}\\\\-2\\pi&<4\\tan^{-1}(x-2)<2\\pi\\\\-3\\pi&<4\\tan^{-1}(x-2)-\\pi<\\pi\\end{aligned}$$\n\nDomain: $\\mathbb R$. Range: $(-3\\pi,\\pi)$. The end values are excluded.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
