  "content": {
    "id": "p45-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "Let $f(x)=(2x-3)^2$. Find the values of $x$ for which",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p45-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{2}$",
          "worked": "A square is zero when its base is zero.\n\n$$\\begin{align*}(2x-3)^2&=0\\\\2x-3&=0\\\\x&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p45-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "$f'(x)=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{2}$",
          "worked": "By the chain rule, $f'(x)=4(2x-3)$.\n\n$$\\begin{align*}4(2x-3)&=0\\\\2x-3&=0\\\\x&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p45-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "$f'(x)>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x>\\frac{3}{2}$",
          "worked": "By the chain rule, $f'(x)=4(2x-3)$.\n\n$$\\begin{align*}4(2x-3)&>0\\\\2x-3&>0\\\\x&>\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p45-q18-d",
        "type": "part",
        "label": "d",
        "prompt": "$f'(x)=10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{11}{4}$",
          "worked": "By the chain rule, $f'(x)=4(2x-3)$.\n\n$$\\begin{align*}4(2x-3)&=10\\\\2x-3&=\\frac{5}{2}\\\\2x&=\\frac{11}{2}\\\\x&=\\frac{11}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
