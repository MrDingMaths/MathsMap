  "content": {
    "id": "v2-ebd82-p56-practice-j5-132537-root",
    "type": "question",
    "label": null,
    "prompt": "Consider the digits 1, 2, 3, 4, 5 and 6.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-ebd82-p56-practice-j5-132537-j5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "How many different three-digit numbers can be made using each of the digits 2, 5 and 6 once?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}N&=3!\\\\&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-ebd82-p56-practice-j5-132537-j5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "How many of the numbers in part a have their digits in descending order?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Only $652$ has its digits in descending order.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-ebd82-p56-practice-j5-132537-j5-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find how many three-digit numbers are possible if the digits are to be in descending order.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "Each selection of three digits has exactly one descending arrangement, so choose three of the six digits.\n$$\\begin{align*}N&={}^{6}C_{3}\\\\&=20\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
