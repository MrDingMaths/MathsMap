    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{2\\sqrt6+3}{5}$",
      "worked": "$$\\begin{align*}\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}&=\\frac{\\sqrt3(2\\sqrt2+\\sqrt3)}{(2\\sqrt2-\\sqrt3)(2\\sqrt2+\\sqrt3)}\\\\\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}&=\\frac{2\\sqrt6+3}{8-3}\\\\\\frac{\\sqrt3}{2\\sqrt2-\\sqrt3}&=\\frac{2\\sqrt6+3}{5}\\end{align*}$$",
