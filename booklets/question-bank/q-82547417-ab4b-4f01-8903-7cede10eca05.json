  "content": {
    "id": "p42-q5",
    "type": "question",
    "label": null,
    "prompt": "When a function $f(x)$ is composed with a linear function $g(x)$ the result is a transformation of $f(x)$. Let $f(x)=x^2-4$ and $g(x)=x+1$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the domain and range of $y=f(x)$. A sketch may help.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Domain: $x\\in\\mathbb R$. Range: $y\\geq-4$.",
          "worked": "$x^2-4$ is defined for every real $x$. Since $x^2\\geq0$, the minimum value of $f(x)$ is $-4$, attained at $x=0$.\n\nDomain: $x\\in\\mathbb R$. Range: $y\\geq-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p42-q5-b",
        "type": "group",
        "label": "b",
        "prompt": "Find the values of:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q5-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(g(3))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$12$",
              "worked": "$$\\begin{align*}g(3)&=3+1=4\\\\f(g(3))&=f(4)\\\\f(g(3))&=4^2-4=12\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q5-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$g(f(3))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$6$",
              "worked": "$$\\begin{align*}f(3)&=3^2-4=5\\\\g(f(3))&=g(5)\\\\g(f(3))&=5+1=6\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p42-q5-c",
        "type": "group",
        "label": "c",
        "prompt": "Find expressions for:",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q5-c-i",
            "type": "part",
            "label": "i",
            "prompt": "$f(g(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$f(g(x))=x^2+2x-3$",
              "worked": "$$\\begin{align*}f(g(x))&=f(x+1)\\\\f(g(x))&=(x+1)^2-4\\\\f(g(x))&=x^2+2x-3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q5-c-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$g(f(x))$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$g(f(x))=x^2-3$",
              "worked": "$$\\begin{align*}g(f(x))&=f(x)+1\\\\g(f(x))&=(x^2-4)+1\\\\g(f(x))&=x^2-3\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          }
        ]
      },
      {
        "id": "p42-q5-d",
        "type": "group",
        "label": "d",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q5-d-i",
            "type": "part",
            "label": "i",
            "prompt": "What transformation maps the graph of $y=f(x)$ to the graph of $y=f(g(x))$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Shift 1 unit to the left.",
              "worked": "$f(g(x))=f(x+1)$. Replacing $x$ by $x+1$ shifts the graph 1 unit to the left.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p42-q5-d-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Hence write down the domain and range of $y=f(g(x))$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Domain: $x\\in\\mathbb R$. Range: $y\\geq-4$.",
              "worked": "The horizontal shift leaves the domain as all real numbers and preserves the minimum value $-4$.\n\nDomain: $x\\in\\mathbb R$. Range: $y\\geq-4$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      },
      {
        "id": "p42-q5-e",
        "type": "group",
        "label": "e",
        "prompt": "",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q5-e-i",
            "type": "part",
            "label": "i",
            "prompt": "What transformation maps the graph of $y=f(x)$ to the graph of $y=g(f(x))$?",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Shift 1 unit up.",
              "worked": "$g(f(x))=f(x)+1$, so every output increases by 1. The graph shifts 1 unit up.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          },
          {
            "id": "p42-q5-e-ii",
            "type": "part",
            "label": "ii",
            "prompt": "Hence write down the domain and range of $y=g(f(x))$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Domain: $x\\in\\mathbb R$. Range: $y\\geq-3$.",
              "worked": "The vertical shift preserves the domain and increases the minimum output from $-4$ to $-3$.\n\nDomain: $x\\in\\mathbb R$. Range: $y\\geq-3$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 10
          }
        ]
      }
    ]
