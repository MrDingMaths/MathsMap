  "content": {
    "id": "p7-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A square has side length $4\\sqrt{7}$ cm. Find:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "the area of the square",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$112\\text{ cm}^2$",
          "worked": "$$\\begin{align*}A&=(4\\sqrt{7})^2\\\\A&=16\\times7\\\\A&=112\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "the length of a diagonal",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt{14}\\text{ cm}$",
          "worked": "The diagonal is the hypotenuse of a right-angled triangle with both shorter sides $4\\sqrt{7}$ cm. By Pythagoras' theorem,\n$$\\begin{align*}d^2&=(4\\sqrt{7})^2+(4\\sqrt{7})^2\\\\d^2&=112+112\\\\d^2&=224\\\\d&=\\sqrt{224}\\\\d&=4\\sqrt{14}\\text{ cm}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
  },
