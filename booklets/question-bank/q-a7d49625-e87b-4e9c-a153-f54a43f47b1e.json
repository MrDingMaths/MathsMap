  "content": {
    "id": "p42-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Paula is making a wooden box. She knows that for every $\\frac{3}{5}$ m of pine she needs 70 cm of oak.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "She states that the ratio of pine to oak is $\\frac{3}{5}:70$. Explain why she is incorrect.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The units are different.",
          "worked": "The pine is measured in metres and the oak in centimetres. Convert both lengths to the same unit before writing the ratio.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p42-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "Write the correct simplified ratio of pine to oak.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6:7$",
          "worked": "$$\\begin{align*}\\frac{3}{5}\\text{ m} &= \\frac{3}{5}\\times100\\text{ cm}\\\\&=60\\text{ cm}\\\\\\text{Pine}:\\text{oak} &=60:70\\\\&=6:7\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p42-q10-c",
        "type": "part",
        "label": "c",
        "prompt": "How many metres of pine would she need if she wants to use 14 m of oak?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12\\text{ m}$",
          "worked": "$$\\begin{align*}7\\text{ parts} &=14\\text{ m}\\\\1\\text{ part} &=14\\div7=2\\text{ m}\\\\6\\text{ parts} &=2\\times6=12\\text{ m}\\end{align*}$$\nShe needs 12 m of pine.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
