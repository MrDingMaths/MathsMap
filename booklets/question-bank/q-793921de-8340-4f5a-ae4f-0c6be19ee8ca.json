  "content": {
    "id": "p46-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "A loan of $\\$6000$ is paid back in equal annual instalments over 3 years. If the interest is 12.5% p.a., find the amount of each annual instalment to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2519.59$ annually.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p46-q1-worked-definition",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Let each annual instalment be ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "M",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ".",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p46-q1-worked-balances",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}\\text{Start: }&6000\\\\\\text{1st repayment: }&6000(1.125)-M\\\\\\text{2nd repayment: }&6000(1.125)^2-M(1.125)-M\\\\\\text{3rd repayment: }&6000(1.125)^3-M(1.125)^2-M(1.125)-M\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p46-q1-worked-series",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The repayments form a geometric series with ",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "math",
                "latex": "a=M,\\ r=1.125,\\ n=3",
                "display": false,
                "colour": "#268cff"
              },
              {
                "type": "text",
                "text": ". When the loan is repaid, the balance is zero.",
                "marks": [],
                "colour": "#268cff"
              }
            ]
          },
          {
            "id": "p46-q1-worked-solve",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}0&=6000(1.125)^3-M\\left[\\frac{1.125^3-1}{1.125-1}\\right]\\\\M\\left[\\frac{1.125^3-1}{0.125}\\right]&=6000(1.125)^3\\\\M&=\\frac{6000(1.125)^3(0.125)}{1.125^3-1}\\\\M&\\approx\\$2519.59\\end{align*}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
