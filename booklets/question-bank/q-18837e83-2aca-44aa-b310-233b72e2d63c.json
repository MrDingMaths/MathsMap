    "children": [
      {
        "id": "v2-1659ef0f4-practice-slot-2-slot-2-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^3$ in $(1+2x)^3+(1+2x)^4+(1+2x)^5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "$$\\begin{align*}\\text{Coefficient of }x^3\\text{ in }(1+2x)^3&=\\binom33 2^3=8\\\\\\text{Coefficient of }x^3\\text{ in }(1+2x)^4&=\\binom43 2^3=32\\\\\\text{Coefficient of }x^3\\text{ in }(1+2x)^5&=\\binom53 2^3=80\\end{align*}$$\n$$\\text{Total}=8+32+80=120$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-1659ef0f4-practice-slot-2-slot-2-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^3$ in $(2-x)^4+(2-x)^5+(2-x)^6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-208$",
          "worked": "$$\\begin{align*}\\text{Coefficient of }x^3\\text{ in }(2-x)^4&=\\binom43 2^1(-1)^3=-8\\\\\\text{Coefficient of }x^3\\text{ in }(2-x)^5&=\\binom53 2^2(-1)^3=-40\\\\\\text{Coefficient of }x^3\\text{ in }(2-x)^6&=\\binom63 2^3(-1)^3=-160\\end{align*}$$\n$$\\text{Total}=-8-40-160=-208$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      }
    ]
  },
