  "content": {
    "id": "p15-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "A ball is thrust upwards from a machine on the ground.\nThe height ($h$ metres) after $t$ seconds is given by $h=t(4-t)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p15-q11-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[{\"name\":\"trajectoryBlue\",\"hex\":\"268CFF\",\"reason\":\"dashed trajectory distinguishes the flight path from the ground\"},{\"name\":\"motionRed\",\"hex\":\"EF6068\",\"reason\":\"arrow indicates the ascending direction of motion\"}],\"reference\":\"source page 15 p15-q11-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=0.4cm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{trajectoryBlue}{HTML}{268CFF}\n\\definecolor{motionRed}{HTML}{EF6068}\n\\draw[black,line width=0.8pt] (-0.25,0)--(4.25,0);\n\\draw[trajectoryBlue,dashed,line width=0.8pt] plot[domain=0:4,samples=81] (\\x,{\\x*(4-\\x)});\n\\coordinate (ball) at (1,3);\n\\draw[motionRed,line width=0.8pt,-{Stealth}] (ball)--(1.72,4.44);\n\\draw[black,fill=white,line width=0.8pt] (ball) circle[radius=1.9mm];\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 70,
        "alt": "Mathematical diagram",
        "overlayOf": null,
