    "children": [
      {
        "id": "p15-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the height after 1.5 seconds.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3.75\\text{ m}$",
          "worked": "$$\\begin{align*}h&=1.5(4-1.5)\\\\h&=1.5\\times2.5\\\\h&=3.75\\end{align*}$$\nThe height is $3.75\\text{ m}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Find when the ball is at ground level.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0\\text{ s}$ and $4\\text{ s}$",
          "worked": "At ground level, $h=0$.\n$$\\begin{align*}t(4-t)&=0\\\\t&=0\\quad\\text{or}\\quad4-t=0\\\\t&=0\\quad\\text{or}\\quad t=4\\end{align*}$$\nThe ball is at ground level at $0\\text{ s}$ and $4\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p15-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "Why are there two solutions to part **b**?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The ball starts on the ground and returns to the ground after $4\\text{ s}$.",
          "worked": "The ball is on the ground at launch, when $t=0$, and again when it falls back down, at $t=4\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p15-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "Find when the ball is at a height of 3 metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\text{ s}$ and $3\\text{ s}$",
          "worked": "$$\\begin{align*}t(4-t)&=3\\\\4t-t^2&=3\\\\t^2-4t+3&=0\\\\(t-1)(t-3)&=0\\\\t&=1\\quad\\text{or}\\quad t=3\\end{align*}$$\nThe ball is $3\\text{ m}$ high at $1\\text{ s}$ and $3\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p15-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "Find when the ball is at a height of 4 metres.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\text{ s}$",
          "worked": "$$\\begin{align*}t(4-t)&=4\\\\4t-t^2&=4\\\\t^2-4t+4&=0\\\\(t-2)^2&=0\\\\t&=2\\end{align*}$$\nThe ball is $4\\text{ m}$ high at $2\\text{ s}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p15-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "Why is there only one solution for part **e**?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\text{ m}$ is the maximum height, reached only once.",
          "worked": "The ball reaches its maximum height of $4\\text{ m}$ at $2\\text{ s}$, where it changes from rising to falling. It reaches this height only once.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
