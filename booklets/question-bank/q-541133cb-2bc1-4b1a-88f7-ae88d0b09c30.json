        "label": "a",
        "prompt": "A number, $x$, is multiplied by 3 and 2 is added to the result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x+2$",
          "worked": "Multiplying $x$ by 3 gives $3x$. Adding 2 gives $3x+2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "2 is added to $x$ and the result is multiplied by 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(x+2)$",
          "worked": "Adding 2 gives $x+2$. Multiplying this whole result by 3 gives $(x+2)\\times3=3(x+2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "A number, $x$, is multiplied by 5 and 3 is subtracted from the result.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5x-3$",
          "worked": "Multiplying $x$ by 5 gives $5x$. Subtracting 3 gives $5x-3$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p17-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "3 is subtracted from a number, $x$, and the result is multiplied by 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5(x-3)$",
          "worked": "Subtracting 3 gives $x-3$. Multiplying this whole result by 5 gives $(x-3)\\times5=5(x-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
