              "inlines": [
                {
                  "type": "math",
                  "latex": "\\ln(x)\\;\\xrightarrow[\\text{reflect}]{}\\;\\ln(-x)\\;\\xrightarrow[\\text{translate}]{}\\;\\ln(",
                  "display": false
                },
                {
                  "type": "cloze",
                  "answer": "$1-x$",
                  "width": 16
                },
                {
                  "type": "math",
