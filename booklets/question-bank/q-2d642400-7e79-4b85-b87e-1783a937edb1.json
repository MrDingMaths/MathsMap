                  "display": false
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-x$",
          "worked": "The translation replaces $x$ with $x-1$ in $\\ln(-x)$. The argument becomes $-(x-1)=1-x$.\n\n$$\\ln(x)\\;\\xrightarrow[\\text{reflect}]{}\\;\\ln(-x)\\;\\xrightarrow[\\text{translate}]{}\\;\\ln(1-x)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 0,
        "responseSpace": "scaffold"
      },
      {
        "id": "p14-q10e",
        "type": "part",
        "label": "e",
        "prompt": "From the above, did the order matter or did you end up with the same curve doing it either way?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The order mattered.",
          "worked": "The order mattered. Translating first gives $y=\\ln(-x-1)$ with domain $x<-1$. Reflecting first gives $y=\\ln(1-x)$ with domain $x<1$. The different domains show that the curves differ.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
