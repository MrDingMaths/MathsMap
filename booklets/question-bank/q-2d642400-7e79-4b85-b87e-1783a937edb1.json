        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-x-1$",
          "worked": "The reflection replaces $x$ with $-x$ in $\\ln(x-1)$.\n\n$$\\ln(x)\\;\\xrightarrow[\\text{translate}]{}\\;\\ln(x-1)\\;\\xrightarrow[\\text{reflect}]{}\\;\\ln(-x-1)$$",
