  "content": {
    "id": "p14-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Consider the graph of $y=\\ln(x)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q10a",
        "type": "part",
        "label": "a",
        "prompt": "Write down the equation of the graph when it is translated right by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln(x-1)$",
          "worked": "Replace $x$ with $x-1$ for the translation right by 1 unit.\n\n$$y=\\ln(x-1)$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p14-q10b",
        "type": "part",
        "label": "b",
        "prompt": "Write down the new equation if the graph is then reflected across the $y$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\ln(-x-1)$",
          "worked": "Replace $x$ with $-x$ in the equation from part (a).\n\n$$\\begin{align*}y&=\\ln((-x)-1)\\\\y&=\\ln(-x-1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p14-q10c",
        "type": "part",
        "label": "c",
        "prompt": {
