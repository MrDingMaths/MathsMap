  "content": {
    "id": "p30-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Given $\\underset{\\sim}{a}=2i+5j$ and $\\underset{\\sim}{b}=3i+j$, find these resultant vectors in component form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}+\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5i+6j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}+\\underset{\\sim}{b}&=(2i+5j)+(3i+j)\\\\&=5i+6j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}-\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-i+4j$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}-\\underset{\\sim}{b}&=(2i+5j)-(3i+j)\\\\&=-i+4j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p30-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$2\\underset{\\sim}{a}+\\underset{\\sim}{b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7i+11j$",
          "worked": "$$\\begin{aligned}2\\underset{\\sim}{a}+\\underset{\\sim}{b}&=2(2i+5j)+(3i+j)\\\\&=4i+10j+3i+j\\\\&=7i+11j\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
