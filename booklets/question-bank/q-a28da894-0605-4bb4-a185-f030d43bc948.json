  "content": {
    "id": "p30-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "Given $\\underset{\\sim}{a}=4i-2j$ and $\\underset{\\sim}{b}=-i+3j$, find these resultant vectors in component form:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q3-ab",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 2,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "$\\underset{\\sim}{b}-\\underset{\\sim}{a}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$-5i+5j$",
              "worked": "$$\\begin{aligned}\\underset{\\sim}{b}-\\underset{\\sim}{a}&=(-i+3j)-(4i-2j)\\\\&=-5i+5j\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p30-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "$3\\underset{\\sim}{a}-2\\underset{\\sim}{b}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$14i-12j$",
              "worked": "$$\\begin{aligned}3\\underset{\\sim}{a}-2\\underset{\\sim}{b}&=3(4i-2j)-2(-i+3j)\\\\&=12i-6j+2i-6j\\\\&=14i-12j\\end{aligned}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 23
          }
        ]
      },
      {
        "id": "p30-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "If $\\underset{\\sim}{a}+k\\underset{\\sim}{b}=2i+4j$,\nfind $k$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=2$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}+k\\underset{\\sim}{b}&=2i+4j\\\\(4i-2j)+k(-i+3j)&=2i+4j\\\\4i-2j-ki+3kj&=2i+4j\\\\(4-k)i+(-2+3k)j&=2i+4j\\end{aligned}$$\nEquate $i$-components:\n$$\\begin{aligned}4-k&=2\\\\k&=2\\end{aligned}$$\nEquate $j$-components:\n$$\\begin{aligned}-2+3k&=4\\\\k&=2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      }
    ]
  },
