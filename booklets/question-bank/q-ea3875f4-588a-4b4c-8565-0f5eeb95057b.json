        "answer": {
          "short": "$5s^5$",
          "worked": "$$\\begin{align*}(5st^2)^3\\div(5s^{-1}t^3)^2&=\\frac{125s^3t^6}{25s^{-2}t^6}\\\\(5st^2)^3\\div(5s^{-1}t^3)^2&=5s^5\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p11-q2-r",
        "type": "part",
        "label": "r",
        "prompt": "$(2a^{-2}y^3)^{-2}\\div(2ay^{-3})^3$",
        "layout": "list",
        "columns": null,
