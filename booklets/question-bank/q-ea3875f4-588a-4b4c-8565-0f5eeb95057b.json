        "answer": {
          "short": "$\\frac{4}{3f^2}$",
          "worked": "$$\\begin{align*}\\frac{4f^{-5}}{3f^{-3}}&=\\frac43f^{-2}\\\\\\frac{4f^{-5}}{3f^{-3}}&=\\frac{4}{3f^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q2-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{3d^{-3}}{6d^{-1}}$",
