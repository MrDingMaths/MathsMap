    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2y\\times x^4y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^6y^4$",
          "worked": "$$\\begin{align*}x^2y\\times x^4y^3&=x^{2+4}y^{1+3}\\\\x^2y\\times x^4y^3&=x^6y^4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{-5}y^3\\times x^3y^{-2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{y}{x^2}$",
          "worked": "$$\\begin{align*}x^{-5}y^3\\times x^3y^{-2}&=x^{-2}y\\\\x^{-5}y^3\\times x^3y^{-2}&=\\frac{y}{x^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$0.2s^{-2}t^3\\times 5st^{-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{st^2}$",
          "worked": "$$\\begin{align*}0.2s^{-2}t^3\\times5st^{-5}&=s^{-1}t^{-2}\\\\0.2s^{-2}t^3\\times5st^{-5}&=\\frac{1}{st^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$56x^2y^6\\div 8xy^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7x}{y^2}$",
          "worked": "$$\\begin{align*}56x^2y^6\\div8xy^8&=7xy^{-2}\\\\56x^2y^6\\div8xy^8&=\\frac{7x}{y^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$(s^2y^{-3})^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{s^6}{y^9}$",
          "worked": "$$\\begin{align*}(s^2y^{-3})^3&=s^6y^{-9}\\\\(s^2y^{-3})^3&=\\frac{s^6}{y^9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$(5c^{-2}d^3)^{-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{c^2}{5d^3}$",
          "worked": "$$\\begin{align*}(5c^{-2}d^3)^{-1}&=\\frac{1}{5c^{-2}d^3}\\\\(5c^{-2}d^3)^{-1}&=\\frac{c^2}{5d^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$3a^{-4}\\times2a^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{a^2}$",
          "worked": "$$\\begin{align*}3a^{-4}\\times2a^2&=6a^{-2}\\\\3a^{-4}\\times2a^2&=\\frac{6}{a^2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$5m^{-4}\\times(-2m^{-2})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{10}{m^6}$",
          "worked": "$$\\begin{align*}5m^{-4}\\times(-2m^{-2})&=-10m^{-6}\\\\5m^{-4}\\times(-2m^{-2})&=-\\frac{10}{m^6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p11-q2-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{2x^{-2}}{3x^{-3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{3}$",
          "worked": "$$\\begin{align*}\\frac{2x^{-2}}{3x^{-3}}&=\\frac{2}{3}x^{-2-(-3)}\\\\\\frac{2x^{-2}}{3x^{-3}}&=\\frac{2x}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q2-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{7d^{-3}}{10d^{-5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{7d^2}{10}$",
          "worked": "$$\\begin{align*}\\frac{7d^{-3}}{10d^{-5}}&=\\frac{7}{10}d^{-3-(-5)}\\\\\\frac{7d^{-3}}{10d^{-5}}&=\\frac{7d^2}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q2-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{6c^{-5}}{12c^{-5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2}$",
          "worked": "$$\\begin{align*}\\frac{6c^{-5}}{12c^{-5}}&=\\frac12c^0\\\\\\frac{6c^{-5}}{12c^{-5}}&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q2-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{5s^{-2}}{3s}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{3s^3}$",
          "worked": "$$\\begin{align*}\\frac{5s^{-2}}{3s}&=\\frac53s^{-3}\\\\\\frac{5s^{-2}}{3s}&=\\frac{5}{3s^3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p11-q2-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{4f^{-5}}{3f^{-3}}$",
        "layout": "list",
        "columns": null,
