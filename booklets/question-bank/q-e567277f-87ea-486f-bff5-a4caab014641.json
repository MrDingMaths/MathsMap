  "content": {
    "id": "p23-q20-root",
    "type": "question",
    "label": "20",
    "prompt": "Find the pair of numbers whose sum is $\\frac14$ and whose difference is $\\frac13$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac7{24}$ and $-\\frac1{24}$.",
      "worked": "Let $x$ be the larger number and $y$ the smaller number.\n$$\\begin{align*}x+y&=\\frac14\\\\x-y&=\\frac13\\\\2x&=\\frac14+\\frac13\\\\2x&=\\frac7{12}\\\\x&=\\frac7{24}\\\\y&=\\frac14-\\frac7{24}\\\\y&=-\\frac1{24}\\end{align*}$$\nThe numbers are $\\frac7{24}$ and $-\\frac1{24}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 84
  },
