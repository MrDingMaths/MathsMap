  "content": {
    "id": "p49-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Find the number if:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p49-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$80\\%$ of the number is $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$75$",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}0.8x &= 60\\\\x &= \\frac{60}{0.8}\\\\x &= 75\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$75\\%$ of the number is $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80$",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}0.75x &= 60\\\\x &= \\frac{60}{0.75}\\\\x &= 80\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$12\\%$ of the number is $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$500$",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}0.12x &= 60\\\\x &= \\frac{60}{0.12}\\\\x &= 500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$12.5\\%$ of a number is $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$480$",
          "worked": "Let $x$ be the number.\n$$\\begin{align*}0.125x &= 60\\\\x &= \\frac{60}{0.125}\\\\x &= 480\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p49-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$33\\frac{1}{3}\\%$ of a number is $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$180$",
          "worked": "Let $x$ be the number. Since $33\\frac{1}{3}\\%=\\frac{1}{3}$,\n$$\\begin{align*}\\frac{1}{3}x &= 60\\\\x &= 60\\div\\frac{1}{3}\\\\x &= 180\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p49-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$66\\frac{2}{3}\\%$ of a number is $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$90$",
          "worked": "Let $x$ be the number. Since $66\\frac{2}{3}\\%=\\frac{2}{3}$,\n$$\\begin{align*}\\frac{2}{3}x &= 60\\\\x &= 60\\div\\frac{2}{3}\\\\x &= 90\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
