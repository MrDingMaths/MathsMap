  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "A pen and a pencil together cost $\\$1.10$. The pen costs $\\$1$ more than the pencil. How much does the pen cost?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$1.05$",
      "worked": "Let the pencil cost $x$ dollars. The pen costs $x+1$ dollars.\n$$\\begin{align*}x+(x+1)&=1.10\\\\2x+1&=1.10\\\\2x&=0.10\\\\x&=0.05\\end{align*}$$\nThe pen costs $\\$0.05+\\$1=\\$1.05$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 52
  },
