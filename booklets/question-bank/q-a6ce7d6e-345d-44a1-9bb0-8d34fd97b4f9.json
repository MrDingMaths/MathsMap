  "content": {
    "id": "v2-5975df-p7-practice-j8-083413-root",
    "type": "question",
    "label": null,
    "prompt": "A $20$ g sample of a substance halves in mass every day. Find the mass of the sample:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-5975df-p7-practice-j8-083413-j8-q-a",
        "type": "part",
        "label": "a",
        "prompt": "at the start",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$ g.",
          "worked": "$$a_1=20\\text{ g}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-5975df-p7-practice-j8-083413-j8-q-b",
        "type": "part",
        "label": "b",
        "prompt": "after $1$ day",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$10$ g.",
          "worked": "$$\\begin{align*}a_2&=20\\left(\\tfrac12\\right)^1\\\\&=10\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-5975df-p7-practice-j8-083413-j8-q-c",
        "type": "part",
        "label": "c",
        "prompt": "after $2$ days",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$ g.",
          "worked": "$$\\begin{align*}a_3&=20\\left(\\tfrac12\\right)^2\\\\&=5\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-5975df-p7-practice-j8-083413-j8-q-d",
        "type": "part",
        "label": "d",
        "prompt": "after $5$ days",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.625$ g.",
          "worked": "$$\\begin{align*}a_6&=20\\left(\\tfrac12\\right)^5\\\\&=0.625\\text{ g}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "v2-5975df-p7-practice-j8-083413-j8-q-e",
        "type": "part",
        "label": "e",
        "prompt": "after $k$ days",
