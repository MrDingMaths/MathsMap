  "content": {
    "id": "p57-q18-root",
    "type": "question",
    "label": "18",
    "prompt": "When $x^5+3x^3+ax+b$ is divided by $x^2-1$, the remainder is $2x-7$. Find $a$ and $b$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=-2$, $b=-7$; substitute $x=1$ and $x=-1$ and solve simultaneously.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p57-q18-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "P(x)=(x-1)(x+1)Q(x)+2x-7",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}P(1)&=1^5+3(1)^3+a(1)+b\\\\P(1)&=2(1)-7=-5\\\\4+a+b&=-5\\\\a+b&=-9\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}P(-1)&=(-1)^5+3(-1)^3+a(-1)+b\\\\P(-1)&=2(-1)-7=-9\\\\-4-a+b&=-9\\\\-a+b&=-5\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Solving simultaneously:",
                "marks": [],
                "colour": "#268cff"
              },
              {
                "type": "break"
              },
              {
                "type": "math",
                "latex": "\\begin{aligned}2b&=-14\\\\b&=-7\\\\a&=-9-(-7)=-2\\end{aligned}",
                "display": true,
                "colour": "#268cff"
              }
            ]
          }
        ]
      },
      "solutionDiagrams": []
    },
