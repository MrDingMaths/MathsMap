  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find the exact values, rationalising the denominator where appropriate.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$(\\sin 60^\\circ)^2+(\\cos 60^\\circ)^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{align*}(\\sin 60^\\circ)^2+(\\cos 60^\\circ)^2&=\\left(\\frac{\\sqrt3}{2}\\right)^2+\\left(\\frac12\\right)^2\\\\(\\sin 60^\\circ)^2+(\\cos 60^\\circ)^2&=\\frac34+\\frac14\\\\(\\sin 60^\\circ)^2+(\\cos 60^\\circ)^2&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$(\\tan 30^\\circ)^2-\\dfrac{1}{(\\cos 30^\\circ)^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}(\\tan 30^\\circ)^2-\\frac{1}{(\\cos 30^\\circ)^2}&=\\left(\\frac1{\\sqrt3}\\right)^2-\\frac1{\\left(\\frac{\\sqrt3}{2}\\right)^2}\\\\(\\tan 30^\\circ)^2-\\frac{1}{(\\cos 30^\\circ)^2}&=\\frac13-\\frac1{3/4}\\\\(\\tan 30^\\circ)^2-\\frac{1}{(\\cos 30^\\circ)^2}&=\\frac13-\\frac43\\\\(\\tan 30^\\circ)^2-\\frac{1}{(\\cos 30^\\circ)^2}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\times\\tan45^\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2-\\sqrt3$\n\nSubstitute the exact ratios and rationalise using the conjugate.",
          "worked": "$$\\begin{align*}\\frac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\times\\tan45^\\circ}&=\\frac{\\sqrt3-1}{1+\\sqrt3\\times1}\\\\\\frac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\times\\tan45^\\circ}&=\\frac{\\sqrt3-1}{\\sqrt3+1}\\times\\frac{\\sqrt3-1}{\\sqrt3-1}\\\\\\frac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\times\\tan45^\\circ}&=\\frac{3-2\\sqrt3+1}{3-1}\\\\\\frac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\times\\tan45^\\circ}&=\\frac{4-2\\sqrt3}{2}\\\\\\frac{\\tan60^\\circ-\\tan45^\\circ}{1+\\tan60^\\circ\\times\\tan45^\\circ}&=2-\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p7-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sin45^\\circ\\times\\cos60^\\circ+\\cos45^\\circ\\times\\sin60^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt2+\\sqrt6}{4}$",
          "worked": "Using the exact ratios,\n$$\\begin{align*}\\sin45^\\circ\\times\\cos60^\\circ+\\cos45^\\circ\\times\\sin60^\\circ&=\\frac1{\\sqrt2}\\times\\frac12+\\frac1{\\sqrt2}\\times\\frac{\\sqrt3}{2}\\\\\\sin45^\\circ\\times\\cos60^\\circ+\\cos45^\\circ\\times\\sin60^\\circ&=\\frac{1+\\sqrt3}{2\\sqrt2}\\\\\\sin45^\\circ\\times\\cos60^\\circ+\\cos45^\\circ\\times\\sin60^\\circ&=\\frac{1+\\sqrt3}{2\\sqrt2}\\times\\frac{\\sqrt2}{\\sqrt2}\\\\\\sin45^\\circ\\times\\cos60^\\circ+\\cos45^\\circ\\times\\sin60^\\circ&=\\frac{\\sqrt2+\\sqrt6}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 55
      },
      {
        "id": "p7-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$2\\sin30^\\circ\\times\\cos30^\\circ$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt3}{2}$",
          "worked": "$$\\begin{align*}2\\sin30^\\circ\\times\\cos30^\\circ&=2\\times\\frac12\\times\\frac{\\sqrt3}{2}\\\\2\\sin30^\\circ\\times\\cos30^\\circ&=\\frac{\\sqrt3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$2(\\cos45^\\circ)^2-1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}2(\\cos45^\\circ)^2-1&=2\\left(\\frac1{\\sqrt2}\\right)^2-1\\\\2(\\cos45^\\circ)^2-1&=2\\times\\frac12-1\\\\2(\\cos45^\\circ)^2-1&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
