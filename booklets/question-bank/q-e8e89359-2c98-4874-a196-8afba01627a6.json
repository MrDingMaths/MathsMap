  "content": {
    "id": "p22-q5-root",
    "type": "question",
    "label": "",
    "prompt": "Make $x$ the subject.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p22-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\frac{ax+b}{4}=\\frac{x+c}{3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{4c-3b}{3a-4}$",
          "worked": "$$\\begin{align*}3(ax+b)&=4(x+c)\\\\3ax+3b&=4x+4c\\\\3ax-4x&=4c-3b\\\\x(3a-4)&=4c-3b\\\\x&=\\frac{4c-3b}{3a-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p22-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\frac{x}{a}-\\frac{x}{2a}=b$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2ab$",
          "worked": "$$\\begin{align*}2x-x&=2ab\\\\x(2-1)&=2ab\\\\x&=2ab\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p22-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\frac{ax}{b}-\\frac{cx}{2}=d$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2bd}{2a-bc}$",
          "worked": "$$\\begin{align*}2ax-bcx&=2bd\\\\x(2a-bc)&=2bd\\\\x&=\\frac{2bd}{2a-bc}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\frac{x-a}{b}=\\frac{x}{c}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{ca}{c-b}$",
          "worked": "$$\\begin{align*}c(x-a)&=bx\\\\cx-ca&=bx\\\\cx-bx&=ca\\\\x(c-b)&=ca\\\\x&=\\frac{ca}{c-b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\frac{x+a}{b}=\\frac{d+e}{c}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{bd+be-ac}{c}$",
          "worked": "$$\\begin{align*}c(x+a)&=b(d+e)\\\\cx+ac&=bd+be\\\\cx&=bd+be-ac\\\\x&=\\frac{bd+be-ac}{c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\frac{x+a}{3b}+\\frac{x-a}{2b}=1$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{6b+a}{5}$",
          "worked": "$$\\begin{align*}2(x+a)+3(x-a)&=6b\\\\2x+2a+3x-3a&=6b\\\\5x-a&=6b\\\\5x&=6b+a\\\\x&=\\frac{6b+a}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\frac{a}{x}=\\frac{b}{c}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{ac}{b}$",
          "worked": "$$\\begin{align*}bx&=ac\\\\x&=\\frac{ac}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p23-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\frac{2a-b}{a}+\\frac{a}{x}=a$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{a^2}{a^2-2a+b}$",
          "worked": "$$\\begin{align*}x(2a-b)+a^2&=a^2x\\\\2ax-bx+a^2&=a^2x\\\\a^2x-2ax+bx&=a^2\\\\x(a^2-2a+b)&=a^2\\\\x&=\\frac{a^2}{a^2-2a+b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\frac{a}{x}+b=\\frac{c}{x}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{a-c}{b}$",
          "worked": "$$\\begin{align*}a+bx&=c\\\\bx&=c-a\\\\x&=\\frac{c-a}{b}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p23-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\frac{ax-b}{x-b}=c$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{b-bc}{a-c}$",
          "worked": "$$\\begin{align*}ax-b&=c(x-b)\\\\ax-b&=cx-bc\\\\ax-cx&=b-bc\\\\x(a-c)&=b-bc\\\\x&=\\frac{b-bc}{a-c}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\frac{cx+b}{x+a}=d$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{ad-b}{c-d}$",
          "worked": "$$\\begin{align*}cx+b&=d(x+a)\\\\cx+b&=dx+ad\\\\cx-dx&=ad-b\\\\x(c-d)&=ad-b\\\\x&=\\frac{ad-b}{c-d}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\frac{1}{x-a}=\\frac{1}{ax+b}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{-a-b}{a-1}$",
          "worked": "$$\\begin{align*}ax+b&=x-a\\\\ax-x&=-a-b\\\\x(a-1)&=-a-b\\\\x&=\\frac{-a-b}{a-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p23-q5-m",
        "type": "part",
        "label": "m",
        "prompt": "$$y=\\frac{5x+5b}{x+a}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5b-ay}{y-5}$",
          "worked": "$$\\begin{align*}y(x+a)&=5x+5b\\\\xy+ay&=5x+5b\\\\xy-5x&=5b-ay\\\\x(y-5)&=5b-ay\\\\x&=\\frac{5b-ay}{y-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-n",
        "type": "part",
        "label": "n",
        "prompt": "$$y=\\frac{5x+5b}{3x-3a}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3ay+5b}{3y-5}$",
          "worked": "$$\\begin{align*}y(3x-3a)&=5x+5b\\\\3xy-3ay&=5x+5b\\\\3xy-5x&=3ay+5b\\\\x(3y-5)&=3ay+5b\\\\x&=\\frac{3ay+5b}{3y-5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p23-q5-o",
        "type": "part",
        "label": "o",
        "prompt": "$$y-1=\\frac{9-x}{2x-3}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{6+3y}{2y-1}$",
          "worked": "$$\\begin{align*}(y-1)(2x-3)&=9-x\\\\2xy-3y-2x+3&=9-x\\\\2xy-2x+x&=6+3y\\\\2xy-x&=6+3y\\\\x(2y-1)&=6+3y\\\\x&=\\frac{6+3y}{2y-1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
