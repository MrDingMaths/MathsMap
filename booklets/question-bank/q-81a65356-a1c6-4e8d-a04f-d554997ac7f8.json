  "content": {
    "id": "p12-q11-response",
    "type": "question",
    "label": "11",
    "prompt": "With reference to the null factor law, explain why $y=(x-3)(x-5)$ and $y=2(x-3)(x-5)$ both have the same $x$-intercepts.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "For both equations, the null factor law says either $x-3=0$ or $x-5=0$.",
      "worked": "At an $x$-intercept, $y=0$. In both equations, the null factor law gives $x-3=0$ or $x-5=0$, since the constant factor $2$ cannot be zero. Thus both have $x$-intercepts $(3,0)$ and $(5,0)$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
