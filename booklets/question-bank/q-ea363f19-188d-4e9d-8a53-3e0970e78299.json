  "content": {
    "id": "p6-q4-content",
    "type": "question",
    "label": "4",
    "prompt": "Is there a curve where the instantaneous rate of change is always equal to the average rate of change, regardless of the interval chosen?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Yes. Any non-vertical straight line has a constant gradient, so every secant and tangent has that gradient.",
      "worked": "Yes. For a non-vertical straight line $y=mx+k$, the gradient is constant at $m$. The average rate over any interval is $m$, and the tangent gradient at every point is also $m$.",
      "solutionDiagrams": []
    },
