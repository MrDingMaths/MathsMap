            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "Horizontal translation left ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "\\ln(3)",
                "display": false
              },
              {
                "type": "text",
                "text": " units.",
                "marks": []
              }
            ]
          },
          {
            "id": "p27-q37-short-method",
