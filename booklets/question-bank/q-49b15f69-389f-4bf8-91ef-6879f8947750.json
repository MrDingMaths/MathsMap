  "content": {
    "id": "p27-q37-content",
    "type": "question",
    "label": "37",
    "prompt": "The graph of $y=e^x$ is vertically dilated by a factor of 3. What is the equivalent horizontal translation to give the same result?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q37-short-result",
            "type": "paragraph",
            "fontSize": null,
