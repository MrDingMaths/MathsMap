            "inlines": [
              {
                "type": "text",
                "text": "Write ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "3e^x=e^{x+\\ln(3)}",
                "display": false
              },
              {
                "type": "text",
                "text": " to identify the horizontal translation.",
                "marks": []
