  "content": {
    "id": "v2-p22-mixed-practice-slot-11-lower-root",
    "type": "question",
    "label": null,
    "prompt": "The kinetic energy $E$ joules of a mosquito is given by $E=\\frac{1}{2}mv^{2}$, where $m=2.5\\times10^{-6}$ kg is its mass and $v=4\\times10^{-1}$ m/s is its speed.\nCalculate $E$ in scientific notation.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2\\times10^{-7}\\text{ J}$",
      "worked": "$$\\begin{align*}E&=\\frac{1}{2}(2.5\\times10^{-6})(4\\times10^{-1})^{2}\\\\&=\\frac{1}{2}(2.5\\times10^{-6})(16\\times10^{-2})\\\\&=\\frac{1}{2}\\times40\\times10^{-8}\\\\&=20\\times10^{-8}\\\\&=2\\times10^{-7}\\text{ J}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
