  "content": {
    "id": "v2-8113f-p18-practice-slot-12-root",
    "type": "question",
    "label": null,
    "prompt": "\\$2500 is invested for 3 years compounded quarterly at 4.8% p.a. Calculate the future value to the nearest dollar.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$2885",
      "worked": "$$\\begin{align*}r&=\\frac{0.048}{4}=0.012\\\\n&=3\\times4=12\\\\FV&=PV(1+r)^n\\\\FV&=2500(1+0.012)^{12}\\\\FV&\\approx\\$2885\\end{align*}$$\nTo the nearest dollar.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
