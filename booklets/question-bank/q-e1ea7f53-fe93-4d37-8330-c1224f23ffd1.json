    "type": "question",
    "label": "7",
    "prompt": "Find the points where each parabola meets the line.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p23-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=2x^2-3x+4$ and $y=12-3x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(-2,18)$ and $(2,6)$",
          "worked": "At an intersection, the two expressions for $y$ are equal.\n$$\\begin{align*}2x^2-3x+4&=12-3x\\\\2x^2&=8\\\\x^2&=4\\\\x&=-2\\text{ or }2\\end{align*}$$\nWhen $x=-2$, $y=12-3(-2)=18$.\n\nWhen $x=2$, $y=12-3(2)=6$.\n\nThe points are $(-2,18)$ and $(2,6)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p23-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=2-x-3x^2$ and $y=-7x+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(0,2)$ and $(2,-12)$",
          "worked": "At an intersection, the two expressions for $y$ are equal.\n$$\\begin{align*}2-x-3x^2&=-7x+2\\\\3x^2-6x&=0\\\\3x(x-2)&=0\\\\x&=0\\text{ or }2\\end{align*}$$\nWhen $x=0$, $y=-7(0)+2=2$.\n\nWhen $x=2$, $y=-7(2)+2=-12$.\n\nThe points are $(0,2)$ and $(2,-12)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
