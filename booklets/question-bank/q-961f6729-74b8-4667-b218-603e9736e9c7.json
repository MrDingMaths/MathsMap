  "content": {
    "id": "p5-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Find the three terms $x+5,\\ 2x-6,\\ 4$, given that they form an arithmetic progression.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$12,\\ 8,\\ 4$.",
      "worked": "Consecutive differences are equal.\n$$\\begin{align*}(2x-6)-(x+5)&=4-(2x-6)\\\\x-11&=10-2x\\\\3x&=21\\\\x&=7\\end{align*}$$\nSubstituting $x=7$ gives $x+5=12$ and $2x-6=8$. The three terms are $12,\\ 8,\\ 4$, with common difference $-4$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 42
  },
