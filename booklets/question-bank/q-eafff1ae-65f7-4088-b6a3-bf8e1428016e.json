  "content": {
    "id": "p21-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "From a standard deck of 52 cards, two cards are drawn at random with replacement.\nFind the probability of drawing:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "A spade then a heart",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{16}$",
          "worked": "Replacement makes the draws independent.\n$$\\begin{align*}P(\\text{spade then heart})&=\\frac{13}{52}\\times\\frac{13}{52}\\\\P(\\text{spade then heart})&=\\frac{1}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Two clubs",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{16}$",
          "worked": "Replacement makes the draws independent.\n$$\\begin{align*}P(\\text{two clubs})&=\\frac{13}{52}\\times\\frac{13}{52}\\\\P(\\text{two clubs})&=\\frac{1}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "A jack then a queen",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{169}$",
          "worked": "There are four jacks and four queens. Replacement makes the draws independent.\n$$\\begin{align*}P(\\text{jack then queen})&=\\frac{4}{52}\\times\\frac{4}{52}\\\\P(\\text{jack then queen})&=\\frac{1}{169}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p21-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "The king of diamonds then the ace of clubs.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{2704}$",
          "worked": "Each specified card occurs once in the deck. Replacement makes the draws independent. Let $K_D$ denote the king of diamonds and $A_C$ the ace of clubs.\n$$\\begin{align*}P(K_D\\text{ then }A_C)&=\\frac{1}{52}\\times\\frac{1}{52}\\\\P(K_D\\text{ then }A_C)&=\\frac{1}{2704}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
