  "content": {
    "id": "p9-q13-root",
    "type": "question",
    "label": "13",
    "prompt": "Solve these trigonometric equations for $x\\in[0,2\\pi)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "$2\\sin^2x-\\sin x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{\\pi}{2},\\dfrac{7\\pi}{6},\\dfrac{11\\pi}{6}$",
          "worked": "$$\\begin{aligned}2\\sin^2x-\\sin x-1&=0\\\\(2\\sin x+1)(\\sin x-1)&=0\\\\\\sin x&=-\\frac12\\quad\\text{or}\\quad1\\\\x&=\\frac{\\pi}{2},\\frac{7\\pi}{6},\\frac{11\\pi}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "$2\\sin^2x+3\\sin x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{7\\pi}{6},\\dfrac{3\\pi}{2},\\dfrac{11\\pi}{6}$",
          "worked": "$$\\begin{aligned}2\\sin^2x+3\\sin x+1&=0\\\\(2\\sin x+1)(\\sin x+1)&=0\\\\\\sin x&=-\\frac12\\quad\\text{or}\\quad-1\\\\x&=\\frac{7\\pi}{6},\\frac{3\\pi}{2},\\frac{11\\pi}{6}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p9-q13-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin^2x+\\sin x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac{\\pi}{2}$",
          "worked": "$$\\begin{aligned}\\sin^2x+\\sin x-2&=0\\\\(\\sin x+2)(\\sin x-1)&=0\\\\\\sin x&=-2\\quad\\text{or}\\quad1\\end{aligned}$$\nSince $-1\\leq\\sin x\\leq1$, reject $\\sin x=-2$.\n$$x=\\frac{\\pi}{2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p9-q13-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos^2x-2\\cos x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\pi$",
          "worked": "$$\\begin{aligned}\\cos^2x-2\\cos x-3&=0\\\\(\\cos x-3)(\\cos x+1)&=0\\\\\\cos x&=3\\quad\\text{or}\\quad-1\\end{aligned}$$\nSince $-1\\leq\\cos x\\leq1$, reject $\\cos x=3$.\n$$x=\\pi$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
