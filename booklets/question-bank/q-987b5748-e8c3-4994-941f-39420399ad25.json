  "content": {
    "id": "p5-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Mrs Brown has ten students in her class and these students score an average of $60\\%$ on their class test. Mrs Taylor has fifteen students in her class and these students score an average of $80\\%$ on the same test. What is the average score when the classes are combined?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$72\\%$.\n\nWeight each class average by its number of students.",
      "worked": "$$\\begin{align*}\\text{Combined average} &= \\frac{10\\times60\\%+15\\times80\\%}{10+15}\\\\\\text{Combined average} &= \\frac{1800\\%}{25}\\\\\\text{Combined average} &= 72\\%.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
