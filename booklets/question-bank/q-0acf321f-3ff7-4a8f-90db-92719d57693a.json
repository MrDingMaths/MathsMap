  "content": {
    "id": "p12-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Simplify each of the following by base swapping:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\log_{16}2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac14$",
          "worked": "$$\\begin{align*}\\log_{16}2&=\\frac1{\\log_2 16}\\\\\\log_{16}2&=\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\log_9 3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}\\log_9 3&=\\frac1{\\log_3 9}\\\\\\log_9 3&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\log_{\\sqrt3}3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$$\\begin{align*}\\log_{\\sqrt3}3&=\\frac1{\\log_3\\sqrt3}\\\\\\log_{\\sqrt3}3&=\\frac1{1/2}\\\\\\log_{\\sqrt3}3&=2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p12-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\log_{1/4}2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$$\\begin{align*}\\log_{1/4}2&=\\frac1{\\log_2(1/4)}\\\\\\log_{1/4}2&=\\frac1{-2}\\\\\\log_{1/4}2&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\log_{1/100}10$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac12$",
          "worked": "$$\\begin{align*}\\log_{1/100}10&=\\frac1{\\log_{10}(1/100)}\\\\\\log_{1/100}10&=\\frac1{-2}\\\\\\log_{1/100}10&=-\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p12-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$(\\log_{1/9}3)(\\log_{1/3}3)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac12$",
          "worked": "$$\\begin{align*}(\\log_{1/9}3)(\\log_{1/3}3)&=\\frac1{\\log_3(1/9)}\\frac1{\\log_3(1/3)}\\\\(\\log_{1/9}3)(\\log_{1/3}3)&=\\frac1{-2}\\times\\frac1{-1}\\\\(\\log_{1/9}3)(\\log_{1/3}3)&=\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
