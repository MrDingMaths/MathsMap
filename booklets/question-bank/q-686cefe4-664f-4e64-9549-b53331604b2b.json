  "content": {
    "id": "p60-q13",
    "type": "question",
    "label": "13",
    "prompt": "A car dealer buys a car for \\$12,000 and sells it for \\$15,600.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p60-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the percentage profit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$30\\%$ profit.",
          "worked": "$$\\begin{align*}\\text{Profit} &= \\$15{,}600-\\$12{,}000\\\\&=\\$3600\\\\\\text{Percentage profit} &= \\frac{3600}{12{,}000}\\times100\\%\\\\&=30\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p60-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "What selling price would give a 40% profit?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$16{,}800$.",
          "worked": "A $40\\%$ profit gives a selling price of $140\\%$ of the cost price.\n$$\\begin{align*}\\text{Selling price} &= 12{,}000\\times1.4\\\\&=\\$16{,}800\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
