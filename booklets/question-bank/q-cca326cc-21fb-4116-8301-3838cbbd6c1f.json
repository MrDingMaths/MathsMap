    "id": "p9-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "A football club with $15\\,000$ members undertook a membership drive, and the membership increased by $110\\%$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "How many new members joined the club?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$16\\,500$ new members",
          "worked": "$$\\begin{align*}\\text{New members}&=15\\,000\\times110\\%\\\\\\text{New members}&=15\\,000\\times1.10\\\\\\text{New members}&=16\\,500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p9-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the size of the club’s membership now?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$31\\,500$ members",
          "worked": "$$\\begin{align*}\\text{Membership now}&=15\\,000+16\\,500\\\\\\text{Membership now}&=31\\,500\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
