  "content": {
    "id": "p58-q4",
    "type": "question",
    "label": "4",
    "prompt": "Write true or false for these statements.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p58-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$(5^2)^{12}=5^{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "$$\\begin{align*}(5^2)^{12}&=5^{2\\times12}\\\\&=5^{24}\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$(3^6)^2=3^8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "$$\\begin{align*}(3^6)^2&=3^{6\\times2}\\\\&=3^{12}\\end{align*}$$\nFalse: the result is $3^{12}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$1^0=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "True: $1$ is a nonzero base, so $1^0=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p58-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$(3^2)^{10}=9^{20}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "$$\\begin{align*}(3^2)^{10}&=9^{10}\\\\9^{20}&\\ne9^{10}\\end{align*}$$\nFalse: the left-hand side is $9^{10}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p58-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$3(4)^0=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "False",
          "worked": "$$\\begin{align*}3(4)^0&=3\\times1\\\\&=3\\end{align*}$$\nFalse: the coefficient $3$ is outside the power.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p58-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$0^3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "True",
          "worked": "$$\\begin{align*}0^3&=0\\times0\\times0\\\\&=0\\end{align*}$$\nTrue.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      }
    ]
  },
