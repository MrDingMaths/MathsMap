    "children": [
      {
        "id": "p39-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "A curve has gradient function $\\dfrac{e^{2x}}{1+e^{4x}}$ and passes through $\\left(0,\\dfrac{\\pi}{8}\\right)$.\n\nUse $u=e^{2x}$ to find its equation.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\dfrac12\\tan^{-1}(e^{2x})$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q9-a-answer-columns",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p39-q9-a-main-working",
                    "blocks": [
                      {
                        "id": "p39-q9-a-integrate",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}y&=\\int\\frac{e^{2x}}{1+e^{4x}}\\,dx\\\\&=\\frac12\\int\\frac{1}{1+u^2}\\,du\\\\&=\\frac12\\tan^{-1}u+C\\\\&=\\frac12\\tan^{-1}(e^{2x})+C\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-a-condition-text",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Substitute ",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "\\left(0,\\frac{\\pi}{8}\\right)",
                            "display": false
                          },
                          {
                            "type": "text",
                            "text": ":",
                            "marks": []
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-a-condition",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\frac{\\pi}{8}&=\\frac12\\tan^{-1}(1)+C\\\\&=\\frac12\\left(\\frac{\\pi}{4}\\right)+C\\\\C&=0\\\\\\therefore y&=\\frac12\\tan^{-1}(e^{2x})\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p39-q9-a-substitution-working",
                    "blocks": [
                      {
                        "id": "p39-q9-a-substitution",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}u&=e^{2x}\\\\u^2&=e^{4x}\\\\\\frac{du}{dx}&=2e^{2x}\\\\du&=2e^{2x}\\,dx\\\\dx&=\\frac{du}{2e^{2x}}\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 72
      },
      {
        "id": "p39-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "If $y''=\\dfrac{x}{(4-x^2)^{3/2}}$, and when $x=0$, $y'=1$ and $y=\\dfrac12$,\n\nuse $u=4-x^2$ to find $y'$ and then $y$ as a function of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'=\\dfrac{1}{\\sqrt{4-x^2}}+\\dfrac12$; $y=\\sin^{-1}\\left(\\dfrac{x}{2}\\right)+\\dfrac{x}{2}+\\dfrac12$.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p39-q9-b-answer-columns",
                "type": "layout",
                "arrangement": "parallel",
                "title": "",
                "border": false,
                "padding": 3,
                "margin": 3,
                "gap": 3,
                "columns": 2,
                "slots": [
                  {
                    "id": "p39-q9-b-main-working",
                    "blocks": [
                      {
                        "id": "p39-q9-b-first-integral",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}y'&=\\int\\frac{x}{(4-x^2)^{3/2}}\\,dx\\\\&=-\\frac12\\int u^{-3/2}\\,du\\\\&=-\\frac12(-2)u^{-1/2}+C_1\\\\&=\\frac{1}{\\sqrt{4-x^2}}+C_1\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-b-first-condition-text",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Substitute ",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "x=0,\\ y'=1",
                            "display": false
                          },
                          {
                            "type": "text",
                            "text": ":",
                            "marks": []
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-b-first-condition",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}1&=\\frac12+C_1\\\\C_1&=\\frac12\\\\\\therefore y'&=\\frac{1}{\\sqrt{4-x^2}}+\\frac12\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-b-second-integral",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}y&=\\int\\left(\\frac{1}{\\sqrt{4-x^2}}+\\frac12\\right)\\,dx\\\\&=\\sin^{-1}\\left(\\frac{x}{2}\\right)+\\frac{x}{2}+C_2\\end{aligned}",
                            "display": true
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-b-second-condition-text",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "text",
                            "text": "Substitute ",
                            "marks": []
                          },
                          {
                            "type": "math",
                            "latex": "x=0,\\ y=\\frac12",
                            "display": false
                          },
                          {
                            "type": "text",
                            "text": ":",
                            "marks": []
                          }
                        ]
                      },
                      {
                        "id": "p39-q9-b-second-condition",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
                        "lineHeight": 1.4,
                        "indent": 0,
                        "inlines": [
                          {
                            "type": "math",
                            "latex": "\\begin{aligned}\\frac12&=0+0+C_2\\\\C_2&=\\frac12\\\\\\therefore y&=\\sin^{-1}\\left(\\frac{x}{2}\\right)+\\frac{x}{2}+\\frac12\\end{aligned}",
                            "display": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "p39-q9-b-substitution-working",
                    "blocks": [
                      {
                        "id": "p39-q9-b-substitution",
                        "type": "paragraph",
                        "fontSize": null,
                        "align": "left",
                        "spaceBefore": 0,
                        "spaceAfter": 2,
