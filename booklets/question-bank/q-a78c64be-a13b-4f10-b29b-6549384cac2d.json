                            "type": "math",
                            "latex": "\\begin{aligned}u&=4-x^2\\\\\\frac{du}{dx}&=-2x\\\\du&=-2x\\,dx\\\\dx&=\\frac{du}{-2x}\\end{aligned}",
                            "display": true
