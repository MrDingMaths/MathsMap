  "content": {
    "id": "p61-q11-root",
    "type": "question",
    "label": null,
    "prompt": "$ABCD$ is a trapezium. $\\overrightarrow{AD}=3\\overrightarrow{BC}$.\n\nWrite the vectors in terms of $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p61-q11-figure",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 61 question 11\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (0,0);\\coordinate (B) at (1.3,2);\\coordinate (C) at (2.8,2);\\coordinate (D) at (4.5,0);\n\\draw (A)--(B)--(C)--(D)--cycle;\n\\draw[->] (B)--($(B)!0.58!(C)$);\\draw[->] (C)--($(C)!0.52!(D)$);\n\\node[below left] at (A) {$A$};\\node[above left] at (B) {$B$};\\node[above right] at (C) {$C$};\\node[below right] at (D) {$D$};\n\\path (B)--(C) node[midway,above] {$\\underset{\\sim}{a}+\\underset{\\sim}{b}$};\n\\path (C)--(D) node[midway,right] {$\\underset{\\sim}{a}-2\\underset{\\sim}{b}$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "spec": {
          "sourcePage": 61,
          "sourceRegion": "Question 11 diagram",
          "description": "Trapezium ABCD with horizontal parallel sides BC and AD, and directed BC and CD.",
          "mathematics": "AD=3BC; BC=a+b; CD=a-2b.",
          "answerVisibility": "Givens only."
        },
        "derived": false,
        "reviewStatus": "needs-review"
      }
    ],
    "children": [
      {
        "id": "p61-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\overrightarrow{AD}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3\\underset{\\sim}{a}+3\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AD}&=3\\overrightarrow{BC}\\\\\\overrightarrow{AD}&=3(\\underset{\\sim}{a}+\\underset{\\sim}{b})\\\\\\overrightarrow{AD}&=3\\underset{\\sim}{a}+3\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p61-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\overrightarrow{AC}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\underset{\\sim}{a}+5\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AC}&=\\overrightarrow{AD}-\\overrightarrow{CD}\\\\\\overrightarrow{AC}&=(3\\underset{\\sim}{a}+3\\underset{\\sim}{b})-(\\underset{\\sim}{a}-2\\underset{\\sim}{b})\\\\\\overrightarrow{AC}&=2\\underset{\\sim}{a}+5\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p61-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\overrightarrow{AB}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\underset{\\sim}{a}+4\\underset{\\sim}{b}$",
          "worked": "$$\\begin{aligned}\\overrightarrow{AB}&=\\overrightarrow{AC}-\\overrightarrow{BC}\\\\\\overrightarrow{AB}&=(2\\underset{\\sim}{a}+5\\underset{\\sim}{b})-(\\underset{\\sim}{a}+\\underset{\\sim}{b})\\\\\\overrightarrow{AB}&=\\underset{\\sim}{a}+4\\underset{\\sim}{b}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      }
    ],
    "diagramPlacement": "beside-prompt"
  },
