    "type": "question",
    "label": "10",
    "prompt": "A wall that is to be painted on one side has length 5 m and height 3.5 m. It requires two coats of paint. What is the total area to be painted?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$35\\,\\mathrm{m}^2$",
      "worked": "Area for one coat:\n$$\\begin{align*}A&=L\\times W\\\\A&=5\\times3.5\\\\A&=17.5\\,\\mathrm{m}^2\\end{align*}$$\nTotal area for two coats:\n$$\\begin{align*}A_{\\text{total}}&=2\\times17.5\\\\A_{\\text{total}}&=35\\,\\mathrm{m}^2\\end{align*}$$",
      "solutionDiagrams": []
    },
