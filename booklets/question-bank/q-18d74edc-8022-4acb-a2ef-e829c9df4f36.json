    "label": "2",
    "prompt": "Evaluate each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin75^{\\circ}+\\sin15^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{\\dfrac{3}{2}}$",
          "worked": "$$\\begin{align*}\\sin75^{\\circ}+\\sin15^{\\circ}&=2\\sin\\left(\\frac{75^{\\circ}+15^{\\circ}}{2}\\right)\\cos\\left(\\frac{75^{\\circ}-15^{\\circ}}{2}\\right)\\\\\\sin75^{\\circ}+\\sin15^{\\circ}&=2\\sin45^{\\circ}\\cos30^{\\circ}\\\\\\sin75^{\\circ}+\\sin15^{\\circ}&=2\\cdot\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}\\\\\\sin75^{\\circ}+\\sin15^{\\circ}&=\\sqrt{\\frac32}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p11-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos165^{\\circ}-\\cos105^{\\circ}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\dfrac{1}{\\sqrt2}$",
          "worked": "$$\\begin{align*}\\cos165^{\\circ}-\\cos105^{\\circ}&=-2\\sin\\left(\\frac{165^{\\circ}+105^{\\circ}}{2}\\right)\\sin\\left(\\frac{165^{\\circ}-105^{\\circ}}{2}\\right)\\\\\\cos165^{\\circ}-\\cos105^{\\circ}&=-2\\sin135^{\\circ}\\sin30^{\\circ}\\\\\\cos165^{\\circ}-\\cos105^{\\circ}&=-2\\cdot\\frac{\\sqrt2}{2}\\cdot\\frac12\\\\\\cos165^{\\circ}-\\cos105^{\\circ}&=-\\frac{1}{\\sqrt2}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      }
    ]
  },
