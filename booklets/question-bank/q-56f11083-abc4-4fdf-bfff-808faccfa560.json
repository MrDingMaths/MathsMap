  "content": {
    "id": "p20-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "If $x=2\\sqrt{3}$ and $y=\\frac{7}{\\sqrt{3}}$, find, in simplest form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p20-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}x+y&=2\\sqrt{3}+\\frac{7}{\\sqrt{3}}\\\\x+y&=2\\sqrt{3}+\\frac{7\\sqrt{3}}{3}\\\\x+y&=\\frac{6\\sqrt{3}+7\\sqrt{3}}{3}\\\\x+y&=\\frac{13\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x-y$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{\\sqrt{3}}{3}$",
          "worked": "$$\\begin{align*}x-y&=2\\sqrt{3}-\\frac{7}{\\sqrt{3}}\\\\x-y&=2\\sqrt{3}-\\frac{7\\sqrt{3}}{3}\\\\x-y&=\\frac{6\\sqrt{3}-7\\sqrt{3}}{3}\\\\x-y&=-\\frac{\\sqrt{3}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p20-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$xy$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$14$",
          "worked": "$$\\begin{align*}xy&=2\\sqrt{3}\\times\\frac{7}{\\sqrt{3}}\\\\xy&=\\frac{14\\sqrt{3}}{\\sqrt{3}}\\\\xy&=14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p20-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x}{y}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{6}{7}$",
          "worked": "$$\\begin{align*}\\frac{x}{y}&=2\\sqrt{3}\\div\\frac{7}{\\sqrt{3}}\\\\\\frac{x}{y}&=2\\sqrt{3}\\times\\frac{\\sqrt{3}}{7}\\\\\\frac{x}{y}&=\\frac{2\\times3}{7}\\\\\\frac{x}{y}&=\\frac{6}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p20-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^3+y^3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{559\\sqrt{3}}{9}$",
          "worked": "$$\\begin{align*}x^3+y^3&=(2\\sqrt{3})^3+\\left(\\frac{7}{\\sqrt{3}}\\right)^3\\\\x^3+y^3&=8\\times3\\sqrt{3}+\\frac{343}{3\\sqrt{3}}\\\\x^3+y^3&=24\\sqrt{3}+\\frac{343\\sqrt{3}}{9}\\\\x^3+y^3&=\\frac{216\\sqrt{3}+343\\sqrt{3}}{9}\\\\x^3+y^3&=\\frac{559\\sqrt{3}}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      }
    ]
