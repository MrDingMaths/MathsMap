    "label": "44",
    "prompt": "Find all the digits of $1003^4$ by expanding $(1000+3)^4$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1003^4=1\\,012\\,054\\,108\\,081$.",
      "worked": "Use row 4 of Pascal’s triangle: $1,4,6,4,1$.\n\n$$\\begin{align*}(1000+3)^4&=1000^4+4(1000^3)(3)+6(1000^2)(3^2)+4(1000)(3^3)+3^4\\\\(1000+3)^4&=1\\,000\\,000\\,000\\,000+12\\,000\\,000\\,000+54\\,000\\,000+108\\,000+81\\\\(1000+3)^4&=1\\,012\\,054\\,108\\,081\\end{align*}$$",
      "solutionDiagrams": []
    },
