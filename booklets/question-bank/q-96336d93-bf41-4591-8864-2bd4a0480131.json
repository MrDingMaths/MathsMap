    "children": [
      {
        "id": "p33-q5a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{2x^2+17x+21}{3x^2+26x+35}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2x+3}{3x+5}$",
          "worked": "$$\\begin{align*}2x^2+17x+21&=2x^2+14x+3x+21\\\\2x^2+17x+21&=2x(x+7)+3(x+7)\\\\2x^2+17x+21&=(2x+3)(x+7)\\end{align*}$$\n$$\\begin{align*}3x^2+26x+35&=3x^2+21x+5x+35\\\\3x^2+26x+35&=3x(x+7)+5(x+7)\\\\3x^2+26x+35&=(3x+5)(x+7)\\end{align*}$$\n$$\\begin{align*}\\frac{2x^2+17x+21}{3x^2+26x+35}&=\\frac{(2x+3)(x+7)}{(3x+5)(x+7)}\\\\\\frac{2x^2+17x+21}{3x^2+26x+35}&=\\frac{2x+3}{3x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p33-q5b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{3x^2+23x+14}{3x^2+41x+26}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+7}{x+13}$",
          "worked": "$$\\begin{align*}3x^2+23x+14&=3x^2+21x+2x+14\\\\3x^2+23x+14&=3x(x+7)+2(x+7)\\\\3x^2+23x+14&=(3x+2)(x+7)\\end{align*}$$\n$$\\begin{align*}3x^2+41x+26&=3x^2+39x+2x+26\\\\3x^2+41x+26&=3x(x+13)+2(x+13)\\\\3x^2+41x+26&=(3x+2)(x+13)\\end{align*}$$\n$$\\begin{align*}\\frac{3x^2+23x+14}{3x^2+41x+26}&=\\frac{(3x+2)(x+7)}{(3x+2)(x+13)}\\\\\\frac{3x^2+23x+14}{3x^2+41x+26}&=\\frac{x+7}{x+13}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p33-q5c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x^2-5x}{x^2-4x-5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{x+1}$",
          "worked": "$$\\begin{align*}\\frac{x^2-5x}{x^2-4x-5}&=\\frac{x(x-5)}{(x-5)(x+1)}\\\\\\frac{x^2-5x}{x^2-4x-5}&=\\frac{x}{x+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p33-q5d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a^2-121}{a^2-4}\\div\\dfrac{a+11}{a+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{a-11}{a-2}$",
          "worked": "$$\\begin{align*}\\frac{a^2-121}{a^2-4}\\div\\frac{a+11}{a+2}&=\\frac{a^2-121}{a^2-4}\\times\\frac{a+2}{a+11}\\\\\\frac{a^2-121}{a^2-4}\\div\\frac{a+11}{a+2}&=\\frac{(a-11)(a+11)}{(a-2)(a+2)}\\times\\frac{a+2}{a+11}\\\\\\frac{a^2-121}{a^2-4}\\div\\frac{a+11}{a+2}&=\\frac{a-11}{a-2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p33-q5e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{16x^2-9a^2}{x^2-4}\\times\\dfrac{x-2}{4x-3a}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{4x+3a}{x+2}$",
          "worked": "$$\\begin{align*}\\frac{16x^2-9a^2}{x^2-4}\\times\\frac{x-2}{4x-3a}&=\\frac{(4x-3a)(4x+3a)}{(x-2)(x+2)}\\times\\frac{x-2}{4x-3a}\\\\\\frac{16x^2-9a^2}{x^2-4}\\times\\frac{x-2}{4x-3a}&=\\frac{4x+3a}{x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p33-q5f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x^2-14x-15}{x^2-4x-45}\\div\\dfrac{x^2-12x-45}{x^2-6x-27}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x+5}$\n\nChange division to multiplication by the reciprocal, factorise, then cancel common factors.",
          "worked": "$$\\begin{align*}\\frac{x^2-14x-15}{x^2-4x-45}\\div\\frac{x^2-12x-45}{x^2-6x-27}&=\\frac{x^2-14x-15}{x^2-4x-45}\\times\\frac{x^2-6x-27}{x^2-12x-45}\\\\\\frac{x^2-14x-15}{x^2-4x-45}\\div\\frac{x^2-12x-45}{x^2-6x-27}&=\\frac{(x-15)(x+1)}{(x-9)(x+5)}\\times\\frac{(x-9)(x+3)}{(x-15)(x+3)}\\\\\\frac{x^2-14x-15}{x^2-4x-45}\\div\\frac{x^2-12x-45}{x^2-6x-27}&=\\frac{x+1}{x+5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
