  "content": {
    "id": "p16-q15",
    "type": "question",
    "label": "15",
    "prompt": "These factorisations are incomplete. Complete the factorisation.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p16-q15-a",
        "type": "part",
        "label": "a",
        "prompt": "$2(3x + 9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(x + 3)$",
          "worked": "$$\\begin{align*}2(3x + 9) &= 2\\times 3(x + 3)\\\\&= 6(x + 3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p16-q15-b",
        "type": "part",
        "label": "b",
        "prompt": "$7(4x + 12y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$28(x + 3y)$",
          "worked": "$$\\begin{align*}7(4x + 12y) &= 7\\times 4(x + 3y)\\\\&= 28(x + 3y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q15-c",
        "type": "part",
        "label": "c",
        "prompt": "$x(y + 2xy)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$xy(1 + 2x)$",
          "worked": "$$\\begin{align*}x(y + 2xy) &= x\\times y(1 + 2x)\\\\&= xy(1 + 2x)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q15-d",
        "type": "part",
        "label": "d",
        "prompt": "$2(6x + 9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6(2x + 3)$",
          "worked": "$$\\begin{align*}2(6x + 9) &= 2\\times 3(2x + 3)\\\\&= 6(2x + 3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q15-e",
        "type": "part",
        "label": "e",
        "prompt": "$3x(16zy + 12y)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12xy(4z + 3)$",
          "worked": "$$\\begin{align*}3x(16zy + 12y) &= 3x\\times 4y(4z + 3)\\\\&= 12xy(4z + 3)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p16-q15-f",
        "type": "part",
        "label": "f",
        "prompt": "$12x(x^2 + xy)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12x^2(x + y)$",
          "worked": "$$\\begin{align*}12x(x^2 + xy) &= 12x\\times x(x + y)\\\\&= 12x^2(x + y)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
