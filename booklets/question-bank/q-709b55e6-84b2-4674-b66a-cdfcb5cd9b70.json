  "content": {
    "id": "p20-q23-root",
    "type": "question",
    "label": "23",
    "prompt": "An alloy is made by combining $6.25$ kg of metal A, $3.75$ kg of metal B and $8.75$ kg of metal C. Find the ratio of metal A to metal B to metal C.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$5:3:7$",
      "worked": "All masses are in kilograms. Multiply each term by $100$, then divide by the highest common factor, $125$.\n\n$$\\begin{align*}\\text{A:B:C}&=6.25:3.75:8.75\\\\\\text{A:B:C}&=625:375:875\\\\\\text{A:B:C}&=5:3:7\\end{align*}$$",
      "solutionDiagrams": []
    },
