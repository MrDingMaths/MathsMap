  "content": {
    "id": "p15-q19-root",
    "type": "question",
    "label": "19",
    "prompt": "Let $g(x)=4x+1$.\n\nFind and simplify each pair.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "$g(2a)$ and $2g(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8a+1$; $8a+2$",
          "worked": "$$\\begin{align*}g(2a)&=4(2a)+1\\\\&=8a+1\\end{align*}$$\n$$\\begin{align*}2g(a)&=2(4a+1)\\\\&=8a+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "$g(3a)$ and $3g(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12a+1$; $12a+3$",
          "worked": "$$\\begin{align*}g(3a)&=4(3a)+1\\\\&=12a+1\\end{align*}$$\n$$\\begin{align*}3g(a)&=3(4a+1)\\\\&=12a+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "$g(a^2)$ and $(g(a))^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a^2+1$; $16a^2+8a+1$",
          "worked": "$$\\begin{align*}g(a^2)&=4(a^2)+1\\\\&=4a^2+1\\end{align*}$$\n$$\\begin{align*}(g(a))^2&=(4a+1)^2\\\\&=16a^2+2(4a)(1)+1\\\\&=16a^2+8a+1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p15-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "$g(a+1)$ and $g(a)+1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4a+5$; $4a+2$",
          "worked": "$$\\begin{align*}g(a+1)&=4(a+1)+1\\\\&=4a+5\\end{align*}$$\n$$\\begin{align*}g(a)+1&=(4a+1)+1\\\\&=4a+2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p15-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "$g(-a)$ and $-g(a)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-4a$; $-4a-1$",
          "worked": "$$\\begin{align*}g(-a)&=4(-a)+1\\\\&=1-4a\\end{align*}$$\n$$\\begin{align*}-g(a)&=-(4a+1)\\\\&=-4a-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
