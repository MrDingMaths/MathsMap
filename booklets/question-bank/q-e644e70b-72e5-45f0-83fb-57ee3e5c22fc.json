  "content": {
    "id": "p16-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the fraction halfway between $\\frac{7}{8}$ and $\\frac{8}{9}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{127}{144}$",
      "worked": "Using a common denominator,\n$$\\begin{align*}\\frac{7}{8}&=\\frac{63}{72}\\\\\\frac{8}{9}&=\\frac{64}{72}\\end{align*}$$\nThe numerators differ by $1$, so double both numerators and denominators:\n$$\\begin{align*}\\frac{7}{8}&=\\frac{126}{144}\\\\\\frac{8}{9}&=\\frac{128}{144}\\end{align*}$$\nSince $127$ is halfway between $126$ and $128$, the required fraction is $\\frac{127}{144}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 64
  },
