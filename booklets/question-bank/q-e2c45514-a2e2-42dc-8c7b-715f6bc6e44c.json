  "content": {
    "id": "p52-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "If the radius of a sector is $16\\text{ cm}$, is it possible to make a sector with perimeter $215\\text{ cm}$?\nJustify your answer.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "No. The required angle is $\\dfrac{183\\times360}{32\\pi}\\approx655.3^\\circ$, which exceeds $360^\\circ$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p52-q8-answer",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{align*}P &= \\frac{\\theta}{360}(2\\pi r)+2r\\\\215 &= \\frac{\\theta}{360}(2\\pi)(16)+2(16)\\\\215 &= \\frac{\\theta}{360}(32\\pi)+32\\\\183 &= \\frac{32\\pi\\theta}{360}\\\\\\theta &= \\frac{183\\times360}{32\\pi}\\\\\\theta &\\approx 655.3^\\circ\\end{align*}",
                "display": false
              }
            ]
          },
          {
            "id": "p52-q8-answer-reason",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
