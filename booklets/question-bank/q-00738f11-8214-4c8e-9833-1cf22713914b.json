  "content": {
    "id": "p7-q7-root",
    "type": "question",
    "label": "",
    "prompt": "Write an equation and solve it to find the number.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "The square of the number is 7 times the same number",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2=7x$; $x=0$ or $7$.",
          "worked": "Let the number be $x$.\n$$\\begin{align*}x^2&=7x\\\\x^2-7x&=0\\\\x(x-7)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $x-7=0$.\nHence $x=0$ or $7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "The difference between the square of a number and 64 is zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x^2-64=0$; $x=\\pm8$.",
          "worked": "Let the number be $x$.\n$$\\begin{align*}x^2-64&=0\\\\x^2&=64\\\\x&=\\pm8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p7-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "3 times the square of a number is equal to $-12$ times the number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3x^2=-12x$; $x=0$ or $-4$.",
          "worked": "Let the number be $x$.\n$$\\begin{align*}3x^2&=-12x\\\\3x^2+12x&=0\\\\3x(x+4)&=0\\end{align*}$$\nBy the null factor law, $x=0$ or $x+4=0$.\nHence $x=0$ or $-4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
  },
