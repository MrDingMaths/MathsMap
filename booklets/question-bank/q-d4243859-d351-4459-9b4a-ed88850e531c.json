    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x+1}{x+2}\\times\\dfrac{x+2}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x+3}$",
          "worked": "$$\\begin{aligned}\\frac{x+1}{x+2}\\times\\frac{x+2}{x+3}&=\\frac{(x+1)(x+2)}{(x+2)(x+3)}\\\\&=\\frac{x+1}{x+3}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{x+1}{x+2}\\times\\dfrac{x+2}{x+4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+1}{x+4}$",
          "worked": "$$\\begin{aligned}\\frac{x+1}{x+2}\\times\\frac{x+2}{x+4}&=\\frac{(x+1)(x+2)}{(x+2)(x+4)}\\\\&=\\frac{x+1}{x+4}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x+1}{x+2}\\times\\dfrac{x+3}{x+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x+3}{x+2}$",
          "worked": "$$\\begin{aligned}\\frac{x+1}{x+2}\\times\\frac{x+3}{x+1}&=\\frac{(x+1)(x+3)}{(x+2)(x+1)}\\\\&=\\frac{x+3}{x+2}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{x+2}{x+3}\\times\\dfrac{x+3}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{x+2}{x+3}\\times\\frac{x+3}{x+2}&=\\frac{(x+2)(x+3)}{(x+3)(x+2)}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{x-1}{x+2}\\times\\dfrac{x+2}{x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$$\\begin{aligned}\\frac{x-1}{x+2}\\times\\frac{x+2}{x-1}&=\\frac{(x-1)(x+2)}{(x+2)(x-1)}\\\\&=1\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{x+1}{x+2}\\times\\dfrac{x+4}{x+3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{(x+1)(x+4)}{(x+2)(x+3)}$",
          "worked": "$$\\begin{aligned}\\frac{x+1}{x+2}\\times\\frac{x+4}{x+3}&=\\frac{(x+1)(x+4)}{(x+2)(x+3)}\\end{aligned}$$\nThere are no common factors to cancel.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      }
    ]
  },
