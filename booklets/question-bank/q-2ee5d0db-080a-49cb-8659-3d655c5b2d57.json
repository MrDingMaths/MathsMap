    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-p7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $c^{\\log_c(a)\\times\\log_b(c)}=a^{\\log_b(c)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{\\log_b(c)}$\n\nRegroup the powers and use $c^{\\log_c(a)}=a$.",
          "worked": "$$\\begin{align*}c^{\\log_c(a)\\times\\log_b(c)}&=\\left(c^{\\log_c(a)}\\right)^{\\log_b(c)}\\\\c^{\\log_c(a)\\times\\log_b(c)}&=a^{\\log_b(c)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p7-p7-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence, or otherwise, show that $a^{\\log_b(c)}=c^{\\log_b(a)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a^{\\log_b(c)}=c^{\\log_b(a)}$\n\nUse part (a) and change base in $\\log_c(a)$ to simplify the exponent.",
          "worked": "For $c\\ne1$, use part (a) and change $\\log_c(a)$ to base $b$.\n$$\\begin{align*}a^{\\log_b(c)}&=c^{\\log_c(a)\\times\\log_b(c)}\\\\a^{\\log_b(c)}&=c^{\\frac{\\log_b(a)}{\\log_b(c)}\\times\\log_b(c)}\\\\a^{\\log_b(c)}&=c^{\\log_b(a)}.\\end{align*}$$\nIf $c=1$, both sides equal $1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
