        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"source page 29 p29-q15-diagram\"}\n\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (C) at (0,0);\n\\coordinate (B) at (0,3);\n\\coordinate (A) at ({-3*sin(80)},{3*cos(80)});\n\\draw[black,line width=0.8pt] (A)--(B)--(C)--cycle;\n\\draw[black,line width=0.5pt,->] ($(A)+(0,-1.6)$)--($(A)+(0,1.7)$) node[above] {$N$};\n\\draw[black,line width=0.5pt,->] (B)--($(B)+(0,1.6)$) node[above] {$N$};\n\\coordinate (MAC) at ($(A)!0.5!(C)$);\n\\coordinate (MBC) at ($(B)!0.5!(C)$);\n\\draw[black,line width=0.4pt] ($(MAC)+({-0.13*sin(10)},{-0.13*cos(10)})$)--($(MAC)+({0.13*sin(10)},{0.13*cos(10)})$);\n\\draw[black,line width=0.4pt] ($(MBC)+(-0.13,0)$)--($(MBC)+(0.13,0)$);\n\\pic[draw=black,line width=0.4pt,angle radius=7mm] {angle=B--C--A};\n\\path (C)--++(130:1.03) node {$80^{\\circ}$};\n\\node[left] at (A) {$A$};\n\\node[right] at (B) {$B$};\n\\node[below right] at (C) {$C$};\n\\end{tikzpicture}",
        "src": null,
        "widthMm": 45,
