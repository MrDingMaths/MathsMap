    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3.8\\text{ cm}$",
      "worked": "Original length = image length ÷ scale factor.\n$$\\begin{align*}\\text{Smaller length}&=15.2\\div4\\\\&=3.8\\text{ cm}\\end{align*}$$",
