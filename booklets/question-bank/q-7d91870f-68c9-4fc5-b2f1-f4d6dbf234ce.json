  "content": {
    "id": "p34-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Find the digits $a$ and $b$ if $(ab)_7=(ba)_9$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$a=4$, $b=3$.",
      "worked": "The two-digit numerals have values $7a+b$ and $9b+a$.\n$$\\begin{align*}7a+b&=9b+a\\\\6a&=8b\\\\3a&=4b\\end{align*}$$\nHence $a=4k$ and $b=3k$ for a positive integer $k$. Both digits occur in base 7, so $1\\le a,b\\le6$. Therefore $k=1$, giving $a=4$ and $b=3$.\nCheck: $43_7=4\\times7+3=31$ and $34_9=3\\times9+4=31$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
