        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5}{3}$",
          "worked": "$$\\begin{align*}x&=2-\\frac{1}{3}\\\\x&=\\frac{5}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x-3=\\frac{1}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{11}{7}$",
          "worked": "$$\\begin{align*}2x&=\\frac{1}{7}+3\\\\2x&=\\frac{22}{7}\\\\x&=\\frac{11}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x-\\frac{1}{4}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{13}{12}$",
          "worked": "$$\\begin{align*}3x&=3+\\frac{1}{4}\\\\3x&=\\frac{13}{4}\\\\x&=\\frac{13}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-d",
        "type": "part",
        "label": "d",
        "prompt": "$x+\\frac{1}{4}=\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{5}{12}$",
          "worked": "$$\\begin{align*}x&=\\frac{2}{3}-\\frac{1}{4}\\\\x&=\\frac{8-3}{12}\\\\x&=\\frac{5}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-e",
        "type": "part",
        "label": "e",
        "prompt": "$2x-\\frac{1}{4}=\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{8}$",
          "worked": "$$\\begin{align*}2x&=\\frac{1}{2}+\\frac{1}{4}\\\\2x&=\\frac{3}{4}\\\\x&=\\frac{3}{8}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x}{2}+\\frac{1}{4}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{7}{2}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}&=2-\\frac{1}{4}\\\\\\frac{x}{2}&=\\frac{7}{4}\\\\x&=\\frac{7}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x}{3}-\\frac{5}{6}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{11}{2}$",
          "worked": "$$\\begin{align*}\\frac{x}{3}&=1+\\frac{5}{6}\\\\\\frac{x}{3}&=\\frac{11}{6}\\\\x&=\\frac{11}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x}{2}-\\frac{x}{4}=\\frac{1}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{4}{3}$",
          "worked": "$$\\begin{align*}\\frac{2x-x}{4}&=\\frac{1}{3}\\\\\\frac{x}{4}&=\\frac{1}{3}\\\\x&=\\frac{4}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-i",
        "type": "part",
        "label": "i",
        "prompt": "$x+\\frac{x}{2}+\\frac{x}{3}=\\frac{1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{22}$",
          "worked": "Multiply both sides by $12$.\n\n$$\\begin{align*}12x+6x+4x&=3\\\\22x&=3\\\\x&=\\frac{3}{22}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q11-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{x}{2}+\\frac{1}{4}=\\frac{3}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{4}$",
          "worked": "$$\\begin{align*}\\frac{x}{2}&=\\frac{3}{8}-\\frac{1}{4}\\\\\\frac{x}{2}&=\\frac{1}{8}\\\\x&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{2x}{3}-\\frac{1}{6}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{19}{4}$",
          "worked": "Multiply both sides by $6$.\n\n$$\\begin{align*}4x-1&=18\\\\4x&=19\\\\x&=\\frac{19}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q11-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{3x}{4}+\\frac{5}{6}=\\frac{1}{12}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "Multiply both sides by $12$.\n\n$$\\begin{align*}9x+10&=1\\\\9x&=-9\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q11-m",
        "type": "part",
        "label": "m",
        "prompt": "$x+3+\\frac{1}{2}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{3}{2}$",
          "worked": "$$\\begin{align*}x&=2-3-\\frac{1}{2}\\\\x&=-\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p7-q11-n",
        "type": "part",
        "label": "n",
        "prompt": "$3x-2-\\frac{3}{4}=\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{13}{12}$",
          "worked": "$$\\begin{align*}3x&=\\frac{1}{2}+2+\\frac{3}{4}\\\\3x&=\\frac{13}{4}\\\\x&=\\frac{13}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p7-q11-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{x+1}{2}-\\frac{1}{4}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{2}$",
          "worked": "Multiply both sides by $4$.\n\n$$\\begin{align*}2(x+1)-1&=4\\\\2x+1&=4\\\\2x&=3\\\\x&=\\frac{3}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q11-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\frac{x-2}{2}+x=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{8}{3}$",
          "worked": "Multiply both sides by $2$.\n\n$$\\begin{align*}x-2+2x&=6\\\\3x&=8\\\\x&=\\frac{8}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q11-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\frac{x-1}{2}-\\frac{x}{4}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=10$",
          "worked": "Multiply both sides by $4$.\n\n$$\\begin{align*}2(x-1)-x&=8\\\\x-2&=8\\\\x&=10\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q11-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\frac{x+2}{3}+\\frac{x-2}{6}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{16}{3}$\n\nClear the fractions by multiplying both sides by $6$.",
          "worked": "Multiply both sides by $6$.\n\n$$\\begin{align*}2(x+2)+(x-2)&=18\\\\2x+4+x-2&=18\\\\3x+2&=18\\\\3x&=16\\\\x&=\\frac{16}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q11-s",
        "type": "part",
        "label": "s",
        "prompt": "$\\frac{x+3}{2}-\\frac{x-3}{3}=\\frac{1}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-14$\n\nMultiply both sides by $6$, then expand the brackets.",
          "worked": "Multiply both sides by $6$.\n\n$$\\begin{align*}3(x+3)-2(x-3)&=1\\\\3x+9-2x+6&=1\\\\x+15&=1\\\\x&=-14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q11-t",
        "type": "part",
        "label": "t",
        "prompt": "$\\frac{2(x+3)}{3}-\\frac{3x}{2}=3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{6}{5}$\n\nMultiply both sides by $6$, then collect the $x$ terms.",
          "worked": "Multiply both sides by $6$.\n\n$$\\begin{align*}4(x+3)-9x&=18\\\\4x+12-9x&=18\\\\12&=18+5x\\\\5x&=-6\\\\x&=-\\frac{6}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      }
    ]
