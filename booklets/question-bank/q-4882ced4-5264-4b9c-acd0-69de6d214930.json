        "answer": {
          "short": "$\\frac{x^2-1}{x^2+1}$",
          "worked": "$$\\begin{align*}\\frac{x-\\frac{1}{x}}{x+\\frac{1}{x}}&=\\frac{x-\\frac{1}{x}}{x+\\frac{1}{x}}\\times\\frac{x}{x}\\\\&=\\frac{x\\left(x-\\frac{1}{x}\\right)}{x\\left(x+\\frac{1}{x}\\right)}\\\\&=\\frac{x^2-1}{x^2+1}\\end{align*}$$",
          "solutionDiagrams": []
        },
