        "label": "a",
        "prompt": "$3\\text{ cm}$, $6\\text{ cm}$ and $7\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt5\\text{ cm}^2$",
          "worked": "$$\\begin{align*}s&=\\frac{3+6+7}{2}=8\\\\A&=\\sqrt{8(8-3)(8-6)(8-7)}\\\\A&=\\sqrt{80}\\\\A&=4\\sqrt5\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
