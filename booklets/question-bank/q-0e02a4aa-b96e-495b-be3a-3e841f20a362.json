        "id": "p14-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$4\\text{ cm}$, $4\\text{ cm}$ and $4\\text{ cm}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4\\sqrt3\\text{ cm}^2$",
          "worked": "$$\\begin{align*}s&=\\frac{4+4+4}{2}=6\\\\A&=\\sqrt{6(6-4)(6-4)(6-4)}\\\\A&=\\sqrt{48}\\\\A&=4\\sqrt3\\text{ cm}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
