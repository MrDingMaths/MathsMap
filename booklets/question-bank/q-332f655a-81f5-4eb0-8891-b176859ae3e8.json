    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q5a",
        "type": "part",
        "label": "a",
        "prompt": "Find the 10th term of the geometric sequence $6,12,24,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3072$",
          "worked": "$$\\begin{align*}r&=\\frac{12}{6}=2\\\\a_{10}&=ar^9\\\\a_{10}&=6\\times2^9\\\\a_{10}&=3072\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q5b",
        "type": "part",
        "label": "b",
        "prompt": "Find the 8th term of the geometric sequence $3,3\\sqrt{3},9,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81\\sqrt{3}$",
          "worked": "$$\\begin{align*}r&=\\frac{3\\sqrt{3}}{3}=\\sqrt{3}\\\\a_8&=ar^7\\\\a_8&=3(\\sqrt{3})^7\\\\a_8&=81\\sqrt{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p12-q5c",
        "type": "part",
        "label": "c",
        "prompt": "Find the 6th term of the geometric sequence $6,3,\\frac{3}{2},\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{16}$",
          "worked": "$$\\begin{align*}r&=\\frac{3}{6}=\\frac12\\\\a_6&=ar^5\\\\a_6&=6\\left(\\frac12\\right)^5\\\\a_6&=\\frac{3}{16}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p12-q5d",
        "type": "part",
        "label": "d",
        "prompt": "Find the 5th term of the geometric sequence $1,-3,9,\\ldots$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$81$",
          "worked": "$$\\begin{align*}r&=\\frac{-3}{1}=-3\\\\a_5&=ar^4\\\\a_5&=1\\times(-3)^4\\\\a_5&=81\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
