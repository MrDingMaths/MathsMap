      {
        "id": "p17-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Expand $(1-3x)^4$ as far as the term in $x^3$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1-12x+54x^2-108x^3+\\cdots$",
          "worked": "$$\\begin{aligned}(1-3x)^4&=1+\\binom41(-3x)+\\binom42(-3x)^2+\\binom43(-3x)^3+\\cdots\\\\&=1-12x+54x^2-108x^3+\\cdots.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p17-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the coefficient of $x^3$ in the expansion of $(2+x)^2(1-3x)^4$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-228$",
          "worked": "$$(2+x)^2=4+4x+x^2.$$\n$$(2+x)^2(1-3x)^4=(4+4x+x^2)(1-12x+54x^2-108x^3+\\cdots).$$\nCoefficient of $x^3$:\n$$\\begin{aligned}4(-108)+4(54)+1(-12)&=-432+216-12\\\\&=-228.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
