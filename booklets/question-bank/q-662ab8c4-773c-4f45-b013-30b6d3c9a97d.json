        "prompt": "$2x+3y+1=0$, translated right by 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+3y-3=0$",
          "worked": "Replace $x$ with $x-2$.\n\n$$\\begin{align*}2(x-2)+3y+1&=0\\\\2x+3y-3&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2+y^2=4$, translated left by 4 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x+4)^2+y^2=4$",
          "worked": "Replace $x$ with $x+4$.\n\n$$(x+4)^2+y^2=4$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p7-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$xy=1$, translated right by 3 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{x-3}$",
          "worked": "Replace $x$ with $x-3$.\n\n$$\\begin{align*}(x-3)y&=1\\\\y&=\\frac{1}{x-3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$x^2+xy=1$, translated left by 1 unit.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{x+1}-(x+1)$",
          "worked": "Replace both occurrences of $x$ with $x+1$.\n\n$$\\begin{align*}(x+1)^2+(x+1)y&=1\\\\(x+1)y&=1-(x+1)^2\\\\y&=\\frac{1-(x+1)^2}{x+1}\\\\y&=\\frac{1}{x+1}-(x+1)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      }
