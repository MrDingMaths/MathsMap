    "id": "p27-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "A cuboid has dimensions $x\\text{ cm}\\times x\\text{ cm}\\times5\\text{ cm}$. Find $x$ if the surface area of the cuboid is $78\\text{ cm}^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
