  "content": {
    "id": "p11-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Use a sum-to-product formula to find an alternative expression for each of the following:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p11-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sin5\\theta+\\sin\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\sin3\\theta\\cos2\\theta$",
          "worked": "$$\\begin{align*}\\sin5\\theta+\\sin\\theta&=2\\sin\\left(\\frac{5\\theta+\\theta}{2}\\right)\\cos\\left(\\frac{5\\theta-\\theta}{2}\\right)\\\\\\sin5\\theta+\\sin\\theta&=2\\sin3\\theta\\cos2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\cos3\\theta-\\cos\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\sin2\\theta\\sin\\theta$",
          "worked": "$$\\begin{align*}\\cos3\\theta-\\cos\\theta&=-2\\sin\\left(\\frac{3\\theta+\\theta}{2}\\right)\\sin\\left(\\frac{3\\theta-\\theta}{2}\\right)\\\\\\cos3\\theta-\\cos\\theta&=-2\\sin2\\theta\\sin\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sin4\\theta-\\sin2\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cos3\\theta\\sin\\theta$",
          "worked": "$$\\begin{align*}\\sin4\\theta-\\sin2\\theta&=2\\cos\\left(\\frac{4\\theta+2\\theta}{2}\\right)\\sin\\left(\\frac{4\\theta-2\\theta}{2}\\right)\\\\\\sin4\\theta-\\sin2\\theta&=2\\cos3\\theta\\sin\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p11-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\cos2\\theta+\\cos6\\theta$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2\\cos4\\theta\\cos2\\theta$",
          "worked": "$$\\begin{align*}\\cos2\\theta+\\cos6\\theta&=2\\cos\\left(\\frac{2\\theta+6\\theta}{2}\\right)\\cos\\left(\\frac{2\\theta-6\\theta}{2}\\right)\\\\\\cos2\\theta+\\cos6\\theta&=2\\cos4\\theta\\cos(-2\\theta)\\\\\\cos2\\theta+\\cos6\\theta&=2\\cos4\\theta\\cos2\\theta.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
