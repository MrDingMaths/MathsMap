  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "A scale diagram of a park uses a scale of $1\\text{ cm}=10\\text{ m}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4a-node",
        "type": "part",
        "label": "a",
        "prompt": "Write this as a ratio; remember that ratios always have the same units for both quantities.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1:1000$",
          "worked": "$10\\text{ m}=1000\\text{ cm}$, so the ratio of diagram length to real length is $1:1000$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p6-q4b-node",
        "type": "part",
        "label": "b",
        "prompt": "A park is $15\\text{ cm}$ across on the diagram. Work out the equivalent distance in real life in m.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$150\\text{ m}$",
          "worked": "Length ratio, diagram : real life: $1:1000$.\n\n$$\\begin{aligned}\\text{Real distance}&=15\\times1000\\text{ cm}\\\\&=15000\\text{ cm}\\\\&=150\\text{ m}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p6-q4c-node",
        "type": "part",
        "label": "c",
        "prompt": "A playground in the park has an area of $4.3\\text{ cm}^2$ on the diagram.\n\nWork out the area the playground takes up in real life in m².",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$430\\text{ m}^2$",
          "worked": "Length ratio, diagram : real life: $1:1000$.\n\nArea ratio: $1:1000^2=1:1000000$.\n\n$$\\begin{aligned}\\text{Real area}&=4.3\\times1000^2\\text{ cm}^2\\\\&=4300000\\text{ cm}^2\\\\&=\\frac{4300000}{10000}\\text{ m}^2\\\\&=430\\text{ m}^2\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
