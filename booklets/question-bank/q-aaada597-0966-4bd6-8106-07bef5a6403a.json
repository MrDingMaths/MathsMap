  "content": {
    "id": "p19-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Find the value of $x$ if $\\sqrt{18}+\\sqrt{8}=\\sqrt{x}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=50$.",
      "worked": "$$\\begin{align*}\\sqrt{18}+\\sqrt{8}&=3\\sqrt{2}+2\\sqrt{2}\\\\\\sqrt{18}+\\sqrt{8}&=5\\sqrt{2}.\\end{align*}$$\nTherefore $\\sqrt{x}=5\\sqrt{2}$. Squaring both sides,\n$$\\begin{align*}x&=(5\\sqrt{2})^2\\\\x&=25\\times2\\\\x&=50.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
