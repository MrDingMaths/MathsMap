  "content": {
    "id": "p20-q16-root",
    "type": "question",
    "label": "16",
    "prompt": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p20-q16-stem",
          "type": "paragraph",
          "fontSize": null,
