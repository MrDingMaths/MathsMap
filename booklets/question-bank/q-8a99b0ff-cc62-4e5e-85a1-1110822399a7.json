  "content": {
    "id": "v2-fafc9-p54-practice-slot-10-lower-root",
    "type": "question",
    "label": null,
    "prompt": "Simplify $$\\frac{1}{1+\\sqrt{2}}+\\frac{1}{\\sqrt{2}+\\sqrt{3}}+\\frac{1}{\\sqrt{3}+2}$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1$",
      "worked": "$$\\begin{align*}\\frac{1}{1+\\sqrt{2}}&=\\frac{\\sqrt{2}-1}{2-1}=\\sqrt{2}-1\\\\\\frac{1}{\\sqrt{2}+\\sqrt{3}}&=\\frac{\\sqrt{3}-\\sqrt{2}}{3-2}=\\sqrt{3}-\\sqrt{2}\\\\\\frac{1}{\\sqrt{3}+2}&=\\frac{2-\\sqrt{3}}{4-3}=2-\\sqrt{3}\\\\\\text{Sum}&=(\\sqrt{2}-1)+(\\sqrt{3}-\\sqrt{2})+(2-\\sqrt{3})\\\\&=1\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
