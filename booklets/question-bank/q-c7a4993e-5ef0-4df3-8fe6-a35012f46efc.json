            "format": "tikz",
            "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"geometry\",\"base\":[],\"semantic\":[],\"reference\":\"page 34 q4a\"}\n\\begin{tikzpicture}[line width=0.8pt,every node/.style={font=\\fontsize{10}{12}\\selectfont,text=black}]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\coordinate (A) at (120:1.2);\\coordinate (B) at (-55:1.2);\\coordinate (C) at (185:1.2);\\coordinate (D) at (35:1.2);\\coordinate (I) at (-0.19,0.24);\n\\draw (0,0) circle (1.2);\\draw (A)--(B);\\draw (C)--(D);\n\\path (A)--(I) node[midway,left] {$x$};\\path (I)--(B) node[midway,right] {$x+5$};\\path (C)--(I) node[midway,below] {$8$};\\path (I)--(D) node[midway,below right] {$7$};\n\\end{tikzpicture}",
