    "children": [
      {
        "id": "p75-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $x$. (hint: the sum of all probabilities is 1)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=0.1$",
          "worked": "$$\\begin{align*}\n0.3+0.3+x+3x &= 1 \\\\\n4x+0.6 &= 1 \\\\\n4x &= 0.4 \\\\\nx &= 0.1\n\\end{align*}$$\nCheck: $0.3+0.3+0.1+0.3=1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p75-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the probability that the spinner lands on an even number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.6$",
          "worked": "The even outcomes are 2 and 4. From part a, $3x=3(0.1)=0.3$.\n$$\\begin{align*}\nP(\\text{even}) &= P(2)+P(4) \\\\\n&= 0.3+0.3 \\\\\n&= 0.6\n\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
