  "content": {
    "id": "p8-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "The side length of a square is $x$ cm. If the side length is decreased by 5 cm, then the area decreases by $35\\text{ cm}^2$. Find the value of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=6$",
      "worked": "The original area is $x^2$ and the new area is $(x-5)^2$, in square centimetres.\n\n$$\\begin{align*}x^2-(x-5)^2&=35\\\\x^2-(x^2-10x+25)&=35\\\\10x-25&=35\\\\10x&=60\\\\x&=6\\end{align*}$$\n\nThe original side length is $6\\text{ cm}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
