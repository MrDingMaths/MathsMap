  "content": {
    "id": "p6-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "A car uses 24 L of petrol to travel 216 km. Express these quantities as a simplified rate in:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Kilometres per litre",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9\\text{ km/L}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{216\\text{ km}}{24\\text{ L}}\\\\&=\\frac{216\\div24\\text{ km}}{24\\div24\\text{ L}}\\\\&=9\\text{ km/L}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p6-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Litres per kilometre",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}\\text{ L/km}$",
          "worked": "$$\\begin{aligned}\\text{Rate}&=\\frac{24\\text{ L}}{216\\text{ km}}\\\\&=\\frac{24\\div216\\text{ L}}{216\\div216\\text{ km}}\\\\&=\\frac{1}{9}\\text{ L/km}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "How can you convert from km/L to L/km?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Flip the fraction (take the reciprocal).",
          "worked": "Take the reciprocal: reversing the quantities changes km/L to L/km. For example, $9\\text{ km/L}$ becomes $\\frac{1}{9}\\text{ L/km}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
