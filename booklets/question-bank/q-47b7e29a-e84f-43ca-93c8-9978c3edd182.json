  "content": {
    "id": "p24-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "The line $3x-8y+10=0$ and another line intersect at right angles at the point $(10,5)$. Find the equation of the other line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$8x+3y=95$",
      "worked": "$$\\begin{align*}8y&=3x+10\\\\y&=\\frac{3}{8}x+\\frac{5}{4}\\end{align*}$$\nThe perpendicular gradient is $-\\dfrac{8}{3}$.\n$$\\begin{align*}y-5&=-\\frac{8}{3}(x-10)\\\\3(y-5)&=-8(x-10)\\\\3y-15&=-8x+80\\\\8x+3y&=95\\\\y&=\\frac{-8x+95}{3}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 72
  },
