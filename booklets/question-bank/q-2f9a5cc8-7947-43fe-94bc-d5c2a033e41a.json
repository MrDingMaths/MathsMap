    "children": [
      {
        "id": "p16-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that a triangle whose sides have lengths $\\sqrt{2}$, $\\sqrt{3}$ and $\\sqrt{5}$ has a right angle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $(\\sqrt{2})^2+(\\sqrt{3})^2=5=(\\sqrt{5})^2$.",
          "worked": "$$\\begin{align*}(\\sqrt{2})^2+(\\sqrt{3})^2&=2+3\\\\(\\sqrt{2})^2+(\\sqrt{3})^2&=5\\\\(\\sqrt{2})^2+(\\sqrt{3})^2&=(\\sqrt{5})^2\\end{align*}$$\nBy the converse of the Pythagorean theorem, the triangle has a right angle opposite the side of length $\\sqrt{5}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p16-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Let $a,b>0$. Show that a triangle with sides $\\sqrt{a}$, $\\sqrt{b}$ and $\\sqrt{a+b}$ has a right angle.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes: $(\\sqrt{a})^2+(\\sqrt{b})^2=a+b=(\\sqrt{a+b})^2$.",
          "worked": "$$\\begin{align*}(\\sqrt{a})^2+(\\sqrt{b})^2&=a+b\\\\(\\sqrt{a})^2+(\\sqrt{b})^2&=(\\sqrt{a+b})^2\\end{align*}$$\nBy the converse of the Pythagorean theorem, the triangle has a right angle opposite the side of length $\\sqrt{a+b}$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
