  },
  "content": {
    "id": "p6-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Solve each of the following equations by first putting the quadratic equation in standard form:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$x+3+\\frac2x=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2,\\ -1$",
          "worked": "$$\\begin{align*}x^2+3x+2&=0\\\\(x+1)(x+2)&=0\\\\x&=-2,\\ -1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p6-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac3x+1=4x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1,\\ -\\frac34$",
          "worked": "$$\\begin{align*}3+x&=4x^2\\\\4x^2-x-3&=0\\\\(4x+3)(x-1)&=0\\\\x&=1,\\ -\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x-\\frac4x=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1-\\sqrt{13}}{3},\\ \\frac{1+\\sqrt{13}}{3}$",
          "worked": "$$\\begin{align*}3x^2-4&=2x\\\\3x^2-2x-4&=0\\end{align*}$$\nThis quadratic does not factorise over the rationals. Using the quadratic formula:\n$$\\begin{align*}x&=\\frac{2\\pm\\sqrt{(-2)^2-4(3)(-4)}}{2(3)}\\\\x&=\\frac{2\\pm\\sqrt{52}}{6}\\\\x&=\\frac{1\\pm\\sqrt{13}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p6-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x+15}{2}=x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac52,\\ 3$",
          "worked": "$$\\begin{align*}x+15&=2x^2\\\\2x^2-x-15&=0\\\\(2x+5)(x-3)&=0\\\\x&=-\\frac52,\\ 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p6-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$x^2=\\frac{x+2}{2}+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac32,\\ 2$",
          "worked": "$$\\begin{align*}2x^2&=x+2+4\\\\2x^2&=x+6\\\\2x^2-x-6&=0\\\\(2x+3)(x-2)&=0\\\\x&=-\\frac32,\\ 2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p6-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$x=\\frac6{5-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2,\\ 3$",
          "worked": "$$\\begin{align*}x(5-x)&=6\\\\5x-x^2&=6\\\\x^2-5x+6&=0\\\\(x-2)(x-3)&=0\\\\x&=2,\\ 3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
