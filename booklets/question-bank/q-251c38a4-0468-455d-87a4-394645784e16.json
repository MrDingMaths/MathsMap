  "content": {
    "id": "p27-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "A plan of a rectangular block of land is drawn to a scale of $1:1000$. The side lengths of the block on the plan are $8\\text{ cm}$ and $15\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p27-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate the side lengths of the actual block.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$80\\text{ m}$ and $150\\text{ m}$",
          "worked": "$$\\begin{align*}\\text{Actual first side}&=8\\times1000\\text{ cm}\\\\\\text{Actual first side}&=8000\\text{ cm}=80\\text{ m}\\\\\\text{Actual second side}&=15\\times1000\\text{ cm}\\\\\\text{Actual second side}&=15000\\text{ cm}=150\\text{ m}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p27-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate the area of the actual block.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12000\\text{ m}^2$",
          "worked": "$$\\begin{align*}\\text{Actual area}&=80\\times150\\text{ m}^2\\\\\\text{Actual area}&=12000\\text{ m}^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
