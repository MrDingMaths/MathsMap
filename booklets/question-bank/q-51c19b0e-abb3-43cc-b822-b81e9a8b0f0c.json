    "children": [
      {
        "id": "p25-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Give an example of an even function and an odd function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Sample answers: even, $f(x)=x^2$; odd, $g(x)=x^3$.",
          "worked": "$$\\begin{align*}f(-x)&=(-x)^2\\\\f(-x)&=x^2\\\\f(-x)&=f(x)\\end{align*}$$\nThus $f(x)=x^2$ is even.\n$$\\begin{align*}g(-x)&=(-x)^3\\\\g(-x)&=-x^3\\\\g(-x)&=-g(x)\\end{align*}$$\nThus $g(x)=x^3$ is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p25-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Prove that the sum of two even functions is an even function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For even $f$ and $g$, $(f+g)(-x)=f(x)+g(x)=(f+g)(x)$, so their sum is even.",
          "worked": "Let $f$ and $g$ be even, and let $h(x)=f(x)+g(x)$. For every real $x$,\n$$\\begin{align*}h(-x)&=f(-x)+g(-x)\\\\h(-x)&=f(x)+g(x)\\\\h(-x)&=h(x).\\end{align*}$$\nTherefore the sum is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p25-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Prove that the product of two even functions is an even function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For even $f$ and $g$, $(fg)(-x)=f(x)g(x)=(fg)(x)$, so their product is even.",
          "worked": "Let $f$ and $g$ be even, and let $h(x)=f(x)g(x)$. For every real $x$,\n$$\\begin{align*}h(-x)&=f(-x)g(-x)\\\\h(-x)&=f(x)g(x)\\\\h(-x)&=h(x).\\end{align*}$$\nTherefore the product is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p25-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Prove that the product of two odd functions is an even function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For odd $f$ and $g$, $(fg)(-x)=[-f(x)][-g(x)]=(fg)(x)$, so their product is even.",
          "worked": "Let $f$ and $g$ be odd, and let $h(x)=f(x)g(x)$. For every real $x$,\n$$\\begin{align*}h(-x)&=f(-x)g(-x)\\\\h(-x)&=[-f(x)][-g(x)]\\\\h(-x)&=f(x)g(x)\\\\h(-x)&=h(x).\\end{align*}$$\nTherefore the product is even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p25-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Prove that the composition of two odd functions is an odd function.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "For odd $f$ and $g$, $f(g(-x))=f(-g(x))=-f(g(x))$, so their composition is odd.",
          "worked": "Let $f$ and $g$ be odd, and let $h(x)=f(g(x))$. For every real $x$,\n$$\\begin{align*}h(-x)&=f(g(-x))\\\\h(-x)&=f(-g(x))\\\\h(-x)&=-f(g(x))\\\\h(-x)&=-h(x).\\end{align*}$$\nThe second row uses that $g$ is odd; the third uses that $f$ is odd. Therefore the composition is odd.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
