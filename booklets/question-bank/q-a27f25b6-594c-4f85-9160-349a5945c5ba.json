  "content": {
    "id": "p21-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "A bird was recorded by satellite tag to have flown 11 500 km in eight days. What was the speed of the bird in metres per second? Give your answer correct to two decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$16.64\\text{ m/s}$",
      "worked": "$$\\begin{align*}d&=11\\,500\\times1000\\\\d&=11\\,500\\,000\\text{ m}\\\\t&=8\\times24\\times60\\times60\\\\t&=691\\,200\\text{ s}\\\\s&=\\frac{d}{t}\\\\s&=\\frac{11\\,500\\,000}{691\\,200}\\text{ m/s}\\\\s&\\approx16.64\\text{ m/s}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
