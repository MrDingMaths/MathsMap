        "prompt": "$f(x)=3-2x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=7-2x$",
          "worked": "Replace $x$ with $x-2$.\n\n$$\\begin{align*}y&=f(x-2)\\\\y&=3-2(x-2)\\\\y&=7-2x\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p9-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=3-4x-x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=7-x^2$",
          "worked": "Replace $x$ with $x-2$.\n\n$$\\begin{align*}y&=f(x-2)\\\\y&=3-4(x-2)-(x-2)^2\\\\y&=3-4x+8-x^2+4x-4\\\\y&=7-x^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p9-q11-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=2^{-x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=2^{-x+2}$",
          "worked": "Replace $x$ with $x-2$.\n\n$$\\begin{align*}y&=f(x-2)\\\\y&=2^{-(x-2)}\\\\y&=2^{-x+2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      }
