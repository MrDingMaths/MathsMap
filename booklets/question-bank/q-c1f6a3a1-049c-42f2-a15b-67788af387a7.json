  "content": {
    "id": "p9-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Which is cheaper, 12 oranges for $\\$4.08$ or 30 oranges for $\\$12.96$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "12 oranges for $\\$4.08$ is cheaper.",
      "worked": "For the first offer:\n$$\\begin{align*}\\text{Cost per orange}&=\\$4.08\\div12\\\\\\text{Cost per orange}&=\\$0.34\\end{align*}$$\nFor the second offer:\n$$\\begin{align*}\\text{Cost per orange}&=\\$12.96\\div30\\\\\\text{Cost per orange}&=\\$0.432\\end{align*}$$\nSince $0.34<0.432$, 12 oranges for $\\$4.08$ is cheaper.",
      "solutionDiagrams": []
    },
