  "content": {
    "id": "p18-p2-root",
    "type": "question",
    "label": "2",
    "prompt": "Solve the equation $2^x+4^x=6$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$x=1$\n\nUse $u=2^x>0$ to turn the equation into a quadratic.",
      "worked": "Let $u=2^x$. Then $u>0$ and $4^x=(2^x)^2=u^2$.\n$$\\begin{align*}\nu+u^2&=6\\\\\nu^2+u-6&=0\\\\\n(u-2)(u+3)&=0\n\\end{align*}$$\nSince $u>0$, take $u=2$. Then $2^x=2^1$, so $x=1$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
