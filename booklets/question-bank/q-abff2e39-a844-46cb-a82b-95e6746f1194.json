        "label": "d",
        "prompt": "$\\frac{1}{8}$ or $\\frac{4}{24}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{8}$",
          "worked": "$$\\frac{1}{8}=\\frac{3}{24}$$\nSince $\\frac{3}{24}<\\frac{4}{24}$, $\\frac{1}{8}$ is smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4}{6}$ or $\\frac{17}{27}$",
