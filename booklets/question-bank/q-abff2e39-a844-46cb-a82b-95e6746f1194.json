    "type": "question",
    "label": "4",
    "prompt": "Compare these fractions by finding a common denominator. Which is smaller?",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p19-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{2}{3}$ or $\\frac{5}{6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{3}$",
          "worked": "$$\\frac{2}{3}=\\frac{4}{6}$$\nSince $\\frac{4}{6}<\\frac{5}{6}$, $\\frac{2}{3}$ is smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p19-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{9}{8}$ or $\\frac{8}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{8}$",
          "worked": "$$\\begin{align*}\\frac{9}{8}&=\\frac{63}{56}\\\\\\frac{8}{7}&=\\frac{64}{56}\\end{align*}$$\nSince $63<64$, $\\frac{9}{8}$ is smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p19-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{8}{17}$ or $\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{8}{17}$",
          "worked": "$$\\begin{align*}\\frac{8}{17}&=\\frac{16}{34}\\\\\\frac{1}{2}&=\\frac{17}{34}\\end{align*}$$\nSince $16<17$, $\\frac{8}{17}$ is smaller.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p19-q4-d",
