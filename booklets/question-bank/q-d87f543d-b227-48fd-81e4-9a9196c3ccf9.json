  "content": {
    "id": "p34-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Use the fact that $4 + 9 = 13$ to work out the following as decimals.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$400 + 900$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1300$",
          "worked": "$$\\begin{align*}400+900&=(4+9)\\times100\\\\&=13\\times100\\\\&=1300\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p34-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$0.4 + 0.9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.3$",
          "worked": "$$\\begin{align*}0.4+0.9&=\\frac{4+9}{10}\\\\&=\\frac{13}{10}\\\\&=1.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p34-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{9}{100} + 0.04$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.13$",
          "worked": "$$\\begin{align*}\\frac{9}{100}+0.04&=\\frac{9}{100}+\\frac{4}{100}\\\\&=\\frac{9+4}{100}\\\\&=\\frac{13}{100}\\\\&=0.13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{9}{10} + 0.4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1.3$",
          "worked": "$$\\begin{align*}\\frac{9}{10}+0.4&=\\frac{9}{10}+\\frac{4}{10}\\\\&=\\frac{9+4}{10}\\\\&=\\frac{13}{10}\\\\&=1.3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
  },
