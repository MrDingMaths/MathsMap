    "children": [
      {
        "id": "backfill-factor-theorem-8-root",
        "type": "part",
        "label": "a",
        "prompt": "When a polynomial $P(x)$ is divided by $x^2-7$, the remainder is $3x+2$.\nFind the remainder when $P(x)+P(-x)$ is divided by $x^2-7$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$; the linear remainder terms cancel when the identities are added.",
          "worked": "$$P(x)=(x^2-7)Q(x)+3x+2$$\n$$\\begin{align*}P(-x)&=((-x)^2-7)Q(-x)+3(-x)+2\\\\P(-x)&=(x^2-7)Q(-x)-3x+2\\end{align*}$$\n$$\\begin{align*}P(x)+P(-x)&=(x^2-7)Q(x)+3x+2+(x^2-7)Q(-x)-3x+2\\\\P(x)+P(-x)&=(x^2-7)Q(x)+(x^2-7)Q(-x)+4\\\\P(x)+P(-x)&=(x^2-7)(Q(x)+Q(-x))+4\\end{align*}$$\nTherefore the remainder is $4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "backfill-factor-theorem-9-root",
        "type": "part",
        "label": "b",
        "prompt": "When a polynomial $P(x)$ is divided by $x^2-6$, the remainder is $4-3x$.\nFind the remainder when $P(x)+P(-x)$ is divided by $x^2-6$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8$; the linear remainder terms cancel when the identities are added.",
          "worked": "$$P(x)=(x^2-6)Q(x)+4-3x$$\n$$\\begin{align*}P(-x)&=((-x)^2-6)Q(-x)+4-3(-x)\\\\P(-x)&=(x^2-6)Q(-x)+4+3x\\end{align*}$$\n$$\\begin{align*}P(x)+P(-x)&=(x^2-6)Q(x)+4-3x+(x^2-6)Q(-x)+4+3x\\\\P(x)+P(-x)&=(x^2-6)Q(x)+(x^2-6)Q(-x)+8\\\\P(x)+P(-x)&=(x^2-6)(Q(x)+Q(-x))+8\\end{align*}$$\nTherefore the remainder is $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
