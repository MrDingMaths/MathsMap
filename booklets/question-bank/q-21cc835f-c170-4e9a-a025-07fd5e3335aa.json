  "content": {
    "id": "v2-de45f-p12-practice-j4-222410-root",
    "type": "question",
    "label": null,
    "prompt": "Points $A, B$ and $C$ lie on a straight line, with B between A and C.\nPoint $A$ has coordinates $(-2,1)$\nPoint $B$ has coordinates $(2,4)$\nPoint $C$ is such that $AB:BC=2:3$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-de45f-p12-practice-j4-222410-j4-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the length of $AB$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5$ units",
          "worked": "$$\\begin{align*}AB&=\\sqrt{(2-(-2))^2+(4-1)^2}\\\\AB&=\\sqrt{16+9}\\\\AB&=5\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-de45f-p12-practice-j4-222410-j4-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the length of $BC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$7.5$ units",
          "worked": "$$\\begin{align*}BC&=\\frac{3}{2}AB\\\\BC&=\\frac{3}{2}\\times5\\\\BC&=7.5\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-de45f-p12-practice-j4-222410-j4-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Hence find the length of $AC$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$12.5$ units",
          "worked": "$$\\begin{align*}AC&=AB+BC\\\\AC&=5+7.5\\\\AC&=12.5\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
