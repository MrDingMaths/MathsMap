  "content": {
    "id": "p12-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "The cost of installing a standard swimming pool is rising exponentially according to the formula $C=\\$6000\\times(1.03)^n$, where $n$ is the number of years after 1st January 2015.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "What was the original cost on 1st January 2015?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\$6000$",
          "worked": "Here $n=0$.\n\n$$\\begin{align*}C&=\\$6000\\times(1.03)^0\\\\C&=\\$6000\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
