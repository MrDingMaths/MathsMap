  "content": {
    "id": "p37-q3",
    "type": "question",
    "label": "3",
    "prompt": "Levon buys 5 tickets in a raffle of 1000 tickets.\nWhat is the probability that he doesn’t win?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{199}{200}$",
      "worked": "Assuming one winning ticket is selected and all tickets are equally likely to win:\n$$\\begin{align*}P(\\text{not win})&=1-\\frac{5}{1000}\\\\P(\\text{not win})&=\\frac{995}{1000}\\\\P(\\text{not win})&=\\frac{199}{200}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 10
  },
