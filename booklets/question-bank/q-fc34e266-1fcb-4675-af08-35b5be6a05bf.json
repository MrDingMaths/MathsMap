        "questionDiagrams": [],
        "children": [
          {
            "id": "p30-q4-b-i",
            "type": "part",
            "label": "i",
            "prompt": "the tangent has gradient $2$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=4$",
              "worked": "$$\\begin{align*}2a-6&=2\\\\2a&=8\\\\a&=4\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 17
          },
          {
            "id": "p30-q4-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "the normal has gradient $4$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\dfrac{23}{8}$",
              "worked": "$$\\begin{align*}-\\frac{1}{2a-6}&=4\\\\2a-6&=-\\frac14\\\\2a&=\\frac{23}{4}\\\\a&=\\frac{23}{8}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 25
          },
          {
            "id": "p30-q4-b-iii",
            "type": "part",
            "label": "iii",
            "prompt": "the tangent has angle of inclination $135^\\circ$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\dfrac52$",
              "worked": "$$\\begin{align*}m_{\\mathrm{tangent}}&=\\tan135^\\circ=-1\\\\2a-6&=-1\\\\2a&=5\\\\a&=\\frac52\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 22
          },
          {
            "id": "p30-q4-b-iv",
            "type": "part",
            "label": "iv",
            "prompt": "the normal has angle of inclination $30^\\circ$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=3-\\dfrac{\\sqrt3}{2}$",
              "worked": "$$\\begin{align*}m_{\\mathrm{normal}}&=\\tan30^\\circ=\\frac{1}{\\sqrt3}\\\\-\\frac{1}{2a-6}&=\\frac{1}{\\sqrt3}\\\\2a-6&=-\\sqrt3\\\\2a&=6-\\sqrt3\\\\a&=3-\\frac{\\sqrt3}{2}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 31
          },
          {
            "id": "p30-q4-b-v",
            "type": "part",
            "label": "v",
            "prompt": "the tangent is parallel to $2x-3y+4=0$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\dfrac{10}{3}$",
              "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}3y&=2x+4\\\\y&=\\frac23x+\\frac43\\\\2a-6&=\\frac23\\\\2a&=\\frac{20}{3}\\\\a&=\\frac{10}{3}\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p30-q4-b-vi",
            "type": "part",
            "label": "vi",
            "prompt": "the normal is parallel to $2x-3y+4=0$.",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$a=\\dfrac94$",
              "worked": "Parallel lines have equal gradients.\n$$\\begin{align*}3y&=2x+4\\\\y&=\\frac23x+\\frac43\\\\-\\frac{1}{2a-6}&=\\frac23\\\\2a-6&=-\\frac32\\\\2a&=\\frac92\\\\a&=\\frac94\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 33
          }
        ]
      }
    ]
