  "content": {
    "id": "p30-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Consider $f(x)=x^2-6x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p30-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the gradient of the tangent and normal at the point $A(a,a^2-6a)$ on the curve.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $2a-6$. Normal: $-\\dfrac{1}{2a-6}$ for $a\\ne3$; when $a=3$, the normal is vertical and its gradient is undefined.",
          "worked": "$$\\begin{align*}f'(x)&=2x-6\\\\m_{\\mathrm{tangent}}&=f'(a)=2a-6\\\\m_{\\mathrm{normal}}&=-\\frac{1}{2a-6}\\quad(a\\ne3)\\end{align*}$$\nWhen $a=3$, the tangent is horizontal, so the normal is vertical and its gradient is undefined.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p30-q4-b",
        "type": "group",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
