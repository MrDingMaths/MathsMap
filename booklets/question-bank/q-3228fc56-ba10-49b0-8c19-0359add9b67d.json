  "content": {
    "id": "p8-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "Solve these equations.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3x}{2}-\\frac{x}{8}=12$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{96}{11}$",
          "worked": "$$\\begin{align*}\\frac{12x}{8}-\\frac{x}{8}&=12\\\\\\frac{11x}{8}&=12\\\\11x&=96\\\\x&=\\frac{96}{11}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 46
      },
      {
        "id": "p8-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{x}{3}+\\frac{2x-1}{4}=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{3}{10}$",
          "worked": "$$\\begin{align*}\\frac{4x}{12}+\\frac{3(2x-1)}{12}&=0\\\\\\frac{4x+6x-3}{12}&=0\\\\\\frac{10x-3}{12}&=0\\\\10x-3&=0\\\\10x&=3\\\\x&=\\frac{3}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p8-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{x}{4}+\\frac{2x+1}{6}=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{2}{7}$",
          "worked": "$$\\begin{align*}\\frac{3x}{12}+\\frac{2(2x+1)}{12}&=0\\\\\\frac{3x+4x+2}{12}&=0\\\\\\frac{7x+2}{12}&=0\\\\7x+2&=0\\\\7x&=-2\\\\x&=-\\frac{2}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p8-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x+3}{2}+\\frac{x-4}{3}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}\\frac{3(x+3)}{6}+\\frac{2(x-4)}{6}&=1\\\\\\frac{3x+9+2x-8}{6}&=1\\\\\\frac{5x+1}{6}&=1\\\\5x+1&=6\\\\5x&=5\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p8-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{x+2}{3}+\\frac{x-1}{2}=1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$",
          "worked": "$$\\begin{align*}\\frac{2(x+2)}{6}+\\frac{3(x-1)}{6}&=1\\\\\\frac{2x+4+3x-3}{6}&=1\\\\\\frac{5x+1}{6}&=1\\\\5x+1&=6\\\\5x&=5\\\\x&=1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p8-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{x-4}{5}+\\frac{x+2}{3}=2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "$$\\begin{align*}\\frac{3(x-4)}{15}+\\frac{5(x+2)}{15}&=2\\\\\\frac{3x-12+5x+10}{15}&=2\\\\\\frac{8x-2}{15}&=2\\\\8x-2&=30\\\\8x&=32\\\\x&=4\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
