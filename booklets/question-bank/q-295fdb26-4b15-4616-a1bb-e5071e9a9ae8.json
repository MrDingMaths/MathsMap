    "questionDiagrams": [],
    "children": [
      {
        "id": "p18-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$|x+5|\\ge 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "All real $x$.",
          "worked": "An absolute value is always non-negative, so the inequality holds for all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p18-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$|4-x|\\le 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=4$",
          "worked": "An absolute value is non-negative, so it must equal zero.\n$$\\begin{aligned}4-x&=0\\\\x&=4\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p18-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$|3x-4|>0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\ne\\frac43$",
          "worked": "An absolute value is positive unless its argument is zero.\n$$\\begin{aligned}3x-4&=0\\\\x&=\\frac43\\end{aligned}$$\nHence all real $x$ except $\\frac43$ satisfy the inequality.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p18-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$|4-3x|<0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "An absolute value cannot be negative, so there is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p18-q6-e",
        "type": "part",
        "label": "e",
        "prompt": "$|5x-2|\\le 0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\dfrac25$",
          "worked": "An absolute value is non-negative, so it must equal zero.\n$$\\begin{aligned}5x-2&=0\\\\5x&=2\\\\x&=\\frac25\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p18-q6-f",
        "type": "part",
        "label": "f",
        "prompt": "$|3x+2|<-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No solution.",
          "worked": "Since $|3x+2|\\ge0$, it cannot be less than $-7$. There is no solution.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p18-q6-g",
        "type": "part",
        "label": "g",
        "prompt": "$|3x-4|>-1$",
