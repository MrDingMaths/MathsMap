  "content": {
    "id": "p11-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the equation of a line with a gradient of $-4$ and an $x$-intercept of $5$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$y=-4x+20$",
      "worked": "The $x$-intercept gives the point $(5,0)$.\n$$\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-0&=-4(x-5)\\\\y&=-4x+20\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 36
  },
