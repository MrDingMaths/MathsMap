    "type": "question",
    "label": "15",
    "prompt": "Use $\\tan x=\\dfrac{\\sin x}{\\cos x}$ to show that $\\displaystyle\\int_0^{\\pi/4}\\tan x\\,dx=\\dfrac12\\ln 2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac12\\ln 2$.",
      "worked": "$$\\begin{aligned}\\int_0^{\\pi/4}\\tan x\\,dx&=\\int_0^{\\pi/4}\\frac{\\sin x}{\\cos x}\\,dx\\\\&=\\left[-\\ln|\\cos x|\\right]_0^{\\pi/4}\\\\&=-\\ln\\left(\\frac1{\\sqrt2}\\right)+\\ln1\\\\&=\\ln\\sqrt2\\\\&=\\frac12\\ln2.\\end{aligned}$$",
      "solutionDiagrams": []
    },
