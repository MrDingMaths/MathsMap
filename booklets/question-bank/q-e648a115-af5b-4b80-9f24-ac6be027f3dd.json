    }
  },
  "content": {
    "id": "p12-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Give a counterexample to disprove each of the following statements:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "All prime numbers are odd.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$ is prime and even.",
          "worked": "The number $2$ is prime but is not odd, so it is a counterexample.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p12-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Suppose $m,n\\in\\mathbb Z$. If $mn$ is even, then $m$ and $n$ are both even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=2$, $n=3$: $mn=6$ is even, but $n$ is odd.",
          "worked": "Take $m=2$ and $n=3$. Their product is $mn=2\\times3=6$, which is even, but the two factors are not both even.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "If $a$ divides $b+c$, then $a$ divides $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$, $b=1$, $c=3$: $2$ divides $4$ but divides neither $1$ nor $3$.",
          "worked": "Take $a=2$, $b=1$ and $c=3$. Then $b+c=4$, which is divisible by $2$. Neither $1$ nor $3$ is divisible by $2$, so the conclusion is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "Suppose $a\\in\\mathbb Z$. If $a^2$ is divisible by $12$, then $a$ is divisible by $12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=6$: $a^2=36$ is divisible by $12$, but $6$ is not.",
          "worked": "Take $a=6$. Then $a^2=36=12\\times3$ is divisible by $12$, but $6$ is not divisible by $12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p12-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "Suppose $x,y\\in\\mathbb R$. If $x>y$, then $x^3>y^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1$, $y=-2$: $1>-2$, but $x^3=1<4=y^2$.",
          "worked": "Take $x=1$ and $y=-2$. Then $x>y$, but $x^3=1$ and $y^2=4$. Thus $x^3<y^2$, so the asserted conclusion is false.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p12-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "For every natural number $n$, the number $n^2+n+17$ is prime.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$n=17$: $n^2+n+17=323=17\\times19$, which is composite.",
          "worked": "Take $n=17$.\n$$\\begin{align*}n^2+n+17&=17^2+17+17\\\\n^2+n+17&=323\\\\n^2+n+17&=17\\times19.\\end{align*}$$\nBoth factors exceed $1$, so this value is composite.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p12-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "Suppose $a,b\\in\\mathbb Z$. If $8$ divides $ab$, then $8$ divides $a$ or $8$ divides $b$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$, $b=4$: $ab=8$, but $8$ divides neither factor.",
          "worked": "Take $a=2$ and $b=4$. Then $ab=8$, which is divisible by $8$, but neither $2$ nor $4$ is divisible by $8$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p12-q4-h",
        "type": "part",
        "label": "h",
        "prompt": "If $a,b\\in\\mathbb Z$, then $a^3+a^2b+ab^2+b^3$ is a composite number.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2$, $b=3$: the expression equals $13$, which is prime.",
          "worked": "Take $a=-2$ and $b=3$.\n$$\\begin{align*}a^3+a^2b+ab^2+b^3&=(-2)^3+(-2)^2(3)+(-2)(3)^2+3^3\\\\a^3+a^2b+ab^2+b^3&=-8+12-18+27\\\\a^3+a^2b+ab^2+b^3&=13.\\end{align*}$$\nSince $13$ is prime, this is a counterexample.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
  },
