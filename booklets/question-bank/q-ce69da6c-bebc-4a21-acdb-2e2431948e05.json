  "content": {
    "id": "p28-q17-root",
    "type": "question",
    "label": "17",
    "prompt": "Find the surface area of the smallest cylinder that will contain three tennis balls arranged in a line if each ball has a radius of $3\\text{ cm}$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$126\\pi\\text{ cm}^2$.\n\nThe cylinder has radius $3\\text{ cm}$ and height $18\\text{ cm}$.",
      "worked": "The smallest cylinder has the same radius as a ball, and its height is three ball diameters.\n\n$$\\begin{align*}r&=3\\text{ cm}\\\\h&=3(2\\times3)=18\\text{ cm}\\\\A&=2\\pi r^2+2\\pi rh\\\\A&=2\\pi(3)^2+2\\pi(3)(18)\\\\A&=126\\pi\\text{ cm}^2.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 60
  },
