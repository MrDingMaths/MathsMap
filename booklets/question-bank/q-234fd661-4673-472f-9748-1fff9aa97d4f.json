  "content": {
    "id": "p27-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The lines $y=2x$ and $y=2x+\\frac52$ are parallel. Find the shortest distance between these two lines.\n\nHint: Start with the point $(0,0)$ on the first line.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p27-q3-short-result",
