  "content": {
    "id": "v2-1a591-p11-practice-j3-085643-root",
    "type": "question",
    "label": null,
    "prompt": "$f(x)=4-3x$. Find, in simplest form:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-1a591-p11-practice-j3-085643-j3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x+h)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4-3x-3h$",
          "worked": "$$\\begin{align*}f(x+h)&=4-3(x+h)\\\\&=4-3x-3h\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-1a591-p11-practice-j3-085643-j3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x+h)-f(x)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3h$",
          "worked": "$$\\begin{align*}f(x+h)-f(x)&=4-3x-3h-(4-3x)\\\\&=-3h\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-1a591-p11-practice-j3-085643-j3-q-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\frac{f(x+h)-f(x)}{h}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-3$, for $h\\ne0$.",
          "worked": "$$\\begin{align*}\\frac{f(x+h)-f(x)}{h}&=\\frac{-3h}{h}\\\\&=-3\\qquad(h\\ne0)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
