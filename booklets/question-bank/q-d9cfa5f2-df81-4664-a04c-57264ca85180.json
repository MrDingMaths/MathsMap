  "content": {
    "id": "p10-q19-root",
    "type": "question",
    "label": null,
    "prompt": "A regular ten-sided die labelled with the numbers 1 to 10 is rolled once. Find the probability that the outcome is:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p10-q19-a",
        "type": "part",
        "label": "a",
        "prompt": "prime",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2}{5}$",
          "worked": "The prime outcomes are $\\{2,3,5,7\\}$.\n$$\\begin{align*}\\Pr(\\text{prime})&=\\frac{4}{10}\\\\\\Pr(\\text{prime})&=\\frac{2}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q19-b",
        "type": "part",
        "label": "b",
        "prompt": "even and prime",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{10}$",
          "worked": "The only outcome that is both even and prime is $2$.\n$$\\Pr(\\text{even and prime})=\\frac{1}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p10-q19-c",
        "type": "part",
        "label": "c",
        "prompt": "odd and prime",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{10}$",
          "worked": "The outcomes that are both odd and prime are $\\{3,5,7\\}$.\n$$\\Pr(\\text{odd and prime})=\\frac{3}{10}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p10-q19-d",
        "type": "part",
        "label": "d",
        "prompt": "even or prime",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{4}{5}$",
          "worked": "Inclusive “or” includes outcomes with either or both properties. The favourable outcomes are $\\{2,3,4,5,6,7,8,10\\}$, counting $2$ once.\n$$\\begin{align*}\\Pr(\\text{even or prime})&=\\frac{8}{10}\\\\\\Pr(\\text{even or prime})&=\\frac{4}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p10-q19-e",
        "type": "part",
        "label": "e",
        "prompt": "odd or prime",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{3}{5}$",
          "worked": "The favourable outcomes are $\\{1,2,3,5,7,9\\}$, counting each outcome once.\n$$\\begin{align*}\\Pr(\\text{odd or prime})&=\\frac{6}{10}\\\\\\Pr(\\text{odd or prime})&=\\frac{3}{5}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p10-q19-f",
        "type": "part",
        "label": "f",
        "prompt": "odd and even",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "No integer is both odd and even, so the intersection is empty.\n$$\\Pr(\\text{odd and even})=\\frac{0}{10}=0.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      },
      {
        "id": "p10-q19-g",
        "type": "part",
        "label": "g",
        "prompt": "odd or even.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "Every outcome is either odd or even, so the union is the whole sample space.\n$$\\Pr(\\text{odd or even})=\\frac{10}{10}=1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 12
      }
    ]
  },
