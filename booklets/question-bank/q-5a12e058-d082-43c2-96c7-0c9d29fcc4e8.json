  "content": {
    "id": "p8-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "Simplify the following.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q14-parts",
        "type": "group",
        "label": "",
        "prompt": "",
