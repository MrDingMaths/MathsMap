        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p8-q14-a",
            "type": "part",
            "label": "a",
            "prompt": "$a^{\\frac{1}{2}}\\times a^{-\\frac{1}{2}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}a^{\\frac{1}{2}}\\times a^{-\\frac{1}{2}}&=a^{\\frac{1}{2}-\\frac{1}{2}}\\\\&=a^0\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q14-b",
            "type": "part",
            "label": "b",
            "prompt": "$a^{\\frac{2}{3}}\\times a^{-\\frac{2}{3}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}a^{\\frac{2}{3}}\\times a^{-\\frac{2}{3}}&=a^{\\frac{2}{3}-\\frac{2}{3}}\\\\&=a^0\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q14-c",
            "type": "part",
            "label": "c",
            "prompt": "$a^{\\frac{4}{7}}\\times a^{-\\frac{4}{7}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}a^{\\frac{4}{7}}\\times a^{-\\frac{4}{7}}&=a^{\\frac{4}{7}-\\frac{4}{7}}\\\\&=a^0\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q14-d",
            "type": "part",
            "label": "d",
            "prompt": "$a^{\\frac{5}{6}}\\div a^{\\frac{5}{6}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}a^{\\frac{5}{6}}\\div a^{\\frac{5}{6}}&=a^{\\frac{5}{6}-\\frac{5}{6}}\\\\&=a^0\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p8-q14-e",
            "type": "part",
            "label": "e",
            "prompt": "$\\left(a^{\\frac{1}{2}}\\right)^{\\frac{1}{2}}\\div a^{\\frac{1}{4}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}\\left(a^{\\frac{1}{2}}\\right)^{\\frac{1}{2}}\\div a^{\\frac{1}{4}}&=a^{\\frac{1}{4}}\\div a^{\\frac{1}{4}}\\\\&=a^{\\frac{1}{4}-\\frac{1}{4}}\\\\&=a^0\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          },
          {
            "id": "p8-q14-f",
            "type": "part",
            "label": "f",
            "prompt": "$a^2\\div\\left(a^3\\right)^{\\frac{2}{3}}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$1$",
              "worked": "$$\\begin{align*}a^2\\div\\left(a^3\\right)^{\\frac{2}{3}}&=a^2\\div a^2\\\\&=a^{2-2}\\\\&=a^0\\\\&=1\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 32
          }
        ]
      },
      {
        "id": "p8-q14-observation",
        "type": "part",
        "label": "g",
        "prompt": "What do you notice about your answers?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "They all evaluate to 1.",
          "worked": "Each expression simplifies to $a^0=1$, so all six answers are 1.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
