  "content": {
    "id": "p54-q4",
    "type": "question",
    "label": "4",
    "prompt": "",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "By evaluating both sides of the equation, show that $6^2 = 2^2 \\times 3^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6^2=36$ and $2^2\\times3^2=4\\times9=36$, so both sides are equal.",
          "worked": "$$\\begin{align*}6^2 &= 36\\\\2^2\\times3^2 &= 4\\times9\\\\&=36\\end{align*}$$Both sides equal $36$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "Therefore, write $6^3$ as a product of powers of 2 and 3.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6^3=2^3\\times3^3$",
          "worked": "$$\\begin{align*}6^3 &= (2\\times3)(2\\times3)(2\\times3)\\\\&=(2\\times2\\times2)(3\\times3\\times3)\\\\&=2^3\\times3^3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "Write $10^2$ as a product of powers of 2 and 5.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2^2\\times5^2$",
          "worked": "$$\\begin{align*}10^2 &=(2\\times5)(2\\times5)\\\\&=(2\\times2)(5\\times5)\\\\&=2^2\\times5^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
