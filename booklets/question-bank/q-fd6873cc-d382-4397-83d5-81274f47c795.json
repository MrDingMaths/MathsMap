  "content": {
    "id": "v2-4ef5b-p11-practice-slot-3-root",
    "type": "question",
    "label": null,
    "prompt": "Find the minimum length of each code so that every one can have a different code.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-4ef5b-p11-practice-slot-3-slot-3-q-a",
        "type": "part",
        "label": "a",
        "prompt": "A library has 60 000 members. Each member is given a code made up of letters only. How many letters should the code have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "4 letters",
          "worked": "With $n$ letters, there are $26^n$ possible codes. We need $26^n\\geq60\\,000$.\n\n$$\\begin{aligned}26^3&=17\\,576<60\\,000\\\\26^4&=456\\,976\\geq60\\,000\\end{aligned}$$\n\nThe minimum is 4 letters.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "v2-4ef5b-p11-practice-slot-3-slot-3-q-b",
        "type": "part",
        "label": "b",
        "prompt": "A school has 1200 lockers. Each locker is given a code made up of binary digits (0 or 1). How many binary digits should the code have?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "11 binary digits",
          "worked": "With $n$ binary digits, there are $2^n$ possible codes. We need $2^n\\geq1200$.\n\n$$\\begin{aligned}2^{10}&=1024<1200\\\\2^{11}&=2048\\geq1200\\end{aligned}$$\n\nThe minimum is 11 binary digits.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
