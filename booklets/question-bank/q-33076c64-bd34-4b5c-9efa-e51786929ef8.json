    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3750\\text{ m}$",
      "worked": "$$\\begin{align*}\\text{Time}&=\\frac{45}{60}\\text{ h}\\\\\\text{Distance}&=5\\times\\frac{45}{60}\\text{ km}\\\\\\text{Distance}&=\\frac{15}{4}\\times1000\\text{ m}\\\\\\text{Distance}&=3750\\text{ m}\\end{align*}$$",
