    "type": "question",
    "label": "2",
    "prompt": "Form an equation and solve.\n\nWhen 16 is added to twice Simone’s age, the answer is 44. How old is Simone?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "14 years old.",
      "worked": "Let $a$ be Simone’s age in years.\n\n$$\\begin{align*}2a+16&=44\\\\2a&=28\\\\a&=14\\end{align*}$$\n\nSimone is 14 years old.",
