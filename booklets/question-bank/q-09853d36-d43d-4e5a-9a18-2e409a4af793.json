  "content": {
    "id": "p69-q10-root",
    "type": "question",
    "label": "10",
    "prompt": "Show that the tangent to $y=\\sqrt[3]{x}$ at $T(-1,-1)$ meets the curve again at $(8,2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [
      {
        "id": "p69-q10-diagram",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"curveBlue\",\"hex\":\"268CFF\",\"reason\":\"cube-root curve\"},{\"name\":\"tangentRed\",\"hex\":\"EF6068\",\"reason\":\"tangent distinguished from curve\"}],\"reference\":\"source page 69 p69-q10-diagram\"}\n\\begin{tikzpicture}[x=0.28cm,y=0.85cm,>=stealth]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{curveBlue}{HTML}{268CFF}\n\\definecolor{tangentRed}{HTML}{EF6068}\n\\draw[<->,black,line width=0.5pt] (-8.8,0)--(10.2,0) node[right] {$x$};\n\\draw[<->,black,line width=0.5pt] (0,-3.7)--(0,3.7) node[above] {$y$};\n\\draw[<->,curveBlue,line width=0.8pt,domain=-2.05:2.15,samples=121,variable=\\t] plot ({\\t*\\t*\\t},{\\t});\n\\draw[<->,tangentRed,line width=0.8pt] (-8,-3.333333)--(10,2.666667);\n\\node[text=black,anchor=north west] at (1,3.35) {not to scale};\n\\end{tikzpicture}",
