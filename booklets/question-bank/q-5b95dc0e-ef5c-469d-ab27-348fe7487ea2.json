  "content": {
    "id": "p32-q21-root",
    "type": "question",
    "label": "21",
    "prompt": "In a clothing factory, $28\\%$ of the employees are female. There are 672 female employees. How many employees are there in total?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "2400 employees.",
      "worked": "$$\\begin{align*}28\\%\\text{ of the total}&=672\\\\1\\%\\text{ of the total}&=672\\div28=24\\\\100\\%\\text{ of the total}&=24\\times100=2400\\end{align*}$$\n\nThere are 2400 employees in total.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 27
