  "content": {
    "id": "p21-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "The velocity $v$ m s$^{-1}$ at time $t$ seconds ($t\\geq0$) of a body moving in a straight line is given by $v=6t^2+6t-12$. Find:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "the acceleration when the velocity is zero.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$18\\text{ m/s}^2$",
          "worked": "When the velocity is zero,\n$$\\begin{align*}6t^2+6t-12&=0\\\\t^2+t-2&=0\\\\(t+2)(t-1)&=0\\\\t&=-2\\text{ or }1.\\end{align*}$$\nSince $t\\geq0$, use $t=1$ s.\n$$\\begin{align*}a(t)&=\\frac{dv}{dt}=12t+6\\\\a(1)&=12(1)+6\\\\a(1)&=18\\text{ m/s}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 33
      },
      {
        "id": "p21-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "the initial velocity and acceleration.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Initial velocity: $-12\\text{ m/s}$; initial acceleration: $6\\text{ m/s}^2$.",
          "worked": "Initially, $t=0$.\n$$\\begin{align*}v(0)&=6(0)^2+6(0)-12\\\\v(0)&=-12\\text{ m/s}.\\end{align*}$$\n$$\\begin{align*}a(t)&=12t+6\\\\a(0)&=12(0)+6\\\\a(0)&=6\\text{ m/s}^2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
