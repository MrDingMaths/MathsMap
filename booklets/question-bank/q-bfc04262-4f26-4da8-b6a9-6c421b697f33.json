  "content": {
    "id": "p36-q1-root",
    "type": "question",
    "label": "1",
    "prompt": "For the points $A(-1,3)$ and $B(4,2)$, find the coordinates of the point $P$ on the interval $AB$ such that $AP:PB$ equals:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p36-q1-a",
        "type": "part",
        "label": "a",
        "prompt": "$1:1$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=(1.5,2.5)$",
          "worked": "$P$ is the midpoint of $AB$.\n$$\\begin{align*}P&=\\left(\\frac{-1+4}{2},\\frac{3+2}{2}\\right)\\\\P&=\\left(\\frac32,\\frac52\\right).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p36-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$2:1$ ($P$ is closer to $B$.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=\\left(\\frac73,\\frac73\\right)$.\n\n$P$ is two-thirds of the way from $A$ to $B$.",
          "worked": "From $A$ to $B$, the horizontal change is $4-(-1)=5$ and the vertical change is $2-3=-1$. Since $AP:PB=2:1$, take two of the three equal portions of each change.\n$$\\begin{align*}x_P&=-1+\\frac23\\times5\\\\x_P&=\\frac73,\\\\y_P&=3+\\frac23\\times(-1)\\\\y_P&=\\frac73.\\end{align*}$$\nThus $P=\\left(\\frac73,\\frac73\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      },
      {
        "id": "p36-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$2:3$ ($P$ is closer to $A$.)",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=\\left(1,\\frac{13}{5}\\right)$.\n\n$P$ is two-fifths of the way from $A$ to $B$.",
          "worked": "From $A$ to $B$, the horizontal change is $5$ and the vertical change is $-1$. Since $AP:PB=2:3$, take two of the five equal portions of each change.\n$$\\begin{align*}x_P&=-1+\\frac25\\times5\\\\x_P&=1,\\\\y_P&=3+\\frac25\\times(-1)\\\\y_P&=\\frac{13}{5}.\\end{align*}$$\nThus $P=\\left(1,\\frac{13}{5}\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 35
      }
    ]
  },
