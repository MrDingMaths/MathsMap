  "content": {
    "id": "p11-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "In a certain experiment, two events $A$ and $B$ satisfy $P(A)=0.6$, $P(B)=0.3$ and $P(A\\cap B)=0.2$. Find $P(A\\cup B)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.7$",
      "worked": "$$\\begin{align*}P(A\\cup B)&=P(A)+P(B)-P(A\\cap B)\\\\P(A\\cup B)&=0.6+0.3-0.2\\\\P(A\\cup B)&=0.7\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 25
  },
