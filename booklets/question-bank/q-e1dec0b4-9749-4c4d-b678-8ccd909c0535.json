        "id": "p51-q67-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $h=t^2+\\dfrac12$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-q67-a-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "h=t^2+\\frac12",
                    "display": false
                  }
                ]
              },
              {
                "id": "p51-q67-a-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The normal at ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "T",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " has gradient ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "-\\frac{1}{2t}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " and passes through ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "C(0,h)",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "$$\\begin{align*}\\frac{dy}{dx}&=2x\\\\m_{\\mathrm N}&=-\\frac{1}{2t}\\\\y-t^2&=-\\frac{1}{2t}(x-t)\\\\h-t^2&=-\\frac{1}{2t}(0-t)\\\\h&=t^2+\\frac12\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p51-q67-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the value of $h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p51-q67-b-short-result",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "h=\\frac54",
                    "display": false
                  }
                ]
              },
              {
                "id": "p51-q67-b-short-method",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Use ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "CT=1",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " with the vertical separation ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "h-t^2=\\frac12",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "The circle has radius $CT=1$ and $h-t^2=\\dfrac12$. Hence\n$$\\begin{align*}CT^2&=(t-0)^2+(t^2-h)^2\\\\1&=t^2+\\left(-\\frac12\\right)^2\\\\t^2&=\\frac34\\\\h&=\\frac34+\\frac12\\\\h&=\\frac54\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 66
      }
