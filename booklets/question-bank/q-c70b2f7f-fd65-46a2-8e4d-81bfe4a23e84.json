        "answer": {
          "short": "$a_{11}=-55$",
          "worked": "AP where $a=15$, $d=-7$.\n\n$$\\begin{align*}a_{11}&=15+(11-1)(-7)\\\\a_{11}&=15+10(-7)\\\\a_{11}&=-55\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q4-c",
