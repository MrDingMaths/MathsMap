    "id": "p8-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Use the formula $a_n=a+(n-1)d$ to find the 11th term $a_{11}$ of these APs:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$a=7,\\quad d=6$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a_{11}=67$",
          "worked": "AP where $a=7$, $d=6$.\n\n$$\\begin{align*}a_{11}&=7+(11-1)(6)\\\\a_{11}&=7+10(6)\\\\a_{11}&=67\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p8-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$a=15,\\quad d=-7$",
        "layout": "list",
