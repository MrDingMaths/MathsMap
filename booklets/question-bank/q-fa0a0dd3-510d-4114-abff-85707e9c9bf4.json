                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\mathrm{LHS}=3\\qquad\\mathrm{RHS}=\\frac12(7(1)-1)=\\frac12(6)=3",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
