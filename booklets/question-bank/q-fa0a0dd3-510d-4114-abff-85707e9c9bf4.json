                ]
              },
              {
                "id": "p17-q2-a-wtp",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}3+10+17+\\cdots+(7k-4)+(7(k+1)-4)&=\\frac{k+1}{2}\\bigl(7(k+1)-1\\bigr)\\\\&=\\frac{k+1}{2}(7k+6).\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p17-q2-a-inductive-working",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}\\mathrm{LHS}&=[3+10+17+\\cdots+(7k-4)]+(7k+3)\\\\&=\\frac{k}{2}(7k-1)+(7k+3)\\quad\\text{using assumption}\\\\&=\\frac12(7k^2-k)+7k+3\\\\&=\\frac12[7k^2-k+14k+6]\\\\&=\\frac12(7k^2+13k+6)\\\\&=\\frac12(k+1)(7k+6)\\\\&=\\frac{k+1}{2}(7k+6)\\\\&=\\mathrm{RHS}.\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p17-q2-a-conclusion",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The statement is true for ",
