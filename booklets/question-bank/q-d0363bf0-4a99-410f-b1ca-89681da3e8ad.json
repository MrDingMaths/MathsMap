  "content": {
    "id": "p9-q3-content",
    "type": "question",
    "label": "3",
    "prompt": "Swap $x$ and $y$ and solve for $y$ to find the inverse of each function.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p9-q3-functions",
        "type": "group",
        "label": "",
        "prompt": "",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p9-q3-a",
            "type": "part",
            "label": "a",
            "prompt": "$$y=\\frac{1}{x}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac{1}{x}$, $x\\ne0$.",
              "worked": "$$\\begin{align*}x&=\\frac{1}{y}\\\\xy&=1\\\\y&=\\frac{1}{x}\\end{align*}$$\nThe inverse has domain $x\\ne0$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 27
          },
          {
            "id": "p9-q3-b",
            "type": "part",
            "label": "b",
            "prompt": "$$y=-x$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=-x$.",
              "worked": "$$\\begin{align*}x&=-y\\\\y&=-x\\end{align*}$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 16
          },
          {
            "id": "p9-q3-c",
            "type": "part",
            "label": "c",
            "prompt": "$$y=\\frac{2x-2}{x-2}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$y=\\dfrac{2x-2}{x-2}$, $x\\ne2$.",
              "worked": "$$\\begin{align*}x&=\\frac{2y-2}{y-2}\\\\x(y-2)&=2y-2\\\\xy-2x&=2y-2\\\\(x-2)y&=2x-2\\\\y&=\\frac{2x-2}{x-2}\\end{align*}$$\nThe inverse has domain $x\\ne2$.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 45
          }
        ]
      },
      {
        "id": "p9-q3-observation",
        "type": "part",
        "label": "d",
        "prompt": "What do you notice? What does this mean, graphically?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Each inverse is identical to the original function. Each graph is symmetrical about $y=x$.",
          "worked": "Each inverse has the same equation and domain as its original function. Reflecting each graph across $y=x$ leaves it unchanged, so each graph is symmetrical about $y=x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
