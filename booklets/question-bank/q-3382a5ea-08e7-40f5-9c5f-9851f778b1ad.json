  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve $\\sin\\theta=\\frac12$ in the domain $\\theta\\in[0,4\\pi]$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\theta=\\frac{\\pi}{6},\\frac{5\\pi}{6},\\frac{13\\pi}{6},\\frac{17\\pi}{6}$.",
      "worked": "The reference angle is $\\frac{\\pi}{6}$. Since $\\sin\\theta>0$, the solutions lie in quadrants I and II.\n\nIn $[0,2\\pi)$,\n$$\\begin{align*}\\theta&=\\frac{\\pi}{6}\\quad\\text{or}\\quad\\frac{5\\pi}{6}.\\end{align*}$$\nAdd $2\\pi$ to obtain the remaining solutions in the domain:\n$$\\begin{align*}\\frac{\\pi}{6}+2\\pi&=\\frac{13\\pi}{6}\\\\\\frac{5\\pi}{6}+2\\pi&=\\frac{17\\pi}{6}.\\end{align*}$$\nTherefore,\n$$\\theta=\\frac{\\pi}{6},\\frac{5\\pi}{6},\\frac{13\\pi}{6},\\frac{17\\pi}{6}.$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
