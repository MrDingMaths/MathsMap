            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y'&=18x^2+2x-35\\\\18x^2+2x-35&=0\\\\x&=\\frac{-2\\pm\\sqrt{2^2-4(18)(-35)}}{36}\\\\x&=\\frac{-1\\pm\\sqrt{631}}{18}.\\end{aligned}",
                "display": true
              }
            ]
