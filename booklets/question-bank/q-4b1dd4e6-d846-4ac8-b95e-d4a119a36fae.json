    "type": "question",
    "label": "12",
    "prompt": "Sketch $y=6x^3+x^2-35x$, showing all intercepts and turning points.\nGive turning points as decimals to 3 d.p.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "Intercepts: $(-\\tfrac52,0)$, $(0,0)$, $(\\tfrac73,0)$. Local maximum $(-1.451,34.561)$; local minimum $(1.340,-30.668)$.",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
