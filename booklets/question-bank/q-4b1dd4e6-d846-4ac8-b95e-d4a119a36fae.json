            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}y&=x(6x^2+x-35)\\\\y&=x(2x+5)(3x-7).\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p21-q12-intercepts",
            "type": "paragraph",
            "fontSize": null,
            "align": "left",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "text",
                "text": "The intercepts are ",
                "marks": []
              },
              {
                "type": "math",
                "latex": "(-\\tfrac52,0),\\ (0,0),\\ (\\tfrac73,0)",
                "display": false
              },
              {
                "type": "text",
                "text": ". The leading term is positive, so the curve falls to the left and rises to the right.",
                "marks": []
              }
            ]
          },
          {
