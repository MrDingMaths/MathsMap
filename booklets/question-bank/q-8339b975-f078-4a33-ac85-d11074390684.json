  "content": {
    "id": "p105-q28",
    "type": "question",
    "label": "28",
    "prompt": "Evie spent $\\frac{1}{2}$ of her earnings on a pair of shorts and $\\frac{1}{2}$ of what remained on a present.\n\nIf she spent \\$90, how much does she earn?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$120",
      "worked": "Let Evie's earnings be $y$ dollars. The present costs $\\frac{1}{2}\\times\\frac{1}{2}y=\\frac{1}{4}y$ dollars.\n\n$$\\begin{align*}\\frac{1}{2}y+\\frac{1}{4}y&=90\\\\\\frac{3}{4}y&=90\\\\y&=90\\times\\frac{4}{3}\\\\y&=120\\end{align*}$$\n\nEvie earns \\$120.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 40
  },
