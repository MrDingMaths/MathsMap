  "content": {
    "id": "p69-q14-root",
    "type": "question",
    "label": "",
    "prompt": "Determine the $x$ values for which the $y$ value is defined.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p69-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\sqrt{x^2-4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x\\le-2$ or $x\\ge2$.",
          "worked": "The expression inside the square root must be greater than or equal to zero.\n$$\\begin{aligned}x^2-4&\\ge0\\\\(x-2)(x+2)&\\ge0.\\end{aligned}$$\nThe upward-opening parabola has $x$-intercepts $-2$ and $2$. It is on or above the $x$-axis outside these intercepts, so $x\\le-2$ or $x\\ge2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 57
      },
      {
        "id": "p69-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{1}{\\sqrt{1-x^2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1<x<1$.",
          "worked": "The expression inside the square root must be non-negative, and the denominator cannot be zero. Therefore it must be strictly positive.\n$$\\begin{aligned}1-x^2&>0\\\\x^2-1&<0\\\\(x-1)(x+1)&<0.\\end{aligned}$$\nThe upward-opening parabola $y=x^2-1$ has $x$-intercepts $-1$ and $1$ and is below the $x$-axis between them. Thus $-1<x<1$; the endpoints are excluded because they make the denominator zero.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      }
    ]
  },
