  "content": {
    "id": "v2-2ee03-p25-practice-slot-13-upper-root",
    "type": "question",
    "label": null,
    "prompt": "The graph of a quartic polynomial $P(x)$ is shown.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [
      {
        "id": "v2-2ee03-p25-practice-slot-13-upper-slot-13-upper-q-graph",
        "role": "question",
        "format": "tikz",
        "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[],\"reference\":\"slot-13 upper graph\"}\n\\begin{tikzpicture}[x=0.8cm,y=0.0625cm]\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\\def\\tk#1{\\special{dvisvgm:raw <g data-graph-text=\"tick\">}#1\\special{dvisvgm:raw </g>}}\\draw[<->,black,line width=0.5pt] (-3.1,0)--(4.3,0) node[right] {$x$};\\draw[<->,black,line width=0.5pt] (0,-45)--(0,42) node[above] {$y$};\\draw[<->,black,line width=0.8pt] plot[domain=-2.3:3.5,samples=200] (\\x,{-2*(\\x+2)*(\\x-1)^2*(\\x-3)});\\node[above left] at (-2,0) {\\tk{$-2$}};\\node[below] at (1,0) {\\tk{$1$}};\\node[above right] at (3,0) {\\tk{$3$}};\\node[left] at (0,12) {\\tk{$12$}};\\end{tikzpicture}",
        "src": null,
        "widthMm": 55,
        "alt": "Mathematical diagram",
        "overlayOf": null,
        "transparent": false,
        "axes": null,
        "derived": false
      }
    ],
    "children": [
      {
        "id": "v2-2ee03-p25-practice-slot-13-upper-slot-13-upper-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Write the equation of $P(x)$ in factorised form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P(x)=-2(x+2)(x-1)^2(x-3)$",
          "worked": "The curve crosses at $x=-2$ and $x=3$ and touches at $x=1$, so\n$$P(x)=k(x+2)(x-1)^2(x-3).$$\nThe curve passes through $(0,12)$:\n$$\\begin{align*}12&=k(2)(-1)^2(-3)\\\\12&=-6k\\\\k&=-2\\end{align*}$$\nHence $P(x)=-2(x+2)(x-1)^2(x-3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-2ee03-p25-practice-slot-13-upper-slot-13-upper-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find the values of $a$, $b$, $c$, $d$ and $e$ in $P(x)=ax^4+bx^3+cx^2+dx+e$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2$, $b=6$, $c=6$, $d=-22$, $e=12$",
          "worked": "$$\\begin{align*}(x-1)^2(x+2)(x-3)&=(x^2-2x+1)(x^2-x-6)\\\\&=x^2(x^2-x-6)-2x(x^2-x-6)+1(x^2-x-6)\\\\&=x^4-x^3-6x^2-2x^3+2x^2+12x+x^2-x-6\\\\&=x^4-3x^3-3x^2+11x-6\\\\P(x)&=-2(x^4-3x^3-3x^2+11x-6)\\\\&=-2x^4+6x^3+6x^2-22x+12\\end{align*}$$\nHence $a=-2$, $b=6$, $c=6$, $d=-22$, $e=12$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 85
      }
    ]
  },
