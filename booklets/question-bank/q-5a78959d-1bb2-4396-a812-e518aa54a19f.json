  "content": {
    "id": "p41-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "Amanda has $\\$P$ in her bank account. Write an expression for money each person has if:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p41-q16-a",
        "type": "part",
        "label": "a",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "7db65164-9c0b-43e0-a8a4-e10c9c552ca4",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Paul has $250 more than Amanda in his bank account.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P+250$",
          "worked": "Add $250$ to Amanda’s balance: $P+250$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 10
      },
      {
        "id": "p41-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "Gisele has one third of Amanda’s money.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{P}{3}$",
          "worked": "Divide Amanda’s balance by $3$: $\\frac{P}{3}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p41-q16-c",
        "type": "part",
        "label": "c",
        "prompt": "Vinesh has triple the amount of Paul.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$3(P+250)$",
          "worked": "Paul has $P+250$ dollars, so Vinesh has $3(P+250)$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p41-q16-d",
        "type": "part",
        "label": "d",
        "prompt": "Michele has half the amount of money as Gisele.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{P}{6}$",
          "worked": "$$\\begin{align*}\\frac{1}{2}\\times\\frac{P}{3}&=\\frac{P}{6}\\end{align*}$$\nMichele has $\\frac{P}{6}$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p41-q16-e",
        "type": "part",
        "label": "e",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "65aee9c7-7f9e-4869-baa3-0133ace5c1be",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "Lucy has $20 less than Gisele.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{P}{3}-20$",
          "worked": "Subtract $20$ from Gisele’s balance: $\\frac{P}{3}-20$ dollars.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p41-q16-f",
        "type": "part",
        "label": "f",
        "prompt": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "5d239a0d-3ae1-4eda-8be2-fbc1a2019d39",
              "type": "paragraph",
              "fontSize": null,
              "align": "left",
              "spaceBefore": 0,
              "spaceAfter": 2,
              "lineHeight": 1.4,
              "indent": 0,
              "inlines": [
                {
                  "type": "text",
                  "text": "If Amanda has $600 in her account, find how much each person has.",
                  "marks": []
                }
              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "53e1ab8a-109d-4a01-a8cc-7ef6642ee88e",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Paul: $850; Gisele: $200; Vinesh: $2550; Michele: $100; Lucy: $180.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "worked": "Substitute $P=600$. All balances below are in dollars.\n$$\\begin{align*}\\text{Paul’s balance}&=600+250\\\\\\text{Paul’s balance}&=850\\\\\\text{Gisele’s balance}&=\\frac{600}{3}\\\\\\text{Gisele’s balance}&=200\\\\\\text{Vinesh’s balance}&=3(600+250)\\\\\\text{Vinesh’s balance}&=2550\\\\\\text{Michele’s balance}&=\\frac{600}{6}\\\\\\text{Michele’s balance}&=100\\\\\\text{Lucy’s balance}&=\\frac{600}{3}-20\\\\\\text{Lucy’s balance}&=180\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 75
      }
    ]
  },
