      {
        "id": "p42-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\displaystyle\\int_1^3 2^x\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6}{\\ln 2}\\approx 8.6562$",
          "worked": "$$\\begin{align*}\\int_1^3 2^x\\,dx&=\\left[\\frac{2^x}{\\ln 2}\\right]_1^3\\\\\\int_1^3 2^x\\,dx&=\\frac{8-2}{\\ln 2}\\\\\\int_1^3 2^x\\,dx&=\\frac{6}{\\ln 2}\\\\\\int_1^3 2^x\\,dx&\\approx 8.6562\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      },
      {
        "id": "p42-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\displaystyle\\int_{-1}^1(3^x+1)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2+\\dfrac{8}{3\\ln 3}\\approx 4.4273$",
          "worked": "$$\\begin{align*}\\int_{-1}^1(3^x+1)\\,dx&=\\left[\\frac{3^x}{\\ln 3}+x\\right]_{-1}^1\\\\\\int_{-1}^1(3^x+1)\\,dx&=\\frac{3}{\\ln 3}+1-\\left(\\frac{1}{3\\ln 3}-1\\right)\\\\\\int_{-1}^1(3^x+1)\\,dx&=2+\\frac{8}{3\\ln 3}\\\\\\int_{-1}^1(3^x+1)\\,dx&\\approx 4.4273\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      },
      {
        "id": "p42-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\displaystyle\\int_0^2(10^x-10x)\\,dx$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{99}{\\ln 10}-20\\approx 22.9952$",
          "worked": "$$\\begin{align*}\\int_0^2(10^x-10x)\\,dx&=\\left[\\frac{10^x}{\\ln 10}-5x^2\\right]_0^2\\\\\\int_0^2(10^x-10x)\\,dx&=\\frac{100}{\\ln 10}-20-\\frac{1}{\\ln 10}\\\\\\int_0^2(10^x-10x)\\,dx&=\\frac{99}{\\ln 10}-20\\\\\\int_0^2(10^x-10x)\\,dx&\\approx 22.9952\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
