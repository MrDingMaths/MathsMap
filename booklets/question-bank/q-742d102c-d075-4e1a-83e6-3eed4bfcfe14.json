  "content": {
    "id": "p11-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Let $x$ and $y$ be integers. Find the number of solutions $(x,y)$ to the inequality $x^2+y^2<5$.",
    "layout": "list",
    "columns": null,
