        "children": [],
        "answer": {
          "short": "$3$",
          "worked": "$$\\begin{align*}\\frac{9x+3}{3x+1}&=\\frac{3(3x+1)}{3x+1}\\\\\\frac{9x+3}{3x+1}&=3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p28-q1-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{x^2-36}{x+6}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x-6$",
          "worked": "$$\\begin{align*}\\frac{x^2-36}{x+6}&=\\frac{(x-6)(x+6)}{x+6}\\\\\\frac{x^2-36}{x+6}&=x-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p28-q1-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{4x^2-81}{2x-9}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2x+9$",
          "worked": "$$\\begin{align*}\\frac{4x^2-81}{2x-9}&=\\frac{(2x-9)(2x+9)}{2x-9}\\\\\\frac{4x^2-81}{2x-9}&=2x+9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p28-q1-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{(x-5)(x+4)}{(x+4)(5-x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1$",
          "worked": "$$\\begin{align*}\\frac{(x-5)(x+4)}{(x+4)(5-x)}&=\\frac{x-5}{5-x}\\\\\\frac{(x-5)(x+4)}{(x+4)(5-x)}&=\\frac{x-5}{-(x-5)}\\\\\\frac{(x-5)(x+4)}{(x+4)(5-x)}&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p28-q1-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{(2x-5)(x+4)}{(x-4)(5-2x)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{x+4}{x-4}$",
          "worked": "Since $5-2x=-(2x-5)$,\n$$\\begin{align*}\\frac{(2x-5)(x+4)}{(x-4)(5-2x)}&=\\frac{(2x-5)(x+4)}{-(x-4)(2x-5)}\\\\\\frac{(2x-5)(x+4)}{(x-4)(5-2x)}&=-\\frac{x+4}{x-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p28-q1-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{(2x-5)(x+4)}{x^2-16}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x-5}{x-4}$",
          "worked": "$$\\begin{align*}\\frac{(2x-5)(x+4)}{x^2-16}&=\\frac{(2x-5)(x+4)}{(x-4)(x+4)}\\\\\\frac{(2x-5)(x+4)}{x^2-16}&=\\frac{2x-5}{x-4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p28-q1-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{(2x-5)(2x+4)}{2(x+4)(2x-5)}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x+2}{x+4}$",
          "worked": "$$\\begin{align*}\\frac{(2x-5)(2x+4)}{2(x+4)(2x-5)}&=\\frac{2x+4}{2(x+4)}\\\\\\frac{(2x-5)(2x+4)}{2(x+4)(2x-5)}&=\\frac{2(x+2)}{2(x+4)}\\\\\\frac{(2x-5)(2x+4)}{2(x+4)(2x-5)}&=\\frac{x+2}{x+4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
