        "children": [],
        "answer": {
          "short": "$\\frac{4x}{5}$",
          "worked": "$$\\begin{align*}\\frac{8x}{10}&=\\frac{2\\times4x}{2\\times5}\\\\\\frac{8x}{10}&=\\frac{4x}{5}\\end{align*}$$",
