      {
        "id": "p19-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{1}{\\sqrt{5}+\\sqrt{2}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{5}-\\sqrt{2}}{3}$",
          "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{5}+\\sqrt{2}}&=\\frac{1}{\\sqrt{5}+\\sqrt{2}}\\times\\frac{\\sqrt{5}-\\sqrt{2}}{\\sqrt{5}-\\sqrt{2}}\\\\\\frac{1}{\\sqrt{5}+\\sqrt{2}}&=\\frac{\\sqrt{5}-\\sqrt{2}}{5-2}\\\\\\frac{1}{\\sqrt{5}+\\sqrt{2}}&=\\frac{\\sqrt{5}-\\sqrt{2}}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p19-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{3-\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3+\\sqrt{7}}{2}$",
          "worked": "$$\\begin{align*}\\frac{1}{3-\\sqrt{7}}&=\\frac{1}{3-\\sqrt{7}}\\times\\frac{3+\\sqrt{7}}{3+\\sqrt{7}}\\\\\\frac{1}{3-\\sqrt{7}}&=\\frac{3+\\sqrt{7}}{9-7}\\\\\\frac{1}{3-\\sqrt{7}}&=\\frac{3+\\sqrt{7}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p19-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{1}{2\\sqrt{6}-\\sqrt{3}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{2\\sqrt{6}+\\sqrt{3}}{21}$",
          "worked": "$$\\begin{align*}\\frac{1}{2\\sqrt{6}-\\sqrt{3}}&=\\frac{1}{2\\sqrt{6}-\\sqrt{3}}\\times\\frac{2\\sqrt{6}+\\sqrt{3}}{2\\sqrt{6}+\\sqrt{3}}\\\\\\frac{1}{2\\sqrt{6}-\\sqrt{3}}&=\\frac{2\\sqrt{6}+\\sqrt{3}}{4\\times6-3}\\\\\\frac{1}{2\\sqrt{6}-\\sqrt{3}}&=\\frac{2\\sqrt{6}+\\sqrt{3}}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p19-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{\\sqrt{3}}{\\sqrt{3}+1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3-\\sqrt{3}}{2}$",
          "worked": "$$\\begin{align*}\\frac{\\sqrt{3}}{\\sqrt{3}+1}&=\\frac{\\sqrt{3}}{\\sqrt{3}+1}\\times\\frac{\\sqrt{3}-1}{\\sqrt{3}-1}\\\\\\frac{\\sqrt{3}}{\\sqrt{3}+1}&=\\frac{3-\\sqrt{3}}{3-1}\\\\\\frac{\\sqrt{3}}{\\sqrt{3}+1}&=\\frac{3-\\sqrt{3}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 39
      },
      {
        "id": "p19-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3}{\\sqrt{11}+\\sqrt{5}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{\\sqrt{11}-\\sqrt{5}}{2}$",
          "worked": "$$\\begin{align*}\\frac{3}{\\sqrt{11}+\\sqrt{5}}&=\\frac{3}{\\sqrt{11}+\\sqrt{5}}\\times\\frac{\\sqrt{11}-\\sqrt{5}}{\\sqrt{11}-\\sqrt{5}}\\\\\\frac{3}{\\sqrt{11}+\\sqrt{5}}&=\\frac{3(\\sqrt{11}-\\sqrt{5})}{11-5}\\\\\\frac{3}{\\sqrt{11}+\\sqrt{5}}&=\\frac{\\sqrt{11}-\\sqrt{5}}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p19-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{3\\sqrt{7}}{2\\sqrt{5}-\\sqrt{7}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{6\\sqrt{35}+21}{13}$",
          "worked": "$$\\begin{align*}\\frac{3\\sqrt{7}}{2\\sqrt{5}-\\sqrt{7}}&=\\frac{3\\sqrt{7}}{2\\sqrt{5}-\\sqrt{7}}\\times\\frac{2\\sqrt{5}+\\sqrt{7}}{2\\sqrt{5}+\\sqrt{7}}\\\\\\frac{3\\sqrt{7}}{2\\sqrt{5}-\\sqrt{7}}&=\\frac{6\\sqrt{35}+21}{4\\times5-7}\\\\\\frac{3\\sqrt{7}}{2\\sqrt{5}-\\sqrt{7}}&=\\frac{6\\sqrt{35}+21}{13}\\end{align*}$$",
          "solutionDiagrams": []
