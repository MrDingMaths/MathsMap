  "content": {
    "id": "p15-q6",
    "type": "question",
    "label": "6",
    "prompt": "Determine the equation of a line with gradient $-4$ that passes through $(3,-10)$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q6-method1",
        "type": "part",
        "label": "",
        "prompt": "Method 1: Substitute into $y-y_1=m(x-x_1)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+2$",
          "worked": "$\\begin{align*}y+10&=-4(x-3)\\\\y+10&=-4x+12\\\\y&=-4x+2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p15-q6-method2",
        "type": "part",
        "label": "",
        "prompt": "Method 2: Substitute into $y=mx+c$ and solve for $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-4x+2$",
          "worked": "$\\begin{align*}-10&=-4(3)+c\\\\c&=2\\\\y&=-4x+2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
  },
