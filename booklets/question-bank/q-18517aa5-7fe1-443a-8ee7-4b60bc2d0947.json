  "content": {
    "id": "p42-q11-root",
    "type": "question",
    "label": "11",
    "prompt": "Find the equations of the tangent and normal to each curve at the point $x=1$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "$y=\\dfrac{3}{4x-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-\\dfrac43x+\\dfrac73$.\n\nNormal: $y=\\dfrac34x+\\dfrac14$.",
          "worked": "$$\\begin{align*}y&=3(4x-1)^{-1}\\\\y'&=-3(4x-1)^{-2}\\times4\\\\y'&=-\\frac{12}{(4x-1)^2}\\\\y(1)&=\\frac{3}{4-1}=1\\\\m_T&=-\\frac{12}{(4-1)^2}=-\\frac43\\\\m_N&=-\\frac{1}{-4/3}=\\frac34\\end{align*}$$\nTangent:\n$$\\begin{align*}y-1&=-\\frac43(x-1)\\\\y&=-\\frac43x+\\frac73\\end{align*}$$\nNormal:\n$$\\begin{align*}y-1&=\\frac34(x-1)\\\\y&=\\frac34x+\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "p42-q11-b",
        "type": "part",
        "label": "b",
        "prompt": "$y=\\dfrac{3}{(x-2)^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Tangent: $y=-9x+6$.\n\nNormal: $y=\\dfrac19x-\\dfrac{28}{9}$.",
          "worked": "$$\\begin{align*}y&=3(x-2)^{-3}\\\\y'&=-9(x-2)^{-4}\\times1\\\\y'&=-\\frac9{(x-2)^4}\\\\y(1)&=\\frac3{(1-2)^3}=-3\\\\m_T&=-\\frac9{(1-2)^4}=-9\\\\m_N&=-\\frac1{-9}=\\frac19\\end{align*}$$\nTangent:\n$$\\begin{align*}y+3&=-9(x-1)\\\\y&=-9x+6\\end{align*}$$\nNormal:\n$$\\begin{align*}y+3&=\\frac19(x-1)\\\\y&=\\frac19x-\\frac{28}{9}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      }
    ]
  },
