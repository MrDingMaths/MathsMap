                  "type": "math",
                  "latex": "\\begin{array}{r:c}6.2&34\\end{array}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": "   34 is greater than 5, so ",
                  "marks": []
                },
                {
                  "type": "math",
                  "latex": "6.234=6.3",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " to 1 decimal place",
