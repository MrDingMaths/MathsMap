              ]
            }
          ]
        },
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Use only the critical digit $3$, not $34$; $6.234\\approx6.2$ to 1 decimal place.",
          "worked": "The critical digit immediately after the cut is $3$. Since $3<5$, keep the tenths digit and remove the digits after the cut.\n$$6.234\\approx6.2\\quad\\text{(1 d.p.)}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p8-q6-b",
        "type": "part",
        "label": "b",
        "prompt": {
          "format": "maths-editor-document-v1",
