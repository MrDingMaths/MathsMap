    "children": [
      {
        "id": "p24-q7a",
        "type": "part",
        "label": "a",
        "prompt": "How many ways can seven identical coins be distributed among four children?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120$",
          "worked": "Represent the coins by 7 identical stars and separate the four children's allocations with $4-1=3$ identical bars. Bars may be adjacent or at either end, allowing children to receive no coins. Choose the three bar positions among the ten positions:\n$$\\binom{10}{3}=120.$$\nThere are 120 ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p24-q7b",
        "type": "part",
        "label": "b",
        "prompt": "How many ways can this be done so that each child receives at least one coin?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$20$",
          "worked": "There are $7-1=6$ gaps between the seven stars. To give each child at least one coin, place the three bars in three distinct gaps:\n$$\\binom{6}{3}=20.$$\nThere are 20 ways.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      }
    ]
  },
