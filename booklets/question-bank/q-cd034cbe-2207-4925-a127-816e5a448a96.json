  "content": {
    "id": "s5-p31-q2-content",
    "type": "question",
    "label": "2",
    "prompt": "A map scale is given as $1\\text{ cm}=100\\text{ m}$. Write this as a simplified ratio.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1:10\\,000$",
      "worked": "Use the same units for image and original.\n$$\\begin{align*}100\\text{ m}&=10\\,000\\text{ cm}\\\\\\text{Image}:\\text{Original}&=1\\text{ cm}:10\\,000\\text{ cm}\\\\&=1:10\\,000\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
