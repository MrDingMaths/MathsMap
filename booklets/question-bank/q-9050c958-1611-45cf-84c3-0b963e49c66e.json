            "inlines": [
              {
                "type": "text",
                "text": "Subtract the probability of five tails from 1.",
                "marks": []
              }
            ]
          }
        ]
      },
      "worked": "The complementary event is getting tails on all five flips.\n$$\\begin{align*}P(\\text{at least one head})&=1-P(\\text{five tails})\\\\P(\\text{at least one head})&=1-\\left(\\frac{1}{2}\\right)^5\\\\P(\\text{at least one head})&=\\frac{31}{32}\\end{align*}$$",
      "solutionDiagrams": []
