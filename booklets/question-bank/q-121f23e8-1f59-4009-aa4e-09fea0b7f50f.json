      {
        "id": "p18-q10-a",
        "type": "part",
        "label": "a",
        "prompt": "What is the mass if $120\\%$ of the mass is $720\\text{ kg}$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$600\\text{ kg}$",
          "worked": "$$\\begin{align*}\\text{Mass for }1\\%&=\\frac{720}{120}=6\\text{ kg}\\\\\\text{Mass for }100\\%&=6\\times100=600\\text{ kg}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p18-q10-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the volume if $175\\%$ of the volume is $120\\text{ L}$? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$68.57\\text{ L}$",
          "worked": "$$\\begin{align*}\\text{Volume for }1\\%&=\\frac{120}{175}=\\frac{24}{35}\\text{ L}\\\\\\text{Volume for }100\\%&=\\frac{24}{35}\\times100=\\frac{480}{7}\\text{ L}\\\\\\text{Volume}&\\approx68.57\\text{ L}\\end{align*}$$\nTo 2 decimal places.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      }
    ]
  },
