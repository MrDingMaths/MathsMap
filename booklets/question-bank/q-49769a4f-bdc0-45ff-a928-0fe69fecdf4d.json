  "content": {
    "id": "p8-q22-root",
    "type": "question",
    "label": "22",
    "prompt": "Prove that $$\\tan^2\\theta=\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}.$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1-\\cos 2\\theta}{1+\\cos 2\\theta}=\\dfrac{2\\sin^2\\theta}{2\\cos^2\\theta}=\\tan^2\\theta$.",
      "worked": "$$\\begin{align*}\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}&=\\frac{1-(1-2\\sin^2\\theta)}{1+(2\\cos^2\\theta-1)}\\\\\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}&=\\frac{2\\sin^2\\theta}{2\\cos^2\\theta}\\\\\\frac{1-\\cos 2\\theta}{1+\\cos 2\\theta}&=\\tan^2\\theta.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
