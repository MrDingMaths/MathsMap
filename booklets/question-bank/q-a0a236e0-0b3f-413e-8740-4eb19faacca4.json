  "content": {
    "id": "v2-ab927-p15-practice-retro-slot-3-225510-root",
    "type": "question",
    "label": null,
    "prompt": "In a class of 32 students, 12 walk to school and 8 catch the bus. The rest are driven.\n\nWrite the ratio of students who are driven to students who walk or catch the bus, in simplest form.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$3:5$",
      "worked": "$$\\begin{align*}\\text{Driven}&=32-12-8\\\\&=12\\\\\\text{Walk or bus}&=12+8\\\\&=20\\end{align*}$$\nThe HCF of 12 and 20 is 4.\n$$\\begin{align*}\\text{Driven}:\\text{walk or bus}&=12:20\\\\&=(12\\div4):(20\\div4)\\\\&=3:5\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
