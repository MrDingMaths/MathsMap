        "answer": {
          "short": "$x=\\frac{15}{2}$",
          "worked": "$x\\ne0$.\n\n$$\\begin{align*}2x&=3\\times5\\\\2x&=15\\\\x&=\\frac{15}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{4}{x}=-\\frac{3}{5}$",
