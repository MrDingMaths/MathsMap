        "children": [],
        "answer": {
          "short": "$x=-\\frac{20}{3}$",
          "worked": "$x\\ne0$.\n\n$$\\begin{align*}-3x&=4\\times5\\\\-3x&=20\\\\x&=-\\frac{20}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{x+1}{2}=\\frac{2}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{3}$",
          "worked": "$$\\begin{align*}3(x+1)&=2\\times2\\\\3x+3&=4\\\\3x&=1\\\\x&=\\frac{1}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{x-2}{5}=\\frac{3}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{19}{2}$",
          "worked": "$$\\begin{align*}2(x-2)&=5\\times3\\\\2x-4&=15\\\\2x&=19\\\\x&=\\frac{19}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-i",
        "type": "part",
        "label": "i",
        "prompt": "$\\frac{x+3}{3}=-\\frac{5}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{27}{4}$",
          "worked": "$$\\begin{align*}4(x+3)&=3(-5)\\\\4x+12&=-15\\\\4x&=-27\\\\x&=-\\frac{27}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-j",
        "type": "part",
        "label": "j",
        "prompt": "$\\frac{x+2}{2}=\\frac{x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-6$",
          "worked": "$$\\begin{align*}3(x+2)&=2x\\\\3x+6&=2x\\\\x+6&=0\\\\x&=-6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-k",
        "type": "part",
        "label": "k",
        "prompt": "$\\frac{x-3}{5}=\\frac{x+2}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{16}{3}$\n\nCross multiply, expand and collect the $x$ terms.",
          "worked": "$$\\begin{align*}2(x-3)&=5(x+2)\\\\2x-6&=5x+10\\\\-6&=3x+10\\\\3x&=-16\\\\x&=-\\frac{16}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p7-q13-l",
        "type": "part",
        "label": "l",
        "prompt": "$\\frac{x+1}{3}=-\\frac{x+1}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-1$",
          "worked": "$$\\begin{align*}4(x+1)&=-3(x+1)\\\\4x+4&=-3x-3\\\\7x&=-7\\\\x&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p7-q13-m",
        "type": "part",
        "label": "m",
        "prompt": "$\\frac{1}{x+2}=\\frac{3}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$\n\nCross multiply and collect the $x$ terms.",
          "worked": "$x\\ne-2,0$.\n\n$$\\begin{align*}x&=3(x+2)\\\\x&=3x+6\\\\2x&=-6\\\\x&=-3\\end{align*}$$\n\nThis value is allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q13-n",
        "type": "part",
        "label": "n",
        "prompt": "$\\frac{2}{x-3}=\\frac{3}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=13$\n\nCross multiply, expand and collect the $x$ terms.",
          "worked": "$x\\ne3,-2$.\n\n$$\\begin{align*}2(x+2)&=3(x-3)\\\\2x+4&=3x-9\\\\x-9&=4\\\\x&=13\\end{align*}$$\n\nThis value is allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q13-o",
        "type": "part",
        "label": "o",
        "prompt": "$\\frac{3}{x+1}=-\\frac{1}{x+2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac{7}{4}$\n\nCross multiply, expand and collect the $x$ terms.",
          "worked": "$x\\ne-1,-2$.\n\n$$\\begin{align*}3(x+2)&=-(x+1)\\\\3x+6&=-x-1\\\\4x&=-7\\\\x&=-\\frac{7}{4}\\end{align*}$$\n\nThis value is allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q13-p",
        "type": "part",
        "label": "p",
        "prompt": "$\\frac{x+1}{x+2}=\\frac{3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2$\n\nCross multiply, expand and collect the $x$ terms.",
          "worked": "$x\\ne-2$.\n\n$$\\begin{align*}4(x+1)&=3(x+2)\\\\4x+4&=3x+6\\\\x+4&=6\\\\x&=2\\end{align*}$$\n\nThis value is allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q13-q",
        "type": "part",
        "label": "q",
        "prompt": "$\\frac{x-2}{x+3}=-\\frac{1}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{1}{3}$\n\nCross multiply, expand and collect the $x$ terms.",
          "worked": "$x\\ne-3$.\n\n$$\\begin{align*}2(x-2)&=-(x+3)\\\\2x-4&=-x-3\\\\3x&=1\\\\x&=\\frac{1}{3}\\end{align*}$$\n\nThis value is allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p7-q13-r",
        "type": "part",
        "label": "r",
        "prompt": "$\\frac{2-x}{2+x}=\\frac{3}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac{2}{7}$\n\nCross multiply, expand and collect the $x$ terms.",
          "worked": "$x\\ne-2$.\n\n$$\\begin{align*}4(2-x)&=3(2+x)\\\\8-4x&=6+3x\\\\8&=6+7x\\\\7x&=2\\\\x&=\\frac{2}{7}\\end{align*}$$\n\nThis value is allowed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
