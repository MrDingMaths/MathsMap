  "content": {
    "id": "p6-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Rearrange these formulae to make $t$ the subject.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p6-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$p=3t+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{p-7}{3}$ or $\\frac{p}{3}-\\frac{7}{3}$",
          "worked": "$$\\begin{align*}p-7&=3t\\\\\\frac{p-7}{3}&=t\\\\t&=\\frac{p-7}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p6-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$p=3t-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{p+7}{3}$ or $\\frac{p}{3}+\\frac{7}{3}$",
          "worked": "$$\\begin{align*}p+7&=3t\\\\\\frac{p+7}{3}&=t\\\\t&=\\frac{p+7}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p6-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$p=3t+a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{p-a}{3}$ or $\\frac{p}{3}-\\frac{a}{3}$",
          "worked": "$$\\begin{align*}p-a&=3t\\\\\\frac{p-a}{3}&=t\\\\t&=\\frac{p-a}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p6-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$p=3t-a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{p+a}{3}$ or $\\frac{p}{3}+\\frac{a}{3}$",
          "worked": "$$\\begin{align*}p+a&=3t\\\\\\frac{p+a}{3}&=t\\\\t&=\\frac{p+a}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      },
      {
        "id": "p6-q2-e",
        "type": "part",
        "label": "e",
        "prompt": "$p=\\frac{t}{2}+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2(p-7)$ or $2p-14$",
          "worked": "$$\\begin{align*}p-7&=\\frac{t}{2}\\\\2(p-7)&=t\\\\t&=2(p-7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-f",
        "type": "part",
        "label": "f",
        "prompt": "$p=\\frac{t}{2}-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2(p+7)$ or $2p+14$",
          "worked": "$$\\begin{align*}p+7&=\\frac{t}{2}\\\\2(p+7)&=t\\\\t&=2(p+7)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-g",
        "type": "part",
        "label": "g",
        "prompt": "$p=\\frac{t}{2}+a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2(p-a)$ or $2p-2a$",
          "worked": "$$\\begin{align*}p-a&=\\frac{t}{2}\\\\2(p-a)&=t\\\\t&=2(p-a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p6-q2-h",
        "type": "part",
        "label": "h",
        "prompt": "$p=\\frac{t}{2}-a$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=2(p+a)$ or $2p+2a$",
          "worked": "$$\\begin{align*}p+a&=\\frac{t}{2}\\\\2(p+a)&=t\\\\t&=2(p+a)\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      }
    ]
  },
