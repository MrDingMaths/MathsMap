  "content": {
    "id": "p5-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Simplify the following:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p5-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\dfrac{x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1$",
          "worked": "$\\begin{align*}\\frac{x}{x}&=\\frac{x\\div x}{x\\div x}\\\\&=1\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q2-e",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{2x}{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$2$",
          "worked": "$\\begin{align*}\\frac{2x}{x}&=\\frac{2x\\div x}{x\\div x}\\\\&=2\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q2-j",
        "type": "part",
        "label": "c",
        "prompt": "$\\dfrac{x}{2x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{2}$",
          "worked": "$\\begin{align*}\\frac{x}{2x}&=\\frac{x\\div x}{2x\\div x}\\\\&=\\frac{1}{2}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q2-b",
        "type": "part",
        "label": "d",
        "prompt": "$\\dfrac{a}{a^2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{a}$",
          "worked": "$\\begin{align*}\\frac{a}{a^2}&=\\frac{a\\div a}{a^2\\div a}\\\\&=\\frac{1}{a}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p5-q2-f",
        "type": "part",
        "label": "e",
        "prompt": "$\\dfrac{3x^2}{9xy}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{x}{3y}$",
          "worked": "$\\begin{align*}\\frac{3x^2}{9xy}&=\\frac{3x^2\\div x}{9xy\\div x}\\\\&=\\frac{3x\\div3}{9y\\div3}\\\\&=\\frac{x}{3y}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p5-q2-k",
        "type": "part",
        "label": "f",
        "prompt": "$\\dfrac{12ab}{4a^2b}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{3}{a}$",
          "worked": "$\\begin{align*}\\frac{12ab}{4a^2b}&=\\frac{12ab\\div(ab)}{4a^2b\\div(ab)}\\\\&=\\frac{12\\div4}{4a\\div4}\\\\&=\\frac{3}{a}\\end{align*}$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
  },
