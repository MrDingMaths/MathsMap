  "content": {
    "id": "v2-8424b-p43-practice-slot-10-root",
    "type": "question",
    "label": null,
    "prompt": "The mean of a binomial distribution is $27$.\nIf there are $40$ trials, find the probability of success as a percentage.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$67.5\\%$",
      "worked": "Using $E(X)=np$:\n$$\\begin{aligned}40p&=27\\\\p&=\\frac{27}{40}\\\\p&=0.675=67.5\\%\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
