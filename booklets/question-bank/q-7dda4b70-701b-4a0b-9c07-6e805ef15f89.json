            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}FV&=\\frac{a(R^n-1)}{R-1}\\\\FV&=\\frac{500(1.065^5-1)}{1.065-1}\\\\FV&\\approx\\$2846.82\\end{aligned}",
