  "content": {
    "id": "p25-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Jacqueline puts aside $\\$500$ at the end of each year for 5 years.\nIf the money is invested at 6.5% p.a., how much will she have at the end of the 5 years? Give your answer to the nearest cent.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\$2846.82$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p25-q2-answer-year1",
            "type": "paragraph",
