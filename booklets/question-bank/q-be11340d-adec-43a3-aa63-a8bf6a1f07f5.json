  "content": {
    "id": "p19-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Alice and Ben both belong to a group of 10 students. Suppose 5 students are to be chosen, however, no selection is to include both Alice and Ben. How many ways can this be done?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$196$",
      "worked": "There are $\\binom{10}{5}$ unrestricted selections. Selections containing both Alice and Ben require choosing the remaining 3 students from the other 8.\n$$\\begin{align*}N&=\\binom{10}{5}-\\binom{8}{3}\\\\N&=252-56\\\\N&=196.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 29
  },
