  "content": {
    "id": "p7-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Evaluate each expression for $x=12$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}\\frac{3x}{4}&=\\frac{3\\times12}{4}\\\\\\frac{3x}{4}&=3\\times3\\\\\\frac{3x}{4}&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{3x}{4}-9$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0$",
          "worked": "$$\\begin{align*}\\frac{3x}{4}-9&=\\frac{3\\times12}{4}-9\\\\\\frac{3x}{4}-9&=9-9\\\\\\frac{3x}{4}-9&=0\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p7-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{3(x+2)}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$",
          "worked": "$$\\begin{align*}\\frac{3(x+2)}{7}&=\\frac{3(12+2)}{7}\\\\\\frac{3(x+2)}{7}&=\\frac{3\\times14}{7}\\\\\\frac{3(x+2)}{7}&=3\\times2\\\\\\frac{3(x+2)}{7}&=6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      }
    ]
