  "content": {
    "id": "v2-1479f-p27-practice-slot-6-root",
    "type": "question",
    "label": null,
    "prompt": "Find the equation of a circle with diameter $RS$, where $R(-4,6)$ and $S(10,-2)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$(x-3)^2+(y-2)^2=65$",
      "worked": "The centre is the midpoint of the diameter.\n$$\\begin{align*}\\text{Centre}&=\\left(\\frac{-4+10}{2},\\frac{6+(-2)}{2}\\right)\\\\&=(3,2).\\end{align*}$$\nUsing the distance from the centre to $S$:\n$$\\begin{align*}r^2&=(10-3)^2+(-2-2)^2\\\\&=49+16\\\\&=65.\\end{align*}$$\nHence the equation is $(x-3)^2+(y-2)^2=65$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
