      {
        "id": "p31-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "Show that the gradient of the tangent at the point of inflection is $-75$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y'(-1)=3(-1)^2+6(-1)-72=-75$.",
          "worked": "At $x=-1$:\n$$\\begin{align*}y'&=3(-1)^2+6(-1)-72\\\\y'&=-75\\end{align*}$$\nThe gradient of the tangent is $-75$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p31-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence find the equation of the tangent at the point of inflection.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-75x+13$.",
          "worked": "Using $y-y_1=m(x-x_1)$:\n$$\\begin{align*}y-88&=-75\\bigl(x-(-1)\\bigr)\\\\y-88&=-75x-75\\\\y&=-75x+13\\end{align*}$$",
          "solutionDiagrams": []
