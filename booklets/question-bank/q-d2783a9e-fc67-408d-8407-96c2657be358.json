  "content": {
    "id": "p17-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "A function has $f'(1)=3$ and $f(1)=5$. Evaluate $f(-2)$ given $f''(x)=6x+18$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$f(-2)=77$",
      "worked": {
        "format": "maths-editor-document-v1",
        "version": 1,
        "blocks": [
          {
            "id": "p17-q16-answer-first-primitive",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 0,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}f''(x)&=6x+18\\\\f'(x)&=3x^2+18x+C_1\\\\f'(1)&=3\\\\3&=3+18+C_1\\\\C_1&=-18\\\\f'(x)&=3x^2+18x-18\\end{aligned}",
                "display": true
              }
            ]
          },
          {
            "id": "p17-q16-answer-second-primitive",
            "type": "paragraph",
            "fontSize": null,
            "align": "right",
            "spaceBefore": 4,
            "spaceAfter": 2,
            "lineHeight": 1.4,
            "indent": 0,
            "inlines": [
              {
                "type": "math",
                "latex": "\\begin{aligned}f(x)&=x^3+9x^2-18x+C_2\\\\f(1)&=5\\\\5&=1+9-18+C_2\\\\C_2&=13\\\\f(x)&=x^3+9x^2-18x+13\\\\f(-2)&=-8+36+36+13\\\\f(-2)&=77\\end{aligned}",
                "display": true
              }
            ]
          }
        ]
      },
