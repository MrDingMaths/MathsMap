      {
        "id": "p66-q13-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $(2n+1)^2-(2n-1)^2=8n$ for all integers $n$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$$(2n+1)^2-(2n-1)^2=(4n)(2)=8n.$$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p66-q13-a-proof",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}(2n+1)^2-(2n-1)^2&=[(2n+1)+(2n-1)][(2n+1)-(2n-1)]\\\\(2n+1)^2-(2n-1)^2&=(4n)(2)\\\\(2n+1)^2-(2n-1)^2&=8n\\end{aligned}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p66-q13-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence show that the difference of the squares of any two consecutive odd integers is always divisible by 8.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Consecutive odd integers can be written as $2n-1$ and $2n+1$. Their squares differ by $8n$, a multiple of 8.",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p66-q13-b-representation",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Any two consecutive odd integers can be written as ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2n-1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " and ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "2n+1",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": " for an integer ",
                    "marks": [],
                    "colour": "#268cff"
                  },
                  {
                    "type": "math",
                    "latex": "n",
                    "display": false,
                    "colour": "#268cff"
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": [],
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p66-q13-b-explanation",
                "type": "paragraph",
                "fontSize": null,
