  "content": {
    "id": "p12-q7-root",
    "type": "question",
    "label": "7",
    "prompt": "Substitute $m=-4\\frac16$, $n=5\\frac13$ and $p=-1\\frac12$ to evaluate.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p12-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "$m+n$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac16$",
          "worked": "$$\\begin{align*}m+n&=-4\\frac16+5\\frac13\\\\m+n&=-4-\\frac16+5+\\frac26\\\\m+n&=1+\\frac16\\\\m+n&=1\\frac16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "$m+p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-5\\frac23$",
          "worked": "$$\\begin{align*}m+p&=-4\\frac16+\\left(-1\\frac12\\right)\\\\m+p&=-4-\\frac16-1-\\frac36\\\\m+p&=-5-\\frac46\\\\m+p&=-5\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "$m-p$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2\\frac23$",
          "worked": "$$\\begin{align*}m-p&=-4\\frac16-\\left(-1\\frac12\\right)\\\\m-p&=-4\\frac16+1\\frac12\\\\m-p&=-4-\\frac16+1+\\frac36\\\\m-p&=-2\\frac23\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "$mp$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6\\frac14$",
          "worked": "$$\\begin{align*}mp&=\\left(-4\\frac16\\right)\\times\\left(-1\\frac12\\right)\\\\mp&=\\frac{25}{6}\\times\\frac32\\\\mp&=\\frac{25}{4}\\\\mp&=6\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-e",
        "type": "part",
        "label": "e",
        "prompt": "$np$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-8$",
          "worked": "$$\\begin{align*}np&=5\\frac13\\times\\left(-1\\frac12\\right)\\\\np&=-\\left(\\frac{16}{3}\\times\\frac32\\right)\\\\np&=-8\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p12-q7-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{p}{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac9{25}$",
          "worked": "$$\\begin{align*}\\frac{p}{m}&=\\left(-1\\frac12\\right)\\div\\left(-4\\frac16\\right)\\\\\\frac{p}{m}&=\\frac32\\div\\frac{25}{6}\\\\\\frac{p}{m}&=\\frac32\\times\\frac6{25}\\\\\\frac{p}{m}&=\\frac9{25}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "p12-q7-g",
        "type": "part",
        "label": "g",
        "prompt": "$mnp$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$33\\frac13$",
          "worked": "$$\\begin{align*}mnp&=\\left(-4\\frac16\\right)\\times5\\frac13\\times\\left(-1\\frac12\\right)\\\\mnp&=\\frac{25}{6}\\times\\frac{16}{3}\\times\\frac32\\\\mnp&=\\frac{100}{3}\\\\mnp&=33\\frac13\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p12-q7-h",
        "type": "part",
        "label": "h",
        "prompt": "$\\frac{p}{n}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac9{32}$",
          "worked": "$$\\begin{align*}\\frac{p}{n}&=\\left(-1\\frac12\\right)\\div5\\frac13\\\\\\frac{p}{n}&=-\\left(\\frac32\\div\\frac{16}{3}\\right)\\\\\\frac{p}{n}&=-\\left(\\frac32\\times\\frac3{16}\\right)\\\\\\frac{p}{n}&=-\\frac9{32}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      }
    ]
