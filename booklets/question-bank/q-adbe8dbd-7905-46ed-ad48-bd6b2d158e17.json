    "children": [
      {
        "id": "p20-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\frac{1}{x}+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1+\\sqrt{2}$ or $x=1-\\sqrt{2}$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}x^2&=1+2x\\\\x^2-2x&=1\\\\x^2-2x+1&=2\\\\(x-1)^2&=2\\\\x-1&=\\pm\\sqrt{2}\\\\x&=1\\pm\\sqrt{2}\\end{align*}$$\nBoth values satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p20-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4x-1}{x}=x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2+\\sqrt{3}$ or $x=2-\\sqrt{3}$.",
          "worked": "For $x\\ne0$,\n$$\\begin{align*}4x-1&=x^2\\\\x^2-4x&=-1\\\\x^2-4x+4&=3\\\\(x-2)^2&=3\\\\x-2&=\\pm\\sqrt{3}\\\\x&=2\\pm\\sqrt{3}\\end{align*}$$\nBoth values satisfy $x\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p20-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "$a=\\frac{a+4}{a-1}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=1+\\sqrt{5}$ or $a=1-\\sqrt{5}$.",
          "worked": "For $a\\ne1$,\n$$\\begin{align*}a(a-1)&=a+4\\\\a^2-a&=a+4\\\\a^2-2a&=4\\\\a^2-2a+1&=5\\\\(a-1)^2&=5\\\\a-1&=\\pm\\sqrt{5}\\\\a&=1\\pm\\sqrt{5}\\end{align*}$$\nBoth values satisfy $a\\ne1$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p20-q8-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{5m}{2}=2+\\frac{1}{m}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=\\frac{2+\\sqrt{14}}{5}$ or $m=\\frac{2-\\sqrt{14}}{5}$.",
          "worked": "For $m\\ne0$,\n$$\\begin{align*}5m^2&=4m+2\\\\m^2-\\frac45m&=\\frac25\\\\m^2-\\frac45m+\\frac4{25}&=\\frac{14}{25}\\\\\\left(m-\\frac25\\right)^2&=\\frac{14}{25}\\\\m-\\frac25&=\\pm\\frac{\\sqrt{14}}5\\\\m&=\\frac{2\\pm\\sqrt{14}}5\\end{align*}$$\nBoth values satisfy $m\\ne0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      }
    ]
  },
