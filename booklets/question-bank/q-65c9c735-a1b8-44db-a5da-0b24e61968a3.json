  "content": {
    "id": "p35-q16-root",
    "type": "question",
    "label": "16",
    "prompt": "The probability that a set of traffic lights will be green when you arrive at them is 0.6.\nA motorist drives through two sets of lights. Assuming that the two sets of traffic lights are independent of each other, find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q16-a",
        "type": "part",
        "label": "a",
        "prompt": "both sets of lights will be green,",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{9}{25}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q16-a-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{both green})&=\\frac{3}{5}\\times\\frac{3}{5}\\\\P(\\text{both green})&=\\frac{9}{25}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p35-q16-b",
        "type": "part",
        "label": "b",
        "prompt": "at least one set of lights will be green.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{21}{25}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p35-q16-b-answer",
                "type": "paragraph",
                "fontSize": null,
                "align": "right",
                "spaceBefore": 0,
                "spaceAfter": 2,
                "lineHeight": 1.4,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}P(\\text{at least one green})&=1-P(\\text{both not green})\\\\P(\\text{at least one green})&=1-\\frac{2}{5}\\times\\frac{2}{5}\\\\P(\\text{at least one green})&=1-\\frac{4}{25}\\\\P(\\text{at least one green})&=\\frac{21}{25}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      }
    ]
  },
