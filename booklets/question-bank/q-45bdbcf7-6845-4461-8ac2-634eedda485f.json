  "content": {
    "id": "p31-q3",
    "type": "question",
    "label": "3",
    "prompt": "Consider the expression $\\tan\\left(\\sin^{-1}\\left(\\frac{12}{13}\\right)-\\cos^{-1}\\left(\\frac45\\right)\\right)$.\n\nLet $A=\\sin^{-1}\\left(\\frac{12}{13}\\right)$ and $B=\\cos^{-1}\\left(\\frac45\\right)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p31-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the compound angle rule to write the expression in terms of $A$ and $B$ and expand.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan(A-B)=\\frac{\\tan A-\\tan B}{1+\\tan A\\tan B}$",
          "worked": "$$\\begin{align*}\\tan\\left(\\sin^{-1}\\left(\\frac{12}{13}\\right)-\\cos^{-1}\\left(\\frac45\\right)\\right)&=\\tan(A-B)\\\\&=\\frac{\\tan A-\\tan B}{1+\\tan A\\tan B}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p31-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "By drawing appropriate triangles, find $\\tan A$ and $\\tan B$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\tan A=\\frac{12}{5},\\quad \\tan B=\\frac34$",
          "worked": "Both $A$ and $B$ are acute. The triangles have side lengths $5,12,13$ and $3,4,5$, respectively.\n\n$$\\tan A=\\frac{12}{5},\\qquad \\tan B=\\frac34.$$",
          "solutionDiagrams": [
            {
              "id": "p31-q3-b-solution-triangles",
              "role": "solution",
              "format": "tikz",
              "code": "\\begin{tikzpicture}[x=1cm,y=1cm,every node/.style={font=\\fontsize{10}{12}\\selectfont},line width=0.5pt]\n\\draw (0,0)--(3,0)--(3,2.4)--cycle;\n\\draw (2.78,0)--(2.78,0.22)--(3,0.22);\n\\node[below] at (1.5,0) {$5$};\n\\node[right] at (3,1.2) {$12$};\n\\node[above left] at (1.5,1.2) {$13$};\n\\node at (1.05,0.38) {$A$};\n\\draw (5,0)--(8,0)--(8,2.25)--cycle;\n\\draw (7.78,0)--(7.78,0.22)--(8,0.22);\n\\node[below] at (6.5,0) {$4$};\n\\node[right] at (8,1.125) {$3$};\n\\node[above left] at (6.5,1.125) {$5$};\n\\node at (6.1,0.38) {$B$};\n\\end{tikzpicture}",
              "src": null,
              "widthMm": 115,
              "alt": "Mathematical diagram",
              "overlayOf": null,
              "transparent": false,
              "axes": null,
              "spec": {
