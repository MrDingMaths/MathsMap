      },
      {
        "id": "p31-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "Use your values from b to find the exact value of $\\tan\\left(\\sin^{-1}\\left(\\frac{12}{13}\\right)-\\cos^{-1}\\left(\\frac45\\right)\\right)$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{33}{56}$",
          "worked": "$$\\begin{align*}\\tan\\left(\\sin^{-1}\\left(\\frac{12}{13}\\right)-\\cos^{-1}\\left(\\frac45\\right)\\right)&=\\frac{\\tan A-\\tan B}{1+\\tan A\\tan B}\\\\&=\\frac{\\frac{12}{5}-\\frac34}{1+\\frac{12}{5}\\times\\frac34}\\\\&=\\frac{\\frac{33}{20}}{\\frac{14}{5}}\\\\&=\\frac{33}{56}.\\end{align*}$$",
