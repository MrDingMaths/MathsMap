  "content": {
    "id": "p21-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve each of the following for $(x,y)$ using the substitution method.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$$\\begin{aligned}y+2x&=5\\\\y&=3x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,3)$",
          "worked": "$$\\begin{align*}3x+2x&=5\\\\5x&=5\\\\x&=1\\\\y&=3(1)\\\\y&=3\\end{align*}$$\nThus $(x,y)=(1,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$$\\begin{aligned}x+2y&=2\\\\x&=2y\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(1,\\frac12\\right)$",
          "worked": "$$\\begin{align*}2y+2y&=2\\\\4y&=2\\\\y&=\\frac12\\\\x&=2\\left(\\frac12\\right)\\\\x&=1\\end{align*}$$\nThus $(x,y)=\\left(1,\\frac12\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 54
      },
      {
        "id": "p21-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$$\\begin{aligned}x+y&=5\\\\y&=x+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,4)$",
          "worked": "$$\\begin{align*}x+(x+3)&=5\\\\2x+3&=5\\\\2x&=2\\\\x&=1\\\\y&=1+3\\\\y&=4\\end{align*}$$\nThus $(x,y)=(1,4)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p21-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$$\\begin{aligned}x+y&=4\\\\x&=y-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,\\frac72\\right)$",
          "worked": "$$\\begin{align*}(y-3)+y&=4\\\\2y-3&=4\\\\2y&=7\\\\y&=\\frac72\\\\x&=\\frac72-3\\\\x&=\\frac12\\end{align*}$$\nThus $(x,y)=\\left(\\frac12,\\frac72\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p21-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$$\\begin{aligned}y+2x&=3\\\\y&=2x-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,1)$",
          "worked": "$$\\begin{align*}(2x-1)+2x&=3\\\\4x-1&=3\\\\4x&=4\\\\x&=1\\\\y&=2(1)-1\\\\y&=1\\end{align*}$$\nThus $(x,y)=(1,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p21-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$$\\begin{aligned}y+x&=-1\\\\y&=-3x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,-\\frac32\\right)$",
          "worked": "$$\\begin{align*}-3x+x&=-1\\\\-2x&=-1\\\\x&=\\frac12\\\\y&=-3\\left(\\frac12\\right)\\\\y&=-\\frac32\\end{align*}$$\nThus $(x,y)=\\left(\\frac12,-\\frac32\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$$\\begin{aligned}2x+4y&=20\\\\x&=3y\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(6,2)$",
          "worked": "$$\\begin{align*}2(3y)+4y&=20\\\\6y+4y&=20\\\\10y&=20\\\\y&=2\\\\x&=3(2)\\\\x&=6\\end{align*}$$\nThus $(x,y)=(6,2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p21-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$$\\begin{aligned}2x-y&=1\\\\x&=-3y\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac37,-\\frac17\\right)$",
          "worked": "$$\\begin{align*}2(-3y)-y&=1\\\\-6y-y&=1\\\\-7y&=1\\\\y&=-\\frac17\\\\x&=-3\\left(-\\frac17\\right)\\\\x&=\\frac37\\end{align*}$$\nThus $(x,y)=\\left(\\frac37,-\\frac17\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 64
      },
      {
        "id": "p21-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$$\\begin{aligned}2y+x&=5\\\\x&=4y-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(3,1)$",
          "worked": "$$\\begin{align*}2y+(4y-1)&=5\\\\6y-1&=5\\\\6y&=6\\\\y&=1\\\\x&=4(1)-1\\\\x&=3\\end{align*}$$\nThus $(x,y)=(3,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p21-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$$\\begin{aligned}2y+3x&=12\\\\y&=x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(2,3)$",
          "worked": "$$\\begin{align*}2(x+1)+3x&=12\\\\2x+2+3x&=12\\\\5x+2&=12\\\\5x&=10\\\\x&=2\\\\y&=2+1\\\\y&=3\\end{align*}$$\nThus $(x,y)=(2,3)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p21-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$$\\begin{aligned}2x-3y&=7\\\\x&=2y+3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(5,1)$",
          "worked": "$$\\begin{align*}2(2y+3)-3y&=7\\\\4y+6-3y&=7\\\\y+6&=7\\\\y&=1\\\\x&=2(1)+3\\\\x&=5\\end{align*}$$\nThus $(x,y)=(5,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p21-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$$\\begin{aligned}4y-5x&=-9\\\\y&=2x-3\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(1,-1)$",
          "worked": "$$\\begin{align*}4(2x-3)-5x&=-9\\\\8x-12-5x&=-9\\\\3x-12&=-9\\\\3x&=3\\\\x&=1\\\\y&=2(1)-3\\\\y&=-1\\end{align*}$$\nThus $(x,y)=(1,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p21-q5-m",
        "type": "part",
        "label": "m",
        "prompt": "$$\\begin{aligned}3x-3y&=1\\\\y&=3x-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac13,0\\right)$",
          "worked": "$$\\begin{align*}3x-3(3x-1)&=1\\\\3x-9x+3&=1\\\\-6x+3&=1\\\\-6x&=-2\\\\x&=\\frac13\\\\y&=3\\left(\\frac13\\right)-1\\\\y&=0\\end{align*}$$\nThus $(x,y)=\\left(\\frac13,0\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p21-q5-n",
        "type": "part",
        "label": "n",
        "prompt": "$$\\begin{aligned}y-2x&=-11\\\\x&=3-2y\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(5,-1)$",
          "worked": "$$\\begin{align*}y-2(3-2y)&=-11\\\\y-6+4y&=-11\\\\5y-6&=-11\\\\5y&=-5\\\\y&=-1\\\\x&=3-2(-1)\\\\x&=5\\end{align*}$$\nThus $(x,y)=(5,-1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p21-q5-o",
        "type": "part",
        "label": "o",
        "prompt": "$$\\begin{aligned}4x-3y&=-16\\\\y&=7-2x\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac12,6\\right)$",
          "worked": "$$\\begin{align*}4x-3(7-2x)&=-16\\\\4x-21+6x&=-16\\\\10x-21&=-16\\\\10x&=5\\\\x&=\\frac12\\\\y&=7-2\\left(\\frac12\\right)\\\\y&=6\\end{align*}$$\nThus $(x,y)=\\left(\\frac12,6\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 70
      },
      {
        "id": "p21-q5-p",
        "type": "part",
        "label": "p",
        "prompt": "$$\\begin{aligned}y+\\frac{x}{2}&=1\\\\y&=\\frac{x}{2}+2\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(-1,\\frac32\\right)$",
          "worked": "$$\\begin{align*}\\left(\\frac{x}{2}+2\\right)+\\frac{x}{2}&=1\\\\x+2&=1\\\\x&=-1\\\\y&=\\frac{-1}{2}+2\\\\y&=\\frac32\\end{align*}$$\nThus $(x,y)=\\left(-1,\\frac32\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 56
      },
      {
        "id": "p21-q5-q",
        "type": "part",
        "label": "q",
        "prompt": "$$\\begin{aligned}2y+\\frac{x}{4}&=3\\\\y&=\\frac{x}{2}-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(4,1)$",
          "worked": "$$\\begin{align*}2\\left(\\frac{x}{2}-1\\right)+\\frac{x}{4}&=3\\\\x-2+\\frac{x}{4}&=3\\\\4x-8+x&=12\\\\5x-8&=12\\\\5x&=20\\\\x&=4\\\\y&=\\frac42-1\\\\y&=1\\end{align*}$$\nThus $(x,y)=(4,1)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 78
      },
      {
        "id": "p21-q5-r",
        "type": "part",
        "label": "r",
        "prompt": "$$\\begin{aligned}\\frac{y}{2}+\\frac{x}{4}&=1\\\\y&=x+1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=\\left(\\frac23,\\frac53\\right)$",
          "worked": "$$\\begin{align*}\\frac{x+1}{2}+\\frac{x}{4}&=1\\\\2(x+1)+x&=4\\\\2x+2+x&=4\\\\3x+2&=4\\\\3x&=2\\\\x&=\\frac23\\\\y&=\\frac23+1\\\\y&=\\frac53\\end{align*}$$\nThus $(x,y)=\\left(\\frac23,\\frac53\\right)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 80
      },
      {
        "id": "p21-q5-s",
        "type": "part",
        "label": "s",
        "prompt": "$$\\begin{aligned}\\frac{y}{2}-\\frac{2x}{3}&=1\\\\x&=y-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(-3,-2)$",
          "worked": "$$\\begin{align*}\\frac{y}{2}-\\frac{2(y-1)}{3}&=1\\\\3y-4(y-1)&=6\\\\3y-4y+4&=6\\\\-y+4&=6\\\\y&=-2\\\\x&=-2-1\\\\x&=-3\\end{align*}$$\nThus $(x,y)=(-3,-2)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 68
      },
      {
        "id": "p21-q5-t",
        "type": "part",
        "label": "t",
        "prompt": "$$\\begin{aligned}y+0.2x&=2\\\\y&=0.3x-1\\end{aligned}$$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$(x,y)=(6,0.8)$",
          "worked": "$$\\begin{align*}(0.3x-1)+0.2x&=2\\\\0.5x-1&=2\\\\0.5x&=3\\\\x&=6\\\\y&=0.3(6)-1\\\\y&=0.8\\end{align*}$$\nThus $(x,y)=(6,0.8)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      }
    ]
