  "content": {
    "id": "p43-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "The mean of a binomial distribution is $12.6$ and the probability of success is $\\dfrac{1}{5}$.\nFind the number of trials.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$63$ trials",
      "worked": "Using $E(X)=np$:\n$$\\begin{aligned}\\frac{n}{5}&=12.6\\\\n&=\\frac{12.6}{1/5}\\\\n&=63\\end{aligned}$$",
      "solutionDiagrams": []
