    "id": "v2-de45f-p12-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "Points $A, B$ and $C$ lie on a straight line, with B between A and C.\nPoint $A$ has coordinates $(-1,6)$\nPoint $C$ has coordinates $(7,-2)$\nPoint $B$ is such that $AB:BC=3:5$.\nWork out the length of line segment $AB$. Give your answer to 1 decimal place.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4.2$ units. Find $AC$ using the distance formula, then use $AB=\\frac{3}{8}AC$.",
      "worked": "$$\\begin{align*}AC^2&=(7-(-1))^2+(-2-6)^2\\\\AC^2&=128\\\\AC&=\\sqrt{128}\\end{align*}$$\n$$\\begin{align*}AB&=\\frac{3}{3+5}AC\\\\AB&=\\frac{3}{8}\\sqrt{128}\\\\AB&\\approx4.2\\text{ units}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
