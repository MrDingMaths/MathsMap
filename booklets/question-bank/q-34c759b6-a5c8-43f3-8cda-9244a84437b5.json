  "content": {
    "id": "p54-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Consider the graph of $y=\\frac{1}{x}$. Find the equation of the final graph if $y=\\frac{1}{x}$ is",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p54-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "translated left by 2 units, then dilated horizontally by a factor of $\\frac{1}{3}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{3x+2}$",
          "worked": "Translate left: replace $x$ by $x+2$.\n$$y=\\frac{1}{x+2}$$\nDilate horizontally by a factor of $\\frac{1}{3}$: replace $x$ by $3x$.\n$$y=\\frac{1}{3x+2}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p54-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "dilated horizontally by a factor of $\\frac{1}{3}$, then translated left by 2 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{1}{3x+6}$",
          "worked": "Dilate horizontally by a factor of $\\frac{1}{3}$: replace $x$ by $3x$.\n$$y=\\frac{1}{3x}$$\nTranslate left: replace $x$ by $x+2$.\n$$\\begin{align*}y&=\\frac{1}{3(x+2)}\\\\y&=\\frac{1}{3x+6}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p54-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "translated right by 5 units, then dilated horizontally by a factor of 2.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{2}{x-10}$",
          "worked": "Translate right: replace $x$ by $x-5$.\n$$y=\\frac{1}{x-5}$$\nDilate horizontally by a factor of 2: replace $x$ by $\\frac{x}{2}$.\n$$\\begin{align*}y&=\\frac{1}{\\frac{x}{2}-5}\\\\y&=\\frac{2}{x-10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p54-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "dilated horizontally by a factor of 2, then translated right by 5 units.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=\\frac{2}{x-5}$",
          "worked": "Dilate horizontally by a factor of 2: replace $x$ by $\\frac{x}{2}$.\n$$\\begin{align*}y&=\\frac{1}{\\frac{x}{2}}\\\\y&=\\frac{2}{x}\\end{align*}$$\nTranslate right: replace $x$ by $x-5$.\n$$y=\\frac{2}{x-5}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      }
    ]
  },
