          "lineHeight": 1.4,
          "indent": 0,
          "inlines": [
            {
              "type": "text",
              "text": "For this question, you may assume the identity ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\cos2\\theta=1-2\\sin^2\\theta",
              "display": false
            },
            {
