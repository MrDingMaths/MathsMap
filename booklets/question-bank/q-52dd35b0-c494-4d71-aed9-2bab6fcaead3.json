  "content": {
    "id": "p25-q8-root",
    "type": "question",
    "label": "8",
    "prompt": "Fertiliser is to be spread at the rate of $0.2\\text{ kg/m}^2$.",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p25-q8-a",
        "type": "part",
        "label": "a",
        "prompt": "How much fertiliser would be needed for an area of $600\\text{ m}^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$120\\text{ kg}$",
          "worked": "$$\\begin{align*}\\frac{0.2\\text{ kg}}{1\\text{ m}^2}&=\\frac{x\\text{ kg}}{600\\text{ m}^2}\\\\x&=0.2\\times600\\\\x&=120\\end{align*}$$\n$120\\text{ kg}$ of fertiliser is needed.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p25-q8-b",
        "type": "part",
        "label": "b",
        "prompt": "If the fertiliser is sold in $20\\text{ kg}$ bags, how many bags are needed for an area of $600\\text{ m}^2$?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$6$ bags",
          "worked": "From part a, $120\\text{ kg}$ is needed.\n$$\\begin{align*}\\text{Number of bags}&=\\frac{120\\text{ kg}}{20\\text{ kg/bag}}\\\\&=6\\text{ bags}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p25-q8-c",
        "type": "part",
        "label": "c",
        "prompt": "What area could be fertilised with $1\\text{ t}$ of fertiliser?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$5000\\text{ m}^2$",
          "worked": "$1\\text{ t}=1000\\text{ kg}$.\n$$\\frac{0.2\\text{ kg}}{1\\text{ m}^2}=\\frac{1000\\text{ kg}}{x\\text{ m}^2}$$\nTake the reciprocal of both sides.\n$$\\begin{align*}\\frac{1\\text{ m}^2}{0.2\\text{ kg}}&=\\frac{x\\text{ m}^2}{1000\\text{ kg}}\\\\x&=\\frac{1000}{0.2}\\\\x&=5000\\end{align*}$$\nThe area is $5000\\text{ m}^2$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 58
      }
    ]
  },
