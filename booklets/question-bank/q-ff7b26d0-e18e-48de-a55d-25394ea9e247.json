  "content": {
    "id": "p35-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "The probability of an arrow hitting a target is 0.7. If 8 arrows are fired, find the probability of hitting the target in each case. Give your answers correct to three significant figures.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p35-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "5 times",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.254$",
          "worked": "Let $X$ be the number of hits, so $X\\sim\\operatorname{Bin}(8,0.7)$.\n$$\\begin{align*}P(X=5)&=\\binom85(0.7)^5(0.3)^3\\\\&=0.25412184\\\\&\\approx0.254.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p35-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "Twice",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.0100$",
          "worked": "$X\\sim\\operatorname{Bin}(8,0.7)$.\n$$\\begin{align*}P(X=2)&=\\binom82(0.7)^2(0.3)^6\\\\&=0.01000188\\\\&\\approx0.0100.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p35-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "3 times",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.0467$",
          "worked": "$X\\sim\\operatorname{Bin}(8,0.7)$.\n$$\\begin{align*}P(X=3)&=\\binom83(0.7)^3(0.3)^5\\\\&=0.04667544\\\\&\\approx0.0467.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p35-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "7 times",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.198$",
          "worked": "$X\\sim\\operatorname{Bin}(8,0.7)$.\n$$\\begin{align*}P(X=7)&=\\binom87(0.7)^7(0.3)\\\\&=0.19765032\\\\&\\approx0.198.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p35-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "At least 6 times",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.552$",
          "worked": "$X\\sim\\operatorname{Bin}(8,0.7)$.\n$$\\begin{align*}P(X\\ge6)&=P(X=6)+P(X=7)+P(X=8)\\\\&=\\binom86(0.7)^6(0.3)^2+\\binom87(0.7)^7(0.3)+(0.7)^8\\\\&=0.55177381\\\\&\\approx0.552.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      }
