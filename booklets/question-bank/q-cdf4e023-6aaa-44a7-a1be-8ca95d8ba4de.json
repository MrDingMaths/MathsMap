  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Evaluate $2x-3y$ when:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$x=\\frac12$ and $y=\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\frac14$",
          "worked": "$$\\begin{align*}2x-3y&=2\\times\\frac12-3\\times\\frac34\\\\2x-3y&=1-\\frac94\\\\2x-3y&=-\\frac54\\\\2x-3y&=-1\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      },
      {
        "id": "p3-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$x=-\\frac13$ and $y=\\frac16$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-1\\frac16$",
          "worked": "$$\\begin{align*}2x-3y&=2\\times\\left(-\\frac13\\right)-3\\times\\frac16\\\\2x-3y&=-\\frac23-\\frac12\\\\2x-3y&=-\\frac46-\\frac36\\\\2x-3y&=-\\frac76\\\\2x-3y&=-1\\frac16\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p3-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$x=\\frac25$ and $y=-\\frac14$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$1\\frac{11}{20}$",
          "worked": "$$\\begin{align*}2x-3y&=2\\times\\frac25-3\\times\\left(-\\frac14\\right)\\\\2x-3y&=\\frac45+\\frac34\\\\2x-3y&=\\frac{16}{20}+\\frac{15}{20}\\\\2x-3y&=\\frac{31}{20}\\\\2x-3y&=1\\frac{11}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 50
      },
      {
        "id": "p3-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$x=-\\frac23$ and $y=-\\frac34$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{11}{12}$",
          "worked": "$$\\begin{align*}2x-3y&=2\\times\\left(-\\frac23\\right)-3\\times\\left(-\\frac34\\right)\\\\2x-3y&=-\\frac43+\\frac94\\\\2x-3y&=-\\frac{16}{12}+\\frac{27}{12}\\\\2x-3y&=\\frac{11}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 42
      }
    ]
