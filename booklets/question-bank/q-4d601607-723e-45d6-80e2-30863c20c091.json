    "label": "14",
    "prompt": "Simplify the following. $\\sqrt{35}\\times\\sqrt{125}$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$25\\sqrt7$",
      "worked": "$$\\begin{align*}\\sqrt{35}\\times\\sqrt{125}&=\\sqrt{7\\times5\\times25\\times5}\\\\\\sqrt{35}\\times\\sqrt{125}&=\\sqrt{625\\times7}\\\\\\sqrt{35}\\times\\sqrt{125}&=25\\sqrt7.\\end{align*}$$",
