    "label": "13",
    "prompt": "Without fully simplifying, explain why $\\dfrac{x^2-9}{x+3}\\times\\dfrac{x+3}{x^2-9}=1$ for valid values of $x$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
