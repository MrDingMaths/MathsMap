  "content": {
    "id": "p41-q14-root",
    "type": "question",
    "label": "14",
    "prompt": "What is the perimeter, in metres, of a regular pentagon (all sides are equal), with side length $1.3\\text{ mm}$?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$0.0065\\text{ m}$",
      "worked": "A regular pentagon has five equal sides. There are $1000\\text{ mm}$ in $1\\text{ m}$.\n$$\\begin{align*}\\text{Perimeter}&=5\\times1.3\\text{ mm}\\\\\\text{Perimeter}&=6.5\\text{ mm}\\\\\\text{Perimeter}&=\\frac{6.5}{1000}\\text{ m}\\\\\\text{Perimeter}&=0.0065\\text{ m}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 24
  },
