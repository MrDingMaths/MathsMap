  "content": {
    "id": "p13-q6-root",
    "type": "question",
    "label": "6",
    "prompt": "Solve the following quadratic equations by completing the square.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p13-q6-a",
        "type": "part",
        "label": "a",
        "prompt": "$x^2-2x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=1\\pm\\sqrt2$",
          "worked": "$$\\begin{align*}x^2-2x&=1\\\\x^2-2x+1&=2\\\\(x-1)^2&=2\\\\x-1&=\\pm\\sqrt2\\\\x&=1\\pm\\sqrt2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q6-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^2-4x+1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=2\\pm\\sqrt3$",
          "worked": "$$\\begin{align*}x^2-4x&=-1\\\\x^2-4x+4&=3\\\\(x-2)^2&=3\\\\x-2&=\\pm\\sqrt3\\\\x&=2\\pm\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q6-c",
        "type": "part",
        "label": "c",
        "prompt": "$x^2-10x+13=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=5\\pm2\\sqrt3$",
          "worked": "$$\\begin{align*}x^2-10x&=-13\\\\x^2-10x+25&=12\\\\(x-5)^2&=12\\\\x-5&=\\pm2\\sqrt3\\\\x&=5\\pm2\\sqrt3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p13-q6-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2-16x+11=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "${x=2\\pm\\tfrac{\\sqrt5}{2}}$",
          "worked": "$$\\begin{align*}4x^2-16x&=-11\\\\x^2-4x&=-\\frac{11}{4}\\\\x^2-4x+4&=\\frac54\\\\(x-2)^2&=\\frac54\\\\x-2&=\\pm\\frac{\\sqrt5}{2}\\\\x&=2\\pm\\frac{\\sqrt5}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      }
    ]
