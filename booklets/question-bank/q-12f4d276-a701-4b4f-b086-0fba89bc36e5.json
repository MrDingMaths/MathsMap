  "content": {
    "id": "sum-product-b1-5-root",
    "type": "question",
    "label": null,
    "prompt": "Let $5+\\sqrt2$ be a root of the quadratic equation $x^2+px+23=0$, where $p$ is a rational number. Find:\n\n(a) the other root\n\n(b) the value of $p$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "(a) $5-\\sqrt2$; (b) $p=-10$",
      "worked": "(a) Let the other root be $\\beta$.\n$$\\begin{aligned}(5+\\sqrt2)\\beta&=23\\\\\\beta&=\\frac{23}{5+\\sqrt2}\\\\&=\\frac{23(5-\\sqrt2)}{25-2}\\\\&=5-\\sqrt2\\end{aligned}$$\n(b)\n$$\\begin{aligned}(5+\\sqrt2)+(5-\\sqrt2)&=-p\\\\10&=-p\\\\p&=-10\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 33
  },
