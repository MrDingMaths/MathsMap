  "content": {
    "id": "p3-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Solve each of the following quadratic equations:",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p3-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$2x^2+7x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=-\\frac12$.",
          "worked": "$$\\begin{align*}2x^2+7x+3&=0\\\\(2x+1)(x+3)&=0\\end{align*}$$\nBy the null factor law, $2x+1=0$ or $x+3=0$.\n$$x=-\\frac12\\text{ or }x=-3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$2x^2+11x+15=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-3$ or $x=-\\frac52$.",
          "worked": "$$\\begin{align*}2x^2+11x+15&=0\\\\(2x+5)(x+3)&=0\\end{align*}$$\nBy the null factor law, $2x+5=0$ or $x+3=0$.\n$$x=-\\frac52\\text{ or }x=-3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$3x^2+7x+2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-2$ or $x=-\\frac13$.",
          "worked": "$$\\begin{align*}3x^2+7x+2&=0\\\\(3x+1)(x+2)&=0\\end{align*}$$\nBy the null factor law, $3x+1=0$ or $x+2=0$.\n$$x=-\\frac13\\text{ or }x=-2.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$4x^2+12x+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac32$.",
          "worked": "$$\\begin{align*}4x^2+12x+9&=0\\\\(2x+3)^2&=0\\\\2x+3&=0\\\\x&=-\\frac32\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q5-e",
        "type": "part",
        "label": "e",
        "prompt": "$2x^2+7x-4=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-4$ or $x=\\frac12$.",
          "worked": "$$\\begin{align*}2x^2+7x-4&=0\\\\(2x-1)(x+4)&=0\\end{align*}$$\nBy the null factor law, $2x-1=0$ or $x+4=0$.\n$$x=\\frac12\\text{ or }x=-4.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-f",
        "type": "part",
        "label": "f",
        "prompt": "$3x^2-13x-10=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac23$ or $x=5$.",
          "worked": "$$\\begin{align*}3x^2-13x-10&=0\\\\(3x+2)(x-5)&=0\\end{align*}$$\nBy the null factor law, $3x+2=0$ or $x-5=0$.\n$$x=-\\frac23\\text{ or }x=5.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-g",
        "type": "part",
        "label": "g",
        "prompt": "$5x^2-16x+3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac15$ or $x=3$.",
          "worked": "$$\\begin{align*}5x^2-16x+3&=0\\\\(5x-1)(x-3)&=0\\end{align*}$$\nBy the null factor law, $5x-1=0$ or $x-3=0$.\n$$x=\\frac15\\text{ or }x=3.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-h",
        "type": "part",
        "label": "h",
        "prompt": "$6x^2-x-1=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac13$ or $x=\\frac12$.",
          "worked": "$$\\begin{align*}6x^2-x-1&=0\\\\(3x+1)(2x-1)&=0\\end{align*}$$\nBy the null factor law, $3x+1=0$ or $2x-1=0$.\n$$x=-\\frac13\\text{ or }x=\\frac12.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-i",
        "type": "part",
        "label": "i",
        "prompt": "$16x^2-24x+9=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac34$.",
          "worked": "$$\\begin{align*}16x^2-24x+9&=0\\\\(4x-3)^2&=0\\\\4x-3&=0\\\\x&=\\frac34\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p3-q5-j",
        "type": "part",
        "label": "j",
        "prompt": "$12x^2-5x-3=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac13$ or $x=\\frac34$.",
          "worked": "$$\\begin{align*}12x^2-5x-3&=0\\\\(3x+1)(4x-3)&=0\\end{align*}$$\nBy the null factor law, $3x+1=0$ or $4x-3=0$.\n$$x=-\\frac13\\text{ or }x=\\frac34.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-k",
        "type": "part",
        "label": "k",
        "prompt": "$21x^2+x-2=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=-\\frac13$ or $x=\\frac27$.",
          "worked": "$$\\begin{align*}21x^2+x-2&=0\\\\(3x+1)(7x-2)&=0\\end{align*}$$\nBy the null factor law, $3x+1=0$ or $7x-2=0$.\n$$x=-\\frac13\\text{ or }x=\\frac27.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
      {
        "id": "p3-q5-l",
        "type": "part",
        "label": "l",
        "prompt": "$30x^2-61x+30=0$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x=\\frac56$ or $x=\\frac65$.",
          "worked": "$$\\begin{align*}30x^2-61x+30&=0\\\\(6x-5)(5x-6)&=0\\end{align*}$$\nBy the null factor law, $6x-5=0$ or $5x-6=0$.\n$$x=\\frac56\\text{ or }x=\\frac65.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      }
    ]
