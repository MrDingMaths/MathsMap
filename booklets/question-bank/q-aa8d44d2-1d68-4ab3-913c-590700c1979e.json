  "content": {
    "id": "v2-a6564-p25-practice-j5-085638-root",
    "type": "question",
    "label": null,
    "prompt": "Write $2x^2+8x+3$ in the form $2(x+a)^2+c$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2(x+2)^2-5$",
      "worked": "$$\\begin{align*}2(x+a)^2+c&=2(x^2+2ax+a^2)+c\\\\&=2x^2+4ax+2a^2+c\\end{align*}$$\nEquate coefficients and constant terms.\n$$\\begin{align*}4a&=8\\\\a&=2\\\\2a^2+c&=3\\\\8+c&=3\\\\c&=-5\\end{align*}$$\nHence $2x^2+8x+3=2(x+2)^2-5$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
