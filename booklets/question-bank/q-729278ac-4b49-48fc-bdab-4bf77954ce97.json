    "questionDiagrams": [],
    "children": [
      {
        "id": "p21-q18-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the perimeter of a square of area 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4$ units.",
          "worked": "Let $s$ be the side length.\n$$\\begin{align*}s^2&=1\\\\s&=1\\end{align*}$$\n$$\\begin{align*}P&=4s\\\\P&=4\\times1\\\\P&=4\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 52
      },
      {
        "id": "p21-q18-b",
        "type": "part",
        "label": "b",
        "prompt": "Find the perimeter of a circle of area 1.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{4\\pi}$ units.",
          "worked": "$$\\begin{align*}\\pi r^2&=1\\\\r^2&=\\frac1\\pi\\\\r&=\\frac1{\\sqrt\\pi}\\end{align*}$$\n$$\\begin{align*}C&=2\\pi r\\\\C&=2\\pi\\left(\\frac1{\\sqrt\\pi}\\right)\\\\C&=2\\sqrt\\pi\\\\C&=\\sqrt{4\\pi}\\text{ units}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 62
      },
      {
        "id": "p21-q18-c",
        "type": "part",
        "label": "c",
        "prompt": "Without the use of your calculator, find which of these two figures has the smaller perimeter?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The circle, since $\\sqrt{4\\pi}<\\sqrt{16}=4$.",
          "worked": "Since $\\pi<4$, we have $4\\pi<16$. Taking positive square roots gives $\\sqrt{4\\pi}<\\sqrt{16}=4$. Therefore, the circle has the smaller perimeter.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
