  "content": {
    "id": "v2-4e6fa-p12-practice-j7-052053-root",
    "type": "question",
    "label": null,
    "prompt": "Find the value of $m$ if:\n\n$(x+5)(m-4)=3x+15$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=7$",
      "worked": "Factorise the right-hand side:\n$$\\begin{align*}3x+15&=3(x+5)\\end{align*}$$\nComparing the factors multiplying $x+5$ gives\n$$\\begin{align*}m-4&=3\\\\m&=7\\end{align*}$$",
      "solutionDiagrams": []
    },
