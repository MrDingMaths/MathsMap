          "worked": "$$\\begin{aligned}\\bar{x}&=\\frac{51+(-36)}{2}=7.5\\\\\\bar{y}&=\\frac{-12+11}{2}=-0.5\\\\M&=(7.5,-0.5)\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 32
      },
      {
        "id": "p5-q3-f",
        "type": "part",
        "label": "f",
