  "content": {
    "id": "p7-q5-root",
    "type": "question",
    "label": "5",
    "prompt": "Write each function using a fractional index, and hence find the primitive.",
    "layout": "grid",
    "columns": 4,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q5-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\sqrt{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt{x}=x^{1/2}$; primitive: $\\dfrac{2x^{3/2}}{3}+C$.",
          "worked": "$$\\begin{aligned}\\sqrt{x}&=x^{1/2}\\\\f(x)&=\\frac{x^{3/2}}{3/2}+C\\\\f(x)&=\\frac{2x^{3/2}}{3}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\dfrac{1}{\\sqrt{x}}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{\\sqrt{x}}=x^{-1/2}$; primitive: $2\\sqrt{x}+C$.",
          "worked": "$$\\begin{aligned}\\frac{1}{\\sqrt{x}}&=x^{-1/2}\\\\f(x)&=\\frac{x^{1/2}}{1/2}+C\\\\f(x)&=2x^{1/2}+C\\\\f(x)&=2\\sqrt{x}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p7-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\sqrt[3]{x}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[3]{x}=x^{1/3}$; primitive: $\\dfrac{3x^{4/3}}{4}+C$.",
          "worked": "$$\\begin{aligned}\\sqrt[3]{x}&=x^{1/3}\\\\f(x)&=\\frac{x^{4/3}}{4/3}+C\\\\f(x)&=\\frac{3x^{4/3}}{4}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "p7-q5-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\sqrt[5]{x^3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\sqrt[5]{x^3}=x^{3/5}$; primitive: $\\dfrac{5x^{8/5}}{8}+C$.",
          "worked": "$$\\begin{aligned}\\sqrt[5]{x^3}&=x^{3/5}\\\\f(x)&=\\frac{x^{8/5}}{8/5}+C\\\\f(x)&=\\frac{5x^{8/5}}{8}+C\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      }
    ]
  },
