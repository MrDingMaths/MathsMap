    "children": [
      {
        "id": "v2-f3075-p38-practice-slot-3-slot-3-a",
        "type": "part",
        "label": "a",
        "prompt": "Express $y=x^2+4x+7$ in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=(x+2)^2+3$",
          "worked": "$$\\begin{align*}y&=x^2+4x+4-4+7\\\\y&=(x+2)^2+3\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "v2-f3075-p38-practice-slot-3-slot-3-b",
        "type": "part",
        "label": "b",
        "prompt": "Using your answer to part a, explain why the parabola is always above the $x$-axis.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Since $(x+2)^2\\ge0$, $y=(x+2)^2+3\\ge3>0$.",
          "worked": "Since $(x+2)^2\\ge0$, adding 3 gives $y\\ge3$. Thus every point on the parabola lies above the $x$-axis.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "v2-f3075-p38-practice-slot-3-slot-3-c",
        "type": "part",
        "label": "c",
        "prompt": "Express $y=-2x^2+8x-9$ in vertex form.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$y=-2(x-2)^2-1$",
          "worked": "$$\\begin{align*}y&=-2(x^2-4x)-9\\\\y&=-2\\bigl((x-2)^2-4\\bigr)-9\\\\y&=-2(x-2)^2+8-9\\\\y&=-2(x-2)^2-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 40
      },
      {
        "id": "v2-f3075-p38-practice-slot-3-slot-3-d",
        "type": "part",
        "label": "d",
        "prompt": "Explain why $y=-2x^2+8x-9$ has no $x$-intercepts.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "The parabola is concave down with vertex $(2,-1)$, so $y\\le-1<0$.",
          "worked": "Since $-2(x-2)^2\\le0$, $y=-2(x-2)^2-1\\le-1<0$. The parabola is always below the $x$-axis, so it has no $x$-intercepts.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
