  "content": {
    "id": "v2-641694-p7-practice-j9-095846-root",
    "type": "question",
    "label": null,
    "prompt": "Hana works from 8:30 am to 4 pm on Monday and from 9 am to 2:30 pm on Tuesday. Her hourly rate is \\$26.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-641694-p7-practice-j9-095846-j9-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the number of hours Hana works on Monday.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "7.5 hours",
          "worked": "From 8:30 am to 4 pm is 7 hours 30 minutes.\n$$\\begin{align*}\\text{Hours}&=7.5\\text{ hours}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "v2-641694-p7-practice-j9-095846-j9-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Calculate her pay for Monday.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$195",
          "worked": "$$\\begin{align*}\\text{Total Pay}&=\\text{Pay per period}\\times\\text{Number of periods}\\\\&=\\$26/\\text{hour}\\times7.5\\text{ hours}\\\\&=\\$195\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "v2-641694-p7-practice-j9-095846-j9-q-c",
        "type": "part",
        "label": "c",
        "prompt": "Calculate her total pay for Monday and Tuesday.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "\\$338",
          "worked": "From 9 am to 2:30 pm is $5.5$ hours on Tuesday.\n$$\\begin{align*}\\text{Total hours}&=7.5+5.5\\\\&=13\\text{ hours}\\\\\\text{Total Pay}&=\\$26/\\text{hour}\\times13\\text{ hours}\\\\&=\\$338\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
