                  "code": "% mathsmap-diagram-colours {\"version\":1,\"kind\":\"graph\",\"base\":[],\"semantic\":[{\"name\":\"springOrange\",\"hex\":\"EF8B2C\",\"reason\":\"supplied spring-length data series\"}],\"reference\":\"source page 10 p10-q4-a-extension\"}\n\\begin{tikzpicture}[x=0.18mm,y=0.27mm]\n\\special{dvisvgm:raw <metadata data-graph-strokes=\"1\"/>}\n\\definecolor{springOrange}{HTML}{EF8B2C}\n\\draw[black,line width=0.15pt,xstep=25,ystep=25] (0,0) grid (300,150);\n\\draw[black,line width=0.25pt,xstep=50,ystep=50] (0,0) grid (300,150);\n\\draw[black,->,line width=0.5pt] (0,0)--(325,0);\n\\draw[black,->,line width=0.5pt] (0,0)--(0,166);\n\\foreach \\v in {0,50,100,150,200,250,300} {\\draw[black,line width=0.4pt] (\\v,0)--(\\v,-3);\\node[below,font=\\fontsize{8.5}{10}\\selectfont] at (\\v,-3) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\v$\\special{dvisvgm:raw </g>}};}\n\\foreach \\v in {0,50,100,150} {\\draw[black,line width=0.4pt] (0,\\v)--(-4,\\v);\\node[left,font=\\fontsize{8.5}{10}\\selectfont] at (-4,\\v) {\\special{dvisvgm:raw <g data-graph-text=\"tick\">}$\\v$\\special{dvisvgm:raw </g>}};}\n\\node[below,font=\\fontsize{10}{12}\\selectfont] at (150,-22) {$m\\ (\\mathrm{g})$};\n\\node[rotate=90,font=\\fontsize{10}{12}\\selectfont] at (-65,75) {$l\\ (\\mathrm{mm})$};\n\\draw[springOrange,line width=0.8pt] plot[domain=100:300,samples=2] (\\x,{0.4*\\x+20});\n\\draw[black,dashed,line width=0.8pt] plot[domain=0:100,samples=2] (\\x,{0.4*\\x+20});\n\\fill[black] (0,20) circle[radius=1pt];\n\\node[anchor=west,font=\\fontsize{10}{12}\\selectfont] at (12,16) {$l=20$};\n\\end{tikzpicture}",
