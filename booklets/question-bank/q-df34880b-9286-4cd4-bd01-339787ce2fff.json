  "content": {
    "id": "p20-q19",
    "type": "question",
    "label": "19",
    "prompt": "Emily says that a number divisible by 24 must also be divisible by 4 and 6.\nExplain why she is correct.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$4$ and $6$ are factors of $24$.",
      "worked": "$24=4\\times6$, so every multiple of $24$ is also a multiple of both $4$ and $6$. Therefore Emily is correct.",
