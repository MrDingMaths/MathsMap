  "content": {
    "id": "p36-q9-response",
    "type": "question",
    "label": "9",
    "prompt": "Use all of the numbers 1, 2, 3, 4, 5, 6 and 7 once and the symbols $+$, $-$, $\\times$ and $\\div$ to make a number sentence that results in 100.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "One solution is $5\\times(7\\times3-6\\div(4+2))\\times1=100$.",
      "worked": "One solution uses each number once and all four operation symbols.\n\n$$\\begin{align*}5\\times(7\\times3-6\\div(4+2))\\times1&=5\\times(21-6\\div6)\\times1\\\\5\\times(7\\times3-6\\div(4+2))\\times1&=5\\times(21-1)\\times1\\\\5\\times(7\\times3-6\\div(4+2))\\times1&=5\\times20\\times1\\\\5\\times(7\\times3-6\\div(4+2))\\times1&=100\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
