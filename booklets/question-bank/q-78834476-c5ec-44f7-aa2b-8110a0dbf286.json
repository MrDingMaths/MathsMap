    "label": "43",
    "prompt": "Complete the square of the following.\n$$2x^2-8x+3$$",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$2(x-2)^2-5$",
      "worked": "$$\\begin{align*}2x^2-8x+3&=2\\left(x^2-4x+\\frac32\\right)\\\\2x^2-8x+3&=2\\left((x-2)^2-4+\\frac32\\right)\\\\2x^2-8x+3&=2(x-2)^2-5.\\end{align*}$$",
      "solutionDiagrams": []
    },
