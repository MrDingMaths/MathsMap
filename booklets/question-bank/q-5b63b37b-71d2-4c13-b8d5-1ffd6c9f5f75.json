  "content": {
    "id": "v2-0442a-p18-practice-slot-8-lower-root",
    "type": "question",
    "label": null,
    "prompt": "A walking track in the Blue Mountains is 2 km long. On a map, the track is 8 cm long.\nWhat is the scale factor from the track to its image on the map?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\dfrac{1}{25\\,000}$",
      "worked": "$2\\text{ km}=2000\\text{ m}=200\\,000\\text{ cm}$.\n$$\\begin{align*}\\text{Scale factor}&=\\frac{\\text{Image length}}{\\text{Original length}}\\\\&=\\frac{8}{200\\,000}\\\\&=\\frac{1}{25\\,000}\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": null
  },
