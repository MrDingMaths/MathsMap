  "content": {
    "id": "estimating-r6-atpoint-1-root",
    "type": "question",
    "label": null,
    "prompt": "Consider $f(x)=3x^2$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "estimating-r6-atpoint-1-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $f(4)=48$ and $f(4+h)=48+24h+3h^2$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f(4)=3(4)^2=48$ and $f(4+h)=3(16+8h+h^2)=48+24h+3h^2$.",
          "worked": "$$\\begin{align*}f(4)&=3(4)^2\\\\f(4)&=48\\end{align*}$$\n$$\\begin{align*}f(4+h)&=3(4+h)^2\\\\f(4+h)&=3(16+8h+h^2)\\\\f(4+h)&=48+24h+3h^2\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "estimating-r6-atpoint-1-b",
        "type": "part",
        "label": "b",
        "prompt": "Show that $\\dfrac{f(4+h)-f(4)}{h}=24+3h$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{f(4+h)-f(4)}{h}=\\dfrac{24h+3h^2}{h}=24+3h$, for $h\\ne0$.",
          "worked": "For $h\\ne0$,\n$$\\begin{align*}\\frac{f(4+h)-f(4)}{h}&=\\frac{48+24h+3h^2-48}{h}\\\\\\frac{f(4+h)-f(4)}{h}&=\\frac{h(24+3h)}{h}\\\\\\frac{f(4+h)-f(4)}{h}&=24+3h.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 23
      },
      {
        "id": "estimating-r6-atpoint-1-c",
        "type": "part",
        "label": "c",
        "prompt": "Take the limit as $h\\to0$ to show that $f'(4)=24$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f'(4)=\\lim_{h\\to0}(24+3h)=24$.",
          "worked": "$$\\begin{align*}f'(4)&=\\lim_{h\\to0}\\frac{f(4+h)-f(4)}{h}\\\\f'(4)&=\\lim_{h\\to0}(24+3h)\\\\f'(4)&=24.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      }
    ]
  },
