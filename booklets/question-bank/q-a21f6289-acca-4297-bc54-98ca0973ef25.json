  "content": {
    "id": "p42-q15-root",
    "type": "question",
    "label": "15",
    "prompt": "In each part, describe how each subsequent equation is a transformation of the first graph.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p42-q15-a",
        "type": "group",
        "label": "a",
        "prompt": "$y=x^2$",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q15-a-1",
            "type": "part",
            "label": "i",
            "prompt": "$y=(x+1)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "1 unit left.",
              "worked": "Replace $x$ with $x+1$: translate 1 unit left.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q15-a-2",
            "type": "part",
            "label": "ii",
            "prompt": "$y=-(x+1)^2$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "1 unit left and reflection in the $x$-axis.",
              "worked": "Replace $x$ with $x+1$ and $y$ with $-y$: translate 1 unit left and reflect in the $x$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p42-q15-a-3",
            "type": "part",
            "label": "iii",
            "prompt": "$y=(x+1)^2-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "1 unit left and 1 unit down.",
              "worked": "Write $y+1=(x+1)^2$. Replace $x$ with $x+1$ and $y$ with $y+1$: translate 1 unit left and 1 unit down.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p42-q15-b",
        "type": "group",
        "label": "b",
        "prompt": "$y=\\sqrt{x}$",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q15-b-1",
            "type": "part",
            "label": "i",
            "prompt": "$y=\\sqrt{x+4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "4 units left.",
              "worked": "Replace $x$ with $x+4$: translate 4 units left.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q15-b-2",
            "type": "part",
            "label": "ii",
            "prompt": "$y=\\sqrt{-x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflection in the $y$-axis.",
              "worked": "Replace $x$ with $-x$: reflect in the $y$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q15-b-3",
            "type": "part",
            "label": "iii",
            "prompt": "$y=-\\sqrt{x+4}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "4 units left and reflection in the $x$-axis.",
              "worked": "Replace $x$ with $x+4$ and $y$ with $-y$: translate 4 units left and reflect in the $x$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p42-q15-c",
        "type": "group",
        "label": "c",
        "prompt": "$y=\\dfrac{2}{x}$",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q15-c-1",
            "type": "part",
            "label": "i",
            "prompt": "$y=\\dfrac{2}{x}-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "1 unit down.",
              "worked": "Write $y+1=\\dfrac{2}{x}$. Replace $y$ with $y+1$: translate 1 unit down.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q15-c-2",
            "type": "part",
            "label": "ii",
            "prompt": "$y=\\dfrac{2}{x-2}-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "2 units right and 1 unit down.",
              "worked": "Write $y+1=\\dfrac{2}{x-2}$. Replace $x$ with $x-2$ and $y$ with $y+1$: translate 2 units right and 1 unit down.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p42-q15-c-3",
            "type": "part",
            "label": "iii",
            "prompt": "$y=-\\dfrac{2}{x}$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflection in either the $x$-axis or the $y$-axis.",
              "worked": "Replacing $y$ with $-y$ reflects in the $x$-axis. Alternatively, replacing $x$ with $-x$ gives $y=\\dfrac{2}{-x}=-\\dfrac{2}{x}$, a reflection in the $y$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      },
      {
        "id": "p42-q15-d",
        "type": "group",
        "label": "d",
        "prompt": "$y=\\sin x$",
        "layout": "grid",
        "columns": 3,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p42-q15-d-1",
            "type": "part",
            "label": "i",
            "prompt": "$y=\\sin x-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "1 unit down.",
              "worked": "Write $y+1=\\sin x$. Replace $y$ with $y+1$: translate 1 unit down.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 18
          },
          {
            "id": "p42-q15-d-2",
            "type": "part",
            "label": "ii",
            "prompt": "$y=\\sin(x-\\pi)-1$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "$\\pi$ units right and 1 unit down.",
              "worked": "Write $y+1=\\sin(x-\\pi)$. Replace $x$ with $x-\\pi$ and $y$ with $y+1$: translate $\\pi$ units right and 1 unit down.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          },
          {
            "id": "p42-q15-d-3",
            "type": "part",
            "label": "iii",
            "prompt": "$y=-\\sin x$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "Reflection in either the $x$-axis or the $y$-axis, since $\\sin(-x)=-\\sin x$.",
              "worked": "Replacing $y$ with $-y$ reflects in the $x$-axis. Since $\\sin(-x)=-\\sin x$, replacing $x$ with $-x$ produces the same graph by reflection in the $y$-axis.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 24
          }
        ]
      }
    ]
