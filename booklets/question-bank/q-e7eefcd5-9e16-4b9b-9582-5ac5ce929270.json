  "content": {
    "id": "p11-problem-1-root",
    "type": "question",
    "label": "1",
    "prompt": "Show that $\\frac{4}{2+\\sqrt{5}}-\\frac{1}{9-4\\sqrt{5}}$ is a rational number.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$-17$.\n\nRationalising both denominators gives equal surd terms that cancel.",
      "worked": "$$\\begin{align*}\\frac{4}{2+\\sqrt{5}}-\\frac{1}{9-4\\sqrt{5}}&=\\frac{4(2-\\sqrt{5})}{(2+\\sqrt{5})(2-\\sqrt{5})}-\\frac{9+4\\sqrt{5}}{(9-4\\sqrt{5})(9+4\\sqrt{5})}\\\\\\frac{4}{2+\\sqrt{5}}-\\frac{1}{9-4\\sqrt{5}}&=\\frac{4(2-\\sqrt{5})}{4-5}-\\frac{9+4\\sqrt{5}}{81-80}\\\\\\frac{4}{2+\\sqrt{5}}-\\frac{1}{9-4\\sqrt{5}}&=(-8+4\\sqrt{5})-(9+4\\sqrt{5})\\\\\\frac{4}{2+\\sqrt{5}}-\\frac{1}{9-4\\sqrt{5}}&=-17.\\end{align*}$$\n\nSince $-17$ is an integer, it is rational.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 30
  },
