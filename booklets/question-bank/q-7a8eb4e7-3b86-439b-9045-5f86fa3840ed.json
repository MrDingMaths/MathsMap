  "content": {
    "id": "p14-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Express each expression as a single fraction.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p14-q4-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\frac{3x}{8}+\\frac{x}{8}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{x}{2}$",
          "worked": "$$\\begin{align*}\\frac{3x}{8}+\\frac{x}{8}&=\\frac{3x+x}{8}\\\\\\frac{3x}{8}+\\frac{x}{8}&=\\frac{4x}{8}\\\\\\frac{3x}{8}+\\frac{x}{8}&=\\frac{x}{2}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p14-q4-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\frac{4x}{5}-\\frac{2x}{5}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{2x}{5}$",
          "worked": "$$\\begin{align*}\\frac{4x}{5}-\\frac{2x}{5}&=\\frac{4x-2x}{5}\\\\\\frac{4x}{5}-\\frac{2x}{5}&=\\frac{2x}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q4-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{2x}{7}-\\frac{5x}{7}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-\\frac{3x}{7}$",
          "worked": "$$\\begin{align*}\\frac{2x}{7}-\\frac{5x}{7}&=\\frac{2x-5x}{7}\\\\\\frac{2x}{7}-\\frac{5x}{7}&=-\\frac{3x}{7}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q4-d",
        "type": "part",
        "label": "d",
        "prompt": "$\\frac{4x}{5}+\\frac{x}{2}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{13x}{10}$",
          "worked": "$$\\begin{align*}\\frac{4x}{5}+\\frac{x}{2}&=\\frac{8x+5x}{10}\\\\\\frac{4x}{5}+\\frac{x}{2}&=\\frac{13x}{10}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q4-e",
        "type": "part",
        "label": "e",
        "prompt": "$\\frac{6x}{5}-\\frac{x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{19x}{20}$",
          "worked": "$$\\begin{align*}\\frac{6x}{5}-\\frac{x}{4}&=\\frac{24x-5x}{20}\\\\\\frac{6x}{5}-\\frac{x}{4}&=\\frac{19x}{20}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q4-f",
        "type": "part",
        "label": "f",
        "prompt": "$\\frac{2x}{7}-\\frac{2x}{3}$",
        "layout": "list",
        "columns": null,
