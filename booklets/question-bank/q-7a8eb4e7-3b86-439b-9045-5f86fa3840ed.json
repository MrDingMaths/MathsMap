        "children": [],
        "answer": {
          "short": "$-\\frac{8x}{21}$",
          "worked": "$$\\begin{align*}\\frac{2x}{7}-\\frac{2x}{3}&=\\frac{6x-14x}{21}\\\\\\frac{2x}{7}-\\frac{2x}{3}&=-\\frac{8x}{21}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q4-g",
        "type": "part",
        "label": "g",
        "prompt": "$\\frac{2x}{3}+\\frac{x}{2}-\\frac{3x}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5x}{12}$",
          "worked": "$$\\begin{align*}\\frac{2x}{3}+\\frac{x}{2}-\\frac{3x}{4}&=\\frac{8x+6x-9x}{12}\\\\\\frac{2x}{3}+\\frac{x}{2}-\\frac{3x}{4}&=\\frac{5x}{12}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p14-q4-h",
