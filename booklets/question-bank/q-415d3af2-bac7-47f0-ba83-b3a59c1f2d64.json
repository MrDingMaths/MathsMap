  "content": {
    "id": "p8-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "If $\\theta$ is the angle between the vectors $\\underset{\\sim}{a}$ and $\\underset{\\sim}{b}$, find the exact value of $\\cos\\theta$ given:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p8-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "$\\underset{\\sim}{a}=4\\underset{\\sim}{i}+3\\underset{\\sim}{j}$, $\\underset{\\sim}{b}=5\\underset{\\sim}{j}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac35$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=4(0)+3(5)\\\\&=15\\\\|\\underset{\\sim}{a}|&=\\sqrt{4^2+3^2}=5\\\\|\\underset{\\sim}{b}|&=5\\\\\\cos\\theta&=\\frac{15}{5\\times5}=\\frac35\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 26
      },
      {
        "id": "p8-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}2\\\\2\\end{pmatrix}$, $\\underset{\\sim}{b}=\\begin{pmatrix}3\\\\-1\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac1{\\sqrt5}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=2(3)+2(-1)\\\\&=4\\\\|\\underset{\\sim}{a}|&=\\sqrt8\\\\|\\underset{\\sim}{b}|&=\\sqrt{10}\\\\\\cos\\theta&=\\frac4{\\sqrt8\\times\\sqrt{10}}\\\\&=\\frac4{\\sqrt{80}}\\\\&=\\frac1{\\sqrt5}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 31
      },
      {
        "id": "p8-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\underset{\\sim}{a}=\\begin{pmatrix}-6\\\\4\\end{pmatrix}$, $\\underset{\\sim}{b}=\\begin{pmatrix}-8\\\\-2\\end{pmatrix}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{10}{\\sqrt{221}}$",
          "worked": "$$\\begin{aligned}\\underset{\\sim}{a}\\cdot\\underset{\\sim}{b}&=(-6)(-8)+4(-2)\\\\&=40\\\\|\\underset{\\sim}{a}|&=\\sqrt{36+16}\\\\&=\\sqrt{52}\\\\|\\underset{\\sim}{b}|&=\\sqrt{64+4}\\\\&=\\sqrt{68}\\\\\\cos\\theta&=\\frac{40}{\\sqrt{52\\times68}}\\\\&=\\frac{40}{\\sqrt{3536}}\\\\&=\\frac{10}{\\sqrt{221}}\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 37
      }
    ]
  },
