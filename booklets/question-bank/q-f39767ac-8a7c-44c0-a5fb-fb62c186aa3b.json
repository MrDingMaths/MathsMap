          "inlines": [
            {
              "type": "text",
              "text": "We can partition the set ",
              "marks": []
            },
            {
              "type": "math",
              "latex": "\\{1,2,3,4,5,6,7\\}",
              "display": false
            },
            {
              "type": "text",
              "text": " into two sets with the same sum. For example:",
              "marks": []
            }
          ]
        },
