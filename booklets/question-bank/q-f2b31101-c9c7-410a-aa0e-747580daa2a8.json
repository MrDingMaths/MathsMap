  "content": {
    "id": "p20-q3-root",
    "type": "question",
    "label": "3",
    "prompt": "The average of 5 masses is 67 kg. If a mass of 25 kg is added, what is the average of the 6 masses?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$60.00\\text{ kg}$",
      "worked": "$$\\begin{align*}\\text{Original total mass}&=5\\times67=335\\text{ kg}\\\\\\text{New total mass}&=335+25=360\\text{ kg}\\\\\\text{New average mass}&=\\frac{360}{6}=60.00\\text{ kg}\\end{align*}$$",
      "solutionDiagrams": []
    },
