  "content": {
    "id": "v2-11f0f-p40-practice-slot-5-root",
    "type": "question",
    "label": null,
    "prompt": "The line $y = 4x + k$ and the parabola $y = x^{2} - 2x + 3$ are given.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "v2-11f0f-p40-practice-slot-5-slot-5-q-a",
        "type": "part",
        "label": "a",
        "prompt": "Find the value of $k$ for which the line is tangent to the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k = -6$",
          "worked": "$$\\begin{align*}4x + k &= x^{2} - 2x + 3\\\\x^{2} - 6x + 3 - k &= 0\\end{align*}$$\n$$\\begin{align*}\\Delta &= (-6)^{2} - 4(1)(3 - k)\\\\\\Delta &= 24 + 4k\\end{align*}$$\nFor a tangent, $\\Delta = 0$.\n$$\\begin{align*}24 + 4k &= 0\\\\k &= -6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 45
      },
      {
        "id": "v2-11f0f-p40-practice-slot-5-slot-5-q-b",
        "type": "part",
        "label": "b",
        "prompt": "Determine for which values of $k$ the line does not intersect the parabola.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k < -6$",
          "worked": "For no points of intersection, $\\Delta < 0$.\n$$\\begin{align*}24 + 4k &< 0\\\\4k &< -24\\\\k &< -6\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
