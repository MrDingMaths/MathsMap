        "answer": {
          "short": "$1\\frac14$",
          "worked": "$$\\begin{align*}\\frac{n}{m}&=\\frac{20}{16}\\\\\\frac{n}{m}&=\\frac54\\\\\\frac{n}{m}&=1\\frac14\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p11-q5-c",
        "type": "part",
        "label": "c",
        "prompt": "$\\frac{m+n}{4}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}\\frac{m+n}{4}&=\\frac{16+20}{4}\\\\\\frac{m+n}{4}&=\\frac{36}{4}\\\\\\frac{m+n}{4}&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
