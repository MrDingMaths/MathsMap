  "content": {
    "id": "p24-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "If two fair six-sided dice are rolled once, find the probability that:",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p24-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "both show a 6",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "There are $6\\times6=36$ equally likely ordered pairs. Only $(6,6)$ is favourable.\n$$\\begin{align*}\\Pr(\\text{both show a 6})&=\\frac{1}{36}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "both show a 1",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{36}$",
          "worked": "There are $36$ equally likely ordered pairs. Only $(1,1)$ is favourable.\n$$\\begin{align*}\\Pr(\\text{both show a 1})&=\\frac{1}{36}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p24-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "show different numbers",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{5}{6}$",
          "worked": "Of the $36$ equally likely ordered pairs, six have identical numbers: $(1,1)$ through $(6,6)$. The other $30$ pairs have different numbers.\n$$\\begin{align*}\\Pr(\\text{different numbers})&=\\frac{36-6}{36}\\\\\\Pr(\\text{different numbers})&=\\frac{5}{6}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      },
      {
        "id": "p24-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "both show a number exceeding 4.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\frac{1}{9}$",
          "worked": "Each die must show $5$ or $6$. The favourable ordered pairs are $(5,5)$, $(5,6)$, $(6,5)$ and $(6,6)$.\n$$\\begin{align*}\\Pr(\\text{both exceed 4})&=\\frac{4}{36}\\\\\\Pr(\\text{both exceed 4})&=\\frac{1}{9}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 30
      }
    ]
  },
