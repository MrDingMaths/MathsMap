  "content": {
    "id": "p18-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "\\$1140 is invested for 2 years compounded monthly at 5% p.a. Calculate the future value to 2 decimal places.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "\\$1259.63",
      "worked": "$$\\begin{align*}r&=\\frac{0.05}{12}\\\\n&=2\\times12=24\\\\FV&=PV(1+r)^n\\\\FV&=1140\\left(1+\\frac{0.05}{12}\\right)^{24}\\\\FV&\\approx\\$1259.63\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 38
  },
