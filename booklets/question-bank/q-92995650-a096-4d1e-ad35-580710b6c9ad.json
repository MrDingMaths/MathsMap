    "questionDiagrams": [],
    "children": [
      {
        "id": "p15-q11-a",
        "type": "part",
        "label": "a",
        "prompt": "Use the discriminant of a suitable quadratic equation to determine whether or not the parabola $y=x^2+x+1$ intersects the line $y=7x-6$. If they do intersect then how many points are there and what are the $x$-coordinates?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Two points, with $x=3-\\sqrt2$ and $x=3+\\sqrt2$.",
          "worked": "At an intersection, the two expressions for $y$ are equal.\n$$\\begin{align*}x^2+x+1&=7x-6\\\\x^2-6x+7&=0\\\\\\Delta&=(-6)^2-4\\times1\\times7\\\\\\Delta&=8.\\end{align*}$$\nSince $\\Delta>0$, there are two intersection points.\n$$\\begin{align*}x&=\\frac{6\\pm\\sqrt8}{2}\\\\x&=3\\pm\\sqrt2.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 60
      },
      {
        "id": "p15-q11-b",
        "type": "group",
        "label": "b",
        "prompt": "Use a similar method to investigate these parabolas and straight lines.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [
          {
            "id": "p15-q11-b-i",
            "type": "part",
            "label": "i",
            "prompt": "$$\\begin{aligned}y&=x^2-2x+7\\\\y&=4x-2\\end{aligned}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "One point, with $x=3$.",
              "worked": "At an intersection:\n$$\\begin{align*}x^2-2x+7&=4x-2\\\\x^2-6x+9&=0\\\\\\Delta&=(-6)^2-4\\times1\\times9\\\\\\Delta&=0.\\end{align*}$$\nSince $\\Delta=0$, there is one intersection point.\n$$x=\\frac{6}{2}=3.$$",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 52
          },
          {
            "id": "p15-q11-b-ii",
            "type": "part",
            "label": "ii",
            "prompt": "$$\\begin{aligned}y&=x^2+3x+6\\\\y&=-x+1\\end{aligned}$$",
            "layout": "list",
            "columns": null,
            "questionDiagrams": [],
            "children": [],
            "answer": {
              "short": "They do not intersect.",
              "worked": "At an intersection:\n$$\\begin{align*}x^2+3x+6&=-x+1\\\\x^2+4x+5&=0\\\\\\Delta&=4^2-4\\times1\\times5\\\\\\Delta&=-4.\\end{align*}$$\nSince $\\Delta<0$, there are no real solutions, so the parabola and line do not intersect.",
              "solutionDiagrams": []
            },
            "answerSpaceMm": 44
          }
        ]
      }
    ]
  },
