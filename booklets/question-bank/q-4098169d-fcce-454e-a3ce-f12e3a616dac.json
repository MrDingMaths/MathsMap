  "content": {
    "id": "p7-q9-root",
    "type": "question",
    "label": "9",
    "prompt": "Decide whether each pair of lines will have the same $y$-intercept.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p7-q9-a",
        "type": "part",
        "label": "a",
        "prompt": "$y = 4x + 5$ and $y = 3x + 5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "Yes.",
          "worked": "Both constant terms are $5$, so both lines have $y$-intercept $(0,5)$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q9-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = 7 - x$ and $y = -x + 4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The $y$-intercepts are $(0,7)$ and $(0,4)$, so they are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q9-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = \\dfrac{2}{3}x - 9$ and $y = 4 + \\dfrac{2x}{3}$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The $y$-intercepts are $(0,-9)$ and $(0,4)$, so they are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q9-d",
        "type": "part",
        "label": "d",
        "prompt": "$y = 18x - 11$ and $y = 11 - 18x$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "The $y$-intercepts are $(0,-11)$ and $(0,11)$, so they are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p7-q9-e",
        "type": "part",
        "label": "e",
        "prompt": "$y = 4(3x + 1)$ and $y = 3x - 8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}y &= 4(3x + 1)\\\\y &= 12x + 4\\end{align*}$$\nThe $y$-intercepts are $(0,4)$ and $(0,-8)$, so they are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p7-q9-f",
        "type": "part",
        "label": "f",
        "prompt": "$y = 2x + 7$ and $y = 2(x - 9)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "No.",
          "worked": "$$\\begin{align*}y &= 2(x - 9)\\\\y &= 2x - 18\\end{align*}$$\nThe $y$-intercepts are $(0,7)$ and $(0,-18)$, so they are different.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      }
    ]
  },
