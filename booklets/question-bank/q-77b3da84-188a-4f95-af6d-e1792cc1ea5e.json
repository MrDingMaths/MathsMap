  "content": {
    "id": "reuse-s5-p88-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Solve these equations. The answers may be positive or negative integers or fractions.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "reuse-s5-p88-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "$3m+7=8m+2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$m=1$",
          "worked": "Subtract $3m$ from both sides, then subtract $2$ and divide by $5$.\n$$\\begin{align*}7&=5m+2\\\\5&=5m\\\\1&=m\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "reuse-s5-p88-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "$7t-6=4t+5$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{11}{3}$",
          "worked": "Subtract $4t$ from both sides, then add $6$ and divide by $3$.\n$$\\begin{align*}3t-6&=5\\\\3t&=11\\\\t&=\\frac{11}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "reuse-s5-p88-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "$6h-8=2h-7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$h=\\frac{1}{4}$",
          "worked": "Subtract $2h$ from both sides, then add $8$ and divide by $4$.\n$$\\begin{align*}4h-8&=-7\\\\4h&=1\\\\h&=\\frac{1}{4}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "reuse-s5-p88-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "$12+3w=6w-4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$w=\\frac{16}{3}$",
          "worked": "Subtract $3w$ from both sides, then add $4$ and divide by $3$.\n$$\\begin{align*}12&=3w-4\\\\16&=3w\\\\\\frac{16}{3}&=w\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "reuse-s5-p88-q12-e",
        "type": "part",
        "label": "e",
        "prompt": "$5p=2p+8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=\\frac{8}{3}$",
          "worked": "Subtract $2p$ from both sides, then divide by $3$.\n$$\\begin{align*}3p&=8\\\\p&=\\frac{8}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "reuse-s5-p88-q12-f",
        "type": "part",
        "label": "f",
        "prompt": "$5p=2p-8$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$p=-\\frac{8}{3}$",
          "worked": "Subtract $2p$ from both sides, then divide by $3$.\n$$\\begin{align*}3p&=-8\\\\p&=-\\frac{8}{3}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "reuse-s5-p88-q12-g",
        "type": "part",
        "label": "g",
        "prompt": "$k-19=6k-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k=-\\frac{16}{5}$",
          "worked": "Subtract $k$ from both sides, then add $3$ and divide by $5$.\n$$\\begin{align*}-19&=5k-3\\\\-16&=5k\\\\-\\frac{16}{5}&=k\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "reuse-s5-p88-q12-h",
        "type": "part",
        "label": "h",
        "prompt": "$6t=4t+8-3t$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=\\frac{8}{5}$",
          "worked": "Collect like terms on the right. Subtract $t$ from both sides, then divide by $5$.\n$$\\begin{align*}6t&=t+8\\\\5t&=8\\\\t&=\\frac{8}{5}\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      }
    ]
