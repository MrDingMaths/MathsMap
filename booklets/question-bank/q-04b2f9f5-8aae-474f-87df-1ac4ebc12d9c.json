  "content": {
    "id": "p14-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "Both the numerator and denominator of $\\frac{4}{5}$ are decreased by the same amount. The resulting fraction equals $\\frac{1}{3}$. How much was the decrease?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{7}{2}$",
      "worked": "Let $x$ be the decrease.\n$$\\begin{align*}\\frac{4-x}{5-x}&=\\frac{1}{3}\\\\3(4-x)&=5-x\\\\12-3x&=5-x\\\\7&=2x\\\\x&=\\frac{7}{2}\\end{align*}$$\nThe decrease was $\\frac{7}{2}$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 62
  },
