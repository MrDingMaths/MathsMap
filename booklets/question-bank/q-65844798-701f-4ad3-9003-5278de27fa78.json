  "content": {
    "id": "p26-q12-root",
    "type": "question",
    "label": "12",
    "prompt": "The number of trees that can be planted along the fence line of a paddock varies inversely with the distance between each tree. There will be 108 trees if the distance between them is 5 metres.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p26-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "How many trees can be planted if the distance between them is 6 metres?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "90 trees",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "449fee09-2150-4dbf-826d-79060390a400-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Let ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "N",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " be the number of trees and ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "d",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " the distance between them in metres.",
                    "marks": []
                  }
                ]
              },
              {
                "id": "3d346c59-9792-46be-8fde-057a295c694c-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}N &= \\frac{k}{d}\\\\108 &= \\frac{k}{5}\\\\540 &= k\\\\N &= \\frac{540}{d}=\\frac{540}{6}=90\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "569a81f6-7401-4fca-9221-9f98d2c441ea-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "90 trees can be planted.",
                    "marks": []
                  }
                ]
              }
            ]
          },
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p26-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "What is the distance between the trees if 120 trees are planted.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$4.5\\text{ m}$",
          "worked": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "04b95d84-2355-4448-9733-66c9a6d901d1-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "Using ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "N=\\frac{540}{d}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": " from part a:",
                    "marks": []
                  }
                ]
              },
              {
                "id": "a301aea4-4237-42e9-88b9-2cc864f65d3c-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\begin{aligned}120 &= \\frac{540}{d}\\\\120d &= 540\\\\d &= \\frac{540}{120}=4.5\\end{aligned}",
                    "display": true
                  }
                ]
              },
              {
                "id": "c9bc79c7-3b2c-482b-b309-01dda331462c-compact-0",
                "type": "paragraph",
                "fontSize": null,
                "align": "left",
                "spaceBefore": 0,
                "spaceAfter": 0,
                "lineHeight": 1.25,
                "indent": 0,
                "inlines": [
                  {
                    "type": "text",
                    "text": "The distance between the trees is ",
                    "marks": []
                  },
                  {
                    "type": "math",
                    "latex": "4.5\\text{ m}",
                    "display": false
                  },
                  {
                    "type": "text",
                    "text": ".",
                    "marks": []
                  }
                ]
              }
            ]
          },
