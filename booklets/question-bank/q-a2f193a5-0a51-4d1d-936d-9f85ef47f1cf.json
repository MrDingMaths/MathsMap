  "content": {
    "id": "p7-q4-root",
    "type": "question",
    "label": "4",
    "prompt": "Find the value of $m$ and $n$ if $(-1,1)$ is the midpoint of points $(m,n)$ and $(-n,m)$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=0,\\ n=2$.",
      "worked": "Using the midpoint formula,\n$$\\begin{align*}\\frac{m-n}{2}&=-1\\\\m-n&=-2\\\\\\frac{n+m}{2}&=1\\\\m+n&=2.\\end{align*}$$\nAdding the two equations gives\n$$\\begin{align*}2m&=0\\\\m&=0.\\end{align*}$$\nSubstituting into $m+n=2$ gives $n=2$.",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 78
  },
