  "content": {
    "id": "p39-q3",
    "type": "question",
    "label": "3",
    "prompt": "To make pink paint, white and red paint need to be mixed in the ratio $3:4$.\nHow much white paint is needed to mix with 10 L of red paint?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "7.5 L",
      "worked": "$$\\begin{align*}4\\text{ parts}&=10\\text{ L}\\\\1\\text{ part}&=(10\\div4)\\text{ L}\\\\1\\text{ part}&=2.5\\text{ L}\\\\3\\text{ parts}&=(2.5\\times3)\\text{ L}\\\\3\\text{ parts}&=7.5\\text{ L}\\end{align*}$$\nYou need 7.5 L of white paint.",
      "solutionDiagrams": []
    },
