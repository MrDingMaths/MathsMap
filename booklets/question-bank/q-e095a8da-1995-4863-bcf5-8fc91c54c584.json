  "content": {
    "id": "p148-q15-response",
    "type": "question",
    "label": "2",
    "prompt": "The line $y=mx-4$ is a tangent to the parabola $y=x^2-2x+5$. Find the value of $m$.",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$m=4$ or $m=-8$.",
      "worked": "Equate the two expressions for $y$.\n$$\\begin{align*}\nmx-4 &= x^2-2x+5\\\\\nx^2-(m+2)x+9 &= 0\n\\end{align*}$$\nFor tangency, the intersection quadratic has one repeated root, so its discriminant is zero.\n$$\\begin{align*}\n\\Delta &= 0\\\\\n(m+2)^2-36 &= 0\\\\\n(m+2)^2 &= 36\\\\\nm+2 &= \\pm6\\\\\nm &= 4\\text{ or }-8\n\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 68
  },
