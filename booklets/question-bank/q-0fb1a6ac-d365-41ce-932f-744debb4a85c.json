      {
        "id": "p34-q14-a",
        "type": "part",
        "label": "a",
        "prompt": "$P(X=2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.3$",
          "worked": "The probabilities sum to $1$.\n$$\\begin{aligned}0.1+0.4+2k+k+0.05&=1\\\\3k&=0.45\\\\k&=0.15\\\\P(X=2)&=2(0.15)\\\\P(X=2)&=0.3\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 28
      },
      {
        "id": "p34-q14-b",
        "type": "part",
        "label": "b",
        "prompt": "$P(X=0)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.1$",
          "worked": "Read the probability corresponding to $x=0$:\n$$P(X=0)=0.1.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 9
      },
      {
        "id": "p34-q14-c",
        "type": "part",
        "label": "c",
        "prompt": "$P(X\\geq2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.5$",
          "worked": "Using $k=0.15$,\n$$\\begin{aligned}P(X\\geq2)&=2k+k+0.05\\\\P(X\\geq2)&=0.3+0.15+0.05\\\\P(X\\geq2)&=0.5.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p34-q14-d",
        "type": "part",
        "label": "d",
        "prompt": "$P(X>2)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.2$",
          "worked": "Using $k=0.15$,\n$$\\begin{aligned}P(X>2)&=k+0.05\\\\P(X>2)&=0.15+0.05\\\\P(X>2)&=0.2.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
      },
      {
        "id": "p34-q14-e",
        "type": "part",
        "label": "e",
        "prompt": "$P(1\\leq X\\leq4)$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.9$",
          "worked": "$$\\begin{aligned}P(1\\leq X\\leq4)&=1-P(X=0)\\\\P(1\\leq X\\leq4)&=1-0.1\\\\P(1\\leq X\\leq4)&=0.9.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 15
      },
      {
        "id": "p34-q14-f",
        "type": "part",
        "label": "f",
        "prompt": "$P(X\\text{ is even})$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$0.45$",
          "worked": "The even outcomes are $0$, $2$ and $4$.\n$$\\begin{aligned}P(X\\text{ is even})&=0.1+0.3+0.05\\\\P(X\\text{ is even})&=0.45.\\end{aligned}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 19
