  "content": {
    "id": "p34-q20-root",
    "type": "question",
    "label": null,
    "prompt": "The population of a town is initially 8000. Every year the population increases by 5%. What is the population of the town after:",
    "layout": "grid",
    "columns": 3,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p34-q20-a",
        "type": "part",
        "label": "a",
        "prompt": "1 year?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "8400 people",
          "worked": "The annual multiplier is $1+0.05=1.05$.\n$$\\begin{align*}P&=8000(1.05)\\\\P&=8400\\end{align*}$$\nThe population is 8400 people.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q20-b",
        "type": "part",
        "label": "b",
        "prompt": "3 years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "9261 people",
          "worked": "$$\\begin{align*}P&=8000(1.05)^3\\\\P&=9261\\end{align*}$$\nThe population is 9261 people.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 24
      },
      {
        "id": "p34-q20-c",
        "type": "part",
        "label": "c",
        "prompt": "$n$ years?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$8000(1.05)^n$ people",
          "worked": "Each year multiplies the population by $1.05$, so after $n$ years:\n$$P=8000(1.05)^n\\text{ people}.$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
