        "answer": {
          "short": "$51$",
          "worked": "$$\\begin{align*}\\text{New value}&=60\\times0.85\\\\&=51\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p38-q3-f",
        "type": "part",
        "label": "f",
        "prompt": "A number is increased by $15\\%$ to $60$. What is the number? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$52.17$",
          "worked": "The final value represents $115\\%$ of the original.\n$$\\begin{align*}115\\%&=60\\\\1\\%&=\\frac{60}{115}\\\\100\\%&=\\frac{60}{115}\\times100\\\\&=\\frac{1200}{23}\\\\&\\approx52.17\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p38-q3-g",
        "type": "part",
        "label": "g",
        "prompt": "A number is decreased by $15\\%$ to $60$. What is the number? Give your answer to 2 decimal places.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$70.59$",
          "worked": "The final value represents $85\\%$ of the original.\n$$\\begin{align*}85\\%&=60\\\\1\\%&=\\frac{60}{85}\\\\100\\%&=\\frac{60}{85}\\times100\\\\&=\\frac{1200}{17}\\\\&\\approx70.59\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p38-q3-h",
        "type": "part",
        "label": "h",
        "prompt": "$15$ increased to $60$. What is the percentage change?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$300\\%$ increase",
          "worked": "$$\\begin{align*}\\text{Increase}&=60-15=45\\\\\\text{Percentage increase}&=\\frac{45}{15}\\times100\\%\\\\&=300\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
