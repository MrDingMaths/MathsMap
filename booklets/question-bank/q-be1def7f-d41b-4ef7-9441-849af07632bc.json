      {
        "id": "p38-q3-a",
        "type": "part",
        "label": "a",
        "prompt": "Calculate $15\\%$ of $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$9$",
          "worked": "$$\\begin{align*}\\text{Amount}&=\\frac{15}{100}\\times60\\\\&=9\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p38-q3-b",
        "type": "part",
        "label": "b",
        "prompt": "Express $15$ as a percentage of $60$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$25\\%$",
          "worked": "$$\\begin{align*}\\text{Percentage}&=\\frac{15}{60}\\times100\\%\\\\&=25\\%\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 17
      },
      {
        "id": "p38-q3-c",
        "type": "part",
        "label": "c",
        "prompt": "$15\\%$ of a number is $60$. What is the number?",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$400$",
          "worked": "$$\\begin{align*}15\\%&=60\\\\1\\%&=\\frac{60}{15}=4\\\\100\\%&=4\\times100=400\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 25
      },
      {
        "id": "p38-q3-d",
        "type": "part",
        "label": "d",
        "prompt": "Increase $60$ by $15\\%$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$69$",
          "worked": "$$\\begin{align*}\\text{New value}&=60\\times1.15\\\\&=69\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 14
      },
      {
        "id": "p38-q3-e",
        "type": "part",
        "label": "e",
        "prompt": "Decrease $60$ by $15\\%$.",
        "layout": "list",
