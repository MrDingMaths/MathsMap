  "content": {
    "id": "p85-q3-root",
    "type": "question",
    "label": "",
    "prompt": "There are five backpackers and four available rooms in a hotel. How many ways can the backpackers be accommodated in the four rooms if each room can hold at most four people?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$1020$ ways.",
      "worked": "Each backpacker can choose any of the 4 rooms, giving $4^5$ allocations before applying the capacity restriction.\n\nAn allocation is invalid only when all 5 backpackers occupy one room. There are 4 such allocations.\n\n$$\\begin{aligned}N&=4^5-4\\\\N&=1024-4\\\\N&=1020\\end{aligned}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 20
  },
