        "answer": {
          "short": "$120:240$",
          "worked": "$$\\begin{align*}\\text{Total parts}&=1+2=3\\\\\\text{One part}&=360\\div3=120\\\\\\text{First share}&=1\\times120=120\\\\\\text{Second share}&=2\\times120=240\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 44
      },
