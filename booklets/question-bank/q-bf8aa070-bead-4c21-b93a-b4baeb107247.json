      {
        "id": "p69-q7-a",
        "type": "part",
        "label": "a",
        "prompt": "Show that $\\dfrac{1}{P}+\\dfrac{1}{1-P}=\\dfrac{1}{P(1-P)}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac{1}{P}+\\dfrac{1}{1-P}=\\dfrac{(1-P)+P}{P(1-P)}=\\dfrac{1}{P(1-P)}$.",
          "worked": "$$\\begin{align*}\\frac{1}{P}+\\frac{1}{1-P}&=\\frac{(1-P)+P}{P(1-P)}\\\\&=\\frac{1}{P(1-P)}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 18
      },
      {
        "id": "p69-q7-b",
        "type": "part",
        "label": "b",
        "prompt": "Solve for $P$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$P=\\dfrac{e^{3t}}{4+e^{3t}}$.",
          "worked": "$$\\begin{align*}\\frac{1}{P(1-P)}\\,dP&=3\\,dt\\\\\\int\\left(\\frac{1}{P}+\\frac{1}{1-P}\\right)\\,dP&=\\int3\\,dt\\\\\\ln|P|-\\ln|1-P|&=3t+D\\\\\\ln\\left|\\frac{P}{1-P}\\right|&=3t+D\\\\\\frac{P}{1-P}&=Ae^{3t}.\\end{align*}$$\nUsing $P(0)=\\dfrac15$:\n$$\\begin{align*}\\frac{\\frac15}{\\frac45}&=Ae^0\\\\A&=\\frac14\\\\4P&=(1-P)e^{3t}\\\\P(4+e^{3t})&=e^{3t}\\\\P&=\\frac{e^{3t}}{4+e^{3t}}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 69
      },
      {
        "id": "p69-q7-c",
        "type": "part",
        "label": "c",
        "prompt": "What proportion of the school has heard the gossip after 1 week? Answer to the nearest percent.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$83\\%$.",
          "worked": "At $t=1$,\n$$\\begin{align*}P(1)&=\\frac{e^3}{4+e^3}\\\\&\\approx83\\%.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 16
      },
      {
        "id": "p69-q7-d",
        "type": "part",
        "label": "d",
        "prompt": "Find the exact time at which half the school has heard the gossip.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$\\dfrac13\\ln4$ weeks.",
          "worked": "Set $P=\\dfrac12$:\n$$\\begin{align*}\\frac12&=\\frac{e^{3t}}{4+e^{3t}}\\\\4+e^{3t}&=2e^{3t}\\\\e^{3t}&=4\\\\3t&=\\ln4\\\\t&=\\frac13\\ln4\\text{ weeks}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 29
      }
    ]
  },
