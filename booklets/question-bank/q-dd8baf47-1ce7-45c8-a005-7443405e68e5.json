    "questionDiagrams": [],
    "children": [
      {
        "id": "p64-q12-a",
        "type": "part",
        "label": "a",
        "prompt": "Given that $(ax+b)^2+c=4x^2-4x+2$ for all $x$, find $a$, $b$ and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=2$, $b=-1$, $c=1$, or $a=-2$, $b=1$, $c=1$.",
          "worked": "Expand and equate coefficients.\n$$\\begin{align*}(ax+b)^2+c&=a^2x^2+2abx+b^2+c\\\\a^2&=4\\\\2ab&=-4\\\\b^2+c&=2\\end{align*}$$\nTaking $a=2$ gives\n$$\\begin{align*}4b&=-4\\\\b&=-1\\\\1+c&=2\\\\c&=1\\end{align*}$$\nThus $a=2$, $b=-1$, $c=1$. Taking $a=-2$ instead gives $b=1$, $c=1$, representing the same square.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 48
      },
      {
        "id": "p64-q12-b",
        "type": "part",
        "label": "b",
        "prompt": "Hence find all values of $k$ for which $4x^2-4x+2=k$ has real solutions.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$k\\geq1$.",
          "worked": "$$\\begin{align*}4x^2-4x+2&=(2x-1)^2+1\\\\(2x-1)^2+1&=k\\\\(2x-1)^2&=k-1\\end{align*}$$\nA real square root exists exactly when\n$$\\begin{align*}k-1&\\geq0\\\\k&\\geq1\\end{align*}$$\nYou can also solve this using the discriminant.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 34
      },
      {
        "id": "p64-q12-c",
        "type": "part",
        "label": "c",
        "prompt": "Given that $a(x+b)^2+c=-2x^2+8x-9$ for all $x$, find $a$, $b$, and $c$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$a=-2$, $b=-2$, $c=-1$.",
          "worked": "Expand and equate coefficients.\n$$\\begin{align*}a(x+b)^2+c&=ax^2+2abx+ab^2+c\\\\a&=-2\\\\2ab&=8\\\\ab^2+c&=-9\\end{align*}$$\nSubstitute $a=-2$.\n$$\\begin{align*}-4b&=8\\\\b&=-2\\\\-2(-2)^2+c&=-9\\\\c&=-1\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 43
      },
      {
        "id": "p64-q12-d",
        "type": "part",
        "label": "d",
        "prompt": "Hence explain why $-2x^2+8x-9$ is negative for all real values of $x$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-2x^2+8x-9=-2(x-2)^2-1\\leq-1<0$ for all real $x$.",
          "worked": "$$\\begin{align*}-2x^2+8x-9&=-2(x-2)^2-1\\end{align*}$$\nFor every real $x$,\n$$\\begin{align*}(x-2)^2&\\geq0\\\\-2(x-2)^2&\\leq0\\\\-2(x-2)^2-1&\\leq-1<0\\end{align*}$$\nTherefore $-2x^2+8x-9$ is negative for all real $x$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 27
      }
    ]
  },
