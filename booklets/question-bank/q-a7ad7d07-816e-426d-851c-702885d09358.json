  "content": {
    "id": "p29-q2-root",
    "type": "question",
    "label": "2",
    "prompt": "Find $f''(x)$ for each function. By evaluating $f''(0)$, state whether the curve is concave up ($f''(x)>0$) or concave down ($f''(x)<0$) at $x=0$.",
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p29-q2-a",
        "type": "part",
        "label": "a",
        "prompt": "$f(x)=x^3-3x^2$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(x)=6x-6$; concave down at $x=0$.",
          "worked": "$$\\begin{align*}f'(x)&=3x^2-6x\\\\f''(x)&=6x-6\\\\f''(0)&=6(0)-6\\\\f''(0)&=-6\\end{align*}$$\nSince $f''(0)<0$, the curve is concave down at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p29-q2-b",
        "type": "part",
        "label": "b",
        "prompt": "$f(x)=x^3+4x^2-5x+7$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(x)=6x+8$; concave up at $x=0$.",
          "worked": "$$\\begin{align*}f'(x)&=3x^2+8x-5\\\\f''(x)&=6x+8\\\\f''(0)&=6(0)+8\\\\f''(0)&=8\\end{align*}$$\nSince $f''(0)>0$, the curve is concave up at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p29-q2-c",
        "type": "part",
        "label": "c",
        "prompt": "$f(x)=x^4+2x^2-3$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(x)=12x^2+4$; concave up at $x=0$.",
          "worked": "$$\\begin{align*}f'(x)&=4x^3+4x\\\\f''(x)&=12x^2+4\\\\f''(0)&=12(0)^2+4\\\\f''(0)&=4\\end{align*}$$\nSince $f''(0)>0$, the curve is concave up at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      },
      {
        "id": "p29-q2-d",
        "type": "part",
        "label": "d",
        "prompt": "$f(x)=6x-7x^2-8x^4$",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$f''(x)=-14-96x^2$; concave down at $x=0$.",
          "worked": "$$\\begin{align*}f'(x)&=6-14x-32x^3\\\\f''(x)&=-14-96x^2\\\\f''(0)&=-14-96(0)^2\\\\f''(0)&=-14\\end{align*}$$\nSince $f''(0)<0$, the curve is concave down at $x=0$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 21
      }
    ]
