  "content": {
    "id": "p24-q19-answer",
    "type": "question",
    "label": "19",
    "prompt": "Two unbiased dice, each with faces numbered 1, 2, 3, 4, 5, 6, are rolled.\n\nWhat is the probability of a 6 appearing on at least one of the dice?",
    "layout": "list",
    "columns": null,
    "questionDiagrams": [],
    "children": [],
    "answer": {
      "short": "$\\frac{11}{36}$",
      "worked": "The complementary event is neither die showing a 6. The rolls are independent.\n\n$$\\begin{align*}P(\\text{at least one 6}) &= 1-P(\\text{neither die shows a 6})\\\\&=1-\\frac{5}{6}\\times\\frac{5}{6}\\\\&=\\frac{11}{36}.\\end{align*}$$",
      "solutionDiagrams": []
    },
    "answerSpaceMm": 32
  },
