            {
              "type": "math",
              "latex": "x(t)=\\frac{4}{t+1}+1",
              "display": true
            }
          ]
        }
      ]
    },
    "layout": "grid",
    "columns": 2,
    "questionDiagrams": [],
    "children": [
      {
        "id": "p77-q18a",
        "type": "part",
        "label": "a",
        "prompt": "Find the initial displacement.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$x(0)=5\\text{ m}$",
          "worked": "$$\\begin{align*}x(0)&=\\frac{4}{0+1}+1\\\\&=5\\text{ m}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      },
      {
        "id": "p77-q18b",
        "type": "part",
        "label": "b",
        "prompt": "Find the initial velocity.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(0)=-4\\text{ m s}^{-1}$",
          "worked": "$$\\begin{align*}v(t)&=x'(t)=-\\frac{4}{(t+1)^2}\\\\v(0)&=-\\frac{4}{(0+1)^2}=-4\\text{ m s}^{-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 22
      },
      {
        "id": "p77-q18c",
        "type": "part",
        "label": "c",
        "prompt": "Find when the speed is $1\\text{ m s}^{-1}$.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=1\\text{ s}$",
          "worked": "$$\\begin{align*}|v(t)|&=1\\\\\\frac{4}{(t+1)^2}&=1\\\\(t+1)^2&=4\\\\t&=1\\quad(t\\geq0).\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 36
      },
      {
        "id": "p77-q18d",
        "type": "part",
        "label": "d",
        "prompt": "Find when the particle is at $x=2$, and its velocity at that instant.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$t=3\\text{ s}$ and $v(3)=-\\frac14\\text{ m s}^{-1}$.\n\nSet $x(t)=2$, then substitute the time into $v(t)$.",
          "worked": "$$\\begin{align*}\\frac{4}{t+1}+1&=2\\\\\\frac{4}{t+1}&=1\\\\t&=3\\\\v(3)&=-\\frac{4}{(3+1)^2}=-\\frac14\\text{ m s}^{-1}.\\end{align*}$$",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 38
      },
      {
        "id": "p77-q18e",
        "type": "part",
        "label": "e",
        "prompt": "Show that the particle is always moving to the left.",
        "layout": "list",
        "columns": null,
        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$v(t)=-\\dfrac{4}{(t+1)^2}<0$ for $t\\geq0$, so the particle always moves left.",
          "worked": "$$v(t)=x'(t)=-\\frac{4}{(t+1)^2}<0\\qquad(t\\geq0).$$\nVelocity is always negative, so the particle always moves to the left.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 20
      }
    ]
  },
