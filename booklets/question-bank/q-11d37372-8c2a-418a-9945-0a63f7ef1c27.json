        "questionDiagrams": [],
        "children": [],
        "answer": {
          "short": "$-7$",
          "worked": "Parallel lines have equal gradients. The coefficient of $x$ is $-7$, so $m_{\\mathrm{par}} = -7$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p20-q1-c",
        "type": "part",
        "label": "c",
        "prompt": "$y = -\\frac{3}{4}x + 2$",
