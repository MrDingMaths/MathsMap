        "children": [],
        "answer": {
          "short": "$4$",
          "worked": "Parallel lines have equal gradients. The coefficient of $x$ is $4$, so $m_{\\mathrm{par}} = 4$.",
          "solutionDiagrams": []
        },
        "answerSpaceMm": 8
      },
      {
        "id": "p20-q1-b",
        "type": "part",
        "label": "b",
        "prompt": "$y = -7x - 1$",
