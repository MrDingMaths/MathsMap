    "content": {
      "id": "p30-gp-root",
      "type": "group",
      "label": "",
      "prompt": "Simplify these expressions.",
      "layout": "grid",
      "columns": 3,
      "children": [
        {
          "id": "p30-gp-a",
          "type": "part",
          "label": "a",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p30-gp-a-expr",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\mathrel{\\phantom{=}}\\frac{x+6}{2}+\\frac{x}{5}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p30-gp-a-scaffold",
                "type": "paragraph",
                "align": "left",
                "spaceBefore": 2,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "=\\frac{\\left(\\phantom{\\boxed{\\rule{0pt}{5mm}\\hspace{14mm}}}\\right)}{10}+\\frac{\\boxed{\\rule{0pt}{5mm}\\hspace{10mm}}}{10}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "answerSpaceMm": 28,
          "answer": {
            "short": "$\\frac{7x+30}{10}$",
            "worked": "$$\\begin{aligned}\\frac{x+6}{2}+\\frac{x}{5}&=\\frac{5(x+6)}{10}+\\frac{2x}{10}\\\\&=\\frac{5x+30+2x}{10}\\\\&=\\frac{7x+30}{10}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-gp-b",
          "type": "part",
          "label": "b",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p30-gp-b-expr",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\mathrel{\\phantom{=}}\\frac{x+3}{3}+\\frac{x}{4}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p30-gp-b-scaffold",
                "type": "paragraph",
                "align": "left",
                "spaceBefore": 2,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "=\\frac{\\left(\\phantom{\\boxed{\\rule{0pt}{5mm}\\hspace{14mm}}}\\right)}{12}+\\frac{\\boxed{\\rule{0pt}{5mm}\\hspace{10mm}}}{12}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "answerSpaceMm": 28,
          "answer": {
            "short": "$\\frac{7x+12}{12}$",
            "worked": "$$\\begin{aligned}\\frac{x+3}{3}+\\frac{x}{4}&=\\frac{4(x+3)}{12}+\\frac{3x}{12}\\\\&=\\frac{4x+12+3x}{12}\\\\&=\\frac{7x+12}{12}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\frac{2x+5}{5}+\\frac{x}{10}$",
          "answerSpaceMm": 36,
          "answer": {
            "short": "$\\frac{x+2}{2}$",
            "worked": "$$\\begin{aligned}\\frac{2x+5}{5}+\\frac{x}{10}&=\\frac{2(2x+5)}{10}+\\frac{x}{10}\\\\&=\\frac{4x+10+x}{10}\\\\&=\\frac{5x+10}{10}\\\\&=\\frac{x+2}{2}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-gp-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\frac{x+1}{2}+\\frac{x+3}{5}$",
          "answerSpaceMm": 36,
          "answer": {
            "short": "$\\frac{7x+11}{10}$",
            "worked": "$$\\begin{aligned}\\frac{x+1}{2}+\\frac{x+3}{5}&=\\frac{5(x+1)}{10}+\\frac{2(x+3)}{10}\\\\&=\\frac{5x+5+2x+6}{10}\\\\&=\\frac{7x+11}{10}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-gp-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\frac{y+4}{5}+\\frac{y-3}{6}$",
          "answerSpaceMm": 36,
          "answer": {
            "short": "$\\frac{11y+9}{30}$",
            "worked": "$$\\begin{aligned}\\frac{y+4}{5}+\\frac{y-3}{6}&=\\frac{6(y+4)}{30}+\\frac{5(y-3)}{30}\\\\&=\\frac{6y+24+5y-15}{30}\\\\&=\\frac{11y+9}{30}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-gp-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\frac{2x-3}{6}+\\frac{x+2}{8}$",
          "answerSpaceMm": 36,
          "answer": {
            "short": "$\\frac{11x-6}{24}$",
            "worked": "$$\\begin{aligned}\\frac{2x-3}{6}+\\frac{x+2}{8}&=\\frac{4(2x-3)}{24}+\\frac{3(x+2)}{24}\\\\&=\\frac{8x-12+3x+6}{24}\\\\&=\\frac{11x-6}{24}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
