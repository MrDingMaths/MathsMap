    "content": {
      "id": "p56-t3-root",
      "type": "group",
      "label": "",
      "prompt": "Rationalise these expressions.",
      "layout": "grid",
      "columns": 3,
      "children": [
        {
          "id": "p56-q1a",
          "type": "part",
          "label": "a",
          "prompt": "$\\frac{1}{\\sqrt{3}-1}\\times{\\color{#ef6068}\\frac{\\sqrt{3}+1}{\\sqrt{3}+1}}$",
          "answerSpaceMm": 52,
          "answer": {
            "short": "$\\frac{\\sqrt{3}+1}{2}$",
            "worked": "$$\\begin{aligned}\\frac{1}{\\sqrt{3}-1}&=\\frac{1}{\\sqrt{3}-1}\\times\\frac{\\sqrt{3}+1}{\\sqrt{3}+1}\\\\&=\\frac{\\sqrt{3}+1}{3-1}\\\\&=\\frac{\\sqrt{3}+1}{2}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p56-q1b",
          "type": "part",
          "label": "b",
          "prompt": "$\\frac{1}{\\sqrt{5}-\\sqrt{2}}$",
          "answerSpaceMm": 52,
          "answer": {
            "short": "$\\frac{\\sqrt{5}+\\sqrt{2}}{3}$",
            "worked": "$$\\begin{aligned}\\frac{1}{\\sqrt{5}-\\sqrt{2}}&=\\frac{1}{\\sqrt{5}-\\sqrt{2}}\\times\\frac{\\sqrt{5}+\\sqrt{2}}{\\sqrt{5}+\\sqrt{2}}\\\\&=\\frac{\\sqrt{5}+\\sqrt{2}}{5-2}\\\\&=\\frac{\\sqrt{5}+\\sqrt{2}}{3}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p56-q1c",
          "type": "part",
          "label": "c",
          "prompt": "$\\frac{4}{\\sqrt{3}+\\sqrt{2}}$",
          "answerSpaceMm": 52,
          "answer": {
            "short": "$4\\sqrt{3}-4\\sqrt{2}$",
            "worked": "$$\\begin{aligned}\\frac{4}{\\sqrt{3}+\\sqrt{2}}&=\\frac{4}{\\sqrt{3}+\\sqrt{2}}\\times\\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{3}-\\sqrt{2}}\\\\&=\\frac{4\\sqrt{3}-4\\sqrt{2}}{3-2}\\\\&=4\\sqrt{3}-4\\sqrt{2}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p56-q1d",
          "type": "part",
          "label": "d",
          "prompt": "$\\frac{\\sqrt{3}-4}{\\sqrt{3}+4}$",
          "answerSpaceMm": 62,
          "answer": {
            "short": "$\\frac{-19+8\\sqrt{3}}{13}$",
            "worked": "$$\\begin{aligned}\\frac{\\sqrt{3}-4}{\\sqrt{3}+4}&=\\frac{\\sqrt{3}-4}{\\sqrt{3}+4}\\times\\frac{\\sqrt{3}-4}{\\sqrt{3}-4}\\\\&=\\frac{3-8\\sqrt{3}+16}{3-16}\\\\&=\\frac{19-8\\sqrt{3}}{-13}\\\\&=\\frac{-19+8\\sqrt{3}}{13}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p56-q1e",
          "type": "part",
          "label": "e",
          "prompt": "$\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}$",
          "answerSpaceMm": 52,
          "answer": {
            "short": "$\\frac{28+10\\sqrt{7}}{3}$",
            "worked": "$$\\begin{aligned}\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}&=\\frac{2\\sqrt{7}}{2\\sqrt{7}-5}\\times\\frac{2\\sqrt{7}+5}{2\\sqrt{7}+5}\\\\&=\\frac{28+10\\sqrt{7}}{28-25}\\\\&=\\frac{28+10\\sqrt{7}}{3}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p56-q1f",
          "type": "part",
          "label": "f",
          "prompt": "$\\frac{2\\sqrt{3}}{\\sqrt{5}+2\\sqrt{6}}$",
          "answerSpaceMm": 62,
          "answer": {
            "short": "$\\frac{-2\\sqrt{15}+12\\sqrt{2}}{19}$",
            "worked": "$$\\begin{aligned}\\frac{2\\sqrt{3}}{\\sqrt{5}+2\\sqrt{6}}&=\\frac{2\\sqrt{3}}{\\sqrt{5}+2\\sqrt{6}}\\times\\frac{\\sqrt{5}-2\\sqrt{6}}{\\sqrt{5}-2\\sqrt{6}}\\\\&=\\frac{2\\sqrt{15}-4\\sqrt{18}}{5-24}\\\\&=\\frac{2\\sqrt{15}-12\\sqrt{2}}{-19}\\\\&=\\frac{-2\\sqrt{15}+12\\sqrt{2}}{19}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
