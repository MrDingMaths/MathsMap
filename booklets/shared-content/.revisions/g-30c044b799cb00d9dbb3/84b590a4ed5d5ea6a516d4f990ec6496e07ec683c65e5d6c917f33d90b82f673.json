          "id": "p29-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$7^{n+2}+7^n$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$50\\times7^n$",
            "worked": "$$\\begin{align*}7^{n+2}+7^n&=7^n(7^2+1)\\\\&=7^n(49+1)\\\\&=50\\times7^n\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p29-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$4^n+12^n$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$4^n(1+3^n)$ or $2^{2n}(1+3^n)$",
            "worked": "$$\\begin{align*}4^n+12^n&=4^n+4^n\\times3^n\\\\&=4^n(1+3^n)\\\\&=2^{2n}(1+3^n)\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p29-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$2^{2n+2}-2^{2n-1}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$7\\times2^{2n-1}$ or $3.5\\times2^{2n}$",
            "worked": "$$\\begin{align*}2^{2n+2}-2^{2n-1}&=2^{2n-1}(2^3-1)\\\\&=2^{2n-1}(8-1)\\\\&=7\\times2^{2n-1}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p29-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{3^{n+3}-3^n}{3^n}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$26$",
            "worked": "$$\\begin{align*}\\frac{3^{n+3}-3^n}{3^n}&=\\frac{3^n(3^3-1)}{3^n}\\\\&=27-1\\\\&=26\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
