    "content": {
      "id": "p41-q24-root",
      "type": "question",
      "label": "24",
      "prompt": "Four identical balls are numbered 1, 2, 3 and 4 and put into a box. A ball is randomly drawn from the box, and not returned to the box. A second ball is then randomly drawn from the box.",
      "children": [
        {
          "id": "p41-q24-a",
          "type": "part",
          "label": "a",
          "prompt": "What is the probability that the first ball drawn is numbered 4 and the second ball drawn is numbered 1?",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$\\frac{1}{12}$",
            "worked": "$$\\begin{align*}P(4,1)&=\\frac{1}{4}\\times\\frac{1}{3}\\\\P(4,1)&=\\frac{1}{12}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "source"
            }
          }
        },
        {
          "id": "p41-q24-b",
          "type": "part",
          "label": "b",
          "prompt": "What is the probability that the sum of the numbers on the two balls is 5?",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$\\frac{1}{3}$",
            "worked": "The favourable ordered outcomes are $(1,4)$, $(2,3)$, $(3,2)$ and $(4,1)$. There are $4\\times3=12$ equally likely ordered outcomes.\n$$\\begin{align*}P(\\text{sum}=5)&=\\frac{4}{12}\\\\P(\\text{sum}=5)&=\\frac{1}{3}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p41-q24-c",
          "type": "part",
          "label": "c",
          "prompt": "Given that the sum of the numbers on the two balls is 5, what is the probability that the second ball drawn is numbered 1?",
          "answerSpaceMm": 23,
          "answer": {
            "short": "$\\frac{1}{4}$",
            "worked": "Only $(4,1)$ gives a sum of 5 with the second ball numbered 1.\n$$\\begin{align*}P(\\text{second}=1\\mid\\text{sum}=5)&=\\frac{P(4,1)}{P(\\text{sum}=5)}\\\\P(\\text{second}=1\\mid\\text{sum}=5)&=\\frac{\\frac{1}{12}}{\\frac{1}{3}}\\\\P(\\text{second}=1\\mid\\text{sum}=5)&=\\frac{1}{4}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "source"
            }
          }
        }
      ]
    },
    "sourceReview": {
      "teachingContext": [
        {
          "pageNumber": 27,
          "method": "Restrict the sample space to the given event."
        },
        {
