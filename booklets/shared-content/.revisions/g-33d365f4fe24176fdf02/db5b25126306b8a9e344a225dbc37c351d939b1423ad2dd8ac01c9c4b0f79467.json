                  "align": "left",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "The product of an expression and its conjugate is a difference of two squares."
                    }
                  ],
                  "spaceAfter": 1
                }
              ]
            },
            {
              "id": "p52-conjugate-product-bullet-2",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p52-conjugate-product-bullet-text-2",
                  "type": "paragraph",
                  "align": "left",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "A conjugate product has no surds."
                    }
                  ],
                  "spaceAfter": 1
                }
              ]
            }
          ]
        },
        {
          "id": "p52-conjugate-product-formulas",
