          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\color{#268cff}\\frac{2x+1}{x(x+1)}$",
            "worked": "$$\\begin{align*}\\frac{1}{x}+\\frac{1}{x+1}&=\\frac{x+1}{x(x+1)}+\\frac{x}{x(x+1)}\\\\&=\\frac{x+1+x}{x(x+1)}\\\\&=\\frac{2x+1}{x(x+1)}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{4}{x+1}+\\dfrac{3}{x-2}$",
          "answerSpaceMm": 32,
          "answer": {
            "short": "$\\color{#268cff}\\frac{7x-5}{(x+1)(x-2)}$",
            "worked": "$$\\begin{align*}\\frac{4}{x+1}+\\frac{3}{x-2}&=\\frac{4(x-2)}{(x+1)(x-2)}+\\frac{3(x+1)}{(x+1)(x-2)}\\\\&=\\frac{4x-8+3x+3}{(x+1)(x-2)}\\\\&=\\frac{7x-5}{(x+1)(x-2)}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{2}{x-3}-\\dfrac{3}{x-2}$",
          "answerSpaceMm": 40,
          "answer": {
            "short": "$\\color{#268cff}\\frac{-x+5}{(x-3)(x-2)}$",
            "worked": "$$\\begin{align*}\\frac{2}{x-3}-\\frac{3}{x-2}&=\\frac{2(x-2)}{(x-3)(x-2)}-\\frac{3(x-3)}{(x-3)(x-2)}\\\\&=\\frac{2x-4-(3x-9)}{(x-3)(x-2)}\\\\&=\\frac{2x-4-3x+9}{(x-3)(x-2)}\\\\&=\\frac{-x+5}{(x-3)(x-2)}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{3}{(x-1)^2}-\\dfrac{2}{x-1}$",
          "answerSpaceMm": 32,
          "answer": {
            "short": "$\\color{#268cff}\\frac{5-2x}{(x-1)^2}$",
            "worked": "$$\\begin{align*}\\frac{3}{(x-1)^2}-\\frac{2}{x-1}&=\\frac{3}{(x-1)^2}-\\frac{2(x-1)}{(x-1)^2}\\\\&=\\frac{3-2x+2}{(x-1)^2}\\\\&=\\frac{5-2x}{(x-1)^2}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\dfrac{2x}{x-5}-\\dfrac{x}{x+1}$",
          "answerSpaceMm": 40,
          "answer": {
            "short": "$\\color{#268cff}\\frac{x^2+7x}{(x-5)(x+1)}$",
            "worked": "$$\\begin{align*}\\frac{2x}{x-5}-\\frac{x}{x+1}&=\\frac{2x(x+1)}{(x-5)(x+1)}-\\frac{x(x-5)}{(x-5)(x+1)}\\\\&=\\frac{2x^2+2x-(x^2-5x)}{(x-5)(x+1)}\\\\&=\\frac{2x^2+2x-x^2+5x}{(x-5)(x+1)}\\\\&=\\frac{x^2+7x}{(x-5)(x+1)}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{2}{x^2-4}-\\dfrac{3}{x+2}$",
          "answerSpaceMm": 40,
          "answer": {
            "short": "$\\color{#268cff}\\frac{8-3x}{(x-2)(x+2)}$",
            "worked": "$$\\begin{align*}\\frac{2}{x^2-4}-\\frac{3}{x+2}&=\\frac{2}{(x-2)(x+2)}-\\frac{3}{x+2}\\\\&=\\frac{2}{(x-2)(x+2)}-\\frac{3(x-2)}{(x-2)(x+2)}\\\\&=\\frac{2-3x+6}{(x-2)(x+2)}\\\\&=\\frac{8-3x}{(x-2)(x+2)}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
