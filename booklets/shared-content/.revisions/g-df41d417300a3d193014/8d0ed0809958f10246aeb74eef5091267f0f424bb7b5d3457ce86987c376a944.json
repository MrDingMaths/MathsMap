            "worked": "$\\begin{aligned}\\left(\\frac{x^3}{y}\\right)^{-2}&=\\left(\\frac{y}{x^3}\\right)^2\\\\&=\\frac{y^2}{x^6}\\end{aligned}$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p9-guided-d-node",
          "type": "part",
