          "answer": {
            "short": "$\\frac{x^5}{3y}$",
            "worked": "$\\begin{aligned}\\left(\\frac{3y}{x^5}\\right)^{-1}&=\\frac{x^5}{3y}\\end{aligned}$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p9-guided-e-node",
          "type": "part",
          "label": "e",
          "prompt": "$\\left(\\frac{2x^5}{y}\\right)^{-3}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\frac{y^3}{8x^{15}}$",
            "worked": "$\\begin{aligned}\\left(\\frac{2x^5}{y}\\right)^{-3}&=\\left(\\frac{y}{2x^5}\\right)^3\\\\&=\\frac{y^3}{8x^{15}}\\end{aligned}$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
