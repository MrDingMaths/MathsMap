            "worked": "$$\\begin{align*}\\text{Original length}&=45\\times200\\text{ mm}\\\\&=9000\\text{ mm}\\\\&=9\\text{ m}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-h",
          "type": "part",
          "label": "h",
          "prompt": "Scale $1:200$. An original length is 7.2 m.\nFind the drawing length in centimetres.",
