        {
          "id": "p33-q6-a",
          "type": "part",
          "label": "a",
          "prompt": "Scale $1:500$. An image length is 3 cm.\nFind the original length in metres.",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$15\\text{ m}$",
            "worked": "$$\\begin{align*}\\text{Original length}&=3\\times500\\text{ cm}\\\\&=1500\\text{ cm}\\\\&=15\\text{ m}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-b",
          "type": "part",
          "label": "b",
          "prompt": "Scale $1:500$. An original length is 20 m.\nFind the image length in centimetres.",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$4\\text{ cm}$",
            "worked": "$$\\begin{align*}\\text{Image length}&=20\\div500\\text{ m}\\\\&=0.04\\text{ m}\\\\&=4\\text{ cm}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-c",
          "type": "part",
          "label": "c",
          "prompt": "Scale $1:25\\,000$. A map distance is 6 cm.\nFind the original distance in kilometres.",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$1.5\\text{ km}$",
            "worked": "$$\\begin{align*}\\text{Original distance}&=6\\times25\\,000\\text{ cm}\\\\&=150\\,000\\text{ cm}\\\\&=1.5\\text{ km}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-d",
          "type": "part",
          "label": "d",
          "prompt": "Scale $1:25\\,000$. Two places are 3 km apart.\nFind their map distance in centimetres.",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$12\\text{ cm}$",
            "worked": "$$\\begin{align*}\\text{Original distance}&=300\\,000\\text{ cm}\\\\\\text{Map distance}&=300\\,000\\div25\\,000\\text{ cm}\\\\&=12\\text{ cm}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-e",
          "type": "part",
          "label": "e",
          "prompt": "Scale $50:1$. An object is 8 mm long.\nFind the image length in centimetres.",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$40\\text{ cm}$",
            "worked": "$$\\begin{align*}\\text{Image length}&=8\\times50\\text{ mm}\\\\&=400\\text{ mm}\\\\&=40\\text{ cm}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-f",
          "type": "part",
          "label": "f",
          "prompt": "Scale $50:1$. An image is 30 cm long.\nFind the original length in millimetres.",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$6\\text{ mm}$",
            "worked": "$$\\begin{align*}\\text{Original length}&=30\\div50\\text{ cm}\\\\&=0.6\\text{ cm}\\\\&=6\\text{ mm}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q6-g",
          "type": "part",
          "label": "g",
          "prompt": "Scale $1:200$. A drawing length is 45 mm.\nFind the original length in metres.",
          "answerSpaceMm": 26,
          "answer": {
