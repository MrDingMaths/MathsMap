          "prompt": "$\\dfrac{1}{\\sqrt{3}}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{\\sqrt{3}}{3}$",
            "worked": "$$\\begin{align*}\\frac{1}{\\sqrt{3}}&=\\frac{1}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{\\sqrt{3}}{3}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p48-guided-part-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{\\sqrt{2}}{\\sqrt{3}}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{\\sqrt{6}}{3}$",
            "worked": "$$\\begin{align*}\\frac{\\sqrt{2}}{\\sqrt{3}}&=\\frac{\\sqrt{2}}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{\\sqrt{6}}{3}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p48-guided-part-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{1+\\sqrt{2}}{\\sqrt{3}}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{\\sqrt{3}+\\sqrt{6}}{3}$",
            "worked": "$$\\begin{align*}\\frac{1+\\sqrt{2}}{\\sqrt{3}}&=\\frac{1+\\sqrt{2}}{\\sqrt{3}}\\times\\frac{\\sqrt{3}}{\\sqrt{3}}\\\\&=\\frac{(1+\\sqrt{2})\\sqrt{3}}{3}\\\\&=\\frac{\\sqrt{3}+\\sqrt{6}}{3}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p48-guided-part-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{\\sqrt{6}-5}{\\sqrt{2}}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{2\\sqrt{3}-5\\sqrt{2}}{2}$",
            "worked": "$$\\begin{align*}\\frac{\\sqrt{6}-5}{\\sqrt{2}}&=\\frac{\\sqrt{6}-5}{\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\&=\\frac{\\sqrt{12}-5\\sqrt{2}}{2}\\\\&=\\frac{2\\sqrt{3}-5\\sqrt{2}}{2}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p48-guided-part-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\dfrac{\\sqrt{3}}{2\\sqrt{2}}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{\\sqrt{6}}{4}$",
            "worked": "$$\\begin{align*}\\frac{\\sqrt{3}}{2\\sqrt{2}}&=\\frac{\\sqrt{3}}{2\\sqrt{2}}\\times\\frac{\\sqrt{2}}{\\sqrt{2}}\\\\&=\\frac{\\sqrt{6}}{4}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p48-guided-part-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{8+3\\sqrt{2}}{4\\sqrt{5}}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{8\\sqrt{5}+3\\sqrt{10}}{20}$",
            "worked": "$$\\begin{align*}\\frac{8+3\\sqrt{2}}{4\\sqrt{5}}&=\\frac{8+3\\sqrt{2}}{4\\sqrt{5}}\\times\\frac{\\sqrt{5}}{\\sqrt{5}}\\\\&=\\frac{(8+3\\sqrt{2})\\sqrt{5}}{20}\\\\&=\\frac{8\\sqrt{5}+3\\sqrt{10}}{20}\\end{align*}$$",
            "provenance": {
