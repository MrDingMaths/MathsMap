    "content": {
      "id": "p108-q37-content",
      "type": "question",
      "label": "37",
      "prompt": "We can write $\\frac{1}{6}$ as the sum of two fractions, each with 1 as the numerator, as $\\frac{1}{7}+\\frac{1}{42}$. This can be done in four other ways. Find these.",
      "answerSpaceMm": 88,
      "answer": {
        "short": "$\\frac{1}{8}+\\frac{1}{24},\\quad \\frac{1}{9}+\\frac{1}{18},\\quad \\frac{1}{10}+\\frac{1}{15},\\quad \\frac{1}{12}+\\frac{1}{12}$.",
        "worked": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p108-q37-answer",
              "type": "paragraph",
              "align": "left",
              "inlines": [
                {
                  "type": "text",
                  "text": "Let "
                },
                {
                  "type": "math",
                  "latex": "\\frac{1}{6}=\\frac{1}{x}+\\frac{1}{y}",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", where x and y are positive integers."
                }
              ]
            },
            {
              "id": "p108-q37-answer-derivation",
              "type": "paragraph",
              "align": "left",
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}\\frac{1}{y}&=\\frac{1}{6}-\\frac{1}{x}\\\\\\frac{1}{y}&=\\frac{x-6}{6x}\\\\y&=\\frac{6x}{x-6}\\\\y&=6+\\frac{36}{x-6}\\end{aligned}",
                  "display": true
                }
              ]
            },
            {
              "id": "p108-q37-answer-factors",
              "type": "paragraph",
              "align": "left",
              "inlines": [
                {
                  "type": "text",
                  "text": "For y to be an integer, "
                },
                {
                  "type": "math",
                  "latex": "x-6",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " must be a factor of 36. Excluding the supplied pair and counting reversed pairs only once, use "
                },
                {
                  "type": "math",
                  "latex": "x-6=2,3,4,6",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ". This gives "
                },
                {
                  "type": "math",
                  "latex": "x=8,9,10,12",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " and "
                },
                {
                  "type": "math",
                  "latex": "y=24,18,15,12",
                  "display": false
                },
                {
                  "type": "text",
                  "text": ", respectively."
                }
              ]
            },
            {
              "id": "p108-q37-answer-pairs",
              "type": "paragraph",
              "align": "left",
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{aligned}\\frac{1}{6}&=\\frac{1}{8}+\\frac{1}{24}\\\\\\frac{1}{6}&=\\frac{1}{9}+\\frac{1}{18}\\\\\\frac{1}{6}&=\\frac{1}{10}+\\frac{1}{15}\\\\\\frac{1}{6}&=\\frac{1}{12}+\\frac{1}{12}\\end{aligned}",
                  "display": true
                }
              ]
            }
          ]
        },
