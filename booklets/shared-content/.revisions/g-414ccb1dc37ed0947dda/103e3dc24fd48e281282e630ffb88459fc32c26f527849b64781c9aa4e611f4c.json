          "answer": {
            "short": "$\\dfrac{32x^{5}}{y^{5}}$",
            "worked": "$$\\begin{aligned}\\left(\\frac{2x}{y}\\right)^{5}&=\\frac{2^{5}x^{5}}{y^{5}}\\\\\\left(\\frac{2x}{y}\\right)^{5}&=\\frac{32x^{5}}{y^{5}}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
