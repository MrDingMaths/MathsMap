          "answer": {
            "short": "$\\dfrac{3n^{6}}{4m^{2}}$",
            "worked": "$$\\begin{aligned}3\\left(\\frac{n^{3}}{2m}\\right)^{2}&=3\\times\\frac{(n^{3})^{2}}{2^{2}m^{2}}\\\\3\\left(\\frac{n^{3}}{2m}\\right)^{2}&=3\\times\\frac{n^{6}}{4m^{2}}\\\\3\\left(\\frac{n^{3}}{2m}\\right)^{2}&=\\frac{3n^{6}}{4m^{2}}\\end{aligned}$$",
            "provenance": {
              "short": "source",
