        "prompt": "$\\frac{x-1}{3}-\\frac{x+4}{5}$",
        "theorySolution": "$$\\begin{array}{ll}{\\color{#ef6068}\\text{1. same denominators}}&\\color{#268cff}\\frac{5(x-1)}{15}-\\frac{3(x+4)}{15}\\\\{\\color{#ef6068}\\text{2. subtract}}&\\color{#268cff}\\frac{5(x-1)-3(x+4)}{15}\\\\{\\color{#ef6068}\\text{3. simplify}}&\\mathrel{\\phantom{=}}\\color{#268cff}\\frac{5x-5-3x-12}{15}\\\\&\\color{#268cff}=\\frac{2x-17}{15}\\end{array}$$"
      },
      {
        "id": "p32-ex2",
        "label": "",
        "prompt": "$\\frac{2x-3}{6}-\\frac{3-x}{5}$",
        "theorySolution": "$$\\begin{array}{ll}{\\color{#ef6068}\\text{1. same denominators}}&\\color{#268cff}\\frac{5(2x-3)}{30}-\\frac{6(3-x)}{30}\\\\{\\color{#ef6068}\\text{2. subtract}}&\\color{#268cff}\\frac{5(2x-3)-6(3-x)}{30}\\\\{\\color{#ef6068}\\text{3. simplify}}&\\mathrel{\\phantom{=}}\\color{#268cff}\\frac{10x-15-18+6x}{30}\\\\&\\color{#268cff}=\\frac{16x-33}{30}\\end{array}$$"
      }
    ],
