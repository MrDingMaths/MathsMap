                    "type": "math",
                    "latex": "\\dfrac{2x+1}{3}=\\dfrac{\\boxed{\\rule{0pt}{5mm}\\hspace{18mm}}}{12}",
                    "display": true
                  }
                ]
              },
              {
                "id": "p3-guided-a-scaffold",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "=\\dfrac{(2x+1)\\,\\color{#ef6068}{\\times4}}{3\\,\\color{#ef6068}{\\times4}}",
                    "display": true,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\dfrac{8x+4}{12}$",
            "worked": "$$\\begin{aligned}\\dfrac{2x+1}{3}&=\\dfrac{4(2x+1)}{12}\\\\&=\\dfrac{8x+4}{12}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-equivalent-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$$\\dfrac{5x-8}{2}=\\dfrac{\\boxed{\\rule{0pt}{5mm}\\hspace{18mm}}}{6}$$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\dfrac{15x-24}{6}$",
            "worked": "$$\\begin{aligned}\\dfrac{5x-8}{2}&=\\dfrac{3(5x-8)}{6}\\\\&=\\dfrac{15x-24}{6}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-equivalent-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$$\\dfrac{6x-8}{4}=\\dfrac{\\boxed{\\rule{0pt}{5mm}\\hspace{18mm}}}{2}$$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\dfrac{3x-4}{2}$",
            "worked": "$$\\begin{aligned}\\dfrac{6x-8}{4}&=\\dfrac{(6x-8)\\div2}{4\\div2}\\\\&=\\dfrac{3x-4}{2}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-equivalent-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$$\\dfrac{12x+14}{6}=\\dfrac{\\boxed{\\rule{0pt}{5mm}\\hspace{18mm}}}{3}$$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\dfrac{6x+7}{3}$",
            "worked": "$$\\begin{aligned}\\dfrac{12x+14}{6}&=\\dfrac{(12x+14)\\div2}{6\\div2}\\\\&=\\dfrac{6x+7}{3}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-equivalent-guided-e",
          "type": "part",
