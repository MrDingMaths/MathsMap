          "prompt": "$$\\frac{5-x}{x-5}$$",
          "answerSpaceMm": 22,
          "answer": {
            "short": "$-1$",
            "worked": "$$\\begin{aligned}\\frac{5-x}{x-5}&=\\frac{-(x-5)}{x-5}\\\\&=-1\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p5-guided-b-node",
          "type": "part",
          "label": "b",
          "prompt": "$$\\frac{2x-7}{7-2x}$$",
          "answerSpaceMm": 22,
          "answer": {
            "short": "$-1$",
            "worked": "$$\\begin{aligned}\\frac{2x-7}{7-2x}&=\\frac{-(7-2x)}{7-2x}\\\\&=-1\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p5-guided-c-node",
          "type": "part",
          "label": "c",
          "prompt": "$$\\frac{6-9x}{3x-2}$$",
          "answerSpaceMm": 22,
          "answer": {
            "short": "$-3$",
            "worked": "$$\\begin{aligned}\\frac{6-9x}{3x-2}&=\\frac{-3(3x-2)}{3x-2}\\\\&=-3\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p5-guided-d-node",
          "type": "part",
          "label": "d",
          "prompt": "$$\\frac{5-10x}{6x-3}$$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$-\\frac{5}{3}$",
            "worked": "$$\\begin{aligned}\\frac{5-10x}{6x-3}&=\\frac{5(1-2x)}{3(2x-1)}\\\\&=\\frac{-5(2x-1)}{3(2x-1)}\\\\&=-\\frac{5}{3}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p5-guided-e-node",
          "type": "part",
          "label": "e",
          "prompt": "$$\\frac{16-x^2}{x-4}$$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$-(x+4)$",
            "worked": "$$\\begin{aligned}\\frac{16-x^2}{x-4}&=\\frac{(4-x)(4+x)}{x-4}\\\\&=\\frac{-(x-4)(x+4)}{x-4}\\\\&=-(x+4)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p5-guided-f-node",
          "type": "part",
          "label": "f",
          "prompt": "$$\\frac{x^2-9}{3-x}$$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$-(x+3)$",
            "worked": "$$\\begin{aligned}\\frac{x^2-9}{3-x}&=\\frac{(x-3)(x+3)}{3-x}\\\\&=\\frac{-(3-x)(x+3)}{3-x}\\\\&=-(x+3)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
