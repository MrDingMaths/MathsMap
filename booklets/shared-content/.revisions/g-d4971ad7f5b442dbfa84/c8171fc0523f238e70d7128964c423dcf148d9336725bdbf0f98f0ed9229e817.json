    "classification": {
      "primarySkillId": "simplify-fractions-by-factorising",
      "secondarySkillIds": [],
      "reasoningScore": 40,
      "difficulty": "Development",
      "difficultyReason": "Multiply and divide algebraic fractions given in factorised form by cancelling common binomial factors, including a reversed bracket."
    },
    "content": {
      "id": "p36-g2",
      "type": "group",
      "label": "",
      "prompt": "Simplify these fractions by cancelling common factors.",
      "layout": "grid",
      "columns": 2,
      "children": [
        {
          "id": "p36-g2-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\dfrac{(x+2)(x-3)}{(x+1)(x+2)}\\times\\dfrac{(x+1)(x+5)}{(x-3)(x+4)}$",
          "answerSpaceMm": 45,
          "answer": {
            "short": "$\\dfrac{x+5}{x+4}$",
            "worked": "$$\\begin{aligned}\\frac{(x+2)(x-3)}{(x+1)(x+2)}\\times\\frac{(x+1)(x+5)}{(x-3)(x+4)}&=\\frac{(x+2)(x-3)(x+1)(x+5)}{(x+1)(x+2)(x-3)(x+4)}\\\\&=\\frac{x+5}{x+4}\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p36-g2-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{3(x-1)}{(x+2)(x-1)}\\times\\dfrac{(x+2)(x+3)}{6}$",
          "answerSpaceMm": 45,
          "answer": {
            "short": "$\\dfrac{x+3}{2}$",
            "worked": "$$\\begin{aligned}\\frac{3(x-1)}{(x+2)(x-1)}\\times\\frac{(x+2)(x+3)}{6}&=\\frac{3(x-1)(x+2)(x+3)}{6(x+2)(x-1)}\\\\&=\\frac{3(x+3)}{6}\\\\&=\\frac{x+3}{2}\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p36-g2-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{(x+4)(x-2)}{(x+3)(x+4)}\\div\\dfrac{(x-2)}{(x+3)(x+1)}$",
          "answerSpaceMm": 45,
          "answer": {
            "short": "$x+1$",
            "worked": "$$\\begin{aligned}\\frac{(x+4)(x-2)}{(x+3)(x+4)}\\div\\frac{x-2}{(x+3)(x+1)}&=\\frac{(x+4)(x-2)}{(x+3)(x+4)}\\times\\frac{(x+3)(x+1)}{x-2}\\\\&=\\frac{(x+4)(x-2)(x+3)(x+1)}{(x+3)(x+4)(x-2)}\\\\&=x+1\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p36-g2-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{(x+1)(x-2)}{(x+3)(x+1)}\\times\\dfrac{(x+3)(x+5)}{(x-2)(x+7)}$",
          "answerSpaceMm": 45,
          "answer": {
            "short": "$\\dfrac{x+5}{x+7}$",
            "worked": "$$\\begin{aligned}\\frac{(x+1)(x-2)}{(x+3)(x+1)}\\times\\frac{(x+3)(x+5)}{(x-2)(x+7)}&=\\frac{(x+1)(x-2)(x+3)(x+5)}{(x+3)(x+1)(x-2)(x+7)}\\\\&=\\frac{x+5}{x+7}\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p36-g2-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\dfrac{2(x+4)}{(x-1)(x+4)}\\div\\dfrac{6}{(x-1)}$",
          "answerSpaceMm": 45,
          "answer": {
            "short": "$\\dfrac{1}{3}$",
            "worked": "$$\\begin{aligned}\\frac{2(x+4)}{(x-1)(x+4)}\\div\\frac{6}{x-1}&=\\frac{2(x+4)}{(x-1)(x+4)}\\times\\frac{x-1}{6}\\\\&=\\frac{2(x+4)(x-1)}{6(x-1)(x+4)}\\\\&=\\frac{2}{6}\\\\&=\\frac{1}{3}\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p36-g2-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{(x+1)}{(1-x)}\\div\\dfrac{(x+5)}{(x-1)}$",
          "answerSpaceMm": 45,
          "answer": {
            "short": "$-\\dfrac{x+1}{x+5}$",
            "worked": "$$\\begin{aligned}\\frac{x+1}{1-x}\\div\\frac{x+5}{x-1}&=\\frac{x+1}{1-x}\\times\\frac{x-1}{x+5}\\\\&=\\frac{(x+1)\\times\\left(-(1-x)\\right)}{(1-x)(x+5)}\\\\&=-\\frac{x+1}{x+5}\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        }
      ]
    },
