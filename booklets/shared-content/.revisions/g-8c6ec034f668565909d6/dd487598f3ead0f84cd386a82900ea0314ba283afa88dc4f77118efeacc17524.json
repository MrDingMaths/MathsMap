                "spaceAfter": 1
              }
            ]
          },
          "answerSpaceMm": 10,
          "answer": {
            "short": "$\\color{#268cff}(7+3x)(1+x)$",
            "worked": "$$\\color{#268cff}\\begin{aligned}7+3x+x(7+3x)&=1(7+3x)+x(7+3x)\\\\&=(7+3x)(1+x)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p37-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$y(4y-1)-(4y-1)$",
          "answerSpaceMm": 12,
          "answer": {
            "short": "$\\color{#268cff}(4y-1)(y-1)$",
            "worked": "$$\\color{#268cff}\\begin{aligned}y(4y-1)-(4y-1)&=(4y-1)(y-1)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p37-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$y(2x-5)-2x+5$",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\color{#268cff}(2x-5)(y-1)$",
            "worked": "$$\\color{#268cff}\\begin{aligned}y(2x-5)-2x+5&=y(2x-5)-(2x-5)\\\\&=(2x-5)(y-1)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p37-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$2x(x+1)-x-1$",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\color{#268cff}(x+1)(2x-1)$",
            "worked": "$$\\color{#268cff}\\begin{aligned}2x(x+1)-x-1&=2x(x+1)-(x+1)\\\\&=(x+1)(2x-1)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p37-guided-e",
          "type": "part",
          "label": "e",
          "prompt": "$5y(x-7)-x+7$",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\color{#268cff}(x-7)(5y-1)$",
            "worked": "$$\\color{#268cff}\\begin{aligned}5y(x-7)-x+7&=5y(x-7)-(x-7)\\\\&=(x-7)(5y-1)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p37-guided-f",
          "type": "part",
          "label": "f",
          "prompt": "$12x^{2}(y-3)+3-y$",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\color{#268cff}(y-3)(12x^{2}-1)$",
            "worked": "$$\\color{#268cff}\\begin{aligned}12x^{2}(y-3)+3-y&=12x^{2}(y-3)-(y-3)\\\\&=(y-3)(12x^{2}-1)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
