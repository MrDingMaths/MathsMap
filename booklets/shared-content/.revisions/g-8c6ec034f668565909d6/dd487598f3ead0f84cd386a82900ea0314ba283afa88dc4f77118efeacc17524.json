                    "type": "math",
                    "latex": "\\mathrel{\\phantom{=}}7+3x+x(7+3x)"
                  }
                ],
                "spaceAfter": 1
              },
              {
                "id": "p37-guided-a-scaffold",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "=1(7+3x)+x(7+3x)",
                    "colour": "#268cff"
                  }
                ],
                "spaceAfter": 1
              },
              {
                "id": "p37-guided-a-response-start",
                "type": "paragraph",
