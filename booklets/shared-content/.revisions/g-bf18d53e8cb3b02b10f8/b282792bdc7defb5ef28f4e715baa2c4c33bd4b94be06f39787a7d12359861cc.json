          "id": "p8-q2-a",
          "type": "part",
          "label": "a",
          "prompt": "Odd positive integers less than 10.",
          "answerSpaceMm": 10,
          "answer": {
            "short": "$\\{1,3,5,7,9\\}$",
            "worked": "The odd positive integers below 10 are $1,3,5,7,9$.\n\n$\\{1,3,5,7,9\\}$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p8-q2-b",
          "type": "part",
          "label": "b",
          "prompt": "The first six positive multiples of 6.",
          "answerSpaceMm": 10,
          "answer": {
            "short": "$\\{6,12,18,24,30,36\\}$",
            "worked": "$6\\times1=6$, $6\\times2=12$, $6\\times3=18$, $6\\times4=24$, $6\\times5=30$, $6\\times6=36$.\n\n$\\{6,12,18,24,30,36\\}$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p8-q2-c",
          "type": "part",
          "label": "c",
          "prompt": "The numbers on a die.",
          "answerSpaceMm": 10,
          "answer": {
            "short": "$\\{1,2,3,4,5,6\\}$",
            "worked": "A standard die has faces numbered $1$ to $6$.\n\n$\\{1,2,3,4,5,6\\}$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p8-q2-d",
          "type": "part",
          "label": "d",
          "prompt": "The factors of 20.",
          "answerSpaceMm": 10,
