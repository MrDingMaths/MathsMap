    "content": {
      "id": "p31-q1-root",
      "type": "question",
      "label": "1",
      "prompt": "A map has a scale of $1:50\\,000$.",
      "layout": "list",
      "children": [
        {
          "id": "p31-q1-a",
          "type": "part",
          "label": "a",
          "prompt": "How many centimetres in real life does $1\\text{ cm}$ on the map equal?",
          "answerSpaceMm": 12,
          "answer": {
            "short": "$50\\,000\\text{ cm}$",
            "worked": "The scale is image : original, so $1$ unit on the map represents $50\\,000$ units in real life.\n$$\\begin{align*}\\text{Original length}&=1\\times50\\,000\\text{ cm}\\\\&=50\\,000\\text{ cm}.\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p31-q1-b",
          "type": "part",
          "label": "b",
          "prompt": "Therefore, how many metres does $1\\text{ cm}$ represent?",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$500\\text{ m}$",
            "worked": "$100\\text{ cm}=1\\text{ m}$.\n$$\\begin{align*}\\text{Original length}&=(50\\,000\\div100)\\text{ m}\\\\&=500\\text{ m}.\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p31-q1-c",
          "type": "part",
          "label": "c",
          "prompt": "What is the scale factor, as a fraction?",
          "answerSpaceMm": 16,
          "answer": {
            "short": "$\\dfrac{1}{50\\,000}$",
            "worked": "Use image length divided by original length, with both lengths in the same units.\n$$\\begin{align*}\\text{Scale factor}&=\\frac{\\text{image length}}{\\text{original length}}\\\\&=\\frac{1}{50\\,000}.\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
