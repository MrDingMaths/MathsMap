        "evidence": ".booklet-work/full-imports/further-non-linear-relationships-v1-20261007/semantic-packets/assignments/assignment-f4174a61b4c9c50eea0b/1/generation.json"
      }
    },
    "content": {
      "id": "p50-q8-root",
      "type": "group",
      "label": "8",
      "prompt": "The line $2x-y+3=0$ intersects the circle $x^2+y^2-4x+6y-12=0$ at two points, $D$ and $E$.",
      "children": [
        {
          "id": "p50-q8-a",
          "type": "part",
          "label": "a",
          "prompt": "Find the coordinates of $D$ and $E$.",
          "answerSpaceMm": 38,
          "answer": {
            "short": "$(-1,1)$ and $(-3,-3)$.",
            "worked": "Rearrange the line and substitute into the circle:\n$$\\begin{align*}\ny&=2x+3\\\\\nx^2+(2x+3)^2-4x+6(2x+3)-12&=0\\\\\n5x^2+20x+15&=0\\\\\nx^2+4x+3&=0\\\\\n(x+1)(x+3)&=0\\\\\nx&=-1\\text{ or }-3\n\\end{align*}$$\nWhen $x=-1$, $y=2(-1)+3=1$.\nWhen $x=-3$, $y=2(-3)+3=-3$.\nThe points of intersection are $(-1,1)$ and $(-3,-3)$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p50-q8-b",
          "type": "part",
          "label": "b",
          "prompt": "Hence find the length of the line segment joining $DE$.",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$2\\sqrt{5}$ units.",
            "worked": "$$\\begin{align*}\nDE&=\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2}\\\\\nDE&=\\sqrt{(-1-(-3))^2+(1-(-3))^2}\\\\\nDE&=\\sqrt{2^2+4^2}\\\\\nDE&=2\\sqrt{5}\\text{ units}\n\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
