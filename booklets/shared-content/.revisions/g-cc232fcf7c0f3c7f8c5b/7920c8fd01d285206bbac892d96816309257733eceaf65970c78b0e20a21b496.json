      "id": "p11-guided-factorise",
      "type": "question",
      "label": "",
      "prompt": "Factorise",
      "layout": "grid",
      "columns": 2,
      "children": [
        {
          "id": "p11-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$xk+xc$",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$x(k+c)$",
            "worked": "HCF: $x$.\n$$\\begin{align*}xk+xc &= x\\left(\\frac{xk}{x}+\\frac{xc}{x}\\right)\\\\xk+xc &= x(k+c)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p11-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$x^2+3x$",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$x(x+3)$",
            "worked": "HCF: $x$.\n$$\\begin{align*}x^2+3x &= x\\left(\\frac{x^2}{x}+\\frac{3x}{x}\\right)\\\\x^2+3x &= x(x+3)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p11-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$x^2-3x$",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$x(x-3)$",
            "worked": "HCF: $x$.\n$$\\begin{align*}x^2-3x &= x\\left(\\frac{x^2}{x}-\\frac{3x}{x}\\right)\\\\x^2-3x &= x(x-3)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p11-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$6xb+8b$",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$2b(3x+4)$",
            "worked": "HCF: $2b$.\n$$\\begin{align*}6xb+8b &= 2b\\left(\\frac{6xb}{2b}+\\frac{8b}{2b}\\right)\\\\6xb+8b &= 2b(3x+4)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p11-guided-e",
          "type": "part",
          "label": "e",
          "prompt": "$3ab-5b$",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$b(3a-5)$",
            "worked": "HCF: $b$.\n$$\\begin{align*}3ab-5b &= b\\left(\\frac{3ab}{b}-\\frac{5b}{b}\\right)\\\\3ab-5b &= b(3a-5)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p11-guided-f",
          "type": "part",
          "label": "f",
          "prompt": "$4xy^2-6y^2$",
          "answerSpaceMm": 20,
          "answer": {
            "short": "$2y^2(2x-3)$",
            "worked": "HCF: $2y^2$.\n$$\\begin{align*}4xy^2-6y^2 &= 2y^2\\left(\\frac{4xy^2}{2y^2}-\\frac{6y^2}{2y^2}\\right)\\\\4xy^2-6y^2 &= 2y^2(2x-3)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        }
      ]
    },
