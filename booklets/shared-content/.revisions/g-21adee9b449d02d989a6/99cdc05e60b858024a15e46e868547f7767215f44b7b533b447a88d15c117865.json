                  "type": "text",
                  "text": "  "
                },
                {
                  "type": "math",
                  "latex": "\\color{#ef6068}\\frac{\\times3x^{2}}{\\times3x^{2}}",
                  "display": false
                }
              ]
            }
          ]
        },
        "theorySolution": "$$\\color{#268cff}\\begin{aligned}&=\\frac{3x^{2}\\left(1+\\frac{1}{3x}\\right)}{3x^{2}\\left(1-\\frac{1}{x^{2}}\\right)}\\\\&=\\frac{3x^{2}+x}{3x^{2}-3}\\\\&=\\frac{x(3x+1)}{3(x-1)(x+1)}\\end{aligned}$$",
        "equationAlignment": {
          "mode": "continuation"
        }
      },
      {
        "id": "p42-example-2",
        "label": "",
        "prompt": "$\\dfrac{1+\\frac{1}{3x}}{1-\\frac{1}{x^{2}}}$",
        "theorySolution": "$$\\color{#268cff}\\begin{aligned}&=\\frac{\\left(\\frac{3x+1}{3x}\\right)}{\\left(\\frac{x^{2}-1}{x^{2}}\\right)}=\\frac{3x+1}{3x}\\div\\frac{x^{2}-1}{x^{2}}\\\\&=\\frac{3x+1}{3x}\\times\\frac{x^{2}}{x^{2}-1}\\\\&=\\frac{x(3x+1)}{3(x-1)(x+1)}\\end{aligned}$$",
        "equationAlignment": {
          "mode": "continuation"
        }
      }
