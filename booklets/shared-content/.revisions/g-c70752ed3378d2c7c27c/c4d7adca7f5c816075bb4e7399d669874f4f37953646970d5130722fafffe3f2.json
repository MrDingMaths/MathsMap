                  "type": "math",
                  "display": true,
                  "latex": "\\frac{1+\\frac{1}{3x}}{1-\\frac{1}{x^2}}"
                }
              ],
              "spaceAfter": 1
            }
          ]
        },
        "theorySolution": "$$\\begin{aligned}&\\mathrel{\\phantom{=}}\\color{#24282d}\\frac{1+\\frac{1}{3x}}{1-\\frac{1}{x^2}}\\quad\\color{#ef6068}\\frac{\\times 3x^2}{\\times 3x^2}\\\\&\\color{#268cff}=\\frac{3x^2\\left(1+\\frac{1}{3x}\\right)}{3x^2\\left(1-\\frac{1}{x^2}\\right)}\\\\&\\color{#268cff}=\\frac{3x^2+x}{3x^2-3}\\\\&\\color{#268cff}=\\frac{x(3x+1)}{3(x-1)(x+1)}\\end{aligned}$$"
      },
