          "id": "p33-q2-a",
          "type": "part",
          "label": "a",
          "prompt": "Complete the square for $x^2+4x+y^2-6y+15=0$.",
          "answerSpaceMm": 25,
          "answer": {
            "short": "$(x+2)^2+(y-3)^2=-2$.",
            "worked": "$$\\begin{align*}x^2+4x+4-4+y^2-6y+9-9+15&=0\\\\(x^2+4x+4)+(y^2-6y+9)+2&=0\\\\(x+2)^2+(y-3)^2+2&=0\\\\(x+2)^2+(y-3)^2&=-2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p33-q2-b",
          "type": "part",
          "label": "b",
          "prompt": "Explain why this is not an equation of a circle.",
          "answerSpaceMm": 10,
          "answer": {
            "short": "The square of the radius cannot be negative.",
            "worked": "Here $r^2=-2$. The square of a real radius cannot be negative, so the equation does not represent a circle.",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        }
      ]
