          "inlines": [
            {
              "type": "text",
              "text": "The probability of the zoo having an animal born on a day is 40%."
            }
          ]
        },
        {
          "id": "p6-example-stem-2",
          "type": "paragraph",
          "align": "left",
          "inlines": [
            {
              "type": "text",
              "text": "The zoo publishes an article 80% of the time when there is a birth of a baby animal."
            }
          ]
        },
        {
          "id": "p6-example-stem-3",
          "type": "paragraph",
          "align": "left",
          "inlines": [
            {
              "type": "text",
              "text": "When there is no birth, there is a 30% probability the zoo will publish an article."
            }
          ]
        },
        {
          "id": "p6-example-task",
          "type": "paragraph",
          "align": "left",
          "inlines": [
            {
              "type": "text",
              "text": "Find the probability that a baby animal was born given that an article was published."
            }
          ]
        }
      ]
    },
