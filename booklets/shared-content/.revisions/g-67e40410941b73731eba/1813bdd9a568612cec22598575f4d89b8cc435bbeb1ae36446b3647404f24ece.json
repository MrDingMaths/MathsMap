          "align": "left",
          "lineHeight": 1.5,
          "inlines": [
            {
              "type": "text",
              "text": "The goal is to form an equation with only one pronumeral, solve it, then use that value to find the other."
            }
          ],
          "spaceAfter": 1
        },
        {
          "id": "p29-teaching-method",
          "type": "list",
          "ordered": true,
          "start": 1,
          "indent": 7,
          "items": [
            {
              "id": "p29-teaching-step-1",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p29-teaching-step-1-text",
                  "type": "paragraph",
                  "align": "left",
                  "lineHeight": 1.5,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Add or subtract",
                      "marks": [
                        "bold"
                      ]
                    },
                    {
                      "type": "text",
                      "text": " the equations to eliminate one of the variables."
                    }
                  ],
                  "spaceAfter": 1
                }
              ]
            },
            {
              "id": "p29-teaching-step-2",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p29-teaching-step-2-text",
                  "type": "paragraph",
                  "align": "left",
                  "lineHeight": 1.5,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Solve",
                      "marks": [
                        "bold"
                      ]
                    },
                    {
                      "type": "text",
                      "text": " for the pronumeral."
                    }
                  ],
                  "spaceAfter": 1
                }
              ]
            },
            {
              "id": "p29-teaching-step-3",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p29-teaching-step-3-text",
                  "type": "paragraph",
                  "align": "left",
                  "lineHeight": 1.5,
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Substitute",
                      "marks": [
                        "bold"
                      ]
                    },
                    {
                      "type": "text",
                      "text": " the solution back into either equation to find the other pronumeral."
                    }
                  ],
                  "spaceAfter": 1
                }
              ]
            }
          ]
        }
