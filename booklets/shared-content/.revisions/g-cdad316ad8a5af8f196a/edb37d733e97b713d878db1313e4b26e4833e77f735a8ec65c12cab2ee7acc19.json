                      "id": "p12-example-gradient",
                      "type": "paragraph",
                      "align": "left",
                      "inlines": [
                        {
                          "type": "math",
                          "latex": "\\begin{aligned}m&=\\dfrac{y_2-y_1}{x_2-x_1}=\\dfrac{-1-5}{4-1}\\\\m&=-2\\end{aligned}",
                          "display": true,
                          "colour": "#268cff"
                        }
                      ],
                      "spaceAfter": 1
                    }
                  ]
                },
