                    {
                      "id": "p12-example-substitution",
                      "type": "paragraph",
                      "align": "center",
                      "inlines": [
                        {
                          "type": "math",
                          "latex": "\\begin{aligned}y-y_1&=m(x-x_1)\\\\y-5&=-2(x-1)\\end{aligned}",
                          "display": true,
                          "colour": "#268cff"
                        }
