            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p26-gp-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{3}{5x}-\\dfrac{1}{2x}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\dfrac{1}{10x}$",
            "worked": "$$\\begin{aligned}\\frac{3}{5x}-\\frac{1}{2x}&=\\frac{6}{10x}-\\frac{5}{10x}\\\\&=\\frac{1}{10x}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p26-gp-e",
