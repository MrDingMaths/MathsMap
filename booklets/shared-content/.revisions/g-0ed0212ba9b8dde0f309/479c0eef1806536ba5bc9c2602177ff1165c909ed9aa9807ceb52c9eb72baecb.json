          "label": "e",
          "prompt": "$\\dfrac{5}{a}+\\dfrac{2}{a^{3}}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\dfrac{5a^{2}+2}{a^{3}}$",
            "worked": "$$\\begin{aligned}\\frac{5}{a}+\\frac{2}{a^{3}}&=\\frac{5a^{2}}{a^{3}}+\\frac{2}{a^{3}}\\\\&=\\frac{5a^{2}+2}{a^{3}}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p26-gp-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{1}{x^{2}}-\\dfrac{1}{y}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\dfrac{y-x^{2}}{x^{2}y}$",
            "worked": "$$\\begin{aligned}\\frac{1}{x^{2}}-\\frac{1}{y}&=\\frac{y}{x^{2}y}-\\frac{x^{2}}{x^{2}y}\\\\&=\\frac{y-x^{2}}{x^{2}y}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
