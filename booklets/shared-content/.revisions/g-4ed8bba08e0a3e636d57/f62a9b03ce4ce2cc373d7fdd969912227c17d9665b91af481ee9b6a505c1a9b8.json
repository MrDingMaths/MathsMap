    },
    "content": {
      "id": "p30-q8",
      "type": "group",
      "label": "8",
      "prompt": "The interval joining the points $A(3,-1)$ and $B(-7,5)$ is a diameter of a circle.",
      "children": [
        {
          "id": "p30-q8-a",
          "type": "part",
          "label": "a",
          "prompt": "Find the midpoint of $AB$.",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$(-2,2)$",
            "worked": "$$\\begin{align*}M&=\\left(\\frac{3+(-7)}2,\\frac{-1+5}2\\right)\\\\&=(-2,2)\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-q8-b",
          "type": "part",
          "label": "b",
          "prompt": "Explain why the midpoint of $AB$ is the centre of the circle.",
          "answerSpaceMm": 18,
          "answer": {
            "short": "A diameter passes through the centre, which is halfway between its endpoints.",
            "worked": "The diameter connects two points on the circumference and passes through the centre. Its two halves are equal radii, so its midpoint is the centre of the circle.",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-q8-c",
          "type": "part",
          "label": "c",
          "prompt": "Find the length of the radius.",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\sqrt{34}$",
            "worked": "Using the distance from the centre $(-2,2)$ to $A(3,-1)$:\n$$\\begin{align*}r&=\\sqrt{(3+2)^2+(-1-2)^2}\\\\&=\\sqrt{25+9}\\\\&=\\sqrt{34}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-q8-d",
          "type": "part",
          "label": "d",
          "prompt": "Hence state the equation of the circle.",
          "answerSpaceMm": 10,
          "answer": {
            "short": "$(x+2)^2+(y-2)^2=34$",
            "worked": "The centre is $(-2,2)$ and $r^2=34$.\n$$(x+2)^2+(y-2)^2=34$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
