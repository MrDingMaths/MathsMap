      "type": "question",
      "label": "48",
      "prompt": "It is 7 p.m. now. What will the time be $23\\,999\\,999\\,996$ hours later?",
      "answerSpaceMm": 32,
      "answer": {
        "short": "3 p.m.",
        "worked": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "p85-q48-answer",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "text",
                  "text": "Time repeats every 24 hours."
                },
                {
                  "type": "break"
                },
                {
                  "type": "math",
                  "latex": "24\\,000\\,000\\,000=24\\times1\\,000\\,000\\,000",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "math",
                  "latex": "23\\,999\\,999\\,996=24\\,000\\,000\\,000-4",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "After a whole number of days, the time would be 7 p.m. Four hours earlier is 3 p.m."
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Therefore, the time will be 3 p.m."
                }
