    "content": {
      "id": "p17-guided-question",
      "type": "group",
      "label": "",
      "prompt": "Simplify these expressions.",
      "layout": "grid",
      "columns": 3,
      "children": [
        {
          "id": "p17-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\dfrac{x^4}{n^2}\\times\\dfrac{m}{n^3}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\dfrac{mx^4}{n^5}$",
            "worked": "$$\\begin{aligned}\\frac{x^4}{n^2}\\times\\frac{m}{n^3}&=\\frac{mx^4}{n^2n^3}\\\\&=\\frac{mx^4}{n^5}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p17-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{x}{y}\\times\\dfrac{y^2}{x}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$y$",
            "worked": "$$\\begin{aligned}\\frac{x}{y}\\times\\frac{y^2}{x}&=\\frac{xy^2}{xy}\\\\&=y\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p17-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{xz}{5}\\div\\dfrac{x}{10z}$",
          "answerSpaceMm": 44,
          "answer": {
            "short": "$2z^2$",
            "worked": "$$\\begin{aligned}\\frac{xz}{5}\\div\\frac{x}{10z}&=\\frac{xz}{5}\\times\\frac{10z}{x}\\\\&=\\frac{10xz^2}{5x}\\\\&=2z^2\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p17-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{2x}{5y}\\times\\dfrac{2y}{5x^2}$",
          "answerSpaceMm": 32,
          "answer": {
            "short": "$\\dfrac{4}{25x}$",
            "worked": "$$\\begin{aligned}\\frac{2x}{5y}\\times\\frac{2y}{5x^2}&=\\frac{4xy}{25x^2y}\\\\&=\\frac{4}{25x}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p17-guided-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\dfrac{3}{4y^3x}\\times\\dfrac{3x^2}{y^2}$",
          "answerSpaceMm": 46,
          "answer": {
            "short": "$\\dfrac{9x}{4y^5}$",
            "worked": "$$\\begin{aligned}\\frac{3}{4y^3x}\\times\\frac{3x^2}{y^2}&=\\frac{9x^2}{4xy^3y^2}\\\\&=\\frac{9x^2}{4xy^5}\\\\&=\\frac{9x}{4y^5}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p17-guided-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{3x^2}{5y^2}\\div\\dfrac{2x}{3y}$",
          "answerSpaceMm": 46,
          "answer": {
            "short": "$\\dfrac{9x}{10y}$",
            "worked": "$$\\begin{aligned}\\frac{3x^2}{5y^2}\\div\\frac{2x}{3y}&=\\frac{3x^2}{5y^2}\\times\\frac{3y}{2x}\\\\&=\\frac{9x^2y}{10xy^2}\\\\&=\\frac{9x}{10y}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
