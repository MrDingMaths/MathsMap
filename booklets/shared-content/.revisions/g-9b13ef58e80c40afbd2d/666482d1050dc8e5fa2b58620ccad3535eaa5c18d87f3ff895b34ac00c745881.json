    "content": {
      "id": "p61-q2",
      "type": "question",
      "label": "2",
      "prompt": "A parabola has the equation $y=x^2+2x+3$.\nFind the values of $a$ and $c$ in the equation $y=(x-a)^2+c$ and hence determine the coordinates of the vertex $(a,c)$.",
      "answerSpaceMm": 38,
      "answer": {
        "short": "$a=-1$, $c=2$; vertex $(-1,2)$.",
        "worked": "Expand and equate coefficients.\n$$\\begin{align*}(x-a)^2+c&=x^2-2ax+a^2+c\\\\-2a&=2\\\\a&=-1\\\\a^2+c&=3\\\\(-1)^2+c&=3\\\\c&=2\\end{align*}$$\nThe vertex is $(a,c)=(-1,2)$.",
        "provenance": {
          "short": "authored",
          "worked": "authored"
        }
      }
    },
