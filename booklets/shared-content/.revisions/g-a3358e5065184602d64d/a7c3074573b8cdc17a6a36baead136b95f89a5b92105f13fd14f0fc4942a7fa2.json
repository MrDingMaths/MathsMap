          "id": "p38-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$$\\frac{1+\\frac{1}{x}}{1-\\frac{1}{x}}$$",
          "answerSpaceMm": 36,
          "answer": {
            "short": "$\\dfrac{x+1}{x-1}$",
            "worked": "Multiply the main numerator and denominator by $x$.\n$$\\begin{align*}\\frac{1+\\frac1x}{1-\\frac1x}&=\\frac{x\\left(1+\\frac1x\\right)}{x\\left(1-\\frac1x\\right)}\\\\&=\\frac{x+1}{x-1}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$$\\frac{2+\\frac{1}{x+1}}{3-\\frac{1}{x+1}}$$",
          "answerSpaceMm": 48,
          "answer": {
            "short": "$\\dfrac{2x+3}{3x+2}$",
            "worked": "Multiply the main numerator and denominator by $x+1$.\n$$\\begin{align*}\\frac{2+\\frac1{x+1}}{3-\\frac1{x+1}}&=\\frac{(x+1)\\left(2+\\frac1{x+1}\\right)}{(x+1)\\left(3-\\frac1{x+1}\\right)}\\\\&=\\frac{2(x+1)+1}{3(x+1)-1}\\\\&=\\frac{2x+3}{3x+2}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$$\\frac{1-\\frac{1}{5x}}{1-\\frac{1}{x^2}}$$",
          "answerSpaceMm": 50,
          "answer": {
            "short": "$\\dfrac{x(5x-1)}{5(x-1)(x+1)}$",
            "worked": "Multiply the main numerator and denominator by $5x^2$.\n$$\\begin{align*}\\frac{1-\\frac1{5x}}{1-\\frac1{x^2}}&=\\frac{5x^2\\left(1-\\frac1{5x}\\right)}{5x^2\\left(1-\\frac1{x^2}\\right)}\\\\&=\\frac{5x^2-x}{5x^2-5}\\\\&=\\frac{x(5x-1)}{5(x-1)(x+1)}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$$\\frac{\\frac{1}{x}+\\frac{1}{y}}{\\frac{1}{x}-\\frac{1}{y}}$$",
          "answerSpaceMm": 44,
          "answer": {
            "short": "$\\dfrac{x+y}{y-x}$",
            "worked": "Multiply the main numerator and denominator by $xy$.\n$$\\begin{align*}\\frac{\\frac1x+\\frac1y}{\\frac1x-\\frac1y}&=\\frac{xy\\left(\\frac1x+\\frac1y\\right)}{xy\\left(\\frac1x-\\frac1y\\right)}\\\\&=\\frac{y+x}{y-x}\\\\&=\\frac{x+y}{y-x}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
