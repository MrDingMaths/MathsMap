          "type": "part",
          "label": "a",
          "prompt": "$\\frac{x}{3}\\times\\frac{2}{5}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\color{#268cff}\\frac{2x}{15}$",
            "worked": "$$\\begin{aligned}\\frac{x}{3}\\times\\frac{2}{5}&=\\frac{x\\times2}{3\\times5}\\\\&=\\frac{2x}{15}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\frac{2}{3}\\times\\frac{4a}{5}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\color{#268cff}\\frac{8a}{15}$",
            "worked": "$$\\begin{aligned}\\frac{2}{3}\\times\\frac{4a}{5}&=\\frac{2\\times4a}{3\\times5}\\\\&=\\frac{8a}{15}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\frac{6x}{5}\\times\\frac{7y}{6}$",
          "answerSpaceMm": 32,
          "answer": {
            "short": "$\\color{#268cff}\\frac{7xy}{5}$",
            "worked": "$$\\begin{aligned}\\frac{6x}{5}\\times\\frac{7y}{6}&=\\frac{6x\\times7y}{5\\times6}\\\\&=\\frac{42xy}{30}\\\\&=\\frac{7xy}{5}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\frac{8a}{5}\\times\\frac{3b}{4c}$",
          "answerSpaceMm": 32,
          "answer": {
            "short": "$\\color{#268cff}\\frac{6ab}{5c}$",
            "worked": "$$\\begin{aligned}\\frac{8a}{5}\\times\\frac{3b}{4c}&=\\frac{8a\\times3b}{5\\times4c}\\\\&=\\frac{24ab}{20c}\\\\&=\\frac{6ab}{5c}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-guided-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\frac{3x}{2}\\times6$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$\\color{#268cff}9x$",
            "worked": "$$\\begin{aligned}\\frac{3x}{2}\\times6&=\\frac{3x\\times6}{2}\\\\&=9x\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-guided-f",
          "type": "part",
