      "children": [
        {
          "id": "p4-indices-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$$\\frac{35x^2}{7x}$$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$5x$",
            "worked": "$$\\begin{align*}\\frac{35x^2}{7x}&=\\frac{35x^2\\div x}{7x\\div x}\\\\\\frac{35x^2}{7x}&=\\frac{35x\\div7}{7\\div7}\\\\\\frac{35x^2}{7x}&=5x\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p4-indices-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$$\\frac{-14x^3}{7x}$$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$-2x^2$",
            "worked": "$$\\begin{align*}\\frac{-14x^3}{7x}&=\\frac{-14x^3\\div x}{7x\\div x}\\\\\\frac{-14x^3}{7x}&=\\frac{-14x^2\\div7}{7\\div7}\\\\\\frac{-14x^3}{7x}&=-2x^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p4-indices-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$$-\\frac{36ab^2}{4ab}$$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$-9b$",
            "worked": "$$\\begin{align*}-\\frac{36ab^2}{4ab}&=-\\frac{36ab^2\\div(ab)}{4ab\\div(ab)}\\\\-\\frac{36ab^2}{4ab}&=-\\frac{36b\\div4}{4\\div4}\\\\-\\frac{36ab^2}{4ab}&=-9b\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p4-indices-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$$\\frac{8xy^3}{4x^2y}$$",
          "answerSpaceMm": 27,
          "answer": {
            "short": "$\\frac{2y^2}{x}$",
            "worked": "$$\\begin{align*}\\frac{8xy^3}{4x^2y}&=\\frac{8xy^3\\div(xy)}{4x^2y\\div(xy)}\\\\\\frac{8xy^3}{4x^2y}&=\\frac{8y^2\\div4}{4x\\div4}\\\\\\frac{8xy^3}{4x^2y}&=\\frac{2y^2}{x}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p4-indices-guided-e",
          "type": "part",
          "label": "e",
          "prompt": "$$\\frac{-15pq^2}{30p^2q^2}$$",
          "answerSpaceMm": 27,
          "answer": {
            "short": "$-\\frac{1}{2p}$",
            "worked": "$$\\begin{align*}\\frac{-15pq^2}{30p^2q^2}&=\\frac{-15pq^2\\div(pq^2)}{30p^2q^2\\div(pq^2)}\\\\\\frac{-15pq^2}{30p^2q^2}&=\\frac{-15\\div15}{30p\\div15}\\\\\\frac{-15pq^2}{30p^2q^2}&=-\\frac{1}{2p}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p4-indices-guided-f",
          "type": "part",
          "label": "f",
          "prompt": "$$\\frac{-20s}{45s^2t}$$",
          "answerSpaceMm": 27,
          "answer": {
            "short": "$-\\frac{4}{9st}$",
            "worked": "$$\\begin{align*}\\frac{-20s}{45s^2t}&=\\frac{-20s\\div s}{45s^2t\\div s}\\\\\\frac{-20s}{45s^2t}&=\\frac{-20\\div5}{45st\\div5}\\\\\\frac{-20s}{45s^2t}&=-\\frac{4}{9st}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
