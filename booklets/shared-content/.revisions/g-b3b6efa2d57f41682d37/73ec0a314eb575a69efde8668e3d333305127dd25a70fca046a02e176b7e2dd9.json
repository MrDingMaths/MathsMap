        "id": "p4-indices-example-a",
        "label": "",
        "prompt": "$$\\frac{10a^5}{5a^2}$$",
        "theorySolution": "$$\\begin{aligned}\\color{#268cff}\\frac{10a^5}{5a^2}&\\color{#268cff}=\\frac{10a^5\\,{\\color{#ef6068}\\div a^2}}{5a^2\\,{\\color{#ef6068}\\div a^2}}\\\\\\color{#268cff}\\frac{10a^5}{5a^2}&\\color{#268cff}=\\frac{10a^3\\,{\\color{#ef6068}\\div5}}{5\\,{\\color{#ef6068}\\div5}}\\\\\\color{#268cff}\\frac{10a^5}{5a^2}&\\color{#268cff}=2a^3\\end{aligned}$$"
      },
      {
        "id": "p4-indices-example-b",
        "label": "",
        "prompt": "$$\\frac{8ab}{2a^2}$$",
        "theorySolution": "$$\\begin{aligned}\\color{#268cff}\\frac{8ab}{2a^2}&\\color{#268cff}=\\frac{8ab\\,{\\color{#ef6068}\\div a}}{2a^2\\,{\\color{#ef6068}\\div a}}\\\\\\color{#268cff}\\frac{8ab}{2a^2}&\\color{#268cff}=\\frac{8b\\,{\\color{#ef6068}\\div2}}{2a\\,{\\color{#ef6068}\\div2}}\\\\\\color{#268cff}\\frac{8ab}{2a^2}&\\color{#268cff}=\\frac{4b}{a}\\end{aligned}$$"
      }
    ],
