        "prompt": "$\\dfrac{2}{5}+\\dfrac{3}{a^{2}}$",
        "theorySolution": "$$\\begin{aligned}\\color{#ef6068}\\text{1. Same denominators}&\\ \\color{#268cff}\\frac{\\hspace{8mm}}{5a^{2}}+\\frac{\\hspace{8mm}}{5a^{2}}\\\\&\\ \\color{#268cff}\\frac{2a^{2}}{5a^{2}}+\\frac{15}{5a^{2}}\\\\\\color{#ef6068}\\text{2. Add numerators}&\\ \\color{#268cff}\\frac{2a^{2}+15}{5a^{2}}\\end{aligned}$$"
      },
      {
        "id": "p26-example-2",
        "label": "",
        "prompt": "$\\dfrac{2}{3x}-\\dfrac{3}{5x}$",
        "theorySolution": "$$\\begin{aligned}\\color{#ef6068}\\text{1. Same denominators}&\\ \\color{#268cff}\\frac{\\hspace{8mm}}{15x}-\\frac{\\hspace{8mm}}{15x}\\\\&\\ \\color{#268cff}\\frac{10}{15x}-\\frac{9}{15x}\\\\\\color{#ef6068}\\text{2. Subtract numerators}&\\ \\color{#268cff}\\frac{1}{15x}\\end{aligned}$$"
      }
