          "id": "p3-gp-a",
          "type": "part",
          "label": "a",
          "prompt": "$6x^{3}y^{7}\\times 2x^{5}y^{2}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$12x^{8}y^{9}$",
            "worked": "$$\\begin{aligned}6x^{3}y^{7}\\times 2x^{5}y^{2}&=(6\\times 2)x^{3+5}y^{7+2}\\\\&=12x^{8}y^{9}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-gp-b",
          "type": "part",
          "label": "b",
          "prompt": "$4c^{4}d\\times 2c^{2}$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$8c^{6}d$",
            "worked": "$$\\begin{aligned}4c^{4}d\\times 2c^{2}&=(4\\times 2)c^{4+2}d\\\\&=8c^{6}d\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{12x^{2}y^{11}}{8x^{6}y}$",
          "answerSpaceMm": 34,
          "answer": {
            "short": "$\\dfrac{3y^{10}}{2x^{4}}$",
            "worked": "$$\\begin{aligned}\\frac{12x^{2}y^{11}}{8x^{6}y}&=\\frac{12}{8}\\times x^{2-6}\\times y^{11-1}\\\\&=\\frac{3}{2}x^{-4}y^{10}\\\\&=\\frac{3y^{10}}{2x^{4}}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-gp-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{2x^{5}y^{3}}{14x^{6}y}$",
          "answerSpaceMm": 34,
          "answer": {
            "short": "$\\dfrac{y^{2}}{7x}$",
            "worked": "$$\\begin{aligned}\\frac{2x^{5}y^{3}}{14x^{6}y}&=\\frac{2}{14}\\times x^{5-6}\\times y^{3-1}\\\\&=\\frac{1}{7}x^{-1}y^{2}\\\\&=\\frac{y^{2}}{7x}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
