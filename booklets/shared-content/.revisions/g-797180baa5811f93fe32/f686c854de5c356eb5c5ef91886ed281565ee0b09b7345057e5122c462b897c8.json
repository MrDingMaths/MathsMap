        {
          "id": "p21-part-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\sqrt{12}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}2\\sqrt3$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\sqrt{12}&=\\sqrt{4\\times3}\\\\\\sqrt{12}&=\\sqrt4\\times\\sqrt3\\\\\\sqrt{12}&=2\\sqrt3\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\sqrt{28}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}2\\sqrt7$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\sqrt{28}&=\\sqrt{4\\times7}\\\\\\sqrt{28}&=\\sqrt4\\times\\sqrt7\\\\\\sqrt{28}&=2\\sqrt7\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\sqrt{54}$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}3\\sqrt6$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\sqrt{54}&=\\sqrt{9\\times6}\\\\\\sqrt{54}&=\\sqrt9\\times\\sqrt6\\\\\\sqrt{54}&=3\\sqrt6\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-d",
          "type": "part",
          "label": "d",
          "prompt": "$3\\sqrt8$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\color{#268cff}6\\sqrt2$",
            "worked": "$$\\color{#268cff}\\begin{align*}3\\sqrt8&=3\\sqrt{4\\times2}\\\\3\\sqrt8&=3\\sqrt4\\sqrt2\\\\3\\sqrt8&=6\\sqrt2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\dfrac{\\sqrt{48}}2$",
          "answerSpaceMm": 44,
          "answer": {
            "short": "$\\color{#268cff}2\\sqrt3$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\frac{\\sqrt{48}}2&=\\frac{\\sqrt{16\\times3}}2\\\\\\frac{\\sqrt{48}}2&=\\frac{4\\sqrt3}2\\\\\\frac{\\sqrt{48}}2&=2\\sqrt3\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{5\\sqrt{40}}6$",
          "answerSpaceMm": 44,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac{5\\sqrt{10}}3$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\frac{5\\sqrt{40}}6&=\\frac{5\\sqrt{4\\times10}}6\\\\\\frac{5\\sqrt{40}}6&=\\frac{10\\sqrt{10}}6\\\\\\frac{5\\sqrt{40}}6&=\\frac{5\\sqrt{10}}3\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-g",
          "type": "part",
          "label": "g",
          "prompt": "$\\sqrt{\\dfrac{75}9}$",
          "answerSpaceMm": 46,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac5{\\sqrt3}\\text{ or }\\dfrac{5\\sqrt3}3$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\sqrt{\\frac{75}9}&=\\frac{\\sqrt{75}}3\\\\\\sqrt{\\frac{75}9}&=\\frac{\\sqrt{25\\times3}}3\\\\\\sqrt{\\frac{75}9}&=\\frac{5\\sqrt3}3\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p21-part-h",
          "type": "part",
          "label": "h",
          "prompt": "$\\sqrt{\\dfrac{50}{16}}$",
          "answerSpaceMm": 46,
          "answer": {
            "short": "$\\color{#268cff}\\dfrac5{2\\sqrt2}\\text{ or }\\dfrac{5\\sqrt2}4$",
            "worked": "$$\\color{#268cff}\\begin{align*}\\sqrt{\\frac{50}{16}}&=\\frac{\\sqrt{50}}4\\\\\\sqrt{\\frac{50}{16}}&=\\frac{\\sqrt{25\\times2}}4\\\\\\sqrt{\\frac{50}{16}}&=\\frac{5\\sqrt2}4\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
