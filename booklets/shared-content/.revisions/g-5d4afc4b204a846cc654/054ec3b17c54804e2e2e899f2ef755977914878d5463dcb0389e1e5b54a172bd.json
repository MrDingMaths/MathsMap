              "latex": "\\begin{aligned}0.827&=827\\text{ thousandths}\\\\&=\\frac{827}{1000}\\end{aligned}",
              "display": true
            }
          ]
        },
        {
          "id": "p27-teaching-patterns",
          "type": "paragraph",
          "align": "left",
          "inlines": [
            {
              "type": "text",
              "text": "Every recurring decimal can also be written as a fraction by looking at patterns."
            },
