                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\mathrel{\\phantom{=}}\\frac{3x+3}{2x}\\times\\frac{x^{2}}{x^{2}-1}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p38-gp-b-scaffold",
                "type": "paragraph",
                "align": "left",
                "spaceBefore": 2,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "=\\frac{3(\\phantom{\\boxed{\\rule{0pt}{5mm}\\hspace{9mm}}})}{2x}\\times\\frac{x^{2}}{(\\phantom{\\boxed{\\rule{0pt}{5mm}\\hspace{9mm}}})(\\phantom{\\boxed{\\rule{0pt}{5mm}\\hspace{9mm}}})}",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              },
              {
                "id": "p38-gp-b-eq",
                "type": "paragraph",
                "align": "left",
                "spaceBefore": 2,
                "inlines": [
                  {
                    "type": "math",
                    "latex": "=",
                    "display": false,
                    "colour": "#268cff"
                  }
                ]
              }
            ]
          },
          "answerSpaceMm": 34,
          "answer": {
            "short": "$\\frac{3x}{2(x-1)}$",
            "worked": "$$\\begin{aligned}\\frac{3x+3}{2x}\\times\\frac{x^{2}}{x^{2}-1}&=\\frac{3(x+1)}{2x}\\times\\frac{x^{2}}{(x-1)(x+1)}\\\\&=\\frac{3x}{2(x-1)}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-gp-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\frac{a^{2}-4}{3}\\times\\frac{5b}{a+2}$",
          "answerSpaceMm": 34,
          "answer": {
            "short": "$\\frac{5b(a-2)}{3}$",
            "worked": "$$\\begin{aligned}\\frac{a^{2}-4}{3}\\times\\frac{5b}{a+2}&=\\frac{(a-2)(a+2)}{3}\\times\\frac{5b}{a+2}\\\\&=\\frac{5b(a-2)}{3}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-gp-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\frac{6x-12}{5}\\div\\frac{x-2}{3}$",
          "answerSpaceMm": 34,
          "answer": {
            "short": "$\\frac{18}{5}$",
            "worked": "$$\\begin{aligned}\\frac{6x-12}{5}\\div\\frac{x-2}{3}&=\\frac{6(x-2)}{5}\\times\\frac{3}{x-2}\\\\&=\\frac{18}{5}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-gp-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\frac{3-6y}{8}\\div\\frac{1-2y}{2}$",
          "answerSpaceMm": 44,
          "answer": {
            "short": "$\\frac{3}{4}$",
            "worked": "$$\\begin{aligned}\\frac{3-6y}{8}\\div\\frac{1-2y}{2}&=\\frac{3(1-2y)}{8}\\times\\frac{2}{1-2y}\\\\&=\\frac{6}{8}\\\\&=\\frac{3}{4}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p38-gp-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\frac{12x}{x+1}\\div\\frac{6x}{x^{2}+2x+1}$",
          "answerSpaceMm": 34,
          "answer": {
            "short": "$2(x+1)$",
            "worked": "$$\\begin{aligned}\\frac{12x}{x+1}\\div\\frac{6x}{x^{2}+2x+1}&=\\frac{12x}{x+1}\\times\\frac{(x+1)^{2}}{6x}\\\\&=2(x+1)\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
