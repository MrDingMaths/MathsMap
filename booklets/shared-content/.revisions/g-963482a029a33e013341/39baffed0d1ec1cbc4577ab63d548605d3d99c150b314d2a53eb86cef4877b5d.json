          "answerSpaceMm": 44,
          "answer": {
            "short": "$6$",
            "worked": "$$\\begin{aligned}\\frac{3x+6}{5}\\times\\frac{10}{x+2}&=\\frac{3(x+2)}{5}\\times\\frac{10}{x+2}\\\\&=\\frac{3\\times10}{5}\\\\&=6\\end{aligned}$$",
