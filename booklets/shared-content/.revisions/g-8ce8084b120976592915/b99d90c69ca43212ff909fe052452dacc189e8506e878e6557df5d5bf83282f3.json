        {
          "id": "p3-identify-i-node",
          "type": "part",
          "label": "i",
          "prompt": "Explain why we cannot use the null factor law:\n$$(x-5)(x-2)=9$$",
          "answerSpaceMm": 34,
          "answer": {
            "short": "The product equals $9$, whereas the null factor law requires a product of zero.",
            "worked": "The null factor law applies only when a product equals zero. Here $(x-5)(x-2)=9$, so we cannot set either factor equal to zero.",
