          "type": "part",
          "label": "c",
          "prompt": "$(2x-5)(x-2)=0$",
          "answerSpaceMm": 19,
          "answer": {
            "short": "$x=\\frac52$ or $x=2$.",
            "worked": "$$\\begin{aligned}2x-5&=0\\quad\\text{or}\\quad x-2=0\\\\2x&=5\\quad\\text{or}\\quad x=2\\\\x&=\\frac52\\quad\\text{or}\\quad x=2\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-identify-d-node",
          "type": "part",
          "label": "d",
          "prompt": "$(2x+5)(x-2)=0$",
          "answerSpaceMm": 19,
          "answer": {
            "short": "$x=-\\frac52$ or $x=2$.",
            "worked": "$$\\begin{aligned}2x+5&=0\\quad\\text{or}\\quad x-2=0\\\\2x&=-5\\quad\\text{or}\\quad x=2\\\\x&=-\\frac52\\quad\\text{or}\\quad x=2\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
