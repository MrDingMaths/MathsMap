          "type": "part",
          "label": "e",
          "prompt": "$10(2x+5)(x-2)=0$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$x=-\\frac52$ or $x=2$.",
            "worked": "Since $10\\ne0$, divide both sides by $10$.\n$$\\begin{aligned}(2x+5)(x-2)&=0\\\\2x+5&=0\\quad\\text{or}\\quad x-2=0\\\\2x&=-5\\quad\\text{or}\\quad x=2\\\\x&=-\\frac52\\quad\\text{or}\\quad x=2\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p3-identify-f-node",
          "type": "part",
          "label": "f",
          "prompt": "$(2x+5)(7x-1)=0$",
          "answerSpaceMm": 19,
          "answer": {
            "short": "$x=-\\frac52$ or $x=\\frac17$.",
            "worked": "$$\\begin{aligned}2x+5&=0\\quad\\text{or}\\quad 7x-1=0\\\\2x&=-5\\quad\\text{or}\\quad 7x=1\\\\x&=-\\frac52\\quad\\text{or}\\quad x=\\frac17\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
