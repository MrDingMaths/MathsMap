          "prompt": "$(x-5)(x-2)=0$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$x=5$ or $x=2$.",
            "worked": "$$\\begin{aligned}x-5&=0\\quad\\text{or}\\quad x-2=0\\\\x&=5\\quad\\text{or}\\quad x=2\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
