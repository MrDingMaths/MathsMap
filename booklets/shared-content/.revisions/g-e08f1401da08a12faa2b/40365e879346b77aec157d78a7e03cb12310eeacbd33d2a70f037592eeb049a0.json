    },
    "pedagogyRole": "identify",
    "classification": {
      "primarySkillId": "operate-algebraic-fractions-denominator",
      "secondarySkillIds": [],
      "reasoningScore": 35,
      "difficulty": "Development",
      "difficultyReason": "Identify the lowest common multiple of numerical, monomial and binomial-factor terms, including terms that need factorising first."
    },
    "content": {
      "id": "p39-q",
      "type": "group",
      "label": "",
      "prompt": "Identify the lowest common multiple of these terms.",
      "layout": "grid",
      "columns": 2,
      "children": [
        {
          "id": "p39-a",
          "type": "part",
          "label": "a",
          "prompt": "$6x\\;\\&\\;9x^{2}$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$18x^{2}$",
            "worked": "$$\\begin{aligned}&6x=2\\times3\\times x\\\\&9x^{2}=3^{2}\\times x^{2}\\\\&\\text{LCM}=18x^{2}\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-b",
          "type": "part",
          "label": "b",
          "prompt": "$(x-2)\\;\\&\\;4(x-2)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$4(x-2)$",
            "worked": "$$\\begin{aligned}&(x-2)=1\\times(x-2)\\\\&4(x-2)=2^{2}\\times(x-2)\\\\&\\text{LCM}=4(x-2)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-c",
          "type": "part",
          "label": "c",
          "prompt": "$(x+3)(x-1)\\;\\&\\;(x-1)(x+7)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$(x+3)(x-1)(x+7)$",
            "worked": "$$\\begin{aligned}&(x+3)(x-1)\\\\&(x-1)(x+7)\\\\&\\text{LCM}=(x+3)(x-1)(x+7)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-d",
          "type": "part",
          "label": "d",
          "prompt": "$x(x+4)\\;\\&\\;(x+4)(x-2)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$x(x+4)(x-2)$",
            "worked": "$$\\begin{aligned}&x(x+4)\\\\&(x+4)(x-2)\\\\&\\text{LCM}=x(x+4)(x-2)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-e",
          "type": "part",
          "label": "e",
          "prompt": "$(x+1)^{2}\\;\\&\\;(x+1)(x-5)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$(x+1)^{2}(x-5)$",
            "worked": "$$\\begin{aligned}&(x+1)^{2}\\\\&(x+1)(x-5)\\\\&\\text{LCM}=(x+1)^{2}(x-5)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-f",
          "type": "part",
          "label": "f",
          "prompt": "$(x+2)(x-3)\\;\\&\\;(x-3)(2x+1)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$(x+2)(x-3)(2x+1)$",
            "worked": "$$\\begin{aligned}&(x+2)(x-3)\\\\&(x-3)(2x+1)\\\\&\\text{LCM}=(x+2)(x-3)(2x+1)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-g",
          "type": "part",
          "label": "g",
          "prompt": "$x(x-2)\\;\\&\\;(x-2)(x+3)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$x(x-2)(x+3)$",
            "worked": "$$\\begin{aligned}&x(x-2)\\\\&(x-2)(x+3)\\\\&\\text{LCM}=x(x-2)(x+3)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-h",
          "type": "part",
          "label": "h",
          "prompt": "$4x(x+5)\\;\\&\\;2x^{2}(x+5)(x-3)$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$4x^{2}(x+5)(x-3)$",
            "worked": "$$\\begin{aligned}&4x(x+5)=2^{2}\\times x(x+5)\\\\&2x^{2}(x+5)(x-3)=2\\times x^{2}(x+5)(x-3)\\\\&\\text{LCM}=4x^{2}(x+5)(x-3)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-i",
          "type": "part",
          "label": "i",
          "prompt": "$x+2\\;\\&\\;x^{2}+5x+6$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$(x+2)(x+3)$",
            "worked": "$$\\begin{aligned}&x+2\\\\&x^{2}+5x+6=(x+2)(x+3)\\\\&\\text{LCM}=(x+2)(x+3)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p39-j",
          "type": "part",
          "label": "j",
          "prompt": "$x^{2}-4\\;\\&\\;x+2$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$(x-2)(x+2)$",
            "worked": "$$\\begin{aligned}&x^{2}-4=(x-2)(x+2)\\\\&x+2\\\\&\\text{LCM}=(x-2)(x+2)\\end{aligned}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        }
      ]
    },
