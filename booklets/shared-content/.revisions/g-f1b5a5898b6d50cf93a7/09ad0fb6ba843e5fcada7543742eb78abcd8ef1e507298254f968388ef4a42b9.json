      {
        "id": "p30-ex1",
        "label": "",
        "prompt": "$\\dfrac{y+1}{5}+\\dfrac{2y}{3}$",
        "theorySolution": "$$\\begin{array}{ll}\\color{#ef6068}\\text{1. same denominators}&\\color{#268cff}\\dfrac{3(y+1)}{15}+\\dfrac{5(2y)}{15}\\\\\\color{#ef6068}\\text{2. add numerators}&\\color{#268cff}\\dfrac{3(y+1)+5(2y)}{15}\\\\\\color{#ef6068}\\text{3. simplify}&\\mathrel{\\phantom{=}}\\color{#268cff}\\dfrac{3y+3+10y}{15}\\\\&\\color{#268cff}=\\dfrac{13y+3}{15}\\end{array}$$"
      },
      {
        "id": "p30-ex2",
        "label": "",
        "prompt": "$\\dfrac{x+3}{2}+\\dfrac{x-2}{5}$",
        "theorySolution": "$$\\begin{array}{ll}\\color{#ef6068}\\text{1. same denominators}&\\color{#268cff}\\dfrac{5(x+3)}{10}+\\dfrac{2(x-2)}{10}\\\\\\color{#ef6068}\\text{2. add numerators}&\\color{#268cff}\\dfrac{5(x+3)+2(x-2)}{10}\\\\\\color{#ef6068}\\text{3. simplify}&\\mathrel{\\phantom{=}}\\color{#268cff}\\dfrac{5x+15+2x-4}{10}\\\\&\\color{#268cff}=\\dfrac{7x+11}{10}\\end{array}$$"
      }
    ],
