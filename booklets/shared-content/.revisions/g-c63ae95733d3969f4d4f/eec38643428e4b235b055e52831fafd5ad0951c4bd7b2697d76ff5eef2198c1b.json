        {
          "id": "p25-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$x^2+10x+25$",
          "answerSpaceMm": 28,
          "answer": {
            "short": "$(x+5)^2$",
            "worked": "$x^2=(x)^2$, $25=5^2$.\n\nCheck: $2\\times x\\times5=10x$.\n\n$$\\begin{align*}x^2+10x+25&=(x+5)^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p25-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$x^2+18x+81$",
          "answerSpaceMm": 28,
          "answer": {
            "short": "$(x+9)^2$",
            "worked": "$x^2=(x)^2$, $81=9^2$.\n\nCheck: $2\\times x\\times9=18x$.\n\n$$\\begin{align*}x^2+18x+81&=(x+9)^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p25-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$p^2+2pq+q^2$",
          "answerSpaceMm": 28,
          "answer": {
            "short": "$(p+q)^2$",
            "worked": "The square factors are $p$ and $q$.\n\nCheck: $2\\times p\\times q=2pq$.\n\n$$\\begin{align*}p^2+2pq+q^2&=(p+q)^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p25-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$x^2-16x+64$",
          "answerSpaceMm": 28,
          "answer": {
            "short": "$(x-8)^2$",
            "worked": "$x^2=(x)^2$, $64=8^2$.\n\nCheck: $2\\times x\\times8=16x$; the middle term is negative.\n\n$$\\begin{align*}x^2-16x+64&=(x-8)^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p25-guided-e",
          "type": "part",
          "label": "e",
          "prompt": "$25x^2+60x+36$",
          "answerSpaceMm": 28,
          "answer": {
            "short": "$(5x+6)^2$",
            "worked": "$25x^2=(5x)^2$, $36=6^2$.\n\nCheck: $2\\times5x\\times6=60x$.\n\n$$\\begin{align*}25x^2+60x+36&=(5x+6)^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p25-guided-f",
          "type": "part",
          "label": "f",
          "prompt": "$x^6-14x^3+49$",
          "answerSpaceMm": 28,
          "answer": {
            "short": "$(x^3-7)^2$",
            "worked": "$x^6=(x^3)^2$, $49=7^2$.\n\nCheck: $2\\times x^3\\times7=14x^3$; the middle term is negative.\n\n$$\\begin{align*}x^6-14x^3+49&=(x^3-7)^2\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
