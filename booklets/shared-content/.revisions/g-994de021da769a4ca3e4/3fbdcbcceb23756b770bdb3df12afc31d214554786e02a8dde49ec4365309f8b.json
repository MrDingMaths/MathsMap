      "children": [
        {
          "id": "p23-q14-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\log_{25}45-\\log_{25}9$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\frac12$",
            "worked": "$$\\begin{align*}\\log_{25}45-\\log_{25}9&=\\log_{25}\\left(\\frac{45}{9}\\right)\\\\\\log_{25}45-\\log_{25}9&=\\log_{25}25^{1/2}\\\\\\log_{25}45-\\log_{25}9&=\\frac12\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p23-q14-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\log_{81}12-\\log_{81}36$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$-\\frac14$",
            "worked": "$$\\begin{align*}\\log_{81}12-\\log_{81}36&=\\log_{81}\\left(\\frac{12}{36}\\right)\\\\\\log_{81}12-\\log_{81}36&=\\log_{81}81^{-1/4}\\\\\\log_{81}12-\\log_{81}36&=-\\frac14\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p23-q14-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\log_8 3-\\log_8 96$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$-\\frac53$",
            "worked": "$$\\begin{align*}\\log_8 3-\\log_8 96&=\\log_8\\left(\\frac{3}{96}\\right)\\\\\\log_8 3-\\log_8 96&=\\log_8 8^{-5/3}\\\\\\log_8 3-\\log_8 96&=-\\frac53\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p23-q14-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\log_{\\frac1{32}}5-\\log_{\\frac1{32}}10$",
          "answerSpaceMm": 30,
          "answer": {
            "short": "$\\frac15$",
            "worked": "$$\\begin{align*}\\log_{\\frac1{32}}5-\\log_{\\frac1{32}}10&=\\log_{\\frac1{32}}\\left(\\frac5{10}\\right)\\\\\\log_{\\frac1{32}}5-\\log_{\\frac1{32}}10&=\\log_{\\frac1{32}}\\left(\\frac1{32}\\right)^{1/5}\\\\\\log_{\\frac1{32}}5-\\log_{\\frac1{32}}10&=\\frac15\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
