    "content": {
      "id": "p28-guided-root",
      "type": "group",
      "label": "",
      "prompt": "Simplify by writing these expressions with prime bases.",
      "layout": "grid",
      "columns": 2,
      "children": [
        {
          "id": "p28-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$2^n \\times 4^n \\times 8^n$",
          "answerSpaceMm": 24,
          "answer": {
            "short": "$2^{6n}$",
            "worked": "$$\\begin{align*}2^n \\times 4^n \\times 8^n &= 2^n \\times 2^{2n} \\times 2^{3n} \\\\ &= 2^{n+2n+3n} \\\\ &= 2^{6n}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p28-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$18^n \\times 12$",
          "answerSpaceMm": 32,
          "answer": {
            "short": "$2^{n+2} \\times 3^{2n+1}$",
            "worked": "$$\\begin{align*}18^n \\times 12 &= (2 \\times 3^2)^n \\times 2^2 \\times 3 \\\\ &= 2^n \\times 3^{2n} \\times 2^2 \\times 3 \\\\ &= 2^{n+2} \\times 3^{2n+1}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p28-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$100^{2n-1} \\times 25^{-1} \\times 8^{-1}$",
          "answerSpaceMm": 40,
          "answer": {
            "short": "$2^{4n-5} \\times 5^{4n-4}$",
            "worked": "$$\\begin{align*}100^{2n-1} \\times 25^{-1} \\times 8^{-1} &= (2^2 \\times 5^2)^{2n-1} \\times (5^2)^{-1} \\times (2^3)^{-1} \\\\ &= 2^{4n-2} \\times 5^{4n-2} \\times 5^{-2} \\times 2^{-3} \\\\ &= 2^{4n-2-3} \\times 5^{4n-2-2} \\\\ &= 2^{4n-5} \\times 5^{4n-4}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p28-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{9^{n+2} \\times 3^{n+1}}{3 \\times 27^n}$",
          "answerSpaceMm": 40,
          "answer": {
            "short": "$81$",
            "worked": "$$\\begin{align*}\\frac{9^{n+2} \\times 3^{n+1}}{3 \\times 27^n} &= \\frac{3^{2n+4} \\times 3^{n+1}}{3 \\times 3^{3n}} \\\\ &= \\frac{3^{3n+5}}{3^{3n+1}} \\\\ &= 3^4 \\\\ &= 81\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
