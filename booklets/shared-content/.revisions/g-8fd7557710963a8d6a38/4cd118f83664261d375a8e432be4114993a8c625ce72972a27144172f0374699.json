    "content": {
      "id": "p32-t3",
      "type": "group",
      "label": "",
      "prompt": "Simplify these expressions.",
      "layout": "grid",
      "columns": 3,
      "children": [
        {
          "id": "p32-q1a",
          "type": "part",
          "label": "a",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p32-q1a-given",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\frac{x-4}{2}-\\frac{x+2}{3}",
                    "display": false
                  }
                ]
              },
              {
                "id": "p32-q1a-scaffold",
                "type": "paragraph",
                "align": "left",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "\\color{#268cff}\\begin{aligned}&=\\frac{3(\\hspace{12mm})}{6}-\\frac{2(\\hspace{12mm})}{6}\\\\&=\\frac{3(\\hspace{11.5mm})-2(\\hspace{11.5mm})}{6}\\end{aligned}",
                    "display": true
                  }
                ]
              }
            ]
          },
          "answerSpaceMm": 25,
          "answer": {
            "short": "$\\dfrac{x-16}{6}$",
            "worked": "$$\\begin{aligned}\\frac{x-4}{2}-\\frac{x+2}{3}&=\\frac{3(x-4)}{6}-\\frac{2(x+2)}{6}\\\\&=\\frac{3(x-4)-2(x+2)}{6}\\\\&=\\frac{3x-12-2x-4}{6}\\\\&=\\frac{x-16}{6}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p32-q1b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{x+1}{2}-\\dfrac{2x+3}{5}$",
          "answerSpaceMm": 50,
          "answer": {
            "short": "$\\dfrac{x-1}{10}$",
            "worked": "$$\\begin{aligned}\\frac{x+1}{2}-\\frac{2x+3}{5}&=\\frac{5(x+1)}{10}-\\frac{2(2x+3)}{10}\\\\&=\\frac{5(x+1)-2(2x+3)}{10}\\\\&=\\frac{5x+5-4x-6}{10}\\\\&=\\frac{x-1}{10}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p32-q1c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{2x+1}{4}-\\dfrac{2-x}{3}$",
          "answerSpaceMm": 50,
          "answer": {
            "short": "$\\dfrac{10x-5}{12}$",
            "worked": "$$\\begin{aligned}\\frac{2x+1}{4}-\\frac{2-x}{3}&=\\frac{3(2x+1)}{12}-\\frac{4(2-x)}{12}\\\\&=\\frac{3(2x+1)-4(2-x)}{12}\\\\&=\\frac{6x+3-8+4x}{12}\\\\&=\\frac{10x-5}{12}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
    },
