            "worked": "$$\\begin{aligned}y-\\sqrt{rs}&=x+\\sqrt{rs}-\\sqrt{rs}\\\\y-\\sqrt{rs}&=x\\\\x&=y-\\sqrt{rs}\\end{aligned}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
