                ]
              }
            ]
          },
          "responseSpace": "scaffold",
          "answerSpaceMm": 0,
          "answer": {
            "short": "$\\dfrac{-x-y}{a+b}=\\dfrac{x+y}{-a-b}$",
            "worked": "Negate every term in either the numerator or the denominator:\n$$-\\frac{x+y}{a+b}=\\frac{-x-y}{a+b}=\\frac{x+y}{-a-b}.$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
