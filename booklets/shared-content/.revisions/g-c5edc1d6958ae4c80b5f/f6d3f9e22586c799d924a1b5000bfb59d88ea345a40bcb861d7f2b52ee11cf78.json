    "content": {
      "id": "p7-working-negative-root",
      "type": "group",
      "label": "",
      "prompt": "Write as many equivalent fractions as possible.",
      "children": [
        {
          "id": "p7-a",
          "type": "part",
          "label": "a",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-a-line",
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "-\\frac{3}{5}=",
                    "display": false
                  },
                  {
                    "type": "cloze",
                    "answer": "$\\frac{-3}{5}=\\frac{3}{-5}$",
                    "width": 26
                  }
                ]
              }
            ]
          },
          "responseSpace": "scaffold",
          "answerSpaceMm": 0,
          "answer": {
            "short": "$\\dfrac{-3}{5}=\\dfrac{3}{-5}$",
            "worked": "Move the negative into either the numerator or the denominator:\n$$-\\frac{3}{5}=\\frac{-3}{5}=\\frac{3}{-5}.$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p7-b",
          "type": "part",
          "label": "b",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-b-line",
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "-\\frac{x+y}{3}=",
                    "display": false
                  },
                  {
                    "type": "cloze",
                    "answer": "$\\frac{-x-y}{3}=\\frac{x+y}{-3}$",
                    "width": 35
                  }
                ]
              }
            ]
          },
          "responseSpace": "scaffold",
          "answerSpaceMm": 0,
          "answer": {
            "short": "$\\dfrac{-x-y}{3}=\\dfrac{x+y}{-3}$",
            "worked": "Negate both numerator terms, or negate the denominator:\n$$-\\frac{x+y}{3}=\\frac{-x-y}{3}=\\frac{x+y}{-3}.$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p7-c",
          "type": "part",
          "label": "c",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
            "blocks": [
              {
                "id": "p7-c-line",
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "math",
                    "latex": "-\\frac{x-y}{3}=",
                    "display": false
                  },
                  {
                    "type": "cloze",
                    "answer": "$\\frac{-x+y}{3}=\\frac{x-y}{-3}$",
                    "width": 35
                  }
                ]
              }
            ]
          },
          "responseSpace": "scaffold",
          "answerSpaceMm": 0,
          "answer": {
            "short": "$\\dfrac{y-x}{3}=\\dfrac{x-y}{-3}$",
            "worked": "Negating $x-y$ gives $-x+y=y-x$:\n$$-\\frac{x-y}{3}=\\frac{-x+y}{3}=\\frac{y-x}{3}=\\frac{x-y}{-3}.$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p7-d",
          "type": "part",
          "label": "d",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
