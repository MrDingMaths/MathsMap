                  {
                    "type": "math",
                    "latex": "\\frac{x-y}{3}=",
                    "display": false
                  },
                  {
                    "type": "cloze",
                    "answer": "$-\\frac{y-x}{3}=\\frac{y-x}{-3}$",
                    "width": 35
                  }
                ]
              }
            ]
          },
          "responseSpace": "scaffold",
          "answerSpaceMm": 0,
          "answer": {
            "short": "$-\\dfrac{y-x}{3}=\\dfrac{y-x}{-3}$",
            "worked": "Since $x-y=-(y-x)$,\n$$\\frac{x-y}{3}=-\\frac{y-x}{3}=\\frac{y-x}{-3}.$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p7-e",
          "type": "part",
          "label": "e",
          "prompt": {
            "format": "maths-editor-document-v1",
            "version": 1,
