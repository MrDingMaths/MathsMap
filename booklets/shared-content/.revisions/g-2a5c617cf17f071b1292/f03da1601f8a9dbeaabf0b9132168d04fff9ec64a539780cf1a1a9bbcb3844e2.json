          "type": "paragraph",
          "align": "left",
          "inlines": [
            {
              "type": "text",
              "text": "To factorise a non-monic quadratic trinomial: "
            },
            {
              "type": "math",
              "latex": "ax^2+bx+c",
              "display": false
            }
          ],
          "spaceAfter": 1
        },
