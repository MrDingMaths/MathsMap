    "content": {
      "format": "maths-editor-document-v1",
      "version": 1,
      "blocks": [
        {
          "id": "p29-definition-description",
          "type": "paragraph",
          "inlines": [
            {
              "type": "text",
              "text": "A "
            },
            {
              "type": "text",
              "text": "scale drawing",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": " is a smaller or larger drawing of a real-life object."
            }
          ]
        },
        {
          "id": "p29-definition-examples",
          "type": "paragraph",
          "inlines": [
            {
              "type": "text",
              "text": "Examples include maps, house plans, and scientific diagrams."
            }
          ]
        },
        {
          "id": "p29-definition-terminology",
          "type": "paragraph",
          "inlines": [
            {
              "type": "text",
              "text": "We call the real-life object the "
            },
            {
              "type": "text",
              "text": "original",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": ", and the drawing the "
            },
            {
              "type": "text",
              "text": "image",
              "marks": [
                "bold"
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "id": "p29-definition-notation-intro",
          "type": "paragraph",
          "inlines": [
            {
              "type": "text",
              "text": "Scales for scale drawings are written in "
            },
            {
              "type": "text",
              "text": "simplified ratio notation:",
              "marks": [
                "bold"
              ]
            }
          ]
        },
        {
          "id": "p29-scale-notation",
          "type": "paragraph",
          "align": "center",
          "inlines": [
            {
              "type": "math",
              "latex": "\\begin{gathered}\\text{image}:\\text{original}\\\\1:n\\quad\\text{or}\\quad n:1\\\\\\text{For }n>1:\\quad1:n\\text{ is a reduction;}\\\\n:1\\text{ is an enlargement.}\\end{gathered}",
              "display": true
            }
          ]
        },
        {
          "id": "p29-definition-scale-meaning",
          "type": "paragraph",
          "inlines": [
            {
              "type": "text",
              "text": "A scale of "
            },
            {
              "type": "math",
              "latex": "1:500",
              "display": false
            },
            {
              "type": "text",
              "text": " means every 1 unit on the drawing is 500 units in real life."
            }
          ]
        },
        {
          "id": "p29-scale-method",
          "type": "list",
          "ordered": true,
          "start": 1,
          "indent": 7,
          "items": [
            {
              "id": "p29-scale-method-first",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p29-scale-method-table-instruction",
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Set up a ratio table "
                    },
                    {
                      "type": "text",
                      "text": "image : original",
                      "marks": [
                        "bold",
                        "italic"
                      ]
                    }
                  ]
                },
                {
                  "id": "p29-scale-method-row-a",
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "a. The first row should be the given scale."
                    }
                  ]
                },
                {
                  "id": "p29-scale-method-row-b",
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "b. The second row should be the given length and the length you want to find."
                    }
                  ]
                }
              ]
            },
            {
              "id": "p29-scale-method-second",
              "type": "list-item",
              "blocks": [
                {
                  "id": "p29-scale-method-operation",
