          "id": "p8-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$y+2x=5$",
          "answerSpaceMm": 21,
          "answer": {
            "short": "$m=-2,\\ c=5$",
            "worked": "$$\\begin{aligned}y&=-2x+5\\end{aligned}$$\nGradient: $-2$; $y$-intercept: $5$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p8-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$x-y=7$",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$m=1,\\ c=-7$",
            "worked": "$$\\begin{aligned}-y&=7-x\\\\y&=x-7\\end{aligned}$$\nGradient: $1$; $y$-intercept: $-7$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p8-guided-c",
          "type": "part",
          "label": "c",
          "prompt": "$4x+2y=1$",
          "answerSpaceMm": 33,
          "answer": {
            "short": "$m=-2,\\ c=0.5$",
            "worked": "$$\\begin{aligned}2y&=-4x+1\\\\y&=\\frac{-4x}{2}+\\frac{1}{2}\\\\y&=-2x+\\frac{1}{2}\\end{aligned}$$\nGradient: $-2$; $y$-intercept: $\\frac{1}{2}=0.5$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p8-guided-d",
          "type": "part",
          "label": "d",
          "prompt": "$-2x-5y=3$",
          "answerSpaceMm": 35,
          "answer": {
            "short": "$m=-\\frac{2}{5},\\ c=-\\frac{3}{5}$",
            "worked": "$$\\begin{aligned}-5y&=2x+3\\\\y&=\\frac{2x}{-5}+\\frac{3}{-5}\\\\y&=-\\frac{2}{5}x-\\frac{3}{5}\\end{aligned}$$\nGradient: $-\\frac{2}{5}$; $y$-intercept: $-\\frac{3}{5}$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
