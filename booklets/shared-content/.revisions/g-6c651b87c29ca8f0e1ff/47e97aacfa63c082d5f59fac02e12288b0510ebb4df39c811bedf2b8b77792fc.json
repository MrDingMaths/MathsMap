    "content": {
      "id": "p27-q1-root",
      "type": "question",
      "label": "1",
      "prompt": "$\\frac{1}{3}$ as a decimal is $0.333333333333333\\ldots$",
      "layout": "list",
      "children": [
        {
          "id": "p27-q1-a",
          "type": "part",
          "label": "a",
          "prompt": "Express this recurring decimal using the correct notation.",
          "answerSpaceMm": 12,
          "answer": {
            "short": "$0.\\dot{3}$",
            "worked": "The digit $3$ repeats indefinitely, so place a dot above it: $0.\\dot{3}$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p27-q1-b",
          "type": "part",
          "label": "b",
          "prompt": "Without using a calculator, what would $\\frac{2}{3}$ be?",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$0.\\dot{6}$",
            "worked": "$$\\begin{align*}\\frac{2}{3}&=2\\times\\frac{1}{3}\\\\\\frac{2}{3}&=2\\times0.333333\\ldots\\\\\\frac{2}{3}&=0.\\dot{6}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p27-q1-c",
          "type": "part",
          "label": "c",
          "prompt": "Check $2\\div3$ on a calculator using decimal display. Explain why the displayed decimal is an approximation to your answer to part b.",
          "answerSpaceMm": 20,
          "answer": {
            "short": "The display shows only a limited number of decimal places. A rounded display ends in 7, while the exact decimal has 6 recurring indefinitely.",
            "worked": "$$2\\div3=0.666666\\ldots=0.\\dot{6}$$\nThe exact decimal continues indefinitely. A calculator's decimal display has a limited number of places, so it shows an approximation. If the display rounds the decimal, the final displayed $6$ becomes $7$.",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        }
      ]
