                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "reuse-s5-p95-q25-check",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{align*}6&=2\\times3\\\\(6+4)+(3+4)&=17\\end{align*}",
                  "display": true,
                  "colour": "#268cff"
                }
              ]
            },
            {
