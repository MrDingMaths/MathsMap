            "inlines": [
              {
                "type": "text",
                "text": "Flo has two cats, Misty and Smokey. Misty is twice as old as Smokey."
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "In four years’ time, the sum of their ages will be 17. How old is Misty now?"
              }
            ],
            "spaceAfter": 1
          }
        ]
      },
      "answerSpaceMm": 82,
      "answer": {
        "short": "Misty is 6 years old. $2s+s+8=17$, so $s=3$ and $m=6$.",
        "worked": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "reuse-s5-p95-q25-answer",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "text",
                  "text": "Let ",
                  "colour": "#268cff"
                },
                {
                  "type": "math",
                  "latex": "s",
                  "display": false,
                  "colour": "#268cff"
                },
                {
                  "type": "text",
                  "text": " = Smokey’s current age and ",
                  "colour": "#268cff"
                },
                {
                  "type": "math",
                  "latex": "m",
                  "display": false,
                  "colour": "#268cff"
                },
                {
                  "type": "text",
                  "text": " = Misty’s current age, in years.",
                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "reuse-s5-p95-q25-relationship",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "math",
                  "latex": "m=2s",
                  "display": false,
                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "reuse-s5-p95-q25-future-ages",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "text",
                  "text": "In four years:",
                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "reuse-s5-p95-q25-equation-working",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "math",
                  "latex": "\\begin{align*}(m+4)+(s+4)&=17\\\\2s+s+8&=17\\\\3s+8&=17\\\\3s&=9\\\\s&=3\\\\m&=2\\times3=6\\end{align*}",
                  "display": true,
                  "colour": "#268cff"
                }
              ]
            },
            {
              "id": "reuse-s5-p95-q25-check-introduction",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "text",
