    "content": {
      "id": "p10-tickets-root",
      "type": "group",
      "label": "",
      "prompt": "Adult concert tickets cost $\\$5$ more than child tickets. Two adult tickets and two child tickets cost $\\$70$ in total. Find the cost of each ticket.",
      "children": [
        {
          "id": "p10-tickets-step1",
          "type": "part",
          "label": "1",
          "prompt": "",
          "answerSpaceMm": 13,
          "answer": {
            "short": "Let $a$ be the adult ticket cost and $c$ be the child ticket cost, both in dollars.",
            "worked": "Let $a$ be the adult ticket cost and $c$ be the child ticket cost, both in dollars.",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p10-tickets-step2",
          "type": "part",
          "label": "2",
          "prompt": "",
          "answerSpaceMm": 15,
          "answer": {
            "short": "$a-c=5$ (1); $2a+2c=70$ (2).",
            "worked": "$$\\begin{align*}a-c&=5\\qquad (1)\\\\2a+2c&=70\\qquad (2)\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p10-tickets-step3",
          "type": "part",
          "label": "3",
          "prompt": "",
          "answerSpaceMm": 31,
          "answer": {
            "short": "$a=20$, $c=15$.",
            "worked": "Multiply (1) by 2.\n$$\\begin{align*}2a-2c&=10\\qquad (3)\\end{align*}$$\nAdd (2) and (3).\n$$\\begin{align*}4a&=80\\\\a&=20\\end{align*}$$\nSubstitute $a=20$ into (1).\n$$\\begin{align*}20-c&=5\\\\c&=15\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p10-tickets-step4",
          "type": "part",
          "label": "4",
          "prompt": "",
          "answerSpaceMm": 10,
          "answer": {
            "short": "Child: $\\$15$; adult: $\\$20$.",
            "worked": "Each child ticket costs $\\$15$ and each adult ticket costs $\\$20$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
