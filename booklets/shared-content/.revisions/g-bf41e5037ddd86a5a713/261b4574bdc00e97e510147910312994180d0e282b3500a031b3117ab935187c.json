    "pedagogyRole": "identify",
    "content": {
      "id": "p12-cancelling-question",
      "type": "group",
      "label": "",
      "prompt": "Simplify these fractions by cancelling common factors.",
      "layout": "grid",
      "columns": 3,
      "children": [
        {
          "id": "p12-cancelling-a",
          "type": "part",
          "label": "a",
          "prompt": "$\\dfrac{(x+1)(x+4)}{x+1}$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$x+4$",
            "worked": "$$\\begin{align*}\\frac{(x+1)(x+4)}{x+1}&=x+4\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-b",
          "type": "part",
          "label": "b",
          "prompt": "$\\dfrac{(x-3)(x+2)}{(x+2)(x+5)}$",
          "answerSpaceMm": 16,
          "answer": {
            "short": "$\\dfrac{x-3}{x+5}$",
            "worked": "$$\\begin{align*}\\frac{(x-3)(x+2)}{(x+2)(x+5)}&=\\frac{x-3}{x+5}\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-c",
          "type": "part",
          "label": "c",
          "prompt": "$\\dfrac{2(x+3)(x-1)}{8(x+3)(x+2)}$",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$\\dfrac{x-1}{4(x+2)}$",
            "worked": "$$\\begin{align*}\\frac{2(x+3)(x-1)}{8(x+3)(x+2)}&=\\frac{2(x-1)}{8(x+2)}\\\\&=\\frac{x-1}{4(x+2)}\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-d",
          "type": "part",
          "label": "d",
          "prompt": "$\\dfrac{(x+3)(x+4)}{x+4}$",
          "answerSpaceMm": 14,
          "answer": {
            "short": "$x+3$",
            "worked": "$$\\begin{align*}\\frac{(x+3)(x+4)}{x+4}&=x+3\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-e",
          "type": "part",
          "label": "e",
          "prompt": "$\\dfrac{2(x-1)(x+5)}{4(x+5)}$",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$\\dfrac{x-1}{2}$",
            "worked": "$$\\begin{align*}\\frac{2(x-1)(x+5)}{4(x+5)}&=\\frac{2(x-1)}4\\\\&=\\frac{x-1}2\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-f",
          "type": "part",
          "label": "f",
          "prompt": "$\\dfrac{(x-3)(x+2)}{3(x+2)(x+7)}$",
          "answerSpaceMm": 16,
          "answer": {
            "short": "$\\dfrac{x-3}{3(x+7)}$",
            "worked": "$$\\begin{align*}\\frac{(x-3)(x+2)}{3(x+2)(x+7)}&=\\frac{x-3}{3(x+7)}\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-g",
          "type": "part",
          "label": "g",
          "prompt": "$\\dfrac{x-2}{(2-x)(x+3)}$",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$-\\dfrac1{x+3}$",
            "worked": "$$\\begin{align*}\\frac{x-2}{(2-x)(x+3)}&=\\frac{x-2}{-(x-2)(x+3)}\\\\&=-\\frac1{x+3}\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-h",
          "type": "part",
          "label": "h",
          "prompt": "$\\dfrac{(x-5)(x+7)}{(x+5)(5-x)}$",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$-\\dfrac{x+7}{x+5}$",
            "worked": "$$\\begin{align*}\\frac{(x-5)(x+7)}{(x+5)(5-x)}&=\\frac{(x-5)(x+7)}{-(x+5)(x-5)}\\\\&=-\\frac{x+7}{x+5}\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p12-cancelling-i",
          "type": "part",
          "label": "i",
          "prompt": "$\\dfrac{3(x-4)^2}{(x-4)(x+2)}$",
          "answerSpaceMm": 26,
          "answer": {
            "short": "$\\dfrac{3(x-4)}{x+2}$",
            "worked": "$$\\begin{align*}\\frac{3(x-4)^2}{(x-4)(x+2)}&=\\frac{3(x-4)(x-4)}{(x-4)(x+2)}\\\\&=\\frac{3(x-4)}{x+2}\\end{align*}$$",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        }
      ]
    },
