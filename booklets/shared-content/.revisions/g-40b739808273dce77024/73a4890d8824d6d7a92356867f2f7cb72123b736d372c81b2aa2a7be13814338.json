      "children": [
        {
          "id": "p33-q",
          "type": "group",
          "label": "",
          "prompt": "Decide whether these fractions can be simplified.",
          "layout": "grid",
          "columns": 3,
          "children": [
            {
              "id": "p33-a",
              "type": "part",
              "label": "a",
              "prompt": "$\\frac{3x+9}{3}$",
              "answerSpaceMm": 12,
              "answer": {
                "short": "Tick: it can be simplified.",
                "worked": "$3x+9=3(x+3)$, so $3$ is a common factor of the numerator and denominator.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p33-b",
              "type": "part",
              "label": "b",
              "prompt": "$\\frac{3x+5}{3}$",
              "answerSpaceMm": 12,
              "answer": {
                "short": "Cross: it cannot be simplified.",
                "worked": "$3x+5$ has no factor $3$ (it is not $3(\\ldots)$), so there is no common factor other than $1$.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p33-c",
              "type": "part",
              "label": "c",
              "prompt": "$\\frac{(x-4)(x+4)}{x+4}$",
              "answerSpaceMm": 12,
              "answer": {
                "short": "Tick: it can be simplified.",
                "worked": "$(x+4)$ is a common factor of the numerator and denominator.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p33-d",
              "type": "part",
              "label": "d",
              "prompt": "$\\frac{x^{2}+3}{x}$",
              "answerSpaceMm": 12,
              "answer": {
                "short": "Cross: it cannot be simplified.",
                "worked": "$x$ is not a factor of the term $3$, so the numerator has no common factor with $x$.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p33-e",
              "type": "part",
              "label": "e",
              "prompt": "$\\frac{x^{2}+3x}{x}$",
              "answerSpaceMm": 12,
              "answer": {
                "short": "Tick: it can be simplified.",
                "worked": "$x^{2}+3x=x(x+3)$, so $x$ is a common factor.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            },
            {
              "id": "p33-f",
              "type": "part",
              "label": "f",
              "prompt": "$\\frac{(x+4)(x+2)}{x-2}$",
              "answerSpaceMm": 12,
              "answer": {
                "short": "Cross: it cannot be simplified.",
                "worked": "The denominator $(x-2)$ is not a factor of the numerator.",
                "provenance": {
                  "short": "authored",
                  "worked": "authored"
                }
              }
            }
          ]
        }
      ]
