      "label": "",
      "prompt": "Write in the form $a+\\frac{b}{x+r}$.",
      "layout": "grid",
      "columns": 2,
      "children": [
        {
          "id": "p30-guided-a",
          "type": "part",
          "label": "a",
          "prompt": "$$\\frac{x+1}{x+5}$$",
          "answerSpaceMm": 25,
          "answer": {
            "short": "$1-\\frac{4}{x+5}$",
            "worked": "$$\\begin{align*}\\frac{x+1}{x+5}&=a+\\frac{b}{x+5}\\\\x+1&=a(x+5)+b\\\\x+1&=ax+5a+b\\end{align*}$$\nEquating coefficients:\n$$\\begin{align*}a&=1\\\\5a+b&=1\\\\5+b&=1\\\\b&=-4\\\\\\frac{x+1}{x+5}&=1-\\frac{4}{x+5}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p30-guided-b",
          "type": "part",
          "label": "b",
          "prompt": "$$\\frac{2x+3}{x+5}$$",
          "answerSpaceMm": 25,
          "answer": {
            "short": "$2-\\frac{7}{x+5}$",
            "worked": "$$\\begin{align*}\\frac{2x+3}{x+5}&=a+\\frac{b}{x+5}\\\\2x+3&=a(x+5)+b\\\\2x+3&=ax+5a+b\\end{align*}$$\nEquating coefficients:\n$$\\begin{align*}a&=2\\\\5a+b&=3\\\\10+b&=3\\\\b&=-7\\\\\\frac{2x+3}{x+5}&=2-\\frac{7}{x+5}\\end{align*}$$",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
