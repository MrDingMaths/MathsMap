            "align": "left",
            "inlines": [
              {
                "type": "text",
                "text": "Ed collects 5c and 10c coins in a jar. The jar contains three more 5c coins than 10c coins."
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Altogether there is $1.80 in the jar."
              },
              {
                "type": "break"
              },
              {
                "type": "text",
                "text": "Form and solve an equation to find the number, "
              },
              {
                "type": "math",
                "latex": "x",
                "display": false
              },
              {
                "type": "text",
                "text": ", of 10c coins in the jar."
              }
            ],
            "spaceAfter": 1
          }
        ]
      },
      "answerSpaceMm": 56,
      "answer": {
        "short": "$5(x+3)+10x=180$; $x=11$. There are 11 ten-cent coins.",
        "worked": {
          "format": "maths-editor-document-v1",
          "version": 1,
          "blocks": [
            {
              "id": "reuse-s5-p94-q17-answer",
              "type": "paragraph",
              "align": "right",
              "inlines": [
                {
                  "type": "text",
                  "text": "Let "
                },
                {
                  "type": "math",
                  "latex": "x",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " be the number of 10c coins."
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Number of 5c coins "
                },
                {
                  "type": "math",
                  "latex": "=x+3",
                  "display": false
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Using cents:"
                },
                {
                  "type": "break"
                },
                {
                  "type": "math",
                  "latex": "\\begin{align*}5(x+3)+10x&=180\\\\15x+15&=180\\\\15x&=165\\\\x&=11\\end{align*}",
                  "display": true
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "There are 11 ten-cent coins and 14 five-cent coins."
                },
                {
                  "type": "break"
                },
                {
                  "type": "text",
                  "text": "Check: "
                },
                {
                  "type": "math",
                  "latex": "5(14)+10(11)=180",
                  "display": false
                },
                {
                  "type": "text",
                  "text": " cents, or $1.80."
                }
              ]
            }
          ]
        },
