      "type": "question",
      "label": "46",
      "prompt": "A number is greater than 48 squared and less than 49 squared. If 6 squared is one of its factors, and it is a multiple of 13, what is the number?",
      "answerSpaceMm": 56,
      "answer": {
        "short": "$2340$",
        "worked": {
          "format": "maths-editor-document-v1",
          "version": 1,
