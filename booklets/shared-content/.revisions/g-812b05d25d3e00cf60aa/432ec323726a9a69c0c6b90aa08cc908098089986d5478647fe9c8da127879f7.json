          "id": "p46-q4-a",
          "type": "part",
          "label": "a",
          "prompt": "Which numbers are irrational?",
          "answerSpaceMm": 16,
          "answer": {
            "short": "$\\sqrt{2},\\ \\sqrt{3},\\ \\sqrt{5},\\ 3\\sqrt{7},\\ -\\sqrt{3}$",
            "worked": "$\\sqrt{2}$, $\\sqrt{3}$, $\\sqrt{5}$ and $\\sqrt{7}$ are irrational because their radicands are not perfect squares. Multiplying $\\sqrt{7}$ by $3$ or taking the negative of $\\sqrt{3}$ preserves irrationality.\n\nThe irrational numbers are $\\sqrt{2},\\ \\sqrt{3},\\ \\sqrt{5},\\ 3\\sqrt{7},\\ -\\sqrt{3}$.",
            "provenance": {
              "short": "authored",
              "worked": "authored"
            }
          }
        },
        {
          "id": "p46-q4-b",
          "type": "part",
          "label": "b",
          "prompt": "Which numbers are rational?",
          "answerSpaceMm": 18,
          "answer": {
            "short": "$\\sqrt{4},\\ 2\\sqrt{100},\\ -\\sqrt{25}$",
            "worked": "$$\\begin{align*}\\sqrt{4}&=2\\\\2\\sqrt{100}&=2\\times10\\\\&=20\\\\-\\sqrt{25}&=-5\\end{align*}$$\nThese values are integers, so each can be written as a fraction with denominator $1$. The rational numbers are $\\sqrt{4},\\ 2\\sqrt{100},\\ -\\sqrt{25}$.",
            "provenance": {
              "short": "source",
              "worked": "authored"
            }
          }
        }
      ]
