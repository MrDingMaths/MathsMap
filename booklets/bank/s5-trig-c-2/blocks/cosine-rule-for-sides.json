    {
      "id": "cosine-rule-for-sides-proof-1",
      "type": "proof",
      "title": "Proof of the Cosine Rule",
      "origin": {
        "file": "booklets/Stage 5/Trigonometry C 2_Non-Right-Angled Trigonometry.md",
        "section": "Cosine Rule for Sides",
        "lines": [
          870,
          918
        ]
      },
      "tier": "mastery",
      "figure": {
        "png": "figures/image79.png",
        "widthCm": 6.24
      },
      "steps": [
        {
          "prompt": "Consider the non-right-angled triangle shown.\nWrite an expression for length $AP$.",
          "working": "$b - x$"
        },
        {
          "prompt": "Use Pythagoras' Theorem in $\\Delta CBP$ to write an equation relating $c$, $x$, and $h$.",
          "working": "$x^{2} + h^{2} = a^{2}$"
        },
        {
          "prompt": "Use Pythagoras' Theorem in $\\Delta ABP$ to write an equation relating $b$, $a$, $x$, and $h$.",
          "working": "$(b - x)^{2} + h^{2} = c^{2}$"
        },
        {
          "prompt": "By making $h^{2}$ the subject of your two equations above, eliminate $h$ and simplify your result.",
          "working": "$h^{2} = a^{2} - x^{2}$ and $h^{2} = c^{2} - (b - x)^{2}$\n$a^{2} - x^{2} = c^{2} - (b - x)^{2}$\n$a^{2} - x^{2} = c^{2} - (b^{2} - 2bx + x^{2})$\n$a^{2} - x^{2} = c^{2} - b^{2} + 2bx - x^{2}$\n$a^{2} = c^{2} - b^{2} + 2bx$"
        },
        {
          "prompt": "Use $\\cos\\theta = \\frac{\\text{Adjacent}}{\\text{Hypotenuse}}$ to write an expression for $\\cos C$.",
          "working": "$\\cos C = \\frac{x}{a}$"
        },
        {
          "prompt": "Combine your equations from the two parts above to prove cosine rule.",
          "working": "$x = a\\cos C$\n$a^{2} = c^{2} - b^{2} + 2ab\\cos C$\n$\\therefore c^{2} = a^{2} + b^{2} - 2ab\\cos C$"
        }
      ]
    }
