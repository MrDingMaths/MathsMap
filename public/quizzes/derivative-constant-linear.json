    {
      "id": "q4",
      "question_text": "What is the derivative of $f(x)=8-7x$?",
      "structure": "derivative-of-linear-slope-intercept",
      "mastery": false,
      "options": [
        {
          "text": "$-7$",
          "correct": true
        },
        {
          "text": "$7$",
          "why": "Omitted the negative sign on the coefficient of $x$."
        },
        {
          "text": "$8$",
          "why": "Selected the constant term 8 instead of the coefficient of $x$."
        },
        {
          "text": "$1$",
          "why": "Subtracted $8-7=1$ instead of finding the slope."
        }
      ],
      "solution_text": "$f(x)=-7x+8$\n$f'(x)=-7$"
