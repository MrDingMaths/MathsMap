    {
      "id": "q5",
      "question_text": "Find $f'(x)$ for $f(x)=\\dfrac{4x+9}{5}$.",
      "structure": "derivative-of-rearranged-linear-function",
      "mastery": false,
      "options": [
        {
          "text": "$\\dfrac{4}{5}$",
          "correct": true
        },
        {
          "text": "$4$",
          "why": "Differentiated the numerator without dividing by the denominator 5."
        },
        {
          "text": "$\\dfrac{4x}{5}$",
          "why": "Retained the variable $x$ in the derivative."
        },
        {
          "text": "$\\dfrac{13}{5}$",
          "why": "Added 4 and 9 in the numerator."
        }
      ],
      "solution_text": "$f(x)=\\dfrac{4}{5}x+\\dfrac{9}{5}$\n$f'(x)=\\dfrac{4}{5}$"
    },
    {
