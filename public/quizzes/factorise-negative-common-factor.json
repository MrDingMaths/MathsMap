  "questions": [
    {
      "id": "q1",
      "question_text": "Factorise $-4x - 10$.",
      "structure": "both-terms-negative",
      "mastery": false,
      "options": [
        {
          "text": "$-2(2x + 5)$",
          "correct": true
        },
        {
          "text": "$2(2x + 5)$",
          "why": "Took out $+2$; expanding $2(2x + 5) = 4x + 10$, the opposite sign of the original."
        },
        {
          "text": "$-2(2x - 5)$",
          "why": "Did not flip the second sign; $-10 \\div -2 = +5$, so it is $+5$ inside."
        },
        {
          "text": "$-2(2x + 10)$",
          "why": "Flipped the constant's sign but forgot to divide it by $2$, leaving $10$ instead of $5$."
        }
      ],
      "solution_text": "$-4x - 10$\n$= -2(2x + 5)$"
    },
    {
      "id": "q2",
      "question_text": "Factorise $-x - 9$.",
      "structure": "factor-out-negative-one",
      "mastery": false,
      "options": [
        {
          "text": "$-(x + 9)$",
          "correct": true
        },
        {
          "text": "$-(x - 9)$",
          "why": "Left the constant negative; $-9 \\div -1 = +9$, so it should be $+9$ inside."
        },
        {
          "text": "$(x + 9)$",
          "why": "Dropped the negative factor; $x + 9$ expands to $x + 9$, not $-x - 9$."
        },
        {
          "text": "$-9(x + 1)$",
          "why": "Treated $9$ as the common factor; $-9(x + 1) = -9x - 9$ changes the $x$ coefficient."
        }
      ],
      "solution_text": "$-x - 9$\n$= -(x + 9)$"
    },
    {
      "id": "q3",
      "question_text": "Factorise $-8m + 20$.",
      "structure": "mixed-sign-terms",
      "mastery": false,
      "options": [
        {
          "text": "$-4(2m - 5)$",
          "correct": true
        },
        {
          "text": "$-4(2m + 5)$",
          "why": "Did not flip the $+20$; dividing $20$ by $-4$ gives $-5$, not $+5$."
        },
        {
          "text": "$4(2m - 5)$",
          "why": "Took out $+4$ instead of $-4$; $4(2m - 5) = 8m - 20$ has both signs reversed."
        },
        {
          "text": "$-4(8m - 5)$",
          "why": "Left the $-8m$ undivided; $-8m \\div -4 = 2m$, not $8m$."
        }
      ],
      "solution_text": "$-8m + 20$\n$= -4(2m - 5)$"
    },
    {
      "id": "q4",
      "question_text": "Factorise $-9a^2 - 12a$.",
      "structure": "negative-algebraic-factor",
      "mastery": false,
      "options": [
        {
          "text": "$-3a(3a + 4)$",
          "correct": true
        },
        {
          "text": "$-3a(3a - 4)$",
          "why": "Kept the $-12a$ term negative; $-12a \\div -3a = +4$, so it is $+4$ inside."
        },
        {
          "text": "$3a(3a + 4)$",
          "why": "Took out $+3a$; $3a(3a + 4) = 9a^2 + 12a$, the opposite sign of the original."
        },
        {
          "text": "$-3a(3a^2 + 4)$",
          "why": "Left $a^2$ after dividing; $-9a^2 \\div -3a = 3a$, dropping one power of $a$."
        }
      ],
      "solution_text": "$-9a^2 - 12a$\n$= -3a(3a + 4)$"
    },
    {
      "id": "q5",
      "question_text": "Factorise $-10p - 15q + 20$.",
      "structure": "three-terms-negative",
      "mastery": true,
      "options": [
        {
          "text": "$-5(2p + 3q - 4)$",
          "correct": true
        },
        {
          "text": "$-5(2p + 3q + 4)$",
          "why": "Did not flip the $+20$; dividing $20$ by $-5$ gives $-4$, not $+4$."
        },
        {
          "text": "$5(2p + 3q - 4)$",
          "why": "Took out $+5$; every term then expands with the opposite sign."
        },
        {
          "text": "$-5(2p + 3q - 20)$",
          "why": "Flipped the last term's sign but did not divide the $20$ by $5$."
        }
      ],
      "solution_text": "$-10p - 15q + 20$\n$= -5(2p + 3q - 4)$"
    },
    {
      "id": "q6",
      "question_text": "Factorise $-9 + 15k^2$ by taking out a negative common factor.",
      "structure": "leading-negative-power",
      "mastery": true,
      "options": [
        {
          "text": "$-3(3 - 5k^2)$",
          "correct": true
        },
        {
          "text": "$-3(3 + 5k^2)$",
          "why": "Did not flip the $k^2$ term; $15k^2 \\div -3 = -5k^2$, so it is $-5k^2$ inside."
        },
        {
          "text": "$3(3 - 5k^2)$",
          "why": "Took out $+3$; $3(3 - 5k^2) = 9 - 15k^2$, the opposite sign of every term."
        },
        {
          "text": "$-3(3 - 5k)$",
          "why": "Dropped the square; $15k^2 \\div -3 = -5k^2$, which keeps the power."
        }
      ],
      "solution_text": "$-9 + 15k^2$\n$= -3(3 - 5k^2)$"
    }
  ]
