      "question_text": "Simplify $4 + 2n - n$.",
      "structure": "variable-and-constant",
      "mastery": false,
      "options": [
        {
          "text": "$n + 4$",
          "correct": true
        },
        {
          "text": "$3n + 4$",
          "why": "Added $2n$ and $n$ instead of subtracting, giving $3n$."
        },
        {
          "text": "$5n$",
          "why": "Treated the constant $4$ as a like term with the $n$ terms and combined all three."
        },
        {
          "text": "$n$",
          "why": "Combined the $n$ terms correctly but dropped the constant $4$."
        }
      ],
      "solution_text": "$4 + 2n - n$\n$= (2n - n) + 4$\n$= n + 4$"
