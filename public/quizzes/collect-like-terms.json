    {
      "id": "q3",
      "question_text": "Simplify $10x + 31y - y + 4x$.",
      "structure": "two-variable-groups",
      "mastery": false,
      "options": [
        {
          "text": "$14x + 30y$",
          "correct": true
        },
        {
          "text": "$14x + 32y$",
          "why": "Read $-y$ as $+y$, so the $y$ terms were added to give $31 + 1 = 32$."
        },
        {
          "text": "$14x + 31y$",
          "why": "Left out the lone $-y$ term, thinking a term with no number in front counts as nothing."
        },
        {
          "text": "$44xy$",
          "why": "Treated all four terms as alike, working out $10 + 31 - 1 + 4$ and merging the letters into $xy$."
        }
      ],
      "solution_text": "$10x + 31y - y + 4x$\n$= (10x + 4x) + (31y - y)$\n$= 14x + 30y$"
    },
