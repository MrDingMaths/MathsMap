      "id": "q1",
      "question_text": "Differentiate $y = \\tan 8x$.",
      "structure": "derivative-tan-multiple",
      "mastery": false,
      "options": [
        { "text": "$8\\sec^{2}8x$", "correct": true },
        { "text": "$\\sec^{2}8x$", "why": "Forgot to multiply by $8$, the coefficient of $x$ inside the tangent." },
        { "text": "$8\\sec^{2}x$", "why": "Multiplied by $8$ but also removed the $8$ from inside the function." },
        { "text": "$8\\sec 8x\\tan 8x$", "why": "Used $\\dfrac{d}{dx}(\\sec x) = \\sec x\\tan x$ in place of the derivative of $\\tan x$." }
      ],
      "solution_text": "$\\dfrac{dy}{dx} = 8\\sec^{2}8x$"
    },
{
      "id": "q2",
      "question_text": "Differentiate $y = 9\\tan x - 2x^{2}$.",
      "structure": "derivative-sum-with-tan",
      "mastery": false,
      "options": [
        { "text": "$9\\sec^{2}x - 4x$", "correct": true },
        { "text": "$9\\sec^{2}x - 4$", "why": "Differentiated $2x^{2}$ as $4$ instead of $4x$." },
        { "text": "$-9\\sec^{2}x - 4x$", "why": "Attached a negative sign to the derivative of $\\tan x$, which has none." },
        { "text": "$9\\sec x\\tan x - 4x$", "why": "Used the derivative of $\\sec x$ in place of the derivative of $\\tan x$." }
      ],
      "solution_text": "$\\dfrac{dy}{dx} = 9\\sec^{2}x - 4x$"
    },
{
      "id": "q5",
      "question_text": "Given $f(x) = \\tan 3x$, find the exact value of $f'\\left(\\dfrac{\\pi}{12}\\right)$.",
      "structure": "evaluate-derivative-at-point",
      "mastery": false,
      "options": [
        { "text": "$6$", "correct": true },
        { "text": "$2$", "why": "Forgot to multiply by $3$, the coefficient of $x$ inside the tangent." },
        { "text": "$\\dfrac{3}{2}$", "why": "Used $\\cos^{2}\\dfrac{\\pi}{4} = \\dfrac{1}{2}$ instead of $\\sec^{2}\\dfrac{\\pi}{4} = 2$." },
        { "text": "$1$", "why": "Evaluated $f\\left(\\dfrac{\\pi}{12}\\right)$ instead of $f'\\left(\\dfrac{\\pi}{12}\\right)$." }
      ],
      "solution_text": "$f'(x) = 3\\sec^{2}3x$\n$f'\\left(\\dfrac{\\pi}{12}\\right) = 3\\sec^{2}\\dfrac{\\pi}{4}$\n$= 3 \\times 2$\n$= 6$"
    },
{
      "id": "q8",
      "question_text": "Find the exact value of $\\dfrac{d}{dx}(\\operatorname{cosec} x)$ at $x = \\dfrac{\\pi}{6}$.",
      "structure": "evaluate-derivative-at-point",
      "mastery": true,
      "options": [
        { "text": "$-2\\sqrt{3}$", "correct": true },
        { "text": "$2\\sqrt{3}$", "why": "Lost the negative sign in $\\dfrac{d}{dx}(\\operatorname{cosec} x) = -\\operatorname{cosec} x\\cot x$." },
        { "text": "$-4$", "why": "Used $-\\operatorname{cosec}^{2}x$, which is the derivative of $\\cot x$, not of $\\operatorname{cosec} x$." },
        { "text": "$-\\dfrac{2\\sqrt{3}}{3}$", "why": "Used $\\tan\\dfrac{\\pi}{6} = \\dfrac{1}{\\sqrt{3}}$ in place of $\\cot\\dfrac{\\pi}{6} = \\sqrt{3}$." }
      ],
      "solution_text": "$\\dfrac{d}{dx}(\\operatorname{cosec} x) = -\\operatorname{cosec} x\\cot x$\n$= -\\operatorname{cosec}\\dfrac{\\pi}{6}\\cot\\dfrac{\\pi}{6}$\n$= -2 \\times \\sqrt{3}$\n$= -2\\sqrt{3}$"
    }
]
