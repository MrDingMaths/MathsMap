{
      "id": "q1",
      "question_text": "Simplify $\\dfrac{5\\cos\\theta}{\\sec\\theta}$ for $\\cos\\theta\\ne0$.",
      "structure": "simplify-reciprocal-expression",
      "mastery": false,
      "options": [
{
          "text": "$5\\cos^2\\theta$",
          "correct": true
        },
{
          "text": "$5$",
          "why": "Replaced $\\sec\\theta$ with $\\cos\\theta$, giving $5\\cos\\theta/\\cos\\theta$."
        },
{
          "text": "$\\cos^2\\theta$",
          "why": "Dropped the coefficient $5$ when multiplying by $\\cos\\theta$."
        },
{
          "text": "$5\\sec^2\\theta$",
          "why": "Reversed the quotient to $5\\sec\\theta/\\cos\\theta$."
        }
],
      "solution_text": "$\\dfrac{5\\cos\\theta}{\\sec\\theta}=5\\cos\\theta\\times\\cos\\theta=5\\cos^2\\theta$"
    },
{
      "id": "q2",
      "question_text": "Which of the following simplifies $\\dfrac{\\tan\\alpha}{\\sec\\alpha}$?",
      "structure": "simplify-reciprocal-expression",
      "mastery": false,
      "options": [
{
          "text": "$\\sin\\alpha$",
          "correct": true
        },
{
          "text": "$\\cos\\alpha$",
          "why": "Replaced the numerator $\\tan\\alpha$ with $1$, giving $1/\\sec\\alpha=\\cos\\alpha$."
        },
{
          "text": "$\\cot\\alpha$",
          "why": "Replaced $\\sec\\alpha$ with $\\tan^2\\alpha$, giving $\\tan\\alpha/\\tan^2\\alpha=\\cot\\alpha$ on the common domain."
        },
{
          "text": "$\\operatorname{cosec}\\alpha$",
          "why": "Took the reciprocal of the simplified sine result."
        }
],
      "solution_text": "$\\dfrac{\\tan\\alpha}{\\sec\\alpha} = \\dfrac{\\sin\\alpha/\\cos\\alpha}{1/\\cos\\alpha} = \\sin\\alpha$"
    },
{
      "id": "q3",
      "question_text": "Simplify $\\dfrac{3}{\\sec^2\\theta}$ for all permissible angles $\\theta$.",
      "structure": "simplify-reciprocal-expression",
      "mastery": false,
      "options": [
{
          "text": "$3\\cos^2\\theta$",
          "correct": true
        },
{
          "text": "$3\\sec^2\\theta$",
          "why": "Changed division by $\\sec^2\\theta$ into multiplication."
        },
{
          "text": "$3\\cos\\theta$",
          "why": "Dropped the square when replacing $1/\\sec^2\\theta$."
        },
{
          "text": "$\\cos^2\\theta$",
          "why": "Dropped the numerator $3$."
        }
],
      "solution_text": "$\\dfrac{3}{\\sec^2\\theta}=3\\left(\\dfrac{1}{\\sec\\theta}\\right)^2=3\\cos^2\\theta$"
    },
{
      "id": "q4",
      "question_text": "Simplify $\\sin x \\cot x \\sec x$ for all permissible values of $x$.",
      "structure": "simplify-reciprocal-expression",
      "mastery": false,
      "options": [
{
          "text": "$1$",
          "correct": true
        },
{
          "text": "$\\tan x$",
          "why": "Replaced $\\cot x$ with $1$, giving $\\sin x\\sec x=\\tan x$."
        },
{
          "text": "$\\cot x$",
          "why": "Replaced $\\sec x$ with $\\operatorname{cosec}x$, so the sine and cosecant factors cancel."
        },
{
          "text": "$\\cos^2 x$",
          "why": "Replaced $\\sec x$ with $\\cos x$, giving $\\sin x\\times(\\cos x/\\sin x)\\times\\cos x$."
        }
],
      "solution_text": "$\\sin x \\cot x \\sec x = \\sin x \\times \\dfrac{\\cos x}{\\sin x} \\times \\dfrac{1}{\\cos x} = 1$"
    },
{
      "id": "q5",
      "question_text": "Simplify $\\dfrac{7\\sin\\beta}{\\operatorname{cosec}\\beta}$ for $\\sin\\beta\\ne0$.",
      "structure": "simplify-reciprocal-expression",
      "mastery": false,
      "options": [
{
          "text": "$7\\sin^2\\beta$",
          "correct": true
        },
{
          "text": "$7$",
          "why": "Replaced $\\operatorname{cosec}\\beta$ with $\\sin\\beta$, causing an incorrect cancellation."
        },
{
          "text": "$7\\operatorname{cosec}^2\\beta$",
          "why": "Reversed the quotient to $7\\operatorname{cosec}\\beta/\\sin\\beta$."
        },
{
          "text": "$\\sin^2\\beta$",
          "why": "Dropped the coefficient $7$."
        }
],
      "solution_text": "$\\dfrac{7\\sin\\beta}{\\operatorname{cosec}\\beta}=7\\sin\\beta\\times\\sin\\beta=7\\sin^2\\beta$"
