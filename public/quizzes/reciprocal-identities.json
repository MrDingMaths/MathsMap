{
      "id": "q7",
      "question_text": "Which of the following is a valid single-step algebraic justification that $\\cot\\theta \\sec\\theta = \\operatorname{cosec}\\theta$?",
      "structure": "prove-reciprocal-identity",
      "mastery": true,
      "options": [
        {
          "text": "$\\cot\\theta \\sec\\theta = \\dfrac{\\cos\\theta}{\\sin\\theta} \\times \\dfrac{1}{\\cos\\theta} = \\dfrac{1}{\\sin\\theta} = \\operatorname{cosec}\\theta$",
          "correct": true
        },
        {
          "text": "$\\cot\\theta \\sec\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta} \\times \\dfrac{1}{\\cos\\theta} = \\dfrac{\\sin\\theta}{\\cos^2\\theta} = \\operatorname{cosec}\\theta$",
          "why": "Used $\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}$ instead of $\\cot\\theta=\\frac{\\cos\\theta}{\\sin\\theta}$."
        },
        {
          "text": "$\\cot\\theta \\sec\\theta = \\dfrac{1}{\\tan\\theta} \\times \\cos\\theta = \\dfrac{\\cos\\theta}{\\tan\\theta} = \\operatorname{cosec}\\theta$",
          "why": "Replaced $\\sec\\theta$ with $\\cos\\theta$ instead of $\\frac{1}{\\cos\\theta}$."
        },
        {
          "text": "$\\cot\\theta \\sec\\theta = \\dfrac{\\cos\\theta}{\\sin\\theta} \\times \\dfrac{1}{\\sin\\theta} = \\dfrac{\\cos\\theta}{\\sin^2\\theta} = \\operatorname{cosec}\\theta$",
          "why": "Replaced $\\sec\\theta$ with $\\frac{1}{\\sin\\theta}$ instead of $\\frac{1}{\\cos\\theta}$."
        }
      ],
      "solution_text": "$\\text{LHS} = \\cot\\theta \\sec\\theta = \\dfrac{\\cos\\theta}{\\sin\\theta} \\times \\dfrac{1}{\\cos\\theta} = \\dfrac{1}{\\sin\\theta} = \\operatorname{cosec}\\theta = \\text{RHS}$"
    },
{
      "id": "q8",
      "question_text": "Simplify $\\dfrac{3\\sec\\theta+3\\operatorname{cosec}\\theta}{1+\\cot\\theta}$ into a single reciprocal trigonometric expression, for all permissible angles $\\theta$.",
      "structure": "simplify-reciprocal-expression",
      "mastery": true,
      "options": [
{
          "text": "$3\\sec\\theta$",
          "correct": true
        },
{
          "text": "$3\\operatorname{cosec}\\theta$",
          "why": "Replaced the denominator $1+\\cot\\theta$ with $1+\\tan\\theta$."
        },
{
          "text": "$\\sec\\theta$",
          "why": "Dropped the common coefficient $3$ from the numerator."
        },
{
          "text": "$3\\cos\\theta$",
          "why": "Inverted the final factor $1/\\cos\\theta$ to $\\cos\\theta$."
        }
],
      "solution_text": "$\\dfrac{3\\sec\\theta+3\\operatorname{cosec}\\theta}{1+\\cot\\theta}=\\dfrac{3(\\sin\\theta+\\cos\\theta)/(\\sin\\theta\\cos\\theta)}{(\\sin\\theta+\\cos\\theta)/\\sin\\theta}$\n$=\\dfrac{3}{\\cos\\theta}=3\\sec\\theta$"
    },
