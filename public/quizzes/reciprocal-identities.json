{
      "id": "q6",
      "question_text": "Simplify $\\dfrac{2\\tan x}{\\sec x}$ for all permissible values of $x$.",
      "structure": "simplify-reciprocal-expression",
      "mastery": false,
      "options": [
{
          "text": "$2\\sin x$",
          "correct": true
        },
{
          "text": "$2\\operatorname{cosec}x$",
          "why": "Reversed the quotient to $2\\sec x/\\tan x$."
        },
{
          "text": "$2\\cos x$",
          "why": "Replaced $\\tan x$ with $1$, giving $2/\\sec x$."
        },
{
          "text": "$\\sin x$",
          "why": "Dropped the coefficient $2$."
        }
],
      "solution_text": "$\\dfrac{2\\tan x}{\\sec x}=\\dfrac{2\\sin x/\\cos x}{1/\\cos x}=2\\sin x$"
