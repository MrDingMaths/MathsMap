  "questions": [
    {
      "id": "q1",
      "question_text": "If $f(x) = 3x - 1$ and $g(x) = 2x + 4$, what is the value of $f(g(3))$?",
      "structure": "eval-composite-linear",
      "mastery": false,
      "options": [
        {
          "text": "$29$",
          "correct": true
        },
        {
          "text": "$20$",
          "why": "Evaluated $g(f(3))$ instead of $f(g(3))$."
        },
        {
          "text": "$80$",
          "why": "Multiplied $f(3) \\times g(3)$ instead of composing."
        },
        {
          "text": "$18$",
          "why": "Added $f(3) + g(3)$ instead of composing."
        }
      ],
      "solution_text": "$g(3) = 2(3) + 4 = 10$\n$f(g(3)) = f(10)$\n$= 3(10) - 1$\n$= 29$"
    },
    {
      "id": "q2",
      "question_text": "If $f(x) = 6 - 2x$ and $g(x) = x + 5$, what is the value of $g(f(-2))$?",
      "structure": "eval-composite-linear",
      "mastery": false,
      "options": [
        {
          "text": "$15$",
          "correct": true
        },
        {
          "text": "$0$",
          "why": "Evaluated $f(g(-2))$ instead of $g(f(-2))$."
        },
        {
          "text": "$7$",
          "why": "Miscalculated $f(-2) = 6 - 4 = 2$ and evaluated $g(2) = 7$."
        },
        {
          "text": "$3$",
          "why": "Evaluated only the inner function $g(-2)$."
        }
      ],
      "solution_text": "$f(-2) = 6 - 2(-2) = 10$\n$g(f(-2)) = g(10)$\n$= 10 + 5$\n$= 15$"
    },
    {
      "id": "q3",
      "question_text": "If $f(x) = x^{2} - 2$ and $g(x) = 3x + 1$, what is the value of $(f \\circ g)(2)$?",
      "structure": "eval-composite-polynomial",
      "mastery": false,
      "options": [
        {
          "text": "$47$",
          "correct": true
        },
        {
          "text": "$7$",
          "why": "Evaluated $g(f(2))$ instead of $(f \\circ g)(2)$."
        },
        {
          "text": "$14$",
          "why": "Multiplied $2 \\times 7$ instead of squaring $7$."
        },
        {
          "text": "$49$",
          "why": "Squared $7$ but forgot to subtract $2$."
        }
      ],
      "solution_text": "$g(2) = 3(2) + 1 = 7$\n$(f \\circ g)(2) = f(7)$\n$= (7)^{2} - 2$\n$= 47$"
    },
    {
      "id": "q4",
      "question_text": "If $f(x) = 2x - 5$ and $g(x) = x^{2} + 4$, what is the value of $f(g(-3))$?",
