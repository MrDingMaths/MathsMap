        {
          "text": "$17$",
          "why": "Evaluated $g(f(3))$ or made an arithmetic error."
        },
        {
          "text": "$14$",
          "why": "Evaluated only the inner function $g(3)$."
        },
        {
          "text": "$25$",
          "why": "Computed $14 + 11 = 25$ but forgot to take the square root."
