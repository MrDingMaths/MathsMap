{
      "id": "q1",
      "question_text": "If $f(x) = 3x - 1$ and $g(x) = 2x + 4$, what is the value of $f(g(3))$?",
      "structure": "eval-composite-linear",
      "mastery": false,
      "options": [
        {
          "text": "$29$",
          "correct": true
        },
        {
          "text": "$20$",
          "why": "Evaluated $g(f(3))$ instead of $f(g(3))$."
        },
        {
          "text": "$80$",
          "why": "Multiplied $f(3) \\times g(3)$ instead of composing."
        },
        {
          "text": "$18$",
          "why": "Added $f(3) + g(3)$ instead of composing."
        }
      ],
      "solution_text": "$g(3) = 2(3) + 4 = 10$\n$f(g(3)) = f(10)$\n$= 3(10) - 1$\n$= 29$"
    },
