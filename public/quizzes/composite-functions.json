    {
      "id": "q9",
      "question_text": "Given $f(x) = 3 - 2x$, what is the value of $(f \\circ f \\circ f)(2)$?",
      "structure": "eval-composite-self",
      "mastery": true,
      "options": [
        {
          "text": "$-7$",
          "correct": true
        },
        {
          "text": "$5$",
          "why": "Evaluated only two layers $(f \\circ f)(2)$ instead of three."
        },
        {
          "text": "$-1$",
          "why": "Evaluated only one layer $f(2)$."
        },
        {
          "text": "$17$",
          "why": "Made sign errors in successive function evaluations."
        }
      ],
      "solution_text": "$f(2) = 3 - 2(2) = -1$\n$f(f(2)) = f(-1) = 3 - 2(-1) = 5$\n$(f \\circ f \\circ f)(2) = f(5)$\n$= 3 - 2(5)$\n$= -7$"
    }
