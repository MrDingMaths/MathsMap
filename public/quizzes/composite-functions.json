    {
      "id": "q5",
      "question_text": "If $f(x) = 4x - 7$, what is the value of $f(f(2))$?",
      "structure": "eval-composite-self",
      "mastery": false,
      "options": [
        {
          "text": "$-3$",
          "correct": true
        },
        {
          "text": "$1$",
          "why": "Evaluated only $f(2)$ without applying the outer $f$."
        },
        {
          "text": "$-15$",
          "why": "Computed $[f(2)]^{2} - 7$ or confused self-composition."
        },
        {
          "text": "$4$",
          "why": "Applied $f$ to $f(2) = 1$ but dropped the constant on the second application, computing $4(1)$ instead of $4(1) - 7$."
        }
      ],
      "solution_text": "$f(2) = 4(2) - 7 = 1$\n$f(f(2)) = f(1)$\n$= 4(1) - 7$\n$= -3$"
    },
    {
