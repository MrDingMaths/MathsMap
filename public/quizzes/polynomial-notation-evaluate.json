{
      "id": "q1",
      "question_text": "If $P(x)=x^{2}+5x-2$, evaluate $P(3)$.",
      "structure": "evaluate-positive",
      "mastery": false,
      "options": [
        {
          "text": "$22$",
          "correct": true
        },
        {
          "text": "$16$",
          "why": "Substituted $3$ into $x^{2}$ without squaring: $3+15-2$."
        },
        {
          "text": "$26$",
          "why": "Added the constant instead of subtracting it: $9+15+2$."
        },
        {
          "text": "$-8$",
          "why": "Evaluated at $x=-3$, flipping the sign of the $5x$ term: $9-15-2$."
        }
      ],
      "solution_text": "$P(3)$\n$=(3)^{2}+5(3)-2$\n$=9+15-2$\n$=22$"
    },
{
