      "question_text": "The quartic function $y=(x+1)(x+2)(x-3)(x-1)$ crosses the y-axis at...",
      "structure": "evaluate-factored",
      "mastery": false,
      "options": [
{
          "text": "$(0,-1)$",
          "why": "Retains only the factor $x-1$ and omits $x+1$, $x+2$ and $x-3$: at $x=0$, $0-1=-1$."
        },
{
          "text": "$(0,2)$",
          "why": "Uses only the positive factors and omits the two negative factors."
        },
{
          "text": "$(0,-3)$",
          "why": "Treats the factor $x-3$ as the whole value at the y-axis."
        },
{
          "text": "$(0,6)$",
          "correct": true
        }
],
      "solution_text": "At the y-axis $x=0$. Thus $y=(1)(2)(-3)(-1)=6$, so the intercept is $(0,6)$."
    },
