{
      "id": "q8",
      "question_text": "$P(x)=kx^{2}+3x$ and $P(4)=44$.\nFind the value of $k$.",
      "structure": "find-unknown-coefficient",
      "mastery": true,
      "options": [
        {
          "text": "$2$",
          "correct": true
        },
        {
          "text": "$8$",
          "why": "Substituted $4$ into $x^{2}$ without squaring, solving $4k+12=44$."
        },
        {
          "text": "$32$",
          "why": "Reached $16k=32$ but forgot to divide both sides by $16$."
        },
        {
          "text": "$\\frac{11}{4}$",
          "why": "Ignored the $3x$ term and divided $44$ by $16$."
        }
      ],
      "solution_text": "$P(4)=44$\n$k(4)^{2}+3(4)=44$\n$16k+12=44$\n$16k=32$\n$k=2$"
    },
