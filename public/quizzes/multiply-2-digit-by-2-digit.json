{
      "id": "q1",
      "question_text": "Use the area model to calculate $27\\times16$.\n[tikz]\n\\begin{tikzpicture}[every node/.style={font=\\large}]\n\\draw (0,0) rectangle (4,3);\n\\draw (2.5,0)--(2.5,3);\n\\draw (0,1.7)--(4,1.7);\n\\node[above] at (1.25,3) {$20$};\n\\node[above] at (3.25,3) {$7$};\n\\node[left] at (0,2.35) {$10$};\n\\node[left] at (0,0.85) {$6$};\n\\end{tikzpicture}\n[/tikz]",
      "structure": "two-digit-area-model-product",
      "mastery": false,
      "options": [
{ "text": "$432$", "correct": true },
{ "text": "$412$", "why": "Used $100$ instead of $120$ for the $20\\times6$ part-product, losing $20$ from the total." },
{ "text": "$342$", "why": "Added 70 and 120 as 100, losing 90 from the sum." },
{ "text": "$404$", "why": "Used $14$ instead of $42$ for the $7\\times6$ part-product, losing $28$ from the total." }
],
      "solution_text": "$20\\times10=200$, $7\\times10=70$.\n$20\\times6=120$, $7\\times6=42$.\n$27\\times16=200+70+120+42=432$."
    },
