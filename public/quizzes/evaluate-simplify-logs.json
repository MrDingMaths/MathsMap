        { "text": "$5$", "why": "Used $3^{5}=243$, one power short of $729$." },
        { "text": "$7$", "why": "Used $3^{7}$, one power too many." },
        { "text": "$243$", "why": "Gave the value $3^{5}$ instead of the exponent that produces $729$." }
