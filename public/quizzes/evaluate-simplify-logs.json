    {
      "id": "q1",
      "question_text": "Evaluate $\\log_{2}128$.",
      "structure": "evaluate-power-of-2",
      "mastery": false,
      "options": [
        { "text": "$7$", "correct": true },
        { "text": "$6$", "why": "Counted one factor of $2$ short, using $2^{6}=64$." },
        { "text": "$8$", "why": "Counted one factor of $2$ too many, using $2^{8}=256$." },
        { "text": "$64$", "why": "Gave the value $2^{6}$ rather than the exponent that produces $128$." }
      ],
      "solution_text": "$\\log_{2}128$\n$=\\log_{2}2^{7}$\n$=7$"
    },
    {
      "id": "q2",
      "question_text": "Evaluate $\\log_{3}729$.",
      "structure": "evaluate-power-of-3",
      "mastery": false,
