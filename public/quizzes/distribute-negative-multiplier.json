  "questions": [
    {
      "id": "q1",
      "question_text": "Expand $-4(2x+5)$.",
      "structure": "neg-times-sum",
      "mastery": false,
      "options": [
        {
          "text": "$-8x-20$",
          "correct": true
        },
        {
          "text": "$-8x+20$",
          "why": "Made the second product positive; $-4 \\times (+5)$ is $-20$, not $+20$."
        },
        {
          "text": "$8x+20$",
          "why": "Dropped the negative on the multiplier and expanded as $4(2x+5)$."
        },
        {
          "text": "$-8x+5$",
          "why": "Multiplied only the first term by $-4$ and copied the $+5$ across unchanged."
        }
      ],
      "solution_text": "$-4(2x+5)$\n$= -4(2x) - 4(5)$\n$= -8x-20$"
    },
    {
      "id": "q2",
      "question_text": "Expand $-7(8x-2)$.",
      "structure": "neg-times-difference",
      "mastery": false,
      "options": [
        {
          "text": "$-56x+14$",
          "correct": true
        },
        {
          "text": "$-56x-14$",
          "why": "Treated $-7 \\times (-2)$ as $-14$; a negative times a negative is positive."
        },
        {
          "text": "$56x-14$",
          "why": "Dropped the negative on the multiplier and expanded as $7(8x-2)$."
        },
        {
          "text": "$-56x+2$",
          "why": "Flipped the sign of the $2$ but forgot to multiply it by $7$."
        }
      ],
      "solution_text": "$-7(8x-2)$\n$= -7(8x) - 7(-2)$\n$= -56x+14$"
    },
    {
      "id": "q3",
      "question_text": "Expand $-(3x-7)$.",
      "structure": "bare-negative-bracket",
      "mastery": false,
      "options": [
        {
          "text": "$-3x+7$",
          "correct": true
        },
        {
          "text": "$-3x-7$",
          "why": "Flipped the sign of $3x$ but left the $-7$ unchanged."
        },
        {
          "text": "$3x-7$",
          "why": "Removed the brackets without multiplying by $-1$, so no signs changed."
        },
        {
          "text": "$3x+7$",
          "why": "Flipped the $-7$ to $+7$ but left the $3x$ positive."
        }
      ],
      "solution_text": "$-(3x-7)$\n$= -1(3x) - 1(-7)$\n$= -3x+7$"
    },
    {
      "id": "q4",
      "question_text": "Expand $-8(5-2y)$.",
      "structure": "reversed-order-difference",
      "mastery": false,
      "options": [
        {
          "text": "$-40+16y$",
          "correct": true
        },
        {
          "text": "$-40-16y$",
          "why": "Treated $-8 \\times (-2y)$ as $-16y$; a negative times a negative is positive."
        },
        {
          "text": "$40+16y$",
          "why": "Made $-8 \\times 5$ positive; a negative times a positive is negative."
        },
        {
          "text": "$-40+16$",
          "why": "Multiplied $-8$ by the $2$ but dropped the variable $y$ from $-2y$."
        }
      ],
      "solution_text": "$-8(5-2y)$\n$= -8(5) - 8(-2y)$\n$= -40+16y$"
    },
