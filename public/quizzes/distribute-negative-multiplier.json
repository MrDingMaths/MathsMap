    {
      "id": "q6",
      "question_text": "Expand $-(-2x-5)$.",
      "structure": "bare-negative-bracket",
      "mastery": true,
      "options": [
        {
          "text": "$2x+5$",
          "correct": true
        },
        {
          "text": "$-2x-5$",
          "why": "Removed the brackets without multiplying by $-1$, so no signs flipped."
        },
        {
          "text": "$2x-5$",
          "why": "Flipped the sign of the $-2x$ but left the $-5$ unchanged."
        },
        {
          "text": "$-2x+5$",
          "why": "Flipped only the second term; $-1 \\times (-2x)$ should also become $+2x$."
        }
      ],
      "solution_text": "$-(-2x-5)$\n$= -1(-2x) - 1(-5)$\n$= 2x+5$"
    },
    {
      "id": "dq-77967",
      "question_text": "Expand and simplify $5a-(3-a)$.",
      "structure": "bare-negative-bracket",
      "mastery": false,
      "options": [
        {
          "text": "$6a-3$",
          "correct": true
        },
        {
          "text": "$4a-3$",
          "why": "The negative sign changes $-a$ inside the bracket to $+a$."
        },
        {
          "text": "$4a+3$",
          "why": "Both the coefficient and the constant have been handled incorrectly."
        },
        {
          "text": "$3a$",
          "why": "The constant term cannot be removed when expanding."
        }
      ],
      "solution_text": "Distribute the subtraction across the bracket: $5a-3+a$. Collect like terms to obtain $6a-3$."
    }
  ]
