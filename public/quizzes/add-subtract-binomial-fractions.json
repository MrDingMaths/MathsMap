      "structure": "add-binomial-and-monomial",
      "mastery": false,
      "options": [
        { "text": "$\\frac{5p+10}{12}$", "correct": true },
        { "text": "$\\frac{5p+5}{12}$", "why": "Multiplied only the $p$ term of $p+5$ by $2$ when rewriting over $12$." },
        { "text": "$\\frac{2p+5}{12}$", "why": "Added the numerators without rescaling either fraction to twelfths." },
        { "text": "$\\frac{2p+5}{10}$", "why": "Added the numerators and the denominators straight across." }
      ],
      "solution_text": "$\\frac{p}{4} + \\frac{p+5}{6}$\n$= \\frac{3p}{12} + \\frac{2(p+5)}{12}$\n$= \\frac{3p + 2(p+5)}{12}$\n$= \\frac{3p+2p+10}{12}$\n$= \\frac{5p+10}{12}$"
    },
    {
