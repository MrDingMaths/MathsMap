        { "text": "$\\frac{6x+4}{9}$", "correct": true },
        { "text": "$\\frac{6x+4}{18}$", "why": "Added the denominators as well; a common denominator stays $9$." },
        { "text": "$\\frac{6x-10}{9}$", "why": "Subtracted the constant terms instead of adding them." },
