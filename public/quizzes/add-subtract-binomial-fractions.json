    {
      "id": "q1",
      "question_text": "Which fraction is equivalent to $\\frac{2x+5}{4}$ with a denominator of $12$?",
      "structure": "equivalent-fraction-scale-up",
      "mastery": false,
      "options": [
        { "text": "$\\frac{6x+15}{12}$", "correct": true },
        { "text": "$\\frac{6x+5}{12}$", "why": "Multiplied only the $x$ term by $3$ and left the constant unchanged." },
        { "text": "$\\frac{2x+15}{12}$", "why": "Multiplied only the constant term by $3$ and left the $x$ term unchanged." },
        { "text": "$\\frac{2x+5}{12}$", "why": "Changed the denominator to $12$ without scaling the numerator at all." }
      ],
      "solution_text": "$\\frac{2x+5}{4}$\n$= \\frac{3(2x+5)}{12}$\n$= \\frac{6x+15}{12}$"
    },
    {
      "id": "q2",
      "question_text": "Which fraction is equivalent to $\\frac{9x-6}{15}$ with a denominator of $5$?",
      "structure": "equivalent-fraction-scale-down",
      "mastery": false,
      "options": [
        { "text": "$\\frac{3x-2}{5}$", "correct": true },
        { "text": "$\\frac{3x-6}{5}$", "why": "Divided only the $x$ term by $3$ and left the constant unchanged." },
        { "text": "$\\frac{9x-6}{5}$", "why": "Changed the denominator to $5$ without dividing the numerator." },
        { "text": "$\\frac{6x-9}{5}$", "why": "Subtracted $3$ from each term ($9x-3=6x$, $-6-3=-9$) instead of dividing each term by $3$." }
      ],
      "solution_text": "$\\frac{9x-6}{15}$\n$= \\frac{(9x-6) \\div 3}{15 \\div 3}$\n$= \\frac{3x-2}{5}$"
    },
