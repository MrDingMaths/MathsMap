    {
      "id": "q9",
      "question_text": "Simplify the algebraic fraction $\\dfrac{^{n}C_{2}}{n}$ for $n \\ge 2$.",
      "structure": "factorial-algebraic-proof",
      "mastery": true,
      "options": [
        {
          "text": "$\\dfrac{n - 1}{2}$",
          "correct": true
        },
        {
          "text": "$n - 1$",
          "why": "Omitted the denominator 2! = 2 from the combination formula."
        },
        {
          "text": "$\\dfrac{n}{2}$",
          "why": "Cancelled incorrectly, leaving n/2."
        },
        {
          "text": "$\\dfrac{n + 1}{2}$",
          "why": "Used factor (n + 1) instead of (n - 1)."
        }
      ],
      "solution_text": "$\\dfrac{^{n}C_{2}}{n} = \\dfrac{\\dfrac{n(n-1)}{2}}{n}$\n$= \\dfrac{n-1}{2}$"
    },
    {
      "id": "q10",
      "question_text": "Which expression is identically equal to $^{n}C_{1} + 2 \\cdot {^{n}C_{2}}$?",
      "structure": "factorial-algebraic-proof",
      "mastery": true,
      "options": [
        {
          "text": "$n^2$",
          "correct": true
        },
        {
          "text": "$n^2 + n$",
          "why": "Forgot to subtract n when expanding n(n - 1)."
        },
        {
          "text": "$2n$",
          "why": "Added coefficients 1 + 2 and multiplied by n."
        },
        {
          "text": "$n^2 - n$",
          "why": "Omitted the nC1 term, evaluating only 2 * nC2 = n^2 - n."
        }
      ],
      "solution_text": "$^{n}C_{1} + 2 \\cdot {^{n}C_{2}} = n + 2 \\cdot \\dfrac{n(n-1)}{2}$\n$= n + n(n-1)$\n$= n + n^2 - n$\n$= n^2$"
    }
  ]
