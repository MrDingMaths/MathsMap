    {
      "id": "q3",
      "question_text": "Which expression is equal to $^{8}C_{3} + {^{8}C_{4}}$?",
      "structure": "pascals-identity-simplify",
      "mastery": false,
      "options": [
        {
          "text": "$^{9}C_{4}$",
          "correct": true
        },
        {
          "text": "$^{8}C_{7}$",
          "why": "Added the lower indices without incrementing the upper index."
        },
        {
          "text": "$^{9}C_{3}$",
          "why": "Incremented the upper index but selected the smaller lower index."
        },
        {
          "text": "$^{16}C_{7}$",
          "why": "Added both upper indices and lower indices together."
        }
      ],
      "solution_text": "By Pascal's identity $^{n}C_{r} + {^{n}C_{r+1}} = {^{n+1}C_{r+1}}$:\n$^{8}C_{3} + {^{8}C_{4}} = {^{9}C_{4}}$"
    },
    {
