    {
      "id": "q7",
      "question_text": "Evaluate the sum of all binomial coefficients for $n = 6$: $^{6}C_{0} + {^{6}C_{1}} + {^{6}C_{2}} + {^{6}C_{3}} + {^{6}C_{4}} + {^{6}C_{5}} + {^{6}C_{6}}$.",
      "structure": "sum-of-binomial-coefficients",
      "mastery": false,
      "options": [
        {
          "text": "$64$",
          "correct": true
        },
        {
          "text": "$32$",
          "why": "Calculated 2^5 instead of 2^6."
        },
        {
          "text": "$12$",
          "why": "Multiplied 6 by 2 instead of evaluating 2^6."
        },
        {
          "text": "$128$",
          "why": "Calculated 2^7 instead of 2^6."
        }
      ],
      "solution_text": "$\\sum_{r=0}^{6} {^{6}C_{r}} = 2^{6}$\n$= 64$"
