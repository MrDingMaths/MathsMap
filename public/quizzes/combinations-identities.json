    {
      "id": "q1",
      "question_text": "If $^{14}C_{n} = {^{14}C_{5}}$ and $n \\ne 5$, find the value of $n$.",
      "structure": "symmetry-solve-unknown",
      "mastery": false,
      "options": [
        {
          "text": "$9$",
          "correct": true
        },
        {
          "text": "$14$",
          "why": "Used the top index n = 14 instead of subtracting 5."
        },
        {
          "text": "$4$",
          "why": "Subtracted 1 from 5 instead of computing 14 - 5."
        },
        {
          "text": "$19$",
          "why": "Added 14 and 5 instead of applying the symmetry property."
        }
      ],
      "solution_text": "By symmetry $^{n}C_{r} = {^{n}C_{n-r}}$:\n$n = 14 - 5$\n$= 9$"
    },
    {
      "id": "q2",
