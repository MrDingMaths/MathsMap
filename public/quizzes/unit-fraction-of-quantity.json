      "structure": "choose-operation",
      "mastery": false,
      "options": [
        {
          "text": "$64\\div4$",
          "correct": true
        },
        {
          "text": "$64-4$",
          "why": "A unit fraction means equal sharing, not subtraction."
        },
        {
          "text": "$64\\times4$",
          "why": "This makes the quantity larger instead of finding one part."
        }
      ],
      "solution_text": "$\\frac{1}{4}$ means one of four equal parts.\n$64\\div4=16$"
