    {
      "id": "q1",
      "question_text": "What is $\\frac{1}{4}$ of $36$?",
      "structure": "quarter-quantity",
      "mastery": false,
      "options": [
        {
          "text": "$9$",
          "correct": true
        },
        {
          "text": "$32$",
          "why": "This subtracts four instead of dividing by four."
        },
        {
          "text": "$144$",
          "why": "This multiplies by four instead of dividing by four."
        }
      ],
      "solution_text": "$36\\div4=9$"
    },
