      "options": [
        {
          "text": "$4$",
          "correct": true
        },
        {
          "text": "$-3$",
          "why": "Picked a coefficient ($-3x$) instead of the term with no pronumeral."
        },
        {
          "text": "$2$",
          "why": "Picked the coefficient of $y$ instead of the constant term."
        },
        {
          "text": "$-4$",
          "why": "Flipped the sign; the term is $+4$, so the constant is $4$."
        }
      ],
      "solution_text": "$2y - 3x + 4$\n$4$"
