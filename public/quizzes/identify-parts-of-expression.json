{
  "skillId": "identify-parts-of-expression",
  "questions": [
    {
      "id": "q1",
      "question_text": "List all the terms in $5a + 3b - 7c + 12$.",
      "structure": "list-terms",
      "mastery": false,
      "options": [
        {
          "text": "$5a,\\ 3b,\\ -7c,\\ 12$",
          "correct": true
        },
        {
          "text": "$5a,\\ 3b,\\ 7c,\\ 12$",
          "why": "Dropped the minus sign — the term is $-7c$, and the sign travels with the term."
        },
        {
          "text": "$5a,\\ 3b,\\ -7c$",
          "why": "Left out $12$ — a number on its own is still a term."
        },
        {
          "text": "$5,\\ a,\\ 3,\\ b,\\ 7,\\ c,\\ 12$",
          "why": "Split every symbol apart instead of keeping each term ($5a$, $3b$) whole."
        }
      ],
      "solution_text": "$5a + 3b - 7c + 12$\n$= 5a + 3b + (-7c) + 12$\n$5a,\\ 3b,\\ -7c,\\ 12$"
    },
    {
      "id": "q2",
      "question_text": "State the coefficient of $n$ in $15w + 21n + 1$.",
      "structure": "state-coefficient",
      "mastery": false,
      "options": [
        {
          "text": "$21$",
          "correct": true
        },
        {
          "text": "$15$",
          "why": "Read the coefficient of the wrong pronumeral ($w$) instead of $n$."
        },
        {
          "text": "$1$",
          "why": "Gave the constant term instead of the number multiplying $n$."
        },
        {
          "text": "$21n$",
          "why": "Included the pronumeral — a coefficient is just the number $21$."
        }
      ],
      "solution_text": "$15w + 21n + 1$\n$21$"
    },
    {
      "id": "q3",
      "question_text": "State the coefficient of $y$ in $6 - 5y + 2x$.",
      "structure": "signed-coefficient",
      "mastery": false,
      "options": [
        {
          "text": "$-5$",
          "correct": true
        },
        {
          "text": "$5$",
          "why": "Ignored the subtraction; the term is $-5y$, so the coefficient is $-5$."
        },
        {
          "text": "$2$",
          "why": "Read the coefficient of the wrong pronumeral ($x$) instead of $y$."
        },
        {
          "text": "$6$",
          "why": "Gave the constant term instead of the number multiplying $y$."
        }
      ],
      "solution_text": "$6 - 5y + 2x$\n$= 6 + (-5y) + 2x$\n$-5$"
    },
    {
      "id": "q4",
      "question_text": "State the coefficient of $t$ in $\\frac{5t}{8} + 2$.",
      "structure": "fractional-coefficient",
      "mastery": false,
      "options": [
        {
          "text": "$\\frac{5}{8}$",
          "correct": true
        },
        {
          "text": "$\\frac{8}{5}$",
          "why": "Inverted the fraction, reading the denominator over the numerator."
        },
        {
          "text": "$5$",
          "why": "Took only the numerator and ignored the division by $8$."
        },
        {
          "text": "$\\frac{1}{8}$",
          "why": "Dropped the $5$ from the numerator, reading the term as $\\frac{t}{8}$."
        }
      ],
      "solution_text": "$\\frac{5t}{8} + 2$\n$= \\frac{5}{8}t + 2$\n$\\frac{5}{8}$"
    },
    {
      "id": "q5",
      "question_text": "Identify the constant term in $2y - 3x + 4$.",
