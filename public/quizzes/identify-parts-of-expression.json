    {
      "id": "q6",
      "question_text": "Identify the constant term in $3a - 8 + 13c$.",
      "structure": "identify-constant",
      "mastery": true,
      "options": [
        {
          "text": "$-8$",
          "correct": true
        },
        {
          "text": "$8$",
          "why": "Dropped the minus sign — the subtraction travels with the term, so the constant is $-8$."
        },
        {
          "text": "$13$",
          "why": "Chose the coefficient of $c$; a constant term has no pronumeral."
        },
        {
          "text": "$3$",
          "why": "Chose the coefficient of $a$; a constant term has no pronumeral."
        }
      ],
      "solution_text": "$3a - 8 + 13c$\n$= 3a + (-8) + 13c$\n$-8$"
    },
    {
      "id": "q7",
      "question_text": "State the coefficient of $b$ in $-b + 8a - 3$.",
      "structure": "signed-coefficient",
      "mastery": true,
      "options": [
        {
          "text": "$-1$",
          "correct": true
        },
        {
          "text": "$1$",
          "why": "Missed the leading minus sign; $-b$ has coefficient $-1$, not $1$."
        },
        {
          "text": "$8$",
          "why": "Read the coefficient of the wrong pronumeral ($a$) instead of $b$."
        },
        {
          "text": "$-3$",
          "why": "Gave the constant term instead of the number multiplying $b$."
        }
      ],
      "solution_text": "$-b + 8a - 3$\n$= (-1)b + 8a + (-3)$\n$-1$"
    }
  ]
