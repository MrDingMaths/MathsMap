{
  "skillId": "derivative-sum-multiple",
  "questions": [
    {
      "id": "q1",
      "question_text": "Differentiate $f(x) = 5x^3 - 8x^2 + 6x - 14$ with respect to $x$.",
      "structure": "differentiate-polynomial",
      "mastery": false,
      "options": [
        {
          "text": "$15x^2 - 16x + 6$",
          "correct": true
        },
        {
          "text": "$15x^2 - 16x + 6 - 14$",
          "why": "Kept the constant term $-14$ instead of differentiating it to $0$."
        },
        {
          "text": "$15x^2 - 16x$",
          "why": "Differentiated the linear term $6x$ to $0$ instead of its coefficient $6$."
        },
        {
          "text": "$15x^3 - 16x^2 + 6x$",
          "why": "Multiplied each term by its power but forgot to decrease the exponents by $1$."
        }
      ],
      "solution_text": "$f(x) = 5x^3 - 8x^2 + 6x - 14$\n$= 5(3x^2) - 8(2x) + 6(1) - 0$\n$= 15x^2 - 16x + 6$"
    },
    {
      "id": "q2",
      "question_text": "Differentiate $f(x) = \\dfrac{x^6}{3} - \\dfrac{3x^4}{2} + 5x$ with respect to $x$.",
      "structure": "differentiate-polynomial",
      "mastery": false,
      "options": [
        {
          "text": "$2x^5 - 6x^3 + 5$",
          "correct": true
        },
        {
          "text": "$2x^5 - 6x^3$",
          "why": "Dropped the linear term $5x$ entirely instead of differentiating it to $5$."
        },
        {
          "text": "$6x^5 - 12x^3 + 5$",
          "why": "Multiplied by exponents without dividing by the existing denominators."
        },
        {
          "text": "$2x^6 - 6x^4 + 5$",
          "why": "Simplified coefficients correctly but did not reduce the powers by $1$."
        }
      ],
      "solution_text": "$f(x) = \\dfrac{1}{3}x^6 - \\dfrac{3}{2}x^4 + 5x$\n$= \\dfrac{1}{3}(6x^5) - \\dfrac{3}{2}(4x^3) + 5(1)$\n$= 2x^5 - 6x^3 + 5$"
    },
    {
      "id": "q3",
      "question_text": "Differentiate $f(x) = (3x + 4)(2x - 5)$ with respect to $x$.",
      "structure": "expand-and-differentiate",
      "mastery": false,
      "options": [
        {
          "text": "$12x - 7$",
          "correct": true
        },
        {
          "text": "$6x - 7$",
          "why": "Differentiated $6x^2$ as $6x$ instead of $12x$."
        },
        {
          "text": "$6$",
          "why": "Differentiated each factor separately and multiplied: $3 \\times 2 = 6$."
        },
        {
          "text": "$12x + 7$",
          "why": "Calculated $-15x + 8x = +7x$ with a sign error in expanding the linear terms."
        }
      ],
      "solution_text": "$f(x) = 6x^2 - 15x + 8x - 20$\n$= 6x^2 - 7x - 20$\n$= 12x - 7$"
    },
    {
      "id": "q4",
      "question_text": "Differentiate $f(x) = x^2(5 - 2x)$ with respect to $x$.",
      "structure": "expand-and-differentiate",
      "mastery": false,
      "options": [
        {
          "text": "$10x - 6x^2$",
          "correct": true
        },
        {
          "text": "$10x - 2x^2$",
          "why": "Expanded as $5x^2 - 2x^2 = 3x^2$ or failed to multiply the $x^2$ into the second term."
        },
        {
          "text": "$5x - 6x^2$",
          "why": "Differentiated $5x^2$ as $5x$ instead of multiplying by the power $2$."
        },
        {
          "text": "$10 - 6x$",
          "why": "Reduced the powers by $2$ instead of $1$ on each term."
        }
      ],
      "solution_text": "$f(x) = 5x^2 - 2x^3$\n$= 5(2x) - 2(3x^2)$\n$= 10x - 6x^2$"
    },
    {
      "id": "q5",
      "question_text": "Differentiate $f(x) = \\dfrac{4x^5 - 9x^3}{x^2}$ with respect to $x$.",
      "structure": "divide-monomial-and-differentiate",
      "mastery": false,
      "options": [
        {
          "text": "$12x^2 - 9$",
          "correct": true
        },
        {
          "text": "$\\dfrac{20x^4 - 27x^2}{2x}$",
          "why": "Differentiated the numerator and denominator separately instead of simplifying first."
        },
        {
          "text": "$12x^2 - 9x$",
          "why": "Did not simplify the linear term after dividing by $x^2$."
        },
        {
          "text": "$12x^3 - 9x$",
          "why": "Divided powers incorrectly before differentiating."
        }
      ],
      "solution_text": "$f(x) = \\dfrac{4x^5}{x^2} - \\dfrac{9x^3}{x^2}$\n$= 4x^3 - 9x$\n$= 4(3x^2) - 9(1)$\n$= 12x^2 - 9$"
    },
    {
      "id": "q6",
      "question_text": "Differentiate $f(x) = 4x^3 + \\dfrac{6}{x} - 2\\sqrt{x}$ with respect to $x$.",
      "structure": "differentiate-sum-negative-fractional",
      "mastery": false,
      "options": [
        {
          "text": "$12x^2 - \\dfrac{6}{x^2} - \\dfrac{1}{\\sqrt{x}}$",
          "correct": true
        },
        {
          "text": "$12x^2 + \\dfrac{6}{x^2} - \\dfrac{1}{\\sqrt{x}}$",
          "why": "Forgot the negative sign when differentiating $x^{-1}$ to $-x^{-2}$."
        },
        {
          "text": "$12x^2 - \\dfrac{6}{x^2} - \\dfrac{1}{2\\sqrt{x}}$",
          "why": "Did not multiply the derivative of $\\sqrt{x}$ by the coefficient $2$."
        },
        {
          "text": "$12x^2 - \\dfrac{6}{x^2} - \\sqrt{x}$",
          "why": "Subtracted $1$ incorrectly from the fractional power $\\frac{1}{2}$."
        }
      ],
      "solution_text": "$f(x) = 4x^3 + 6x^{-1} - 2x^{\\frac{1}{2}}$\n$= 12x^2 + 6(-x^{-2}) - 2\\left(\\dfrac{1}{2}x^{-\\frac{1}{2}}\\right)$\n$= 12x^2 - \\dfrac{6}{x^2} - \\dfrac{1}{\\sqrt{x}}$"
    },
    {
      "id": "q7",
      "question_text": "Differentiate $f(x) = px^4 - qx^2 + r$ with respect to $x$, where $p, q, r$ are non-zero constants.",
      "structure": "differentiate-symbolic-polynomial",
      "mastery": false,
      "options": [
        {
          "text": "$4px^3 - 2qx$",
          "correct": true
        },
        {
          "text": "$4px^3 - 2qx + r$",
          "why": "Treated the constant term $r$ as surviving differentiation instead of differentiating to $0$."
        },
        {
          "text": "$4px^3 - 2q$",
          "why": "Differentiated $-qx^2$ as $-2q$ instead of $-2qx$."
        },
        {
          "text": "$4px^4 - 2qx^2$",
          "why": "Multiplied by powers but did not decrease the exponents by $1$."
        }
      ],
      "solution_text": "$f(x) = px^4 - qx^2 + r$\n$= p(4x^3) - q(2x) + 0$\n$= 4px^3 - 2qx$"
    },
    {
      "id": "q8",
      "question_text": "Given $f(x) = 2x^3 - 3x^2 - 12x + 7$, evaluate $f'(3)$.",
      "structure": "evaluate-sum-derivative",
      "mastery": false,
      "options": [
        {
          "text": "$24$",
          "correct": true
        },
        {
          "text": "$36$",
          "why": "Omitted the $-12$ term when evaluating the derivative at $x = 3$."
        },
        {
          "text": "$-2$",
          "why": "Substituted $x = 3$ into the original function instead of the derivative."
        },
        {
          "text": "$30$",
          "why": "Calculated $6(3)^2 - 6(3) - 12 = 54 - 18 - 12$ with an arithmetic error."
        }
      ],
      "solution_text": "$f'(x) = 6x^2 - 6x - 12$\n$f'(3) = 6(3)^2 - 6(3) - 12$\n$= 6(9) - 18 - 12$\n$= 54 - 18 - 12$\n$= 24$"
    },
    {
      "id": "q9",
      "question_text": "Find all values of $x$ for which the tangent to the curve $y = 2x^3 - 6x + 5$ has a gradient of $18$.",
      "structure": "evaluate-sum-derivative",
      "mastery": true,
      "options": [
        {
          "text": "$x = 2 \\text{ and } x = -2$",
          "correct": true
        },
        {
          "text": "$x = 2$",
          "why": "Found the positive solution to $x^2 = 4$ but omitted the negative solution $x = -2$."
        },
        {
          "text": "$x = \\sqrt{2} \\text{ and } x = -\\sqrt{2}$",
          "why": "Divided $24$ by $6$ incorrectly or solved $6x^2 = 12$ instead of $6x^2 = 24$."
        },
        {
          "text": "$x = 4 \\text{ and } x = -4$",
          "why": "Forgot to take the square root when solving $x^2 = 4$."
        }
      ],
      "solution_text": "$y = 2x^3 - 6x + 5$\n$\\dfrac{dy}{dx} = 6x^2 - 6$\n$6x^2 - 6 = 18$\n$6x^2 = 24$\n$x^2 = 4$\n$x = 2 \\text{ or } x = -2$"
    },
    {
      "id": "q10",
      "question_text": "Differentiate $f(x) = (2x - 1)^3$ by first expanding the binomial, then differentiating term-by-term.",
      "structure": "expand-and-differentiate",
      "mastery": true,
      "options": [
        {
          "text": "$24x^2 - 24x + 6$",
          "correct": true
        },
        {
          "text": "$8x^2 - 12x + 6$",
          "why": "Differentiated $8x^3 - 12x^2 + 6x - 1$ as $8x^2 - 12x + 6$ without multiplying by exponents."
        },
        {
          "text": "$24x^2 - 12x + 6$",
          "why": "Differentiated $-12x^2$ as $-12x$ instead of $-24x$."
        },
        {
          "text": "$24x^3 - 24x^2 + 6x$",
          "why": "Multiplied by coefficients without reducing powers by $1$."
        }
      ],
      "solution_text": "$f(x) = (2x - 1)(4x^2 - 4x + 1)$\n$= 8x^3 - 8x^2 + 2x - 4x^2 + 4x - 1$\n$= 8x^3 - 12x^2 + 6x - 1$\n$= 8(3x^2) - 12(2x) + 6(1) - 0$\n$= 24x^2 - 24x + 6$"
    }
  ]
}
