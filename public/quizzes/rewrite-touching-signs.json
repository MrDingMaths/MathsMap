    {
      "id": "q1",
      "question_text": "Rewrite $8 + (-5)$ with a single sign.",
      "structure": "rewrite-plus-negative",
      "mastery": false,
      "options": [
        {
          "text": "$8 - 5$",
          "correct": true
        },
        {
          "text": "$8 + 5$",
          "why": "Applied the same-sign rule to the different-sign pair $+(-)$, keeping it as $+$."
        },
        {
          "text": "$-8 - 5$",
          "why": "Combined the touching pair correctly but also moved the bracket's negative onto the leading $8$."
        },
        {
          "text": "$-8 + 5$",
          "why": "Moved the negative onto the leading $8$ and left the touching pair as a $+$."
        }
      ],
      "solution_text": "$8 + (-5)$\n$= 8 - 5$"
    },
    {
