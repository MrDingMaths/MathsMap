      "id": "q1",
      "question_text": "Calculate $\\frac{1}{3}+\\frac{1}{6}$ and give the answer in simplest form.",
      "structure": "add-related",
      "mastery": false,
      "options": [
        {
          "text": "$\\frac{1}{2}$",
          "correct": true
        },
        {
          "text": "$\\frac{2}{9}$",
          "why": "This adds numerator and denominator without making equal parts."
        },
        {
          "text": "$\\frac{2}{6}$",
          "why": "This changes the denominator but not the numerator of one third."
        }
      ],
      "solution_text": "$\\frac{1}{3}=\\frac{2}{6}$\n$\\frac{2}{6}+\\frac{1}{6}=\\frac{3}{6}=\\frac{1}{2}$"
    },
