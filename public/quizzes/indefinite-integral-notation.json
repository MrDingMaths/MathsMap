  "skillId": "indefinite-integral-notation",
  "questions": [
{
      "id": "q2",
      "question_text": "Find $\\int 15x^{4}\\,dx$.",
      "structure": "constant-multiple-rule",
      "mastery": false,
      "options": [
        { "text": "$3x^{5} + C$", "correct": true },
        { "text": "$60x^{3} + C$", "why": "Differentiated $15x^{4}$ instead of integrating it." },
        { "text": "$\\dfrac{15x^{5}}{4} + C$", "why": "Divided by the original index $4$ instead of the new index $5$." },
        { "text": "$3x^{5}$", "why": "Omitted the constant of integration from an indefinite integral." }
      ],
      "solution_text": "$\\int 15x^{4}\\,dx$\n$= 15 \\times \\dfrac{x^{5}}{5} + C$\n$= 3x^{5} + C$"
    },
{
      "id": "q3",
      "question_text": "Find $\\int\\left(2x^{3} + 8x\\right)dx$.",
      "structure": "sum-rule-integral",
      "mastery": false,
      "options": [
{ "text": "$\\dfrac{x^{4}}{2} + 4x^{2} + C$", "correct": true },
{ "text": "$\\dfrac{x^{4}}{2} + 8x^{2} + C$", "why": "Raised the index of $8x$ but did not divide by the new index $2$." },
{ "text": "$\\dfrac{2x^{4}}{3} + 4x^{2} + C$", "why": "Divided the first term by the old index $3$ instead of the new index $4$." },
{ "text": "$6x^{2} + 8 + C$", "why": "Differentiated each term instead of integrating it." }
],
      "solution_text": "$\\int\\left(2x^{3} + 8x\\right)dx$\n$= \\dfrac{2x^{4}}{4} + \\dfrac{8x^{2}}{2} + C$\n$= \\dfrac{x^{4}}{2} + 4x^{2} + C$"
    },
{
      "id": "q5",
      "question_text": "Which of these is $\\int\\left(3x^{2} - 10x\\right)dx$?",
      "structure": "check-by-differentiating",
      "mastery": false,
      "options": [
        { "text": "$x^{3} - 5x^{2} + C$", "correct": true },
        { "text": "$x^{3} - 10x^{2} + C$", "why": "Raised the index of $-10x$ but did not divide by the new index $2$." },
        { "text": "$6x - 10 + C$", "why": "Differentiated the integrand instead of integrating it." },
        { "text": "$\\dfrac{3x^{3}}{2} - 5x^{2} + C$", "why": "Divided the first term by the old index $2$ instead of the new index $3$." }
      ],
      "solution_text": "$\\dfrac{d}{dx}\\left(x^{3} - 5x^{2} + C\\right)$\n$= 3x^{2} - 10x$, which is the integrand."
    },
{
      "id": "q6",
      "question_text": "Find $\\int 5u^{4}\\,du$.",
      "structure": "dx-variable-role",
      "mastery": false,
      "options": [
        { "text": "$u^{5} + C$", "correct": true },
        { "text": "$x^{5} + C$", "why": "Changed the variable; the $du$ requires the answer to be written in terms of $u$." },
        { "text": "$\\dfrac{5u^{5}}{4} + C$", "why": "Divided by the old index $4$ instead of the new index $5$." },
        { "text": "$20u^{3} + C$", "why": "Differentiated $5u^{4}$ instead of integrating it." }
      ],
      "solution_text": "$\\int 5u^{4}\\,du$\n$= \\dfrac{5u^{5}}{5} + C$\n$= u^{5} + C$"
    },
{
      "id": "q7",
      "question_text": "Express $y$ in terms of $x$ if $\\dfrac{dy}{dx} = 8x^{3} + 6x - 5$.",
      "structure": "general-primitive-from-derivative",
      "mastery": true,
      "options": [
{ "text": "$y = 2x^{4} + 3x^{2} - 5x + C$", "correct": true },
{ "text": "$y = 2x^{4} + 3x^{2} - 5 + C$", "why": "Left the constant term $-5$ unchanged instead of integrating it to $-5x$." },
{ "text": "$y = \\dfrac{8x^{4}}{3} + 3x^{2} - 5x + C$", "why": "Divided the first term by the old index $3$ instead of the new index $4$." },
{ "text": "$y = 24x^{2} + 6 + C$", "why": "Differentiated $8x^{3} + 6x - 5$ instead of integrating it." }
],
      "solution_text": "$y = \\int\\left(8x^{3} + 6x - 5\\right)dx$\n$= \\dfrac{8x^{4}}{4} + \\dfrac{6x^{2}}{2} - 5x + C$\n$= 2x^{4} + 3x^{2} - 5x + C$"
    },
{
      "id": "q8",
      "question_text": "Find $\\int (4x - 3)(x + 2)\\,dx$.",
      "structure": "expand-product-integral",
      "mastery": true,
      "options": [
{ "text": "$\\dfrac{4x^{3}}{3} + \\dfrac{5x^{2}}{2} - 6x + C$", "correct": true },
{ "text": "$\\dfrac{4x^{3}}{3} - \\dfrac{3x^{2}}{2} - 6x + C$", "why": "Omitted the product $4x \\times 2 = 8x$ when expanding the brackets." },
{ "text": "$4x^{3} + \\dfrac{5x^{2}}{2} - 6x + C$", "why": "Raised the index of $4x^{2}$ but did not divide by the new index $3$." },
{ "text": "$8x + 5 + C$", "why": "Differentiated the expanded integrand $4x^{2} + 5x - 6$ instead of integrating it." }
],
      "solution_text": "$\\int (4x - 3)(x + 2)\\,dx$\n$= \\int\\left(4x^{2} + 5x - 6\\right)dx$\n$= \\dfrac{4x^{3}}{3} + \\dfrac{5x^{2}}{2} - 6x + C$"
    }
]
}
