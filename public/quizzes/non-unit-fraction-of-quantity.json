    {
      "id": "q3",
      "question_text": "Which calculation finds $\\frac{2}{4}$ of $28$?",
      "structure": "choose-two-step",
      "mastery": false,
      "options": [
        {
          "text": "$28\\div4\\times2$",
          "correct": true
        },
        {
          "text": "$28\\div2\\times4$",
          "why": "This reverses numerator and denominator roles."
        },
        {
          "text": "$28-4+2$",
          "why": "This uses the fraction numbers as additive changes."
        }
      ],
      "solution_text": "$28\\div4=7$\n$7\\times2=14$"
    },
    {
