  "skillId": "non-unit-fraction-of-quantity",
  "questions": [
    {
      "id": "q1",
      "question_text": "Find $\\frac{3}{5}$ of $40$.",
      "structure": "direct-nonunit",
      "mastery": false,
      "options": [
        {
          "text": "$24$",
          "correct": true
        },
        {
          "text": "$8$",
          "why": "This finds one fifth but does not take three parts."
        },
        {
          "text": "$120$",
          "why": "This multiplies by the numerator without dividing by the denominator."
        }
      ],
      "solution_text": "$40\\div5=8$\n$8\\times3=24$"
    },
    {
