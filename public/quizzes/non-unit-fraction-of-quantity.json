    {
      "id": "q6",
      "question_text": "A student finds $\\frac{3}{8}$ of $64$ as $64\\div3\\times8$.\nWhat is the correct answer?",
      "structure": "diagnose-operation-order",
      "mastery": true,
      "options": [
        {
          "text": "$24$",
          "correct": true
        },
        {
          "text": "$21\\frac{1}{3}$",
          "why": "This divides by the numerator and stops before using the denominator."
        },
        {
          "text": "$192$",
          "why": "This multiplies by three but never divides by eight."
        }
      ],
      "solution_text": "$64\\div8=8$\n$8\\times3=24$"
