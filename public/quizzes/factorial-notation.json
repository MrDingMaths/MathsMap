{
  "skillId": "factorial-notation",
  "questions": [
    {
      "id": "q1",
      "question_text": "What is the value of $3! + 0! \\times 2!$?",
      "structure": "evaluate-numeric-factorial",
      "mastery": false,
      "options": [
        {
          "text": "$8$",
          "correct": true
        },
        {
          "text": "$6$",
          "why": "Treated $0!$ as $0$ instead of $1$, giving $6 + 0 = 6$."
        },
        {
          "text": "$14$",
          "why": "Evaluated $(3! + 0!) \\times 2! = (6 + 1) \\times 2 = 14$, ignoring the order of operations."
        },
        {
          "text": "$12$",
          "why": "Evaluated $3! \\times 2! = 12$, treating $0!$ as $1$ but multiplying all terms."
        }
      ],
      "solution_text": "$3! + 0! \\times 2!$\n$= 6 + 1 \\times 2$\n$= 6 + 2$\n$= 8$"
    },
    {
      "id": "q2",
      "question_text": "Which expression correctly shows $(n + 3)!$ unrolled three times?",
      "structure": "unroll-factorial-expression",
      "mastery": false,
      "options": [
        {
          "text": "$(n + 3)(n + 2)(n + 1)n!$",
          "correct": true
        },
        {
          "text": "$(n + 3)(n + 2)(n + 1)(n - 1)!$",
          "why": "Subtracted $4$ instead of $3$ to find the remaining factorial index."
        },
        {
          "text": "$(n + 3)(n + 2)(n + 1)$",
          "why": "Dropped the remaining factorial factor $n!$ after peeling off three terms."
        },
        {
          "text": "$(n + 3)(n + 2)n!$",
          "why": "Skipped the $(n + 1)$ factor between $(n + 2)$ and $n!$."
        }
      ],
      "solution_text": "$(n + 3)!$\n$= (n + 3)(n + 2)(n + 1)n!$"
    },
    {
      "id": "q3",
      "question_text": "Evaluate $\\frac{11!}{8! \\times 3!}$ without using a calculator.",
      "structure": "simplify-numeric-ratio",
      "mastery": false,
      "options": [
        {
          "text": "$165$",
          "correct": true
        },
        {
          "text": "$990$",
          "why": "Cancelled $8!$ but forgot to divide by $3! = 6$."
        },
        {
          "text": "$55$",
          "why": "Divided by $18$ instead of evaluating $3! = 6$."
        },
        {
          "text": "$330$",
          "why": "Divided by $3$ instead of evaluating $3! = 6$."
        }
      ],
      "solution_text": "$\\frac{11!}{8! \\times 3!}$\n$= \\frac{11 \\times 10 \\times 9 \\times 8!}{8! \\times 6}$\n$= \\frac{990}{6}$\n$= 165$"
    },
    {
      "id": "q4",
      "question_text": "What is the value of $\\frac{13!}{11!}$?",
      "structure": "simplify-numeric-ratio",
      "mastery": false,
      "options": [
        {
          "text": "$156$",
          "correct": true
        },
        {
          "text": "$\\frac{13}{11}$",
          "why": "Cancelled the exclamation marks as if they were common variables."
        },
        {
          "text": "$2$",
          "why": "Subtracted the numbers $13 - 11$ instead of simplifying the factorial quotient."
        },
        {
          "text": "$1716$",
          "why": "Multiplied $13 \\times 12 \\times 11$, forgetting that $11!$ cancels completely."
        }
      ],
      "solution_text": "$\\frac{13!}{11!}$\n$= \\frac{13 \\times 12 \\times 11!}{11!}$\n$= 13 \\times 12$\n$= 156$"
    },
    {
      "id": "q5",
      "question_text": "Which expression is the simplified form of $\\frac{(n + 3)!}{(n + 1)!}$?",
      "structure": "simplify-algebraic-ratio",
      "mastery": false,
      "options": [
        {
          "text": "$n^2 + 5n + 6$",
          "correct": true
        },
        {
          "text": "$n + 3$",
          "why": "Cancelled all but the first term $(n + 3)$, omitting $(n + 2)$."
        },
        {
          "text": "$(n + 3)(n + 2)!$",
          "why": "Unrolled only one factor from the numerator instead of unrolling down to $(n + 1)!$."
        },
        {
          "text": "$\\frac{n + 3}{n + 1}$",
          "why": "Cancelled the factorials directly without unrolling the numerator."
        }
      ],
      "solution_text": "$\\frac{(n + 3)!}{(n + 1)!}$\n$= \\frac{(n + 3)(n + 2)(n + 1)!}{(n + 1)!}$\n$= (n + 3)(n + 2)$\n$= n^2 + 5n + 6$"
    },
    {
      "id": "q6",
      "question_text": "Which of the following is equivalent to $9! - 8!$?",
      "structure": "factorise-factorial-sum",
      "mastery": false,
      "options": [
        {
          "text": "$8 \\times 8!$",
          "correct": true
        },
        {
          "text": "$1!$",
          "why": "Subtracted the factorial arguments $9 - 8 = 1$ directly."
        },
        {
          "text": "$9$",
          "why": "Divided $9!$ by $8!$ instead of subtracting $8!$."
        },
        {
          "text": "$8!$",
          "why": "Factored out $8!$ as $8!(9 - 0) = 9 \\times 8!$ without subtracting the second term."
        }
      ],
      "solution_text": "$9! - 8!$\n$= 9 \\times 8! - 8!$\n$= 8!(9 - 1)$\n$= 8 \\times 8!$"
    },
    {
      "id": "q7",
      "question_text": "Express $\\frac{1}{7!} - \\frac{1}{8!}$ as a single fraction.",
      "structure": "combine-factorial-fractions",
      "mastery": false,
      "options": [
        {
          "text": "$\\frac{7}{8!}$",
          "correct": true
        },
        {
          "text": "$\\frac{1}{1!}$",
          "why": "Subtracted the denominators directly as $8! - 7! = 1!$."
        },
        {
          "text": "$-\\frac{1}{8!}$",
          "why": "Subtracted the numerators without finding a common denominator."
        },
        {
          "text": "$\\frac{8}{8!}$",
          "why": "Forgot to subtract the numerator of the second fraction after converting to the common denominator."
        }
      ],
      "solution_text": "$\\frac{1}{7!} - \\frac{1}{8!}$\n$= \\frac{8}{8!} - \\frac{1}{8!}$\n$= \\frac{8 - 1}{8!}$\n$= \\frac{7}{8!}$"
    },
    {
      "id": "q8",
      "question_text": "Simplify $\\frac{(n!)^2}{(n - 1)!(n + 1)!}$ fully.",
      "structure": "simplify-algebraic-ratio",
      "mastery": true,
      "options": [
        {
          "text": "$\\frac{n}{n + 1}$",
          "correct": true
        },
        {
          "text": "$\\frac{1}{n + 1}$",
          "why": "Cancelled $(n!)^2$ against $(n - 1)!(n + 1)!$ as if $n! \\times n! = (n - 1)!(n + 1)!$."
        },
        {
          "text": "$\\frac{n^2}{n^2 - 1}$",
          "why": "Treated the factorials as ordinary polynomial factors $(n)^2 / ((n - 1)(n + 1))$."
        },
        {
          "text": "$1$",
          "why": "Assumed the numerator and denominator have equal terms that cancel to $1$."
        }
      ],
      "solution_text": "$\\frac{(n!)^2}{(n - 1)!(n + 1)!}$\n$= \\frac{n(n - 1)! \\times n!}{(n - 1)! \\times (n + 1)n!}$\n$= \\frac{n}{n + 1}$"
    },
    {
      "id": "q9",
      "question_text": "Express $\\frac{1}{n!} - \\frac{1}{(n + 2)!}$ as a single fraction in simplest form.",
      "structure": "combine-factorial-fractions",
      "mastery": true,
      "options": [
        {
          "text": "$\\frac{n^2 + 3n + 1}{(n + 2)!}$",
          "correct": true
        },
        {
          "text": "$\\frac{n + 1}{(n + 2)!}$",
          "why": "Multiplied the first term by $(n + 2)$ only instead of $(n + 2)(n + 1)$."
        },
        {
          "text": "$\\frac{n^2 + 3n + 2}{(n + 2)!}$",
          "why": "Forgot to subtract the second numerator $1$ after finding the common denominator."
        },
        {
          "text": "$\\frac{1}{2!}$",
          "why": "Subtracted $(n + 2)! - n!$ in the denominator to get $2!$."
        }
      ],
      "solution_text": "$\\frac{1}{n!} - \\frac{1}{(n + 2)!}$\n$= \\frac{(n + 2)(n + 1)}{(n + 2)!} - \\frac{1}{(n + 2)!}$\n$= \\frac{n^2 + 3n + 2 - 1}{(n + 2)!}$\n$= \\frac{n^2 + 3n + 1}{(n + 2)!}$"
    }
  ]
}
