      ],
      "solution_text": "$x^2+7x=0$\n$x(x+7)=0$\n$x=0$ or $x=-7$"
    },
    {
      "id": "q6",
      "question_text": "For $f(x)=x^2+x$, solve $f(x)=20$.",
      "structure": "solve-quadratic-trinomial",
      "mastery": false,
      "options": [
        { "text": "$x=-5$ or $x=4$", "correct": true },
        { "text": "$x=5$ or $x=-4$", "why": "Reversed the signs of both roots when reading them from the factors." },
        { "text": "$x=4$ or $x=5$", "why": "Solved $x+5=0$ as $x=5$, missing the sign change." },
        { "text": "$x=-5$ or $x=-4$", "why": "Solved $x-4=0$ as $x=-4$ instead of $x=4$." }
      ],
      "solution_text": "$x^2+x=20$\n$x^2+x-20=0$\n$(x+5)(x-4)=0$\n$x=-5$ or $x=4$"
    },
    {
      "id": "q7",
      "question_text": "For $f(x)=ax-1$, it is known that $f(3)=8$. Find the value of the coefficient $a$.",
      "structure": "find-coefficient",
      "mastery": false,
      "options": [
        { "text": "$3$", "correct": true },
        { "text": "$\\dfrac{7}{3}$", "why": "Subtracted $1$ from $8$ instead of adding it, giving $3a=7$." },
        { "text": "$27$", "why": "Multiplied $9$ by $3$ instead of dividing by $3$." },
        { "text": "$9$", "why": "Solved $3a=9$ but did not divide by $3$." }
      ],
      "solution_text": "$a(3)-1=8$\n$3a-1=8$\n$3a=9$\n$a=3$"
    },
    {
