    {
      "id": "q5",
      "question_text": "For $f(x)=x^2+7x$, solve $f(x)=0$.",
      "structure": "solve-quadratic-common-factor",
      "mastery": false,
      "options": [
        { "text": "$x=0$ or $x=-7$", "correct": true },
        { "text": "$x=-7$", "why": "Divided both sides by $x$, losing the solution $x=0$." },
        { "text": "$x=0$ or $x=7$", "why": "Took the factor $x+7=0$ as $x=7$ instead of $x=-7$." },
