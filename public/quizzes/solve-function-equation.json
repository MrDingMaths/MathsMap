      "question_text": "For $f(x)=2x+1$ and $g(x)=x^2-2$, solve $f(x)=g(x)$.",
      "structure": "solve-equate-functions",
      "mastery": true,
      "options": [
        { "text": "$x=3$ or $x=-1$", "correct": true },
        { "text": "$x=-3$ or $x=1$", "why": "Reversed the signs of both roots read from $(x-3)(x+1)$." },
        { "text": "$x=3$", "why": "Gave only one root, stopping after $x=3$." },
        { "text": "$x=3$ or $x=1$", "why": "Solved $x+1=0$ as $x=1$ instead of $x=-1$." }
      ],
      "solution_text": "$2x+1=x^2-2$\n$0=x^2-2x-3$\n$(x-3)(x+1)=0$\n$x=3$ or $x=-1$"
