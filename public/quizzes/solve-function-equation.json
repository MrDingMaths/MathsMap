      "id": "q7",
      "question_text": "For $f(x)=ax-1$, it is known that $f(3)=8$.\nFind the value of the coefficient $a$.",
      "structure": "find-coefficient",
      "mastery": false,
      "options": [
        {
          "text": "$3$",
          "correct": true
        },
        {
          "text": "$\\dfrac{7}{3}$",
          "why": "Subtracted $1$ from $8$ instead of adding it, giving $3a=7$."
        },
        {
          "text": "$27$",
          "why": "Multiplied $9$ by $3$ instead of dividing by $3$."
        },
        {
          "text": "$9$",
          "why": "Solved $3a=9$ but did not divide by $3$."
        }
      ],
      "solution_text": "$a(3)-1=8$\n$3a-1=8$\n$3a=9$\n$a=3$"
    },
