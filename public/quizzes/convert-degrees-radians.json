  "questions": [
    {
      "id": "q1",
      "question_text": "Convert $120^{\\circ}$ to exact radian measure in terms of $\\pi$.",
      "structure": "degrees-to-exact-radians",
      "mastery": false,
      "options": [
        {
          "text": "$\\dfrac{2\\pi}{3}$",
          "correct": true
        },
        {
          "text": "$\\dfrac{3\\pi}{4}$",
          "why": "Confused $120^{\\circ}$ with $135^{\\circ}$."
        },
        {
          "text": "$\\dfrac{\\pi}{3}$",
          "why": "Calculated $60^{\\circ}$ instead of $120^{\\circ}$."
        },
        {
          "text": "$\\dfrac{4\\pi}{3}$",
          "why": "Confused $120^{\\circ}$ with $240^{\\circ}$."
        }
      ],
      "solution_text": "$120^{\\circ} \\times \\dfrac{\\pi}{180^{\\circ}}$\n$= \\dfrac{120\\pi}{180}$\n$= \\dfrac{2\\pi}{3}$"
    },
    {
      "id": "q2",
      "question_text": "Convert $\\dfrac{5\\pi}{4}\\text{ radians}$ to degrees.",
      "structure": "radians-to-exact-degrees",
      "mastery": false,
      "options": [
        {
          "text": "$225^{\\circ}$",
          "correct": true
        },
        {
          "text": "$135^{\\circ}$",
          "why": "Converted $\\frac{3\\pi}{4}$ instead of $\\frac{5\\pi}{4}$."
        },
        {
          "text": "$315^{\\circ}$",
          "why": "Converted $\\frac{7\\pi}{4}$ instead of $\\frac{5\\pi}{4}$."
        },
        {
          "text": "$210^{\\circ}$",
          "why": "Confused the denominator $4$ with denominator $6$."
        }
      ],
      "solution_text": "$\\dfrac{5\\pi}{4} \\times \\dfrac{180^{\\circ}}{\\pi}$\n$= \\dfrac{5 \\times 180^{\\circ}}{4}$\n$= 225^{\\circ}$"
    },
