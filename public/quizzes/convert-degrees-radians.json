      "mastery": false,
      "options": [
        {
          "text": "$120^{\\circ}$",
          "correct": true
        },
        {
          "text": "$60^{\\circ}$",
          "why": "Converted $\\frac{\\pi}{3}$ instead of $\\frac{2\\pi}{3}$."
        },
        {
          "text": "$240^{\\circ}$",
          "why": "Converted $\\frac{4\\pi}{3}$ instead of $\\frac{2\\pi}{3}$."
        },
        {
          "text": "$150^{\\circ}$",
          "why": "Confused with $\\frac{5\\pi}{6}$."
        }
      ],
      "solution_text": "$\\dfrac{2\\pi}{3} \\times \\dfrac{180^{\\circ}}{\\pi}$\n$= \\dfrac{2 \\times 180^{\\circ}}{3}$\n$= 120^{\\circ}$"
    },
    {
      "id": "q5",
