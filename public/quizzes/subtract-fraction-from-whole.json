{
  "skillId": "subtract-fraction-from-whole",
  "questions": [
    {
      "id": "q1",
      "question_text": "Calculate $1-\\frac{3}{7}$.",
      "structure": "one-minus-proper",
      "mastery": false,
      "options": [
        {
          "text": "$\\frac{4}{7}$",
          "correct": true
        },
        {
          "text": "$\\frac{2}{7}$",
          "why": "This subtracts the numerator from one instead of from seven."
        },
        {
          "text": "$\\frac{3}{7}$",
          "why": "This repeats the fraction removed rather than finding its complement."
        }
      ],
      "solution_text": "$1-\\frac{3}{7}$\n$=\\frac{7}{7}-\\frac{3}{7}$\n$=\\frac{4}{7}$"
    },
    {
      "id": "q2",
      "question_text": "What completes $\\frac{5}{9}+\\square=1$?",
      "structure": "missing-complement",
      "mastery": false,
      "options": [
        {
          "text": "$\\frac{4}{9}$",
          "correct": true
        },
        {
          "text": "$\\frac{5}{9}$",
          "why": "This repeats the given part rather than finding the missing part."
        },
        {
          "text": "$\\frac{4}{0}$",
          "why": "This subtracts denominators instead of keeping ninths."
        }
      ],
      "solution_text": "$1-\\frac{5}{9}=\\frac{9}{9}-\\frac{5}{9}$\n$=\\frac{4}{9}$"
    },
    {
      "id": "q3",
      "question_text": "Calculate $3-\\frac{2}{5}$.",
      "structure": "whole-greater-one",
      "mastery": false,
      "options": [
        {
          "text": "$2\\frac{3}{5}$",
          "correct": true
        },
        {
          "text": "$\\frac{1}{5}$",
          "why": "This subtracts the numerator directly from the whole number."
        },
        {
          "text": "$3\\frac{3}{5}$",
          "why": "This keeps all three wholes and also adds the complement."
        }
      ],
      "solution_text": "$3-\\frac{2}{5}$\n$=2+\\frac{5}{5}-\\frac{2}{5}$\n$=2\\frac{3}{5}$"
    },
    {
      "id": "q4",
      "question_text": "A field is $\\frac{7}{8}$ planted. What fraction is not planted?",
      "structure": "context-complement",
      "mastery": false,
      "options": [
        {
          "text": "$\\frac{1}{8}$",
          "correct": true
        },
        {
          "text": "$\\frac{7}{8}$",
          "why": "This gives the planted part rather than the unplanted complement."
        },
        {
          "text": "$\\frac{6}{8}$",
          "why": "This subtracts one from the numerator rather than from a whole."
        }
      ],
      "solution_text": "$1-\\frac{7}{8}=\\frac{8}{8}-\\frac{7}{8}$\n$=\\frac{1}{8}$"
    },
    {
      "id": "q5",
      "question_text": "Calculate and simplify $1-\\frac{6}{10}$.",
      "structure": "simplified-complement",
      "mastery": true,
      "options": [
        {
          "text": "$\\frac{2}{5}$",
          "correct": true
        },
        {
          "text": "$\\frac{4}{10}$",
          "why": "This finds the complement but does not simplify as requested."
        },
        {
          "text": "$\\frac{5}{9}$",
          "why": "This subtracts one from both numerator and denominator."
        }
      ],
      "solution_text": "$1-\\frac{6}{10}=\\frac{10}{10}-\\frac{6}{10}$\n$=\\frac{4}{10}$\n$=\\frac{2}{5}$"
    },
    {
      "id": "q6",
      "question_text": "If $1-\\frac{a}{11}=\\frac{3}{11}$, what is $a$?",
      "structure": "inverse-complement",
      "mastery": true,
      "options": [
        {
          "text": "$8$",
          "correct": true
        },
        {
          "text": "$7$",
          "why": "This subtracts one extra part from the whole."
        },
        {
          "text": "$14$",
          "why": "This adds the known numerator to the whole numerator."
        }
      ],
      "solution_text": "$\\frac{11}{11}-\\frac{a}{11}=\\frac{3}{11}$\n$11-a=3$\n$a=8$"
    }
  ]
}
