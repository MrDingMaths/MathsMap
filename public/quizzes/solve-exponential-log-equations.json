{
      "id": "q4",
      "question_text": "Solve $5^{x}=40$, correct to $3$ decimal places.",
      "structure": "solve-exponential-via-log",
      "mastery": false,
      "options": [
        {
          "text": "$2.292$",
          "correct": true
        },
        {
          "text": "$1.602$",
          "why": "Evaluated $\\log_{10}40$ but forgot to divide by $\\log_{10}5$."
        },
        {
          "text": "$0.436$",
          "why": "Divided $\\log_{10}5$ by $\\log_{10}40$, inverting the change-of-base ratio."
        }
      ],
      "solution_text": "$5^{x}=40$\n$\\log_{10}5^{x}=\\log_{10}40$\n$x\\log_{10}5=\\log_{10}40$\n$x=\\dfrac{\\log_{10}40}{\\log_{10}5}$\n$x=2.292$"
    },
{
      "id": "q5",
      "question_text": "Solve $5\\times2^{x}=45$, correct to $3$ decimal places.",
      "structure": "solve-coefficient-exponential",
      "mastery": false,
      "options": [
        {
          "text": "$3.170$",
          "correct": true
        },
        {
          "text": "$5.492$",
          "why": "Took $\\log_{2}45$ without first dividing both sides by $5$ to isolate the power."
        },
        {
          "text": "$4.500$",
          "why": "After reaching $2^{x}=9$, divided $9$ by the base $2$ instead of taking logarithms."
        }
      ],
      "solution_text": "$5\\times2^{x}=45$\n$2^{x}=9$\n$\\log_{10}2^{x}=\\log_{10}9$\n$x\\log_{10}2=\\log_{10}9$\n$x=\\dfrac{\\log_{10}9}{\\log_{10}2}$\n$x=3.170$"
    },
{
      "id": "q6",
      "question_text": "An investment of $\\$8\\,000$ grows at $7\\%$ p.a., so its value after $n$ years is $FV=8\\,000(1.07)^{n}$.\nFind how long it takes to reach $\\$12\\,000$, correct to the nearest $0.1$ years.",
      "structure": "solve-modelling-for-exponent",
      "mastery": false,
      "options": [
        {
          "text": "$6.0$",
          "correct": true
        },
        {
          "text": "$138.8$",
          "why": "Took $\\log_{1.07}12\\,000$ without first dividing by the present value $8\\,000$."
        },
        {
          "text": "$0.2$",
          "why": "Divided $\\log_{10}1.07$ by $\\log_{10}1.5$, inverting the ratio."
        }
      ],
      "solution_text": "$FV=8\\,000(1.07)^{n}$\n$12\\,000=8\\,000(1.07)^{n}$\n$1.5=1.07^{n}$\n$\\log_{10}1.5=n\\log_{10}1.07$\n$n=\\dfrac{\\log_{10}1.5}{\\log_{10}1.07}$\n$n=6.0\\text{ years}$"
    },
{
      "id": "q7",
      "question_text": "Solve $2^{3x}=50$, correct to $3$ decimal places.",
      "structure": "solve-compound-index-exponential",
      "mastery": true,
      "options": [
{
          "text": "$1.881$",
          "correct": true
        },
{
          "text": "$5.644$",
          "why": "Solved $2^{x}=50$, forgetting the index is $3x$ rather than $x$."
        },
{
          "text": "$16.932$",
          "why": "Multiplied the result by the index $3$ instead of dividing by it."
        }
],
      "solution_text": "$2^{3x}=50$\n$\\log_{10}2^{3x}=\\log_{10}50$\n$3x\\log_{10}2=\\log_{10}50$\n$3x=\\dfrac{\\log_{10}50}{\\log_{10}2}$\n$x=\\dfrac{\\log_{10}50}{3\\log_{10}2}$\n$x=1.881$"
    },
{
      "id": "dq-87608",
      "question_text": "Solve $11^x=3$, correct to $4$ significant figures.",
      "structure": "solve-exponential-via-log",
      "mastery": false,
      "options": [
{
          "text": "$x=0.5643$",
          "why": "Evaluated $\\log_{10}(11/3)$ instead of dividing $\\log_{10}3$ by $\\log_{10}11$."
        },
{
          "text": "$x=2.183$",
          "why": "Divided $\\log_{10}11$ by $\\log_{10}3$, reversing the change-of-base ratio."
        },
{
          "text": "$x=-0.5643$",
          "why": "Evaluated $\\log_{10}(3/11)$ instead of dividing $\\log_{10}3$ by $\\log_{10}11$."
        },
{
          "text": "$x=0.4582$",
          "correct": true
        }
],
      "solution_text": "$11^x=3$\n$\\log_{10}11^x=\\log_{10}3$\n$x\\log_{10}11=\\log_{10}3$\n$x=\\dfrac{\\log_{10}3}{\\log_{10}11}$\n$x=0.4582$"
    },
{
      "id": "dq-87605",
      "question_text": "Solve the equation: $9^x=27$",
      "structure": "solve-exact-exponential-common-base",
      "mastery": false,
      "options": [
{
          "text": "$x=2$",
          "why": "Incorrectly wrote $27=3^4$, giving $2x=4$ and hence $x=2$."
        },
{
          "text": "$x=\\frac{1}{2}$",
          "why": "Incorrectly wrote $27=3^1$, giving $2x=1$ and hence $x=\\frac{1}{2}$."
        },
{
          "text": "$x=\\frac{3}{2}$",
          "correct": true
        },
{
          "text": "$x=-\\frac{2}{3}$",
          "why": "Reversed the ratio of the indices and incorrectly made it negative, giving $x=-2/3$ instead of $x=3/2$."
        }
],
      "solution_text": "Rewrite the bases as powers of 3: $9^x=(3^2)^x=3^{2x}$ and $27=3^3$. Therefore, $2x=3$, so $x=\\frac{3}{2}$."
    },
