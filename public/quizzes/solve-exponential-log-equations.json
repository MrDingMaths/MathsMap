      "question_text": "Solve $\\log_{2}x=6$.",
      "structure": "solve-log-x-equals-k",
      "mastery": false,
      "options": [
        {
          "text": "$64$",
          "correct": true
        },
        {
          "text": "$12$",
          "why": "Multiplied the base by the index, giving $2\\times6$ instead of raising $2$ to the power $6$."
        },
        {
          "text": "$36$",
          "why": "Raised the index to the base, computing $6^{2}$ instead of $2^{6}$."
        },
        {
          "text": "$\\dfrac{1}{64}$",
          "why": "Treated the index as negative, evaluating $2^{-6}$ instead of $2^{6}$."
        }
      ],
      "solution_text": "$\\log_{2}x=6$\n$x=2^{6}$\n$x=64$"
