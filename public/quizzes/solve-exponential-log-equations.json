    {
      "id": "q1",
      "question_text": "Solve $\\log_{2}x=6$.",
      "structure": "solve-log-x-equals-k",
      "mastery": false,
      "options": [
        { "text": "$64$", "correct": true },
        { "text": "$12$", "why": "Multiplied the base by the index, giving $2\\times6$ instead of raising $2$ to the power $6$." },
        { "text": "$36$", "why": "Raised the index to the base, computing $6^{2}$ instead of $2^{6}$." },
        { "text": "$\\dfrac{1}{64}$", "why": "Treated the index as negative, evaluating $2^{-6}$ instead of $2^{6}$." }
      ],
      "solution_text": "$\\log_{2}x=6$\n$x=2^{6}$\n$x=64$"
    },
    {
      "id": "q2",
      "question_text": "Solve $\\log_{x}216=3$.",
      "structure": "solve-log-base-unknown",
      "mastery": false,
      "options": [
        { "text": "$6$", "correct": true },
        { "text": "$72$", "why": "Divided $216$ by the index $3$ instead of taking the cube root of $216$." },
        { "text": "$3$", "why": "Gave the index $3$ as the answer instead of solving $x^{3}=216$." }
      ],
      "solution_text": "$\\log_{x}216=3$\n$x^{3}=216$\n$x=\\sqrt[3]{216}$\n$x=6$"
    },
    {
      "id": "q3",
      "question_text": "Solve $2^{x}=256$.",
      "structure": "solve-exact-exponential-common-base",
      "mastery": false,
      "options": [
        { "text": "$8$", "correct": true },
        { "text": "$128$", "why": "Halved $256$ instead of finding the power of $2$ that gives $256$." },
        { "text": "$7$", "why": "Counted the doublings but stopped at $2^{7}=128$, one power early." },
        { "text": "$9$", "why": "Went one power too far, using $2^{9}=512$." }
      ],
      "solution_text": "$2^{x}=256$\n$2^{x}=2^{8}$\n$x=8$"
    },
    {
      "id": "q4",
      "question_text": "Solve $5^{x}=40$, correct to $3$ decimal places.",
      "structure": "solve-exponential-via-log",
      "mastery": false,
      "options": [
        { "text": "$2.292$", "correct": true },
        { "text": "$1.602$", "why": "Evaluated $\\log_{10}40$ but forgot to divide by $\\log_{10}5$." },
        { "text": "$0.436$", "why": "Divided $\\log_{10}5$ by $\\log_{10}40$, inverting the change-of-base ratio." }
      ],
      "solution_text": "$5^{x}=40$\n$\\log_{10}5^{x}=\\log_{10}40$\n$x\\log_{10}5=\\log_{10}40$\n$x=\\dfrac{\\log_{10}40}{\\log_{10}5}$\n$x=2.292$"
    },
    {
      "id": "q5",
      "question_text": "Solve $5\\times2^{x}=45$, correct to $3$ decimal places.",
      "structure": "solve-coefficient-exponential",
      "mastery": false,
      "options": [
        { "text": "$3.170$", "correct": true },
        { "text": "$5.492$", "why": "Took $\\log_{2}45$ without first dividing both sides by $5$ to isolate the power." },
        { "text": "$4.500$", "why": "After reaching $2^{x}=9$, divided $9$ by the base $2$ instead of taking logarithms." }
      ],
      "solution_text": "$5\\times2^{x}=45$\n$2^{x}=9$\n$\\log_{10}2^{x}=\\log_{10}9$\n$x\\log_{10}2=\\log_{10}9$\n$x=\\dfrac{\\log_{10}9}{\\log_{10}2}$\n$x=3.170$"
    },
    {
      "id": "q6",
      "question_text": "An investment of $\\$8\\,000$ grows at $7\\%$ p.a., so its value after $n$ years is $FV=8\\,000(1.07)^{n}$. Find how long it takes to reach $\\$12\\,000$, correct to the nearest $0.1$ years.",
      "structure": "solve-modelling-for-exponent",
      "mastery": false,
      "options": [
        { "text": "$6.0$", "correct": true },
        { "text": "$138.8$", "why": "Took $\\log_{1.07}12\\,000$ without first dividing by the present value $8\\,000$." },
        { "text": "$0.2$", "why": "Divided $\\log_{10}1.07$ by $\\log_{10}1.5$, inverting the ratio." }
      ],
      "solution_text": "$FV=8\\,000(1.07)^{n}$\n$12\\,000=8\\,000(1.07)^{n}$\n$1.5=1.07^{n}$\n$\\log_{10}1.5=n\\log_{10}1.07$\n$n=\\dfrac{\\log_{10}1.5}{\\log_{10}1.07}$\n$n=6.0\\text{ years}$"
    },
    {
      "id": "q7",
      "question_text": "Solve $2^{3x}=50$, correct to $3$ decimal places.",
      "structure": "solve-compound-index-exponential",
      "mastery": true,
      "options": [
        { "text": "$1.881$", "correct": true },
        { "text": "$5.644$", "why": "Solved $2^{x}=50$, forgetting the index is $3x$ rather than $x$." },
        { "text": "$16.933$", "why": "Multiplied the result by the index $3$ instead of dividing by it." }
      ],
      "solution_text": "$2^{3x}=50$\n$\\log_{10}2^{3x}=\\log_{10}50$\n$3x\\log_{10}2=\\log_{10}50$\n$3x=\\dfrac{\\log_{10}50}{\\log_{10}2}$\n$x=\\dfrac{\\log_{10}50}{3\\log_{10}2}$\n$x=1.881$"
    }
  ]
}
