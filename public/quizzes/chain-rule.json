    {
      "id": "q1",
      "question_text": "What is the derivative of $y = (5x - 4)^{6}$?",
      "structure": "chain-rule-linear-power",
      "mastery": false,
      "options": [
        {
          "text": "$30(5x - 4)^{5}$",
          "correct": true
        },
        {
          "text": "$6(5x - 4)^{5}$",
          "why": "Applied the power rule to the bracket but never multiplied by $\\dfrac{du}{dx} = 5$, the derivative of the inner function."
        },
        {
          "text": "$30(5x - 4)^{6}$",
          "why": "Multiplied the power $6$ by the inner derivative $5$ but left the index at $6$ instead of reducing it to $5$."
        },
        {
          "text": "$6(5x - 4)^{6}$",
          "why": "Brought the power $6$ down as the coefficient but neither reduced the index nor multiplied by the inner derivative $5$."
        }
      ],
      "solution_text": "$\\text{Let } u = 5x - 4, \\quad y = u^{6}$\n$\\dfrac{du}{dx} = 5, \\quad \\dfrac{dy}{du} = 6u^{5}$\n$\\dfrac{dy}{dx} = 6u^{5} \\times 5$\n$= 30(5x - 4)^{5}$"
    },
