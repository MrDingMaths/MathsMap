    {
      "id": "q7",
      "question_text": "What is the gradient of the tangent to $y = \\sqrt{4x + 9}$ at $x = 4$?",
      "structure": "chain-rule-tangent-normal",
      "mastery": false,
      "options": [
        {
          "text": "$\\dfrac{2}{5}$",
          "correct": true
        },
        {
          "text": "$\\dfrac{1}{5}$",
          "why": "Forgot to multiply by the numerator coefficient of 2 from $4/2$."
        },
        {
          "text": "$\\dfrac{4}{5}$",
          "why": "Forgot the factor of $1/2$ from differentiating the square root."
        },
        {
          "text": "$5$",
          "why": "Evaluated the function value $y(4) = \\sqrt{25} = 5$."
        }
      ],
      "solution_text": "$y' = \\dfrac{1}{2\\sqrt{4x + 9}} \\times 4 = \\dfrac{2}{\\sqrt{4x + 9}}$\n$\\text{At } x = 4, y'(4) = \\dfrac{2}{\\sqrt{25}} = \\dfrac{2}{5}$."
    },
    {
      "id": "q8",
      "question_text": "What is the equation of the normal to the curve $y = (3x - 8)^{3}$ at $x = 3$?",
      "structure": "chain-rule-tangent-normal",
      "mastery": true,
      "options": [
        {
          "text": "$x + 9y - 12 = 0$",
          "correct": true
        },
        {
          "text": "$9x - y - 26 = 0$",
          "why": "Found the equation of the tangent line instead of the normal."
        },
        {
          "text": "$x - 9y + 6 = 0$",
          "why": "Used positive reciprocal gradient $1/9$ instead of negative reciprocal."
        },
        {
          "text": "$x + 3y - 6 = 0$",
          "why": "Omitted the inner derivative of $3$ when computing the tangent gradient."
        }
      ],
      "solution_text": "$\\text{When } x = 3, y = (1)^{3} = 1$.\n$y' = 3(3x - 8)^{2} \\times 3 = 9(3x - 8)^{2}$\n$\\text{At } x = 3, y'(3) = 9(1)^{2} = 9$.\n$\\text{Normal gradient } m = -\\dfrac{1}{9}$.\n$y - 1 = -\\dfrac{1}{9}(x - 3)$\n$9y - 9 = -x + 3$\n$x + 9y - 12 = 0$"
    },
