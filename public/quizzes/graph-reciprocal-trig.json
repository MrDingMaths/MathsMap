      "id": "q1",
      "question_text": "For the graph of $y=\\sec x$, which list gives its ordinates at $x=0,\\pi/2,\\pi$ in that order?",
      "structure": "reciprocal-trig-key-point-table",
      "mastery": false,
      "options": [
{
          "text": "$1$, undefined, $-1$",
          "correct": true
        },
{
          "text": "Undefined, $1$, undefined",
          "why": "These are cosecant values, obtained by reciprocating sine instead of cosine."
        },
{
          "text": "Undefined, $0$, undefined",
          "why": "These are cotangent values, obtained from $\\cos x/\\sin x$ instead of $1/\\cos x$."
        },
{
          "text": "$1$, $0$, $-1$",
          "why": "This keeps the cosine ordinates without reciprocating them; secant is undefined where cosine is zero."
        }
],
      "solution_text": "Use $\\sec x=1/\\cos x$. The cosine values are $1,0,-1$, so the secant values are $1$, undefined, $-1$."
    },
