{
      "id": "q6",
      "question_text": "What is the exact ordinate of $y=\\cot x$ at $x=300^{\\circ}$?",
      "structure": "reciprocal-trig-exact-graph-ordinates",
      "mastery": false,
      "options": [
{
          "text": "$0$",
          "why": "This treats $300^{\\circ}$ as a cotangent zero; cotangent is zero at $90^{\\circ}$ and $270^{\\circ}$ in a full turn."
        },
{
          "text": "$1/\\sqrt3$",
          "why": "This loses the negative sign: cosine is positive and sine is negative at $300^{\\circ}$."
        },
{
          "text": "$-\\sqrt3$",
          "why": "This gives $\\tan300^{\\circ}$ instead of its reciprocal."
        },
{
          "text": "$-1/\\sqrt3$",
          "correct": true
        }
],
      "solution_text": "Use $\\cot x=\\cos x/\\sin x$. Thus $\\cot300^{\\circ}=(1/2)/(-\\sqrt3/2)=-1/\\sqrt3$."
    },
