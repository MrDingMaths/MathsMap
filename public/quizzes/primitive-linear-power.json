{
  "skillId": "primitive-linear-power",
  "questions": [
{
      "id": "q1",
      "question_text": "Find $\\displaystyle\\int(3x+2)^{4}\\,dx$.",
      "structure": "primitive-linear-bracket",
      "mastery": false,
      "options": [
        { "text": "$\\dfrac{(3x+2)^{5}}{15}+C$", "correct": true },
        { "text": "$\\dfrac{(3x+2)^{5}}{5}+C$", "why": "Divided by the new power $5$ but not by the coefficient $a=3$." },
        { "text": "$\\dfrac{(3x+2)^{5}}{12}+C$", "why": "Divided by the original power $4$ and the coefficient $3$ instead of by the new power $5$." },
        { "text": "$12(3x+2)^{3}$", "why": "Differentiated $(3x+2)^{4}$ with the chain rule instead of finding its primitive." }
      ],
      "solution_text": "$\\displaystyle\\int(3x+2)^{4}\\,dx=\\dfrac{(3x+2)^{5}}{3(5)}+C$\n$=\\dfrac{(3x+2)^{5}}{15}+C$"
    },
{
      "id": "q2",
      "question_text": "Find $\\displaystyle\\int(2-7x)^{3}\\,dx$.",
      "structure": "primitive-linear-bracket-negative-a",
      "mastery": false,
      "options": [
        { "text": "$-\\dfrac{(2-7x)^{4}}{28}+C$", "correct": true },
        { "text": "$\\dfrac{(2-7x)^{4}}{28}+C$", "why": "Used $7$ as the coefficient and lost the negative sign of $a=-7$." },
        { "text": "$\\dfrac{(2-7x)^{4}}{4}+C$", "why": "Divided by the new power $4$ but not by the coefficient $a=-7$." },
        { "text": "$-\\dfrac{(2-7x)^{4}}{21}+C$", "why": "Divided by the original power $3$ instead of by the new power $4$." }
      ],
      "solution_text": "$\\displaystyle\\int(2-7x)^{3}\\,dx=\\dfrac{(2-7x)^{4}}{-7(4)}+C$\n$=-\\dfrac{(2-7x)^{4}}{28}+C$"
    },
{
      "id": "q3",
      "question_text": "Find $\\displaystyle\\int(x+9)^{5}\\,dx$.",
      "structure": "primitive-linear-bracket-a-one",
      "mastery": false,
      "options": [
{ "text": "$\\dfrac{(x+9)^{6}}{6}+C$", "correct": true },
{ "text": "$\\dfrac{(x+9)^{6}}{54}+C$", "why": "Divided by the constant $9$ as well; only the coefficient of $x$ is used, and here that coefficient is $1$." },
{ "text": "$\\dfrac{(x+9)^{6}}{5}+C$", "why": "Divided by the original power $5$ instead of by the new power $6$." },
{ "text": "$\\dfrac{x^{6}}{6}+9x+C$", "why": "Incorrectly replaced $(x+9)^5$ by $x^5+9$, then integrated those two terms." }
],
      "solution_text": "$\\displaystyle\\int(x+9)^{5}\\,dx=\\dfrac{(x+9)^{6}}{1(6)}+C$\n$=\\dfrac{(x+9)^{6}}{6}+C$"
    },
{
      "id": "q4",
      "question_text": "Find $\\displaystyle\\int 15(5x-6)^{2}\\,dx$.",
      "structure": "primitive-linear-with-coefficient",
      "mastery": false,
      "options": [
        { "text": "$(5x-6)^{3}+C$", "correct": true },
        { "text": "$5(5x-6)^{3}+C$", "why": "Divided by the new power $3$ but not by the coefficient $a=5$." },
        { "text": "$3(5x-6)^{3}+C$", "why": "Divided by the coefficient $a=5$ but not by the new power $3$." },
        { "text": "$150(5x-6)$", "why": "Differentiated $15(5x-6)^{2}$ instead of finding its primitive." }
      ],
      "solution_text": "$\\displaystyle\\int 15(5x-6)^{2}\\,dx=\\dfrac{15(5x-6)^{3}}{5(3)}+C$\n$=(5x-6)^{3}+C$"
    },
{
      "id": "q5",
      "question_text": "Find $\\displaystyle\\int\\dfrac{1}{(4x-1)^{3}}\\,dx$, writing your answer without a negative index.",
      "structure": "primitive-linear-negative-index",
      "mastery": false,
      "options": [
        { "text": "$-\\dfrac{1}{8(4x-1)^{2}}+C$", "correct": true },
        { "text": "$\\dfrac{1}{8(4x-1)^{2}}+C$", "why": "Lost the negative sign that comes from the new power $-2$." },
        { "text": "$\\dfrac{1}{16(4x-1)^{4}}+C$", "why": "Added $1$ to the power of the denominator instead of to the index $-3$." },
        { "text": "$-\\dfrac{1}{2(4x-1)^{2}}+C$", "why": "Divided by the new power $-2$ but not by the coefficient $a=4$." }
      ],
      "solution_text": "$\\dfrac{1}{(4x-1)^{3}}$\n$=(4x-1)^{-3}$\n$\\displaystyle\\int(4x-1)^{-3}\\,dx=\\dfrac{(4x-1)^{-2}}{4(-2)}+C$\n$=-\\dfrac{1}{8(4x-1)^{2}}+C$"
    },
{
      "id": "q6",
      "question_text": "Find $\\displaystyle\\int\\sqrt{6x-5}\\,dx$.",
      "structure": "primitive-linear-fractional-index",
      "mastery": false,
      "options": [
        { "text": "$\\dfrac{(6x-5)^{\\frac{3}{2}}}{9}+C$", "correct": true },
        { "text": "$\\dfrac{2(6x-5)^{\\frac{3}{2}}}{3}+C$", "why": "Divided by the new power $\\dfrac{3}{2}$ but not by the coefficient $a=6$." },
        { "text": "$\\dfrac{(6x-5)^{\\frac{3}{2}}}{6}+C$", "why": "Divided by the coefficient $a=6$ but not by the new power $\\dfrac{3}{2}$." },
        { "text": "$\\dfrac{(6x-5)^{\\frac{3}{2}}}{12}+C$", "why": "Doubled the coefficient $6$ instead of multiplying it by the new power $\\dfrac{3}{2}$." }
      ],
      "solution_text": "$\\sqrt{6x-5}$\n$=(6x-5)^{\\frac{1}{2}}$\n$\\displaystyle\\int(6x-5)^{\\frac{1}{2}}\\,dx=\\dfrac{(6x-5)^{\\frac{3}{2}}}{6\\left(\\frac{3}{2}\\right)}+C$\n$=\\dfrac{(6x-5)^{\\frac{3}{2}}}{9}+C$"
    },
