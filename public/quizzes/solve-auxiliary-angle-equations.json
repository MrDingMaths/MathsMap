      "structure": "solve-auxiliary-multiple-angle",
      "mastery": false,
      "options": [
        {
          "text": "$x = \\frac{7\\pi}{8}, \\frac{15\\pi}{8}$",
          "correct": true
        },
        {
          "text": "$x = \\frac{7\\pi}{8}$",
          "why": "Missed the second period solution within $[0, 2\\pi]$."
        },
        {
          "text": "$x = \\frac{\\pi}{8}, \\frac{9\\pi}{8}$",
          "why": "Solved $\\cos(2x + \\pi/4) = 1$ with a sign error on the angle."
