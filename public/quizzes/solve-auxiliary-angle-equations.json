    {
      "id": "q1",
      "question_text": "Solve $\\cos x + \\sin x = 1$ for $0 \\le x \\le 2\\pi$.",
      "structure": "solve-auxiliary-exact-radian",
      "mastery": false,
      "options": [
        {
          "text": "$x = 0, \\frac{\\pi}{2}, 2\\pi$",
          "correct": true
        },
        {
          "text": "$x = 0, \\frac{\\pi}{2}$",
          "why": "Omitted the upper boundary value $x = 2\\pi$ in the closed domain $[0, 2\\pi]$."
        },
        {
          "text": "$x = \\frac{\\pi}{4}, \\frac{5\\pi}{4}$",
          "why": "Solved $\\sin(x + \\pi/4) = 0$ instead of $1/\\sqrt{2}$."
        },
        {
          "text": "$x = \\pi, \\frac{3\\pi}{2}$",
          "why": "Used wrong quadrant solutions corresponding to $-1/\\sqrt{2}$."
        }
      ],
      "solution_text": "$\\sqrt{2}\\cos\\left(x - \\frac{\\pi}{4}\\right) = 1$\n$\\cos\\left(x - \\frac{\\pi}{4}\\right) = \\frac{1}{\\sqrt{2}}$\nFor $x \\in [0, 2\\pi]$, $x - \\frac{\\pi}{4} \\in \\left[-\\frac{\\pi}{4}, \\frac{7\\pi}{4}\\right]$.\n$x - \\frac{\\pi}{4} = -\\frac{\\pi}{4}, \\frac{\\pi}{4}, \\frac{7\\pi}{4}$\n$x = 0, \\frac{\\pi}{2}, 2\\pi$"
    },
    {
