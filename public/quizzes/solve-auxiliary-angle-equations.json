    {
      "id": "q4",
      "question_text": "How many solutions does the equation $\\sqrt{7}\\cos x + 3\\sin x = 4$ have in $[0, 2\\pi)$?",
      "structure": "solve-auxiliary-boundary-extreme",
      "mastery": false,
      "options": [
        {
          "text": "Exactly $1$",
          "correct": true
        },
        {
          "text": "$2$",
          "why": "Assumed general cosine values always yield two roots without checking $c = R$."
        },
        {
          "text": "$0$",
          "why": "Believed $4 > R$ without evaluating $R = \\sqrt{7 + 9} = 4$."
        },
        {
          "text": "$4$",
          "why": "Doubled the root count across quadrants."
        }
      ],
      "solution_text": "$R = \\sqrt{(\\sqrt{7})^2 + 3^2} = \\sqrt{7 + 9} = 4$\nThe equation becomes $4\\cos(x - \\alpha) = 4 \\implies \\cos(x - \\alpha) = 1$.\nSince $\\cos\\theta = 1$ has exactly one solution per $2\\pi$ period, there is exactly $1$ solution."
    },
