      "id": "q1",
      "question_text": "Evaluate $20 + 6m$ for $m = -4$.",
      "structure": "add-negative",
      "mastery": false,
      "options": [
        {
          "text": "$-4$",
          "correct": true
        },
        {
          "text": "$44$",
          "why": "Ignored the negative sign, using $m = 4$: $20 + 6(4) = 44$."
        },
        {
          "text": "$22$",
          "why": "Read $6m$ as $6 - 4$ instead of multiplying: $20 + 6 - 4 = 22$."
        },
        {
          "text": "$-24$",
          "why": "Evaluated only $6(-4)$ and left out the $+20$."
        }
      ],
      "solution_text": "$20 + 6m$\n$= 20 + 6(-4)$\n$= 20 + (-24)$\n$= -4$"
    },
