{
  "skillId": "evaluate-function-algebraic-argument",
  "questions": [
    {
      "id": "q1",
      "question_text": "For $p(x)=3x-4$, find $p(a+2)$ in simplest form.",
      "structure": "sub-linear-argument",
      "mastery": false,
      "options": [
        { "text": "$3a+2$", "correct": true },
        { "text": "$3a-2$", "why": "Did not distribute the $3$ over the $2$, writing $3a+2$ before subtracting $4$." },
        { "text": "$3a+6$", "why": "Expanded $3(a+2)=3a+6$ but forgot to subtract the $4$." }
      ],
      "solution_text": "$p(a+2)=3(a+2)-4$\n$=3a+6-4$\n$=3a+2$"
    },
    {
      "id": "q2",
      "question_text": "For $f(x)=x^2+3x$, find $f(x+1)$ in simplest form.",
      "structure": "sub-quadratic-argument",
      "mastery": false,
      "options": [
        { "text": "$x^2+5x+4$", "correct": true },
        { "text": "$x^2+3x+4$", "why": "Expanded $(x+1)^2$ as $x^2+1$, dropping the middle term $2x$." },
        { "text": "$x^2+5x+1$", "why": "Substituted into $3(x+1)$ but only added $3x$, forgetting the $+3$." },
        { "text": "$x^2+2x+4$", "why": "Distributed the $3$ over only the $1$, adding $3$ but not $3x$." }
      ],
      "solution_text": "$f(x+1)=(x+1)^2+3(x+1)$\n$=x^2+2x+1+3x+3$\n$=x^2+5x+4$"
    },
    {
      "id": "q3",
      "question_text": "For $f(x)=x^2-7$, find $f(x-1)$ in simplest form.",
      "structure": "sub-square-argument",
      "mastery": false,
      "options": [
        { "text": "$x^2-2x-6$", "correct": true },
        { "text": "$x^2-8$", "why": "Expanded $(x-1)^2$ as $x^2-1$, dropping the middle term $-2x$." },
        { "text": "$x^2+2x-6$", "why": "Expanded $(x-1)^2$ with a positive middle term $+2x$ instead of $-2x$." }
      ],
      "solution_text": "$f(x-1)=(x-1)^2-7$\n$=x^2-2x+1-7$\n$=x^2-2x-6$"
    },
    {
      "id": "q4",
      "question_text": "For $g(x)=x^2-x$, find $g(-a)$ in simplest form.",
      "structure": "sub-negative-argument",
      "mastery": false,
      "options": [
        { "text": "$a^2+a$", "correct": true },
        { "text": "$a^2-a$", "why": "Wrote $-(-a)$ as $-a$ instead of $+a$, keeping the sign unchanged." },
        { "text": "$-a^2+a$", "why": "Squared $-a$ as $-a^2$ instead of $a^2$." },
        { "text": "$-a^2-a$", "why": "Squared $-a$ as $-a^2$ and also kept $-(-a)$ as $-a$." }
      ],
      "solution_text": "$g(-a)=(-a)^2-(-a)$\n$=a^2+a$"
    },
    {
      "id": "q5",
      "question_text": "For $f(x)=x^2$, find $f(x+h)$ in simplest form.",
      "structure": "sub-h-parameter",
      "mastery": false,
      "options": [
        { "text": "$x^2+2xh+h^2$", "correct": true },
        { "text": "$x^2+h^2$", "why": "Expanded $(x+h)^2$ as $x^2+h^2$, dropping the middle term $2xh$." },
        { "text": "$x^2+2xh+h$", "why": "Wrote the last term as $h$ instead of $h^2$ when squaring." },
        { "text": "$x^2+xh+h^2$", "why": "Used a coefficient of $1$ for the middle term instead of $2$." }
      ],
      "solution_text": "$f(x+h)=(x+h)^2$\n$=x^2+2xh+h^2$"
    },
    {
      "id": "q6",
      "question_text": "For $f(x)=x^2+3x$, find $f(k)-f(k-1)$ in simplest form.",
      "structure": "difference-consecutive",
      "mastery": false,
      "options": [
        { "text": "$2k+2$", "correct": true },
        { "text": "$2k-1$", "why": "Simplified as if $f(x)=x^2$, ignoring the $+3x$ term." },
        { "text": "$2k-2$", "why": "Did not change the sign of the $-2$ when subtracting $f(k-1)$." }
      ],
      "solution_text": "$f(k)-f(k-1)=(k^2+3k)-((k-1)^2+3(k-1))$\n$=(k^2+3k)-(k^2+k-2)$\n$=k^2+3k-k^2-k+2$\n$=2k+2$"
    },
    {
      "id": "q7",
      "question_text": "For $f(x)=3x^2-2x-4$, simplify $\\dfrac{f(x+h)-f(x)}{h}$.",
      "structure": "difference-quotient-general",
      "mastery": false,
      "options": [
        { "text": "$6x+3h-2$", "correct": true },
        { "text": "$6x+3h$", "why": "Divided the numerator by $h$ but dropped the constant $-2$." },
        { "text": "$6x+3h^2-2$", "why": "Left $\\dfrac{3h^2}{h}$ as $3h^2$ instead of cancelling to $3h$." },
        { "text": "$6x-2$", "why": "Cancelled $h$ before simplifying, dropping the $3h$ term entirely." }
      ],
      "solution_text": "$f(x+h)=3(x+h)^2-2(x+h)-4$\n$=3x^2+6xh+3h^2-2x-2h-4$\n$\\dfrac{f(x+h)-f(x)}{h}=\\dfrac{(3x^2+6xh+3h^2-2x-2h-4)-(3x^2-2x-4)}{h}$\n$=\\dfrac{6xh+3h^2-2h}{h}$\n$=6x+3h-2$"
    },
    {
      "id": "q8",
      "question_text": "For $f(x)=x^2-5$, find $\\dfrac{f(2+h)-f(2)}{h}$ in simplest form.",
      "structure": "difference-quotient-point",
      "mastery": true,
      "options": [
        { "text": "$h+4$", "correct": true },
        { "text": "$4$", "why": "Cancelled $h$ before simplifying, dropping the $h^2$ term so only $4$ remained." },
        { "text": "$h^2+4h$", "why": "Simplified the numerator but forgot to divide by $h$." },
        { "text": "$h+8$", "why": "Expanded $(2+h)^2$ with a middle term $8h$ instead of $4h$." }
      ],
      "solution_text": "$f(2+h)=(2+h)^2-5$\n$=h^2+4h-1$\n$f(2)=(2)^2-5$\n$=-1$\n$\\dfrac{f(2+h)-f(2)}{h}=\\dfrac{(h^2+4h-1)-(-1)}{h}$\n$=\\dfrac{h^2+4h}{h}$\n$=h+4$"
    }
  ]
}
