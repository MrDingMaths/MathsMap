  "questions": [
    {
      "id": "q1",
      "question_text": "Simplify $36$ mm $:4$ cm to its simplest form.",
      "structure": "length-units",
      "mastery": false,
      "options": [
        {
          "text": "$9:10$",
          "correct": true
        },
        {
          "text": "$9:1$",
          "why": "Treated $4$ cm as $4$ mm and simplified $36:4$ without converting."
        },
        {
          "text": "$10:9$",
          "why": "Converted correctly but wrote the two parts in the reverse order."
        },
        {
          "text": "$36:40$",
          "why": "Converted correctly but did not divide both parts by the HCF $4$."
        }
      ],
      "solution_text": "$36\\text{ mm}:4\\text{ cm}$\n$=36\\text{ mm}:40\\text{ mm}$\n$=(36\\div4):(40\\div4)$\n$=9:10$"
    },
    {
