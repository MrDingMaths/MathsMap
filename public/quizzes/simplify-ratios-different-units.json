      ],
      "solution_text": "$30\\text{ cm}:1\\text{ m}:45\\text{ cm}$\n$=30\\text{ cm}:100\\text{ cm}:45\\text{ cm}$\n$=(30\\div5):(100\\div5):(45\\div5)$\n$=6:20:9$"
    },
