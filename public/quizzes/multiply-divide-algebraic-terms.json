      "question_text": "Simplify $7e \\times 9g$.",
      "structure": "product-numbers-and-letters",
      "mastery": false,
      "options": [
        {
          "text": "$63eg$",
          "correct": true
        },
        {
          "text": "$16eg$",
          "why": "Added the coefficients $7 + 9$ instead of multiplying them."
        },
        {
          "text": "$63e$",
          "why": "Multiplied the numbers but carried only the first letter, dropping the $g$."
        },
        {
          "text": "$63$",
          "why": "Multiplied $7 \\times 9$ but dropped both pronumerals from the answer."
        }
      ],
      "solution_text": "$7e \\times 9g$\n$= (7 \\times 9)(e \\times g)$\n$= 63eg$"
    },
