{
  "skillId": "add-subtract-multiply-polynomials",
  "questions": [
    {
      "id": "q1",
      "question_text": "$P(x)=3x^{2}+x-6$ and $Q(x)=x^{2}-5x+2$.\nFind $P(x)+Q(x)$.",
      "structure": "add-polynomials",
      "mastery": false,
      "options": [
        { "text": "$4x^{2}-4x-4$", "correct": true },
        { "text": "$2x^{2}+6x-8$", "why": "Subtracted $Q(x)$ instead of adding it." },
        { "text": "$4x^{2}-4x+4$", "why": "Sign slip on the constants: $-6+2=-4$, not $+4$." },
        { "text": "$4x^{4}-4x-4$", "why": "Added the indices as well as the coefficients: $3x^{2}+x^{2}$ gives $4x^{2}$, not $4x^{4}$." }
      ],
      "solution_text": "$P(x)+Q(x)$\n$=(3x^{2}+x-6)+(x^{2}-5x+2)$\n$=4x^{2}-4x-4$"
    },
    {
      "id": "q2",
      "question_text": "$P(x)=2x^{3}-4x+7$ and $Q(x)=x^{3}+3x-5$.\nFind $P(x)-Q(x)$.",
      "structure": "subtract-polynomials",
      "mastery": false,
      "options": [
        { "text": "$x^{3}-7x+12$", "correct": true },
        { "text": "$x^{3}-x+2$", "why": "Only the $x^{3}$ term of $Q(x)$ had its sign changed; every term of $Q(x)$ must switch sign." },
        { "text": "$x^{3}-7x+2$", "why": "Changed the sign of $3x$ but not of $-5$: the constant becomes $7+5=12$, not $7-5$." },
        { "text": "$3x^{3}-x+2$", "why": "Added the polynomials instead of subtracting them." }
      ],
      "solution_text": "$P(x)-Q(x)$\n$=(2x^{3}-4x+7)-(x^{3}+3x-5)$\n$=2x^{3}-4x+7-x^{3}-3x+5$\n$=x^{3}-7x+12$"
    },
    {
      "id": "q3",
      "question_text": "$P(x)=x^{2}+6x$ and $Q(x)=3x^{2}-x+4$.\nFind $2P(x)-Q(x)$.",
      "structure": "scalar-combination",
      "mastery": false,
      "options": [
        { "text": "$-x^{2}+13x-4$", "correct": true },
        { "text": "$-x^{2}+11x-4$", "why": "Kept $-x$ as $-x$ when subtracting $Q(x)$; it must become $+x$." },
        { "text": "$5x^{2}+11x+4$", "why": "Added $Q(x)$ instead of subtracting it." },
        { "text": "$-x^{2}+13x+4$", "why": "The $+4$ in $Q(x)$ must become $-4$ after subtracting." }
      ],
      "solution_text": "$2P(x)-Q(x)$\n$=2(x^{2}+6x)-(3x^{2}-x+4)$\n$=2x^{2}+12x-3x^{2}+x-4$\n$=-x^{2}+13x-4$"
    },
    {
      "id": "q4",
      "question_text": "Expand and simplify $(x+6)(x^{2}-2x+5)$.",
      "structure": "multiply-binomial-trinomial",
      "mastery": false,
      "options": [
        { "text": "$x^{3}+4x^{2}-7x+30$", "correct": true },
        { "text": "$x^{3}+8x^{2}+17x+30$", "why": "Dropped the negative on $-2x$ and expanded $(x+6)(x^{2}+2x+5)$ instead." },
        { "text": "$x^{3}-2x^{2}+5x+30$", "why": "Distributed $x$ through the trinomial but multiplied $6$ only by the constant term." },
        { "text": "$x^{3}+4x^{2}-7x-30$", "why": "Recorded $6\\times 5$ as $-30$; the product of two positive terms is $+30$." }
      ],
      "solution_text": "$(x+6)(x^{2}-2x+5)$\n$=x(x^{2}-2x+5)+6(x^{2}-2x+5)$\n$=x^{3}-2x^{2}+5x+6x^{2}-12x+30$\n$=x^{3}+4x^{2}-7x+30$"
    },
    {
      "id": "q5",
      "question_text": "Expand and simplify $(x^{2}-9)(x^{3}+4x)$.",
      "structure": "multiply-sparse-terms",
      "mastery": false,
      "options": [
        { "text": "$x^{5}-5x^{3}-36x$", "correct": true },
        { "text": "$x^{5}+4x^{3}-36x$", "why": "Missed the product of $-9$ and $x^{3}$; the two $x^{3}$ terms combine to $-5x^{3}$." },
        { "text": "$x^{5}-36x$", "why": "Multiplied only the first terms and the last terms together, skipping the two cross products." },
        { "text": "$x^{6}-5x^{3}-36x$", "why": "Multiplied the indices in $x^{2}\\times x^{3}$ instead of adding them." }
      ],
      "solution_text": "$(x^{2}-9)(x^{3}+4x)$\n$=x^{2}(x^{3}+4x)-9(x^{3}+4x)$\n$=x^{5}+4x^{3}-9x^{3}-36x$\n$=x^{5}-5x^{3}-36x$"
    },
    {
      "id": "q6",
      "question_text": "$P(x)=2x+1$ and $Q(x)=x^{2}-x+5$.\nFind $P(x)\\times Q(x)$.",
      "structure": "multiply-binomial-trinomial",
      "mastery": false,
      "options": [
        { "text": "$2x^{3}-x^{2}+9x+5$", "correct": true },
        { "text": "$2x^{3}-x^{2}+10x+5$", "why": "Missed the product $1\\times(-x)$, so the $x$ terms combine to $9x$, not $10x$." },
        { "text": "$2x^{3}-2x^{2}+10x+5$", "why": "Distributed $2x$ through $Q(x)$ but multiplied $1$ only by the constant term." },
        { "text": "$2x^{3}+3x^{2}+9x+5$", "why": "Dropped the negative on $-x$ when multiplying by $2x$, giving $+2x^{2}$ instead of $-2x^{2}$." }
      ],
      "solution_text": "$P(x)\\times Q(x)$\n$=(2x+1)(x^{2}-x+5)$\n$=2x(x^{2}-x+5)+1(x^{2}-x+5)$\n$=2x^{3}-2x^{2}+10x+x^{2}-x+5$\n$=2x^{3}-x^{2}+9x+5$"
    },
    {
      "id": "q7",
      "question_text": "$P(x)=x-4$ and $Q(x)=x^{2}+2x-3$.\nFind $P(x)Q(x)+4Q(x)$.",
      "structure": "combined-operations",
      "mastery": true,
      "options": [
        { "text": "$x^{3}+2x^{2}-3x$", "correct": true },
        { "text": "$x^{3}-2x^{2}-11x+12$", "why": "Found $P(x)Q(x)$ but never added the $4Q(x)$ term." },
        { "text": "$x^{3}-6x^{2}-19x+24$", "why": "Subtracted $4Q(x)$ instead of adding it." }
      ],
      "solution_text": "$P(x)Q(x)+4Q(x)$\n$=(x-4)(x^{2}+2x-3)+4(x^{2}+2x-3)$\n$=x^{3}+2x^{2}-3x-4x^{2}-8x+12+4x^{2}+8x-12$\n$=x^{3}+2x^{2}-3x$"
    },
    {
      "id": "q8",
      "question_text": "$P(x)=x^{2}-3x$.\nFind $\\left(P(x)\\right)^{2}$.",
      "structure": "square-polynomial",
      "mastery": true,
      "options": [
        { "text": "$x^{4}-6x^{3}+9x^{2}$", "correct": true },
        { "text": "$x^{4}+9x^{2}$", "why": "Squared each term separately and skipped the middle term $2\\times x^{2}\\times(-3x)$." },
        { "text": "$x^{4}-6x^{3}-9x^{2}$", "why": "Squared $-3x$ as $-9x^{2}$; a negative term squared is positive." },
        { "text": "$2x^{2}-6x$", "why": "Doubled each term instead of multiplying the polynomial by itself." }
      ],
      "solution_text": "$\\left(P(x)\\right)^{2}$\n$=(x^{2}-3x)(x^{2}-3x)$\n$=x^{4}-3x^{3}-3x^{3}+9x^{2}$\n$=x^{4}-6x^{3}+9x^{2}$"
    }
  ]
}
