    {
      "id": "q1",
      "question_text": "Find $\\int 12x^{3}\\,dx$.",
      "structure": "integrate-single-power",
      "mastery": false,
      "options": [
        { "text": "$3x^{4} + C$", "correct": true },
        { "text": "$36x^{2} + C$", "why": "Differentiated $12x^{3}$ instead of integrating it." },
        { "text": "$4x^{4} + C$", "why": "Divided by the old index $3$ instead of the new index $4$." },
        { "text": "$3x^{4}$", "why": "Omitted the constant of integration from an indefinite integral." }
      ],
      "solution_text": "$\\int 12x^{3}\\,dx$\n$= \\dfrac{12x^{4}}{4} + C$\n$= 3x^{4} + C$"
    },
    {
      "id": "q2",
      "question_text": "Find $\\int \\dfrac{1}{x^{5}}\\,dx$.",
      "structure": "integrate-negative-power",
      "mastery": false,
      "options": [
        { "text": "$-\\dfrac{1}{4x^{4}} + C$", "correct": true },
        { "text": "$\\dfrac{1}{4x^{4}} + C$", "why": "Added one to the index but ignored that dividing by $-4$ makes the term negative." },
        { "text": "$-\\dfrac{1}{6x^{6}} + C$", "why": "Subtracted one from the index $-5$ instead of adding one." },
        { "text": "$-\\dfrac{5}{x^{6}} + C$", "why": "Differentiated $x^{-5}$ instead of integrating it." }
      ],
      "solution_text": "$\\int \\dfrac{1}{x^{5}}\\,dx$\n$= \\int x^{-5}\\,dx$\n$= \\dfrac{x^{-4}}{-4} + C$\n$= -\\dfrac{1}{4x^{4}} + C$"
    },
    {
      "id": "q3",
      "question_text": "Find $\\int \\sqrt[3]{x}\\,dx$.",
      "structure": "integrate-fractional-power",
      "mastery": false,
      "options": [
        { "text": "$\\dfrac{3x^{\\frac{4}{3}}}{4} + C$", "correct": true },
        { "text": "$\\dfrac{4x^{\\frac{4}{3}}}{3} + C$", "why": "Multiplied by the new index $\\dfrac{4}{3}$ instead of dividing by it." },
        { "text": "$\\dfrac{x^{\\frac{4}{3}}}{4} + C$", "why": "Divided by $4$ rather than by the new index $\\dfrac{4}{3}$." },
        { "text": "$\\dfrac{x^{-\\frac{2}{3}}}{3} + C$", "why": "Differentiated $x^{\\frac{1}{3}}$ instead of integrating it." }
      ],
      "solution_text": "$\\int \\sqrt[3]{x}\\,dx$\n$= \\int x^{\\frac{1}{3}}\\,dx$\n$= \\dfrac{x^{\\frac{4}{3}}}{\\frac{4}{3}} + C$\n$= \\dfrac{3x^{\\frac{4}{3}}}{4} + C$"
    },
    {
      "id": "q4",
      "question_text": "Evaluate $\\int_{1}^{3} 4x^{3}\\,dx$.",
      "structure": "definite-power",
      "mastery": false,
      "options": [
        { "text": "$80$", "correct": true },
        { "text": "$-80$", "why": "Computed $F(a) - F(b)$ instead of $F(b) - F(a)$." },
        { "text": "$82$", "why": "Added the two substituted values instead of subtracting them." },
        { "text": "$81$", "why": "Substituted the upper limit only and did not subtract the value at $x = 1$." }
      ],
      "solution_text": "$\\int_{1}^{3} 4x^{3}\\,dx$\n$= \\left[x^{4}\\right]_{1}^{3}$\n$= 81 - 1$\n$= 80$"
    },
    {
      "id": "q5",
      "question_text": "Evaluate $\\int_{0}^{4}(3x - 14)\\,dx$.",
      "structure": "definite-polynomial",
      "mastery": false,
      "options": [
        { "text": "$-32$", "correct": true },
        { "text": "$32$", "why": "Computed $F(a) - F(b)$, reversing the order of the limits." },
        { "text": "$-8$", "why": "Integrated $3x$ as $3x^{2}$ instead of $\\dfrac{3x^{2}}{2}$, giving $48 - 56$." },
        { "text": "$24$", "why": "Left the constant term $-14$ unintegrated instead of writing $-14x$." }
      ],
      "solution_text": "$\\int_{0}^{4}(3x - 14)\\,dx$\n$= \\left[\\dfrac{3x^{2}}{2} - 14x\\right]_{0}^{4}$\n$= (24 - 56) - 0$\n$= -32$"
    },
    {
      "id": "q6",
      "question_text": "Evaluate $\\int_{0}^{3} x(x - 4)\\,dx$.",
      "structure": "expand-then-integrate",
      "mastery": false,
      "options": [
        { "text": "$-9$", "correct": true },
        { "text": "$9$", "why": "Computed $F(a) - F(b)$ instead of $F(b) - F(a)$." },
        { "text": "$-27$", "why": "Integrated $-4x$ as $-4x^{2}$ instead of $-2x^{2}$." },
        { "text": "$-\\dfrac{135}{4}$", "why": "Integrated the two factors separately as $\\dfrac{x^{2}}{2}$ and $\\dfrac{x^{2}}{2} - 4x$, as if a product rule existed for integration." }
      ],
      "solution_text": "$\\int_{0}^{3} x(x - 4)\\,dx$\n$= \\int_{0}^{3}\\left(x^{2} - 4x\\right)dx$\n$= \\left[\\dfrac{x^{3}}{3} - 2x^{2}\\right]_{0}^{3}$\n$= (9 - 18) - 0$\n$= -9$"
    },
    {
      "id": "q7",
      "question_text": "Evaluate $\\int_{1}^{2} \\dfrac{6x^{3} - x^{2}}{x^{2}}\\,dx$.",
      "structure": "split-fraction-then-integrate",
      "mastery": false,
      "options": [
        { "text": "$8$", "correct": true },
        { "text": "$-8$", "why": "Computed $F(a) - F(b)$, reversing the order of the limits." },
        { "text": "$\\dfrac{20}{3}$", "why": "Divided only the first term of the numerator by $x^{2}$, integrating $6x - x^{2}$." },
        { "text": "$10$", "why": "Substituted the upper limit only, without subtracting the value at $x = 1$." }
      ],
      "solution_text": "$\\int_{1}^{2} \\dfrac{6x^{3} - x^{2}}{x^{2}}\\,dx$\n$= \\int_{1}^{2}(6x - 1)\\,dx$\n$= \\left[3x^{2} - x\\right]_{1}^{2}$\n$= (12 - 2) - (3 - 1)$\n$= 10 - 2$\n$= 8$"
    },
