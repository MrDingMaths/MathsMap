    {
      "id": "dq-27903",
      "question_text": "Expand and simplify: $4(2x+1)-(5x-9)$",
      "structure": "expand-collect",
      "mastery": false,
      "options": [
        {
          "text": "$3x-5$",
          "why": "Distributes or combines the constant terms with incorrect signs."
        },
        {
          "text": "$3x+13$",
          "correct": true
        },
        {
          "text": "$13x-5$",
          "why": "Adds the coefficients of x incorrectly after expanding the brackets."
        },
        {
          "text": "$13x+13$",
          "why": "Adds both x-coefficients instead of subtracting the second bracket."
        }
      ],
      "solution_text": "Expand: $4(2x+1)=8x+4$ and $-(5x-9)=-5x+9$. Therefore $8x+4-5x+9=3x+13$."
    },
    {
      "id": "dq-82101",
      "question_text": "Algebra: Expanding Single Brackets.\nExpand 2x(x + 3)",
      "structure": "variable-multiplier",
      "mastery": false,
      "options": [
        {
          "text": "(A) 2x + 6",
          "why": "Multiplies the bracket incorrectly and loses the factor of x."
        },
        {
          "text": "(B) 2x² + 6x",
          "correct": true
        },
        {
          "text": "(C) 2 + x² + 6",
          "why": "Adds terms and does not distribute 2x to both terms."
        },
        {
          "text": "(D) 2x² + 3",
          "why": "Multiplies only the first term and leaves the second term unchanged."
        }
      ],
      "solution_text": "Distribute $2x$ to each term.\n$2x \\times x + 2x \\times 3$\n$= 2x^{2} + 6x$"
    },
    {
      "id": "dq-18211",
      "question_text": "Expand and simplify $3(2x + 1) + 2(4x - 3)$",
      "structure": "expand-collect",
      "mastery": false,
      "options": [
        {
          "text": "A: $14x + 9$",
          "why": "The negative constant term was incorrectly treated as positive."
        },
        {
          "text": "B: $14x - 9$",
          "why": "The constant terms were combined incorrectly after expansion."
        },
        {
          "text": "C: $14x - 3$",
          "correct": true
        },
        {
          "text": "D: $14x + 3$",
          "why": "The second bracket's negative constant was given the wrong sign."
        }
      ],
      "solution_text": "Distribute each multiplier: $3(2x+1)=6x+3$ and $2(4x-3)=8x-6$. Then collect like terms: $6x+8x+3-6=14x-3$."
    }
  ]
