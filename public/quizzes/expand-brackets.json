  "questions": [
    {
      "id": "q1",
      "question_text": "Expand $3(m+9)$.",
      "structure": "numeric-multiplier-add",
      "mastery": false,
      "options": [
        {
          "text": "$3m+27$",
          "correct": true
        },
        {
          "text": "$3m+9$",
          "why": "Distributed the $3$ to the first term only, leaving the $9$ un-multiplied."
        },
        {
          "text": "$3m+12$",
          "why": "Added $3+9$ instead of multiplying $3 \\times 9$ for the second term."
        },
        {
          "text": "$27m$",
          "why": "Treated $m+9$ as a single term and multiplied everything together."
        }
      ],
      "solution_text": "$3(m+9)$\n$= 3(m) + 3(9)$\n$= 3m+27$"
    },
    {
      "id": "q2",
      "question_text": "Expand $8(t-4)$.",
      "structure": "numeric-multiplier-subtract",
      "mastery": false,
      "options": [
        {
          "text": "$8t-32$",
          "correct": true
        },
        {
          "text": "$8t-4$",
          "why": "Distributed to the $t$ only and copied the $-4$ unchanged."
        },
        {
          "text": "$8t+32$",
          "why": "Lost the subtraction sign, turning $-4$ into $+32$."
        },
        {
          "text": "$t-32$",
          "why": "Forgot to multiply the $t$ term by $8$."
        }
      ],
      "solution_text": "$8(t-4)$\n$= 8(t) - 8(4)$\n$= 8t-32$"
    },
    {
      "id": "q3",
      "question_text": "Expand $3x(4x+5)$.",
      "structure": "variable-multiplier",
      "mastery": false,
      "options": [
        {
          "text": "$12x^2+15x$",
          "correct": true
        },
        {
          "text": "$12x+15x$",
          "why": "Treated $x \\times x$ as $x$ instead of $x^2$ for the first product."
        },
        {
          "text": "$12x^2+15$",
          "why": "Multiplied $3x \\times 5$ as $15$, dropping the $x$ from the second product."
        },
        {
          "text": "$7x^2+15x$",
          "why": "Added $3+4$ instead of multiplying $3 \\times 4$ for the first product."
        }
      ],
      "solution_text": "$3x(4x+5)$\n$= 3x(4x) + 3x(5)$\n$= 12x^2+15x$"
    },
    {
      "id": "q4",
      "question_text": "Expand $7(2p+q+4)$.",
      "structure": "three-terms",
      "mastery": false,
      "options": [
        {
          "text": "$14p+7q+28$",
          "correct": true
        },
        {
          "text": "$14p+q+4$",
          "why": "Distributed the $7$ to the first term only, copying $q$ and $4$ unchanged."
        },
        {
          "text": "$14p+7q+4$",
          "why": "Stopped early and forgot to multiply the last term $4$."
        },
        {
          "text": "$14p+7q+11$",
          "why": "Added $7$ to the last term ($4+7$) instead of multiplying it."
        }
      ],
      "solution_text": "$7(2p+q+4)$\n$= 7(2p) + 7(q) + 7(4)$\n$= 14p+7q+28$"
    },
    {
      "id": "q5",
      "question_text": "Expand and simplify $3(3x+2)-2(x+5)$.",
      "structure": "expand-collect",
      "mastery": true,
      "options": [
        {
          "text": "$7x-4$",
          "correct": true
        },
        {
          "text": "$11x+16$",
          "why": "Read the subtraction as addition, expanding the second bracket as $+2x+10$."
        },
        {
          "text": "$7x+16$",
          "why": "Applied the minus to $2x$ only, leaving $+10$ instead of $-10$."
        },
        {
          "text": "$7x-8$",
          "why": "Distributed the $3$ to the $3x$ only, leaving the $+2$ un-multiplied."
        }
      ],
      "solution_text": "$3(3x+2)-2(x+5)$\n$= 9x+6 - 2x-10$\n$= 7x-4$"
    },
    {
      "id": "q6",
      "question_text": "Expand $4ab(2a-5b)$.",
      "structure": "variable-multiplier",
      "mastery": true,
      "options": [
        {
          "text": "$8a^2b-20ab^2$",
          "correct": true
        },
        {
          "text": "$8a^2b+20ab^2$",
          "why": "Sign slip — made the second product positive despite the $-5b$."
        },
        {
          "text": "$8a^2b-20b^2$",
          "why": "Dropped the $a$ from $4ab \\times 5b$, losing a factor in the second product."
        },
        {
          "text": "$6a^2b-20ab^2$",
          "why": "Added $4+2$ instead of multiplying $4 \\times 2$ for the first product."
