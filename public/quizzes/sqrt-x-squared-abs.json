          "why": "Assumed $x - 6 < 0$ without a given domain restriction."
        },
        {
          "text": "$(x - 6)^2$",
          "why": "Omitted the square root operation entirely."
        }
      ],
      "solution_text": "$\\sqrt{(x - 6)^2}$\n$=|x - 6|$"
    },
    {
      "id": "q5",
      "question_text": "Simplify $\\sqrt{x^2 - 8x + 16}$ for all real numbers $x$.",
      "structure": "evaluate-perfect-square-trinomial",
      "mastery": false,
      "options": [
        {
          "text": "$|x - 4|$",
          "correct": true
        },
        {
          "text": "$x - 4$",
          "why": "Omitted the absolute value bars on the linear factor."
        },
        {
          "text": "$|x + 4|$",
          "why": "Used addition instead of subtraction in the factored binomial."
        },
        {
          "text": "$x^2 - 4$",
          "why": "Attempted to take square roots of individual terms instead of factorising."
        }
      ],
      "solution_text": "$\\sqrt{x^2 - 8x + 16}$\n$=\\sqrt{(x - 4)^2}$\n$=|x - 4|$"
    },
    {
      "id": "q6",
      "question_text": "Simplify $\\sqrt{(x - 2)^2}$ given that $x < 2$.",
      "structure": "conditional-simplification-with-domain",
      "mastery": false,
      "options": [
        {
          "text": "$-x + 2$",
          "correct": true
        },
        {
          "text": "$x - 2$",
          "why": "Ignored the domain restriction $x < 2$ and removed absolute value bars without negating."
        },
        {
          "text": "$x + 2$",
          "why": "Changed the sign of only the constant rather than distributing $-1$."
        },
        {
          "text": "$-x - 2$",
          "why": "Negated both terms with incorrect signs."
        }
      ],
      "solution_text": "$\\sqrt{(x - 2)^2}$\n$=|x - 2|$\n$\\text{Since } x < 2, x - 2 < 0 \\implies |x - 2| = -(x - 2) = -x + 2.$"
    },
    {
      "id": "q7",
      "question_text": "Which calculation correctly disproves the claim that $\\sqrt{x^2} = x$ for all real numbers $x$?",
      "structure": "numerical-substitution-demonstration",
      "mastery": false,
      "options": [
        {
          "text": "$\\sqrt{(-4)^2} = \\sqrt{16} = 4 \\neq -4$",
          "correct": true
        },
        {
          "text": "$\\sqrt{4^2} = \\sqrt{16} = 4 = 4$",
          "why": "Substituting a positive number satisfies the equality and does not disprove it."
        },
        {
          "text": "$\\sqrt{0^2} = \\sqrt{0} = 0 = 0$",
          "why": "Substituting zero satisfies the equality and does not provide a counterexample."
        },
        {
          "text": "$\\sqrt{(-4)^2} = -4$",
          "why": "Incorrectly evaluated the principal square root as a negative number."
        }
      ],
      "solution_text": "$\\text{For } x = -4: \\text{LHS} = \\sqrt{(-4)^2} = \\sqrt{16} = 4 \\text{ while RHS} = -4.$\n$\\text{Since } 4 \\neq -4, \\text{ this counterexample disproves } \\sqrt{x^2} = x.$"
    },
    {
      "id": "q8",
      "question_text": "Simplify $\\sqrt{x^2 - 4x + 4} + \\sqrt{x^2 - 12x + 36}$ for $2 \\le x \\le 6$.",
      "structure": "evaluate-perfect-square-trinomial",
      "mastery": true,
      "options": [
        {
          "text": "$4$",
          "correct": true
        },
        {
          "text": "$2x - 8$",
          "why": "Treated $x - 6$ as positive on $2 \\le x \\le 6$, writing $x - 6$ instead of $6 - x$."
        },
        {
          "text": "$-2x + 8$",
          "why": "Treated $x - 2$ as negative on $2 \\le x \\le 6$, writing $2 - x$ instead of $x - 2$."
        },
        {
          "text": "$8$",
          "why": "Made an arithmetic error when combining the constant terms $(x - 2) + (6 - x)$."
        }
      ],
      "solution_text": "$\\sqrt{x^2 - 4x + 4} + \\sqrt{x^2 - 12x + 36}$\n$=\\sqrt{(x - 2)^2} + \\sqrt{(x - 6)^2}$\n$=|x - 2| + |x - 6|$\n$\\text{For } 2 \\le x \\le 6: x - 2 \\ge 0 \\implies |x - 2| = x - 2$\n$\\text{and } x - 6 \\le 0 \\implies |x - 6| = 6 - x$\n$=x - 2 + 6 - x$\n$=4$"
    },
    {
      "id": "q9",
      "question_text": "Simplify $\\dfrac{\\sqrt{(x - 5)^2}}{5 - x}$ for all $x < 5$.",
      "structure": "conditional-simplification-with-domain",
      "mastery": true,
      "options": [
        {
          "text": "$1$",
          "correct": true
        },
        {
          "text": "$-1$",
          "why": "Did not recognise that $|x - 5| = -(x - 5) = 5 - x$ when $x < 5$."
        },
        {
          "text": "$x - 5$",
          "why": "Cancelled algebraic factors incorrectly."
        },
        {
          "text": "$|x - 5|$",
          "why": "Failed to simplify the fraction after replacing the radical."
        }
      ],
      "solution_text": "$\\dfrac{\\sqrt{(x - 5)^2}}{5 - x}$\n$=\\dfrac{|x - 5|}{5 - x}$\n$\\text{Since } x < 5, x - 5 < 0 \\implies |x - 5| = -(x - 5) = 5 - x$\n$=\\dfrac{5 - x}{5 - x}$\n$=1$"
    }
  ]
}
