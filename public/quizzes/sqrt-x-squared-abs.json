{
  "skillId": "sqrt-x-squared-abs",
  "questions": [
    {
      "id": "q1",
      "question_text": "What is the value of $\\sqrt{(-8)^2}$?",
      "structure": "numerical-substitution-demonstration",
      "mastery": false,
      "options": [
        {
          "text": "$8$",
          "correct": true
        },
        {
          "text": "$-8$",
          "why": "Assumed $\\sqrt{x^2} = x$ for negative numbers, forgetting principal square roots are non-negative."
        },
        {
          "text": "$\\pm 8$",
          "why": "Treated the evaluation as having two roots instead of evaluating the single principal square root."
        },
        {
          "text": "$-64$",
          "why": "Squared $-8$ incorrectly as $-64$ and omitted the square root."
        }
      ],
      "solution_text": "$\\sqrt{(-8)^2}$\n$=\\sqrt{64}$\n$=8$"
    },
    {
      "id": "q2",
      "question_text": "For any real number $x$, what is the simplified form of $\\sqrt{x^2}$?",
      "structure": "simplify-monomial-radical",
      "mastery": false,
      "options": [
        {
          "text": "$|x|$",
          "correct": true
        },
        {
          "text": "$x$",
          "why": "Ignored negative values of $x$ where $\\sqrt{x^2} = -x \\neq x$."
        },
        {
          "text": "$\\pm x$",
          "why": "Treated the algebraic expression as having two simultaneous signs."
        },
        {
          "text": "$x^2$",
          "why": "Failed to apply the square root operation to the expression."
        }
      ],
      "solution_text": "$\\sqrt{x^2}$\n$=|x|$"
    },
    {
      "id": "q3",
      "question_text": "Simplify $\\sqrt{16y^2}$ for all real numbers $y$.",
      "structure": "simplify-monomial-radical",
      "mastery": false,
      "options": [
        {
          "text": "$4|y|$",
          "correct": true
        },
        {
          "text": "$4y$",
          "why": "Omitted the absolute value bars on the variable $y$."
        },
        {
          "text": "$16|y|$",
          "why": "Did not take the square root of the coefficient $16$."
        },
        {
          "text": "$\\pm 4y$",
          "why": "Used plus-minus notation instead of the required absolute value form."
        }
      ],
      "solution_text": "$\\sqrt{16y^2}$\n$=\\sqrt{4^2 y^2}$\n$=4|y|$"
    },
    {
