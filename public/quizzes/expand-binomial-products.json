{
      "id": "q1",
      "question_text": "Expand and simplify $(x+8)(x-2)$.",
      "structure": "expand-monic-binomials",
      "mastery": false,
      "options": [
        {
          "text": "$x^2+6x-16$",
          "correct": true
        },
        {
          "text": "$x^2-6x-16$",
          "why": "Swapped the signs of the two middle products, using $-8x$ and $+2x$."
        },
        {
          "text": "$x^2+6x+16$",
          "why": "Multiplied $8\\times(-2)$ as $+16$, ignoring the negative sign."
        },
        {
          "text": "$x^2-16$",
          "why": "Multiplied only the first terms and only the last terms, omitting the two middle products."
        }
      ],
      "solution_text": "$(x+8)(x-2)$\n$=x^2-2x+8x-16$\n$=x^2+6x-16$"
    },
