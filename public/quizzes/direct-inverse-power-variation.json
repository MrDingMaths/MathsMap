    {
      "id": "q1",
      "structure": "translate-power-model",
      "question_text": "For $x>0$, $y$ varies inversely with the cube of $x$. Which equation describes the relationship for $k\\ne0$?",
      "solution_text": "$y\\propto\\frac1{x^3}$, so $y=\\frac{k}{x^3}$.",
      "mastery": false,
      "options": [
        {
          "text": "$y=\\frac{k}{x^3}$",
          "correct": true
        },
        {
          "text": "$y=kx^3$",
          "why": "Used direct variation instead of inverse variation."
        },
        {
          "text": "$y=\\frac{k}{x}$",
          "why": "Ignored the cube and used first-power inverse variation."
        },
        {
          "text": "$y=\\frac{k}{\\sqrt[3]x}$",
          "why": "Used the cube root instead of the cube in the denominator."
        }
      ]
    },
    {
      "id": "q2",
      "structure": "find-power-constant",
      "question_text": "For $x>0$, $y=\\frac{k}{x^2}$. At $x=4$, $y=6$. What is $k$?",
      "solution_text": "$\\begin{aligned}6&=\\frac{k}{16}\\\\k&=6(16)\\\\&=96\\end{aligned}$",
      "mastery": false,
      "options": [
        {
          "text": "$96$",
          "correct": true
        },
        {
          "text": "$24$",
          "why": "Used first-power multiplication: $6(4)=24$."
        },
        {
          "text": "$0.375$",
          "why": "Divided by the square instead of multiplying: $6/16=0.375$."
        },
        {
          "text": "$36$",
          "why": "Squared the output instead of using the input: $6^2=36$."
        }
      ]
    },
