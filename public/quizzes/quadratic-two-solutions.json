{
      "id": "q1",
      "question_text": "Find both solutions of $x^{2}=100$.",
      "structure": "find-both-solutions-of-numerical-square-equation",
      "mastery": false,
      "options": [
{
          "text": "$x=\\pm 10$",
          "correct": true
        },
{
          "text": "$x=10$ only",
          "why": "Took only the positive root, forgetting that $(-10)^{2}$ also gives $100$."
        },
{
          "text": "$x=\\pm 50$",
          "why": "Halved $100$ instead of finding the number that multiplies by itself to give $100$."
        },
{
          "text": "$x=\\pm 100$",
          "why": "Repeated the right-hand side as the solutions without undoing the square."
        }
],
      "solution_text": "$10\\times 10=100$ and $(-10)\\times (-10)=100$\n$x=\\pm 10$"
    },
