    {
      "id": "q1",
      "question_text": "Find the natural domain of $f(x)=\\frac{1}{x+5}$.",
      "structure": "reciprocal-linear-denominator",
      "mastery": false,
      "options": [
        { "text": "$(-\\infty,-5)\\cup(-5,\\infty)$", "correct": true },
        { "text": "$(-\\infty,5)\\cup(5,\\infty)$", "why": "Excluded $x=5$, but solving $x+5=0$ gives $x=-5$." },
        { "text": "$(-\\infty,\\infty)$", "why": "Missed that the denominator is zero at $x=-5$, which must be excluded." }
      ],
      "solution_text": "$x+5\\neq0$\n$x\\neq-5$\nDomain: $(-\\infty,-5)\\cup(-5,\\infty)$"
    },
    {
      "id": "q2",
      "question_text": "Find the natural domain of $f(x)=\\sqrt{2x-6}$.",
      "structure": "square-root-radicand",
      "mastery": false,
      "options": [
        { "text": "$[3,\\infty)$", "correct": true },
        { "text": "$(3,\\infty)$", "why": "Used $($ at $3$, but $2x-6\\geq0$ allows $x=3$, so it needs $[$." },
        { "text": "$(-\\infty,3]$", "why": "Required the radicand $\\leq0$ instead of $\\geq0$." }
      ],
      "solution_text": "$2x-6\\geq0$\n$2x\\geq6$\n$x\\geq3$\nDomain: $[3,\\infty)$"
    },
    {
      "id": "q3",
      "question_text": "Find the natural domain of $f(x)=\\frac{\\sqrt{x}}{x-4}$.",
      "structure": "root-numerator-and-denominator",
      "mastery": true,
      "options": [
        { "text": "$[0,4)\\cup(4,\\infty)$", "correct": true },
        { "text": "$(-\\infty,4)\\cup(4,\\infty)$", "why": "Excluded $x=4$ but ignored that $\\sqrt{x}$ needs $x\\geq0$." },
        { "text": "$[0,\\infty)$", "why": "Applied $x\\geq0$ but forgot the denominator is zero at $x=4$." }
      ],
      "solution_text": "The radicand needs $x\\geq0$.\nThe denominator needs $x-4\\neq0$, so $x\\neq4$.\nCombining both: $x\\geq0$ and $x\\neq4$.\nDomain: $[0,4)\\cup(4,\\infty)$"
    },
    {
      "id": "q4",
      "question_text": "Find the natural domain of $f(x)=x^3$.",
