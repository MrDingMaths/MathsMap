{
  "skillId": "algebraic-notation",
  "atomType": "T",
  "theory": {
        "intro": "Algebra has agreed conventions for writing expressions shortly: drop the $\\times$ sign, write division as a fraction, and write repeated multiplication as a power.",
        "facts": [
          "**Drop the $\\times$ sign** when multiplying: $3 \\times x = 3x$ and $a \\times b = ab$.",
          "**Write the number first**, then the pronumerals: $x \\times 6 = 6x$.",
          "**Hide a coefficient of $1$ or $-1$**: $1 \\times x = x$ and $-1 \\times x = -x$.",
          "**Repeated multiplication** of the same pronumeral becomes a power: $x \\times x = x^2$ and $x \\times x \\times x = x^3$.",
          "**Show division as a fraction**: $x \\div 3 = \\frac{x}{3}$ and $7 \\div a = \\frac{7}{a}$."
        ],
        "steps": [
          "Drop the $\\times$ sign.",
          "Number first.",
          "Hide the 1.",
          "Repeats to powers.",
          "Division to fraction."
        ]
      },
  "practice": {
    "foundation": [
      {
        "question_text": "Write $4 \\times m$ using algebraic conventions.",
        "structure": "drop-times-sign",
        "solution_text": "$4 \\times m$\n$= 4m$"
      },
      {
        "question_text": "Write $h \\times z$ using algebraic conventions.",
        "structure": "drop-times-sign",
        "solution_text": "$h \\times z$\n$= hz$"
      },
      {
        "question_text": "Write $t \\times 3$ using algebraic conventions.",
        "structure": "number-before-pronumerals",
        "solution_text": "$t \\times 3$\n$= 3t$"
      },
      {
        "question_text": "Write $-1 \\times y$ using algebraic conventions.",
        "structure": "hide-one",
        "solution_text": "$-1 \\times y$\n$= -y$"
      },
      {
        "question_text": "Write $w \\times w$ using algebraic conventions.",
        "structure": "repeated-to-power",
        "solution_text": "$w \\times w$\n$= w^2$"
      },
      {
        "question_text": "Write $x \\div 3$ using algebraic conventions.",
        "structure": "division-as-fraction",
        "solution_text": "$x \\div 3$\n$= \\frac{x}{3}$"
      }
    ],
    "development": [
      {
        "question_text": "Write $x \\times 5 \\times y$ using algebraic conventions.",
        "structure": "number-before-pronumerals",
        "solution_text": "$x \\times 5 \\times y$\n$= 5xy$"
      },
      {
        "question_text": "Write $y \\times 6 \\times y$ using algebraic conventions.",
        "structure": "combined-conventions",
        "solution_text": "$y \\times 6 \\times y$\n$= 6y \\times y$\n$= 6y^2$"
      },
      {
        "question_text": "Write $2x \\div 13$ using algebraic conventions.",
        "structure": "division-as-fraction",
        "solution_text": "$2x \\div 13$\n$= \\frac{2x}{13}$"
      },
      {
        "question_text": "Write $3abc$ in full, showing every multiplication sign.",
        "structure": "expand-convention",
        "solution_text": "$3abc$\n$= 3 \\times a \\times b \\times c$"
      },
      {
        "question_text": "Write $v^2$ in full, showing the multiplication sign.",
        "structure": "expand-convention",
        "solution_text": "$v^2$\n$= v \\times v$"
      }
    ],
    "mastery": [
      {
        "question_text": "Write $x \\times 7 \\times x \\times y$ using algebraic conventions.",
        "structure": "combined-conventions",
        "solution_text": "$x \\times 7 \\times x \\times y$\n$= 7 \\times x \\times x \\times y$\n$= 7x^2y$"
      },
      {
        "question_text": "Write $a \\times b \\times a \\times a$ using algebraic conventions.",
        "structure": "repeated-to-power",
        "solution_text": "$a \\times b \\times a \\times a$\n$= a \\times a \\times a \\times b$\n$= a^3b$"
      },
      {
        "question_text": "Write $c \\times c \\div 4$ using algebraic conventions.",
        "structure": "combined-conventions",
        "solution_text": "$c \\times c \\div 4$\n$= c^2 \\div 4$\n$= \\frac{c^2}{4}$"
      }
    ]
  }
}
