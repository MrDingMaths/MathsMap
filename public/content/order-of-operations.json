{
  "skillId": "order-of-operations",
  "atomType": "R",
  "theory": {
    "intro": "When an expression has several operations, everyone agrees to work them out in a fixed order so the answer is the same.",
    "facts": [
      "Do **brackets** first, then **multiplication and division** (left to right), then **addition and subtraction** (left to right).",
      "Multiplication and division have **equal** priority — work left to right.",
      "Without the agreed order, the same expression could give different answers."
    ],
    "steps": [
      "Work out anything inside brackets.",
      "Do all $\\times$ and $\\div$ from left to right.",
      "Do all $+$ and $-$ from left to right."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "Evaluate $7+3 \\times 4$.",
        "structure": "addition-and-multiplication",
        "solution_text": "$7+3 \\times 4$\n$=7+12$\n$=19$"
      },
      {
        "question_text": "Evaluate $30-18 \\div 3$.",
        "structure": "division-between-add-subtract",
        "solution_text": "$30-18 \\div 3$\n$=30-6$\n$=24$"
      },
      {
        "question_text": "Evaluate $(8+4) \\times 3$.",
        "structure": "brackets-then-multiplication",
        "solution_text": "$(8+4) \\times 3$\n$=12 \\times 3$\n$=36$"
      },
      {
        "question_text": "Evaluate $48 \\div 6 \\times 5$ from left to right.",
        "structure": "equal-priority-left-to-right",
        "solution_text": "$48 \\div 6 \\times 5$\n$=8 \\times 5$\n$=40$"
      },
      {
        "question_text": "Evaluate $24 \\div 4+7$.",
        "structure": "division-between-add-subtract",
        "solution_text": "$24 \\div 4+7$\n$=6+7$\n$=13$"
      },
      {
        "question_text": "Evaluate $20-6+9$ from left to right.",
        "structure": "equal-priority-left-to-right",
        "solution_text": "$20-6+9$\n$=14+9$\n$=23$"
      }
    ],
    "development": [
      {
        "question_text": "Evaluate $50-6 \\times 7+4$.",
        "structure": "addition-and-multiplication",
        "solution_text": "$50-6 \\times 7+4$\n$=50-42+4$\n$=8+4$\n$=12$"
      },
      {
        "question_text": "Evaluate $72 \\div 8 \\times 3-5$.",
        "structure": "equal-priority-left-to-right",
        "solution_text": "$72 \\div 8 \\times 3-5$\n$=9 \\times 3-5$\n$=27-5$\n$=22$"
      },
      {
        "question_text": "Evaluate $4 \\times (15-7)+6$.",
        "structure": "brackets-then-multiplication",
        "solution_text": "$4 \\times (15-7)+6$\n$=4 \\times 8+6$\n$=32+6$\n$=38$"
      },
      {
        "question_text": "Evaluate $96 \\div (8+4) \\times 3$.",
        "structure": "brackets-then-multiplication",
        "solution_text": "$96 \\div (8+4) \\times 3$\n$=96 \\div 12 \\times 3$\n$=8 \\times 3$\n$=24$"
      },
      {
        "question_text": "Evaluate $18+42 \\div 7 \\times 2$.",
        "structure": "equal-priority-left-to-right",
        "solution_text": "$18+42 \\div 7 \\times 2$\n$=18+6 \\times 2$\n$=18+12$\n$=30$"
      },
      {
        "question_text": "Evaluate $100-36 \\div 6-8$.",
        "structure": "division-between-add-subtract",
        "solution_text": "$100-36 \\div 6-8$\n$=100-6-8$\n$=94-8$\n$=86$"
      }
    ],
    "mastery": [
      {
        "question_text": "Four coaches each carry $12$ balls, and a store room has another $17$ balls. Evaluate $4 \\times 12+17$ to find the total.",
        "structure": "real-life-priority-context",
        "solution_text": "$4 \\times 12+17$\n$=48+17$\n$=65$ balls"
      },
      {
        "question_text": "A club has $90$ badges in its supply. It will award $48$ badges equally among $6$ teams. One team collects its share. Evaluate $90-48 \\div 6$ to find how many badges remain in the supply.",
        "structure": "real-life-priority-context",
        "solution_text": "$90-48 \\div 6$\n$=90-8$\n$=82$ badges"
      },
      {
        "question_text": "Evaluate $144 \\div 12 \\times (9-4)+7$.",
        "structure": "brackets-then-multiplication",
        "solution_text": "$144 \\div 12 \\times (9-4)+7$\n$=144 \\div 12 \\times 5+7$\n$=12 \\times 5+7$\n$=60+7$\n$=67$"
      }
