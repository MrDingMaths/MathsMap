{
  "skillId": "simplify-ratios-different-units",
  "atomType": "R",
  "theory": {
        "intro": "A ratio can only compare quantities measured in the **same unit**. Convert to the same unit first — choose the smaller one so the numbers stay whole — then simplify. The units are then dropped, so a simplified ratio has no units.",
        "facts": [
          "$1$ cm $=10$ mm, $1$ m $=100$ cm, $1$ km $=1000$ m.",
          "$1$ kg $=1000$ g, $1$ L $=1000$ mL, $\\$1=100$c.",
          "$1$ h $=60$ min, $1$ day $=24$ h, $1$ fortnight $=14$ days.",
          "$12$ cm $:3$ mm is **not** $4:1$ — converting first gives $120$ mm $:3$ mm $=40:1$."
        ],
        "steps": [
          "Choose the smaller of the units given.",
          "Convert every quantity to that unit.",
          "Divide every part by their HCF."
        ]
      },
  "practice": {
    "foundation": [
      {
        "question_text": "Simplify $24$ mm $:3$ cm.",
        "structure": "length-units",
        "solution_text": "$24\\text{ mm}:3\\text{ cm}$\n$=24\\text{ mm}:30\\text{ mm}$\n$=(24\\div6):(30\\div6)$\n$=4:5$"
      },
      {
        "question_text": "Simplify $400$ mL $:1$ L.",
        "structure": "mass-capacity-units",
        "solution_text": "$400\\text{ mL}:1\\text{ L}$\n$=400\\text{ mL}:1000\\text{ mL}$\n$=(400\\div200):(1000\\div200)$\n$=2:5$"
      },
      {
        "question_text": "Simplify $45$ min $:2$ h.",
        "structure": "time-units",
        "solution_text": "$45\\text{ min}:2\\text{ h}$\n$=45\\text{ min}:120\\text{ min}$\n$=(45\\div15):(120\\div15)$\n$=3:8$"
      },
      {
        "question_text": "Simplify $3$ kg $:450$ g.",
        "structure": "mass-capacity-units",
        "solution_text": "$3\\text{ kg}:450\\text{ g}$\n$=3000\\text{ g}:450\\text{ g}$\n$=(3000\\div150):(450\\div150)$\n$=20:3$"
      },
      {
        "question_text": "Simplify $80$c $:\\$8$.",
        "structure": "money-units",
        "solution_text": "$80\\text{c}:\\$8$\n$=80\\text{c}:800\\text{c}$\n$=(80\\div80):(800\\div80)$\n$=1:10$"
      },
      {
        "question_text": "Simplify $120$ m $:1$ km.",
        "structure": "length-units",
        "solution_text": "$120\\text{ m}:1\\text{ km}$\n$=120\\text{ m}:1000\\text{ m}$\n$=(120\\div40):(1000\\div40)$\n$=3:25$"
      },
      {
        "question_text": "Simplify $4$ hours $:50$ min.",
        "structure": "larger-unit-first",
        "solution_text": "$4\\text{ h}:50\\text{ min}$\n$=240\\text{ min}:50\\text{ min}$\n$=(240\\div10):(50\\div10)$\n$=24:5$"
      }
    ],
    "development": [
      {
        "question_text": "Simplify $2.5$ km $:500$ m.",
        "structure": "length-units",
        "solution_text": "$2.5\\text{ km}:500\\text{ m}$\n$=2500\\text{ m}:500\\text{ m}$\n$=(2500\\div500):(500\\div500)$\n$=5:1$"
      },
      {
        "question_text": "Simplify $\\$3.50:30$c.",
        "structure": "money-units",
        "solution_text": "$\\$3.50:30\\text{c}$\n$=350\\text{c}:30\\text{c}$\n$=(350\\div10):(30\\div10)$\n$=35:3$"
      },
      {
        "question_text": "Simplify $0.7$ kg $:800$ g.",
        "structure": "mass-capacity-units",
        "solution_text": "$0.7\\text{ kg}:800\\text{ g}$\n$=700\\text{ g}:800\\text{ g}$\n$=(700\\div100):(800\\div100)$\n$=7:8$"
      },
      {
        "question_text": "Simplify $3$ weeks $:1$ fortnight.",
        "structure": "time-units",
        "solution_text": "$3\\text{ weeks}:1\\text{ fortnight}$\n$=21\\text{ days}:14\\text{ days}$\n$=(21\\div7):(14\\div7)$\n$=3:2$"
      },
      {
        "question_text": "Simplify $40$ cm $:2$ m $:50$ cm.",
        "structure": "three-part-units",
        "solution_text": "$40\\text{ cm}:2\\text{ m}:50\\text{ cm}$\n$=40\\text{ cm}:200\\text{ cm}:50\\text{ cm}$\n$=(40\\div10):(200\\div10):(50\\div10)$\n$=4:20:5$"
      },
      {
        "question_text": "For every $\\$1$ Ali has, Cathy has $50$ cents. Explain why the ratio of Ali's money to Cathy's is **not** $1:50$, then write it in simplest form.",
        "structure": "diagnose-unit-error",
        "solution_text": "$\\$1$ and $50$c are measured in different units, so $1:50$ compares dollars with cents.\n$\\$1:50\\text{c}=100\\text{c}:50\\text{c}$\n$=(100\\div50):(50\\div50)$\n$=2:1$"
      }
    ],
    "mastery": [
      {
        "question_text": "Fred simplified $12$ cm $:3$ mm to $4:1$. Explain his mistake and give the correct simplified ratio.",
        "structure": "diagnose-unit-error",
        "solution_text": "Fred divided $12$ by $3$ without converting, so he compared centimetres with millimetres.\n$12\\text{ cm}:3\\text{ mm}=120\\text{ mm}:3\\text{ mm}$\n$=(120\\div3):(3\\div3)$\n$=40:1$"
      },
      {
        "question_text": "Simplify $15$ cm $:0.6$ m $:30$ mm.",
        "structure": "three-part-units",
        "solution_text": "$15\\text{ cm}:0.6\\text{ m}:30\\text{ mm}$\n$=150\\text{ mm}:600\\text{ mm}:30\\text{ mm}$\n$=(150\\div30):(600\\div30):(30\\div30)$\n$=5:20:1$"
      },
      {
        "question_text": "Simplify $6$ min $:2.1$ h.",
        "structure": "time-units",
        "solution_text": "$6\\text{ min}:2.1\\text{ h}$\n$=6\\text{ min}:126\\text{ min}$\n$=(6\\div6):(126\\div6)$\n$=1:21$"
      }
    ]
  }
}
