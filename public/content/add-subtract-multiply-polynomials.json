      },
      {
        "question_text": "Expand and simplify $(x^{2}-2x+5)(x^{2}+4)$.",
        "solution_text": "$(x^{2}-2x+5)(x^{2}+4)$\n$=x^{2}(x^{2}+4)-2x(x^{2}+4)+5(x^{2}+4)$\n$=x^{4}+4x^{2}-2x^{3}-8x+5x^{2}+20$\n$=x^{4}-2x^{3}+9x^{2}-8x+20$"
      },
      {
        "question_text": "$P(x)=x^{2}+x-3$ and $Q(x)=2x-5$. Find $P(x)\\times Q(x)$.",
        "solution_text": "$P(x)\\times Q(x)$\n$=(x^{2}+x-3)(2x-5)$\n$=x^{2}(2x-5)+x(2x-5)-3(2x-5)$\n$=2x^{3}-5x^{2}+2x^{2}-5x-6x+15$\n$=2x^{3}-3x^{2}-11x+15$"
      }
    ],
