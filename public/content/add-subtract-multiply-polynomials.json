{
  "skillId": "add-subtract-multiply-polynomials",
  "atomType": "R",
  "theory": {
    "intro": "Polynomials are added and subtracted by collecting like terms, and multiplied by distributing every term of one polynomial onto every term of the other. Writing each polynomial in brackets first protects the signs.",
    "facts": [
      "To find $P(x)+Q(x)$ or $P(x)-Q(x)$, write each polynomial in brackets before combining.",
      "Subtracting a polynomial changes the sign of **every** term: $-(2x^{2}+x-1)=-2x^{2}-x+1$.",
      "To find $P(x)\\times Q(x)$, multiply every term of $P(x)$ by every term of $Q(x)$, using the index law $x^{m}\\times x^{n}=x^{m+n}$.",
      "A multiple such as $2P(x)$ means every term of $P(x)$ is multiplied by $2$.",
      "Finish by collecting like terms and writing the answer in descending powers of $x$."
    ],
    "steps": [
      "Write each polynomial in brackets.",
      "Expand, changing every sign when subtracting.",
      "Collect like terms."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "$P(x)=2x^{2}+3x-1$ and $Q(x)=x^{2}-4x+6$. Find $P(x)+Q(x)$.",
        "solution_text": "$P(x)+Q(x)$\n$=(2x^{2}+3x-1)+(x^{2}-4x+6)$\n$=3x^{2}-x+5$"
      },
      {
        "question_text": "$P(x)=2x^{2}+3x-1$ and $Q(x)=x^{2}-4x+6$. Find $P(x)-Q(x)$.",
        "solution_text": "$P(x)-Q(x)$\n$=(2x^{2}+3x-1)-(x^{2}-4x+6)$\n$=2x^{2}+3x-1-x^{2}+4x-6$\n$=x^{2}+7x-7$"
      },
      {
        "question_text": "$P(x)=x^{3}+2x^{2}-5$ and $Q(x)=3x^{3}-x+2$. Find $P(x)+Q(x)$.",
        "solution_text": "$P(x)+Q(x)$\n$=(x^{3}+2x^{2}-5)+(3x^{3}-x+2)$\n$=4x^{3}+2x^{2}-x-3$"
      },
      {
        "question_text": "$P(x)=4x^{2}-x+3$ and $Q(x)=4x^{2}+5x-2$. Find $P(x)-Q(x)$.",
        "solution_text": "$P(x)-Q(x)$\n$=(4x^{2}-x+3)-(4x^{2}+5x-2)$\n$=4x^{2}-x+3-4x^{2}-5x+2$\n$=-6x+5$"
      },
      {
        "question_text": "$P(x)=5x^{2}+2x$ and $Q(x)=x^{3}-3x^{2}$. Find $Q(x)-P(x)$.",
        "solution_text": "$Q(x)-P(x)$\n$=(x^{3}-3x^{2})-(5x^{2}+2x)$\n$=x^{3}-3x^{2}-5x^{2}-2x$\n$=x^{3}-8x^{2}-2x$"
      },
      {
        "question_text": "Expand and simplify $(x+2)(x^{2}+3x+4)$.",
        "solution_text": "$(x+2)(x^{2}+3x+4)$\n$=x(x^{2}+3x+4)+2(x^{2}+3x+4)$\n$=x^{3}+3x^{2}+4x+2x^{2}+6x+8$\n$=x^{3}+5x^{2}+10x+8$"
      },
      {
        "question_text": "Expand and simplify $(x-3)(x^{2}+2x-1)$.",
        "solution_text": "$(x-3)(x^{2}+2x-1)$\n$=x(x^{2}+2x-1)-3(x^{2}+2x-1)$\n$=x^{3}+2x^{2}-x-3x^{2}-6x+3$\n$=x^{3}-x^{2}-7x+3$"
      }
    ],
    "development": [
      {
        "question_text": "$P(x)=x^{2}-3x+4$ and $Q(x)=2x^{3}-x^{2}+x$. Find $2P(x)+Q(x)$.",
        "solution_text": "$2P(x)+Q(x)$\n$=2(x^{2}-3x+4)+(2x^{3}-x^{2}+x)$\n$=2x^{2}-6x+8+2x^{3}-x^{2}+x$\n$=2x^{3}+x^{2}-5x+8$"
      },
      {
        "question_text": "$P(x)=2x^{2}+x-1$ and $Q(x)=x^{2}-4x+3$. Find $3P(x)-2Q(x)$.",
        "solution_text": "$3P(x)-2Q(x)$\n$=3(2x^{2}+x-1)-2(x^{2}-4x+3)$\n$=6x^{2}+3x-3-2x^{2}+8x-6$\n$=4x^{2}+11x-9$"
      },
      {
        "question_text": "$P(x)=x^{4}-2x^{2}+7$ and $Q(x)=3x^{2}-x-9$. Find $P(x)+Q(x)$.",
        "solution_text": "$P(x)+Q(x)$\n$=(x^{4}-2x^{2}+7)+(3x^{2}-x-9)$\n$=x^{4}+x^{2}-x-2$"
      },
      {
        "question_text": "Expand and simplify $(2x-1)(3x^{2}+x-4)$.",
