      {
        "question_text": "$P(x)=2x^{2}+3x-1$ and $Q(x)=x^{2}-4x+6$.\nFind $P(x)+Q(x)$.",
        "structure": "add-polynomials",
        "solution_text": "$P(x)+Q(x)$\n$=(2x^{2}+3x-1)+(x^{2}-4x+6)$\n$=3x^{2}-x+5$"
      },
      {
        "question_text": "$P(x)=2x^{2}+3x-1$ and $Q(x)=x^{2}-4x+6$.\nFind $P(x)-Q(x)$.",
        "structure": "subtract-polynomials",
        "solution_text": "$P(x)-Q(x)$\n$=(2x^{2}+3x-1)-(x^{2}-4x+6)$\n$=2x^{2}+3x-1-x^{2}+4x-6$\n$=x^{2}+7x-7$"
      },
      {
        "question_text": "$P(x)=x^{3}+2x^{2}-5$ and $Q(x)=3x^{3}-x+2$.\nFind $P(x)+Q(x)$.",
        "structure": "add-polynomials",
        "solution_text": "$P(x)+Q(x)$\n$=(x^{3}+2x^{2}-5)+(3x^{3}-x+2)$\n$=4x^{3}+2x^{2}-x-3$"
      },
      {
        "question_text": "$P(x)=4x^{2}-x+3$ and $Q(x)=4x^{2}+5x-2$.\nFind $P(x)-Q(x)$.",
        "structure": "subtract-polynomials",
        "solution_text": "$P(x)-Q(x)$\n$=(4x^{2}-x+3)-(4x^{2}+5x-2)$\n$=4x^{2}-x+3-4x^{2}-5x+2$\n$=-6x+5$"
      },
      {
        "question_text": "$P(x)=5x^{2}+2x$ and $Q(x)=x^{3}-3x^{2}$.\nFind $Q(x)-P(x)$.",
