    "development": [
      {
        "question_text": "$P(x)=x^{2}-3x+4$ and $Q(x)=2x^{3}-x^{2}+x$.\nFind $2P(x)+Q(x)$.",
        "structure": "scalar-combination",
        "solution_text": "$2P(x)+Q(x)$\n$=2(x^{2}-3x+4)+(2x^{3}-x^{2}+x)$\n$=2x^{2}-6x+8+2x^{3}-x^{2}+x$\n$=2x^{3}+x^{2}-5x+8$"
      },
      {
        "question_text": "$P(x)=2x^{2}+x-1$ and $Q(x)=x^{2}-4x+3$.\nFind $3P(x)-2Q(x)$.",
        "structure": "scalar-combination",
        "solution_text": "$3P(x)-2Q(x)$\n$=3(2x^{2}+x-1)-2(x^{2}-4x+3)$\n$=6x^{2}+3x-3-2x^{2}+8x-6$\n$=4x^{2}+11x-9$"
      },
      {
        "question_text": "$P(x)=x^{4}-2x^{2}+7$ and $Q(x)=3x^{2}-x-9$.\nFind $P(x)+Q(x)$.",
        "structure": "add-polynomials",
        "solution_text": "$P(x)+Q(x)$\n$=(x^{4}-2x^{2}+7)+(3x^{2}-x-9)$\n$=x^{4}+x^{2}-x-2$"
