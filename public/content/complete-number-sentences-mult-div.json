{
  "skillId": "complete-number-sentences-mult-div",
  "atomType": "R",
  "theory": {
"intro": "A number sentence with a missing number can be completed by working out what value makes both sides equal.",
"facts": [
      "The $=$ sign means both sides have the **same value**.",
      "To find a missing factor, **divide**; to find a missing dividend or product, multiply.",
      "Always check by substituting your answer back into the sentence."
    ],
"steps": [
      "Identify which number is missing and which operation links the numbers.",
      "Use the inverse operation to find the missing value.",
      "Check the sentence balances."
    ],
"workedExamples": [
  {
    "question_text": "Find $\\square$ in each number sentence.\n(a) $6\\times\\square=4\\times27$\n(b) $\\square\\div7=11+2$\n(c) $168\\div\\square=9+5$",
    "solution_text": "(a) $4\\times27=108$.\n$\\square=108\\div6=18$.\nCheck: $6\\times18=108=4\\times27$.\n(b) $11+2=13$.\n$\\square=13\\times7=91$.\nCheck: $91\\div7=13=11+2$.\n(c) $9+5=14$.\n$\\square=168\\div14=12$.\nCheck: $168\\div12=14=9+5$."
  },
  {
    "question_text": "Complete each number sentence.\n(a) $9\\times8=\\square+25$\n(b) $84\\div3=57-\\square$",
    "solution_text": "(a) $9\\times8=72$.\n$\\square=72-25=47$.\nCheck: $47+25=72=9\\times8$.\n(b) $84\\div3=28$.\n$\\square=57-28=29$.\nCheck: $57-29=28=84\\div3$."
  },
  {
    "question_text": "Find $\\square$ and check each sentence.\n(a) $5\\times\\square+13=4\\times22$\n(b) $350\\div\\square-7=2\\times14$",
    "solution_text": "(a) $4\\times22=88$.\n$5\\times\\square=88-13=75$.\n$\\square=75\\div5=15$.\nCheck: $5\\times15+13=75+13=88$.\n(b) $2\\times14=28$.\n$350\\div\\square=28+7=35$.\n$\\square=350\\div35=10$.\nCheck: $350\\div10-7=35-7=28$."
  }
]
},
