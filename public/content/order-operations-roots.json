      },
      {
        "question_text": "Evaluate $\\sqrt{9}\\times\\sqrt{64}\\div\\sqrt{36}$.",
        "solution_text": "$\\sqrt{9}\\times\\sqrt{64}\\div\\sqrt{36}$\n$=3\\times 8\\div 6$\n$=24\\div 6$\n$=4$"
      },
      {
        "question_text": "Evaluate $12+4\\times\\sqrt{9}$.",
        "solution_text": "$12+4\\times\\sqrt{9}$\n$=12+4\\times 3$\n$=12+12$\n$=24$"
      }
