{
  "skillId": "order-operations-roots",
  "atomType": "R",
  "theory": {
    "intro": "The order of operations does not change when a root appears. A root sign carries **invisible brackets**, so everything underneath it is worked out first, and the root itself is then evaluated at the same stage as a power.",
    "facts": [
      "A root sign acts like a bracket: $\\sqrt{a+b}=\\sqrt{(a+b)}$, so add first and take the root afterwards.",
      "Roots and powers sit at the same stage, straight after brackets.",
      "A fraction bar is also a bracket: evaluate the numerator and the denominator before dividing.",
      "$\\sqrt{a+b}$ is not $\\sqrt{a}+\\sqrt{b}$: $\\sqrt{9+16}=5$, but $\\sqrt{9}+\\sqrt{16}=7$."
    ],
    "steps": [
      "Work out anything inside brackets, including everything under a root sign.",
      "Evaluate powers and roots.",
      "Do all $\\times$ and $\\div$ from left to right.",
      "Do all $+$ and $-$ from left to right."
    ]
  },
  "practice": {
    "foundation": [
      {
