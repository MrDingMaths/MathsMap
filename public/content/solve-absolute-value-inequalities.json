  "theory": {
    "intro": "Absolute value measures distance. Compare that distance with the stated bound.",
    "facts": [
      "For $a>0$, $|u|<a$ means $-a<u<a$.",
      "For $a>0$, $|u|>a$ means $u<-a$ or $u>a$.",
      "Non-strict inequalities include their boundary points.",
      "Absolute value is non-negative; check zero and negative bounds separately."
    ],
    "steps": [
      "Check the bound",
      "Write the interval or two cases",
      "Solve and mark endpoints"
    ],
