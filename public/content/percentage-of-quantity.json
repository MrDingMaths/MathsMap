{
  "skillId": "percentage-of-quantity",
  "atomType": "R",
  "theory": {
        "intro": "To find a percentage of a quantity, replace 'of' with $\\times$, turn the percentage into a decimal, then multiply. A percentage under $100\\%$ gives a smaller answer; over $100\\%$ gives a larger one.",
        "facts": [
          "In mathematics, 'of' means multiply: $35\\%$ of $240$ means $35\\%\\times240$.",
          "Convert a percentage to a decimal by dividing by $100$: $35\\%=0.35$, $8\\%=0.08$, $2.7\\%=0.027$.",
          "$x\\%$ of $y$ equals $y\\%$ of $x$, because both are $\\dfrac{xy}{100}$."
        ],
        "steps": [
          "Change 'of' to $\\times$.",
          "Convert the percentage to a decimal by dividing by $100$.",
          "Multiply to find the answer."
        ]
      },
  "practice": {
    "foundation": [
      {
        "question_text": "Find $37\\%$ of $150$.",
        "structure": "percent-under-100",
        "solution_text": "$37\\%\\times150$\n$=0.37\\times150$\n$=55.5$"
      },
      {
        "question_text": "Find $8\\%$ of $350$.",
        "structure": "percent-under-100",
        "solution_text": "$8\\%\\times350$\n$=0.08\\times350$\n$=28$"
      },
      {
        "question_text": "Find $68\\%$ of $350$.",
        "structure": "percent-under-100",
        "solution_text": "$68\\%\\times350$\n$=0.68\\times350$\n$=238$"
      },
      {
        "question_text": "Find $9\\%$ of $140$.",
        "structure": "percent-under-100",
        "solution_text": "$9\\%\\times140$\n$=0.09\\times140$\n$=12.6$"
      }
    ],
    "development": [
      {
        "question_text": "Find $115\\%$ of $60$.",
        "structure": "percent-over-100",
        "solution_text": "$115\\%\\times60$\n$=1.15\\times60$\n$=69$"
      },
      {
        "question_text": "Find $2.7\\%$ of $300$.",
        "structure": "small-or-decimal-percent",
        "solution_text": "$2.7\\%\\times300$\n$=0.027\\times300$\n$=8.1$"
      },
      {
        "question_text": "A school has $850$ students.\n$64\\%$ of them travel by bus.\nHow many students travel by bus?",
        "structure": "word-problem",
        "solution_text": "$64\\%\\times850$\n$=0.64\\times850$\n$=544$ students"
      },
      {
        "question_text": "The human body is about $70\\%$ water.\nA student has a mass of $61$ kg.\nHow much of this is water?",
        "structure": "word-problem",
        "solution_text": "$70\\%\\times61$\n$=0.7\\times61$\n$=42.7$ kg"
      },
      {
        "question_text": "Find $4.2\\%$ of $310$.",
        "structure": "small-or-decimal-percent",
        "solution_text": "$4.2\\%\\times310$\n$=0.042\\times310$\n$=13.02$"
      }
    ],
    "mastery": [
      {
        "question_text": "Which is greater: $15\\%$ of $80$, or $80\\%$ of $15$?",
        "structure": "commutative-percent",
        "solution_text": "$15\\%\\times80=0.15\\times80=12$\n$80\\%\\times15=0.8\\times15=12$\nThey are equal; both are $12$."
      },
      {
        "question_text": "Sven's height is $120\\%$ of Huda's height.\nEmily's height is $110\\%$ of Sven's height.\nHuda is $115$ cm tall.\nHow tall is Emily?",
        "structure": "chained-percentage-application",
        "solution_text": "$120\\%\\times115=1.2\\times115=138$\n$110\\%\\times138=1.1\\times138$\n$=151.8$ cm"
      },
      {
        "question_text": "In a survey of $450$ people, $38\\%$ preferred coffee and $42\\%$ preferred tea.\nThe rest preferred neither.\nHow many people preferred neither?",
        "structure": "remaining-percentage-word-problem",
        "solution_text": "$100\\%-38\\%-42\\%=20\\%$\n$20\\%\\times450=0.2\\times450$\n$=90$ people"
      }
    ]
  }
