{
  "skillId": "use-grouping-symbols",
  "atomType": "R",
  "theory": {
    "intro": "Brackets (grouping symbols) tell you to work out part of an expression first, even ahead of multiplication and division.",
    "facts": [
      "Whatever is inside **brackets** is calculated **first**.",
      "Brackets can change the answer: $2 \\times (3 + 4) \\neq 2 \\times 3 + 4$.",
      "Insert brackets to force an addition or subtraction to happen before a multiplication."
    ],
    "steps": [
      "Evaluate inside the brackets first.",
      "Then apply $\\times$ and $\\div$, then $+$ and $-$.",
      "To insert brackets, decide which part must be done first and enclose it."
    ]
  },
  "practice": {
    "foundation": [
      {"question_text":"Insert one pair of brackets to make $2+4 \\times 7=42$ true.","solution_text":"$(2+4) \\times 7$\n$=6 \\times 7$\n$=42$"},
      {"question_text":"Insert one pair of brackets to make $3+5 \\times 6=48$ true.","solution_text":"$(3+5) \\times 6$\n$=8 \\times 6$\n$=48$"},
      {"question_text":"Insert brackets so $20-8 \\div 4=3$ is true.","solution_text":"$(20-8) \\div 4$\n$=12 \\div 4$\n$=3$"},
      {"question_text":"Place brackets to make $6 \\times 5-2=18$ true.","solution_text":"$6 \\times (5-2)$\n$=6 \\times 3$\n$=18$"},
      {"question_text":"Insert one pair of brackets so $24 \\div 6+2=3$ is true.","solution_text":"$24 \\div (6+2)$\n$=24 \\div 8$\n$=3$"},
      {"question_text":"Place brackets to make $18-3 \\times 4=60$ true.","solution_text":"$(18-3) \\times 4$\n$=15 \\times 4$\n$=60$"}
    ],
    "development": [
      {"question_text":"Insert one pair of brackets to make $8+4 \\times 3-2=34$ true.","solution_text":"$(8+4) \\times 3-2$\n$=12 \\times 3-2$\n$=36-2$\n$=34$"},
      {"question_text":"Place brackets so $72 \\div 5+3=9$ is true.","solution_text":"$72 \\div (5+3)$\n$=72 \\div 8$\n$=9$"},
      {"question_text":"Insert brackets to make $7 \\times 12-5+4=53$ true.","solution_text":"$7 \\times (12-5)+4$\n$=7 \\times 7+4$\n$=49+4$\n$=53$"},
      {"question_text":"Place one pair of brackets to make $5+7 \\times 4-3=45$ true.","solution_text":"$(5+7) \\times 4-3$\n$=12 \\times 4-3$\n$=48-3$\n$=45$"},
      {"question_text":"Insert brackets so $96 \\div 10-2+6=18$ is true.","solution_text":"$96 \\div (10-2)+6$\n$=96 \\div 8+6$\n$=12+6$\n$=18$"},
      {"question_text":"Place brackets to make $9 \\times 6+2-5=67$ true.","solution_text":"$9 \\times (6+2)-5$\n$=9 \\times 8-5$\n$=72-5$\n$=67$"}
    ],
    "mastery": [
      {"question_text":"Insert one pair of brackets to make $120 \\div 8+7 \\times 3=24$ true.","solution_text":"$120 \\div (8+7) \\times 3$\n$=120 \\div 15 \\times 3$\n$=8 \\times 3$\n$=24$"},
      {"question_text":"A game score is written $50-6+4 \\times 5$. Insert one pair of brackets so the score is $0$.","solution_text":"$50-(6+4) \\times 5$\n$=50-10 \\times 5$\n$=50-50$\n$=0$"},
      {"question_text":"Insert one pair of brackets to make $84 \\div 9-2+5=17$ true.","solution_text":"$84 \\div (9-2)+5$\n$=84 \\div 7+5$\n$=12+5$\n$=17$"}
    ]
  }
}
