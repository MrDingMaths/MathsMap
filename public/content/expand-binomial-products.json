      {
        "question_text": "Show by expansion that $(x+a)(x+b)=x^2+(a+b)x+ab$, and hence write the expansion of $(x+13)(x+7)$ without multiplying out the four products.",
        "structure": "general-identity",
        "solution_text": "$(x+a)(x+b)$\n$=x^2+bx+ax+ab$\n$=x^2+(a+b)x+ab$\nWith $a=13$ and $b=7$, the sum is $20$ and the product is $91$.\n$(x+13)(x+7)=x^2+20x+91$"
      },
      {
        "question_text": "The expansion of $(3x+m)(x+2)$ is $3x^2+11x+10$. Find the value of $m$.",
        "structure": "find-unknown-coefficient",
        "solution_text": "$(3x+m)(x+2)$\n$=3x^2+6x+mx+2m$\n$=3x^2+(6+m)x+2m$\nMatching the constant terms, $2m=10$\n$m=5$"
      }
