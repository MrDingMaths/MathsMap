{
  "skillId": "factorise-to-multiply",
  "atomType": "R",
  "theory": {
    "intro": "Breaking a number into factors lets you re-group a multiplication into easier steps. This uses the **associative property**.",
    "facts": [
      "You can multiply factors in **any order or grouping**: $a \\times b \\times c = (a \\times b) \\times c$.",
      "e.g. $12 \\times 25 = 3 \\times 4 \\times 25 = 3 \\times 100 = 300$.",
      "Look for factors that pair to make $10$, $100$ or another round number."
    ],
    "steps": [
      "Factorise one number to expose a helpful factor.",
      "Re-group so an easy product (like $\\times 100$) is formed.",
      "Multiply the remaining factors."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "Factorise $15$ to calculate $15 \\times 6$ mentally.",
        "structure": "factor-to-make-10",
        "solution_text": "$15 \\times 6$\n$=3 \\times 5 \\times 6$\n$=3 \\times 30$\n$=90$"
      },
      {
        "question_text": "Use $16=4 \\times 4$ to calculate $16 \\times 25$ mentally.",
        "structure": "factor-to-make-100",
        "solution_text": "$16 \\times 25$\n$=4 \\times 4 \\times 25$\n$=4 \\times 100$\n$=400$"
      },
      {
        "question_text": "Factorise $24$ to create a factor pair of $2 \\times 5$, then calculate $24 \\times 5$.",
        "structure": "factor-to-make-10",
        "solution_text": "$24 \\times 5$\n$=12 \\times 2 \\times 5$\n$=12 \\times 10$\n$=120$"
      },
      {
        "question_text": "Use a helpful factorisation to calculate $8 \\times 125$.",
        "structure": "factor-to-make-1000",
        "solution_text": "$8 \\times 125$\n$=2 \\times 4 \\times 125$\n$=2 \\times 500$\n$=1000$"
      },
      {
        "question_text": "Use $14=7 \\times 2$ to calculate $14 \\times 15$ mentally.",
        "structure": "factor-to-make-10",
        "solution_text": "$14 \\times 15$\n$=7 \\times 2 \\times 15$\n$=7 \\times 30$\n$=210$"
      },
      {
        "question_text": "Factorise $12$ to calculate $35 \\times 12$ mentally.",
        "structure": "factor-to-make-10",
        "solution_text": "$35 \\times 12$\n$=35 \\times 2 \\times 6$\n$=70 \\times 6$\n$=420$"
      }
    ],
    "development": [
      {
        "question_text": "Use $32=8 \\times 4$ to calculate $32 \\times 25$ mentally.",
        "structure": "factor-to-make-100",
        "solution_text": "$32 \\times 25$\n$=8 \\times 4 \\times 25$\n$=8 \\times 100$\n$=800$"
      },
      {
        "question_text": "Factorise $18$ to calculate $18 \\times 50$ mentally.",
