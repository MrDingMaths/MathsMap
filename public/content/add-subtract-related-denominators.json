{
  "skillId": "add-subtract-related-denominators",
  "atomType": "R",
  "theory": {
    "intro": "When one denominator divides into the other (like $4$ and $8$, or $3$ and $6$), rename the fractions so they share the **same** denominator, then add or subtract the numerators.",
    "facts": [
      "Related denominators: one is a multiple of the other, e.g. $\\tfrac{1}{4} = \\tfrac{2}{8}$ because $4 \\times 2 = 8$.",
      "Rename the fraction with the **smaller** denominator to match the larger one.",
      "Once denominators match, **add or subtract the numerators** and keep the denominator the same."
    ],
    "steps": [
      "Find the larger denominator — it becomes the common denominator.",
      "Rename the other fraction as an equivalent fraction over that denominator.",
      "Add or subtract the numerators; simplify if you can."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "Calculate $\\frac{1}{4}+\\frac{3}{8}$.",
        "structure": "add-related",
        "solution_text": "$\\frac{1}{4}=\\frac{2}{8}$\n$\\frac{2}{8}+\\frac{3}{8}=\\frac{5}{8}$"
      },
      {
        "question_text": "Calculate $\\frac{5}{6}-\\frac{1}{3}$.",
        "structure": "subtract-related",
        "solution_text": "$\\frac{1}{3}=\\frac{2}{6}$\n$\\frac{5}{6}-\\frac{2}{6}=\\frac{3}{6}=\\frac{1}{2}$"
      },
      {
        "question_text": "Calculate $\\frac{2}{5}+\\frac{3}{10}$.",
        "structure": "add-related",
        "solution_text": "$\\frac{2}{5}=\\frac{4}{10}$\n$\\frac{4}{10}+\\frac{3}{10}=\\frac{7}{10}$"
      },
      {
        "question_text": "Calculate $\\frac{7}{8}-\\frac{1}{4}$.",
        "structure": "subtract-related",
        "solution_text": "$\\frac{1}{4}=\\frac{2}{8}$\n$\\frac{7}{8}-\\frac{2}{8}=\\frac{5}{8}$"
      },
      {
        "question_text": "Complete: $\\frac{1}{2}+\\frac{\\square}{6}=\\frac{5}{6}$.",
        "structure": "missing-numerator-related",
        "solution_text": "$\\frac{1}{2}=\\frac{3}{6}$\n$3+\\square=5$\n$\\square=2$"
      },
      {
        "question_text": "Calculate and simplify $\\frac{3}{4}+\\frac{2}{8}$.",
        "structure": "add-related",
        "solution_text": "$\\frac{3}{4}=\\frac{6}{8}$\n$\\frac{6}{8}+\\frac{2}{8}=\\frac{8}{8}=1$"
      }
    ],
    "development": [
      {
