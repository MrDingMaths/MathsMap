        "structure": "improper-sum-related",
        "solution_text": "$\\frac{5}{6}=\\frac{10}{12}$\n$\\frac{10}{12}+\\frac{7}{12}=\\frac{17}{12}=1\\frac{5}{12}$"
      },
      {
        "question_text": "Calculate $\\frac{11}{15}-\\frac{2}{5}$.",
        "structure": "subtract-related",
        "solution_text": "$\\frac{2}{5}=\\frac{6}{15}$\n$\\frac{11}{15}-\\frac{6}{15}=\\frac{5}{15}=\\frac{1}{3}$"
      },
      {
        "question_text": "Find $x$: $\\frac{x}{10}+\\frac{1}{5}=\\frac{9}{10}$.",
        "structure": "missing-numerator-related",
        "solution_text": "$\\frac{1}{5}=\\frac{2}{10}$\n$x+2=9$\n$x=7$"
      },
      {
        "question_text": "Calculate $\\frac{3}{8}+\\frac{1}{2}-\\frac{1}{4}$.",
        "structure": "three-term-related",
        "solution_text": "$\\frac{1}{2}=\\frac{4}{8}$ and $\\frac{1}{4}=\\frac{2}{8}$\n$\\frac{3+4-2}{8}=\\frac{5}{8}$"
      },
      {
        "question_text": "Repair the working: $\\frac{2}{3}+\\frac{1}{6}=\\frac{3}{9}$.",
        "structure": "diagnose-conversion",
        "solution_text": "Rename thirds as sixths.\n$\\frac{2}{3}+\\frac{1}{6}=\\frac{4}{6}+\\frac{1}{6}=\\frac{5}{6}$"
      },
      {
        "question_text": "Which is greater: $\\frac{3}{4}+\\frac{1}{8}$ or $\\frac{5}{8}$?",
        "structure": "compare-sum-related",
        "solution_text": "$\\frac{3}{4}+\\frac{1}{8}=\\frac{6}{8}+\\frac{1}{8}=\\frac{7}{8}$\n$\\frac{7}{8}>\\frac{5}{8}$"
      }
