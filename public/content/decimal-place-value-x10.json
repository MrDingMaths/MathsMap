{
  "skillId": "decimal-place-value-x10",
  "atomType": "R",
  "theory": {
    "intro": "Multiplying or dividing a decimal by $10$ or $100$ moves every digit to a new place-value column.",
    "facts": [
      "$\\times 10$ makes each digit $10$ times bigger → digits shift **one place left**.",
      "$\\div 10$ (or $\\tfrac{1}{10}$ of) makes each digit $10$ times smaller → digits shift **one place right**.",
      "$\\times 100$ or $\\div 100$ shifts digits **two places**."
    ],
    "steps": [
      "Decide the direction: bigger (×) shifts left, smaller (÷) shifts right.",
      "Decide how many places: $10 \\to 1$ place, $100 \\to 2$ places.",
      "Insert zeros where a place would otherwise be empty."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "Find $10 \\times 3.47$.",
        "structure": "multiply-by-10",
        "solution_text": "$3.47 \\times 10$\n$= 34.7$"
      },
      {
        "question_text": "Find $100 \\times 0.062$.",
        "structure": "multiply-by-100",
        "solution_text": "$0.062 \\times 100$\n$= 6.2$"
      },
      {
        "question_text": "Find $\\tfrac{1}{10}$ of $8.5$.",
        "structure": "one-tenth-of",
        "solution_text": "$8.5 \\div 10$\n$= 0.85$"
      },
      {
        "question_text": "Find $\\tfrac{1}{100}$ of $46.2$.",
        "structure": "one-hundredth-of",
        "solution_text": "$46.2 \\div 100$\n$= 0.462$"
      },
      {
        "question_text": "A lab sample has mass $0.009$ g. What is $10$ times this mass?",
        "structure": "multiply-by-10",
        "solution_text": "$0.009 \\text{ g} \\times 10$\n$= 0.09 \\text{ g}$"
      },
      {
        "question_text": "A strip is $2.04$ cm long.\nWhat is $100$ times this length?",
        "structure": "multiply-by-100",
        "solution_text": "$2.04 \\text{ cm} \\times 100$\n$= 204 \\text{ cm}$"
      }
    ],
    "development": [
      {
        "question_text": "Complete $0.735 \\times \\Box = 73.5$, where $\\Box$ is $10$ or $100$.",
        "structure": "identify-scale-factor",
        "solution_text": "$0.735 \\times 100$\n$= 73.5$\n$\\Box = 100$"
      },
      {
        "question_text": "Complete $64.8 \\div \\Box = 0.648$, where $\\Box$ is $10$ or $100$.",
        "structure": "identify-scale-factor",
        "solution_text": "$64.8 \\div 100$\n$= 0.648$\n$\\Box = 100$"
      },
      {
        "question_text": "How many times as large is $5.6$ as $0.056$?",
        "structure": "identify-scale-factor",
        "solution_text": "$0.056 \\times 100$\n$= 5.6$\n$5.6$ is $100$ times as large."
      },
      {
        "question_text": "Which is greater: $10$ times $0.407$ or $100$ times $0.041$?",
        "structure": "compare-scaled-values",
        "solution_text": "$0.407 \\times 10 = 4.07$\n$0.041 \\times 100 = 4.1$\n$100$ times $0.041$ is greater."
      },
      {
        "question_text": "A decimal becomes $7.09$ after it is multiplied by $10$.\nFind the original decimal.",
        "structure": "reverse-scale",
        "solution_text": "$7.09 \\div 10$\n$= 0.709$"
      },
      {
        "question_text": "A volume is $8.3$ L. Find one hundredth of the volume.",
        "structure": "one-hundredth-of",
        "solution_text": "$8.3 \\text{ L} \\div 100$\n$= 0.083 \\text{ L}$"
      }
    ],
    "mastery": [
      {
        "question_text": "Insert $10$, $100$, $\\tfrac{1}{10}$ or $\\tfrac{1}{100}$ to make $4.06 \\times \\Box = 0.0406$.",
        "structure": "identify-scale-factor",
        "solution_text": "$4.06 \\div 100$\n$= 0.0406$\n$\\Box = \\tfrac{1}{100}$"
      },
      {
        "question_text": "A number is $100$ times $0.038$ and also $10$ times another number.\nFind the other number.",
        "structure": "reverse-scale",
        "solution_text": "$0.038 \\times 100 = 3.8$\n$3.8 \\div 10 = 0.38$"
      },
      {
        "question_text": "Place a decimal point after the second digit in the first string, then place one decimal point in the second string so that the first number is $100$ times the second: $731$ and $731$.",
        "structure": "identify-scale-factor",
        "solution_text": "$73.1 = 100 \\times 0.731$\nOne solution is $73.1$ and $0.731$."
      }
    ]
  }
