{
  "skillId": "polynomial-notation-evaluate",
  "atomType": "R",
  "theory": {
    "intro": "$P(x)$ names a whole polynomial with one letter, just like function notation $f(x)$. Then $P(c)$ means the value of the polynomial when $x=c$.",
    "facts": [
      "$P(x)$ is read '$P$ of $x$'; different polynomials in the same question get different letters, such as $Q(x)$.",
      "$P(c)$ means the value of $P(x)$ when $x=c$: substitute $c$ for every $x$, in brackets.",
      "$P(0)$ always equals the constant term, because every term containing $x$ becomes $0$.",
      "Keep negative substitutions in brackets: $(-2)^{2}=4$ but $(-2)^{3}=-8$."
    ],
    "steps": [
      "Substitute the value for every $x$, in brackets.",
      "Evaluate using the order of operations."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "If $P(x)=x^{2}+4x-3$, evaluate $P(2)$.",
        "solution_text": "$P(2)$\n$=(2)^{2}+4(2)-3$\n$=4+8-3$\n$=9$"
      },
      {
        "question_text": "If $P(x)=2x^{3}-x+4$, evaluate $P(3)$.",
        "solution_text": "$P(3)$\n$=2(3)^{3}-(3)+4$\n$=54-3+4$\n$=55$"
      },
      {
        "question_text": "If $P(x)=x^{2}-6x+1$, evaluate $P(-2)$.",
        "solution_text": "$P(-2)$\n$=(-2)^{2}-6(-2)+1$\n$=4+12+1$\n$=17$"
      },
      {
        "question_text": "If $P(x)=3x^{2}+2x-8$, evaluate $P(0)$.",
        "solution_text": "$P(0)$\n$=3(0)^{2}+2(0)-8$\n$=0+0-8$\n$=-8$"
      },
      {
        "question_text": "If $P(x)=5-2x$, evaluate $P(7)$.",
        "solution_text": "$P(7)$\n$=5-2(7)$\n$=5-14$\n$=-9$"
      },
      {
        "question_text": "If $P(x)=x^{4}+x^{3}+x$, evaluate $P(-1)$.",
        "solution_text": "$P(-1)$\n$=(-1)^{4}+(-1)^{3}+(-1)$\n$=1-1-1$\n$=-1$"
      },
      {
        "question_text": "$Q(x)=x^{3}-2x$. Explain in words what $Q(4)$ means, then find its value.",
        "solution_text": "$Q(4)$ means the value of $Q(x)$ when $x=4$.\n$Q(4)=(4)^{3}-2(4)$\n$=64-8$\n$=56$"
      }
    ],
    "development": [
      {
        "question_text": "If $P(x)=4x^{2}+6x-1$, evaluate $P\\left(\\frac{1}{2}\\right)$.",
        "solution_text": "$P\\left(\\frac{1}{2}\\right)$\n$=4\\left(\\frac{1}{2}\\right)^{2}+6\\left(\\frac{1}{2}\\right)-1$\n$=1+3-1$\n$=3$"
      },
      {
        "question_text": "If $P(x)=(x+3)(x-5)$, evaluate $P(4)$.",
        "solution_text": "$P(4)$\n$=\\left((4)+3\\right)\\left((4)-5\\right)$\n$=(7)(-1)$\n$=-7$"
      },
      {
        "question_text": "If $Q(x)=x(x-2)(x+6)$, evaluate $Q(3)$.",
        "solution_text": "$Q(3)$\n$=(3)\\left((3)-2\\right)\\left((3)+6\\right)$\n$=(3)(1)(9)$\n$=27$"
      },
      {
        "question_text": "$P(x)=x^{2}+x$ and $Q(x)=3x-4$. Evaluate $P(3)+Q(2)$.",
        "solution_text": "$P(3)+Q(2)$\n$=\\left((3)^{2}+(3)\\right)+\\left(3(2)-4\\right)$\n$=12+2$\n$=14$"
      },
      {
        "question_text": "$P(x)=x^{2}+x$ and $Q(x)=3x-4$. Evaluate $P(2)-Q(-1)$.",
        "solution_text": "$P(2)-Q(-1)$\n$=\\left((2)^{2}+(2)\\right)-\\left(3(-1)-4\\right)$\n$=6-(-7)$\n$=13$"
      },
      {
        "question_text": "Without substituting into every term, write down $P(0)$ for $P(x)=7x^{5}-3x^{2}+11$.",
        "solution_text": "$P(0)$\nEvery term containing $x$ becomes $0$, leaving only the constant term.\n$P(0)=11$"
      },
      {
        "question_text": "If $P(x)=2x^{3}+3x^{2}-x$, evaluate $P(-3)$.",
        "solution_text": "$P(-3)$\n$=2(-3)^{3}+3(-3)^{2}-(-3)$\n$=-54+27+3$\n$=-24$"
      }
    ],
    "mastery": [
      {
        "question_text": "$P(x)=x^{2}-5x$ and $Q(x)=2x+7$. Evaluate $\\left(P(1)\\right)^{2}+\\left(Q(-2)\\right)^{2}$.",
        "solution_text": "$\\left(P(1)\\right)^{2}+\\left(Q(-2)\\right)^{2}$\n$P(1)=(1)^{2}-5(1)=-4$\n$Q(-2)=2(-2)+7=3$\n$\\left(P(1)\\right)^{2}+\\left(Q(-2)\\right)^{2}=(-4)^{2}+(3)^{2}$\n$=16+9$\n$=25$"
      },
      {
        "question_text": "$P(x)=ax^{3}+2$ and $P(2)=26$. Find the value of $a$.",
        "solution_text": "$P(2)=26$\n$a(2)^{3}+2=26$\n$8a+2=26$\n$8a=24$\n$a=3$"
      },
      {
        "question_text": "$P(x)=x^{3}-x$. Evaluate $P(5)-P(-5)$.",
        "solution_text": "$P(5)-P(-5)$\n$P(5)=(5)^{3}-(5)=120$\n$P(-5)=(-5)^{3}-(-5)=-120$\n$P(5)-P(-5)=120-(-120)$\n$=240$"
      }
    ]
  }
}
