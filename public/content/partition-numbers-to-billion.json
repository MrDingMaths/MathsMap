{
  "skillId": "partition-numbers-to-billion",
  "atomType": "R",
  "theory": {
    "intro": "Partitioning splits a number into parts. The standard partition uses place value; non-standard partitions regroup those parts in other useful ways.",
    "facts": [
      "**Standard partition**: $5\\,372 = 5\\,000 + 300 + 70 + 2$.",
      "**Non-standard partition** regroups a place, e.g. $5\\,372 = 5\\,000 + 200 + 170 + 2$.",
      "Renaming counts a number in one unit, e.g. $4\\,300\\,000 = 43$ hundred-thousands."
    ],
    "steps": [
      "Read each digit's place value.",
      "For a standard partition, write each digit times its place.",
      "To regroup, take $1$ from a higher place and add its value ($10$ of the next unit) lower down."
    ]
  },
  "practice": {
    "foundation": [
      {
        "question_text": "Write $46\\,208\\,075$ in standard expanded form.",
        "structure": "standard-expanded-form",
        "solution_text": "$46\\,208\\,075$\n$=40\\,000\\,000+6\\,000\\,000+200\\,000+8\\,000+70+5$"
      },
      {
        "question_text": "Write $700\\,000\\,000+30\\,000\\,000+4\\,000\\,000+50\\,000+900+2$ as one numeral.",
        "structure": "compose-standard-parts",
        "solution_text": "$700\\,000\\,000+30\\,000\\,000+4\\,000\\,000+50\\,000+900+2$\n$=734\\,050\\,902$"
      },
      {
        "question_text": "How many thousands make $1$ million?",
        "structure": "thousands-to-million",
        "solution_text": "$1\\,000$ thousands $=1\\,000\\,000$\nSo $1\\,000$ thousands make $1$ million."
      },
      {
        "question_text": "How many millions make $1$ billion?",
        "structure": "millions-to-billion",
        "solution_text": "$1\\,000$ millions $=1\\,000\\,000\\,000$\nSo $1\\,000$ millions make $1$ billion."
      },
      {
        "question_text": "Rename $6\\,400\\,000$ as a number of hundred-thousands.",
        "structure": "rename-hundred-thousands",
        "solution_text": "$6\\,400\\,000$\n$=64\\times100\\,000$\n$=64$ hundred-thousands"
      },
      {
        "question_text": "An inventory total is $382\\,450$.\nState it as thousands, hundreds and tens, with no ones.",
        "structure": "nonstandard-missing-part",
        "solution_text": "$382\\,450$\n$=382$ thousands $+4$ hundreds $+5$ tens"
      },
      {
        "question_text": "Complete the partition: $205\\,070\\,004=200\\,000\\,000+\\square+70\\,000+4$.",
        "structure": "nonstandard-missing-part",
        "solution_text": "$205\\,070\\,004-200\\,000\\,000-70\\,000-4$\n$=5\\,000\\,000$\nSo $\\square=5\\,000\\,000$."
      }
    ],
    "development": [
      {
        "question_text": "Regroup $73\\,400$ as a number of hundreds.",
        "structure": "rename-hundred-thousands",
        "solution_text": "$73\\,400$\n$=734\\times100$\n$=734$ hundreds"
      },
      {
        "question_text": "Write $8\\,352\\,000$ as a number of thousands.",
        "structure": "rename-hundred-thousands",
        "solution_text": "$8\\,352\\,000$\n$=8\\,352\\times1\\,000$\n$=8\\,352$ thousands"
      },
      {
        "question_text": "Complete this non-standard partition: $164\\,380=150\\,000+\\square$.",
        "structure": "nonstandard-missing-part",
        "solution_text": "$164\\,380-150\\,000$\n$=14\\,380$\nSo $\\square=14\\,380$."
      },
      {
        "question_text": "Regroup $52\\,706\\,000$ by trading one million for ten hundred-thousands.",
        "structure": "nonstandard-missing-part",
        "solution_text": "$52\\,706\\,000$\n$=51\\,000\\,000+17\\times100\\,000+6\\,000$\n$=51\\,000\\,000+1\\,700\\,000+6\\,000$"
      },
      {
        "question_text": "An inventory of $4\\,260\\,000$ parts is packed in lots of $10\\,000$.\nHow many lots is this?",
        "structure": "rename-inventory-lots",
        "solution_text": "$4\\,260\\,000$\n$=426\\times10\\,000$\n$=426$ lots"
      },
      {
        "question_text": "Write $906\\,040\\,500$ in standard expanded form, omitting zero-value places.",
        "structure": "standard-expanded-form",
        "solution_text": "$906\\,040\\,500$\n$=900\\,000\\,000+6\\,000\\,000+40\\,000+500$"
      },
      {
        "question_text": "Complete the equivalent regrouping: $340\\,000\\,000=300$ million $+\\square$ million.",
        "structure": "nonstandard-missing-part",
        "solution_text": "$340$ million $-300$ million\n$=40$ million\nSo $\\square=40$."
      }
    ],
    "mastery": [
      {
        "question_text": "An inventory of $268\\,450$ items is regrouped as $250$ thousands, $x$ hundreds and $5$ tens.\nFind $x$.",
        "structure": "nonstandard-missing-part",
        "solution_text": "$268\\,450-250\\,000-50$\n$=18\\,400$\n$18\\,400=184$ hundreds\nSo $x=184$."
      },
      {
        "question_text": "Write $1$ billion as both a number of hundred-thousands and a number of ten-millions.",
        "structure": "rename-hundred-thousands",
        "solution_text": "$1\\,000\\,000\\,000=10\\,000\\times100\\,000$\n$=100\\times10\\,000\\,000$\nSo $1$ billion is $10\\,000$ hundred-thousands or $100$ ten-millions."
      },
      {
        "question_text": "Which is the missing part in $620\\,305\\,040=600$ million $+19$ million $+\\square$?",
        "structure": "nonstandard-missing-part",
        "solution_text": "$620\\,305\\,040-600\\,000\\,000-19\\,000\\,000$\n$=1\\,305\\,040$\nSo $\\square=1\\,305\\,040$."
      },
      {
        "question_text": "A warehouse count is represented as $47$ hundred-thousands $+36$ thousands $+82$ ones.\nWrite the count as a numeral.",
        "structure": "compose-mixed-units",
        "solution_text": "$47\\times100\\,000+36\\times1\\,000+82$\n$=4\\,700\\,000+36\\,000+82$\n$=4\\,736\\,082$"
      }
    ]
  }
}
