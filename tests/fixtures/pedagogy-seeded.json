   "topicId": "two-step-equations",
   "title": "Solving two-step equations",
   "blocks": [
    {
     "id": "t2-review",
     "type": "question",
     "pedagogyRole": "review",
     "content": {
      "id": "t2-review-root",
      "type": "question",
      "label": "1",
      "prompt": "Solve these one-step equations.",
      "children": [
