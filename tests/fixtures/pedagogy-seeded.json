      ]
     }
    },
    {
     "id": "t2-definition",
     "type": "rich-text",
     "pedagogyRole": "definition",
     "content": "To solve a two-step equation, undo the operations in reverse order. Do the same to both sides at each step."
    },
    {
     "id": "t2-example-1",
     "type": "worked-example",
     "pedagogyRole": "example",
     "examples": [
      {
       "id": "t2-example-1-entry",
       "label": "",
       "prompt": "Solve $3x+4=19$",
       "theorySolution": "$\\begin{align*}3x+4&=19\\\\3x&=15&&\\text{subtract 4 from both sides}\\\\x&=5&&\\text{divide both sides by 3}\\end{align*}$"
      }
     ]
    },
    {
     "id": "t2-example-2",
     "type": "worked-example",
     "pedagogyRole": "example",
     "examples": [
      {
       "id": "t2-example-2-entry",
       "label": "",
       "prompt": "Solve $2x+6=12$",
       "theorySolution": "$\\begin{align*}2x+6&=12\\\\2x&=6&&\\text{subtract 6 from both sides}\\\\x&=3&&\\text{divide both sides by 2}\\end{align*}$"
      }
     ]
    },
    {
     "id": "t2-example-3",
     "type": "worked-example",
     "pedagogyRole": "example",
     "examples": [
      {
       "id": "t2-example-3-entry",
       "label": "",
       "prompt": "I think of a number, multiply it by 3 and subtract 2. The result is 10. Write an equation and solve it.",
       "theorySolution": "Let the number be $x$.\n$\\begin{align*}3x-2&=10\\\\3x&=12&&\\text{add 2 to both sides}\\\\x&=4&&\\text{divide both sides by 3}\\end{align*}$\nThe number is 4."
      }
     ]
    },
    {
     "id": "t2-guided",
     "type": "question",
     "pedagogyRole": "guided-practice",
     "content": {
      "id": "t2-guided-root",
      "type": "question",
      "label": "",
      "prompt": "Solve $5x+2=17$\n\n$\\begin{align*}5x+2&=17\\\\&\\cdots\\cdots\\cdots\\\\&\\cdots\\cdots\\cdots\\end{align*}$",
      "answer": {
       "short": "$x=3$",
       "worked": "$\\begin{align*}5x+2&=17\\\\5x&=15\\\\x&=3\\end{align*}$"
      }
     }
    }
   ]
  },
