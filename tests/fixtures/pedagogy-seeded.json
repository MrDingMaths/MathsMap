       "label": "",
       "prompt": "Find $17\\%$ of $200$",
       "theorySolution": "$\\begin{align*}17\\%&=0.17\\\\0.17\\times200&=34\\end{align*}$"
      }
     ]
    },
    {
     "id": "t3-example-2",
     "type": "worked-example",
     "pedagogyRole": "example",
     "examples": [
