   "topicId": "index-with-coefficient",
   "title": "Negative indices with coefficients",
   "blocks": [
    {
     "id": "t4-review",
     "type": "question",
     "pedagogyRole": "review",
     "content": {
      "id": "t4-review-root",
      "type": "question",
      "label": "1",
      "prompt": "Review",
      "children": [
       {
        "id": "t4-review-a",
        "type": "part",
        "label": "a",
        "prompt": "Write $5^{-2}$ as a fraction.",
        "answer": {
         "short": "$\\dfrac{1}{25}$",
         "worked": "$\\dfrac{1}{25}$"
        }
       },
       {
        "id": "t4-review-b",
        "type": "part",
        "label": "b",
        "prompt": "Write $x^{-3}$ with a positive index.",
        "answer": {
         "short": "$\\dfrac{1}{x^{3}}$",
         "worked": "$\\dfrac{1}{x^{3}}$"
        }
       },
       {
        "id": "t4-review-c",
        "type": "part",
        "label": "c",
        "prompt": "Expand $(3x)^{2}$.",
        "answer": {
         "short": "$9x^{2}$",
         "worked": "$9x^{2}$"
        }
       }
      ]
     }
    },
    {
     "id": "t4-definition",
     "type": "rich-text",
     "pedagogyRole": "definition",
     "content": "An index applies only to the base it is attached to. In $3x^{-2}$ the index $-2$ belongs to $x$, not to $3$. Brackets change this: in $(3x)^{-2}$ it belongs to both."
    },
    {
     "id": "t4-example",
     "type": "worked-example",
     "pedagogyRole": "example",
     "examples": [
      {
       "id": "t4-example-a",
       "label": "a",
       "prompt": "Write $3x^{-2}$ with a positive index.",
       "theorySolution": "$\\begin{align*}3x^{-2}&=3\\times\\dfrac{1}{x^{2}}\\\\&=\\dfrac{3}{x^{2}}\\end{align*}$"
      },
      {
       "id": "t4-example-b",
       "label": "b",
       "prompt": "Write $(3x)^{-2}$ with a positive index.",
       "theorySolution": "$\\begin{align*}(3x)^{-2}&=\\dfrac{1}{(3x)^{2}}\\\\&=\\dfrac{1}{9x^{2}}\\end{align*}$"
      }
     ]
    },
    {
     "id": "t4-guided",
     "type": "question",
     "pedagogyRole": "guided-practice",
     "content": {
      "id": "t4-guided-root",
      "type": "question",
      "label": "",
      "prompt": "Write $5a^{-3}$ with a positive index.",
      "answer": {
       "short": "$\\dfrac{5}{a^{3}}$",
       "worked": "$5\\times\\dfrac{1}{a^{3}}=\\dfrac{5}{a^{3}}$"
      }
     }
    }
   ]
  },
