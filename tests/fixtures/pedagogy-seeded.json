   "topicId": "negative-index",
   "title": "The negative index",
   "blocks": [
    {
     "id": "t1-review",
     "type": "question",
     "pedagogyRole": "review",
     "content": {
      "id": "t1-review-root",
      "type": "question",
      "label": "1",
      "prompt": "Simplify using the division index law.",
      "children": [
       {
        "id": "t1-review-a",
        "type": "part",
        "label": "a",
        "prompt": "$5^{6}\\div5^{2}$",
        "answer": {
         "short": "$5^{4}$",
         "worked": "$5^{6-2}=5^{4}$"
        }
       },
       {
        "id": "t1-review-b",
        "type": "part",
        "label": "b",
        "prompt": "$x^{7}\\div x^{3}$",
        "answer": {
         "short": "$x^{4}$",
         "worked": "$x^{7-3}=x^{4}$"
        }
       }
      ]
     }
    },
    {
     "id": "t1-definition",
     "type": "rich-text",
     "pedagogyRole": "definition",
     "content": "A negative index means the reciprocal with a positive index: $a^{-n}=\\dfrac{1}{a^{n}}$."
    },
    {
     "id": "t1-example",
     "type": "worked-example",
     "pedagogyRole": "example",
     "examples": [
      {
       "id": "t1-example-a",
       "label": "a",
       "prompt": "Write $5^{-1}$ as a fraction.",
       "theorySolution": "$5^{-1}=\\dfrac{1}{5}$"
      },
      {
       "id": "t1-example-b",
       "label": "b",
       "prompt": "Write $x^{-1}$ with a positive index.",
       "theorySolution": "$x^{-1}=\\dfrac{1}{x}$"
      }
     ]
    },
    {
     "id": "t1-guided",
     "type": "question",
     "pedagogyRole": "guided-practice",
     "content": {
      "id": "t1-guided-root",
      "type": "question",
      "label": "",
