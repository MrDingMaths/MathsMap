{
  "name": "mathsmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Student-facing NSW Stage 3-6 maths skill map: hierarchy, prerequisite graph, progress, and recommender.",
  "scripts": {
    "predev": "node scripts/build-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-manifest.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "gate": "node scripts/agy/gate.mjs",
    "dev:batch": "node scripts/agy/dev-server.mjs --start",
    "test": "node --test \"tests/*.test.js\"",
    "tikz:patch": "node scripts/tikz-patcher/patcher.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "dq:capture": "node scripts/dq/capture.mjs",
    "dq:bg": "node scripts/dq/background.mjs",
    "dq:qa": "node scripts/dq/qa-jobs.mjs",
    "dq:export": "node scripts/dq/export-jobs.mjs",
    "dq:process": "node scripts/dq/process-candidates.mjs",
    "dq:check-map": "node scripts/dq/run-luna-check-map.mjs",
    "structure:jobs": "node scripts/structure-jobs.mjs",
    "structure:apply": "node scripts/structure-apply.mjs",
    "booklet:import": "node scripts/booklet/import.mjs",
    "booklet:export": "node scripts/booklet/export-pdf.mjs",
    "booklet:sync-editor": "node scripts/booklet/sync-maths-editor.mjs",
    "booklet:export-practice": "node scripts/booklet/export-practice-pdfs.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "playwright-core": "^1.61.1",
    "svelte": "^5.19.0",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "cytoscape": "^3.31.0",
    "katex": "^0.17.0"
  }
}
